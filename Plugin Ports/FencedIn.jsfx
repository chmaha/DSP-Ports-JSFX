gtitle_data();
gi0 = 0;
loop(11, GMV[gi0] = -20 + 2 * gi0; GML[gi0] = 200 + gi0; sprintf(200 + gi0, "%d", -20 + 2 * gi0); gi0 += 1;);
gi0 = 0;
