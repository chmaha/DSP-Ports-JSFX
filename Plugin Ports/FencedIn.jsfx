);

@slider
fl_last_srate != srate ? ( fl_last_srate = srate; fl_reset(); );
fl_cq = threshold; fl_coef();
pdc_delay = fl_total; pdc_bot_ch = 0; pdc_top_ch = 2;

@block
threshold !== fl_cq ? ( fl_cq = threshold; fl_coef(); );
fl_grl = 20 * log10(max(fl_pml, 0.000001)); fl_grr = 20 * log10(max(fl_pmr, 0.000001));

@sample
fl_rng = fl_rng * 1664525 + 1013904223; fl_rng -= 4294967296 * floor(fl_rng / 4294967296);
q_dt = ((floor(fl_rng / 256) * 0.000000059604644775390625 - 0.5) * FL_DA);
fl_wp = (fl_wp + 1) & 65535;
q_p1 = (fl_wp + 65536 - fl_post) & 65535;
q_p2 = (q_p1 + 65536 - fl_look) & 65535;
q_dl = ((spl0) + q_dt);
q_al = (abs(q_dl) + FL_EPS);
q_rl = (fl_thr / q_al); q_rl > 1 ? q_rl = 1;
fl_pml <= q_rl ? ( fl_pml = (fl_pml + ((q_rl - fl_pml) * fl_c190)); ) : ( fl_pml = q_rl; );
q_gl = ((q_al - fl_thr) / q_al); q_gl < FL_EPS ? q_gl = FL_EPS;
fl_e1l = (fl_e1l * fl_c8); q_gl > fl_e1l ? fl_e1l = q_gl;
fl_i1l = (fl_i1l * fl_v1l); q_gl > fl_i1l ? fl_i1l = q_gl;
fl_i1l <= fl_e1l ? ( fl_v1l = 1; ) : ( fl_v1l = fl_v1l - (((fl_i1l - fl_e1l) * (fl_v1l - fl_c8)) / fl_sr); );
fl_s1l = (fl_s1l + ((fl_i1l - fl_s1l) * fl_cc)); fl_i1l < fl_s1l ? fl_s1l = fl_i1l;
q_wl = (fl_s1l - (fl_zl * fl_a1)); q_pl = (fl_b * (q_wl + fl_zl)); fl_zl = q_wl;
q_el = ((1 - q_pl) * q_dl);
q_ql = abs(q_el); q_ql > fl_thr ? ( q_ol = ((q_ql - fl_thr) / q_ql); q_el = (q_el * (1 - ((q_ol * q_ol) * q_ol))); );
FLBL[fl_wp] = q_el;
q_xl = (abs(FLBL[q_p1]) + FL_EPS);
q_el = FLBL[q_p2];
q_hl = ((q_xl - fl_thr) / q_xl); q_hl < FL_EPS ? q_hl = FL_EPS;
fl_e2l = (fl_e2l * fl_d0); q_hl > fl_e2l ? fl_e2l = q_hl;
fl_i2l = (fl_i2l * fl_v2l); q_hl > fl_i2l ? fl_i2l = q_hl;
fl_i2l <= fl_e2l ? ( fl_v2l = fl_v2l + (((1 - fl_v2l) * 8000) / fl_sr); fl_v2l > 1 ? fl_v2l = 1; ) : ( fl_v2l = fl_v2l - (((fl_i2l - fl_e2l) * (fl_v2l - fl_d0)) / fl_sr); );
fl_s2l = (fl_s2l + ((fl_i2l - fl_s2l) * fl_d4)); fl_i2l < fl_s2l ? fl_s2l = fl_i2l;
q_el = ((1 - fl_s2l) * q_el);
q_yl = (abs(q_el) + FL_EPS); q_kl = ((q_yl - fl_thr) / q_yl); q_kl < FL_EPS ? q_kl = FL_EPS;
fl_e3l = (fl_e3l * fl_d0); q_kl > fl_e3l ? fl_e3l = q_kl;
spl0 = (((1 - fl_e3l) * q_el) * fl_og);
q_dr = ((spl1) + q_dt);
q_ar = (abs(q_dr) + FL_EPS);
q_rr = (fl_thr / q_ar); q_rr > 1 ? q_rr = 1;
fl_pmr <= q_rr ? ( fl_pmr = (fl_pmr + ((q_rr - fl_pmr) * fl_c190)); ) : ( fl_pmr = q_rr; );
q_gr = ((q_ar - fl_thr) / q_ar); q_gr < FL_EPS ? q_gr = FL_EPS;
fl_e1r = (fl_e1r * fl_c8); q_gr > fl_e1r ? fl_e1r = q_gr;
fl_i1r = (fl_i1r * fl_v1r); q_gr > fl_i1r ? fl_i1r = q_gr;
fl_i1r <= fl_e1r ? ( fl_v1r = 1; ) : ( fl_v1r = fl_v1r - (((fl_i1r - fl_e1r) * (fl_v1r - fl_c8)) / fl_sr); );
fl_s1r = (fl_s1r + ((fl_i1r - fl_s1r) * fl_cc)); fl_i1r < fl_s1r ? fl_s1r = fl_i1r;
q_wr = (fl_s1r - (fl_zr * fl_a1)); q_pr = (fl_b * (q_wr + fl_zr)); fl_zr = q_wr;
q_er = ((1 - q_pr) * q_dr);
q_qr = abs(q_er); q_qr > fl_thr ? ( q_or = ((q_qr - fl_thr) / q_qr); q_er = (q_er * (1 - ((q_or * q_or) * q_or))); );
FLBR[fl_wp] = q_er;
q_xr = (abs(FLBR[q_p1]) + FL_EPS);
q_er = FLBR[q_p2];
q_hr = ((q_xr - fl_thr) / q_xr); q_hr < FL_EPS ? q_hr = FL_EPS;
fl_e2r = (fl_e2r * fl_d0); q_hr > fl_e2r ? fl_e2r = q_hr;
fl_i2r = (fl_i2r * fl_v2r); q_hr > fl_i2r ? fl_i2r = q_hr;
fl_i2r <= fl_e2r ? ( fl_v2r = fl_v2r + (((1 - fl_v2r) * 8000) / fl_sr); fl_v2r > 1 ? fl_v2r = 1; ) : ( fl_v2r = fl_v2r - (((fl_i2r - fl_e2r) * (fl_v2r - fl_d0)) / fl_sr); );
fl_s2r = (fl_s2r + ((fl_i2r - fl_s2r) * fl_d4)); fl_i2r < fl_s2r ? fl_s2r = fl_i2r;
q_er = ((1 - fl_s2r) * q_er);
q_yr = (abs(q_er) + FL_EPS); q_kr = ((q_yr - fl_thr) / q_yr); q_kr < FL_EPS ? q_kr = FL_EPS;
fl_e3r = (fl_e3r * fl_d0); q_kr > fl_e3r ? fl_e3r = q_kr;
spl1 = (((1 - fl_e3r) * q_er) * fl_og);
@gfx 1050 276
G_NOW = time_precise();
G_WHEEL = mouse_wheel; mouse_wheel = 0;
G_SC = max(0.45, min(gfx_w / 860, gfx_h / 226));
G_OX = floor((gfx_w - 860 * G_SC) * 0.5);
G_OY = 57;
G_SC !== G_FSC ? (
  G_FSC = G_SC;
  gfx_setfont(1, "Arial", 13 * G_SC, 'b');
  gfx_setfont(3, "Arial", 14 * G_SC, 'b');
  gfx_setfont(4, "Arial", 12 * G_SC);
  gfx_setfont(5, "Arial", 11 * G_SC);
);
G_GH = max(1, gfx_h);
(gfx_w !== G_CW0 || gfx_h !== G_CH0 || G_SC !== G_CS0) ? (
  G_CW0 = gfx_w; G_CH0 = gfx_h; G_CS0 = G_SC;
  G_DST = gfx_dest;
  gled_sprite(23, 0); gled_sprite(24, 1);
  gfx_setimgdim(22, 0, 0); gfx_setimgdim(22, gfx_w, gfx_h);
  gfx_dest = 22;
  gfx_gradrect(0, 0, gfx_w, gfx_h, 0.10, 0.13, 0.12, 1, 0, 0, 0, 0, (0.04 - 0.10) / G_GH, (0.06 - 0.13) / G_GH, (0.05 - 0.12) / G_GH, 0);
  gfx_mode = 0;
  G_OY = 0;
  gtitle(0, 24, 44, 24, 0.96, 0.93, 0.82);
  gtitle(1, 24 + gtitle_w(0, 24) + 14, 44, 13, 0.80, 0.74, 0.50);
  gtext(860 - 20, 30, "based on Classic Master Limiter RE-01 by AnClark Liu", 4, 0.70, 0.72, 0.64, 1, 2);
  G_OY = 57;
  G_XX = floor(gsx(5)); G_YY = floor(gsy(5)); G_WW = ceil(850 * G_SC); G_HH = ceil(150 * G_SC);
  gfrr(G_XX + 3, G_YY + 4, G_XX + G_WW + 3, G_YY + G_HH + 4, floor(13 * G_SC), 0, 0, 0, 0.35);
  gfrr(G_XX, G_YY, G_XX + G_WW, G_YY + G_HH, floor(13 * G_SC), 0.27, 0.33, 0.27, 1);
  gbord(G_XX, G_YY, G_XX + G_WW, G_YY + G_HH, floor(13 * G_SC), max(1, floor(1.5 * G_SC + 0.5)), 0.93, 0.88, 0.66, 0.3);
  gsection(14, 300, 19, "THRESHOLD");
  gsection(318, 657, 19, "COMPRESSION");
  gsection(675, 846, 19, "OUTPUT");
  ginfo(760, 44, "CEILING", "-0.2 dBFS");
  ginfo(760, 84, "LOOK-AHEAD", "3 ms");
  gscale(159, 84, 26);
  gtext(159, 139, "LEVEL (dB)", 4, 0.98, 0.95, 0.86, 1, 1);
  gtext(354, 52, "LEFT", 4, 0.98, 0.95, 0.86, 1, 0);
  gtext(354, 96, "RIGHT", 4, 0.98, 0.95, 0.86, 1, 0);
  gi1 = 0;
  loop(11,
    G_XX = 413 + gi1 * 17;
    gfx_set(0.98, 0.95, 0.86, 0.85);
    gfx_rect(floor(gsx(G_XX) - 0.5 * G_SC), floor(gsy(61)), max(1, floor(G_SC + 0.4)), max(1, floor(4 * G_SC)));
    gfx_rect(floor(gsx(G_XX) - 0.5 * G_SC), floor(gsy(83)), max(1, floor(G_SC + 0.4)), max(1, floor(4 * G_SC)));
    gtext(G_XX, 74, 220 + gi1, 5, 0.98, 0.95, 0.86, 0.95, 1);
    gi1 += 1;
  );
  gtext(597, 74, "dB", 5, 0.98, 0.95, 0.86, 0.95, 0);
  gtext(481, 134, "PEAK LEVEL METER", 4, 0.98, 0.95, 0.86, 1, 1);
  gfx_dest = G_DST;
);
gfx_x = 0; gfx_y = 0; gfx_a = 1; gfx_mode = 0;
gfx_blit(22, 1, 0);

sprintf(#g_lat, "%d samples", pdc_delay);
ginfo(760, 124, "LATENCY", #g_lat);
gmeter_row(52, fl_grl);
gmeter_row(96, fl_grr);

G_MD = mouse_cap & 1;
G_PRESS = G_MD && !G_LMD;
G_REL = !G_MD && G_LMD;
G_MX = (mouse_x - G_OX) / G_SC; G_MY = mouse_y / G_SC - G_OY;
G_DCLK = G_PRESS && G_NOW - G_LCLK < 0.3 && abs(G_MX - G_LCX) < 4 && abs(G_MY - G_LCY) < 4;
G_PRESS ? ( G_LCLK = G_DCLK ? 0 : G_NOW; G_LCX = G_MX; G_LCY = G_MY; );

G_HK = (G_MX - 159) ^ 2 + (G_MY - 84) ^ 2 <= 32 * 32;
G_DRAG === 1 ? G_HK = 1;
gknob_th(159, 84, 26, G_HK);

G_PRESS && G_HK ? (
  G_DCLK ? ( threshold = -5; gauto(1, 1); ) :
  ( G_DRAG = 1; G_DY = mouse_y; G_DT = gk_t(threshold); );
);
G_DRAG === 1 && G_MD ? (
  G_V = gk_v(G_DT + (G_DY - mouse_y) * ((mouse_cap & 4) ? 0.0005 : 0.005) / G_SC);
  G_V !== threshold ? ( threshold = G_V; gauto(1, 0); );
  mouse_cap |= 65536;
);
G_REL ? (
  G_DRAG === 1 ? gauto(1, 1);
  G_DRAG = 0;
);
G_WHEEL !== 0 && G_DRAG === 0 && G_HK ? (
  G_T = gk_t(threshold) + (G_WHEEL > 0 ? 1 : -1) * ((mouse_cap & 4) ? 0.002 : 0.02);
  G_V = gk_v(G_T);
  G_V === threshold ? G_V = gk_v(G_T + (G_WHEEL > 0 ? 1 : -1) * 0.004);
  threshold = G_V; gauto(1, 1);
);

(G_HK !== G_TLAST || G_MD || G_WHEEL !== 0) ? ( G_TLAST = G_HK; G_TT0 = G_NOW; );
(G_HK && (G_DRAG === 1 || G_NOW - G_TT0 >= 0.5)) ? (
  sprintf(#g_tip, "%.1f dB", threshold);
  gfx_setfont(4);
  gfx_measurestr(#g_tip, G_TW, G_TH);
  G_TPW = G_TW + floor(16 * G_SC); G_TPH = G_TH + floor(10 * G_SC);
  G_TPX = mouse_x + floor(14 * G_SC); G_TPY = mouse_y + floor(20 * G_SC);
  G_TPX + G_TPW > gfx_w - 2 ? G_TPX = max(2, gfx_w - 2 - G_TPW);
  G_TPY + G_TPH > gfx_h - 2 ? G_TPY = max(2, mouse_y - floor(8 * G_SC) - G_TPH);
  gfrr(G_TPX, G_TPY, G_TPX + G_TPW, G_TPY + G_TPH, floor(5 * G_SC), 0.09, 0.12, 0.10, 1);
  gbord(G_TPX, G_TPY, G_TPX + G_TPW, G_TPY + G_TPH, floor(5 * G_SC), max(1, floor(G_SC + 0.5)), 0.80, 0.70, 0.42, 0.6);
  gfx_set(0.96, 0.93, 0.82, 1);
  gfx_x = G_TPX + floor(8 * G_SC); gfx_y = G_TPY + floor(5 * G_SC);
  gfx_drawstr(#g_tip);
);
G_LMD = G_MD;

