options:no_meter

in_pin:none
out_pin:Left
out_pin:Right

@init
function f32(x) local(c) ( c = x * 536870913; c - (c - x); );
function f32k(x) local(c) ( c = x * 536870913; c - (c - x); );

function alloc(n) local(r) instance(mp) global() ( r = mp; mp += n; memset(r, 0, n); r; );

function ol_slot_clear(s) (
  s[0] = 0; s[1] = 0; s[2] = 0x1ff; s[3] = 0x1ff; s[4] = 3; s[5] = 0; s[6] = 0; s[7] = 0;
);

function ol_opregs_default(o) (
  o[0] = 0; o[1] = 0; o[2] = 1; o[3] = 0; o[4] = 1; o[5] = 0; o[6] = 63; o[7] = 15; o[8] = 0; o[9] = 0; o[10] = 7; o[11] = 0;
);

function ol_voice_clear(v) local(j) (
  memset(v, 0, OL_VS);
  j = 0; loop(4, ol_slot_clear(v + j * 8); j += 1;);
  v[36] = -1; v[44] = -1; v[49] = 0x30; v[51] = -1;
  ol_opregs_default(v + 56); ol_opregs_default(v + 68);
);

function ol_gm_init() local(k) (
  ol_gmfree_n = 18; ol_gmalloc_n = 0;
  k = 0; loop(18, OL_GMFREE[k] = k; k += 1;);
  k = 0; loop(16, OL_GMCH[k * 4] = 0; OL_GMCH[k * 4 + 1] = 100; OL_GMCH[k * 4 + 2] = 0x30; OL_GMCH[k * 4 + 3] = 0; k += 1;);
);

function rs_reset() (
  memset(RS_HL, 0, 64); memset(RS_HR, 0, 64);
  rs_pos = 0; rs_avail = 0;
);

function ol_reset() local(k) (
  k = 0; loop(18, ol_voice_clear(OL_VOICE + k * OL_VS); k += 1;);
  k = 0; loop(3, ol_voice_clear(OL_DRUM + k * OL_VS); k += 1;);
  ol_timer = 0; ol_egtimer = 0; ol_egstate = 0; ol_egadd = 0; ol_egtimerlo = 0;
  ol_trempos = 0; ol_trem = 0; ol_vibpos = 0;
  ol_age = 0;
  ol_gm_init();
  ol_drumkeys = 0; ol_drumrestart = 0;
  ol_noise = 1; ol_nz_pending = 0;
  ol_hh2 = 0; ol_hh3 = 0; ol_hh7 = 0; ol_hh8 = 0; ol_tc3 = 0; ol_tc5 = 0;
  rs_reset();
);

function ol_expout(level) (
  level > 0x1fff ? level = 0x1fff;
  (OL_EXPT[level & 0xff] * 2) >> (level >> 8);
);

function ol_wave(wf, ph, env) local(out, neg, v) (
  ph &= 0x3ff;
  neg = 0;
  wf === 0 ? (
    neg = ph & 0x200;
    out = (ph & 0x100) ? OL_LOGSIN[255 - (ph & 0xff)] : OL_LOGSIN[ph & 0xff];
  ) : wf === 1 ? (
    out = (ph & 0x200) ? 0x1000 : (ph & 0x100) ? OL_LOGSIN[255 - (ph & 0xff)] : OL_LOGSIN[ph & 0xff];
  ) : wf === 2 ? (
    out = (ph & 0x100) ? OL_LOGSIN[255 - (ph & 0xff)] : OL_LOGSIN[ph & 0xff];
  ) : wf === 3 ? (
    out = (ph & 0x100) ? 0x1000 : OL_LOGSIN[ph & 0xff];
  ) : wf === 4 ? (
    neg = (ph & 0x300) === 0x100;
    out = (ph & 0x200) ? 0x1000 : (ph & 0x80) ? OL_LOGSIN[((ph ~ 0xff) * 2) & 0xff] : OL_LOGSIN[(ph * 2) & 0xff];
  ) : wf === 5 ? (
    out = (ph & 0x200) ? 0x1000 : (ph & 0x80) ? OL_LOGSIN[((ph ~ 0xff) * 2) & 0xff] : OL_LOGSIN[(ph * 2) & 0xff];
  ) : wf === 6 ? (
    neg = ph & 0x200;
    out = 0;
  ) : (
    (ph & 0x200) ? ( neg = 1; ph = 0x1ff - (ph & 0x1ff); );
    out = ph * 8;
  );
  v = ol_expout(out + env * 8);
  neg ? -v - 1 : v;
);

function ol_env(s, o, v, xtl) local(rr, reset, ks, rate, rhi, rlo, egsh, shift, rout, inc, off, gen, egr, key, t)
(
  egr = s[2]; gen = s[4]; key = s[7];
  t = o[6] + xtl;
  s[3] = ((egr + (min(63, t) * 4)) + (v[35] >> OL_KSLSH[o[5]])) + (o[0] ? ol_trem : 0);
  reset = 0;
  rr = (key && gen === 3) ? ( reset = 1; o[7]; ) :
       gen === 0 ? o[7] :
       gen === 1 ? o[8] :
       gen === 2 ? (o[2] ? 0 : o[10]) :
       o[10];
  ol_pgreset = reset;
  ks = o[3] ? v[34] : v[34] >> 2;
  rate = ks + rr * 4;
  rhi = rate >> 2;
  rlo = rate & 3;
  (rhi & 0x10) ? rhi = 0x0f;
  egsh = rhi + ol_egadd;
  shift = 0;
  rr !== 0 ? (
    rhi < 12 ? (
      ol_egstate ? shift = (egsh === 12 ? 1 : egsh === 13 ? (rlo >> 1) & 1 : egsh === 14 ? rlo & 1 : 0);
    ) : (
      shift = (rhi & 3) + OL_INCSTEP[rlo * 4 + ol_egtimerlo];
      (shift & 4) ? shift = 3;
      !shift ? shift = ol_egstate;
    );
  );
  rout = egr;
  inc = 0;
  (reset && rhi === 0x0f) ? rout = 0;
  off = (egr & 0x1f8) === 0x1f8;
  ((gen !== 0 && !reset) && off) ? rout = 0x1ff;
  gen === 0 ? (
    egr === 0 ? ( gen = 1; ) : ( ((key && shift > 0) && rhi !== 0x0f) ? inc = floor((-egr - 1) / (2 ^ (4 - shift))); );
  ) : gen === 1 ? (
    (egr >> 4) === o[9] ? ( gen = 2; ) : ( ((!off && !reset) && shift > 0) ? inc = 2 ^ (shift - 1); );
  ) : (
    ((!off && !reset) && shift > 0) ? inc = 2 ^ (shift - 1);
  );
  s[2] = (rout + inc) & 0x1ff;
  reset ? gen = 0;
  !key ? gen = 3;
  s[4] = gen;
);

function ol_phase(s, o, v) local(fnum, range, base) (
  fnum = v[32];
  o[1] ? (
    range = (fnum >> 7) & 7;
    !(ol_vibpos & 3) ? ( range = 0; ) : ( (ol_vibpos & 1) ? range = range >> 1; );
    range = range >> ol_vibshift;
    (ol_vibpos & 4) ? range = -range;
    fnum += range;
  );
  base = (fnum * (2 ^ v[33])) >> 1;
  s[1] = (s[0] >> 9) & 0x3ff;
  ol_pgreset ? s[0] = 0;
  s[0] = (s[0] + ((base * OL_MT[o[4]]) >> 1)) & 0x7ffff;
);

function ol_setfnum(v, fnum, block) (
  v[32] = fnum; v[33] = block;
  v[34] = (block * 2) | ((fnum >> 9) & 1);
  v[35] = max(0, (OL_KSLROM[fnum >> 6] * 4) - ((8 - block) * 32));
);

function ol_setpitch(v) local(f, block, fn) (
  f = 440 * (2 ^ ((((v[36] + (v[52] ? ol_tr2 : ol_tr1)) - 69) / 12) + ((v[52] ? ol_tunecents + ol_det * 3.125 : ol_tunecents) / 1200)));
  block = 0;
  fn = (f * 1048576) / OL_CHIPRATE;
  while (fn >= 1023.5 && block < 7) ( fn *= 0.5; block += 1; );
  ol_setfnum(v, max(0, min(1023, floor(fn + 0.5))), block);
);

function ol_numvoices() ( ol_model <= 1 ? 9 : ol_fourop ? 6 : 18; );
function ol_reserved(k) ( ((ol_rhythm && !ol_fourop) && k >= 6) && k <= 8; );
function ol_chipchannel(k) ( ol_fourop ? OL_FOURCH[k] : k; );
function ol_carriers() ( !ol_fourop ? ((ol_alg & 1) === 0 ? 2 : 3) : OL_CARR4[ol_alg]; );
function ol_chains(j) (
  !ol_fourop ? ol_alg === 0 :
  ol_alg === 0 ? 1 :
  ol_alg === 1 ? j !== 2 :
  ol_alg === 2 ? j !== 1 :
  j === 2;
);

function ol_veltl(vel) local(fv, x) (
  fv = f32k(vel * OL_INV127);
  x = (-20 * log10(max(OL_F001, fv))) / 0.75;
  max(0, min(63, floor(x + 0.5)));
);

function ol_noisestep(n) local(bit) (
  bit = ((n >> 14) ~ n) & 1;
  (n >> 1) | (bit * 4194304);
);

function ol_roundtrip(value) local(scan, lz, b, e) (
  scan = value < 0 ? -value - 1 : value;
  lz = 0; b = 14;
  while (b >= 0 && !((scan >> b) & 1)) ( lz += 1; b -= 1; );
  e = max(7 - min(7, lz), 1) - 1;
  value & -(2 ^ e);
);

function ol_mix(v, k, acc) local(pan, onl, onr, latel, later) (
  pan = ol_panmode === 1 ? 1 : ol_panmode === 2 ? 2 : ol_panmode === 3 ? 1 + (k & 1) : 0;
  onl = ol_model <= 1 || (ol_gm ? (v[49] & 0x10) !== 0 : pan !== 2);
  onr = ol_model <= 1 || (ol_gm ? (v[49] & 0x20) !== 0 : pan !== 1);
  latel = (ol_model === 2 && v[38] >= 6) && v[38] <= 8;
  later = ol_model === 2 && v[38] >= 15;
  onl ? ol_mixl += latel ? v[39] : acc;
  onr ? ol_mixr += later ? v[40] : acc;
  v[39] = acc; v[40] = acc;
);

function ol_level(d) ( max(0, min(63, OL_DRUMTL[d] + OL_DRUMVEL[d])); );

function ol_rhythm_sample(n13, n16) local(keys, c6, c7, c8, m, c, h, sd, t, y, x) (
  keys = ol_drumkeys & (0x1f - (ol_drumrestart & 0x1f));
  ol_drumrestart = 0;
  c6 = OL_DRUM; c7 = OL_DRUM + OL_VS; c8 = OL_DRUM + 2 * OL_VS;
  c6[7] = (keys & 0x10) !== 0;
  c6[15] = c6[7];
  c7[7] = (keys & 0x01) !== 0;
  c7[15] = (keys & 0x08) !== 0;
  c8[7] = (keys & 0x04) !== 0;
  c8[15] = (keys & 0x02) !== 0;

  m = c6; c = c6 + 8;
  m[6] = m[5];
  ol_env(m, OL_DRUMOP, c6, 0);
  ol_phase(m, OL_DRUMOP, c6);
  m[5] = ol_wave(0, m[1], m[3]);
  ol_env(c, OL_DRUMOP + 12, c6, ol_level(0));
  ol_phase(c, OL_DRUMOP + 12, c6);
  c[5] = ol_wave(0, c[1] + m[5], c[3]);
  ol_mix(c6, 6, 2 * c[5]);

  h = c7; sd = c7 + 8;
  ol_env(h, OL_DRUMOP + 60, c7, ol_level(4));
  ol_phase(h, OL_DRUMOP + 60, c7);
  ol_hh2 = (h[1] >> 2) & 1; ol_hh3 = (h[1] >> 3) & 1;
  ol_hh7 = (h[1] >> 7) & 1; ol_hh8 = (h[1] >> 8) & 1;
  x = ((ol_hh2 ~ ol_hh7) | (ol_hh3 ~ ol_tc5)) | (ol_tc3 ~ ol_tc5);
  h[1] = (x * 512) | ((x ~ (n13 & 1)) !== 0 ? 0xd0 : 0x34);
  h[5] = ol_wave(0, h[1], h[3]);
  ol_env(sd, OL_DRUMOP + 24, c7, ol_level(1));
  ol_phase(sd, OL_DRUMOP + 24, c7);
  sd[1] = (ol_hh8 * 512) | ((ol_hh8 ~ (n16 & 1)) * 256);
  sd[5] = ol_wave(0, sd[1], sd[3]);
  ol_mix(c7, 7, 2 * h[5] + 2 * sd[5]);

  t = c8; y = c8 + 8;
  ol_env(t, OL_DRUMOP + 36, c8, ol_level(2));
  ol_phase(t, OL_DRUMOP + 36, c8);
  t[5] = ol_wave(0, t[1], t[3]);
  ol_env(y, OL_DRUMOP + 48, c8, ol_level(3));
  ol_phase(y, OL_DRUMOP + 48, c8);
  ol_tc3 = (y[1] >> 3) & 1; ol_tc5 = (y[1] >> 5) & 1;
  x = ((ol_hh2 ~ ol_hh7) | (ol_hh3 ~ ol_tc5)) | (ol_tc3 ~ ol_tc5);
  y[1] = (x * 512) | 0x80;
  y[5] = ol_wave(0, y[1], y[3]);
  ol_mix(c8, 8, 2 * t[5] + 2 * y[5]);
);

function ol_timers() local(shift) (
  (ol_timer & 0x3f) === 0x3f ? ol_trempos = (ol_trempos + 1) % 210;
  ol_trem = (ol_trempos < 105 ? ol_trempos : 210 - ol_trempos) >> ol_tremshift;
  (ol_timer & 0x3ff) === 0x3ff ? ol_vibpos = (ol_vibpos + 1) & 7;
  ol_timer = (ol_timer + 1) & 0x3ff;
  ol_egstate ? (
    shift = 0;
    while (shift < 13 && ((ol_egtimer >> shift) & 1) === 0) ( shift += 1; );
    ol_egadd = shift > 12 ? 0 : shift + 1;
    ol_egtimerlo = ol_egtimer & 3;
    ol_egtimer = (ol_egtimer + 1) & 0x1fff;
  );
  ol_egstate = 1 - ol_egstate;
);

function ol_vibbase(fnum, p) local(range) (
  range = (fnum >> 7) & 7;
  !(p & 3) ? ( range = 0; ) : ( (p & 1) ? range = range >> 1; );
  range = range >> ol_vibshift;
  (p & 4) ? range = -range;
  ((fnum + range) * (2 ^ rv_block)) >> 1;
