evn = 0;
while (gq_r != gq_w) (
  EVQ[evn * 4] = 0; EVQ[evn * 4 + 1] = GQ[gq_r * 3]; EVQ[evn * 4 + 2] = GQ[gq_r * 3 + 1]; EVQ[evn * 4 + 3] = GQ[gq_r * 3 + 2];
  evn += 1;
  gq_r = (gq_r + 1) % 64;
);
while (midirecv(mofs, m1, m2, m3)) (
  evn < 1000 ? (
    EVQ[evn * 4] = mofs; EVQ[evn * 4 + 1] = m1; EVQ[evn * 4 + 2] = m2; EVQ[evn * 4 + 3] = m3;
    evn += 1;
  );
  (m1 & 0xf0) === 0xe0 ? ol_pb = (((((m3 * 128) | m2) - 8192) / 8192) * bendrange);
);

ol_read_params();
nn_update();
(gm_restore && ol_gm) ? ( gm_restore = 0; bk = 0; loop(16, OL_GMCH[bk * 4] = GMSAVE[bk]; bk += 1;); );
ol_bend = (ol_bend + (OL_F02 * (ol_pb - ol_bend)));
ol_tunecents = (finetune) + 100 * ol_bend;
!ol_gm ? (
  bk = 0;
  loop(18, OL_VOICE[bk * OL_VS + 36] >= 0 ? ol_setpitch(OL_VOICE + bk * OL_VS); bk += 1;);
);

bpos = rs_pos; bav = rs_avail; btot = 0;
bi = 0;
loop(samplesblock,
  bneed = 0;
  while (bav + bneed <= floor(bpos) + 8) ( bneed += 1; );
  NEED[bi] = bneed; CB[bi] = btot;
  btot += bneed; bav += bneed;
  bpos += rs_step;
  bpos > 1000000 ? ( bsh = floor((floor(bpos) - 16) / 64) * 64; bpos -= bsh; bav -= bsh; );
  bi += 1;
);
bcur = 0;
bev = 0;
loop(evn,
  bb = CB[min(samplesblock - 1, max(0, EVQ[bev * 4]))];
  bb > bcur ? ( ol_render_seg(bcur, bb - bcur); bcur = bb; );
  bm = EVQ[bev * 4 + 1] & 0xf0;
  (bm === 0x90 && EVQ[bev * 4 + 3] > 0) ? (
    KEYL[EVQ[bev * 4 + 2]] = 1;
    CHA[EVQ[bev * 4 + 1] & 15] = 1;
    (ol_rhythm && (EVQ[bev * 4 + 1] & 15) === 9) ? ( bd = ol_drum_of(EVQ[bev * 4 + 2]); bd >= 0 ? DRA[bd] = 1; );
  ) : ( (bm === 0x80 || bm === 0x90) ? KEYL[EVQ[bev * 4 + 2]] = 0; );
  ol_gm ? ol_gm_midi(EVQ[bev * 4 + 1], EVQ[bev * 4 + 2], EVQ[bev * 4 + 3])
        : ol_midi(EVQ[bev * 4 + 1], EVQ[bev * 4 + 2], EVQ[bev * 4 + 3]);
  bev += 1;
);
btot > bcur ? ol_render_seg(bcur, btot - bcur);
bi = 0;
loop(btot,
  bl = max(-32768, min(32767, CHL[bi]));
  br = max(-32768, min(32767, CHR[bi]));
  ol_model <= 1 ? ( bl = ol_roundtrip(bl); br = ol_roundtrip(br); );
  CHL[bi] = bl * OL_KGAIN; CHR[bi] = br * OL_KGAIN;
  bi += 1;
);

bgold = ol_model === 2 && gold > 0.5;
bgold !== gd_was ? ( gd_was = bgold; gd_reset(); );
bgold ? gd_apply(gd_round(gbass), gd_round(gtreble), gd_round(gstereo), gd_round(gsurround), gd_round(glevel));
bsur = bgold && gd_pgm > 0;

bg = (gain / 100);
binc = ((bg - ol_glast) / samplesblock);
bgg = ol_glast;
bc = 0;
bi = 0;
loop(samplesblock,
  loop(NEED[bi],
    RS_HL[rs_avail & 63] = CHL[bc];
    RS_HR[rs_avail & 63] = CHR[bc];
    bsur ? gd_push(CHL[bc], CHR[bc]);
    rs_avail += 1; bc += 1;
  );
  bbase = floor(rs_pos);
  bh = RS_TAB + floor((rs_pos - bbase) * 512) * 16;
  bl = 0; br = 0;
  bk = 0;
  loop(16,
    bidx = (bbase + bk - 7) & 63;
    bl = (bl + (bh[bk] * RS_HL[bidx]));
    br = (br + (bh[bk] * RS_HR[bidx]));
    bk += 1;
  );
  rs_pos += rs_step;
  rs_pos > 1000000 ? (
    bsh = floor((floor(rs_pos) - 16) / 64) * 64;
    rs_pos -= bsh;
    rs_avail -= bsh;
  );
  (ol_model <= 1 || ol_mono) ? ( bl = (OL_FHALF * (bl + br)); br = bl; );
  bgold ? ( gd_process(bl, br); bl = gd_ol; br = gd_or; );
  bgi = ol_glast === bg ? bg : bgg;
  OUTL[bi] = (bl * bgi);
  OUTR[bi] = (br * bgi);
  bgg = (bgg + binc);
  bi += 1;
);
ol_glast = bg;
spos = 0;

@serialize
file_var(0, g_preset);
sk = 0;
loop(16, sv = OL_GMCH[sk * 4]; file_var(0, sv); file_avail(0) >= 0 ? ( GMSAVE[sk] = sv; gm_restore = 1; ); sk += 1;);

@sample
spl0 = OUTL[spos];
spl1 = OUTR[spos];
spos += 1;
SCOPEL[gs_w] = spl0 + spl1;
gs_w = (gs_w + 1) & 4095;
gm_peakl = max(gm_peakl, abs(spl0));
gm_peakr = max(gm_peakr, abs(spl1));

@gfx 1100 760

CANVW = 1100; CANVH = 760;
z = max(0.4, min(gfx_w / CANVW, gfx_h / CANVH));
ox = floor((gfx_w - CANVW * z) * 0.5);
oy = 0;

function automate(s, e)
(
<?
  max_sliders > 64 ? printf("slider_automate(2^(s-1),e);") :
    loop(i = 1; 64,
      printf("  s == %d ? slider_automate(slider%d, e) :\n", i, i);
      i += 1;
    );
?> 0;
);

function gq_push(a, b, c) ( (gq_w + 1) % 64 != gq_r ? ( GQ[gq_w * 3] = a; GQ[gq_w * 3 + 1] = b; GQ[gq_w * 3 + 2] = c; gq_w = (gq_w + 1) % 64; ); );

// ================================================================ theme (Partiality)

function rgba(r, g, b, a) ( gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; );
function col(c)
(
  c == 0 ? rgba(0.055, 0.060, 0.071, 1)
  : c == 1 ? rgba(0.090, 0.097, 0.112, 1)
  : c == 2 ? rgba(0.133, 0.143, 0.163, 1)
  : c == 3 ? rgba(0.196, 0.208, 0.233, 1)
  : c == 4 ? rgba(0.930, 0.937, 0.949, 1)
  : c == 5 ? rgba(0.620, 0.646, 0.690, 1)
  : c == 6 ? rgba(0.420, 0.446, 0.494, 1)
  : c == 7 ? rgba(0.039, 0.043, 0.052, 1)
  : c == 8 ? rgba(0.165, 0.176, 0.200, 1)
  : rgba(1, 1, 1, 1);
);
C_BG = 0; C_CARD = 1; C_CTRL = 2; C_LINE = 3; C_TEXT = 4; C_TEXT2 = 5; C_TEXT3 = 6; C_SCREEN = 7; C_HOVER = 8;

function acol(a, al)
(
  a == 0 ? rgba(0.937, 0.463, 0.502, al)
  : a == 1 ? rgba(0.388, 0.698, 0.965, al)
  : a == 2 ? rgba(0.945, 0.733, 0.388, al)
  : a == 3 ? rgba(0.612, 0.565, 0.965, al)
  : a == 4 ? rgba(0.333, 0.824, 0.733, al)
  : rgba(0.965, 0.580, 0.420, al);
);
A_PINK = 0; A_SKY = 1; A_LEMON = 2; A_LILAC = 3; A_MINT = 4; A_PEACH = 5;
function amix(a, t) local(r, g, b)
(
  acol(a, 1); r = gfx_r; g = gfx_g; b = gfx_b;
  rgba(0.090 + (r - 0.090) * t, 0.097 + (g - 0.097) * t, 0.112 + (b - 0.112) * t, 1);
);
function opacc(k) ( k == 0 ? A_PINK : k == 1 ? A_SKY : k == 2 ? A_LEMON : A_LILAC; );

function sx(x) ( ox + x * z; );
function sy(y) ( oy + y * z; );
function fnt(n)
(
  n == 1 ? gfx_setfont(1, "Arial", 15 * z, 0)
  : n == 2 ? gfx_setfont(2, "Arial", 16 * z, 0)
  : n == 3 ? gfx_setfont(3, "Arial", 17 * z, 'b')
  : n == 4 ? gfx_setfont(4, "Arial", 24 * z, 'b')
  : n == 5 ? gfx_setfont(5, "Arial", 19 * z, 'b')
  : n == 6 ? gfx_setfont(6, "Arial", 14 * z, 0)
  : n == 8 ? gfx_setfont(8, "Arial", 15 * z, 'b')
  : n == 9 ? gfx_setfont(9, "Arial", 13 * z, 'b')
  : n == 10 ? gfx_setfont(10, "Arial", 30 * z, 'b')
  : n == 11 ? gfx_setfont(11, "Arial", 13 * z, 0)
  : gfx_setfont(7, "Arial", 15 * z, 'b');
);
function frect(x, y, w, h) local(x1, y1, x2, y2)
(
  x1 = floor(sx(x) + 0.5); y1 = floor(sy(y) + 0.5);
  x2 = floor(sx(x + w) + 0.5); y2 = floor(sy(y + h) + 0.5);
  gfx_rect(x1, y1, max(1, x2 - x1), max(1, y2 - y1), 1);
);
function disc(x, y, r) ( gfx_circle(sx(x), sy(y), r * z, 1, 1); );
function ring(x, y, r) ( gfx_circle(sx(x), sy(y), r * z, 0, 1); );
function rr(x, y, w, h, r, fill) local(x1, y1, x2, y2, rp)
(
  x1 = floor(sx(x) + 0.5); y1 = floor(sy(y) + 0.5);
  x2 = floor(sx(x + w) + 0.5); y2 = floor(sy(y + h) + 0.5);
  rp = floor(min(r * z, min(x2 - x1, y2 - y1) / 2) + 0.5);
  fill ? (
    rp < 1 ? gfx_rect(x1, y1, max(1, x2 - x1), max(1, y2 - y1), 1) : (
      gfx_rect(x1 + rp, y1, max(1, x2 - x1 - 2 * rp), y2 - y1, 1);
      gfx_rect(x1, y1 + rp, x2 - x1, max(1, y2 - y1 - 2 * rp), 1);
      gfx_circle(x1 + rp, y1 + rp, rp, 1, 1);
      gfx_circle(x2 - 1 - rp, y1 + rp, rp, 1, 1);
      gfx_circle(x1 + rp, y2 - 1 - rp, rp, 1, 1);
      gfx_circle(x2 - 1 - rp, y2 - 1 - rp, rp, 1, 1);
    );
  ) : gfx_roundrect(x1, y1, x2 - x1 - 1, y2 - y1 - 1, rp, 1);
);
function ln(x1, y1, x2, y2) ( gfx_line(sx(x1), sy(y1), sx(x2), sy(y2), 1); );
function txt_w(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / z; );
function txt(s, x, y, align) local(tw, th)
(
  gfx_measurestr(s, tw, th);
  gfx_x = align == 1 ? sx(x) - tw / 2 : align == 2 ? sx(x) - tw : sx(x);
  gfx_y = sy(y) - th / 2;
  gfx_drawstr(s);
);
function inr(x, y, w, h) ( gmx >= x && gmx < x + w && gmy >= y && gmy < y + h; );
function thick_arc(x, y, r, a0, a1, t) local(i)
(
  i = 0; loop(ceil(t / 0.6), gfx_arc(sx(x), sy(y), (r - i * 0.6) * z, a0, a1, 1); i += 1;);
);
function hint(s) ( gnh = s; );
function thick_line(x1, y1, x2, y2, t) local(i, nx, ny, l)
(
  l = sqrt(sqr(x2 - x1) + sqr(y2 - y1)) + 0.0001;
  nx = -(y2 - y1) / l; ny = (x2 - x1) / l;
  i = -t / 2;
  while (i <= t / 2) (ln(x1 + nx * i, y1 + ny * i, x2 + nx * i, y2 + ny * i); i += 0.5;);
);
function dblclick(id) local(t, d)
(
  t = time_precise();
  d = id == g_lastid && t - g_lastt < 0.32;
  g_lastid = id; g_lastt = t;
  d;
);

// ================================================================ interaction

function ui_frame_begin()
(
  gmdown = mouse_cap & 1;
  gmclick = gmdown && !gpdown;
  gmx = (mouse_x - ox) / z;
  gmy = (mouse_y - oy) / z;
  gwheel = mouse_wheel; mouse_wheel = 0;
  gwid = 0;
  gcur_hint = 0; gnh = 0;
  (!gmdown && gactive > 0 && gactive < 1000) ? automate(gactive, 1);
  !gmdown ? gactive = 0;
);
function ui_frame_end() ( gpdown = gmdown; );
function nid() ( gwid += 1; gwid; );
function take_hint(hot) ( hot && gnh ? gcur_hint = gnh; gnh = 0; );

function set_sl(i, v) (
  v = max(GSMIN[i], min(GSMAX[i], v));
  slider(i) !== v ? ( slider(i) = v; automate(i, 0); );
);
function tap_sl(i, v) ( set_sl(i, v); automate(i, 1); );

function sl_text(i, str) local(v, f) (
  v = slider(i);
  i == 23 ? sprintf(str, "%+.1f cents", v) :
  (i == 18 || i == 19) ? sprintf(str, "%+d dB", v) :
  i == 77 ? sprintf(str, "%+.1f ct", v * 3.125) :
  (i == 78 || i == 79) ? sprintf(str, "%+d st", v) :
  i == 22 ? sprintf(str, "%d dB", v) :
  i == 24 ? sprintf(str, "%d semitones", v) :
  i == 25 ? sprintf(str, "%d %%", floor(v + 0.5)) :
  (i >= 12 && i <= 16) ? (v == 0 ? strcpy(str, "0 dB") : sprintf(str, "-%.2f dB", v * 0.75)) :
  (i >= 26 && i <= 73) || i >= 80 ? (
    f = (i - (i >= 80 ? 80 : 26)) % 12;
    f == 5 ? strcpy(str, v == 0 ? "off" : v == 1 ? "1.5 dB" : v == 2 ? "3 dB" : "6 dB") :
    f == 4 ? (v == 0 ? strcpy(str, "x0.5") : sprintf(str, "x%d", GMUL[v])) :
    f == 6 ? (v == 0 ? strcpy(str, "0 dB") : sprintf(str, "-%.1f dB", v * 0.75)) :
    f == 9 ? sprintf(str, "-%d dB", (v == 15 ? 31 : v) * 3) :
    sprintf(str, "%d", v);
  ) :
  sprintf(str, "%d", v);
);

// ---------------------------------------------------------------- knob

function knob_draw(cx, cy, r, norm, hot, en, bip) local(a0, a1, ang, cap, t)
(
  a0 = -2.4; a1 = 2.4;
  ang = a0 + (a1 - a0) * max(0, min(1, norm));
  t = max(2.4, r * 0.11);
  !en ? col(C_CTRL) : amix(gacc, 0.16);
  thick_arc(cx, cy, r, a0, a1, t);
  !en ? col(C_TEXT3) : acol(gacc, 1);
  bip ? thick_arc(cx, cy, r, min(0, ang), max(0, ang), t) : thick_arc(cx, cy, r, a0, ang, t);
  cap = r - t - 3.5;
  hot ? col(C_HOVER) : col(C_CTRL);
  disc(cx, cy, cap);
  col(C_LINE); ring(cx, cy, cap);
  !en ? col(C_TEXT3) : col(C_TEXT);
  thick_line(cx + sin(ang) * cap * 0.25, cy - cos(ang) * cap * 0.25, cx + sin(ang) * (cap - 1.5), cy - cos(ang) * (cap - 1.5), max(1.5, r * 0.07));
);

function knob(cx, cy, r, i, label, sub, en) local(id, k, hit, hot, rng, st, small)
(
  id = nid();
  k = slider(i);
  rng = GSMAX[i] - GSMIN[i];
  st = GSSTEP[i];
  small = r < 24;
  hit = (gmx - cx) ^ 2 + (gmy - cy) ^ 2 <= (r + 4) ^ 2 || inr(cx - r - 6, cy + r, 2 * r + 12, small ? 26 : 30);
  en ? (
    gmclick && hit ? (
      dblclick(id) ? tap_sl(i, GSDEF[i]) : ( gactive = i; g_dragy = gmy; g_dragv = k; automate(i, 0); );
    );
    gactive == i && gmdown ? (
      mouse_cap |= 65536;
      set_sl(i, floor((g_dragv + (g_dragy - gmy) / ((mouse_cap & 4) ? 1600 : 200) * rng) / st + 0.5) * st);
      k = slider(i);
    );
    hit && gwheel != 0 && !gmdown ? ( tap_sl(i, k + (gwheel > 0 ? 1 : -1) * st * ((rng / st > 40 && !(mouse_cap & 4)) ? 5 : 1)); k = slider(i); );
  );
  hot = en && (hit || gactive == i);
  take_hint(hot);
  knob_draw(cx, cy, r, rng > 0 ? (k - GSMIN[i]) / rng : 0, hot, en, GSMIN[i] < 0 && GSMAX[i] > 0);
  strlen(label) ? (
    small ? fnt(9) : fnt(8); !en ? col(C_TEXT3) : col(C_TEXT2);
    txt(label, cx, cy + r + (small ? 9 : 11), 1);
    small ? fnt(11) : fnt(6); !en ? col(C_TEXT3) : hot ? acol(gacc, 1) : col(C_TEXT3);
    sl_text(i, #gkv);
    txt(#gkv, cx, cy + r + (small ? 22 : 25), 1);
    strlen(sub) ? ( fnt(6); col(C_TEXT3); txt(sub, cx, cy + r + 40, 1); );
  );
);

function toggle(x, y, i, label, en) local(on, hit, w, hot)
(
  on = slider(i) >= 0.5;
  fnt(2);
  w = 36 + txt_w(label);
  hit = inr(x - 2, y - 11, w + 4, 22);
  en && gmclick && hit ? ( tap_sl(i, on ? 0 : 1); on = !on; );
  hot = hit && en;
  take_hint(hot);
  !en ? col(C_LINE) : on ? acol(gacc, 1) : col(C_LINE);
  rr(x, y - 7, 28, 14, 7, 1);
  !en ? col(C_TEXT3) : on ? col(C_TEXT) : col(C_TEXT2);
  disc(on ? x + 21 : x + 7, y, 4.5);
  !en ? col(C_TEXT3) : on || hot ? col(C_TEXT) : col(C_TEXT2);
  txt(label, x + 38, y, 0);
);

function button(x, y, w, h, label, lit) local(hit)
(
  hit = inr(x, y, w, h);
  take_hint(hit);
  lit ? acol(gacc, 1) : hit ? col(C_HOVER) : col(C_CTRL);
  rr(x, y, w, h, 5, 1);
  !lit ? (col(C_LINE); rr(x, y, w, h, 5, 0););
  fnt(8);
  lit ? col(C_BG) : col(C_TEXT);
  txt(label, x + w / 2, y + h / 2, 1);
  gmclick && hit;
);

function choice_str(list, idx, out) local(i, n, c, start, len) (
  n = 0; start = 0; i = 0; len = strlen(list);
  strcpy(out, "");
  while (i <= len) (
    c = i < len ? str_getchar(list, i) : '|';
    c == '|' ? ( n == idx ? strcpy_substr(out, list, start, i - start); n += 1; start = i + 1; );
    i += 1;
  );
  gch_n = n;
  out;
);

function pills_sl(x, y, h, i, list, a, en) local(k, n, tw, hit, px, sel)
(
  choice_str(list, 0, #gpl); n = gch_n;
  px = x;
  fnt(7);
  k = 0;
  loop(n,
    choice_str(list, k, #gpl);
    tw = txt_w(#gpl) + 26;
    hit = inr(px, y, tw, h);
    sel = slider(i) == k;
    en && gmclick && hit ? tap_sl(i, k);
    take_hint(hit && en);
    !en ? ( sel ? col(C_LINE) : col(C_CTRL); ) : sel ? acol(a, 1) : hit ? col(C_HOVER) : col(C_CTRL);
    rr(px, y, tw, h, 5, 1);
    !en ? col(C_TEXT3) : sel ? col(C_BG) : col(C_TEXT2);
    txt(#gpl, px + tw / 2, y + h / 2, 1);
    px += tw + 6;
    k += 1;
  );
);

function card(x, y, w, h, title, a)
(
  col(C_CARD); rr(x, y, w, h, 8, 1);
  col(C_LINE); rr(x, y, w, h, 8, 0);
  gacc = a;
  acol(a, 1); frect(x + 18, y + 19, 3, 12);
  fnt(3); col(C_TEXT);
  txt(title, x + 28, y + 25, 0);
);

function screen(x, y, w, h) local(i)
(
  col(C_SCREEN); rr(x, y, w, h, 6, 1);
  rgba(1, 1, 1, 0.03);
  i = 1; loop(3, frect(x + 8, y + h * i / 4, w - 16, 1); i += 1;);
  i = 1; loop(7, frect(x + w * i / 8, y + 8, 1, h - 16); i += 1;);
);

// ================================================================ OPL displays

function wave_shape(wf, x, y, w, h, a, al) local(k, p, v, px, py, n)
(
  n = max(8, floor(w * z));
  acol(a, al);
  k = 0;
  loop(n + 1,
    p = floor(k / n * 1023);
    v = OL_LSW[wf * 1024 + p];
    v = v >= 0 ? (v >= 4096 ? 0 : 10 ^ (-v * 0.000390625)) : ((-v - 1) >= 4096 ? 0 : -(10 ^ ((v + 1) * 0.000390625)));
    px = sx(x) + k * w * z / n; py = sy(y + h / 2) - v * h * 0.42 * z;
    k == 0 ? ( gfx_x = px; gfx_y = py; ) : ( gfx_lineto(px, py, 1); gfx_lineto(px, py + 1, 1); );
    k += 1;
  );
);

function alg_graph(four, alg) local(k) (
  !four ? (
    (alg & 1) == 0 ? (
      gal_c = 1; gal_r = 2; GNX[1] = 0; GNR[1] = 1; GNX[2] = 0; GNR[2] = 0; GEDN = 1; GEDF[0] = 1; GEDT[0] = 2; gal_car = 2;
    ) : (
      gal_c = 2; gal_r = 1; GNX[1] = 0; GNR[1] = 0; GNX[2] = 1; GNR[2] = 0; GEDN = 0; gal_car = 3;
    );
    gal_n = 2;
  ) : (
    gal_n = 4;
    alg == 0 ? (
      gal_c = 1; gal_r = 4; k = 1; loop(4, GNX[k] = 0; GNR[k] = 4 - k; k += 1;);
      GEDN = 3; GEDF[0] = 1; GEDT[0] = 2; GEDF[1] = 2; GEDT[1] = 3; GEDF[2] = 3; GEDT[2] = 4; gal_car = 8;
    ) : alg == 1 ? (
      gal_c = 2; gal_r = 2; GNX[1] = 0; GNR[1] = 1; GNX[2] = 0; GNR[2] = 0; GNX[3] = 1; GNR[3] = 1; GNX[4] = 1; GNR[4] = 0;
      GEDN = 2; GEDF[0] = 1; GEDT[0] = 2; GEDF[1] = 3; GEDT[1] = 4; gal_car = 10;
    ) : alg == 2 ? (
      gal_c = 2; gal_r = 3; GNX[1] = 0; GNR[1] = 0; GNX[2] = 1; GNR[2] = 2; GNX[3] = 1; GNR[3] = 1; GNX[4] = 1; GNR[4] = 0;
      GEDN = 2; GEDF[0] = 2; GEDT[0] = 3; GEDF[1] = 3; GEDT[1] = 4; gal_car = 9;
    ) : (
      gal_c = 3; gal_r = 2; GNX[1] = 0; GNR[1] = 0; GNX[2] = 1; GNR[2] = 1; GNX[3] = 1; GNR[3] = 0; GNX[4] = 2; GNR[4] = 0;
      GEDN = 1; GEDF[0] = 2; GEDT[0] = 3; gal_car = 13;
    );
  );
);

function alg_draw(x, y, w, h, four, alg, labels, en) local(cell, bx, orx, ory, k, a, b, c, ym, busy, bl, brr, xr, yt, t)
(
  alg_graph(four, alg);
  cell = min(w / (gal_c + 0.5), h / (gal_r + 0.7));
  bx = cell * 0.62;
  orx = x + w / 2 - cell * (gal_c + 0.5) * 0.5;
  ory = y + h / 2 - cell * (gal_r + 0.7) * 0.5;
  k = 1; loop(gal_n, GCX[k] = orx + cell * (GNX[k] + 0.5); GCY[k] = ory + cell * ((gal_r - 1 - GNR[k]) + 0.5); k += 1;);
  t = max(1, cell * 0.035);
  en ? col(C_TEXT2) : col(C_TEXT3);
  k = 0;
  loop(GEDN,
    a = GEDF[k]; b = GEDT[k];
    ym = GCY[b] - bx * 0.5 - (cell - bx) * 0.5;
    thick_line(GCX[a], GCY[a] + bx * 0.5, GCX[a], ym, t);
    thick_line(GCX[a], ym, GCX[b], ym, t);
    thick_line(GCX[b], ym, GCX[b], GCY[b] - bx * 0.5, t);
    k += 1;
  );
  busy = ory + cell * (gal_r + 0.25);
  bl = 100000; brr = -100000;
  k = 1;
  loop(gal_n,
    (gal_car >> (k - 1)) & 1 ? ( thick_line(GCX[k], GCY[k] + bx * 0.5, GCX[k], busy, t); bl = min(bl, GCX[k]); brr = max(brr, GCX[k]); );
    k += 1;
  );
  thick_line(bl, busy, brr, busy, t);
  c = (bl + brr) * 0.5;
  thick_line(c, busy, c, busy + cell * 0.25, t);
  gfx_triangle(sx(c - cell * 0.08), sy(busy + cell * 0.22), sx(c + cell * 0.08), sy(busy + cell * 0.22), sx(c), sy(busy + cell * 0.36));
  xr = GCX[1] + bx * 0.5 + (cell - bx) * 0.45;
  yt = GCY[1] - bx * 0.5 - (cell - bx) * 0.3;
  en ? acol(A_PEACH, 1) : col(C_TEXT3);
  thick_line(GCX[1] + bx * 0.5, GCY[1], xr, GCY[1], t);
  thick_line(xr, GCY[1], xr, yt, t);
  thick_line(xr, yt, GCX[1], yt, t);
  thick_line(GCX[1], yt, GCX[1], GCY[1] - bx * 0.5, t);
  k = 1;
  loop(gal_n,
    en ? ( (gal_car >> (k - 1)) & 1 ? amix(opacc(k - 1 + g_algc), 0.45) : amix(opacc(k - 1 + g_algc), 0.16); ) : col(C_CTRL);
    rr(GCX[k] - bx / 2, GCY[k] - bx / 2, bx, bx, bx * 0.18, 1);
    en ? acol(opacc(k - 1 + g_algc), 1) : col(C_LINE);
    rr(GCX[k] - bx / 2, GCY[k] - bx / 2, bx, bx, bx * 0.18, 0);
    labels ? (
      gfx_setfont(12, "Arial", max(9, min(26, bx * 0.5)) * z, 'b');
      en ? col(C_TEXT) : col(C_TEXT3);
      sprintf(#gal, "%d", k); txt(#gal, GCX[k], GCY[k], 1);
    );
    k += 1;
  );
);

// envelope (KoniSynth StageEnvView with EngineEnv::oplOperator: chip rates, times at C4 with KSR)

function env_full(reg, ksr, base) local(rate) (
  reg == 0 ? -1 : (
    rate = min(63, 4 * reg + (ksr ? 8 : 2));
    base * (2 ^ (1 - (rate >> 2))) / (1 + (rate & 3) / 4);
  );
);
function env_part(full, units) ( units <= 0 ? 0 : full < 0 ? -1 : full * units / 504; );
function env_amp(u) ( u >= 504 ? 0 : 10 ^ (-0.1875 * u / 20); );

function env_stages(op, ar, dr, sl, rr, egt, ksr) local(e, slu, ra, ta, td, tr, hold, from) (
  e = GENV + op * 32;
  slu = (sl == 15 ? 31 : sl) * 16;
  ra = min(63, 4 * ar + (ksr ? 8 : 2));
  ta = ar == 0 ? -1 : ra >= 60 ? 0 : env_full(ar, ksr, 2.8425);
  td = env_part(env_full(dr, ksr, 41.482), slu);
  tr = env_full(rr, ksr, 41.482);
  e[0] = ta; e[1] = 0.22; e[2] = 2.85; e[3] = 0; e[4] = ar;
  e[7] = td < 0 ? 41.5 : td; e[8] = 0.28; e[9] = 41.5; e[10] = 0; e[11] = td < 0; e[12] = slu;
  hold = td < 0 ? 0 : slu;
  egt ? ( e[14] = 0; e[15] = 0.16; e[16] = 0; e[17] = 1; e[18] = hold; e[19] = hold; )
      : ( e[14] = env_part(tr, 504 - hold); e[15] = 0.16; e[16] = 41.5; e[17] = 0; e[18] = hold; e[19] = 504; );
  from = egt ? hold : 504;
  e[21] = from >= 504 ? tr : env_part(tr, 504 - from); e[22] = 0.32; e[23] = 41.5; e[24] = 0; e[25] = from; e[26] = 504;
  e[28] = ta; e[29] = td; e[30] = tr;
);

function env_level(op, s, f) local(e) (
  e = GENV + op * 32;
  s == 0 ? ( e[4] == 0 ? 0 : env_amp(GATK[floor(f * (g_natk - 1) + 0.5)]); ) :
  s == 1 ? ( e[11] ? 1 : env_amp(e[12] * f); ) :
  s == 2 ? env_amp(e[18] + (e[19] - e[18]) * f) :
  env_amp(e[25] + (e[26] - e[25]) * f);
);

function env_width(op, s, pw) local(e, b, sec) (
  e = GENV + op * 32; b = s * 7;
  e[b + 3] ? pw * e[b + 1] : (
    sec = e[b] < 0 ? e[b + 2] : max(0, min(e[b + 2], e[b]));
    pw * e[b + 1] * log(1 + sec / 0.001) / log(1 + e[b + 2] / 0.001);
  );
);

function env_ttext(t, str) ( t < 0 ? strcpy(str, "never") : t < 1 ? sprintf(str, "%d ms", floor(t * 1000 + 0.5)) : sprintf(str, "%.2f s", t); );

function env_view(op, b, x, y, w, h, en, a) local(si, ar, dr, sl, rr, egt, ksr, px0, pw, pt, pb, ex, s, j, f, lv, X0, Y0, Y1, hx, hy, best, bd, d, cand, kk, hov)
(
  ar = slider(b + 7); dr = slider(b + 8); sl = slider(b + 9); rr = slider(b + 10); egt = slider(b + 2) >= 0.5; ksr = slider(b + 3) >= 0.5;
  env_stages(op, ar, dr, sl, rr, egt, ksr);
  screen(x, y, w, h);
  px0 = x + 10; pw = w - 20; pt = y + 24; pb = y + h - 8;
  ex = px0;
  GEX[op * 5] = ex;
  s = 0;
  loop(4, ex += env_width(op, s, pw); GEX[op * 5 + s + 1] = ex; s += 1;);
  s = 0;
  X0 = floor(sx(px0));
  loop(floor(sx(px0 + pw)) - X0,
    j = (X0 - ox) / z;
    while (s < 3 && j > GEX[op * 5 + s + 1]) ( s += 1; );
    f = GEX[op * 5 + s + 1] > GEX[op * 5 + s] ? (j - GEX[op * 5 + s]) / (GEX[op * 5 + s + 1] - GEX[op * 5 + s]) : 1;
    lv = env_level(op, s, max(0, min(1, f)));
    Y1 = sy(pb - lv * (pb - pt));
    en ? acol(a, 0.10) : col(C_CTRL); gfx_line(X0, Y1, X0, sy(pb));
    X0 > floor(sx(px0)) ? (
      en ? acol(a, 0.25) : col(C_TEXT3); gfx_line(X0 - 1, Y0 + 1.5, X0, Y1 + 1.5, 1);
      en ? acol(a, 1) : col(C_TEXT3); gfx_line(X0 - 1, Y0, X0, Y1, 1); gfx_line(X0 - 1, Y0 + 0.7, X0, Y1 + 0.7, 1);
    );
    Y0 = Y1;
    X0 += 1;
  );
  env_stages(op, ar, dr, sl, rr, egt, ksr);
  fnt(11); en ? col(C_TEXT2) : col(C_TEXT3);
  env_ttext(GENV[op * 32 + 28], #gea); env_ttext(GENV[op * 32 + 29], #geb); env_ttext(GENV[op * 32 + 30], #gec);
  sprintf(#ge, "A %s   D %s   R %s", #gea, #geb, #gec); txt(#ge, x + 10, y + 12, 0);
  sprintf(#ge, "SL -%d dB%s", (sl == 15 ? 31 : sl) * 3, egt ? "" : "  ·  no EGT"); txt(#ge, x + w - 10, y + 12, 2);
  en ? (
    kk = 0;
    loop(3,
      hx = GEX[op * 5 + (kk == 0 ? 1 : kk == 1 ? 2 : 4)];
      hy = kk == 0 ? pb - env_level(op, 0, 1) * (pb - pt) : kk == 1 ? pb - env_level(op, 1, 1) * (pb - pt) : pb - env_level(op, 3, 1) * (pb - pt);
      hov = inr(hx - 7, hy - 7, 14, 14);
      si = b + (kk == 0 ? 7 : kk == 1 ? 8 : 10);
      gmclick && hov ? ( gactive = 1000 + op * 4 + kk; automate(si, 0); kk == 1 ? automate(b + 9, 0); );
      hint(kk == 0 ? "Attack Rate: drag left and right." : kk == 1 ? "Decay Rate (left and right) and Sustain Level (up and down)." : "Release Rate: drag left and right.");
      take_hint(hov);
      (hov || gactive == 1000 + op * 4 + kk) ? ( acol(a, 0.3); disc(hx, hy, 8); );
      col(C_TEXT); disc(hx, hy, 4); acol(a, 1); ring(hx, hy, 4.5);
      kk += 1;
    );
    (gactive >= 1000 && floor((gactive - 1000) / 4) == op && gmdown) ? (
      mouse_cap |= 65536;
      kk = (gactive - 1000) % 4;
      si = b + (kk == 0 ? 7 : kk == 1 ? 8 : 10);
      best = slider(si); bd = 1000000;
      cand = 0;
      loop(16,
        env_stages(op, kk == 0 ? cand : ar, kk == 1 ? cand : dr, sl, kk == 2 ? cand : rr, egt, ksr);
        ex = px0; s = 0;
        loop(kk == 0 ? 1 : kk == 1 ? 2 : 4, ex += env_width(op, s, pw); s += 1;);
        d = abs(ex - gmx);
        d < bd - 0.0001 ? ( bd = d; best = cand; );
        cand += 1;
      );
      set_sl(si, best);
      kk == 1 ? (
        best = sl; bd = 1000000; cand = 0;
        loop(16,
          d = abs(pb - env_amp((cand == 15 ? 31 : cand) * 16) * (pb - pt) - gmy);
          d < bd - 0.0001 ? ( bd = d; best = cand; );
          cand += 1;
        );
        set_sl(b + 9, best);
      );
    );
    (!gmdown && gpdown && g_edown >= 1000 && floor((g_edown - 1000) / 4) == op) ? (
      kk = (g_edown - 1000) % 4;
      automate(b + (kk == 0 ? 7 : kk == 1 ? 8 : 10), 1); kk == 1 ? automate(b + 9, 1);
    );
  );
  hint("The operator's envelope with the chip's own rates (times at middle C, with KSR). Drag the dots.");
  take_hint(inr(x, y, w, h) && en);
);

// ================================================================ presets

function reset_defaults() local(i) ( i = 1; loop(103, tap_sl(i, GSDEF[i]); i += 1;); );

function load_factory(p) local(b, n, k) (
  reset_defaults();
  b = GFP + p * 64;
  n = b[0];
  k = 0; loop(n, tap_sl(b[1 + k * 2], b[2 + k * 2]); k += 1;);
  g_preset = p;
);

function dmx_op(b, s) (
  tap_sl(s + 0, (b[0] & 0x80) ? 1 : 0); tap_sl(s + 1, (b[0] & 0x40) ? 1 : 0);
  tap_sl(s + 2, (b[0] & 0x20) ? 1 : 0); tap_sl(s + 3, (b[0] & 0x10) ? 1 : 0);
  tap_sl(s + 4, b[0] & 0x0f);
  tap_sl(s + 5, OL_KSLIDX[(b[4] >> 6) & 3]);
  tap_sl(s + 6, b[5] & 0x3f);
  tap_sl(s + 7, b[1] >> 4); tap_sl(s + 8, b[1] & 0x0f);
  tap_sl(s + 9, b[2] >> 4); tap_sl(s + 10, b[2] & 0x0f);
  tap_sl(s + 11, b[3] & 7);
);

function load_dmx(ins) local(b, d) (
  reset_defaults();
  b = OL_GMB + ins * 32;
  d = b + 3;
  tap_sl(1, 2);
  tap_sl(4, d[6] & 1);
  tap_sl(5, (d[6] >> 1) & 7);
  dmx_op(d, 26);
  dmx_op(d + 7, 38);
  tap_sl(38 + 6, 0);
  tap_sl(78, d[13] + 12);
  (b[0] & 4) ? (
    d = b + 17;
    tap_sl(74, 1);
    tap_sl(75, d[6] & 1);
    tap_sl(76, (d[6] >> 1) & 7);
    dmx_op(d, 80);
    dmx_op(d + 7, 92);
    tap_sl(92 + 6, 0);
    tap_sl(77, floor(b[1] / 2) - 64);
    tap_sl(79, d[13] + 12);
  );
  g_preset = 100 + ins;
);

function preset_step(dir) local(p) (
  g_preset < 100 ? (
    p = g_preset + dir;
    p < 0 ? load_dmx(174) : p > 5 ? load_dmx(0) : load_factory(p);
  ) : (
    p = g_preset - 100 + dir;
    p < 0 ? load_factory(5) : p > 174 ? load_factory(0) : load_dmx(p);
  );
);

function preset_menu() local(k, f, r) (
  strcpy(#gm, ">KoniSynth OPL presets|");
  k = 0; loop(6, k == 5 ? strcat(#gm, "<"); g_preset == k ? strcat(#gm, "!"); strcat(#gm, GFNAME + k); strcat(#gm, "|"); k += 1;);
  f = 0;
  loop(16,
    strcat(#gm, ">DMXOPL3: "); strcat(#gm, GMFAM + f); strcat(#gm, "|");
    k = 0;
    loop(8, k == 7 ? strcat(#gm, "<"); g_preset == 100 + f * 8 + k ? strcat(#gm, "!"); strcat(#gm, GMNAME + f * 8 + k); strcat(#gm, "|"); k += 1;);
    f += 1;
  );
  strcat(#gm, ">DMXOPL3: Percussion|");
  k = 0; loop(47, k == 46 ? strcat(#gm, "<"); g_preset == 228 + k ? strcat(#gm, "!"); strcat(#gm, GMNAME + 128 + k); strcat(#gm, "|"); k += 1;);
  gfx_x = sx(436); gfx_y = sy(59);
  r = gfx_showmenu(#gm);
  (r >= 1 && r <= 6) ? load_factory(r - 1) : (r >= 7 && r <= 181) ? load_dmx(r - 7);
  gmdown = 0; gpdown = 0; gmclick = 0;
);

function preset_name(s) (
  g_preset < 0 ? strcpy(s, "Init") : g_preset < 100 ? strcpy(s, GFNAME + g_preset) : strcpy(s, GMNAME + g_preset - 100);
);
function preset_kind(s) (
  g_preset < 0 ? strcpy(s, "Starting point") :
  g_preset < 100 ? strcpy(s, "KoniSynth preset") :
  g_preset < 228 ? sprintf(s, "DMXOPL3 bank  ·  %s  ·  program %d", GMFAM + floor((g_preset - 100) / 8), g_preset - 99) :
  sprintf(s, "DMXOPL3 bank  ·  Percussion  ·  note %d", g_preset - 228 + 35);
);

// ================================================================ frame parts

function logo(x, y) local(i, px, py, t)
(
  col(C_LINE); ring(x, y, 16); ring(x, y, 15.5);
  acol(A_PEACH, 1);
  i = 0;
  loop(41,
    t = i / 40;
    px = x - 11 + t * 22;
    py = y - sin(2 * $pi * t + 1.6 * sin(4 * $pi * t)) * 6.5;
    i == 0 ? (gfx_x = sx(px); gfx_y = sy(py);) : (gfx_lineto(sx(px), sy(py), 1); gfx_lineto(sx(px), sy(py) + 1, 1););
    i += 1;
  );
);

function topbar() local(i, v, hp, tw)
(
  col(C_CARD); frect(0, 0, CANVW, 70);
  col(C_LINE); frect(0, 70, CANVW, 1);
  logo(44, 35);
  fnt(4); col(C_TEXT); txt("OFF THE CUFF", 70, 29, 0);
  fnt(6); col(C_TEXT3); txt("ADLIB / SOUND BLASTER FM  ·  KONISYNTH", 71, 49, 0);
  hint("Click to pick a sound: KoniSynth's OPL presets or any instrument of the DMXOPL3 bank. The arrows step through them.");
  hp = inr(436, 11, 440, 48);
  take_hint(hp);
  hp ? col(C_HOVER) : col(C_CTRL); rr(436, 11, 440, 48, 6, 1);
  col(C_LINE); rr(436, 11, 440, 48, 6, 0);
  preset_name(#gpn);
  fnt(5); txt_w(#gpn) > 360 ? fnt(8);
  txt_w(#gpn) > 360 ? fnt(11);
  col(C_TEXT); txt(#gpn, 656, 28, 1);
  fnt(6); acol(g_preset < 0 ? A_LILAC : g_preset < 100 ? A_PEACH : A_SKY, 1); preset_kind(#gpk); txt(#gpk, 656, 47, 1);
  inr(838, 17, 30, 36) ? col(C_TEXT) : col(C_TEXT2);
  ln(850, 29, 856, 35); ln(856, 35, 850, 41);
  inr(444, 17, 30, 36) ? col(C_TEXT) : col(C_TEXT2);
  ln(462, 29, 456, 35); ln(456, 35, 462, 41);
  gmclick ? (
    inr(444, 17, 30, 36) ? preset_step(-1) :
    inr(838, 17, 30, 36) ? preset_step(1) :
    hp ? preset_menu();
  );
  gacc = A_LILAC;
  hint("Init: every control back to its default.");
  button(890, 21, 56, 28, "Init", 0) ? ( reset_defaults(); g_preset = -1; );
  gacc = A_LILAC;
  hint("Output level (KoniSynth's master Gain).");
  knob(1000, 33, 17, 25, "", "", 1);
  fnt(6); col(C_TEXT3); txt("OUTPUT", 1000, 62, 1);
  g_ml = max(g_ml * 0.85, gm_peakl); g_mr = max(g_mr * 0.85, gm_peakr); gm_peakl = 0; gm_peakr = 0;
  i = 0;
  loop(2,
    v = i == 0 ? g_ml : g_mr;
    v = max(0, min(1, (20 * log10(max(v, 0.00001)) + 60) / 60));
    col(C_CTRL); rr(1036 + i * 9, 14, 4, 42, 2, 1);
    v > 0.95 ? acol(A_PINK, 1) : acol(A_MINT, 1);
    v > 0.02 ? rr(1036 + i * 9, 14 + 42 * (1 - v), 4, 42 * v, 2, 1);
    i += 1;
  );
  fnt(7);
  v = 24; i = 0;
  loop(5,
    choice_str("Play|Operators|Rhythm & GM|AdLib Gold|Settings", i, #gpl);
    tw = txt_w(#gpl) + 26;
    hp = inr(v, 82, tw, 34);
    gmclick && hp ? g_page = i;
    g_page == i ? acol(A_LILAC, 1) : hp ? col(C_HOVER) : col(C_CTRL);
    rr(v, 82, tw, 34, 5, 1);
    g_page == i ? col(C_BG) : col(C_TEXT2);
    txt(#gpl, v + tw / 2, 99, 1);
    v += tw + 6;
    i += 1;
  );
  fnt(6); col(C_TEXT3);
  sprintf(#gst, "%s  ·  %s", gmodel == 0 ? "YM3526" : gmodel == 1 ? "YM3812" : "YMF262",
          ggm ? "Multitimbral GM, 18 channels" : gv2 ? (gmodel == 2 ? (grh ? "2 voices per note, 7 notes + rhythm" : "2 voices per note, 9 notes") : (grh ? "2 voices per note, 3 notes + rhythm" : "2 voices per note, 4 notes")) : gfour ? (grh ? "4-operator, 6 voices + rhythm" : "4-operator, 6 voices") : grh ? (gmodel == 2 ? "rhythm + 15 voices" : "rhythm + 6 voices") : (gmodel == 2 ? "2-operator, 18 voices" : "2-operator, 9 voices"));
  txt(#gst, 1076, 99, 2);
);

function hintbar() local(s)
(
  col(C_LINE); frect(24, 730, 1052, 1);
  acol(A_MINT, 1); disc(30, 744, 2.5);
  fnt(2); col(C_TEXT2);
  s = gcur_hint ? gcur_hint
    : g_page == 0 ? "Pick a chip and a sound, then play the keyboard (or your MIDI controller)."
    : g_page == 1 ? "Operators are sine-based oscillators with their own envelopes. Modulators bend the carriers' phase; carriers are what you hear."
    : g_page == 2 ? "Rhythm mode turns three chip channels into a drum kit on MIDI channel 10. Multitimbral plays General MIDI like DOS games did."
    : g_page == 3 ? "The AdLib Gold 1000 (1992) put a tone and stereo chip (TDA8425) and a surround module (YM7128B) behind its OPL3."
    : "Chip-wide settings: LFO depths, output, velocity and tuning.";
  txt(s, 40, 744, 0);
);

function white_note(i) local(d) ( d = i % 7; floor(i / 7) * 12 + (d == 0 ? 0 : d == 1 ? 2 : d == 2 ? 4 : d == 3 ? 5 : d == 4 ? 7 : d == 5 ? 9 : 11); );
function black_slot(pc) ( pc == 1 ? 1 : pc == 3 ? 2 : pc == 6 ? 4 : pc == 8 ? 5 : pc == 10 ? 6 : 0; );

function keyboard(x, y, w, h, base, oct) local(nw, ww, i, n, kx, pc, hitn, bw, bh, on)
(
  nw = oct * 7 + 1; ww = w / nw;
  bw = ww * 0.62; bh = h * 0.6;
  hitn = -1;
  i = 0;
  loop(oct * 12,
    pc = i % 12;
    black_slot(pc) ? ( kx = x + (floor(i / 12) * 7 + black_slot(pc)) * ww - bw / 2; inr(kx, y, bw, bh) ? hitn = base + i; );
    i += 1;
  );
  hitn < 0 ? (i = 0; loop(nw, inr(x + i * ww, y, ww, h) ? hitn = base + white_note(i); i += 1;););
  gactive == 0 ? (
    gmclick && hitn >= 0 ? ( gq_push(0x90, hitn, 100); g_kbn = hitn; );
    gmdown && g_kbn >= 0 && hitn >= 0 && hitn != g_kbn ? ( gq_push(0x80, g_kbn, 0); gq_push(0x90, hitn, 100); g_kbn = hitn; );
  );
  i = 0;
  loop(nw,
    n = base + white_note(i);
    on = KEYL[n] || n == g_kbn;
    on ? acol(A_MINT, 1) : rgba(0.86, 0.87, 0.89, 1);
    rr(x + i * ww + 1, y, ww - 2, h, 3, 1);
    (i % 7 == 0 && ww > 12) ? ( fnt(11); col(C_TEXT3); sprintf(#gkn, "C%d", floor(n / 12) - 1); txt(#gkn, x + i * ww + ww / 2, y + h - 10, 1); );
    i += 1;
  );
  i = 0;
  loop(oct * 12,
    n = base + i; pc = i % 12;
    black_slot(pc) ? (
      kx = x + (floor(i / 12) * 7 + black_slot(pc)) * ww - bw / 2;
      KEYL[n] || n == g_kbn ? acol(A_MINT, 1) : rgba(0.10, 0.105, 0.12, 1);
      rr(kx, y, bw, bh, 2.5, 1);
    );
    i += 1;
  );
);

function draw_scope(x, y, w, h) local(i, st, n, v, px, py, k, pk)
(
  screen(x, y, w, h);
  n = 900;
  st = gs_w - 2 * n; st < 0 ? st += 4096;
  i = 0;
  while (i < n && !(SCOPEL[(st + i) % 4096] <= 0 && SCOPEL[(st + i + 1) % 4096] > 0)) (i += 1;);
  st = (st + i) % 4096;
  pk = 0.02; i = 0; loop(n, pk = max(pk, abs(SCOPEL[(st + i) % 4096])); i += 1;);
  g_scg = g_scg * 0.9 + 0.1 / pk;
  k = 0;
  loop(2,
    k == 0 ? acol(A_MINT, 0.25) : acol(A_MINT, 1);
    i = 0;
    loop(n / 3,
      v = SCOPEL[(st + i * 3) % 4096];
      px = x + 8 + (w - 16) * i / (n / 3 - 1);
      py = y + h / 2 - max(-1, min(1, v * g_scg * 0.9)) * (h / 2 - 10) + (k == 0 ? 1.5 : 0);
      i == 0 ? (gfx_x = sx(px); gfx_y = sy(py);) : gfx_lineto(sx(px), sy(py), 1);
      i += 1;
    );
    k += 1;
  );
);

function slim_keys() (
  col(C_CARD); rr(24, 658, 1052, 64, 8, 1); col(C_LINE); rr(24, 658, 1052, 64, 8, 0);
  hint("Click and drag across the keys to audition. Your MIDI keyboard works too.");
  take_hint(inr(36, 666, 1028, 48));
  keyboard(36, 666, 1028, 48, 24, 7);
);

// ================================================================ pages

function chip_tile(x, y, w, h, m, a, name, chip, used, spec) local(sel, hit)
(
  sel = gmodel == m;
  hit = inr(x, y, w, h);
  gmclick && hit ? tap_sl(1, m);
  hint(m == 0 ? "YM3526 (1984): arcade boards and the C64 Sound Expander. The OPL2 without waveform select: every operator is a sine."
     : m == 1 ? "YM3812 (1985): the AdLib and Sound Blaster 1.0-2.0. Four waveforms, mono, through the grainy YM3014 DAC."
     : "YMF262 (1990): the Sound Blaster Pro 2 and 16. Eight waveforms, 18 channels or 6 four-operator voices, stereo.");
  take_hint(hit);
  sel ? amix(a, 0.20) : hit ? col(C_HOVER) : col(C_CTRL);
  rr(x, y, w, h, 8, 1);
  sel ? acol(a, 1) : col(C_LINE); rr(x, y, w, h, 8, 0);
  fnt(10); sel ? acol(a, 1) : col(C_TEXT2); txt(name, x + 20, y + 28, 0);
  fnt(8); sel ? col(C_TEXT) : col(C_TEXT2); txt(chip, x + 20, y + 56, 0);
  fnt(6); col(C_TEXT3); txt(used, x + 20, y + 76, 0); txt(spec, x + 20, y + 95, 0);
  wave_shape(m == 0 ? 0 : m == 1 ? 3 : 6, x + w - 74, y + 14, 56, 30, a, sel ? 1 : 0.3);
);

function page_play() local(cx, sp)
(
  card(24, 122, 1052, 172, "Sound chip", A_PEACH);
  chip_tile(40, 156, 248, 122, 0, A_MINT, "OPL", "Yamaha YM3526", "arcade, C64 Sound Expander", "9 voices · sine only · mono");
  chip_tile(300, 156, 248, 122, 1, A_SKY, "OPL2", "Yamaha YM3812", "AdLib, Sound Blaster 1.0-2.0", "9 voices · 4 waves · mono");
  chip_tile(560, 156, 248, 122, 2, A_PEACH, "OPL3", "Yamaha YMF262", "Sound Blaster Pro 2 and 16", "18 voices · 8 waves · stereo");
  gacc = A_PEACH;
  hint("OPL3 only: pairs of channels become 6 four-operator voices with 4 algorithms.");
  toggle(832, 180, 2, "4-operator voices", gmodel == 2 && !ggm);
  gacc = A_LEMON;
  hint("Rhythm mode (register BDh): chip channels 6-8 become bass drum, snare, tom, cymbal and hi-hat on MIDI channel 10.");
  toggle(832, 216, 11, "Rhythm mode", !ggm);
  gacc = A_LILAC;
  hint("OPL3 only: General MIDI on 16 channels with the DMX driver (Doom, Heretic, Hexen) and the DMXOPL3 bank.");
  toggle(832, 252, 3, "Multitimbral GM", gmodel == 2);

  card(24, 306, 1052, 230, "Quick controls", A_PINK);
  fnt(6); col(C_TEXT3); txt("each knob is a chip register, named underneath", 200, 331, 0);
  sp = 175; cx = 24 + sp / 2;
  hint("How the operators connect: FM (one modulates the next) or AM (added). With 4 operators there are 4 algorithms.");
  knob(cx, 414, 40, 4, "Algorithm", "connection (C0h)", !ggm); cx += sp;
  hint("OP1 modulating itself: from a pure tone at 0 to a bright, buzzy, noisy one at 7.");
  knob(cx, 414, 40, 5, "Feedback", "OP1 feedback (C0h)", !ggm); cx += sp;
  gacc = A_SKY;
  hint("The modulator's level: less attenuation means more modulation and a brighter sound.");
  knob(cx, 414, 40, 26 + 6, "Brightness", "OP1 total level", !ggm); cx += sp;
  hint("The modulator's frequency multiple: which harmonics the modulation adds.");
  knob(cx, 414, 40, 26 + 4, "Timbre", "OP1 multiple", !ggm); cx += sp;
  gacc = A_MINT;
  hint("How fast the carrier fades in (15 = instant).");
  knob(cx, 414, 40, 38 + 7, "Attack", "OP2 attack rate", !ggm); cx += sp;
  hint("How fast the carrier fades after you let go.");
  knob(cx, 414, 40, 38 + 10, "Release", "OP2 release rate", !ggm);

  card(24, 548, 1052, 174, "Try it", A_MINT);
  draw_scope(40, 584, 280, 124);
  hint("Click and drag across the keys to play. Your MIDI keyboard works too.");
  take_hint(inr(336, 584, 724, 124));
  keyboard(336, 584, 724, 124, g_kbase, 3);
  fnt(8); col(C_TEXT2); txt("Octave", 900, 565, 0);
  gacc = A_MINT;
  hint("Shift the on-screen keyboard down an octave");
  button(960, 553, 44, 24, "-", 0) && g_kbase > 12 ? g_kbase -= 12;
  hint("Shift the on-screen keyboard up an octave");
  button(1012, 553, 44, 24, "+", 0) && g_kbase < 84 ? g_kbase += 12;
);

function op_card(k, x, y, w, h) local(a, b, en, car, kx, sp, i, tx, hit, sel, wmax, fl, v2c)
(
  a = opacc(k);
  v2c = !gfour && k >= 2;
  b = v2c ? 80 + (k - 2) * 12 : 26 + k * 12;
  en = !ggm && (v2c ? gv2 : (k < 2 || gfour));
  car = v2c ? (slider(75) >= 0.5 || k == 3) : (gal_car >> k) & 1;
  col(C_CARD); rr(x, y, w, h, 8, 1);
  en && car ? acol(a, 0.55) : col(C_LINE); rr(x, y, w, h, 8, 0);
  gacc = a;
  acol(a, en ? 1 : 0.35); frect(x + 18, y + 19, 3, 12);
  fnt(3); en ? col(C_TEXT) : col(C_TEXT3);
  v2c ? sprintf(#gop, "V2 OP%d", k - 1) : sprintf(#gop, "OP%d", k + 1);
  txt(#gop, x + 28, y + 25, 0);
  fnt(9); en && car ? acol(a, 1) : col(C_TEXT3);
  txt(car ? "CARRIER" : "MODULATOR", x + (v2c ? 100 : 72), y + 25, 0);
  !en ? ( fnt(6); col(C_TEXT3); txt(ggm ? "set by the DMXOPL3 bank in GM mode" : v2c ? "Voice 2 is off (Algorithm column)" : "4-operator mode only (OPL3)", x + w - 16, y + 25, 2); );
  env_view(k, b, x + 16, y + 42, w - 32, 82, en, a);
  sp = (w - 32) / 7; kx = x + 16 + sp / 2;
  hint("Total Level: attenuation in 0.75 dB steps. On a modulator it sets the brightness.");
  knob(kx, y + 152, 14, b + 6, "TL", "", en); kx += sp;
  hint("Frequency multiple: 0 = x0.5, then 1-10, 12, 15 (11 and 13 give 10 and 12, as on the chip).");
  knob(kx, y + 152, 14, b + 4, "MULT", "", en); kx += sp;
  hint("Key Scale Level: attenuation that grows with pitch.");
  knob(kx, y + 152, 14, b + 5, "KSL", "", en); kx += sp;
  hint("Attack Rate (15 = instant).");
  knob(kx, y + 152, 14, b + 7, "AR", "", en); kx += sp;
  hint("Decay Rate, from full level down to the sustain level.");
  knob(kx, y + 152, 14, b + 8, "DR", "", en); kx += sp;
  hint("Sustain Level in 3 dB steps (15 = -93 dB).");
  knob(kx, y + 152, 14, b + 9, "SL", "", en); kx += sp;
  hint("Release Rate (and the decay after sustain when EGT is off).");
  knob(kx, y + 152, 14, b + 10, "RR", "", en);
  wmax = gmodel == 0 ? 0 : gmodel == 1 ? 3 : 7;
  tx = x + 16;
  i = 0;
  loop(8,
    hit = inr(tx, y + 196, 40, 24);
    sel = (slider(b + 11) & wmax) == i;
    en && i <= wmax && gmclick && hit ? tap_sl(b + 11, i);
    hint(i == 0 ? "Waveform 0: sine." : i == 1 ? "Waveform 1: half sine." : i == 2 ? "Waveform 2: absolute sine." : i == 3 ? "Waveform 3: quarter (pulse) sine."
       : i == 4 ? "Waveform 4: alternating sine (OPL3 only)." : i == 5 ? "Waveform 5: camel sine (OPL3 only)." : i == 6 ? "Waveform 6: square (OPL3 only)." : "Waveform 7: logarithmic saw (OPL3 only).");
    take_hint(hit);
    (en && sel) ? amix(a, 0.3) : (hit && en && i <= wmax) ? col(C_HOVER) : col(C_CTRL);
    rr(tx, y + 196, 40, 24, 4, 1);
    (en && sel) ? ( acol(a, 1); rr(tx, y + 196, 40, 24, 4, 0); );
    wave_shape(i, tx + 5, y + 198, 30, 20, a, (!en || i > wmax) ? 0.18 : sel ? 1 : 0.55);
    tx += 44;
    i += 1;
  );
  fl = 0;
  tx = x + 16;
  loop(4,
    i = b + fl;
    strcpy(#gfl, fl == 0 ? "AM" : fl == 1 ? "VIB" : fl == 2 ? "EGT" : "KSR");
    hit = inr(tx, y + 226, 84, 22);
    sel = slider(i) >= 0.5;
    en && gmclick && hit ? tap_sl(i, sel ? 0 : 1);
    hint(fl == 0 ? "AM: tremolo from the chip LFO (3.7 Hz); depth on the Settings page."
       : fl == 1 ? "VIB: vibrato from the chip LFO (6.1 Hz); depth on the Settings page."
       : fl == 2 ? "EGT on: the envelope holds at SL while the key is down. Off: it keeps decaying at RR (percussive)."
       : "KSR: envelopes get faster in higher octaves.");
    take_hint(hit && en);
    (en && sel) ? acol(a, 1) : (hit && en) ? col(C_HOVER) : col(C_CTRL);
    rr(tx, y + 226, 84, 22, 5, 1);
    fnt(9); (en && sel) ? col(C_BG) : en ? col(C_TEXT2) : col(C_TEXT3);
    txt(#gfl, tx + 42, y + 237, 1);
    tx += 90;
    fl += 1;
  );
);

function page_ops() local(i, x, y, hit, sel, en)
(
  card(24, 122, 252, 524, "Algorithm", A_PEACH);
  en = !ggm;
  hint("2 operators per voice (FM or AM) or, OPL3 only, 4 operators per voice.");
  pills_sl(40, 158, 28, 2, "2 operators|4 operators", A_PEACH, en && gmodel == 2);
  i = 0;
  loop(gfour ? 4 : 2,
    x = 40 + (i % 2) * 112; y = 198 + floor(i / 2) * 104;
    hit = inr(x, y, 104, 96);
    sel = galg == i;
    en && gmclick && hit ? tap_sl(4, i);
    hint(gfour ? (i == 0 ? "1 -> 2 -> 3 -> 4: one long FM chain." : i == 1 ? "(1 -> 2) + (3 -> 4): two FM pairs added." : i == 2 ? "1 + (2 -> 3 -> 4): a tone plus an FM chain." : "1 + (2 -> 3) + 4: two tones plus an FM pair.")
               : (i == 0 ? "FM: OP1 modulates OP2. The classic AdLib sound." : "AM: OP1 and OP2 added, like an organ."));
    take_hint(hit && en);
    (sel && en) ? amix(A_PEACH, 0.20) : (hit && en) ? col(C_HOVER) : col(C_CTRL);
    rr(x, y, 104, 96, 6, 1);
    (sel && en) ? acol(A_PEACH, 1) : col(C_LINE); rr(x, y, 104, 96, 6, 0);
    alg_draw(x + 6, y + 4, 92, 72, gfour, i, 0, en && sel);
    fnt(11); (sel && en) ? acol(A_PEACH, 1) : col(C_TEXT3);
    gfour ? sprintf(#gal, "Algorithm %d", i) : strcpy(#gal, i == 0 ? "FM" : "AM");
    txt(#gal, x + 52, y + 86, 1);
    i += 1;
  );
  gfour ? (
    alg_draw(40, 410, 220, 150, 1, galg, 1, en);
    alg_graph(1, galg);
    fnt(8); en ? col(C_TEXT) : col(C_TEXT3);
    strcpy(#gd, galg == 0 ? "1 -> 2 -> 3 -> 4" : galg == 1 ? "(1 -> 2) + (3 -> 4)" : galg == 2 ? "1 + (2 -> 3 -> 4)" : "1 + (2 -> 3) + 4");
    txt(#gd, 150, 572, 1);
    gacc = A_PEACH;
    hint("OP1 modulating itself: from a pure tone at 0 to a bright, buzzy, noisy one at 7.");
    knob(110, 610, 16, 5, "", "", en);
    fnt(9); en ? col(C_TEXT2) : col(C_TEXT3); txt("OP1 feedback", 136, 603, 0);
    sl_text(5, #gkv); fnt(11); col(C_TEXT3); txt(#gkv, 136, 618, 0);
  ) : (
    g_algc = 0;
    alg_draw(40, 302, 105, 112, 0, galg, 1, en);
    g_algc = 2;
    alg_draw(150, 302, 105, 112, 0, slider(75) >= 0.5, 1, en && gv2);
    g_algc = 0;
    alg_graph(0, galg);
    fnt(11); en ? col(C_TEXT2) : col(C_TEXT3); txt(galg & 1 ? "V1: 1 + 2" : "V1: 1 -> 2", 92, 420, 1);
    en && gv2 ? col(C_TEXT2) : col(C_TEXT3); txt(slider(75) >= 0.5 ? "V2: 1 + 2" : "V2: 1 -> 2", 202, 420, 1);
    gacc = A_PEACH;
    hint("Voice 1 OP1 feedback: from a pure tone at 0 to a bright, buzzy, noisy one at 7.");
    knob(80, 448, 14, 5, "feedback", "", en);
    hint("Transposes voice 1 in semitones (DMXOPL3 instruments use this to sit an octave lower or higher).");
    knob(200, 448, 14, 78, "transpose", "", en);
    col(C_LINE); frect(40, 496, 220, 1);
    gacc = A_LEMON;
    hint("Voice 2: a second 2-operator voice on another chip channel for every note, as in the DMX driver's double-voice instruments. Uses twice the channels.");
    fnt(8); col(C_TEXT); txt("Voice 2", 40, 512, 0);
    toggle(110, 512, 74, slider(74) >= 0.5 ? "on" : "off", en);
    hint("Voice 2 connection: FM (OP1 modulates OP2) or AM (both heard).");
    pills_sl(40, 530, 24, 75, "FM|AM", A_LEMON, en && gv2);
    hint("Voice 2 OP1 feedback.");
    knob(68, 592, 14, 76, "feedback", "", en && gv2);
    hint("Voice 2 detune in 1/32 semitone steps (the DMX driver's fine tune): a slow beat against voice 1.");
    knob(150, 592, 14, 77, "detune", "", en && gv2);
    hint("Transposes voice 2 in semitones.");
    knob(232, 592, 14, 79, "transpose", "", en && gv2);
  );
  i = 0;
  loop(4,
    op_card(i, 288 + (i % 2) * 400, 122 + floor(i / 2) * 268, 388, 256);
    i += 1;
  );
  slim_keys();
);

function drum_pad(k, x, y, w, h, name, note, a) local(hit, lit)
(
  hit = inr(x, y, w, h);
  lit = GDRL[k];
  grh && gmclick && hit ? gq_push(0x99, note, 110);
  hint("Click to hit it. From MIDI: channel 10, General MIDI drum notes.");
  take_hint(hit && grh);
  grh ? (lit > 0.02 ? amix(a, 0.25 + 0.6 * lit) : hit ? col(C_HOVER) : col(C_CTRL)) : col(C_CTRL);
  rr(x, y, w, h, 8, 1);
  grh ? acol(a, 0.4 + 0.6 * lit) : col(C_LINE); rr(x, y, w, h, 8, 0);
  fnt(5); grh ? col(C_TEXT) : col(C_TEXT3); txt(name, x + w / 2, y + h / 2 - 8, 1);
  fnt(11); col(C_TEXT3); sprintf(#gdn, "note %d", note); txt(#gdn, x + w / 2, y + h / 2 + 14, 1);
  GDRL[k] = lit * 0.88;
);

function page_rhythm() local(i, y, mus, p, lv, a, hit, f, k, r, v)
(
  card(24, 122, 520, 524, "Rhythm mode", A_LEMON);
  gacc = A_LEMON;
  hint("Rhythm mode (register BDh): chip channels 6-8 become bass drum, snare, tom, cymbal and hi-hat on MIDI channel 10.");
  toggle(176, 147, 11, ggm ? "not with Multitimbral" : grh ? "on" : "off", !ggm);
  fnt(6); col(C_TEXT3);
  txt("Three chip channels become five drums, with the sounds that Ad Lib's", 40, 186, 0);
  txt("Music SDK loaded (1987). The snare, hi-hat and cymbal take their", 40, 204, 0);
  txt("phase from the chip's noise generator, as on the silicon.", 40, 222, 0);
  i = 0;
  loop(5,
    a = i == 0 ? A_PINK : i == 1 ? A_PEACH : i == 2 ? A_LEMON : i == 3 ? A_SKY : A_LILAC;
    drum_pad(i, 40 + i * 98, 250, 90, 120, i == 0 ? "BD" : i == 1 ? "SD" : i == 2 ? "TOM" : i == 3 ? "CY" : "HH", i == 0 ? 36 : i == 1 ? 38 : i == 2 ? 45 : i == 3 ? 49 : 42, a);
    gacc = a;
    hint(i == 0 ? "Bass drum level (attenuation, 0.75 dB steps)." : i == 1 ? "Snare level (attenuation)." : i == 2 ? "Tom level (attenuation)." : i == 3 ? "Cymbal level (attenuation)." : "Hi-hat level (attenuation).");
    knob(85 + i * 98, 412, 20, 12 + i, "level", "", grh);
    i += 1;
  );
  fnt(8); col(C_TEXT2); txt("MIDI channel 10", 40, 484, 0);
  fnt(6); col(C_TEXT3);
  txt("Bass drum 35-36   ·   Snare 37-40   ·   Toms 41, 43, 45, 47, 48, 50", 40, 508, 0);
  txt("Cymbals 49, 51-53, 55, 57, 59   ·   Hi-hat 42, 44, 46", 40, 528, 0);
  txt(gmodel == 2 ? "15 melodic voices remain (6 with 4 operators)." : "6 melodic voices remain.", 40, 560, 0);

  card(556, 122, 520, 524, "General MIDI (DMX driver)", A_LILAC);
  gacc = A_LILAC;
  hint("OPL3 only: General MIDI on 16 channels with the DMX driver (Doom, Heretic, Hexen) and the DMXOPL3 bank.");
  toggle(846, 147, 3, gmodel != 2 ? "OPL3 only" : ggm ? "on" : "off", gmodel == 2);
  !ggm ? (
    screen(572, 176, 488, 452);
    fnt(5); col(C_TEXT2); txt("Multitimbral is off", 816, 330, 1);
    fnt(6); col(C_TEXT3);
    txt(gmodel != 2 ? "Choose the OPL3 chip and turn Multitimbral on to play" : "Turn Multitimbral on to play General MIDI on 16 channels,", 816, 362, 1);
    txt(gmodel != 2 ? "General MIDI like a Sound Blaster 16 running Doom." : "like a Sound Blaster 16 running Doom's DMX driver.", 816, 382, 1);
    txt("Each channel then gets its instrument from Program Change,", 816, 414, 1);
    txt("or pick one here; channel 10 is the drum kit.", 816, 434, 1);
    txt("The Operators page is not used in this mode.", 816, 466, 1);
  ) : (
    fnt(11); col(C_TEXT3);
    txt("CH", 590, 176, 1); txt("INSTRUMENT  (click to change)", 610, 176, 0); txt("VOL", 846, 176, 1); txt("PAN", 884, 176, 1); txt("ACTIVITY", 966, 176, 1);
    i = 0;
    loop(16,
      y = 188 + i * 27;
      mus = i == 9 ? 15 : i == 15 ? 9 : i;
      lv = GCHL[i];
      hit = i != 9 && inr(572, y, 262, 23);
      hint("Click to choose this channel's instrument (sends a Program Change). A Program Change in your MIDI overrides it.");
      take_hint(hit);
      hit && gmclick ? (
        strcpy(#gm, "");
        f = 0;
        loop(16,
          strcat(#gm, ">"); strcat(#gm, GMFAM + f); strcat(#gm, "|");
          k = 0;
          loop(8, k == 7 ? strcat(#gm, "<"); OL_GMCH[mus * 4] == f * 8 + k ? strcat(#gm, "!"); strcat(#gm, GMNAME + f * 8 + k); strcat(#gm, "|"); k += 1;);
          f += 1;
        );
        gfx_x = sx(610); gfx_y = sy(y + 23);
        r = gfx_showmenu(#gm);
        r >= 1 ? gq_push(0xC0 | i, r - 1, 0);
        gmdown = 0; gpdown = 0; gmclick = 0;
      );
      (lv > 0.05) ? col(C_HOVER) : col(C_CTRL); rr(572, y, 488, 23, 4, 1);
      hit ? ( acol(A_LILAC, 0.6); rr(572, y, 262, 23, 4, 0); );
      fnt(9); col(C_TEXT2); sprintf(#gch, "%d", i + 1); txt(#gch, 590, y + 12, 1);
      fnt(11); col(C_TEXT);
      i == 9 ? strcpy(#gch, "Drum kit (47 sounds)") : ( p = OL_GMCH[mus * 4]; strcpy(#gch, GMNAME + max(0, min(127, p))); );
      txt(#gch, 610, y + 12, 0);
      v = OL_GMCH[mus * 4 + 1] / 127;
      col(C_LINE); rr(832, y + 9, 28, 5, 2, 1);
      acol(A_LILAC, 0.9); v > 0.01 ? rr(832, y + 9, 28 * v, 5, 2, 1);
      fnt(9); col(C_TEXT2);
      p = OL_GMCH[mus * 4 + 2];
      txt(p == 0x10 ? "L" : p == 0x20 ? "R" : "C", 884, y + 12, 1);
      acol(opacc(i % 4), 0.18); rr(906, y + 8, 142, 7, 3, 1);
      lv > 0.02 ? ( acol(opacc(i % 4), 1); rr(906, y + 8, 142 * lv, 7, 3, 1); );
      GCHL[i] = lv * 0.9;
      i += 1;
    );
    fnt(6); col(C_TEXT3);
    txt("Pan as heard: the DMX driver swaps the sides of CC 10, as in the games.", 572, 630, 0);
  );
);


function gold_taps(x, y, w, h, p, en) local(b, i, t, gl, gr, al, ar, px, fb, k)
(
  screen(x, y, w, h);
  b = GD_PROG + p * 26;
  col(C_LINE); frect(x + 10, y + h / 2, w - 20, 1);
  fnt(11); col(C_TEXT3);
  k = 0; loop(6, txt(sprintf(#gtk, "%d ms", k * 20), x + 14 + (w - 28) * k / 5, y + h - 9, 1); k += 1;);
  p > 0 ? (
    fb = b[16];
    fb ? (
      px = x + 14 + (w - 28) * b[17] / 31;
      acol(A_PEACH, en ? 0.6 : 0.2);
      k = 0; loop(12, frect(px, y + 12 + k * (h - 36) / 12, 1, (h - 36) / 24); k += 1;);
      fnt(11); txt("feedback", px + 4, y + 16, 0);
    );
    i = 1;
    loop(8,
      t = b[17 + i];
      gl = b[i - 1]; gr = b[8 + i - 1];
      al = (gl & 31) ? 10 ^ (-(31 - (gl & 31)) * 2 / 20) : 0;
      ar = (gr & 31) ? 10 ^ (-(31 - (gr & 31)) * 2 / 20) : 0;
      px = x + 14 + (w - 28) * t / 31;
      al > 0 ? ( (gl & 32) ? acol(A_SKY, en ? 1 : 0.3) : acol(A_PINK, en ? 1 : 0.3); frect(px - 2, y + h / 2 - al * (h / 2 - 22), 4, al * (h / 2 - 22)); disc(px, y + h / 2 - al * (h / 2 - 22), 3.5); );
      ar > 0 ? ( (gr & 32) ? acol(A_MINT, en ? 1 : 0.3) : acol(A_PINK, en ? 1 : 0.3); frect(px - 2, y + h / 2, 4, ar * (h / 2 - 22)); disc(px, y + h / 2 + ar * (h / 2 - 22), 3.5); );
      i += 1;
    );
    fnt(11); acol(A_SKY, en ? 1 : 0.4); txt("left", x + 12, y + 14, 0);
    acol(A_MINT, en ? 1 : 0.4); txt("right", x + 12, y + h - 24, 0);
  ) : (
    fnt(8); col(C_TEXT3); txt("surround off: the dry chip sound only", x + w / 2, y + h / 2 - 14, 1);
  );
);

function page_gold() local(en, i, x, hit, sel, a)
(
  en = gmodel == 2;
  card(24, 122, 1052, 92, "AdLib Gold 1000", A_LEMON);
  gacc = A_LEMON;
  hint("The AdLib Gold output stage after the OPL3: tone and stereo (TDA8425) and the surround module (YM7128B). OPL3 only.");
  toggle(200, 147, 17, en ? (slider(17) >= 0.5 ? "on" : "off") : "OPL3 only", en);
  fnt(6); col(C_TEXT3);
  txt("Ad Lib's 1992 card: an OPL3 with a Philips TDA8425 tone and stereo processor and the optional SP2 surround", 40, 176, 0);
  txt("module (Yamaha YM7128B). The surround programs are KoniSynth's own: no original Ad Lib table is known.", 40, 194, 0);
  en = en && slider(17) >= 0.5;

  card(24, 226, 400, 420, "Tone and stereo (TDA8425)", A_PEACH);
  gacc = A_PEACH;
  hint("Bass shelf at 300 Hz, in 3 dB steps.");
  knob(124, 316, 34, 18, "Bass", "300 Hz shelf", en);
  hint("Treble shelf at 4.5 kHz, in 3 dB steps.");
  knob(324, 316, 34, 19, "Treble", "4.5 kHz shelf", en);
  fnt(8); col(C_TEXT2); txt("Stereo mode", 40, 428, 0);
  i = 0;
  loop(4,
    x = 40 + (i % 2) * 182; hit = inr(x, 446 + floor(i / 2) * 82, 176, 74);
    sel = slider(20) == i;
    en && gmclick && hit ? tap_sl(20, i);
    hint(i == 0 ? "Forced mono: left plus right on both sides." : i == 1 ? "Linear stereo: the chip's stereo as it is."
       : i == 2 ? "Pseudo stereo: two all-pass filters on the left channel make a mono sound wide." : "Spatial stereo: 52 % crosstalk cancellation widens the stereo image.");
    take_hint(hit && en);
    (sel && en) ? amix(A_PEACH, 0.2) : (hit && en) ? col(C_HOVER) : col(C_CTRL);
    rr(x, 446 + floor(i / 2) * 82, 176, 74, 6, 1);
    (sel && en) ? acol(A_PEACH, 1) : col(C_LINE); rr(x, 446 + floor(i / 2) * 82, 176, 74, 6, 0);
    fnt(8); (sel && en) ? acol(A_PEACH, 1) : en ? col(C_TEXT) : col(C_TEXT3);
    txt(i == 0 ? "Forced mono" : i == 1 ? "Linear" : i == 2 ? "Pseudo" : "Spatial", x + 88, 446 + floor(i / 2) * 82 + 24, 1);
    fnt(11); col(C_TEXT3);
    txt(i == 0 ? "L + R on both" : i == 1 ? "as the chip plays" : i == 2 ? "all-pass widening" : "52 % crosstalk", x + 88, 446 + floor(i / 2) * 82 + 48, 1);
    i += 1;
  );

  card(436, 226, 640, 420, "Surround (YM7128B)", A_SKY);
  gacc = A_SKY;
  i = 0;
  loop(5,
    x = 452 + i * 120; hit = inr(x, 262, 112, 56);
    sel = slider(21) == i;
    en && gmclick && hit ? tap_sl(21, i);
    hint(i == 0 ? "No surround: only the tone and stereo stage." : i == 1 ? "Narrow: two Haas echoes, 3.2 ms left and 6.5 ms right."
       : i == 2 ? "Wide: four echoes from 9.7 to 29 ms, alternating sides and polarity." : i == 3 ? "Room: eight echoes from 6.5 to 74 ms with -18 dB feedback from 25.8 ms."
       : "Hall: eight echoes from 16 to 100 ms with -10 dB feedback from 64.5 ms.");
    take_hint(hit && en);
    (sel && en) ? acol(A_SKY, 1) : (hit && en) ? col(C_HOVER) : col(C_CTRL);
    rr(x, 262, 112, 56, 6, 1);
    fnt(8); (sel && en) ? col(C_BG) : en ? col(C_TEXT) : col(C_TEXT3);
    txt(i == 0 ? "Off" : i == 1 ? "Narrow" : i == 2 ? "Wide" : i == 3 ? "Room" : "Hall", x + 56, 290, 1);
    i += 1;
  );
  gold_taps(452, 334, 608, 200, slider(21), en);
  hint("Level of the surround echoes (VL / VR, 2 dB steps).");
  knob(520, 590, 22, 22, "Echo level", "", en && slider(21) > 0);
  fnt(6); col(C_TEXT3);
  txt("Echo taps from the surround program: height is the gain,", 600, 572, 0);
  txt("colour the polarity (pink = inverted). Up = left, down = right.", 600, 590, 0);
  txt("The YM7128B runs at 23.55 kHz with 14-bit samples.", 600, 616, 0);
);

function page_settings()
(
  card(24, 122, 520, 250, "LFO", A_SKY);
  gacc = A_SKY;
  fnt(8); col(C_TEXT2); txt("Tremolo depth (AM)", 40, 184, 0);
  hint("Depth of the chip's 3.7 Hz tremolo on operators with AM on.");
  pills_sl(40, 200, 30, 6, "1 dB|4.8 dB", A_SKY, 1);
  fnt(8); col(C_TEXT2); txt("Vibrato depth (VIB)", 40, 260, 0);
  hint("Depth of the chip's 6.1 Hz vibrato on operators with VIB on.");
  pills_sl(40, 276, 30, 7, "7 cents|14 cents", A_SKY, 1);
  fnt(6); col(C_TEXT3); txt("Both LFOs run at fixed rates from the chip's global counter.", 40, 344, 0);

  card(556, 122, 520, 250, "Output", A_MINT);
  gacc = A_MINT;
  fnt(8); col(C_TEXT2); txt("Output (OPL3)", 572, 184, 0);
  hint("OPL3 stereo or mono. The OPL and OPL2 are always mono.");
  pills_sl(572, 200, 30, 10, "Stereo|Mono", A_MINT, gmodel == 2);
  fnt(8); col(C_TEXT2); txt("Pan (OPL3)", 572, 260, 0);
  hint("Where the voices sit (register C0h): centre, left, right, or alternating voices left and right.");
  pills_sl(572, 276, 30, 9, "Center|Left|Right|Alternate L/R", A_MINT, gmodel == 2 && !ggm);
  hint("Velocity on the carriers' Total Level, in 0.75 dB steps.");
  toggle(572, 348, 8, "Velocity sensitive", !ggm);

  card(24, 384, 520, 262, "Tuning", A_PINK);
  gacc = A_PINK;
  hint("Fine tune in cents (GM mode uses the DMX driver's own frequency table).");
  knob(160, 490, 34, 23, "Fine tune", "", !ggm);
  hint("Pitch bend range in semitones (GM mode uses the driver's fixed +-2 semitones).");
  knob(400, 490, 34, 24, "Bend range", "", !ggm);

  card(556, 384, 520, 262, "About", A_LILAC);
  fnt(6); col(C_TEXT2);
  txt("Ported from the KoniSynth OPL engine by k0n1m4k1 (AGPL-3.0),", 572, 430, 0);
  txt("which follows the chip behaviour documented by Nuked-OPL3.", 572, 450, 0);
  txt("DMXOPL3 General MIDI bank by sneakernets (MIT).", 572, 478, 0);
  txt("DMX driver rules as reconstructed by Chocolate Doom.", 572, 498, 0);
  col(C_TEXT3);
  txt("AdLib Gold stage: TDA8425_emu and YM7128B_emu by Andrea Zoppi (BSD-2).", 572, 526, 0);
  txt("Bit-exact against KoniSynth's own C++ code.", 572, 556, 0);
  slim_keys();
);

// ================================================================ frame

!g_init ? ( g_init = 1; g_kbn = -1; g_kbase = 48; g_scg = 1; );
ui_frame_begin();
col(C_BG); gfx_rect(0, 0, gfx_w, gfx_h, 1);
gmodel = slider(1); gfour = gmodel == 2 && slider(2) >= 0.5 && slider(3) < 0.5; ggm = gmodel == 2 && slider(3) >= 0.5;
grh = !ggm && slider(11) >= 0.5;
gv2 = !ggm && !gfour && slider(74) >= 0.5;
galg = gfour ? slider(4) : slider(4) & 1;
alg_graph(gfour, galg);
gn = 0; loop(16, CHA[gn] > 0 ? ( GCHL[gn] = 1; CHA[gn] = 0; ); gn += 1;);
gn = 0; loop(5, DRA[gn] > 0 ? ( GDRL[gn] = 1; DRA[gn] = 0; ); gn += 1;);
topbar();
g_page == 0 ? page_play() : g_page == 1 ? page_ops() : g_page == 2 ? ( page_rhythm(); slim_keys(); ) : g_page == 3 ? ( page_gold(); slim_keys(); ) : page_settings();
hintbar();
!gmdown && g_kbn >= 0 ? ( gq_push(0x80, g_kbn, 0); g_kbn = -1; );
gmdown ? ( gactive >= 1000 ? g_edown = gactive; ) : g_edown = 0;
ui_frame_end();
