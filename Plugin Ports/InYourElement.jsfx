knob_at(17, px(850), py(340), 26 * uscale, 0, 0);


gfx_set(0.62, 0.63, 0.65, 1);
gfx_rect(px(20), py(404), (UDW - 40) * uscale, max(1, uscale), 1);
gfx_set(0.97, 0.97, 0.97, 1);
gfx_rect(px(20), py(405), (UDW - 40) * uscale, max(1, uscale), 1);

gfx_set(0.12, 0.12, 0.13, 1);
gfx_setfont(1, "Arial", 12 * uscale, 'b');
gfx_x = px(30); gfx_y = py(419); gfx_drawstr("BEND");
bend_counter(px(72), py(414));
toggle_btn(22, px(190), py(414), 80 * uscale, 24 * uscale, "LEGATO");
toggle_btn(18, px(810), py(414), 80 * uscale, 24 * uscale, "FREEZE");

gfx_set(0.12, 0.12, 0.13, 1);
gfx_setfont(1, "Arial", 12 * uscale, 'b');
gfx_x = px(560); gfx_y = py(419); gfx_drawstr("OUTPUT");
sprintf(#uout, "%+.1f dB", p_out);
gfx_set(0.36, 0.37, 0.40, 1);
gfx_x = px(622); gfx_y = py(419); gfx_drawstr(#uout);
uhov23 = hit_circle(mouse_x, mouse_y, px(712), py(426), 15 * uscale);
uhov23 ? u_hov = 23;
(u_click && uhov23) ? (
  (u_ctarget == 23 && time_precise() - u_ctime < 0.3) ? ( set_slider(23, 0); u_drag = 0; ) :
  ( u_drag = 23; u_dy0 = mouse_y; u_dv0 = norm_of(23); u_dfine = mouse_cap & 4; automate(23, 0); );
  u_ctarget = 23; u_ctime = time_precise();
  u_click = 0;
);
(uhov23 && u_wheel != 0 && u_drag == 0) ? ( set_norm(23, max(0, min(1, norm_of(23) + (u_wheel / 120) * ((mouse_cap & 4) ? 0.002 : 0.02)))); automate(23, 1); u_wheel = 0; );
rk_draw(px(712), py(426), 14 * uscale, norm_of(23), 0.97, 0.97, 0.96);

!tables_ok ? (
  gfx_set(0.10, 0.13, 0.20, 0.92);
  gfx_rect(px(250), py(200), 500 * uscale, 50 * uscale, 1);
  gfx_set(1, 0.8, 0.5, 1);
  ctext("Missing or unreadable Dependencies/InYourElement/elements_tables.txt", px(500), py(216), 14, 'b');
);

// ---------------------------------------------------------------------- keyboard
ukby = py(446); ukbh = 56 * uscale;
ukbx = px(20); ukbw = (UDW - 40) * uscale;
unwk = 36;
uwkw = ukbw / unwk;
ukhit = -1;
uk = 0;
loop(unwk,
  uoc = floor(uk / 7);
  uwn = uk % 7;
  ukn = 36 + uoc * 12 + (uwn == 0 ? 0 : uwn == 1 ? 2 : uwn == 2 ? 4 : uwn == 3 ? 5 : uwn == 4 ? 7 : uwn == 5 ? 9 : 11);
  ukpx = ukbx + uk * uwkw;
  hit_rect(mouse_x, mouse_y, ukpx, ukby, uwkw, ukbh) ? ( ukhit = ukn; ukhy = (mouse_y - ukby) / ukbh; );
  uk += 1;
);
uk = 0;
loop(unwk - 1,
  uwn = uk % 7;
  (uwn != 2 && uwn != 6) ? (
    uoc = floor(uk / 7);
    ukn = 36 + uoc * 12 + (uwn == 0 ? 1 : uwn == 1 ? 3 : uwn == 3 ? 6 : uwn == 4 ? 8 : 10);
    ukpx = ukbx + (uk + 1) * uwkw - uwkw * 0.32;
    hit_rect(mouse_x, mouse_y, ukpx, ukby, uwkw * 0.64, ukbh * 0.6) ? ( ukhit = ukn; ukhy = (mouse_y - ukby) / (ukbh * 0.6); );
  );
  uk += 1;
);
jkb_draw(ukbx, ukby, ukbw, ukbh, unwk, 36, KEYD, u_kbnote, 0, 0.94, 0.55, 0.16, 1, uscale);
ukhit >= 0 ? (
  u_hov = 24;
  u_click ? (
    UIQ[uiq_w * 3] = 0x90; UIQ[uiq_w * 3 + 1] = ukhit; UIQ[uiq_w * 3 + 2] = floor(30 + 97 * min(1, max(0, ukhy)));
    uiq_w = (uiq_w + 1) % 64;
    u_kbnote = ukhit;
    u_click = 0;
  );
);
(u_kbnote >= 0 && !u_down) ? (
  UIQ[uiq_w * 3] = 0x80; UIQ[uiq_w * 3 + 1] = u_kbnote; UIQ[uiq_w * 3 + 2] = 0;
  uiq_w = (uiq_w + 1) % 64;
  u_kbnote = -1;
);

// ---------------------------------------------------------------------- hint bar
gfx_set(0.20, 0.20, 0.21, 1);
gfx_rect(px(0), py(508), UDW * uscale, 36 * uscale, 1);
uhs = u_drag > 0 ? u_drag : u_hov;
gfx_setfont(1, "Arial", 13 * uscale);
gfx_set(0.80, 0.80, 0.82, 1);
strcpy(#uhint, hint_text(uhs));
gfx_measurestr(#uhint, uhtw, uhth);
uhtw > (UDW - 20) * uscale ? ( gfx_setfont(1, "Arial", 13 * uscale * (UDW - 20) * uscale / uhtw); gfx_measurestr(#uhint, uhtw, uhth); );
gfx_x = uox + (UDW * uscale - uhtw) * 0.5; gfx_y = py(508) + (36 * uscale - uhth) * 0.5;
gfx_drawstr(#uhint);

u_drag > 0 ? (
  u_down ? (
    mouse_cap |= 65536;
    ufine = mouse_cap & 4;
    ufine != u_dfine ? ( u_dy0 = mouse_y; u_dv0 = norm_of(u_drag); u_dfine = ufine; );
    set_norm(u_drag, max(0, min(1, u_dv0 + (u_dy0 - mouse_y) / (150 * uscale) * (ufine ? 0.1 : 1))));
  ) : ( automate(u_drag, 1); u_drag = 0; );
);

u_pstate = u_down;
