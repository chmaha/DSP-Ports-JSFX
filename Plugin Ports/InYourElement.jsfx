gfx_x = px(70) + utw + 16 * uscale; gfx_y = py(17);
gfx_drawstr("modal synthesizer");
gfx_setfont(1, "Arial", 12 * uscale);
gfx_set(0.36, 0.37, 0.40, 1);
gfx_x = px(71); gfx_y = py(41);
gfx_drawstr("by chmaha  ·  based on Mutable Instruments Elements");

utabw = 100 * uscale; utabh = 26 * uscale;
utx = px(UDW - 30) - 4 * utabw - 18 * uscale;
uk = 0;
loop(4,
  dark_btn(20, utx + uk * (utabw + 6 * uscale), py(14), uk == 3 ? utabw + 12 * uscale : utabw, utabh,
           uk == 0 ? "MODAL" : uk == 1 ? "STRING" : uk == 2 ? "STRINGS" : "OMINOUS", (p_engine | 0) == uk, 13) ? ( set_slider(20, uk); u_click = 0; );
  uk += 1;
);

uby = py(60);
gfx_set(0.70, 0.71, 0.73, 1);
gfx_rect(px(0), uby, UDW * uscale, 9 * uscale, 1);
uk = 0;
loop(UDW / 4,
  gfx_set(0.52, 0.53, 0.56, 1);
  gfx_line(px(uk * 4), uby + 8 * uscale, px(uk * 4 + 6), uby + uscale, 1);
  uk += 1;
);
gfx_set(0.97, 0.97, 0.97, 1);
gfx_rect(px(0), uby + 9 * uscale, UDW * uscale, max(1, uscale), 1);

// ---------------------------------------------------------------------- exciter (left) and resonator (right)
ui_exclevel = part_exclevel;
ui_reslevel = part_reslevel_led;
dots_v(px(500), py(80), py(400));
