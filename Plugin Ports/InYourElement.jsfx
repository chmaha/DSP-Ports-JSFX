uk = 0;
loop(6, gfx_line(px(45) + sin(uk * $pi / 3) * 9 * uscale, py(25) - cos(uk * $pi / 3) * 9 * uscale, px(45) + sin(uk * $pi / 3) * 12 * uscale, py(25) - cos(uk * $pi / 3) * 12 * uscale, 1); uk += 1; );
gfx_setfont(1, "Arial", 30 * uscale);
gfx_x = px(70); gfx_y = py(8);
gfx_drawstr("In Your Element");
gfx_measurestr("In Your Element", utw, uth);
