knob_at(10, px(610), py(110), 24 * uscale, 0, 0);
knob_at(11, px(730), py(110), 24 * uscale, 0, 0);
knob_at(12, px(850), py(110), 24 * uscale, 0, 0);
gfx_set(0.12, 0.12, 0.13, 1);
ctext("-", px(816), py(124), 16, 'b'); ctext("+", px(884), py(124), 16, 'b');

knob_at(13, px(630), py(222), 40 * uscale, 1, 0);
led(px(740), py(222), 0.98, 0.55, 0.10, ui_reslevel);
