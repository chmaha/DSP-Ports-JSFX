<?
  k = 1; loop(8, printf("slider%d:mod%d=0<0,106,1>-Slot %d Module\n", k, k, k); k += 1);
  k = 1; loop(8, printf("slider%d:byp%d=0<0,1,1{Off,On}>-Slot %d Bypass\n", 8 + k, k, k); k += 1);
  k = 1; loop(32, printf("slider%d:cab%d=%d<0,1600,1>-Cable %d\n", 16 + k, k, k == 1 ? 37 : k == 2 ? 78 : 0, k); k += 1);
  k = 1; loop(8, printf("slider%d:bx%d=0<0,960,1>-Slot %d X\n", 48 + k, k, k); k += 1);
  k = 1; loop(8, printf("slider%d:by%d=0<0,700,1>-Slot %d Y\n", 56 + k, k, k); k += 1);
  k = 0; loop(128, printf("slider%d:p%d_%d=0<0,1,0.000001>-Slot %d Param %d\n", 65 + k, floor(k / 16) + 1, k % 16 + 1, floor(k / 16) + 1, k % 16 + 1); k += 1);
?>
slider193:slack=0.428571<0,1,0.000001>-Cable Slack

import Dependencies/HarrisTweed/swh_dsp.jsfx-inc

in_pin:L
in_pin:R
in_pin:Sidechain L
in_pin:Sidechain R
out_pin:L
out_pin:R

options:maxmem=20000000 no_meter
@init
ext_noinit = gfx_ext_retina = 1;

GNT = 106;
GM = 48000;
GMS = 100;
GRP = 59000;
GRI = 59300;
GRK = 59340;
GLD = 59400;
GSM = 59500;
GJL = 59600;
GTG = 59700;
GCC = 59850;

