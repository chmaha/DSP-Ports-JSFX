g_tables();
memset(GRP, 0, 1000);
GCC[0] = 0.58; GCC[1] = 0.60; GCC[2] = 0.64;
GCC[3] = 0.85; GCC[4] = 0.35; GCC[5] = 0.35;
GCC[6] = 0.28; GCC[7] = 0.55; GCC[8] = 0.88;
GCC[9] = 0.30; GCC[10] = 0.75; GCC[11] = 0.68;
GCC[12] = 0.88; GCC[13] = 0.66; GCC[14] = 0.25;
GCC[15] = 0.66; GCC[16] = 0.46; GCC[17] = 0.88;
GCC[18] = 0.88; GCC[19] = 0.45; GCC[20] = 0.70;
GCC[21] = 0.92; GCC[22] = 0.52; GCC[23] = 0.20;
GCC[24] = 0.45; GCC[25] = 0.72; GCC[26] = 0.92;
GCC[27] = 0.55; GCC[28] = 0.80; GCC[29] = 0.35;
GCC[30] = 0.62; GCC[31] = 0.64; GCC[32] = 0.68;

rk_tables();
rk_setup();
RK_SR = srate;
RK_PDC = 128;
last_srate = srate;

@slider
last_srate !== srate ? (
  last_srate = srate;
  RK_SR = srate;
  rk_setup();
);

@block
rk_sync();
pdc_delay = RK_PDC;
pdc_bot_ch = 0;
pdc_top_ch = 2;

@sample
rk_sample();

@gfx 960 700

function g_auto(s, e)
(
<?
  max_sliders > 193 ? printf("slider_automate(2^(s-1), e);") : (
    k = 1; loop(8, printf("  s == %d ? slider_automate(mod%d, e) :\n", k, k); k += 1);
    k = 1; loop(8, printf("  s == %d ? slider_automate(byp%d, e) :\n", 8 + k, k); k += 1);
    k = 1; loop(32, printf("  s == %d ? slider_automate(cab%d, e) :\n", 16 + k, k); k += 1);
    k = 1; loop(8, printf("  s == %d ? slider_automate(bx%d, e) :\n", 48 + k, k); k += 1);
    k = 1; loop(8, printf("  s == %d ? slider_automate(by%d, e) :\n", 56 + k, k); k += 1);
    k = 0; loop(128, printf("  s == %d ? slider_automate(p%d_%d, e) :\n", 65 + k, floor(k / 16) + 1, k % 16 + 1); k += 1);
    printf("  s == 193 ? slider_automate(slack, e) :\n");
  );
?> 0;
);

function g_sx(x) ( gox + x * gz; );
function g_sy(y) ( goy + y * gz; );
function g_hit(x, y, w, h) ( mouse_x >= g_sx(x) && mouse_x < g_sx(x + w) && mouse_y >= g_sy(y) && mouse_y < g_sy(y + h); );
function g_hitc(x, y, r) ( sqr(mouse_x - g_sx(x)) + sqr(mouse_y - g_sy(y)) <= sqr(r * gz); );
function g_near(x, y, r) ( sqr(gmx - x) + sqr(gmy - y) <= r * r; );
function g_dbl(key) local(r) (
  r = glast_i === key && gnow - glast_t < 0.3;
  glast_i = key;
  glast_t = gnow;
  r;
);
function g_clamp01(x) ( max(0, min(1, x)); );
function g_font(sz, fl) ( gfx_setfont(1, "Arial", sz * gz, fl); );
function g_fit(str, sz, fl, maxw) local(tw, th) (
  g_font(sz, fl);
  gfx_measurestr(str, tw, th);
  while (tw > maxw * gz && sz > 11) (
    sz -= 1;
    g_font(sz, fl);
    gfx_measurestr(str, tw, th);
  );
);
function g_small() ( g_font(12, 0); gfx_set(0.70, 0.72, 0.76, 1); );
function g_text_c(str, cx, y) local(tw, th) ( gfx_measurestr(str, tw, th); gfx_x = g_sx(cx) - tw * 0.5; gfx_y = g_sy(y); gfx_drawstr(str); );
function g_text_r(str, rx, y) local(tw, th) ( gfx_measurestr(str, tw, th); gfx_x = g_sx(rx) - tw; gfx_y = g_sy(y); gfx_drawstr(str); );
function g_text_l(str, lx, y) ( gfx_x = g_sx(lx); gfx_y = g_sy(y); gfx_drawstr(str); );
function g_text_cc(str, cx, cy) local(tw, th) ( gfx_measurestr(str, tw, th); gfx_x = g_sx(cx) - tw * 0.5; gfx_y = g_sy(cy) - th * 0.5; gfx_drawstr(str); );
function g_box(x, y, w, h, fill) ( gfx_rect(g_sx(x), g_sy(y), w * gz, h * gz, fill); );
function g_panel(x, y, w, h) (
  gfx_set(0.12, 0.13, 0.15, 1);
  g_box(x, y, w, h, 1);
  gfx_set(0.30, 0.31, 0.35, 1);
  g_box(x, y, w, h, 0);
);
function g_catcol(c, f) ( gfx_set(min(1, GCC[c * 3] * f), min(1, GCC[c * 3 + 1] * f), min(1, GCC[c * 3 + 2] * f), 1); );

function g_put(i, v) ( slider(i) !== v ? ( slider(i) = v; g_auto(i, 0); g_auto(i, 1); ); );

function g_mdp(t, k) ( RK_MD + t * RK_MDS + 15 + k * 5; );
function g_lo(t, k) local(m) ( m = g_mdp(t, k); (m[4] & 8) ? m[1] * srate : m[1]; );
function g_hi(t, k) local(m) ( m = g_mdp(t, k); (m[4] & 8) ? m[2] * srate : m[2]; );
function g_map(t, k, u) local(m, lo, hi, f, v) (
  m = g_mdp(t, k);
  lo = m[1]; hi = m[2]; f = m[4];
  (f & 8) ? ( lo *= srate; hi *= srate; );
  u = max(0, min(1, u));
  (f & 4) ? v = (u >= 0.5) :
  (f & 1) ? v = lo * (hi / lo) ^ u :
  v = lo + (u * (hi - lo));
  (f & 2) ? v = floor(v + 0.5);
  v;
);
function g_unmap(t, k, v) local(m, lo, hi, f) (
  m = g_mdp(t, k);
  lo = m[1]; hi = m[2]; f = m[4];
  (f & 8) ? ( lo *= srate; hi *= srate; );
  (f & 4) ? (v >= 0.5) :
  (f & 1) ? max(0, min(1, log(v / lo) / log(hi / lo))) :
  hi > lo ? max(0, min(1, (v - lo) / (hi - lo))) : 0;
);
function g_def_u(t, k) local(m, d) (
  m = g_mdp(t, k);
  d = m[3];
  ((m[4] & 8) && !(m[4] & 16)) ? d *= srate;
  g_unmap(t, k, d);
);

function g_unit(un) (
  un === 1 ? "dB" : un === 2 ? "ms" : un === 3 ? "s" : un === 4 ? "Hz" : un === 5 ? "%" : un === 6 ? "smp" :
  un === 7 ? "oct" : un === 8 ? "m" : un === 10 ? "in" : un === 11 ? "ips" : "";
);
function g_fmt(t, k, v) local(un, kind, sp, d, q) (
  un = GM[t * GMS + 31 + k * 4];
  kind = GM[t * GMS + 32 + k * 4];
  sp = abs(g_hi(t, k) - g_lo(t, k));
  kind === 1 || kind === 2 ? (
    un === 6 ? sprintf(#gfmt, "%d smp", v) : sprintf(#gfmt, "%d", v);
  ) : un === 4 ? (
    v >= 10000 ? sprintf(#gfmt, "%.1f kHz", v / 1000) :
    v >= 1000 ? sprintf(#gfmt, "%.2f kHz", v / 1000) :
    v >= 100 ? sprintf(#gfmt, "%.0f Hz", v) :
    v >= 10 ? sprintf(#gfmt, "%.1f Hz", v) :
    v >= 1 ? sprintf(#gfmt, "%.2f Hz", v) : sprintf(#gfmt, "%.3f Hz", v);
  ) : un === 3 ? (
    abs(v) >= 1 ? sprintf(#gfmt, "%.2f s", v) :
    abs(v) >= 0.01 ? sprintf(#gfmt, "%.0f ms", v * 1000) : sprintf(#gfmt, "%.2f ms", v * 1000);
  ) : un === 2 ? (
    abs(v) >= 1000 ? sprintf(#gfmt, "%.2f s", v / 1000) :
    abs(v) >= 100 ? sprintf(#gfmt, "%.0f ms", v) :
    abs(v) >= 10 ? sprintf(#gfmt, "%.1f ms", v) : sprintf(#gfmt, "%.2f ms", v);
  ) : un === 9 ? (
    sprintf(#gfmt, "1:%.1f", v);
  ) : (
    d = sp >= 200 ? 0 : sp >= 20 ? 1 : sp >= 0.5 ? 2 : 3;
    q = 10 ^ d;
    v = floor(v * q + 0.5) / q;
    d === 0 ? sprintf(#gfmt, "%.0f", v) : d === 1 ? sprintf(#gfmt, "%.1f", v) :
    d === 2 ? sprintf(#gfmt, "%.2f", v) : sprintf(#gfmt, "%.3f", v);
    un > 0 ? ( strcat(#gfmt, " "); strcat(#gfmt, g_unit(un)); );
  );
  #gfmt;
);

function g_items(s) local(i, n) (
  n = 1;
  i = 0;
  loop(strlen(s), str_getchar(s, i) == '|' ? n += 1; i += 1);
  n;
);
function g_item(dst, s, idx) local(i, st, k, l, c) (
  strcpy(dst, "");
  l = strlen(s);
  st = k = i = 0;
  loop(l + 1,
    c = i < l ? str_getchar(s, i) : '|';
    c == '|' ? (
      k == idx ? strcpy_substr(dst, s, st, i - st);
      k += 1;
      st = i + 1;
    );
    i += 1);
  dst;
);

function g_type(n) ( n >= 1 && n <= 8 ? max(0, min(GNT, floor(slider(n) + 0.5))) : 0; );
function g_live(n) ( n === 0 || n === 9 || g_type(n) > 0; );
function g_nin(n) ( n === 0 ? 0 : n === 9 ? 2 : RK_MD[g_type(n) * RK_MDS]; );
function g_nout(n) ( n === 0 ? 4 : n === 9 ? 0 : RK_MD[g_type(n) * RK_MDS + 1]; );
function g_hof(t) local(r, o) (
  r = max(1, max(RK_MD[t * RK_MDS], RK_MD[t * RK_MDS + 1]));
  o = RK_MD[t * RK_MDS + 3];
  32 + r * 18 + (o > 0 ? o * 14 + 4 : 0);
);
function g_nw(n) ( n === 0 || n === 9 ? GIOW : GBW; );
function g_nh(n) ( n === 0 ? 104 : n === 9 ? 68 : g_hof(g_type(n)); );
function g_nx(n) ( n === 0 ? GCX + 10 : n === 9 ? GCX + GCW - GIOW - 10 : slider(48 + n); );
function g_ny(n) ( n === 0 || n === 9 ? GCY + floor((GCH - g_nh(n)) * 0.5) : slider(56 + n); );
function g_jy(n, p) ( g_ny(n) + 37 + p * 18; );
function g_jix(n) ( g_nx(n) + GJIN; );
function g_jox(n) ( g_nx(n) + g_nw(n) - GJIN; );
function g_nmo(n) ( n === 0 ? 2 : n === 9 ? 0 : GM[g_type(n) * GMS + 22]; );
function g_mo(n, k) ( n === 0 ? k : GM[g_type(n) * GMS + 23 + k]; );
function g_mo_idx(n, sp) local(k, r) (
  r = -1;
  k = 0;
  loop(g_nmo(n), g_mo(n, k) === sp ? r = k; k += 1;);
  r;
);
function g_plabel(n, isout, p) (
  n === 0 ? ( p === 0 ? "L" : p === 1 ? "R" : p === 2 ? "SC L" : "SC R"; ) :
  n === 9 ? ( p === 0 ? "L" : "R"; ) :
  GM[g_type(n) * GMS + (isout ? 10 : 6) + p];
);

function g_cv(c) ( floor(slider(17 + c) + 0.5); );
function g_dec(v) ( v -= 1; gq_s = floor(v / 40); gq_d = v - gq_s * 40; );
function g_ok(c) local(v, sn, sp, dn, dp) (
  v = g_cv(c);
  v > 0 && v <= 1440 ? (
    g_dec(v);
    sn = floor(gq_s / 4); sp = gq_s - sn * 4;
    dn = floor(gq_d / 4); dp = gq_d - dn * 4;
    sn <= 8 && dn >= 1 && sn !== dn && g_live(sn) && g_live(dn) && sp < g_nout(sn) && dp < g_nin(dn) ? 1 : 0;
  ) : 0;
);
function g_has(sc, dc) local(c, r) (
  r = 0;
  c = 0;
  loop(32, g_cv(c) === 1 + sc * 40 + dc ? r = 1; c += 1;);
