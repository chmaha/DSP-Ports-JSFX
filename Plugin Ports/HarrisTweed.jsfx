  gj = g_in_jack_at();
  gj >= 0 && g_can(gcsrc, gj) ? ( gex = g_jxi(gj); gey = g_jyc(gj); gfr = 4; ) : ( gex = gmx; gey = gmy + GPLUGL + GPINL; gfr = 2; );
  g_rope_target(32, g_jxo(gcsrc), g_jyc(gcsrc), gex, gey);
  loop(gnsub, g_rope_step(32, g_jxo(gcsrc), g_jyc(gcsrc), gex, gey, 1 / 120));
  g_draw_cable(32, gcsrc, g_jxo(gcsrc), g_jyc(gcsrc), gex, gey, gfr);
);
gmode == 3 ? (
  gj = g_out_jack_at();
  gj >= 0 && g_can(gj, gcdst) ? ( gex = g_jxo(gj); gey = g_jyc(gj); gfr = 3; ) : ( gj = 0; gex = gmx; gey = gmy + GPLUGL + GPINL; gfr = 1; );
  g_rope_target(32, gex, gey, g_jxi(gcdst), g_jyc(gcdst));
  loop(gnsub, g_rope_step(32, gex, gey, g_jxi(gcdst), g_jyc(gcdst), 1 / 120));
  g_draw_cable(32, gj, gex, gey, g_jxi(gcdst), g_jyc(gcdst), gfr);
);

g_panel(24, 452, 912, 240);
gsel >= 1 && !g_live(gsel) ? gsel = -1;
gsel >= 1 ? (
  gt = g_type(gsel);
  gc = GM[gt * GMS + 2];
  g_catcol(gc, 1);
  g_box(24, 452, 4, 240, 1);
  g_font(13, 'b');
  gfx_set(0.88, 0.89, 0.92, 1);
  g_text_l(GM[gt * GMS], 40, 462);
  g_small();
  g_text_l(GM[gt * GMS + 3], 40, 480);
  g_catcol(gc, 1.1);
  g_text_r(GM[GM[gt * GMS + 2]], 712, 462);
  RK_MD[gt * RK_MDS + 14] > 0 ? (
    g_small();
    g_text_r(sprintf(#glat, "Latency %d samples", RK_LAT[gsel]), 712, 480);
  );
  g_button(724, 460, 100, 26, "BYPASS", slider(8 + gsel) >= 0.5, 0) ? g_put(8 + gsel, slider(8 + gsel) >= 0.5 ? 0 : 1);
  g_button(836, 460, 92, 26, "REMOVE", 0, 0) ? g_remove(gsel);
  gsel >= 1 ? (
    gnp = RK_MD[gt * RK_MDS + 2];
    gnp === 0 ? (
      g_small();
      g_text_c("No parameters", 480, 584);
    );
    gr0 = gnp > 8 ? ceil(gnp / 2) : gnp;
    gk = 0;
    loop(gnp,
      gx = 480 + (gk >= gr0 ? gk - gr0 - (gnp - gr0 - 1) * 0.5 : gk - (gr0 - 1) * 0.5) * 114;
      gy = gnp > 8 ? (gk >= gr0 ? 636 : 546) : 591;
      gi = 65 + (gsel - 1) * 16 + gk;
      gkind = GM[gt * GMS + 32 + gk * 4];
      gkind === 2 ? g_penum(gx, gy, gi, gt, gk, gc) : gkind === 3 ? g_ptog(gx, gy, gi, gt, gk) : g_pknob(gx, gy, gi, gt, gk, gc);
      gk += 1;
    );
  );
) : (
  g_font(15, 'b');
  gfx_set(0.88, 0.89, 0.92, 1);
  g_text_c("GETTING STARTED", 480, 482);
  g_font(14, 0);
  gfx_set(0.72, 0.74, 0.78, 1);
  g_text_c("Right-click the canvas or use ADD MODULE: inserts after the selected block (or IN), else before OUT. Shift: unpatched.", 480, 512);
  g_text_c("Drag between an output jack (right side) and an input jack (left side), in either direction, to add a cable.", 480, 536);
  g_text_c("Pull a cable well away and release to unplug it. An output can feed many inputs; an input sums all its cables.", 480, 560);
  g_text_c("Right-click cables, jacks or blocks to disconnect, bypass, remove or reset. Delete removes the selected block.", 480, 584);
  g_text_c("Mono modules take the left signal and feed both sides. IN SC L/R are track channels 3/4, for sidechain inputs.", 480, 608);
  g_text_c("Drag blocks to arrange them and click one to edit it. Up to 8 modules and 32 cables.", 480, 632);
);

!gdown && gdrag_i ? (
  g_auto(gdrag_i, 1);
  gdrag_i = 0;
);
gprev_down = gdown;
gprev_rdown = grdown;
