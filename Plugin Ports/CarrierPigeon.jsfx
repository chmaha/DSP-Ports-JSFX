// https://github.com/pluginguru/mda-effects


slider1:p_track=0.25<0,1,0.001>-Tracking
slider2:p_pitch=0.5<0,1,0.001>-Pitch
slider3:p_breath=0.2<0,1,0.001>-Breath
slider4:p_sthr=0.5<0,1,0.001>-S Thresh
slider5:p_maxf=0.35<0,1,0.001>-Max Freq

in_pin:Left input
in_pin:Right input
out_pin:Left output
out_pin:Right output
options:no_meter

@init

ext_noinit = gfx_ext_retina = 1;
ext_nodenorm = 1;

function itrunc(x) ( x < 0 ? ceil(x) : floor(x); );

vi_seed = 1;
vi_l0 = vi_l1 = vi_l2 = vi_l3 = 0;
vi_pstep = vi_s = vi_le = vi_he = 0;

function vi_resume() local(fs, ifs)
(
  fs = srate;
  ifs = 1 / fs;
  vi_track = itrunc(2.990000009536743 * p_track);
  vi_pmult = 1.0594631433486938 ^ floor((48 * p_pitch) - 24);
  vi_track == 0 ? vi_pstep = (110 * vi_pmult) * ifs;
  vi_noise = 6 * p_breath;
  vi_lfreq = 660 * ifs;
  vi_minp = ((16 ^ (0.5 - p_maxf)) * fs) / 440;
  vi_maxp = 0.029999999329447746 * fs;
  vi_root = log10(8.175799369812012 * ifs);
  vi_vuv = p_sthr * p_sthr;
  o_1 = p_track; o_2 = p_pitch; o_3 = p_breath; o_4 = p_sthr; o_5 = p_maxf;
);

vi_resume();

@slider

last_srate != srate ? (
  last_srate = srate;
  meter_decay = 0.001 ^ (1 / (0.4 * srate));
  vi_dirty = 1;
);

@block

vi_started ? (
  abs(vi_he) > 0.0000000001 ? 0 : vi_he = 0;
  abs(vi_l1) > 0.0000000001 ? 0 : vi_l0 = vi_l1 = vi_le = 0;
  vi_tr ? vi_pstep = vi_ds;
);
vi_started = 1;
(vi_dirty || p_track !== o_1 || p_pitch !== o_2 || p_breath !== o_3 || p_sthr !== o_4 || p_maxf !== o_5) ? ( vi_resume(); vi_dirty = 0; );

vi_ds = vi_pstep;
vi_et = vi_lfreq * 0.10000000149011612;
vi_mn = vi_minp;
vi_tr = vi_track;

@sample

vi_a = spl0;
vi_l0 -= vi_lfreq * (vi_l1 + vi_a);
vi_l1 -= vi_lfreq * (vi_l1 - vi_l0);
vi_le -= vi_et * (vi_le - abs(vi_l0));
vi_he -= vi_et * (vi_he - abs((vi_a + 0.029999999329447746) * vi_vuv));
vi_l3 += 1;
vi_tr > 0 ? (
  (vi_l1 > 0 && vi_l2 <= 0) ? (
    (vi_l3 > vi_mn && vi_l3 < vi_maxp) ? (
      vi_mn = 0.6000000238418579 * vi_l3;
      vi_l2 = vi_l1 / (vi_l1 - vi_l2);
      vi_ds = vi_pmult / (vi_l3 - vi_l2);
      vi_tr == 2 ? (
        vi_ds = 39.863136291503906 * (log10(vi_ds) - vi_root);
        vi_ds = 1.0594631 ^ (floor(vi_ds + 0.5) + (39.863136291503906 * vi_root));
      );
    );
    vi_l3 = vi_l2;
  );
  vi_l2 = vi_l1;
);
vi_seed = (vi_seed * 214013) + 2531011;
vi_seed -= floor(vi_seed / 4294967296) * 4294967296;
vi_b = 0.000009999999747378752 * ((floor(vi_seed / 65536) & 32767) - 16384);
vi_vo = vi_le > vi_he;
vi_vo ? vi_b *= vi_s * vi_noise;
vi_b += vi_s;
vi_s += vi_ds;
vi_s > 0.5 ? vi_s -= 1;
spl1 = vi_b;

abs(vi_a) > ipk ? ipk = abs(vi_a) : ipk *= meter_decay;
abs(spl1) > opk ? opk = abs(spl1) : opk *= meter_decay;

@gfx 760 336

DW = 760;
DH = 336;
scale = max(0.5, min(gfx_w / DW, gfx_h / DH));
ox = floor((gfx_w - DW*scale) * 0.5);
oy = 0;

MARGIN = 14*scale;
CW = 92*scale;
KR = 28*scale;
PANEL_H = 128*scale;
GHIST = 200000;
HN = 96;

function automate(s, end_touch)
(
<?
  max_sliders > 5 ? printf("slider_automate(2^(s-1), end_touch);") :
    printf("s == 1 ? slider_automate(p_track, end_touch) : s == 2 ? slider_automate(p_pitch, end_touch) : s == 3 ? slider_automate(p_breath, end_touch) : s == 4 ? slider_automate(p_sthr, end_touch) : s == 5 ? slider_automate(p_maxf, end_touch) :");
?> 0;
);
function set_slider(s, v) ( slider(s) = v; automate(s, 0); automate(s, 1); );
function hit_circle(mx, my, cx, cy, rad) ( sqr(mx - cx) + sqr(my - cy) <= sqr(rad); );
function hit_rect(mx, my, x, y, w, h) ( mx >= x && mx <= x+w && my >= y && my <= y+h; );
function g_trunc(x) ( x < 0 ? ceil(x) : floor(x); );

function set_norm(s, v)
local(old)
(
  old = slider(s);
  slider(s) = floor(v*1000 + 0.5) / 1000;
  slider(s) !== old ? automate(s, 0);
);

function upper(str)
local(i, c)
(
  i = 0;
  loop(strlen(str),
    c = str_getchar(str, i);
    (c >= 97 && c <= 122) ? str_setchar(str, i, c - 32);
    i += 1;
  );
  str;
);

function draw_knob(cx, cy, rad, pos, cr, cg, cb, valtext, name)
local(ang0, ang1, ang, i, tx, ty)
(
  ang0 = -2.35619;
  ang1 =  2.35619;
  gfx_set(0.05, 0.05, 0.06, 1);
  gfx_circle(cx, cy, rad + 2*scale, 1, 1);
  gfx_set(cr*0.55, cg*0.55, cb*0.55, 1);
  gfx_circle(cx, cy, rad, 1, 1);
  gfx_set(cr, cg, cb, 1);
  gfx_circle(cx, cy, rad*0.72, 1, 1);
  gfx_set(1, 1, 1, 0.18);
  gfx_circle(cx - rad*0.28, cy - rad*0.28, rad*0.42, 1, 1);
  i = 0;
  loop(9,
    ang = ang0 + (ang1 - ang0) * (i / 8);
    gfx_set(0.85, 0.85, 0.85, 0.7);
    gfx_line(cx + sin(ang)*rad*0.82, cy - cos(ang)*rad*0.82, cx + sin(ang)*rad*0.98, cy - cos(ang)*rad*0.98, 1);
    i += 1;
  );
  ang = ang0 + (ang1 - ang0) * pos;
  gfx_set(0.05, 0.05, 0.05, 1);
  gfx_line(cx, cy, cx + sin(ang)*rad*0.85, cy - cos(ang)*rad*0.85, 1);
  gfx_setfont(1, "Arial", 14*scale);
  gfx_set(0.85, 0.85, 0.85, 1);
  gfx_measurestr(valtext, tx, ty);
  gfx_x = cx - tx*0.5; gfx_y = cy - rad - 18*scale;
  gfx_drawstr(valtext);
  gfx_set(0.8, 0.8, 0.82, 1);
  gfx_measurestr(name, tx, ty);
  gfx_x = cx - tx*0.5; gfx_y = cy + rad + 7*scale;
  gfx_drawstr(name);
);

function lcd_touch(s) ( lcd_sl = s; lcd_t = time_precise(); );

function row_begin(y, nk, ns)
(
  rx = ox + (DW*scale - (nk*CW + ns*8*scale + (ns - 1)*10*scale)) * 0.5;
  ry = oy + y;
);

function sec(nk, title, cr, cg, cb)
local(w, tw, th)
(
  w = nk*CW + 8*scale;
  gfx_set(0.035, 0.035, 0.04, 1);
  gfx_rect(rx - scale, ry - scale, w + 2*scale, PANEL_H + 2*scale, 1);
  gfx_set(0.125, 0.125, 0.14, 1);
  gfx_rect(rx, ry, w, PANEL_H, 1);
  gfx_set(cr, cg, cb, 0.8);
  gfx_rect(rx, ry, w, max(1, 2*scale), 1);
  gfx_setfont(1, "Arial", 12*scale, 'b');
  gfx_set(cr*0.75 + 0.15, cg*0.75 + 0.15, cb*0.75 + 0.15, 1);
  gfx_measurestr(title, tw, th);
  gfx_x = rx + (w - tw)*0.5; gfx_y = ry + 5*scale;
  gfx_drawstr(title);
  k_sx = rx + 4*scale; k_col = 0;
  k_r = cr; k_g = cg; k_b = cb;
  sec_x = rx; sec_w = w;
  rx += w + 10*scale;
);

function seg_btn(s, x, y, w, h, label, act, fs)
local(tw, th, gap, hov)
(
  hov = hit_rect(mouse_x, mouse_y, x, y, w, h);
  hov ? hov_s = s;
  gap = max(1, scale);
  gfx_set(0.03, 0.03, 0.04, 1);
  gfx_rect(x - gap, y - gap, w + 2*gap, h + 2*gap, 1);
  act ? gfx_set(acc_r*0.62, acc_g*0.62, acc_b*0.62, 1) : gfx_set(hov ? 0.17 : 0.14, hov ? 0.17 : 0.14, hov ? 0.19 : 0.16, 1);
  gfx_rect(x, y, w, h, 1);
  act ? gfx_set(acc_r, acc_g, acc_b, 1) : gfx_set(0.21, 0.21, 0.24, 1);
  gfx_rect(x + gap, y + gap, w - 2*gap, h*0.5, 1);
  gfx_set(1, 1, 1, act ? 0.22 : 0.08);
  gfx_rect(x + gap, y + gap, w - 2*gap, h*0.3, 1);
  gfx_setfont(1, "Arial", fs*scale, 'b');
  act ? gfx_set(0.08, 0.08, 0.10, 1) : gfx_set(0.78, 0.78, 0.80, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + (w - tw)*0.5; gfx_y = y + (h - th)*0.5;
  gfx_drawstr(label);
  mouse_just_down && hov;
);

function glow_text(str, x, y, r, g, b)
(
  gfx_set(r, g, b, 0.16);
  gfx_x = x - scale; gfx_y = y; gfx_drawstr(str);
  gfx_x = x + scale; gfx_y = y; gfx_drawstr(str);
  gfx_x = x; gfx_y = y - scale; gfx_drawstr(str);
  gfx_x = x; gfx_y = y + scale; gfx_drawstr(str);
  gfx_set(r, g, b, 1);
  gfx_x = x; gfx_y = y; gfx_drawstr(str);
);

function meter(x, y, w, h, pk, label)
local(db, fy, tw, th)
(
  gfx_setfont(1, "Arial", 11*scale, 'b');
  gfx_set(0.62, 0.63, 0.66, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + w*0.5 - tw*0.5; gfx_y = y;
  gfx_drawstr(label);
  y += th + 3*scale;
  h -= th + 3*scale;
  gfx_set(0.04, 0.04, 0.05, 1);
  gfx_rect(x - scale, y - scale, w + 2*scale, h + 2*scale, 1);
  gfx_set(acc_r*0.22, acc_g*0.22, acc_b*0.22, 1);
  gfx_rect(x, y, w, h, 1);
  db = pk > 0.000001 ? 20 * log10(pk) : -100;
  fy = y + h * (1 - max(0, min(1, (db + 60) / 60)));
  db > -1 ? gfx_set(1.0, 0.35, 0.30, 1) : gfx_set(acc_r, acc_g, acc_b, 1);
  gfx_rect(x, fy, w, y + h - fy, 1);
);

function lcd_frame(x, y, w, h)
(
  LX = x; LY = y; LW = w; LH = h;
  gfx_set(0.03, 0.03, 0.04, 1);
  gfx_rect(LX - 2*scale, LY - 2*scale, LW + 4*scale, LH + 4*scale, 1);
  gfx_set(0.17, 0.17, 0.19, 1);
  gfx_rect(LX, LY, LW, LH, 1);
  GX = LX + 6*scale; GY = LY + 6*scale; GW = LW - 12*scale; GH = LH - 12*scale;
  gfx_set(0.02, 0.02, 0.02, 1);
  gfx_rect(GX - scale, GY - scale, GW + 2*scale, GH + 2*scale, 1);
  gfx_set(0.035 + acc_r*0.05, 0.035 + acc_g*0.05, 0.035 + acc_b*0.05, 1);
  gfx_rect(GX, GY, GW, GH, 1);
  lc_r = min(1, 0.35 + acc_r*0.75); lc_g = min(1, 0.35 + acc_g*0.75); lc_b = min(1, 0.35 + acc_b*0.75);
);

function lcd_finish()
local(scy)
(
  gfx_set(0, 0, 0, 0.22);
  scy = GY;
  while (scy < GY + GH) ( gfx_rect(GX, scy, GW, max(1, scale), 1); scy += 3*scale; );
  gfx_set(1, 1, 1, 0.035);
  gfx_rect(GX, GY, GW, GH*0.45, 1);
);

function header(title, sub)
(
  gfx_set(0.09, 0.08, 0.08, 1);
  gfx_rect(0, 0, gfx_w, gfx_h, 1);
  gfx_setfont(1, "Arial", 20*scale, 'b');
  gfx_set(acc_r, acc_g, acc_b, 1);
  gfx_x = ox + MARGIN; gfx_y = oy + 8*scale;
  gfx_drawstr(title);
  gfx_setfont(1, "Arial", 13*scale);
  gfx_set(0.58, 0.60, 0.64, 1);
  gfx_x = ox + MARGIN + 2*scale; gfx_y = oy + 30*scale;
  gfx_drawstr(sub);
);

function hline(y) ( gfx_set(0.04, 0.04, 0.05, 1); gfx_rect(0, oy + y, gfx_w, max(1, scale), 1); );

function hint_bar(y, h, str)
local(tw, th)
(
  hline(y);
  gfx_setfont(1, "Arial", 13*scale);
  gfx_set(0.62, 0.63, 0.66, 1);
  strcpy(#ghint, str);
  gfx_measurestr(#ghint, tw, th);
  tw > (DW - 20)*scale ? ( gfx_setfont(1, "Arial", 13*scale*(DW - 20)*scale/tw); gfx_measurestr(#ghint, tw, th); );
  gfx_x = ox + (DW*scale - tw)*0.5; gfx_y = oy + y + (h - th)*0.5;
  gfx_drawstr(#ghint);
);


function def_val(s) ( s == 1 ? 0.25 : s == 2 ? 0.5 : s == 3 ? 0.2 : s == 4 ? 0.5 : 0.35; );

function knob_name(s) ( s == 1 ? "Tracking" : s == 2 ? "Pitch" : s == 3 ? "Breath" : s == 4 ? "S Thresh" : "Max Freq"; );

function hint_text(s)
(
  s == 1 ? "Tracking: Off plays a constant pitch, Free follows the input pitch, Quant follows it to the nearest semitone" :
  s == 2 ? "Pitch: oscillator note when tracking is off, or transpose in semitones while tracking" :
  s == 3 ? "Breath: amount of breath noise on voiced sounds" :
  s == 4 ? "S Thresh: sensitivity for adding sibilance (fricative noise) on consonants" :
  s == 5 ? "Max Freq: highest pitch the tracker accepts, mainly to reduce tracking errors" :
  "Voice passes through on the left channel; the carrier comes out on the right, ready for a vocoder";
);

function note_str(n, dst)
local(o, k)
(
  o = g_trunc(n / 12); k = n - 12 * o; o -= 2;
  strcpy(dst, k == 0 ? "C" : k == 1 ? "C#" : k == 2 ? "D" : k == 3 ? "D#" : k == 4 ? "E" : k == 5 ? "F" :
              k == 6 ? "F#" : k == 7 ? "G" : k == 8 ? "G#" : k == 9 ? "A" : k == 10 ? "A#" : "B");
  strcat(dst, sprintf(#gns, "%d", o));
  dst;
);

function ptext(s)
local(v)
(
  v = slider(s);
  s == 1 ? strcpy(#ptxt, g_trk == 0 ? "OFF" : g_trk == 1 ? "FREE" : "QUANT") :
  s == 2 ? ( g_trk ? sprintf(#ptxt, "%+d st", g_trunc(48 * v - 24)) : note_str(g_trunc(48 * v + 21), #ptxt); ) :
  s == 5 ? note_str(g_trunc(48 * v + 45), #ptxt) :
  sprintf(#ptxt, "%.0f %%", 100 * v);
  #ptxt;
);

function knob_at(s, cx, cy, rad, cr, cg, cb)
local(hov, gv)
(
  hov = hit_circle(mouse_x, mouse_y, cx, cy, rad + 4*scale);
  hov ? hov_s = s;
  (mouse_just_down && hov) ? (
    (click_target == s && time_precise() - click_time < 0.3) ? (
      set_slider(s, def_val(s));
      drag_target = 0;
      lcd_touch(s);
    ) : (
      drag_target = s; drag_y0 = mouse_y; drag_v0 = slider(s); drag_fine = mouse_cap & 4;
    );
    click_target = s; click_time = time_precise();
  );
  (hov && mouse_wheel != 0 && drag_target == 0) ? (
    gv = slider(s) + (mouse_wheel / 120) * ((mouse_cap & 4) ? 0.001 : 0.01);
    set_norm(s, max(0, min(1, gv)));
    automate(s, 1);
    lcd_touch(s);
    mouse_wheel = 0;
  );
  draw_knob(cx, cy, rad, slider(s), cr, cg, cb, ptext(s), knob_name(s));
);

function knob(s)
local(cx, cy)
(
  cx = k_sx + CW*(k_col + 0.5);
  cy = ry + 72*scale;
  k_col += 1;
  knob_at(s, cx, cy, KR, k_r, k_g, k_b);
);

function drag_update()
(
  drag_target > 0 ? (
    mouse_down ? (
      mouse_cap |= 65536;
      fine_now = mouse_cap & 4;
      fine_now != drag_fine ? ( drag_y0 = mouse_y; drag_v0 = slider(drag_target); drag_fine = fine_now; );
      gv = max(0, min(1, drag_v0 + (drag_y0 - mouse_y) / (150*scale) * (fine_now ? 0.1 : 1)));
      set_norm(drag_target, gv);
      lcd_touch(drag_target);
    ) : ( automate(drag_target, 1); drag_target = 0; );
  );
);


function fy_of(hz) ( VY + VH * (1 - max(0, min(1, log(max(hz, 1) / 40) / log(1600 / 40)))); );

mouse_down = mouse_cap & 1;
mouse_just_down = mouse_down && !mouse_state;
hov_s = 0;
acc_r = 0.36; acc_g = 0.84; acc_b = 0.74;
g_trk = g_trunc(2.990000009536743 * p_track);

header("CARRIER PIGEON", "by chmaha  ·  based on mda VocInput");
TABW = 72*scale; TABH = 26*scale; TABG = 5*scale;
tx0 = ox + DW*scale - MARGIN - 3*TABW - 2*TABG;
seg_btn(1, tx0, oy + 11*scale, TABW, TABH, "OFF", g_trk == 0, 13) ? ( set_slider(1, 0.167); mouse_just_down = 0; );
seg_btn(1, tx0 + TABW + TABG, oy + 11*scale, TABW, TABH, "FREE", g_trk == 1, 13) ? ( set_slider(1, 0.5); mouse_just_down = 0; );
seg_btn(1, tx0 + 2*(TABW + TABG), oy + 11*scale, TABW, TABH, "QUANT", g_trk == 2, 13) ? ( set_slider(1, 0.833); mouse_just_down = 0; );
g_trk = g_trunc(2.990000009536743 * p_track);
gfx_setfont(1, "Arial", 12*scale, 'b');
gfx_set(0.62, 0.63, 0.66, 1);
gfx_measurestr("TRACKING", gtw, gth);
gfx_x = tx0 - gtw - 10*scale; gfx_y = oy + 11*scale + (TABH - gth)*0.5;
gfx_drawstr("TRACKING");
hline(46*scale);

lcd_frame(ox + MARGIN, oy + 56*scale, 600*scale, 96*scale);
TAW = 230*scale;
g_hz = vi_ds * srate;
gfx_setfont(2, "Courier New", 14*scale, 'b');
glow_text("CARRIER", GX + 10*scale, GY + 6*scale, lc_r, lc_g, lc_b);
strcpy(#lt, g_trk == 0 ? "FIXED" : g_trk == 1 ? "FREE TRACK" : "QUANTISED");
gfx_measurestr(#lt, ltw, lth);
glow_text(#lt, GX + TAW - ltw, GY + 6*scale, lc_r, lc_g, lc_b);
g_hz > 1 ? sprintf(#ln, "%.1f HZ", g_hz) : strcpy(#ln, "-- HZ");
gfx_setfont(2, "Courier New", 26*scale, 'b');
gfx_measurestr(#ln, ltw, lth);
glow_text(#ln, GX + 10*scale + (TAW - 10*scale - ltw)*0.5, GY + 26*scale + (26*scale - lth)*0.5, lc_r, lc_g, lc_b);
gfx_setfont(2, "Courier New", 14*scale, 'b');
LY3 = GY + GH - 20*scale;
(lcd_sl > 0 && time_precise() - lcd_t < 1.5) ? (
  strcpy(#lt, knob_name(lcd_sl)); upper(#lt);
  glow_text(#lt, GX + 10*scale, LY3, lc_r, lc_g, lc_b);
  strcpy(#lv, ptext(lcd_sl)); upper(#lv);
  gfx_measurestr(#lv, ltw, lth);
  glow_text(#lv, GX + TAW - ltw, LY3, lc_r, lc_g, lc_b);
) : (
  g_hz > 1 ? note_str(floor(12 * log(g_hz / 8.1757989) / log(2) + 0.5), #lt) : strcpy(#lt, "--");
  sprintf(#lv, "NOTE %s", #lt);
  glow_text(#lv, GX + 10*scale, LY3, lc_r, lc_g, lc_b);
  g_vo_l = vi_vo ? min(1, g_vo_l + 0.25) : g_vo_l * 0.85;
  strcpy(#lv, "VOICED");
  gfx_measurestr(#lv, ltw, lth);
  glow_text(#lv, GX + TAW - ltw - 14*scale, LY3, lc_r, lc_g, lc_b);
  gfx_set(lc_r, lc_g, lc_b, 0.18 + 0.82 * g_vo_l);
  gfx_circle(GX + TAW - 4*scale, LY3 + lth*0.5, 4*scale, 1, 1);
);

SDX = GX + TAW + 12*scale;
gfx_set(lc_r, lc_g, lc_b, 0.18);
gfx_rect(SDX, GY + 8*scale, max(1, scale), GH - 16*scale, 1);
VX = SDX + 12*scale; VW = GX + GW - 10*scale - VX;
VY = GY + 8*scale; VH = GH - 16*scale;
hist_t += 1;
hist_t >= 2 ? (
  hist_t = 0;
  ghi = 0; loop(HN - 1, GHIST[ghi] = GHIST[ghi + 1]; GHIST[HN + ghi] = GHIST[HN + ghi + 1]; ghi += 1; );
  GHIST[HN - 1] = g_hz; GHIST[2*HN - 1] = ipk;
);
gfx_set(lc_r, lc_g, lc_b, 0.08);
gfx_rect(VX, VY, VW, VH, 1);
gfx_setfont(1, "Arial", 11*scale);
ghi = 0;
loop(3,
  gfq = ghi == 0 ? 100 : ghi == 1 ? 300 : 1000;
  gfy = fy_of(gfq);
  gfx_set(lc_r, lc_g, lc_b, 0.16);
  gfx_rect(VX, gfy, VW, max(1, scale), 1);
  gfx_set(lc_r, lc_g, lc_b, 0.6);
  gfx_x = VX + 3*scale; gfx_y = gfy - 12*scale; gfx_drawstr(sprintf(#gns, "%d", gfq));
  ghi += 1;
);
g_trk ? (
  gmy = fy_of(srate / max(1, vi_minp));
  gfx_set(1, 0.9, 0.5, 0.7);
  gfx_rect(VX, gmy, VW, max(1, scale), 1);
  gfx_set(1, 0.9, 0.5, 0.8);
  gfx_x = VX + VW - 30*scale; gfx_y = max(VY, gmy - 12*scale); gfx_drawstr("MAX");
);
gbw = VW / HN;
ghi = 0;
loop(HN,
  GHIST[ghi] > 1 ? (
    gfy = fy_of(GHIST[ghi]);
    gfx_set(lc_r, lc_g, lc_b, 0.25 + 0.7 * min(1, GHIST[HN + ghi] * 4));
    gfx_rect(VX + ghi * gbw, gfy - scale, max(1, gbw - scale), max(2, 3*scale), 1);
  );
  ghi += 1;
);
lcd_finish();

MW = 16*scale;
MAX0 = LX + LW + 26*scale;
MSP = (ox + DW*scale - MARGIN - MAX0 - MW);
meter(MAX0, LY, MW, LH, ipk, "VOICE");
meter(MAX0 + MSP, LY, MW, LH, opk, "OUT");

hline(162*scale);
row_begin(170*scale, 4, 2);
sec(2, "PITCH", 0.36, 0.84, 0.74); knob(2); knob(5);
sec(2, "NOISE", 0.80, 0.80, 0.84); knob(3); knob(4);

hint_bar(304*scale, 32*scale, hint_text(drag_target > 0 ? drag_target : hov_s));

drag_update();

mouse_wheel = 0;
mouse_state = mouse_down;
