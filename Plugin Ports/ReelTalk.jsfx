    ) : (
      ch_pow = (1 + 2 * chr.jr_float()) * p_chew_depth;
      ch_crink ? chfl.sm_set(ch_hf - ch_fc * p_chew_depth);
    );
    chm0.sv_set(ch_mix);
    chp0.sv_set(1 + ch_pow);
    ch_dro = !(chm0.tgt === 0 && chm0.cnt <= 0);
    ch_cnt += 64;
  );
  ch_dro ? (
    m = chm0.sv_next(); pw = chp0.sv_next();
    xl = m * (abs(xl) ^ pw * ((xl > 0) - (xl < 0))) + (1 - m) * xl;
    xr = m * (abs(xr) ^ pw * ((xr > 0) - (xr < 0))) + (1 - m) * xr;
  );
  chfl.cnt > 0 ? chf_coefs(chfl.sm_next());
  t = chf_z + xl * chf_b0; chf_z = xl * chf_b0 - t * chf_a1; xl = t;
  t = chf_zr + xr * chf_b0; chf_zr = xr * chf_b0 - t * chf_a1; xr = t;
  chb.fade ? ( xl = xl * chb.gw + il * chb.gd; xr = xr * chb.gw + ir * chb.gd; chb.gw += chb.iw; chb.gd += chb.id; );
);

dg_act ? (
  il = xl; ir = xr;
  lv = abs(xl) * (1 / 2);
  lv += abs(xr) * (1 / 2);
  tau = dg_inc ? dg_ta : dg_tr; lv = dg_y + tau * (lv - dg_y); dg_inc = lv > dg_y; dg_y = lv;
  dgn_ramp ? (
    nl = 0 + (dnl.jr_float() - 0.5) * ((dgn_cur * bpos / BS) + (dgn_p0 * (1 - bpos / BS)));
    nr = 0 + (dnr.jr_float() - 0.5) * ((dgn_cur * bpos / BS) + (dgn_p0 * (1 - bpos / BS)));
  ) : (
    nl = 0 + (dnl.jr_float() - 0.5) * dgn_cur;
    nr = 0 + (dnr.jr_float() - 0.5) * dgn_cur;
  );
  dg_env ? ( nl *= lv; nr *= lv; );
  xl += nl; xr += nr;
  dgfl.cnt > 0 ? dgf_coefs(dgfl.sm_next(), 0);
  t = dgfl_z + xl * dgfl_b0; dgfl_z = xl * dgfl_b0 - t * dgfl_a1; xl = t;
  dgfr.cnt > 0 ? dgf_coefs(dgfr.sm_next(), 1);
  t = dgfr_z + xr * dgfr_b0; dgfr_z = xr * dgfr_b0 - t * dgfr_a1; xr = t;
  xl *= dg_g; xr *= dg_g; dg_g += dg_ginc;
  dgb.fade ? ( xl = xl * dgb.gw + il * dgb.gd; xr = xr * dgb.gw + ir * dgb.gd; dgb.gw += dgb.iw; dgb.gd += dgb.id; );
);

wf_w = (wf_w + 1) & 32767;
wf_act ? (
  il = xl; ir = xr;
  wf_ph += wf_ad;
  cd = wfdl.sm_next() * wf_amp;
  oh_y += oh_sqd * OHN[bpos] * oh_amt;
  oh_y += oh_damp * (oh_mean - oh_y) * oh_t;
  v3 = oh_y - oh_s2; v1 = oh_a2 * v3 + oh_a1 * oh_s1; v2 = oh_a3 * v3 + oh_a2 * oh_s1 + oh_s2;
  oh_s1 = 2 * v1 - oh_s1; oh_s2 = 2 * v2 - oh_s2;
  wv = cd * (cos(wf_ph) + v2);
  fl_p1 += fl_ad1; fl_p2 += fl_ad2; fl_p3 += fl_ad3;
  fv = wfdf.sm_next() * (fl_a1 * cos(fl_p1 + 0) + fl_a2 * cos(fl_p2 + fl_o2) + fl_a3 * cos(fl_p3 + fl_o3));
  t = (wv + fv + fl_dc + cd) * srate / 1000;
  t = min(max(t, 0), 32760);
  wf_dly = t;
  WFDL[wf_w] = xl; WFDR[wf_w] = xr;
  xl = dl3_read(WFDL, 32767, wf_w, t);
  xr = dl3_read(WFDR, 32767, wf_w, t);
  wf_mw = wv / wf_amp; wf_mf = fv / (230 * 1000 / srate);
  xl = wfcl.dcb_tick(xl); xr = wfcr.dcb_tick(xr);
  wfb.fade ? ( xl = xl * wfb.gw + il * wfb.gd; xr = xr * wfb.gw + ir * wfb.gd; wfb.gw += wfb.iw; wfb.gd += wfb.id; );
) : (
  wf_ph += wf_ad;
  fl_p1 += fl_ad1; fl_p2 += fl_ad2; fl_p3 += fl_ad3;
  WFDL[wf_w] = 0; WFDR[wf_w] = 0;
  wf_mw = wf_mf = 0;
);

lf_on ? (
  il = xl; ir = xr;
  lz0 = LFZ + lf_act * 1664; lz1 = LFZ + (!lf_act) * 1664;
  lf_fading ? (
    fxl = xl; fxr = xr;
  ) : (
    fir_push(lz1, 0, xl); fir_push(lz1, 1, xr);
  );
  xl = fir_run2(lz0, xl, xr); xr = FIRY;
  lf_act ? (
    t = xl * lb1_b0 + lb1_zl1; lb1_zl1 = xl * lb1_b1 - t * lb1_a1 + lb1_zl2; lb1_zl2 = xl * lb1_b2 - t * lb1_a2; xl = t;
    t = xr * lb1_b0 + lb1_zr1; lb1_zr1 = xr * lb1_b1 - t * lb1_a1 + lb1_zr2; lb1_zr2 = xr * lb1_b2 - t * lb1_a2; xr = t;
  ) : (
    t = xl * lb0_b0 + lb0_zl1; lb0_zl1 = xl * lb0_b1 - t * lb0_a1 + lb0_zl2; lb0_zl2 = xl * lb0_b2 - t * lb0_a2; xl = t;
    t = xr * lb0_b0 + lb0_zr1; lb0_zr1 = xr * lb0_b1 - t * lb0_a1 + lb0_zr2; lb0_zr2 = xr * lb0_b2 - t * lb0_a2; xr = t;
  );
  lf_fading ? (
    fxl = fir_run2(lz1, fxl, fxr); fxr = FIRY;
    !lf_act ? (
      t = fxl * lb1_b0 + lb1_zl1; lb1_zl1 = fxl * lb1_b1 - t * lb1_a1 + lb1_zl2; lb1_zl2 = fxl * lb1_b2 - t * lb1_a2; fxl = t;
      t = fxr * lb1_b0 + lb1_zr1; lb1_zr1 = fxr * lb1_b1 - t * lb1_a1 + lb1_zr2; lb1_zr2 = fxr * lb1_b2 - t * lb1_a2; fxr = t;
    ) : (
      t = fxl * lb0_b0 + lb0_zl1; lb0_zl1 = fxl * lb0_b1 - t * lb0_a1 + lb0_zl2; lb0_zl2 = fxl * lb0_b2 - t * lb0_a2; fxl = t;
      t = fxr * lb0_b0 + lb0_zr1; lb0_zr1 = fxr * lb0_b1 - t * lb0_a1 + lb0_zr2; lb0_zr2 = fxr * lb0_b2 - t * lb0_a2; fxr = t;
    );
    bpos < lf_n ? (
      xl = xl * lf_gs + fxl * lf_dg; xr = xr * lf_gs + fxr * lf_dg;
      lf_gs += lf_ginc; lf_dg += lf_dinc;
    ) : (
      xl *= lf_ge; xr *= lf_ge;
    );
  );
  az_w = (az_w + 1) & 4095;
  azl.cnt > 0 ? azl_d = azl.sv_next();
  AZDL[az_w] = xl; xl = dl3_read(AZDL, 4095, az_w, azl_d);
  azr.cnt > 0 ? azr_d = azr.sv_next();
  AZDR[az_w] = xr; xr = dl3_read(AZDR, 4095, az_w, azr_d);
  lsb.fade ? ( xl = xl * lsb.gw + il * lsb.gd; xr = xr * lsb.gw + ir * lsb.gd; lsb.gw += lsb.iw; lsb.gd += lsb.id; );
);

dry_w = (dry_w + 1) & 4095;
DRYL[dry_w] = dl; DRYR[dry_w] = dr;
dw_ramp || dw_cur !== 1 ? (
  dl = dl5_read(DRYL, 4095, dry_w, dry_dly);
  dr = dl5_read(DRYR, 4095, dry_w, dry_dly);
);

p_balmk ? ( xl *= mso0.sv_next(); xr *= mso1.sv_next(); );
ms_cur ? (
  xl *= 10 ^ (3 * 0.05); xr *= 10 ^ (3 * 0.05);
  xr *= -1;
  xl += xr * -1;
  xl *= 0.5;
  xr += xl;
);
ms_fading ? ( xl *= ms_fg; xr *= ms_fg; ms_fg += ms_finc; );

mk_act ? (
  il = xl; ir = xr;
  mk_on ? (
    mk_w = (mk_w + 1) & 4095;
    MKDL[mk_w] = 0 + cl_l + ch_l; MKDR[mk_w] = 0 + cl_r + ch_r;
    xl += dl3_read(MKDL, 4095, mk_w, mk_dly);
    xr += dl3_read(MKDR, 4095, mk_w, mk_dly);
  );
  ifm.fade ? ( xl = xl * ifm.gw + il * ifm.gd; xr = xr * ifm.gw + ir * ifm.gd; ifm.gw += ifm.iw; ifm.gd += ifm.id; );
);

xl *= og_g; xr *= og_g; og_g += og_inc;

dw_ramp ? (
  xl = xl * dw_g + dl * dw_d; xr = xr * dw_g + dr * dw_d;
  dw_g += dw_ginc; dw_d += dw_dinc;
) : dw_cur !== 1 ? (
  xl *= dw_cur; xr *= dw_cur;
  xl += dl * (1 - dw_cur); xr += dr * (1 - dw_cur);
);

!(abs(xl) < 100) ? xl = 0;
!(abs(xr) < 100) ? xr = 0;
spl0 = xl; spl1 = xr;
rms_bo += xl * xl;
sc_w = (sc_w + 1) & 2047;
SCOPE[sc_w] = xl;

bpos += 1;
bpos >= BS ? ( block_end(); bpos = 0; );

(!sl_in && abs(xl) + abs(xr) < 0.00000003) ? (
  sl_q += 1;
  sl_q >= max(srate, 40000) ? ( sl_on = 1; sl_q = 0; sl_b = 0; sl_store(); );
) : sl_q = 0;

);

@gfx 720 612

DW = 720;
DH = 612;
scale = max(0.5, min(gfx_w / DW, gfx_h / DH));
ox = floor((gfx_w - DW * scale) * 0.5);
oy = 0;

function px(x) ( ox + x * scale; );
function py(y) ( oy + y * scale; );
function font(sz, fl) ( gfx_setfont(1, "Arial", (sz + 2) * scale, fl); );

function automate(s, end_touch)
(
<?
  max_sliders > 49 ? printf("slider_automate(2^(s-1), end_touch);") :
    loop(i = 1; 49,
      printf("  s == %d ? slider_automate(slider%d, end_touch) :\n", i, i);
      i += 1;
    );
?> 0;
);

function set_slider(s, v) ( slider(s) = v; automate(s, 0); automate(s, 1); );

function hit_circle(mx, my, cx, cy, rad) ( sqr(mx - cx) + sqr(my - cy) <= sqr(rad); );
function hit_rect(mx, my, x, y, w, h) ( mx >= x && mx <= x + w && my >= y && my <= y + h; );

function s_min(s) (
  s == 1 ? -30 : s == 2 ? -30 : s == 5 ? 20 : s == 6 ? 2000 : (s == 9 || s == 10 || s == 47) ? -1 : s == 11 ? 100 :
  s == 14 ? 0.1 : s == 15 ? 10 : s == 24 ? 1 : (s == 25 || s == 26) ? 0.1 : s == 27 ? 1 : s == 28 ? -75 : 0;
);
function s_max(s) (
  s == 1 ? 6 : s == 2 ? 30 : s == 5 ? 2000 : s == 6 ? 22000 : s == 11 ? 4000 : s == 13 ? 9 : s == 14 ? 50 :
  s == 15 ? 1000 : s == 24 ? 50 : s == 25 ? 20 : s == 26 ? 50 : s == 27 ? 50 : s == 28 ? 75 : 1;
);
function s_ctr(s) (
  s == 5 ? 250 : s == 6 ? 10000 : s == 11 ? 500 : s == 13 ? 3 : s == 14 ? 10 : s == 15 ? 100 :
  s == 24 ? 15 : s == 25 ? 10 : s == 26 ? 15 : s == 27 ? 10 : -1000;
);
function s_skew(s) local(c) (
  c = s_ctr(s);
  c > -1000 ? log(0.5) / log((c - s_min(s)) / (s_max(s) - s_min(s))) : 1;
);
function s_def(s) (
  s == 3 ? 1 : s == 5 ? 20 : s == 6 ? 22000 : s == 11 ? 500 : s == 14 ? 5 : s == 15 ? 200 : (s == 17 || s == 18 || s == 19) ? 0.5 :
  s == 24 ? 30 : (s == 25 || s == 26) ? 0.1 : s == 27 ? 1 : s == 30 ? 0.3 : s == 32 ? 0.25 : 0;
);
function to_pos(s, v) local(a, b) (
  a = s_min(s); b = s_max(s);
  max(0, min(1, (v - a) / (b - a))) ^ s_skew(s);
);
function from_pos(s, p) local(a, b) (
  a = s_min(s); b = s_max(s);
  p <= 0 ? a : a + (b - a) * exp(log(min(1, p)) / s_skew(s));
);
function set_pos(s, p) local(v, old) (
  old = slider(s);
  v = from_pos(s, max(0, min(1, p)));
  slider(s) = v;
  v !== old ? automate(s, 0);
);

function s_name(s) (
  s == 1 ? "Input Gain" : s == 2 ? "Output Gain" : s == 3 ? "Dry/Wet" : s == 5 ? "Low Cut" : s == 6 ? "High Cut" :
  s == 9 ? "Bass" : s == 10 ? "Treble" : s == 11 ? "Transition Freq" : s == 13 ? "Amount" : s == 14 ? "Attack" :
  s == 15 ? "Release" : s == 17 ? "Drive" : s == 18 ? "Saturation" : s == 19 ? "Bias" : s == 24 ? "Speed [ips]" :
  s == 25 ? "Spacing [microns]" : s == 26 ? "Thickness [microns]" : s == 27 ? "Gap [microns]" : s == 28 ? "Azimuth [degrees]" :
  s == 30 ? "Rate" : s == 31 ? "Depth" : s == 32 ? "Rate" : s == 33 ? "Depth" : s == 34 ? "Variance" : s == 35 ? "Drift" :
  s == 38 ? "Depth" : s == 39 ? "Amount" : s == 40 ? "Variance" : s == 41 ? "Envelope" : s == 43 ? "Depth" :
  s == 44 ? "Frequency" : s == 45 ? "Variance" : s == 47 ? "Balance" : "";
);

function s_text(s) local(v) (
  v = slider(s);
  (s == 1 || s == 2 || s == 13) ? sprintf(#vt, "%.2f dB", v) :
  (s == 3 || s == 47) ? sprintf(#vt, "%d%%", floor(v * 100 + (v < 0 ? -0.5 : 0.5))) :
  (s == 5 || s == 6 || s == 11) ? ( v > 1000 ? sprintf(#vt, "%.2f kHz", v / 1000) : sprintf(#vt, "%.2f Hz", v); ) :
  (s == 14 || s == 15) ? sprintf(#vt, "%.2f ms", v) :
  (s == 25 || s == 26 || s == 27) ? sprintf(#vt, "%.4f", v) :
  sprintf(#vt, "%.2f", v);
  #vt;
);

function hint_text(h) (
  h == 1 ? "Input Gain: level going into the tape machine (in dB)" :
  h == 2 ? "Output Gain: level coming out of the tape machine (in dB)" :
  h == 3 ? "Dry/Wet: blend between the untouched input and the tape sound" :
  h == 4 ? "Turns the input filters on or off" :
  h == 5 ? "Low Cut: removes lows before the tape processing" :
  h == 6 ? "High Cut: removes highs before the tape processing" :
  h == 7 ? "Makeup: adds the filtered-out signal back after the tape processing" :
  h == 8 ? "Turns the tone controls on or off" :
  h == 9 ? "Bass: boosts or cuts lows before the tape and undoes it after, so the tape saturates the lows more or less" :
  h == 10 ? "Treble: boosts or cuts highs before the tape and undoes it after" :
  h == 11 ? "Transition Freq: where bass turns into treble for the tone controls" :
  h == 12 ? "Turns the tape compression on or off" :
  h == 13 ? "Amount: how much tape-style compression is applied (in dB)" :
  h == 14 ? "Attack: how quickly the compression reacts" :
  h == 15 ? "Release: how quickly the compression recovers" :
  h == 16 ? "Turns the magnetic tape model (hysteresis) on or off" :
  h == 17 ? "Drive: how hard the tape is driven; more drive means more saturation and grit" :
  h == 18 ? "Saturation: how easily the tape saturates (the magnetic saturation level)" :
  h == 19 ? "Bias: the tape bias; lower settings give the gritty, underbiased sound of a misaligned machine" :
  h == 23 ? "Turns the playback head loss effects on or off" :
  h == 24 ? "Speed: tape speed in inches per second; slower tape loses more highs and moves the head bump down" :
  h == 25 ? "Spacing: distance between the tape and the playback head; more spacing dulls the highs" :
  h == 26 ? "Thickness: tape thickness; thicker tape loses more high end" :
  h == 27 ? "Gap: width of the playback head gap; a wider gap rolls off highs and shapes the head bump" :
  h == 28 ? "Azimuth: angle of the playback head; non-zero angles delay one channel for stereo smearing" :
  h == 29 ? "Turns wow and flutter on or off" :
  h == 30 ? "Flutter Rate: speed of the fast pitch wobble" :
  h == 31 ? "Flutter Depth: amount of the fast pitch wobble" :
  h == 32 ? "Wow Rate: speed of the slow pitch drift" :
  h == 33 ? "Wow Depth: amount of the slow pitch drift" :
  h == 34 ? "Wow Variance: adds random variation to the wow" :
  h == 35 ? "Wow Drift: lets the wow speed wander" :
  h == 36 ? "Turns the tape degradation (noise and dulling) on or off" :
  h == 37 ? "0.1x: scales the degrade depth down by 10 for subtle settings" :
  h == 38 ? "Depth: how much noise and level loss the worn tape adds" :
  h == 39 ? "Amount: how dull the worn tape sounds" :
  h == 40 ? "Variance: random variation in the degradation" :
  h == 41 ? "Envelope: makes the noise follow the input level" :
  h == 42 ? "Turns chew (crinkled, damaged tape) on or off" :
  h == 43 ? "Depth: how strongly the damaged spots distort and dull the sound" :
  h == 44 ? "Frequency: how often damaged spots come along; fully up means constant damage" :
  h == 45 ? "Variance: how irregular the damaged spots are" :
  h == 46 ? "Mid/Side: process the mid and side signals instead of left and right" :
  h == 47 ? "Balance: drive one channel (or mid/side) harder than the other" :
  h == 48 ? "Balance Makeup: undo the balance gain after the tape" :
  h == 101 ? "Oversampling: higher settings reduce aliasing from the tape model but cost more CPU" :
  h == 102 ? "Tape Mode: how the tape model is solved; RK2 is cheapest, NR8 most accurate, STN uses a neural network, V1 is the original v1 sound" :
  h == 103 ? "Presets: click for the factory presets, or use the arrows to step through them" :
  h == 104 ? "Sync the flutter rate to the tape speed or the project tempo" :
  h == 105 ? "Sync the wow rate to the tape speed or the project tempo" :
  h == 106 ? "Set the tape speed" :
  "";
);

function arc_band(cx, cy, r0, r1, a0, a1) local(r) (
  r = r0;
  while (r <= r1) ( gfx_arc(cx, cy, r, a0, a1, 1); r += 0.6; );
);

function draw_knob(s, cx, cy, rad) local(p, a0, a1, a, bip, ac, tr, hov, v, tw, th) (
  hov = hit_circle(mouse_x, mouse_y, cx, cy, rad + 8 * scale);
  hov ? hov_s = s;
  (mouse_just_down && hov) ? (
    (click_target == s && time_precise() - click_time < 0.3) ? (
      set_slider(s, s_def(s)); drag_target = 0;
    ) : (
      drag_target = s; drag_kind = 0; drag_y0 = mouse_y; drag_p0 = to_pos(s, slider(s)); drag_fine = mouse_cap & 4;
    );
    click_target = s; click_time = time_precise(); mouse_just_down = 0;
  );
  (hov && wheel != 0 && drag_target == 0) ? (
    set_pos(s, to_pos(s, slider(s)) + wheel / 120 * ((mouse_cap & 4) ? 0.002 : 0.02));
    automate(s, 1); wheel = 0;
  );
  p = to_pos(s, slider(s));
  a0 = -2.35619; a1 = 2.35619;
  a = a0 + (a1 - a0) * p;
  bip = s == 9 || s == 10 || s == 47;
  tr = rad + 5 * scale;
  gfx_set(0.349, 0.361, 0.42, 1);
  arc_band(cx, cy, tr, tr + 3.5 * scale, a0, a1);
  s == 3 ? gfx_set(0.043, 0.741, 0.761, 1) : gfx_set(0.612, 0.737, 0.741, 1);
  bip ? ( a < 0 ? arc_band(cx, cy, tr, tr + 3.5 * scale, a, 0) : arc_band(cx, cy, tr, tr + 3.5 * scale, 0, a); )
      : ( p > 0.002 ? arc_band(cx, cy, tr, tr + 3.5 * scale, a0, a); );
  gfx_set(0.08, 0.08, 0.09, 0.6);
  gfx_circle(cx + 1.5 * scale, cy + 2.5 * scale, rad, 1, 1);
  gfx_set(0.42, 0.43, 0.46, 1);
  gfx_circle(cx, cy, rad, 1, 1);
  gfx_set(0.62, 0.63, 0.66, 1);
  gfx_circle(cx, cy, rad - 2 * scale, 1, 1);
  gfx_set(0.72, 0.73, 0.76, 1);
  gfx_circle(cx - 0.12 * rad, cy - 0.12 * rad, rad * 0.78, 1, 1);
  gfx_set(0.80, 0.81, 0.83, 0.55);
  gfx_circle(cx - 0.25 * rad, cy - 0.28 * rad, rad * 0.45, 1, 1);
  gfx_set(0.13, 0.13, 0.15, 1);
  v = -1.2;
  loop(5,
    gfx_line(cx + sin(a) * rad * 0.22 + cos(a) * v * scale * 0.6, cy - cos(a) * rad * 0.22 + sin(a) * v * scale * 0.6,
             cx + sin(a) * rad * 0.92 + cos(a) * v * scale * 0.6, cy - cos(a) * rad * 0.92 + sin(a) * v * scale * 0.6, 1);
    v += 0.6;
  );
  font(14, 'b');
  gfx_set(1, 1, 1, 1);
  gfx_measurestr(s_name(s), tw, th);
  gfx_x = cx - tw * 0.5; gfx_y = cy - rad - 9 * scale - th - 2 * scale;
  gfx_drawstr(s_name(s));
  font(12, 0);
  gfx_set(0.92, 0.92, 0.94, 1);
  gfx_measurestr(s_text(s), tw, th);
  gfx_x = cx - tw * 0.5; gfx_y = cy + rad + 9 * scale;
  gfx_drawstr(#vt);
);

function draw_hslider(s, x, y, w) local(p, tx, ty, hov, bip, c, tw, th) (
  font(14, 'b');
  gfx_set(1, 1, 1, 1);
  gfx_x = x; gfx_y = y;
  gfx_drawstr(s_name(s));
  ty = y + 26 * scale;
  hov = hit_rect(mouse_x, mouse_y, x - 4 * scale, ty - 10 * scale, w + 8 * scale, 20 * scale);
  hov ? hov_s = s;
  (mouse_just_down && hov) ? (
    (click_target == s && time_precise() - click_time < 0.3) ? (
      set_slider(s, s_def(s)); drag_target = 0;
    ) : (
      drag_target = s; drag_kind = 1; drag_x0 = mouse_x; drag_w = w; drag_p0 = to_pos(s, slider(s)); drag_fine = mouse_cap & 4;
    );
    click_target = s; click_time = time_precise(); mouse_just_down = 0;
  );
  (hov && wheel != 0 && drag_target == 0) ? (
    set_pos(s, to_pos(s, slider(s)) + wheel / 120 * ((mouse_cap & 4) ? 0.002 : 0.02));
    automate(s, 1); wheel = 0;
  );
  p = to_pos(s, slider(s));
  tx = x + w * p;
  bip = s == 28;
  gfx_set(0.349, 0.361, 0.42, 1);
  gfx_rect(x, ty - 2 * scale, w, 4 * scale, 1);
  gfx_set(0.612, 0.737, 0.741, 1);
  bip ? ( c = x + w * 0.5; gfx_rect(min(c, tx), ty - 2 * scale, abs(tx - c), 4 * scale, 1); )
      : gfx_rect(x, ty - 2 * scale, tx - x, 4 * scale, 1);
  gfx_set(0.10, 0.10, 0.12, 0.6);
  gfx_circle(tx + scale, ty + 1.5 * scale, 7 * scale, 1, 1);
  gfx_set(0.55, 0.56, 0.60, 1);
  gfx_circle(tx, ty, 7 * scale, 1, 1);
  gfx_set(0.75, 0.76, 0.79, 1);
  gfx_circle(tx - scale, ty - scale, 4.5 * scale, 1, 1);
  font(12, 0);
  gfx_set(0.92, 0.92, 0.94, 1);
  gfx_x = x; gfx_y = ty + 10 * scale;
  gfx_drawstr(s_text(s));
);

function draw_power(s, cx, cy) local(on, hov, r) (
  r = 9 * scale;
  hov = hit_circle(mouse_x, mouse_y, cx, cy, r + 5 * scale);
  hov ? hov_s = s;
  (mouse_just_down && hov) ? ( set_slider(s, slider(s) >= 0.5 ? 0 : 1); mouse_just_down = 0; );
  on = slider(s) >= 0.5;
  on ? gfx_set(0.918, 0.663, 0.173, 1) : gfx_set(0.349, 0.361, 0.42, 1);
  arc_band(cx, cy, r - scale, r + scale, 0.6, 2 * $pi - 0.6);
  gfx_rect(cx - scale, cy - r - 2 * scale, 2 * scale, r, 1);
);

function draw_toggle(s, x, y, w, h, label) local(on, hov, tw, th) (
  hov = hit_rect(mouse_x, mouse_y, x, y, w, h);
  hov ? hov_s = s;
  (mouse_just_down && hov) ? ( set_slider(s, slider(s) >= 0.5 ? 0 : 1); mouse_just_down = 0; );
  on = slider(s) >= 0.5;
  on ? gfx_set(0.706, 0.09, 0.09, 1) : gfx_set(0.2, 0.204, 0.239, 1);
  gfx_roundrect(x, y, w, h, 5 * scale, 1);
  gfx_rect(x + scale, y + scale, w - 2 * scale, h - 2 * scale, 1);
  gfx_set(0.349, 0.361, 0.42, 1);
  gfx_roundrect(x, y, w, h, 5 * scale, 1);
  font(14, 'b');
  gfx_set(1, 1, 1, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + (w - tw) * 0.5; gfx_y = y + (h - th) * 0.5;
  gfx_drawstr(label);
);

function draw_button(id, x, y, w, h, label, fs) local(hov, tw, th) (
  hov = hit_rect(mouse_x, mouse_y, x, y, w, h);
  hov ? hov_s = id;
  gfx_set(0.349, 0.361, 0.42, 1);
  gfx_roundrect(x, y, w, h, 5 * scale, 1);
  hov ? ( gfx_set(1, 1, 1, 0.06); gfx_rect(x + scale, y + scale, w - 2 * scale, h - 2 * scale, 1); );
  font(fs, 'b');
  gfx_set(1, 1, 1, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + (w - tw) * 0.5; gfx_y = y + (h - th) * 0.5;
  gfx_drawstr(label);
  ret = mouse_just_down && hov;
  ret ? mouse_just_down = 0;
  ret;
);

function draw_panel(x, y, w, h, tab, n, t0, t1, t2) local(i, tx, tw, th, nm, cw) (
  gfx_set(0.192, 0.196, 0.227, 1);
  gfx_rect(px(x) + 4 * scale, py(y), (w - 8) * scale, h * scale, 1);
  gfx_rect(px(x), py(y) + 4 * scale, w * scale, (h - 8) * scale, 1);
  gfx_circle(px(x) + 4 * scale, py(y) + 4 * scale, 4 * scale, 1, 1);
  gfx_circle(px(x + w) - 4 * scale - 1, py(y) + 4 * scale, 4 * scale, 1, 1);
  gfx_circle(px(x) + 4 * scale, py(y + h) - 4 * scale - 1, 4 * scale, 1, 1);
  gfx_circle(px(x + w) - 4 * scale - 1, py(y + h) - 4 * scale - 1, 4 * scale, 1, 1);
  gfx_set(0.13, 0.13, 0.15, 1);
  gfx_rect(px(x), py(y + 40), w * scale, max(1, scale), 1);
  cw = w / n;
  i = 0;
  loop(n,
    nm = i == 0 ? t0 : i == 1 ? t1 : t2;
    font(14, 'b');
    gfx_measurestr(nm, tw, th);
    tx = px(x + cw * i) + (cw * scale - tw) * 0.5;
    (mouse_just_down && hit_rect(mouse_x, mouse_y, px(x + cw * i), py(y), cw * scale, 40 * scale)) ? ( tab = i; mouse_just_down = 0; );
    i == tab ? gfx_set(1, 1, 1, 1) : gfx_set(0.6, 0.61, 0.66, 1);
    gfx_x = tx; gfx_y = py(y) + (40 * scale - th) * 0.5;
    gfx_drawstr(nm);
    i += 1;
  );
  tab;
);

function knob3(x, w, s1, s2, s3) (
  draw_knob(s1, px(x + w * 0.5), py(214), 26 * scale);
  s2 > 0 ? draw_knob(s2, px(x + w * 0.5), py(326), 26 * scale);
  s3 > 0 ? draw_knob(s3, px(x + w * 0.5), py(438), 26 * scale);
);

function sync_menu(flutter) local(r, q, f, t) (
  gfx_x = mouse_x; gfx_y = mouse_y;
  r = flutter ? gfx_showmenu("Sync to tape speed|Sync to eighth note|Sync to quarter note|Sync to half note|Sync to whole note")
              : gfx_showmenu("Sync to tape speed|Sync to one bar|Sync to two bars|Sync to four bars|Sync to eight bars");
  r > 0 ? (
    q = 60 / (tempo > 0 ? tempo : 120);
    r == 1 ? (
      t = p_speed / (6 * $pi);
      f = flutter ? t : sqrt(t);
    ) : (
      f = flutter ? 1 / (q * (r == 2 ? 0.125 : r == 3 ? 0.25 : r == 4 ? 0.5 : 1))
                  : 1 / (q * (r == 2 ? 1 : r == 3 ? 2 : r == 4 ? 4 : 8));
    );
    flutter ? set_slider(30, max(0, min(1, 0.144765 * log(10 * f))))
            : set_slider(32, max(0, min(1, 0.664859 * log(f + 1))));
  );
);

function apply_preset(i) local(k) (
  i = max(0, min(PR_COUNT - 1, i));
  pr_row(i);
  k = 0;
  loop(48, slider(k + 1) = PRT[k]; automate(k + 1, 0); automate(k + 1, 1); k += 1;);
  set_slider(49, i);
);

function draw_meter(x, y, w, h, v) local(cx) (
  gfx_set(0.13, 0.13, 0.15, 1);
  gfx_rect(px(x), py(y), w * scale, h * scale, 1);
  cx = px(x + w * 0.5) + max(-1, min(1, v)) * (w * 0.5 - 8) * scale;
  gfx_set(0.918, 0.663, 0.173, 0.25);
  gfx_circle(cx, py(y + h * 0.5), 7 * scale, 1, 1);
  gfx_set(0.918, 0.663, 0.173, 0.9);
  gfx_circle(cx, py(y + h * 0.5), 3.5 * scale, 1, 1);
);

wheel = mouse_wheel; mouse_wheel = 0;
mouse_down = mouse_cap & 1;
mouse_just_down = mouse_down && !mouse_state;
hov_s = 0;

gfx_set(0.545, 0.196, 0.196, 1);
gfx_rect(0, 0, gfx_w, gfx_h, 1);
gfx_gradrect(0, 0, gfx_w, gfx_h, 0.545, 0.196, 0.196, 1, 0, 0, 0, 0, -0.06 / max(1, gfx_h), -0.05 / max(1, gfx_h), -0.05 / max(1, gfx_h), 0);

font(34, 'b');
gfx_set(1, 1, 1, 1);
gfx_x = px(16); gfx_y = py(14);
gfx_drawstr("Reel Talk");
font(12, 0);
gfx_set(0.918, 0.663, 0.173, 1);
gfx_x = px(18); gfx_y = py(62);
gfx_drawstr("by chmaha  ·  based on CHOW Tape Model");
gfx_x = px(18); gfx_y = py(80);
gfx_drawstr("by Jatin Chowdhury");

gfx_set(0, 0, 0, 0.2);
gfx_rect(px(300), py(8), 412 * scale, 92 * scale, 1);
sc_n = min(1000, floor(srate * 0.02));
gt = sc_w - 2 * sc_n; gk = -1; gi = 1;
loop(sc_n - 1, (gk < 0 && SCOPE[(gt + gi - 1) & 2047] < 0 && SCOPE[(gt + gi) & 2047] >= 0) ? gk = gi; gi += 1;);
gk < 0 ? gk = sc_n;
gfx_set(0.918, 0.663, 0.173, 1);
gi = 0;
loop(400,
  gv = SCOPE[(gt + gk + floor(gi * sc_n / 400)) & 2047];
  gxx = px(300 + gi * 412 / 400); gyy = py(54) - max(-1, min(1, gv)) * 40 * scale;
  gi > 0 ? gfx_line(glxx, glyy, gxx, gyy, 1);
  glxx = gxx; glyy = gyy; gi += 1;
);
font(13, 0);
gfx_set(1, 1, 1, 0.9);
gv = rms_n > 0 ? sqrt(max(0, rms_si) / (rms_n * BS)) : 0;
sprintf(#mt, "IN: %.1f dB", gv > 0.0001 ? max(-80, 20 * log10(gv)) : -80);
gfx_x = px(306); gfx_y = py(10); gfx_drawstr(#mt);
gv = rms_n > 0 ? sqrt(max(0, rms_so) / (rms_n * BS)) : 0;
sprintf(#mt, "OUT: %.1f dB", gv > 0.0001 ? max(-80, 20 * log10(gv)) : -80);
gfx_measurestr(#mt, gtw, gth);
gfx_x = px(706) - gtw; gfx_y = py(10); gfx_drawstr(#mt);
(p_mode == 4 && !stn_ok) ? (
  font(13, 'b'); gfx_set(1, 0.4, 0.35, 1);
  gfx_x = px(306); gfx_y = py(80); gfx_drawstr("Missing Dependencies/ReelTalk/stn_weights.txt (STN mode)");
);

tab0 = draw_panel(8, 112, 182, 422, tab0, 3, "Gain", "Filters", "Stereo");
tab0 == 0 ? knob3(8, 182, 1, 3, 2)
: tab0 == 1 ? (
  knob3(8, 182, 5, 6, 0);
  draw_toggle(7, px(49), py(408), 100 * scale, 30 * scale, "Makeup");
  draw_power(4, px(99), py(508));
) : (
  draw_toggle(46, px(41), py(166), 116 * scale, 30 * scale, "Mid/Side");
  draw_knob(47, px(99), py(286), 26 * scale);
  draw_toggle(48, px(41), py(384), 116 * scale, 30 * scale, "Makeup");
);

tab1 = draw_panel(198, 112, 182, 422, tab1, 3, "Tape", "Comp", "Tone");
tab1 == 0 ? ( knob3(198, 182, 19, 18, 17); draw_power(16, px(289), py(508)); )
: tab1 == 1 ? ( knob3(198, 182, 13, 14, 15); draw_power(12, px(289), py(508)); )
: ( knob3(198, 182, 9, 10, 11); draw_power(8, px(289), py(508)); );

tab2 = draw_panel(388, 112, 190, 422, tab2, 3, "Loss", "Degrade", "Chew");
tab2 == 0 ? (
  draw_hslider(27, px(402), py(158), 160 * scale);
  draw_hslider(26, px(402), py(216), 160 * scale);
  draw_hslider(25, px(402), py(274), 160 * scale);
  draw_hslider(28, px(402), py(332), 160 * scale);
  draw_hslider(24, px(402), py(390), 160 * scale);
  gi = 0;
  loop(4,
    gv = gi == 0 ? 3.75 : gi == 1 ? 7.5 : gi == 2 ? 15 : 30;
    sprintf(#bt, gi == 0 ? "3.75" : gi == 1 ? "7.5" : gi == 2 ? "15" : "30");
    draw_button(106, px(398 + gi * 43.5), py(450), 38 * scale, 24 * scale, #bt, 12) ? set_slider(24, gv);
    gi += 1;
  );
  draw_power(23, px(483), py(508));
) : tab2 == 1 ? (
  draw_hslider(38, px(402), py(158), 160 * scale);
  draw_hslider(39, px(402), py(216), 160 * scale);
  draw_hslider(40, px(402), py(274), 160 * scale);
  draw_hslider(41, px(402), py(332), 160 * scale);
  draw_toggle(37, px(433), py(408), 100 * scale, 30 * scale, "0.1x");
  draw_power(36, px(483), py(508));
) : (
  draw_hslider(43, px(402), py(158), 160 * scale);
  draw_hslider(44, px(402), py(216), 160 * scale);
  draw_hslider(45, px(402), py(274), 160 * scale);
  draw_power(42, px(483), py(508));
);

tab3 = draw_panel(586, 112, 126, 422, tab3, 2, "Flutter", "Wow", "");
tab3 == 0 ? (
  draw_button(104, px(596), py(160), 106 * scale, 34 * scale, "Flutter Sync", 14) ? sync_menu(1);
  draw_knob(31, px(649), py(264), 24 * scale);
  draw_knob(30, px(649), py(370), 24 * scale);
  draw_meter(602, 438, 94, 40, wf_mf);
) : (
  draw_button(105, px(596), py(160), 106 * scale, 34 * scale, "Wow Sync", 14) ? sync_menu(0);
  draw_knob(33, px(619), py(258), 18 * scale);
  draw_knob(32, px(679), py(258), 18 * scale);
  draw_knob(34, px(619), py(358), 18 * scale);
  draw_knob(35, px(679), py(358), 18 * scale);
  draw_meter(602, 438, 94, 40, wf_mw);
);
draw_power(29, px(649), py(508));

gfx_set(0.12, 0.12, 0.14, 1);
gfx_rect(0, py(544), gfx_w, gfx_h - py(544), 1);
font(14, 'b');
gfx_set(1, 1, 1, 1);
gfx_measurestr("Oversampling: ", gtw, gth);
gfx_x = px(18); gfx_y = py(564) - gth * 0.5; gfx_drawstr("Oversampling: ");
gfx_set(0.918, 0.663, 0.173, 1);
sprintf(#ot, "%dx%s", 2 ^ p_os, p_osmode >= 0.5 ? " (Lin)" : "");
gfx_measurestr(#ot, gtv, gth);
gfx_x = px(18) + gtw; gfx_drawstr(#ot);
hit_rect(mouse_x, mouse_y, px(18), py(548), gtw + gtv, 32 * scale) ? (
  hov_s = 101;
  mouse_just_down ? (
    gfx_x = mouse_x; gfx_y = mouse_y;
    sprintf(#om, "%s1x|%s2x|%s4x|%s8x|%s16x||%sMin Phase|%sLinear Phase",
      p_os == 0 ? "!" : "", p_os == 1 ? "!" : "", p_os == 2 ? "!" : "", p_os == 3 ? "!" : "", p_os == 4 ? "!" : "",
      p_osmode < 0.5 ? "!" : "", p_osmode >= 0.5 ? "!" : "");
    gr = gfx_showmenu(#om);
    gr >= 1 && gr <= 5 ? set_slider(21, gr - 1);
    gr >= 6 ? set_slider(22, gr - 6);
    mouse_just_down = 0;
  );
);
gfx_set(1, 1, 1, 1);
gfx_measurestr("Tape Mode: ", gtw, gth);
gfx_x = px(206); gfx_y = py(564) - gth * 0.5; gfx_drawstr("Tape Mode: ");
gfx_set(0.918, 0.663, 0.173, 1);
strcpy(#mo, p_mode == 0 ? "RK2" : p_mode == 1 ? "RK4" : p_mode == 2 ? "NR4" : p_mode == 3 ? "NR8" : p_mode == 4 ? "STN" : "V1");
gfx_measurestr(#mo, gtv, gth);
gfx_x = px(206) + gtw; gfx_drawstr(#mo);
hit_rect(mouse_x, mouse_y, px(206), py(548), gtw + gtv, 32 * scale) ? (
  hov_s = 102;
  mouse_just_down ? (
    gfx_x = mouse_x; gfx_y = mouse_y;
    sprintf(#mm, "%sRK2|%sRK4|%sNR4|%sNR8|%sSTN|%sV1", p_mode == 0 ? "!" : "", p_mode == 1 ? "!" : "", p_mode == 2 ? "!" : "",
      p_mode == 3 ? "!" : "", p_mode == 4 ? "!" : "", p_mode == 5 ? "!" : "");
    gr = gfx_showmenu(#mm);
    gr > 0 ? set_slider(20, gr - 1);
    mouse_just_down = 0;
  );
);

pbx = 420; pbw = 284;
gfx_set(0.349, 0.361, 0.42, 1);
gfx_roundrect(px(pbx + 22), py(550), (pbw - 44) * scale, 28 * scale, 5 * scale, 1);
gfx_set(0.42, 0.43, 0.48, 1);
gfx_rect(px(pbx + 23), py(551), (pbw - 46) * scale, 26 * scale, 1);
font(13, 'b');
gfx_set(1, 1, 1, 1);
strcpy(#pn, pr_name(floor(p_preset + 0.5)));
gfx_measurestr(#pn, gtw, gth);
gfx_x = px(pbx + pbw * 0.5) - gtw * 0.5; gfx_y = py(564) - gth * 0.5;
gfx_drawstr(#pn);
gfx_set(1, 1, 1, 1);
gfx_triangle(px(pbx + 6), py(564), px(pbx + 15), py(558), px(pbx + 15), py(570));
gfx_triangle(px(pbx + pbw - 6), py(564), px(pbx + pbw - 15), py(558), px(pbx + pbw - 15), py(570));
hit_rect(mouse_x, mouse_y, px(pbx), py(548), pbw * scale, 32 * scale) ? (
  hov_s = 103;
  mouse_just_down ? (
    mouse_x < px(pbx + 22) ? apply_preset(p_preset - 1 < 0 ? PR_COUNT - 1 : p_preset - 1)
    : mouse_x > px(pbx + pbw - 22) ? apply_preset(p_preset + 1 >= PR_COUNT ? 0 : p_preset + 1)
    : (
      gfx_x = mouse_x; gfx_y = mouse_y;
      gr = gfx_showmenu(pr_menu());
      gr > 0 ? apply_preset(gr - 1);
    );
    mouse_just_down = 0;
  );
);

gfx_set(0.06, 0.06, 0.07, 1);
gfx_rect(0, py(582), gfx_w, max(1, scale), 1);
hs = drag_target > 0 ? drag_target : hov_s;
font(12, 0);
gfx_set(0.62, 0.63, 0.66, 1);
strcpy(#hint, hs > 0 ? hint_text(hs) : "Drag or scroll to adjust  ·  Ctrl for fine control  ·  double-click to reset  ·  click a tab to switch pages");
hs == 103 ? sprintf(#hint, "Preset: %s  (%s)  ·  click for the list, arrows to step", pr_name(floor(p_preset + 0.5)), pr_vendor(floor(p_preset + 0.5)));
gfx_measurestr(#hint, gtw, gth);
gtw > (DW - 24) * scale ? ( gfx_setfont(1, "Arial", 14 * scale * (DW - 24) * scale / gtw); gfx_measurestr(#hint, gtw, gth); );
gfx_x = px(DW * 0.5) - gtw * 0.5; gfx_y = py(597) - gth * 0.5;
gfx_drawstr(#hint);

drag_target > 0 ? (
  mouse_down ? (
    mouse_cap |= 65536;
    fine_now = mouse_cap & 4;
    drag_kind == 0 ? (
      fine_now != drag_fine ? ( drag_y0 = mouse_y; drag_p0 = to_pos(drag_target, slider(drag_target)); drag_fine = fine_now; );
      set_pos(drag_target, drag_p0 + (drag_y0 - mouse_y) / (200 * scale) * (fine_now ? 0.1 : 1));
    ) : (
      fine_now != drag_fine ? ( drag_x0 = mouse_x; drag_p0 = to_pos(drag_target, slider(drag_target)); drag_fine = fine_now; );
      set_pos(drag_target, drag_p0 + (mouse_x - drag_x0) / drag_w * (fine_now ? 0.1 : 1));
    );
  ) : ( automate(drag_target, 1); drag_target = 0; );
);

mouse_state = mouse_down;
