// ---------------------------------------------------------------------- hysteresis

function hp_cook(drv, wid, sat, v1) local(sf, wf) (
  sf = f32(sat); wf = f32(wid);
  hs_sat = min(max(floor(f32(20 * sf)), 0), 20);
  hs_wid = min(max(floor(f32(10 * wf)), 0), 10);
  hp_ms = 0.5 + 1.5 * (1 - sat);
  hp_a = hp_ms / (0.01 + 6 * drv);
  hp_c = sqrt(1 - wid) - 0.01;
  hp_k = 0.47875;
  hp_lim = 20;
  v1 ? (
    hp_k = 27000;
    hp_c = 0.17;
    hp_ms *= 50000;
    hp_a = hp_ms / (0.01 + 40 * drv);
    hp_lim = 100000;
  );
  hp_nc = 1 - hp_c;
  hp_ia = 1 / hp_a;
  hp_nck = hp_nc * hp_k;
  hp_msoa = hp_ms / hp_a;
  hp_msoa_ta = ALPHA * hp_msoa;
  hp_msoa_tc = hp_c * hp_msoa;
  hp_msoa_tc_ta = ALPHA * hp_msoa_tc;
  hp_msoasq_tc_ta = hp_msoa_tc_ta / hp_a;
  hp_msoasq_tc_tasq = ALPHA * hp_msoasq_tc_ta;
);

function hf(mm, hh, hd) local(q, aq, q2, u, ct, oq, l, lp, md, kap, f1d) (
  q = (hh + mm * ALPHA) * hp_ia;
  aq = abs(q);
  aq < 0.001 ? (
    l = q * (1 / 3); lp = 1 / 3;
  ) : aq < 0.25 ? (
    q2 = q * q;
    l = q * (0.3333333333333333 + q2 * (-0.022222222222222223 + q2 * (0.0021164021164021165 + q2 * (-0.00021164021164021165 + q2 * (0.000021377799155576935 + q2 * (-0.0000021644042808063972 + q2 * (0.00000021925947851873778 + q2 * (-0.000000022214608789979678 + q2 * (0.0000000022507846516808994)))))))));
    lp = 0.3333333333333333 + q2 * (-0.06666666666666667 + q2 * (0.010582010582010581 + q2 * (-0.0014814814814814814 + q2 * (0.0001924001924001924 + q2 * (-0.00002380844708887037 + q2 * (0.0000028503732207435913 + q2 * (-0.0000003332191318496952 + q2 * (0.000000038263339078575285))))))));
  ) : (
    u = exp(-2 * aq);
    ct = (1 + u) / (1 - u);
    q < 0 ? ct = -ct;
    oq = 1 / q;
    l = ct - oq;
    lp = oq * oq - ct * ct + 1;
  );
  md = l * hp_ms - mm;
  hd >= 0 ? ( kap = md > 0; f1d = hp_nck - ALPHA * md; ) : ( kap = md < 0; f1d = -hp_nck - ALPHA * md; );
  hd * ((kap ? hp_nc * md / f1d : 0) + lp * hp_msoa_tc) / (1 - lp * hp_msoa_tc_ta);
);

function hfn(mm, hh, hd) local(q, aq, q2, u, ct, oq, l, md, kap) (
  q = (hh + mm * ALPHA) * hp_ia;
  aq = abs(q);
  aq < 0.001 ? (
    l = q * (1 / 3); hn_lp = 1 / 3; hn_lpp = (-2 / 15) * q;
  ) : aq < 0.25 ? (
    q2 = q * q;
    l = q * (0.3333333333333333 + q2 * (-0.022222222222222223 + q2 * (0.0021164021164021165 + q2 * (-0.00021164021164021165 + q2 * (0.000021377799155576935 + q2 * (-0.0000021644042808063972 + q2 * (0.00000021925947851873778 + q2 * (-0.000000022214608789979678 + q2 * (0.0000000022507846516808994)))))))));
    hn_lp = 0.3333333333333333 + q2 * (-0.06666666666666667 + q2 * (0.010582010582010581 + q2 * (-0.0014814814814814814 + q2 * (0.0001924001924001924 + q2 * (-0.00002380844708887037 + q2 * (0.0000028503732207435913 + q2 * (-0.0000003332191318496952 + q2 * (0.000000038263339078575285))))))));
    hn_lpp = q * (-0.13333333333333333 + q2 * (0.042328042328042326 + q2 * (-0.008888888888888889 + q2 * (0.0015392015392015391 + q2 * (-0.0002380844708887037 + q2 * (0.000034204478648923095 + q2 * (-0.000004665067845895733 + q2 * (0.0000006122134252572046 + q2 * (-0.00000007799361711970527)))))))));
  ) : (
    u = exp(-2 * aq);
    ct = (1 + u) / (1 - u);
    q < 0 ? ct = -ct;
    oq = 1 / q;
    l = ct - oq;
    hn_lp = oq * oq - ct * ct + 1;
    hn_lpp = 2 * ct * (ct * ct - 1) - 2 * oq * oq * oq;
  );
  md = l * hp_ms - mm;
  hd >= 0 ? ( kap = md > 0; hn_f1d = hp_nck - ALPHA * md; ) : ( kap = md < 0; hn_f1d = -hp_nck - ALPHA * md; );
  hn_kap = kap ? hp_nc : 0;
  hn_md = md;
  hn_f3 = 1 - hn_lp * hp_msoa_tc_ta;
  hd * ((kap ? hp_nc * md / hn_f1d : 0) + hn_lp * hp_msoa_tc) / hn_f3;
);

function hfp(hd, dmdt) local(md2, of1d, f1p) (
  md2 = hn_lp * hp_msoa_ta - 1;
  of1d = 1 / hn_f1d;
  f1p = md2 * of1d;
  f1p += hn_md * ALPHA * md2 * (of1d * of1d);
  f1p *= hn_kap;
  (hd * (f1p + hn_lpp * hp_msoasq_tc_ta) - dmdt * (hn_lpp * (-hp_msoasq_tc_tasq))) / hn_f3;
);

function stn_fwd(i0, i1, i2, i3, i4) local(w, a0, a1, a2, a3, b0, b1, b2, b3) (
  w = STNW + (hs_wid * 21 + hs_sat) * 49;
  a0 = tanh_acc(0 + w[0] * i0 + w[1] * i1 + w[2] * i2 + w[3] * i3 + w[4] * i4 + w[20]);
  a1 = tanh_acc(0 + w[5] * i0 + w[6] * i1 + w[7] * i2 + w[8] * i3 + w[9] * i4 + w[21]);
  a2 = tanh_acc(0 + w[10] * i0 + w[11] * i1 + w[12] * i2 + w[13] * i3 + w[14] * i4 + w[22]);
  a3 = tanh_acc(0 + w[15] * i0 + w[16] * i1 + w[17] * i2 + w[18] * i3 + w[19] * i4 + w[23]);
  b0 = tanh_acc(0 + w[24] * a0 + w[25] * a1 + w[26] * a2 + w[27] * a3 + w[40]);
  b1 = tanh_acc(0 + w[28] * a0 + w[29] * a1 + w[30] * a2 + w[31] * a3 + w[41]);
  b2 = tanh_acc(0 + w[32] * a0 + w[33] * a1 + w[34] * a2 + w[35] * a3 + w[42]);
  b3 = tanh_acc(0 + w[36] * a0 + w[37] * a1 + w[38] * a2 + w[39] * a3 + w[43]);
  0 + w[44] * b0 + w[45] * b1 + w[46] * b2 + w[47] * b3 + w[48];
);

function hproc(hh, solver) instance(mn1, hn1, hdn1) local(hd, m, k1, k2, k3, k4, h12, hd12, ldm, dmdt, dmp, dnr, sc) (
  hd = ((1 + 0.75) / hy_t) * (hh - hn1) - 0.75 * hdn1;
  solver === 0 ? (
    k1 = hf(mn1, hn1, hdn1) * hy_t;
    k2 = hf(mn1 + (k1 * 0.5), (hh + hn1) * 0.5, (hd + hdn1) * 0.5) * hy_t;
    m = mn1 + k2;
  ) : solver === 1 ? (
    h12 = (hh + hn1) * 0.5;
    hd12 = (hd + hdn1) * 0.5;
    k1 = hf(mn1, hn1, hdn1) * hy_t;
    k2 = hf(mn1 + (k1 * 0.5), h12, hd12) * hy_t;
    k3 = hf(mn1 + (k2 * 0.5), h12, hd12) * hy_t;
    k4 = hf(mn1 + k3, hh, hd) * hy_t;
    m = mn1 + k1 * (1 / 6) + k2 * (1 / 3) + k3 * (1 / 3) + k4 * (1 / 6);
  ) : solver === 4 ? (
    sc = 0.7071 / hp_a;
    m = stn_fwd(hh * sc, hd * (1 / 60000) * sc, hn1 * sc, hdn1 * (1 / 60000) * sc, mn1) * hs_corr + mn1;
  ) : (
    m = mn1;
    ldm = hf(mn1, hn1, hdn1);
    loop(solver === 2 ? 4 : 8,
      dmdt = hfn(m, hh, hd);
      dmp = hfp(hd, dmdt);
      dnr = (m - mn1 - hy_ta * (dmdt + ldm)) / (1 - hy_ta * dmp);
      m -= dnr;
    );
  );
  !(m <= hp_lim) ? ( m = 0; hd = 0; );
  mn1 = m; hn1 = hh; hdn1 = hd;
  m;
);
function hreset() instance(mn1, hn1, hdn1) ( mn1 = hn1 = hdn1 = 0; );

function stn_load() local(h, n) (
  h = file_open("ReelTalk/stn_weights.txt");
  h < 0 ? h = file_open("Dependencies/ReelTalk/stn_weights.txt");
  stn_ok = 0;
  h >= 0 ? (
    n = file_mem(h, STNR, 11400);
    file_close(h);
    (n == 11320 && STNR[0] == 11319) ? (
      memcpy(STNW, STNR + 1, 11319);
      stn_ok = STNW[0] < -0.38389 && STNW[0] > -0.38390 && STNW[11318] > 0.000243 && STNW[11318] < 0.000244;
    );
  );
  !stn_ok ? memset(STNW, 0, 11319);
);

// ---------------------------------------------------------------------- delay lines

function dl3_read(buf, msk, w, dly) local(di, fr, d1, d2, d3, v1, v2, v3, v4) (
  di = floor(dly); fr = dly - di;
  di >= 1 ? ( fr += 1; di -= 1; );
  v1 = buf[(w - di) & msk]; v2 = buf[(w - di - 1) & msk]; v3 = buf[(w - di - 2) & msk]; v4 = buf[(w - di - 3) & msk];
  d1 = fr - 1; d2 = fr - 2; d3 = fr - 3;
  v1 * (-d1 * d2 * d3 / 6) + fr * (v2 * (d2 * d3 * 0.5) + v3 * (-d1 * d3 * 0.5) + v4 * (d1 * d2 / 6));
);
function dl5_read(buf, msk, w, dly) local(di, fr, d1, d2, d3, d4, d5, v1, v2, v3, v4, v5, v6) (
  di = floor(dly); fr = dly - di;
  di >= 2 ? ( fr += 2; di -= 2; );
  v1 = buf[(w - di) & msk]; v2 = buf[(w - di - 1) & msk]; v3 = buf[(w - di - 2) & msk];
  v4 = buf[(w - di - 3) & msk]; v5 = buf[(w - di - 4) & msk]; v6 = buf[(w - di - 5) & msk];
  d1 = fr - 1; d2 = fr - 2; d3 = fr - 3; d4 = fr - 4; d5 = fr - 5;
  v1 * (-d1 * d2 * d3 * d4 * d5 / 120) + fr * (v2 * (d2 * d3 * d4 * d5 / 24) + v3 * (-d1 * d3 * d4 * d5 / 12)
    + v4 * (d1 * d2 * d4 * d5 / 12) + v5 * (-d1 * d2 * d3 * d5 / 24) + v6 * (d1 * d2 * d3 * d4 / 120));
);

// ---------------------------------------------------------------------- loss filter

function loss_calc(which) local(k, n, fq, wn, tk, kg, idx, s, hc, bf, gn, pka, om, alp, c2, a0i) (
  lf_bw = srate / lf_ord;
  k = 0;
  loop(floor(lf_ord / 2),
    fq = k * lf_bw;
    wn = TWOPI * max(fq, 20) / (p_speed * 0.0254);
    tk = wn * (p_thick * 0.000001);
    kg = wn * (p_gap * 0.000001) / 2;
    LFH[k] = exp(-wn * (p_spacing * 0.000001));
    LFH[k] *= (1 - exp(-tk)) / tk;
    LFH[k] *= sin(kg) / kg;
    LFH[lf_ord - k - 1] = LFH[k];
    k += 1;
  );
  n = 0;
  loop(floor(lf_ord / 2),
    idx = floor(lf_ord / 2) + n;
    k = 0; s = LFC[idx];
    loop(lf_ord, s += LFH[k] * cos(TWOPI * k * n / lf_ord); k += 1;);
    LFC[idx] = s / lf_ord;
    LFC[floor(lf_ord / 2) - n] = LFC[idx];
    n += 1;
  );
  hc = LFZ + which * 1664 + 1280;
  memcpy(hc, LFC, lf_ord);
  hc[lf_ord] = 0;
  bf = p_speed * 0.0254 / ((p_gap * 0.000001) * 500);
  gn = max(1.5 * (1000 - abs(bf - 100)) / 1000, 1);
  pka = max(0, sqrt(gn));
  om = (2 * $pi * max(bf, 2)) / srate;
  alp = sin(om) / (2 * 2);
  c2 = -2 * cos(om);
  a0i = 1 / (1 + alp / pka);
  which ? (
    lb1_b0 = (1 + alp * pka) * a0i; lb1_b1 = c2 * a0i; lb1_b2 = (1 - alp * pka) * a0i; lb1_a1 = c2 * a0i; lb1_a2 = (1 - alp / pka) * a0i;
  ) : (
    lb0_b0 = (1 + alp * pka) * a0i; lb0_b1 = c2 * a0i; lb0_b2 = (1 - alp * pka) * a0i; lb0_a1 = c2 * a0i; lb0_a2 = (1 - alp / pka) * a0i;
  );
);

function fir_push(z, ch, x) local(p) (
  p = z[1600 + ch];
  z[ch * 640 + p] = x;
  z[ch * 640 + p + lf_ord] = x;
  z[1600 + ch] = p === 0 ? lf_ord - 1 : p - 1;
);
function fir_run2(z, xl, xr) local(p, zl, zr, hc, c, yl, yr, a, b, h) (
  p = z[1600];
  zl = z + p; zr = z + 640 + p;
  zl[0] = xl; zl[lf_ord] = xl;
  zr[0] = xr; zr[lf_ord] = xr;
  hc = z + 1280;
  c = floor(lf_ord / 2);
  yl = hc[c] * zl[c]; yr = hc[c] * zr[c];
  a = c + 1; b = c - 1;
  loop(c - 1, h = hc[a]; yl += h * (zl[a] + zl[b]); yr += h * (zr[a] + zr[b]); a += 1; b -= 1;);
  z[1600] = z[1601] = p === 0 ? lf_ord - 1 : p - 1;
  FIRY = yr;
  yl;
);

function chf_coefs(fc) local(wc, c, a0) (
  wc = TWOPI * fc / srate;
  c = 1 / ftan(wc / 2);
  a0 = c + 1;
  chf_b0 = 1 / a0; chf_a1 = (1 - c) / a0;
);
function dgf_coefs(fc, ch) local(wc, c, a0) (
  wc = TWOPI * fc / srate;
  c = 1 / ftan(wc / 2);
  a0 = c + 1;
  ch ? ( dgfr_b0 = 1 / a0; dgfr_a1 = (1 - c) / a0; ) : ( dgfl_b0 = 1 / a0; dgfl_a1 = (1 - c) / a0; );
);

function chew_dry_time() local(ts, vs) (
  ts = p_chew_freq ^ 0.1;
  vs = (chr.jr_float() * 2) ^ p_chew_var;
  chr.jr_range(floor((1 - ts) * srate * vs), floor((2 - 1.99 * ts) * srate * vs));
);
function chew_wet_time() local(ts, st, en, vs) (
  ts = p_chew_freq ^ 0.1;
  st = 0.2 + 0.8 * p_chew_depth;
  en = st - (0.001 + 0.01 * p_chew_depth);
  vs = (chr.jr_float() * 2) ^ p_chew_var;
  chr.jr_range(floor((1 - ts) * srate * vs), floor(((1 - ts) + st - en * ts) * srate * vs));
);

function degrade_cook(prep) local(dv, fhz, gdb, es, rl, g) (
  dv = p_deg_p1 ? p_deg_depth * 0.1 : p_deg_depth;
  fhz = 200 * (20000 / 200) ^ (1 - p_deg_amt);
  gdb = -24 * dv;
  !prep ? (
    dgn_set = 0.5 * dv * p_deg_amt;
    dgfl.sm_set(min(fhz + (p_deg_var * (fhz / 0.6) * (dgr.jr_float() - 0.5)), 0.49 * srate));
    dgfr.sm_set(min(fhz + (p_deg_var * (fhz / 0.6) * (dgr.jr_float() - 0.5)), 0.49 * srate));
  );
  es = 1 - p_deg_env ^ 0.8;
  rl = f32(20 * (5000 / 20) ^ es);
  dg_ta = f32(1 - f32(exp(f32(dg_exp / 10))));
  dg_tr = rl < 0.001 ? 0 : f32(1 - f32(exp(f32(dg_exp / rl))));
  g = db2g(min(gdb + (p_deg_var * 36 * (dgr.jr_float() - 0.5)), 3));
  g !== dg_gcur ? ( dg_gold = dg_gcur; dg_gcur = g; );
);

// ---------------------------------------------------------------------- reset / prepare

function engine_prepare() local(i, n) (
  memset(OSST, 0, 22 * 1024);
  os_clear_all();
  bpos = 0;
  pr_first = !pr_done;
  pr_done = 1;

  ig_cur = 1; ig_old = ig_cur;
  og_cur = 1; og_old = og_cur;

  ifb.prev = p_if_on; ifm.prev = p_if_on;
  ifl.lr_set(2000); ifr.lr_set(2000);
  ifhl.lr_set(2000); ifhr.lr_set(2000);
  ifl.s0 = ifl.s1 = ifl.s2 = ifl.s3 = 0; ifr.s0 = ifr.s1 = ifr.s2 = ifr.s3 = 0;
  ifhl.s0 = ifhl.s1 = ifhl.s2 = ifhl.s3 = 0; ifhr.s0 = ifhr.s1 = ifhr.s2 = ifhr.s3 = 0;
  memset(MKDL, 0, 4096); memset(MKDR, 0, 4096); mk_w = 0;

  msf.sv_init(0, floor(0.04 * srate));
  ms_cur = p_ms === 1; ms_prev = ms_cur;
  pr_first ? ( msi0.sv_init(0, floor(0.05 * srate)); msi1.sv_init(0, floor(0.05 * srate)); mso0.sv_init(0, floor(0.05 * srate)); mso1.sv_init(0, floor(0.05 * srate)); )
           : ( msi0.sv_reset(floor(0.05 * srate)); msi1.sv_reset(floor(0.05 * srate)); mso0.sv_reset(floor(0.05 * srate)); mso1.sv_reset(floor(0.05 * srate)); );

  tin_l.sm_init(1, floor(0.05 * srate)); tin_h.sm_init(1, floor(0.05 * srate)); tin_f.sm_init(500, floor(0.05 * srate));
  tout_l.sm_init(1, floor(0.05 * srate)); tout_h.sm_init(1, floor(0.05 * srate)); tout_f.sm_init(500, floor(0.05 * srate));
  tin.shelf_coefs(1, 1, 500); tout.shelf_coefs(1, 1, 500);
  tin_zl = tin_zr = tout_zl = tout_zr = 0;

  cpb.prev = p_comp_on;
  pr_first ? ( cpd0.sv_init(0, floor(srate * 0.05)); ) : cpd0.sv_reset(floor(srate * 0.05));
  cp_yl = cp_yr = 0; cp_incl = cp_incr = 1;
  cp_ta = cp_tr = 1;
  memset(CTHL, 0, 8); memset(CTHR, 0, 8); cth_w = 0; cth_vl = cth_vr = 0;
  cp_lat = 3.137320896310392;
  cp_frac = 1 - (cp_lat - floor(cp_lat));
  cp_frac === 1 ? cp_frac = 0 : cp_frac < 0.618 ? cp_frac += 1;
  cth_di = floor(cp_frac); cth_fr = cp_frac - cth_di;
  (cth_fr < 0.618 && cth_di >= 1) ? ( cth_fr += 1; cth_di -= 1; );
  cth_al = (1 - cth_fr) / (1 + cth_fr);

  hyb.prev = p_hyst_on;
  hy_wasv1 = hy_usev1 = p_mode === 5;
  hy_cfg = p_os + 5 * p_osmode; hy_fac = p_os;
  pr_first ? ( hyd.sv_init(0, 500); hyw.sv_init(0, 500); hys.sv_init(0, 500); hym.sm_init(1, 500); )
           : ( hyd.sv_reset(500); hyw.sv_reset(500); hys.sv_reset(500); hym.sm_reset(500); );
  hy_fs = srate * 2 ^ hy_fac;
  hy_t = 1 / hy_fs; hy_ta = hy_t / 1.9; hs_corr = 96000 / hy_fs;
  hp_cook(hyd.cur, hyw.cur, hys.cur, hy_wasv1);
  hyl.hreset(); hyr.hreset();
  hy_bal = hy_bar = 0;
  hy_bfreq = srate * 2 ^ hy_fac / 2;
  hydl.dcb_init(35); hydr.dcb_init(35);

  chb.prev = p_chew_on;
  ch_mix = 0; ch_pow = 0;
  pr_first ? ( chm0.sv_init(0, floor(srate * 0.01)); chp0.sv_init(0, floor(srate * 0.005)); )
           : ( chm0.sv_reset(floor(srate * 0.01)); chp0.sv_reset(floor(srate * 0.005)); );
  chfl.sm_init(pr_first ? 20000 : chfl.tgt, floor(srate * 0.02)); chf_z = 0; chf_zr = 0; ch_dro = 0;
  chf_coefs(chfl.cur);
  ch_crink = 0;
  ch_until = chew_dry_time();
  ch_cnt = 0;

  dgb.prev = p_deg_on;
  dg_cnt = 0;
  dg_exp = f32(-1000 / f32(srate));
  dg_gcur = 1; dg_gold = 0;
  degrade_cook(1);
  dgn_cur = dgn_prev = dgn_set = 0;
  dgfl.sm_init(20000, 20); dgfr.sm_init(20000, 20);
  dgfl_z = dgfr_z = 0;
  dgf_coefs(dgfl.cur, 0); dgf_coefs(dgfr.cur, 1);
  dg_y = 0; dg_inc = 1;
  dg_gold = dg_gcur;

  wfb.prev = p_wf_on;
  wfdl.sm_init(0.001, floor(srate * 0.05)); wfdf.sm_init(0.001, floor(srate * 0.05));
  wf_ph = 0;
  wf_amp = 1000 * 1000 / srate;
  oh_sqd = 1 / sqrt(srate); oh_t = 1 / srate;
  oh_y = 1;
  oh_g0 = tan($pi * 10 / srate); oh_k = 1 / (1 / sqrt(2));
  oh_gk = oh_g0 + oh_k; oh_a1 = 1 / (1 + oh_g0 * oh_gk); oh_a2 = oh_g0 * oh_a1; oh_a3 = oh_g0 * oh_a2; oh_ak = oh_gk * oh_a1;
  oh_s1 = oh_s2 = 0;
  fl_p1 = fl_p2 = fl_p3 = 0;
  fl_a1 = -230 * 1000 / srate; fl_a2 = -80 * 1000 / srate; fl_a3 = -99 * 1000 / srate; fl_dc = 350 * 1000 / srate;
  fl_o2 = 13 * $pi / 4; fl_o3 = -$pi / 10;
  memset(WFDL, 0, 32768); memset(WFDR, 0, 32768); wf_w = 0;
  wfcl.dcb_init(15); wfcr.dcb_init(15);

  lsb.prev = p_loss_on;
  lf_ord = floor(64 * (srate / 44100));
  lf_pad = 2 * ceil(lf_ord / 2);
  lf_fadelen = max(1024, BS);
  memset(LFZ, 0, 2 * 1664); memset(LFH, 0, 320); memset(LFC, 0, 320);
  lf_act = 0; lf_fade = 0;
  loss_calc(0);
  memcpy(LFZ + 1664 + 1280, LFZ + 1280, lf_ord + 1);
  lb0_zl1 = lb0_zl2 = lb0_zr1 = lb0_zr2 = 0; lb1_zl1 = lb1_zl2 = lb1_zr1 = lb1_zr2 = 0;
  lf_pspeed = p_speed; lf_pspacing = p_spacing; lf_pthick = p_thick; lf_pgap = p_gap;
  pr_first ? ( azl.sv_init(0, floor(srate * 0.05)); azr.sv_init(0, floor(srate * 0.05)); ) : ( azl.sv_reset(floor(srate * 0.05)); azr.sv_reset(floor(srate * 0.05)); );
  memset(AZDL, 0, 4096); memset(AZDR, 0, 4096); az_w = 0;

  memset(DRYL, 0, 4096); memset(DRYR, 0, 4096); dry_w = 0;
  dw_cur = p_drywet / 100; dw_last = dw_cur;
  sp_lat = 0;
  rms_n = min(2048, floor(5 * srate / BS));
  memset(RMSI, 0, 2048); memset(RMSO, 0, 2048);
  rms_i = 0; rms_si = rms_so = 0; rms_bi = rms_bo = 0;
  sl_on = 0; sl_q = 0; sl_b = 0;
  sc_w = 0; memset(SCOPE, 0, 2048);
);

function rng_seed_all() (
  ref_seeds ? (
    chr.jr_seed(1001); dgr.jr_seed(1002); wfr.jr_seed(1003); ohr.jr_seed(1004); dnl.jr_seed(2000); dnr.jr_seed(2001);
  ) : (
    chr.jr_seed(floor(rand(16777216)) * 16777216 + floor(rand(16777216)));
    dgr.jr_seed(floor(rand(16777216)) * 16777216 + floor(rand(16777216)));
    wfr.jr_seed(floor(rand(16777216)) * 16777216 + floor(rand(16777216)));
    ohr.jr_seed(floor(rand(16777216)) * 16777216 + floor(rand(16777216)));
    dnl.jr_seed(floor(rand(16777216)) * 16777216 + floor(rand(16777216)));
    dnr.jr_seed(floor(rand(16777216)) * 16777216 + floor(rand(16777216)));
  );
);

// ---------------------------------------------------------------------- block start

function lat_calc() (
  f32((p_loss_on ? lf_ord / 2 : 0) + (p_hyst_on ? f32(hy_lat) + 1.4 : 0) + (p_comp_on ? 4 : 0));
);

function block_begin() local(g, dly, ang, fadj, n, u1, u2, rad, i, cd, ff, sh) (
  g = db2g(p_ingain);
  g !== ig_cur ? ( ig_old = ig_cur; ig_cur = g; );
  ig_cur !== ig_old ? ( ig_g = ig_old; ig_inc = (ig_cur - ig_old) / BS; ig_old = ig_cur; ) : ( ig_g = ig_cur; ig_inc = 0; );
  g = db2g(p_outgain);
  g !== og_cur ? ( og_old = og_cur; og_cur = g; );
  og_cur !== og_old ? ( og_g = og_old; og_inc = (og_cur - og_old) / BS; og_old = og_cur; ) : ( og_g = og_cur; og_inc = 0; );
  dw_new = p_drywet;
  dw_new !== dw_cur ? dw_cur = dw_new;

  if_act = ifb.byp_begin(p_if_on);
  if_act ? (
    ifl.lr_set(p_lowcut); ifr.lr_set(p_lowcut);
    ifhl.lr_set(min(p_highcut, srate * 0.48)); ifhr.lr_set(min(p_highcut, srate * 0.48));
  );

  msi0.sv_set(db2g(p_bal * 6)); msi1.sv_set(db2g(p_bal * -6));

  tin_l.sm_set(p_tone_on ? db2g(18 * p_bass) : db2g(0));
  tin_h.sm_set(p_tone_on ? db2g(18 * p_treble) : db2g(0));
  tin_f.sm_set(p_tfreq);
  tin_smooth = tin_l.cnt > 0 || tin_h.cnt > 0 || tin_f.cnt > 0;

  cp_act = cpb.byp_begin(p_comp_on);
  cp_act ? (
    cpd0.sv_set(p_comp_amt);
