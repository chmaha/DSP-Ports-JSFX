@init

ext_noinit = gfx_ext_retina = 1;
ext_nodenorm = 1;

function alloc(n) local(r) instance(mp) global() ( r = mp; mp += n; memset(r, 0, n); r; );
alloc.mp = 0;

BS = 512;
ALPHA = 0.0016;
TWOPI = 2 * $pi;

FIRC = alloc(1024);
OSST = alloc(22 * 1024);
OSA = alloc(32);
OSB = alloc(32);
OSE = alloc(32);
OSF = alloc(32);
OSA2 = alloc(32);
OSB2 = alloc(32);
OSE2 = alloc(32);
OSF2 = alloc(32);
STNW = alloc(11320);
STNR = alloc(11400);
LFH = alloc(320);
LFC = alloc(320);
LFZ = alloc(2 * 1664);
WFDL = alloc(32768);
WFDR = alloc(32768);
AZDL = alloc(4096);
AZDR = alloc(4096);
DRYL = alloc(4096);
DRYR = alloc(4096);
MKDL = alloc(4096);
MKDR = alloc(4096);
CTHL = alloc(8);
CTHR = alloc(8);
SCOPE = alloc(2048);
PRV = alloc(96 * 48);
RMSI = alloc(2048);
RMSO = alloc(2048);
SLP = alloc(64);

