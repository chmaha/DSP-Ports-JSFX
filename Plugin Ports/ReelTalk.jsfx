// ---------------------------------------------------------------------- helpers

function db2g(x) ( x > -100 ? 10 ^ (x * 0.05) : 0; );
function g2db(x) ( x > 0 ? max(-100, log10(x) * 20) : -100; );

function f32(x) local(a, e, q, r, fl, d) (
  x === 0 ? 0 : (
    a = abs(x);
    e = floor(log(a) / log(2));
    2 ^ e > a ? e -= 1;
    2 ^ (e + 1) <= a ? e += 1;
    q = 2 ^ (e - 23);
    r = a / q;
    fl = floor(r);
    d = r - fl;
    (d > 0.5 || (d === 0.5 && (fl - 2 * floor(fl / 2)) === 1)) ? fl += 1;
    x < 0 ? -fl * q : fl * q;
  );
);

function ftan(x) local(x2) (
  x2 = x * x;
  x * (-135135 + x2 * (17325 + x2 * (-378 + x2))) / (-135135 + x2 * (62370 + x2 * (-3150 + 28 * x2)));
);

function tanh_acc(x) local(ax, y, u, em, t) (
  ax = abs(x);
  ax < 0.5 ? (
    y = 2 * ax;
    u = exp(y);
    em = u === 1 ? y : (u - 1) * y / log(u);
    t = em / (em + 2);
  ) : (
    u = exp(-2 * ax);
    t = (1 - u) / (1 + u);
  );
  x < 0 ? -t : t;
);

function jr_seed(s) instance(sd) ( sd = s; );
function jr_next() instance(sd) local(sh, sl, t, r) (
  sh = floor(sd / 16777216);
  sl = sd - sh * 16777216;
  t = sh * 15525485 + sl * 1502;
  t -= floor(t / 16777216) * 16777216;
  r = sl * 15525485 + t * 16777216 + 11;
  r -= floor(r / 281474976710656) * 281474976710656;
  sd = r;
  floor(r / 65536);
);
function f32u(u) local(q, r, fl, d) (
  u < 16777216 ? u : (
    q = u < 33554432 ? 2 : u < 67108864 ? 4 : u < 134217728 ? 8 : u < 268435456 ? 16 : u < 536870912 ? 32 : u < 1073741824 ? 64 : u < 2147483648 ? 128 : 256;
    r = u / q; fl = floor(r); d = r - fl;
    (d > 0.5 || (d === 0.5 && (fl - 2 * floor(fl / 2)) === 1)) ? fl += 1;
    fl * q;
  );
);
function jr_float() local(r) (
  r = f32u(this.jr_next()) / 4294967296;
  r === 1 ? 1 - 2 ^ -23 : r;
);
function jr_skip1024() instance(sd) local(sh, sl, t, r) (
  sh = floor(sd / 16777216);
  sl = sd - sh * 16777216;
  t = sh * 14585857 + sl * 12213447;
  t -= floor(t / 16777216) * 16777216;
  r = sl * 14585857 + t * 16777216 + 188734207353856;
  r -= floor(r / 281474976710656) * 281474976710656;
  sd = r;
);
function jr_double() ( this.jr_next() / 4294967296; );
function jr_int(mx) ( floor(this.jr_next() * mx / 4294967296); );
function jr_range(a, b) ( a + this.jr_int(max(a, b) - a); );

function sv_init(v, n) instance(cur, tgt, cnt, stp, steps) ( cur = tgt = v; cnt = 0; stp = 0; steps = n; );
function sv_reset(n) instance(cur, tgt, cnt, steps) ( steps = n; cur = tgt; cnt = 0; );
function sv_set(v) instance(cur, tgt, cnt, stp, steps) (
  v !== tgt ? (
    steps <= 0 ? ( cur = tgt = v; cnt = 0; ) : ( tgt = v; cnt = steps; stp = (tgt - cur) / cnt; );
  );
);
function sv_next() instance(cur, tgt, cnt, stp) (
  cnt > 0 ? ( cnt -= 1; cnt > 0 ? cur += stp : cur = tgt; cur; ) : tgt;
);
function sv_skip(n) instance(cur, tgt, cnt, stp) (
  n >= cnt ? ( cur = tgt; cnt = 0; tgt; ) : ( cur += stp * n; cnt -= n; cur; );
);
function sv_now(v) instance(cur, tgt, cnt) ( cur = tgt = v; cnt = 0; );

function sm_init(v, n) instance(cur, tgt, cnt, stp, steps) ( cur = tgt = v; cnt = 0; stp = 1; steps = n; );
function sm_reset(n) instance(cur, tgt, cnt, steps) ( steps = n; cur = tgt; cnt = 0; );
function sm_set(v) instance(cur, tgt, cnt, stp, steps) (
  v !== tgt ? (
    steps <= 0 ? ( cur = tgt = v; cnt = 0; ) : ( tgt = v; cnt = steps; stp = exp((log(abs(tgt)) - log(abs(cur))) / cnt); );
  );
);
function sm_next() instance(cur, tgt, cnt, stp) (
  cnt > 0 ? ( cnt -= 1; cnt > 0 ? cur *= stp : cur = tgt; cur; ) : tgt;
);
function sm_now(v) instance(cur, tgt, cnt) ( cur = tgt = v; cnt = 0; );

function byp_begin(on) instance(prev, act, fade, gw, gd, iw, id) local(s, e) (
  act = on || prev;
  fade = act && (on != prev);
  fade ? (
    s = !on ? 1 : 0;
    e = 1 - s;
    gw = s; iw = (e - s) / BS;
    gd = 1 - s; id = ((1 - e) - (1 - s)) / BS;
  );
  prev = on;
  act;
);

function lr_set(fc) instance(g, h) (
  g = tan($pi * fc / srate);
  h = 1 / (1 + 1.41421356237 * g + g * g);
);
function lr_tick(x) instance(g, h, s0, s1, s2, s3, lo, hi) local(yh, tb, yb, tl, yl, yh2, tb2, yb2, tl2, yl2) (
  yh = (x - (1.41421356237 + g) * s0 - s1) * h;
  tb = g * yh; yb = tb + s0; s0 = tb + yb;
  tl = g * yb; yl = tl + s1; s1 = tl + yl;
  yh2 = (yl - (1.41421356237 + g) * s2 - s3) * h;
  tb2 = g * yh2; yb2 = tb2 + s2; s2 = tb2 + yb2;
  tl2 = g * yb2; yl2 = tl2 + s3; s3 = tl2 + yl2;
  lo = yl2;
  hi = yl - 1.41421356237 * yb + yh - yl2;
);

function shelf_coefs(lg, hg, fc) instance(b0, b1, a1) local(rr, kk, a0i) (
  lg === hg ? (
    b0 = lg; b1 = 0; a1 = 0;
  ) : (
    rr = 1 / sqrt(hg / lg);
    kk = 1 / tan($pi * fc / srate);
    a0i = 1 / (rr * kk + 1);
    b0 = (hg * rr * kk + lg) * a0i;
    b1 = (hg * rr * -kk + lg) * a0i;
    a1 = (rr * -kk + 1) * a0i;
  );
);

function dcb_init(fc) instance(b0, b1, a1, a2, c0, c1, d1, d2, z1, z2, w1, w2) local(wc, c, phi, kk, a0) (
  wc = TWOPI * fc / srate;
  c = 1 / ftan(wc / 2);
  phi = c * c;
  kk = c / (1 / (-2 * cos(5 * $pi / 8)));
  a0 = phi + kk + 1;
  b0 = phi / a0; b1 = -2 * b0; a1 = 2 * (1 - phi) / a0; a2 = (phi - kk + 1) / a0;
  kk = c / (1 / (-2 * cos(7 * $pi / 8)));
  a0 = phi + kk + 1;
  c0 = phi / a0; c1 = -2 * c0; d1 = 2 * (1 - phi) / a0; d2 = (phi - kk + 1) / a0;
  z1 = z2 = w1 = w2 = 0;
);
function dcb_tick(x) instance(b0, b1, a1, a2, c0, c1, d1, d2, z1, z2, w1, w2) local(y) (
  y = z1 + x * b0;
  z1 = z2 + x * b1 - y * a1;
  z2 = x * b0 - y * a2;
  x = y;
  y = w1 + x * c0;
  w1 = w2 + x * c1 - y * d1;
  w2 = x * c0 - y * d2;
  y;
);

function snapz(x) ( (x < -0.00000001 || x > 0.00000001) ? x : 0; );

// ---------------------------------------------------------------------- oversampling

function fir_up(x, cf, st) local(nn, h, w, k, o) (
  nn = cf[0]; h = floor(nn / 2);
  w = (st[64] + 1) & 63; st[64] = w;
  st[w] = 2 * x;
  o = 0; k = 0;
  loop(floor((h + 1) / 2),
    o += (st[(w - ((nn - 1 - k) / 2)) & 63] + st[(w - k / 2) & 63]) * cf[1 + k];
    k += 2;
  );
  OSY0 = o;
  OSY1 = st[(w - ((nn - 1 - (h + 1)) / 2)) & 63] * cf[1 + h];
);
function fir_down(x0, x1, cf, st) local(nn, h, h4, w, k, o, ps) (
  nn = cf[0]; h = floor(nn / 2); h4 = floor(h / 2);
  w = (st[64] + 1) & 63; st[64] = w;
  st[w] = x0;
  o = 0; k = 0;
  loop(floor((h + 1) / 2),
    o += (st[(w - ((nn - 1 - k) / 2)) & 63] + st[(w - k / 2) & 63]) * cf[1 + k];
    k += 2;
  );
  ps = st[65];
  o += st[66 + ps] * cf[1 + h];
  st[66 + ps] = x1;
  st[65] = ps === 0 ? h4 : ps - 1;
  o;
);

function fos_up(x, cfg, ch, fac) local(st, n, c, i, src, dst, t) (
  st = OSST + (cfg * 2 + ch) * 1024;
  src = ch ? OSA2 : OSA; dst = ch ? OSB2 : OSB;
  src[0] = x; c = 1; n = 0;
  loop(fac,
    i = 0;
    loop(c,
      fir_up(src[i], FIRC + n * 256, st + n * 256);
      dst[2 * i] = OSY0; dst[2 * i + 1] = OSY1;
      i += 1;
    );
    c *= 2; n += 1;
    t = src; src = dst; dst = t;
  );
  src;
);
function fos_down(buf, cfg, ch, fac) local(st, n, c, i, src, dst, t) (
  st = OSST + (cfg * 2 + ch) * 1024;
  src = buf; dst = ch ? OSE2 : OSE;
  c = 2 ^ fac; n = fac - 1;
  loop(fac,
    c *= 0.5; i = 0;
    loop(c,
      dst[i] = fir_down(src[2 * i], src[2 * i + 1], FIRC + n * 256 + 128, st + n * 256 + 128);
      i += 1;
    );
    n -= 1;
    t = src; src = dst; dst = t === buf ? (ch ? OSF2 : OSF) : t;
  );
  src[0];
);

function iu0(x) instance(s0, s1, s2, s3, s4, s5, s6) local(v, o) (
  v = x;
  o = 0.04572814762408269 * v + s0; s0 = v - 0.04572814762408269 * o; v = o;
  o = 0.33250110957929974 * v + s1; s1 = v - 0.33250110957929974 * o; v = o;
  o = 0.6632020200410513 * v + s2; s2 = v - 0.6632020200410513 * o; v = o;
  o = 0.933855803088384 * v + s3; s3 = v - 0.933855803088384 * o; v = o;
  OSY0 = v;
  v = x;
  o = 0.16808754441358362 * v + s4; s4 = v - 0.16808754441358362 * o; v = o;
  o = 0.5044857477257907 * v + s5; s5 = v - 0.5044857477257907 * o; v = o;
