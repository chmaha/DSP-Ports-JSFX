slider1:p_hthr=0.3<0,1,0.001>-Hat Thr
slider2:p_hrate=0.45<0,1,0.001>-Hat Rate
slider3:p_hmix=0.5<0,1,0.001>-Hat Mix
slider4:p_kthr=0.46<0,1,0.001>-Kik Thr
slider5:p_ktrig=0.15<0,1,0.001>-Kik Trig
slider6:p_kmix=0.5<0,1,0.001>-Kik Mix
slider7:p_sthr=0.5<0,1,0.001>-Snr Thr
slider8:p_strig=0.7<0,1,0.001>-Snr Trig
slider9:p_smix=0.5<0,1,0.001>-Snr Mix
slider10:p_dyn=0<0,1,0.001>-Dynamics
slider11:p_rec=0<0,1,0.001>-Record
slider12:p_thru=0<0,1,0.001>-Thru Mix

in_pin:Left input
in_pin:Right input
out_pin:Left output
out_pin:Right output
options:no_meter

@init

ext_noinit = gfx_ext_retina = 1;
ext_nodenorm = 1;

bb_fix = 1;

function itrunc(x) ( x < 0 ? ceil(x) : floor(x); );

function bb_rand() (
  bb_seed = bb_seed * 214013 + 2531011;
  bb_seed -= floor(bb_seed / 4294967296) * 4294967296;
  floor(bb_seed / 65536) & 32767;
);

CSR = 44100;
HBL = 20000; KBL = 20000; SBL = 60000;
HB = 0; KB = 20000; SB = 40000; SB2 = 100000;

function bb_synth() local(t, e, de, o, o1, o2, p, dp)
(
  bb_seed = 1;
  memset(HB, 0, HBL);
  e = 0.00011999999696854502;
  o1 = o2 = 0;
  de = 10 ^ (-36 / CSR);
  t = 0;
  loop(5000,
    o = (bb_rand() % 2000) - 1000;
    HB[t] = e * (((2 * o1) - o2) - o);
    e *= de; o2 = o1; o1 = o;
    t += 1;
  );
  memset(KB, 0, KBL);
  de = 10 ^ (-3.8 / CSR);
  e = 0.5; dp = 1588 / CSR;
  p = 0.20000000298023224;
  t = 0;
  loop(14000,
    KB[t] = e * sin(p);
    e *= de;
    p = p + (dp * e);
    p >= 6.2831854820251465 ? p -= 6.2831854820251465;
    t += 1;
  );
  memset(SB, 0, SBL);
  memset(SB2, 0, SBL);
  de = 10 ^ (-15 / CSR);
  e = 0.3799999952316284;
  t = 0;
  loop(7000,
    o = (0.30000001192092896 * o) + ((bb_rand() % 2000) - 1000);
    SB[t] = e * (sin(p) + (0.0004 * o));
    SB2[t] = SB[t];
    e *= de;
    p = p + 0.025;
    p >= 6.2831853 ? p -= 6.2831853;
    t += 1;
  );
);

bb_synth();
bb_wver = 1;
bb_hrec = bb_krec = bb_srec = 0;

bb_hthr = 10 ^ ((2 * p_hthr) - 2);
bb_hdel = itrunc((0.04 + (0.2 * p_hrate)) * CSR);
bb_sthr = 40 * (10 ^ ((2 * p_sthr) - 2));
bb_sdel = itrunc(0.12 * CSR);
bb_kthr = 220 * (10 ^ ((2 * p_kthr) - 2));
bb_kdel = itrunc(0.1 * CSR);
bb_hlev = 0.00009999999747378752 + ((p_hmix * p_hmix) * 4);
bb_klev = 0.00009999999747378752 + ((p_kmix * p_kmix) * 4);
bb_slev = 0.00009999999747378752 + ((p_smix * p_smix) * 4);
bb_kww = 10 ^ (-3 + (2.2 * p_ktrig));
bb_ksf1 = cos(3.1415927 * bb_kww);
bb_ksf2 = sin(3.1415927 * bb_kww);
bb_ww = 10 ^ (-3 + (2.2 * p_strig));
bb_sf1 = cos(3.1415927 * bb_ww);
bb_sf2 = sin(3.1415927 * bb_ww);
bb_sf3 = 0.9909999966621399;
bb_sfx = bb_ksfx = 0;
bb_rec = bb_recx = bb_recpos = 0;
bb_mix = p_thru;
bb_dyna = 10 ^ (-1000 / CSR);
bb_dynr = 10 ^ (-6 / CSR);
bb_dyne = 0;
bb_dynm = p_dyn;
bb_hp = HBL - 2; bb_kp = KBL - 2; bb_sp = SBL - 2;
bb_hf = bb_f1 = bb_f2 = bb_kf1 = bb_kf2 = 0;

function bb_set()
(
  bb_hthr = 10 ^ ((2 * p_hthr) - 2);
  bb_hdel = itrunc((0.04 + (0.2 * p_hrate)) * srate);
  bb_sthr = 40 * (10 ^ ((2 * p_sthr) - 2));
  bb_kthr = 220 * (10 ^ ((2 * p_kthr) - 2));
  bb_hlev = 0.00009999999747378752 + ((p_hmix * p_hmix) * 4);
  bb_klev = 0.00009999999747378752 + ((p_kmix * p_kmix) * 4);
  bb_slev = 0.00009999999747378752 + ((p_smix * p_smix) * 4);
  bb_wwx = bb_ww;
  bb_ww = 10 ^ (-3 + (2.2 * p_strig));
  bb_sf1 = cos(3.1415927 * bb_ww);
  bb_sf2 = sin(3.1415927 * bb_ww);
  bb_kwwx = bb_kww;
  bb_kww = 10 ^ (-3 + (2.2 * p_ktrig));
  bb_ksf1 = cos(3.1415927 * bb_kww);
  bb_ksf2 = sin(3.1415927 * bb_kww);
  bb_wwx !== bb_ww ? bb_sfx = itrunc(2 * srate);
  bb_kwwx !== bb_kww ? bb_ksfx = itrunc(2 * srate);
  bb_rec = itrunc(4.900000095367432 * p_rec);
  (bb_rec != bb_recx && bb_recpos > 0) ? (
    bb_rec == 2 ? memset(HB + bb_recpos, 0, HBL - bb_recpos) :
    bb_rec == 3 ? memset(KB + bb_recpos, 0, KBL - bb_recpos) :
    bb_rec == 4 ? ( memset(SB + bb_recpos, 0, SBL - bb_recpos); memset(SB2 + bb_recpos, 0, SBL - bb_recpos); );
  );
  bb_recpos = 0; bb_recx = bb_rec;
  bb_mix = p_thru;
  bb_dynm = p_dyn;
  o_1 = p_hthr; o_2 = p_hrate; o_3 = p_hmix; o_4 = p_kthr; o_5 = p_ktrig; o_6 = p_kmix;
  o_7 = p_sthr; o_8 = p_strig; o_9 = p_smix; o_10 = p_dyn; o_11 = p_rec; o_12 = p_thru;
);

bb_set();

@slider

last_srate != srate ? (
  last_srate = srate;
  meter_decay = 0.001 ^ (1 / (0.4 * srate));
  bb_set();
);

@block

(p_hthr !== o_1 || p_hrate !== o_2 || p_hmix !== o_3 || p_kthr !== o_4 || p_ktrig !== o_5 || p_kmix !== o_6 ||
 p_sthr !== o_7 || p_strig !== o_8 || p_smix !== o_9 || p_dyn !== o_10 || p_rec !== o_11 || p_thru !== o_12) ? bb_set();

bb_mx3 = 0; bb_mx1 = bb_mix;
bb_hlv = bb_hlev; bb_klv = bb_klev; bb_slv = bb_slev;
bb_b1 = bb_sf1; bb_b2 = bb_sf2;
bb_sfx > 0 ? ( bb_mx3 = 0.07999999821186066; bb_slv = bb_klv = bb_hlv = 0; bb_mx1 = 0; bb_sfx -= samplesblock; );
bb_ksfx > 0 ? ( bb_mx3 = 0.029999999329447746; bb_slv = bb_klv = bb_hlv = 0; bb_mx1 = 0; bb_ksfx -= samplesblock; bb_b1 = bb_ksf1; bb_b2 = bb_ksf2; );
bb_hl = HBL - 2; bb_kl = KBL - 2; bb_sl = SBL - 2;
bb_rec >= 2 ? ( bb_wver += 1; bb_rec == 2 ? bb_hrec = 1 : bb_rec == 3 ? bb_krec = 1 : bb_srec = 1; );
bb_mxb = bb_fix ? 1 : 0;

@sample

bb_a = spl0;
bb_b = spl1;
bb_rec == 0 ? (
  bb_e = bb_a + bb_b;
  bb_dyne = bb_e < bb_dyne ? bb_dyne * bb_dynr : bb_e - (bb_dyna * (bb_e - bb_dyne));
  bb_hf = bb_e - bb_hf;
  (bb_hp > bb_hdel && bb_hf > bb_hthr) ? ( bb_hp = 0; bb_hhit = 1; ) : ( bb_hp += 1; bb_hp > bb_hl ? bb_hp = bb_hl; );
  bb_o = bb_hlv * HB[bb_hp];
  bb_k = ((bb_e + (bb_kf1 * bb_ksf1)) - (bb_kf2 * bb_ksf2));
  bb_kf2 = bb_sf3 * ((bb_kf1 * bb_ksf2) + (bb_kf2 * bb_ksf1));
  bb_kf1 = bb_sf3 * bb_k;
  (bb_kp > bb_kdel && bb_k > bb_kthr) ? ( bb_kp = 0; bb_khit = 1; ) : ( bb_kp += 1; bb_kp > bb_kl ? bb_kp = bb_kl; );
  bb_o += bb_klv * KB[bb_kp];
  bb_s = (((bb_hf + (0.30000001192092896 * bb_e)) + (bb_f1 * bb_b1)) - (bb_f2 * bb_b2));
  bb_f2 = bb_sf3 * ((bb_f1 * bb_b2) + (bb_f2 * bb_b1));
  bb_f1 = bb_sf3 * bb_s;
  (bb_sp > bb_sdel && bb_s > bb_sthr) ? ( bb_sp = 0; bb_shit = 1; ) : ( bb_sp += 1; bb_sp > bb_sl ? bb_sp = bb_sl; );
  bb_mx4 = 1 + (bb_dynm * ((bb_dyne + bb_dyne) - 1));
  bb_d = (bb_mx1 * bb_a) + (bb_mx3 * bb_s);
  spl0 = bb_d + (bb_mx4 * (bb_o + (bb_slv * SB[bb_sp])));
  bb_mxb ? bb_d = (bb_mx1 * bb_b) + (bb_mx3 * bb_s);
  spl1 = bb_d + (bb_mx4 * (bb_o + (bb_slv * SB2[bb_sp])));
  bb_hf = bb_e;
) : (
  bb_e = 0.5 * (bb_a + bb_b);
  (bb_recpos == 0 && abs(bb_e) < 0.004000000189989805) ? bb_e = 0 : (
    bb_rec == 2 ? ( bb_recpos < bb_hl ? ( HB[bb_recpos] = bb_e; bb_recpos += 1; ) : bb_e = 0; ) :
    bb_rec == 3 ? ( bb_recpos < bb_kl ? ( KB[bb_recpos] = bb_e; bb_recpos += 1; ) : bb_e = 0; ) :
    bb_rec == 4 ? ( bb_recpos < bb_sl ? ( SB[bb_recpos] = bb_a; SB2[bb_recpos] = bb_b; bb_recpos += 1; ) : bb_e = 0; );
  );
  spl0 = spl1 = bb_e;
);

bb_m = max(abs(bb_a), abs(bb_b));
bb_m > ipk ? ipk = bb_m : ipk *= meter_decay;
bb_m = max(abs(spl0), abs(spl1));
bb_m > opk ? opk = bb_m : opk *= meter_decay;

@gfx 900 380

DW = 900;
DH = 380;
scale = max(0.5, min(gfx_w / DW, gfx_h / DH));
ox = floor((gfx_w - DW*scale) * 0.5);
oy = 0;

MARGIN = 14*scale;
CW = 74*scale;
KR = 25*scale;
PANEL_H = 128*scale;
GENV = 200000;

function automate(s, end_touch)
(
<?
  max_sliders > 12 ? printf("slider_automate(2^(s-1), end_touch);") :
    printf("s == 1 ? slider_automate(p_hthr, end_touch) : s == 2 ? slider_automate(p_hrate, end_touch) : s == 3 ? slider_automate(p_hmix, end_touch) : s == 4 ? slider_automate(p_kthr, end_touch) : s == 5 ? slider_automate(p_ktrig, end_touch) : s == 6 ? slider_automate(p_kmix, end_touch) : s == 7 ? slider_automate(p_sthr, end_touch) : s == 8 ? slider_automate(p_strig, end_touch) : s == 9 ? slider_automate(p_smix, end_touch) : s == 10 ? slider_automate(p_dyn, end_touch) : s == 11 ? slider_automate(p_rec, end_touch) : s == 12 ? slider_automate(p_thru, end_touch) :");
?> 0;
);
function set_slider(s, v) ( slider(s) = v; automate(s, 0); automate(s, 1); );
function hit_circle(mx, my, cx, cy, rad) ( sqr(mx - cx) + sqr(my - cy) <= sqr(rad); );
function hit_rect(mx, my, x, y, w, h) ( mx >= x && mx <= x+w && my >= y && my <= y+h; );
function g_trunc(x) ( x < 0 ? ceil(x) : floor(x); );

function set_norm(s, v)
local(old)
(
  old = slider(s);
  slider(s) = floor(v*1000 + 0.5) / 1000;
  slider(s) !== old ? automate(s, 0);
);

function upper(str)
local(i, c)
(
  i = 0;
  loop(strlen(str),
    c = str_getchar(str, i);
    (c >= 97 && c <= 122) ? str_setchar(str, i, c - 32);
    i += 1;
  );
  str;
);

function draw_knob(cx, cy, rad, pos, cr, cg, cb, valtext, name)
local(ang0, ang1, ang, i, tx, ty)
(
  ang0 = -2.35619;
  ang1 =  2.35619;
  gfx_set(0.05, 0.05, 0.06, 1);
  gfx_circle(cx, cy, rad + 2*scale, 1, 1);
  gfx_set(cr*0.55, cg*0.55, cb*0.55, 1);
  gfx_circle(cx, cy, rad, 1, 1);
  gfx_set(cr, cg, cb, 1);
  gfx_circle(cx, cy, rad*0.72, 1, 1);
  gfx_set(1, 1, 1, 0.18);
  gfx_circle(cx - rad*0.28, cy - rad*0.28, rad*0.42, 1, 1);
  i = 0;
  loop(9,
    ang = ang0 + (ang1 - ang0) * (i / 8);
    gfx_set(0.85, 0.85, 0.85, 0.7);
    gfx_line(cx + sin(ang)*rad*0.82, cy - cos(ang)*rad*0.82, cx + sin(ang)*rad*0.98, cy - cos(ang)*rad*0.98, 1);
    i += 1;
  );
  ang = ang0 + (ang1 - ang0) * pos;
  gfx_set(0.05, 0.05, 0.05, 1);
  gfx_line(cx, cy, cx + sin(ang)*rad*0.85, cy - cos(ang)*rad*0.85, 1);
  gfx_setfont(1, "Arial", 14*scale);
  gfx_set(0.85, 0.85, 0.85, 1);
  gfx_measurestr(valtext, tx, ty);
  gfx_x = cx - tx*0.5; gfx_y = cy - rad - 18*scale;
  gfx_drawstr(valtext);
  gfx_set(0.8, 0.8, 0.82, 1);
  gfx_measurestr(name, tx, ty);
  gfx_x = cx - tx*0.5; gfx_y = cy + rad + 7*scale;
  gfx_drawstr(name);
);

function lcd_touch(s) ( lcd_sl = s; lcd_t = time_precise(); );

function row_begin(y, nk, ns)
(
  rx = ox + (DW*scale - (nk*CW + ns*8*scale + (ns - 1)*10*scale)) * 0.5;
  ry = oy + y;
);

function sec(nk, title, cr, cg, cb)
local(w, tw, th)
(
  w = nk*CW + 8*scale;
  gfx_set(0.035, 0.035, 0.04, 1);
  gfx_rect(rx - scale, ry - scale, w + 2*scale, PANEL_H + 2*scale, 1);
  gfx_set(0.125, 0.125, 0.14, 1);
  gfx_rect(rx, ry, w, PANEL_H, 1);
  gfx_set(cr, cg, cb, 0.8);
  gfx_rect(rx, ry, w, max(1, 2*scale), 1);
  gfx_setfont(1, "Arial", 12*scale, 'b');
  gfx_set(cr*0.75 + 0.15, cg*0.75 + 0.15, cb*0.75 + 0.15, 1);
  gfx_measurestr(title, tw, th);
  gfx_x = rx + (w - tw)*0.5; gfx_y = ry + 5*scale;
  gfx_drawstr(title);
  k_sx = rx + 4*scale; k_col = 0;
  k_r = cr; k_g = cg; k_b = cb;
  sec_x = rx; sec_w = w;
  rx += w + 10*scale;
);

function seg_btn(s, x, y, w, h, label, act, fs)
local(tw, th, gap, hov)
(
  hov = hit_rect(mouse_x, mouse_y, x, y, w, h);
  hov ? hov_s = s;
  gap = max(1, scale);
  gfx_set(0.03, 0.03, 0.04, 1);
  gfx_rect(x - gap, y - gap, w + 2*gap, h + 2*gap, 1);
  act ? gfx_set(acc_r*0.62, acc_g*0.62, acc_b*0.62, 1) : gfx_set(hov ? 0.17 : 0.14, hov ? 0.17 : 0.14, hov ? 0.19 : 0.16, 1);
  gfx_rect(x, y, w, h, 1);
  act ? gfx_set(acc_r, acc_g, acc_b, 1) : gfx_set(0.21, 0.21, 0.24, 1);
  gfx_rect(x + gap, y + gap, w - 2*gap, h*0.5, 1);
  gfx_set(1, 1, 1, act ? 0.22 : 0.08);
  gfx_rect(x + gap, y + gap, w - 2*gap, h*0.3, 1);
  gfx_setfont(1, "Arial", fs*scale, 'b');
  act ? gfx_set(0.08, 0.08, 0.10, 1) : gfx_set(0.78, 0.78, 0.80, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + (w - tw)*0.5; gfx_y = y + (h - th)*0.5;
  gfx_drawstr(label);
  mouse_just_down && hov;
);

function glow_text(str, x, y, r, g, b)
(
  gfx_set(r, g, b, 0.16);
  gfx_x = x - scale; gfx_y = y; gfx_drawstr(str);
  gfx_x = x + scale; gfx_y = y; gfx_drawstr(str);
  gfx_x = x; gfx_y = y - scale; gfx_drawstr(str);
  gfx_x = x; gfx_y = y + scale; gfx_drawstr(str);
  gfx_set(r, g, b, 1);
  gfx_x = x; gfx_y = y; gfx_drawstr(str);
);

function meter(x, y, w, h, pk, label)
local(db, fy, tw, th)
(
  gfx_setfont(1, "Arial", 11*scale, 'b');
  gfx_set(0.62, 0.63, 0.66, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + w*0.5 - tw*0.5; gfx_y = y;
  gfx_drawstr(label);
  y += th + 3*scale;
  h -= th + 3*scale;
  gfx_set(0.04, 0.04, 0.05, 1);
  gfx_rect(x - scale, y - scale, w + 2*scale, h + 2*scale, 1);
  gfx_set(acc_r*0.22, acc_g*0.22, acc_b*0.22, 1);
  gfx_rect(x, y, w, h, 1);
  db = pk > 0.000001 ? 20 * log10(pk) : -100;
  fy = y + h * (1 - max(0, min(1, (db + 60) / 60)));
  db > -1 ? gfx_set(1.0, 0.35, 0.30, 1) : gfx_set(acc_r, acc_g, acc_b, 1);
  gfx_rect(x, fy, w, y + h - fy, 1);
);

function lcd_frame(x, y, w, h)
(
  LX = x; LY = y; LW = w; LH = h;
  gfx_set(0.03, 0.03, 0.04, 1);
  gfx_rect(LX - 2*scale, LY - 2*scale, LW + 4*scale, LH + 4*scale, 1);
  gfx_set(0.17, 0.17, 0.19, 1);
  gfx_rect(LX, LY, LW, LH, 1);
  GX = LX + 6*scale; GY = LY + 6*scale; GW = LW - 12*scale; GH = LH - 12*scale;
  gfx_set(0.02, 0.02, 0.02, 1);
  gfx_rect(GX - scale, GY - scale, GW + 2*scale, GH + 2*scale, 1);
  gfx_set(0.035 + acc_r*0.05, 0.035 + acc_g*0.05, 0.035 + acc_b*0.05, 1);
  gfx_rect(GX, GY, GW, GH, 1);
  lc_r = min(1, 0.35 + acc_r*0.75); lc_g = min(1, 0.35 + acc_g*0.75); lc_b = min(1, 0.35 + acc_b*0.75);
);

function lcd_finish()
local(scy)
(
  gfx_set(0, 0, 0, 0.22);
  scy = GY;
  while (scy < GY + GH) ( gfx_rect(GX, scy, GW, max(1, scale), 1); scy += 3*scale; );
  gfx_set(1, 1, 1, 0.035);
  gfx_rect(GX, GY, GW, GH*0.45, 1);
);

function header(title, sub)
(
  gfx_set(0.09, 0.08, 0.08, 1);
  gfx_rect(0, 0, gfx_w, gfx_h, 1);
  gfx_setfont(1, "Arial", 20*scale, 'b');
  gfx_set(acc_r, acc_g, acc_b, 1);
  gfx_x = ox + MARGIN; gfx_y = oy + 8*scale;
  gfx_drawstr(title);
  gfx_setfont(1, "Arial", 13*scale);
  gfx_set(0.58, 0.60, 0.64, 1);
  gfx_x = ox + MARGIN + 2*scale; gfx_y = oy + 30*scale;
  gfx_drawstr(sub);
);

function hline(y) ( gfx_set(0.04, 0.04, 0.05, 1); gfx_rect(0, oy + y, gfx_w, max(1, scale), 1); );

function hint_bar(y, h, str)
local(tw, th)
(
  hline(y);
  gfx_setfont(1, "Arial", 13*scale);
  gfx_set(0.62, 0.63, 0.66, 1);
  strcpy(#ghint, str);
  gfx_measurestr(#ghint, tw, th);
  tw > (DW - 20)*scale ? ( gfx_setfont(1, "Arial", 13*scale*(DW - 20)*scale/tw); gfx_measurestr(#ghint, tw, th); );
  gfx_x = ox + (DW*scale - tw)*0.5; gfx_y = oy + y + (h - th)*0.5;
  gfx_drawstr(#ghint);
);


function def_val(s)
(
  s == 1 ? 0.3 : s == 2 ? 0.45 : s == 3 ? 0.5 : s == 4 ? 0.46 : s == 5 ? 0.15 : s == 6 ? 0.5 :
  s == 7 ? 0.5 : s == 8 ? 0.7 : s == 9 ? 0.5 : 0;
);

function knob_name(s)
(
  (s == 1 || s == 4 || s == 7) ? "Thr" : s == 2 ? "Rate" : (s == 3 || s == 6 || s == 9) ? "Mix" :
  (s == 5 || s == 8) ? "Trig" : s == 10 ? "Dynamics" : s == 12 ? "Thru Mix" : "Record";
);

function hint_text(s)
(
  s == 1 ? "Hat Thr: trigger threshold for the hi-hat, which listens to the high frequencies" :
  s == 2 ? "Hat Rate: maximum hi-hat trigger rate, as the shortest time between two hits" :
  s == 4 ? "Kik Thr: trigger threshold for the kick drum, which listens to the low frequencies" :
  s == 5 ? "Kik Trig: kick trigger filter frequency; you hear the filter (key listen) for 2 s after a change" :
  s == 7 ? "Snr Thr: trigger threshold for the snare, which listens to the mid frequencies" :
  s == 8 ? "Snr Trig: snare trigger filter frequency; raise it if the kick also fires the snare (key listen for 2 s)" :
  (s == 3 || s == 6 || s == 9) ? "Mix: playback level of this drum sample" :
  s == 10 ? "Dynamics: apply the level changes of the input signal to the drums" :
  s == 11 ? "Record: Monitor to hear the input, then pick a slot and play one sound into it; go back to Monitor, then Off" :
  s == 12 ? "Thru Mix: mix some of the input signal in with the drums" :
  "Drag or scroll a knob to adjust  ·  Ctrl for fine control  ·  double-click to reset";
);

function ptext(s)
local(v, d)
(
  v = slider(s);
  (s == 1 || s == 4 || s == 7) ? sprintf(#ptxt, "%.2f dB", 40 * v - 40) :
  s == 2 ? ( d = g_trunc((0.04 + 0.2 * v) * srate); sprintf(#ptxt, "%d ms", g_trunc(1000 * d / srate)); ) :
  (s == 3 || s == 6 || s == 9) ? sprintf(#ptxt, "%d dB", g_trunc(20 * log10(0.0001 + v * v * 4))) :
  (s == 5 || s == 8) ? sprintf(#ptxt, "%d Hz", g_trunc(0.5 * (10 ^ (-3 + 2.2 * v)) * srate)) :
  s == 10 ? sprintf(#ptxt, "%d %%", g_trunc(100 * v)) :
  s == 12 ? ( v > 0.0000001 ? sprintf(#ptxt, "%d dB", g_trunc(20 * log10(v))) : strcpy(#ptxt, "-inf dB"); ) :
  strcpy(#ptxt, "");
  #ptxt;
);

function knob_at(s, cx, cy, rad, cr, cg, cb)
local(hov, gv)
(
  hov = hit_circle(mouse_x, mouse_y, cx, cy, rad + 4*scale);
  hov ? hov_s = s;
  (mouse_just_down && hov) ? (
    (click_target == s && time_precise() - click_time < 0.3) ? (
      set_slider(s, def_val(s));
      drag_target = 0;
      lcd_touch(s);
    ) : (
      drag_target = s; drag_y0 = mouse_y; drag_v0 = slider(s); drag_fine = mouse_cap & 4;
    );
    click_target = s; click_time = time_precise();
  );
  (hov && mouse_wheel != 0 && drag_target == 0) ? (
    gv = slider(s) + (mouse_wheel / 120) * ((mouse_cap & 4) ? 0.001 : 0.01);
    set_norm(s, max(0, min(1, gv)));
    automate(s, 1);
    lcd_touch(s);
    mouse_wheel = 0;
  );
  draw_knob(cx, cy, rad, slider(s), cr, cg, cb, ptext(s), knob_name(s));
);

function knob(s)
local(cx, cy)
(
  cx = k_sx + CW*(k_col + 0.5);
  cy = ry + 72*scale;
  k_col += 1;
  knob_at(s, cx, cy, KR, k_r, k_g, k_b);
);

function drag_update()
(
  drag_target > 0 ? (
    mouse_down ? (
      mouse_cap |= 65536;
      fine_now = mouse_cap & 4;
      fine_now != drag_fine ? ( drag_y0 = mouse_y; drag_v0 = slider(drag_target); drag_fine = fine_now; );
      gv = max(0, min(1, drag_v0 + (drag_y0 - mouse_y) / (150*scale) * (fine_now ? 0.1 : 1)));
      set_norm(drag_target, gv);
      lcd_touch(drag_target);
    ) : ( automate(drag_target, 1); drag_target = 0; );
  );
);


function env_build(base, len, dst, n)
local(i, j, a, m, st, p, ns, top)
(
  i = len - 1;
  while (i > 0 && base[i] == 0) ( i -= 1; );
  len = max(1000, i + 1);
  st = len / n;
  ns = min(64, max(1, floor(st)));
  top = 0;
  i = 0;
  loop(n,
    m = 0; p = floor(i * st); j = 0;
    loop(ns,
      a = abs(base[p + floor(j * st / ns)]);
      a > m ? m = a;
      j += 1;
    );
    dst[i] = m;
    m > top ? top = m;
    i += 1;
  );
  dst[n] = top;
);

function pad(i, x, y, w, h, title, lamp, rec, base, len)
local(tw, th, pgx, pgy, pgw, pgh, e, k, top, pk)
(
  gfx_set(lc_r, lc_g, lc_b, 0.06 + 0.30 * lamp);
  gfx_rect(x, y, w, h, 1);
  gfx_set(lc_r, lc_g, lc_b, 0.25 + 0.6 * lamp);
  gfx_rect(x, y, w, max(1, scale), 1);
  gfx_rect(x, y + h - max(1, scale), w, max(1, scale), 1);
  gfx_rect(x, y, max(1, scale), h, 1);
  gfx_rect(x + w - max(1, scale), y, max(1, scale), h, 1);
  gfx_setfont(2, "Courier New", 14*scale, 'b');
  glow_text(title, x + 8*scale, y + 5*scale, lc_r, lc_g, lc_b);
  gfx_setfont(1, "Arial", 11*scale, 'b');
  strcpy(#gpt, rec ? "RECORDED" : "BUILT-IN");
  gfx_measurestr(#gpt, tw, th);
  gfx_set(lc_r, lc_g, lc_b, 0.8);
  gfx_x = x + w - tw - 8*scale; gfx_y = y + 7*scale; gfx_drawstr(#gpt);
  pgx = x + 8*scale; pgy = y + 26*scale; pgw = w - 16*scale; pgh = h - 32*scale;
  e = GENV + i * 256;
  pk = e[128];
  pk = pk > 0 ? 1 / pk : 0;
  k = 0;
  loop(128,
    top = min(1, e[k] * pk) * pgh * 0.5;
    gfx_set(lc_r, lc_g, lc_b, 0.35 + 0.55 * lamp);
    gfx_rect(pgx + k * pgw / 128, pgy + pgh * 0.5 - top, max(1, pgw / 128 - 0.5*scale), max(1, 2 * top), 1);
    k += 1;
  );
);

mouse_down = mouse_cap & 1;
mouse_just_down = mouse_down && !mouse_state;
hov_s = 0;
acc_r = 0.56; acc_g = 0.86; acc_b = 0.40;
g_rec = g_trunc(4.900000095367432 * p_rec);

bb_wver !== g_wver ? (
  g_wver = bb_wver;
  env_build(HB, HBL, GENV, 128);
  env_build(KB, KBL, GENV + 256, 128);
  env_build(SB, SBL, GENV + 512, 128);
);

header("BEAT AROUND THE BUSH", "by chmaha  ·  based on mda BeatBox");
gfx_setfont(1, "Arial", 12*scale, 'b');
gfx_set(0.62, 0.63, 0.66, 1);
strcpy(#gt, "DRUM REPLACER");
gfx_measurestr(#gt, gtw, gth);
gfx_x = ox + DW*scale - MARGIN - gtw; gfx_y = oy + 17*scale;
gfx_drawstr(#gt);
hline(46*scale);

lcd_frame(ox + MARGIN, oy + 56*scale, 770*scale, 96*scale);
TAW = 220*scale;
gfx_setfont(2, "Courier New", 14*scale, 'b');
glow_text("STATUS", GX + 10*scale, GY + 6*scale, lc_r, lc_g, lc_b);
sprintf(#lt, "%.1f KHZ", srate / 1000);
gfx_measurestr(#lt, ltw, lth);
glow_text(#lt, GX + TAW - ltw, GY + 6*scale, lc_r, lc_g, lc_b);
strcpy(#ln, g_rec == 1 ? "MONITOR" : g_rec == 2 ? "REC HAT" : g_rec == 3 ? "REC KICK" : g_rec == 4 ? "REC SNARE" :
            bb_ksfx > 0 ? "KICK KEY" : bb_sfx > 0 ? "SNARE KEY" : "PLAYING");
gfx_setfont(2, "Courier New", 24*scale, 'b');
gfx_measurestr(#ln, ltw, lth);
glow_text(#ln, GX + 10*scale + (TAW - 10*scale - ltw)*0.5, GY + 26*scale + (26*scale - lth)*0.5, lc_r, lc_g, lc_b);
gfx_setfont(2, "Courier New", 14*scale, 'b');
LY3 = GY + GH - 20*scale;
(lcd_sl > 0 && time_precise() - lcd_t < 1.5) ? (
  strcpy(#lt, lcd_sl <= 3 ? "HAT " : lcd_sl <= 6 ? "KICK " : lcd_sl <= 9 ? "SNARE " : "");
  strcat(#lt, knob_name(lcd_sl)); upper(#lt);
  glow_text(#lt, GX + 10*scale, LY3, lc_r, lc_g, lc_b);
  strcpy(#lv, ptext(lcd_sl)); upper(#lv);
  gfx_measurestr(#lv, ltw, lth);
  glow_text(#lv, GX + TAW - ltw, LY3, lc_r, lc_g, lc_b);
) : g_rec >= 2 ? (
  g_len = g_rec == 2 ? HBL - 2 : g_rec == 3 ? KBL - 2 : SBL - 2;
  bb_recpos > 0 ? sprintf(#lt, "%.2f / %.2f S", bb_recpos / srate, g_len / srate) : sprintf(#lt, "WAIT FOR SOUND");
  gfx_measurestr(#lt, ltw, lth);
  glow_text(#lt, GX + 10*scale + (TAW - 10*scale - ltw)*0.5, LY3, lc_r, lc_g, lc_b);
) : (
  sprintf(#lt, "DYN %d %%  THRU %s", g_trunc(100 * p_dyn), ptext(12));
  upper(#lt);
  gfx_measurestr(#lt, ltw, lth);
  glow_text(#lt, GX + 10*scale + (TAW - 10*scale - ltw)*0.5, LY3, lc_r, lc_g, lc_b);
);

SDX = GX + TAW + 12*scale;
gfx_set(lc_r, lc_g, lc_b, 0.18);
gfx_rect(SDX, GY + 8*scale, max(1, scale), GH - 16*scale, 1);
VX = SDX + 12*scale; VW = GX + GW - 8*scale - VX;
VY = GY + 4*scale; VH = GH - 8*scale;
PW = (VW - 2*10*scale) / 3;
bb_hhit ? ( g_lh = 1; bb_hhit = 0; ) : g_lh *= 0.8;
bb_khit ? ( g_lk = 1; bb_khit = 0; ) : g_lk *= 0.8;
bb_shit ? ( g_ls = 1; bb_shit = 0; ) : g_ls *= 0.8;
g_rec ? ( g_lh *= 0.5; g_lk *= 0.5; g_ls *= 0.5; );
pad(0, VX, VY, PW, VH, "HAT", g_rec == 2 ? 0.6 : g_lh, bb_hrec, HB, HBL);
pad(1, VX + PW + 10*scale, VY, PW, VH, "KICK", g_rec == 3 ? 0.6 : g_lk, bb_krec, KB, KBL);
pad(2, VX + 2*(PW + 10*scale), VY, PW, VH, "SNARE", g_rec == 4 ? 0.6 : g_ls, bb_srec, SB, SBL);
lcd_finish();

MW = 16*scale;
MAX0 = LX + LW + 26*scale;
MSP = (ox + DW*scale - MARGIN - MAX0 - MW);
meter(MAX0, LY, MW, LH, ipk, "IN");
meter(MAX0 + MSP, LY, MW, LH, opk, "OUT");

SY = oy + 164*scale; SH = 26*scale;
gfx_setfont(1, "Arial", 12*scale, 'b');
gfx_set(0.62, 0.63, 0.66, 1);
gfx_measurestr("RECORD", ltw, lth);
gfx_x = ox + MARGIN; gfx_y = SY + (SH - lth)*0.5;
gfx_drawstr("RECORD");
LBX = ox + MARGIN + ltw + 10*scale; LBW = 104*scale;
gli = 0;
loop(5,
  seg_btn(11, LBX + gli*(LBW + 4*scale), SY, LBW, SH, gli == 0 ? "OFF" : gli == 1 ? "MONITOR" : gli == 2 ? "-> HAT" : gli == 3 ? "-> KICK" : "-> SNARE", g_rec == gli, 12) ? (
    set_slider(11, gli == 0 ? 0 : gli == 1 ? 0.306 : gli == 2 ? 0.51 : gli == 3 ? 0.714 : 0.918); mouse_just_down = 0;
  );
  gli += 1;
);
g_rec = g_trunc(4.900000095367432 * p_rec);
gfx_setfont(1, "Arial", 12*scale);
gfx_set(0.58, 0.60, 0.64, 1);
strcpy(#gt, g_rec >= 2 ? "recording starts with the first sound" : "record your own hat, kick or snare");
gfx_measurestr(#gt, gtw, gth);
gfx_x = ox + DW*scale - MARGIN - gtw; gfx_y = SY + (SH - gth)*0.5;
gfx_drawstr(#gt);

hline(200*scale);
row_begin(208*scale, 11, 4);
sec(3, "HAT", 0.45, 0.80, 0.95); knob(1); knob(2); knob(3);
sec(3, "KICK", 1.00, 0.50, 0.30); knob(4); knob(5); knob(6);
sec(3, "SNARE", 0.98, 0.80, 0.30); knob(7); knob(8); knob(9);
sec(2, "OUTPUT", 0.80, 0.80, 0.84); knob(10); knob(12);

hint_bar(346*scale, 34*scale, hint_text(drag_target > 0 ? drag_target : hov_s));

drag_update();

mouse_wheel = 0;
mouse_state = mouse_down;
