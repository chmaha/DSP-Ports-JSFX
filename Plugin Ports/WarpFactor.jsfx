  A_DRIVE[ch] = d;
  d2 = drive * drive;
  ga = drive * 0.5;
  gb = (d2 * d2 * drive) * 24;
  g = ga + (gb - ga) * d2;
  squ = drive * (2 - drive);
  pg = 1 / sclip(0.33 + squ * (g - 0.33));
  prev = A_PRE[ch]; prei = (g - prev) / sz;
  postv = A_POST[ch]; posti = (pg - postv) / sz;
  i = 0;
