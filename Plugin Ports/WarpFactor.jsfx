    s = b[2] * zd42 + s;
    s = b[1] * zd41 + s;
    s = b[0] * zd40 + s;
    out[0] = s;
    out += 1;
  );
);
function dn3(st, pid, in, out, sz) local(s, p, b) (
  while (sz > 0) (
    loop(3,
      p = pid[0];
      st[p] = in[0];
      st[p + 36] = in[0];
      in += 1;
      p -= 1;
      p < 0 ? p += 36;
      pid[0] = p;
    );
    sz -= 3;
    b = st + pid[0] + 1;
    s = 0;
    s = b[35] * zd335 + s;
    s = b[34] * zd334 + s;
    s = b[33] * zd333 + s;
