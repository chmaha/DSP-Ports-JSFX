    s = x1 * zu4_1_1 + s;
    s = x0 * zu4_1_0 + s;
    out[0] = s;
    out += 1;
    s = 0;
    s = x11 * zu4_2_11 + s;
    s = x10 * zu4_2_10 + s;
    s = x9 * zu4_2_9 + s;
    s = x8 * zu4_2_8 + s;
    s = x7 * zu4_2_7 + s;
