    qo_render(sh, fr, ci, cq, BS);
  ) : (
    i = 0;
    loop(BS,
      qt_sample(0, INL[i] / 32768);
      ci[i] = q_i;
      cq[i] = q_q;
      i += 1;
    );
    ps = pv_ps; psi = (p_ps - ps) / BS;
    i = 0;
    loop(BS,
      xi = ci[i]; xq = cq[i];
      ps += psi;
      ang = ps;
      rs = interp(T_SIN, ang, 1024);
      rc = interp(T_SIN + 256, ang, 1024);
      ci[i] = rs * xi + rc * xq;
      cq[i] = rs * xq - rc * xi;
      i += 1;
    );
