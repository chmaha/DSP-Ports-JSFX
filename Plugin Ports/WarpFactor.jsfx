// ---------------------------------------------------------------------- oscillators
O_PH = alloc(2); O_PI = alloc(2); O_NS = alloc(2); O_LP = alloc(2); O_HP = alloc(2); O_HI = alloc(2); O_EXT = alloc(2); O_S1 = alloc(2); O_S2 = alloc(2);

function osc_init() local(i) (
  i = 0;
  loop(2,
    O_NS[i] = 0; O_PH[i] = 0; O_PI[i] = 100 * (1 / SR);
    O_HP[i] = 0; O_LP[i] = 0; O_HI[i] = 0; O_EXT[i] = 0; O_S1[i] = 0; O_S2[i] = 0;
    i += 1;
