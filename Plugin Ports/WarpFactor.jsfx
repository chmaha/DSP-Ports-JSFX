  hu52 = H_U6[42];
  hu53 = H_U6[43];
  hu54 = H_U6[44];
  hu55 = H_U6[45];
  hu56 = H_U6[46];
  hu57 = H_U6[47];
);
function su0(in, out) local(x0, x1, x2, x3, x4, x5, x6, x7, v) (
  x0 = sv0_0; x1 = sv0_1; x2 = sv0_2; x3 = sv0_3; x4 = sv0_4; x5 = sv0_5; x6 = sv0_6; x7 = sv0_7;
  v = 0;
  loop(60,
    x7 = x6; x6 = x5; x5 = x4; x4 = x3; x3 = x2; x2 = x1; x1 = x0; x0 = in[v];
    out[v * 6 + 0] = x0 * hu00 + (x1 * hu01 + (x2 * hu02 + (x3 * hu03 + (x4 * hu04 + (x5 * hu05 + (x6 * hu06 + (x7 * hu07)))))));
    out[v * 6 + 1] = x0 * hu10 + (x1 * hu11 + (x2 * hu12 + (x3 * hu13 + (x4 * hu14 + (x5 * hu15 + (x6 * hu16 + (x7 * hu17)))))));
    out[v * 6 + 2] = x0 * hu20 + (x1 * hu21 + (x2 * hu22 + (x3 * hu23 + (x4 * hu24 + (x5 * hu25 + (x6 * hu26 + (x7 * hu27)))))));
    out[v * 6 + 3] = x0 * hu30 + (x1 * hu31 + (x2 * hu32 + (x3 * hu33 + (x4 * hu34 + (x5 * hu35 + (x6 * hu36 + (x7 * hu37)))))));
    out[v * 6 + 4] = x0 * hu40 + (x1 * hu41 + (x2 * hu42 + (x3 * hu43 + (x4 * hu44 + (x5 * hu45 + (x6 * hu46 + (x7 * hu47)))))));
    out[v * 6 + 5] = x0 * hu50 + (x1 * hu51 + (x2 * hu52 + (x3 * hu53 + (x4 * hu54 + (x5 * hu55 + (x6 * hu56 + (x7 * hu57)))))));
    v += 1;
  );
  sv0_0 = x0; sv0_1 = x1; sv0_2 = x2; sv0_3 = x3; sv0_4 = x4; sv0_5 = x5; sv0_6 = x6; sv0_7 = x7;
);
function su1(in, out) local(x0, x1, x2, x3, x4, x5, x6, x7, v) (
  x0 = sv1_0; x1 = sv1_1; x2 = sv1_2; x3 = sv1_3; x4 = sv1_4; x5 = sv1_5; x6 = sv1_6; x7 = sv1_7;
  v = 0;
  loop(60,
    x7 = x6; x6 = x5; x5 = x4; x4 = x3; x3 = x2; x2 = x1; x1 = x0; x0 = in[v];
    out[v * 6 + 0] = x0 * hu00 + (x1 * hu01 + (x2 * hu02 + (x3 * hu03 + (x4 * hu04 + (x5 * hu05 + (x6 * hu06 + (x7 * hu07)))))));
    out[v * 6 + 1] = x0 * hu10 + (x1 * hu11 + (x2 * hu12 + (x3 * hu13 + (x4 * hu14 + (x5 * hu15 + (x6 * hu16 + (x7 * hu17)))))));
    out[v * 6 + 2] = x0 * hu20 + (x1 * hu21 + (x2 * hu22 + (x3 * hu23 + (x4 * hu24 + (x5 * hu25 + (x6 * hu26 + (x7 * hu27)))))));
    out[v * 6 + 3] = x0 * hu30 + (x1 * hu31 + (x2 * hu32 + (x3 * hu33 + (x4 * hu34 + (x5 * hu35 + (x6 * hu36 + (x7 * hu37)))))));
    out[v * 6 + 4] = x0 * hu40 + (x1 * hu41 + (x2 * hu42 + (x3 * hu43 + (x4 * hu44 + (x5 * hu45 + (x6 * hu46 + (x7 * hu47)))))));
    out[v * 6 + 5] = x0 * hu50 + (x1 * hu51 + (x2 * hu52 + (x3 * hu53 + (x4 * hu54 + (x5 * hu55 + (x6 * hu56 + (x7 * hu57)))))));
    v += 1;
  );
  sv1_0 = x0; sv1_1 = x1; sv1_2 = x2; sv1_3 = x3; sv1_4 = x4; sv1_5 = x5; sv1_6 = x6; sv1_7 = x7;
);
function dn6(st, pid, in, out, sz) local(s, p, b) (
  while (sz > 0) (
    loop(6,
      p = pid[0];
      st[p] = in[0];
      st[p + 48] = in[0];
      in += 1;
      p -= 1;
      p < 0 ? p += 48;
      pid[0] = p;
    );
    sz -= 6;
    b = st + pid[0] + 1;
    s = 0;
    s = b[47] * zd647 + s;
    s = b[46] * zd646 + s;
    s = b[45] * zd645 + s;
    s = b[44] * zd644 + s;
    s = b[43] * zd643 + s;
