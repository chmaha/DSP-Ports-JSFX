function osc_noise(o, note, mod, out, sz) local(i, lv, e, ig, x, inc, f2, g, r, h, s1, s2, hp, bp, lp) (
  i = 0;
  loop(sz,
    nrng = (nrng * 1664525 + 1013904223);
    nrng -= 4294967296 * floor(nrng / 4294967296);
    x = nrng * (1 / 4294967296);
    out[i] = 2 * x - 1;
