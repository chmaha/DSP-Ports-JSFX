);

function mod_init() (
  A_DRIVE[0] = 0; A_DRIVE[1] = 0; A_LEVEL[0] = 0; A_LEVEL[1] = 0; A_POST[0] = 0; A_POST[1] = 0; A_PRE[0] = 0; A_PRE[1] = 0;
  sv0_0=sv0_1=sv0_2=sv0_3=sv0_4=sv0_5=sv0_6=sv0_7=sv1_0=sv1_1=sv1_2=sv1_3=sv1_4=sv1_5=sv1_6=sv1_7=0;
  memset(SD, 0, 96);
  osc_init();
  voc_init();
  qt_init();
  qo_f = qo_s = qo_p = 0;
  pv_d0 = pv_d1 = pv_alg = pv_par = pv_ps = 0;
  pv_note = 48;
  SD_P[0] = 47;
  fbs = 0;
);
SU0 = alloc(8); SU1 = alloc(8); SD = alloc(96); SD_P = alloc(1);
tables_ok ? ( su_load(); su2_load(); );
sv0_0=sv0_1=sv0_2=sv0_3=sv0_4=sv0_5=sv0_6=sv0_7=sv1_0=sv1_1=sv1_2=sv1_3=sv1_4=sv1_5=sv1_6=sv1_7=0;

function clipd(x) ( x < -32768 ? -1 : x > 32767 ? 32767 / 32768 : x / 32768; );

function egg_proc() local(ci, cq, i, d, lin, fr, dir, sh, ang, xi, xq, rs, rc, sm, smi, fv, fvi, dv, dvi, tm, inp, mo, am, mf, a, b, up, dn, fin, fou, mn, ax, w, ps, psi) (
  ci = SRC0; cq = SRC0 + BS;
  p_shape ? (
    d = p_fsp - 0.5;
    lin = 1 - (14 * d) * d;
    lin < 0 ? lin = 0;
    fr = p_fsp;
    fr += lin * p_fsc;
    dir = fr >= 0.5 ? 1 : -1;
    fr = 2 * abs(fr - 0.5);
    fr = fr <= 0.4 ? ((fr * fr) * fr) * 62.5 : 4 * semi(180 * (fr - 0.4));
    fr *= semi(((p_fsc * 60) * (1 - lin)) * dir);
    fr *= dir;
