  i = 0;
  loop(sz,
    hp = (((out[i] - r * s1) - g * s1) - s2) * h;
    bp = g * hp + s1;
    s1 = g * hp + bp;
    lp = g * bp + s2;
    s2 = g * bp + lp;
    out[i] = lp;
    i += 1;
  );
  O_S1[o] = s1; O_S2[o] = s2;
  1;
