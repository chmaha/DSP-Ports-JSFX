    a = clip16i(x1 * 32768) & 65535;
    b = clip16i(x2 * 32768) & 65535;
    m = a ~ b;
    m >= 32768 ? m -= 65536;
    m /= 32768;
    s = (x1 + x2) * 0.7;
    s + (m - s) * par;
  ) : alg === 5 ? (
    x_comp(x1, x2, par);
  ) : x1;
