M_PI = $pi;
TA = ((0.3333314036 * M_PI) * M_PI) * M_PI;
TB = ((((0.1333923995 * M_PI) * M_PI) * M_PI) * M_PI) * M_PI;
TC = ((((((0.0533740603 * M_PI) * M_PI) * M_PI) * M_PI) * M_PI) * M_PI) * M_PI;
TD = ((((((((0.002900525 * M_PI) * M_PI) * M_PI) * M_PI) * M_PI) * M_PI) * M_PI) * M_PI) * M_PI;
TE = ((((((((((0.0095168091 * M_PI) * M_PI) * M_PI) * M_PI) * M_PI) * M_PI) * M_PI) * M_PI) * M_PI) * M_PI) * M_PI;

function osc_render(o, shape, note, mod, out, sz) (
  shape === 0 ? osc_sine(o, note, mod, out, sz) :
  shape === 1 ? osc_tri(o, note, mod, out, sz) :
  shape === 2 ? osc_saw(o, note, mod, out, sz) :
  shape === 3 ? osc_pulse(o, note, mod, out, sz) :
  osc_noise(o, note, mod, out, sz);
