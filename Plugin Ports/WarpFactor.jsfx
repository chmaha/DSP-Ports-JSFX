    loop(360,
      x1 = pm[0]; x2 = pa[0];
      s = 0; s += x1; s += x2; s += (x1 * x2) * 0.25; s *= 0.02 + par;
      xv = s * KFOLD; xi = xv | 0; xu = fdt[xi]; a = xu + (fdt[xi + 1] - xu) * (xv - xi);
      c2 = x2 * 2; d1 = x1 + c2; d2 = x1 - c2;
      dz = abs(d1) - 0.667; dz += abs(dz); dz *= dz; d1 = (0.04324765822726063 * dz) * (d1 > 0 ? 1 : -1);
      dz = abs(d2) - 0.667; dz += abs(dz); dz *= dz; d2 = (0.04324765822726063 * dz) * (d2 > 0 ? 1 : -1);
      r = d1 + d2; r *= (4 + par * 24);
      b = (r * (27 + r * r)) / (27 + 9 * r * r);
