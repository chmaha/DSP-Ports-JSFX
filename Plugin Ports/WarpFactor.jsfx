    OUTR[i] = clipd(ax * 32768);
    i += 1;
  );
);

function xmod_block(ai, par, pinc, bal, binc) local(pa, pm, x1, x2, a, b, xv, xi, xu, fi, fo, s, c2, d1, d2, dz, r, fdt) (
  pa = SRC0; pm = SRC1; fdt = T_FOLD + 2048;
  ai === 0 ? (
    loop(360,
      x1 = pm[0]; x2 = pa[0];
      xv = par * 256; xi = xv | 0; xu = T_XIN[xi]; fi = xu + (T_XIN[xi + 1] - xu) * (xv - xi);
      xu = T_XOUT[xi]; fo = xu + (T_XOUT[xi + 1] - xu) * (xv - xi);
