    loop(360,
      x1 = pm[0]; x2 = pa[0];
      a = x_comp(x1, x2, par);
      b = x1;
      pa[0] = a + (b - a) * bal;
      par += pinc;
      bal += binc;
      pa += 1; pm += 1;
    );
  );
);

function mod_proc() local(va, i, xs, vs, cg, ba, a, b, al, pa, ai, pi, af, pf, p0, p1, pinc, bal, binc, n, x1, x2, ra, rl, tg, ag) (
  va = (p_alg - 0.7) * 20 + 0.5;
  va = max(0, min(1, va));
  !p_shape ? memset(BUF2, 0, BS);
  !p_shape ? amp_proc(0, p_d0, 1 - va, INL, BUF0, BUF2, BS);
  amp_proc(1, p_d1, 1 - va, INR, BUF1, BUF2, BS);
  p_shape ? (
    i = 0;
    loop(BS, INTM[i] = INL[i] / 32768; i += 1;);
    xs = p_shape - 1;
    vs = p_shape + 1;
    va === 0 ? (
      osc_render(0, xs, p_note, INTM, BUF2, BS);
      i = 0;
      loop(BS, BUF0[i] = BUF2[i] * 0.5; i += 1;);
    ) : va >= 0.5 ? (
      cg = osc_render(1, vs, p_note, INTM, BUF2, BS);
      i = 0;
      loop(BS, BUF0[i] = BUF2[i] * cg; i += 1;);
    ) : (
      ba = va * 2;
      osc_render(0, xs, p_note, INTM, BUF0, BS);
      cg = osc_render(1, vs, p_note, INTM, BUF2, BS);
      i = 0;
      loop(BS,
        a = BUF0[i];
        b = BUF2[i];
        BUF2[i] = a + (b - a) * ba;
        a *= 0.5;
        b *= cg;
        BUF0[i] = a + (b - a) * ba;
        i += 1;
      );
    );
  );
  va < 0.5 ? (
    su0(BUF0, SRC0);
    su1(BUF1, SRC1);
    al = min(p_alg * 8, 5.999);
    pa = min(pv_alg * 8, 5.999);
    ai = al | 0; af = al - ai;
    pi = pa | 0; pf = pa - pi;
    ai !== pi ? pf = af;
    p0 = skew_par(pv_alg, pv_par);
    p1 = skew_par(p_alg, p_par);
    pinc = (p1 - p0) * (1 / 360);
    bal = pf;
    binc = (af - pf) * (1 / 360);
    xmod_block(ai, p0, pinc, bal, binc);
    dn6(SD, SD_P, SRC0, BUF0, 360);
  ) : (
    rl = 4 * (p_alg - 0.75);
    rl = max(0, min(1, rl));
    voc_rel = rl * (2 - rl);
    voc_fs = p_par;
    voc_proc(BUF1, BUF0, BUF0, BS);
  );
  tg = 2 * (va < 0.5 ? va : 1 - va);
  tg !== 0 ? (
    i = 0;
    loop(BS, BUF0[i] += tg * (BUF1[i] - BUF0[i]); i += 1;);
  );
  i = 0;
  loop(BS,
    OUTL[i] = clipd(BUF0[i] * 32768);
    OUTR[i] = clipd(BUF2[i] * 16384);
    i += 1;
  );
);

function glue_init() (
  lp_l1 = k_l1; lp_l2 = k_l2; lp_alg = k_alg; lp_tim = k_tim;
  note_pot = 60 * k_l1 + 12;
  note_cv = 0;
);

function glue_read() local(pot, n, iv) (
  lp_l1 += (0.33 * 0.08) * (k_l1 - lp_l1);
  lp_l2 += (0.33 * 0.08) * (k_l2 - lp_l2);
  lp_alg += (0.33 * 0.08) * (k_alg - lp_alg);
  lp_tim += (0.33 * 0.08) * (k_tim - lp_tim);
  p_d0 = lp_l1 * lp_l1;
  p_d1 = lp_l2 * lp_l2;
  pot = interp(T_POT, lp_alg, 512);
  p_alg = max(0, min(1, pot));
  p_par = max(0, min(1, lp_tim));
  p_alg <= 0.125 ? (
    p_alg = p_alg * 1.08 - 0.01;
    p_alg = max(0, min(1, p_alg));
  );
  p_fsp = lp_alg;
  p_fsc = 0;
  p_ps = max(0, min(1, lp_alg));
  n = 60 * k_l1 + 12;
  note_pot += 0.1 * (n - note_pot);
  midi_held > 0 ? (
    iv = midi_note - note_cv;
    (iv < -0.4 || iv > 0.4) ? note_cv = midi_note : note_cv += 0.1 * iv;
    p_note = note_cv;
  ) : (
    p_note = note_pot + 24;
  );
  p_shape = k_osc | 0;
);

function engine_block() local(k, ipk, opk) (
  ipk = 0; k = 0;
  loop(BS, ipk = max(ipk, max(abs(INL[k]), abs(INR[k]))); k += 1;);
  (ipk > 0.3 || (k_osc >= 0.5) || midi_held > 0) ? ( idle = 0; idle_cnt = 0; );
  idle ? (
    memset(OUTL, 0, BS); memset(OUTR, 0, BS);
    idle_blk += 1;
  ) : (
    idle_blk = 0;
    glue_read();
    k_egg >= 0.5 ? egg_proc() : mod_proc();
    pv_d0 = p_d0; pv_d1 = p_d1; pv_alg = p_alg; pv_par = p_par; pv_ps = p_ps; pv_note = p_note;
    opk = 0; k = 0;
    loop(BS, opk = max(opk, max(abs(OUTL[k]), abs(OUTR[k]))); k += 1;);
    (opk < 0.000001 && ipk <= 0.3 && k_osc < 0.5) ? (
      idle_cnt += 1;
      idle_cnt >= 3200 ? idle = 1;
    ) : idle_cnt = 0;
  );
);

function engine_reset() (
  mod_init();
  glue_init();
  idle = 0; idle_cnt = 0; idle_blk = 0;
  midi_held = 0;
);

// ---------------------------------------------------------------------- host bridge (windowed-sinc resampling to and from 96 kHz)

KT = alloc(4100);
BDCO = alloc(65536); BUCO = alloc(65536);
BDST = alloc(4096); BDCN = alloc(4096); BUST = alloc(4096); BUCN = alloc(4096);
HDIN = alloc(4 * 8192);
EOR = alloc(4 * 8192);

function bessel_i0(x) local(s, t, k) (
  s = 1; t = 1; k = 1;
  loop(30, t *= (x / (2 * k)) * (x / (2 * k)); s += t; k += 1; );
  s;
);

function kern(u) local(x, i) (
  x = (u + KW) * 256;
  i = floor(x);
  (i < 0 || i >= KW * 512) ? 0 : KT[i] + (KT[i + 1] - KT[i]) * (x - i);
);

function kern_build() local(i, u, w, beta) (
  KW = 8;
  beta = 7.5;
  i = 0;
  loop(KW * 512 + 1,
    u = i / 256 - KW;
    w = 1 - (u / KW) * (u / KW);
    KT[i] = (abs(u) < 0.000000001 ? 0.9 : sin($pi * 0.9 * u) / ($pi * u)) * (w > 0 ? bessel_i0(beta * sqrt(w)) / bessel_i0(beta) : 0);
    i += 1;
  );
);
kern_build();

function gcd(a, b) local(t) ( while (b > 0) ( t = a % b; a = b; b = t; ); a; );

function host_setup() local(fl, gg, ri, st, en, j, tq) (
  bypass = srate == SR;
  fl = min(srate, SR);
  dn_scale = fl / srate;
  dn_half = KW * srate / fl;
  dn_step = srate / SR;
  up_scale = fl / SR;
  up_half = KW * SR / fl;
  up_step = SR / srate;
  host_lat = bypass ? BS : ceil((BS + 3 + dn_half / dn_step + up_half) * dn_step);
  poly = 0;
  (!bypass && srate === floor(srate)) ? (
    gg = gcd(srate, SR);
    rta = srate / gg; rtb = SR / gg;
    tdn = floor(2 * dn_half) + 2; tup = floor(2 * up_half) + 2;
    (rta <= 4096 && rtb <= 4096 && rtb * tdn <= 65536 && rta * tup <= 65536) ? (
      poly = 1;
      ri = 0;
      loop(rtb,
        st = ceil(ri / rtb - dn_half); en = floor(ri / rtb + dn_half);
        BDST[ri] = st; BDCN[ri] = en - st + 1;
        j = 0;
        loop(en - st + 1, BDCO[ri * tdn + j] = kern((st + j - ri / rtb) * dn_scale) * dn_scale; j += 1; );
        ri += 1;
      );
      ri = 0;
      loop(rta,
        st = ceil(ri / rta - up_half); en = floor(ri / rta + up_half);
        BUST[ri] = st; BUCN[ri] = en - st + 1;
        j = 0;
        loop(en - st + 1, BUCO[ri * tup + j] = kern((st + j - ri / rta) * up_scale) * up_scale; j += 1; );
        ri += 1;
      );
      dnq = 0; dnr = 0;
      tq = -host_lat * rtb;
      upq = floor(tq / rta); upr = tq - upq * rta;
    );
  );
  hbase = hin;
  dn_t = hin;
  ein_n = 0;
  eo_n = 0;
  memset(HDIN, 0, 4 * 8192);
  memset(EOR, 0, 4 * 8192);
  memset(OUTL, 0, BS); memset(OUTR, 0, BS);
  bpos = 0;
);

function push_engine_in(l, r) local(k) (
  INL[ein_n] = l; INR[ein_n] = r;
  ein_n += 1;
  ein_n >= BS ? (
    ein_n = 0;
    engine_block();
    k = 0;
    loop(BS,
      eix = (eo_n & 8191) * 2;
      EOR[eix] = EOR[eix + 16384] = OUTL[k];
      EOR[eix + 1] = EOR[eix + 16385] = OUTR[k];
      eo_n += 1;
      k += 1;
    );
  );
);
last_srate = 0;
cur_engine = -1;
MIDN = alloc(16);
last_srate = 0;

@slider

last_srate != srate ? (
  last_srate = srate;
  tables_ok ? engine_reset();
  host_setup();
);

@block

while (midirecv(mofs, mm1, mm2, mm3)) (
  mst = mm1 & 240;
  (mst === 144 && mm3 > 0) ? (
    midi_note = mm2;
    midi_held < 16 ? ( MIDN[midi_held] = mm2; midi_held += 1; );
  ) : (mst === 128 || mst === 144) ? (
    mi = 0;
    while (mi < midi_held) (
      MIDN[mi] === mm2 ? (
        memcpy(MIDN + mi, MIDN + mi + 1, midi_held - mi - 1);
        midi_held -= 1;
        mi -= 1;
      );
      mi += 1;
    );
    midi_held > 0 ? midi_note = MIDN[midi_held - 1];
  );
  midisend(mofs, mm1, mm2, mm3);
);
pdc_bot_ch = 0;
pdc_top_ch = 2;
pdc_delay = host_lat;

@sample

k_route >= 0.5 ? (
  xl = spl0; xr = spl1;
) : (
  xl = 0.5 * (spl0 + spl1); xr = 0.5 * (spl2 + spl3);
);
xl *= 32768; xr *= 32768;
tables_ok ? (
  (xl === 0 && xr === 0) ? in_zero += 1 : in_zero = 0;
  bsl = idle && idle_blk >= 4 && in_zero > 256;
  bypass ? (
    INL[bpos] = xl; INR[bpos] = xr;
    gl = OUTL[bpos]; gr = OUTR[bpos];
    bpos += 1;
    bpos >= BS ? ( bpos = 0; engine_block(); );
  ) : (
    eix = (hin & 8191) * 2;
    HDIN[eix] = HDIN[eix + 16384] = xl;
    HDIN[eix + 1] = HDIN[eix + 16385] = xr;
    poly ? (
      lastn = hbase + dnq + BDST[dnr] + BDCN[dnr] - 1;
      while (lastn < hin) (
        bsl ? push_engine_in(0, 0) : (
          nn = hbase + dnq + BDST[dnr];
          cop = BDCO + dnr * tdn;
          al = 0; ar = 0;
          ep = HDIN + (nn & 8191) * 2;
          loop(BDCN[dnr],
            kv = cop[0];
            al += ep[0] * kv;
            ar += ep[1] * kv;
            ep += 2; cop += 1;
          );
          push_engine_in(al, ar);
        );
        dnr += rta;
        while (dnr >= rtb) ( dnr -= rtb; dnq += 1; );
        lastn = hbase + dnq + BDST[dnr] + BDCN[dnr] - 1;
      );
      gl = gr = 0;
      mm = upq + BUST[upr];
      (mm >= 0 && !bsl) ? (
        cop = BUCO + upr * tup;
        (mm + BUCN[upr]) <= eo_n ? (
          ep = EOR + (mm & 8191) * 2;
          k_outm < 0.5 ? (
            loop(BUCN[upr],
              gl += ep[0] * cop[0];
              ep += 2; cop += 1;
            );
          ) : (
            loop(BUCN[upr],
              kv = cop[0];
              gl += ep[0] * kv;
              gr += ep[1] * kv;
              ep += 2; cop += 1;
            );
          );
        ) : (
          loop(BUCN[upr],
            mm < eo_n ? (
              kv = cop[0];
              ix = (mm & 8191) * 2;
              gl += EOR[ix] * kv;
              gr += EOR[ix + 1] * kv;
            );
            mm += 1; cop += 1;
          );
        );
      );
      upr += rtb;
      while (upr >= rta) ( upr -= rta; upq += 1; );
    ) : (
      while (dn_t + dn_half < hin) (
        n0 = ceil(dn_t - dn_half);
        n1 = floor(dn_t + dn_half);
        al = 0; ar = 0;
        nn = n0;
        while (nn <= n1) (
          kv = kern((nn - dn_t) * dn_scale);
          al += HDIN[(nn & 8191) * 2] * kv;
          ar += HDIN[(nn & 8191) * 2 + 1] * kv;
          nn += 1;
        );
        push_engine_in(al * dn_scale, ar * dn_scale);
        dn_t += dn_step;
      );
      ut = (hin - hbase - host_lat) * up_step;
      gl = gr = 0;
      ut - up_half >= 0 ? (
        m0 = ceil(ut - up_half);
        m1 = floor(ut + up_half);
        mm = m0;
        while (mm <= m1) (
          mm < eo_n ? (
            kv = kern((mm - ut) * up_scale) * up_scale;
            gl += EOR[(mm & 8191) * 2] * kv;
            gr += EOR[(mm & 8191) * 2 + 1] * kv;
          );
          mm += 1;
        );
      );
    );
  );
  hin += 1;
  spl0 = gl;
  spl1 = k_outm >= 0.5 ? gr : gl;
  k_outm < 0.5 ? spl1 = gl;
) : (
  spl0 = spl1 = 0;
);
ui_lev = max(ui_lev * 0.9995, abs(spl0));

@gfx 860 430

UDW = 860;
UDH = 430;
uscale = max(0.5, min(gfx_w / UDW, gfx_h / UDH));
uox = floor((gfx_w - UDW * uscale) * 0.5);
uoy = 0;

function s_min(s) ( 0; );
function s_max(s) ( s == 5 ? 3 : s > 5 ? 1 : 1; );
function s_step(s) ( s >= 5 ? 1 : 0; );
function def_val(s) ( s == 1 || s == 2 || s == 4 ? 0.5 : 0; );
function knob_name(s) (
  k_egg >= 0.5 ? (
    s == 1 ? "FEEDBACK" : s == 2 ? "DRY / WET" : s == 3 ? (k_osc >= 0.5 ? "FREQ SHIFT" : "PHASE") : "UP / DOWN";
  ) : (
    s == 1 ? (k_osc >= 0.5 ? "PITCH" : "LEVEL 1") : s == 2 ? "LEVEL 2" : s == 3 ? "ALGORITHM" : "TIMBRE";
  );
);
function ptext(s) (
  sprintf(#upt, "%d%%", floor(slider(s) * 100 + 0.5));
  #upt;
);
function seg_label(s, i) (
  s == 7 ? (i ? "L / R" : "1+2 / 3+4") :
  s == 8 ? (i ? "MAIN + AUX" : "MAIN") : "";
);
function hint_text(s) (
  k_egg >= 0.5 && s <= 4 && s > 0 ? (
    s == 1 ? "Feedback: routes the shifted signal back into the input." :
    s == 2 ? "Dry / wet: how much of the shifted signal you hear." :
    s == 3 ? (k_osc >= 0.5 ? "Frequency shift: centre is no shift, left down, right up. The oscillator shape sets the character." : "Phase rotation between the two inputs (input 1 is the carrier).") :
    "Blends the up-shifted and down-shifted signals. Hard left or right gives a single-sideband shift.";
  ) :
  s == 1 ? (k_osc >= 0.5 ? "Pitch of the internal oscillator (MIDI notes override it)." : "Level and drive of input 1, the carrier.") :
  s == 2 ? "Level and drive of input 2, the modulator." :
  s == 3 ? "Algorithm: crossfade, fold, analog ring, digital ring, XOR, comparator, then the vocoder (release grows until it freezes)." :
  s == 4 ? "Timbre: the character of the current algorithm, or the formant shift in the vocoder." :
  s == 5 ? "INT OSC replaces input 1 with an oscillator. Sine, triangle or saw in the cross-mods; saw, pulse or noise in the vocoder." :
  s == 6 ? "Easter egg: the module's hidden frequency shifter." :
  s == 7 ? "Where the inputs come from: channels 1+2 and 3+4 (sidechain), or just left and right." :
  s == 8 ? "Outputs: main on both, or main left and aux right (the aux out is the sum of the inputs, or the oscillator)." :
  "Drag or scroll a knob to adjust  ·  Ctrl for fine control  ·  double-click to reset";
);

function automate(s, e)
(
<?
  max_sliders > 8 ? printf("slider_automate(2^(s-1), e);") :
    loop(i = 1; 8,
      printf("  s == %d ? slider_automate(slider%d, e) :\n", i, i);
      i += 1;
    );
?> 0;
);

function set_slider(s, x) ( slider(s) = x; automate(s, 0); automate(s, 1); );
function hit_circle(mx, my, cx, cy, rad) ( sqr(mx - cx) + sqr(my - cy) <= sqr(rad); );
function hit_rect(mx, my, x, y, w, h) ( mx >= x && mx <= x + w && my >= y && my <= y + h; );
function px(x) ( uox + x * uscale; );
function py(y) ( uoy + y * uscale; );

function norm_of(s) ( (slider(s) - s_min(s)) / (s_max(s) - s_min(s)); );
function set_norm(s, x) local(old, st) (
  old = slider(s);
  st = s_step(s);
  slider(s) = st > 0 ? s_min(s) + floor(x * (s_max(s) - s_min(s)) / st + 0.5) * st : s_min(s) + x * (s_max(s) - s_min(s));
  slider(s) !== old ? ( automate(s, 0); );
);

function ctext(str, cx, y, fs, fl) local(tw, th)
(
  gfx_setfont(1, "Arial", fs * uscale, fl);
  gfx_measurestr(str, tw, th);
  gfx_x = cx - tw * 0.5; gfx_y = y;
  gfx_drawstr(str);
);

function ltext(str, x, y, fs, fl)
(
  gfx_setfont(1, "Arial", fs * uscale, fl);
  gfx_x = x; gfx_y = y;
  gfx_drawstr(str);
);

function rk_draw(cx, cy, rad, pos, cr, cg, cb) local(ang0, ang1, ang, i, a, rr, ca, sa, n)
(
  ang0 = -2.35619;
  ang1 = 2.35619;
  gfx_set(0, 0, 0, 0.18);
  gfx_circle(cx + rad * 0.06, cy + rad * 0.10, rad * 1.02, 1, 1);
  gfx_set(0.07, 0.07, 0.08, 1);
  gfx_circle(cx, cy, rad, 1, 1);
  i = 0;
  loop(36,
    a = i * 2 * $pi / 36;
    gfx_set(0.20, 0.20, 0.22, 1);
    gfx_line(cx + sin(a) * rad * 0.80, cy - cos(a) * rad * 0.80, cx + sin(a) * rad * 0.97, cy - cos(a) * rad * 0.97, 1);
    i += 1;
  );
  gfx_set(0.13, 0.13, 0.14, 1);
  gfx_circle(cx, cy, rad * 0.76, 1, 1);
  ang = ang0 + (ang1 - ang0) * pos;
  sa = sin(ang); ca = cos(ang);
  rr = rad * 0.08;
  n = max(7, 2 * floor(rad * 0.16) + 1);
  i = 0;
  loop(n,
    a = (i - (n - 1) / 2) / ((n - 1) / 2) * rr;
    gfx_set(cr, cg, cb, 1);
    gfx_line(cx + sa * rad * 0.50 + ca * a, cy - ca * rad * 0.50 + sa * a, cx + sa * rad * 0.96 + ca * a, cy - ca * rad * 0.96 + sa * a, 1);
    i += 1;
  );
  gfx_set(cr * 0.64, cg * 0.64, cb * 0.64, 1);
  gfx_circle(cx, cy, rad * 0.56, 1, 1);
  gfx_set(cr, cg, cb, 1);
  gfx_circle(cx, cy, rad * 0.53, 1, 1);
  gfx_set(1, 1, 1, 0.45);
  gfx_circle(cx - rad * 0.10, cy - rad * 0.12, rad * 0.30, 1, 1);
  gfx_set(cr * 0.78, cg * 0.78, cb * 0.78, 1);
  gfx_line(cx + sa * rad * 0.20, cy - ca * rad * 0.20, cx + sa * rad * 0.50, cy - ca * rad * 0.50, 1);
);

function pill_col(kind)
(
  kind == 1 ? gfx_set(0.91, 0.18, 0.42, 1) :
  kind == 2 ? gfx_set(0.10, 0.72, 0.78, 1) :
  kind == 3 ? gfx_set(0.70, 0.08, 0.42, 1) :
  gfx_set(0.95, 0.55, 0.15, 1);
);

function label_pill(str, cx, y, kind, big) local(tw, th, fs)
(
  fs = big ? 15 : 14;
  gfx_setfont(1, "Arial", fs * uscale, 'b');
  gfx_measurestr(str, tw, th);
  kind > 0 ? (
    pill_col(kind);
    gfx_rect(cx - tw * 0.5 - 5 * uscale, y - 1 * uscale, tw + 10 * uscale, th + 2 * uscale, 1);
    gfx_set(1, 1, 1, 1);
  ) : gfx_set(0.12, 0.12, 0.13, 1);
  gfx_x = cx - tw * 0.5; gfx_y = y;
  gfx_drawstr(str);
);

function rosette(cx, cy, r0) local(i, a, r1)
(
  i = 0;
  loop(60,
    a = i * 2 * $pi / 60;
    r1 = r0 * ((i & 1) ? 1.20 : 1.12);
    gfx_set(0.45, 0.46, 0.48, (i & 1) ? 0.30 : 0.18);
    gfx_line(cx + sin(a) * r0 * 1.04, cy - cos(a) * r0 * 1.04, cx + sin(a) * r1, cy - cos(a) * r1, 1);
    gfx_circle(cx + sin(a + 0.05) * r0 * 1.26, cy - cos(a + 0.05) * r0 * 1.26, max(1, 1.2 * uscale), 0, 1);
    i += 1;
  );
);

function knob_core(s, cx, cy, rad, kind) local(hov, x, cr, cg, cb)
(
  hov = hit_circle(mouse_x, mouse_y, cx, cy, rad + 4 * uscale);
  hov ? u_hov = s;
  (u_click && hov) ? (
    (u_ctarget == s && time_precise() - u_ctime < 0.3) ? (
      set_slider(s, def_val(s));
      u_drag = 0;
    ) : (
      u_drag = s; u_dy0 = mouse_y; u_dv0 = norm_of(s); u_dfine = mouse_cap & 4;
      automate(s, 0);
    );
    u_ctarget = s; u_ctime = time_precise();
    u_click = 0;
  );
  (hov && u_wheel != 0 && u_drag == 0) ? (
    x = norm_of(s) + (u_wheel / 120) * ((mouse_cap & 4) ? 0.002 : 0.02);
    set_norm(s, max(0, min(1, x)));
    automate(s, 1);
    u_wheel = 0;
  );
  kind == 1 ? ( cr = 0.93; cg = 0.27; cb = 0.47; ) :
  kind == 2 ? ( cr = 0.20; cg = 0.78; cb = 0.84; ) :
  kind == 3 ? ( cr = 0.72; cg = 0.10; cb = 0.45; ) :
  ( cr = 0.97; cg = 0.97; cb = 0.96; );
  rk_draw(cx, cy, rad, norm_of(s), cr, cg, cb);
  hov;
);

function knob_at(s, cx, cy, rad, big, kind) local(hov, ly)
(
  big ? rosette(cx, cy, rad);
  hov = knob_core(s, cx, cy, rad, kind);
  ly = cy + rad * (big ? 1.30 : 1.12) + 4 * uscale;
  label_pill(knob_name(s), cx, ly, kind, big);
  gfx_set((hov || u_drag == s) ? 0.78 : 0.36, (hov || u_drag == s) ? 0.42 : 0.37, (hov || u_drag == s) ? 0.10 : 0.40, 1);
  ctext(ptext(s), cx, ly + 18 * uscale, 12, 0);
);

function led(cx, cy, r, g, b, lv)
(
  gfx_set(0.55, 0.55, 0.56, 1);
  gfx_circle(cx, cy, 8 * uscale, 1, 1);
  gfx_set(0.93, 0.93, 0.92, 1);
  gfx_circle(cx, cy, 6.5 * uscale, 1, 1);
  lv > 0.01 ? (
    gfx_set(r, g, b, 0.35 * lv); gfx_circle(cx, cy, 11 * uscale, 1, 1);
    gfx_set(r, g, b, 0.25 + 0.75 * lv); gfx_circle(cx, cy, 6.5 * uscale, 1, 1);
  );
  gfx_set(1, 1, 1, 0.6);
  gfx_circle(cx - 2 * uscale, cy - 2 * uscale, 2 * uscale, 1, 1);
);

function dark_btn(s, x, y, w, h, label, act, fs) local(tw, th, hov)
(
  hov = hit_rect(mouse_x, mouse_y, x, y, w, h);
  hov ? u_hov = s;
  gfx_set(0.10, 0.10, 0.11, 1);
  gfx_rect(x - uscale, y - uscale, w + 2 * uscale, h + 2 * uscale, 1);
  act ? gfx_set(0.93, 0.50, 0.16, 1) : gfx_set(hov ? 0.30 : 0.24, hov ? 0.30 : 0.24, hov ? 0.32 : 0.26, 1);
  gfx_rect(x, y, w, h, 1);
  gfx_set(1, 1, 1, act ? 0.20 : 0.07);
  gfx_rect(x, y, w, h * 0.45, 1);
  gfx_setfont(1, "Arial", fs * uscale, 'b');
  act ? gfx_set(0.10, 0.07, 0.04, 1) : gfx_set(0.90, 0.90, 0.91, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + (w - tw) * 0.5; gfx_y = y + (h - th) * 0.5;
  gfx_drawstr(label);
  u_click && hov;
);

function seg(s, x, y, w, h, n, base) local(i, sw)
(
  sw = w / n;
  i = 0;
  loop(n,
    dark_btn(s, x + i * sw, y, sw - 2 * uscale, h, seg_label(s, i), (slider(s) | 0) == i + base, 12) ? ( set_slider(s, i + base); u_click = 0; );
    i += 1;
  );
);

function cap(str, x, y)
(
  gfx_set(0.12, 0.12, 0.13, 1);
  ltext(str, x, y, 12, 'b');
);

function field(s, x, y, w, h) local(hov, v)
(
  hov = hit_rect(mouse_x, mouse_y, x, y, w, h);
  hov ? u_hov = s;
  gfx_set(0.10, 0.10, 0.11, 1);
  gfx_rect(x - uscale, y - uscale, w + 2 * uscale, h + 2 * uscale, 1);
  gfx_set(hov || u_drag == s ? 0.30 : 0.24, hov || u_drag == s ? 0.30 : 0.24, hov || u_drag == s ? 0.32 : 0.26, 1);
  gfx_rect(x, y, w, h, 1);
  gfx_set(0.90, 0.90, 0.91, 1);
  ctext(ptext(s), x + w * 0.5, y + (h - 14 * uscale) * 0.5, 12, 'b');
  (u_click && hov) ? (
    (u_ctarget == s && time_precise() - u_ctime < 0.3) ? ( set_slider(s, def_val(s)); u_drag = 0; ) :
    ( u_drag = s; u_dy0 = mouse_y; u_dv0 = norm_of(s); u_dfine = mouse_cap & 4; automate(s, 0); );
    u_ctarget = s; u_ctime = time_precise();
    u_click = 0;
  );
  (hov && u_wheel != 0 && u_drag == 0) ? (
    v = slider(s) + (u_wheel > 0 ? 1 : -1) * s_step(s);
    slider(s) = max(s_min(s), min(s_max(s), v));
    automate(s, 0); automate(s, 1);
    u_wheel = 0;
  );
);

function dots_h(x0, x1, y) local(x)
(
  gfx_set(0.16, 0.16, 0.18, 0.75);
  x = x0;
  while (x < x1) ( gfx_rect(x, y - uscale, max(1, 2 * uscale), max(1, 2 * uscale), 1); x += 6 * uscale; );
);
function dots_v(x, y0, y1) local(y)
(
  gfx_set(0.16, 0.16, 0.18, 0.75);
  y = y0;
  while (y < y1) ( gfx_rect(x - uscale, y, max(1, 2 * uscale), max(1, 2 * uscale), 1); y += 6 * uscale; );
);

function screw(cx, cy)
(
  gfx_set(0.62, 0.62, 0.63, 1); gfx_circle(cx, cy, 6 * uscale, 1, 1);
  gfx_set(0.93, 0.93, 0.93, 1); gfx_circle(cx, cy, 4.5 * uscale, 1, 1);
  gfx_set(0.55, 0.55, 0.57, 1);
  gfx_line(cx - 3 * uscale, cy - 3 * uscale, cx + 3 * uscale, cy + 3 * uscale, 1);
);

function panel_bg() local(useed)
(
  gfx_set(0.86, 0.865, 0.875, 1);
  gfx_rect(0, 0, gfx_w, gfx_h, 1);
  useed = 7;
  loop(140,
    useed = (useed * 1103 + 12345) % 65536;
    gfx_set(useed & 1 ? 1 : 0, useed & 1 ? 1 : 0, useed & 1 ? 1 : 0, 0.028);
    gfx_rect(px(0), py(useed / 65536 * UDH), UDW * uscale, max(1, uscale), 1);
  );
  screw(px(14), py(12)); screw(px(UDW - 14), py(12));
);

function panel_band(y) local(uby, i)
(
  uby = py(y);
  gfx_set(0.70, 0.71, 0.73, 1);
  gfx_rect(px(0), uby, UDW * uscale, 9 * uscale, 1);
  i = 0;
  loop(UDW / 4,
    gfx_set(0.52, 0.53, 0.56, 1);
    gfx_line(px(i * 4), uby + 8 * uscale, px(i * 4 + 6), uby + uscale, 1);
    i += 1;
  );
  gfx_set(0.97, 0.97, 0.97, 1);
  gfx_rect(px(0), uby + 9 * uscale, UDW * uscale, max(1, uscale), 1);
);

function panel_title(tt, sub, origin) local(tw, th)
(
  gfx_set(0.14, 0.14, 0.15, 1);
  gfx_setfont(1, "Arial", 30 * uscale);
  gfx_x = px(70); gfx_y = py(8);
  gfx_drawstr(tt);
  gfx_measurestr(tt, tw, th);
  gfx_setfont(1, "Arial", 17 * uscale);
  gfx_x = px(70) + tw + 16 * uscale; gfx_y = py(17);
  gfx_drawstr(sub);
  gfx_setfont(1, "Arial", 12 * uscale);
  gfx_set(0.36, 0.37, 0.40, 1);
  gfx_x = px(71); gfx_y = py(41);
  gfx_drawstr(origin);
);

function hint_bar(y) local(uhs, tw, th)
(
  gfx_set(0.20, 0.20, 0.21, 1);
  gfx_rect(px(0), py(y), UDW * uscale, 36 * uscale, 1);
  uhs = u_drag > 0 ? u_drag : u_hov;
  gfx_setfont(1, "Arial", 13 * uscale);
  gfx_set(0.80, 0.80, 0.82, 1);
  strcpy(#uhint, hint_text(uhs));
  gfx_measurestr(#uhint, tw, th);
  tw > (UDW - 20) * uscale ? ( gfx_setfont(1, "Arial", 13 * uscale * (UDW - 20) * uscale / tw); gfx_measurestr(#uhint, tw, th); );
  gfx_x = uox + (UDW * uscale - tw) * 0.5; gfx_y = py(y) + (36 * uscale - th) * 0.5;
  gfx_drawstr(#uhint);
);

function frame_begin()
(
  u_down = mouse_cap & 1;
  u_click = u_down && !u_pstate;
  u_wheel = mouse_wheel;
  mouse_wheel = 0;
  u_hov = 0;
);

function frame_end() local(ufine)
(
  u_drag > 0 ? (
    u_down ? (
      mouse_cap |= 65536;
      ufine = mouse_cap & 4;
      ufine != u_dfine ? ( u_dy0 = mouse_y; u_dv0 = norm_of(u_drag); u_dfine = ufine; );
      set_norm(u_drag, max(0, min(1, u_dv0 + (u_dy0 - mouse_y) / (150 * uscale) * (ufine ? 0.1 : 1))));
    ) : ( automate(u_drag, 1); u_drag = 0; );
  );
  u_pstate = u_down;
);

function pal(i, c) (
  c == 0 ? (i == 0 ? 0 : i == 1 ? 64 : i == 2 ? 255 : i == 3 ? 255 : i == 4 ? 255 : i == 5 ? 255 : i == 6 ? 255 : i == 7 ? 0 : 0) :
  c == 1 ? (i == 0 ? 192 : i == 1 ? 255 : i == 2 ? 255 : i == 3 ? 64 : i == 4 ? 0 : i == 5 ? 0 : i == 6 ? 0 : i == 7 ? 0 : 255) :
  (i == 0 ? 64 : i == 1 ? 0 : i == 2 ? 0 : i == 3 ? 0 : i == 4 ? 0 : i == 5 ? 64 : i == 6 ? 255 : i == 7 ? 255 : 192);
);

function palc(z, c) local(i, f, a, b) (
  i = min(8, floor(z));
  f = z - i;
  a = pal(i, c); b = pal(min(8, i + 1), c);
  (a + (b - a) * f) / 255;
);

function alg_label(i) (
  i == 0 ? "XFADE" : i == 1 ? "FOLD" : i == 2 ? "ANALOG" : i == 3 ? "DIGITAL" : i == 4 ? "XOR" :
  i == 5 ? "COMP" : i == 6 ? "VOCODER" : i == 7 ? "RELEASE" : "FREEZE";
);

function arc_col(cx, cy, r, a0, a1, cr, cg, cb) local(i, a) (
  gfx_set(cr, cg, cb, 1);
  i = 0;
  loop(3, gfx_arc(cx, cy, r + i * 0.5, a0, a1, 1); i += 1;);
);

frame_begin();
panel_bg();

gfx_set(0.14, 0.14, 0.15, 1);
gfx_rect(px(30), py(10), 30 * uscale, 30 * uscale, 0);
gfx_rect(px(31), py(11), 28 * uscale, 28 * uscale, 0);
gfx_line(px(36), py(32), px(45), py(16), 1); gfx_line(px(45), py(16), px(54), py(32), 1); gfx_line(px(40), py(25), px(50), py(25), 1);
panel_title("Warp Factor", "meta modulator", "by chmaha  ·  based on Mutable Instruments Warps");
panel_band(60);

gsz = k_egg >= 0.5 ? p_ps * 8 : p_alg * 8;
gcr = palc(gsz, 0); gcg = palc(gsz, 1); gcb = palc(gsz, 2);

gi = 0;
loop(9,
  gang = -2.35619 + gi / 8 * 4.71239;
  gfx_set(0.55, 0.55, 0.57, 1);
  gfx_circle(px(220) + sin(gang) * 108 * uscale, py(208) - cos(gang) * 108 * uscale, 2 * uscale, 1, 1);
  gfx_set(0.12, 0.12, 0.13, k_egg >= 0.5 ? 0.3 : 1);
  ctext(alg_label(gi), px(220) + sin(gang) * 142 * uscale, py(208) - cos(gang) * 124 * uscale - 7 * uscale, 11, 'b');
  gi += 1;
);
gfx_set(0.55, 0.55, 0.57, 1);
gfx_arc(px(220), py(208), 108 * uscale, -2.35619, 2.35619, 1);

knob_core(3, px(220), py(208), 84 * uscale, 0);
gfx_set(gcr, gcg, gcb, 0.34); gfx_circle(px(220), py(208), 84 * uscale * 0.53, 1, 1);
label_pill(knob_name(3), px(220), py(324), 0, 1);

gfx_set(0.16, 0.16, 0.18, 0.75);
dots_v(px(390), py(78), py(340));

knob_core(1, px(462), py(146), 34 * uscale, 3);
arc_col(px(462), py(146), 44 * uscale, -2.35619, 2.35619, 0.70, 0.08, 0.42);
label_pill(knob_name(1), px(462), py(196), 3, 0);
gfx_set(0.36, 0.37, 0.40, 1); ctext(ptext(1), px(462), py(214), 12, 0);

knob_core(2, px(596), py(146), 34 * uscale, 2);
arc_col(px(596), py(146), 44 * uscale, -2.35619, 2.35619, 0.10, 0.72, 0.78);
label_pill(knob_name(2), px(596), py(196), 2, 0);
gfx_set(0.36, 0.37, 0.40, 1); ctext(ptext(2), px(596), py(214), 12, 0);

knob_at(4, px(736), py(146), 42 * uscale, 1, 0);

g_ohov = hit_circle(mouse_x, mouse_y, px(440), py(268), 16 * uscale);
g_ohov ? u_hov = 5;
(u_click && g_ohov) ? ( set_slider(5, ((k_osc | 0) + 1) & 3); u_click = 0; );
gfx_set(0.07, 0.07, 0.08, 1); gfx_circle(px(440), py(268), 14 * uscale, 1, 1);
gfx_set(0.20, 0.20, 0.22, 1); gfx_circle(px(440), py(268), 10 * uscale, 1, 1);
gfx_set(1, 1, 1, 0.30); gfx_circle(px(437), py(265), 3 * uscale, 1, 1);
gos = k_osc | 0;
led(px(440), py(240), gos >= 2 ? 0.98 : 0.10, (gos > 0 && gos <= 2) ? 0.85 : 0.10, 0.12, gos > 0);
label_pill("INT. OSC", px(516), py(258), 3, 0);
gfx_set(0.36, 0.37, 0.40, 1);
ctext(gos == 0 ? "off" : gos == 1 ? "sine / saw" : gos == 2 ? "triangle / pulse" : "saw / noise", px(516), py(278), 12, 0);

dark_btn(6, px(620), py(250), 90 * uscale, 26 * uscale, "EASTER EGG", k_egg >= 0.5, 12) ? ( set_slider(6, k_egg >= 0.5 ? 0 : 1); u_click = 0; );

gfx_set(0.37, 0.40, 0.46, 1);
gfx_rect(px(420), py(298), 420 * uscale, 42 * uscale, 1);
gfx_set(1, 1, 1, 1);
k_egg >= 0.5 ? (
  ltext(k_osc >= 0.5 ? "FREQUENCY SHIFTER" : "PHASE SHIFTER", px(434), py(310), 15, 'b');
) : (
  gza = floor(min(8, p_alg * 8));
  sprintf(#galg, "%s", alg_label(gza));
  ltext(#galg, px(434), py(310), 15, 'b');
  gza < 8 ? ( sprintf(#galg2, ">  %s", alg_label(gza + 1)); gfx_set(1, 1, 1, 0.6); ltext(#galg2, px(560), py(310), 15, 'b'); );
);

gfx_set(0.62, 0.63, 0.65, 1);
gfx_rect(px(20), py(350), (UDW - 40) * uscale, max(1, uscale), 1);
gfx_set(0.97, 0.97, 0.97, 1);
gfx_rect(px(20), py(351), (UDW - 40) * uscale, max(1, uscale), 1);

cap("INPUTS", px(30), py(366));
seg(7, px(90), py(361), 190 * uscale, 24 * uscale, 2, 0);
cap("OUTPUTS", px(320), py(366));
seg(8, px(392), py(361), 190 * uscale, 24 * uscale, 2, 0);

!tables_ok ? (
  gfx_set(0.10, 0.13, 0.20, 0.92);
  gfx_rect(px(180), py(180), 500 * uscale, 50 * uscale, 1);
  gfx_set(1, 0.8, 0.5, 1);
  ctext("Missing or unreadable Dependencies/WarpFactor/warps_tables.txt", px(430), py(196), 14, 'b');
);

hint_bar(394);
frame_end();
