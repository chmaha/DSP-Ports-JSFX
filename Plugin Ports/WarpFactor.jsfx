function osc_pulse(o, note, mod, out, sz) local(ph, pi, st, ns, lp, hp, ts, mi, t, pold) (
  ph = O_PH[o]; pi = O_PI[o];
  pold = pi;
  st = (midi_inc(note) - pi) / sz;
  ns = O_NS[o]; lp = O_LP[o]; hp = O_HP[o];
  loop(sz,
    ts = ns;
    ns = 0;
    pi += st;
    mi = pi * (1 + mod[0]);
    mod += 1;
    mi <= 0 ? mi = 0.0000001;
    ph += mi;
    ph >= 1 ? (
      ph -= 1;
      t = ph / mi;
      ts -= 0.5 * t * t;
      t = 1 - t;
      ns -= -0.5 * t * t;
