      ph -= 1;
      t = ph / mi;
      ts -= 0.5 * t * t;
      t = 1 - t;
      ns -= -0.5 * t * t;
      hi = 0;
    );
    c = mi * 0.0625;
    ns += ph < 0.5 ? 0 : 1;
