// ---------------------------------------------------------------------- amplifiers, quadrature, modulator
A_LEVEL = alloc(2); A_DRIVE = alloc(2); A_POST = alloc(2); A_PRE = alloc(2);
Q_X = alloc(34); Q_Y = alloc(34); Q_C = alloc(34);

function amp_proc(ch, drive, limit, in, out, raw, sz) local(lv, d, di, i, s, e, d2, ga, gb, g, squ, pg, prev, prei, postv, posti, pr, po) (
  d = A_DRIVE[ch];
  di = (drive - d) / sz;
  lv = A_LEVEL[ch];
  i = 0;
  loop(sz,
    s = in[i] / 32768;
    e = s * s - lv;
    lv += e * (e > 0 ? 0.1 : 0.0001);
    s *= lv <= 0.0001 ? (1 / 0.0001) * lv : 1;
