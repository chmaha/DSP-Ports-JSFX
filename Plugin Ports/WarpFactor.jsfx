function qo_render(shape, freq, iout, qout, sz) local(nf, fi, si, ph, comp, a, b, t0, t1, srv, sf, v, dp) (
  nf = max(-0.25, min(0.25, freq * (1 / SR)));
  fi = (nf - qo_f) / sz;
  si = (shape - qo_s) / sz;
  ph = qo_p;
  loop(sz,
    qo_f += fi;
    ph += qo_f;
    ph <= 0 ? ph += 1 : ph >= 1 ? ph -= 1;
    qo_s += si;
    srv = qo_s * 1.9999;
    v = srv | 0;
    sf = srv - v;
    comp = 0;
    loop(2,
      t0 = TOFF[T_W0 + 2 * v + comp];
      t1 = TOFF[T_W0 + 2 * v + 2 + comp];
      a = interp(t0, ph, 1024);
      b = interp(t1, ph, 1024);
      dp = comp === 0 ? iout : qout;
      dp[0] = a + (b - a) * sf;
      comp += 1;
