function xmod(alg, x1, x2, par) local(r, s, fi, fo, a, b, m) (
  alg === 0 ? (
    fi = interp(T_XIN, par, 256);
    fo = interp(T_XOUT, par, 256);
    x1 * fi + x2 * fo;
  ) : alg === 1 ? (
    s = 0;
    s += x1;
    s += x2;
    s += (x1 * x2) * 0.25;
    s *= 0.02 + par;
    interp(T_FOLD + 2048, s, KFOLD);
