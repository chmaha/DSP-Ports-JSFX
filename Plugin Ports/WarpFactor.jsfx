  fv = pv_d0; fvi = (p_d0 - fv) / BS;
  dv = pv_d1; dvi = (p_d1 - dv) / BS;
  i = 0;
  loop(BS,
    sm += smi;
    tm = sm;
    inp = INR[i] / 32768;
    p_shape ? inp += INL[i] / 32768;
    mo = inp;
    fv += fvi;
    am = fv;
    am *= 2 - am;
    am *= 2 - am;
