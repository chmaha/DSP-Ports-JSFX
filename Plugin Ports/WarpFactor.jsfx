  zu3_2_1 = H_U3[25];
  zu3_2_2 = H_U3[26];
  zu3_2_3 = H_U3[27];
  zu3_2_4 = H_U3[28];
  zu3_2_5 = H_U3[29];
  zu3_2_6 = H_U3[30];
  zu3_2_7 = H_U3[31];
  zu3_2_8 = H_U3[32];
  zu3_2_9 = H_U3[33];
  zu3_2_10 = H_U3[34];
  zu3_2_11 = H_U3[35];
);
// ---------------------------------------------------------------------- filter bank and vocoder
NB = 20;
B_GROUP = alloc(21); B_DEC = alloc(20); B_DELAY = alloc(20); B_POST = alloc(20); B_F = alloc(40); B_FQ = alloc(40);
B_OFS = alloc(20); B_DLO = alloc(20); B_DLS = alloc(20);
FB_T0 = alloc(2); FB_T1 = alloc(2); FB_SMP = alloc(2); FB_SVF = alloc(2); FB_MD = alloc(2); FB_MDP = alloc(2);
FB_LD = alloc(2); FB_LDP = alloc(2); FB_MU = alloc(2); FB_LU = alloc(2); FB_DL = alloc(2); FB_HEAD = alloc(2);

function fb_alloc(b) (
  FB_T0[b] = alloc(96); FB_T1[b] = alloc(96); FB_SMP[b] = alloc(960); FB_SVF[b] = alloc(240);
  FB_MD[b] = alloc(72); FB_LD[b] = alloc(96); FB_MU[b] = alloc(12); FB_LU[b] = alloc(12);
  FB_DL[b] = alloc(6144); FB_HEAD[b] = alloc(20);
);
fb_alloc(0); fb_alloc(1);

function fb_init() local(i, b, dec, grp, ofs, mx, co, c, comp) (
  mx = 0; ofs = 0; grp = -1; dec = -1;
  i = 0;
  loop(NB,
    co = T_FB + i * 7;
    B_DEC[i] = co[0] | 0;
    B_DEC[i] != dec ? ( dec = B_DEC[i]; grp += 1; );
    B_GROUP[i] = grp;
    B_OFS[i] = ofs;
    ofs += floor(96 / B_DEC[i]);
    B_DELAY[i] = (co[1] | 0) * B_DEC[i];
    B_POST[i] = co[2];
    B_F[i * 2] = co[3]; B_FQ[i * 2] = co[4];
    B_F[i * 2 + 1] = co[5]; B_FQ[i * 2 + 1] = co[6];
    mx = max(mx, B_DELAY[i]);
    i += 1;
  );
  B_GROUP[NB] = B_GROUP[NB - 1] + 1;
  mx = min(mx, 256);
  ofs = 0;
  i = 0;
  loop(NB,
    comp = mx - B_DELAY[i];
    B_GROUP[i] === 0 ? (
      comp -= 4 * (24 + 6);
      comp -= 18;
      comp -= 6;
    ) : B_GROUP[i] === 1 ? (
      comp -= 18;
      comp -= 6;
    );
    comp = max(comp - floor(B_DEC[i] / 2), 0);
    c = floor(comp / B_DEC[i]);
    B_DLO[i] = ofs;
    B_DLS[i] = c + 1;
    ofs += c + 1;
    i += 1;
  );
  b = 0;
  loop(2,
    memset(FB_SVF[b], 0, 240);
    memset(FB_MD[b], 0, 72); memset(FB_LD[b], 0, 96);
    memset(FB_MU[b], 0, 12); memset(FB_LU[b], 0, 12);
    memset(FB_DL[b], 0, 6144); memset(FB_HEAD[b], 0, 20);
    FB_MDP[b] = 35; FB_LDP[b] = 47;
    b += 1;
  );
);

function sv_lp(st, in, out, n, f, fq) local(lp1, bp1, lp2, bp2, v, y) (
  lp1 = st[0]; bp1 = st[1]; lp2 = st[2]; bp2 = st[3];
  loop(n,
    v = in[0]; in += 1;
    lp1 += f * bp1;
    bp1 += ((-fq * bp1) - (f * lp1)) + v;
    y = lp1 * f;
    lp2 += f * bp2;
    bp2 += ((-fq * bp2) - (f * lp2)) + y;
    out[0] = lp2 * f; out += 1;
  );
  st[0] = lp1; st[1] = bp1; st[2] = lp2; st[3] = bp2;
);

function sv_bp(st, in, out, n, f, fq) local(lp1, bp1, lp2, bp2, x1, x2, v, y) (
  lp1 = st[0]; bp1 = st[1]; lp2 = st[2]; bp2 = st[3]; x1 = st[4]; x2 = st[5];
  loop(n,
    v = in[0]; in += 1;
    lp1 += f * bp1;
    bp1 += ((-fq * bp1) - (f * lp1)) + v;
    bp1 += x1;
    x1 = v;
    y = bp1 * fq;
    lp2 += f * bp2;
    bp2 += ((-fq * bp2) - (f * lp2)) + y;
    bp2 += x2;
    x2 = y;
    out[0] = bp2 * fq; out += 1;
  );
  st[0] = lp1; st[1] = bp1; st[2] = lp2; st[3] = bp2; st[4] = x1; st[5] = x2;
);

function sv_hp(st, in, out, n, f, fq) local(lp1, bp1, lp2, bp2, x1, x2, v, y) (
  lp1 = st[0]; bp1 = st[1]; lp2 = st[2]; bp2 = st[3]; x1 = st[4]; x2 = st[5];
  loop(n,
    v = in[0]; in += 1;
    lp1 += f * bp1;
    bp1 += ((-fq * bp1) - (f * lp1)) + v;
    x1 = v;
    y = (x1 - (lp1 * f)) - (bp1 * fq);
    lp2 += f * bp2;
    bp2 += ((-fq * bp2) - (f * lp2)) + y;
    x2 = y;
    out[0] = (x2 - (lp2 * f)) - (bp2 * fq); out += 1;
  );
  st[0] = lp1; st[1] = bp1; st[2] = lp2; st[3] = bp2; st[4] = x1; st[5] = x2;
);

function fb_analyze(b, in, sz) local(i, pass, bsz, src, dst, st, t0, t1, g, k) (
  t0 = FB_T0[b]; t1 = FB_T1[b];
  dn3(FB_MD[b], FB_MDP + b, in, t0, sz);
  dn4(FB_LD[b], FB_LDP + b, t0, t1, floor(sz / 3));
  i = 0;
  loop(NB,
    bsz = floor(sz / B_DEC[i]);
    dst = FB_SMP[b] + B_OFS[i];
    pass = 0;
    loop(2,
      src = pass === 0 ? (B_GROUP[i] === 0 ? t1 : B_GROUP[i] === 1 ? t0 : in) : dst;
      st = FB_SVF[b] + (i * 2 + pass) * 6;
      i === 0 ? sv_lp(st, src, dst, bsz, B_F[i * 2 + pass], B_FQ[i * 2 + pass]) :
      i === NB - 1 ? sv_hp(st, src, dst, bsz, B_F[i * 2 + pass], B_FQ[i * 2 + pass]) :
      sv_bp(st, src, dst, bsz, B_F[i * 2 + pass], B_FQ[i * 2 + pass]);
      pass += 1;
    );
    g = B_POST[i];
    k = 0;
    loop(bsz, dst[k] *= g; k += 1;);
    i += 1;
  );
);

function fb_synth(b, out, sz) local(i, bsz, s, smp, dl, hd, dsz, j, t0, t1, gh, k) (
  t0 = FB_T0[b]; t1 = FB_T1[b];
  memset(t1, 0, floor(sz / B_DEC[0]));
  i = 0;
  loop(NB,
    bsz = floor(sz / B_DEC[i]);
    s = B_GROUP[i] === 0 ? t1 : B_GROUP[i] === 1 ? t0 : out;
    smp = FB_SMP[b] + B_OFS[i];
    dl = FB_DL[b] + B_DLO[i];
    dsz = B_DLS[i];
    gh = FB_HEAD[b];
    hd = gh[i];
    j = 0;
    loop(bsz,
      dl[hd] = smp[j];
      hd = (hd + 1) % dsz;
      s[j] += dl[hd];
      j += 1;
    );
    gh[i] = hd;
    B_GROUP[i + 1] !== B_GROUP[i] ? (
      B_GROUP[i] === 0 ? (
        uf4(FB_LU[b], t1, t0, bsz);
      ) : B_GROUP[i] === 1 ? (
        uf3(FB_MU[b], t0, out, bsz);
      );
    );
    i += 1;
  );
);

V_ENV = alloc(20); V_ATK = alloc(20); V_DEC = alloc(20); V_PEAK = alloc(20); V_FRZ = alloc(20);
V_GC = alloc(20); V_GV = alloc(20); V_PGC = alloc(20); V_PGV = alloc(20);

function voc_init() local(i) (
  fb_init();
  lim_peak = 0.5;
  voc_rel = 0.5; voc_fs = 0.5;
  memset(V_GC, 0, 20); memset(V_GV, 0, 20); memset(V_PGC, 0, 20); memset(V_PGV, 0, 20);
  i = 0;
  loop(20, V_ENV[i] = 0; V_FRZ[i] = 0; V_ATK[i] = 0.1; V_DEC[i] = 0.1; V_PEAK[i] = 0; i += 1;);
);

function foll_proc(i, in, out, n) local(env, atk, dec, pk, e, gf) (
  env = V_ENV[i];
  atk = V_FRZ[i] ? 0 : V_ATK[i];
  dec = V_FRZ[i] ? 0 : V_DEC[i];
  pk = 0;
  gf = FOLLOW_G;
  loop(n,
    e = abs(in[0] * gf) - env;
    in += 1;
    env += (e > 0 ? atk : dec) * e;
    env > pk ? pk = env;
    out[0] = env;
    out += 1;
  );
  V_ENV[i] = env;
  e = pk - V_PEAK[i];
  V_PEAK[i] += (e > 0 ? 0.5 : 0.1) * e;
);
FOLLOW_G = sqrt(20);

function voc_proc(modu, carr, out, sz) local(f, i, dec, fsa, einc, env, sb, si, sf, a, b, bg, att, kl, bsz, step, cp, mp, ep, vg, vi, cg, ci, j, s) (
  fb_analyze(0, modu, sz);
  fb_analyze(1, carr, sz);
  f = 80 * semi(-72 * voc_rel);
  i = 0;
  loop(NB,
    dec = f / (SR / B_DEC[i]);
    V_ATK[i] = dec * 2;
    V_DEC[i] = dec * 0.5;
    V_FRZ[i] = voc_rel > 0.995;
    f *= 1.2599;
    i += 1;
  );
  fsa = 2 * abs(voc_fs - 0.5);
  fsa *= 2 - fsa;
  fsa *= 2 - fsa;
  einc = 4 * semi(-48 * voc_fs);
  env = 0;
  kl = NB - 1.0001;
  i = 0;
  loop(NB,
    sb = max(0, min(kl, env));
    si = sb | 0;
    sf = sb - si;
    a = V_PEAK[si];
    b = V_PEAK[si + 1];
    bg = a + (b - a) * sf;
    att = env - kl;
    att >= 0 ? bg *= 1 / (1 + 1 * att);
    env += einc;
    V_GC[i] = bg * fsa;
    V_GV[i] = 1 - fsa;
    i += 1;
  );
  i = 0;
  loop(NB,
    bsz = floor(sz / B_DEC[i]);
    step = 1 / bsz;
    cp = FB_SMP[1] + B_OFS[i];
    mp = FB_SMP[0] + B_OFS[i];
    ep = ENVT;
    foll_proc(i, mp, ep, bsz);
    vg = V_PGV[i];
    vi = (V_GV[i] - vg) * step;
    cg = V_PGC[i];
    ci = (V_GC[i] - cg) * step;
    j = 0;
    loop(bsz,
      cp[j] *= cg + vg * ep[j];
      vg += vi;
      cg += ci;
      j += 1;
    );
    V_PGC[i] = V_GC[i];
    V_PGV[i] = V_GV[i];
    i += 1;
  );
  fb_synth(1, out, sz);
  i = 0;
  loop(sz,
    s = out[i] * 1.4;
