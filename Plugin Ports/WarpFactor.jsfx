KFOLD = 2048 / ((1 + 1 + 0.25) * 1.02);

function skew_par(al, par) local(sk) (
  sk = 0;
  al <= 1 ? sk = al : al >= 5 ? sk = 1 : al >= 4 ? sk = 5 - al;
  par * (1 + sk * (par - 1));
