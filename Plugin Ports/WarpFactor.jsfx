desc: Warp Factor Meta-Modulator (Mutable Instruments Warps port) by chmaha
tags: effect modulation ring-modulator vocoder crossmod frequency-shifter
author: chmaha
version: 1.0
changelog:
  Initial release.
about:
  A port of Mutable Instruments Warps, the meta-modulator: two signals go in and one comes out, combined through
  a continuously morphing set of algorithms. Algorithm sweeps from crossfade through wavefolding, analog and
  digital ring modulation, XOR and comparator to a 20-band vocoder with release and freeze. Timbre changes the
  character of the current algorithm, and in the vocoder it shifts the formants.
  Input 1 (carrier) comes from channels 1+2 and input 2 (modulator) from channels 3+4; the Input selector can use
  L/R instead. Send a second track into channels 3/4 for sidechained modulation. INT OSC replaces input 1 with
  the internal oscillator (sine, triangle or saw; saw, pulse or noise in the vocoder), and Level 1 then sets its
  pitch, or play it from MIDI. The Easter egg turns the module into a frequency shifter.
  Levels and timbres are the module's own, so very hot signals saturate as they would on the real thing.
  Needs Dependencies/WarpFactor/warps_tables.txt.
  Ported from Warps by Emilie Gillet (Mutable Instruments)
  https://github.com/pichenettes/eurorack (MIT)
  JSFX version released under GPLv3+ license
  Claude generated some of this code
provides:
  Dependencies/WarpFactor/warps_tables.txt

slider1:k_l1=0.5<0,1,0.001>-Level 1
slider2:k_l2=0.5<0,1,0.001>-Level 2
slider3:k_alg=0<0,1,0.001>-Algorithm
slider4:k_tim=0.5<0,1,0.001>-Timbre
slider5:k_osc=0<0,3,1{Off,Sine,Triangle,Saw}>-Int Osc
slider6:k_egg=0<0,1,1{Off,On}>-Easter Egg
slider7:k_route=0<0,1,1{Inputs 1+2 and 3+4,L and R}>-Inputs
slider8:k_outm=0<0,1,1{Main,Main L Aux R}>-Outputs

in_pin:Input 1 L
in_pin:Input 1 R
in_pin:Input 2 L
in_pin:Input 2 R
out_pin:Main L
out_pin:Main R

options:no_meter

@init
ext_noinit = gfx_ext_retina = 1;

SR = 96000;
BS = 60;

function alloc(n) local(r) instance(mp) global() ( r = mp; mp += n; memset(r, 0, n); r; );
alloc.mp = 0;

TRAW = alloc(18000);
TBL = alloc(18000);
TOFF = alloc(32);
TLEN = alloc(32);
tables_ok = 0;

function tables_load() local(h, n, nt, i, p, q, len) (
  h = file_open("WarpFactor/warps_tables.txt");
  h < 0 ? h = file_open("Dependencies/WarpFactor/warps_tables.txt");
  h >= 0 ? (
    n = file_mem(h, TRAW, 18000);
    file_close(h);
    nt = TRAW[0];
    (n > 100 && nt == 23) ? (
      q = 1;
      p = 0;
      i = 0;
      loop(nt,
        len = TRAW[q];
        TOFF[i] = TBL + p;
        TLEN[i] = len;
        memcpy(TBL + p, TRAW + q + 1, len);
        p += len;
        q += len + 1;
        i += 1;
      );
      tables_ok = q == n;
    );
  );
);
tables_load();
T_PRH = TOFF[0]; T_PRL = TOFF[1]; T_FB = TOFF[2]; T_SIN = TOFF[3]; T_XIN = TOFF[4]; T_XOUT = TOFF[5];
T_FOLD = TOFF[6]; T_MH = TOFF[7]; T_ML = TOFF[8]; T_POT = TOFF[9]; T_POLES = TOFF[10];
T_W0 = 11;
T_U6 = TOFF[17]; T_D6 = TOFF[18]; T_U4 = TOFF[19]; T_D4 = TOFF[20]; T_U3 = TOFF[21]; T_D3 = TOFF[22];

INL = alloc(BS); INR = alloc(BS); OUTL = alloc(BS); OUTR = alloc(BS);
BUF0 = alloc(96); BUF1 = alloc(96); BUF2 = alloc(96); INTM = alloc(96);
SRC0 = alloc(576); SRC1 = alloc(576);
ENVT = alloc(96);

function semi(x) local(p, i) (
  p = x + 128;
  i = p | 0;
  T_PRH[i] * T_PRL[((p - i) * 256) | 0];
);

function interp(t, index, size) local(x, i, a) (
  x = index * size;
  i = x | 0;
  a = t[i];
  a + (t[i + 1] - a) * (x - i);
);

function slimit(x) ( (x * (27 + x * x)) / (27 + 9 * x * x); );
function sclip(x) ( x < -3 ? -1 : x > 3 ? 1 : (x * (27 + x * x)) / (27 + 9 * x * x); );

// ---------------------------------------------------------------------- sample rate converters
H_U6 = alloc(48); H_D6 = alloc(48); H_U4 = alloc(48); H_D4 = alloc(48); H_U3 = alloc(36); H_D3 = alloc(36);

function src_up_make(hfull, h, ka, ln) local(n, r, i, idx) (
  n = ln / ka;
  r = 0;
  loop(ka,
    i = 0;
    loop(n,
      idx = r + i * ka;
      hfull[r * n + i] = h[idx >= ln / 2 ? ln - 1 - idx : idx];
      i += 1;
    );
    r += 1;
  );
);
function src_dn_make(hfull, h, ln) local(i) (
  i = 0;
  loop(ln, hfull[i] = h[i >= ln / 2 ? ln - 1 - i : i]; i += 1;);
);
tables_ok ? (
  src_up_make(H_U6, T_U6, 6, 48); src_dn_make(H_D6, T_D6, 48);
  src_up_make(H_U4, T_U4, 4, 48); src_dn_make(H_D4, T_D4, 48);
  src_up_make(H_U3, T_U3, 3, 36); src_dn_make(H_D3, T_D3, 36);
);

function src_up(st, hfull, n, ka, in, out, sz) local(r, s, j, h) (
  loop(sz,
    memcpy(st + 1, st, n - 1);
    st[0] = in[0];
    in += 1;
    r = 0;
    loop(ka,
      s = 0;
      j = n - 1;
      h = hfull + r * n + n - 1;
      loop(n, s = st[j] * h[0] + s; j -= 1; h -= 1;);
      out[0] = s;
      out += 1;
      r += 1;
    );
  );
);

function src_dn(st, pid, hf, n, ka, in, out, sz) local(s, j, p, b) (
  while (sz > 0) (
    loop(ka,
      p = pid[0];
      st[p] = in[0];
      st[p + n] = in[0];
      in += 1;
      p -= 1;
      p < 0 ? p += n;
      pid[0] = p;
    );
    sz -= ka;
    s = 0;
    j = n - 1;
    b = st + pid[0] + 1;
    loop(n, s = b[j] * hf[j] + s; j -= 1;);
    out[0] = s;
    out += 1;
  );
);

function su_load() (
  hu00 = H_U6[0];
