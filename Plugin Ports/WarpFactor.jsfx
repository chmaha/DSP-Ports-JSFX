  lv = O_EXT[o];
  i = 0;
  loop(sz,
    x = mod[i];
    e = x * x - lv;
    lv += (e > 0 ? 0.01 : 0.0001) * e;
    ig = 1 - 32 * lv;
    ig <= 0 ? ig = 0;
    out[i] = x + ig * (out[i] - x);
    i += 1;
