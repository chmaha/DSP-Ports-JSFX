);

function osc_tri(o, note, mod, out, sz) local(ph, pi, st, ns, hi, lp, ts, mi, t, c) (
  ph = O_PH[o]; pi = O_PI[o];
  st = (midi_inc(note) - pi) / sz;
  ns = O_NS[o]; hi = O_HI[o]; lp = O_LP[o];
  loop(sz,
    ts = ns;
    ns = 0;
    pi += st;
    mi = pi * (1 + mod[0]);
    mod += 1;
    mi <= 0 ? mi = 0.0000001;
    ph += mi;
