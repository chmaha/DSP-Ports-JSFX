    s = b[25] * zd625 + s;
    s = b[24] * zd624 + s;
    s = b[23] * zd623 + s;
    s = b[22] * zd622 + s;
    s = b[21] * zd621 + s;
    s = b[20] * zd620 + s;
    s = b[19] * zd619 + s;
    s = b[18] * zd618 + s;
    s = b[17] * zd617 + s;
    s = b[16] * zd616 + s;
    s = b[15] * zd615 + s;
    s = b[14] * zd614 + s;
    s = b[13] * zd613 + s;
    s = b[12] * zd612 + s;
    s = b[11] * zd611 + s;
    s = b[10] * zd610 + s;
    s = b[9] * zd69 + s;
    s = b[8] * zd68 + s;
    s = b[7] * zd67 + s;
    s = b[6] * zd66 + s;
    s = b[5] * zd65 + s;
    s = b[4] * zd64 + s;
    s = b[3] * zd63 + s;
    s = b[2] * zd62 + s;
    s = b[1] * zd61 + s;
    s = b[0] * zd60 + s;
    out[0] = s;
    out += 1;
  );
);
function dn4(st, pid, in, out, sz) local(s, p, b) (
  while (sz > 0) (
    loop(4,
      p = pid[0];
      st[p] = in[0];
      st[p + 48] = in[0];
      in += 1;
      p -= 1;
