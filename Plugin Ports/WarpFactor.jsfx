  zd646 = H_D6[46]; zd446 = H_D4[46];
  zd647 = H_D6[47]; zd447 = H_D4[47];
  zd30 = H_D3[0];
  zd31 = H_D3[1];
  zd32 = H_D3[2];
  zd33 = H_D3[3];
  zd34 = H_D3[4];
  zd35 = H_D3[5];
