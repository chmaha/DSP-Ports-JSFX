function qt_init() local(k, i) (
  k = 0;
  loop(2,
    i = 0;
    loop(17, Q_X[k * 17 + i] = 0; Q_Y[k * 17 + i] = 0; Q_C[k * 17 + i] = -T_POLES[i]; i += 1;);
    k += 1;
  );
  q_i = q_q = 0;
);

function qt_sample(k, in) local(i, base, src, y, c) (
  base = k * 17;
  i = 0;
  loop(17,
    src = i <= 1 ? in : ((i & 1) ? q_q : q_i);
    c = Q_C[base + i];
    y = c * (src - Q_Y[base + i]) + Q_X[base + i];
    Q_X[base + i] = src;
    Q_Y[base + i] = y;
    (i & 1) ? q_q = y : q_i = y;
    i += 1;
