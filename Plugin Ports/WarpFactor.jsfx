function clip16i(x) local(i) (
  i = x | 0;
  i < -32768 ? -32768 : i > 32767 ? 32767 : i;
);

function x_comp(mo, ca, par) local(x, xi, xf, d, w, w2, th, a, b) (
  x = par * 2.995;
  xi = x | 0;
  xf = x - xi;
  d = mo < ca ? mo : ca;
  w = abs(mo) > abs(ca) ? mo : ca;
  w2 = abs(mo) > abs(ca) ? abs(mo) : -abs(ca);
  th = ca > 0.05 ? ca : mo;
  xi === 0 ? ( a = d; b = th; ) : xi === 1 ? ( a = th; b = w; ) : ( a = w; b = w2; );
