    s = x5 * zu4_3_5 + s;
    s = x4 * zu4_3_4 + s;
    s = x3 * zu4_3_3 + s;
    s = x2 * zu4_3_2 + s;
    s = x1 * zu4_3_1 + s;
    s = x0 * zu4_3_0 + s;
    out[0] = s;
    out += 1;
  );
  st[0] = x0; st[1] = x1; st[2] = x2; st[3] = x3; st[4] = x4; st[5] = x5; st[6] = x6; st[7] = x7; st[8] = x8; st[9] = x9; st[10] = x10; st[11] = x11;
);
function uf3(st, in, out, sz) local(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, r, s) (
  x0 = st[0]; x1 = st[1]; x2 = st[2]; x3 = st[3]; x4 = st[4]; x5 = st[5]; x6 = st[6]; x7 = st[7]; x8 = st[8]; x9 = st[9]; x10 = st[10]; x11 = st[11];
  loop(sz,
    x11 = x10; x10 = x9; x9 = x8; x8 = x7; x7 = x6; x6 = x5; x5 = x4; x4 = x3; x3 = x2; x2 = x1; x1 = x0; x0 = in[0];
    in += 1;
    s = 0;
    s = x11 * zu3_0_11 + s;
    s = x10 * zu3_0_10 + s;
    s = x9 * zu3_0_9 + s;
    s = x8 * zu3_0_8 + s;
    s = x7 * zu3_0_7 + s;
    s = x6 * zu3_0_6 + s;
    s = x5 * zu3_0_5 + s;
    s = x4 * zu3_0_4 + s;
    s = x3 * zu3_0_3 + s;
    s = x2 * zu3_0_2 + s;
    s = x1 * zu3_0_1 + s;
    s = x0 * zu3_0_0 + s;
    out[0] = s;
    out += 1;
    s = 0;
    s = x11 * zu3_1_11 + s;
    s = x10 * zu3_1_10 + s;
    s = x9 * zu3_1_9 + s;
    s = x8 * zu3_1_8 + s;
    s = x7 * zu3_1_7 + s;
    s = x6 * zu3_1_6 + s;
    s = x5 * zu3_1_5 + s;
    s = x4 * zu3_1_4 + s;
    s = x3 * zu3_1_3 + s;
    s = x2 * zu3_1_2 + s;
    s = x1 * zu3_1_1 + s;
    s = x0 * zu3_1_0 + s;
    out[0] = s;
    out += 1;
    s = 0;
    s = x11 * zu3_2_11 + s;
    s = x10 * zu3_2_10 + s;
    s = x9 * zu3_2_9 + s;
    s = x8 * zu3_2_8 + s;
    s = x7 * zu3_2_7 + s;
    s = x6 * zu3_2_6 + s;
    s = x5 * zu3_2_5 + s;
    s = x4 * zu3_2_4 + s;
    s = x3 * zu3_2_3 + s;
    s = x2 * zu3_2_2 + s;
    s = x1 * zu3_2_1 + s;
    s = x0 * zu3_2_0 + s;
    out[0] = s;
    out += 1;
  );
  st[0] = x0; st[1] = x1; st[2] = x2; st[3] = x3; st[4] = x4; st[5] = x5; st[6] = x6; st[7] = x7; st[8] = x8; st[9] = x9; st[10] = x10; st[11] = x11;
);
function su2_load() (
  zd60 = H_D6[0]; zd40 = H_D4[0];
  zd61 = H_D6[1]; zd41 = H_D4[1];
  zd62 = H_D6[2]; zd42 = H_D4[2];
