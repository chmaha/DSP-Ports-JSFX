function mono_note_on(n, v)
(
  SUSN[n] = 0;
  queue_note_on = n;
  queue_note_on_and_off = 0;
  last_key = n;
  queue_vel = (v / (127));
  ks_push(n);
);

function mono_note_off(n)
(
  pedal ? SUSN[n] = 1 : (
    ks_pop(n);
    n == queue_note_on ? queue_note_on_and_off = 1 :
    n == last_key ? end_note();
  );
);

function mono_pedal_up() local(i, hq, hl)
(
  hq = hl = 0;
  i = 0;
  loop(128,
    SUSN[i] ? (
      SUSN[i] = 0;
      ks_pop(i);
      i == queue_note_on ? hq = 1 : i == last_key ? hl = 1;
    );
    i += 1;
  );
  hq ? queue_note_on_and_off = 1 : hl ? end_note();
);

function voice_release()
(
  queue_note_on != -1 ? queue_note_on_and_off = 1 : (
    gate = 0;
    env1.adsr_note_off(); env2.adsr_note_off();
  );
);

function poly_note_on(n, v) local(k, best, ba, rel)
(
  best = -1;
  k = 0; loop(8, (best < 0 && VNOTE[k] == n && VHELD[k] >= 0) ? best = k; k += 1; );
  best < 0 ? (
    k = 0; loop(8, (best < 0 && VHELD[k] < 0) ? best = k; k += 1; );
  );
  best < 0 ? (
    ba = 1000000000; rel = 0;
    k = 0; loop(8, (VHELD[k] == 0 && VAGE[k] < ba) ? ( ba = VAGE[k]; best = k; rel = 1; ); k += 1; );
    !rel ? ( k = 0; loop(8, VAGE[k] < ba ? ( ba = VAGE[k]; best = k; ); k += 1; ); );
  );
  v_load(best);
  queue_note_on = n;
  queue_note_on_and_off = 0;
  last_key = n;
  queue_vel = (v / (127));
  v_save(best);
  agec += 1;
  VNOTE[best] = n; VAGE[best] = agec; VSUS[best] = 0; VHELD[best] = 1;
  ks_push(n);
);

function poly_note_off(n) local(k)
(
  ks_pop(n);
  k = 0;
  loop(8,
    (VNOTE[k] == n && VHELD[k] == 1) ? (
      pedal ? VSUS[k] = 1 : ( v_load(k); voice_release(); v_save(k); VHELD[k] = 0; );
    );
    k += 1;
  );
);

function poly_pedal_up() local(k)
(
  k = 0;
  loop(8,
    VSUS[k] ? ( VSUS[k] = 0; VHELD[k] == 1 ? ( v_load(k); voice_release(); v_save(k); VHELD[k] = 0; ); );
    k += 1;
  );
);

function poly_all_off(force) local(k)
(
  k = 0;
  loop(8,
    v_load(k);
    force ? force_fadeout = 1;
    gate = 0; queue_note_on = -1;
    env1.adsr_note_off(); env2.adsr_note_off();
    v_save(k);
    VSUS[k] = 0; VHELD[k] >= 0 ? VHELD[k] = 0;
    k += 1;
  );
);

function ms_note_on(ch, n, v)
( (q_midi < 0.5 || ch + 1 == floor(q_midi + 0.5)) ? ( poly ? poly_note_on(n, v) : mono_note_on(n, v); ); );

function ms_note_off(ch, n)
( (q_midi < 0.5 || ch + 1 == floor(q_midi + 0.5)) ? ( poly ? poly_note_off(n) : mono_note_off(n); ); );

function ms_cc(ch, c, v) local(wasp)
(
  (q_midi < 0.5 || ch + 1 == floor(q_midi + 0.5)) ? (
    c == 1 ? ( modwheel_value_int = (modwheel_value_int & 127) | (v << 7); modwheel_value = (modwheel_value_int / 16383); ) :
    c == 33 ? ( modwheel_value_int = (modwheel_value_int & 16256) | v; modwheel_value = (modwheel_value_int / 16383); ) :
    c == 64 ? (
      wasp = pedal; pedal = v >= 64;
      wasp && !pedal ? ( poly ? poly_pedal_up() : mono_pedal_up(); );
    ) :
    (c == 120 || c == 123) ? (
      pedal = 0; memset(SUSN, 0, 128);
      poly ? ( poly_all_off(c == 120); ks_clear(); ) : (
        c == 120 ? force_fadeout = 1;
        gate = 0;
        queue_note_on = -1;
        env1.adsr_note_off(); env2.adsr_note_off();
        ks_clear();
      );
    );
  );
);

function ms_pressure(ch, v)
( (q_midi < 0.5 || ch + 1 == floor(q_midi + 0.5)) ? ipr.il_set((v * (1 / 127))); );

function ms_bend(ch, v)
( (q_midi < 0.5 || ch + 1 == floor(q_midi + 0.5)) ? ipb.ie_set((2 ^ ((v * q_pbrange) / (1200 * 8192)))); );

function ms_event(m1, m2, m3) local(st, ch)
(
  st = m1 & 0xF0; ch = m1 & 0x0F;
  st == 0x90 && m3 > 0 ? ms_note_on(ch, m2, m3) :
  (st == 0x80 || st == 0x90) ? ms_note_off(ch, m2) :
  st == 0xB0 ? ms_cc(ch, m2, m3) :
  st == 0xD0 ? ms_pressure(ch, m2) :
  st == 0xE0 ? ms_bend(ch, (m2 + 128 * m3) - 8192);
);

function voice_active(k) ( VHELD[k] >= 0; );

function poly_step() local(k, i)
(
  ipb.ie_step();
  g_pr = ipr.il_get();
  icut.ie_set(q_cutoff); g_cut = icut.ie_get();
  glfo1_ph += osc_pd(q_lforate, crate); glfo1_ph >= U32 ? glfo1_ph -= U32;
  glfo2_ph += osc_pd(q_lfo2rate, crate); glfo2_ph >= U32 ? glfo2_ph -= U32;
  memset(MIX1, 0, 64); memset(MIX2, 0, 64); memset(SNDN, 0, 128);
  poly_any = 0;
  k = 0;
  loop(8,
    voice_active(k) ? (
      v_load(k);
      calculate_step();
      ms_running ? (
        poly_any = 1;
        SNDN[last_key] = 1;
        i = 0;
        is_stereo() ? loop(64, MIX1[i] += BUF1[i]; MIX2[i] += BUF2[i]; i += 1; ) :
          loop(64, MIX1[i] += BUF1[i]; MIX2[i] += BUF1[i]; i += 1; );
      ) : queue_note_on == -1 ? VHELD[k] = -1;
      v_save(k);
    );
    k += 1;
  );
);

function poly_render(dl, dr, n) local(pos, len, ip, vol, i)
(
  pos = 0;
  while (pos < n) (
    output_pos == 0 ? poly_step();
    len = min(64 - output_pos, n - pos);
    ip = output_pos;
    poly_any ? (
      i = 0;
      loop(len, vol = mst.il_get(); dl[pos + i] = MIX1[ip + i] * vol; dr[pos + i] = MIX2[ip + i] * vol; i += 1; );
    ) : (
      memset(dl + pos, 0, len); memset(dr + pos, 0, len);
    );
    pos += len;
    output_pos += len;
    output_pos == 64 ? output_pos = 0;
  );
);

function poly_params_changed(all) local(k)
(
  k = 0;
  loop(8,
    (all || voice_active(k)) ? ( v_load(k); params_changed(); v_save(k); );
    k += 1;
  );
);

function set_mode(np) local(k)
(
  np ? (
    VHELD[0] = ms_running || queue_note_on != -1 ? (gate ? 1 : 0) : -1;
    VNOTE[0] = last_key; VSUS[0] = 0; agec += 1; VAGE[0] = agec;
    v_save(0);
    k = 1; loop(7, VHELD[k] = -1; VSUS[k] = 0; k += 1; );
    poly = 1;
  ) : (
    poly = 0;
    k = 1;
    loop(7,
      v_load(k);
      ms_running = 0; stopping = 0; queue_note_on = -1; gate = 0;
      env1.adsr_reset(); env2.adsr_reset();
      v_save(k);
      VHELD[k] = -1;
      k += 1;
    );
    v_load(0);
    legato = floor(q_legato + 0.5);
  );
);

function read_params() local(i, v, ch, b)
(
  ch = 0;
  i = 1;
  loop(103,
    v = slider(i);
    v !== PC[i] ? ( PC[i] = v; PV[i] = (v); ch = 1; );
    i += 1;
  );
  p_changed = ch;
  ch ? (
    q_wave1 = PV[1]; q_wave2 = PV[2]; q_pw1 = PV[3]; q_pw2 = PV[4]; q_detune = PV[5]; q_o2xpose = PV[6];
    q_phasemode = PV[7]; q_mix = PV[8]; q_filter = PV[9]; q_cutoff = PV[10]; q_res = PV[11]; q_sep = PV[12];
    q_e1cut = PV[13]; q_e1res = PV[14]; q_e1amp = PV[15]; q_e1a = PV[16]; q_e1d = PV[17]; q_e1s = PV[18];
    q_e1f = PV[19]; q_e1r = PV[20]; q_keyfollow = PV[21]; q_legato = PV[22]; q_portamento = PV[23];
    q_vel2filter = PV[24]; q_vel2amp = PV[25]; q_master = PV[26]; q_pbrange = PV[27]; q_lforate = PV[28];
    q_lfodelay = PV[29]; q_lfofilter = PV[30]; q_lfopitch = PV[31]; q_lfopw = PV[32]; q_mwhl_lfo = PV[33];
    q_scaledetune = PV[34]; q_e2cut = PV[35]; q_e2res = PV[36]; q_e2amp = PV[37]; q_e2a = PV[38];
    q_e2d = PV[39]; q_e2s = PV[40]; q_e2f = PV[41]; q_e2r = PV[42]; q_stretch1 = PV[43]; q_window1 = PV[44];
    q_lfo1trig = PV[45]; q_lfo2trig = PV[46]; q_lfo2rate = PV[47]; q_lfo2delay = PV[48]; q_unison = PV[49];
    q_unisonfrq = PV[50]; q_o1xpose = PV[51]; q_midi = PV[52]; q_poly = PV[103];
    i = 0;
    loop(10,
      b = MROW + i * 5;
      b[0] = clipv(floor(PV[53 + i * 5] + 0.5), 0, 7);
      b[1] = clipv(floor(PV[54 + i * 5] + 0.5), 0, 7);
      b[2] = clipv(floor(PV[55 + i * 5] + 0.5), 0, 7);
      b[3] = PV[56 + i * 5];
      b[4] = clipv(floor(PV[57 + i * 5] + 0.5), 0, 11);
      i += 1;
    );
  );
);

memset(PC, -1234567, 110);
read_params();
build_waves();
ms_construct();
last_srate = srate;
ms_set_sample_rate();
ms_reset();
poly = 0; pedal = 0; agec = 0; g_last_freq = 0;
k_i = 0; loop(8, v_save(k_i); VHELD[k_i] = -1; VSUS[k_i] = 0; VAGE[k_i] = 0; VNOTE[k_i] = -1; k_i += 1; );
uiq_r = uiq_w = 0;

@slider
last_srate != srate ? (
  last_srate = srate;
  ms_set_sample_rate();
  poly ? set_mode(0);
  ms_reset();
  k_i = 0; loop(8, v_save(k_i); VHELD[k_i] = -1; VSUS[k_i] = 0; k_i += 1; );
);

@block
read_params();
(q_poly >= 0.5) != poly ? set_mode(q_poly >= 0.5);
poly ? poly_params_changed(p_changed) : params_changed();

ev_n = 0;
while (uiq_r != uiq_w) (
  EVQ[ev_n * 4] = 0; EVQ[ev_n * 4 + 1] = UIQ[uiq_r * 3]; EVQ[ev_n * 4 + 2] = UIQ[uiq_r * 3 + 1]; EVQ[ev_n * 4 + 3] = UIQ[uiq_r * 3 + 2];
  ev_n += 1;
  uiq_r = (uiq_r + 1) % 64;
);
while (midirecv(mofs, mm1, mm2, mm3)) (
  ev_n < 1000 ? (
    EVQ[ev_n * 4] = max(0, min(samplesblock - 1, mofs));
    EVQ[ev_n * 4 + 1] = mm1; EVQ[ev_n * 4 + 2] = mm2; EVQ[ev_n * 4 + 3] = mm3;
    ev_n += 1;
  );
);

blk_n = min(samplesblock, 16384);
bpos = 0;
ev_r = 0;
while (bpos < blk_n) (
  while (ev_r < ev_n && EVQ[ev_r * 4] <= bpos) (
    ms_event(EVQ[ev_r * 4 + 1], EVQ[ev_r * 4 + 2], EVQ[ev_r * 4 + 3]);
    ev_r += 1;
  );
  blk_end = ev_r < ev_n ? min(blk_n, EVQ[ev_r * 4]) : blk_n;
  blk_end > bpos ? ( poly ? poly_render(OUTL + bpos, OUTR + bpos, blk_end - bpos) : ms_render(OUTL + bpos, OUTR + bpos, blk_end - bpos); );
  bpos = blk_end;
);
ob_pos = 0;

@sample
spl0 = OUTL[ob_pos];
spl1 = OUTR[ob_pos];
ob_pos += 1;
abs(spl0) > mt_l ? mt_l = abs(spl0);
abs(spl1) > mt_r ? mt_r = abs(spl1);

@gfx 1280 800

gW = 1280; gH = 800;
gsc = max(0.4, min(gfx_w / gW, gfx_h / gH));
gox = floor((gfx_w - gW * gsc) * 0.5);
goy = 0;
gwheel = mouse_wheel; mouse_wheel = 0;
gnow = time_precise();

function automate(s, e)
(
<?
