function gxp(x) ( gox + x * gsc; );
function gyp(y) ( goy + y * gsc; );
function gfont(sz, fl) ( gfx_setfont(1, "Arial", sz * gsc, fl); );
function hexc(h, a) ( gfx_set(((h >> 16) & 255) / 255, ((h >> 8) & 255) / 255, (h & 255) / 255, a); );
function grect(x, y, w, h) ( gfx_rect(gxp(x), gyp(y), w * gsc, h * gsc); );
function inr(x, y, w, h) ( gmx >= x && gmx < x + w && gmy >= y && gmy < y + h; );
function txt_c(cx, y, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = gxp(cx) - tw * 0.5; gfx_y = gyp(y); gfx_drawstr(s); );
function txt_cc(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = gxp(cx) - tw * 0.5; gfx_y = gyp(cy) - th * 0.5; gfx_drawstr(s); );
function txt_l(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = gxp(x); gfx_y = gyp(cy) - th * 0.5; gfx_drawstr(s); );
function txt_r(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = gxp(x) - tw; gfx_y = gyp(cy) - th * 0.5; gfx_drawstr(s); );

function set_sl(s, v) ( slider(s) = v; automate(s, 0); );
function set_sl_done(s, v) ( slider(s) = v; automate(s, 0); automate(s, 1); );


function nm_set(b, n, s0, s1, s2, s3, s4, s5, s6, s7)
(
  GNM[b] = s0; GNM[b + 1] = s1; GNM[b + 2] = s2; GNM[b + 3] = s3;
  GNM[b + 4] = s4; GNM[b + 5] = s5; GNM[b + 6] = s6; GNM[b + 7] = s7;
);

function knob(s, x, y, r, tp, lo, hi, df, lab, fm, bas) local(k)
(
  k = GK + GKN * 12;
  k[0] = s; k[1] = x; k[2] = y; k[3] = r; k[4] = tp; k[5] = lo; k[6] = hi; k[7] = df; k[8] = lab; k[9] = fm; k[10] = bas; k[11] = gpage_def;
  GKN += 1;
);

function kpos(tp, v, lo, hi)
(
  tp == 1 ? log(max(v, lo) / lo) / log(hi / lo) :
  tp == 2 ? sqrt(max(0, (v - lo) / (hi - lo))) :
  tp == 3 ? ((max(0, (v - lo) / (hi - lo))) ^ (1 / 3)) :
  (v - lo) / (hi - lo);
);

function kval(tp, p, lo, hi)
(
  p = max(0, min(1, p));
  tp == 1 ? lo * ((hi / lo) ^ p) :
  tp == 2 ? lo + (hi - lo) * p * p :
  tp == 3 ? lo + (hi - lo) * p * p * p :
  tp == 4 ? floor(lo + (hi - lo) * p + 0.5) :
  lo + (hi - lo) * p;
);

function fmt_val(fm, v)
(
  fm == 1 ? ( v >= 1000 ? sprintf(#gv, "%.2fk", v / 1000) : v >= 100 ? sprintf(#gv, "%.0f", v) : sprintf(#gv, "%.1f", v); ) :
  fm == 2 ? ( v >= 1000 ? sprintf(#gv, "%.2fs", v / 1000) : sprintf(#gv, "%.0fms", v); ) :
  fm == 3 ? sprintf(#gv, "%.0f%%", v * 100) :
  fm == 4 ? sprintf(#gv, "%.0f", v) :
  fm == 5 ? ( v > 0 ? sprintf(#gv, "+%d", v) : sprintf(#gv, "%d", v); ) :
  fm == 6 ? sprintf(#gv, "%.2fs", v) :
  fm == 7 ? sprintf(#gv, "%.2f", v) :
  fm == 8 ? ( v < 1 ? sprintf(#gv, "%.2fHz", v) : sprintf(#gv, "%.1fHz", v); ) :
  fm == 9 ? ( abs(v) >= 1000 ? sprintf(#gv, "%.1fs", v / 1000) : sprintf(#gv, "%.0fms", v); ) :
  fm == 10 ? ( v <= 0.0000001 ? strcpy(#gv, "-inf") : sprintf(#gv, "%.1f", 20 * log10(v)); ) :
  sprintf(#gv, "%.2f", v);
  #gv;
);

function arc_band(cx, cy, r, th, a1, a2) local(k)
(
  k = 0;
  while (k < th) (
    gfx_arc(gxp(cx), gyp(cy), (r - k * 0.5) * gsc, a1, a2, 1);
    k += 0.5;
  );
);

function draw_knob(k) local(s, cx, cy, r, tp, lo, hi, v, p, pb, a0, av, ab, th, px1, py1, px2, py2)
(
  s = k[0]; cx = k[1]; cy = k[2]; r = k[3]; tp = k[4]; lo = k[5]; hi = k[6];
  v = slider(s);
  p = max(0, min(1, kpos(tp, v, lo, hi)));
  a0 = -0.75 * $pi;
  av = a0 + p * 1.5 * $pi;
  th = max(3, r * 0.15);
  hexc(0x32353d, 1);
  arc_band(cx, cy, r, th, a0, 0.75 * $pi);
  hexc(0x0066ff, 1);
  k[10] > -1000000 ? (
    pb = max(0, min(1, kpos(tp, k[10], lo, hi)));
    ab = a0 + pb * 1.5 * $pi;
    av > ab ? arc_band(cx, cy, r, th, ab, av) : av < ab ? arc_band(cx, cy, r, th, av, ab);
  ) : (
    p > 0.002 ? arc_band(cx, cy, r, th, a0, av);
  );
  hexc(0xfdfeff, 1);
  px1 = cx + sin(av) * (r - th - 1); py1 = cy - cos(av) * (r - th - 1);
  px2 = cx + sin(av) * (r + 2); py2 = cy - cos(av) * (r + 2);
  gfx_line(gxp(px1), gyp(py1), gxp(px2), gyp(py2), 1);
  gfx_line(gxp(px1) + cos(av), gyp(py1) + sin(av), gxp(px2) + cos(av), gyp(py2) + sin(av), 1);
  gfx_line(gxp(px1) - cos(av), gyp(py1) - sin(av), gxp(px2) - cos(av), gyp(py2) - sin(av), 1);
  gfont(max(12, r * 0.46), 0);
  hexc(0xfdfeff, 1);
  txt_cc(cx, cy, fmt_val(k[9], v));
  gfont(13, 0);
  hexc(0xd8dde2, 1);
  txt_c(cx, cy + r + 4, k[8]);
);

function panel(x, y, w, h, title)
(
  hexc(0x0a0d10, 1); grect(x, y, w, h);
  hexc(0x1a1d22, 1); grect(x, y, w, 30);
  gfont(15, 0); hexc(0x9498a2, 1);
  txt_cc(x + w * 0.5, y + 15, title);
);

function draw_select(x, y, w, h, s)
(
  hexc(inr(x, y, w, h) ? 0x24282e : 0x1a1d22, 1); grect(x, y, w, h);
  gfont(15, 0); hexc(0xfdfeff, 1);
  txt_l(x + 10, y + h * 0.5, s);
  hexc(0xd8dde2, 1);
  gfx_triangle(gxp(x + w - 22), gyp(y + h * 0.5 - 3), gxp(x + w - 10), gyp(y + h * 0.5 - 3), gxp(x + w - 16), gyp(y + h * 0.5 + 4));
);

function menu_pick(b, n, cur) local(i)
(
  strcpy(#gmenu, "");
  i = 0;
  loop(n,
    i == cur ? strcat(#gmenu, "!");
    strcat(#gmenu, GNM[b + i]);
    i < n - 1 ? strcat(#gmenu, "|");
    i += 1;
  );
  gfx_x = mouse_x; gfx_y = mouse_y;
  gfx_showmenu(#gmenu) - 1;
);

function sel_slider(x, y, w, h, s, b, n) local(cur, r)
(
  cur = floor(slider(s) + 0.5);
  draw_select(x, y, w, h, GNM[b + max(0, min(n - 1, cur))]);
  gclick && inr(x, y, w, h) ? (
    r = menu_pick(b, n, cur);
    r >= 0 ? set_sl_done(s, r);
    gclick = 0;
  );
);

function seg(x, y, w, h, s, b, n) local(i, bw, cur, on)
(
  bw = w / n; cur = floor(slider(s) + 0.5);
  i = 0;
  loop(n,
    on = i == cur;
    hexc(on ? 0x0066ff : inr(x + i * bw, y, bw - 2, h) ? 0x24282e : 0x1a1d22, 1);
    grect(x + i * bw, y, bw - 2, h);
    gfont(14, 0); hexc(0xfdfeff, 1);
    txt_cc(x + i * bw + (bw - 2) * 0.5, y + h * 0.5, GNM[b + i]);
    gclick && inr(x + i * bw, y, bw - 2, h) ? ( set_sl_done(s, i); gclick = 0; );
    i += 1;
  );
);

function toggle(x, y, w, h, s, lab) local(on)
(
  on = slider(s) >= 0.5;
  hexc(on ? 0x0066ff : inr(x, y, w, h) ? 0x24282e : 0x1a1d22, 1); grect(x, y, w, h);
  gfont(14, 0); hexc(0xfdfeff, 1);
  txt_cc(x + w * 0.5, y + h * 0.5, lab);
  gclick && inr(x, y, w, h) ? ( set_sl_done(s, on ? 0 : 1); gclick = 0; );
);

function wave_preview(x, y, w, h, osc) local(S, wv, pw, sh, fl, sg, tb, rs, scl, i, n, pos, r, ph, d, xx, yy, lx, ly, st)
(
  hexc(0x000000, 1); grect(x, y, w, h);
  hexc(0x1a1d22, 1); grect(x, y + h * 0.5, w, 1);
  S = 4096;
  wv = max(0, min(15, floor(slider(osc) + 0.5)));
  pw = slider(osc + 2);
  sh = ms_running ? (osc == 1 ? last_pwshift1 : last_pwshift2) : (pw >= 0 ? floor(2013265920 * pw) : -floor(-2013265920 * pw));
  fl = wv == 1;
  sh = (fl ? S / 2 : 0) + floor((sh - floor(sh / U32) * U32) / 1048576);
  sg = fl ? -1 : 1;
  tb = ORIG + (fl ? 0 : wv) * S;
  rs = 1 - slider(44) * 0.5;
  scl = rs < 1 ? 1 / (1 - rs) : 0;
  st = ms_running ? last_stretch1 : 65536 * max(1, min(16, slider(43)));
  n = floor(w);
  hexc(0x0066ff, 1);
  i = 0;
  loop(n,
    pos = floor(i * S / n);
    r = 1;
    osc == 1 ? (
      ph = i / n; ph < 0.5 ? ph = 1 - ph;
      ph = (ph - rs) * scl; ph < 0 ? ph = 0;
      r = 1 - ph * ph;
      pos = floor(pos * st / 65536) % S;
    );
    d = r * (sg * tb[pos] + tb[(pos + sh) & 4095]) / (sg == -1 ? 1 : 2);
    xx = x + i; yy = y + h * 0.5 - d * (h * 0.42);
    i > 0 ? gfx_line(gxp(lx), gyp(ly), gxp(xx), gyp(yy), 1);
    lx = xx; ly = yy;
    i += 1;
  );
);

function gbq_set(t, fc, q) instance(a0, a1, a2, b1, b2) local(om, sn, cs, al, inv)
(
  t == 0 ? ( a0 = 1; a1 = a2 = b1 = b2 = 0; ) : (
    om = ((2 * $pi) * fc) / srate; sn = sin(om); cs = cos(om);
    al = sn / (2 * q); inv = 1 / (1 + al);
    b1 = (-2 * cs) * inv; b2 = (1 - al) * inv;
    t == 1 ? ( a2 = a0 = (inv * (1 - cs)) * 0.5; a1 = a0 + a0; ) :
    t == 2 ? ( a0 = (inv * (1 + cs)) / 2; a1 = -2 * a0; a2 = a0; ) :
    t == 3 ? ( a0 = inv * al; a1 = 0; a2 = (-1 * inv) * al; ) :
    ( a0 = inv; a1 = ((-1 * inv) * 2) * cs; a2 = inv; );
  );
);

function bq_mag(f, a0, a1, a2, b1, b2) local(w, c1, s1, c2, s2, nr, ni, dr, di)
(
  w = 2 * $pi * f / srate;
  c1 = cos(w); s1 = sin(w); c2 = cos(2 * w); s2 = sin(2 * w);
  nr = a0 + a1 * c1 + a2 * c2; ni = -(a1 * s1 + a2 * s2);
  dr = 1 + b1 * c1 + b2 * c2; di = -(b1 * s1 + b2 * s2);
  sqrt((nr * nr + ni * ni) / max(0.0000000001, dr * dr + di * di));
);

function filter_graph(x, y, w, h) local(ft, c, rs, c2, fg, i, f, l1, l2, db, xx, yy, lx, ly, lx2, ly2, st, k, gl)
(
  hexc(0x000000, 1); grect(x, y, w, h);
  hexc(0x1a1d22, 1);
  k = 0; loop(4, gl = y + h * (k + 1) / 5; grect(x, gl, w, 1); k += 1; );
  f = 100; loop(3, xx = x + w * log(f / 20) / log(1000); grect(xx, y, 1, h); f *= 10; );
  ft = floor(slider(9) + 0.5);
  st = ft == 2 || ft == 7;
  ms_running ? (
    gq1a0 = flt1.a0; gq1a1 = flt1.a1; gq1a2 = flt1.a2; gq1b1 = flt1.b1; gq1b2 = flt1.b2;
    gq2a0 = flt2.a0; gq2a1 = flt2.a1; gq2a2 = flt2.a2; gq2b1 = flt2.b1; gq2b2 = flt2.b2;
    fg = fgain;
  ) : (
    c = max(10, min(18000, slider(10)));
    rs = max(0.7, slider(11));
    c2 = max(10, min(18000, c * 2 ^ (slider(12) / 1200)));
    gf1.gbq_set(0, 0, 1); gf2.gbq_set(0, 0, 1);
    ft == 0 ? ( gf1.gbq_set(1, c, rs); fg = min(0.7, 0.7 / rs); ) :
    ft == 3 ? ( gf1.gbq_set(2, c, rs); fg = min(0.7, 0.7 / rs); ) :
    ft == 1 ? ( gf1.gbq_set(1, c, rs); gf2.gbq_set(1, c2, rs); fg = min(0.5, 0.5 / rs); ) :
    ft == 4 ? ( gf1.gbq_set(1, c, rs); gf2.gbq_set(4, c2, 1 / rs); fg = min(0.5, 0.5 / rs); ) :
    ft == 5 ? ( gf1.gbq_set(2, c, rs); gf2.gbq_set(4, c2, 1 / rs); fg = min(0.5, 0.5 / rs); ) :
    ft == 2 ? ( gf1.gbq_set(1, c, rs); gf2.gbq_set(1, c2, rs); fg = min(0.7, 0.7 / rs); ) :
    ft == 6 ? ( gf1.gbq_set(3, c, rs); fg = 1; ) :
    ( gf1.gbq_set(3, c, rs); gf2.gbq_set(3, c2, rs); fg = 1; );
    gq1a0 = gf1.a0; gq1a1 = gf1.a1; gq1a2 = gf1.a2; gq1b1 = gf1.b1; gq1b2 = gf1.b2;
    gq2a0 = gf2.a0; gq2a1 = gf2.a1; gq2a2 = gf2.a2; gq2b1 = gf2.b1; gq2b2 = gf2.b2;
  );
  i = 0;
  loop(floor(w / 2) + 1,
    f = 20 * (1000 ^ (2 * i / w));
    l1 = bq_mag(f, gq1a0, gq1a1, gq1a2, gq1b1, gq1b2);
    l2 = bq_mag(f, gq2a0, gq2a1, gq2a2, gq2b1, gq2b2);
    xx = x + 2 * i;
    st ? (
      db = 20 * log10(max(0.00001, l1 * fg)); yy = y + h * (24 - db) / 72;
      db = 20 * log10(max(0.00001, l2 * fg)); ly2 = y + h * (24 - db) / 72;
      yy = max(y, min(y + h, yy)); ly2 = max(y, min(y + h, ly2));
      i > 0 ? (
        hexc(0x0066ff, 1); gfx_line(gxp(lx), gyp(ly), gxp(xx), gyp(yy), 1);
        hexc(0xff0066, 1); gfx_line(gxp(lx), gyp(lx2), gxp(xx), gyp(ly2), 1);
      );
      lx2 = ly2;
    ) : (
      db = 20 * log10(max(0.00001, l1 * l2 * fg)); yy = y + h * (24 - db) / 72;
      yy = max(y, min(y + h, yy));
      i > 0 ? ( hexc(0xc000ff, 1); gfx_line(gxp(lx), gyp(ly), gxp(xx), gyp(yy), 1); );
    );
    lx = xx; ly = yy;
    i += 1;
  );
  gfont(11, 0); hexc(0x9498a2, 1);
  txt_r(x + w - 4, y + h / 5, "12dB");
  txt_r(x + w - 4, y + 2 * h / 5, "0dB");
  txt_r(x + w - 4, y + 3 * h / 5, "-12dB");
  txt_l(x + 4, y + h - 8, "20Hz");
  txt_l(x + w * log(5) / log(1000) + 3, y + h - 8, "100");
  txt_l(x + w * log(50) / log(1000) + 3, y + h - 8, "1k");
  txt_l(x + w * log(500) / log(1000) + 3, y + h - 8, "10k");
);

function knobs_init()
(
  GK = 2000000; GKN = 0; GNM = 2010000; GPR = 2020000; GPV = 2030000; GDEF = 2040000;
  nm_set(0, 8, "Sawtooth", "Square", "Pulse", "Sine", "Triangle", "Varistep", "Skewed Saw", "Skewed Square");
  nm_set(8, 8, "Smooth Brass", "Bass", "Dark FM", "Multiwave", "Bell FM", "Dark Pad", "DCO Saw", "DCO Maze");
  nm_set(20, 6, "0° : 0°", "0° : 180°", "0° : 90°", "90° : 90°", "90° : 270°", "Random", 0, 0);
  nm_set(30, 8, "12dB/oct Lowpass", "24dB/oct Lowpass", "2x12dB/oct Lowpass", "12dB/oct Highpass", "Lowpass+Notch", "Highpass+Notch", "6dB/oct Bandpass", "2x6dB/oct Bandpass");
  nm_set(40, 4, "Retrig", "Legato", "Fng Retrig", "Fng Legato", 0, 0, 0, 0);
  nm_set(44, 2, "Retrig", "Free", 0, 0, 0, 0, 0, 0);
  nm_set(50, 8, "None", "Velocity", "Pressure", "ModWheel", "Envelope 1", "Envelope 2", "LFO 1", "LFO 2");
  nm_set(60, 8, "0..1", "-1..1", "-1..0", "x^2", "2x^2-1", "ASqr", "ASqrBip", "Para");
  nm_set(70, 8, "None", "Attenuation", "Osc Mix Ratio (%)", "Cutoff [ct]", "Resonance", "O1: Detune [ct]", "O2: Detune [ct]", "O1: PW (%)");
  nm_set(78, 4, "O2: PW (%)", "O1: Stretch", "O2: Unison Amt (%)", "O2: Unison Detune (log2)", 0, 0, 0, 0);
  nm_set(90, 8, "Omni", "1", "2", "3", "4", "5", "6", "7");
  nm_set(98, 8, "8", "9", "10", "11", "12", "13", "14", "15");
  GNM[106] = "16";
  nm_set(110, 2, "Off", "On", 0, 0, 0, 0, 0, 0);
  nm_set(112, 2, "Audio Path", "Modulation", 0, 0, 0, 0, 0, 0);
  nm_set(114, 2, "Mono", "Poly", 0, 0, 0, 0, 0, 0);
  NOB = -2000000;
  knob(3, 54, 262, 24, 0, -1, 1, 0, "PW", 7, 0);
  knob(43, 124, 262, 24, 1, 1, 16, 1, "Stretch", 7, NOB);
  knob(44, 194, 262, 24, 0, 0, 1, 0, "Window", 3, NOB);
  knob(51, 264, 262, 24, 4, -24, 24, 0, "Transpose", 5, 0);
  knob(4, 366, 262, 24, 0, -1, 1, 0, "PW", 7, 0);
  knob(6, 436, 262, 24, 4, -24, 24, 12, "Transpose", 5, 0);
  knob(49, 506, 262, 24, 0, 0, 1, 0, "Unison", 3, NOB);
  knob(50, 576, 262, 24, 1, 0.01, 20, 2, "Uni Detune", 8, NOB);
  knob(8, 711, 196, 30, 0, 0, 1, 0.5, "O1 <> O2", 3, NOB);
  knob(5, 674, 282, 18, 0, 0, 100, 10, "Detune", 4, NOB);
  knob(34, 748, 282, 18, 0, 0, 1, 1, "Scale", 3, NOB);
  knob(10, 1106, 178, 34, 1, 10, 16000, 33, "Cutoff", 1, NOB);
  knob(11, 1210, 178, 26, 1, 0.7, 8, 3, "Resonance", 7, NOB);
  knob(12, 1106, 282, 22, 0, -2400, 2400, 0, "Separation", 4, 0);
  knob(21, 1210, 282, 22, 0, 0, 2, 0, "Key Follow", 3, NOB);
  knob(16, 46, 420, 22, 1, 1, 20000, 1, "Attack", 2, NOB);
  knob(17, 106, 420, 22, 1, 10, 20000, 350, "Decay", 2, NOB);
  knob(18, 166, 420, 22, 0, 0, 1, 0.5, "Sustain", 3, NOB);
  knob(19, 226, 420, 22, 0, -10000, 10000, 0, "Fade", 9, 0);
  knob(20, 286, 420, 22, 1, 10, 20000, 100, "Release", 2, NOB);
  knob(13, 70, 528, 22, 0, -10800, 10800, 8000, "To Cutoff", 4, 0);
  knob(14, 150, 528, 22, 0, 0, 1, 1, "To Res", 3, NOB);
  knob(38, 374, 420, 22, 1, 1, 20000, 1, "Attack", 2, NOB);
  knob(39, 434, 420, 22, 1, 10, 20000, 100, "Decay", 2, NOB);
  knob(40, 494, 420, 22, 0, 0, 1, 0.5, "Sustain", 3, NOB);
  knob(41, 554, 420, 22, 0, -10000, 10000, 0, "Fade", 9, 0);
  knob(42, 614, 420, 22, 1, 10, 20000, 50, "Release", 2, NOB);
  knob(35, 398, 528, 22, 0, -10800, 10800, 0, "To Cutoff", 4, 0);
  knob(36, 478, 528, 22, 0, 0, 1, 0.3, "To Res", 3, NOB);
  knob(28, 712, 456, 24, 1, 0.01, 20, 5, "Rate", 8, NOB);
  knob(29, 792, 456, 24, 2, 0, 5, 0.5, "Delay", 6, NOB);
  knob(31, 872, 456, 24, 2, 0, 1200, 100, "To Pitch", 4, NOB);
  knob(30, 712, 548, 20, 0, -4800, 4800, 0, "To Filter", 4, 0);
  knob(32, 792, 548, 20, 0, 0, 1, 0, "To PW", 3, NOB);
  knob(33, 872, 548, 20, 0, 0, 1, 1, "ModWheel", 3, NOB);
  knob(47, 980, 456, 24, 1, 0.01, 20, 5, "Rate", 8, NOB);
  knob(48, 980, 548, 20, 1, 0.1, 5, 0.5, "Delay", 6, NOB);
  knob(23, 1106, 476, 17, 1, 1, 2000, 1, "Portamento", 2, NOB);
  knob(27, 1206, 476, 17, 0, 0, 2400, 200, "PB Range", 4, NOB);
  knob(24, 1106, 530, 17, 0, 0, 1, 0.5, "Vel > Filter", 3, NOB);
  knob(25, 1206, 530, 17, 0, 0, 1, 0, "Vel > Amp", 3, NOB);
  gknob_n1 = GKN;
  knob(26, 1166, 36, 26, 3, 0, 1, 0.5, "", 10, NOB);
  GDEF[1] = 0; GDEF[2] = 1; GDEF[7] = 0; GDEF[9] = 1; GDEF[15] = 0; GDEF[22] = 0; GDEF[37] = 1;
  GDEF[45] = 0; GDEF[46] = 0; GDEF[52] = 0;
  gk_ready = 1;
);

function keyboard(x, y, w, h) local(kw, lo, nw, ww, n, kx, kpc, isb, bx, bw, bh, hovn, down, vel, QX, QY, QH, oct, wi, col, lit, snd, kg, ar, ag, ab)
(
  lo = 36; nw = 36;
  ww = w / nw; bw = ww * 0.62; bh = h * 0.62;
  QX = gxp(x); QY = gyp(y); QH = h * gsc;
  ar = 0; ag = 0.4; ab = 1;
  hovn = -1;
  (mouse_y >= QY && mouse_y < QY + QH && mouse_x >= QX && mouse_x < QX + w * gsc) ? (
    n = lo; wi = 0;
    loop(61,
      kpc = n % 12; isb = kpc == 1 || kpc == 3 || kpc == 6 || kpc == 8 || kpc == 10;
      isb ? ( bx = x + wi * ww - bw * 0.5; (mouse_y < QY + bh * gsc && mouse_x >= gxp(bx) && mouse_x < gxp(bx + bw)) ? hovn = n; );
      !isb ? wi += 1;
      n += 1;
    );
    hovn < 0 ? ( wi = floor((mouse_x - QX) / (ww * gsc)); oct = floor(wi / 7); kpc = wi - oct * 7;
      hovn = lo + oct * 12 + (kpc == 0 ? 0 : kpc == 1 ? 2 : kpc == 2 ? 4 : kpc == 3 ? 5 : kpc == 4 ? 7 : kpc == 5 ? 9 : 11); );
  );
  down = mouse_cap & 1;
  (gclick && hovn >= 0) ? ( gui_note = -1; kb_on = 1; gclick = 0; );
  kb_on && !down ? (
    gui_note >= 0 ? ( UIQ[uiq_w * 3] = 128; UIQ[uiq_w * 3 + 1] = gui_note; UIQ[uiq_w * 3 + 2] = 0; uiq_w = (uiq_w + 1) % 64; );
    gui_note = -1; kb_on = 0;
  );
  (kb_on && down && hovn != gui_note && hovn >= 0 && hovn <= 127) ? (
    gui_note >= 0 ? ( UIQ[uiq_w * 3] = 128; UIQ[uiq_w * 3 + 1] = gui_note; UIQ[uiq_w * 3 + 2] = 0; uiq_w = (uiq_w + 1) % 64; );
    vel = floor(40 + 87 * max(0, min(1, (mouse_y - QY) / QH)));
    UIQ[uiq_w * 3] = 144; UIQ[uiq_w * 3 + 1] = hovn; UIQ[uiq_w * 3 + 2] = vel; uiq_w = (uiq_w + 1) % 64;
    gui_note = hovn;
  );
  n = lo; wi = 0;
  loop(61,
    kpc = n % 12; isb = kpc == 1 || kpc == 3 || kpc == 6 || kpc == 8 || kpc == 10;
    !isb ? (
      kg = max(1, floor(gsc));
      kx = floor(gxp(x + wi * ww)) + kg;
      kw = floor(gxp(x + (wi + 1) * ww)) - kx;
      lit = KS_ST[n] != 255 || gui_note == n;
      snd = SNDN[n];
      lit ? gfx_gradrect(kx, QY, kw, QH, ar, ag, ab, 1, 0, 0, 0, 0, -0.2 / QH, -0.2 / QH, -0.2 / QH, 0) : (
        col = snd ? 0.80 : 0.90;
        gfx_gradrect(kx, QY, kw, QH, col * 0.86, col * 0.87, col * 0.9, 1, 0, 0, 0, 0, 0.12 / QH, 0.12 / QH, 0.12 / QH, 0);
        snd ? ( gfx_set(ar, ag, ab, 0.35); gfx_rect(kx, QY + QH - 5 * gsc, kw, 5 * gsc, 1); );
      );
      gfx_set(0, 0, 0, 0.18); gfx_rect(kx, QY, kw, 2 * gsc, 1);
      kpc == 0 ? ( gfont(10, 'b'); gfx_set(0.35, 0.36, 0.4, 1); sprintf(#gkl, "C%d", floor(n / 12) - 1); txt_c(x + wi * ww + ww * 0.5, y + h - 18, #gkl); );
      wi += 1;
    );
    n += 1;
  );
  n = lo; wi = 0;
  loop(61,
    kpc = n % 12; isb = kpc == 1 || kpc == 3 || kpc == 6 || kpc == 8 || kpc == 10;
    isb ? (
      bx = floor(gxp(x + wi * ww - bw * 0.5));
      lit = KS_ST[n] != 255 || gui_note == n;
      snd = SNDN[n];
      gfx_set(0, 0, 0, 0.35); gfx_rect(bx + gsc, QY, bw * gsc, bh * gsc + 2 * gsc, 1);
      lit ? gfx_gradrect(bx, QY, bw * gsc, bh * gsc, ar * 0.8, ag * 0.8, ab * 0.8, 1, 0, 0, 0, 0, 0.1 / (bh * gsc), 0.1 / (bh * gsc), 0.1 / (bh * gsc), 0) : (
        gfx_gradrect(bx, QY, bw * gsc, bh * gsc, 0.08, 0.085, 0.095, 1, 0, 0, 0, 0, 0.1 / (bh * gsc), 0.1 / (bh * gsc), 0.1 / (bh * gsc), 0);
        gfx_set(1, 1, 1, 0.10); gfx_rect(bx + 2 * gsc, QY + bh * gsc - 7 * gsc, bw * gsc - 4 * gsc, 5 * gsc, 1);
        snd ? ( gfx_set(ar, ag, ab, 0.55); gfx_rect(bx + 2 * gsc, QY + bh * gsc - 7 * gsc, bw * gsc - 4 * gsc, 5 * gsc, 1); );
      );
    );
    !isb ? wi += 1;
    n += 1;
  );
);

function grad_at(t) local(u)
(
  t < 0.5 ? ( u = t * 2; gfx_set((0x9d / 255) * u, 0.4 * (1 - u), 1, 1); ) :
  ( u = (t - 0.5) * 2; gfx_set((0x9d + (255 - 0x9d) * u) / 255, 0, 1 - u * 0.6, 1); );
);

function grad_text(s, w) local(i, n, cw, ch, x0)
(
  n = strlen(s); x0 = gfx_x;
  i = 0;
  loop(n,
    strcpy_substr(#gch, s, i, 1);
    gfx_measurestr(#gch, cw, ch);
    grad_at(w > 0 ? (gfx_x - x0 + cw * 0.5) / w : 0);
    gfx_drawstr(#gch);
    i += 1;
  );
);

function title_logo(x, y) local(tw, th, mw, mh, sx0)
(
  gfont(30, 'b'); hexc(0xfdfeff, 1);
  gfx_x = gxp(x); gfx_y = gyp(y);
  gfx_drawstr("herd ");
  gfx_measurestr("mentality", mw, mh);
  sx0 = gfx_x;
  grad_text("mentality", mw);
  gfont(13, 0); hexc(0xb6bac1, 1);
  gfx_x = gxp(x + 2); gfx_y = gyp(y + 38);
  gfx_drawstr("by chmaha  ·  based on Calf Monosynth");
);

