in_pin:none
out_pin:Left output
out_pin:Right output
options:no_meter

@init
ext_noinit = gfx_ext_retina = 1;

U32 = 4294967296; I31 = 2147483648;
WSZ = 4096; WSC = 1048576;

ORIG = 0; FB = 65536; SPEC = 73728;
LKEY = 81920; LPTR = 82560; NLEV = 83200;
BUF1 = 83300; BUF2 = 83400; SILENCE = 83500;
MODD = 87700; MODS = 87720; MSC = 87740;
KS_ACT = 87800; KS_ST = 87930; RNG = 88100;
EVQ = 88200; UIQ = 125700;
OUTL = 92400; OUTR = 108800;
PC = 125300; PV = 125450;
UNM = 125600; MROW = 125620;
VST = 126000; VSZ = 200; VNOTE = 127700; VAGE = 127710; VSUS = 127720; VHELD = 127730;
SUSN = 127800; SNDN = 127930; MIX1 = 128100; MIX2 = 128200;
TBASE = 200000;

function f32(x) local(a, e, q, m, r, fr)
(
  x === 0 ? 0 : (
    a = abs(x);
    e = floor(log(a) * 1.4426950408889634);
    2 ^ e > a ? e -= 1 : 2 ^ (e + 1) <= a ? e += 1;
    e < -126 ? e = -126;
    q = 2 ^ (e - 23);
    m = a / q; r = floor(m); fr = m - r;
    (fr > 0.5 || (fr === 0.5 && (r - 2 * floor(r * 0.5)) === 1)) ? r += 1;
    x < 0 ? -(r * q) : r * q;
  );
);

function wrap32(x) ( x - floor(x / U32) * U32; );
function itrunc(x) ( x >= 0 ? floor(x) : -floor(-x); );
function asr(x, n) ( floor(x / (2 ^ n)); );
function sgn32(x) ( x >= I31 ? x - U32 : x; );
function clipv(x, lo, hi) ( x < lo ? lo : x > hi ? hi : x; );

FIXQ = 1;
F001 = (0.001); F01 = (0.01); F0999 = (0.999); FE5 = (0.00001);
F00101 = (0.00101); F1200 = (1 / (1200)); SMALLV = 1 / 16777216;
MSC[0] = 0; MSC[1] = 1; MSC[2] = 0;
MSC[3] = -1; MSC[4] = 2; MSC[5] = 0;
MSC[6] = -1; MSC[7] = 1; MSC[8] = 0;
MSC[9] = 0; MSC[10] = 0; MSC[11] = 1;
MSC[12] = -1; MSC[13] = 0; MSC[14] = 1;
MSC[15] = 0; MSC[16] = 2; MSC[17] = -1;
MSC[18] = -1; MSC[19] = 4; MSC[20] = -2;
MSC[21] = 0; MSC[22] = 4; MSC[23] = -4;
UNM[0] = 33; UNM[1] = -47; UNM[2] = 53; UNM[3] = -67; UNM[4] = 87; UNM[5] = -101; UNM[6] = 121; UNM[7] = -139;

function grand_step() local(v)
(
  v = RNG[(rng_n - 31) % 34] + RNG[(rng_n - 3) % 34];
  v >= U32 ? v -= U32;
  RNG[rng_n % 34] = v;
  rng_n += 1;
  v;
);

function grand_init() local(i, hi, lo, w)
(
  RNG[0] = 1;
  i = 1;
  loop(30,
    hi = floor(RNG[i - 1] / 127773); lo = RNG[i - 1] - hi * 127773;
    w = 16807 * lo - 2836 * hi;
    w < 0 ? w += 2147483647;
    RNG[i] = w;
    i += 1;
  );
  i = 31; loop(3, RNG[i] = RNG[i - 31]; i += 1; );
  rng_n = 34;
  loop(310, grand_step(); );
);

function grand() ( floor(grand_step() * 0.5); );
function grand_phase() ( wrap32(grand() * 65536); );

function normalize_wave(t) local(i, dc, mx, dv)
(
  dc = 0; i = 0; loop(WSZ, dc += t[i]; i += 1; );
  dc /= WSZ;
  i = 0; loop(WSZ, t[i] -= dc; i += 1; );
  mx = 0; i = 0; loop(WSZ, mx = max(mx, abs(t[i])); i += 1; );
  mx >= 0.000001 ? (
    dv = 1 / mx;
    i = 0; loop(WSZ, t[i] *= dv; i += 1; );
  );
);

function wave_make(w) local(o, i, vmax, vthres, cumul, cutoff, key, n, tp, mg)
(
  o = ORIG + w * WSZ;
  i = 0; loop(WSZ, FB[2 * i] = o[i]; FB[2 * i + 1] = 0; i += 1; );
  fft(FB, WSZ); fft_permute(FB, WSZ);
  memcpy(SPEC, FB, 2 * WSZ);
  SPEC[0] = SPEC[1] = 0;
  vmax = 0;
  i = 0; loop(WSZ / 2, vmax = max(vmax, sqrt(sqr(SPEC[2 * i]) + sqr(SPEC[2 * i + 1]))); i += 1; );
  vthres = vmax / 1024;
  cutoff = WSZ / 2;
  n = 0;
  while (cutoff > 2) (
    cumul = 0;
    while (cutoff > 1 && (cumul + (mg = sqrt(sqr(SPEC[2 * (cutoff - 1)]) + sqr(SPEC[2 * (cutoff - 1) + 1])))) < vthres) (
      cumul += mg;
      cutoff -= 1;
    );
    memset(FB, 0, 2 * WSZ);
    i = 1;
    loop(cutoff - 1,
      FB[2 * i] = SPEC[2 * i]; FB[2 * i + 1] = SPEC[2 * i + 1];
      FB[2 * (WSZ - i)] = SPEC[2 * (WSZ - i)]; FB[2 * (WSZ - i) + 1] = SPEC[2 * (WSZ - i) + 1];
      i += 1;
    );
    fft_ipermute(FB, WSZ); ifft(FB, WSZ);
    key = WSC * floor((WSZ / 2) / cutoff);
    n > 0 && LKEY[w * 40 + n - 1] === key ? (
      tp = LPTR[w * 40 + n - 1];
    ) : (
      tp = tnext; tnext += WSZ + 1;
      LKEY[w * 40 + n] = key; LPTR[w * 40 + n] = tp;
      n += 1;
    );
    i = 0; loop(WSZ, tp[i] = FB[2 * i] / WSZ; i += 1; );
    tp[WSZ] = tp[0];
    cutoff = floor(0.75 * cutoff);
  );
  NLEV[w] = n;
);

function build_waves() local(o, i, j, p, HS, QS, QS3, S, ii)
(
  S = WSZ; HS = S / 2; QS = S / 4; QS3 = 3 * QS;
  tnext = TBASE;
  memset(SILENCE, 0, S + 1);
  o = ORIG;
  i = 0; loop(HS, o[i] = (i * 1) / HS; o[i + HS] = (i * 1) / HS - 1; i += 1; );
  wave_make(0);
  o = ORIG + S;
  i = 0; loop(S, o[i] = i < HS ? -1 : 1; i += 1; );
  NLEV[1] = 0;
  o = ORIG + 2 * S;
  i = 0; loop(S, o[i] = i < 128 ? -1 : 1; i += 1; );
  wave_make(2);
  o = ORIG + 3 * S;
  i = 0; loop(S, o[i] = sin((i * $pi) / HS); i += 1; );
  wave_make(3);
  o = ORIG + 4 * S;
  i = 0; loop(QS,
    o[i] = i * (1 / QS); o[i + QS] = 1 - i * (1 / QS);
    o[i + HS] = -i * (1 / QS); o[i + QS3] = -1 + i * (1 / QS);
    i += 1;
  );
  wave_make(4);
  o = ORIG + 5 * S;
  i = 0; j = 1; loop(S, o[i] = -1 + (j * 1) / HS; i == j ? j *= 2; i += 1; );
  wave_make(5);
  o = ORIG + 6 * S;
  i = 0; loop(S,
    p = ((i * i) * 8) / (S * S);
    o[i] = ((min(1, i / 64) * (1 - (i * 1) / S)) * (-1 + (p - 2 * floor(p / 2))));
    i += 1;
  );
  normalize_wave(o); wave_make(6);
  o = ORIG + 7 * S;
  i = 0; loop(S,
    p = ((i * i) * 8) / (S * S);
    o[i] = ((min(1, i / 64) * (1 - (i * 1) / S)) * ((p - 2 * floor(p / 2)) < 1 ? -1 : 1));
    i += 1;
  );
  normalize_wave(o); wave_make(7);
  o = ORIG + 8 * S;
  i = 0; loop(S,
    i < QS3 ? ( p = (i * 1) / QS3; o[i] = sin((($pi * p) * p) * p); ) : (
      p = (i - QS3 * 1) / QS; o[i] = -0.5 * sin(((3 * $pi) * p) * p);
    );
    i += 1;
  );
