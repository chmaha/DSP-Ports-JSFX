@sample
x = nll; nll = x ~ ((x << 13) & 65535); nlh = nlh ~ (((nlh << 13) | (x >> 3)) & 65535);
nll = nll ~ (nlh >> 1);
x = nll; nll = x ~ ((x << 5) & 65535); nlh = nlh ~ (((nlh << 5) | (x >> 11)) & 65535);
x = nrl; nrl = x ~ ((x << 13) & 65535); nrh = nrh ~ (((nrh << 13) | (x >> 3)) & 65535);
nrl = nrl ~ (nrh >> 1);
