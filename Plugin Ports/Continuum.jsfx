function gky(y) ( y * G_SC - G_OYS; );

function gwave(wp, wn0) local(pk, i, stp, qx, qe, u, kk, ff, a0, a1, am, y0, y1, ln, la, sg, xa, xb, ya, yb, wl, wt, wr, wb, mid, hh, pul) (
  pk = 0.000000001; i = 0; loop(wn0, pk = max(pk, wp[i]); i += 1;);
  pul = 0.85 + 0.15 * sin(G_TM * 0.4);
  wl = 44 - G_E; wt = 146; wr = 376 + G_E; wb = 248;
  mid = (wt + wb) * 0.5; hh = (wb - wt) * 0.5; stp = (wr - wl) / max(1, wn0);
  wn0 > 1 ? (
    gset(C_ACC, 0.20 * pul);
    qx = ceil(gsx(wl + 0.5 * stp)); qe = floor(gsx(wl + (wn0 - 0.5) * stp));
    while (qx <= qe) (
      u = ((qx + 0.5 - G_OX) / G_SC - wl) / stp - 0.5;
