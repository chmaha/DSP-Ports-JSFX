);
function gbtn(x, y, w, h, lb, on, hov) local(xx, yy, ww, hh, rr) (
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC); rr = floor(h * 0.5 * G_SC);
  on ? (
    gfrr(xx, yy, xx + ww, yy + hh, rr, G_ACR, G_ACG, G_ACB, hov ? 1 : 0.9);
    gtext(x + w * 0.5, y + h * 0.5, lb, 3, G_DKR, G_DKG, G_DKB, 1, 1);
  ) : (
    gfrr(xx, yy, xx + ww, yy + hh, rr, G_BFR, G_BFG, G_BFB, hov ? 0.95 : 0.8);
    gbord(xx, yy, xx + ww, yy + hh, rr, max(1, floor(G_SC + 0.5)), G_BDR, G_BDG, G_BDB, hov ? 0.7 : 0.4);
    gtext(x + w * 0.5, y + h * 0.5, lb, 3, G_T2R, G_T2G, G_T2B, hov ? 1 : 0.8, 1);
  );
);

function gauto(s, e) (
<?
max_sliders > 5 ? printf("slider_automate(2^(s-1), e);") : (
  printf("s == 1 ? slider_automate(gain_db, e) :\n");
  printf("s == 2 ? slider_automate(mute, e) :\n");
  printf("s == 3 ? slider_automate(room, e) :\n");
  printf("s == 4 ? slider_automate(start_s, e) :\n");
  printf("s == 5 ? slider_automate(theme, e) : 0;");
);
?>
);

