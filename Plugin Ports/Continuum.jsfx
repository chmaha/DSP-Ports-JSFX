gfont_data();

function gdec(c) ( c - 35 - (c > 92 ? 1 : 0); );

function gdecode() local(g, s, n, i, k, c, px, py, fx, fy, np, e, a, b) (
  e = 0; g = 0;
  loop(NGLY,
    s = 400 + g; n = strlen(s);
    GEO[g] = e; i = 0; np = 0;
    while (i <= n) (
      c = i < n ? str_getchar(s, i, 'cu') : 32;
      c === 32 ? (
        np > 2 ? (
          (fy !== py) ? ( GE[4 * e] = px; GE[4 * e + 1] = py; GE[4 * e + 2] = fx; GE[4 * e + 3] = fy; e += 1; );
        );
        np = 0; i += 1;
      ) : (
        a = (gdec(c) * 90 + gdec(str_getchar(s, i + 1, 'cu'))) - 4000;
        b = (gdec(str_getchar(s, i + 2, 'cu')) * 90 + gdec(str_getchar(s, i + 3, 'cu'))) - 4000;
        np === 0 ? ( fx = a; fy = b; ) : (
          (b !== py) ? ( GE[4 * e] = px; GE[4 * e + 1] = py; GE[4 * e + 2] = a; GE[4 * e + 3] = b; e += 1; );
        );
        px = a; py = b; np += 1; i += 4;
      );
    );
    GEN[g] = e - GEO[g];
    g += 1;
  );
);
gdecode();

function gtl(f, s, size) local(n, i, c, cp, g, cur, upx, last) (
  G_PX = floor(size + 0.5);
  upx = G_PX / (FASC[f] - FDSC[f]);
  G_ASC = floor(FASC[f] * size / (FASC[f] - FDSC[f]) * 32 + 0.5) / 32;
  n = strlen(s); i = 0; GLN = 0; cur = 0; last = 0;
  while (i < n) (
    c = str_getchar(s, i, 'cu');
    c < 128 ? ( cp = c; i += 1; ) :
    c < 224 ? ( cp = ((c & 31) << 6) | (str_getchar(s, i + 1, 'cu') & 63); i += 2; ) :
    c < 240 ? ( cp = ((c & 15) << 12) | ((str_getchar(s, i + 1, 'cu') & 63) << 6) | (str_getchar(s, i + 2, 'cu') & 63); i += 3; ) :
    ( cp = 63; i += 4; );
    cp === 8212 ? cp = 151;
    g = cp < CMW ? CMAP[f * CMW + cp] : 0;
    g === 0 ? g = CMAP[f * CMW + 63];
    g > 0 && GLN < 250 ? (
      g -= 1;
      GLG[GLN] = g; GLX[GLN] = cur;
      last = cur + GADV[g] * upx;
      cur = floor(last + 0.5);
      GLN += 1;
    );
  );
  G_UPX = upx;
  last;
);

function gras(o) local(py, py1, bx, w, k, ye, n, e, t, tdir, i, j, wd, wp, xa, a, bb, ia, ib, c, cnt, x0, run, rc)
(
  bx = floor(TBX0) - 1; w = ceil(TBX1) - bx + 2;
  py = floor(TBY0); py1 = ceil(TBY1);
  memset(TC, 0, w + 2);
  cnt = 0;
  while (py < py1) (
    k = 0;
    loop(8,
      ye = py + (k + 0.5) / 8;
      n = 0; e = TE;
      loop(TEN,
        (e[1] <= ye) !== (e[3] <= ye) ? (
          t = e[0] + (ye - e[1]) * (e[2] - e[0]) / (e[3] - e[1]) - bx;
          tdir = e[3] > e[1] ? 1 : -1;
          i = n;
          while (i > 0 && TX[i - 1] > t) ( TX[i] = TX[i - 1]; TD[i] = TD[i - 1]; i -= 1; );
          TX[i] = t; TD[i] = tdir; n += 1;
        );
        e += 4;
      );
      wd = 0; j = 0;
      loop(n,
        wp = wd; wd += TD[j];
        wp === 0 && wd !== 0 ? xa = TX[j];
        wp !== 0 && wd === 0 ? (
          a = max(0, xa); bb = min(w, TX[j]);
          bb > a ? (
            ia = floor(a); ib = floor(bb);
            ia === ib ? TC[ia] += (bb - a) * 0.125 : (
              TC[ia] += (ia + 1 - a) * 0.125;
              i = ia + 1; loop(ib - ia - 1, TC[i] += 0.125; i += 1;);
              TC[ib] += (bb - ib) * 0.125;
            );
          );
        );
        j += 1;
      );
      k += 1;
    );
    i = 0; run = -1;
    loop(w + 1,
      c = min(1, TC[i]);
      c >= 0.996 ? (
        run < 0 ? ( run = i; rc = 0; ); rc += 1;
      ) : (
        run >= 0 ? ( o[0] = bx + run; o[1] = py; o[2] = rc; o[3] = 1; o += 4; cnt += 1; run = -1; );
        c > 0.004 ? ( o[0] = bx + i; o[1] = py; o[2] = 1; o[3] = c; o += 4; cnt += 1; );
      );
      TC[i] = 0;
      i += 1;
    );
    run >= 0 ? ( o[0] = bx + run; o[1] = py; o[2] = rc; o[3] = 1; o += 4; cnt += 1; );
    py += 1;
  );
  cnt;
);

function gedge(a, b, c, d) (
  TE[4 * TEN] = a; TE[4 * TEN + 1] = b; TE[4 * TEN + 2] = c; TE[4 * TEN + 3] = d; TEN += 1;
  TBX0 = min(TBX0, min(a, c)); TBX1 = max(TBX1, max(a, c)); TBY0 = min(TBY0, min(b, d)); TBY1 = max(TBY1, max(b, d));
);

function gpoly_begin() ( TEN = 0; TBX0 = TBY0 = 1000000; TBX1 = TBY1 = -1000000; );

function gtx_make(id, f, s, size, x, ytop, align) local(w, left, i, g, ox, oy, sc, e, n, o, k)
(
  w = gtl(f, s, size);
  left = align === 1 ? x - w * 0.5 : align === 2 ? x - w : x;
  gpoly_begin();
  oy = floor(G_SC * (ytop + G_ASC) - G_OYS + 0.5);
  sc = G_SC * G_UPX;
  i = 0;
  loop(GLN,
    g = GLG[i];
    ox = floor(G_OX + G_SC * (left + GLX[i]) + 0.5);
    e = GE + 4 * GEO[g];
    loop(GEN[g],
      TEN < 8000 ? gedge(ox + e[0] * sc, oy - e[1] * sc, ox + e[2] * sc, oy - e[3] * sc);
      e += 4;
    );
    i += 1;
  );
  o = id >= 20 ? DYO0 + (id - 20) * 16384 : SPA;
  n = TEN > 0 ? gras(o) : 0;
  SPO[id] = o; SPC[id] = n;
  id < 20 ? SPA = min(SPA + 4 * n, DYO0 - 16384);
  G_TW = w;
  w;
);

function gtx_draw(id, r, g, b, a) local(o) (
  o = SPO[id];
  loop(SPC[id], gfx_set(r, g, b, a * o[3]); gfx_rect(o[0], o[1], o[2], 1); o += 4;);
  gfx_a = 1;
);

function gpoly_fill(r, g, b, a) local(o, n) (
  o = DYO0 + 5 * 16384;
  n = TEN > 0 ? gras(o) : 0;
  loop(n, gfx_set(r, g, b, a * o[3]); gfx_rect(o[0], o[1], o[2], 1); o += 4;);
  gfx_a = 1;
);

function gpt(x, y) ( G_PXS = G_OX + G_SC * x; G_PYS = G_SC * y; );

function gpoly6(x0, y0, x1, y1, x2, y2, x3, y3, x4, y4, x5, y5, r, g, b, a) local(ax, ay, bx, by) (
  gpoly_begin();
  gpt(x0, y0); ax = G_PXS; ay = G_PYS; gpt(x1, y1); gedge(ax, ay, G_PXS, G_PYS); ax = G_PXS; ay = G_PYS;
  gpt(x2, y2); gedge(ax, ay, G_PXS, G_PYS); ax = G_PXS; ay = G_PYS;
  gpt(x3, y3); gedge(ax, ay, G_PXS, G_PYS); ax = G_PXS; ay = G_PYS;
  gpt(x4, y4); gedge(ax, ay, G_PXS, G_PYS); ax = G_PXS; ay = G_PYS;
  gpt(x5, y5); gedge(ax, ay, G_PXS, G_PYS); ax = G_PXS; ay = G_PYS;
  gpt(x0, y0); gedge(ax, ay, G_PXS, G_PYS);
  gpoly_fill(r, g, b, a);
);

function gcol(h) ( G_R = ((h >> 16) & 255) / 255; G_G = ((h >> 8) & 255) / 255; G_B = (h & 255) / 255; );
function gset(h, a) ( gcol(h); gfx_set(G_R, G_G, G_B, a); );
function glerp(h0, h1, t) local(r0, g0, b0) (
  gcol(h0); r0 = G_R; g0 = G_G; b0 = G_B; gcol(h1);
  G_R = r0 + (G_R - r0) * t; G_G = g0 + (G_G - g0) * t; G_B = b0 + (G_B - b0) * t;
);

function gh(r, g, b) ( floor(r * 255 + 0.5) * 65536 + floor(g * 255 + 0.5) * 256 + floor(b * 255 + 0.5); );
