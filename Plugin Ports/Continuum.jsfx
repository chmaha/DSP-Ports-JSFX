//
// https://github.com/x42/zconvo.lv2

slider1:gain_db=0<-12,12>-Output Gain (dB)
slider2:mute=0<0,1,1{Off,On}>-Mute
slider3:room=0<0,4,1{None,Rosemary Hall,Ivory Chapel,Dutch Church,File}>-Roomtone
slider4:start_s=0<0,60,0.001>-Section Start (s)
slider5:theme=0<0,1,1{Red,Silver}>-Theme

in_pin:none
out_pin:Left
out_pin:Right

options:no_meter
options:maxmem=33554432

@init
ext_noinit = gfx_ext_retina = ext_nodenorm = 1;
RSI = 65536; RSO = 131072; NWB = 160; MAXF = 1000000; STAGEMAX = 2000000; RTMAX = 16;
BB0 = 256; FADE_MS = 40; GROW = 4; FIXQ = 1;
NOISE_DB = -50; UNIFORM_RMS = 0.57735026; MAX_SEC = 5; SRC_SEC = 60; GMAX = 4;
CINL = 4096; CINR = CINL + 2 * RSI; CINM = CINR + 2 * RSI;
TMP = ceil((CINM + 2 * RSI) / 32768) * 32768;
STAGE = TMP + 32768; PATHS = STAGE + STAGEMAX; RT = PATHS + 2 * MAXF;
EMA = ceil((RT + RTMAX * 65536) / 65536) * 65536;
ESZ = 148 * 65536;
EMB = EMA + ESZ; SRCB = EMB + ESZ;
GUIMEM = 393216;
SRCMAX = 33554432 - GUIMEM - SRCB; GUIB = SRCB + SRCMAX;
OVW = 1700; src_key = -1;
strcpy(11, "Rosemary Hall"); strcpy(12, "Ivory Chapel"); strcpy(13, "Dutch Church");
strcpy(21, "rosemary-hall"); strcpy(22, "ivory-chapel"); strcpy(23, "dutch-church");
XTRA = 30; XTRA[1] = 0; XTRA[2] = 0; XTRA[3] = 10;
function e_init(ebp, ez) instance(ebase, eend, LVT, OBL, OBR, HD, WV, DYN, ready, nlev, lst, act, QB0, L, nin, npath, mode, irlen, ncov, span, ph, ywl, ywr, lh, lopen, lerr, lnch, lfsr, lfr, lg, lim, lzl, lsr, lpos, lnc, lrs, lrn, lc, lk, lp, lnin, lnp, lmd, lpm0, lpm1, lpm2, lpm3, wpk, wver, cin0, gsc, age, lxtra, lsub, lacc, lsq, lemax, lmean, lrms_db, lgain, lcal, lratio, lfq, lbk, lwn, ecal, wn, edur, lfkey, lsms, ltot, ls0, etot, es0, ovn, efsr, CE, cen, ecnt, st) (
  ebase = ebp; eend = ebp + ez;
  LVT = ebp; OBL = ebp + 256; OBR = OBL + RSO; HD = OBR + RSO; WV = HD + 512; CE = WV + 4 * NWB; DYN = CE + 4096;
  ready = 0; nlev = 0; lst = 0; act = 0;
);

function e_layout(nn, qb, lat, ni, np, md) instance(ebase, eend, LVT, OBL, OBR, HD, WV, DYN, ready, nlev, lst, act, QB0, L, nin, npath, mode, irlen, ncov, span, ph, ywl, ywr, lh, lopen, lerr, lnch, lfsr, lfr, lg, lim, lzl, lsr, lpos, lnc, lrs, lrn, lc, lk, lp, lnin, lnp, lmd, lpm0, lpm1, lpm2, lpm3, wpk, wver, cin0, gsc, age, lxtra, lsub, lacc, lsq, lemax, lmean, lrms_db, lgain, lcal, lratio, lfq, lbk, lwn, ecal, wn, edur, lfkey, lsms, ltot, ls0, etot, es0, ovn, efsr, CE, cen, ecnt, st) local(k, bb, oo, pp, pn, ptr, tb, nb) (
  QB0 = qb; L = lat; nin = ni; npath = np; mode = md; irlen = nn; cin0 = md === 2 ? CINM : CINL;
  oo = lat ? 0 : qb;
  bb = qb; k = 0; ptr = DYN;
  while (oo < nn && k < 15) (
    tb = LVT + k * 16;
    nb = min(16384, bb * GROW);
    bb >= 16384 ? pp = ceil((nn - oo) / bb) : (
      pn = max(1, ceil((2 * nb - qb - lat - oo) / bb));
      pp = nn - oo <= (pn + 2) * bb ? ceil((nn - oo) / bb) : pn;
    );
    tb[0] = bb; tb[1] = pp; tb[2] = oo; tb[3] = bb / qb;
    tb[10] = 2 * bb; tb[11] = pp * 2 * bb;
    ptr = ceil(ptr / (2 * bb)) * 2 * bb;
    tb[4] = ptr; ptr += ni * pp * 2 * bb;
    tb[5] = ptr; ptr += pp * bb * 2 * np;
    tb[13] = bb * 2 * np;
    ptr = ceil(ptr / (2 * bb)) * 2 * bb;
    tb[6] = ptr; ptr += 2 * bb;
    tb[7] = ptr; ptr += 2 * bb;
    tb[8] = pp - 1; tb[9] = 0;
    tb[12] = oo + lat + 1 - bb - (bb / qb - 1) * qb;
    oo += pp * bb;
    bb = nb;
    k += 1;
  );
  nlev = k; ncov = oo;
  span = oo + lat + 2 * 16384 + 2 * qb;
  ptr <= eend ? ( memset(DYN, 0, ptr - DYN); memset(OBL, 0, 2 * RSO); memset(HD, 0, 512); ph = 0; 1; ) : 0;
);


function e_reset() instance(ebase, eend, LVT, OBL, OBR, HD, WV, DYN, ready, nlev, lst, act, QB0, L, nin, npath, mode, irlen, ncov, span, ph, ywl, ywr, lh, lopen, lerr, lnch, lfsr, lfr, lg, lim, lzl, lsr, lpos, lnc, lrs, lrn, lc, lk, lp, lnin, lnp, lmd, lpm0, lpm1, lpm2, lpm3, wpk, wver, cin0, gsc, age, lxtra, lsub, lacc, lsq, lemax, lmean, lrms_db, lgain, lcal, lratio, lfq, lbk, lwn, ecal, wn, edur, lfkey, lsms, ltot, ls0, etot, es0, ovn, efsr, CE, cen, ecnt, st) local(k, tb) (
  k = 0;
  loop(nlev,
    tb = LVT + k * 16;
    memset(tb[4], 0, nin * tb[1] * tb[10]);
    memset(tb[6], 0, tb[10]); memset(tb[7], 0, tb[10]);
    tb[8] = tb[1] - 1; tb[9] = 0;
    k += 1;
  );
  memset(OBL, 0, RSO); memset(OBR, 0, RSO);
  ph = 0; age = 0;
);

function mac_ts(xx, xc, hq, hb, al, ar, pp, sq, n2, q0, q1) local(b, xp, hp, lr, li, rr, ri, xa, xb, xe, xf, xc1, na) (
  xc1 = xc + 1; na = sq + 1; b = q0;
  b === 0 ? (
      lr = li = rr = ri = 0;
      xp = xx + sq * n2 + 2 * 0; hp = hq + 0 * 8;
      loop(na,
        xa = xp[0]; xb = xp[1]; xe = xp[xc]; xf = xp[xc1];
          lr += xa * hp[0] + xe * hp[4]; li += xb * hp[1] + xf * hp[5];
          rr += xa * hp[2] + xe * hp[6]; ri += xb * hp[3] + xf * hp[7];
          xp -= n2; hp += hb;
      );
      xp = xx + (pp - 1) * n2 + 2 * 0;
      loop(pp - na,
        xa = xp[0]; xb = xp[1]; xe = xp[xc]; xf = xp[xc1];
          lr += xa * hp[0] + xe * hp[4]; li += xb * hp[1] + xf * hp[5];
          rr += xa * hp[2] + xe * hp[6]; ri += xb * hp[3] + xf * hp[7];
          xp -= n2; hp += hb;
      );
      al[2 * 0] = lr; al[2 * 0 + 1] = li; ar[2 * 0] = rr; ar[2 * 0 + 1] = ri;
      b = 1;
  );
  while (b < q1) (
      lr = li = rr = ri = 0;
      xp = xx + sq * n2 + 2 * b; hp = hq + b * 8;
      loop(na,
        xa = xp[0]; xb = xp[1]; xe = xp[xc]; xf = xp[xc1];
          lr += xa * hp[0] - xb * hp[1] + xe * hp[4] - xf * hp[5];
          li += xa * hp[1] + xb * hp[0] + xe * hp[5] + xf * hp[4];
          rr += xa * hp[2] - xb * hp[3] + xe * hp[6] - xf * hp[7];
          ri += xa * hp[3] + xb * hp[2] + xe * hp[7] + xf * hp[6];
          xp -= n2; hp += hb;
      );
      xp = xx + (pp - 1) * n2 + 2 * b;
      loop(pp - na,
        xa = xp[0]; xb = xp[1]; xe = xp[xc]; xf = xp[xc1];
          lr += xa * hp[0] - xb * hp[1] + xe * hp[4] - xf * hp[5];
          li += xa * hp[1] + xb * hp[0] + xe * hp[5] + xf * hp[4];
          rr += xa * hp[2] - xb * hp[3] + xe * hp[6] - xf * hp[7];
          ri += xa * hp[3] + xb * hp[2] + xe * hp[7] + xf * hp[6];
          xp -= n2; hp += hb;
      );
      al[2 * b] = lr; al[2 * b + 1] = li; ar[2 * b] = rr; ar[2 * b + 1] = ri;
      b += 1;
  );
);

function mac_st(xx, xc, hq, hb, al, ar, pp, sq, n2, q0, q1) local(b, xp, hp, lr, li, rr, ri, xa, xb, xe, xf, xc1, na) (
  xc1 = xc + 1; na = sq + 1; b = q0;
  b === 0 ? (
      lr = li = rr = ri = 0;
      xp = xx + sq * n2 + 2 * 0; hp = hq + 0 * 4;
      loop(na,
        xa = xp[0]; xb = xp[1]; xe = xp[xc]; xf = xp[xc1];
          lr += xa * hp[0]; li += xb * hp[1]; rr += xe * hp[2]; ri += xf * hp[3];
          xp -= n2; hp += hb;
      );
      xp = xx + (pp - 1) * n2 + 2 * 0;
      loop(pp - na,
        xa = xp[0]; xb = xp[1]; xe = xp[xc]; xf = xp[xc1];
          lr += xa * hp[0]; li += xb * hp[1]; rr += xe * hp[2]; ri += xf * hp[3];
          xp -= n2; hp += hb;
      );
      al[2 * 0] = lr; al[2 * 0 + 1] = li; ar[2 * 0] = rr; ar[2 * 0 + 1] = ri;
      b = 1;
  );
  while (b < q1) (
      lr = li = rr = ri = 0;
      xp = xx + sq * n2 + 2 * b; hp = hq + b * 4;
      loop(na,
        xa = xp[0]; xb = xp[1]; xe = xp[xc]; xf = xp[xc1];
          lr += xa * hp[0] - xb * hp[1]; li += xa * hp[1] + xb * hp[0];
          rr += xe * hp[2] - xf * hp[3]; ri += xe * hp[3] + xf * hp[2];
          xp -= n2; hp += hb;
      );
      xp = xx + (pp - 1) * n2 + 2 * b;
      loop(pp - na,
        xa = xp[0]; xb = xp[1]; xe = xp[xc]; xf = xp[xc1];
          lr += xa * hp[0] - xb * hp[1]; li += xa * hp[1] + xb * hp[0];
          rr += xe * hp[2] - xf * hp[3]; ri += xe * hp[3] + xf * hp[2];
          xp -= n2; hp += hb;
      );
      al[2 * b] = lr; al[2 * b + 1] = li; ar[2 * b] = rr; ar[2 * b + 1] = ri;
      b += 1;
  );
);

function mac_ms(xx, hq, hb, al, ar, pp, sq, n2, q0, q1) local(b, xp, hp, lr, li, rr, ri, xa, xb, xe, xf, xc1, na) (
  xc1 = 0; na = sq + 1; b = q0;
  b === 0 ? (
      lr = li = rr = ri = 0;
      xp = xx + sq * n2 + 2 * 0; hp = hq + 0 * 4;
      loop(na,
        xa = xp[0]; xb = xp[1];
          lr += xa * hp[0]; li += xb * hp[1]; rr += xa * hp[2]; ri += xb * hp[3];
          xp -= n2; hp += hb;
      );
      xp = xx + (pp - 1) * n2 + 2 * 0;
      loop(pp - na,
        xa = xp[0]; xb = xp[1];
          lr += xa * hp[0]; li += xb * hp[1]; rr += xa * hp[2]; ri += xb * hp[3];
          xp -= n2; hp += hb;
      );
      al[2 * 0] = lr; al[2 * 0 + 1] = li; ar[2 * 0] = rr; ar[2 * 0 + 1] = ri;
      b = 1;
  );
  while (b < q1) (
      lr = li = rr = ri = 0;
      xp = xx + sq * n2 + 2 * b; hp = hq + b * 4;
      loop(na,
        xa = xp[0]; xb = xp[1];
          lr += xa * hp[0] - xb * hp[1]; li += xa * hp[1] + xb * hp[0];
          rr += xa * hp[2] - xb * hp[3]; ri += xa * hp[3] + xb * hp[2];
          xp -= n2; hp += hb;
      );
      xp = xx + (pp - 1) * n2 + 2 * b;
      loop(pp - na,
        xa = xp[0]; xb = xp[1];
          lr += xa * hp[0] - xb * hp[1]; li += xa * hp[1] + xb * hp[0];
          rr += xa * hp[2] - xb * hp[3]; ri += xa * hp[3] + xb * hp[2];
          xp -= n2; hp += hb;
      );
      al[2 * b] = lr; al[2 * b + 1] = li; ar[2 * b] = rr; ar[2 * b + 1] = ri;
      b += 1;
  );
);


function e_tick() instance(ebase, eend, LVT, OBL, OBR, HD, WV, DYN, ready, nlev, lst, act, QB0, L, nin, npath, mode, irlen, ncov, span, ph, ywl, ywr, lh, lopen, lerr, lnch, lfsr, lfr, lg, lim, lzl, lsr, lpos, lnc, lrs, lrn, lc, lk, lp, lnin, lnp, lmd, lpm0, lpm1, lpm2, lpm3, wpk, wver, cin0, gsc, age, lxtra, lsub, lacc, lsq, lemax, lmean, lrms_db, lgain, lcal, lratio, lfq, lbk, lwn, ecal, wn, edur, lfkey, lsms, ltot, ls0, etot, es0, ovn, efsr, CE, cen, ecnt, st) local(k, tb, bb, pp, tt, tcn, n2, xx, xc, al, ar, sq, q0, q1, os, n1, src, dst) (
  k = 0;
  loop(nlev,
    tb = LVT + k * 16;
    bb = tb[0]; pp = tb[1]; tt = tb[3]; n2 = tb[10]; tcn = tb[9]; xx = tb[4]; xc = tb[11];
    al = tb[6]; ar = tb[7];
    tcn === 0 ? (
      sq = tb[8] + 1; sq >= pp ? sq = 0; tb[8] = sq;
      memcpy(xx + sq * n2, cin0 + wi + 1 - n2 + RSI, n2);
      age < n2 ? memset(xx + sq * n2, 0, n2 - age);
      fft_real(xx + sq * n2, n2);
      nin > 1 ? (
        memcpy(xx + xc + sq * n2, CINR + wi + 1 - n2 + RSI, n2);
        age < n2 ? memset(xx + xc + sq * n2, 0, n2 - age);
        fft_real(xx + xc + sq * n2, n2);
      );
    ) : sq = tb[8];
    q0 = floor(tcn * bb / tt); q1 = floor((tcn + 1) * bb / tt);
    q1 > q0 ? (
      mode === 0 ? mac_ts(xx, xc, tb[5], tb[13], al, ar, pp, sq, n2, q0, q1) :
      mode === 1 ? mac_st(xx, xc, tb[5], tb[13], al, ar, pp, sq, n2, q0, q1) :
      mac_ms(xx, tb[5], tb[13], al, ar, pp, sq, n2, q0, q1);
    );
    tcn === tt - 1 ? (
      ifft_real(al, n2); ifft_real(ar, n2);
      os = opos + tb[12]; os >= RSO ? os -= RSO;
      n1 = min(bb, RSO - os);
      src = al + bb; dst = OBL + os; loop(n1, dst[] += src[]; dst += 1; src += 1;);
      dst = OBL; loop(bb - n1, dst[] += src[]; dst += 1; src += 1;);
      src = ar + bb; dst = OBR + os; loop(n1, dst[] += src[]; dst += 1; src += 1;);
      dst = OBR; loop(bb - n1, dst[] += src[]; dst += 1; src += 1;);
      tb[9] = 0;
    ) : tb[9] = tcn + 1;
    k += 1;
  );
);

function e_sample() instance(ebase, eend, LVT, OBL, OBR, HD, WV, DYN, ready, nlev, lst, act, QB0, L, nin, npath, mode, irlen, ncov, span, ph, ywl, ywr, lh, lopen, lerr, lnch, lfsr, lfr, lg, lim, lzl, lsr, lpos, lnc, lrs, lrn, lc, lk, lp, lnin, lnp, lmd, lpm0, lpm1, lpm2, lpm3, wpk, wver, cin0, gsc, age, lxtra, lsub, lacc, lsq, lemax, lmean, lrms_db, lgain, lcal, lratio, lfq, lbk, lwn, ecal, wn, edur, lfkey, lsms, ltot, ls0, etot, es0, ovn, efsr, CE, cen, ecnt, st) local(xl, xr, hp, a0, a1, v0, v1) (
  quiet > span ? (
    ywl = ywr = 0;
    ph += 1; ph >= QB0 ? ph = 0;
  ) : (
    age < 65536 ? age += 1;
    ph += 1; ph >= QB0 ? ( ph = 0; this.e_tick(); );
    ywl = OBL[opos]; ywr = OBR[opos]; OBL[opos] = 0; OBR[opos] = 0;
    L === 0 ? (
      mode === 0 ? (
      xl = CINL + wi + RSI; xr = CINR + wi + RSI; hp = HD; a0 = a1 = 0;
      loop(min(QB0, age), v0 = xl[]; v1 = xr[]; a0 += v0 * hp[0] + v1 * hp[2]; a1 += v0 * hp[1] + v1 * hp[3]; xl -= 1; xr -= 1; hp += 4;);
      ywl += a0; ywr += a1;
      ) : mode === 1 ? (
      xl = CINL + wi + RSI; xr = CINR + wi + RSI; hp = HD; a0 = a1 = 0;
      loop(min(QB0, age), a0 += xl[] * hp[0]; a1 += xr[] * hp[1]; xl -= 1; xr -= 1; hp += 2;);
      ywl += a0; ywr += a1;
      ) : (
      xl = cin0 + wi + RSI; hp = HD; a0 = a1 = 0;
      loop(min(QB0, age), v0 = xl[]; a0 += v0 * hp[0]; a1 += v0 * hp[1]; xl -= 1; hp += 2;);
      ywl += a0; ywr += a1;
      );
    );
  );
);

function e_pow() instance(ebase, eend, LVT, OBL, OBR, HD, WV, DYN, ready, nlev, lst, act, QB0, L, nin, npath, mode, irlen, ncov, span, ph, ywl, ywr, lh, lopen, lerr, lnch, lfsr, lfr, lg, lim, lzl, lsr, lpos, lnc, lrs, lrn, lc, lk, lp, lnin, lnp, lmd, lpm0, lpm1, lpm2, lpm3, wpk, wver, cin0, gsc, age, lxtra, lsub, lacc, lsq, lemax, lmean, lrms_db, lgain, lcal, lratio, lfq, lbk, lwn, ecal, wn, edur, lfkey, lsms, ltot, ls0, etot, es0, ovn, efsr, CE, cen, ecnt, st) local(a, j) (
  a = ecnt - L;
  a <= 0 ? 0 : ( j = floor(a / 256); j >= cen ? 1 : CE[j]; );
);

function e_load_begin(xadd, fkey, sms) instance(ebase, eend, LVT, OBL, OBR, HD, WV, DYN, ready, nlev, lst, act, QB0, L, nin, npath, mode, irlen, ncov, span, ph, ywl, ywr, lh, lopen, lerr, lnch, lfsr, lfr, lg, lim, lzl, lsr, lpos, lnc, lrs, lrn, lc, lk, lp, lnin, lnp, lmd, lpm0, lpm1, lpm2, lpm3, wpk, wver, cin0, gsc, age, lxtra, lsub, lacc, lsq, lemax, lmean, lrms_db, lgain, lcal, lratio, lfq, lbk, lwn, ecal, wn, edur, lfkey, lsms, ltot, ls0, etot, es0, ovn, efsr, CE, cen, ecnt, st) (
  ready = 0; lst = 0; lerr = 0;
  lxtra = xadd; lfkey = fkey; lsms = sms; lsr = srate;
  lh >= 0 && lopen ? file_close(lh);
  lopen = 0;
  src_key === fkey ? ( lpos = 0; lst = 5; ) : (
    lh = file_open(#ldpath);
    lh < 0 ? ( lerr = 1; lst = -1; ) : (
      lopen = 1;
      lnch = 0; lfsr = 0;
      file_riff(lh, lnch, lfsr);
      (lnch < 1 || lfsr < 1000) ? ( file_close(lh); lopen = 0; lerr = 2; lst = -1; ) : (
        ltot = floor(file_avail(lh) / lnch);
        lnc = min(lnch, 2);
        ltot = min(ltot, min(floor(lfsr * SRC_SEC), floor(SRCMAX / lnc)));
