cl = ((nlh * 65536 + nll) / 4294967296 * 2 - 1) * NZS;
cr = ((nrh * 65536 + nrl) / 4294967296 * 2 - 1) * NZS;
CINL[wi] = cl; CINL[wi + RSI] = cl; CINR[wi] = cr; CINR[wi + RSI] = cr;
wl = wr = 0;
pc = 1;
cur === 1 ? ( ea.ecnt += 1; pc = ea.e_pow(); ) : cur === 2 ? ( eb.ecnt += 1; pc = eb.e_pow(); );
kp = 0;
kill ? (
  kpos += 1; ka = min(1, kpos / FADE); kgn = kg0 * cos(ka * $pi * 0.5);
  kill === 1 ? ( ea.gsc = kgn; ea.ecnt += 1; kp = kgn * kgn * ea.e_pow(); ) : ( eb.gsc = kgn; eb.ecnt += 1; kp = kgn * kgn * eb.e_pow(); );
  ka >= 1 ? ( e_free(kill); kill = 0; );
);
kill2 ? (
  kpos2 += 1; ka = min(1, kpos2 / FADE);
