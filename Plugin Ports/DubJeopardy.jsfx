// Modified 2026: translated to JSFX from mda DubDelay (mda-effects).
// https://github.com/pluginguru/mda-effects

slider1:p_delay=0.5<0,1,0.001>-Delay
slider2:p_fb=0.7<0,1,0.001>-Feedback
slider3:p_tone=0.4<0,1,0.001>-Fb Tone
slider4:p_lfod=0<0,1,0.001>-LFO Depth
slider5:p_lfor=0.5<0,1,0.001>-LFO Rate
slider6:p_mix=0.33<0,1,0.001>-FX Mix
slider7:p_out=0.5<0,1,0.001>-Output

in_pin:Left input
in_pin:Right input
out_pin:Left output
out_pin:Right output
options:no_meter

@init

ext_noinit = gfx_ext_retina = 1;
ext_nodenorm = 1;

SIZE = 323766;
BUF = 0;
memset(BUF, 0, SIZE + 2);
dd_i = 0;
dd_f0 = 0;
dd_env = 0;
dd_phi = 0;
dd_dl = 0;

function dd_set()
local(fs)
(
  fs = srate;
  fs < 8000 ? fs = 44100;
  dd_del = p_delay * p_delay * SIZE;
  dd_mod = 0.049 * p_lfod * dd_del;
  dd_fil = p_tone;
  p_tone > 0.5 ? (
    dd_fil = 0.5 * dd_fil - 0.25;
    dd_lmix = -2 * dd_fil;
    dd_hmix = 1;
  ) : (
    dd_hmix = 2 * dd_fil;
    dd_lmix = 1 - dd_hmix;
  );
  dd_fil = exp((-6.2831853 * (10 ^ (2.2 + 4.5 * dd_fil))) / fs);
  dd_fbk = abs(2.2 * p_fb - 1.1);
  dd_rel = p_fb > 0.5 ? 0.9997 : 0.8;
  dd_wet = 1 - p_mix;
  dd_wet = p_out * (1 - dd_wet * dd_wet);
  dd_dry = p_out * 2 * (1 - p_mix * p_mix);
  dd_dphi = (628.31853 * (10 ^ (3 * p_lfor - 2))) / fs;
);

dd_set();

@slider

last_srate != srate ? (
  last_srate = srate;
  meter_decay = 0.001 ^ (1 / (0.4 * srate));
);
dd_set();

@block

dd_set();
abs(dd_f0) < 0.0000000001 ? ( dd_f0 = 0; dd_env = 0; );
dd_db = dd_dl;
dd_ddl = 0;
dd_k = 0;

@sample

dd_a = spl0;
dd_b = spl1;
dd_k == 0 ? (
  dd_db += 0.01 * (((dd_del - dd_db) - dd_mod) - dd_mod * sin(dd_phi));
  dd_ddl = 0.01 * (dd_db - dd_dl);
  dd_phi += dd_dphi;
  dd_phi > 6.2831853 ? dd_phi -= 6.2831853;
  dd_k = 100;
);
dd_k -= 1;
dd_dl += dd_ddl;
dd_i -= 1;
dd_i < 0 ? dd_i = SIZE;
dd_l = dd_dl | 0;
dd_t = dd_dl - dd_l;
dd_l += dd_i;
dd_l > SIZE ? dd_l -= SIZE + 1;
dd_ol = dd_dl < 1 ? 0 : BUF[dd_l];
dd_l += 1;
dd_l > SIZE ? dd_l = 0;
dd_ol += dd_t * (BUF[dd_l] - dd_ol);
dd_t = dd_a + dd_fbk * dd_ol;
dd_f0 = dd_fil * (dd_f0 - dd_t) + dd_t;
dd_t = dd_lmix * dd_f0 + dd_hmix * dd_t;
dd_g = abs(dd_t);
dd_env *= dd_rel;
dd_g > dd_env ? dd_env = dd_g;
dd_env > 1 ? dd_t /= dd_env;
BUF[dd_i] = dd_t;
dd_ol *= dd_wet;
spl0 = dd_dry * dd_a + dd_ol;
spl1 = dd_dry * dd_b + dd_ol;

m_l = max(abs(dd_a), abs(dd_b));
m_l > ipk ? ipk = m_l : ipk *= meter_decay;
m_l = max(abs(spl0), abs(spl1));
m_l > opk ? opk = m_l : opk *= meter_decay;

@gfx 760 336

DW = 760;
DH = 336;
scale = max(0.5, min(gfx_w / DW, gfx_h / DH));
ox = floor((gfx_w - DW*scale) * 0.5);
oy = 0;

MARGIN = 14*scale;
CW = 92*scale;
KR = 28*scale;
PANEL_H = 128*scale;

function automate(s, end_touch)
(
<?
  max_sliders > 7 ? printf("slider_automate(2^(s-1), end_touch);") :
    printf("s == 1 ? slider_automate(p_delay, end_touch) : s == 2 ? slider_automate(p_fb, end_touch) : s == 3 ? slider_automate(p_tone, end_touch) : s == 4 ? slider_automate(p_lfod, end_touch) : s == 5 ? slider_automate(p_lfor, end_touch) : s == 6 ? slider_automate(p_mix, end_touch) : s == 7 ? slider_automate(p_out, end_touch) :");
?> 0;
);

function g_trunc(x) ( x < 0 ? ceil(x) : floor(x); );

function def_val(s)
(
  s == 1 ? 0.5 : s == 2 ? 0.7 : s == 3 ? 0.4 : s == 4 ? 0 : s == 5 ? 0.5 : s == 6 ? 0.33 : 0.5;
);

function knob_name(s)
(
  s == 1 ? "Delay" : s == 2 ? "Feedback" : s == 3 ? "Fb Tone" : s == 4 ? "LFO Depth" : s == 5 ? "LFO Rate" : s == 6 ? "FX Mix" : "Output";
);

function hint_text(s)
(
  s == 1 ? "Delay: echo time; turn it while the echoes ring for the pitch-sliding dub throw" :
  s == 2 ? "Feedback: left of centre saturates the repeats, right of centre limits them (up to 110%)" :
  s == 3 ? "Fb Tone: left darkens every repeat, right thins it out; centre is flat" :
  s == 4 ? "LFO Depth: how much the LFO wobbles the delay time" :
  s == 5 ? "LFO Rate: time for one LFO cycle, 100 seconds down to 0.1 second" :
  s == 6 ? "FX Mix: balance of the dry signal and the echoes (-3 dB each at 50%)" :
  s == 7 ? "Output: overall level, -inf to +6 dB" :
  "Drag or scroll a knob to adjust  ·  Ctrl for fine control  ·  double-click to reset";
);

function g_del_ms() ( g_trunc((p_delay * p_delay * SIZE * 1000) / srate); );
function g_fb_txt()
local(v)
(
  v = g_trunc(220 * p_fb - 110);
  v < 0 ? sprintf(#gfbt, "%d Sat", v) : v > 0 ? sprintf(#gfbt, "%d Lim", v) : strcpy(#gfbt, "0");
  #gfbt;
);

function ptext(s)
local(v)
(
  s == 1 ? sprintf(#ptxt, "%d ms", g_del_ms()) :
  s == 2 ? strcpy(#ptxt, g_fb_txt()) :
  s == 3 ? (
    v = g_trunc(200 * p_tone - 100);
    v < 0 ? sprintf(#ptxt, "%d Lo", v) : v > 0 ? sprintf(#ptxt, "+%d Hi", v) : strcpy(#ptxt, "0");
  ) :
  s == 4 ? sprintf(#ptxt, "%d %%", g_trunc(100 * p_lfod)) :
  s == 5 ? sprintf(#ptxt, "%.2f sec", 10 ^ (2 - 3 * p_lfor)) :
  s == 6 ? sprintf(#ptxt, "%d %%", g_trunc(100 * p_mix)) :
  (p_out > 0 ? sprintf(#ptxt, "%d dB", g_trunc(20 * log10(2 * p_out))) : strcpy(#ptxt, "-inf dB"));
  #ptxt;
);

function set_slider(s, gv) ( slider(s) = gv; automate(s, 0); automate(s, 1); );
function hit_circle(mx, my, cx, cy, rad) ( sqr(mx - cx) + sqr(my - cy) <= sqr(rad); );
function hit_rect(mx, my, x, y, w, h) ( mx >= x && mx <= x+w && my >= y && my <= y+h; );

function upper(str)
local(i, c)
(
  i = 0;
  loop(strlen(str),
    c = str_getchar(str, i);
    (c >= 97 && c <= 122) ? str_setchar(str, i, c - 32);
    i += 1;
  );
  str;
);

function draw_knob(cx, cy, rad, pos, cr, cg, cb, valtext, name)
local(ang0, ang1, ang, i, tx, ty)
(
  ang0 = -2.35619;
  ang1 =  2.35619;
  gfx_set(0.05, 0.05, 0.06, 1);
  gfx_circle(cx, cy, rad + 2*scale, 1, 1);
  gfx_set(cr*0.55, cg*0.55, cb*0.55, 1);
  gfx_circle(cx, cy, rad, 1, 1);
  gfx_set(cr, cg, cb, 1);
  gfx_circle(cx, cy, rad*0.72, 1, 1);
  gfx_set(1, 1, 1, 0.18);
  gfx_circle(cx - rad*0.28, cy - rad*0.28, rad*0.42, 1, 1);
  i = 0;
  loop(9,
    ang = ang0 + (ang1 - ang0) * (i / 8);
    gfx_set(0.85, 0.85, 0.85, 0.7);
    gfx_line(cx + sin(ang)*rad*0.82, cy - cos(ang)*rad*0.82, cx + sin(ang)*rad*0.98, cy - cos(ang)*rad*0.98, 1);
    i += 1;
  );
  ang = ang0 + (ang1 - ang0) * pos;
  gfx_set(0.05, 0.05, 0.05, 1);
  gfx_line(cx, cy, cx + sin(ang)*rad*0.85, cy - cos(ang)*rad*0.85, 1);
  gfx_setfont(1, "Arial", 14*scale);
  gfx_set(0.85, 0.85, 0.85, 1);
  gfx_measurestr(valtext, tx, ty);
  gfx_x = cx - tx*0.5; gfx_y = cy - rad - 18*scale;
  gfx_drawstr(valtext);
  gfx_set(0.8, 0.8, 0.82, 1);
  gfx_measurestr(name, tx, ty);
  gfx_x = cx - tx*0.5; gfx_y = cy + rad + 7*scale;
  gfx_drawstr(name);
);

function lcd_touch(s) ( lcd_sl = s; lcd_t = time_precise(); );

function row_begin(y, nk, ns)
(
  rx = ox + (DW*scale - (nk*CW + ns*8*scale + (ns - 1)*10*scale)) * 0.5;
  ry = oy + y;
);

function sec(nk, title, cr, cg, cb)
local(w, tw, th)
(
  w = nk*CW + 8*scale;
  gfx_set(0.035, 0.035, 0.04, 1);
  gfx_rect(rx - scale, ry - scale, w + 2*scale, PANEL_H + 2*scale, 1);
  gfx_set(0.125, 0.125, 0.14, 1);
  gfx_rect(rx, ry, w, PANEL_H, 1);
  gfx_set(cr, cg, cb, 0.8);
  gfx_rect(rx, ry, w, max(1, 2*scale), 1);
  gfx_setfont(1, "Arial", 12*scale, 'b');
  gfx_set(cr*0.75 + 0.15, cg*0.75 + 0.15, cb*0.75 + 0.15, 1);
  gfx_measurestr(title, tw, th);
  gfx_x = rx + (w - tw)*0.5; gfx_y = ry + 5*scale;
  gfx_drawstr(title);
  k_sx = rx + 4*scale; k_col = 0;
  k_r = cr; k_g = cg; k_b = cb;
  rx += w + 10*scale;
);

function set_norm(s, gv)
local(old)
(
  old = slider(s);
  slider(s) = floor(gv*1000 + 0.5) / 1000;
  slider(s) !== old ? automate(s, 0);
);

function knob_at(s, cx, cy, rad, cr, cg, cb)
local(hov, gv)
(
  hov = hit_circle(mouse_x, mouse_y, cx, cy, rad + 4*scale);
  hov ? hov_s = s;
  (mouse_just_down && hov) ? (
    (click_target == s && time_precise() - click_time < 0.3) ? (
      set_slider(s, def_val(s));
      drag_target = 0;
      lcd_touch(s);
    ) : (
      drag_target = s; drag_y0 = mouse_y; drag_v0 = slider(s); drag_fine = mouse_cap & 4;
    );
    click_target = s; click_time = time_precise();
  );
  (hov && mouse_wheel != 0 && drag_target == 0) ? (
    gv = slider(s) + (mouse_wheel / 120) * ((mouse_cap & 4) ? 0.001 : 0.01);
    set_norm(s, max(0, min(1, gv)));
    automate(s, 1);
    lcd_touch(s);
    mouse_wheel = 0;
  );
  draw_knob(cx, cy, rad, slider(s), cr, cg, cb, ptext(s), knob_name(s));
);

function seg_btn(s, x, y, w, h, label, act, fs)
local(tw, th, gap, hov)
(
  hov = hit_rect(mouse_x, mouse_y, x, y, w, h);
  hov ? hov_s = s;
  gap = max(1, scale);
  gfx_set(0.03, 0.03, 0.04, 1);
  gfx_rect(x - gap, y - gap, w + 2*gap, h + 2*gap, 1);
  act ? gfx_set(acc_r*0.62, acc_g*0.62, acc_b*0.62, 1) : gfx_set(hov ? 0.17 : 0.14, hov ? 0.17 : 0.14, hov ? 0.19 : 0.16, 1);
  gfx_rect(x, y, w, h, 1);
  act ? gfx_set(acc_r, acc_g, acc_b, 1) : gfx_set(0.21, 0.21, 0.24, 1);
  gfx_rect(x + gap, y + gap, w - 2*gap, h*0.5, 1);
  gfx_set(1, 1, 1, act ? 0.22 : 0.08);
  gfx_rect(x + gap, y + gap, w - 2*gap, h*0.3, 1);
  gfx_setfont(1, "Arial", fs*scale, 'b');
  act ? gfx_set(0.08, 0.08, 0.10, 1) : gfx_set(0.78, 0.78, 0.80, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + (w - tw)*0.5; gfx_y = y + (h - th)*0.5;
  gfx_drawstr(label);
  mouse_just_down && hov;
);

function knob(s)
local(cx, cy)
(
  cx = k_sx + CW*(k_col + 0.5);
  cy = ry + 72*scale;
  k_col += 1;
  knob_at(s, cx, cy, KR, k_r, k_g, k_b);
);

function glow_text(str, x, y, r, g, b)
(
  gfx_set(r, g, b, 0.16);
  gfx_x = x - scale; gfx_y = y; gfx_drawstr(str);
  gfx_x = x + scale; gfx_y = y; gfx_drawstr(str);
  gfx_x = x; gfx_y = y - scale; gfx_drawstr(str);
  gfx_x = x; gfx_y = y + scale; gfx_drawstr(str);
  gfx_set(r, g, b, 1);
  gfx_x = x; gfx_y = y; gfx_drawstr(str);
);

function meter(x, y, w, h, pk, label)
local(db, fy, tw, th)
(
  gfx_setfont(1, "Arial", 11*scale, 'b');
  gfx_set(0.62, 0.63, 0.66, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + w*0.5 - tw*0.5; gfx_y = y;
  gfx_drawstr(label);
  y += th + 3*scale;
  h -= th + 3*scale;
  gfx_set(0.04, 0.04, 0.05, 1);
  gfx_rect(x - scale, y - scale, w + 2*scale, h + 2*scale, 1);
  gfx_set(acc_r*0.22, acc_g*0.22, acc_b*0.22, 1);
  gfx_rect(x, y, w, h, 1);
  db = pk > 0.000001 ? 20 * log10(pk) : -100;
  fy = y + h * (1 - max(0, min(1, (db + 60) / 60)));
  db > -1 ? gfx_set(1.0, 0.35, 0.30, 1) : gfx_set(acc_r, acc_g, acc_b, 1);
  gfx_rect(x, fy, w, y + h - fy, 1);
);

function head(title, sub)
(
  gfx_set(0.09, 0.08, 0.09, 1);
  gfx_rect(0, 0, gfx_w, gfx_h, 1);
  gfx_setfont(1, "Arial", 20*scale, 'b');
  gfx_set(acc_r, acc_g, acc_b, 1);
  gfx_x = ox + MARGIN; gfx_y = oy + 8*scale;
  gfx_drawstr(title);
  gfx_setfont(1, "Arial", 13*scale);
  gfx_set(0.58, 0.60, 0.64, 1);
  gfx_x = ox + MARGIN + 2*scale; gfx_y = oy + 30*scale;
  gfx_drawstr(sub);
);

function hline(y) ( gfx_set(0.04, 0.04, 0.05, 1); gfx_rect(0, oy + y, gfx_w, max(1, scale), 1); );

function lcd_frame(w)
(
  LX = ox + MARGIN; LY = oy + 56*scale; LW = w*scale; LH = 96*scale;
  gfx_set(0.03, 0.03, 0.04, 1);
  gfx_rect(LX - 2*scale, LY - 2*scale, LW + 4*scale, LH + 4*scale, 1);
  gfx_set(0.17, 0.17, 0.19, 1);
  gfx_rect(LX, LY, LW, LH, 1);
  GX = LX + 6*scale; GY = LY + 6*scale; GW = LW - 12*scale; GH = LH - 12*scale;
  gfx_set(0.02, 0.02, 0.02, 1);
  gfx_rect(GX - scale, GY - scale, GW + 2*scale, GH + 2*scale, 1);
  gfx_set(0.035 + acc_r*0.05, 0.035 + acc_g*0.05, 0.035 + acc_b*0.05, 1);
  gfx_rect(GX, GY, GW, GH, 1);
  lc_r = min(1, 0.35 + acc_r*0.75); lc_g = min(1, 0.35 + acc_g*0.75); lc_b = min(1, 0.35 + acc_b*0.75);
  TAW = 230*scale;
  SDX = GX + TAW + 12*scale;
  gfx_set(lc_r, lc_g, lc_b, 0.18);
  gfx_rect(SDX, GY + 8*scale, max(1, scale), GH - 16*scale, 1);
  VX = SDX + 12*scale; VW = GX + GW - 10*scale - VX;
  VY = GY + 8*scale; VH = GH - 16*scale;
);

function lcd_text(top_l, top_r, big)
local(tw, th)
(
  gfx_setfont(2, "Courier New", 14*scale, 'b');
  glow_text(top_l, GX + 10*scale, GY + 6*scale, lc_r, lc_g, lc_b);
  gfx_measurestr(top_r, tw, th);
  glow_text(top_r, GX + TAW - tw, GY + 6*scale, lc_r, lc_g, lc_b);
  gfx_setfont(2, "Courier New", 26*scale, 'b');
  gfx_measurestr(big, tw, th);
  glow_text(big, GX + 10*scale + (TAW - 10*scale - tw)*0.5, GY + 26*scale + (26*scale - th)*0.5, lc_r, lc_g, lc_b);
  gfx_setfont(2, "Courier New", 14*scale, 'b');
  LY3 = GY + GH - 20*scale;
);

function lcd_bottom(idle)
local(tw, th)
(
  (lcd_sl > 0 && time_precise() - lcd_t < 1.5) ? (
    strcpy(#lt, knob_name(lcd_sl)); upper(#lt);
    glow_text(#lt, GX + 10*scale, LY3, lc_r, lc_g, lc_b);
    strcpy(#lv, ptext(lcd_sl)); upper(#lv);
    gfx_measurestr(#lv, tw, th);
    glow_text(#lv, GX + TAW - tw, LY3, lc_r, lc_g, lc_b);
  ) : (
    gfx_measurestr(idle, tw, th);
    glow_text(idle, GX + 10*scale + (TAW - 10*scale - tw)*0.5, LY3, lc_r, lc_g, lc_b);
  );
);

function lcd_glass()
(
  gfx_set(0, 0, 0, 0.22);
  scan_y = GY;
  while (scan_y < GY + GH) ( gfx_rect(GX, scan_y, GW, max(1, scale), 1); scan_y += 3*scale; );
  gfx_set(1, 1, 1, 0.035);
  gfx_rect(GX, GY, GW, GH*0.45, 1);
);

function meters(mi, mo)
(
  MW = 16*scale;
  MAX0 = LX + LW + 26*scale;
  MSP = (ox + DW*scale - MARGIN - MAX0 - MW);
  meter(MAX0, LY, MW, LH, mi, "IN");
  meter(MAX0 + MSP, LY, MW, LH, mo, "OUT");
);

function hint_bar(y)
local(hs, htw, hth)
(
  hline(y);
  hs = drag_target > 0 ? drag_target : hov_s;
  gfx_setfont(1, "Arial", 13*scale);
  gfx_set(0.62, 0.63, 0.66, 1);
  strcpy(#ghint, hint_text(hs));
  gfx_measurestr(#ghint, htw, hth);
  htw > (DW - 20)*scale ? ( gfx_setfont(1, "Arial", max(11, 13*scale*(DW - 20)*scale/htw)); gfx_measurestr(#ghint, htw, hth); );
  gfx_x = ox + (DW*scale - htw)*0.5; gfx_y = oy + y + ((DH*scale - y) - hth)*0.5;
  gfx_drawstr(#ghint);
);

function drag_update()
local(fine_now, gv)
(
  drag_target > 0 ? (
    mouse_down ? (
      mouse_cap |= 65536;
      fine_now = mouse_cap & 4;
      fine_now != drag_fine ? ( drag_y0 = mouse_y; drag_v0 = slider(drag_target); drag_fine = fine_now; );
      gv = max(0, min(1, drag_v0 + (drag_y0 - mouse_y) / (150*scale) * (fine_now ? 0.1 : 1)));
      set_norm(drag_target, gv);
      lcd_touch(drag_target);
    ) : ( automate(drag_target, 1); drag_target = 0; );
  );
);

mouse_down = mouse_cap & 1;
mouse_just_down = mouse_down && !mouse_state;
hov_s = 0;
acc_r = 0.62; acc_g = 0.88; acc_b = 0.30;

head("DUB JEOPARDY", "by chmaha  ·  based on mda DubDelay");
hline(46*scale);

lcd_frame(600);
gfbv = abs(2.2 * p_fb - 1.1);
lcd_text("DELAY", p_fb > 0.5 ? "LIMIT" : "SATURATE", sprintf(#lbig, "%d MS", g_del_ms()));
sprintf(#lidle, "FEEDBACK %d%%", g_trunc(gfbv * 100 + 0.0000001));
lcd_bottom(#lidle);

gfx_set(lc_r, lc_g, lc_b, 0.08);
gfx_rect(VX, VY, VW, VH, 1);
gbase = VY + VH - 13*scale;
gtopy = VY + 2*scale;
gfx_set(lc_r, lc_g, lc_b, 0.35);
gfx_rect(VX, gbase, VW, max(1, scale), 1);
gdry = 0.5 * 2 * (1 - p_mix * p_mix);
gwet = 1 - p_mix; gwet = 0.5 * (1 - gwet * gwet);
gnech = 8;
gsp = (VW - 14*scale) / gnech;
gfx_set(lc_r, lc_g, lc_b, 0.45);
gbh = (gbase - gtopy) * max(0, min(1, (20 * log10(max(gdry, 0.0001)) + 36) / 42));
gfx_rect(VX + 4*scale, gbase - gbh, max(2, 6*scale), gbh, 1);
gei = 1;
gamp = gwet;
loop(gnech,
  gex = VX + 4*scale + gei * gsp;
  gbh = (gbase - gtopy) * max(0, min(1, (20 * log10(max(gamp, 0.0001)) + 36) / 42));
  gfx_set(lc_r, lc_g, lc_b, 0.95);
  gfx_rect(gex, gbase - gbh, max(2, 6*scale), gbh, 1);
  gamp *= min(1, gfbv);
  gei += 1;
);
gfx_setfont(1, "Arial", 11*scale, 'b');
gfx_set(lc_r, lc_g, lc_b, 0.8);
gfx_x = VX + 2*scale; gfx_y = gbase + 1*scale; gfx_drawstr("DRY");
sprintf(#gl, "ECHO EVERY %d MS", g_del_ms());
gfx_measurestr(#gl, gtw, gth);
gfx_x = VX + VW - gtw - 2*scale; gfx_y = gbase + 1*scale; gfx_drawstr(#gl);
p_lfod > 0.0005 ? (
  gfx_set(lc_r, lc_g, lc_b, 0.7);
  gli = 0;
  gpy = 0;
  loop(61,
    gyy = gtopy + 6*scale + 4*scale * p_lfod * sin(gli / 60 * 2 * $pi * 3 + dd_phi);
    gli > 0 ? gfx_line(VX + VW - 96*scale + (gli - 1) * 1.5*scale, gpy, VX + VW - 96*scale + gli * 1.5*scale, gyy, 1);
    gpy = gyy;
    gli += 1;
  );
  gfx_x = VX + VW - 128*scale; gfx_y = gtopy; gfx_drawstr("LFO");
);

lcd_glass();
meters(ipk, opk);

hline(162*scale);

row_begin(170*scale, 7, 3);
sec(3, "ECHO", 0.62, 0.88, 0.30); knob(1); knob(2); knob(3);
sec(2, "LFO", 0.98, 0.80, 0.30); knob(4); knob(5);
sec(2, "OUTPUT", 0.80, 0.80, 0.84); knob(6); knob(7);

hint_bar(304*scale);
drag_update();

mouse_wheel = 0;
mouse_state = mouse_down;
