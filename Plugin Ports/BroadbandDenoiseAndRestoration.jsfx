text_c("GAIN REDUCTION", PX + PW * 0.5, PY + PH + 20);

panel(24, 222, 912, 106);
knob(80, 268, 22, 4, 20, 20000, 25, 1, 1, 1, 0.20, 0.42, 0.75, "20", "20k", "Low Freq");
knob(180, 268, 22, 5, 20, 20000, 16000, 1, 1, 1, 0.20, 0.55, 0.28, "20", "20k", "High Freq");
knob(280, 268, 22, 8, -12, 12, 0, 0.1, 0, 0, 0.70, 0.18, 0.20, "-12", "+12", "HF Bias");
knob(380, 268, 22, 9, 0, 100, 0, 1, 0, 2, 0.85, 0.55, 0.15, "0", "100", "St. Link");
knob(480, 268, 22, 10, 0, 100, 100, 1, 0, 2, 0.62, 0.60, 0.22, "0", "100", "Mix");
knob(580, 268, 22, 11, -24, 24, 0, 0.1, 0, 0, 0.50, 0.50, 0.55, "-24", "+24", "Output");
button(680, 236, 70, 30, "HP", hp_on, 0) ? tap_sl(6, !hp_on, 0, 1, 1);
button(758, 236, 70, 30, "LP", lp_on, 0) ? tap_sl(7, !lp_on, 0, 1, 1);
button(836, 236, 92, 30, "ADAPTIVE", adaptive, 0) ? tap_sl(2, !adaptive, 0, 1, 1);
button(680, 276, 70, 30, "SLOW", slow, !adaptive) ? tap_sl(3, !slow, 0, 1, 1);
button(758, 276, 70, 30, "RESET", 0, !adaptive) ? reset_floor = 1;

panel(24, 334, 912, 322);
nudge(32, thr_base, thr_mn, thr_mx, thr_df, 1001);
small_text();
text_r(adaptive ? "Bias (dB)" : "Threshold (dB)", 122, FY - 22);
axis(120, 1, thr_mn, thr_mx, thr_tfirst, thr_tstep, thr_tn);
<?
loop(k = 1; 6,
  printf("band_col(%d, 126 + 112 * %d, cf%d, lvlo%d, lvhi%d, idle ? -999 : disp_lev%d, grlo%d, grhi%d, idle ? -999 : disp_gr%d);\n", k, k - 1, k, k, k, k, k, k, k);
  k += 1);
?>
text_l("Range (dB)", 804, FY - 22);
axis(806, 0, rng_mn, rng_mx, rng_tfirst, rng_tstep, rng_tn);
nudge(868, rng_base, rng_mn, rng_mx, rng_df, 1002);

!down && drag_i ? (
  j = 0;
  loop(drag_n, automate(drag_i + j, 1); j += 1; );
  drag_i = 0;
);
prev_down = down;
