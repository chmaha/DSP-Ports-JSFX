    w = 0;
    diff ? (
      pc_0 = p[278]; pc_1 = p[279]; pc_2 = p[280]; pc_3 = p[281];
      l = l0; loop(lmax - l0, render_lane(p, l, 0, 1); l += 1; );
      w = 1;
    );
    p[278] = OPPS[0]; p[279] = OPPS[1]; p[280] = OPPS[2]; p[281] = OPPS[3];
    pc_0 = OPPS[0]; pc_1 = OPPS[1]; pc_2 = OPPS[2]; pc_3 = OPPS[3];
    nn > w ? ( l = l0; loop(lmax - l0, render_lane(p, l, w, nn - w); l += 1; ); );
