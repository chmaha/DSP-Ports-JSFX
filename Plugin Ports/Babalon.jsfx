function render_voice(v, pos, n) local(p, env, g, gt, i, nn, o, l, k, q, diff, l0, lmax, m1, m2, m3, m4, m5, m6, m7, q0, q1, q2, q3, sl, sr, bv, vl, vr, e, w, gl1, gl2, gl3, gl4, gl5, gl6, gl7, gr1, gr2, gr3, gr4, gr5, gr6, gr7)
(
  p = VST + v * VSS;
  env = p[272]; g = p[273];
  gt = vel_on ? g : (g > 0 ? 1 : 0);
  i = 0;
  while (i < n && (g > 0 || env > 0)) (
    g > 0 ? (
      env < gt ? env = smin((env + ainc), gt) : env > gt ? env = smax((env - ainc), gt);
    ) : (
      env = (env * rc);
      env < (0.0001) ? env = 0;
    );
    EB[i] = env;
    i += 1;
  );
  nn = i;
  p[272] = env;
  nn > 0 ? (
    calc_steps(p);
    o = 0;
    loop(4,
      OPSM[o] !== p[282 + o] ? (
        p[282 + o] = OPSM[o];
        k = 0; loop(8, p[k * 32 + o * 8 + 1] = 1; p[k * 32 + o * 8 + 2] = 1; k += 1; );
      );
      o += 1;
    );
