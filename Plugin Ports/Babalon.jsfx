    gfx_set(1, 1, 1, 1);
    sprintf(#u_t, "%d", a + 1);
    ui_ctext(#u_t, x + w * 0.5, y + h * 0.5, 20 * UQ, 1);
  );
  ui_hit(x, y, w, h) ? u_hov = 11;
);

function ui_voices() local(x0, y0, cw, ch, k, x, y, on, e, hov, row, col)
(
  x0 = ui_sx(-SBU * 0.5 - 62); y0 = ui_py(315.5); cw = 15.5 * UQ; ch = floor(15 * UQ);
  k = 0;
  loop(16,
    row = floor(k / 8); col = k - row * 8;
    x = floor(x0 + col * cw); y = floor(y0 + row * (ch + 2 * UQ));
    hov = ui_hit(x, y, floor(x0 + (col + 1) * cw) - x, ch);
    hov ? ( u_hov = 74; u_click ? ( ui_put(74, k + 1); u_click = 0; ); );
    on = k < ui_ival(74);
    gfx_set(on ? 0.30 : 0.10, on ? 0.30 : 0.10, on ? 0.31 : 0.105, 1);
    gfx_rect(x + 1, y, floor(x0 + (col + 1) * cw) - x - 1, ch);
    e = on ? max(0, min(1, VACT[k])) : 0;
    e > 0.002 ? ( gfx_set(0.929, 0.173, 0.141, 0.25 + 0.6 * e); gfx_rect(x + 1, y, floor(x0 + (col + 1) * cw) - x - 1, ch); );
    hov ? ( gfx_set(1, 1, 1, 0.12); gfx_rect(x + 1, y, floor(x0 + (col + 1) * cw) - x - 1, ch); );
    gfx_set(on ? 1 : 0.58, on ? 1 : 0.58, on ? 1 : 0.6, 1);
    sprintf(#u_t, "%d", k + 1);
    ui_ctext(#u_t, (x + floor(x0 + (col + 1) * cw)) * 0.5, y + ch * 0.5, 11 * UQ / UK, 0);
    k += 1;
  );
);

function ui_kbsend(st, nt, vel) local(gix)
(
  gix = (gq_w & 63) * 3;
  GQ[gix] = st; GQ[gix + 1] = nt; GQ[gix + 2] = vel;
  gq_w += 1;
);

function ui_iswhite(k) local(m) ( m = k - 12 * floor(k / 12); m == 0 || m == 2 || m == 4 || m == 5 || m == 7 || m == 9 || m == 11; );
function ui_bko(m) ( m == 1 ? 1 : m == 3 ? 2 : m == 6 ? 4 : m == 8 ? 5 : 6; );

function ui_keyboard() local(x0, y0, kw, kh, ww, bw, bh, n0, k, wi, x, nt, hk, lit, vel, p, v, e, bx, oct, b, nk, nw)
(
  nk = 49; nw = 29;
  x0 = ui_px(80); y0 = floor(ui_py(262)); kw = 604 * UQ; kh = floor(88 * UQ);
  ww = kw / nw; bw = ww * 0.62; bh = floor(kh * 0.6);
  n0 = 12 * (u_kbo + 1);
  memset(KLIT, 0, 128);
  v = 0;
  loop(16,
    p = VST + v * VSS;
    (v < ui_ival(74) && p[274] >= 0 && p[274] < 128) ? (
      e = p[275] ? max(0.55, min(1, p[272])) : 0;
      KLIT[p[274]] = max(KLIT[p[274]], e);
    );
    v += 1;
  );
  hk = -1;
  ui_hit(x0, y0, kw, kh) ? (
    wi = floor((mouse_x - x0) / ww); wi = max(0, min(nw - 1, wi));
    k = 0; b = -1;
    loop(nk,
      !ui_iswhite(k) ? (
        bx = x0 + (floor(k / 12) * 7 + ui_bko(k - 12 * floor(k / 12))) * ww - bw * 0.5;
        (mouse_x >= bx && mouse_x < bx + bw && mouse_y < y0 + bh) ? b = k;
      );
      k += 1;
    );
    b >= 0 ? hk = n0 + b : (
      oct = floor(wi / 7); k = wi - oct * 7;
      hk = n0 + oct * 12 + (k == 0 ? 0 : k == 1 ? 2 : k == 2 ? 4 : k == 3 ? 5 : k == 4 ? 7 : k == 5 ? 9 : 11);
    );
    u_hov = 100;
  );
  (u_click && hk >= 0) ? (
    vel = floor(40 + 87 * max(0, min(1, (mouse_y - y0) / kh)));
    ui_kbsend(144, hk, vel); u_kbn = hk; u_kbv = vel; u_click = 0;
  );
  u_kbn >= 0 ? (
    !u_down ? ( ui_kbsend(128, u_kbn, 0); u_kbn = -1; ) :
    (hk >= 0 && hk != u_kbn) ? ( ui_kbsend(128, u_kbn, 0); ui_kbsend(144, hk, u_kbv); u_kbn = hk; );
  );
  wi = 0; k = 0;
  loop(nk,
    ui_iswhite(k) ? (
      nt = n0 + k; x = floor(x0 + wi * ww);
      lit = KLIT[nt];
      gfx_set(0.93, 0.93, 0.93, 1);
      gfx_rect(x + 1, y0, floor(x0 + (wi + 1) * ww) - x - 1, kh);
      lit > 0 ? ( gfx_set(0.929, 0.173, 0.141, 0.25 + 0.6 * lit); gfx_rect(x + 1, y0, floor(x0 + (wi + 1) * ww) - x - 1, kh); );
      nt == u_kbn ? ( gfx_set(0, 0, 0, 0.18); gfx_rect(x + 1, y0, floor(x0 + (wi + 1) * ww) - x - 1, kh); );
      k - 12 * floor(k / 12) == 0 ? (
        gfx_set(0.35, 0.35, 0.37, 1);
        sprintf(#u_t, "C%d", floor(nt / 12) - 1);
        ui_ctext(#u_t, (x + floor(x0 + (wi + 1) * ww)) * 0.5, y0 + kh - 9 * UQ, 11 * UQ / UK, 0);
      );
      wi += 1;
    );
    k += 1;
  );
  k = 0;
  loop(nk,
    !ui_iswhite(k) ? (
      nt = n0 + k;
      bx = x0 + (floor(k / 12) * 7 + ui_bko(k - 12 * floor(k / 12))) * ww - bw * 0.5;
      gfx_set(0.08, 0.08, 0.085, 1);
      gfx_rect(floor(bx), y0, floor(bw), bh);
      lit = KLIT[nt];
      lit > 0 ? ( gfx_set(0.929, 0.173, 0.141, 0.35 + 0.6 * lit); gfx_rect(floor(bx), y0, floor(bw), bh); );
      nt == u_kbn ? ( gfx_set(1, 1, 1, 0.2); gfx_rect(floor(bx), y0, floor(bw), bh); );
    );
    k += 1;
  );
);

function ui_obtn(lab, u, v, w, h, id) local(x, y, pw, ph, hov)
(
  x = floor(ui_px(u)); y = floor(ui_py(v)); pw = floor(w * UQ); ph = floor(h * UQ);
  hov = ui_hit(x, y, pw, ph);
  gfx_set(hov ? 0.36 : 0.27, hov ? 0.36 : 0.27, hov ? 0.37 : 0.28, 1);
  gfx_rect(x, y, pw, ph);
  gfx_set(1, 1, 1, 1);
  ui_ctext(lab, x + pw * 0.5, y + ph * 0.5, 13 * UQ, 1);
  hov ? u_hov = id;
  (hov && u_click) ? ( u_click = 0; 1; ) : 0;
);

function ui_hint(h) local(v, f, s)
(
  h == 100 ? strcpy(#u_hint, "Click to play, lower on the key is louder") :
  h == 101 ? strcpy(#u_hint, "Keyboard octave down") :
  h == 102 ? strcpy(#u_hint, "Keyboard octave up") :
  h == 104 ? strcpy(#u_hint, "Click the picture to switch the animation off or on") :
  h == 103 ? strcpy(#u_hint, "Reset Phase: restart every operator of every voice (Reset on Note does this per note)") :
  h >= 110 && h <= 113 ? sprintf(#u_hint, "Operator %d settings: wave table, sync mode and shape mode", h - 109) :
  h >= 1 && h <= 76 ? (
    v = slider(h); f = UFMT[h];
    f == 0 ? sprintf(#u_t, "%.1f %%", v * 100) :
    f == 1 ? strcpy(#u_t, UNB[h] + floor(v + 0.5) - ui_min(h)) :
    f == 2 ? sprintf(#u_t, "%+.2f semitones", v * 12) :
    f == 3 ? sprintf(#u_t, "%+.1f cents", v * 1200) :
    f == 4 ? sprintf(#u_t, "%d", v) :
    f == 5 ? sprintf(#u_t, "%+.1f dB", v) :
    f == 6 ? sprintf(#u_t, "%d ms", v) :
    f == 7 ? strcpy(#u_t, v > 0.5 ? "On" : "Off") :
    f == 9 ? sprintf(#u_t, "%d", v + 1) :
    f == 10 ? sprintf(#u_t, "%+d", v - 10) :
    f == 11 ? sprintf(#u_t, "%.1f %%", v * 400) :
    f == 12 ? sprintf(#u_t, "%+.1f %%", v * 100) :
    sprintf(#u_t, "%g", v);
    sprintf(#u_hint, "%s: %s", 900 + h - 1, #u_t);
  ) : strcpy(#u_hint, "Double-click a knob to reset, Ctrl-drag for fine control");
);

!u_init ? ( ui_inittables(); u_init = 1; u_kbn = -1; u_kbo = 2; u_setm = 0; );

function be_h(n) ( n = sin(n * 12.9898 + 78.233) * 43758.5453; n - floor(n); );
function be_n(x) local(i, f) ( i = floor(x); f = x - i; f = f * f * (3 - 2 * f); be_h(i) * (1 - f) + be_h(i + 1) * f; );

function be_s(x) local(i, f, a, b, c, d)
(
  i = floor(x); f = x - i;
  a = be_h(i - 1); b = be_h(i); c = be_h(i + 1); d = be_h(i + 2);
  b + 0.5 * f * (c - a + f * (2 * a - 5 * b + 4 * c - d + f * (3 * (b - c) + d - a)));
);

function be_snd() local(i, e)
(
  e = 0; i = 0;
  loop(16, i < ui_ival(74) ? e = max(e, VACT[i]); i += 1; );
  e > 0.002;
);

function bh_dx(y) ( y < 168 ? bh_th * (168 - y) : 0; );
function bh_dy(y) ( y < 168 ? bh_b * min(1, (168 - y) / 70) : 0; );

function be_eye(x, y, w, h, ay, v) local(k, sc, xa, ya, fx, fy)
(
  k = (g_ey2 && UQ > UK * 1.25) ? 2 : 1;
  sc = UQ / UK;
  gfx_a = v;
  x += bh_dx(y + h * 0.5); y += bh_dy(y + h * 0.5);
  fx = floor(ui_sx(-SBU)) + x * sc; fy = floor(ui_py(25)) + y * sc;
  xa = ceil(fx); ya = ceil(fy);
  gfx_blit(k == 2 ? 31 : 30, 1, 0, (xa - fx) / sc * k, ay * k + (ya - fy) / sc * k, (w - 1) * k, (h - 1) * k, xa, ya, (w - 1) * sc, (h - 1) * sc);
);

function be_rc(sx, sy, sw, sh, px, py) local(c, s)
(
  px -= sx + sw * 0.5; py -= sy + sh * 0.5;
  c = cos(bh_rot); s = sin(bh_rot);
  be_rx = px - (c * px + s * py); be_ry = py - (c * py - s * px);
);

function ui_head(t, on) local(k, sc, x0, y0, xa, xb, xd, r, y, ya, yb, fx, fy, xh, yh)
(
  bh_amp = on ? bh_amp + (1 - bh_amp) * 0.02 : bh_amp * 0.97;
  bh_amp < 0.002 ? bh_amp = 0;
  bh_th = bh_amp * (1.8 * sin(2 * $pi * t / 8.7 + 2.5 * be_s(t * 0.035 + 21)) + 1.0 * (2 * be_s(t * 0.11 + 3) - 1) + 0.4 * (2 * be_s(t * 0.41 + 6) - 1)) / 128;
  bh_b = bh_amp * 0.8 * (2 * be_s(t * 0.12 + 13) - 1);
  bh_rot = bh_amp * 0.0262 * (0.7 * sin(2 * $pi * t / 26 + 2 * be_s(t * 0.02 + 31)) + 0.3 * (2 * be_s(t * 0.045 + 37) - 1));
  (g_pl && g_hl && bh_amp > 0) ? (
    k = (g_pl2 && g_hl2 && UQ > UK * 1.25) ? 2 : 1; sc = UQ / UK;
    x0 = floor(ui_sx(-SBU)); y0 = floor(ui_py(25));
    xa = floor(x0); xb = floor(ui_sx(0)) - max(1, floor(UQ + 0.5));
    ya = floor(y0 + 3 * sc); yb = floor(y0 + 186 * sc);
    gfx_set(0.157, 0.157, 0.157, 1); gfx_rect(xa, ya, xb - xa, yb - ya);
    gfx_set(1, 1, 1, 1, 1);
    fx = x0 + (4 + bh_dx(92.29)) * sc; fy = y0 + (6 + bh_dy(92.29)) * sc;
    xh = ceil(fx); yh = ceil(fy);
    be_rc((xh - fx) / sc * k, (yh - fy) / sc * k, 170 * k, 168 * k, 85.865 * k, 86.29 * k);
    gfx_blit(k == 2 ? 37 : 36, 1, bh_rot, (xh - fx) / sc * k, (yh - fy) / sc * k, 170 * k, 168 * k, xh, yh, 170 * sc, 168 * sc, be_rx, be_ry);
    gfx_set(1, 1, 1, 1);
    xd = ceil(x0);
    r = ya;
    while (r < yb) (
      y = (r - y0) / sc;
      gfx_blit(k == 2 ? 35 : 34, 1, 0, (6 - bh_dx(y)) * k + (xd - x0) / sc * k, (y - 3 - bh_dy(y) + 2) * k, (xb - xd) / sc * k, k / sc, xd, r, xb - xd, 1);
      r += 1;
    );
    gfx_mode = 0;
  );
);

function ui_embers(t, on) local(k, sc, x0, y0, p, ph, c, u, cs, x, y, a)
(
  (on && !em_on) ? ( em_ps = em_ts; em_pe = em_te; em_ts = t; em_te = 1000000000000; em_on = 1; );
  (!on && em_on) ? ( em_te = t; em_on = 0; );
  (em_on || t < max(em_te, em_pe) + 8) ? (
    sc = UQ / UK; x0 = ui_sx(-SBU); y0 = ui_py(25);
    gfx_mode = 1;
    k = 0;
    loop(8,
      p = 4 + 3 * be_h(k * 5.3 + 1);
      ph = t / p + be_h(k * 2.7 + 3); c = floor(ph); u = ph - c; cs = t - u * p;
      ((cs >= em_ts && cs <= em_te) || (cs >= em_ps && cs <= em_pe)) ? (
        x = 50 + 90 * be_h(c * 3.1 + k * 7.7) + 3 * sin(t * (0.9 + 0.5 * be_h(k * 1.9)) + k * 2.1);
        y = 245 - 25 * be_h(c * 1.3 + k * 4.1) - (120 + 40 * be_h(c * 2.2 + k)) * u;
        a = 0.22 * sin($pi * u) ^ 1.5 * (0.6 + 0.4 * be_h(c * 4.4 + k * 3));
        gfx_set(1, 0.35, 0.12, a * 0.35, 1); gfx_circle(x0 + x * sc, y0 + y * sc, 2.2 * sc, 1, 1);
        gfx_set(1, 0.55, 0.3, a, 1); gfx_circle(x0 + x * sc, y0 + y * sc, (0.6 + 0.4 * be_h(c + k)) * sc, 1, 1);
      );
      k += 1;
    );
    gfx_mode = 0; gfx_a = 1;
  );
);

function ui_eyes() local(t, on, g, k, sc, xa, ya, fl, fx, fy)
(
  !be_t0 ? be_t0 = time_precise();
  t = time_precise() - be_t0;
  on = ((play_state & 1) || be_snd()) && dx_anim > 0.5;
  !em_init ? ( em_init = 1; em_ts = em_te = em_ps = em_pe = -1000000000; );
  be_lv = on ? be_lv + (1 - be_lv) * 0.05 : be_lv * 0.94;
  be_lv < 0.003 ? be_lv = 0;
  ui_head(t, on);
  (g_ey && be_lv > 0) ? (
    fl = max(0, be_n(t * 0.21 + 7) - 0.7) * 3.3; fl *= fl;
    g = be_lv * (0.3 + 0.55 * be_n(t * 0.6) + 0.15 * be_n(t * 2.3 + 40) + 0.45 * fl);
    gfx_mode = 1;
    g_cr ? (
      k = (g_cr2 && UQ > UK * 1.25) ? 2 : 1; sc = UQ / UK;
      gfx_a = be_lv * (0.3 + 0.5 * be_n(t * 0.3 + 70) + 0.12 * be_n(t * 1.4 + 90) + 0.35 * fl);
      fx = floor(ui_sx(-SBU)) + (4 + bh_dx(92.29)) * sc; fy = floor(ui_py(25)) + (3 + bh_dy(92.29)) * sc;
      xa = ceil(fx); ya = ceil(fy);
      be_rc((xa - fx) / sc * k, (ya - fy) / sc * k, 170 * k, 171 * k, 85.865 * k, 89.29 * k);
      gfx_blit(k == 2 ? 33 : 32, 1, bh_rot, (xa - fx) / sc * k, (ya - fy) / sc * k, 170 * k, 171 * k, xa, ya, 170 * sc, 171 * sc, be_rx, be_ry);
    );
    g *= 0.72 + 0.28 * be_n(t * 1.1 + 11);
    be_eye(107, 105, 20, 20, 0, g);
    be_eye(129, 106, 24, 22, 20, g);
    gfx_mode = 0; gfx_a = 1;
  );
  ui_embers(t, on);
);

