      ui_bz(208.79 + o, 112.5, 15.87); ui_bz(250.04 + o, 112.5, 15.87); ui_bz(291.29 + o, 112.5, 15.87);
    );
    ui_ledbase(200.25 + o, 36.7); ui_ledbase(229.91 + o, 156); ui_ledbase(229.91 + o, 174.75);
    ui_ledbase(276.56 + o, 156); ui_ledbase(276.56 + o, 174.75);
    op += 1;
