        m2 = LB[2 * LBS + i]; m3 = LB[3 * LBS + i]; m4 = LB[4 * LBS + i];
        m5 = cs >= 5 ? LB[5 * LBS + i] : 0; m6 = cs >= 6 ? LB[6 * LBS + i] : 0; m7 = cs >= 7 ? LB[7 * LBS + i] : 0;
        q0 = (m4 * gl4);
        q1 = ((m1 * gl1) + (m5 * gl5));
        q2 = ((m2 * gl2) + (m6 * gl6));
        q3 = ((m3 * gl3) + (m7 * gl7));
        sl = ((((q0 + q1) + q2) + q3) * outlev);
        stereo ? (
          q0 = (m4 * gr4);
          q1 = ((m1 * gr1) + (m5 * gr5));
          q2 = ((m2 * gr2) + (m6 * gr6));
          q3 = ((m3 * gr3) + (m7 * gr7));
          sr = ((((q0 + q1) + q2) + q3) * outlev);
        ) : sr = sl;
