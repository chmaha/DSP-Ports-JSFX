    ui_ttext("Velocity", 421, 225, 11); ui_ttext("Spread", 490, 225, 11); ui_ttext("Reset", 559, 225, 11); ui_ttext("on Note", 559, 235, 11);
    ui_ttext("Volume", 628, 239.5, 12); ui_ttext("Sync Source", 159, 227.5, 10);
