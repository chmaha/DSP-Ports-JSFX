function ui_click_at(s)
(
  (u_ctarget == s && time_precise() - u_ctime < 0.3) ? (
    ui_put(s, ui_def(s));
    u_drag = 0;
  ) : (
    u_drag = s; u_dy0 = mouse_y; u_dv0 = ui_norm(s); u_dfine = mouse_cap & 4;
  );
  u_ctarget = s; u_ctime = time_precise();
  u_click = 0;
);

function ui_bar(cx, cy, ca, sa, r0, r1, hw) local(x0, y0, x1, y1, xx, yy, dx, dy, ss, tt, cv)
(
  x0 = floor(min(cx + sa * r0, cx + sa * r1) - hw - 2); x1 = ceil(max(cx + sa * r0, cx + sa * r1) + hw + 2);
  y0 = floor(min(cy - ca * r0, cy - ca * r1) - hw - 2); y1 = ceil(max(cy - ca * r0, cy - ca * r1) + hw + 2);
  yy = y0;
  loop(y1 - y0 + 1,
    xx = x0;
    loop(x1 - x0 + 1,
      dx = xx + 0.5 - cx; dy = yy + 0.5 - cy;
      ss = dx * sa - dy * ca; tt = dx * ca + dy * sa;
      cv = max(0, min(1, min(ss - r0, r1 - ss) + 0.5)) * max(0, min(1, hw - abs(tt) + 0.5));
      cv > 0 ? ( gfx_a = cv; gfx_rect(xx, yy, 1, 1); );
      xx += 1;
    );
    yy += 1;
  );
  gfx_a = 1;
);

function ui_knob(s, u, v, r, col) local(cx, cy, rr, hov, n, a, ca, sa, cr, cg, cb, hr, hg, hb, rc)
(
  cx = ui_px(u); cy = ui_py(v); rr = r * UQ;
  hov = ui_hitc(cx, cy, rr + 2);
  hov ? u_hov = s;
  (u_click && hov) ? ui_click_at(s);
  (hov && u_wheel != 0 && u_drag == 0) ? (
    ui_stp(s) >= 1 ? ui_put(s, slider(s) + (u_wheel > 0 ? 1 : -1) * ui_stp(s))
                   : ( ui_setn(s, ui_norm(s) + (u_wheel / 120) * ((mouse_cap & 4) ? 0.002 : 0.02)); automate(s, 1); );
    u_wheel = 0;
  );
  col == 0 ? ( cr = 0.220; cg = 0.455; cb = 0.812; hr = 0.345; hg = 0.533; hb = 0.820; ) :
  col == 1 ? ( cr = 0.533; cg = 0.329; cb = 0.663; hr = 0.600; hg = 0.302; hb = 0.788; ) :
  col == 2 ? ( cr = 0.890; cg = 0.098; cb = 0.353; hr = 0.922; hg = 0.369; hb = 0.545; ) :
  col == 3 ? ( cr = 0.031; cg = 0.616; cb = 0.706; hr = 0.302; hg = 0.722; hb = 0.788; ) :
  col == 4 ? ( cr = 0.890; cg = 0.525; cb = 0.098; hr = 0.922; hg = 0.667; hb = 0.369; ) :
             ( cr = 0.890; cg = 0.890; cb = 0.890; hr = 0.949; hg = 0.949; hb = 0.949; );
  n = max(0, min(1, ui_norm(s)));
  a = (-0.75 + 1.5 * n) * $pi;
  ca = cos(a); sa = sin(a);
  gfx_set(0, 0, 0, 1); gfx_circle(cx, cy, rr, 1, 1);
  gfx_set(0.22, 0.22, 0.22, 1); gfx_circle(cx, cy, rr * 0.80, 0, 1);
  (hov || u_drag == s) ? gfx_set(hr, hg, hb, 1) : gfx_set(cr, cg, cb, 1);
  gfx_circle(cx, cy, rr * 0.62, 1, 1);
  ui_bar(cx, cy, ca, sa, rr * 0.45, rr * 0.97, max(1, rr * 0.055));
);

function ui_lamp(cx, cy, r, cr_, cg_, cb_, on)
(
  on > 0.01 ? (
    gfx_set(cr_, cg_, cb_, 0.25 * on); gfx_circle(cx, cy, r * 1.6, 1, 1);
    gfx_set(0.235 + (cr_ - 0.235) * on, 0.235 + (cg_ - 0.235) * on, 0.235 + (cb_ - 0.235) * on, 1);
    gfx_circle(cx, cy, r, 1, 1);
    gfx_set(1, 1, 1, 0.35 * on); gfx_circle(cx - r * 0.3, cy - r * 0.3, r * 0.35, 1, 1);
  ) : (
    gfx_set(0.16, 0.16, 0.16, 1); gfx_circle(cx, cy, r, 1, 1);
  );
);

function ui_ledx(id, u, v, on) local(cx, cy, hov)
(
  cx = ui_px(u); cy = ui_py(v);
  hov = ui_hitc(cx, cy, 9 * UQ);
  hov ? u_hov = id;
  ui_lamp(cx, cy, 4.6 * UQ, 0.929, 0.173, 0.141, on);
  hov ? ( gfx_set(1, 1, 1, 0.5); gfx_circle(cx, cy, 8 * UQ, 0, 1); );
  (u_click && hov) ? ( u_click = 0; 1; ) : 0;
);

function ui_led(s, u, v) ( ui_ledx(s, u, v, slider(s) > 0.5) ? ui_put(s, slider(s) > 0.5 ? 0 : 1); );

function ui_menu(base, n, cur) local(i, r)
(
  strcpy(#u_menu, "");
  i = 0;
  loop(n,
    i == cur ? strcat(#u_menu, "!");
    strcat(#u_menu, base + i);
    i < n - 1 ? strcat(#u_menu, "|");
    i += 1;
  );
  gfx_x = mouse_x; gfx_y = mouse_y;
  r = gfx_showmenu(#u_menu);
  r - 1;
);

function ui_choice(s, u, v, w, h) local(x, y, pw, ph, hov, r, n)
(
  x = floor(ui_px(u)); y = floor(ui_py(v)); pw = floor(w * UQ); ph = floor(h * UQ);
  hov = ui_hit(x, y, pw, ph);
  hov ? u_hov = s;
  gfx_set(0.255, 0.251, 0.259, 1); gfx_rect(x, y, pw, ph);
  gfx_set(hov ? 0.12 : 0.067, hov ? 0.12 : 0.067, hov ? 0.125 : 0.067, 1); gfx_rect(x + 1, y + 1, pw - 2, ph - 2);
  gfx_set(1, 1, 1, 1);
  ui_ctext(UNB[s] + ui_ival(s) - ui_min(s), x + pw * 0.5, y + ph * 0.5, 12 * UQ, 0);
  n = ui_max(s) - ui_min(s) + 1;
  (u_click && hov) ? (
    u_click = 0;
    r = ui_menu(UNB[s], n, ui_ival(s) - ui_min(s));
    r >= 0 ? ui_put(s, ui_min(s) + r);
  );
  (hov && u_wheel != 0 && u_drag == 0) ? ( ui_put(s, slider(s) + (u_wheel > 0 ? -1 : 1)); u_wheel = 0; );
);

function ui_algo() local(src, base, fw, fh, a, x, y, w, h)
(
  a = max(0, min(22, ui_ival(11)));
  x = floor(ui_px(138.75)); y = floor(ui_py(88.245)); w = floor(42 * UQ + 0.5); h = floor(70 * UQ + 0.5);
  (g_alg || g_alg2) ? (
    src = (g_alg2 && (UQ > UK * 1.25 || !g_alg)) ? 23 : 22;
    gfx_getimgdim(src, fw, fh); fw /= 23;
    gfx_set(1, 1, 1, 1);
    gfx_blit(src, 1, 0, a * fw, 0, fw, fh, x, y, w, h);
