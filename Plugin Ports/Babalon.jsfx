function render_span(pos, n) local(v)
(
  v = 0;
  loop(nact, render_voice(v, pos, n); v += 1; );
);

function reset_phase(p) local(k)
(
  k = 0; loop(32, p[k * 8] = 0.5; k += 1; );
);

function note_on(nt, vel) local(v, best, bt, p, f)
(
  best = -1; f = -1;
  v = 0; loop(nact, p = VST + v * VSS; p[274] == nt ? f = v; v += 1; );
  f >= 0 ? best = f : (
    bt = 1000000000000;
    v = 0;
    loop(nact,
      p = VST + v * VSS;
      (p[275] == 0 && p[276] < bt) ? ( bt = p[276]; best = v; );
      v += 1;
    );
    best < 0 ? (
      bt = 1000000000000;
      v = 0; loop(nact, p = VST + v * VSS; p[277] < bt ? ( bt = p[277]; best = v; ); v += 1; );
    );
  );
  best >= 0 ? (
    p = VST + best * VSS;
    stamp += 1;
    p[274] = nt; p[275] = 1; p[277] = stamp;
    p[270] = ((nt - 60) / 12);
    p[273] = (vel / 127);
    dx_reset > 0.5 ? reset_phase(p);
  );
);

function note_off(nt) local(v, p)
(
  v = 0;
  loop(16,
    p = VST + v * VSS;
    (p[274] == nt && p[275]) ? ( p[275] = 0; stamp += 1; p[276] = stamp; p[273] = 0; );
    v += 1;
  );
);

function all_off() local(v, p)
(
  v = 0; loop(16, p = VST + v * VSS; p[275] ? ( p[275] = 0; stamp += 1; p[276] = stamp; p[273] = 0; ); v += 1; );
);


voices_init();
rate_setup();
last_sr = srate;
load_tables();
stamp = 0;
do_params();
vgt = vgc = 10 ^ (dx_vol / 20);

@slider
last_sr != srate ? ( last_sr = srate; rate_setup(); );

@block
do_params();
g_rstreq != a_rst ? ( a_rst = g_rstreq; a_v = 0; loop(16, reset_phase(VST + a_v * VSS); a_v += 1; ); );
nev = 0;
while (gq_r < gq_w && nev < 1000) (
  gi = (gq_r & 63) * 3;
  EVQ[nev * 4] = 0; EVQ[nev * 4 + 1] = GQ[gi]; EVQ[nev * 4 + 2] = GQ[gi + 1]; EVQ[nev * 4 + 3] = GQ[gi + 2]; nev += 1;
  gq_r += 1;
);
while (midirecv(ofs, m1, m2, m3)) (
  st = m1 & 0xF0;
  (st == 0x90 || st == 0x80 || (st == 0xB0 && (m2 == 120 || m2 == 123))) && nev < 1000 ? (
    EVQ[nev * 4] = ofs; EVQ[nev * 4 + 1] = st; EVQ[nev * 4 + 2] = m2; EVQ[nev * 4 + 3] = m3; nev += 1;
  );
  midisend(ofs, m1, m2, m3);
);
memset(OBL, 0, samplesblock);
memset(OBR, 0, samplesblock);
pos = 0; er = 0;
while (pos < samplesblock) (
  while (er < nev && EVQ[er * 4] <= pos) (
    st = EVQ[er * 4 + 1];
    (st == 0x90 && EVQ[er * 4 + 3] > 0) ? note_on(EVQ[er * 4 + 2], EVQ[er * 4 + 3])
    : (st == 0x80 || st == 0x90) ? note_off(EVQ[er * 4 + 2])
    : all_off();
    er += 1;
  );
  nxt = er < nev ? EVQ[er * 4] : samplesblock;
  len = min(LBS, min(nxt, samplesblock) - pos);
  len < 1 ? len = 1;
  render_span(pos, len);
  pos += len;
);
bpos = 0;
vgc = vgt; vgt = 10 ^ (dx_vol / 20); vgs = (vgt - vgc) / samplesblock;

@sample
vgs ? vgc += vgs;
spl0 = OBL[bpos] * OUTG * vgc;
spl1 = OBR[bpos] * OUTG * vgc;
bpos += 1;

@gfx 1080 486

UDW = 1080; UDH = 486; UK = 1.3; OPSP = 125.5275; SBU = 138;
uscale = max(0.5, min(gfx_w / UDW, gfx_h / UDH));
uox = floor(SBU * UK * uscale + (gfx_w - (690 + SBU) * UK * uscale) * 0.5);
uoy = 0;
UQ = UK * uscale;
!g_pnl_try ? (
  g_pnl_try = 1;
  g_pnl = gfx_loadimg(20, "Babalon/BabalonPanel.png") >= 0 || gfx_loadimg(20, "Dependencies/Babalon/BabalonPanel.png") >= 0;
  g_pnl2 = gfx_loadimg(21, "Babalon/BabalonPanel2x.png") >= 0 || gfx_loadimg(21, "Dependencies/Babalon/BabalonPanel2x.png") >= 0;
  g_alg = gfx_loadimg(22, "Babalon/BabalonAlgos.png") >= 0 || gfx_loadimg(22, "Dependencies/Babalon/BabalonAlgos.png") >= 0;
  g_alg2 = gfx_loadimg(23, "Babalon/BabalonAlgos2x.png") >= 0 || gfx_loadimg(23, "Dependencies/Babalon/BabalonAlgos2x.png") >= 0;
  g_mk = gfx_loadimg(24, "Babalon/BabalonMark.png") >= 0 || gfx_loadimg(24, "Dependencies/Babalon/BabalonMark.png") >= 0;
  g_mk2 = gfx_loadimg(25, "Babalon/BabalonMark2x.png") >= 0 || gfx_loadimg(25, "Dependencies/Babalon/BabalonMark2x.png") >= 0;
  g_ey = gfx_loadimg(30, "Babalon/BabalonEyes.png") >= 0 || gfx_loadimg(30, "Dependencies/Babalon/BabalonEyes.png") >= 0;
  g_ey2 = gfx_loadimg(31, "Babalon/BabalonEyes2x.png") >= 0 || gfx_loadimg(31, "Dependencies/Babalon/BabalonEyes2x.png") >= 0;
  g_cr = gfx_loadimg(32, "Babalon/BabalonCrown.png") >= 0 || gfx_loadimg(32, "Dependencies/Babalon/BabalonCrown.png") >= 0;
  g_cr2 = gfx_loadimg(33, "Babalon/BabalonCrown2x.png") >= 0 || gfx_loadimg(33, "Dependencies/Babalon/BabalonCrown2x.png") >= 0;
  g_pl = gfx_loadimg(34, "Babalon/BabalonPlate.png") >= 0 || gfx_loadimg(34, "Dependencies/Babalon/BabalonPlate.png") >= 0;
  g_pl2 = gfx_loadimg(35, "Babalon/BabalonPlate2x.png") >= 0 || gfx_loadimg(35, "Dependencies/Babalon/BabalonPlate2x.png") >= 0;
