function ui_min(s) ( UMIN[s]; );
function ui_max(s) ( UMAX[s]; );
function ui_def(s) ( UDEF[s]; );
function ui_stp(s) ( USTP[s]; );
function ui_norm(s) ( (slider(s) - ui_min(s)) / (ui_max(s) - ui_min(s)); );
function ui_set(s, x) local(lo, hi, st, nv, old)
(
  lo = ui_min(s); hi = ui_max(s); st = ui_stp(s);
  nv = max(lo, min(hi, x));
  nv = lo + floor((nv - lo) / st + 0.5) * st;
  nv = max(lo, min(hi, nv));
  old = slider(s);
  slider(s) = nv;
  nv !== old ? automate(s, 0);
);
function ui_setn(s, n) ( ui_set(s, ui_min(s) + max(0, min(1, n)) * (ui_max(s) - ui_min(s))); );
function ui_put(s, x) ( ui_set(s, x); automate(s, 1); );
function ui_ival(s) ( floor(slider(s) + 0.5); );

function ui_px(u) ( uox + u * UQ; );
function ui_sx(u) ( (u + SBU) * UQ; );
function ui_py(v) ( v * UQ; );
function ui_hit(x, y, w, h) ( mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + h; );
function ui_hitc(cx, cy, r) ( sqr(mouse_x - cx) + sqr(mouse_y - cy) <= sqr(r); );

function ui_font(fs, b) ( gfx_setfont(1, "Arial", max(11, floor(fs + 0.5)), b ? 'b' : 0); );
function ui_ctext(str, cx, cy, fs, b) local(tw, th)
(
  ui_font(fs, b);
  gfx_measurestr(str, tw, th);
  gfx_x = floor(cx - tw * 0.5 + 0.5); gfx_y = floor(cy - th * 0.5 + 0.5);
  gfx_drawstr(str);
);
function ui_ttext(str, u, v, fs) local(tw, th)
(
  ui_font(fs * UQ, 0);
  gfx_measurestr(str, tw, th);
  gfx_x = floor(ui_px(u) - tw * 0.5 + 0.5); gfx_y = floor(ui_py(v) + 0.5);
  gfx_drawstr(str);
);

function ui_sttext(str, u, v, fs) local(tw, th)
(
  ui_font(fs * UQ, 0);
  gfx_measurestr(str, tw, th);
  gfx_x = floor(ui_sx(u) - tw * 0.5 + 0.5); gfx_y = floor(ui_py(v) + 0.5);
  gfx_drawstr(str);
);
function ui_rtext(str, x, cy, fs, b) local(tw, th)
(
  ui_font(fs, b);
  gfx_measurestr(str, tw, th);
  gfx_x = floor(x - tw + 0.5); gfx_y = floor(cy - th * 0.5 + 0.5);
  gfx_drawstr(str);
);

function ui_bezel(cx, cy, rr) local(yy, xx, dx, dy, d, cv, th, f, q, rc, ac, c, band)
(
  yy = floor(cy - rr - 1);
  loop(ceil(2 * rr + 3),
    dy = yy + 0.5 - cy;
    xx = floor(cx - rr - 1);
    loop(ceil(2 * rr + 3),
      dx = xx + 0.5 - cx; d = sqrt(dx * dx + dy * dy);
      cv = min(1, rr - d + 0.5);
      cv > 0 ? (
        c = 0.2;
        th = atan2(dx, -dy) * 180 / $pi;
        f = d / rr;
        band = 0;
        (f > 0.84 && f < 0.97) ? ( band = 1; q = th + 360; q = q - 90 * floor(q / 90); );
        (f > 0.66 && f < 0.80) ? ( band = 2; q = th + 405; q = q - 90 * floor(q / 90); );
        band ? (
          rc = band == 1 ? min(1, min((f - 0.84) * rr + 0.5, (0.97 - f) * rr + 0.5)) : min(1, min((f - 0.66) * rr + 0.5, (0.80 - f) * rr + 0.5));
          ac = min(1, min((q - 12) * $pi / 180 * d + 0.5, (78 - q) * $pi / 180 * d + 0.5));
          rc > 0 && ac > 0 ? c = 0.2 + 0.059 * rc * ac;
        );
        f > 0.97 ? c = 0.2 - 0.05 * min(1, (f - 0.97) * rr);
        gfx_set(c, c, c, cv);
        gfx_rect(xx, yy, 1, 1);
      );
      xx += 1;
    );
    yy += 1;
  );
  gfx_a = 1;
);

function ui_bz(u, v, r) ( ui_bezel(ui_px(u), ui_py(v), r * UQ); );

function ui_ledbase(u, v) local(cx, cy, r)
(
  cx = ui_px(u); cy = ui_py(v); r = 8 * UQ;
  gfx_set(0, 0, 0, 1); gfx_circle(cx, cy, r, 1, 1);
  gfx_set(0.235, 0.235, 0.235, 1); gfx_circle(cx, cy, r - max(1, 0.6 * UQ), 1, 1);
);

function ui_panelimg() local(src, base)
(
  src = (g_pnl2 && UQ > UK * 1.25) ? 21 : 20;
  base = src == 21 ? UK * 2 : UK;
  gfx_set(1, 1, 1, 1);
  gfx_x = ui_px(0); gfx_y = ui_py(0);
  gfx_blit(src, UQ / base, 0);
);

function ui_hline(v) ( gfx_set(1, 1, 1, 1); gfx_rect(floor(ui_px(0)), floor(ui_py(v) - UQ * 0.5), ceil(690 * UQ), max(1, floor(UQ + 0.5))); );

function ui_wline(v) local(y, h, xa, xb)
(
  gfx_set(1, 1, 1, 1);
  y = floor(ui_py(v) - UQ * 0.5); h = max(1, floor(UQ + 0.5));
  xa = floor(ui_px(0)); xb = floor(ui_px(690));
  gfx_rect(0, y, xa, h);
  gfx_rect(xb, y, gfx_w - xb, h);
);

function ui_fallback() local(k, o)
(
  gfx_set(1, 1, 1, 1);
  ui_ctext("Babalon", ui_px(276), ui_py(12), 18 * UQ, 0);
  ui_hline(24.5);
  gfx_rect(floor(ui_px(187.5)), floor(ui_py(24.5)), max(1, floor(UQ + 0.5)), floor(ui_py(232)));
  ui_ttext("Oct:", 18, 69, 14); ui_ttext("Coarse", 67.6, 69, 14); ui_ttext("Fine", 110.3, 69, 14); ui_ttext("Algo.", 159.6, 69, 14);
  ui_ttext("Chord", 23.8, 114, 14); ui_ttext("Invert", 67.1, 114, 14); ui_ttext("Detune", 109.8, 114, 14);
  ui_ttext("Full Inversion", 98, 130, 10); ui_ttext("A", 4, 18, 12); ui_ttext("B", 4, 140, 12);
  ui_ttext("Oct:", 18, 187, 14); ui_ttext("Coarse", 67.6, 187, 14); ui_ttext("Fine", 110.3, 187, 14);
  ui_ttext("LFO", 164, 168, 10); ui_ttext("Reset", 164, 186, 10);
  ui_ttext("Shape", 24.3, 240, 14); ui_ttext("Bright", 67.6, 240, 14); ui_ttext("FB", 110.3, 240, 14);
  k = 0;
  loop(4,
    o = OPSP * k;
    sprintf(#u_t, "Operator %d", k + 1); ui_ttext(#u_t, 270 + o, 29, 14);
    ui_ttext("Mul:", 202.1 + o, 78.75, 14); ui_ttext("Coarse", 250.3 + o, 78.75, 14); ui_ttext("Fine", 291.6 + o, 78.75, 14);
    ui_ttext("Wave", 209.1 + o, 130.4, 14); ui_ttext("Shape", 250.3 + o, 130.4, 14); ui_ttext("Level", 291.6 + o, 130.4, 14);
    ui_ttext("Post Shape", 251 + o, 150, 10); ui_ttext("Weak", 250 + o, 169, 10); ui_ttext("LFO", 293 + o, 150, 10); ui_ttext("Sync", 293 + o, 169, 10);
    gfx_rect(floor(ui_px(313.5 + o)), floor(ui_py(24.5)), max(1, floor(UQ + 0.5)), floor(ui_py(171)));
    k += 1;
  );
);

function ui_static() local(k, o, op)
(
  gfx_dest = 10; gfx_setimgdim(10, gfx_w, gfx_h);
  gfx_set(0.157, 0.157, 0.157, 1); gfx_rect(0, 0, gfx_w, gfx_h);
  g_pnl ? (
    ui_panelimg();
  ) : ui_fallback();
  g_mk ? (
    gfx_set(1, 1, 1, 1);
    gfx_x = ui_sx(-SBU); gfx_y = ui_py(25);
    (g_mk2 && UQ > UK * 1.25) ? gfx_blit(25, UQ / (UK * 2), 0) : gfx_blit(24, UQ / UK, 0);
  );
  gfx_set(0.80, 0.80, 0.80, 1);
  ui_rtext("by chmaha", gfx_w - 4 * UQ, ui_py(7), 11 * UQ / UK, 0);
  ui_rtext("based on Dexter by Dale Johnson (Valley Audio Soft)", gfx_w - 4 * UQ, ui_py(17.5), 11 * UQ / UK, 0);
  ui_hline(256.5);
  gfx_set(1, 1, 1, 1); gfx_rect(0, floor(ui_py(356.5) - UQ * 0.5), gfx_w, max(1, floor(UQ + 0.5)));
  ui_wline(24.5);
  gfx_set(1, 1, 1, 1);
  gfx_rect(floor(ui_sx(0)) - max(1, floor(UQ + 0.5)), floor(ui_py(24.5) - UQ * 0.5), max(1, floor(UQ + 0.5)), ceil(ui_py(332)));
  gfx_rect(floor(ui_px(187.5)), floor(ui_py(196)), max(1, floor(UQ + 0.5)), ceil(ui_py(60.5)));
  ui_bz(24.28, 50.99, 15.87); ui_bz(67.58, 50.99, 15.87); ui_bz(110.28, 50.99, 15.87); ui_bz(159.58, 50.99, 15.87);
  ui_bz(23.81, 97.03, 12.4); ui_bz(67.11, 97.03, 12.4); ui_bz(109.81, 97.03, 12.4);
  ui_bz(24.28, 168.99, 15.87); ui_bz(67.58, 168.99, 15.87); ui_bz(110.28, 168.99, 15.87);
  ui_bz(24.28, 221.5, 15.87); ui_bz(67.58, 221.5, 15.87); ui_bz(110.28, 221.5, 15.87);
  ui_ledbase(62.71, 136); ui_ledbase(147.13, 175); ui_ledbase(147.13, 193.46);
  op = 0;
  loop(4,
    o = OPSP * op;
    (u_setm & (1 << op)) ? (
