  ui_bz(214, 220, 15.87); ui_bz(283, 220, 15.87); ui_bz(352, 220, 15.87); ui_bz(628, 220, 15.87);
  ui_ledbase(421, 214); ui_ledbase(490, 214); ui_ledbase(559, 214);
  gfx_set(1, 1, 1, 1);
  !g_pnl ? (
