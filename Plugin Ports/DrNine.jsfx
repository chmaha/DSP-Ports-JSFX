ii = 0; loop(11, (pan_l[ii] !== 1 || pan_r[ii] !== 1 || pt_l[ii] !== 1 || pt_r[ii] !== 1) ? pan_st = 1; ii += 1; );
tempo > 20 && tempo !== last_bpm ? ( last_bpm = tempo; dl_bpm = tempo; dly_retime(); );
ev_n = 0; ev_i = 0; ev_pos = 0; sq_n = 0; sq_i = 0;
i = 0;
while (i < no_n) (
