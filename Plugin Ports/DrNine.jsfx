  ev_n += 1; gq_r = (gq_r + 1) & 63;
);
while (midirecv(mofs, m1, m2, m3)) (
  (m1 & 240) === 144 && m3 > 0 && (chan_sel === 0 || (m1 & 15) === chan_sel - 1) ? (
    w = note_voice(m2);
    w >= 0 && ev_n < 1000 ? ( evq[ev_n * 3] = mofs; evq[ev_n * 3 + 1] = w; evq[ev_n * 3 + 2] = m3; ev_n += 1; );
  );
  midisend(mofs, m1, m2, m3);
);
play_state !== 0 ? prev_on = 0;
prev_req ? (
  prev_req = 0;
