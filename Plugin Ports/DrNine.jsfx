function update_midi_note_names() global(map_mode chan_sel)
            local(state, tmp, oldch, i)
(
  tmp = (map_mode+1) | (chan_sel << 8);
  state != tmp ? (
    set_midi_note_name(-1,0,0,"");
    state=tmp;
    loop(i=0;128,
      (tmp = note_voice(i)) >= 0 ? set_midi_note_name(0,i,chan_sel-1,vname(col_trig(tmp),#));
      i+= 1;
