!(mouse_cap & 1) ? (
  drag_i >= 0 ? ( automate(drag_i, 1); drag_i = -1; );
  paint_on = 0;
  pat_dirty ? ( pat_dirty = 0; sliderchange(-1); );
);
hov_i = -1; tip_on = 0;

gfx_gradrect(sx(0), sy(0), W0 * z, 480 * z, 0.84, 0.84, 0.82, 1, 0, 0, 0, 0, -0.10 / (480 * z), -0.10 / (480 * z), -0.10 / (480 * z), 0);
