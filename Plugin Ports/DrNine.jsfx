gfx_gradrect(sx(0), sy(480), W0 * z, (H0 - 480) * z, 0.22, 0.22, 0.23, 1, 0, 0, 0, 0, -0.10 / ((H0 - 480) * z), -0.10 / ((H0 - 480) * z), -0.10 / ((H0 - 480) * z), 0);
