);
mode = seq_on && (play_state & 1) ? 1 : prev_on ? 2 : 0;
mode !== last_mode ? ( seq_run = 0; last_mode = mode; );
mode === 1 ? seq_block(beat_position, 0) :
mode === 2 ? (
  prev_end = 0;
