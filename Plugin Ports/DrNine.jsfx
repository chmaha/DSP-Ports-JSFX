font(8.5, 'b');
gfx_set(0.62, 0.62, 0.60, 1);
text_l("PADS PLAY THEIR VOICE, LOUDER NEAR THE TOP", 16, 586);

tip_on ? tip_below(tip_x, tip_y, #tip, #tip2);
hov_i > 0 ? (
  hn = sl_name(hov_i);
  is_enum(hov_i) ? ( enum_name(hov_i, slider(hov_i), #hv); sprintf(#tt, "%s  %s", hn, #hv); )
  : hov_i >= 103 ? (
    slider(hov_i) === 0 ? sprintf(#tt, "%s  C", hn) : sprintf(#tt, "%s  %s%d", hn, slider(hov_i) < 0 ? "L" : "R", abs(slider(hov_i)));
  ) : sprintf(#tt, "%s  %.1f", hn, slider(hov_i));
  tooltip(hov_x, hov_y, #tt);
);

last_cap = mouse_cap;
mouse_wheel = 0;
