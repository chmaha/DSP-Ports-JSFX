);

function tooltip(x, y, str) local(tw, th, bx, by, bw, bh) (
  font(11, 'b');
  gfx_measurestr(str, tw, th);
  bw = tw + 12 * z; bh = th + 6 * z;
  bx = max(2, min(gfx_w - bw - 2, sx(x) - bw * 0.5)); by = sy(y) - bh;
  gfx_set(0.10, 0.10, 0.11, 0.94);
  gfx_rect(bx, by, bw, bh, 1);
  gfx_set(0.93, 0.42, 0.13, 1);
  gfx_rect(bx, by + bh - max(1, z), bw, max(1, z), 1);
  gfx_set(1, 1, 1, 1);
  gfx_x = bx + 6 * z; gfx_y = by + 3 * z;
  gfx_drawstr(str);
);

function knob_body(x, y, r) local(QX, QY, QR, i, t, c) (
  QX = sx(x); QY = sy(y); QR = r * z;
  gfx_set(0, 0, 0, 0.28);
  gfx_circle(QX + 1.5 * z, QY + 2.5 * z, QR + 2 * z, 1, 1);
  gfx_set(0.08, 0.08, 0.09, 1);
  gfx_circle(QX, QY, QR + 1.5 * z, 1, 1);
  i = 0;
  loop(ceil(QR),
    t = i / ceil(QR);
    c = 0.10 + 0.16 * t;
    gfx_set(c, c, c * 1.04, 1);
    gfx_circle(QX - QR * 0.12 * t, QY - QR * 0.18 * t, QR * (1 - t * 0.75), 1, 1);
    i += 1;
  );
  gfx_set(1, 1, 1, 0.10);
  gfx_arc(QX, QY, QR - 1 * z, -1.6, 0.2, 1);
);

function knob(x, y, r, i, label) local(hov, nv, d, fine, QX, QY, a, a0, a1, k, pos) (
  hov = hitc(x, y, r + 5);
  (mouse_click && hov) ? (
    (last_click_i == i && now - last_click_t < 0.3) ? ( tap_sl(i, slDef[i]); drag_i = -1; ) :
      ( drag_i = i; drag_y0 = mouse_y; drag_v0 = slider(i); );
    last_click_i = i; last_click_t = now; mouse_click = 0;
  );
  drag_i == i ? (
    mouse_cap |= 65536;
    fine = (mouse_cap & 4) || (mouse_cap & 8);
    d = (drag_y0 - mouse_y) / (200 * z) * (fine ? 0.1 : 1);
    nv = drag_v0 + d * 127;
    set_sl(i, floor(nv * 10 + 0.5) / 10);
  );
  (hov && mouse_wheel != 0 && drag_i < 0) ? (
    tap_sl(i, slider(i) + (mouse_wheel > 0 ? 1 : -1) * ((mouse_cap & 4) ? 0.2 : 2));
    mouse_wheel = 0;
  );
  QX = sx(x); QY = sy(y);
  pos = slider(i) / 127;
  a0 = -2.35619; a1 = 2.35619;
  a = a0 + (a1 - a0) * clamp01(pos);
  k = 0;
  loop(11,
    d = a0 + (a1 - a0) * k / 10;
    gfx_set(0.12, 0.12, 0.13, (k == 0 || k == 5 || k == 10) ? 0.9 : 0.55);
    gfx_line(QX + sin(d) * (r + 4) * z, QY - cos(d) * (r + 4) * z, QX + sin(d) * (r + ((k == 0 || k == 5 || k == 10) ? 8 : 6.5)) * z, QY - cos(d) * (r + ((k == 0 || k == 5 || k == 10) ? 8 : 6.5)) * z, 1);
    k += 1;
  );
  knob_body(x, y, r);
  gfx_set(0.96, 0.96, 0.94, 1);
  k = 0;
  loop(max(1, ceil(1.6 * z)),
    gfx_line(QX + sin(a) * r * 0.2 * z + (k - 0.5) * cos(a), QY - cos(a) * r * 0.2 * z + (k - 0.5) * sin(a),
             QX + sin(a) * r * 0.92 * z + (k - 0.5) * cos(a), QY - cos(a) * r * 0.92 * z + (k - 0.5) * sin(a), 1);
    k += 1;
  );
  font(r >= 14 ? 9.5 : 8.5, 'b');
  gfx_set(0.12, 0.12, 0.13, 1);
  text_c(label, x, y - r - (r >= 14 ? 21 : 19));
  (hov || drag_i == i) ? ( hov_i = i; hov_x = x; hov_y = y - r - 20; );
);

function enum_name(i, v, str) local(n) (
  (i == S_MDIST) ? (
    strcpy(str, v == 0 ? "OFF" : v == 1 ? "DIODE" : v == 2 ? "CLIP" : v == 3 ? "SAT" : v == 4 ? "BFZ" : v == 5 ? "PDIST" : v == 6 ? "FOLD" : "CRUSH");
  ) : (i == S_DTIME) ? (
    strcpy(str, v == 0 ? "1/32" : v == 1 ? "1/16T" : v == 2 ? "1/16" : v == 3 ? "1/8T" : v == 4 ? "1/16." : v == 5 ? "1/8" : v == 6 ? "1/4T" :
                v == 7 ? "1/8." : v == 8 ? "1/4" : v == 9 ? "1/2T" : v == 10 ? "1/4." : v == 11 ? "1/2" : "1/2.");
  ) : (i == S_MAP) ? (
    strcpy(str, v == 0 ? "GENERAL MIDI" : "CHROMATIC C1");
  ) : (i == S_CHAN) ? (
    v == 0 ? strcpy(str, "OMNI") : sprintf(str, "%d", v);
  ) : (i == S_SEQON || i == S_MOUT) ? (
    strcpy(str, v ? "ON" : "OFF");
  ) : (i == S_SHUF) ? (
    sprintf(str, "%d", v);
  ) : (i == S_PAT) ? (
    sprintf(str, "%d", v + 1);
  ) : (
    strcpy(str, v == 0 ? "DIODE" : v == 1 ? "CLIP" : v == 2 ? "SAT" : v == 3 ? "BFZ" : v == 4 ? "PDIST" : v == 5 ? "FOLD" : "CRUSH");
  );
);

function enum_menu(i) local(n, k, v, sel) (
  n = slMax[i] + 1;
  v = slider(i);
  #mn = "";
  k = 0;
  loop(n,
    enum_name(i, k, #en);
    k > 0 ? strcat(#mn, "|");
    k == v ? strcat(#mn, "!");
    strcat(#mn, #en);
    k += 1;
  );
  sel = gfx_showmenu(#mn);
  sel > 0 ? tap_sl(i, sel - 1);
);

function chip(x, y, w, i, label) local(hov, QX, QY, QW, QH, tw, th) (
  QX = sx(x); QY = sy(y); QW = w * z; QH = 20 * z;
  hov = hit(x, y, w, 20);
  label != 0 ? ( font(8.5, 'b'); gfx_set(0.12, 0.12, 0.13, 1); text_c(label, x + w * 0.5, y - 14); );
  gfx_set(0.05, 0.05, 0.05, 1);
  gfx_rect(QX - z, QY - z, QW + 2 * z, QH + 2 * z, 1);
  gfx_gradrect(QX, QY, QW, QH, 0.20, 0.09, 0.05, 1, 0, 0, 0, 0, -0.08 / QH, -0.04 / QH, -0.02 / QH, 0);
  hov ? ( gfx_set(1, 1, 1, 0.08); gfx_rect(QX, QY, QW, QH, 1); );
  enum_name(i, slider(i), #cv);
  font(9.5, 'b');
  gfx_set(1.0, 0.55, 0.22, 1);
  gfx_measurestr(#cv, tw, th);
  gfx_x = QX + (QW - tw) * 0.5; gfx_y = QY + floor((QH - th) * 0.5 + 0.5);
  gfx_drawstr(#cv);
  (mouse_click && hov) ? ( gfx_x = QX; gfx_y = QY + QH; enum_menu(i); mouse_click = 0; );
);

function vabbr(c, str) (
  strcpy(str, c == 0 ? "BD" : c == 1 ? "SD" : c == 2 ? "LT" : c == 3 ? "MT" : c == 4 ? "HT" :
              c == 5 ? "RS" : c == 6 ? "HC" : c == 7 ? "CH" : c == 8 ? "OH" : c == 9 ? "RD" : "CY");
);
function note_name(n, str) local(pc) (
  pc = n % 12;
  sprintf(str, "%s%d", pc == 0 ? "C" : pc == 1 ? "C#" : pc == 2 ? "D" : pc == 3 ? "D#" : pc == 4 ? "E" : pc == 5 ? "F" :
                       pc == 6 ? "F#" : pc == 7 ? "G" : pc == 8 ? "G#" : pc == 9 ? "A" : pc == 10 ? "A#" : "B", floor(n / 12) - 1);
);
function grp_col(i) (
  i < 4 ? ( gr = 0.86; gg = 0.24; gb = 0.13; ) : i < 8 ? ( gr = 0.95; gg = 0.52; gb = 0.14; ) :
  i < 12 ? ( gr = 0.96; gg = 0.82; gb = 0.30; ) : ( gr = 0.93; gg = 0.91; gb = 0.84; );
);

function pair(cx, y, a, la, b, lb) (
  b > 0 ? ( knob(cx - 21, y, 14, a, la); knob(cx + 21, y, 14, b, lb); ) : a > 0 ? knob(cx, y, 14, a, la);
);

function btn(x, y, w, h, label, lit) local(QX, QY, QW, QH, hov) (
  QX = sx(x); QY = sy(y); QW = w * z; QH = h * z;
  hov = hit(x, y, w, h);
  gfx_set(0.05, 0.05, 0.05, 1);
  gfx_rect(QX - z, QY - z, QW + 2 * z, QH + 2 * z, 1);
  lit ? gfx_gradrect(QX, QY, QW, QH, 0.95, 0.50, 0.16, 1, 0, 0, 0, 0, -0.15 / QH, -0.10 / QH, -0.05 / QH, 0)
      : gfx_gradrect(QX, QY, QW, QH, 0.34, 0.34, 0.35, 1, 0, 0, 0, 0, -0.10 / QH, -0.10 / QH, -0.10 / QH, 0);
  hov ? ( gfx_set(1, 1, 1, 0.10); gfx_rect(QX, QY, QW, QH, 1); );
  font(9.5, 'b');
  lit ? gfx_set(0.10, 0.06, 0.03, 1) : gfx_set(0.92, 0.92, 0.90, 1);
  text_c(label, x + w * 0.5, y + h * 0.5 - 6);
  ret = mouse_click && hov;
  ret ? mouse_click = 0;
  ret;
);

function pan_set(i, v) (
  v = max(-100, min(100, floor(v + 0.5)));
  slider(i) !== v ? ( slider(i) = v; automate(i, 0); ui_dirty = 1; );
);

function pan_ctl(c, cx, y) local(i, en, hov, fine, a, px) (
  i = 103 + c;
  en = <?printf("%d", outs != 11);?>;
  hov = en && hit(cx - 36, y - 9, 72, 18);
  (mouse_click && hov) ? (
    (last_click_i == i && now - last_click_t < 0.3) ? ( pan_set(i, 0); automate(i, 1); drag_i = -1; ) :
      ( drag_i = i; drag_x0 = mouse_x; drag_v0 = slider(i); );
    last_click_i = i; last_click_t = now; mouse_click = 0;
  );
  drag_i == i ? (
    fine = (mouse_cap & 4) || (mouse_cap & 8);
    pan_set(i, drag_v0 + (mouse_x - drag_x0) / (60 * z) * 200 * (fine ? 0.1 : 1));
  );
  (hov && mouse_wheel != 0 && drag_i < 0) ? (
    pan_set(i, slider(i) + (mouse_wheel > 0 ? 1 : -1) * ((mouse_cap & 4) ? 1 : 5)); automate(i, 1);
    mouse_wheel = 0;
  );
  a = en ? 1 : 0.35;
  font(8.5, 'b');
  gfx_set(0.12, 0.12, 0.13, a);
  text_c("PAN", cx, y - 21);
  text_c("L", cx - 37, y - 6);
  text_c("R", cx + 37, y - 6);
  gfx_set(0.10, 0.10, 0.11, 0.45 * a);
  box(cx - 30, y - 1, 60, 2);
  gfx_set(0.10, 0.10, 0.11, 0.8 * a);
  box(cx - 0.5, y - 5, 1, 10);
  px = cx + 30 * slider(i) / 100;
  slider(i) !== 0 ? ( gfx_set(0.93, 0.42, 0.13, a); box(min(cx, px), y - 1, abs(px - cx), 2); );
  gfx_set(0, 0, 0, 0.28 * a);
  box(px - 2.5, y - 4.5, 7, 12);
  gfx_set(0.08, 0.08, 0.09, a);
  box(px - 3.5, y - 6, 7, 12);
  gfx_set(0.96, 0.96, 0.94, a);
  box(px - 0.5, y - 4, 1, 8);
  (hov || drag_i == i) ? ( hov_i = i; hov_x = cx; hov_y = y - 10; );
);

function voice_col(c) local(x, cx, b) (
  x = 16 + c * 88; cx = x + 44;
  vname(c, #vn);
  font(9.5, 'b');
  gfx_set(0.10, 0.10, 0.11, 1);
  text_c(#vn, cx, 66);
  gfx_set(0.93, 0.42, 0.13, 1);
  box(x + 6, 82, 76, 2);
  b = c * 4;
  col_lab(c, 0, #l0); col_lab(c, 1, #l1); col_lab(c, 2, #l2); col_lab(c, 3, #l3);
  pair(cx, 132, colK[b], #l0, colK[b + 1], #l1);
  pair(cx, 206, colK[b + 2], #l2, colK[b + 3], #l3);
  gfx_set(0.10, 0.10, 0.11, 0.18);
  box(x + 10, 246, 68, 1);
  knob(cx - 21, 288, 11, colK[100 + c], "DRIVE");
  chip(cx + 1, 280, 40, colK[120 + c], "DIST");
  gfx_set(0.10, 0.10, 0.11, 0.18);
  box(x + 10, 322, 68, 1);
  c == 0 ? (
    knob(cx - 21, 364, 11, S_BDPD, "P.DEPTH"); knob(cx + 21, 364, 11, S_BDPI, "PITCH");
  ) : (
    knob(cx - 21, 364, 11, colK[140 + c], "REVERB"); knob(cx + 21, 364, 11, colK[160 + c], "DELAY");
  );
  gfx_set(0.10, 0.10, 0.11, 0.18);
  box(x + 10, 390, 68, 1);
  pan_ctl(c, cx, 420);
  c > 0 ? ( gfx_set(0.10, 0.10, 0.11, 0.35); box(x, 62, 1, 372); );
);

function group(x, y, w, title) (
  font(10, 'b');
  gfx_set(0.10, 0.10, 0.11, 1);
  text_l(title, x, y);
  gfx_set(0.93, 0.42, 0.13, 1);
  box(x, y + 16, w, 2);
);

function kit_page() local(c) (
  c = 0; loop(11, voice_col(c); c += 1; );
  font(9, 'b');
  gfx_set(0.30, 0.30, 0.32, 1);
  text_c("DRAG  ·  CTRL/SHIFT FINE  ·  MOUSE WHEEL  ·  DOUBLE-CLICK RESETS", W0 * 0.5, 450);
);

function fx_page() (
  group(40, 72, 420, "REVERB");
  knob(90, 160, 22, S_RDEC, "DECAY"); knob(195, 160, 22, S_RTONE, "TONE"); knob(300, 160, 22, S_RHPF, "HPF"); knob(405, 160, 22, S_RLEV, "LEVEL");
  group(520, 72, 440, "DELAY");
  chip(530, 150, 60, S_DTIME, "TIME");
  knob(650, 160, 22, S_DFB, "FEEDBACK"); knob(750, 160, 22, S_DTONE, "TONE"); knob(850, 160, 22, S_DHPF, "HPF"); knob(940, 160, 22, S_DLEV, "LEVEL");
  group(40, 236, 920, "MASTER");
  chip(50, 316, 70, S_MDIST, "DIST");
  knob(200, 326, 22, S_MDRV, "DRIVE"); knob(330, 326, 22, S_COMP, "COMP"); knob(460, 326, 22, S_ACC, "ACCENT");
  knob(590, 326, 22, S_VEL, "VELOCITY"); knob(900, 326, 28, S_VOL, "VOLUME");
  font(9, 'b');
  gfx_set(0.30, 0.30, 0.32, 1);
  text_l("DELAY TIME FOLLOWS THE PROJECT TEMPO. EVERY VOICE EXCEPT THE KICK HAS REVERB AND DELAY SENDS ON THE KIT PAGE.", 40, 400);
);

function seq_toggle(x, y, w, h) local(QX, QY, QW, QH, hov, on, tw, th) (
  QX = sx(x); QY = sy(y); QW = w * z; QH = h * z;
  on = slider(S_SEQON);
  hov = hit(x, y, w, h);
  gfx_set(0.04, 0.04, 0.04, 1);
  gfx_rect(QX - 2 * z, QY - 2 * z, QW + 4 * z, QH + 4 * z, 1);
  on ? gfx_gradrect(QX, QY, QW, QH, 0.20, 0.78, 0.30, 1, 0, 0, 0, 0, -0.10 / QH, -0.25 / QH, -0.10 / QH, 0)
     : gfx_gradrect(QX, QY, QW, QH, 0.80, 0.16, 0.12, 1, 0, 0, 0, 0, -0.25 / QH, -0.06 / QH, -0.05 / QH, 0);
  gfx_set(1, 1, 1, 0.25);
  gfx_rect(QX, QY, QW, max(1, 1.5 * z), 1);
  hov ? ( gfx_set(1, 1, 1, 0.12); gfx_rect(QX, QY, QW, QH, 1); );
  font(8.5, 'b');
  gfx_set(1, 1, 1, 0.9);
  text_c("SEQUENCER", x + w * 0.5, y + 5);
  font(12, 'b');
  gfx_set(1, 1, 1, 1);
  text_c(on ? (seq_step >= 0 ? "RUNNING" : "ON") : "OFF", x + w * 0.5, y + 18);
  (on && seq_step >= 0 && !(seq_step & 1)) ? ( gfx_set(1, 1, 1, 0.9); gfx_circle(QX + QW - 7 * z, QY + 7 * z, 2.5 * z, 1, 1); );
  (mouse_click && hov) ? ( tap_sl(S_SEQON, !on); mouse_click = 0; );
);

function play_btn(x, y, w, h) local(QX, QY, QW, QH, hov, on, ok) (
  QX = sx(x); QY = sy(y); QW = w * z; QH = h * z;
  ok = play_state == 0; on = prev_on && ok;
  hov = ok && hit(x, y, w, h);
  gfx_set(0.05, 0.05, 0.05, 1);
  gfx_rect(QX - z, QY - z, QW + 2 * z, QH + 2 * z, 1);
  !ok ? gfx_gradrect(QX, QY, QW, QH, 0.55, 0.55, 0.55, 1, 0, 0, 0, 0, -0.05 / QH, -0.05 / QH, -0.05 / QH, 0) :
  on ? gfx_gradrect(QX, QY, QW, QH, 0.20, 0.78, 0.30, 1, 0, 0, 0, 0, -0.10 / QH, -0.25 / QH, -0.10 / QH, 0)
     : gfx_gradrect(QX, QY, QW, QH, 0.34, 0.34, 0.35, 1, 0, 0, 0, 0, -0.10 / QH, -0.10 / QH, -0.10 / QH, 0);
  hov ? ( gfx_set(1, 1, 1, 0.10); gfx_rect(QX, QY, QW, QH, 1); );
  font(9.5, 'b');
  !ok ? gfx_set(0.40, 0.40, 0.40, 1) : gfx_set(1, 1, 1, 1);
  text_c(on ? "STOP" : "PLAY", x + w * 0.5, y + h * 0.5 - 6);
  (mouse_click && hov) ? ( prev_req = 1; mouse_click = 0; );
  hit(x, y, w, h) && !ok ? ( tip_on = 1; tip_x = x + w * 0.5; tip_y = 100; #tip = "Preview plays while REAPER's transport is stopped"; #tip2 = ""; );
);

function tip_below(x, y, str, str2) local(tw, th, tw2, bx, by, bw, bh, two) (
  font(11, 'b');
  two = strlen(str2) > 0;
  gfx_measurestr(str, tw, th);
  two ? ( gfx_measurestr(str2, tw2, th); tw = max(tw, tw2); );
  bw = tw + 12 * z; bh = th * (two ? 2 : 1) + 6 * z;
  bx = max(2, min(gfx_w - bw - 2, sx(x) - bw * 0.5)); by = sy(y);
  gfx_set(0.10, 0.10, 0.11, 0.94);
  gfx_rect(bx, by, bw, bh, 1);
  gfx_set(0.93, 0.42, 0.13, 1);
  gfx_rect(bx, by, bw, max(1, z), 1);
  gfx_set(1, 1, 1, 1);
  gfx_x = bx + 6 * z; gfx_y = by + 3 * z;
  gfx_drawstr(str);
  two ? ( gfx_x = bx + 6 * z; gfx_y = by + 3 * z + th; gfx_drawstr(str2); );
);

function copy_row(v) local(k) (
  k = 0; loop(16, gmem[3312 + k] = seqm[slider(S_PAT) * 192 + v * 16 + k]; k += 1; );
  gmem[3311] = v; gmem[3309] = 2;
  copy_t = time_precise();
);

function pat_has(p) local(k, r) ( r = 0; k = 0; loop(192, seqm[p * 192 + k] ? r = 1; k += 1; ); r; );

function pat_page() local(p, x, y, r, s, QX, QY, QW, QH, on, base, L, hov, pl, sel, k, v, cw) (
  p = slider(S_PAT);
  base = p * 192;
  L = plen[p];
  font(8.5, 'b'); gfx_set(0.12, 0.12, 0.13, 1); text_l("PATTERN", 16, 60);
  k = 0;
  loop(16,
    x = 16 + k * 27;
    sprintf(#pn, "%d", k + 1);
    btn(x, 76, 24, 20, #pn, k == p) ? ( tap_sl(S_PAT, k); );
    pat_has(k) ? ( gfx_set(0.93, 0.42, 0.13, 1); box(x + 9, 99, 6, 2); );
    (seq_step >= 0 && k == seq_pat) ? ( gfx_set(1, 0.2, 0.1, 1); gfx_circle(sx(x + 12), sy(71), 2.5 * z, 1, 1); );
    k += 1;
  );
  font(8.5, 'b'); gfx_set(0.12, 0.12, 0.13, 1); text_c("LENGTH", 480, 60);
  sprintf(#ln, "%d", L);
  btn(458, 76, 44, 20, #ln, 0) ? (
    #mn = ""; k = 1; loop(16, sprintf(#en, "%s%d", k == L ? "!" : "", k); strcat(#mn, #en); k < 16 ? strcat(#mn, "|"); k += 1; );
    gfx_x = sx(458); gfx_y = sy(96); sel = gfx_showmenu(#mn); sel > 0 ? ( plen[p] = sel; sliderchange(-1); );
  );
  font(8.5, 'b'); gfx_set(0.12, 0.12, 0.13, 1); text_c("SCALE", 537, 60);
  v = pscl[p];
  btn(510, 76, 54, 20, v == 0 ? "1/16" : v == 1 ? "1/16T" : v == 2 ? "1/8" : v == 3 ? "1/8T" : "1/32", 0) ? (
    gfx_x = sx(510); gfx_y = sy(96);
    sel = gfx_showmenu(v == 0 ? "!1/16|1/16T|1/8|1/8T|1/32" : v == 1 ? "1/16|!1/16T|1/8|1/8T|1/32" : v == 2 ? "1/16|1/16T|!1/8|1/8T|1/32" : v == 3 ? "1/16|1/16T|1/8|!1/8T|1/32" : "1/16|1/16T|1/8|1/8T|!1/32");
    sel > 0 ? ( pscl[p] = sel - 1; sliderchange(-1); );
  );
  chip(572, 76, 40, S_SHUF, "SHUFFLE");
  chip(620, 76, 58, S_MOUT, "MIDI OUT");
  hit(620, 76, 58, 20) ? ( tip_on = 1; tip_x = 649; tip_y = 100;
    #tip = "Sends the pattern's notes as MIDI (channel 10)."; #tip2 = "To record them, set the track's record mode to Record: output (MIDI)."; );
  font(8.5, 'b'); gfx_set(0.12, 0.12, 0.13, 1); text_c("PREVIEW", 737, 60);
  play_btn(688, 76, 58, 20);
  btn(750, 76, 38, 20, "LOOP", prev_loop) ? prev_loop = !prev_loop;
  btn(798, 76, 58, 20, "CLEAR", time_precise() - clear_t < 0.15) ? ( memset(seqm + base, 0, 192); sliderchange(-1); clear_t = time_precise(); );
  gmem[3309] > 0 ? (
    font(8.5, 'b');
    gmem[3309] == 3 ? ( gfx_set(0.93, 0.42, 0.13, 1); text_c("ALL 16 PATTERNS", 923, 60); ) : (
      gfx_set(0.12, 0.12, 0.13, 1);
      gmem[3309] == 1 ? sprintf(#cb, "PATTERN") : ( vname(gmem[3311], #tvn); sprintf(#cb, "ROW: %s", #tvn); );
      text_c(#cb, 923, 60);
    );
  );
  btn(862, 76, 58, 20, "COPY", time_precise() - copy_t < 0.15) ? (
    copy_t = time_precise();
    mouse_cap & 8 ? (
      k = 0; loop(3104, gmem[201 + k] = seqm[k]; k += 1; ); gmem[3309] = 3;
    ) : (
      k = 0; loop(192, gmem[1 + k] = seqm[base + k]; k += 1; ); gmem[193] = plen[p]; gmem[194] = pscl[p]; gmem[3309] = 1;
    );
  );
  hit(862, 76, 58, 20) ? ( tip_on = 1; tip_x = 891; tip_y = 100;
    #tip = "Shift-click: copy all patterns."; #tip2 = "Shift-click a pad or row name to copy just that row."; );
  btn(926, 76, 58, 20, "PASTE", gmem[3309] > 0) ? (
    gmem[3309] == 1 ? ( k = 0; loop(192, seqm[base + k] = gmem[1 + k]; k += 1; ); plen[p] = gmem[193]; pscl[p] = gmem[194]; sliderchange(-1); );
    gmem[3309] == 2 ? ( k = 0; loop(16, seqm[base + gmem[3311] * 16 + k] = gmem[3312 + k]; k += 1; ); sliderchange(-1); );
    gmem[3309] == 3 ? ( k = 0; loop(3104, seqm[k] = gmem[201 + k]; k += 1; ); sliderchange(-1); );
  );
  hit(926, 76, 58, 20) && gmem[3309] > 0 ? ( tip_on = 1; tip_x = 955; tip_y = 100; #tip2 = "";
    gmem[3309] == 1 ? #tip = "Pastes the copied pattern into this slot." :
    gmem[3309] == 3 ? #tip = "Replaces all 16 patterns with the copied set." :
    ( vname(gmem[3311], #tvn); sprintf(#tip, "Pastes the copied %s row into this pattern.", #tvn); );
  );
  cw = 54;
  r = 0;
  loop(12,
    y = 114 + r * 29;
    k = r == 0 ? 11 : r - 1;
    vname(k, #vn);
    font(9, 'b');
    gfx_set(0.10, 0.10, 0.11, 1);
    text_l(#vn, 16, y + 7);
    (mouse_click && (mouse_cap & 8) && hit(16, y, 104, 24)) ? ( copy_row(k); mouse_click = 0; );
    s = 0;
    loop(16,
      x = 124 + s * cw;
      QX = sx(x); QY = sy(y); QW = (cw - 5) * z; QH = 24 * z;
      on = seqm[base + k * 16 + s];
      grp_col(s);
      hov = hit(x, y, cw - 5, 24);
      gfx_set(0.05, 0.05, 0.05, 1);
      gfx_rect(QX - z, QY - z, QW + 2 * z, QH + 2 * z, 1);
      on ? gfx_gradrect(QX, QY, QW, QH, gr, gg, gb, 1, 0, 0, 0, 0, -0.12 * gr / QH, -0.12 * gg / QH, -0.12 * gb / QH, 0)
         : ( gfx_set(gr * 0.32, gg * 0.32, gb * 0.32, 1); gfx_rect(QX, QY, QW, QH, 1); gfx_set(gr, gg, gb, 0.55); gfx_rect(QX, QY + QH - 3 * z, QW, 3 * z, 1); );
      s >= L ? ( gfx_set(0.05, 0.05, 0.05, 0.62); gfx_rect(QX, QY, QW, QH, 1); );
      (seq_step == s && seq_pat == p) ? ( gfx_set(1, 1, 1, 0.30); gfx_rect(QX, QY, QW, QH, 1); );
      hov ? ( gfx_set(1, 1, 1, 0.12); gfx_rect(QX, QY, QW, QH, 1); );
      (mouse_click && hov) ? ( paint_v = !on; paint_on = 1; mouse_click = 0; );
      (paint_on && hov && (mouse_cap & 1)) ? ( seqm[base + k * 16 + s] !== paint_v ? ( seqm[base + k * 16 + s] = paint_v; pat_dirty = 1; ); );
      s += 1;
    );
    r += 1;
  );
  font(8.5, 'b');
  s = 0;
  loop(16, sprintf(#sn, "%d", s + 1); gfx_set(0.25, 0.25, 0.27, 1); text_c(#sn, 124 + s * cw + (cw - 5) * 0.5, 463); s += 1; );
);

function pad(c) local(x, y, w, h, QX, QY, QW, QH, hov, t, lit, vel) (
  x = 16 + c * 88 + 6; y = 510; w = 76; h = 70;
  QX = sx(x); QY = sy(y); QW = w * z; QH = h * z;
  grp_col(c < 4 ? 0 : c < 8 ? 4 : 8);
  hov = hit(x, y, w, h);
  t = hitN[col_trig(c)] > 0 ? (smpN - hitN[col_trig(c)]) / srate : 99;
  lit = t >= 0 && t < 0.25 ? 1 - t / 0.25 : 0;
  gfx_set(0.03, 0.03, 0.03, 1);
  gfx_rect(QX - 2 * z, QY - 2 * z, QW + 4 * z, QH + 4 * z, 1);
  gfx_gradrect(QX, QY, QW, QH, gr, gg, gb, 1, 0, 0, 0, 0, -0.18 * gr / QH, -0.18 * gg / QH, -0.18 * gb / QH, 0);
  gfx_set(1, 1, 1, 0.25);
  gfx_rect(QX, QY, QW, max(1, 1.5 * z), 1);
  gfx_set(0, 0, 0, 0.22);
  gfx_rect(QX, QY + QH - 5 * z, QW, 5 * z, 1);
  hov ? ( gfx_set(1, 1, 1, 0.10); gfx_rect(QX, QY, QW, QH, 1); );
  font(15, 'b');
  gfx_set(0.12, 0.08, 0.06, 0.85);
  c == 9 || c == 10 ? ( text_c(c == 9 ? "RIDE" : "CRASH", x + w * 0.5, y + 17); ) : (
    text_c(c == 0 ? "BASS" : c == 1 ? "SNARE" : c == 2 ? "LOW" : c == 3 ? "MID" : c == 4 ? "HI" : c == 5 ? "RIM" : c == 6 ? "HAND" : c == 7 ? "CLOSED" : "OPEN", x + w * 0.5, y + 8);
    text_c(c <= 1 ? "DRUM" : c <= 4 ? "TOM" : c == 5 ? "SHOT" : c == 6 ? "CLAP" : "HAT", x + w * 0.5, y + 26);
  );
  note_name(voice_note(col_trig(c)), #nn);
  sprintf(#nt, "%s  %d", #nn, voice_note(col_trig(c)));
  font(8.5, 'b');
  gfx_set(0.12, 0.08, 0.06, 0.7);
  text_c(#nt, x + w * 0.5, y + h - 20);
  gfx_set(0.25, 0.03, 0.02, 1);
  gfx_circle(sx(x + w * 0.5), sy(y - 12), 4.5 * z, 1, 1);
  lit > 0 ? (
    gfx_set(1, 0.18, 0.08, 0.35 * lit); gfx_circle(sx(x + w * 0.5), sy(y - 12), 10 * z, 1, 1);
    gfx_set(1, 0.25 + 0.4 * lit, 0.15 + 0.3 * lit, lit); gfx_circle(sx(x + w * 0.5), sy(y - 12), 4.5 * z, 1, 1);
  );
  (mouse_click && hov && (mouse_cap & 8)) ? ( copy_row(col_trig(c)); mouse_click = 0; );
  (mouse_click && hov) ? (
    vel = floor(127 - 87 * clamp01((mouse_y - QY) / QH) + 0.5);
    gq[gq_w * 2] = col_trig(c); gq[gq_w * 2 + 1] = vel; gq_w = (gq_w + 1) & 63;
    mouse_click = 0;
  );
);

function tab(x, w, n, label) local(hov, QX, QY, QW, QH, on) (
  on = page == n;
  QX = sx(x); QY = sy(18); QW = w * z; QH = 26 * z;
  hov = hit(x, 18, w, 26);
  gfx_set(0.05, 0.05, 0.05, 1);
  gfx_rect(QX - z, QY - z, QW + 2 * z, QH + 2 * z, 1);
  on ? gfx_gradrect(QX, QY, QW, QH, 0.95, 0.50, 0.16, 1, 0, 0, 0, 0, -0.15 / QH, -0.10 / QH, -0.05 / QH, 0)
     : gfx_gradrect(QX, QY, QW, QH, 0.30, 0.30, 0.31, 1, 0, 0, 0, 0, -0.08 / QH, -0.08 / QH, -0.08 / QH, 0);
  hov && !on ? ( gfx_set(1, 1, 1, 0.10); gfx_rect(QX, QY, QW, QH, 1); );
  font(10.5, 'b');
  on ? gfx_set(0.10, 0.06, 0.03, 1) : gfx_set(0.92, 0.92, 0.90, 1);
  text_c(label, x + w * 0.5, 24);
  (mouse_click && hov) ? ( page = n; mouse_click = 0; );
);

function logo() local(tw, th) (
  gfx_setfont(4, "Arial", 32 * z, 'bi');
  gfx_set(0.08, 0.08, 0.09, 1);
  gfx_x = sx(16); gfx_y = sy(8);
  gfx_drawstr("DR. NINE");
  gfx_measurestr("DR. NINE", tw, th);
  tw /= z;
  gfx_set(0.93, 0.42, 0.13, 1);
  box(16, 44, tw + 6, 3);
  font(9.5, 'b');
  gfx_set(0.25, 0.25, 0.27, 1);
  text_l("DRUM MACHINE", 16 + tw + 22, 14);
  font(9, 0);
  text_l("by chmaha  ·  based on 9W9", 16 + tw + 22, 30);
);

