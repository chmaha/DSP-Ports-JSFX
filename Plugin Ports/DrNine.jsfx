  outs==11 ? (
    printf("out_pin:Bass Drum\n");
    printf("out_pin:Snare Drum\n");
    printf("out_pin:Low Tom\n");
    printf("out_pin:Mid Tom\n");
    printf("out_pin:Hi Tom\n");
    printf("out_pin:Rim Shot\n");
    printf("out_pin:Hand Clap\n");
    printf("out_pin:Hi-Hat\n");
    printf("out_pin:Ride\n");
    printf("out_pin:Crash\n");
    printf("out_pin:FX Return\n");
  ) : (
    printf("out_pin:Left\n");
    printf("out_pin:Right\n");
  );
?>

@init

ext_noinit = gfx_ext_retina = 1;
last_srate = srate;

function alloc(n) local(r) instance(mp) ( r = mp; mp += n; memset(r, 0, n); r; );

function rate_init()
(
  g_sr = srate; g_rt = 44100 / srate; g_rti = srate / 44100; g_nsc = sqrt(g_rti);
);
function ref_pole(c) ( g_sr === 44100 ? c : c ^ g_rt; );
function ref_step(c) ( g_sr === 44100 ? c : 1 - (1 - c) ^ g_rt; );

function tanh_(x) local(e)
(
  x > 20 ? 1 : x < -20 ? -1 : ( e = exp(2 * x); (e - 1) / (e + 1); );
);

function wp_init(p, v) ( p[0] = 0; p[5] = v; p[1] = v; p[2] = v; p[3] = 0; p[4] = 0; );
function wp_set(p, v) ( p[0] = 0; p[5] = v; p[1] = v; p[2] = v; );
function wp_exp(p, v1, d)
(
  v1 < 0.000000001 ? v1 = 0.000000001;
  p[5] < 0.000000001 ? p[5] = 0.000000001;
  p[0] = 2; p[1] = p[5]; p[2] = v1; p[3] = 0; p[4] = d > 0 ? d : 1;
);
function wp_tick(p)
(
  p[0] === 2 ? (
    p[3] >= p[4] ? ( p[5] = p[2]; p[0] = 0; ) : (
      p[5] = p[1] * (p[2] / p[1]) ^ (p[3] / p[4]);
      p[3] += 1;
      p[3] >= p[4] ? ( p[5] = p[2]; p[0] = 0; );
    );
  );
  p[5];
);

function bq_set(f, type, freq, q, sr) local(fc, w0, cw, sw, al, b0, b1, b2, a0, a1, a2, ia)
(
  fc = freq / (sr * 0.5);
  fc >= 1 ? fc = 0.9999;
  fc <= 0 ? fc = 0.0001;
  w0 = $pi * fc; cw = cos(w0); sw = sin(w0);
  q < 0.0001 ? q = 0.0001;
  al = sw / (2 * q);
  type === 0 ? (
    b0 = (1 - cw) * 0.5; b1 = 1 - cw; b2 = (1 - cw) * 0.5;
  ) : type === 1 ? (
    b0 = (1 + cw) * 0.5; b1 = -(1 + cw); b2 = (1 + cw) * 0.5;
  ) : (
    b0 = al; b1 = 0; b2 = -al;
  );
  a0 = 1 + al; a1 = -2 * cw; a2 = 1 - al;
  ia = 1 / a0;
  f[0] = b0 * ia; f[1] = b1 * ia; f[2] = b2 * ia; f[3] = a1 * ia; f[4] = a2 * ia;
);
function bq_reset(f) ( f[5] = f[6] = f[7] = f[8] = 0; );
function bq_tick(f, x) local(y)
(
  y = ((f[0] * x + f[1] * f[5] + f[2] * f[6]) - f[3] * f[7]) - f[4] * f[8];
  f[6] = f[5]; f[5] = x;
  f[8] = f[7]; f[7] = y;
  y;
);

function tri(o, fr) local(p)
(
  o[0] += fr / g_sr;
  while (o[0] >= 1) ( o[0] -= 1; );
  p = o[0];
  p < 0.5 ? 4 * p - 1 : 3 - 4 * p;
);

function noise_tick() local(th, tl)
(
  th = ((nz_hi << 13) + (nz_lo >> 3)) & 65535; tl = (nz_lo << 13) & 65535;
  nz_hi = nz_hi ~ th; nz_lo = nz_lo ~ tl;
  nz_lo = nz_lo ~ (nz_hi >> 1);
  th = ((nz_hi << 5) + (nz_lo >> 11)) & 65535; tl = (nz_lo << 5) & 65535;
  nz_hi = nz_hi ~ th; nz_lo = nz_lo ~ tl;
  (nz_hi * 65536 + nz_lo) / 2147483648 - 1;
);

function diode(x, dr) local(k) ( k = dr > 0.01 ? dr : 0.01; tanh_(k * x) / tanh_(k); );

function shape(x, dr, type, st) local(t, k, v, body, i, steps, q, hold, u, wet, m, g)
(
  t = floor(type + 0.5);
  k = dr > 0.01 ? dr : 0.01;
  t === 1 ? (
    v = (tanh_(x * k + 0.35) - 0.33638) * 0.958;
    k < 1 ? v / k : v;
  ) : t === 5 ? (
    v = x * k;
    loop(3,
      v > 1 ? v = 2 - v;
      v < -1 ? v = -2 - v;
    );
    body = x * k;
    body > 1 ? body = 1;
    body < -1 ? body = -1;
    v = 0.62 * v + 0.38 * body;
    k < 1 ? v / k : v;
  ) : t === 6 ? (
    steps = 1.5 + 9 / k;
    q = floor(x * steps + 0.5) / steps;
    hold = (k < 1 ? 1 : 1 + (k - 1) * 1.7) * g_rti;
    st[1] += 1;
    st[1] >= hold ? ( st[1] -= hold; st[0] = q; );
    st[0];
  ) : t === 2 ? (
    u = x * k + 0.08 * k * x * x;
    wet = u / (1 + abs(u));
    m = k < 1 ? k : 1;
    v = (1 - 0.65 * m) * x * (k < 1 ? k : 1) + 0.65 * m * wet * 1.35;
    k < 1 ? v / k : v;
  ) : t === 3 ? (
    g = k * 2.5;
    u = x * g + 0.22;
    wet = (u / (1 + abs(u)) - 0.18033) * 1.05;
    m = (k - 0.85) / 1.15;
    m < 0 ? m = 0;
    m > 1 ? m = 1;
    (1 - m) * x + m * wet;
  ) : t === 4 ? (
    u = x * k + 0.12;
    u > 1 ? u = 1;
    u < -1 ? u = -1;
    ((u - ((u * u) * u) / 3) - (0.12 - (0.12 * 0.12 * 0.12) / 3)) * (1.5 / 1.479);
  ) : (
    tanh_(k * x) / tanh_(k);
  );
);

VCA_VT = 0.0002;
VCA_NORM = 1 / (1 - VCA_VT);

function bt_init(v)
(
  bq_set((v + 83), 1, 20, 0.7071, g_sr);
  v[26] = v[0];
  wp_init((v + 32), v[0]);
  wp_init((v + 38), 0);
  wp_init((v + 44), 0);
  wp_init((v + 50), 0);
  bq_set((v + 56), 0, v[5] > 0 ? v[5] : 3000, 0.7071, g_sr);
  bq_set((v + 65), 1, v[13] > 0 ? v[13] : 800, 0.7071, g_sr);
  bq_set((v + 74), 0, 6500, 0.7071, g_sr);
  v[24] <= 0 ? v[24] = 1;
  v[23] = 49;
);

function bt_trigger(v, acc) local(ms, tau, m, pm, longest)
(
  ms = 0.001 * g_sr;
  v[30] = 0.25; v[31] = 0.25;
  bq_reset((v + 83));
  v[26] = v[0];
  v[20] ? (
    tau = v[0] < 6 ? 6 : (v[0] > 32 ? 32 : v[0]);
    m = v[1] < 0 ? 0 : (v[1] > 1 ? 1 : v[1]);
    pm = v[24] > 0 ? v[24] : 1;
    v[23] = 49 * (1 + m * (pm - 1));
    v[21] = 4.6 * tau * (1 + 1.2 * m);
    v[22] = exp(-1 / (tau * ms));
    v[25] = floor(16 * ms);
    wp_set((v + 32), v[23]);
  ) : (
    wp_set((v + 32), v[26] * v[1]);
    wp_exp((v + 32), v[26], v[2] * ms);
  );
  wp_set((v + 38), 1);
  v[17] = floor(v[16] * ms);
  v[17] <= 0 ? wp_exp((v + 38), 0.00001, v[3] * ms);
  wp_set((v + 44), 1);
  wp_exp((v + 44), 0.00001, 3 * ms);
  v[11] > 0 ? (
    wp_set((v + 50), 1);
    v[14] = floor(24 * ms);
    v[15] = 0;
  );
  v[28] = 2;
  v[27] = v[7] * acc;
  longest = v[3] > v[12] ? v[3] : v[12];
  v[29] = (longest + 20) * ms;
);

function bt_render(v, nz) local(f, amp, two, o, ratio, body, click, snare, env)
(
  v[29] <= 0 ? 0 : (
    v[29] -= 1;
    f = wp_tick((v + 32));
    v[20] ? (
      f = v[23] + v[21];
      v[25] > 0 ? v[25] -= 1 : v[21] *= v[22];
    );
    v[17] > 0 ? (
      v[17] -= 1;
      v[17] === 0 ? wp_exp((v + 38), 0.00001, v[3] * 0.001 * g_sr);
    );
    amp = wp_tick((v + 38));
    two = v[9] > 0 && v[10] > 0;
    two ? amp = amp > VCA_VT ? (amp - VCA_VT) * VCA_NORM : 0;
    o = tri((v + 30), f);
    !two ? (
      o = diode(o, 1.6);
      o += 0.05 * o * o;
      o = bq_tick((v + 83), o);
    ) : (
      o = diode(o, 2);
      ratio = v[0] > 1 ? v[9] / v[0] : 1;
      o += diode(tri((v + 31), f * ratio), 2) * v[10];
      o /= (1 + v[10]);
    );
    body = shape(o, v[6], v[8], (v + 18)) * amp;
    click = 0;
    v[28] > 0 ? ( click += g_rti; v[28] -= 1; );
    click += bq_tick((v + 56), nz);
    click *= wp_tick((v + 44)) * v[4];
    snare = 0;
    v[11] > 0 && !v[15] ? (
      v[14] > 0 ? (
        v[14] -= 1;
        v[14] === 0 ? wp_exp((v + 50), 0.00001, (v[12] > 0 ? v[12] : 120) * 0.7 * 0.001 * g_sr);
      );
      env = wp_tick((v + 50));
      v[14] <= 0 ? (
        env = env > VCA_VT ? (env - VCA_VT) * VCA_NORM : 0;
        env <= 0 ? v[15] = 1;
      );
      snare = bq_tick((v + 74), bq_tick((v + 65), nz)) * env * v[11] * 1.95;
    );
    (body + click + snare) * v[27];
  );
);

function tom_init(t)
(
  wp_init((t + 21), 100);
  bq_set((t + 33), 2, 1200, 1.2, g_sr);
  bq_set((t + 42), 1, 20, 0.7071, g_sr);
);

function tom_trigger(t, p, acc) local(ms)
(
  ms = 0.001 * g_sr;
  t[0] = 0.25; t[1] = 0.25; t[2] = 0.25;
  bq_reset((t + 42));
  wp_set((t + 21), p[0] * p[1]);
  wp_exp((t + 21), p[0], p[2] * ms);
  wp_set((t + 3), 1);    wp_exp((t + 3), 0.00001, p[3] * ms);
  wp_set((t + 9), 0.55); wp_exp((t + 9), 0.00001, 110 * ms);
  wp_set((t + 15), 0.45); wp_exp((t + 15), 0.00001, 70 * ms);
  t[52] = p[4];
  wp_set((t + 27), 1); wp_exp((t + 27), 0.00001, 8 * ms);
  t[51] = p[7] * acc;
  t[55] = (p[3] + 60) * ms;
);

function tom_render(t, p, nz) local(f, o, stick, y)
(
  t[55] <= 0 ? 0 : (
    t[55] -= 1;
    f = wp_tick((t + 21));
    o = 0;
    o += diode(tri((t + 0), f * 1), 2) * wp_tick((t + 3));
    o += diode(tri((t + 1), f * 1.5), 2) * wp_tick((t + 9));
    o += diode(tri((t + 2), f * 2.75), 2) * wp_tick((t + 15));
    o *= 0.55;
    stick = bq_tick((t + 33), nz) * wp_tick((t + 27)) * t[52] * 1.5;
    y = shape(o + stick, p[6], p[8], (t + 53));
    y = bq_tick((t + 42), y);
    y * t[51];
  );
);

function rim_retune()
(
  bq_set((rm + 8), 2, rm[0], rm[2], g_sr);
  bq_set((rm + 17), 2, rm[1], rm[2] * 1.1, g_sr);
);
function rim_init()
(
  bq_set((rm + 8), 2, rm[0] > 0 ? rm[0] : 220, rm[2] > 0 ? rm[2] : 12, g_sr);
  bq_set((rm + 17), 2, rm[1] > 0 ? rm[1] : 480, rm[2] > 0 ? rm[2] * 1.1 : 11, g_sr);
  bq_set((rm + 26), 1, 120, 0.7071, g_sr);
  rm[45] = 1;
);
function rim_trigger(acc) local(ms)
(
  ms = 0.001 * g_sr;
  wp_set((rm + 35), 1);
  wp_exp((rm + 35), 0.00001, rm[3] * ms);
  rm[43] = 2;
  rm[45] = acc;
  rm[44] = (rm[3] + 20) * ms;
);
function rim_render(nz) local(exc, a, y)
(
  rm[44] <= 0 ? 0 : (
    rm[44] -= 1;
    exc = 0;
    rm[43] > 0 ? ( exc += (1 + nz * rm[4]) * g_rti; rm[43] -= 1; );
    a = wp_tick((rm + 35));
    y = bq_tick((rm + 8), exc) * 60 + bq_tick((rm + 17), exc) * 32;
    y = shape(y * a, rm[5], rm[6], (rm + 41));
    y = bq_tick((rm + 26), y);
    y * rm[7] * rm[45];
  );
);

function clap_retune() ( bq_set((cp + 9), 2, cp[0], cp[1], g_sr); );
function clap_init()
(
  bq_set((cp + 9), 2, cp[0] > 0 ? cp[0] : 1000, cp[1] > 0 ? cp[1] : 2.5, g_sr);
  bq_set((cp + 18), 1, 400, 0.7071, g_sr);
  cp[41] = 4;
  cp[44] = 1;
);
function clap_trigger(acc) local(ms)
(
  ms = 0.001 * g_sr;
  cp[41] = 0;
  cp[42] = 0;
  wp_set((cp + 33), 0);
  cp[44] = acc;
  cp[43] = (cp[4] + cp[2] * 4 + 40) * ms;
);
function clap_render(nz) local(ms, env, y)
(
  cp[43] <= 0 ? 0 : (
    cp[43] -= 1;
    ms = 0.001 * g_sr;
    cp[41] < 4 ? (
      cp[42] <= 0 ? (
        wp_set((cp + 27), cp[41] === 0 ? 1.22 : cp[41] === 1 ? 1.35 : cp[41] === 2 ? 1.68 : 1);
        wp_exp((cp + 27), 0.00001, cp[3] * ms);
        cp[41] === 3 ? (
          wp_set((cp + 33), cp[5]);
          wp_exp((cp + 33), 0.00001, cp[4] * ms);
