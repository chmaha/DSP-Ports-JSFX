);
function init_lfospd() local(d) (
  d = LFOSPD;
  d[0]=5; d[1]=15; d[2]=25; d[3]=40; d[4]=55; d[5]=70; d[6]=80; d[7]=90; d[8]=100; d[9]=110; d[10]=120; d[11]=130; d[12]=140; d[13]=150; d[14]=160; d[15]=170;
