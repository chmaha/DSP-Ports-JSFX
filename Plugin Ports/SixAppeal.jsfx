  d[192]=0.73959335; d[193]=0.74499988; d[194]=0.75040642; d[195]=0.75581296; d[196]=0.7612195; d[197]=0.76662603; d[198]=0.77203257; d[199]=0.77699595; d[200]=0.78039246; d[201]=0.78378896; d[202]=0.78718546; d[203]=0.79058197; d[204]=0.79397847; d[205]=0.79737497; d[206]=0.80077148; d[207]=0.80396651;
  d[208]=0.8062969; d[209]=0.80862729; d[210]=0.81095768; d[211]=0.81328808; d[212]=0.81561847; d[213]=0.81794886; d[214]=0.82027925; d[215]=0.82300248; d[216]=0.82782737; d[217]=0.83265226; d[218]=0.83747715; d[219]=0.84230204; d[220]=0.84712694; d[221]=0.85195183; d[222]=0.85677672; d[223]=0.86179402;
  d[224]=0.86814615; d[225]=0.87449828; d[226]=0.8808504; d[227]=0.88720253; d[228]=0.89355466; d[229]=0.89990679; d[230]=0.90625891; d[231]=0.91213508; d[232]=0.91344998; d[233]=0.91476487; d[234]=0.91607977; d[235]=0.91739467; d[236]=0.91870957; d[237]=0.92002446; d[238]=0.92133936; d[239]=0.92291244;
