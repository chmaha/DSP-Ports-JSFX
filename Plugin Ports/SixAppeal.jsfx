// ---------------------------------------------------------------- voice state load/save
function cv_load(v)
(
  cv = v;
  cv_pitch = v[O_PITCH]; cv_vel = v[O_VEL]; cv_glide = v[O_GLIDE];
  cv_opos = v[O_OPOS]; cv_osub = v[O_OSUB]; cv_osawg = v[O_OSAWG]; cv_opulg = v[O_OPULG]; cv_osubg = v[O_OSUBG];
  cv_bpos = v[O_BPOS]; cv_bsub = v[O_BSUB]; cv_bsawg = v[O_BSAWG]; cv_bpulg = v[O_BPULG]; cv_bsubg = v[O_BSUBG];
  cv_s0 = v[O_S0]; cv_s1 = v[O_S1]; cv_s2 = v[O_S2]; cv_s3 = v[O_S3]; cv_nseed = v[O_NSEED]; cv_inenv = v[O_INENV];
  cv_cfrq = v[O_CFRQ]; cv_cres = v[O_CRES]; cv_cj106 = v[O_CJ106]; cv_ck = v[O_CK];
  cv_cg1 = v[O_CG1]; cv_cg1_2 = v[O_CG1_2]; cv_cg1_3 = v[O_CG1_3];
  cv_cinvden = v[O_CINVDEN]; cv_ckfb = v[O_CKFB]; cv_cinvkfb = v[O_CINVKFB]; cv_cnoise = v[O_CNOISE];
  cv_state = v[O_STATE]; cv_env = v[O_ENV]; cv_gate = v[O_GATEENV]; cv_envint = v[O_ENVINT];
  cv_envprev = v[O_ENVPREV]; cv_envnext = v[O_ENVNEXT];
  cv_lastpeak = v[O_LASTPEAK]; cv_vcaslew = v[O_VCASLEW]; cv_vcfslew = v[O_VCFSLEW];
  cv_podcs = v[O_PODCS]; cv_pvdcs = v[O_PVDCS];
  cv_fwacc = v[O_FWACC]; cv_fwenvp = v[O_FWENVP]; cv_fwenvn = v[O_FWENVN];
  cv_dacp = v[O_DACP]; cv_dacn = v[O_DACN]; cv_dacupd = v[O_DACUPD]; cv_vcaupd = v[O_VCAUPD];
  cv_vcfph = v[O_VCFPH]; cv_vcaph = v[O_VCAPH];
  cv_vfofs = v[O_VFOFS]; cv_frqtrim = v[O_FRQTRIM]; cv_widtrim = v[O_WIDTRIM];
  cv_pitchofs = v[O_PITCHOFS]; cv_vcags = v[O_VCAGS]; cv_pwmino = v[O_PWMINO]; cv_pwmaxo = v[O_PWMAXO];
);

function cv_save() local(v)
(
  v = cv;
  v[O_PITCH] = cv_pitch; v[O_VEL] = cv_vel; v[O_GLIDE] = cv_glide;
  v[O_OPOS] = cv_opos; v[O_OSUB] = cv_osub; v[O_OSAWG] = cv_osawg; v[O_OPULG] = cv_opulg; v[O_OSUBG] = cv_osubg;
  v[O_BPOS] = cv_bpos; v[O_BSUB] = cv_bsub; v[O_BSAWG] = cv_bsawg; v[O_BPULG] = cv_bpulg; v[O_BSUBG] = cv_bsubg;
  v[O_S0] = cv_s0; v[O_S1] = cv_s1; v[O_S2] = cv_s2; v[O_S3] = cv_s3; v[O_NSEED] = cv_nseed; v[O_INENV] = cv_inenv;
  v[O_CFRQ] = cv_cfrq; v[O_CRES] = cv_cres; v[O_CJ106] = cv_cj106; v[O_CK] = cv_ck;
  v[O_CG1] = cv_cg1; v[O_CG1_2] = cv_cg1_2; v[O_CG1_3] = cv_cg1_3;
  v[O_CINVDEN] = cv_cinvden; v[O_CKFB] = cv_ckfb; v[O_CINVKFB] = cv_cinvkfb; v[O_CNOISE] = cv_cnoise;
  v[O_STATE] = cv_state; v[O_ENV] = cv_env; v[O_GATEENV] = cv_gate; v[O_ENVINT] = cv_envint;
  v[O_ENVPREV] = cv_envprev; v[O_ENVNEXT] = cv_envnext;
  v[O_LASTPEAK] = cv_lastpeak; v[O_VCASLEW] = cv_vcaslew; v[O_VCFSLEW] = cv_vcfslew;
  v[O_PODCS] = cv_podcs; v[O_PVDCS] = cv_pvdcs;
  v[O_FWACC] = cv_fwacc; v[O_FWENVP] = cv_fwenvp; v[O_FWENVN] = cv_fwenvn;
  v[O_DACP] = cv_dacp; v[O_DACN] = cv_dacn; v[O_DACUPD] = cv_dacupd; v[O_VCAUPD] = cv_vcaupd;
);

// ---------------------------------------------------------------- ADSR
function adsr_tick106() local(sum, diff)
(
  cv_state == ST_ATTACK ? (
    sum = cv_envint + g_atkinc;
    sum >= ENVMAX ? (cv_envint = ENVMAX; cv_state = ST_DECAY;) : cv_envint = sum;
  ) : cv_state == ST_DECAY ? (
    cv_envint > g_susint ? (
      diff = cv_envint - g_susint;
      diff = calc_decay(diff, g_decmul);
      cv_envint = (diff + g_susint) & 65535;
    ) : cv_envint = g_susint;
  ) : cv_state == ST_RELEASE ? (
    cv_envint = calc_decay(cv_envint, g_relmul);
    cv_envint == 0 ? cv_state = ST_FINISHED;
  );
);

function adsr_note_on()
(
  cv_state = ST_ATTACK;
  g_model == MDL_J106 ? (
    cv_envprev = cv_envint / ENVMAX;
    adsr_tick106();
    cv_envnext = cv_envint / ENVMAX;
  );
);

function adsr_process_j6()
(
  cv_state == ST_ATTACK ? (
    cv_env += (1.2 - cv_env) * g_atkc;
    cv_gate += 0.03125;
    cv_env >= 1 ? (cv_env = 1; cv_state = ST_DECAY;);
  ) : cv_state == ST_DECAY ? (
    cv_env += (g_sustain - cv_env) * g_decc;
    cv_gate += 0.03125;
  ) : cv_state == ST_RELEASE ? (
    cv_gate -= 0.03125;
    cv_env += (-0.1 - cv_env) * g_relc;
    cv_env < 0.00001 ? (cv_env = 0; cv_state = ST_FINISHED;);
  ) : (
    cv_gate -= 0.03125;
  );
  cv_gate = clampv(cv_gate, 0, 1);
  cv_env;
);

function adsr_update_gate()
(
  cv_state == ST_ATTACK || cv_state == ST_DECAY ? cv_gate += 0.03125 : cv_gate -= 0.03125;
  cv_gate = clampv(cv_gate, 0, 1);
);

function voice_busy(v) ( v[O_STATE] != ST_FINISHED || v[O_GATEENV] > 0; );

// ---------------------------------------------------------------- firmware tick (J106)
function pitch88_of(gp) local(gm, p)
(
  gm = gp * 12 + 69;
  p = gm * 256;
  p = p < 0 ? ceil(p) : floor(p);
  clampv(p, 0, 32512);
);

function firmware_tick(lfoRaw) local(lfoVal, lfoPol, depth, sig, bendVal, bendPol, bamt)
(
  adsr_tick106();
  cv_fwenvp = cv_envint / ENVMAX;
  lfoVal = floor(abs(lfoRaw) * 8191);
  lfoPol = lfoRaw < 0;
  depth = floor(g_lfoenvamp * 255);
  sig = calc_vcf_lfo_signal(g_lfodepthint, depth, lfoVal);
  bendVal = floor(abs(g_rawbend) * 255);
  bendPol = g_rawbend < 0;
  bamt = calc_vcf_bend_amt(g_bendsensint, bendVal);
  cv_dacp = calc_vcf_freq(g_cutoffint, sig, bamt, g_envmodint, g_keytrackint,
                          lfoPol, bendPol, g_envinv > 0, cv_envint, pitch88_of(cv_glide));
);

// ---------------------------------------------------------------- trigger / release
function voice_trigger(v, level, isRetrig) local(bendVal, bamt)
(
  cv_load(v);
  cv_vel = sqrt(level);
  (!g_porta_en || cv_glide < -10) ? cv_glide = cv_pitch;
  adsr_note_on();
  g_model == MDL_J106 ? (
    cv_fwenvp = cv_fwenvn = cv_envnext;
    bendVal = floor(abs(g_rawbend) * 255);
    bamt = calc_vcf_bend_amt(g_bendsensint, bendVal);
    cv_dacp = cv_dacn = calc_vcf_freq(g_cutoffint, 0, bamt, g_envmodint, g_keytrackint,
                                      0, g_rawbend < 0, g_envinv > 0, cv_envint, pitch88_of(cv_glide));
  );
  !isRetrig ? (
    cv_opos = 0;
    cv_osub = 0;
    cv_vcaslew = 0;
  );
  cv_save();
);

function voice_release(v) ( v[O_STATE] = ST_RELEASE; );

function voice_force_finish(v)
(
  v[O_STATE] = ST_FINISHED;
  v[O_ENV] = 0; v[O_GATEENV] = 0; v[O_ENVINT] = 0; v[O_ENVNEXT] = 0; v[O_ENVPREV] = 0;
);

// ---------------------------------------------------------------- VCF (IR3109 4-pole OTA ladder)
function ota_sat(x) local(x2)
(
  x > 3 ? 1 : x < -3 ? -1 : (x2 = x * x; x * (27 + x2) / (27 + 9 * x2););
);

function ota_sat_d(x) local(x2, d)
(
  (x > 3 || x < -3) ? 0 : (x2 = x * x; d = 27 + 9 * x2; 27 * (27 - 3 * x2) / (d * d););
);

function resk_j6(res) ( 0.811 * (exp(2.128 * res) - 1); );

function resk_j106(res) local(r2, r3, r4, k, knee, boost)
(
  r2 = res * res; r3 = r2 * res; r4 = r2 * r2;
  k = 4.6265 * res + 4.3866 * r2 - 8.9869 * r3 + 3.3902 * r4;
  res > 0.7 ? (knee = (res - 0.7) / 0.3; k += min(knee * knee * 1.2, 0.35););
  boost = max(0, (res - 0.898) * (0.17 / 0.102));
  k * (1 + boost);
);

function softclip_k(k) local(ex)
(
  k > 3 ? (ex = k - 3; k = 3 + ex / (1 + ex * 0.2););
  min(k, 6.6);
);

function vcf_update(frq, res) local(k, fade, frqOver, g, kFit, logM, g1, se, en)
(
  (frq !== cv_cfrq || res !== cv_cres || g_j106res !== cv_cj106) ? (
    cv_cfrq = frq; cv_cres = res; cv_cj106 = g_j106res;
    k = g_j106res ? resk_j106(res) : softclip_k(resk_j6(res));
    g_os == 1 && frq > 0.7 ? (fade = max(1 - (frq - 0.7) / 0.2, 0); k *= fade;);
    frqOver = min(frq * g_overscale, 0.85);
    g = tan(frqOver * $pi * 0.5);
    kFit = clampv(k, 0, 5);
    logM = 0.20646 + kFit * (-0.04140 + kFit * (0.00602 - kFit * 0.00127));
    k < 1 ? logM *= max(k, 0);
    k > 3.7 ? (fade = min(1, max(0, (4.4 - k) / 0.7)); logM *= fade;);
    g *= exp(logM);
    g = min(g, 10);
    g1 = g / (1 + g);
    cv_ck = k;
    cv_cg1 = g1; cv_cg1_2 = g1 * g1; cv_cg1_3 = cv_cg1_2 * g1;
    cv_cinvden = 1 / (1 + k * cv_cg1_2 * cv_cg1_2);
    cv_ckfb = 4.2 * clampv(k - 2.5, 0.3, 1);
    cv_cinvkfb = 1 / cv_ckfb;
  );
  se = abs(cv_s0) + abs(cv_s1) + abs(cv_s2) + abs(cv_s3);
  en = max(cv_inenv, se);
  cv_cnoise = 0.01 / (g_os * (1 + en * 1000));
);

function vcf_sample(input) local(white, S, od, oo, u, sa, df, g1n, gn, x, y, sd, t, dd, x2, q)
(
  cv_nseed = lcg(cv_nseed);
  white = (cv_nseed >> 9) / 4194304 - 1;
  input += white * cv_cnoise;
  cv_s0 += 0.00000000000000000001;
  S = (1 - cv_cg1) * (cv_s0 * cv_cg1_3 + cv_s1 * cv_cg1_2 + cv_s2 * cv_cg1 + cv_s3);
  od = input * 0.065 - S;
  oo = ota_sat(od * cv_ckfb) * cv_cinvkfb;
  u = (input * 0.142 + cv_ck * oo) * cv_cinvden;
  sa = abs(cv_s3);
  df = max(1 / sqrt(1 + 0.6 * sa * sa), 0.65);
  g1n = min(cv_cg1 / df, 0.98);
  gn = g1n / (1 - g1n);
  y = cv_s0 + g1n * (u - cv_s0); sd = (u - y) * 0.35;
  sd > 3 ? (t = 2.857142857142857; dd = 1;) : sd < -3 ? (t = -2.857142857142857; dd = 1;) : (
    x2 = sd * sd; q = 1 / (27 + 9 * x2);
    t = sd * (27 + x2) * q * 2.857142857142857;
    dd = 1 + gn * 27 * (27 - 3 * x2) * q * q;
  );
  y -= (y - cv_s0 - gn * t) / dd; cv_s0 = 2 * y - cv_s0; x = y;
  y = cv_s1 + g1n * (x - cv_s1); sd = (x - y) * 0.35;
  sd > 3 ? (t = 2.857142857142857; dd = 1;) : sd < -3 ? (t = -2.857142857142857; dd = 1;) : (
    x2 = sd * sd; q = 1 / (27 + 9 * x2);
    t = sd * (27 + x2) * q * 2.857142857142857;
    dd = 1 + gn * 27 * (27 - 3 * x2) * q * q;
  );
  y -= (y - cv_s1 - gn * t) / dd; cv_s1 = 2 * y - cv_s1; x = y;
  y = cv_s2 + g1n * (x - cv_s2); sd = (x - y) * 0.35;
  sd > 3 ? (t = 2.857142857142857; dd = 1;) : sd < -3 ? (t = -2.857142857142857; dd = 1;) : (
    x2 = sd * sd; q = 1 / (27 + 9 * x2);
    t = sd * (27 + x2) * q * 2.857142857142857;
    dd = 1 + gn * 27 * (27 - 3 * x2) * q * q;
  );
  y -= (y - cv_s2 - gn * t) / dd; cv_s2 = 2 * y - cv_s2; x = y;
  y = cv_s3 + g1n * (x - cv_s3); sd = (x - y) * 0.35;
  sd > 3 ? (t = 2.857142857142857; dd = 1;) : sd < -3 ? (t = -2.857142857142857; dd = 1;) : (
    x2 = sd * sd; q = 1 / (27 + 9 * x2);
    t = sd * (27 + x2) * q * 2.857142857142857;
    dd = 1 + gn * 27 * (27 - 3 * x2) * q * q;
  );
  y -= (y - cv_s3 - gn * t) / dd; cv_s3 = 2 * y - cv_s3; x = y;
  y * 8.59;
);

function dc_post_osc(x) local(vv, lp)
(
  vv = (x - cv_podcs) * g_podk;
  lp = cv_podcs + vv;
  cv_podcs = lp + vv;
  x - lp;
);

function dc_post_vcf(x) local(vv, lp)
(
  vv = (x - cv_pvdcs) * g_pvdk;
  lp = cv_pvdcs + vv;
  cv_pvdcs = lp + vv;
  x - lp;
);

// ---------------------------------------------------------------- oscillators
function polyblep(t, dt) local(dt2, n, n2, u, u2)
(
  dt2 = dt + dt;
  t < dt ? (
    n = t / dt; n2 = n * n;
    0.25 * n2 * n2 - 0.66666667 * n2 * n + 1.33333333 * n - 1;
  ) : t < dt2 ? (
    u = 1 - (t - dt) / dt; u2 = u * u;
    -0.08333333 * u2 * u2;
  ) : t > 1 - dt ? (
    n = (t - 1) / dt; n2 = n * n;
    -0.25 * n2 * n2 - 0.66666667 * n2 * n + 1.33333333 * n + 1;
  ) : t > 1 - dt2 ? (
    u = 1 + (t - 1 + dt) / dt; u2 = u * u;
    0.08333333 * u2 * u2;
  ) : 0;
);

function blep_osc(cps, pw) local(out, blep, saw, effPW, pulse, pw2)
(
  cv_bpos += cps;
  cv_bpos >= 1 ? (cv_bpos -= 1; cv_bsub = !cv_bsub;);
  cv_bsawg += (g_sawon - cv_bsawg) * g_swramp_blep;
  cv_bpulg += (g_pulon - cv_bpulg) * g_swramp_blep;
  cv_bsubg += (g_subon - cv_bsubg) * g_swramp_blep;
  blep = (cv_bpos < cps + cps || cv_bpos > 1 - cps - cps) ? polyblep(cv_bpos, cps) : 0;
  saw = 2 * cv_bpos - 1 - blep;
  out = saw * g_sawamp * cv_bsawg;
  (g_pulon || cv_bpulg > 0.0001) ? (
    effPW = g_pinv ? 1 - pw : pw;
    effPW = clampv(effPW, 0.01, 0.99);
    pulse = cv_bpos < effPW ? -1 : 1;
    pulse -= blep;
    pw2 = cv_bpos - effPW;
    pw2 < 0 ? pw2 += 1;
    (pw2 < cps + cps || pw2 > 1 - cps - cps) ? pulse += polyblep(pw2, cps);
    out += pulse * g_pulamp * cv_bpulg;
  );
  (g_subon || cv_bsubg > 0.0001) ? (
    out += (cv_bsub ? -1 : 1) * (1 - abs(blep)) * g_subamp * g_dcosub * cv_bsubg;
  );
  out;
);

function wt_read(tb, ph) local(idx, i, t, y0, y1, y2, y3, c1, c2, c3)
(
  idx = ph * 4096;
  i = floor(idx);
  t = idx - i;
  y0 = tb[(i - 1) & 4095]; y1 = tb[i & 4095]; y2 = tb[(i + 1) & 4095]; y3 = tb[(i + 2) & 4095];
  c1 = 0.5 * (y2 - y0);
  c2 = y0 - 2.5 * y1 + 2 * y2 - 0.5 * y3;
  c3 = 0.5 * (y3 - y0) + 1.5 * (y1 - y2);
  ((c3 * t + c2) * t + c1) * t + y1;
);

function wt_blend(ph, ti, bl) local(a, b)
(
  ph -= floor(ph);
  a = wt_read(SAWT + ti * 4096, ph);
  b = wt_read(SAWT + (ti + 1) * 4096, ph);
  a + (b - a) * bl;
);

function wt_osc(cps, pw) local(freq, oct, o2, sti, sbl, uti, ubl, effPW, out, sap, sawA, pulA, subA, sph, sub)
(
  freq = cps * g_sr;
  oct = log(max(freq, 1) / 8.176) / log(2);
  o2 = max(0, min(oct - 1, 10)); sti = floor(o2); sbl = o2 - sti;
  o2 = max(0, min(oct - 2, 10)); uti = floor(o2); ubl = o2 - uti;
  effPW = g_pinv ? 1 - pw : pw;
  effPW = clampv(effPW, 0.01, 0.99);
  cv_opos += cps;
  cv_opos >= 1 ? (cv_opos -= 1; cv_osub = !cv_osub;);
  cv_osawg += (g_sawon - cv_osawg) * g_swramp_wt;
  cv_opulg += (g_pulon - cv_opulg) * g_swramp_wt;
  cv_osubg += (g_subon - cv_osubg) * g_swramp_wt;
  sawA = cv_osawg > 0.0001 || g_sawon > 0;
  pulA = cv_opulg > 0.0001 || g_pulon > 0;
  subA = cv_osubg > 0.0001 || g_subon > 0;
  out = 0;
  (sawA || pulA) ? (
    sap = wt_blend(cv_opos, sti, sbl);
    sawA ? out += sap * g_sawamp * cv_osawg;
    pulA ? out += (sap - wt_blend(cv_opos - effPW, sti, sbl) + (1 - 2 * effPW)) * g_pulamp * cv_opulg;
  );
  subA ? (
    sph = (cv_opos + (cv_osub ? 1 : 0)) * 0.5;
    sub = wt_blend(sph - 0.5, uti, ubl) - wt_blend(sph, uti, ubl);
    out += sub * g_subamp * g_dcosub * cv_osubg;
  );
  out;
);

function upsample(v, xo, yo, input) local(ev, od, i, t0, t1, x, y)
(
  x = v + xo; y = v + yo;
  ev = input; od = input;
  i = 0;
  loop(6,
    t0 = (ev - y[i]) * RCOEF[i] + x[i];
    t1 = (od - y[i + 1]) * RCOEF[i + 1] + x[i + 1];
    x[i] = ev; x[i + 1] = od;
    y[i] = t0; y[i + 1] = t1;
    ev = t0; od = t1;
    i += 2;
  );
  up_a = ev; up_b = od;
);

// ---------------------------------------------------------------- per-voice block render
function voice_render(v, n, mix) local(i, target, baseFreq, lfo, lfoRaw, env, pw, pwMin, pwMax, lfoSemi, pitchMod, cps,
    vcfCPS, envScale, vcfBase, kbdRef, vcfFrq, kbdFreq, vcaRaw, vcaGain, slot, noiseAT, noise, peak, k, s, oscOut, cpsOS,
    diff, a0, a1)
(
  cv_load(v);
  target = cv_pitch;
  baseFreq = 0;
  !g_porta_en ? (cv_glide = target; baseFreq = 440 * pow(2, target););
  noiseAT = g_dconoise > 0 ? g_dconoise : 0;
  i = 0;
  loop(n,
    g_porta_en ? (
      diff = target - cv_glide;
      (g_portastep > 0 && abs(diff) > g_portastep) ? (
        diff > 0 ? cv_glide += g_portastep : cv_glide -= g_portastep;
      ) : (
        cv_glide = target;
      );
      baseFreq = 440 * pow(2, cv_glide);
    );
    lfo = LFOB[i];
    lfoRaw = LFORAWB[i];
    g_model != MDL_J106 ? (
      env = adsr_process_j6();
    ) : (
      cv_fwacc += g_fwstep;
      cv_fwacc >= 1 ? (
        cv_fwacc -= 1;
        firmware_tick(lfoRaw);
        cv_dacupd = 0;
        cv_vcaupd = 0;
      );
      (!cv_dacupd && cv_fwacc >= cv_vcfph) ? (cv_dacn = cv_dacp; cv_dacupd = 1;);
      (!cv_vcaupd && cv_fwacc >= cv_vcaph) ? (cv_fwenvn = cv_fwenvp; cv_vcaupd = 1;);
      env = cv_fwenvn;
      cv_env = env;
      adsr_update_gate();
    );
    pw = g_pwmmode == -1 ? g_dcopwm * (1 + lfoRaw) * 0.5 : g_pwmmode == 1 ? g_dcopwm * env : g_dcopwm;
    pwMin = 0.5 + cv_pwmino;
    pwMax = 0.95 + cv_pwmaxo;
    pw = pwMin + pw * (pwMax - pwMin);
    lfoSemi = lfo * (g_dcolfo + g_bmod * g_bendlfo);
    pitchMod = g_octtr / 12 + cv_pitchofs + lfoSemi / 12 + g_rawbend * g_benddco;
    cps = baseFreq * pow(2, pitchMod) / g_sr;
    (cps > 0 && cps < 0.5) ? (
      g_model != MDL_J106 ? (
        envScale = g_envinv > 0 ? 6.931 : 7.766;
        vcfBase = g_model == MDL_J60 ? g_vcffreq60 : g_vcffreq6;
        kbdRef = g_model == MDL_J6 ? 32.703 : 261.626;
        vcfFrq = log(vcfBase) + cv_vfofs;
        kbdFreq = baseFreq * pow(2, g_octtr / 12 + cv_pitchofs);
        vcfFrq += log(kbdFreq / kbdRef) * g_vcfkbd;
        vcfFrq += env * g_vcfenv * envScale * g_envinv;
        vcfFrq += lfo * g_vcflfo * 0.05776;
        vcfFrq += 4.15888 * g_rawbend * g_bendvcf;
        vcfCPS = exp(vcfFrq) * g_invnyq;
      ) : (
        vcfCPS = dac_to_hz(cv_dacn, cv_frqtrim, cv_widtrim) * g_invnyq;
      );
      cv_vcfslew += g_vcfslewc * (vcfCPS - cv_vcfslew);
      vcfCPS = cv_vcfslew;
      cv_inenv = max(abs(cv_lastpeak), cv_inenv * g_envdecay);
      vcf_update(vcfCPS, g_vcfres);
      vcaRaw = g_vcamode ? ((cv_state != ST_RELEASE && cv_state != ST_FINISHED) ? 1 : 0) : env;
      cv_vcaslew += g_vcaslewc * (vcaRaw - cv_vcaslew);
      vcaGain = vca_lookup(g_model == MDL_J106 ? VCAHW : VCAJ6, cv_vcaslew) * cv_vel * cv_vcags;
      slot = mix + i * g_os;
      g_oscmode == 1 ? (
        cpsOS = cps / g_os;
        noise = noiseAT > 0 ? NOISEB[i] * g_noiseamp * noiseAT : 0;
        peak = 0;
        k = 0;
        loop(g_os,
          s = blep_osc(cpsOS, pw) + noise;
          s = dc_post_osc(s);
          slot[k] += dc_post_vcf(vcf_sample(s)) * vcaGain;
          abs(s) > peak ? peak = abs(s);
          k += 1;
        );
        cv_lastpeak = peak;
      ) : (
        oscOut = wt_osc(cps, pw);
        noiseAT > 0 ? oscOut += NOISEB[i] * g_noiseamp * noiseAT;
        cv_lastpeak = abs(oscOut);
        g_os == 4 ? (
          upsample(v, O_UP1X, O_UP1Y, oscOut); a0 = up_a; a1 = up_b;
          upsample(v, O_UP2X, O_UP2Y, a0);
          slot[0] += dc_post_vcf(vcf_sample(dc_post_osc(up_a))) * vcaGain;
          slot[1] += dc_post_vcf(vcf_sample(dc_post_osc(up_b))) * vcaGain;
          upsample(v, O_UP2X, O_UP2Y, a1);
          slot[2] += dc_post_vcf(vcf_sample(dc_post_osc(up_a))) * vcaGain;
          slot[3] += dc_post_vcf(vcf_sample(dc_post_osc(up_b))) * vcaGain;
        ) : g_os == 2 ? (
          upsample(v, O_UP1X, O_UP1Y, oscOut);
          a0 = up_a; a1 = up_b;
          slot[0] += dc_post_vcf(vcf_sample(dc_post_osc(a0))) * vcaGain;
          slot[1] += dc_post_vcf(vcf_sample(dc_post_osc(a1))) * vcaGain;
        ) : (
          slot[0] += dc_post_vcf(vcf_sample(dc_post_osc(oscOut))) * vcaGain;
        );
      );
    );
    i += 1;
  );
  cv_save();
);

// ---------------------------------------------------------------- shared noise source (DCO noise)
function dnoise_setsr(sr) local(r, fc, i, f)
(
  r = 5305 / sr;
  fc = 5305 * (1 - 2.2 * r * r);
  dn_lpa = exp(-2 * $pi * fc / sr);
  dn_hpa = exp(-2 * $pi * 34 / sr);
  dn_lp = 0; dn_hp = 0;
  dn_fa0 = exp(-2 * $pi * 30 / sr); dn_fa1 = exp(-2 * $pi * 300 / sr);
  dn_fa2 = exp(-2 * $pi * 3000 / sr); dn_fa3 = exp(-2 * $pi * 15000 / sr);
  dn_f0 = dn_f1 = dn_f2 = dn_f3 = 0;
);

function dnoise_proc() local(g, white, fl, sh)
(
  g = 0;
  loop(4, dn_seed = lcg(dn_seed); g += 2 * dn_seed / 4294967296 - 1;);
  white = g * 0.5;
  dn_f0 = dn_fa0 * dn_f0 + (1 - dn_fa0) * white;
  dn_f1 = dn_fa1 * dn_f1 + (1 - dn_fa1) * white;
  dn_f2 = dn_fa2 * dn_f2 + (1 - dn_fa2) * white;
  dn_f3 = dn_fa3 * dn_f3 + (1 - dn_fa3) * white;
  fl = (dn_f0 + dn_f1 + dn_f2 + dn_f3) * 0.25;
  sh = white + 1.5 * fl;
  dn_lp = dn_lpa * dn_lp + (1 - dn_lpa) * sh;
  dn_hp = dn_hpa * dn_hp + (1 - dn_hpa) * dn_lp;
  dn_lp - dn_hp;
);

// ---------------------------------------------------------------- analog floor noise / rail ripple
function fn_init(sr, cutoff) instance(lpc, shc, shg) local(fc)
(
  fc = min(cutoff, sr * 0.45);
  lpc = 1 - exp(-2 * $pi * fc / sr);
  shc = 0; shg = 0;
);

function fn_shelf(fcHz, db, sr) instance(shc, shg) local(fc)
(
  fc = min(fcHz, sr * 0.45);
  shc = 1 - exp(-2 * $pi * fc / sr);
  shg = pow(10, db / 20) - 1;
);

function fn_proc() instance(seed, lpst, lpc, shst, shc, shg, pinken, p0, p1, p2, p3, p4, p5, p6) local(white, pink, po)
(
  seed = lcg(seed);
  white = 2 * seed / 4294967296 - 1;
  pinken ? (
    p0 = 0.99886 * p0 + white * 0.0555179;
    p1 = 0.99332 * p1 + white * 0.0750759;
    p2 = 0.96900 * p2 + white * 0.1538520;
    p3 = 0.86650 * p3 + white * 0.3104856;
    p4 = 0.55000 * p4 + white * 0.5329522;
    p5 = -0.7616 * p5 - white * 0.0168980;
    pink = p0 + p1 + p2 + p3 + p4 + p5 + p6 + white * 0.5362;
    p6 = white * 0.115926;
    po = pink * 0.11;
    shg != 0 ? (shst += shc * (po - shst); po + shg * (po - shst);) : po;
  ) : (
    lpst += lpc * (white - lpst);
    shg != 0 ? (shst += shc * (lpst - shst); lpst + shg * (lpst - shst);) : lpst;
  );
);

function rr_set(mainsHz, sr, a1, a2, a3) instance(inc, ph, b1, b2, b3)
(
  inc = 2 * mainsHz / sr;
  b1 = a1; b2 = a2; b3 = a3;
  ph = 0;
);

function rr_proc() instance(inc, ph, b1, b2, b3) local(tp)
(
  ph += inc;
  ph >= 1 ? ph -= 1;
  tp = 2 * $pi * ph;
  b1 * sin(tp) + b2 * sin(2 * tp) + b3 * sin(3 * tp);
);

// ---------------------------------------------------------------- HPF (4-position switch, bass boost)
function bb_init(sr) local(t1z, t1p, t2z, t2p, g2, al, ag, D1, D2, Nb1, Nb2, N0, N1, N2, K, K2, a0)
(
  t1z = 47000 * 0.000000047;
  t1p = 47000 * (0.000000047 + 0.00000001);
  t2z = (10000 * 100000 / (110000)) * 0.000000022;
  t2p = 100000 * 0.000000022;
  g2 = 1 + 100000 / 10000;
  al = 47000 / 220000;
  D1 = t1p + t2p; D2 = t1p * t2p;
  Nb1 = t1z + t2z; Nb2 = t1z * t2z;
  ag = al * g2;
  N0 = 1 + ag; N1 = D1 + ag * Nb1; N2 = D2 + ag * Nb2;
  K = 2 * sr; K2 = K * K;
  a0 = 1 + D1 * K + D2 * K2;
  bb_b0 = (N0 + N1 * K + N2 * K2) / a0;
  bb_b1 = 2 * (N0 - N2 * K2) / a0;
  bb_b2 = (N0 - N1 * K + N2 * K2) / a0;
  bb_a1 = 2 * (1 - D2 * K2) / a0;
  bb_a2 = (1 - D1 * K + D2 * K2) / a0;
);

function hp_with(input) instance(freq, g, hps, dcs, z1, z2) local(y, x, vv, lp, dcb)
(
  freq < 0 ? (
    y = bb_b0 * input + z1;
    z1 = bb_b1 * input - bb_a1 * y + z2;
    z2 = bb_b2 * input - bb_a2 * y;
    x = y;
  ) : x = input;
  vv = (x - dcs) * hp_dcg / (1 + hp_dcg);
  lp = dcs + vv;
  dcs = lp + vv;
  dcb = x - lp;
  freq <= 0 ? dcb : (
    vv = (dcb - hps) * g / (1 + g);
    lp = hps + vv;
    hps = lp + vv;
    dcb - lp;
  );
);

function hp_freq_for(mode)
(
  hp_model == MDL_J6 ? (mode == 0 ? 38.6 : mode == 1 ? 260 : mode == 2 ? 530 : 1394) :
  hp_model == MDL_J60 ? (mode == 0 ? 0 : mode == 1 ? 122 : mode == 2 ? 269 : 571) :
  (mode == 0 ? -1 : mode == 1 ? 0 : mode == 2 ? 236 : 754);
);

function hp_recalc() local(f)
(
  hp_dcg = tan(clampv(0.35 / (g_sr * 0.5), 0, 0.9) * $pi * 0.5);
  hpc.freq <= 0 ? hpc.g = 0 : (
    f = clampv(hpc.freq / (g_sr * 0.5), 0.001, 0.9);
    hpc.g = tan(f * $pi * 0.5);
  );
);

function hp_setmode(mode) local(nm, nf)
(
  nm = clampv(mode, 0, 3);
  nf = hp_freq_for(nm);
  nf !== hpc.freq ? (
    hpp.freq = hpc.freq; hpp.g = hpc.g; hpp.hps = hpc.hps; hpp.dcs = hpc.dcs;
    hpp.z1 = hpc.z1; hpp.z2 = hpc.z2;
    hp_xfade = 64;
  );
  hp_mode = nm;
  hpc.freq = nf;
  hp_recalc();
);

function hp_proc(input) local(out, prev, t)
(
  out = hpc.hp_with(input);
  hp_xfade > 0 ? (
    prev = hpp.hp_with(input);
    t = hp_xfade / 64;
    out = out * (1 - t) + prev * t;
    hp_xfade -= 1;
  );
  out;
);

// ---------------------------------------------------------------- BBD chorus
function bbf_init(sr) instance(gbq, a1bq, gp, ic1, ic2, ps) local(fc)
(
  fc = min(9661, sr * 0.45);
  gbq = tan($pi * fc / sr);
  a1bq = 1 / (1 + gbq / 0.7071 + gbq * gbq);
  fc = min(20000, sr * 0.45);
  gp = tan($pi * fc / sr);
  ic1 = ic2 = ps = 0;
);

function bbf_proc(input) instance(gbq, a1bq, gp, ic1, ic2, ps) local(v3, v1, v2, vv, lp)
(
  v3 = input - ic2;
  v1 = a1bq * ic1 + a1bq * gbq * v3;
  v2 = ic2 + gbq * v1;
  ic1 = 2 * v1 - ic1;
  ic2 = 2 * v2 - ic2;
  vv = (v2 - ps) * gp / (1 + gp);
  lp = ps + vv;
  ps = lp + vv;
  lp;
);

function click_proc(lfoForLine) instance(counter, was) local(inZone, t, u, out)
(
  inZone = lfoForLine > 0.95;
  inZone && !was ? counter = 0;
  was = inZone;
  (counter < 0 || counter >= ch_clickdur) ? (
    counter = -1;
    0;
  ) : (
    t = counter / ch_clickdur;
    counter += 1;
    t < 0.2 ? (
      u = t / 0.2;
      out = -exp(-4 * u) * sin($pi * u);
    ) : (
      u = (t - 0.2) / 0.8;
      out = 0.85 * exp(-8 * u) * sin($pi * u);
    );
    out;
  );
);

function click_suppress() instance(counter, was) ( counter = -1; was = 1; );
function click_reset() instance(counter, was) ( counter = -1; was = 0; );

function leak_init(sr, hpHz) instance(hpc, lpc)
(
  hpc = 1 - exp(-2 * $pi * hpHz / sr);
  lpc = 1 - exp(-2 * $pi * 4000 / sr);
);

function leak_proc() instance(seed, hps, hpc, lps, lpc) local(white, hp)
(
  seed = lcg(seed);
  white = 2 * seed / 4294967296 - 1;
  hps += hpc * (white - hps);
  hp = white - hps;
  lps += lpc * (hp - lps);
  lps;
);

function ring_init(f, q, sr) instance(fc, damp, lo, bd)
(
  fc = 2 * sin($pi * f / sr);
  damp = 1 / q;
  lo = bd = 0;
);

function ring_proc(input) instance(fc, damp, lo, bd) local(hi)
(
  lo += fc * bd;
  hi = input - lo - damp * bd;
  bd += fc * hi;
  lo;
);

function bbd_line(buf, input, dsamp, inj, li) local(st, f, sd, sat, rpos, i1, fr, y0, y1, y2, y3, c1, c2, c3, wet)
(
  st = LNST + li * 4;
  f = li == 0 ? pre0.bbf_proc(input + inj) : pre1.bbf_proc(input + inj);
  st[2] += (st[1] - st[2]) * 0.001;
  sd = st[2];
  sat = sd > 0.01 ? tanh_(f * sd) / sd : f;
  buf[st[0] & ch_mask] = sat;
  rpos = st[0] - dsamp;
  rpos < 0 ? rpos += ch_mask + 1;
  i1 = floor(rpos);
  fr = rpos - i1;
  y0 = buf[(i1 - 1) & ch_mask]; y1 = buf[i1 & ch_mask]; y2 = buf[(i1 + 1) & ch_mask]; y3 = buf[(i1 + 2) & ch_mask];
  c1 = 0.5 * (y2 - y0);
  c2 = y0 - 2.5 * y1 + 2 * y2 - 0.5 * y3;
  c3 = 0.5 * (y3 - y0) + 1.5 * (y1 - y2);
  wet = ((c3 * fr + c2) * fr + c1) * fr + y1;
  st[0] = (st[0] + 1) & ch_mask;
  li == 0 ? post0.bbf_proc(wet) : post1.bbf_proc(wet);
);

function chorus_configure()
(
  ch_mode == 1 ? (
    ch_inc = 0.514 / g_sr; ch_target = 2.13; ch_gms = 1; ch_sine = 0;
  ) : ch_mode == 2 ? (
    ch_inc = 0.842 / g_sr; ch_target = 1.71; ch_gms = 1.71 / 2.13; ch_sine = 0;
  ) : ch_mode == 3 ? (
    ch_inc = 7.85 / g_sr; ch_target = 0.236; ch_gms = 0.236 / 2.13; ch_sine = 1;
  );
);

function chorus_suppress_clicks()
(
  ck0.click_suppress(); ck1.click_suppress(); sk0.click_suppress(); sk1.click_suppress();
  rg0.lo = rg0.bd = 0; rg1.lo = rg1.bd = 0;
);

function chorus_init(sr) local(len, minLen)
(
  minLen = floor(sr * 0.02) + 4;
  len = 1;
  while (len < minLen) ( len *= 2; );
  ch_mask = len - 1;
  memset(CHBUF0, 0, len); memset(CHBUF1, 0, len);
  LNST[0] = 0; LNST[4] = 0;
  pre0.bbf_init(sr); post0.bbf_init(sr); pre1.bbf_init(sr); post1.bbf_init(sr);
  ch_clickdur = floor(180 * 0.001 * sr);
  lk0.leak_init(sr, 800); lk1.leak_init(sr, 800);
  rg0.ring_init(30, 18, sr); rg1.ring_init(30, 18, sr);
  wp0.fn_init(sr, 20000); wp1.fn_init(sr, 20000);
  wp0.fn_shelf(3000, 6, sr); wp1.fn_shelf(3000, 6, sr);
  wrip.rr_set(60, sr, 0.000079, 0.000022, 0.0000098);
  ch_phase = 0;
  ck0.click_reset(); ck1.click_reset(); sk0.click_reset(); sk1.click_reset();
  rg0.lo = rg0.bd = 0; rg1.lo = rg1.bd = 0;
  ch_fadeinc = 1 / (5 * 0.001 * sr);
  ch_mode > 0 ? (
    chorus_configure();
    ch_depth = ch_target;
    ch_fade = ch_fadetgt = 1;
  );
);

function chorus_setmode(nm)
(
  (ch_fadeinc <= 0 && g_sr > 0) ? ch_fadeinc = 1 / (5 * 0.001 * g_sr);
  (nm == ch_mode && nm == ch_pending) ? 0 : (
    (ch_mode > 0 && nm > 0) ? (
      ch_pending = nm;
      ch_fadetgt = 0;
    ) : (
      ch_pending = nm;
      ch_mode = nm;
      ch_mode == 0 ? (
        ch_fadetgt = 0;
      ) : (
        chorus_configure();
        ch_fadetgt = 1;
        ch_fade <= 0 ? ch_fade = ch_fadeinc;
        chorus_suppress_clicks();
      );
    );
  );
);

function chorus_proc(input) local(lfo, d0, d1, ds0, ds1, c0, c1, inv, l0, l1, la0, la1, n0, n1, wp0v, wp1v,
    c0p, c1p, c0s, c1s, in0, in1, w0, w1, g0, g1, rip, dry, wetm)
(
  ch_fade < ch_fadetgt ? ch_fade = min(ch_fade + ch_fadeinc, ch_fadetgt) :
  ch_fade > ch_fadetgt ? ch_fade = max(ch_fade - ch_fadeinc, ch_fadetgt);
  (ch_fade <= 0 && ch_pending != ch_mode) ? (
    ch_mode = ch_pending;
    ch_mode > 0 ? (
      chorus_configure();
      ch_depth = ch_target;
      ch_fadetgt = 1;
      chorus_suppress_clicks();
    );
  );
  ch_depth += (ch_target - ch_depth) * ch_fadeinc;
  ch_phase += ch_inc;
  ch_phase >= 1 ? ch_phase -= 1;
  lfo = ch_sine ? sin(2 * $pi * ch_phase) : 1 - 4 * abs(ch_phase - 0.5);
  d0 = (3.3 + ch_depth * lfo) * (1 - 0.015);
  d1 = (3.3 - ch_depth * lfo) * (1 + 0.015);
  d0 = max(d0, 0.1); d1 = max(d1, 0.1);
  ds0 = d0 * 0.001 * g_sr; ds1 = d1 * 0.001 * g_sr;
  c0 = max(256 / (2 * d0 * 0.001), 5000);
  c1 = max(256 / (2 * d1 * 0.001), 5000);
  inv = ch_depth > 0.000000001 ? 1 / ch_depth : 0;
  l0 = (d0 - 3.3) * inv; l1 = (d1 - 3.3) * inv;
  la0 = ch_depth * (0.0126 + (1 - 0.0126) * (l0 + 1) * 0.5);
  la1 = ch_depth * (0.0126 + (1 - 0.0126) * (l1 + 1) * 0.5);
  n0 = lk0.leak_proc(); n1 = lk1.leak_proc();
  wp0v = wp0.fn_proc() * 0.0018 * ch_analog;
  wp1v = wp1.fn_proc() * 0.0018 * ch_analog;
  c0p = ck0.click_proc(-lfo) * 0.11 * ch_gms;
  c1p = ck1.click_proc(lfo) * 0.11 * ch_gms;
  c0s = sk0.click_proc(lfo) * 0.022 * ch_gms;
  c1s = sk1.click_proc(-lfo) * 0.022 * ch_gms;
  in0 = (wp0v + n0 * 0.0088 * la0 + c0p - c0s) * ch_clock;
  in1 = (wp1v + n1 * 0.0088 * la1 + c1p - c1s) * ch_clock;
  w0 = bbd_line(CHBUF0, input, ds0, in0, 0);
  w1 = bbd_line(CHBUF1, input, ds1, in1, 1);
  g0 = (1 + 0.04) * (1 - 4468 * (1 / c0 - 1 / 40000));
  g1 = (1 - 0.04) * (1 - 4468 * (1 / c1 - 1 / 40000));
  w0 *= g0; w1 *= g1;
  w0 += rg0.ring_proc(c0p) * 0.06 * ch_clock;
  w1 += rg1.ring_proc(c1p) * 0.06 * ch_clock;
  rip = wrip.rr_proc() * ch_mains;
  w0 += rip; w1 += rip;
  dry = 1 - ch_fade * (1 - 0.863);
  wetm = ch_fade * 1.257;
  ch_outl = dry * input + wetm * w0;
  ch_outr = dry * input + wetm * w1;
);

function chorus_update_drive() local(nrm, dr)
(
  nrm = ch_driveuser / 100;
  dr = 0.48 * nrm * nrm;
  LNST[1] = dr; LNST[5] = dr;
);

// ---------------------------------------------------------------- global LFO
function lfo_div_beats(d)
(
  d == 0 ? 24 : d == 1 ? 16 : d == 2 ? 8 : d == 3 ? 4 : d == 4 ? 2 : d == 5 ? 1 : d == 6 ? 2 / 3 :
  d == 7 ? 0.5 : d == 8 ? 1 / 3 : d == 9 ? 0.25 : d == 10 ? 1 / 6 : d == 11 ? 0.125 : 0.0625;
);

function arp_div_beats(d)
(
  d == 0 ? 4 : d == 1 ? 2 : d == 2 ? 1 : d == 3 ? 2 / 3 : d == 4 ? 0.5 : d == 5 ? 1 / 3 : d == 6 ? 0.25 : d == 7 ? 1 / 6 : 0.125;
);

function lfo_recalc_j6()
(
  lfo_delayparam <= 0 ? lfo_delaycoeff = 0 : lfo_delaycoeff = 1 - exp(-1 / (lfo_delayparam * lfo_sr));
);

function lfo_recalc_106() local(pot, idx)
(
  lfo_hinc = attack_inc(lfo_slider);
  lfo_hacc = 0;
  lfo_inhold = lfo_hinc < ENVMAX;
  pot = floor(lfo_slider * 127 + 0.5);
  idx = clampv(pot >> 4, 0, 7);
  lfo_rinc = idx == 0 ? 65535 : idx == 1 ? 1049 : idx == 2 ? 524 : idx == 3 ? 350 : 256;
  lfo_racc = 0;
  lfo_ampint = 0;
);

function lfo_setrate(slider, sr) local(b)
(
  lfo_sr = sr;
  lfo_freq = (lfo_model == MDL_J106 ? lfo_freq_j106(slider) : lfo_freq_j6(slider)) / sr;
  lfo_model == MDL_J106 ? (
    b = clampv(floor(slider * 127 + 0.5), 0, 127);
    lfo_icoeff = LFOSPD[b];
  );
);

function lfo_setdelay(slider)
(
  lfo_slider = slider;
  lfo_model != MDL_J106 ? (lfo_delayparam = slider * 1.5; lfo_recalc_j6();) : lfo_recalc_106();
);

function lfo_update_gate() local(gated)
(
  gated = lfo_gated || lfo_trigger;
  lfo_mode == 1 ? (
    gated && !lfo_wasgated ? (
      lfo_amp = 0; lfo_ampint = 0;
      lfo_model != MDL_J106 ? lfo_recalc_j6() : lfo_recalc_106();
    );
  ) : (
    !gated ? lfo_armed = 1;
    (gated && !lfo_wasgated && lfo_armed) ? (
      lfo_amp = 0; lfo_ampint = 0; lfo_armed = 0;
      lfo_model != MDL_J106 ? lfo_recalc_j6() : lfo_recalc_106();
    );
  );
  lfo_wasgated = gated;
);

function lfo_tick106() local(sum, mag)
(
  lfo_rising ? (
    sum = lfo_iacc + lfo_icoeff;
    sum >= 8192 ? (lfo_iacc = 8191; lfo_rising = 0;) : lfo_iacc = sum;
  ) : (
    lfo_icoeff > lfo_iacc ? (lfo_iacc = 0; lfo_rising = 1; lfo_ipol = !lfo_ipol;) : lfo_iacc -= lfo_icoeff;
  );
  mag = lfo_iacc / 8191;
  lfo_itri = lfo_ipol ? -mag : mag;
  lfo_inhold ? (
    sum = lfo_hacc + lfo_hinc;
    sum >= 16384 ? (lfo_inhold = 0; lfo_hacc = 16384;) : lfo_hacc = sum;
    lfo_ampint = 0;
  ) : (
    sum = lfo_racc + lfo_rinc;
    sum >= 65536 ? (lfo_racc = 65535; lfo_ampint = 1;) : (lfo_racc = sum; lfo_ampint = (lfo_racc >> 8) / 255;);
  );
);

function lfo_process() local(freq, d, tri)
(
  freq = lfo_freq;
  lfo_sync ? (
    d = clampv(lfo_division, 0, 12);
    freq = (host_bpm / (60 * lfo_div_beats(d))) / lfo_sr;
    (host_playing && !lfo_hostwas) ? lfo_pos = 0;
    lfo_hostwas = host_playing;
  );
  lfo_pos += freq;
  lfo_pos >= 1 ? lfo_pos -= 1;
  ((lfo_active || lfo_trigger) && lfo_amp < 1) ? (
    lfo_delaycoeff <= 0 ? lfo_amp = 1 : lfo_amp += lfo_delaycoeff * (1 - lfo_amp);
  );
  tri = 1 - 4 * abs(lfo_pos - 0.5);
  tri = tri * (1.5 - 0.5 * tri * tri);
  lfo_lasttri = tri;
  tri * lfo_amp;
);

// ---------------------------------------------------------------- voice allocation
function vptr(i) ( VOICES + i * VSTRIDE; );

function set_voice_pitch(i, note) ( vptr(i)[O_PITCH] = (note - 69) / 12; vptr(i)[O_MIDINOTE] = note; );

function any_busy() local(i, b) ( b = 0; i = 0; loop(n_active, voice_busy(vptr(i)) ? b = 1; i += 1;); b; );

function trigger_unison(note, vel) local(lv, anyB, i)
(
  lv = ignore_vel ? 1 : vel / 127;
  anyB = any_busy();
  i = 0;
  loop(n_active,
    set_voice_pitch(i, note);
    voice_trigger(vptr(i), lv, anyB);
    i += 1;
  );
);

function release_unison() local(i) ( i = 0; loop(MAXV, voice_release(vptr(i)); i += 1;); );

function glide_unison(note) local(i) ( i = 0; loop(n_active, set_voice_pitch(i, note); i += 1;); );

function reset_vtbl() local(i) ( i = 0; loop(MAXV, VTBL[i] = i; i += 1;); );

function find_lowest_free() local(i, r)
(
  r = -1; i = 0;
  while (r < 0 && i < n_active) ( VNOTE[i] < 0 ? r = i; i += 1; );
  r;
);

function find_hw_voice(note) local(nv, lastv, restartPos, firstFree, pos, vi, done, t)
(
  nv = n_active;
  lastv = VTBL[nv - 1];
  VNOTE[lastv] >= 0 ? -1 : (
    restartPos = -1; firstFree = -1;
    pos = nv - 1; done = 0;
    while (!done && pos >= 0) (
      vi = VTBL[pos];
      VNOTE[vi] >= 0 ? (firstFree = pos + 1; done = 1;) : (
        (VEVER[vi] && VLASTNOTE[vi] == note) ? (restartPos = pos; done = 1;);
      );
      pos -= 1;
    );
    firstFree < 0 ? firstFree = 0;
    restartPos >= 0 ? (
      pos = restartPos;
      while (pos > 0) ( t = VTBL[pos]; VTBL[pos] = VTBL[pos - 1]; VTBL[pos - 1] = t; pos -= 1; );
      VTBL[0];
    ) : VTBL[firstFree];
  );
);

function hw_note_off(note) local(nv, found, pos, vi, t)
(
  nv = n_active;
  found = -1; pos = 0;
  while (found < 0 && pos < nv) ( VNOTE[VTBL[pos]] == note ? found = pos; pos += 1; );
  found >= 0 ? (
    vi = VTBL[found];
    voice_release(vptr(vi));
    VNOTE[vi] = -1;
    pos = found;
    while (pos < nv - 1) ( t = VTBL[pos]; VTBL[pos] = VTBL[pos + 1]; VTBL[pos + 1] = t; pos += 1; );
  );
);

function trigger_voice(vi, note, vel) local(v)
(
  v = vptr(vi);
  set_voice_pitch(vi, note);
  voice_trigger(v, ignore_vel ? 1 : vel / 127, voice_busy(v));
  VNOTE[vi] = note;
  voice_age_ctr += 1;
  VAGE[vi] = voice_age_ctr;
  VLASTNOTE[vi] = note;
  VEVER[vi] = 1;
);

function unistack_remove(note) local(i, j)
(
  i = 0;
  while (i < uni_n) (
    UNISTK[i] == note ? (
      j = i; while (j < uni_n - 1) ( UNISTK[j] = UNISTK[j + 1]; j += 1; );
      uni_n -= 1;
    ) : i += 1;
  );
);

function send_to_synth(note, on, vel) local(was, vi, i, done)
(
  porta_mode == 0 ? (
    on ? (
      unistack_remove(note);
      UNISTK[uni_n] = note; uni_n += 1;
      was = uni_note >= 0;
      uni_note = note;
      (was && !mono_retrig) ? glide_unison(note) : trigger_unison(note, vel);
    ) : (
      unistack_remove(note);
      note == uni_note ? (
        uni_n > 0 ? (uni_note = UNISTK[uni_n - 1]; glide_unison(uni_note);) : (release_unison(); uni_note = -1;);
      );
    );
  ) : porta_mode == 1 ? (
    on ? (
      vi = find_hw_voice(note);
      vi >= 0 ? (
        VNOTE[vi] >= 0 ? VNOTE[vi] = -1;
        trigger_voice(vi, note, vel);
      );
    ) : hw_note_off(note);
  ) : (
    on ? (
      vi = find_lowest_free();
      vi >= 0 ? (
        VNOTE[vi] >= 0 ? VNOTE[vi] = -1;
        trigger_voice(vi, note, vel);
      );
    ) : (
      i = 0; done = 0;
      while (!done && i < n_active) (
        VNOTE[i] == note ? (voice_release(vptr(i)); VNOTE[i] = -1; done = 1;);
        i += 1;
      );
    );
  );
);

// ---------------------------------------------------------------- arpeggiator
function arp_note_on(note) local(i, j)
(
  note >= 0 && note <= 127 ? (
    i = 0; while (i < arp_n && ARPHELD[i] < note) ( i += 1; );
    (i < arp_n && ARPHELD[i] == note) ? 0 : (
      j = arp_n; while (j > i) ( ARPHELD[j] = ARPHELD[j - 1]; j -= 1; );
      ARPHELD[i] = note; arp_n += 1;
      arp_n == 1 ? (arp_phase = 1; arp_step = 0; arp_dir = 1;);
    );
  );
);

function arp_note_off(note) local(i, j)
(
  i = 0; while (i < arp_n && ARPHELD[i] != note) ( i += 1; );
  i < arp_n ? (
    j = i; while (j < arp_n - 1) ( ARPHELD[j] = ARPHELD[j + 1]; j += 1; );
    arp_n -= 1;
  );
  arp_n == 0 ? (arp_step = 0; arp_dir = 1; arp_phase = 0;);
);

function arp_reset() ( arp_n = 0; arp_step = 0; arp_dir = 1; arp_phase = 0; arp_last = -1; arp_lastsync = -1; );

function arp_seqlen() local(c, o, i)
(
  arp_limit ? arp_n * (arp_range + 1) : (
    c = 0; o = 0;
    loop(arp_range + 1, i = 0; loop(arp_n, ARPHELD[i] + o * 12 <= 127 ? c += 1; i += 1;); o += 1;);
    c;
  );
);

function arp_seqnote(idx) local(k, o, i, note, r)
(
  k = 0; r = -1; o = 0;
  loop(arp_range + 1,
    i = 0;
    loop(arp_n,
      note = ARPHELD[i] + o * 12;
      arp_limit ? (
        while (note > 96) ( note -= 12; );
        (r < 0 && k == idx) ? r = note;
        k += 1;
      ) : (
        note <= 127 ? ((r < 0 && k == idx) ? r = note; k += 1;);
      );
      i += 1;
    );
    o += 1;
  );
  r;
);

function arp_next() local(len, note)
(
  len = arp_seqlen();
  len == 0 ? -1 : (
    arp_step >= len ? arp_step = 0;
    arp_step < 0 ? arp_step = len - 1;
    arp_mode == 0 ? (
      note = arp_seqnote(arp_step); arp_step = (arp_step + 1) % len;
    ) : arp_mode == 1 ? (
      note = arp_seqnote(arp_step);
      len > 1 ? (
        arp_step += arp_dir;
        arp_step >= len ? (arp_step = len - 2; arp_dir = -1;) : arp_step < 0 ? (arp_step = 1; arp_dir = 1;);
      );
    ) : arp_mode == 2 ? (
      note = arp_seqnote(len - 1 - arp_step); arp_step = (arp_step + 1) % len;
    ) : note = arp_seqnote(0);
    note;
  );
);

function arp_fire() local(note)
(
  arp_ticks += 1;
  arp_last >= 0 ? send_to_synth(arp_last, 0, 0);
  note = arp_next();
  note >= 0 ? (send_to_synth(note, 1, 127); arp_last = note;);
);

function arp_process(n) local(d, db, bps, s, bp, st, inc)
(
  (!arp_en || arp_n == 0) ? (
    arp_last >= 0 ? (send_to_synth(arp_last, 0, 0); arp_last = -1;);
    arp_lastsync = -1;
  ) : arp_sync ? (
    d = clampv(arp_division, 0, 8);
    db = arp_div_beats(d);
    arp_hostplay ? (
      bps = host_bpm / (60 * g_sr);
      s = 0;
      loop(n,
        bp = host_beatpos + s * bps;
        st = floor(bp / db);
        st != arp_lastsync ? (arp_lastsync = st; arp_fire(););
        s += 1;
      );
    ) : (
      inc = (host_bpm / db) / (60 * g_sr);
      loop(n, arp_phase += inc; arp_phase >= 1 ? (arp_phase -= 1; arp_fire();););
    );
  ) : (
    inc = arp_rate_v / (60 * g_sr);
    loop(n, arp_phase += inc; arp_phase >= 1 ? (arp_phase -= 1; arp_fire();););
  );
);

// ---------------------------------------------------------------- note entry
function dsp_note_on(note, vel)
(
  (note >= 0 && note < 128 && !KEYSDOWN[note]) ? (
    KEYSDOWN[note] = 1;
    arp_en ? arp_note_on(note) : send_to_synth(note, 1, vel);
  );
);

function dsp_note_off(note)
(
  (note >= 0 && note < 128 && KEYSDOWN[note]) ? (
    KEYSDOWN[note] = 0;
    arp_en ? (
      hold_on ? HELDN[note] = 1 : arp_note_off(note);
    ) : (
      hold_on ? HELDN[note] = 1 : send_to_synth(note, 0, 0);
    );
  );
);

function any_keys_down() local(i, r) ( r = 0; i = 0; loop(128, KEYSDOWN[i] ? r = 1; i += 1;); r; );

function release_held_notes() local(i, v)
(
  porta_mode == 0 ? (
    i = 0;
    loop(128,
      HELDN[i] ? (arp_en ? arp_note_off(i); unistack_remove(i););
      i += 1;
    );
    (uni_note >= 0 && uni_n == 0) ? (release_unison(); uni_note = -1;) :
    (uni_note >= 0 && !HELDN[uni_note]) ? 0 :
    uni_n > 0 ? (uni_note = UNISTK[uni_n - 1]; glide_unison(uni_note););
  ) : (
    i = 0;
    loop(128,
      HELDN[i] ? (arp_en ? arp_note_off(i) : send_to_synth(i, 0, 0););
      i += 1;
    );
  );
  memset(HELDN, 0, 128);
  (arp_en && arp_n > 0 && !any_keys_down()) ? (
    arp_last >= 0 ? (send_to_synth(arp_last, 0, 0); arp_last = -1;);
    arp_n = 0;
  );
  i = 0;
  loop(MAXV,
    (VNOTE[i] >= 0 && !KEYSDOWN[VNOTE[i]]) ? (voice_release(vptr(i)); VNOTE[i] = -1;);
    i += 1;
  );
);

function all_notes_off() local(i)
(
  arp_reset();
  memset(KEYSDOWN, 0, 128);
  memset(HELDN, 0, 128);
  release_unison();
  i = 0; loop(MAXV, VNOTE[i] = -1; i += 1;);
  reset_vtbl();
  uni_note = -1; uni_n = 0;
);

function set_active_voices(n) local(i)
(
  n = clampv(n, 1, MAXV);
  n != n_active ? (
    i = n;
    loop(MAXV - n, voice_force_finish(vptr(i)); VNOTE[i] = -1; i += 1;);
    n_active = n;
    reset_vtbl();
  );
);

function update_oct_transpose() ( g_octtr = oct_tr * 12 + tuning + key_tr; );

// ---------------------------------------------------------------- drift
function effective_drift() ( porta_mode == 0 ? drift_amt : 0; );

function voice_set_drift(i, d, reroll) local(v, seed, r1, r2, r3)
(
  v = vptr(i);
  reroll ? (
    seed = (u32mul(i, 2654435761) + drift_salt + 1148348788) & 4294967295;
    seed = lcg(seed); r1 = rnd11(seed);
    seed = lcg(seed); r2 = rnd11(seed);
    seed = lcg(seed); r3 = rnd11(seed);
    v[O_SOU] = r1 + r2 + r3;
  );
  v[O_PITCHOFS] = v[O_SOU] * d * 12 / 1200 + v[O_WALK];
);

function set_drift_amount(d) local(i)
(
  drift_amt = clampv(d, 0, 1);
  i = 0; loop(MAXV, voice_set_drift(i, effective_drift(), 0); i += 1;);
);

function update_drift_walk(d, dt) local(i, v, ws, k, tp)
(
  tp = 2 * $pi;
  i = 0;
  loop(MAXV,
    v = vptr(i);
    ws = 0; k = 0;
    loop(3,
      v[O_WP0 + k] += tp * (k == 0 ? 0.07 : k == 1 ? 0.13 : 0.31) * dt;
      v[O_WP0 + k] > tp ? v[O_WP0 + k] -= tp;
      ws += sin(v[O_WP0 + k]);
      k += 1;
    );
    v[O_WALK] = (ws * (1 / 3)) * d * 3 / 1200;
    v[O_PITCHOFS] = v[O_SOU] * d * 12 / 1200 + v[O_WALK];
    i += 1;
  );
);

function init_variance(i) local(v, seed, slot, r)
(
  v = vptr(i);
  v[O_VIDX] = i;
  slot = i < 6 ? i : i - 5;
  v[O_VCFPH] = slot == 0 ? 0 : slot == 1 ? 0.2874 : slot == 2 ? 0.5748 : slot == 3 ? 0.8622 : slot == 4 ? 1.1497 : 1.4371;
  v[O_VCAPH] = slot == 0 ? 0.1253 : slot == 1 ? 0.4127 : slot == 2 ? 0.7002 : slot == 3 ? 0.9876 : slot == 4 ? 1.2750 : 1.8396;
  v[O_VCFPH] = (v[O_VCFPH] + 2.2055 - 2.2055) / LOOP_MS;
  v[O_VCAPH] = (v[O_VCAPH] + 2.2055 - 2.2055) / LOOP_MS;
  seed = (u32mul(i, 2654435761) + 1182101099) & 4294967295;
  seed = lcg(seed); v[O_VFOFS] = (rnd11(seed)) * (10 / 1200);
  seed = lcg(seed); v[O_FRQTRIM] = (rnd11(seed)) * 10;
  seed = lcg(seed); v[O_WIDTRIM] = 1 + (rnd11(seed)) * (10 / 1200);
  seed = lcg(seed); v[O_VCAGS] = 1 + (rnd11(seed)) * 0.024;
  seed = lcg(seed); v[O_PWMINO] = (rnd11(seed)) * 0.02;
  seed = lcg(seed); v[O_PWMAXO] = (rnd11(seed)) * 0.02;
  seed = lcg(seed); r = rnd11(seed);
  seed = lcg(seed); r += rnd11(seed);
  seed = lcg(seed); r += rnd11(seed);
  v[O_SOU] = r;
  seed = lcg(seed); v[O_WP0] = (rnd11(seed) + 1) * $pi;
  seed = lcg(seed); v[O_WP1] = (rnd11(seed) + 1) * $pi;
  seed = lcg(seed); v[O_WP2] = (rnd11(seed) + 1) * $pi;
  v[O_WALK] = 0;
  v[O_PITCHOFS] = 0;
);

// ---------------------------------------------------------------- parameter dispatch (KR106DSP::SetParam)
function update_chorus_mode() ( chorus_setmode((chorus_i ? 1 : 0) + (chorus_ii ? 2 : 0)); );

function dsp_setparam_base(idx, value) local(d, s, i, prev, active, wasEn, tau, n)
(
  idx == P_DCOLFO ? (
    sl_dcolfo = value;
    g_dcolfo = g_model == MDL_J106 ? dco_lfo_depth106(value) : dco_lfo_depth6(value);
  ) : idx == P_DCOPWM ? (
    g_dcopwm = value;
  ) : idx == P_DCOSUB ? (
    sl_dcosub = value;
    g_dcosub = g_model == MDL_J106 ? sub_level_j106(value) : sub_level_j6(value);
  ) : idx == P_DCONOISE ? (
    sl_dconoise = value;
    g_dconoise = g_model == MDL_J106 ? noise_level_j106(value) : g_model == MDL_J60 ? noise_level_j60(value) :
      tbl_lerp11(value, 0, 0.01496, 0.04571, 0.06166, 0.08318, 0.10116, 0.11092, 0.20654, 0.30200, 0.51286, 1);
  ) : idx == P_VCFFREQ ? (
    sl_vcffreq = value;
    g_vcffreq6 = j6_vcf_freq(value);
    g_vcffreq60 = j60_vcf_freq(value);
    g_cutoffint = floor(value * 16256);
  ) : idx == P_VCFRES ? (
    g_vcfres = value;
  ) : idx == P_VCFENV ? (
    sl_vcfenv = value;
    g_vcfenv = value;
    g_envmodint = floor(value * 254) & 255;
  ) : idx == P_VCFLFO ? (
    sl_vcflfo = value;
    g_vcflfo = g_model == MDL_J106 ? vcf_lfo_depth106(value) : vcf_lfo_depth6(value);
    g_lfodepthint = floor(value * 254) & 255;
  ) : idx == P_VCFKBD ? (
    sl_vcfkbd = value;
    g_vcfkbd = value;
    g_keytrackint = floor(value * 254) & 255;
  ) : idx == P_BENDDCO ? (
    g_benddco = value;
  ) : idx == P_BENDVCF ? (
    sl_bendvcf = value;
    g_bendvcf = value;
    g_bendsensint = floor(value * 255) & 255;
  ) : idx == P_BENDLFO ? (
    g_bendlfo = value;
  ) : idx == P_ENVA ? (
    sl_a = value;
    g_model == MDL_J106 ? g_atkinc = attack_inc(value) : (
      tau = attack_tau_j6(value);
      g_atkc = 1 - exp(-1 / (tau * g_sr));
    );
  ) : idx == P_ENVD ? (
    sl_d = value;
    g_model == MDL_J106 ? g_decmul = DECREL[clampv(floor(value * 127 + 0.5), 0, 127)] : (
      tau = decrel_tau_j6(value);
      g_decc = 1 - exp(-1 / (tau * g_sr));
    );
  ) : idx == P_ENVS ? (
    s = max(value, 0.001);
    g_sustain = s;
    g_susint = floor(s * 16256);
  ) : idx == P_ENVR ? (
    sl_r = value;
    g_model == MDL_J106 ? g_relmul = DECREL[clampv(floor(value * 127 + 0.5), 0, 127)] : (
      tau = decrel_tau_j6(value);
      g_relc = 1 - exp(-1 / (tau * g_sr));
    );
  ) : idx == P_PULSE ? (
    g_pulon = value > 0.5;
  ) : idx == P_SAW ? (
    g_sawon = value > 0.5;
  ) : idx == P_SUBSW ? (
    g_subon = value > 0.5;
  ) : idx == P_PWMMODE ? (
    g_pwmmode = floor(value) - 1;
  ) : idx == P_VCFINV ? (
    g_envinv = floor(value) != 0 ? -1 : 1;
  ) : idx == P_VCAMODE ? (
    n = floor(value);
    i = 0;
    loop(MAXV,
      d = vptr(i);
      (n != g_vcamode && voice_busy(d)) ? (
        n == 0 ? d[O_ENV] = d[O_GATEENV] : d[O_GATEENV] = d[O_ENV];
      );
      i += 1;
    );
    g_vcamode = n;
  ) : idx == P_BENDER ? (
    g_rawbend = value;
  ) : idx == P_LFORATE ? (
    sl_lforate = value;
    lfo_setrate(value, g_sr);
  ) : idx == P_LFOQUANT ? (
    lfo_division = clampv(floor(value), 0, 12);
  ) : idx == P_LFODELAY ? (
    sl_lfodelay = value;
    lfo_setdelay(value);
  ) : idx == P_LFOMODE ? (
    lfo_mode = floor(value);
  ) : idx == P_HPF ? (
    sl_hpf = value;
    hp_setmode(floor(value + 0.5));
  ) : idx == P_VCALEVEL ? (
    sl_vcalevel = value;
    vca_level = g_model == MDL_J6 ? 1 : pow(10, (-10 + 20 * value) / 20);
  ) : idx == P_CHI ? (
    chorus_i = value > 0.5;
    update_chorus_mode();
  ) : idx == P_CHII ? (
    chorus_ii = value > 0.5;
    update_chorus_mode();
  ) : idx == P_OCT ? (
    oct_tr = floor(value) - 1;
    update_oct_transpose();
  ) : idx == P_TUNING ? (
    tuning = value;
    update_oct_transpose();
  ) : idx == P_PORTAMODE ? (
    prev = porta_mode;
    porta_mode = floor(value);
    !(prev >= 1 && porta_mode >= 1) ? (
      i = 0; loop(128, ACTN[i] = KEYSDOWN[i] || HELDN[i]; i += 1;);
      prev == 0 ? (release_unison(); uni_note = -1; uni_n = 0;) : (
        i = 0;
        loop(MAXV, VNOTE[i] >= 0 ? (voice_release(vptr(i)); VNOTE[i] = -1;); i += 1;);
      );
      memset(HELDN, 0, 128);
      i = 0;
      loop(128,
        ACTN[i] ? (send_to_synth(i, 1, 127); !KEYSDOWN[i] ? HELDN[i] = 1;);
        i += 1;
      );
    );
    g_porta_en = 1;
  ) : idx == P_PORTARATE ? (
    g_portarate = value;
    g_portastep = porta_rate(value) / (12 * g_sr);
  ) : idx == P_ARPRATE ? (
    arp_rate_v = arp_rate(value);
  ) : idx == P_ARPQUANT ? (
    arp_division = clampv(floor(value), 0, 8);
  ) : idx == P_ARPMODE ? (
    arp_mode = floor(value);
  ) : idx == P_ARPRANGE ? (
    arp_range = floor(value);
  ) : idx == P_ARP ? (
    wasEn = arp_en;
    arp_en = value > 0.5;
    (arp_en && !wasEn) ? (
      i = 0;
      loop(128,
        (KEYSDOWN[i] || HELDN[i]) ? (arp_note_on(i); send_to_synth(i, 0, 0););
        i += 1;
      );
      memset(HELDN, 0, 128);
    ) : (!arp_en && wasEn) ? (
      hold_on ? (
        memset(HELDN, 0, 128);
        i = 0; loop(arp_n, HELDN[ARPHELD[i]] = 1; i += 1;);
        arp_last = -1;
      ) : arp_last >= 0 ? (
        send_to_synth(arp_last, 0, 0);
        arp_last = -1;
      );
      arp_reset();
    );
  ) : idx == P_HOLD ? (
    hold_on = value > 0.5;
    !hold_on ? release_held_notes();
  ) : idx == P_TRANSPOSE ? (
    transpose_on = value > 0.5;
  );
);


function dsp_setparam(idx, value)
(
  idx == P_ADSRMODE ? (
    g_model = floor(value) == 0 ? MDL_J60 : MDL_J106;
    g_j106res = g_model == MDL_J106;
    g_pinv = g_model == MDL_J106;
    g_model == MDL_J106 ? (
      g_sawamp = 0.6; g_pulamp = 0.5; g_subamp = 0.75; g_noiseamp = 1.2;
    ) : (
      g_sawamp = 0.5; g_pulamp = 0.5; g_subamp = 0.5942; g_noiseamp = 1;
    );
    lfo_model = g_model;
    hp_model = g_model;
    dsp_setparam_base(P_ENVA, sl_a);
    dsp_setparam_base(P_ENVD, sl_d);
    dsp_setparam_base(P_ENVR, sl_r);
    dsp_setparam_base(P_LFORATE, sl_lforate);
    dsp_setparam_base(P_LFODELAY, sl_lfodelay);
    dsp_setparam_base(P_DCOLFO, sl_dcolfo);
    dsp_setparam_base(P_VCFLFO, sl_vcflfo);
    dsp_setparam_base(P_VCFFREQ, sl_vcffreq);
    dsp_setparam_base(P_VCFENV, sl_vcfenv);
    dsp_setparam_base(P_VCFKBD, sl_vcfkbd);
    dsp_setparam_base(P_BENDVCF, sl_bendvcf);
    dsp_setparam_base(P_DCOSUB, sl_dcosub);
    dsp_setparam_base(P_DCONOISE, sl_dconoise);
    dsp_setparam_base(P_VCALEVEL, sl_vcalevel);
    dsp_setparam_base(P_HPF, sl_hpf);
  ) : dsp_setparam_base(idx, value);
);

function voice_rates() local(fs)
(
  fs = g_sr * g_os;
  g_swramp_blep = 1 - exp(-1 / (0.00145 * fs));
  g_podcg = tan(1.59 / (fs * 0.5) * $pi * 0.5);
  g_pvdcg = g_podcg;
  g_podk = g_podcg / (1 + g_podcg);
  g_pvdk = g_podk;
);

function set_oversample(os) local(i, v)
(
  os = os <= 1 ? 1 : os <= 2 ? 2 : 4;
  os != g_os ? (
    g_os = os;
    g_overscale = 1 / os;
    i = 0;
    loop(MAXV,
      v = vptr(i);
      memset(v + O_UP1X, 0, 48);
      v[O_CFRQ] = -1;
      i += 1;
    );
    memset(MD1X, 0, 64);
    bus_lpc = 1 - exp(-2 * $pi * 30000 / (g_sr * g_os));
    bus_lps = 0;
  );
);

// ---------------------------------------------------------------- processor-level parameter handling
function proc_param(idx, value) local(n)
(
  PRM[idx] = value;
  idx == P_POWER ? (
    power_on = value > 0.5;
    !power_on ? all_notes_off();
  ) : idx == P_TRANSOFS ? (
    key_tr = floor(value);
    update_oct_transpose();
  ) : idx == P_MASTER ? (
    0;
  ) : idx == P_VOICES ? (
    n = floor(value + 0.5);
    set_active_voices(n <= 7 ? 6 : n <= 9 ? 8 : 10);
  ) : idx == P_OVERSAMPLE ? (
    n = floor(value + 0.5);
    set_oversample(n <= 1 ? 1 : n <= 3 ? 2 : 4);
  ) : idx == P_IGNOREVEL ? (
    ignore_vel = value > 0.5;
  ) : idx == P_ARPLIMIT ? (
    arp_limit = value > 0.5;
  ) : idx == P_ARPSYNC ? (
    arp_sync = value > 0.5;
  ) : idx == P_LFOSYNC ? (
    lfo_sync = value > 0.5;
  ) : idx == P_MONORETRIG ? (
    mono_retrig = value > 0.5;
  ) : idx == P_MIDISYSEX ? (
    midi_sysex = value > 0.5;
  ) : idx == P_OSCMODE ? (
    g_oscmode = floor(value + 0.5);
  ) : (
    dsp_setparam(idx, value);
  );
);

// ---------------------------------------------------------------- reset (prepareToPlay)
function dsp_reset(sr) local(i, v)
(
  g_sr = sr;
  dac_smooth = 1 - exp(-1 / (0.001 * sr));
  lfo_tickstep = TICKRATE / sr;
  lfo_tickacc = 0;
  postvca_c = 1 - exp(-2 * $pi * 100000 / sr);
  postvca_s = 0;
  bus_lpc = 1 - exp(-2 * $pi * 30000 / (sr * g_os));
  bus_lps = 0;
  init_sawtables(sr);
  g_swramp_wt = 1 - exp(-1 / (0.00145 * sr));
  voice_rates();
  g_vcaslewc = 1 - exp(-1 / (0.000687 * sr));
  g_vcfslewc = 1 - exp(-1 / (0.000522 * sr));
  g_invnyq = 1 / (sr * 0.5);
  g_fwstep = TICKRATE / sr;
  g_envdecay = exp(-1 / (0.022 * sr));
  i = 0;
  loop(MAXV,
    v = vptr(i);
    v[O_S0] = v[O_S1] = v[O_S2] = v[O_S3] = 0;
    v[O_INENV] = 0;
    v[O_CFRQ] = -1;
    v[O_OPOS] = 0; v[O_OSUB] = 0; v[O_BPOS] = 0; v[O_BSUB] = 0;
    v[O_PODCS] = 0; v[O_PVDCS] = 0;
    memset(v + O_UP1X, 0, 48);
    VNOTE[i] = -1;
    i += 1;
  );
  g_portastep = porta_rate(g_portarate) / (12 * sr);
  uni_note = -1; uni_n = 0;
  reset_vtbl();
  hp_model = g_model;
  bb_init(sr);
  hpc.z1 = hpc.z2 = hpp.z1 = hpp.z2 = 0;
  hp_recalc();
  hpc.hps = 0; hpc.dcs = 0; hp_xfade = 0;
  hp_setmode(1);
  chorus_init(sr);
  fl.fn_init(sr, 20000);
  fl.pinken = 1;
  fl.fn_shelf(500, -16, sr);
  frip.rr_set(60, sr, 0.000018, 0.0000089, 0.0000063);
  dnoise_setsr(sr);
  memset(MD1X, 0, 64);
);

function ds_proc(x, y, s0, s1) local(i, t0, t1)
(
  i = 0;
  loop(6,
    t0 = (s0 - y[i]) * RCOEF[i] + x[i];
    t1 = (s1 - y[i + 1]) * RCOEF[i + 1] + x[i + 1];
    x[i] = s0; x[i + 1] = s1;
    y[i] = t0; y[i + 1] = t1;
    s0 = t0; s1 = t1;
    i += 2;
  );
  0.5 * (s0 + s1);
);

// ---------------------------------------------------------------- one block of audio (KR106DSP::ProcessBlock)
function process_chunk(n, outl, outr) local(i, nos, anyB, anyG, s, vi, a, b, c, x, mono, mix, t0, t1, j, ev, od)
(
  nos = n * g_os;
  memset(MIXOS, 0, nos);
  anyB = 0; anyG = 0;
  i = 0;
  loop(n_active, voice_busy(vptr(i)) ? anyB = 1; VNOTE[i] >= 0 ? anyG = 1; i += 1;);
  (porta_mode == 0 && uni_note >= 0) ? anyG = 1;
  lfo_active = anyB; lfo_gated = anyG;
  lfo_update_gate();

  (g_model == MDL_J106 && !lfo_sync) ? (
    s = 0;
    loop(n,
      lfo_tickacc += lfo_tickstep;
      lfo_tickacc >= 1 ? (lfo_tickacc -= 1; lfo_tick106(););
      LFOB[s] = lfo_itri * lfo_ampint;
      LFORAWB[s] = lfo_itri;
      NOISEB[s] = dnoise_proc();
      s += 1;
    );
    lfo_lasttri = lfo_itri;
    lfo_amp = lfo_ampint;
  ) : (
    s = 0;
    loop(n,
      LFOB[s] = lfo_process();
      LFORAWB[s] = lfo_lasttri;
      NOISEB[s] = dnoise_proc();
      s += 1;
    );
  );

  arp_process(n);
  update_drift_walk(effective_drift(), n / g_sr);

  g_lfoenvamp = lfo_amp;
  vi = 0;
  loop(n_active,
    (!eco_mode || voice_busy(vptr(vi)) || vptr(vi)[O_VCASLEW] > 0.00001) ? voice_render(vptr(vi), n, MIXOS);
    vi += 1;
  );

  i = 0;
  loop(nos, bus_lps += bus_lpc * (MIXOS[i] - bus_lps); MIXOS[i] = bus_lps; i += 1;);

  mix = MIXOS;
  s = 0;
  loop(n,
    g_os == 4 ? (
      a = ds_proc(MD2X, MD2Y, mix[1], mix[0]);
      b = ds_proc(MD2X, MD2Y, mix[3], mix[2]);
      mono = ds_proc(MD1X, MD1Y, b, a);
      mix += 4;
    ) : g_os == 2 ? (
      mono = ds_proc(MD1X, MD1Y, mix[1], mix[0]);
      mix += 2;
    ) : (
      mono = mix[0];
      mix += 1;
    );
    mono = hp_proc(mono);
    mono += fl.fn_proc() * 0.0015 * noise_floor_mul + frip.rr_proc() * mains_mul;
    vca_smooth += (vca_level - vca_smooth) * dac_smooth;
    mono *= vca_smooth;
    postvca_s += postvca_c * (mono - postvca_s);
    mono = postvca_s;
    (eco_mode && ch_mode == 0 && ch_pending == 0 && ch_fade <= 0) ? (ch_outl = ch_outr = mono;) : chorus_proc(mono);
    master_smooth += (master_vol - master_smooth) * 0.001;
    outl[s] = ch_outl * master_smooth;
    outr[s] = ch_outr * master_smooth;
    s += 1;
  );
);

function preset_def(i, name, hex) local(k, c0, c1, h0, h1)
(
  PNAMES[i] = name;
  k = 0;
  loop(44,
    c0 = str_getchar(hex, k * 2); c1 = str_getchar(hex, k * 2 + 1);
    h0 = c0 >= 'a' ? c0 - 'a' + 10 : c0 - '0';
    h1 = c1 >= 'a' ? c1 - 'a' + 10 : c1 - '0';
    PRESETV[i * 44 + k] = h0 * 16 + h1;
    k += 1;
  );
);

