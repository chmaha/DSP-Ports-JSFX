MDL_J6 = 0; MDL_J60 = 1; MDL_J106 = 2;
ST_ATTACK = 0; ST_DECAY = 1; ST_RELEASE = 2; ST_FINISHED = 3;

LOOP_MS = 4.2335;
TICKRATE = 1000 / LOOP_MS;
ENVMAX = 16383;
CHUNK = 512;
MAXV = 10;
VSTRIDE = 1024;

// ---------------------------------------------------------------- memory map
DACHZ = 0;
SAWT = 4096;
VCAJ6 = 53248;
VCAHW = 53504;
DECREL = 53760;
LFOSPD = 53888;
PRESETV = 54016;
PNAMES = 65280;
VOICES = 65536;
MIXOS = 75776;
LFOB = 77824;
LFORAWB = 78336;
NOISEB = 78848;
CHBUF0 = 79360;
CHBUF1 = 87552;
OUTL = 95744;
OUTR = 161280;
KEYSDOWN = 226816;
HELDN = 226944;
ARPHELD = 227072;
UNISTK = 227200;
VNOTE = 227328;
VLASTNOTE = 227344;
VEVER = 227360;
VAGE = 227376;
VTBL = 227392;
RCOEF = 227424;
MD1X = 227440; MD1Y = 227456; MD2X = 227472; MD2Y = 227488;
SXBUF = 227520;
LNST = 227504;
PRM = 228096;
PRMLAST = 228160;
VARSAVE = 228224;
ACTN = 228400;
PRMSENT = 228300;
SXOUT = 228600;
KBDHELD = 228640;
UIQ = 228800;
SCOPE = 229000;
QKEY1 = 233200; QKEY2 = 233240; QDOWN = 233280;
GFXMEM = 240000;

// ---------------------------------------------------------------- per-voice offsets
O_PITCH = 0; O_VEL = 1; O_GLIDE = 2; O_MIDINOTE = 3; O_VIDX = 4;
O_OPOS = 5; O_OSUB = 6; O_OSAWG = 7; O_OPULG = 8; O_OSUBG = 9;
O_BPOS = 10; O_BSUB = 11; O_BSAWG = 12; O_BPULG = 13; O_BSUBG = 14;
O_S0 = 15; O_S1 = 16; O_S2 = 17; O_S3 = 18; O_NSEED = 19; O_INENV = 20;
O_CFRQ = 21; O_CRES = 22; O_CJ106 = 23; O_CK = 24; O_CG1 = 25; O_CG1_2 = 26; O_CG1_3 = 27;
O_CINVDEN = 28; O_CKFB = 29; O_CINVKFB = 30; O_CNOISE = 31; O_COS = 32;
O_STATE = 33; O_ENV = 34; O_GATEENV = 35; O_ENVINT = 36; O_ENVPREV = 37; O_ENVNEXT = 38;
O_LASTPEAK = 39; O_VCASLEW = 40; O_VCFSLEW = 41; O_PODCS = 42; O_PVDCS = 43;
O_FWACC = 44; O_FWENVP = 45; O_FWENVN = 46; O_DACP = 47; O_DACN = 48; O_DACUPD = 49; O_VCAUPD = 50;
O_VCFPH = 51; O_VCAPH = 52;
O_VFOFS = 53; O_FRQTRIM = 54; O_WIDTRIM = 55; O_PITCHOFS = 56; O_VCAGS = 57; O_PWMINO = 58; O_PWMAXO = 59;
O_SOU = 60; O_WP0 = 61; O_WP1 = 62; O_WP2 = 63; O_WALK = 64;
O_UP1X = 900; O_UP1Y = 912; O_UP2X = 924; O_UP2Y = 936;

// ---------------------------------------------------------------- helpers
function lcg(s) local(lo, hi)
(
  lo = s & 65535;
  hi = s >> 16;
  (lo * 196314165 + ((hi * 196314165) & 65535) * 65536 + 907633515) & 4294967295;
);

function u32mul(a, b) local(lo, hi)
(
  lo = a & 65535;
  hi = a >> 16;
  (lo * b + ((hi * b) & 65535) * 65536) & 4294967295;
);

function f32u(x) local(e, q, r, fl, fr)
(
  x < 16777216 ? x : (
    e = floor(log(x) / log(2) + 0.0000000001);
    pow(2, e) > x ? e -= 1;
    q = pow(2, e - 23);
    r = x / q; fl = floor(r); fr = r - fl;
    (fr > 0.5 || (fr === 0.5 && (fl & 1))) ? fl += 1;
    fl * q;
  );
);

function rnd11(s) ( f32u(s) / 4294967296 * 2 - 1; );

function tanh_(x) local(e)
(
  x > 20 ? 1 : x < -20 ? -1 : (e = exp(2 * x); (e - 1) / (e + 1));
);

function clampv(x, a, b) ( x < a ? a : x > b ? b : x; );

function tbl_lerp11(t, a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10) local(idx, i0, fr, y0, y1)
(
  idx = t * 10;
  i0 = min(floor(idx), 9);
  i0 < 0 ? i0 = 0;
  fr = idx - i0;
  y0 = i0 == 0 ? a0 : i0 == 1 ? a1 : i0 == 2 ? a2 : i0 == 3 ? a3 : i0 == 4 ? a4 : i0 == 5 ? a5 : i0 == 6 ? a6 : i0 == 7 ? a7 : i0 == 8 ? a8 : a9;
  y1 = i0 == 0 ? a1 : i0 == 1 ? a2 : i0 == 2 ? a3 : i0 == 3 ? a4 : i0 == 4 ? a5 : i0 == 5 ? a6 : i0 == 6 ? a7 : i0 == 7 ? a8 : i0 == 8 ? a9 : a10;
  y0 + fr * (y1 - y0);
);

// ---------------------------------------------------------------- generated tables
function init_decrel() local(val, i, seg, n, cnt, stp)
(
  val = 4096;
  i = 0;
  DECREL[i] = val; i += 1;
  seg = 0;
  loop(7,
    cnt = seg == 0 ? 4 : seg == 1 ? 1 : seg == 2 ? 10 : seg == 3 ? 28 : seg == 4 ? 22 : seg == 5 ? 58 : 4;
    stp = seg == 0 ? 8192 : seg == 1 ? 4096 : seg == 2 ? 2048 : seg == 3 ? 128 : seg == 4 ? 12 : seg == 5 ? 4 : 1;
    loop(cnt, val = (val + stp) & 65535; DECREL[i] = val; i += 1;);
    seg += 1;
  );
);

function init_rcoef()
(
  RCOEF[0] = 0.036681502163648017; RCOEF[1] = 0.13654762463195794; RCOEF[2] = 0.27463175937945444;
  RCOEF[3] = 0.42313861743656711; RCOEF[4] = 0.56109869787919531; RCOEF[5] = 0.67754004997416184;
  RCOEF[6] = 0.76974183386322703; RCOEF[7] = 0.83988962484963892; RCOEF[8] = 0.89226081800387902;
  RCOEF[9] = 0.9315419599631839; RCOEF[10] = 0.96209454837808417; RCOEF[11] = 0.98781637073289585;
);

function init_sawtables(sr) local(t, freqBound, maxH, h, k, b, sg, buf, n)
(
  buf = OUTL;
  t = 0;
  loop(12,
    memset(buf, 0, 8192);
    freqBound = 8.176 * pow(2, t + 1);
    maxH = max(1, floor(sr * 0.5 / freqBound));
    h = 1;
    loop(maxH,
      k = h % 4096;
      sg = 1;
      k > 2048 ? (k = 4096 - k; sg = -1;);
      k > 0 && k < 2048 ? (
        b = (2 / $pi) / h;
        buf[2 * k + 1] += sg * b * 0.5;
      );
      h += 1;
    );
    fft_ipermute(buf, 2048);
    ifft_real(buf, 4096);
    n = 0;
    loop(4096, SAWT[t * 4096 + n] = buf[n]; n += 1;);
    t += 1;
  );
);

// ---------------------------------------------------------------- slider-curve functions
function attack_inc(slider) local(s)
(
  s = clampv(slider, 0, 1);
  s < 0.003937 ? ENVMAX :
  s <= 0.5 ? floor(8192 / (s * 127) + 0.5) :
  s <= 0.681102 ? floor(305.03 - 352.26 * s + 0.5) :
  s <= 0.846457 ? floor(194.74 - 190.50 * s + 0.5) :
  s <= 0.956693 ? floor(86.37 - 62.52 * s + 0.5) :
  max(floor(148 - 127 * s + 0.5), 1);
);

function calc_decay(value, coeff) local(vh, vl, ch, cl)
(
  vh = value >> 8; vl = value & 255;
  ch = coeff >> 8; cl = coeff & 255;
  ((vh * ch) + ((vh * cl) >> 8) + ((vl * ch) >> 8)) & 65535;
);

function attack_tau_j6(slider) local(s, idx, fr, a, b)
(
  s = slider * 10;
  idx = min(floor(s), 9);
  fr = s - idx;
  a = idx == 0 ? 0.000558 : idx == 1 ? 0.001674 : idx == 2 ? 0.008762 : idx == 3 ? 0.029468 : idx == 4 ? 0.064015 :
      idx == 5 ? 0.120998 : idx == 6 ? 0.238481 : idx == 7 ? 0.495993 : idx == 8 ? 0.607950 : 1.392486;
  b = idx == 0 ? 0.001674 : idx == 1 ? 0.008762 : idx == 2 ? 0.029468 : idx == 3 ? 0.064015 : idx == 4 ? 0.120998 :
      idx == 5 ? 0.238481 : idx == 6 ? 0.495993 : idx == 7 ? 0.607950 : idx == 8 ? 1.392486 : 1.674332;
  exp(log(a) + fr * (log(b) - log(a)));
);

function decrel_tau_j6(slider) ( 0.003577 * exp(12.9460 * slider - 5.0638 * slider * slider); );

function attack_ms_j106(slider) local(inc, ticks)
(
  inc = attack_inc(slider);
  ticks = floor((ENVMAX + inc - 1) / inc);
  1 + (ticks - 1) * (1000 / TICKRATE);
);

function decrel_ms_j106(slider) local(idx, coeff, val, target, ticks)
(
  idx = clampv(floor(slider * 127 + 0.5), 0, 127);
  coeff = DECREL[idx];
  val = ENVMAX;
  target = floor(ENVMAX / 10);
  ticks = 0;
  while (val > target && ticks < 50000) ( val = calc_decay(val, coeff); ticks += 1; );
  max(1.5, ticks / TICKRATE * 1000);
);

function dco_lfo_depth6(t) ( tbl_lerp11(t, 0, 0.041, 0.132, 0.198, 0.289, 0.405, 0.487, 0.940, 1.440, 2.053, 2.526); );

function dco_lfo_depth106(t) local(i, coeff)
(
  t = t / (1 + 5 * t - 5 * t * t);
  i = t * 127;
  i < 3 ? 0 : (
    coeff = i < 64 ? i - 2 : i < 96 ? 62 + 2 * (i - 64) : min(255, 128 + 4 * (i - 96));
    (coeff / 255) * 4;
  );
);

function dco_lfo_inv_taper(tp) local(a, b, c, disc)
(
  tp <= 0 ? 0 : tp >= 1 ? 1 : (
    a = 5 * tp; b = 1 - 5 * tp; c = -tp;
    disc = b * b - 4 * a * c;
    (-b + sqrt(disc)) / (2 * a);
  );
);

function vcf_lfo_depth6(t) ( pow(t, 1.2) * 36; );
function vcf_lfo_depth106(t) ( t * 42; );

function porta_rate(t) local(i, coeff)
(
  t === 0 ? 0 : (
    i = t * 127;
    coeff = i <= 25 ? 255 - 8 * (i - 1) : i <= 47 ? 63 - 2 * (i - 25) : floor(18 * pow(0.9625, i - 48) + 0.5);
    coeff * TICKRATE / 256;
  );
);

function sub_level_j6(t) ( tbl_lerp11(t, 0.00285, 0.00285, 0.02512, 0.05820, 0.09661, 0.15139, 0.20654, 0.44158, 0.66834, 0.88106, 1); );
function sub_level_j106(t) ( tbl_lerp11(t, 0.00154, 0.01251, 0.10875, 0.22125, 0.33576, 0.45206, 0.55750, 0.67178, 0.78447, 0.91132, 1); );

function noise_level_j60(t) local(d)
(
  t <= 0 ? 0 : (d = t - 0.1120; 1.1260 * (sqrt(d * d + 0.0227 * 0.0227) + d) * 0.5;);
);
function noise_level_j106(t) local(d)
(
  t <= 0 ? 0 : (d = t - 0.0594; 1.0632 * (sqrt(d * d + 0.0146 * 0.0146) + d) * 0.5;);
);

function j60_vcf_freq(s) local(f)
(
  f = 28 * exp(7.262 * s);
  f > 20000 ? f = 20000 + 20000 * tanh_((f - 20000) / 20000);
  f;
);

function j6_vcf_freq(s) local(rth, i, f)
(
  rth = s * (1 - s) * 50000;
  i = (15 * s + 11) / (rth + 100000);
  f = pow(2, -12.0674 + 116879.07 * i);
  f > 20000 ? f = 20000 + 20000 * tanh_((f - 20000) / 20000);
  f;
);

function dac_to_hz(dac, frqTrim, widthTrim) local(internal)
(
  internal = floor(dac * widthTrim + frqTrim + 0.5);
  dac * widthTrim + frqTrim + 0.5 < 0 ? internal = ceil(dac * widthTrim + frqTrim + 0.5);
  internal < 0 ? internal = 0;
  internal > 16383 ? internal = 16383;
  DACHZ[internal >> 2];
);

function lfo_freq_j6(slider) local(s, alpha, rup, rdn, vw)
(
  s = clampv(slider, 0, 1);
  alpha = (pow(10, 2 * s) - 1) / 99;
  rup = (1 - alpha) * 50000 + 4700;
  rdn = alpha * 50000 + 330;
  vw = 13.5 / (rup * (1 / rup + 1 / rdn + 1 / 150000));
  vw / (4 * 13.5 * (33000 / 47000) * 0.0000001 * 150000);
);

function lfo_speed_coeff(i) local(idx, fr)
(
  i <= 0 ? LFOSPD[0] : i >= 127 ? LFOSPD[127] : (
    idx = floor(i); fr = i - idx;
    LFOSPD[idx] + fr * (LFOSPD[idx + 1] - LFOSPD[idx]);
  );
);

function lfo_freq_j106(t) local(c, ph)
(
  c = floor(lfo_speed_coeff(t * 127) + 0.5);
  c < 1 ? c = 1;
  ph = floor((8192 + c - 1) / c);
  1000 / (4 * ph * LOOP_MS);
);

function arp_rate(t) local(pos, hz)
(
  pos = 1 - t;
  hz = 1 / (2 * (33000 + pos * 1000000) * 0.00000047 * 0.6633);
  hz * 60;
);

function vca_lookup(tbl, e) local(idx, i0, fr)
(
  idx = e * 255;
  i0 = floor(idx);
  idx < 0 ? i0 = ceil(idx);
  i0 = min(i0, 254);
  fr = idx - i0;
  tbl[i0] + fr * (tbl[i0 + 1] - tbl[i0]);
);

// ---------------------------------------------------------------- J106 firmware VCF CV
function calc_vcf_freq(cutoff, lfoSig, bendAmt, envMod, keyTrack, lfoPol, bendPol, envPol, envelope, pitch) local(ea, uf, se, ps, kd, r)
(
  ea = cutoff;
  uf = 0;
  !lfoPol ? (r = ea + lfoSig; r > 65535 ? uf = 0; ea = r & 65535;) : (lfoSig > ea ? uf = 1; ea = (ea - lfoSig) & 65535;);
  !bendPol ? (r = ea + bendAmt; r > 65535 ? uf = 0; ea = r & 65535;) : (bendAmt > ea ? uf = 1; ea = (ea - bendAmt) & 65535;);
  se = (envMod * envelope) >> 8;
  envPol ? (r = ea + se; r > 65535 ? uf = 0; ea = r & 65535;) : (se > ea ? uf = 1; ea = (ea - se) & 65535;);
  ps = ((pitch >> 2) + (pitch >> 3)) & 65535;
  ps > 5760 ? (
    kd = (keyTrack * (ps - 5760)) >> 8;
    r = ea + kd; r > 65535 ? uf = 0; ea = r & 65535;
  ) : (
    kd = (keyTrack * (5760 - ps)) >> 8;
    kd > ea ? uf = 1; ea = (ea - kd) & 65535;
  );
  ea > 16383 ? (uf ? 0 : 16383) : ea;
);

function calc_vcf_lfo_signal(lfoToVcf, depthScalar, lfoVal) local(comb)
(
  comb = ((lfoToVcf * depthScalar) >> 8) & 255;
  ((comb * lfoVal) >> 9) & 65535;
);

function calc_vcf_bend_amt(sens, bendVal) ( ((sens * bendVal) >> 4) & 65535; );
function init_dac_table() local(d) (
  d = DACHZ;
