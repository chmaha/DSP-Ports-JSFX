  preset_def(240, "B71 Piccolo", "000078461c000e00000204003f10625710676a15000000010100010000020000000100000000010200000001");
  preset_def(241, "B72 Melodic Taps", "00007863000000007f03487000007f7f00180018000000000000000100000000000000000000010200000001");
  preset_def(242, "B73 Meow Bass", "000078337f00490000002d6423004154045a001b000000000100010000010000000000010000010200000001");
  preset_def(243, "B74 Violin (high)", "000078472d16000000005900000378552b2d391a000000000100010000020000000000000000010200000001");
  preset_def(244, "B75 High Bells", "0000781e2d7f000000034c7f00007f6f0016343b000000000000010000020000000000000000010200000001");
  preset_def(245, "B76 Rolling Wah", "000078240000690000003c09007f004d22377f69000000010000010000010000000000000000010200000001");
  preset_def(246, "B77 Ping Bell", "000078000b00680000004c7f00007f5300171739000000010000000100020000000000000000010200000001");
  preset_def(247, "B78 Brassy Organ", "0000781000004438000008005700340e00246d00000000010101000100000000000000000000010200000001");
  preset_def(248, "B81 Low Dark Strings", "000078152d055100000047000000672853176d2a000000010100000001000000000000000000010200000001");
  preset_def(249, "B82 Piccolo Trumpet", "000078337f004900000000005e007f61032c330b000000000100010000010000000000010000010200000001");
  preset_def(250, "B83 Cello", "000078392d15000000004b0003012d6d30415a22000000000100010000000000000000000000010200000001");
  preset_def(251, "B84 High Strings", "00007850000a460000005c00000047301b393929000000010100000001020000000000000000010200000001");
  preset_def(252, "B85 Rocket Men", "0000786c0000000000006e7f503f7f00007f3359000000000000000001010000000001000000010200000001");
  preset_def(253, "B86 Forbidden Planet", "000078320b002c0900031d0458055f4f0030172a000000010001000100020000000100000000010200000001");
  preset_def(254, "B87 Froggy", "0000784e0000007f0001377f2b007f4d00000000000000010001010000000000000101010000010200000001");
  preset_def(255, "B88 Owgan", "0000783200002d380000265420007f6500313700000000010101010000000000000100000000010200000001");
);

// ---------------------------------------------------------------- factory patches
function is_live_param(i)
(
  i == P_TUNING || i == P_TRANSPOSE || i == P_HOLD || i == P_ARP || i == P_ARPRATE || i == P_ARPMODE ||
  i == P_ARPRANGE || i == P_PORTAMODE || i == P_PORTARATE || i == P_TRANSOFS || i == P_MASTER ||
  i == P_BENDER || i == P_BENDDCO || i == P_BENDVCF || i == P_BENDLFO || i == P_POWER || i == P_ADSRMODE ||
  i >= P_VOICES;
);

function is_unit_param(i)
(
  !(i == P_HPF || i == P_TRANSPOSE || i == P_HOLD || i == P_ARP || i == P_PULSE || i == P_SAW || i == P_SUBSW ||
    i == P_CHOFF || i == P_CHI || i == P_CHII || i == P_OCT || i == P_ARPMODE || i == P_ARPRANGE ||
    i == P_LFOMODE || i == P_PWMMODE || i == P_VCFINV || i == P_VCAMODE || i == P_BENDER || i == P_TUNING ||
    i == P_POWER || i == P_PORTAMODE || i == P_TRANSOFS || i == P_ADSRMODE || i >= P_VOICES);
);

function bank_offset() ( g_model == MDL_J106 ? 128 : 0; );

function preset_value(abs, i) local(raw, v)
(
  raw = PRESETV[abs * 44 + i];
  is_unit_param(i) ? (
    v = raw / 127;
    (i == P_DCOLFO && abs >= 128) ? v = dco_lfo_inv_taper(v);
  ) : v = raw;
  (i == P_DCOPWM && g_model == MDL_J106) ? v = min(1, v * (127 / 105));
  v;
);

// ---------------------------------------------------------------- parameter plumbing
function out_clip(x) local(a)
(
  a = abs(x);
  a <= 0.8 ? x : (x < 0 ? -1 : 1) * (0.8 + 0.2 * tanh_((a - 0.8) / 0.2));
);

function automate(s, e)
(
<?
  max_sliders > 59 ? printf("slider_automate(2^(s-1),e);") :
    loop(i = 1; 59,
      printf("  s == %d ? slider_automate(slider%d, e) :\n", i, i);
      i += 1;
    );
?> 0;
);

function notify(s)
(
<?
  max_sliders > 59 ? printf("sliderchange(2^(s-1));") :
    loop(i = 1; 59,
      printf("  s == %d ? sliderchange(slider%d) :\n", i, i);
      i += 1;
    );
?> 0;
);

function param_mask(i) ( notify(i + 1); );

function param_apply(i, v)
(
  slider(i + 1) = v;
  PRMLAST[i] = v;
  proc_param(i, v);
  param_mask(i);
);

function remap_bsearch(srcHz, toJ106) local(lo, hi, mid, f)
(
  lo = 0; hi = 1;
  loop(32,
    mid = (lo + hi) * 0.5;
    f = toJ106 ? dac_to_hz(floor(mid * 16256), 0, 1) : j60_vcf_freq(mid);
    f < srcHz ? lo = mid : hi = mid;
  );
  (lo + hi) * 0.5;
);

function param_changed(i, v) local(to106, src, hp)
(
  PRMLAST[i] = v;
  proc_param(i, v);
  (i == P_ADSRMODE && (v > 0.5) != was106) ? (
    to106 = v > 0.5;
    was106 = to106;
    initial_default = 1;
    src = to106 ? j60_vcf_freq(PRM[P_VCFFREQ]) : dac_to_hz(floor(PRM[P_VCFFREQ] * 16256), 0, 1);
    param_apply(P_VCFFREQ, remap_bsearch(src, to106));
    hp = floor(PRM[P_HPF] + 0.5);
    (!to106 && hp <= 1) ? param_apply(P_HPF, 0) : (to106 && hp == 0) ? param_apply(P_HPF, 1);
  );
  ((i == P_CHI || i == P_CHII) && v > 0.5 && PRM[P_CHOFF] > 0.5) ? param_apply(P_CHOFF, 0);
);

function set_param(i, v)
(
  slider(i + 1) = v;
  param_changed(i, v);
  param_mask(i);
);

function poll_sliders() local(i, v)
(
  i = 0;
  loop(NPARAMS,
    v = slider(i + 1);
    v !== PRMLAST[i] ? param_changed(i, v);
    i += 1;
  );
);

function load_preset(idx) local(abs, i, v)
(
  idx >= 0 && idx < 128 ? (
    abs = idx + bank_offset();
    cur_preset = idx;
    initial_default = 0;
    i = 0;
    loop(44,
      !is_live_param(i) ? (
        v = preset_value(abs, i);
        v !== PRM[i] ? set_param(i, v);
      );
      i += 1;
    );
    send_preset_midi = 1;
  );
);

function load_preset_pc(idx) local(abs, i)
(
  idx >= 0 && idx < 128 ? (
    abs = idx + bank_offset();
    i = 0;
    loop(44, !is_live_param(i) ? slider(i + 1) = preset_value(abs, i); i += 1;);
    cur_preset = idx;
    initial_default = 0;
    i = 0;
    loop(NPARAMS, param_changed(i, slider(i + 1)); param_mask(i); i += 1;);
    send_preset_midi = 1;
  );
);

function preset_dirty() local(abs, i, d, cur)
(
  initial_default ? 1 : (
    abs = cur_preset + bank_offset();
    d = 0; i = 0;
    loop(44,
      !is_live_param(i) ? (
        cur = PRM[i];
        abs(cur - preset_value(abs, i)) > 0.0001 ? d = 1;
      );
      i += 1;
    );
    d;
  );
);

// ---------------------------------------------------------------- MIDI in
function cc_to_param(cc)
(
  cc == 3 ? P_DCOLFO : cc == 5 ? P_PORTARATE : cc == 7 ? P_MASTER : cc == 9 ? P_DCOSUB : cc == 11 ? P_VCALEVEL :
  cc == 12 ? P_HPF : cc == 13 ? P_DCONOISE : cc == 70 ? P_ENVS : cc == 71 ? P_VCFRES : cc == 72 ? P_ENVR :
  cc == 73 ? P_ENVA : cc == 74 ? P_VCFFREQ : cc == 75 ? P_ENVD : cc == 76 ? P_VCFENV : cc == 77 ? P_VCFLFO :
  cc == 78 ? P_VCFKBD : cc == 79 ? P_DCOPWM : cc == 80 ? P_LFORATE : cc == 81 ? P_LFODELAY : cc == 82 ? P_ARPRATE : -1;
);

function sx_param(ctrl)
(
  ctrl == 0 ? P_LFORATE : ctrl == 1 ? P_LFODELAY : ctrl == 2 ? P_DCOLFO : ctrl == 3 ? P_DCOPWM :
  ctrl == 4 ? P_DCONOISE : ctrl == 5 ? P_VCFFREQ : ctrl == 6 ? P_VCFRES : ctrl == 7 ? P_VCFENV :
  ctrl == 8 ? P_VCFLFO : ctrl == 9 ? P_VCFKBD : ctrl == 10 ? P_VCALEVEL : ctrl == 11 ? P_ENVA :
  ctrl == 12 ? P_ENVD : ctrl == 13 ? P_ENVS : ctrl == 14 ? P_ENVR : P_DCOSUB;
);

function sx_set(i, v)
(
  (i == P_DCOLFO) ? v = dco_lfo_inv_taper(v);
  set_param(i, v);
);

function sx_slider(ctrl, val) local(v)
(
  v = (ctrl == 3) ? min(val, 105) / 105 : val / 127;
  sx_set(sx_param(ctrl), v);
);

function sx_sw1(val) local(chOn, l1)
(
  set_param(P_OCT, (val & 4) ? 2 : (val & 2) ? 1 : 0);
  set_param(P_PULSE, (val & 8) ? 1 : 0);
  set_param(P_SAW, (val & 16) ? 1 : 0);
  chOn = !(val & 32);
  l1 = (val & 64) != 0;
  set_param(P_CHOFF, chOn ? 0 : 1);
  set_param(P_CHI, (chOn && l1) ? 1 : 0);
  set_param(P_CHII, (chOn && !l1) ? 1 : 0);
);

function sx_sw2(val)
(
  set_param(P_PWMMODE, (val & 1) ? 1 : 0);
  set_param(P_VCFINV, (val & 2) ? 1 : 0);
  set_param(P_VCAMODE, (val & 4) ? 1 : 0);
  set_param(P_HPF, 3 - ((val >> 3) & 3));
);

function handle_sysex(buf, len) local(d, n, cmd, ctrl, k)
(
  d = buf + 1;
  n = len - 1;
  d[n - 1] == 247 ? n -= 1;
  (n >= 4 && d[0] == 65) ? (
    cmd = d[1];
    cmd == 50 ? (
      n >= 5 ? (
        ctrl = d[3];
        ctrl <= 15 ? (
          sx_slider(ctrl, d[4]);
          ctrl == 15 ? set_param(P_SUBSW, d[4] > 0 ? 1 : 0);
        ) : ctrl == 16 ? sx_sw1(d[4]) : ctrl == 17 ? sx_sw2(d[4]);
      );
    ) : (cmd == 48 || cmd == 49) && n >= 21 ? (
      k = 0;
      loop(16, sx_slider(k, d[4 + k]); k += 1;);
      sx_sw1(d[20]);
      sx_sw2(d[21]);
      set_param(P_SUBSW, d[4 + 15] > 0 ? 1 : 0);
      cmd == 48 ? (d[3] < 128 ? cur_preset = d[3]; initial_default = 0;) : initial_default = 1;
    );
  );
);

function control_change(cc, value)
(
  cc == 1 ? (
    lfo_trigger = value > 0;
    g_bmod = value > 0 ? 1 : 0;
  );
);

function handle_cc(cc, val) local(p, h)
(
  (cc == 120 || cc == 123) ? all_notes_off() :
  cc == 64 ? set_param(P_HOLD, val >= 64 ? 1 : 0) :
  cc == 65 ? set_param(P_PORTAMODE, val >= 64 ? 1 : 0) :
  cc == 1 ? (control_change(1, val / 127); lfo_trig_ui = val > 0;) : (
    p = cc_to_param(cc);
    p >= 0 ? (
      p == P_HPF ? (h = min(floor(val / 32), 3); set_param(p, h);) :
      (p == P_DCOPWM && g_model == MDL_J106) ? set_param(p, min(val, 105) / 105) :
      set_param(p, val / 127);
    );
  );
);

function handle_note_on(note, vel)
(
  PRM[P_TRANSPOSE] > 0.5 ? set_param(P_TRANSOFS, clampv(note - 60, -24, 36)) : (
    dsp_note_on(note, vel);
    KBDHELD[note] = 1;
  );
);

function handle_note_off(note)
(
  dsp_note_off(note);
  !hold_on ? KBDHELD[note] = 0;
);

// ---------------------------------------------------------------- MIDI out
function emit_sw1() local(b)
(
  b = PRM[P_OCT] >= 1.5 ? 4 : PRM[P_OCT] >= 0.5 ? 2 : 1;
  PRM[P_PULSE] > 0.5 ? b |= 8;
  PRM[P_SAW] > 0.5 ? b |= 16;
  (PRM[P_CHI] <= 0.5 && PRM[P_CHII] <= 0.5) ? b |= 32;
  PRM[P_CHI] > 0.5 ? b |= 64;
  b;
);

function emit_sw2() local(b)
(
  b = floor(PRM[P_PWMMODE] + 0.5) != 0 ? 1 : 0;
  PRM[P_VCFINV] > 0.5 ? b |= 2;
  floor(PRM[P_VCAMODE] + 0.5) != 0 ? b |= 4;
  b |= (3 - floor(PRM[P_HPF] + 0.5)) * 8;
  b;
);

function sx_param_index(i) local(k, r)
(
  r = -1; k = 0;
  loop(16, sx_param(k) == i ? r = k; k += 1;);
  r;
);

function send_apr(cmd) local(b, k)
(
  b = SXOUT;
  b[0] = 240; b[1] = 65; b[2] = cmd; b[3] = 0; b[4] = cmd == 48 ? cur_preset & 127 : 0;
  k = 0;
  loop(16, b[5 + k] = floor(PRM[sx_param(k)] * (k == 3 ? 105 : 127) + 0.5); k += 1;);
  b[21] = emit_sw1(); b[22] = emit_sw2(); b[23] = 247;
  midisend_buf(0, b, 24);
);

function send_ipr(ctrl, val) local(b)
(
  b = SXOUT;
  b[0] = 240; b[1] = 65; b[2] = 50; b[3] = 0; b[4] = ctrl; b[5] = val; b[6] = 247;
  midisend_buf(0, b, 7);
);

function midi_out_params() local(i, cur, sx, cc, v)
(
  i = 0;
  loop(NPARAMS,
    cur = PRM[i];
    cur !== PRMSENT[i] ? (
      PRMSENT[i] = cur;
      !send_preset_midi ? (
        (preset_clean && midi_sysex && !is_live_param(i)) ? (preset_clean = 0; send_apr(49););
        midi_sysex ? (
          sx = sx_param_index(i);
          sx >= 0 ? send_ipr(sx, floor(cur * (sx == 3 ? 105 : 127) + 0.5));
          (i == P_OCT || i == P_PULSE || i == P_SAW || i == P_CHOFF || i == P_CHI || i == P_CHII) ? send_ipr(16, emit_sw1());
          (i == P_PWMMODE || i == P_VCFINV || i == P_VCAMODE || i == P_HPF) ? send_ipr(17, emit_sw2());
        ) : (
          cc = -1; v = 0;
          loop(128, cc_to_param(v) == i ? cc = v; v += 1;);
          cc >= 0 ? (
            v = i == P_HPF ? floor(cur + 0.5) * 32 : floor(cur * ((i == P_DCOPWM && g_model == MDL_J106) ? 105 : 127) + 0.5);
            midisend(0, 176, cc, clampv(v, 0, 127));
          );
        );
      );
    );
    i += 1;
  );
  send_preset_midi ? (
    send_preset_midi = 0;
    midi_sysex ? send_apr(48) : midisend(0, 192, cur_preset & 127, 0);
    preset_clean = 1;
  );
);

// ---------------------------------------------------------------- startup
function knob_mul(k) ( k <= 0 ? 0 : pow(4, 2 * k - 1); );

function apply_noise_knobs()
(
  noise_floor_mul = ch_analog = knob_mul(k_analog);
  mains_mul = ch_mains = knob_mul(k_mains);
  ch_clock = knob_mul(k_clock);
  ch_driveuser = k_drive * 100;
  chorus_update_drive();
);

function tune_apply(mode) local(base, v, p, seed, r, val, i)
(
  calib_state = mode;
  mode == 1 ? (
    v = 0;
    loop(MAXV, p = vptr(v); p[O_FRQTRIM] = 0; p[O_WIDTRIM] = 1; p[O_VCAGS] = 1; p[O_PWMINO] = 0; p[O_PWMAXO] = 0; v += 1;);
    k_analog = k_mains = k_clock = k_drive = 0;
    apply_noise_knobs();
    set_drift_amount(0);
  ) : (
    base = floor(time_precise() * 1000) & 4294967295;
    v = 0;
    loop(MAXV,
      p = vptr(v);
      seed = (base + u32mul(v, 2654435761)) & 4294967295;
      i = 0;
      loop(5,
        r = i == 0 ? 10 : i == 1 ? 10 : i == 2 ? 0.024 : 0.02;
        mode == 3 ? r *= 2;
        seed = lcg(seed);
        val = rnd11(seed) * r;
        i == 0 ? p[O_FRQTRIM] = val : i == 1 ? p[O_WIDTRIM] = 1 + val / 1200 : i == 2 ? p[O_VCAGS] = 1 + val :
        i == 3 ? p[O_PWMINO] = val : p[O_PWMAXO] = val;
        i += 1;
      );
      v += 1;
    );
    k_analog = k_mains = k_clock = k_drive = mode == 3 ? 0.65 : 0.5;
    apply_noise_knobs();
    drift_amt = mode == 3 ? 0.75 : 0.25;
    drift_salt = base;
    i = 0; loop(MAXV, voice_set_drift(i, effective_drift(), 1); i += 1;);
    set_drift_amount(drift_amt);
  );
);

function apply_all_params() local(i)
(
  i = 0;
  loop(NPARAMS, PRM[i] = slider(i + 1); PRMLAST[i] = PRM[i]; proc_param(i, PRM[i]); i += 1;);
);

function engine_first_init() local(i)
(
  init_dac_table(); init_vcaj6(); init_vcahw(); init_lfospd(); init_decrel(); init_rcoef();
  init_presets();
  i = 0; loop(MAXV, init_variance(i); vptr(i)[O_GLIDE] = -100; vptr(i)[O_STATE] = ST_FINISHED; vptr(i)[O_NSEED] = 123456789;
    vptr(i)[O_OSAWG] = vptr(i)[O_OPULG] = vptr(i)[O_BSAWG] = vptr(i)[O_BPULG] = 1; VNOTE[i] = -1; VLASTNOTE[i] = -1; i += 1;);
  reset_vtbl();
  g_os = 4; g_overscale = 0.25; n_active = 10; g_model = MDL_J106; lfo_model = MDL_J106; hp_model = MDL_J106;
  g_porta_en = 0; porta_mode = 1; uni_note = -1; ignore_vel = 1; mono_retrig = 1; arp_limit = 1;
  arp_rate_v = 120; arp_dir = 1; arp_last = -1; arp_lastsync = -1; arp_division = 6; lfo_division = 5;
  g_envinv = 1; g_vcamode = 0; g_sawon = g_pulon = 1; g_subon = 0; g_dcosub = 1;
  g_sawamp = 0.5; g_pulamp = 0.5; g_subamp = 0.5942; g_noiseamp = 1;
  sl_a = sl_d = sl_r = 0.25; sl_lforate = 0.24; sl_vcffreq = 0.5; sl_dcosub = 1; sl_vcalevel = 0.5; sl_hpf = 1;
  vca_level = vca_smooth = 1; master_vol = master_smooth = 1;
  lfo_rising = 1; lfo_armed = 1; lfo_sr = 44100;
  dn_seed = 22222;
  fl.seed = 305419896; wp0.seed = 305419896; wp1.seed = 305419896;
  lk0.seed = 3735928559; lk1.seed = 3735928559;
  LNST[1] = LNST[2] = LNST[5] = LNST[6] = 0.12;
  noise_floor_mul = 1; mains_mul = 1; ch_analog = 1; ch_mains = 1; ch_clock = 1; ch_driveuser = 50;
  k_analog = k_mains = k_clock = k_drive = 0.5;
  drift_amt = 0.25; drift_salt = 0; calib_state = 2;
  was106 = 1; initial_default = 1; power_on = 1;
  proc_param(P_VOICES, slider(P_VOICES + 1));
  proc_param(P_OVERSAMPLE, slider(P_OVERSAMPLE + 1));
  proc_param(P_IGNOREVEL, slider(P_IGNOREVEL + 1));
  proc_param(P_ARPLIMIT, slider(P_ARPLIMIT + 1));
  proc_param(P_ARPSYNC, slider(P_ARPSYNC + 1));
  proc_param(P_LFOSYNC, slider(P_LFOSYNC + 1));
  proc_param(P_MONORETRIG, slider(P_MONORETRIG + 1));
  proc_param(P_MIDISYSEX, slider(P_MIDISYSEX + 1));
  proc_param(P_OSCMODE, slider(P_OSCMODE + 1));
  set_drift_amount(drift_amt);
  engine_inited = 1;
);

function engine_prepare(sr) local(i)
(
  dsp_reset(sr);
  fade_rem = 64;
  master_vol = slider(P_MASTER + 1) * slider(P_MASTER + 1);
  master_smooth = master_vol;
  vca_smooth = vca_level;
  apply_all_params();
  i = 0; loop(NPARAMS, PRMSENT[i] = PRM[i]; i += 1;);
  hold_on ? (
    arp_en ? (arp_n > 0 ? arp_phase = 1;) : (
      i = 0; loop(128, HELDN[i] ? send_to_synth(i, 1, 127); i += 1;);
    );
  );
);

function render_to(target) local(n)
(
  while (blk_pos < target) (
    n = min(CHUNK, target - blk_pos);
    host_beatpos = blk_beat0 + blk_pos * host_bpm / (60 * srate);
    process_chunk(n, OUTL + blk_pos, OUTR + blk_pos);
    blk_pos += n;
  );
);

!engine_inited ? engine_first_init();
engine_prepare(srate);
last_srate = srate;

@slider
last_srate != srate ? (last_srate = srate; engine_prepare(srate););
poll_sliders();

@block
poll_sliders();
req_preset_on ? (req_preset_on = 0; load_preset(req_preset););
req_tune > 0 ? (tune_apply(req_tune); req_tune = 0;);
req_drift_on ? (req_drift_on = 0; set_drift_amount(req_drift););
req_noise_on ? (req_noise_on = 0; k_analog = k_mains = k_clock = req_noise; apply_noise_knobs(););
(!hold_on && was_hold) || !power_on ? memset(KBDHELD, 0, 128);
was_hold = hold_on;
master_vol = PRM[P_MASTER] * PRM[P_MASTER];
host_bpm = tempo > 0 ? tempo : 120;
host_playing = (play_state & 1) != 0;
arp_hostplay = host_playing;
blk_beat0 = beat_position;
blk_pos = 0;
midi_out_params();

while ((mlen = midirecv_buf(mofs, SXBUF, 512)) > 0) (
  mofs = clampv(mofs, 0, samplesblock);
  render_to(mofs);
  mst = SXBUF[0];
  mtype = mst & 240;
  mch = mst & 15;
  (mst == 240) ? handle_sysex(SXBUF, mlen) :
  (midi_ch == 0 || mch == midi_ch - 1) ? (
    mtype == 144 && SXBUF[2] > 0 ? handle_note_on(SXBUF[1], SXBUF[2]) :
    (mtype == 128 || (mtype == 144 && SXBUF[2] == 0)) ? handle_note_off(SXBUF[1]) :
    mtype == 176 ? handle_cc(SXBUF[1], SXBUF[2]) :
    mtype == 192 ? load_preset_pc(SXBUF[1]) :
    mtype == 224 ? set_param(P_BENDER, ((SXBUF[2] * 128 + SXBUF[1]) - 8192) / 8192);
  );
  midisend_buf(mofs, SXBUF, mlen);
);

while (uiq_r != uiq_w) (
  ust = UIQ[uiq_r * 3]; ud1 = UIQ[uiq_r * 3 + 1]; ud2 = UIQ[uiq_r * 3 + 2];
  (ust == 1) ? (HELDN[ud1] = 0; KBDHELD[ud1] = 0; arp_en ? arp_note_off(ud1) : send_to_synth(ud1, 0, 0);) :
  (ust == 144 && ud2 > 0) ? (dsp_note_on(ud1, ud2); KBDHELD[ud1] = 1;) :
  (ust == 128) ? handle_note_off(ud1) :
  (ust == 176) ? (control_change(ud1, ud2 / 127); lfo_trig_ui = ud2 > 0;);
  ust >= 128 ? midisend(0, ust, ud1, ud2);
  uiq_r = (uiq_r + 1) % 64;
);

render_to(samplesblock);
spos = 0;

@sample
spl0 = OUTL[spos];
spl1 = OUTR[spos];
fade_rem > 0 ? (fgain = (64 - fade_rem) / 64; spl0 *= fgain; spl1 *= fgain; fade_rem -= 1;);
!power_on ? (spl0 = 0; spl1 = 0;);
clip_pk = max(clip_pk, max(abs(spl0), abs(spl1)));
soft_clip ? (spl0 = out_clip(spl0); spl1 = out_clip(spl1););
SCOPE[scope_w] = spl0;
scope_w = (scope_w + 1) & 4095;
spos += 1;

@serialize
ser_ver = 1;
file_var(0, ser_ver);
file_var(0, cur_preset);
file_var(0, initial_default);
file_var(0, drift_amt);
file_var(0, drift_salt);
file_var(0, k_analog);
file_var(0, k_mains);
file_var(0, k_clock);
file_var(0, k_drive);
ser_i = 0;
loop(MAXV,
  ser_v = vptr(ser_i);
  file_var(0, ser_v[O_FRQTRIM]);
  file_var(0, ser_v[O_WIDTRIM]);
  file_var(0, ser_v[O_VCAGS]);
  file_var(0, ser_v[O_PWMINO]);
  file_var(0, ser_v[O_PWMAXO]);
  ser_i += 1;
);
file_var(0, calib_state);
file_avail(0) >= 0 ? (
  calib_state < 1 || calib_state > 3 ? calib_state = 2;
  apply_noise_knobs();
  drift_salt != 0 ? (ser_i = 0; loop(MAXV, voice_set_drift(ser_i, effective_drift(), 1); ser_i += 1;););
  set_drift_amount(drift_amt);
);

@gfx 1400 770
// ---------------------------------------------------------------- geometry and drawing helpers
VW = 1400; VH = 770;
CTX = GFXMEM; CTY = GFXMEM + 200; CTW = GFXMEM + 400; CTH = GFXMEM + 600;
CTT = GFXMEM + 800; CTP = GFXMEM + 1000; CTA = GFXMEM + 1200; CTB = GFXMEM + 1400;
DEFV = GFXMEM + 1600;

function gc(r, g, b) ( gfx_set(r / 255, g / 255, b / 255, 1); );
function gca(r, g, b, a) ( gfx_set(r / 255, g / 255, b / 255, a); );
function X(x) ( gx0 + x * sc; );
function Y(y) ( gy0 + y * sc; );
function rf(x, y, w, h) ( gfx_rect(X(x), Y(y), max(1, w * sc), max(1, h * sc), 1); );
function ro(x, y, w, h) ( gfx_rect(X(x), Y(y), max(1, w * sc), max(1, h * sc), 0); );
function ln(x1, y1, x2, y2) ( gfx_line(X(x1), Y(y1), X(x2), Y(y2), 1); );
function circ(x, y, r, f) ( gfx_circle(X(x), Y(y), max(1, r * sc), f, 1); );
function fnt(size, bold) ( gfx_setfont(1, "Arial", max(6, size * sc), bold ? 'b' : 0); );
function tc(x, y, s) local(w, h) ( gfx_measurestr(s, w, h); gfx_x = X(x) - w * 0.5; gfx_y = Y(y) - h * 0.5; gfx_drawstr(s); );
function tl(x, y, s) local(w, h) ( gfx_measurestr(s, w, h); gfx_x = X(x); gfx_y = Y(y) - h * 0.5; gfx_drawstr(s); );
function tr(x, y, s) local(w, h) ( gfx_measurestr(s, w, h); gfx_x = X(x) - w; gfx_y = Y(y) - h * 0.5; gfx_drawstr(s); );

function ct_add(x, y, w, h, t, p, a, b)
(
  nct < 200 ? (
    CTX[nct] = x; CTY[nct] = y; CTW[nct] = w; CTH[nct] = h; CTT[nct] = t; CTP[nct] = p; CTA[nct] = a; CTB[nct] = b;
    nct += 1;
  );
);

function ct_hit(mx, my) local(i, r)
(
  r = -1; i = nct - 1;
  while (r < 0 && i >= 0) (
    (mx >= CTX[i] && mx < CTX[i] + CTW[i] && my >= CTY[i] && my < CTY[i] + CTH[i]) ? r = i;
    i -= 1;
  );
  r;
);

function pv(i) ( slider(i + 1); );

function ui_set(i, v)
(
  slider(i + 1) !== v ? (slider(i + 1) = v; automate(i + 1, 0););
);

function ui_tap(i, v)
(
  ui_set(i, v);
  automate(i + 1, 1);
);

function ui_q(st, d1, d2) local(nw)
(
  nw = (uiq_w + 1) % 64;
  nw != uiq_r ? (UIQ[uiq_w * 3] = st; UIQ[uiq_w * 3 + 1] = d1; UIQ[uiq_w * 3 + 2] = d2; uiq_w = nw;);
);

// ---------------------------------------------------------------- value text (hover readout)
function fmt_ms(ms) ( ms >= 1000 ? sprintf(#vt, "%.2f s", ms / 1000) : sprintf(#vt, "%d ms", floor(ms + 0.5)); );

function fmt_param(i, v) local(hz, st, ms, db, is106)
(
  is106 = pv(P_ADSRMODE) > 0.5;
  i == P_VCFFREQ ? (
    hz = is106 ? dac_to_hz(floor(v * 16256), 0, 1) : j60_vcf_freq(v);
    hz >= 1000 ? sprintf(#vt, "%.1f kHz", hz / 1000) : sprintf(#vt, "%.1f Hz", hz);
  ) : i == P_LFORATE ? (
    sprintf(#vt, "%.1f Hz", is106 ? lfo_freq_j106(v) : lfo_freq_j6(v));
  ) : i == P_LFODELAY ? (
    v <= 0 ? strcpy(#vt, "Off") : sprintf(#vt, "%d ms", floor(v * 1500 + 0.5));
  ) : i == P_DCOLFO ? (
    st = is106 ? dco_lfo_depth106(v) : dco_lfo_depth6(v);
    st < 0.05 ? strcpy(#vt, "Off") : sprintf(#vt, "%.1f st", st);
  ) : i == P_VCFLFO ? (
    st = is106 ? vcf_lfo_depth106(v) : vcf_lfo_depth6(v);
    st < 0.5 ? strcpy(#vt, "Off") : sprintf(#vt, "%.1f st", st);
  ) : i == P_DCOPWM ? (
    sprintf(#vt, "%d%% [%d]", floor(v * 100 + 0.5), floor(v * (is106 ? 105 : 127) + 0.5));
  ) : i == P_VCALEVEL ? (
    db = -10 + 20 * v; sprintf(#vt, db >= 0 ? "+%.1f dB" : "%.1f dB", db);
  ) : i == P_ENVA ? (
    fmt_ms(is106 ? attack_ms_j106(v) : attack_tau_j6(v) * 1791.8);
  ) : (i == P_ENVD || i == P_ENVR) ? (
    fmt_ms(is106 ? decrel_ms_j106(v) : decrel_tau_j6(v) * 2397.9);
  ) : i == P_TUNING ? (
    st = floor(abs(v) * 100 + 0.5); sprintf(#vt, "%s%d cents", v < 0 && st > 0 ? "-" : "+", st);
  ) : i == P_PORTARATE ? (
    st = porta_rate(v); st <= 0 ? strcpy(#vt, "Off") : (ms = 12000 / st; ms >= 1000 ? sprintf(#vt, "%.2f s/oct", ms / 1000) : sprintf(#vt, "%d ms/oct", floor(ms + 0.5)););
  ) : i == P_MASTER ? (
    v <= 0 ? strcpy(#vt, "-inf dB") : (db = 20 * log10(v * v); sprintf(#vt, db >= 0 ? "+%.1f dB" : "%.1f dB", db););
  ) : i == P_ARPRATE ? (
    pv(P_ARPSYNC) > 0.5 ? strcpy(#vt, "host sync") : sprintf(#vt, "%d bpm", floor(arp_rate(v) + 0.5));
  ) : i == P_HPF ? (
    st = floor(v + 0.5);
    is106 ? strcpy(#vt, st == 0 ? "Bass Boost" : st == 1 ? "Flat" : st == 2 ? "236 Hz" : "754 Hz") :
            strcpy(#vt, st == 0 ? "Flat" : st == 1 ? "122 Hz" : st == 2 ? "269 Hz" : "571 Hz");
  ) : i == P_BENDER ? (
    st = floor(abs(v) * 100 + 0.5); sprintf(#vt, "%s%d%%", v < 0 && st > 0 ? "-" : "+", st);
  ) : (i == P_POWER || i == P_PULSE || i == P_SAW || i == P_SUBSW || i == P_CHI || i == P_CHII || i == P_CHOFF ||
         i == P_ARP || i == P_HOLD || i == P_TRANSPOSE) ? (
    strcpy(#vt, v > 0.5 ? "ON" : "OFF");
  ) : i == P_OCT ? (
    st = floor(v + 0.5); strcpy(#vt, st == 0 ? "16'" : st == 1 ? "8'" : "4'");
  ) : i == P_PWMMODE ? (
    st = floor(v + 0.5); strcpy(#vt, st == 0 ? "LFO" : st == 1 ? "MANUAL" : "ENV");
  ) : i == P_VCFINV ? (
    strcpy(#vt, v > 0.5 ? "INVERTED" : "NORMAL");
  ) : i == P_VCAMODE ? (
    strcpy(#vt, v > 0.5 ? "GATE" : "ENV");
  ) : i == P_LFOMODE ? (
    strcpy(#vt, v > 0.5 ? "MANUAL" : "AUTO");
  ) : i == P_ARPMODE ? (
    st = floor(v + 0.5); strcpy(#vt, st == 0 ? "UP" : st == 1 ? "UP & DOWN" : "DOWN");
  ) : i == P_ARPRANGE ? (
    sprintf(#vt, "%d OCT", floor(v + 0.5) + 1);
  ) : i == P_PORTAMODE ? (
    st = floor(v + 0.5); strcpy(#vt, st == 0 ? "MONO" : st == 1 ? "POLY 1" : "POLY 2");
  ) : i == P_ADSRMODE ? (
    strcpy(#vt, v > 0.5 ? "106" : "60");
  ) : (
    sprintf(#vt, "%d%%", floor(v * 100 + 0.5));
  );
  #vt;
);

function hint(name, i) ( hov_name = name; hov_param = i; );

// ---------------------------------------------------------------- widgets
function scale_ticks(cx, y, h, n) local(k, ty)
(
  k = 0;
  loop(n + 1,
    ty = y + h - h * k / n;
    gca(200, 200, 204, 0.75);
    ln(cx - 22, ty, cx - 14, ty);
    k += 1;
  );
  n == 10 ? (
    fnt(9, 0); gc(170, 170, 175);
    tr(cx - 24, y, "10"); tr(cx - 24, y + h * 0.5, "5"); tr(cx - 24, y + h, "0");
  );
);

function fader(cx, y, h, p, label, steps) local(v, cy, n)
(
  v = pv(p);
  n = steps > 0 ? steps : 10;
  steps > 0 ? v = v / steps;
  fnt(12, 1); gc(236, 236, 236); tc(cx, y - 20, label);
  scale_ticks(cx, y, h, n);
  gc(10, 10, 12); rf(cx - 3.5, y - 6, 7, h + 12);
  gc(74, 74, 80); rf(cx - 0.5, y - 5, 1, h + 10);
  cy = y + h - v * h;
  gca(0, 0, 0, 0.45); rf(cx - 12, cy - 6, 26, 16);
  gc(10, 10, 11); rf(cx - 13, cy - 8, 26, 16);
  gc(56, 56, 60); rf(cx - 13, cy - 8, 26, 3);
  gc(28, 28, 30); rf(cx - 13, cy + 5, 26, 3);
  gc(244, 244, 244); rf(cx - 11, cy - 1, 22, 2);
  ct_add(cx - 16, y - 10, 32, h + 20, 1, p, steps, h);
  (mxv >= cx - 16 && mxv < cx + 16 && myv >= y - 10 && myv < y + h + 10) ? hint(label, p);
);

function vswitch(cx, y, n, p, l0, l1, l2, label, map) local(v, k, py, pos)
(
  v = floor(pv(p) + 0.5);
  pos = map == 3 ? v : n - 1 - v;
  fnt(12, 1); gc(236, 236, 236); label != 0 ? tc(cx + 12, y - 20, label);
  gc(8, 8, 10); rf(cx - 7, y - 4, 14, (n - 1) * 20 + 22);
  gc(30, 30, 33); rf(cx - 5, y - 2, 10, (n - 1) * 20 + 18);
  py = y + pos * 20;
  gc(232, 232, 232); rf(cx - 5, py, 10, 14);
  gc(150, 150, 154); rf(cx - 5, py + 11, 10, 3);
  fnt(10, 1); gc(220, 220, 224);
  k = 0;
  loop(n, tl(cx + 12, y + 7 + k * 20, k == 0 ? l0 : k == 1 ? l1 : l2); k += 1;);
  ct_add(cx - 10, y - 6, 56, n * 20 + 8, 2, p, n, map);
  (mxv >= cx - 10 && mxv < cx + 46 && myv >= y - 6 && myv < y + n * 20 + 2) ? hint(p == P_PWMMODE ? "PWM MODE" : p == P_VCFINV ? "ENV POLARITY" : p == P_VCAMODE ? "VCA MODE" :
    p == P_LFOMODE ? "LFO TRIG" : p == P_ARPMODE ? "ARP MODE" : p == P_ARPRANGE ? "ARP RANGE" : p == P_POWER ? "POWER" : label, p);
);

function led(x, y, on)
(
  on && pwr_on ? (gca(255, 60, 40, 0.3); circ(x, y, 7, 1); gc(255, 64, 44); circ(x, y, 4, 1); gc(255, 196, 176); circ(x - 1, y - 1, 1.3, 1);) :
       (gc(64, 18, 16); circ(x, y, 4, 1); gc(30, 8, 8); circ(x, y, 4, 0););
);

function button(x, y, w, kind, on, lit) local(r, g, b)
(
  kind == 0 ? (r = 234; g = 124; b = 40;) : kind == 1 ? (r = 224; g = 216; b = 178;) :
  kind == 2 ? (r = 108; g = 150; b = 152;) : kind == 4 ? (r = 222; g = 190; b = 60;) : (r = 168; g = 168; b = 172;);
  gc(8, 8, 10); rf(x - 1.5, y - 1.5, w + 3, 27);
  gc(r * 0.72, g * 0.72, b * 0.72); rf(x, y, w, 24);
  gc(r, g, b); rf(x, y, w, on ? 22 : 20.5);
  gca(255, 255, 255, 0.22); rf(x + 1.5, y + 1.5, w - 3, 3);
  gca(0, 0, 0, 0.12); rf(x + 1.5, y + 14, w - 3, on ? 8 : 6.5);
  lit >= 0 ? led(x + w * 0.5, y - 12, lit);
);

function pbutton(x, y, w, kind, p, label) local(on)
(
  on = pv(p) > 0.5;
  button(x, y, w, kind, on, on);
  fnt(10, 1); gc(232, 232, 232); label != 0 ? tc(x + w * 0.5, y + 37, label);
  ct_add(x - 3, y - 18, w + 6, 46, 3, p, 0, 0);
  (mxv >= x - 3 && mxv < x + w + 3 && myv >= y - 18 && myv < y + 28) ? hint(label != 0 ? label : "", p);
);

function rbutton(x, y, w, kind, p, val, label) local(on)
(
  on = floor(pv(p) + 0.5) == val;
  button(x, y, w, kind, on, on);
  fnt(10, 1); gc(232, 232, 232); label != 0 ? tc(x + w * 0.5, y + 37, label);
  ct_add(x - 3, y - 18, w + 6, 46, 4, p, val, 0);
);

function abutton(x, y, w, kind, id, lit, label)
(
  button(x, y, w, kind, 0, lit);
  fnt(10, 1); gc(232, 232, 232); label != 0 ? tc(x + w * 0.5, y + 37, label);
  ct_add(x - 3, y - 18, w + 6, 46, 8, -1, id, 0);
);

function knob(cx, cy, r, p, lo, hi, label) local(v, a, k, t)
(
  v = (pv(p) - lo) / (hi - lo);
  gca(200, 200, 204, 0.7);
  k = 0;
  loop(11,
    t = -2.35 + 4.7 * k / 10;
    ln(cx + sin(t) * (r + 4), cy - cos(t) * (r + 4), cx + sin(t) * (r + 9), cy - cos(t) * (r + 9));
    k += 1;
  );
  gc(6, 6, 7); circ(cx, cy, r, 1);
  gc(42, 42, 46); circ(cx, cy, r * 0.84, 1);
  gc(24, 24, 26); circ(cx, cy, r * 0.72, 1);
  a = -2.35 + 4.7 * v;
  gc(240, 240, 240);
  k = -1;
  loop(3,
    gfx_line(X(cx + sin(a) * r * 0.2) + k, Y(cy - cos(a) * r * 0.2), X(cx + sin(a) * r * 0.82) + k, Y(cy - cos(a) * r * 0.82), 1);
    k += 1;
  );
  fnt(12, 1); gc(236, 236, 236); tc(cx, cy - r - 20, label);
  ct_add(cx - r - 8, cy - r - 8, 2 * r + 16, 2 * r + 16, 5, p, lo, hi);
  (mxv >= cx - r - 8 && mxv < cx + r + 8 && myv >= cy - r - 8 && myv < cy + r + 8) ? hint(label, p);
);

function seg7(x, y, d) local(s, k, w, h)
(
  w = 18; h = 32;
  s = !pwr_on ? 0 : lamp_test ? 127 : d == 0 ? 63 : d == 1 ? 6 : d == 2 ? 91 : d == 3 ? 79 : d == 4 ? 102 : d == 5 ? 109 : d == 6 ? 125 : d == 7 ? 7 : d == 8 ? 127 : d == 9 ? 111 : d == 10 ? 64 : 0;
  k = 0;
  loop(7,
    (s & (2 ^ k)) ? gc(255, 46, 36) : gc(56, 14, 12);
    k == 0 ? rf(x + 3, y, w - 6, 3.2) :
    k == 1 ? rf(x + w - 3.2, y + 3, 3.2, h / 2 - 4) :
    k == 2 ? rf(x + w - 3.2, y + h / 2 + 1, 3.2, h / 2 - 4) :
    k == 3 ? rf(x + 3, y + h - 3.2, w - 6, 3.2) :
    k == 4 ? rf(x, y + h / 2 + 1, 3.2, h / 2 - 4) :
    k == 5 ? rf(x, y + 3, 3.2, h / 2 - 4) :
    rf(x + 3, y + h / 2 - 1.6, w - 6, 3.2);
    k += 1;
  );
);


// ---------------------------------------------------------------- keyboard
KB_X0 = 360; KB_X1 = 1380; KB_Y0 = 556; KB_Y1 = 762; KB_LO = 36; KB_N = 61;

function is_black(n) local(m) ( m = n % 12; m == 1 || m == 3 || m == 6 || m == 8 || m == 10; );

function white_index(n) local(o, m) ( o = floor(n / 12); m = n % 12; o * 7 + (m >= 5 ? (m + 1) / 2 : m / 2) - floor(KB_LO / 12) * 7; );

function key_lit(n) local(i, r)
(
  r = KBDHELD[n] || ui_key == n;
  i = 0; loop(n_active, VNOTE[i] == n ? r = 1; i += 1;);
  porta_mode == 0 && uni_note == n ? r = 1;
  r;
);

function draw_keyboard() local(ww, n, wi, bw, bh, lit, kx, kw, ky, kh, bx, bwp, bhp, kg, c)
(
  ww = (KB_X1 - KB_X0) / 36;
  gc(8, 8, 9); rf(KB_X0 - 4, KB_Y0 - 4, KB_X1 - KB_X0 + 8, KB_Y1 - KB_Y0 + 6);
  gc(176, 32, 42); rf(KB_X0 - 4, KB_Y0 - 4, KB_X1 - KB_X0 + 8, 4);
  ky = floor(Y(KB_Y0)); kh = floor(Y(KB_Y1)) - ky;
  kg = max(1, floor(sc));
  n = KB_LO; wi = 0;
  loop(KB_N,
    !is_black(n) ? (
      kx = floor(X(KB_X0 + wi * ww)) + kg;
      kw = floor(X(KB_X0 + (wi + 1) * ww)) - kx;
      lit = key_lit(n);
      c = lit ? 0 : 1;
      lit ? gfx_gradrect(kx, ky, kw, kh, 0.97, 0.74, 0.55, 1, 0, 0, 0, 0, -0.15 / kh, -0.15 / kh, -0.15 / kh, 0) :
            gfx_gradrect(kx, ky, kw, kh, 0.86, 0.855, 0.83, 1, 0, 0, 0, 0, 0.11 / kh, 0.11 / kh, 0.11 / kh, 0);
      gfx_set(0, 0, 0, 0.18); gfx_rect(kx, ky, kw, max(1, floor(3 * sc)), 1);
      gfx_set(0, 0, 0, 0.12); gfx_rect(kx, ky + kh - floor(6 * sc), kw, floor(6 * sc), 1);
      n % 12 == 0 ? (fnt(10, 1); gc(120, 120, 124); sprintf(#kl, "C%d", floor(n / 12) - 1); tc(KB_X0 + (wi + 0.5) * ww, KB_Y1 - 18, #kl););
      wi += 1;
    );
    n += 1;
  );
  bw = ww * 0.6; bh = (KB_Y1 - KB_Y0) * 0.62;
  bwp = floor(bw * sc); bhp = floor(bh * sc);
  n = 60 + floor(pv(P_TRANSOFS) + 0.5);
  (n != 60 && n >= KB_LO && n < KB_LO + KB_N) ? (
    c = is_black(n) ? KB_X0 + (floor(white_index(n - 1) + 0.01) + 1) * ww : KB_X0 + (floor(white_index(n) + 0.01) + 0.5) * ww;
    pv(P_TRANSPOSE) > 0.5 ? gc(255, 200, 80) : gc(255, 56, 140);
    gfx_triangle(X(c - 7), Y(KB_Y0 - 10), X(c + 7), Y(KB_Y0 - 10), X(c), Y(KB_Y0 - 2));
  );
  n = KB_LO; wi = 0;
  loop(KB_N,
    is_black(n) ? (
      bx = floor(X(KB_X0 + wi * ww - bw * 0.5)) + floor(kg * 0.5);
      lit = key_lit(n);
      gfx_set(0, 0, 0, 0.35); gfx_rect(bx + kg, ky, bwp, bhp + 2 * kg, 1);
      lit ? gfx_gradrect(bx, ky, bwp, bhp, 0.82, 0.46, 0.24, 1, 0, 0, 0, 0, 0.1 / bhp, 0.1 / bhp, 0.1 / bhp, 0) : (
        gfx_gradrect(bx, ky, bwp, bhp, 0.07, 0.07, 0.08, 1, 0, 0, 0, 0, 0.1 / bhp, 0.1 / bhp, 0.1 / bhp, 0);
        gfx_set(1, 1, 1, 0.10); gfx_rect(bx + 2 * kg, ky + bhp - floor(9 * sc), bwp - 4 * kg, floor(6 * sc), 1);
      );
    );
    !is_black(n) ? wi += 1;
    n += 1;
  );
);

function key_at(mx, my) local(ww, wi, n, bw, bh, x, r)
(
  r = -1;
  (mx >= KB_X0 && mx < KB_X1 && my >= KB_Y0 && my < KB_Y1) ? (
    ww = (KB_X1 - KB_X0) / 36;
    bw = ww * 0.6; bh = (KB_Y1 - KB_Y0) * 0.62;
    my < KB_Y0 + bh ? (
      n = KB_LO;
      loop(KB_N,
        is_black(n) ? (
          wi = floor(white_index(n - 1) + 0.01);
          x = KB_X0 + (wi + 1) * ww - bw * 0.5;
          (mx >= x && mx < x + bw) ? r = n;
        );
        n += 1;
      );
    );
    r < 0 ? (
      wi = floor((mx - KB_X0) / ww);
      n = KB_LO;
      loop(KB_N, (!is_black(n) && floor(white_index(n) + 0.01) == wi) ? r = n; n += 1;);
    );
  );
  r;
);

// ---------------------------------------------------------------- menus
function preset_menu() local(g, b, k, abs, sel)
(
  #pm = "";
  g = 0;
  loop(2,
    b = 0;
    loop(8,
      sprintf(#pt, ">%s%d", g == 0 ? "A" : "B", b + 1);
      strcat(#pm, #pt); strcat(#pm, "|");
      k = 0;
      loop(8,
        abs = bank_offset() + g * 64 + b * 8 + k;
        sprintf(#pt, "%s%s%s", (!initial_default && cur_preset == g * 64 + b * 8 + k) ? "!" : "", k == 7 ? "<" : "", PNAMES[abs]);
        strcat(#pm, #pt); strcat(#pm, "|");
        k += 1;
      );
      b += 1;
    );
    g += 1;
  );
  gfx_x = mouse_x; gfx_y = mouse_y;
  sel = gfx_showmenu(#pm);
  sel > 0 ? (req_preset = sel - 1; req_preset_on = 1;);
);

function settings_menu() local(sel, v, os)
(
  v = floor(pv(P_VOICES) + 0.5);
  os = floor(pv(P_OVERSAMPLE) + 0.5);
  #sm = "";
  sprintf(#st, ">Voices|%s6|%s8|<%s10|", v <= 7 ? "!" : "", v == 8 ? "!" : "", v >= 9 ? "!" : ""); strcat(#sm, #st);
  sprintf(#st, ">VCF oversampling|%sOff (1x)|%s2x|<%s4x|", os <= 1 ? "!" : "", (os == 2 || os == 3) ? "!" : "", os >= 4 ? "!" : ""); strcat(#sm, #st);
  sprintf(#st, ">Oscillator|%sWavetable|<%sPolyBLEP|", pv(P_OSCMODE) < 0.5 ? "!" : "", pv(P_OSCMODE) >= 0.5 ? "!" : ""); strcat(#sm, #st);
  sprintf(#st, "%sIgnore velocity|", pv(P_IGNOREVEL) > 0.5 ? "!" : ""); strcat(#sm, #st);
  sprintf(#st, "%sMono retrigger|", pv(P_MONORETRIG) > 0.5 ? "!" : ""); strcat(#sm, #st);
  sprintf(#st, "%sArpeggio limited to keyboard range|", pv(P_ARPLIMIT) > 0.5 ? "!" : ""); strcat(#sm, #st);
  sprintf(#st, "%sArpeggio synced to host tempo|", pv(P_ARPSYNC) > 0.5 ? "!" : ""); strcat(#sm, #st);
  sprintf(#st, "%sLFO synced to host tempo|", pv(P_LFOSYNC) > 0.5 ? "!" : ""); strcat(#sm, #st);
  sprintf(#st, ">MIDI out|%sControl changes|<%sJuno SysEx (IPR/APR)|", pv(P_MIDISYSEX) < 0.5 ? "!" : "", pv(P_MIDISYSEX) >= 0.5 ? "!" : ""); strcat(#sm, #st);
  sprintf(#st, ">Calibration|%sPerfect (no component tolerances)|%sHuman tune (well-maintained unit)|%sOut of tune (neglected vintage unit)|",
    calib_state == 1 ? "!" : "", calib_state == 2 ? "!" : "", calib_state == 3 ? "!" : ""); strcat(#sm, #st);
  sprintf(#st, "<Drift: %d%%|", floor(drift_amt * 100 + 0.5)); strcat(#sm, #st);
  sprintf(#st, ">Analog noise|%sOff|%sQuiet|%sHardware|<%sNoisy|", k_analog <= 0 ? "!" : "",
    (k_analog > 0 && k_analog < 0.45) ? "!" : "", (k_analog >= 0.45 && k_analog < 0.6) ? "!" : "", k_analog >= 0.6 ? "!" : "");
  strcat(#sm, #st);
  sprintf(#st, "%sEco mode (skip silent voices)|", eco_mode ? "!" : ""); strcat(#sm, #st);
  sprintf(#st, "%sOutput soft clip|", soft_clip ? "!" : ""); strcat(#sm, #st);
  gfx_x = mouse_x; gfx_y = mouse_y;
  sel = gfx_showmenu(#sm);
  sel == 1 ? ui_tap(P_VOICES, 6) : sel == 2 ? ui_tap(P_VOICES, 8) : sel == 3 ? ui_tap(P_VOICES, 10) :
  sel == 4 ? ui_tap(P_OVERSAMPLE, 1) : sel == 5 ? ui_tap(P_OVERSAMPLE, 2) : sel == 6 ? ui_tap(P_OVERSAMPLE, 4) :
  sel == 7 ? ui_tap(P_OSCMODE, 0) : sel == 8 ? ui_tap(P_OSCMODE, 1) :
  sel == 9 ? ui_tap(P_IGNOREVEL, pv(P_IGNOREVEL) > 0.5 ? 0 : 1) :
  sel == 10 ? ui_tap(P_MONORETRIG, pv(P_MONORETRIG) > 0.5 ? 0 : 1) :
  sel == 11 ? ui_tap(P_ARPLIMIT, pv(P_ARPLIMIT) > 0.5 ? 0 : 1) :
  sel == 12 ? ui_tap(P_ARPSYNC, pv(P_ARPSYNC) > 0.5 ? 0 : 1) :
  sel == 13 ? ui_tap(P_LFOSYNC, pv(P_LFOSYNC) > 0.5 ? 0 : 1) :
  sel == 14 ? ui_tap(P_MIDISYSEX, 0) : sel == 15 ? ui_tap(P_MIDISYSEX, 1) :
  sel == 16 ? req_tune = 1 : sel == 17 ? req_tune = 2 : sel == 18 ? req_tune = 3 :
  sel == 19 ? (gfx_x = mouse_x; gfx_y = mouse_y;
    v = gfx_showmenu("0% (robot)|25% (recently calibrated)|50%|75% (drifted classic)|100% (uncalibrated)");
    v > 0 ? (req_drift = (v - 1) * 0.25; req_drift_on = 1;);) :
  sel >= 20 && sel <= 23 ? (req_noise = sel == 20 ? 0 : sel == 21 ? 0.3 : sel == 22 ? 0.5 : 0.65; req_noise_on = 1;) :
  sel == 24 ? (eco_mode = !eco_mode; automate(58, 0); automate(58, 1);) :
  sel == 25 ? (soft_clip = !soft_clip; automate(59, 0); automate(59, 1););
);

function sync_menu(isArp) local(sel, d, k)
(
  #dm = "";
  d = floor(pv(isArp ? P_ARPQUANT : P_LFOQUANT) + 0.5);
  sprintf(#st, "%sFollow host tempo|", pv(isArp ? P_ARPSYNC : P_LFOSYNC) > 0.5 ? "!" : ""); strcat(#dm, #st);
  strcat(#dm, "|");
  k = 0;
  loop(isArp ? 9 : 13,
    sprintf(#st, "%s%s|", k == d ? "!" : "",
      isArp ? (k == 0 ? "4 beats" : k == 1 ? "2 beats" : k == 2 ? "1/4" : k == 3 ? "1/4 triplet" : k == 4 ? "1/8" : k == 5 ? "1/8 triplet" : k == 6 ? "1/16" : k == 7 ? "1/16 triplet" : "1/32")
            : (k == 0 ? "24 beats" : k == 1 ? "16 beats" : k == 2 ? "8 beats" : k == 3 ? "4 beats" : k == 4 ? "2 beats" : k == 5 ? "1/4" : k == 6 ? "1/4 triplet" : k == 7 ? "1/8" : k == 8 ? "1/8 triplet" : k == 9 ? "1/16" : k == 10 ? "1/16 triplet" : k == 11 ? "1/32" : "1/64"));
    strcat(#dm, #st);
    k += 1;
  );
  gfx_x = mouse_x; gfx_y = mouse_y;
  sel = gfx_showmenu(#dm);
  sel == 1 ? ui_tap(isArp ? P_ARPSYNC : P_LFOSYNC, pv(isArp ? P_ARPSYNC : P_LFOSYNC) > 0.5 ? 0 : 1) :
  sel >= 2 ? (ui_tap(isArp ? P_ARPQUANT : P_LFOQUANT, sel - 2); ui_tap(isArp ? P_ARPSYNC : P_LFOSYNC, 1););
);

// ---------------------------------------------------------------- panel
function section(x0, x1, y0, y1, name, blue)
(
  gc(62, 62, 67); rf(x0, y0, x1 - x0, y1 - y0);
  blue ? gc(52, 98, 180) : gc(176, 32, 42); rf(x0, y0, x1 - x0, 26);
  fnt(16, 1); gc(250, 250, 250); tc((x0 + x1) * 0.5, y0 + 13.5, name);
  blue ? gc(52, 98, 180) : gc(176, 32, 42); rf(x0, y1 - 4, x1 - x0, 4);
  gc(26, 26, 29); rf(x1 - 1, y0, 2, y1 - y0);
);

function topbox(x, y, w, h, s, on, id)
(
  on ? gc(92, 92, 98) : gc(54, 54, 58); rf(x, y, w, h);
  gca(255, 255, 255, 0.07); rf(x, y, w, 2);
  fnt(14, 0); on ? gc(250, 250, 250) : gc(200, 200, 204); tc(x + w * 0.5, y + h * 0.5, s);
  ct_add(x, y, w, h, 8, -1, id, 0);
);

function capbutton(x, y, w, kind, lit, s, id)
(
  button(x, y, w, kind, 0, lit);
  fnt(11, 1); gc(30, 30, 32); tc(x + w * 0.5, y + 10.5, s);
  ct_add(x - 3, y - 18, w + 6, 44, 8, -1, id, 0);
);

function patch_name(s) local(abs)
(
  abs = cur_preset + bank_offset();
  initial_default ? strcpy(s, "Manual") : sprintf(s, "%s%s", PNAMES[abs], preset_dirty_ui ? " *" : "");
  s;
);

function fntf(face, size, flags) ( gfx_setfont(2, face, max(6, size * sc), flags); );

function title_stripes(x, w, y0, y1, n) local(k, yy)
(
  gc(30, 30, 33);
  k = 0;
  loop(n, yy = y0 + (y1 - y0) * k / n; rf(x, yy, w, (y1 - y0) / n * (0.3 + 0.5 * k / n)); k += 1;);
);

function draw_title() local(w, h)
(
  fntf("Arial", 44, 'b');
  gfx_measurestr("SIX APPEAL", w, h);
  gc(232, 232, 236); tl(22, 29, "SIX APPEAL");
  gc(214, 38, 50); tl(22, 29, "SIX");
  title_stripes(18, w / sc + 8, 31, 46, 5);
);

function draw_panel() local(i, a, d1, d2)
(
  gc(44, 44, 48); rf(0, 0, VW, VH);
  gc(30, 30, 33); rf(0, 0, VW, 58);

  draw_title();

  gc(54, 54, 58); rf(430, 10, 480, 38);
  fnt(18, 1); gc(240, 240, 240); tc(670, 29, patch_name(#pn));
  fnt(16, 1); gc(200, 200, 204); tc(452, 29, "<"); tc(888, 29, ">");
  ct_add(430, 10, 44, 38, 8, -1, 80, 0);
  ct_add(866, 10, 44, 38, 8, -1, 81, 0);
  ct_add(474, 10, 392, 38, 8, -1, 71, 0);

  fnt(11, 1); gc(170, 170, 175); tc(964, 29, "ENGINE");
  topbox(1000, 10, 50, 38, "60", pv(P_ADSRMODE) < 0.5, 90);
  topbox(1054, 10, 56, 38, "106", pv(P_ADSRMODE) >= 0.5, 91);
  sprintf(#st, "%d VOICES  %s  %s", floor(pv(P_VOICES) + 0.5),
    pv(P_OVERSAMPLE) < 1.5 ? "1X" : pv(P_OVERSAMPLE) < 3.5 ? "2X" : "4X", pv(P_OSCMODE) > 0.5 ? "BLEP" : "WAVE");
  topbox(1124, 10, 170, 38, #st, 0, 20);
  topbox(1300, 10, 80, 38, "SETUP", 0, 21);

  section(20, 560, 66, 310, "DCO", 0);
  section(560, 630, 66, 310, "HPF", 0);
  section(630, 944, 66, 310, "VCF", 0);
  section(944, 1058, 66, 310, "VCA", 0);
  section(1058, 1270, 66, 310, "ENV", 0);
  section(1270, 1380, 66, 310, "CHORUS", 0);

  fnt(12, 1); gc(236, 236, 236); tc(93, 126, "RANGE");
  rbutton(42, 200, 30, 3, P_OCT, 0, "16'");
  rbutton(78, 200, 30, 3, P_OCT, 1, "8'");
  rbutton(114, 200, 30, 3, P_OCT, 2, "4'");
  fader(190, 146, 140, P_DCOLFO, "LFO", 0);
  fader(240, 146, 140, P_DCOPWM, "PWM", 0);
  vswitch(278, 186, 3, P_PWMMODE, "LFO", "MAN", "ENV", 0, 3);
  fnt(12, 1); gc(236, 236, 236); tc(384, 126, "WAVE");
  pbutton(342, 200, 30, 3, P_PULSE, "PULSE");
  pbutton(378, 200, 30, 4, P_SAW, "SAW");
  pbutton(414, 200, 30, 0, P_SUBSW, "SUB");
  fader(490, 146, 140, P_DCOSUB, "SUB OSC", 0);
  fader(536, 146, 140, P_DCONOISE, "NOISE", 0);

  fader(595, 146, 140, P_HPF, "FREQ", 3);

  fader(672, 146, 140, P_VCFFREQ, "FREQ", 0);
  fader(722, 146, 140, P_VCFRES, "RES", 0);
  vswitch(758, 196, 2, P_VCFINV, "+", "-", 0, "ENV", 3);
  fader(816, 146, 140, P_VCFENV, "ENV", 0);
  fader(864, 146, 140, P_VCFLFO, "LFO", 0);
  fader(912, 146, 140, P_VCFKBD, "KYBD", 0);

  vswitch(966, 196, 2, P_VCAMODE, "ENV", "GATE", 0, "MODE", 3);
  fader(1028, 146, 140, P_VCALEVEL, "LEVEL", 0);

  fader(1092, 146, 140, P_ENVA, "A", 0);
  fader(1142, 146, 140, P_ENVD, "D", 0);
  fader(1192, 146, 140, P_ENVS, "S", 0);
  fader(1242, 146, 140, P_ENVR, "R", 0);

  i = (pv(P_CHI) < 0.5 && pv(P_CHII) < 0.5);
  button(1300, 132, 40, 1, i, -1);
  fnt(12, 1); gc(236, 236, 236); tl(1350, 144, "OFF");
  ct_add(1280, 124, 96, 40, 8, -1, 10, 0);
  (mxv >= 1280 && mxv < 1376 && myv >= 124 && myv < 164) ? hint("CHORUS OFF", P_CHOFF);
  a = pv(P_CHI) > 0.5;
  led(1288, 202, a); button(1300, 190, 40, 4, a, -1);
  fnt(12, 1); gc(236, 236, 236); tl(1350, 202, "I");
  ct_add(1280, 182, 96, 40, 3, P_CHI, 0, 0);
  (mxv >= 1280 && mxv < 1376 && myv >= 182 && myv < 222) ? hint("CHORUS I", P_CHI);
  a = pv(P_CHII) > 0.5;
  led(1288, 260, a); button(1300, 248, 40, 0, a, -1);
  fnt(12, 1); gc(236, 236, 236); tl(1350, 260, "II");
  ct_add(1280, 240, 96, 40, 3, P_CHII, 0, 0);
  (mxv >= 1280 && mxv < 1376 && myv >= 240 && myv < 280) ? hint("CHORUS II", P_CHII);

  gc(62, 62, 67); rf(20, 404, 330, 138);
  gc(52, 98, 180); rf(20, 538, 330, 4);
  fnt(10, 1); gc(220, 220, 224); tc(51, 416, "GROUP");
  gc(52, 98, 180); rf(94, 410, 252, 12);
  fnt(10, 1); gc(245, 245, 245); tc(220, 416, "BANK");
  capbutton(26, 444, 26, 1, ui_group == 0, "A", 40);
  capbutton(56, 444, 26, 1, ui_group == 1, "B", 41);
  i = 0;
  loop(8,
    sprintf(#st, "%d", i + 1);
    capbutton(96 + i * 31.5, 444, 26, 2, ui_bank == i, #st, 50 + i);
    i += 1;
  );
  gc(20, 6, 6); rf(26, 488, 56, 42);
  initial_default ? (seg7(32, 493, 10); seg7(58, 493, 10);) : (
    d1 = floor((cur_preset % 64) / 8) + 1; d2 = (cur_preset % 8) + 1;
    seg7(32, 493, d1); seg7(58, 493, d2);
  );
  gc(52, 98, 180); rf(94, 476, 252, 12);
  fnt(10, 1); gc(245, 245, 245); tc(220, 482, "PATCH NUMBER");
  i = 0;
  loop(8,
    a = !initial_default && cur_preset == ui_group * 64 + ui_bank * 8 + i;
    sprintf(#st, "%d", i + 1);
    capbutton(96 + i * 31.5, 508, 26, 2, a, #st, 60 + i);
    i += 1;
  );

  section(360, 560, 322, 542, "LFO", 0);
  fader(404, 400, 110, P_LFORATE, "RATE", 0);
  fader(456, 400, 110, P_LFODELAY, "DELAY", 0);
  vswitch(494, 430, 2, P_LFOMODE, "AUTO", "MAN", 0, "TRIG", 3);
  fnt(9, 1); pv(P_LFOSYNC) > 0.5 ? gc(120, 200, 255) : gc(140, 140, 146); tc(404, 528, pv(P_LFOSYNC) > 0.5 ? "SYNC ON" : "SYNC");
  ct_add(384, 520, 40, 16, 8, -1, 31, 0);

  section(560, 842, 322, 542, "ARPEGGIO", 0);
  a = pv(P_ARP) > 0.5;
  button(584, 440, 32, 0, a, a ? ((arp_ticks % 2) == 0) : 0);
  fnt(12, 1); gc(236, 236, 236); tc(600, 380, "ON");
  ct_add(580, 420, 40, 48, 3, P_ARP, 0, 0);
  (mxv >= 580 && mxv < 620 && myv >= 420 && myv < 468) ? hint("ARPEGGIO", P_ARP);
  vswitch(650, 420, 3, P_ARPMODE, "UP", "U&D", "DOWN", "MODE", 3);
  vswitch(728, 420, 3, P_ARPRANGE, "3", "2", "1", "RANGE", 0);
  fader(800, 400, 110, P_ARPRATE, "RATE", 0);
  fnt(9, 1); pv(P_ARPSYNC) > 0.5 ? gc(120, 200, 255) : gc(140, 140, 146); tc(800, 528, pv(P_ARPSYNC) > 0.5 ? "SYNC ON" : "SYNC");
  ct_add(780, 520, 40, 16, 8, -1, 30, 0);

  section(842, 1112, 322, 542, "KEY ASSIGN", 0);
  rbutton(862, 400, 32, 0, P_PORTAMODE, 1, "POLY 1");
  rbutton(908, 400, 32, 0, P_PORTAMODE, 2, "POLY 2");
  rbutton(954, 400, 32, 4, P_PORTAMODE, 0, "MONO");
  pbutton(862, 474, 32, 1, P_TRANSPOSE, "TRANSPOSE");
  pbutton(926, 474, 32, 1, P_HOLD, "HOLD");
  fader(1062, 400, 110, P_PORTARATE, "PORTA", 0);

  section(1112, 1380, 322, 542, "CONTROL", 1);
  fnt(10, 1); gc(200, 200, 204); tc(1200, 362, "BENDER SENSITIVITY");
  fader(1152, 400, 110, P_BENDDCO, "DCO", 0);
  fader(1200, 400, 110, P_BENDVCF, "VCF", 0);
  fader(1248, 400, 110, P_BENDLFO, "LFO", 0);
  knob(1330, 400, 20, P_MASTER, 0, 1, "VOLUME");
  led(1366, 368, time_precise() - clip_t < 0.4 && clip_t > 0);
  fnt(8, 1); gc(200, 200, 204); tc(1366, 356, "CLIP");
  knob(1330, 486, 20, P_TUNING, -1, 1, "TUNE");
);

function draw_display() local(el, nd)
(
  gc(16, 4, 4); rf(20, 322, 330, 78);
  el = time_precise() - pwr_msg_t;
  nd = floor(el * 4) % 4;
  strcpy(#dots, nd == 0 ? "" : nd == 1 ? "." : nd == 2 ? ".." : "...");
  pwr_msg_kind == 1 && el < 1.5 ? (
    gca(255, 40, 30, 0.07); rf(22, 324, 326, 74);
    fnt(22, 1); gc(255, 74, 52); tc(185, 346, "SIX APPEAL");
    fnt(13, 1); gc(230, 80, 60); sprintf(#st, "STARTING UP%s", #dots); tl(132, 376, #st);
    ct_add(20, 322, 330, 78, 8, -1, 70, 0);
  ) : pwr_msg_kind == 2 && el < 1.2 ? (
    gca(255, 40, 30, 0.04); rf(22, 324, 326, 74);
    fnt(13, 1); gc(230 * (1.2 - el) / 1.2 + 25, 70 * (1.2 - el) / 1.2 + 6, 50 * (1.2 - el) / 1.2 + 4);
    sprintf(#st, "SHUTTING DOWN%s", #dots); tl(116, 361, #st);
    ct_add(20, 322, 330, 78, 8, -1, 70, 0);
  ) : !pwr_on ? (ct_add(20, 322, 330, 78, 8, -1, 70, 0); 0;) : (
  gca(255, 40, 30, 0.07); rf(22, 324, 326, 74);
  fnt(18, 1); gc(255, 74, 52); tl(32, 340, patch_name(#pn));
  hov_param >= 0 ? (
    fnt(13, 1); gc(230, 80, 60); tl(32, 368, hov_name);
    fnt(16, 1); gc(255, 120, 90); tr(340, 368, fmt_param(hov_param, pv(hov_param)));
  ) : (
    fnt(12, 0); gc(200, 70, 60);
    sprintf(#st, "%s BANK  %s%d%d", pv(P_ADSRMODE) > 0.5 ? "106" : "60", cur_preset < 64 ? "A" : "B",
      floor((cur_preset % 64) / 8) + 1, cur_preset % 8 + 1);
    tl(32, 368, #st);
  );
  fnt(10, 0); gc(150, 60, 52); tl(32, 389, "CLICK FOR PATCH LIST");
  ct_add(20, 322, 330, 78, 8, -1, 70, 0);
  );
);

function draw_performance() local(lt)
(
  gc(62, 62, 67); rf(20, 552, 330, 210);
  gc(176, 32, 42); rf(20, 552, 330, 4);
  vswitch(44, 600, 2, P_POWER, "ON", "OFF", 0, "POWER", 0);
  lt = lfo_trig_ui || g_bmod > 0;
  fnt(12, 1); gc(236, 236, 236); tc(210, 580, "BENDER");
  fnt(9, 1); gc(200, 200, 204); tc(318, 580, "LFO"); led(318, 596, lt);
  gc(8, 8, 10); rf(110, 618, 200, 50);
  gc(30, 30, 33); rf(116, 624, 188, 38);
  gca(255, 255, 255, 0.12); ln(210, 626, 210, 660);
  bend_x = 210 + pv(P_BENDER) * 80;
  gca(0, 0, 0, 0.45); rf(bend_x - 13, 614 - bend_up * 10, 30, 62);
  gc(8, 8, 9); rf(bend_x - 15, 610 - bend_up * 10, 30, 60);
  gc(54, 54, 58); rf(bend_x - 13, 612 - bend_up * 10, 26, 5);
  gc(230, 230, 230); rf(bend_x - 1.5, 624 - bend_up * 10, 3, 34);
  ct_add(106, 600, 210, 80, 6, P_BENDER, 0, 0);
  (mxv >= 106 && mxv < 316 && myv >= 600 && myv < 680) ? hint("BENDER", P_BENDER);
  fnt(10, 0); gc(165, 165, 170); tc(210, 700, "DRAG SIDEWAYS TO BEND");
  tc(210, 716, "PUSH UP FOR LFO (MOD WHEEL)");
  fnt(9, 0); gc(130, 130, 136); tc(185, 748, "ULTRAMASTER KR-106 PORT BY CHMAHA");
);


// ---------------------------------------------------------------- computer keyboard
function qwerty_init() local(k, s1, s2)
(
  k = 0;
  loop(33,
    s1 = k == 0 ? 'z' : k == 1 ? 's' : k == 2 ? 'x' : k == 3 ? 'd' : k == 4 ? 'c' : k == 5 ? 'v' : k == 6 ? 'g' : k == 7 ? 'b' :
         k == 8 ? 'h' : k == 9 ? 'n' : k == 10 ? 'j' : k == 11 ? 'm' : k == 12 ? 'q' : k == 13 ? '2' : k == 14 ? 'w' : k == 15 ? '3' :
         k == 16 ? 'e' : k == 17 ? 'r' : k == 18 ? '5' : k == 19 ? 't' : k == 20 ? '6' : k == 21 ? 'y' : k == 22 ? '7' : k == 23 ? 'u' :
         k == 24 ? 'i' : k == 25 ? '9' : k == 26 ? 'o' : k == 27 ? '0' : k == 28 ? 'p' : k == 29 ? '[' : k == 30 ? '-' : k == 31 ? ']' : '=';
    s2 = k == 12 ? ',' : k == 13 ? 'l' : k == 14 ? '.' : k == 15 ? ';' : k == 16 ? '/' : k == 17 ? 39 : 0;
    QKEY1[k] = s1; QKEY2[k] = s2; QDOWN[k] = 0;
    k += 1;
  );
  qbase = 48;
);

function qwerty_release_all() local(k)
(
  k = 0;
  loop(33, QDOWN[k] ? (ui_q(128, qbase + k, 0); QDOWN[k] = 0;); k += 1;);
);

function qwerty_poll() local(c, k, d, n, step)
(
  c = gfx_getchar();
  while (c > 0) (
    step = c == 30064 ? -1 : c == 1685026670 ? 1 : c == 1885828464 ? -8 : c == 1885824110 ? 8 : 0;
    step != 0 ? (req_preset = ((initial_default ? 0 : cur_preset) + step + 128) % 128; req_preset_on = 1;) :
    c == 13 ? preset_menu() :
    c == '`' ? (qwerty_release_all(); qbase = max(0, qbase - 12);) :
    c == '1' ? (qwerty_release_all(); qbase = min(108, qbase + 12););
    c = gfx_getchar();
  );
  !(mouse_cap & 4) ? (
    k = 0;
    loop(33,
      d = gfx_getchar(QKEY1[k]) || (QKEY2[k] > 0 && gfx_getchar(QKEY2[k]));
      n = qbase + k;
      d && !QDOWN[k] && n <= 127 ? (
        QDOWN[k] = 1;
        (pv(P_HOLD) > 0.5 && KBDHELD[n]) ? (ui_q(1, n, 0); QDOWN[k] = 2;) : ui_q(144, n, 127);
      ) : !d && QDOWN[k] ? (
        QDOWN[k] == 1 ? ui_q(128, n, 0);
        QDOWN[k] = 0;
      );
      k += 1;
    );
  );
);

// ---------------------------------------------------------------- interaction
function act(id) local(d)
(
  id == 10 ? (ui_tap(P_CHI, 0); ui_tap(P_CHII, 0); ui_tap(P_CHOFF, 1);) :
  id == 20 || id == 21 ? settings_menu() :
  id == 30 ? sync_menu(1) : id == 31 ? sync_menu(0) :
  id == 40 ? ui_group = 0 : id == 41 ? ui_group = 1 :
  id >= 50 && id < 58 ? ui_bank = id - 50 :
  id >= 60 && id < 68 ? (req_preset = ui_group * 64 + ui_bank * 8 + id - 60; req_preset_on = 1;) :
  id == 70 || id == 71 ? preset_menu() :
  id == 80 ? (req_preset = (cur_preset + 127) % 128; req_preset_on = 1;) :
  id == 81 ? (req_preset = initial_default ? cur_preset : (cur_preset + 1) % 128; req_preset_on = 1;) :
  id == 90 ? ui_tap(P_ADSRMODE, 0) : id == 91 ? ui_tap(P_ADSRMODE, 1);
);

function drag_value(c, dyv, dypx, fine) local(p, v, lo, hi, rng)
(
  p = CTP[c];
  CTT[c] == 1 ? (
    CTA[c] > 0 ? (
      v = clampv(floor(drag_v0 + 0.5 + dyv / CTB[c] * CTA[c]), 0, CTA[c]);
    ) : v = clampv(drag_v0 + dyv / CTB[c] * (fine ? 0.1 : 1), 0, 1);
  ) : CTT[c] == 5 ? (
    lo = CTA[c]; hi = CTB[c]; rng = hi - lo;
    v = clampv(drag_v0 + dypx / 450 * rng * (fine ? 0.1 : 1), lo, hi);
  );
  v !== pv(p) ? ui_set(p, v);
);

function wheel_value(c, w) local(p, v, st)
(
  p = CTP[c];
  CTT[c] == 1 ? (
    v = CTA[c] > 0 ? clampv(floor(pv(p) + 0.5) + (w > 0 ? 1 : -1), 0, CTA[c]) : clampv(pv(p) + w * 0.01, 0, 1);
    ui_tap(p, v);
  ) : CTT[c] == 5 ? (
    ui_tap(p, clampv(pv(p) + w * 0.01 * (CTB[c] - CTA[c]), CTA[c], CTB[c]));
  ) : CTT[c] == 2 ? (
    st = floor(pv(p) + 0.5) + (w > 0 ? 1 : -1);
    ui_tap(p, clampv(st, 0, CTA[c] - 1));
  );
);

function switch_click(c, my) local(pos, n, map, v)
(
  n = CTA[c]; map = CTB[c];
  pos = clampv(floor((my - CTY[c] - 2) / 20), 0, n - 1);
  v = map == 3 ? pos : n - 1 - pos;
  ui_tap(CTP[c], v);
);

!gfx_inited ? (
  gfx_inited = 1;
  i = 0;
  loop(NPARAMS, DEFV[i] = slider(i + 1); i += 1;);
  DEFV[P_BENDDCO] = 0; DEFV[P_BENDVCF] = 0; DEFV[P_ARPRATE] = 0.234375; DEFV[P_LFORATE] = 0.24; DEFV[P_LFODELAY] = 0;
  DEFV[P_DCOLFO] = 0; DEFV[P_DCOPWM] = 0.5; DEFV[P_DCOSUB] = 1; DEFV[P_DCONOISE] = 0; DEFV[P_HPF] = 1; DEFV[P_VCFFREQ] = 1;
  DEFV[P_VCFRES] = 0; DEFV[P_VCFENV] = 0; DEFV[P_VCFLFO] = 0; DEFV[P_VCFKBD] = 0; DEFV[P_VCALEVEL] = 0.5;
  DEFV[P_ENVA] = 0.25; DEFV[P_ENVD] = 0.25; DEFV[P_ENVS] = 0.9; DEFV[P_ENVR] = 0.25; DEFV[P_BENDER] = 0; DEFV[P_TUNING] = 0;
  DEFV[P_PORTARATE] = 0; DEFV[P_BENDLFO] = 0; DEFV[P_MASTER] = 0.25;
  ui_key = -1; drag_c = -1;
  qwerty_init();
  ui_group = floor(cur_preset / 64); ui_bank = floor((cur_preset % 64) / 8);
);

sc = min(gfx_w / VW, gfx_h / VH);
gx0 = floor((gfx_w - VW * sc) * 0.5);
gy0 = 0;
mxv = (mouse_x - gx0) / sc;
myv = (mouse_y - gy0) / sc;
gc(20, 20, 22); gfx_rect(0, 0, gfx_w, gfx_h, 1);
nct = 0;
hov_param = -1;
shown_preset != cur_preset ? (shown_preset = cur_preset; ui_group = floor(cur_preset / 64); ui_bank = floor((cur_preset % 64) / 8););
time_precise() > dirty_t + 0.25 ? (dirty_t = time_precise(); preset_dirty_ui = preset_dirty(););
qwerty_poll();
clip_pk > 1 ? (clip_t = time_precise(); clip_pk = 0;) : clip_pk = 0;
pwr_on = pv(P_POWER) > 0.5;
!pwr_seen ? (pwr_seen = 1; pwr_prev = pwr_on; pwr_on ? (pwr_msg_kind = 1; pwr_msg_t = time_precise();););
pwr_on != pwr_prev ? (pwr_prev = pwr_on; pwr_msg_kind = pwr_on ? 1 : 2; pwr_msg_t = time_precise(););
lamp_test = pwr_msg_kind == 1 && time_precise() - pwr_msg_t < 0.7;
draw_panel();
draw_performance();
draw_keyboard();
drag_c >= 0 && hov_param < 0 && CTP[drag_c] >= 0 ? (hov_param = CTP[drag_c]; hov_name = drag_name;);
draw_display();

mdown = mouse_cap & 1;
fine = (mouse_cap & 4) || (mouse_cap & 8);
mdown && !last_mdown ? (
  c = ct_hit(mxv, myv);
  k = key_at(mxv, myv);
  dbl = time_precise() - last_click_t < 0.3 && c == last_click_c && c >= 0;
  last_click_t = time_precise(); last_click_c = c;
  c >= 0 ? (
    t = CTT[c]; p = CTP[c];
    t == 1 || t == 5 ? (
      dbl ? ui_tap(p, DEFV[p]) : (drag_c = c; drag_y0 = myv; drag_py0 = mouse_y; drag_v0 = pv(p); drag_name = hov_name;);
    ) : t == 2 ? switch_click(c, myv) :
    t == 3 ? ui_tap(p, pv(p) > 0.5 ? 0 : 1) :
    t == 4 ? ui_tap(p, CTA[c]) :
    t == 6 ? (drag_c = c; drag_x0 = mxv; drag_y0 = myv; drag_v0 = pv(p); bend_up = 0;) :
    t == 8 ? act(CTA[c]);
  ) : k >= 0 ? (
    pv(P_TRANSPOSE) > 0.5 ? (kb_trans = 1; ui_tap(P_TRANSOFS, clampv(k - 60, -24, 36));) :
    (pv(P_HOLD) > 0.5 && KBDHELD[k]) ? (ui_q(1, k, 0); kb_hold_rel = 1;) :
    (ui_key = k; ui_q(144, k, 100););
  );
);
mdown && last_mdown ? (
  drag_c >= 0 ? (
    CTT[drag_c] == 6 ? (
      ui_set(P_BENDER, clampv(drag_v0 + (mxv - drag_x0) / 80, -1, 1));
      nb = (drag_y0 - myv) > 12;
      nb != bend_up ? (bend_up = nb; ui_q(176, 1, nb ? 127 : 0););
    ) : (
      mouse_cap |= 65536;
      drag_value(drag_c, drag_y0 - myv, drag_py0 - mouse_y, fine);
    );
  ) : kb_trans ? (
    k = key_at(mxv, myv);
    k >= 0 && clampv(k - 60, -24, 36) != floor(pv(P_TRANSOFS) + 0.5) ? ui_tap(P_TRANSOFS, clampv(k - 60, -24, 36));
  ) : ui_key >= 0 ? (
    k = key_at(mxv, myv);
    k >= 0 && k != ui_key ? (ui_q(128, ui_key, 0); ui_key = k; ui_q(144, k, 100););
  );
);
!mdown && last_mdown ? (
  drag_c >= 0 && CTT[drag_c] == 6 ? (
    ui_set(P_BENDER, 0);
    bend_up ? ui_q(176, 1, 0);
    bend_up = 0;
  );
  drag_c >= 0 && CTP[drag_c] >= 0 ? automate(CTP[drag_c] + 1, 1);
  drag_c = -1;
  kb_trans = 0; kb_hold_rel = 0;
  ui_key >= 0 ? (ui_q(128, ui_key, 0); ui_key = -1;);
);
last_mdown = mdown;

mouse_wheel != 0 ? (
  c = ct_hit(mxv, myv);
  c >= 0 && CTP[c] >= 0 ? wheel_value(c, mouse_wheel / 120 * (fine ? 0.1 : 1));
  mouse_wheel = 0;
);
