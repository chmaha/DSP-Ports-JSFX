P_DCOLFO = 5; P_DCOPWM = 6; P_DCOSUB = 7; P_DCONOISE = 8; P_HPF = 9;
P_VCFFREQ = 10; P_VCFRES = 11; P_VCFENV = 12; P_VCFLFO = 13; P_VCFKBD = 14;
P_VCALEVEL = 15; P_ENVA = 16; P_ENVD = 17; P_ENVS = 18; P_ENVR = 19;
P_TRANSPOSE = 20; P_HOLD = 21; P_ARP = 22; P_PULSE = 23; P_SAW = 24; P_SUBSW = 25;
P_CHOFF = 26; P_CHI = 27; P_CHII = 28;
P_OCT = 29; P_ARPMODE = 30; P_ARPRANGE = 31; P_LFOMODE = 32; P_PWMMODE = 33;
