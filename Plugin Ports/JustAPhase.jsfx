function gtitle(sid, x, y, cap, r, g, b) local(s, x0, yb, bx, w, py, py1, k, ye, e, n, i, j, t, td, wd, wp, xa, a, bb, ia, ib, c, y0, y1)
(
  s = cap * G_SC / TTCAP;
  x0 = gsx(x); yb = gsy(y);
  bx = floor(x0); w = ceil(TTW[sid] * s) + 3;
  py = floor(yb - TTY1[sid] * s) - 1; py1 = ceil(yb - TTY0[sid] * s) + 1;
  memset(TTC, 0, w + 2);
  while (py <= py1) (
    k = 0;
    loop(8,
      ye = (yb - (py + (k + 0.5) / 8)) / s;
      n = 0; e = TTE + 4 * TTO[sid];
      loop(TTN[sid],
        y0 = e[1]; y1 = e[3];
        (y0 <= ye) !== (y1 <= ye) ? (
          t = x0 + (e[0] + (ye - y0) * (e[2] - e[0]) / (y1 - y0)) * s - bx;
          td = y1 > y0 ? 1 : -1;
          i = n;
          while (i > 0 && TTX[i - 1] > t) ( TTX[i] = TTX[i - 1]; TTD[i] = TTD[i - 1]; i -= 1; );
          TTX[i] = t; TTD[i] = td; n += 1;
        );
        e += 4;
      );
      wd = 0; j = 0;
      loop(n,
        wp = wd; wd += TTD[j];
        wp === 0 && wd !== 0 ? xa = TTX[j];
        wp !== 0 && wd === 0 ? (
          a = max(0, xa); bb = min(w, TTX[j]);
          bb > a ? (
            ia = floor(a); ib = floor(bb);
            ia === ib ? TTC[ia] += (bb - a) * 0.125 : (
              TTC[ia] += (ia + 1 - a) * 0.125;
              i = ia + 1; loop(ib - ia - 1, TTC[i] += 0.125; i += 1;);
              TTC[ib] += (bb - ib) * 0.125;
            );
          );
        );
        j += 1;
      );
      k += 1;
    );
    i = 0;
    loop(w + 1,
      c = TTC[i];
      c > 0.004 ? ( gfx_set(r, g, b, min(1, c)); gfx_rect(bx + i, py, 1, 1); );
      TTC[i] = 0;
      i += 1;
    );
    py += 1;
  );
);
function gtitle_w(sid, cap) ( TTW[sid] * cap / TTCAP; );

function hk_t(k, v) (
  k === 1 ? (v - 4) / 8 : k === 2 ? log(max(GKMIN[k], v) / GKMIN[k]) / log(GKMAX[k] / GKMIN[k]) : k === 3 ? log(max(GKMIN[k], v) / GKMIN[k]) / log(GKMAX[k] / GKMIN[k]) : (v - GKMIN[k]) / (GKMAX[k] - GKMIN[k]);
);
function hk_v(k, t) local(v) (
  t = gclamp(t, 0, 1);
  v = k === 1 ? 4 + 2 * floor(t * 4 + 0.5) : k === 2 ? GKMIN[k] * (GKMAX[k] / GKMIN[k]) ^ t : k === 3 ? GKMIN[k] * (GKMAX[k] / GKMIN[k]) ^ t : GKMIN[k] + t * (GKMAX[k] - GKMIN[k]);
  v = floor(v / GKSTEP[k] + 0.5) * GKSTEP[k];
  gclamp(v, GKMIN[k], GKMAX[k]);
);
function gsync_str(v) local(u, n, sh, sv, b) (
  u = floor(768 / tempo + 0.5) & 65535;
  n = floor(gclamp(log(v / 0.1) / log(100), 0, 1) * 8 + 0.5);
  sh = u < 2 ? 0 : u < 4 ? 1 : u < 8 ? 2 : u < 16 ? 3 : u < 32 ? 4 : u < 64 ? 5 : u < 128 ? 6 : u < 256 ? 7 : u < 512 ? 8 : 0;
  sv = (2 ^ n * 2 ^ sh) & 65535;
  sv < 1 ? strcpy(#g_tx, "still") : ( b = 128 / sv; b >= 1 ? sprintf(#g_tx, b === 1 ? "%.0f beat" : "%.0f beats", b) : sprintf(#g_tx, "1/%.0f beat", 1 / b); );
  #g_tx;
);
function hk_str(k, v) (
  k === 1 ? ( sprintf(#g_tx, "%d", v); #g_tx; ) : k === 2 ? ( v < 1000 ? sprintf(#g_tx, "%.0f Hz", v) : sprintf(#g_tx, "%.2f kHz", v / 1000); #g_tx; ) : k === 3 ? ( ph_sync > 0.5 && tempo > 0 ? gsync_str(v) : sprintf(#g_tx, v < 1 ? "%.2f Hz" : "%.1f Hz", v); #g_tx; ) : k === 5 ? ( sprintf(#g_tx, "%.0f %%", v); #g_tx; ) : k === 7 ? ( sprintf(#g_tx, "%.0f %%", v); #g_tx; ) : k === 8 ? ( sprintf(#g_tx, "%.0f %%", v); #g_tx; ) : k === 9 ? ( sprintf(#g_tx, "%+.1f dB", v); #g_tx; ) : "";
);
function hk_get(k) ( k === 1 ? ph_stages : k === 2 ? ph_upper : k === 3 ? ph_rate : k === 4 ? ph_sync : k === 5 ? ph_depth : k === 6 ? ph_spread : k === 7 ? ph_feedback : k === 8 ? ph_mix : k === 9 ? ph_level : 0; );
function hk_set(k, v) (
  k === 1 ? ph_stages = v : k === 2 ? ph_upper = v : k === 3 ? ph_rate = v : k === 4 ? ph_sync = v : k === 5 ? ph_depth = v : k === 6 ? ph_spread = v : k === 7 ? ph_feedback = v : k === 8 ? ph_mix = v : k === 9 ? ph_level = v : 0;
);
function gtip_text(id) (
  id === 1 ? strcpy(#g_tip, "Drag up/down or use the wheel; Ctrl = fine; double-click resets") :
  id === 2 ? strcpy(#g_tip, "Factory presets (from Classic Phaser RE-01 by AnClark Liu)") :
  id === 3 ? strcpy(#g_tip, "Previous / next preset") :
  id === 4 ? strcpy(#g_tip, "Click an option to select it, or SET to toggle") : strcpy(#g_tip, "");
  #g_tip;
);

function gsection(x0, x1, y, ttl) local(tw, th, cx) (
  gfx_setfont(3); gfx_measurestr(ttl, tw, th);
  cx = (x0 + x1) * 0.5;
  gtext(cx, y, ttl, 3, TH_TX_R, TH_TX_G, TH_TX_B, 1, 1);
  gfx_set(TH_TX_R, TH_TX_G, TH_TX_B, 0.9);
  gfx_rect(floor(gsx(x0)), floor(gsy(y)), max(1, floor(gsx(cx) - tw * 0.5 - 10 * G_SC) - floor(gsx(x0))), max(1, floor(G_SC + 0.4)));
  gfx_rect(ceil(gsx(cx) + tw * 0.5 + 10 * G_SC), floor(gsy(y)), max(1, floor(gsx(x1)) - ceil(gsx(cx) + tw * 0.5 + 10 * G_SC)), max(1, floor(G_SC + 0.4)));
);

function gscale(k, cx, cy, r) local(i, t, a, sa, ca, px, py, tw, th, m) (
  i = 0; m = GMO[k];
  loop(GMN[k],
    t = hk_t(k, GMV[m + i]);
    a = (-140 + 280 * t) * $pi / 180; sa = sin(a); ca = cos(a);
    gfx_set(TH_TX_R, TH_TX_G, TH_TX_B, 0.85);
    gbar(gsx(cx) + sa * (r + 6) * G_SC, gsy(cy) - ca * (r + 6) * G_SC, gsx(cx) + sa * (r + 11) * G_SC, gsy(cy) - ca * (r + 11) * G_SC, max(1, 1.4 * G_SC));
    GML[m + i] >= 0 ? (
      gfx_setfont(5); gfx_measurestr(GML[m + i], tw, th);
      px = gsx(cx) + sa * (r + 14) * G_SC; py = gsy(cy) - ca * (r + 14) * G_SC;
      gfx_set(TH_TX_R, TH_TX_G, TH_TX_B, 0.95);
      gfx_x = px - tw * (0.5 - 0.5 * sa); gfx_y = py - th * (0.5 + 0.5 * ca);
      gfx_drawstr(GML[m + i]);
    );
    i += 1;
  );
);

function hknob(k, cx, cy, kr, hov) local(x, y, r, a0, a1, t, sa, ca) (
  x = gsx(cx); y = gsy(cy); r = kr * G_SC;
  a0 = -140 * $pi / 180; a1 = 140 * $pi / 180;
  t = gclamp(hk_t(k, hk_get(k)), 0, 1);
  gfx_set(TH_SH_R, TH_SH_G, TH_SH_B, 0.45);
  gfx_circle(x, y + 2 * G_SC, r + 2 * G_SC, 1, 1);
  gfx_set(TH_KR_R, TH_KR_G, TH_KR_B, 1);
  gfx_circle(x, y, r - 5 * G_SC, 1, 1);
  hov ? gfx_set(TH_KH_R, TH_KH_G, TH_KH_B, 1) : gfx_set(TH_KB_R, TH_KB_G, TH_KB_B, 1);
  gfx_circle(x, y, r - 7 * G_SC, 1, 1);
  gfx_set(TH_KC_R, TH_KC_G, TH_KC_B, 1);
  gfx_circle(x, y + 1.2 * G_SC, r - 9 * G_SC, 1, 1);
  gann(x, y, r - 1.2 * G_SC, r + 1.2 * G_SC, a0, a1, TH_SH_R, TH_SH_G, TH_SH_B, 0.5);
  sa = a0 + (a1 - a0) * t;
  ca = a0 + (a1 - a0) * GKCTR[k];
  abs(sa - ca) > 0.001 ? (
    gann(x, y, r - 3.5 * G_SC, r + 3.5 * G_SC, min(ca, sa), max(ca, sa), TH_AC_R, TH_AC_G, TH_AC_B, 0.22);
    gann(x, y, r - 1.5 * G_SC, r + 1.5 * G_SC, min(ca, sa), max(ca, sa), TH_AC_R, TH_AC_G, TH_AC_B, 1);
  );
  gfx_set(0.97, 0.96, 0.93, hov ? 1 : 0.9);
  gbar(x + sin(sa) * r * 0.22, y - cos(sa) * r * 0.22, x + sin(sa) * (r - 8 * G_SC), y - cos(sa) * (r - 8 * G_SC), max(1.5, 2.4 * G_SC));
  gtext(cx, cy + kr + 46, hk_str(k, hk_get(k)), 2, TH_VL_R, TH_VL_G, TH_VL_B, 1, 1);
);

function gled(cx, cy, on) local(x, y) (
  x = gsx(cx); y = gsy(cy);
  gfx_set(TH_SH_R, TH_SH_G, TH_SH_B, 0.6);
  gfx_circle(x, y + G_SC, 6.5 * G_SC, 1, 1);
  gfx_set(0.1, 0.06, 0.05, 1);
  gfx_circle(x, y, 6 * G_SC, 1, 1);
  on ? (
    gfx_set(TH_LD_R, TH_LD_G, TH_LD_B, 1);
    gfx_circle(x, y, 4.6 * G_SC, 1, 1);
    gfx_set(1, 0.95, 0.85, 0.85);
    gfx_circle(x - 1.4 * G_SC, y - 1.4 * G_SC, 1.4 * G_SC, 1, 1);
  ) : (
    gfx_set(TH_LD_R * 0.32, TH_LD_G * 0.32, TH_LD_B * 0.32, 1);
    gfx_circle(x, y, 4.6 * G_SC, 1, 1);
  );
);

function gswitch(j, hov) local(k, cx, v, on1) (
  k = GSI[j]; cx = GSWX[j];
  v = hk_get(k);
  on1 = v >= 0.5 * (GSV0[j] + GSV1[j]);
  G_I2 = 0;
  loop(2,
    gled(cx - 30, 134 + 26 * G_I2, G_I2 ? on1 : !on1);
    gtext(cx - 18, 134 + 26 * G_I2, GSO[j] + G_I2, 4, TH_TX_R, TH_TX_G, TH_TX_B, (G_I2 ? on1 : !on1) ? 1 : 0.72, 0);
    G_I2 += 1;
  );
  G_XX = floor(gsx(cx - 32)); G_YY = floor(gsy(178)); G_WW = ceil(64 * G_SC); G_HH = ceil(22 * G_SC);
  gfrr(G_XX, G_YY + 1, G_XX + G_WW, G_YY + G_HH + 1, floor(4 * G_SC), TH_SH_R, TH_SH_G, TH_SH_B, 0.55);
  gfrr(G_XX, G_YY, G_XX + G_WW, G_YY + G_HH, floor(4 * G_SC), hov ? TH_KH_R : TH_KB_R, hov ? TH_KH_G : TH_KB_G, hov ? TH_KH_B : TH_KB_B, 1);
  gbord(G_XX, G_YY, G_XX + G_WW, G_YY + G_HH, floor(4 * G_SC), max(1, floor(G_SC + 0.5)), TH_TX_R, TH_TX_G, TH_TX_B, hov ? 0.7 : 0.35);
  gtext(cx, 189, "SET", 4, 0.97, 0.96, 0.93, 1, 1);
);

function ph_coef() local(sr, p0, p1, p2, p3, p4, p5, p6, p7, p8, stn, upn, rtn, dpn, fbn, mxn, lvn, rate, tmp, u, n, di, sh, sv, sd, sdi, fhi, ratio, fb_, fa2, al, ah, lg) (
  sr = ph_sr;
  p0 = min(max((ph_stages), 4.0), 12.0);
  p1 = min(max((ph_upper), 50.0), 20000.0);
  p2 = min(max((ph_rate), 0.10000000149011612), 10.0);
  p3 = min(max((ph_sync), 0.0), 1.0);
  p4 = min(max((ph_depth), 0.0), 100.0);
  p5 = min(max((ph_spread), 0.0), 1.0);
  p6 = min(max((ph_feedback), 0.0), 100.0);
  p7 = min(max((ph_mix), 0.0), 100.0);
  p8 = min(max((ph_level), -24.0), 6.0);
  p0 > 4 && p0 < 6 ? p0 = 4; p0 > 6 && p0 < 8 ? p0 = 6; p0 > 8 && p0 < 10 ? p0 = 8; p0 > 10 && p0 < 12 ? p0 = 10;
  ph_spr = p5 > 0.5;
