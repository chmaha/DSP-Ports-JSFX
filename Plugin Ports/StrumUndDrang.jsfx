R_CH[1440] = 114; R_CH[1441] = 46; R_CH[1442] = 46; R_CH[1443] = 46; R_CH[1444] = 114; R_CH[1445] = 46; R_CH[1446] = 46; R_CH[1447] = 46; R_CH[1448] = 102; R_CH[1449] = 46; R_CH[1450] = 46; R_CH[1451] = 46; R_CH[1452] = 102; R_CH[1453] = 46; R_CH[1454] = 102; R_CH[1455] = 46;
K78SLOT[0] = 0; K78SLOT[1] = 1; K78SLOT[2] = 2; K78SLOT[3] = -1; K78SLOT[4] = 3; K78SLOT[5] = 4; K78SLOT[6] = 4; K78SLOT[7] = 10; K78SLOT[8] = 8; K78SLOT[9] = 7; K78SLOT[10] = 9; K78SLOT[11] = 5; K78SLOT[12] = 6; K78SLOT[13] = 11; K78SLOT[14] = 12;
kmr.seed = 1;
km_tu = 1; km_dc = 1; km_tone = 0.5; km_snappy = 0.5;
CIV[0] = 0; CIV[1] = 4; CIV[2] = 7;
CNOTE[0] = 60; CNOTE[1] = 64; CNOTE[2] = 67;
CHZ[0] = om_hz(60); CHZ[1] = om_hz(64); CHZ[2] = om_hz(67); om_bhz = om_hz(48);
om_bsp = om_tunep = -1000000;
om_root = 0; om_bnote = 48; om_ctgt = 0; om_bs = 0; om_pb = 0; om_mw = 0;
om_stopped = 0; om_step = -1; om_bseq = 0;
cq_r = cq_w = 0;
om_last_srate = -1;
om_glast = (volume);

function om_params() (
  om_split = split;
  om_cmode = chord_keys;
  om_abass = auto_bass;
  om_oct = octave;
  om_sus = (sustain / 100);
  om_harp = (harp_level / 100);
  om_chord = (chord_level / 100);
  om_bassl = (bass_level / 100);
  om_rsel = rhythm;
  om_tempo = (rtempo);
  om_rlev = (rhythm_level / 100);
  om_tune = (fine_tune);
  om_brange = (bend_range);
  om_gain = (volume);
  pr_on = rev_on;
  pr_size = (rev_size / 100);
  pr_mix = (rev_mix / 100);
  pr_decay = (rev_decay);
  pr_pre = (rev_predelay);
  pr_diff = (rev_diffusion / 100);
  pr_damp = (rev_damp);
  pr_tone = (rev_tone);
  pr_mod = (rev_mod / 100);
  pr_width = (rev_width / 100);
  pr_freeze = rev_freeze;
);

<?
!jsfx_has_set_midi_note_name ? printf("function set_midi_note_name(a,b,c,d) ( 0 );\n");
?>
function nn_root(pc) (
  pc === 0 ? "C" : pc === 1 ? "Db" : pc === 2 ? "D" : pc === 3 ? "Eb" : pc === 4 ? "E" : pc === 5 ? "F" :
  pc === 6 ? "F#" : pc === 7 ? "G" : pc === 8 ? "Ab" : pc === 9 ? "A" : pc === 10 ? "Bb" : "B";
);
function nn_update() local(st, k, r) (
  st = split + chord_keys * 256;
  st !== nn_st ? (
    nn_st = st;
    set_midi_note_name(-1, 0, 0, "");
    k = 0;
    loop(128,
      k >= split ? (
        set_midi_note_name(0, k, -1, sprintf(#nn_s, "String %d", (k - split) % 13 + 1));
      ) : !chord_keys ? (
        r = floor(((split - 1) - k) / 12) % 3;
        set_midi_note_name(0, k, -1, sprintf(#nn_s, "%s %s", nn_root(k % 12), r === 0 ? "Major" : r === 1 ? "Minor" : "7th"));
      );
      k += 1;
    );
  );
);
nn_st = -1;

@slider
om_last_srate !== srate ? (
  om_last_srate = srate;
  om_prepare();
  pr_prepare();
  om_reset();
  pr_reset();
  om_ambwas = 0;
);
om_params();
nn_update();

@block
om_params();
nn_update();
om_ne = 0;
while (cq_r != cq_w) (
  om_ne < 1024 ? (
    EQ[om_ne * 4] = 0; EQ[om_ne * 4 + 1] = CQ[cq_r * 3]; EQ[om_ne * 4 + 2] = CQ[cq_r * 3 + 1]; EQ[om_ne * 4 + 3] = CQ[cq_r * 3 + 2];
    om_ne += 1;
  );
  cq_r = (cq_r + 1) & 255;
);
while (midirecv(mofs, m1, m2, m3)) (
  om_ne < 1024 ? (
    EQ[om_ne * 4] = mofs; EQ[om_ne * 4 + 1] = m1; EQ[om_ne * 4 + 2] = m2; EQ[om_ne * 4 + 3] = m3;
    om_ne += 1;
  );
);
om_panic = 0;
om_e = 0;
loop(om_ne,
  om_s = EQ[om_e * 4 + 1] & 240;
  om_s == 176 && EQ[om_e * 4 + 2] == 120 && EQ[om_e * 4 + 3] == 0 ? om_panic = 1;
  om_s == 224 ? (
    om_pb = ((((EQ[om_e * 4 + 2] | (EQ[om_e * 4 + 3] * 128)) - 8192) / 8192) * om_brange);
  ) : (
    om_s == 176 && EQ[om_e * 4 + 2] == 1 ? om_mw = (EQ[om_e * 4 + 3] / 127);
  );
  om_e += 1;
);
om_panic ? (
  om_reset();
  om_stopped = 1;
  pr_reset();
);
om_render(samplesblock);
pr_on ? (
  !om_ambwas ? pr_reset();
  pr_process(samplesblock);
);
om_ambwas = pr_on;
om_ginc = om_glast === om_gain ? 0 : ((om_gain - om_glast) / samplesblock);
om_gs = om_glast;
om_i = 0;
loop(samplesblock,
  om_glast === om_gain ? (
    OBL[om_i] = (OBL[om_i] * om_gain);
    OBR[om_i] = (OBR[om_i] * om_gain);
  ) : (
    OBL[om_i] = (OBL[om_i] * om_gs);
    OBR[om_i] = (OBR[om_i] * om_gs);
    om_gs = (om_gs + om_ginc);
  );
  om_i += 1;
);
om_glast = om_gain;
om_si = 0;

@sample
spl0 = OBL[om_si];
spl1 = OBR[om_si];
om_si += 1;

@gfx 1120 696

gW0 = 1120; gH0 = 696;
z = max(0.4, min(gfx_w / gW0, gfx_h / gH0));
ox = floor((gfx_w - gW0 * z) * 0.5);
oy = 0;
gnow = time_precise();

function automate(s, e)
(
<?
  max_sliders > 64 ? printf("slider_automate(2^(s-1),e);") : (
    printf("  s == 1 ? slider_automate(split, e) :\n");
    printf("  s == 2 ? slider_automate(octave, e) :\n");
    printf("  s == 3 ? slider_automate(sustain, e) :\n");
    printf("  s == 4 ? slider_automate(harp_level, e) :\n");
    printf("  s == 5 ? slider_automate(chord_level, e) :\n");
    printf("  s == 6 ? slider_automate(bass_level, e) :\n");
    printf("  s == 7 ? slider_automate(rhythm, e) :\n");
    printf("  s == 8 ? slider_automate(rtempo, e) :\n");
    printf("  s == 9 ? slider_automate(rhythm_level, e) :\n");
    printf("  s == 10 ? slider_automate(fine_tune, e) :\n");
    printf("  s == 11 ? slider_automate(bend_range, e) :\n");
    printf("  s == 12 ? slider_automate(volume, e) :\n");
    printf("  s == 13 ? slider_automate(rev_on, e) :\n");
    printf("  s == 14 ? slider_automate(rev_size, e) :\n");
    printf("  s == 15 ? slider_automate(rev_mix, e) :\n");
    printf("  s == 16 ? slider_automate(rev_decay, e) :\n");
    printf("  s == 17 ? slider_automate(rev_predelay, e) :\n");
    printf("  s == 18 ? slider_automate(rev_diffusion, e) :\n");
    printf("  s == 19 ? slider_automate(rev_damp, e) :\n");
    printf("  s == 20 ? slider_automate(rev_tone, e) :\n");
    printf("  s == 21 ? slider_automate(rev_mod, e) :\n");
    printf("  s == 22 ? slider_automate(rev_width, e) :\n");
    printf("  s == 23 ? slider_automate(rev_freeze, e) :\n");
    printf("  s == 24 ? slider_automate(chord_keys, e) :\n");
    printf("  s == 25 ? slider_automate(auto_bass, e) :\n");
  );
?> 0;
);

function sx(x) ( ox + x * z; );
function sy(y) ( oy + y * z; );
function hit(x, y, w, h) ( mouse_x >= sx(x) && mouse_x < sx(x + w) && mouse_y >= sy(y) && mouse_y < sy(y + h); );
function hitc(x, y, r) ( sqr(mouse_x - sx(x)) + sqr(mouse_y - sy(y)) <= sqr(r * z); );
function font(sz, fl) ( gfx_setfont(1, "Arial", (sz + 2) * z, fl); );
function text_c(str, cx, y) local(tw, th) ( gfx_measurestr(str, tw, th); gfx_x = sx(cx) - tw * 0.5; gfx_y = sy(y); gfx_drawstr(str); );
function text_l(str, lx, y) ( gfx_x = sx(lx); gfx_y = sy(y); gfx_drawstr(str); );
function text_r(str, rx, y) local(tw, th) ( gfx_measurestr(str, tw, th); gfx_x = sx(rx) - tw; gfx_y = sy(y); gfx_drawstr(str); );
function box(x, y, w, h) ( gfx_rect(sx(x), sy(y), w * z, h * z, 1); );
function hint(str) ( strcpy(#ghint, str); );
function lab() ( gfx_set(0.86, 0.86, 0.83, 1); );
function orange() ( gfx_set(0.96, 0.52, 0.18, 1); );

function gq(st, nt, vl) (
  ((cq_w + 1) & 255) != cq_r ? (
    CQ[cq_w * 3] = st; CQ[cq_w * 3 + 1] = nt; CQ[cq_w * 3 + 2] = vl;
    cq_w = (cq_w + 1) & 255;
  );
);

function sl_get(i) ( slider(i); );
function set_sl(i, v) (
  v = max(GSMIN[i], min(GSMAX[i], v));
  slider(i) !== v ? ( slider(i) = v; automate(i, 0); );
);
function tap_sl(i, v) ( set_sl(i, v); automate(i, 1); );

function k_pos(i, v) local(p) (
  p = (v - GSMIN[i]) / (GSMAX[i] - GSMIN[i]);
  p = max(0, min(1, p));
  GSSKEW[i] != 1 ? p ^ GSSKEW[i] : p;
);
function k_val(i, p) (
  p = max(0, min(1, p));
  GSSKEW[i] != 1 ? p = p ^ (1 / GSSKEW[i]);
  GSMIN[i] + p * (GSMAX[i] - GSMIN[i]);
);
function k_quant(i, v) ( floor(v / GSSTEP[i] + 0.5) * GSSTEP[i]; );

function note_name(n, str) local(o) (
  o = floor(n / 12) - 1;
  sprintf(str, "%s%d", GNN[n % 12], o);
);

function sl_text(i, str) local(v) (
  v = slider(i);
  i == 1 ? note_name(v, str) :
  i == 2 ? sprintf(str, "%+d oct", v) :
  i == 7 ? strcpy(str, GRN[v]) :
  i == 8 ? sprintf(str, "%d BPM", v) :
  i == 10 ? sprintf(str, "%+.1f cents", v) :
  i == 11 ? sprintf(str, "%d semitones", v) :
  i == 12 ? sprintf(str, "%d %%", v * 100) :
  i == 16 ? sprintf(str, "%.2f s", v) :
  i == 17 ? sprintf(str, "%.1f ms", v) :
  i == 19 || i == 20 ? (v >= 1000 ? sprintf(str, "%.2f kHz", v / 1000) : sprintf(str, "%d Hz", v)) :
  i == 13 || i == 23 || i == 25 ? strcpy(str, v ? "On" : "Off") :
  i == 24 ? strcpy(str, v ? "Intervals (KoniSynth)" : "Buttons (OM-84)") :
  sprintf(str, "%d %%", v);
);

function knob_body(x, y, r) local(QX, QY, QR, k, t, c) (
  QX = sx(x); QY = sy(y); QR = r * z;
  gfx_set(0, 0, 0, 0.35);
  gfx_circle(QX + 1.5 * z, QY + 2.5 * z, QR + 2 * z, 1, 1);
  gfx_set(0.04, 0.04, 0.045, 1);
  gfx_circle(QX, QY, QR + 1.5 * z, 1, 1);
  k = 0;
  loop(ceil(QR),
    t = k / ceil(QR);
    c = 0.10 + 0.16 * t;
    gfx_set(c, c, c * 1.04, 1);
    gfx_circle(QX - QR * 0.12 * t, QY - QR * 0.18 * t, QR * (1 - t * 0.75), 1, 1);
    k += 1;
  );
  gfx_set(1, 1, 1, 0.10);
  gfx_arc(QX, QY, QR - 1 * z, -1.6, 0.2, 1);
);

function knob(x, y, r, i, label) local(hov, nv, d, fine, QX, QY, a, a0, a1, k, pos, rr, big) (
  hov = hitc(x, y, r + 5);
  (mouse_click && hov) ? (
    (g_lci == i && gnow - g_lct < 0.3) ? ( tap_sl(i, GSDEF[i]); g_drag = -1; ) :
      ( g_drag = i; g_dy0 = mouse_y; g_dp0 = k_pos(i, slider(i)); );
    g_lci = i; g_lct = gnow; mouse_click = 0;
  );
  g_drag == i && (mouse_cap & 1) ? (
    mouse_cap |= 65536;
    fine = (mouse_cap & 4) || (mouse_cap & 8);
    d = (g_dy0 - mouse_y) / (200 * z) * (fine ? 0.1 : 1);
    set_sl(i, k_quant(i, k_val(i, g_dp0 + d)));
  );
  (hov && g_wheel != 0 && g_drag < 0) ? (
    tap_sl(i, k_quant(i, k_val(i, k_pos(i, slider(i)) + (g_wheel > 0 ? 1 : -1) * ((mouse_cap & 4) ? 0.004 : 0.02))));
    g_wheel = 0;
  );
  QX = sx(x); QY = sy(y);
  pos = k_pos(i, slider(i));
  a0 = -2.35619; a1 = 2.35619;
  a = a0 + (a1 - a0) * pos;
  k = 0;
  loop(11,
    d = a0 + (a1 - a0) * k / 10;
    big = k == 0 || k == 5 || k == 10;
    gfx_set(0.86, 0.86, 0.83, big ? 0.9 : 0.6);
    rr = r + (big ? 8 : 6.5);
    gfx_line(QX + sin(d) * (r + 4) * z, QY - cos(d) * (r + 4) * z, QX + sin(d) * rr * z, QY - cos(d) * rr * z, 1);
    k += 1;
  );
  knob_body(x, y, r);
  gfx_set(0.96, 0.96, 0.94, 1);
  k = 0;
  loop(max(1, ceil(1.6 * z)),
    gfx_line(QX + sin(a) * r * 0.2 * z + (k - 0.5) * cos(a), QY - cos(a) * r * 0.2 * z + (k - 0.5) * sin(a),
             QX + sin(a) * r * 0.92 * z + (k - 0.5) * cos(a), QY - cos(a) * r * 0.92 * z + (k - 0.5) * sin(a), 1);
    k += 1;
  );
  font(r >= 20 ? 10 : 9, 'b');
  lab();
  text_c(label, x, y - r - (r >= 20 ? 26 : 22));
  (hov || g_drag == i) ? (
    sl_text(i, #gkv);
    sprintf(#ghint, "%s: %s   (drag, wheel, Ctrl/Shift fine, double-click resets)", GSNAME[i], #gkv);
    g_tipi = i; g_tipx = x; g_tipy = y + r + 10;
  );
);

function tooltip(x, y, str) local(tw, th, bx, by, bw, bh) (
  font(10, 'b');
  gfx_measurestr(str, tw, th);
  bw = tw + 12 * z; bh = th + 6 * z;
  bx = max(2, min(gfx_w - bw - 2, sx(x) - bw * 0.5)); by = sy(y);
  gfx_set(0.08, 0.08, 0.09, 0.95);
  gfx_rect(bx, by, bw, bh, 1);
  gfx_set(0.93, 0.42, 0.13, 1);
  gfx_rect(bx, by, bw, max(1, z), 1);
  gfx_set(1, 1, 1, 1);
  gfx_x = bx + 6 * z; gfx_y = by + 3 * z;
  gfx_drawstr(str);
);

function btn(x, y, w, h, label, lit) local(QX, QY, QW, QH, hov, r) (
  QX = sx(x); QY = sy(y); QW = w * z; QH = h * z;
  hov = hit(x, y, w, h);
  gfx_set(0.02, 0.02, 0.02, 1);
  gfx_rect(QX - z, QY - z, QW + 2 * z, QH + 2 * z, 1);
  lit ? gfx_gradrect(QX, QY, QW, QH, 0.95, 0.50, 0.16, 1, 0, 0, 0, 0, -0.15 / QH, -0.10 / QH, -0.05 / QH, 0)
      : gfx_gradrect(QX, QY, QW, QH, 0.30, 0.30, 0.31, 1, 0, 0, 0, 0, -0.10 / QH, -0.10 / QH, -0.10 / QH, 0);
  hov ? ( gfx_set(1, 1, 1, 0.10); gfx_rect(QX, QY, QW, QH, 1); );
  font(9.5, 'b');
  lit ? gfx_set(0.10, 0.06, 0.03, 1) : gfx_set(0.92, 0.92, 0.90, 1);
  text_c(label, x + w * 0.5, y + h * 0.5 - 7);
  r = mouse_click && hov;
  r ? mouse_click = 0;
  r;
);

function seg4(x, y, w, h, cur) local(k, sw, on, hov, QX, r) (
  sw = w / 4;
  r = -9;
  k = 0;
  loop(4,
    on = k - 2 == cur;
    hov = hit(x + k * sw, y, sw, h);
    QX = sx(x + k * sw);
    gfx_set(0.02, 0.02, 0.02, 1);
    gfx_rect(QX - z, sy(y) - z, sw * z + 2 * z, h * z + 2 * z, 1);
    on ? gfx_gradrect(QX, sy(y), sw * z - z, h * z, 0.95, 0.50, 0.16, 1, 0, 0, 0, 0, -0.15 / (h * z), -0.10 / (h * z), -0.05 / (h * z), 0)
       : gfx_gradrect(QX, sy(y), sw * z - z, h * z, 0.27, 0.27, 0.28, 1, 0, 0, 0, 0, -0.08 / (h * z), -0.08 / (h * z), -0.08 / (h * z), 0);
    hov && !on ? ( gfx_set(1, 1, 1, 0.10); gfx_rect(QX, sy(y), sw * z - z, h * z, 1); );
    font(9.5, 'b');
    on ? gfx_set(0.10, 0.06, 0.03, 1) : gfx_set(0.90, 0.90, 0.88, 1);
    text_c(k == 0 ? "-2" : (k == 1 ? "-1" : (k == 2 ? "0" : "+1")), x + k * sw + sw * 0.5, y + h * 0.5 - 7);
    (mouse_click && hov) ? ( r = k - 2; mouse_click = 0; );
    k += 1;
  );
  r;
);

function seg2(x, y, w, h, cur, s1, s2) local(k, sw, on, hov, QX, r) (
  sw = w / 2;
  r = -1;
  k = 0;
  loop(2,
    on = k == cur;
    hov = hit(x + k * sw, y, sw, h);
    QX = sx(x + k * sw);
    gfx_set(0.02, 0.02, 0.02, 1);
    gfx_rect(QX - z, sy(y) - z, sw * z + 2 * z, h * z + 2 * z, 1);
    on ? gfx_gradrect(QX, sy(y), sw * z - z, h * z, 0.95, 0.50, 0.16, 1, 0, 0, 0, 0, -0.15 / (h * z), -0.10 / (h * z), -0.05 / (h * z), 0)
       : gfx_gradrect(QX, sy(y), sw * z - z, h * z, 0.27, 0.27, 0.28, 1, 0, 0, 0, 0, -0.08 / (h * z), -0.08 / (h * z), -0.08 / (h * z), 0);
    hov && !on ? ( gfx_set(1, 1, 1, 0.10); gfx_rect(QX, sy(y), sw * z - z, h * z, 1); );
    font(9, 'b');
    on ? gfx_set(0.10, 0.06, 0.03, 1) : gfx_set(0.90, 0.90, 0.88, 1);
    text_c(k == 0 ? s1 : s2, x + k * sw + sw * 0.5, y + h * 0.5 - 7);
    (mouse_click && hov) ? ( r = k; mouse_click = 0; );
    k += 1;
  );
  r;
);

function led(x, y, on) local(QX, QY) (
  QX = sx(x); QY = sy(y);
  gfx_set(0.02, 0.02, 0.02, 1);
  gfx_circle(QX, QY, 5 * z, 1, 1);
  on ? gfx_set(1, 0.20, 0.10, 1) : gfx_set(0.36, 0.10, 0.08, 1);
  gfx_circle(QX, QY, 3.6 * z, 1, 1);
  on ? ( gfx_set(1, 0.6, 0.5, 0.9); gfx_circle(QX - z, QY - z, 1.2 * z, 1, 1); );
);

function chord_target(pc, mask) local(top, key, r, base) (
  g_nn = 0;
  mask == 0 ? 0 : chord_keys ? (
    base = max(0, split - 24);
    key = base + ((pc - (base % 12) + 12) % 12);
    GNK[0] = key; g_nn = 1;
    mask == 2 ? ( GNK[1] = key + 3; g_nn = 2; );
    mask == 4 ? ( GNK[1] = key + 10; g_nn = 2; );
    mask == 5 ? ( GNK[1] = key + 11; g_nn = 2; );
    mask == 6 ? ( GNK[1] = key + 3; GNK[2] = key + 10; g_nn = 3; );
    mask == 3 ? ( GNK[1] = key + 3; GNK[2] = key + 6; g_nn = 3; );
    mask == 7 ? ( GNK[1] = key + 4; GNK[2] = key + 8; g_nn = 3; );
  ) : (
    r = 0;
    loop(3,
      (mask >> r) & 1 ? (
        top = split - 12 * (r + 1);
        GNK[g_nn] = top + ((pc - (top % 12) + 12) % 12);
        g_nn += 1;
      );
      r += 1;
    );
  );
);

function in_list(base, n, v) local(k, f) (
  f = 0; k = 0;
  loop(n, base[k] == v ? f = 1; k += 1;);
  f;
);

function chord_send(pc, mask) local(k) (
  chord_target(pc, mask);
  k = 0;
  loop(g_hn, !in_list(GNK, g_nn, GHK[k]) ? gq(128, GHK[k], 0); k += 1;);
  k = 0;
  loop(g_nn, !in_list(GHK, g_hn, GNK[k]) ? gq(144, GNK[k], 100); k += 1;);
  k = 0;
  loop(g_nn, GHK[k] = GNK[k]; k += 1;);
  g_hn = g_nn;
  g_hpc = pc; g_hmask = mask;
);

function chord_sync() local(cpc, mask) (
  cpc = g_mmask ? g_mpc : g_lpc;
  mask = cpc < 0 ? 0 : ((cpc == g_lpc ? g_lmask : 0) | (cpc == g_mpc ? g_mmask : 0));
  (cpc != g_hpc || mask != g_hmask) ? (
    g_hn > 0 && cpc != g_hpc ? chord_send(g_hpc, 0);
    mask ? chord_send(cpc, mask) : ( g_hn > 0 ? chord_send(g_hpc, 0); g_hpc = -1; g_hmask = 0; );
  );
);

function chord_pad(c, row) local(x, y, w, h, QX, QY, QW, QH, hov, pc, act) (
  w = 58; h = 34;
  x = 116 + c * 66; y = 262 + row * 44;
  QX = sx(x); QY = sy(y); QW = w * z; QH = h * z;
  pc = GCPC[c];
  hov = hit(x, y, w, h);
  act = chord_keys ? ((g_hn > 0 && g_hpc == pc && ((g_hmask >> row) & 1)) || (g_cact && g_cpc == pc && ((g_cmask >> row) & 1)))
                   : OBTN[row * 12 + pc] > 0;
  gfx_set(0, 0, 0, 0.45);
  gfx_rect(QX + 2 * z, QY + 3 * z, QW, QH, 1);
  row == 0 ? gfx_set(0.85, 0.29, 0.20, 1) : (row == 1 ? gfx_set(0.96, 0.51, 0.10, 1) : gfx_set(0.92, 0.83, 0.06, 1));
  gfx_rect(QX, QY, QW, QH, 1);
  gfx_set(1, 1, 1, 0.16);
  gfx_rect(QX, QY, QW, 2 * z, 1);
  gfx_set(0, 0, 0, 0.25);
  gfx_rect(QX, QY + QH - 2 * z, QW, 2 * z, 1);
  hov ? ( gfx_set(1, 1, 1, 0.12); gfx_rect(QX, QY, QW, QH, 1); );
  act ? ( gfx_set(1, 1, 1, 0.22); gfx_rect(QX, QY, QW, QH, 1); );
  led(x + 10, y + 9, act);
  font(10, 'b');
  gfx_set(0.10, 0.06, 0.03, 1);
  text_c(GRT[pc], x + w * 0.5 + 6, y + 9);
  g_lpc == pc && ((g_lmask >> row) & 1) ? (
    gfx_set(1, 1, 1, 0.9);
    gfx_rect(QX, QY, QW, QH, 0);
    gfx_rect(QX + z, QY + z, QW - 2 * z, QH - 2 * z, 0);
  );
  (mouse_click && hov) ? (
    mouse_click = 0;
    g_mpc = pc; g_mmask = 1 << row;
  );
  (mouse_rclick && hov) ? (
    mouse_rclick = 0;
    g_lpc != pc ? ( g_lpc = pc; g_lmask = 1 << row; ) : g_lmask ~= 1 << row;
    g_lmask == 0 ? g_lpc = -1;
  );
  hov ? hint("Click and hold to play; right-click latches a button. Same column: MAJ+MIN dim, MAJ+7TH maj7, MIN+7TH m7, all three aug");
);

function chord_name(str) local(b, c, sfx) (
  b = CIV[1]; c = CIV[2];
  sfx = b == 4 && c == 7 ? "" : (b == 3 && c == 7 ? "m" : (b == 4 && c == 10 ? "7" : (b == 3 && c == 10 ? "m7" :
        (b == 4 && c == 11 ? "maj7" : (b == 3 && c == 9 ? "dim" : "aug")))));
  sprintf(str, "%s%s", GRT[om_root], sfx);
);

function plate() local(x, y, w, h, zw, k, zx, amp, QX, QY, zone, vel, ln, z2, nt) (
  x = 26; y = 418; w = 1068; h = 60;
  zw = w / 13;
  QX = sx(x); QY = sy(y);
  gfx_set(0.02, 0.02, 0.02, 1);
  gfx_rect(QX - z, QY - z, w * z + 2 * z, h * z + 2 * z, 1);
  gfx_gradrect(QX, QY, w * z, h * z, 0.20, 0.19, 0.18, 1, 0, 0, 0, 0, -0.08 / (h * z), -0.08 / (h * z), -0.08 / (h * z), 0);
  k = 0;
  loop(13,
    zx = x + k * zw;
    amp = min(1, HAMP[k] * 2.5);
    amp > 0.002 ? ( gfx_set(0.96, 0.52, 0.18, 0.15 + 0.6 * amp); box(zx + 1, y, zw - 2, h); );
    gfx_set(0.80, 0.80, 0.78, 0.8);
    box(zx + zw * 0.5 - 1, y + 6, 2, h - 12);
    k > 0 ? ( gfx_set(0, 0, 0, 0.35); box(zx, y, 1, h); );
    nt = (CNOTE[k % 3] + 12 * floor(k / 3)) + 12 * octave;
    font(9, 'b');
    gfx_set(0.96, 0.96, 0.94, 0.9);
    note_name(nt, #gzn);
    text_c(#gzn, zx + zw * 0.5, y + h + 4);
    k += 1;
  );
  hit(x, y, w, h) ? hint("Strum plate: click or drag across it to pluck the strings (lower = louder). Keys from Split up do the same");
  (mouse_click && hit(x, y, w, h)) ? ( g_strum = 1; g_lz = -1; mouse_click = 0; );
  g_strum && (mouse_cap & 1) ? (
    zone = max(0, min(12, floor((mouse_x - QX) / (zw * z))));
    vel = max(20, min(127, floor(20 + 107 * (mouse_y - QY) / (h * z))));
    zone != g_lz ? (
      g_lz < 0 ? ( gq(144, split + zone, vel); gq(128, split + zone, 0); ) : (
        z2 = g_lz;
        while (z2 != zone) (
          z2 += zone > g_lz ? 1 : -1;
          gq(144, split + z2, vel); gq(128, split + z2, 0);
        );
      );
      g_lz = zone;
    );
  );
);


function is_black(n) local(pc) ( pc = n % 12; pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10; );
function kb_wi(n) local(k, c) ( c = 0; k = g_klo; while (k < n) ( !is_black(k) ? c += 1; k += 1; ); c; );
function kb_left(n) ( is_black(n) ? g_kx + kb_wi(n) * g_kww - g_kww * 0.29 : g_kx + kb_wi(n) * g_kww; );
function kb_right(n) ( is_black(n) ? g_kx + kb_wi(n) * g_kww + g_kww * 0.29 : g_kx + (kb_wi(n) + 1) * g_kww; );

function kb_band(n0, n1, r, g, b, label) local(x0, x1) (
  x0 = kb_left(n0) + 1; x1 = kb_right(n1) - 1;
  gfx_set(r, g, b, 1);
  box(x0, 518, x1 - x0, 16);
  font(9, 'b');
  gfx_set(0.10, 0.06, 0.03, 1);
  text_c(label, (x0 + x1) * 0.5, 519);
);

function kb_key_at(mxp, myp) local(n, hitn, x0) (
  hitn = -1;
  n = g_klo;
  while (n <= g_khi) (
    is_black(n) && mxp >= sx(kb_left(n)) && mxp < sx(kb_right(n)) && myp >= sy(538) && myp < sy(538 + 28) ? hitn = n;
    n += 1;
  );
  hitn < 0 ? (
    n = g_klo;
    while (n <= g_khi) (
      !is_black(n) && mxp >= sx(kb_left(n)) && mxp < sx(kb_right(n)) && myp >= sy(538) && myp < sy(538 + 44) ? hitn = n;
      n += 1;
    );
  );
  hitn;
);

function keymap() local(nw, n, kx, kw, dn, pc, r, top, lbl, z0, amp, QX, QY, k, bw, bh, hn) (
  g_klo = max(0, floor((split - 36) / 12) * 12);
  g_khi = split + 12;
  is_black(g_khi) ? g_khi += 1;
  nw = 0; n = g_klo; while (n <= g_khi) ( !is_black(n) ? nw += 1; n += 1; );
  g_kx = 26; g_kww = 1068 / nw;
  font(9, 'b'); lab();
  text_l("KEYBOARD", 26, 500);
  chord_keys ? (
    note_name(g_klo, #gka); note_name(split - 1, #gkb);
    sprintf(#gkl, "CHORD KEYS %s-%s: LOWEST KEY = ROOT, HELD INTERVALS = TYPE", #gka, #gkb);
    kb_band(g_klo, split - 1, 0.60, 0.60, 0.58, #gkl);
  ) : (
    r = 0;
    loop(3,
      top = split - 12 * (r + 1);
      top + 11 >= g_klo ? (
        note_name(max(top, g_klo), #gka); note_name(top + 11, #gkb);
        sprintf(#gkl, "%s  %s-%s", r == 0 ? "MAJOR" : (r == 1 ? "MINOR" : "7TH"), #gka, #gkb);
        r == 0 ? kb_band(max(top, g_klo), top + 11, 0.85, 0.29, 0.20, #gkl) :
        r == 1 ? kb_band(max(top, g_klo), top + 11, 0.96, 0.51, 0.10, #gkl) :
                 kb_band(max(top, g_klo), top + 11, 0.92, 0.83, 0.06, #gkl);
      );
      r += 1;
    );
    split - 36 > g_klo ? kb_band(g_klo, split - 37, 0.85, 0.29, 0.20, "MAJ");
  );
  note_name(split, #gka); note_name(split + 12, #gkb);
  sprintf(#gkl, "STRUM %s-%s: 13 STRINGS", #gka, #gkb);
  kb_band(split, split + 12, 0.94, 0.86, 0.69, #gkl);
  g_khi > split + 12 ? ( gfx_set(0.30, 0.30, 0.31, 1); box(kb_left(g_khi) + 1, 518, kb_right(g_khi) - kb_left(g_khi) - 2, 16); );

  QY = sy(538);
  bh = 28; bw = g_kww * 0.58;
  gfx_set(0.02, 0.02, 0.02, 1);
  box(26, 538, 1068, 44);
  n = g_klo;
  while (n <= g_khi) (
    !is_black(n) ? (
      kx = floor(sx(kb_left(n))) + max(1, floor(z));
      kw = floor(sx(kb_right(n))) - kx;
      dn = KDN[n] > 0 || n == g_kn;
      amp = n >= split && n <= split + 12 ? min(1, HAMP[n - split] * 2.5) : 0;
      dn ? gfx_gradrect(kx, QY, kw, 42 * z, 0.82, 0.81, 0.78, 1, 0, 0, 0, 0, -0.12 / (44 * z), -0.12 / (44 * z), -0.12 / (44 * z), 0)
         : gfx_gradrect(kx, QY, kw, 44 * z, 0.97, 0.96, 0.93, 1, 0, 0, 0, 0, -0.06 / (44 * z), -0.06 / (44 * z), -0.06 / (44 * z), 0);
      amp > 0.002 ? ( gfx_set(0.96, 0.52, 0.18, 0.2 + 0.6 * amp); gfx_rect(kx, QY, kw, 44 * z, 1); );
      dn ? ( gfx_set(0.96, 0.52, 0.18, 0.55); gfx_rect(kx, QY + 30 * z, kw, 10 * z, 1); );
      gfx_set(0, 0, 0, dn ? 0.45 : 0.25); gfx_rect(kx, QY, kw, 3 * z, 1);
      n % 12 == 0 ? (
        font(9, 'b'); gfx_set(0.35, 0.35, 0.33, 1);
        note_name(n, #gka);
        gfx_measurestr(#gka, k, pc);
        gfx_x = kx + (kw - k) * 0.5; gfx_y = QY + 31 * z; gfx_drawstr(#gka);
      );
    );
    n += 1;
  );
  n = g_klo;
  while (n <= g_khi) (
    is_black(n) ? (
      kx = floor(sx(kb_left(n)));
      dn = KDN[n] > 0 || n == g_kn;
      amp = n >= split && n <= split + 12 ? min(1, HAMP[n - split] * 2.5) : 0;
      gfx_set(0, 0, 0, 0.45); gfx_rect(kx + 2 * z, QY, bw * z, (bh + 3) * z, 1);
      gfx_gradrect(kx, QY, bw * z, (dn ? bh - 2 : bh) * z, 0.05, 0.05, 0.055, 1, 0, 0, 0, 0, 0.12 / (bh * z), 0.12 / (bh * z), 0.12 / (bh * z), 0);
      amp > 0.002 ? ( gfx_set(0.96, 0.52, 0.18, 0.2 + 0.6 * amp); gfx_rect(kx, QY, bw * z, bh * z, 1); );
      dn ? ( gfx_set(0.96, 0.52, 0.18, 0.8); gfx_rect(kx + z, QY + (bh - 9) * z, bw * z - 2 * z, 6 * z, 1); );
    );
    n += 1;
  );
  gfx_set(0.96, 0.52, 0.18, 1);
  box(kb_left(split) - 1, 536, 2, 48);

  hit(26, 538, 1068, 44) ? (
    hn = kb_key_at(mouse_x, mouse_y);
    hn >= 0 ? (
      note_name(hn, #gka);
      hn >= split ? sprintf(#ghint, "%s plucks string %d of the strum plate (click or drag to play). The mod wheel strums too", #gka, hn - split + 1) :
      chord_keys ? sprintf(#ghint, "%s: chord key (Intervals mode: lowest held key is the root, the others set the chord type)", #gka) :
      sprintf(#ghint, "%s: %s %s button (hold keys of one root in several rows to combine)", #gka, GRT[hn % 12],
              (floor(((split - 1) - hn) / 12) % 3) == 0 ? "MAJOR" : ((floor(((split - 1) - hn) / 12) % 3) == 1 ? "MINOR" : "7TH"));
    );
  );
  (mouse_click && hit(26, 538, 1068, 44)) ? (
    mouse_click = 0;
    hn = kb_key_at(mouse_x, mouse_y);
    hn >= 0 ? ( g_kn = hn; gq(144, hn, 100); );
  );
  g_kn >= 0 && (mouse_cap & 1) ? (
    hn = kb_key_at(mouse_x, mouse_y);
    hn >= 0 && hn != g_kn ? ( gq(128, g_kn, 0); g_kn = hn; gq(144, hn, 100); );
  );
);

function apply_preset(p) local(i) (
  i = 1;
  loop(23,
    i != 10 && i != 11 && i != 12 ? set_sl(i, GSDEF[i]);
    i += 1;
  );
  p == 1 ? ( set_sl(7, 1); set_sl(8, 84); set_sl(3, 60); ) :
  p == 2 ? ( set_sl(3, 90); set_sl(5, 20); set_sl(13, 1); set_sl(15, 30); ) :
  p == 3 ? ( set_sl(7, 6); set_sl(8, 112); ) :
  p == 4 ? ( set_sl(7, 9); ) :
  p == 5 ? ( set_sl(7, 8); ) :
  p == 6 ? ( set_sl(2, -1); set_sl(3, 100); set_sl(13, 1); set_sl(14, 80); set_sl(15, 40); );
  i = 1;
  loop(23, i != 10 && i != 11 && i != 12 ? automate(i, 1); i += 1;);
);

function gfx_setup() local(i) (
  i = 1;
  loop(25, GSMIN[i] = 0; GSMAX[i] = 100; GSDEF[i] = 50; GSSTEP[i] = 0.1; GSSKEW[i] = 1; i += 1;);
  GSMIN[1] = 36; GSMAX[1] = 84; GSDEF[1] = 60; GSSTEP[1] = 1;
  GSMIN[2] = -2; GSMAX[2] = 1; GSDEF[2] = 0; GSSTEP[2] = 1;
  GSDEF[4] = 80; GSDEF[6] = 60;
  GSMAX[7] = 12; GSDEF[7] = 0; GSSTEP[7] = 1;
  GSMIN[8] = 60; GSMAX[8] = 240; GSDEF[8] = 100; GSSTEP[8] = 1;
  GSDEF[9] = 70;
  GSMIN[10] = -100; GSMAX[10] = 100; GSDEF[10] = 0;
  GSMAX[11] = 24; GSDEF[11] = 2; GSSTEP[11] = 1;
  GSMAX[12] = 1; GSDEF[12] = 0.5; GSSTEP[12] = 0.01;
  GSMAX[13] = 1; GSDEF[13] = 0; GSSTEP[13] = 1;
  GSDEF[14] = 60; GSDEF[15] = 30;
  GSMIN[16] = 0.2; GSMAX[16] = 30; GSDEF[16] = 2.5; GSSTEP[16] = 0.01; GSSKEW[16] = log(0.5) / log((3 - 0.2) / (30 - 0.2));
  GSMAX[17] = 250; GSDEF[17] = 10; GSSKEW[17] = log(0.5) / log(40 / 250);
  GSDEF[18] = 100;
  GSMIN[19] = 500; GSMAX[19] = 20000; GSDEF[19] = 9000; GSSTEP[19] = 1; GSSKEW[19] = log(0.5) / log((4000 - 500) / (20000 - 500));
  GSMIN[20] = 500; GSMAX[20] = 20000; GSDEF[20] = 16000; GSSTEP[20] = 1; GSSKEW[20] = GSSKEW[19];
  GSMAX[21] = 200; GSDEF[21] = 100;
  GSMAX[22] = 150; GSDEF[22] = 100;
  GSMAX[23] = 1; GSDEF[23] = 0; GSSTEP[23] = 1;
  GSMAX[24] = 1; GSDEF[24] = 0; GSSTEP[24] = 1;
  GSMAX[25] = 1; GSDEF[25] = 1; GSSTEP[25] = 1;
  GSNAME[1] = "Split"; GSNAME[2] = "Harp octave"; GSNAME[3] = "Sustain"; GSNAME[4] = "Harp level"; GSNAME[5] = "Chord level";
  GSNAME[6] = "Bass level"; GSNAME[7] = "Rhythm"; GSNAME[8] = "Tempo (transport stopped)"; GSNAME[9] = "Rhythm level";
  GSNAME[10] = "Fine tune"; GSNAME[11] = "Pitch bend range"; GSNAME[12] = "Volume"; GSNAME[13] = "Reverb";
  GSNAME[14] = "Reverb size"; GSNAME[15] = "Reverb mix"; GSNAME[16] = "Reverb decay"; GSNAME[17] = "Reverb pre-delay";
  GSNAME[18] = "Reverb diffusion"; GSNAME[19] = "Reverb damping"; GSNAME[20] = "Reverb input tone"; GSNAME[21] = "Reverb modulation";
  GSNAME[22] = "Reverb width"; GSNAME[23] = "Reverb freeze"; GSNAME[24] = "Chord keys"; GSNAME[25] = "Auto bass";
  GNN[0] = "C"; GNN[1] = "C#"; GNN[2] = "D"; GNN[3] = "D#"; GNN[4] = "E"; GNN[5] = "F";
  GNN[6] = "F#"; GNN[7] = "G"; GNN[8] = "G#"; GNN[9] = "A"; GNN[10] = "A#"; GNN[11] = "B";
  GRT[0] = "C"; GRT[1] = "Db"; GRT[2] = "D"; GRT[3] = "Eb"; GRT[4] = "E"; GRT[5] = "F";
  GRT[6] = "F#"; GRT[7] = "G"; GRT[8] = "Ab"; GRT[9] = "A"; GRT[10] = "Bb"; GRT[11] = "B";
  GCPC[0] = 1; GCPC[1] = 8; GCPC[2] = 3; GCPC[3] = 10; GCPC[4] = 5; GCPC[5] = 0;
  GCPC[6] = 7; GCPC[7] = 2; GCPC[8] = 9; GCPC[9] = 4; GCPC[10] = 11; GCPC[11] = 6;
  GRN[0] = "OFF"; GRN[1] = "ROCK 1"; GRN[2] = "ROCK 2"; GRN[3] = "SLOW ROCK"; GRN[4] = "SWING"; GRN[5] = "WALTZ"; GRN[6] = "LATIN"; GRN[7] = "FOXTROT"; GRN[8] = "COUNTRY"; GRN[9] = "DISCO"; GRN[10] = "MARCH"; GRN[11] = "BLUES"; GRN[12] = "TANGO";
  g_setup = 1;
  g_drag = -1;
  g_hn = 0;
  g_strum = 0;
  g_lpc = g_mpc = g_hpc = -1;
  g_kn = -1;
  g_lmask = g_mmask = g_hmask = 0;
);

!g_setup ? gfx_setup();
g_wheel = mouse_wheel; mouse_wheel = 0;
mouse_click = (mouse_cap & 1) && !(g_lcap & 1);
mouse_rclick = (mouse_cap & 2) && !(g_lcap & 2);
!(mouse_cap & 1) ? (
  g_drag = -1;
  g_strum = 0;
  g_mmask = 0;
  g_kn >= 0 ? ( gq(128, g_kn, 0); g_kn = -1; );
);
g_lcap = mouse_cap;
strcpy(#ghint, "");
g_tipi = -1;

gfx_set(0.10, 0.10, 0.105, 1);
gfx_rect(0, 0, gfx_w, gfx_h, 1);
gfx_set(0.17, 0.17, 0.18, 1);
box(0, 0, gW0, gH0);
gfx_set(0.05, 0.05, 0.055, 1);
box(0, 0, gW0, 62);

font(22, 'b');
gfx_set(0.97, 0.96, 0.92, 1);
text_l("STRUM UND DRANG", 22, 12);
font(9, 'b');
orange();
text_l("CHORD HARP + RHYTHM BOX", 286, 22);
font(9, 0);
lab();
text_l("by chmaha  ·  based on KoniSynth by k0n1m4k1", 24, 42);
btn(940, 18, 150, 28, "PRESETS...", 0) ? (
  gfx_x = mouse_x; gfx_y = mouse_y;
  g_pm = gfx_showmenu("Rock 1|Strum|Latin|Disco|Country|Deep Jukebox");
  g_pm > 0 ? apply_preset(g_pm);
);
hit(940, 18, 150, 28) ? hint("Factory presets (Fine Tune, Bend Range and Volume are kept)");

knob(60, 124, 17, 3, "SUSTAIN");
knob(140, 124, 17, 4, "HARP");
knob(220, 124, 17, 5, "CHORD");
knob(300, 124, 17, 6, "BASS");
gfx_set(0, 0, 0, 0.25); box(352, 78, 1, 90);
knob(400, 124, 17, 1, "SPLIT");
font(9, 'b'); lab();
text_c("HARP OCTAVE", 520, 88);
g_r = seg4(452, 110, 136, 26, octave);
g_r > -9 ? tap_sl(2, g_r);
hit(452, 110, 136, 26) ? hint("Octave of the strum plate: its 13 zones span four octaves from the chord");
gfx_set(0, 0, 0, 0.25); box(620, 78, 1, 90);
knob(670, 124, 17, 8, "TEMPO");
knob(750, 124, 17, 9, "RHYTHM");
gfx_set(0, 0, 0, 0.25); box(802, 78, 1, 90);
knob(850, 124, 17, 10, "FINE TUNE");
knob(930, 124, 17, 11, "BEND");
knob(1040, 128, 23, 12, "VOLUME");

gfx_set(0, 0, 0, 0.25); box(14, 178, gW0 - 28, 1);
font(9, 'b'); lab();
text_l("RHYTHM", 26, 188);
gk = 0;
loop(13,
  btn(26 + gk * 82, 206, 78, 24, GRN[gk], rhythm == gk) ? tap_sl(7, gk);
  hit(26 + gk * 82, 206, 78, 24) ? hint(gk ? "Rhythm with auto bass. Synced while REAPER plays; with the transport stopped it runs at TEMPO" : "No rhythm: the bass sounds once when you press a chord");
  gk += 1;
);
g_rn = rhythm > 0 ? R_N[rhythm - 1] : 16;
g_st = rhythm > 0 && om_step >= 0 ? om_step % g_rn : -1;
gk = 0;
loop(16,
  gk < g_rn ? led(36 + gk * 22, 244, gk == g_st);
  gk += 1;
);
font(9, 0); lab();
sprintf(#gtmp, (play_state & 1) ? "SYNCED TO REAPER  %.1f BPM" : "FREE RUNNING  %d BPM", (play_state & 1) ? tempo : rtempo);
text_l(rhythm > 0 ? #gtmp : "RHYTHM OFF", 400, 237);
font(9, 'b'); lab();
text_r("AUTO BASS", 1000, 238);
btn(1010, 236, 78, 18, auto_bass ? "ON" : "OFF", auto_bass) ? tap_sl(25, !auto_bass);
hit(1010, 236, 78, 18) ? hint(auto_bass ? "Auto bass on: the bass follows the rhythm while a chord is held (once per chord with Rhythm off)" : "Chord only: no auto bass, as the OM-84's AUTO BASS SYNC switch in its up position");

gfx_set(0, 0, 0, 0.25); box(14, 256, gW0 - 28, 1);
font(9, 'b'); lab();
text_l("MAJOR", 30, 274);
text_l("MINOR", 30, 318);
text_l("7TH", 30, 362);
g_cact = om_nkeys > 0;
g_cb = CIV[1]; g_cc = CIV[2];
g_cmask = g_cb == 4 && g_cc == 7 ? 1 : (g_cb == 3 && g_cc == 7 ? 2 : (g_cb == 4 && g_cc == 10 ? 4 : (g_cb == 4 && g_cc == 11 ? 5 :
          (g_cb == 3 && g_cc == 10 ? 6 : (g_cb == 3 && g_cc == 9 ? 3 : 7)))));
g_cpc = om_root;
gk = 0;
loop(36, chord_pad(gk % 12, floor(gk / 12)); gk += 1;);
chord_sync();
gfx_set(0.05, 0.05, 0.055, 1);
box(916, 262, 178, 122);
font(9, 'b'); orange();
text_c("CHORD", 1005, 270);
chord_name(#gcn);
font(26, 'b');
g_cact ? gfx_set(0.97, 0.96, 0.92, 1) : gfx_set(0.56, 0.56, 0.54, 1);
text_c(#gcn, 1005, 296);
g_r = seg2(926, 340, 158, 22, chord_keys, "BUTTONS", "INTERVALS");
g_r >= 0 ? tap_sl(24, g_r);
hit(926, 340, 158, 22) ? hint(chord_keys ? "Keys below Split: the lowest key is the root, the other held intervals set the chord type (KoniSynth)" :
  "Keys below Split are the buttons: the octave under Split is MAJOR, the next one down MINOR, the next 7TH. Hold several in one column to combine");
font(9, 0); lab();
note_name(max(0, split - 12), #gsp); note_name(split - 1, #gsq);
chord_keys ? strcpy(#gtmp, "ROOT + INTERVALS BELOW SPLIT") : sprintf(#gtmp, "MAJ %s-%s, MIN / 7TH BELOW", #gsp, #gsq);
text_c(#gtmp, 1005, 366);

font(9, 'b'); lab();
text_l("STRUM PLATE", 26, 400);
font(9, 0); gfx_set(0.70, 0.70, 0.68, 1);
note_name(split, #gka); note_name(split + 12, #gkb);
sprintf(#gtmp, "CLICK OR DRAG HERE  ·  KEYS %s-%s  ·  MOD WHEEL", #gka, #gkb);
text_l(#gtmp, 130, 401);
text_r("CLICK: HOLD  ·  RIGHT-CLICK: LATCH (COMBINE ROWS)", 896, 401);
plate();
keymap();

gfx_set(0, 0, 0, 0.25); box(14, 584, gW0 - 28, 1);
font(9, 'b'); lab();
text_l("PLATE REVERB", 26, 594);
btn(26, 616, 62, 24, rev_on ? "ON" : "OFF", rev_on) ? tap_sl(13, !rev_on);
hit(26, 616, 62, 24) ? hint("Plate reverb (Dattorro) on or off");
btn(96, 616, 70, 24, "FREEZE", rev_freeze) ? tap_sl(23, !rev_freeze);
hit(96, 616, 70, 24) ? hint("Freeze: holds the reverb tail indefinitely and stops new input");
knob(240, 632, 13, 14, "SIZE");
knob(344, 632, 13, 15, "MIX");
knob(448, 632, 13, 16, "DECAY");
knob(552, 632, 13, 17, "PRE-DELAY");
knob(656, 632, 13, 18, "DIFFUSION");
knob(760, 632, 13, 19, "DAMP");
knob(864, 632, 13, 20, "TONE");
knob(968, 632, 13, 21, "MOD");
knob(1072, 632, 13, 22, "WIDTH");

gfx_set(0.05, 0.05, 0.055, 1);
box(0, 666, gW0, 30);
font(9, 0);
lab();
strlen(#ghint) ? text_l(#ghint, 22, 673) : text_l("Strum und Drang: engine, rhythms and plate reverb from KoniSynth (k0n1m4k1)  -  AGPL-3.0", 22, 673);
g_tipi > 0 ? ( sl_text(g_tipi, #gkv); tooltip(g_tipx, g_tipy, #gkv); );
