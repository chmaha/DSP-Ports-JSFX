desc: Strum und Drang (Suzuki Omnichord OM-84 / KoniSynth port) by chmaha
author: chmaha
version: 1.2
changelog:
  Note names in REAPER's piano roll: the chord buttons below Split (C Major, C Minor, C 7th and so on) and the 13 strum-plate strings from Split up.
tags: instrument omnichord autoharp chord strum rhythm
about:
  Suzuki Omnichord OM-84 (1984): chord buttons, a 13-zone strum plate ("Sonic Strings"), a held chord voice,
  an automatic bass and a rhythm box with 12 rhythms, plus a Dattorro plate reverb.
  Keys below Split are chord buttons: one key = major, add the minor third for minor, the minor seventh for 7,
  both for m7, the major seventh for maj7, minor third + tritone for dim, major third + augmented fifth for aug.
  Keys from Split up are the 13 strum zones; the mod wheel also strums.
  Engine, rhythms, drum voices and plate reverb ported from KoniSynth by k0n1m4k1,
  https://github.com/k0n1m4k1/KoniSynth (AGPL-3.0). Chord voicing and harp layout follow KoniSynth's figures from
  the Chordian emulator; the rhythm patterns are KoniSynth's own.
  Suzuki and Omnichord are trademarks of their owners; no affiliation.
  JSFX version released under the GNU Affero General Public License v3.0
  Claude generated some of this code

slider1:split=60<36,84,1>-Split
slider2:octave=0<-2,1,1>-Harp Octave
slider3:sustain=50<0,100,0.1>-Sustain (%)
slider4:harp_level=80<0,100,0.1>-Harp (%)
slider5:chord_level=50<0,100,0.1>-Chord (%)
slider6:bass_level=60<0,100,0.1>-Bass (%)
slider7:rhythm=0<0,12,1{Off,Rock 1,Rock 2,Slow Rock,Swing,Waltz,Latin,Foxtrot,Country,Disco,March,Blues,Tango}>-Rhythm
slider8:rtempo=100<60,240,1>-Tempo (BPM)
slider9:rhythm_level=70<0,100,0.1>-Rhythm Level (%)
slider10:fine_tune=0<-100,100,0.1>-Fine Tune (cents)
slider11:bend_range=2<0,24,1>-Bend Range (semitones)
slider12:volume=0.5<0,1,0.01>-Volume
slider13:rev_on=0<0,1,1{Off,On}>-Reverb
slider14:rev_size=60<0,100,0.1>-Reverb Size (%)
slider15:rev_mix=30<0,100,0.1>-Reverb Mix (%)
slider16:rev_decay=2.5<0.2,30,0.01>-Reverb Decay (s)
slider17:rev_predelay=10<0,250,0.1>-Reverb Predelay (ms)
slider18:rev_diffusion=100<0,100,0.1>-Reverb Diffusion (%)
slider19:rev_damp=9000<500,20000,1>-Reverb Damp (Hz)
slider20:rev_tone=16000<500,20000,1>-Reverb Tone (Hz)
slider21:rev_mod=100<0,200,0.1>-Reverb Mod (%)
slider22:rev_width=100<0,150,0.1>-Reverb Width (%)
slider23:rev_freeze=0<0,1,1{Off,On}>-Reverb Freeze
slider24:chord_keys=0<0,1,1{Buttons (OM-84),Intervals (KoniSynth)}>-Chord Keys
slider25:auto_bass=1<0,1,1{Off,On}>-Auto Bass

in_pin:none
out_pin:Left
out_pin:Right

options:no_meter maxmem=4194304

@init
ext_noinit = gfx_ext_retina = 1;
function f32(x) local(c) ( c = x * 536870913; c - (c - x); );
function f32k(x) local(c) ( c = x * 536870913; c - (c - x); );
function clampf(x, lo, hi) ( x < lo ? lo : (x > hi ? hi : x); );

function alloc(n) local(r) instance(mp) global() ( r = mp; mp += n; memset(r, 0, n); r; );
alloc.mp = 0;
KMV = alloc(30 * 64); KHITS = alloc(64); HPH = alloc(13); HHZ = alloc(13); HAMP = alloc(13); CPH = alloc(3); BPH = alloc(1);
CIV = alloc(3); CNOTE = alloc(3); CKEY = alloc(10); CHZ = alloc(3); OM_PLUCKS = alloc(13); K78SLOT = alloc(15);
R_N = alloc(12); R_S = alloc(12); R_L = alloc(12); R_SLOT = alloc(96); R_CH = alloc(1536);
OBTN = alloc(36); BSEQ = alloc(12); HQ = alloc(192); EQ = alloc(4096); CQ = alloc(768);
LB = alloc(13); LM = alloc(13); LS = alloc(13); LW = alloc(13); KDN = alloc(128);
OBL = alloc(65536); OBR = alloc(65536);
GSMIN = alloc(32); GSMAX = alloc(32); GSDEF = alloc(32); GSSTEP = alloc(32); GSSKEW = alloc(32); GSNAME = alloc(32);
GNN = alloc(12); GRN = alloc(16); GRT = alloc(12); GCPC = alloc(12); GHK = alloc(4); GNK = alloc(4);

KM_2PI = 2 * $pi;
KM_FMAX = 1 - 2 ^ -23;
OM_07 = (0.7); OM_C01 = (0.01); OM_E4 = (0.0001); OM_055 = (0.55); OM_08 = (0.8);
OM_075 = 0.75; OM_045 = (0.45); OM_16 = (1.6); OM_025 = 0.25; OM_0001 = (0.001);
OM_HPI = ($pi / 2); OM_9999 = (0.9999); OM_015 = (0.15); OM_06 = (0.6);

function jr_next() local(sh, sl, mid, tot) instance(seed) (
  sh = floor(seed / 16777216);
  sl = seed - sh * 16777216;
  mid = sl * 1502 + sh * 15525485;
  mid -= floor(mid / 16777216) * 16777216;
  tot = sl * 15525485 + mid * 16777216 + 11;
  seed = tot - floor(tot / 281474976710656) * 281474976710656;
  floor(seed / 65536);
);
function km_noise() local(r) (
  r = f32k(kmr.jr_next()) / 4294967296;
  r > KM_FMAX ? r = KM_FMAX;
  (r * 2) - 1;
);
function km_tanh(x) local(e) (
  x > 20 ? 1 : (x < -20 ? -1 : (e = exp(2 * x); (e - 1) / (e + 1)));
);
function km_decay(t, dt) ( exp(((-t) * 2.302585) / dt); );

function bq_set(q, type, f, qq) local(w, c, al, a0) (
  w = (KM_2PI * clampf(f, 10, 0.45 * srate)) / srate;
  c = cos(w);
  al = sin(w) / (2 * qq);
  a0 = 1 + al;
  type == 0 ? (
    q[0] = al; q[1] = 0; q[2] = -al;
  ) : (type == 1 ? (
    q[0] = q[2] = 0.5 * (1 - c); q[1] = 1 - c;
  ) : (
    q[0] = q[2] = 0.5 * (1 + c); q[1] = -(1 + c);
  ));
  q[0] /= a0; q[1] /= a0; q[2] /= a0;
  q[3] = (-2 * c) / a0;
  q[4] = (1 - al) / a0;
);
function bq(q, x) local(y) (
  y = q[0] * x + q[5];
  q[5] = ((q[1] * x) - (q[3] * y)) + q[6];
  q[6] = (q[2] * x) - (q[4] * y);
  y;
);

function km_blep(t, dt) (
  t < dt ? (
    t = t / dt;
    (((t + t) - (t * t)) - 1);
  ) : (t > 1 - dt ? (
    t = (t - 1) / dt;
    ((((t * t) + t) + t) + 1);
  ) : 0);
);
function km_sq(v, k, f) local(dt, ph, plv, fm) (
  dt = f / srate;
  ph = v[7 + k] + dt;
  ph >= 1 ? ph -= 1;
  v[7 + k] = ph;
  plv = ph < 0.5 ? 1 : -1;
  fm = (ph + 1) - 0.5;
  fm >= 1 ? fm -= 1;
  plv = (plv + (km_blep(ph, dt) - km_blep(fm, dt)));
  ((0.7) * plv);
);
function km_ring(v, k, f, dt) local(ph) (
  ph = v[7 + k] + f / srate;
  ph >= 1 ? ph -= 1;
  v[7 + k] = ph;
  sin(KM_2PI * ph) * km_decay(v[6], dt);
);
function km_tom(v, f0, dt, blip) local(f) (
  f = (f0 * v[2]) * (1 + blip * exp((-v[6]) / 0.020));
  km_life = dt * v[3];
  km_ring(v, 0, f, km_life);
);

function km_filters(id, v) (
  id == 1 ? ( bq_set(v + 16, 2, 2000, 0.707); bq_set(v + 23, 1, 12000, 0.707); ) :
  id == 10 ? ( bq_set(v + 16, 0, 800, 3); ) :
  id == 3 || id == 4 || id == 5 ? ( bq_set(v + 16, 0, 9100, 3); bq_set(v + 23, 2, 6000, 0.707); ) :
  id == 11 ? ( bq_set(v + 16, 0, 4300, 4); bq_set(v + 23, 0, 4300, 4); ) :
  id == 12 || id == 13 ? ( bq_set(v + 16, 0, 6130, 8); ) :
  id == 14 ? ( bq_set(v + 16, 2, 3000, 0.7); ) :
  id == 16 ? ( bq_set(v + 16, 0, 5500, 1.5); bq_set(v + 23, 2, 2000, 0.7); ) :
  id == 17 ? ( bq_set(v + 16, 0, 5500, 1); bq_set(v + 23, 2, 1500, 0.7); ) :
  id == 18 ? ( bq_set(v + 16, 0, 5600, 4); ) :
  id == 19 || id == 20 ? ( bq_set(v + 16, 2, 5600, 2); ) :
  id == 21 ? ( bq_set(v + 16, 0, 4600, 3); bq_set(v + 23, 2, 3000, 0.7); ) :
  id == 28 ? ( bq_set(v + 16, 0, 4100, 3); ) :
  id == 29 ? ( bq_set(v + 16, 0, 2700, 4); );
);

function km_trigger(id, vel) local(v) (
  v = KMV + id * 64;
  memset(v, 0, 64);
  v[16] = v[23] = v[30] = v[37] = 1;
  v[0] = 1;
  v[1] = vel;
  v[2] = km_tu;
  v[3] = km_dc;
  v[4] = km_tone;
  v[5] = km_snappy;
  km_filters(id, v);
  km_active |= 1;
  KHITS[id] += 1;
);

function km_voice(id, v) local(t, tu, dc, y, f, tq, s, tail, env, n, jingle, rate, len, click, tick, guiro, pulse) (
  t = v[6];
  tu = v[2];
  dc = v[3];
  y = 0;
  km_life = 1;
  id == 0 ? (
    f = (62.5 * tu) * (1 + 0.6 * exp((-t) / 0.002));
    km_life = 0.081 * dc;
    y = km_tanh((1.2 + v[4]) * km_ring(v, 0, f, km_life));
  ) : id == 1 ? (
    f = km_ring(v, 0, 340 * tu, 0.06 * dc);
    n = bq(v + 23, bq(v + 16, km_noise())) * km_decay(t, 0.02 + (0.06 * v[5]) * dc);
    y = 0.2 * f + 1.6 * n;
    km_life = 0.09 * dc;
  ) : id == 2 ? (
    y = km_ring(v, 0, 1480 * tu, 0.005 * dc); km_life = 0.006 * dc;
  ) : id == 3 ? (
    y = (2.4 * bq(v + 23, bq(v + 16, km_noise()))) * km_decay(t, 0.05 * dc); km_life = 0.05 * dc;
  ) : id == 4 ? (
    tq = 0.35 * dc;
    env = t < tq ? km_decay(t, tq) : 0.1 * exp((-(t - tq)) / 0.0156);
    y = (2.1 * bq(v + 23, bq(v + 16, km_noise()))) * env;
    km_life = tq + 0.08;
  ) : id == 5 ? (
    y = (2.2 * bq(v + 23, bq(v + 16, km_noise()))) * km_decay(t, 0.02 * dc); km_life = 0.02 * dc;
  ) : id == 6 ? (
    y = km_ring(v, 0, 2630 * tu, 0.018 * dc); km_life = 0.018 * dc;
  ) : id == 7 ? (
    y = km_tom(v, 600, 0.023, 0.05);
  ) : id == 8 ? (
    y = km_tom(v, 400, 0.023, 0.05);
  ) : id == 9 ? (
    y = km_tom(v, 208, 0.08, 0.05);
  ) : id == 10 ? (
    s = km_sq(v, 0, 555 * tu) + km_sq(v, 1, 800 * tu);
    tail = 0.029 * dc;
    y = (1.2 * bq(v + 16, s)) * (0.6 * exp((-t) / 0.003) + 0.4 * exp((-t) / tail));
    km_life = 4 * tail;
  ) : id == 11 ? (
    jingle = 0.6 + 0.4 * sin((KM_2PI * 35) * t);
    y = ((4 * bq(v + 23, bq(v + 16, km_noise()))) * jingle) * km_decay(t, 0.22 * dc);
    km_life = 0.22 * dc;
  ) : id == 12 || id == 13 ? (
    rate = id == 12 ? 125 : 77;
    len = id == 12 ? 0.10 : 0.30;
    v[7] += (rate * tu) / srate;
    click = v[7] >= 1 ? 1 : 0;
    v[7] >= 1 ? v[7] -= 1;
    y = 12 * bq(v + 16, t < len * dc ? click : 0);
    km_life = len * dc;
  ) : id == 14 ? (
    s = (km_sq(v, 0, 6170 * tu) + km_sq(v, 1, 5620 * tu)) + km_sq(v, 2, 4080 * tu);
    y = (0.6 * bq(v + 16, s)) * km_decay(t, 0.05 * dc);
    km_life = 0.05 * dc;
  ) : id == 15 ? (
    y = km_tanh(1.3 * km_ring(v, 0, 65 * tu, 0.10 * dc)); km_life = 0.10 * dc;
  ) : id == 16 || id == 17 ? (
    tq = (id == 16 ? 0.12 : 0.25) * dc;
    tick = t < 0.001 ? 1 - t / 0.001 : 0;
    y = ((2 * bq(v + 23, bq(v + 16, km_noise()))) * km_decay(t, tq)) * (0.5 + v[5]) + 0.6 * tick;
    km_life = tq;
  ) : id == 18 ? (
    y = (2.5 * bq(v + 16, km_noise())) * km_decay(t, 0.06 * dc); km_life = 0.06 * dc;
  ) : id == 19 ? (
    y = (1.4 * bq(v + 16, km_noise())) * (km_decay(t, 0.05 * dc) + 0.1 * km_decay(t, 0.46 * dc));
    km_life = 0.5 * dc;
  ) : id == 20 ? (
    tq = 0.9 * dc;
    y = (1.4 * bq(v + 16, km_noise())) * km_decay(t, tq);
    km_life = tq;
  ) : id == 21 ? (
    jingle = 0.6 + 0.4 * sin((KM_2PI * 30) * t);
    y = ((2.5 * bq(v + 23, bq(v + 16, km_noise()))) * jingle) * km_decay(t, 0.2 * dc);
    km_life = 0.2 * dc;
  ) : id == 22 ? (
    y = 0.9 * km_ring(v, 0, 860 * tu, 0.12 * dc) + 0.5 * km_ring(v, 1, 4600 * tu, 0.04 * dc);
    km_life = 0.12 * dc;
  ) : id == 23 ? (
    y = km_ring(v, 0, 195 * tu, 0.18 * dc) + 0.3 * km_ring(v, 1, 390 * tu, 0.05 * dc);
    km_life = 0.18 * dc;
  ) : id == 24 ? (
    y = km_ring(v, 0, 600 * tu, 0.06 * dc); km_life = 0.06 * dc;
  ) : id == 25 ? (
    y = km_ring(v, 0, 400 * tu, 0.08 * dc); km_life = 0.08 * dc;
  ) : id == 26 ? (
    y = km_ring(v, 0, 2200 * tu, 0.04 * dc); km_life = 0.04 * dc;
  ) : id == 27 ? (
    y = km_ring(v, 0, 860 * tu, 0.025 * dc); km_life = 0.025 * dc;
  ) : id == 28 || id == 29 ? (
    guiro = id == 28;
    len = (guiro ? 0.15 : 0.4) * dc;
    rate = (guiro ? 65 : 25 * (1 - (0.5 * t) / len)) * tu;
    v[7] += rate / srate;
    pulse = v[7] >= 1 ? 1 : 0;
    v[7] >= 1 ? v[7] -= 1;
    env = guiro ? 1 : km_decay(t, len);
    y = t < len ? (6 * bq(v + 16, pulse)) * env : bq(v + 16, 0);
    km_life = len;
  );
  v[6] = t + 1 / srate;
  v[6] > km_life * 2 + 0.005 ? v[0] = 0;
  (0.5 * (y));
);

function km_render() local(id, v, sum, any, kv) (
  sum = 0;
  any = 0;
  km_active ? (
    id = 0;
    v = KMV;
    loop(30,
      v[0] ? (
        kv = (v[1] * km_voice(id, v));
        sum = (sum + kv);
        any = 1;
      );
      id += 1;
      v += 64;
    );
    km_active = any;
  );
  sum;
);

function om_blep(t, dt) (
  t < dt ? (
    t = t / dt;
    (((t + t) - (t * t)) - 1);
  ) : (t > 1 - dt ? (
    t = (t - 1) / dt;
    ((((t * t) + t) + t) + 1);
  ) : 0);
);

function om_sq(a, hz) local(dt, ph, pl, fm) (
  dt = hz / srate;
  ph = a[0] + dt;
  ph >= 1 ? ph -= 1;
  a[0] = ph;
  pl = ph < 0.5 ? 1 : -1;
  fm = (ph + 1) - 0.5;
  fm >= 1 ? fm -= 1;
  pl = (pl + (om_blep(ph, dt) - om_blep(fm, dt)));
  (OM_07 * pl);
);

function om_hz(note) ( 440 * 2 ^ ((note - 69) / 12); );

function om_prepare() local(w) (
  w = 2 * $pi;
  OM_KHARP = (1 - (exp((-w * 1500) / srate)));
  OM_KCHORD = (1 - (exp((-w * 2000) / srate)));
  OM_KBASS = (1 - (exp((-w * 350) / srate)));
  OM_CREL = (exp(-1 / (0.18 * srate)));
  OM_CDEC = (exp(-1 / (0.333 * srate)));
  OM_CATK = (exp(-1 / (0.005 * srate)));
  OM_BEND = (1 - (exp(-1 / (0.005 * srate))));
);

function om_reset() (
  memset(KMV, 0, 30 * 64);
  km_active = 0;
  oc_pos = -0.000000001;
  oc_last = -1;
  om_rhythm = -2;
  om_nkeys = 0;
  memset(OBTN, 0, 36);
  memset(HPH, 0, 13); memset(HHZ, 0, 13); memset(HAMP, 0, 13);
  om_cenv = 0;
  om_benv = 0;
  om_hl1 = om_hl2 = om_clp = om_blp = 0;
  om_lastzone = -1;
);

function om_startbass(c) local(r) (
  om_abass ? (
    r = 42 + ((om_root - 6 + 12) % 12);
    om_bnote = c == 82 ? r - 12 : (c == 102 ? r + 7 : (c == 116 ? r + CIV[1] : r));
    om_bhz = om_hz(om_bnote);
    om_benv = 1;
  );
);

function om_has(m, iv) ( (m >> iv) & 1; );

function om_update(pressed) local(low, j, m, a, b, c, root, changed, t) (
  low = 128;
  j = 0;
  loop(om_nkeys, low = min(low, CKEY[j]); j += 1;);
  m = 0;
  j = 0;
  loop(om_nkeys, m |= 1 << ((CKEY[j] - low) % 12); j += 1;);
  a = 0; b = 4; c = 7;
  om_has(m, 3) && om_has(m, 6) ? ( b = 3; c = 9; ) : (
    (om_has(m, 4) && om_has(m, 8)) && !om_has(m, 7) ? ( c = 8; ) : (
      om_has(m, 3) && om_has(m, 10) ? ( b = 3; c = 10; ) : (
        om_has(m, 11) ? ( c = 11; ) : (
          om_has(m, 10) ? ( c = 10; ) : (
            om_has(m, 3) ? ( b = 3; );
          );
        );
      );
    );
  );
  root = low % 12;
  changed = root != om_root || b != CIV[1] || c != CIV[2];
  om_root = root;
  CIV[0] = a; CIV[1] = b; CIV[2] = c;
  j = 0;
  loop(3, CNOTE[j] = 54 + ((((root + CIV[j]) - 6) + 24) % 12); j += 1;);
  CNOTE[0] > CNOTE[1] ? ( t = CNOTE[0]; CNOTE[0] = CNOTE[1]; CNOTE[1] = t; );
  CNOTE[1] > CNOTE[2] ? ( t = CNOTE[1]; CNOTE[1] = CNOTE[2]; CNOTE[2] = t; );
  CNOTE[0] > CNOTE[1] ? ( t = CNOTE[0]; CNOTE[0] = CNOTE[1]; CNOTE[1] = t; );
  CHZ[0] = om_hz(CNOTE[0]); CHZ[1] = om_hz(CNOTE[1]); CHZ[2] = om_hz(CNOTE[2]);
  pressed && (changed || om_cenv < OM_C01) ? (
    om_ctgt = 1;
    !om_running ? om_startbass(114);
  );
);

function om_pluck(zone, vel) local(note) (
  note = (CNOTE[zone % 3] + 12 * floor(zone / 3)) + 12 * om_oct;
  HHZ[zone] = om_hz(note);
  HAMP[zone] = vel;
  OM_PLUCKS[zone] += 1;
);

function om_btn(key, on) local(d, row, pc, idx, best, bs, c, m, r0, n) (
  d = (om_split - 1) - key;
  row = floor(d / 12) % 3;
  pc = key % 12;
  idx = row * 12 + pc;
  on ? (
    OBTN[idx] += 1;
    om_bseq += 1;
    BSEQ[pc] = om_bseq;
  ) : (
    OBTN[idx] = max(0, OBTN[idx] - 1);
  );
  best = -1; bs = -1;
  c = 0;
  loop(12,
    (OBTN[c] > 0 || OBTN[12 + c] > 0 || OBTN[24 + c] > 0) && BSEQ[c] > bs ? ( best = c; bs = BSEQ[c]; );
    c += 1;
  );
  best < 0 ? (
    om_nkeys = 0;
  ) : (
    m = (OBTN[best] > 0 ? 1 : 0) + (OBTN[12 + best] > 0 ? 2 : 0) + (OBTN[24 + best] > 0 ? 4 : 0);
    r0 = 48 + best;
    CKEY[0] = r0;
    n = 1;
    m == 2 ? ( CKEY[1] = r0 + 3; n = 2; );
    m == 4 ? ( CKEY[1] = r0 + 10; n = 2; );
    m == 5 ? ( CKEY[1] = r0 + 11; n = 2; );
    m == 6 ? ( CKEY[1] = r0 + 3; CKEY[2] = r0 + 10; n = 3; );
    m == 3 ? ( CKEY[1] = r0 + 3; CKEY[2] = r0 + 6; n = 3; );
    m == 7 ? ( CKEY[1] = r0 + 4; CKEY[2] = r0 + 8; n = 3; );
    om_nkeys = n;
    om_update(on);
  );
);

function om_midi(m1, m2, m3) local(st, j, found) (
  st = m1 & 240;
  st == 144 && m3 > 0 ? (
    KDN[m2] += 1;
    m2 < om_split ? (
      om_cmode ? (
        om_nkeys < 10 ? ( CKEY[om_nkeys] = m2; om_nkeys += 1; );
        om_update(1);
      ) : om_btn(m2, 1);
    ) : (
      om_pluck((m2 - om_split) % 13, (m3 * (1 / 127)));
    );
  ) : (
    st == 128 || (st == 144 && m3 == 0) ? (
      KDN[m2] = max(0, KDN[m2] - 1);
      m2 < om_split ? (
        om_cmode ? (
          j = 0; found = 0;
          while (!found && j < om_nkeys) (
            CKEY[j] == m2 ? ( om_nkeys -= 1; CKEY[j] = CKEY[om_nkeys]; found = 1; );
