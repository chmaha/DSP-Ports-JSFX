);
function emit_cnt(t, b0, b1, b2, sz) local(c, o) (
  c = b0 & 15;
  o = c * 256 + (b1 & 127);
  sz == 3 && (b0 & 0xF0) == 0x90 ? (
    memcs[o] += 1;
    memcs[o] > 1 ? emit(t, 0x80 | c, b1 & 127, 0, 3);
    emit(t, b0, b1, b2, sz);
  ) : sz == 3 && (b0 & 0xF0) == 0x80 ? (
    memcs[o] > 0 ? (
      memcs[o] -= 1;
      memcs[o] == 0 ? emit(t, b0, b1, b2, sz);
    );
  ) : emit(t, b0, b1, b2, sz);
);

function q_full() ( sv[0] >= QMAX - 1; );
function q_set(i, t, b0, b1, b2, sz) local(p) (
  p = qb + i * 5;
  p[0] = t; p[1] = b0; p[2] = b1; p[3] = b2; p[4] = sz;
);
function q_push(t, b0, b1, b2, sz) (
  !q_full() ? ( q_set(sv[0], t, b0, b1, b2, sz); sv[0] += 1; );
);
function q_ins(t, b0, b1, b2, sz) local(i) (
  !q_full() ? (
    i = sv[0];
    while (i > 0 && qb[(i - 1) * 5] > t) ( i -= 1; );
    memcpy(qb + (i + 1) * 5, qb + i * 5, (sv[0] - i) * 5);
    q_set(i, t, b0, b1, b2, sz);
    sv[0] += 1;
  );
);
function q_del(i) (
  memcpy(qb + i * 5, qb + (i + 1) * 5, (sv[0] - i - 1) * 5);
  sv[0] -= 1;
);
function q_run(lm, dec, cnted) local(i, w, p) (
  i = w = 0;
  loop(sv[0],
    p = qb + i * 5;
    p[0] < lm ? (
      cnted ? emit_cnt(p[0], p[1], p[2], p[3], p[4]) : emit(p[0], p[1], p[2], p[3], p[4]);
    ) : (
      dec ? p[0] -= samplesblock;
      w != i ? memcpy(qb + w * 5, p, 5);
      w += 1;
    );
    i += 1);
  sv[0] = w;
);
function q_find(c, k) local(i, r, p) (
  r = -1;
  i = 0;
  while (r < 0 && i < sv[0]) (
    p = qb + i * 5;
    p[4] == 3 && (p[1] & 15) == c && (p[2] & 127) == k ? r = i;
    i += 1;
  );
  r;
);
function q_dup(c, k, nd) local(i) (
  i = q_find(c, k);
  i >= 0 ? ( nd >= 0 ? qb[i * 5] = nd : q_del(i); 1; ) : 0;
);
function q_take(c, k, t) local(i) (
  while ((i = q_find(c, k)) >= 0) (
    emit(t, qb[i * 5 + 1], qb[i * 5 + 2], qb[i * 5 + 3], 3);
    q_del(i);
  );
);
function q_maxdel(c, k) local(i, r, p) (
  r = 0;
  i = 0;
  loop(sv[0],
    p = qb + i * 5;
    p[4] == 3 && (p[1] & 15) == c && (p[2] & 127) == k && ((p[1] & 0xF0) == 0x90 || (p[1] & 0xF0) == 0x80) ? r = max(r, p[0]);
    i += 1);
  r;
);
function q_purge(c) local(i, w, p) (
  i = w = 0;
  loop(sv[0],
    p = qb + i * 5;
    p[4] == 3 && (p[1] & 0xF0) != 0xF0 && (p[1] & 15) != c ? (
      w != i ? memcpy(qb + w * 5, p, 5);
      w += 1;
    );
    i += 1);
