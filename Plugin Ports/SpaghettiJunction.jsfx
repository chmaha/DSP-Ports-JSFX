      loop(11, of = rnd(cfg[i]); of != 0 ? non(et, chn, key + of, vel); i += 1);
    ) : m == 0x80 ? (
      noff(et, chn, key, vel);
      i = 1;
      loop(11, of = rnd(cfg[i]); of != 0 ? noff(et, chn, key + of, vel); i += 1);
      memci[o] = 0;
      memcm[o] = 0;
    ) : (
      fwd();
      i = 1;
      loop(11, of = rnd(cfg[i]); of != 0 && valid(key + of) ? emit(et, s0, key + of, d2, 3); i += 1);
    );
  );
);
function pre_cluster() local(i, oo, on, c, k, o) (
  i = 1;
  loop(11,
    oo = rnd(lcfg[i]);
    on = rnd(cfg[i]);
    floor(lcfg[i]) != floor(cfg[i]) && oo != on ? (
      c = 0;
      loop(16,
        k = 0;
        loop(128,
          o = c * 256 + k;
          memcm[o] != 0 && memci[o] != 0 ? (
            oo != 0 ? noff(0, c, k + oo, 0);
            on != 0 ? non(0, c, k + on, memcm[o]);
          );
          k += 1);
        c += 1);
    );
    i += 1);
);

function f_range(mdmax, byvel) local(md, lo, hi, x, o) (
  md = clamp(floor(cfg[3]), 0, mdmax);
  !(noteish() && chok()) || md == 0 ? fwd() : (
    lo = lim(floor(cfg[1]));
    hi = lim(floor(cfg[2]));
    x = byvel ? vel : key;
    o = chn * 256 + key;
    offconv() == 0x90 ? (
      (x >= lo && x <= hi) != (md == 2) ? ( fwd(); memcm[o] = vel; );
    ) : (
      memcm[o] > 0 ? fwd();
      memcm[o] = 0;
    );
  );
);
function pre_range(mdmax, byvel) local(md, lo, hi, c, k, o, x) (
  floor(lcfg[1]) != floor(cfg[1]) || floor(lcfg[2]) != floor(cfg[2]) || floor(lcfg[3]) != floor(cfg[3]) ? (
    md = clamp(floor(cfg[3]), 0, mdmax);
    lo = lim(floor(cfg[1]));
    hi = lim(floor(cfg[2]));
    c = 0;
    loop(16,
      k = 0;
      loop(128,
        o = c * 256 + k;
        memcm[o] != 0 ? (
          x = byvel ? memcm[o] : k;
          !(md != 0 && ((x >= lo && x <= hi) != (md == 2))) ? (
            emit(0, 0x80 | c, k, 0, 3);
            memcm[o] = 0;
