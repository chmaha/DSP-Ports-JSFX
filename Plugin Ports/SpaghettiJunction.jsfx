            b = 2 ^ i;
            !(((cb & b) == (oc & b)) && !(cb & b)) &&
            !(((cb & b) == (oc & b)) && hto(t0, i) == hto(t1, i) && t0 == t1) ? (
              (oc & b) ? noff(0, c, k + hto(t0, i), 0);
              (cb & b) ? non(0, c, k + hto(t1, i), memcm[o]);
            );
            i += 1);
          memci[o] = cb;
        );
        k += 1);
      c += 1);
  );
);

function f_cluster() local(i, of, m, o) (
  is_panic() ? panic_cs(et, chn, 0, 0);
  !(noteorpoly() && chok()) ? fwd() : (
    m = offconv();
    o = chn * 256 + key;
    m == 0x90 ? (
      memci[o] = 1;
      memcm[o] = vel;
