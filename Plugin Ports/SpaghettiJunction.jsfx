        );
        k += 1);
      c += 1);
  );
);
function f_keyrange() ( f_range(2, 0); );
function pre_keyrange() ( pre_range(2, 0); );
function f_velrange() ( f_range(3, 1); );
function pre_velrange() ( pre_range(3, 1); );

function init_legato() local(c) ( c = 0; loop(16, memci[c * 256] = -1000; c += 1); );
function f_legato() local(o, pv) (
  !(noteish() && chok()) ? fwd() : offconv() == 0x90 ? (
    o = chn * 256;
    pv = memci[o];
    valid(pv) ? (
      emit(et, 0x80 | chn, pv, 0, 3);
      memci[o] = -1000;
    );
    pv != key ? (
      fwd();
      memci[o] = key;
    );
  );
);
function f_toggle() local(o) (
  !(noteish() && chok()) ? fwd() : offconv() == 0x90 ? (
    o = chn * 256 + key;
    !memci[o] ? (
      fwd();
      memci[o] = 1;
    ) : (
      emit(et, 0x80 | chn, key, 0, 3);
      memci[o] = 0;
    );
  );
);
function init_nodup() ( fill_ci(-1, 256); );
function f_nodup() local(m, o, v) (
  !(esz == 3 && mst != 0xF0 && chok()) ? fwd() : (
    is_panic() ? panic_cs(et, chn, -1, -1);
    m = offconv();
    o = chn * 256;
    m == 0x90 ? (
      memcs[o + key] += 1;
      memcs[o + key] <= 1 ? fwd();
    ) : m == 0x80 ? (
      memcs[o + key] > 0 ? memcs[o + key] -= 1;
      memcs[o + key] == 0 ? fwd();
    ) : (
      v = d1 + d2 * 128;
      !(v == memci[o + (m | 1)] && sv[1] + et - memci[o + m] <= 0) ? (
        memci[o + m] = sv[1] + et;
        memci[o + (m | 1)] = v;
        fwd();
      );
    );
  );
);
function f_choke() local(chf, lo, hi, ck, rv, blk) (
  esz != 3 ? fwd() : (
    chf = clamp(floor(cfg[0]) - 1, -1, 15);
    (chf != -1 && chf != chn) || (mst != 0x90 && mst != 0x80) ? fwd() : (
      lo = lim(floor(cfg[1]));
      hi = lim(floor(cfg[2]));
      ck = lim(floor(cfg[3]));
      rv = clamp(floor(cfg[4]), 0, 2);
      blk = 0;
      mst == 0x90 && vel > 0 ? (
        key == ck ? memf[chn] = vel : key >= lo && key <= hi && memf[chn] != 0 ? (
          emit(et, 0x80 | chn, ck, rv == 0 ? 0 : rv == 1 ? memf[chn] : vel, 3);
          memf[chn] = 0;
        );
      ) : key == ck ? (
        memf[chn] == 0 ? blk = 1 : memf[chn] = 0;
      );
      !blk ? fwd();
    );
  );
);

function f_veladj() local(m, a, b, v) (
  !(noteish() && chok()) ? fwd() : (
    m = offconv();
    m == 0x90 ? (
      a = cfg[1];
      b = cfg[2];
      v = clamp(rnd(vel * (b - a) / 126 + a - (b - a) / 126 + cfg[3]), 1, 127);
    ) : (
      a = cfg[4];
      b = cfg[5];
      v = clamp(rnd(vel * (b - a) / 127 + a + cfg[6]), 0, 127);
    );
    emit(et, m | chn, d1, v, 3);
  );
);
function f_velgamma() local(m) (
  !(noteish() && chok()) ? fwd() : (
    m = offconv();
    emit(et, m | chn, d1, clamp(rnd(pow(vel / 127, m == 0x90 ? cfg[1] : cfg[2]) * 127), 1, 127), 3);
  );
);
function normrand(dev) local(u, s) (
  !nr_init ? ( nr_mem = 2 * rand(1) - 1; nr_init = 1; );
  u = 2 * rand(1) - 1;
  s = u * u + nr_mem * nr_mem;
  loop(2, s >= 1 ? ( u = 2 * rand(1) - 1; s = u * u + nr_mem * nr_mem; ); );
  s >= 1 ? u = 0;
  nr_mem = u;
  u ? dev * u * sqrt(-2 * log(s) / s) : 0;
);
function f_velrand() local(m, rf, r) (
  !(noteish() && chok()) ? fwd() : (
    m = offconv();
    rf = cfg[1];
    r = cfg[2] >= 1 ? normrand(rf) : 2 * rf * rand(1) - rf;
    emit(et, m | chn, d1, clamp(rnd(d2 + r), m == 0x90 ? 1 : 0, 127), 3);
  );
);

function init_delay() ( fill_ci(-1, 128); );
function f_delay() local(bpm, dl, rv, ro, m, o) (
  bpm = host_bpm(cfg[0], cfg[1]);
  dl = max(0, floor(srate * cfg[2] * 60 / bpm));
  rv = srate * cfg[3] * 60 / bpm;
  ro = 0;
  rv > 0 && dl > 0 ? (
    ro = -min(rv, dl);
    rv += min(rv, dl);
  );
  rv > 0 ? dl += rnd(ro + rv * rand(1));
  !q_full() && esz <= 3 ? (
    m = offconv();
    o = chn * 256 + key;
    esz == 3 && m == 0x90 ? (
      dl = max(dl, q_maxdel(chn, key));
      memci[o] = dl;
    ) : esz == 3 && m == 0x80 ? (
      memci[o] >= 0 ? dl = max(dl, memci[o]);
      memci[o] = -1;
    );
    q_push(et + dl, s0, d1, d2, esz);
  );
);
function post_delay() ( q_run(samplesblock, 1, 0); );

function ntap_bpm() ( host_bpm(cfg[1], max(cfg[2], 1)); );
function ntap_grid() ( clamp(cfg[3], 0.00390625, 16); );
function init_ntap() ( fill_ci(-1, 128); memf[0] = 120; );
function f_ntap() local(spb, gr, m, b0, o, i, n) (
  is_panic() ? (
    q_purge(chn);
    panic_cs(et, chn, -1, 0);
  );
  !(noteorpoly() && chok()) || q_full() ? fwd() : (
    gr = ntap_grid();
    spb = 60 / ntap_bpm() * srate;
    m = offconv();
    b0 = m != mst ? 0x80 | chn : s0;
    o = chn * 256 + key;
    m == 0x90 ? (
      memci[o] = et + rnd(gr * spb);
      memcm[o] = vel;
      memcs[o] == 0 ? ( memcs[o] += 1; fwd(); );
    ) : m == 0x80 ? (
      memci[o] = -1;
      memcm[o] = 0;
      memcs[o] > 0 ? (
        memcs[o] -= 1;
        memcs[o] == 0 ? fwd();
      );
    ) : fwd();
    n = clamp(cfg[4], 0, 128);
    i = 0;
    while (i < n && !q_full()) (
      q_ins(et + rnd(gr * spb * (i + 1)), b0, d1, m == 0x90 ? clamp(rnd(vel + (i + 1) * cfg[5]), 1, 127) : vel, 3);
      i += 1;
    );
  );
);
function pre_ntap() local(nb, ob, f, i, c, k) (
  cfg[4] != 0 && lcfg[4] == 0 ? (
    c = 0;
    loop(16, k = 0; loop(128, memcm[c * 256 + k] = 0; memci[c * 256 + k] = -1; k += 1); c += 1);
  );
  nb = ntap_bpm();
  memf[0] != nb || cfg[2] != lcfg[2] ? (
    ob = memf[0];
    memf[0] = nb;
    f = (ntap_grid() / nb) / (clamp(lcfg[3], 0.00390625, 16) / ob);
    i = 0;
    loop(sv[0], qb[i * 5] = rnd(qb[i * 5] * f); i += 1);
  );
);
function post_ntap() local(step, c, k, o, go) (
  step = ceil(ntap_grid() * 60 / ntap_bpm() * srate);
  cfg[4] == 0 ? (
    c = 0;
    loop(16,
      k = 0;
      loop(128,
        o = c * 256 + k;
        memcm[o] != 0 ? (
          memci[o] >= samplesblock ? memci[o] -= samplesblock : (
            go = 1;
            while (go) (
              memcm[o] = clamp(rnd(memcm[o] + cfg[5]), 1, 127);
              q_ins(memci[o], 0x80 | c, k, 0, 3);
              q_full() ? go = 0 : (
                q_ins(memci[o], 0x90 | c, k, memcm[o], 3);
                q_full() ? go = 0;
              );
              memci[o] += step;
              memci[o] >= samplesblock ? go = 0;
            );
            memci[o] -= samplesblock;
          );
        );
        k += 1);
      c += 1);
  );
  q_run(samplesblock, 1, 1);
);

function init_quantize() ( fill_ci(-1000, 128); );
function f_quantize() local(bpm, gr, spb, now, nx, dl, m, b0, o) (
  esz != 3 ? fwd() : (
    is_panic() ? (
      q_purge(chn);
      panic_cs(et, chn, -1000, 0);
    );
    !q_full() ? (
      bpm = host_bpm(cfg[0], max(cfg[1], 1));
      gr = clamp(cfg[2], 0.00390625, 4);
      spb = 60 / bpm * srate;
      now = cfg[0] && (play_state & 1) ? bpos + (et + 1) / spb : (sv[1] + et) / spb;
      nx = (now / gr - floor(now / gr)) * gr;
      dl = rnd((gr - nx) * spb);
      m = offconv();
      b0 = m != mst ? 0x80 | chn : s0;
      o = chn * 256 + key;
      m == 0x90 ? (
        memci[o] = sv[1] + dl + et;
        memcm[o] += 1;
      ) : m == 0x80 ? (
        cfg[3] && memcm[o] > 0 && sv[1] + dl + et == memci[o] ? dl = floor(dl + gr * spb);
        memcm[o] > 0 ? memcm[o] -= 1;
      );
      q_push(et + dl, b0, d1, d2, 3);
    );
  );
);
function post_quantize() ( q_run(samplesblock, 1, 1); );

function strum_time() ( floor(srate * cfg[4] * 60 / host_bpm(cfg[0], cfg[1])); );
function strum_collect() ( 1 + rnd(srate * cfg[3] / 1000); );
function rpb(x, y) local(r) ( r = rnd(y * x) / y; r - floor(r); );
function strum_proc(tm) local(mc, st, md, dir, spb, ps, rel, td, sp, vc, va, sa, sd, i, ii, nu, p, q, v, sf) (
  memi[5] > 0 && !(sv[1] - memi[4] + tm < 0 && memi[5] < 12) ? (
    mc = strum_collect();
    st = strum_time();
    md = floor(cfg[2]);
    spb = 60 / tempo * srate;
    dir = md == 1 ? 1 : md == 2 ? memi[6] != 0 :
          md == 3 ? rpb(beat_frac + (tm - mc) / spb, 12) >= 0.5 :
          md == 4 ? ( ps = rpb(beat_frac + (tm - mc) / spb, 16) * 2; ps - floor(ps) >= 0.5; ) : 0;
    memi[6] = !dir;
    rel = memi[4] - sv[1];
    td = floor(st / memi[5]);
    sp = clamp(-cfg[5] + cfg[7] * (2 * rand(1) - 1), -1, 1);
    vc = cfg[6] / -112 + cfg[8] * (2 * rand(1) - 1);
    va = abs(clamp(vc, -1, 1));
    sa = abs(sp);
    sd = sp < 0;
    i = 0;
    while (i < memi[5] && !q_full()) (
      nu = -1;
      ii = 0;
      loop(memi[5],
        p = sq + ii * 5;
        p[4] != 0 ? (
          nu < 0 ? nu = ii : (
            q = sq + nu * 5;
            (dir ? q[2] < p[2] : q[2] > p[2]) ? nu = ii;
          );
        );
        ii += 1);
      p = sq + nu * 5;
      v = trunc((p[3] & 127) - va * 56);
      v = trunc(v + va * 112 * (vc < 0 ? (i + 1) / (memi[5] + 1) : 1 - (i + 1) / (memi[5] + 1)));
      p[3] = clamp(v, 1, 127);
      sf = pow(sa + 1, (i + 1) / memi[5]) - sa;
      sd ? sf = (sf == 0 ? 0 : 1 / sqrt(sf));
      q_ins(rel + rnd(td * i * sf), p[1], p[2], p[3], p[4]);
      p[4] = 0;
      i += 1;
    );
    memi[5] = 0;
  );
);
function f_strum() local(mc, i, dup, p) (
  esz > 3 ? fwd() : (
    is_panic() ? (
      q_purge(chn);
      memi[4] = memi[5] = memi[6] = 0;
      panic_cs(et, chn, 0, -1);
    );
    !noteish() ? q_ins(et, s0, d1, d2, esz) : (
      mc = strum_collect();
      strum_proc(et);
      offconv() == 0x90 ? (
        memi[5] == 0 ? memi[4] = et + mc + sv[1];
        dup = 0;
        i = 0;
        loop(memi[5], p = sq + i * 5; p[4] == 3 && p[2] == d1 ? dup = 1; i += 1);
        !dup ? (
          p = sq + memi[5] * 5;
          p[1] = s0; p[2] = d1; p[3] = d2; p[4] = 3;
          memi[5] += 1;
        );
      ) : q_ins(et + strum_time() + mc, 0x80 | chn, d1, d2, 3);
    );
  );
);
function post_strum() (
  strum_proc(samplesblock);
  q_run(samplesblock, 1, 1);
);

function f_sostenuto() local(dl, pd, st, m) (
  dl = floor(srate * clamp(cfg[1], 0, 120));
  pd = clamp(floor(cfg[2]), 0, 3);
  esz == 3 && mst == 0xB0 && ((d1 == 64 && pd == 2) || (d1 == 66 && pd == 3)) ? memi[16 + chn] = vel > 63;
  !(noteish() && chok()) ? fwd() : (
    st = pd == 0 ? 0 : pd == 1 ? 1 : memi[16 + chn];
    m = offconv();
    m == 0x90 && st == 1 ? (
      q_dup(chn, key, -1) ? emit(et, 0x80 | chn, key, 0, 3);
      fwd();
    ) : m == 0x80 && st == 1 ? (
      !q_dup(chn, key, et + dl) ? q_push(et + dl, s0, d1, d2, 3);
    ) : fwd();
    q_run(min(et + 1, samplesblock), 0, 0);
  );
);
function pre_sostenuto() local(pd, dl, i, p, c, st, x) (
  pd = clamp(floor(cfg[2]), 0, 3);
  lcfg[1] == cfg[1] && lcfg[2] == cfg[2] && lcfg[2] < 2 ? (
    c = 0;
    loop(16, memi[32 + c] = pd & 1; c += 1);
  ) : (
    dl = rnd(srate * (cfg[1] - lcfg[1]));
    i = 0;
    loop(sv[0],
      p = qb + i * 5;
      x = 1;
      pd >= 2 ? (
        c = p[1] & 15;
        st = memi[16 + c];
        lcfg[1] == cfg[1] && st == memi[32 + c] ? x = 0;
      ) : st = pd & 1;
      x ? p[0] = (st == 0 ? 0 : max(0, p[0] + dl));
      i += 1);
    q_run(1, 0, 0);
    c = 0;
    loop(16, memi[32 + c] = pd < 2 ? pd & 1 : memi[16 + c]; c += 1);
  );
);
function post_sostenuto() ( q_run(samplesblock, 1, 0); );

function f_sustain() local(pd, fc, sty, os, fw, k, o, m) (
  pd = clamp(floor(cfg[0]), 0, 1);
  fc = cfg[1] >= 0.5;
  sty = clamp(floor(cfg[2]), 0, 1);
  o = chn * 256;
  os = memi[chn];
  fw = 1;
  esz == 3 && mst == 0xB0 && d1 == (pd ? 66 : 64) ? (
    memi[chn] = vel > 63;
    !fc ? fw = 0;
  );
  is_panic() ? (
    k = 0;
    loop(128, memcs[o + k] ? ( emit(et, 0x80 | chn, k, 0, 3); memcs[o + k] = 0; ); k += 1);
    fwd();
  ) : (
    os && !memi[chn] ? (
      k = 0;
      loop(128, memcs[o + k] && !memcm[o + k] ? ( emit(et, 0x80 | chn, k, 0, 3); memcs[o + k] = 0; ); k += 1);
    );
    !noteish() ? ( fw ? fwd(); ) : (
      m = offconv();
      memcm[o + key] = m == 0x90;
      !(memi[chn] && m == 0x80 && memcs[o + key]) ? (
        !sty || !memi[chn] ? memcs[o + key] = m == 0x90;
        fwd();
      );
    );
  );
);

function f_cc2note() local(md, b1, b2) (
  !(esz == 3 && mst == 0xB0 && chok()) ? fwd() : (
    md = clamp(floor(cfg[1]), 0, 2);
    md < 2 && key != lim(floor(cfg[2])) ? fwd() : (
      md == 0 ? ( b1 = lim(floor(cfg[3])); b2 = vel; ) :
      md == 1 ? ( b1 = vel; b2 = 64; ) : ( b1 = key; b2 = vel; );
      q_run(min(et + 1, samplesblock), 0, 0);
      q_take(chn, b1, et);
      emit(et, 0x90 | chn, b1, b2, 3);
      q_push(et + floor(srate * 0.01), 0x80 | chn, b1, 0, 3);
    );
  );
);
function post_cc2note() ( q_run(samplesblock, 1, 0); );

function f_note2cc() local(m, md, b1, b2) (
  !(noteish() && chok()) ? fwd() : (
    m = offconv();
    md = clamp(floor(cfg[1]), 0, 3);
    md == 0 && key != lim(floor(cfg[3])) ? fwd() : (
      md == 0 ? ( b1 = lim(floor(cfg[2])); b2 = vel; ) :
      md == 1 ? ( b1 = lim(floor(cfg[2])); b2 = key; ) :
      md == 2 ? ( b1 = key; b2 = vel; ) : ( b1 = key; b2 = m == 0x80 ? 0 : 127; );
      m == 0x90 || cfg[4] <= 0 || md == 3 ? emit(et, 0xB0 | chn, b1, b2, 3);
    );
  );
);
function f_note2pc() local(md, of, mv, sc) (
  !(noteish() && chok()) ? fwd() : (
    md = clamp(floor(cfg[1]), 0, 11);
    of = clamp(floor(cfg[2]), -64, 64);
    mv = lim(floor(cfg[3]));
    sc = md == 0 ? 0 : PGS[key % 12];
    sc >= 0 && ((mst == 0x90 && vel >= mv) || mv == 0) ? (
      emit(et, 0xC0 | chn, md == 0 ? ((128 + key + of) & 127) : ((256 + sc + (floor(key / 12) - md + 1) * 7 + of) & 127), 0, 2);
    );
  );
);
function f_ccmap() local(ci, co) (
  ci = lim(floor(cfg[1]));
  co = lim(floor(cfg[2]));
  esz != 3 || mst != 0xB0 || !chok() || ci != key || ci == co ? fwd() : emit(et, s0, co, d2, 3);
);
function f_scalecc() local(md, v, cm) (
  md = clamp(floor(cfg[3]), 0, 2);
  !(esz == 3 && mst == 0xB0 && chok()) || md == 0 ? fwd() : (
    (key >= lim(floor(cfg[1])) && key <= lim(floor(cfg[2]))) != (md == 2) ? (
      v = rnd(vel * cfg[4] + cfg[5]);
      cm = clamp(floor(cfg[6]), 0, 2);
      emit(et, s0, key, cm == 1 ? pmod(abs(v), 128) : cm == 2 ? pmod(v, 128) : clamp(v, 0, 127), 3);
    ) : fwd();
  );
);
function f_evblock() local(blk) (
  ((mst == 0x80 || mst == 0x90) && cfg[1] > 0) || (mst == 0xC0 && cfg[2] > 0) ||
  (mst == 0xB0 && cfg[0] > 0) || (mst == 0xA0 && cfg[3] > 0) || (mst == 0xD0 && cfg[4] > 0) ||
  (mst == 0xE0 && cfg[5] > 0) || (mst == 0xF0 && cfg[6] > 0) ? 0 :
  esz != 3 || !cfg[7] ? fwd() : (
    blk = 1;
    floor(cfg[10]) != -1 && key != lim(floor(cfg[10])) ? blk = 0;
    floor(cfg[11]) != -1 && vel != lim(floor(cfg[11])) ? blk = 0;
    !blk || !(cfg[9] == 0 || cfg[9] - 1 == chn) || mst != 0x80 + 16 * floor(cfg[8]) ? fwd();
  );
);
function f_nosense() ( s0 != 0xFE ? fwd(); );
function f_thru() ( fwd(); );

function slot_reset(s) (
  set_slot(s);
  memset(memci, 0, SLOTSZ);
  <? gen_disp("init", 4); ?>
);

function calc_cfg(s) local(k, p) (
  k = 0;
  loop(FD[ft * 4 + 3],
    p = ptr(ft, k);
    cfg[k] = pval(p, slider(PB + (s - 1) * 16 + k));
    p[9] == 2 ? cfg[k] = NVT[p[8] + cfg[k]];
    k += 1);
);

function list(n) ( EV + n * EVMAX * 6; );
function sort_ev(b, n) local(i, j, t) (
  i = 1;
  loop(n - 1,
    b[i * 6] < b[i * 6 - 6] ? (
      memcpy(TMP, b + i * 6, 6);
      t = TMP[0];
      j = i;
      while (j > 0 && b[j * 6 - 6] > t) (
        memcpy(b + j * 6, b + j * 6 - 6, 6);
        j -= 1;
      );
      memcpy(b + j * 6, TMP, 6);
    );
    i += 1);
);
function merge_in(d) local(n, c, bit) (
  icnt = 0;
  bit = 2 ^ (d - 1);
  n = 0;
  loop(9,
    (LCN[n] & bit) && CNT[n] > 0 ? (
      c = min(CNT[n], EVMAX - icnt);
      memcpy(INL + icnt * 6, list(n), c * 6);
      icnt += c;
    );
    n += 1);
  sort_ev(INL, icnt);
);

function run_slot(s) local(i, p) (
  set_slot(s);
  calc_cfg(s);
  merge_in(s);
  OL = list(s);
  ocnt = 0;
  LBY[s] ? (
    memcpy(OL, INL, icnt * 6);
    ocnt = icnt;
  ) : (
    <? gen_disp("pre", 1); ?>
    i = 0;
    loop(icnt,
      p = INL + i * 6;
      et = p[0]; s0 = p[1]; d1 = p[2]; d2 = p[3]; esz = p[4]; esx = p[5];
      mst = s0 & 0xF0;
      chn = s0 & 15;
      key = d1 & 127;
      vel = d2 & 127;
      <? gen_disp("f", 0); ?>
      i += 1);
    <? gen_disp("post", 2); ?>
  );
  memcpy(lcfg, cfg, 16);
  sv[1] += samplesblock;
  sort_ev(OL, ocnt);
  CNT[s] = ocnt;
);

function topo() local(n, d, pick) (
  n = 1;
  loop(8, IND[n] = DN[n] = 0; n += 1);
  n = 1;
  loop(8,
    LT[n] ? ( d = 1; loop(8, LT[d] && (LCN[n] & (2 ^ (d - 1))) ? IND[d] += 1; d += 1); );
    n += 1);
  nord = 0;
  loop(8,
    pick = 0;
    n = 1;
    loop(8, !pick && LT[n] && !DN[n] && IND[n] == 0 ? pick = n; n += 1);
    pick ? (
      DN[pick] = 1;
      ORD[nord] = pick;
      nord += 1;
      d = 1;
      loop(8, (LCN[pick] & (2 ^ (d - 1))) ? IND[d] -= 1; d += 1);
    );
  );
);

function send3(t, b0, b1, b2, sz) ( SB[0] = b0; SB[1] = b1; SB[2] = b2; midisend_buf(t, SB, sz); );
function panic_out() local(k) (
  k = 0;
  loop(2048,
    NOTES[k] ? send3(0, 0x80 | floor(k / 128), k % 128, 0, 3);
    NOTES[k] = 0;
    k += 1);
);
function rack_empty() local(n, e) (
  e = 1;
  n = 1;
  loop(8, ftype(n) ? e = 0; n += 1);
  e;
);
function graph_check() local(n, t, b, c, chg, e) (
  chg = !graph_ok;
  graph_ok = 1;
  e = rack_empty();
  n = 0;
  loop(9,
    n > 0 ? (
      t = ftype(n);
      t != LT[n] ? ( LT[n] = t; chg = 1; );
      b = slider(BB + n) > 0.5;
      b != LBY[n] ? ( LBY[n] = b; chg = 1; );
    );
    c = n == 0 ? (conn(0) | (e ? 256 : 0)) : LT[n] ? conn(n) : 0;
    c != LCN[n] ? ( LCN[n] = c; chg = 1; );
    n += 1);
  chg ? (
    topo();
    panic_out();
    n = 1;
    loop(8, slot_reset(n); n += 1);
  );
);
function read_input() local(pp, len, ofs) (
  OL = list(0);
  ocnt = 0;
  pp = 0;
  while ((len = midirecv_buf(ofs, POOL + pp, POOLSZ - pp)) > 0) (
    len <= 3 ? emit6(ofs, POOL[pp], POOL[pp + 1], POOL[pp + 2], len, 0) : (
      emit6(ofs, POOL[pp], 0, 0, len, POOL + pp);
      pp += len;
    );
  );
  CNT[0] = ocnt;
);
function send_out() local(i, p, t, b0, o) (
  i = 0;
  loop(icnt,
    p = INL + i * 6;
    t = clamp(floor(p[0]), 0, samplesblock - 1);
    p[4] > 3 ? midisend_buf(t, p[5], p[4]) : (
      send3(t, p[1], p[2], p[3], p[4]);
      b0 = p[1] & 0xF0;
      o = (p[1] & 15) * 128 + (p[2] & 127);
      p[4] == 3 && b0 == 0x90 && (p[3] & 127) > 0 ? NOTES[o] = 1 : p[4] == 3 && (b0 == 0x80 || b0 == 0x90) ? NOTES[o] = 0;
    );
    i += 1);
);

function process_block() local(n, tn) (
  graph_check();
  bpos = play_state & 1 ? beat_position : fbpos;
  fbpos = bpos + samplesblock * tempo / (60 * srate);
  beat_frac = bpos - floor(bpos);
  memset(CNT, 0, 10);
  read_input();
  n = 0;
  loop(nord, run_slot(ORD[n]); n += 1);
  merge_in(9);
  send_out();
  CNT[9] = icnt;
  tn = time_precise();
  n = 0;
  loop(10, CNT[n] > 0 ? ACT[n] = tn; n += 1);
);

@block
process_block();

@gfx 960 660

W0 = 960;
H0 = 660;
z = max(0.4, min(gfx_w / W0, gfx_h / H0));
ox = floor((gfx_w - W0 * z) * 0.5);
oy = 0;
now = time_precise();
down = mouse_cap & 1;
rdown = mouse_cap & 2;
mouse_click = down && !prev_down;
rclick = rdown && !prev_rdown;
dmx = (mouse_x - ox) / z;
dmy = (mouse_y - oy) / z;

CX = 24;
CY = 52;
CW = 912;
CH = 352;
BW = 150;
BH = 58;
JR = 4.5;
JIN = 11;
PLUGL = 12;
PINL = 7;
CK = 190;
CLAG = 0.2;
CD = 12;
CDROP = 50;
CYANK = 50;
CDROPK = 0.12;
CUW = 60;

function automate(s, e)
(
<?
  max_sliders > 170 ? printf("slider_automate(2^(s-1),e);") :
    loop(i = 1; 170,
      printf("  s == %d ? slider_automate(slider%d, e) :\n", i, i);
      i += 1;
    );
?> 0;
);

function sx(x) ( ox + x * z; );
function sy(y) ( oy + y * z; );
function hit(x, y, w, h) ( mouse_x >= sx(x) && mouse_x < sx(x + w) && mouse_y >= sy(y) && mouse_y < sy(y + h); );
function hitc(x, y, r) ( sqr(mouse_x - sx(x)) + sqr(mouse_y - sy(y)) <= sqr(r * z); );
function near(x, y, r) ( sqr(dmx - x) + sqr(dmy - y) <= r * r; );
function dbl_click(key) local(r) (
  r = last_click_i == key && now - last_click_t < 0.3;
  last_click_i = key;
  last_click_t = now;
  r;
);
function font(sz, fl) ( gfx_setfont(1, "Arial", sz * z, fl); );
function small_text() ( font(12, 0); gfx_set(0.70, 0.72, 0.76, 1); );
function head_text() ( font(13, 'b'); gfx_set(0.88, 0.89, 0.92, 1); );
function text_c(str, cx, y) local(tw, th) ( gfx_measurestr(str, tw, th); gfx_x = sx(cx) - tw * 0.5; gfx_y = sy(y); gfx_drawstr(str); );
function text_r(str, rx, y) local(tw, th) ( gfx_measurestr(str, tw, th); gfx_x = sx(rx) - tw; gfx_y = sy(y); gfx_drawstr(str); );
function text_l(str, lx, y) ( gfx_x = sx(lx); gfx_y = sy(y); gfx_drawstr(str); );
function text_cc(str, cx, cy) local(tw, th) ( gfx_measurestr(str, tw, th); gfx_x = sx(cx) - tw * 0.5; gfx_y = sy(cy) - th * 0.5; gfx_drawstr(str); );
function box(x, y, w, h, fill) ( gfx_rect(sx(x), sy(y), w * z, h * z, fill); );
function panel(x, y, w, h) (
  gfx_set(0.12, 0.13, 0.15, 1);
  box(x, y, w, h, 1);
  gfx_set(0.30, 0.31, 0.35, 1);
  box(x, y, w, h, 0);
);
function catcol(c, f) ( gfx_set(CATC[c * 3] * f, CATC[c * 3 + 1] * f, CATC[c * 3 + 2] * f, 1); );

function put(i, v) ( slider(i) !== v ? ( slider(i) = v; automate(i, 0); automate(i, 1); ); );
function knob_pos(p, u) ( p[10] ? sqrt(clamp01(u)) : clamp01(u); );
function pos_u(p, pos) ( p[10] ? pos * pos : pos; );
function set_par(i, p, pos) local(u) (
  u = norm(p, pval(p, pos_u(p, pos)));
  slider(i) !== u ? ( slider(i) = u; automate(i, 0); );
);

function button(x, y, w, h, label, on, dim) local(hov, cr, cg, cb, gap) (
  hov = hit(x, y, w, h);
  on ? ( cr = 0.82; cg = 0.42; cb = 0.15; ) : ( cr = 0.22; cg = 0.22; cb = 0.25; );
  gap = max(1, z);
  gfx_set(0.04, 0.04, 0.05, 1);
  gfx_rect(sx(x) - gap, sy(y) - gap, w * z + 2 * gap, h * z + 2 * gap, 1);
  gfx_set(cr * 0.6, cg * 0.6, cb * 0.6, 1);
  box(x, y, w, h, 1);
  gfx_set(cr, cg, cb, 1);
  gfx_rect(sx(x) + gap, sy(y) + gap, w * z - 2 * gap, h * z * 0.5, 1);
  gfx_set(1, 1, 1, on ? 0.22 : 0.10);
  gfx_rect(sx(x) + gap, sy(y) + gap, w * z - 2 * gap, h * z * 0.32, 1);
  gfx_set(1, 1, 1, on ? 0.4 : 0.22);
  gfx_rect(sx(x), sy(y), w * z, gap, 1);
  gfx_set(0, 0, 0, 0.3);
  gfx_rect(sx(x), sy(y) + h * z - gap, w * z, gap, 1);
  hov ? ( gfx_set(1, 1, 1, 0.08); box(x, y, w, h, 1); );
  gfx_set(0.03, 0.03, 0.04, 1);
  gfx_rect(sx(x) - gap, sy(y) - gap, w * z + 2 * gap, h * z + 2 * gap, 0);
  font(14, 0);
  gfx_set(1, 1, 1, dim ? 0.45 : 0.9);
  text_c(label, x + w * 0.5, y + (h - 14) * 0.5);
  hov && mouse_click && !dim ? ( mouse_click = 0; 1; ) : 0;
);

function beat_str(v) (
  v == 0.125 ? "1/32" : v == 0.25 ? "1/16" : v == 0.5 ? "1/8" : v == 1 ? "1/4" : v == 2 ? "1/2" :
  v == 4 ? "1 bar" : v == 8 ? "2 bars" : v == 16 ? "4 bars" : sprintf(#fmt, "%.3f b", v);
);
function fmt_par(p, v) local(f) (
  f = p[6];
  p[9] && v == p[8] ? p[7] :
  f == F_NOTE ? sprintf(#fmt, "%s%d", nn(v % 12), floor(v / 12) - 1) :
  f == F_SEMI ? sprintf(#fmt, v > 0 ? "+%d st" : "%d st", v) :
  f == F_F1 ? sprintf(#fmt, "%.1f", v) :
  f == F_F2 ? sprintf(#fmt, "%.2f", v) :
  f == F_BEAT ? beat_str(v) :
  f == F_SEC ? sprintf(#fmt, "%.2f s", v) :
  f == F_BPM ? sprintf(#fmt, "%.1f", v) :
  f == F_MS ? sprintf(#fmt, "%d ms", v) :
  f == F_PCT ? sprintf(#fmt, "%d%%", floor(v * 100 + 0.5)) :
  sprintf(#fmt, "%d", v);
);

function knob_face(x, y, r, pos, c) local(a, v, k, QX, QY, QR) (
  QX = sx(x); QY = sy(y); QR = r * z;
  gfx_set(0.05, 0.05, 0.06, 1);
  gfx_circle(QX, QY, QR + 2 * z, 1, 1);
  catcol(c, 0.55);
  gfx_circle(QX, QY, QR, 1, 1);
  catcol(c, 1);
  gfx_circle(QX, QY, QR * 0.72, 1, 1);
  gfx_set(1, 1, 1, 0.18);
  gfx_circle(QX - QR * 0.28, QY - QR * 0.28, QR * 0.42, 1, 1);
  k = 0;
  loop(9,
    v = -2.35619 + 4.71239 * k / 8;
    gfx_set(0.85, 0.85, 0.85, 0.7);
    gfx_line(QX + sin(v) * QR * 0.82, QY - cos(v) * QR * 0.82, QX + sin(v) * QR * 0.98, QY - cos(v) * QR * 0.98);
    k += 1;
  );
  a = -2.35619 + 4.71239 * pos;
  gfx_set(0.05, 0.05, 0.05, 1);
  gfx_line(QX, QY, QX + sin(a) * QR * 0.85, QY - cos(a) * QR * 0.85, 1);
);
function cell_name(str, x, y) ( font(14, 0); gfx_set(0.88, 0.88, 0.90, 1); text_c(str, x, y + 36); );

function knob_ctl(x, y, hr, i, p) local(u, pos, v, nv, hov) (
  u = slider(i);
  pos = knob_pos(p, u);
  hov = hitc(x, y, hr);
  mouse_click && hov ? (
    dbl_click(i) ? ( put(i, norm(p, p[4])); drag_i = 0; ) : (
      drag_i = i; drag_n = 1; drag_y0 = mouse_y; drag_p0 = pos;
    );
    mouse_click = 0;
  );
  drag_i == i && drag_n == 1 ? (
    down ? mouse_cap |= 65536;
    pos = clamp01(drag_p0 + (drag_y0 - mouse_y) / (200 * z) * ((mouse_cap & 12) ? 0.12 : 1));
    set_par(i, p, pos);
  );
  hov && mouse_wheel != 0 && !drag_i ? (
    v = pval(p, u);
    pos = clamp01(pos + sign(mouse_wheel) * ((mouse_cap & 4) ? 0.004 : 0.03));
    nv = pval(p, pos_u(p, pos));
    nv == v && p[5] > 0 ? nv = clamp(v + sign(mouse_wheel) * p[5], p[2], p[3]);
    put(i, norm(p, nv));
    mouse_wheel = 0;
  );
);
function pknob(x, y, i, p, c) local(u, hs) (
  hs = p[11] && pval(p - 12, slider(i - 1)) >= 1;
  !hs ? knob_ctl(x, y, 24, i, p);
  u = hs ? norm(p, clamp(tempo, p[2], p[3])) : slider(i);
  knob_face(x, y, 18, knob_pos(p, u), hs ? 0 : c);
  font(14, 0);
  gfx_set(0.85, 0.85, 0.85, 1);
  text_c(fmt_par(p, hs ? tempo : pval(p, u)), x, y - 36);
  font(12, 0);
  gfx_set(0.70, 0.70, 0.73, 1);
  text_l(fmt_par(p, p[2]), x - 50, y + 20);
  text_r(fmt_par(p, p[3]), x + 50, y + 20);
  cell_name(p[0], x, y);
);

function penum(x, y, i, p, c) local(v, hov, k, n, r) (
  v = pval(p, slider(i));
  hov = hit(x - 52, y - 14, 104, 28);
  hov && mouse_click ? (
    mouse_click = 0;
    mouse_cap & 4 ? put(i, norm(p, p[4])) : (
      n = p[3] - p[2] + 1;
      strcpy(#menu, "");
      k = 0;
      loop(n,
        k > 0 ? strcat(#menu, "|");
        p[2] + k == v ? strcat(#menu, "!");
        strcat(#menu, item(#mi, p[7], k));
        k += 1);
      gfx_x = mouse_x;
      gfx_y = mouse_y;
      r = gfx_showmenu(#menu);
      r > 0 ? put(i, norm(p, p[2] + r - 1));
    );
  );
  hov && mouse_wheel != 0 && !drag_i ? (
    put(i, norm(p, clamp(v - sign(mouse_wheel), p[2], p[3])));
    mouse_wheel = 0;
  );
  gfx_set(0.07, 0.07, 0.08, 1);
  box(x - 52, y - 14, 104, 28, 1);
  catcol(c, hov ? 0.9 : 0.6);
  box(x - 52, y - 14, 104, 28, 0);
  catcol(c, 1);
  box(x - 52, y - 14, 3, 28, 1);
  gfx_set(0.70, 0.72, 0.76, 1);
  gfx_triangle(sx(x + 38), sy(y - 3), sx(x + 46), sy(y - 3), sx(x + 42), sy(y + 3));
  font(14, 0);
  gfx_set(0.92, 0.92, 0.94, 1);
  text_c(item(#mi, p[7], pval(p, slider(i)) - p[2]), x - 4, y - 8);
  cell_name(p[0], x, y);
);

function ptog(x, y, i, p) (
  hit(x - 50, y - 14, 100, 28) && mouse_wheel != 0 && !drag_i ? (
    put(i, mouse_wheel > 0);
    mouse_wheel = 0;
  );
  button(x - 50, y - 14, 100, 28, p[0], slider(i) > 0.5, 0) ? put(i, slider(i) > 0.5 ? 0 : 1);
);

function live(n) ( n == 0 || n == 9 || slider(n) >= 0.5; );
function nx(n) ( n == 0 ? CX + 10 : n == 9 ? CX + CW - 90 : slider(XB + n); );
function ny(n) ( n == 0 || n == 9 ? CY + CH * 0.5 - 32 : slider(YB + n); );
function nw(n) ( n == 0 || n == 9 ? 80 : BW; );
function nh(n) ( n == 0 || n == 9 ? 64 : BH; );
function jy(n) ( ny(n) + (n == 0 || n == 9 ? nh(n) * 0.5 : 40); );
function jox(n) ( nx(n) + nw(n) - JIN; );
function jix(n) ( nx(n) + JIN; );
function has(s, d) ( (conn(s) & (2 ^ (d - 1))) != 0; );
function vis(s, d) ( !(s == 0 && d == 9 && rack_empty()); );
function link(s, d, on) local(m, b) (
  b = 2 ^ (d - 1);
  m = conn(s);
  put(CB + s, on ? (m | b) : m - (m & b));
);
function reach(a, b) local(vis, n) (
  vis = 2 ^ (a - 1);
  loop(9,
    n = 1;
    loop(8, (vis & (2 ^ (n - 1))) && live(n) ? vis |= conn(n); n += 1);
  );
  (vis & (2 ^ (b - 1))) != 0;
);
function can_link(s, d) ( d >= 1 && d <= 9 && s != d && live(s) && live(d) && !has(s, d) && !(d <= 8 && s >= 1 && reach(d, s)); );
function free_slot() local(s, r) ( r = 0; s = 8; loop(8, !live(s) ? r = s; s -= 1); r; );
function set_pos(n, x, y, e) (
  x = floor(clamp(x, CX + 4, CX + CW - BW - 4));
  y = floor(clamp(y, CY + 4, CY + CH - BH - 4));
  slider(XB + n) !== x ? ( slider(XB + n) = x; automate(XB + n, 0); );
  slider(YB + n) !== y ? ( slider(YB + n) = y; automate(YB + n, 0); );
  e ? ( automate(XB + n, 1); automate(YB + n, 1); );
);
function overlap(x, y) local(n, r) (
  r = 0;
  n = 1;
  loop(8, live(n) && abs(nx(n) - x) < BW + 10 && abs(ny(n) - y) < BH + 10 ? r = 1; n += 1);
  r;
);
function spot_free(x, y) local(n, r) (
  r = x >= CX + 4 && x <= CX + CW - BW - 4 && y >= CY + 4 && y <= CY + CH - BH - 4 && !overlap(x, y);
  n = 0;
  loop(2,
    r && x < nx(n) + nw(n) + 10 && x + BW + 10 > nx(n) && y < ny(n) + nh(n) + 10 && y + BH + 10 > ny(n) ? r = 0;
    n += 9);
  r;
);
function try_spot(px, py) ( x_try < 0 && spot_free(px, py) ? ( x_try = px; y_try = py; ); );
function out_feeders() local(n, m) (
  m = 0;
  n = 0;
  !rack_empty() ? loop(9, live(n) && has(n, 9) ? m |= 2 ^ n; n += 1);
  m ? m : 1;
);
function add_filter(t, x, y, route) local(s, k, src, bx, by, fm, n) (
  s = free_slot();
  s ? (
    fm = out_feeders();
    src = sel >= 1 && live(sel) ? sel : -1;
    src < 0 ? (
      n = 0;
      loop(9, (fm & (2 ^ n)) && (src < 0 || nx(n) > nx(src)) ? src = n; n += 1);
    );
    x < 0 ? (
      x_try = -1;
      bx = nx(src) + nw(src) + 40;
      by = ny(src) + (nh(src) - BH) * 0.5;
      k = 0;
      loop(15,
        try_spot(bx + floor(k / 5) * (BW + 40), by + ((k % 5) == 1 ? -80 : (k % 5) == 2 ? 80 : (k % 5) == 3 ? -160 : (k % 5) == 4 ? 160 : 0));
        k += 1);
      k = 0;
      loop(8, try_spot(CX + 120 + (k % 4) * 185, CY + 60 + floor(k / 4) * 170); k += 1);
      x_try < 0 ? ( x = CX + 120; y = CY + 60; ) : ( x = x_try; y = y_try; );
    );
    put(BB + s, 0);
    k = 0;
    loop(16, put(PB + (s - 1) * 16 + k, k < FD[t * 4 + 3] ? pdefault(t, k) : 0); k += 1);
    set_pos(s, x, y, 1);
    route ? (
      sel >= 1 && live(sel) ? (
        put(CB + s, conn(sel));
        put(CB + sel, 2 ^ (s - 1));
      ) : (
        n = 0;
        loop(9, (fm & (2 ^ n)) ? put(CB + n, (conn(n) - (conn(n) & 256)) | 2 ^ (s - 1)); n += 1);
        put(CB + s, 256);
      );
    ) : put(CB + s, 0);
    put(s, t);
    sel = s;
  );
);
function remove_slot(s) local(n, b, outs) (
  outs = conn(s);
  b = 2 ^ (s - 1);
  n = 0;
  loop(9, n != s && live(n) && (conn(n) & b) ? put(CB + n, (conn(n) - b) | outs); n += 1);
  put(CB + s, 0);
  put(BB + s, 0);
  put(s, 0);
  sel == s ? sel = 0;
);
function unlink_in(d) local(s) ( s = 0; loop(9, has(s, d) ? link(s, d, 0); s += 1); );
function node_name(dst, n) local(t, m, k, tot) (
  n == 0 ? strcpy(dst, "MIDI IN") : n == 9 ? strcpy(dst, "MIDI OUT") : (
    t = ftype(n);
    strcpy(dst, FD[t * 4]);
    k = tot = 0;
    m = 1;
    loop(8,
      live(m) && ftype(m) == t ? (
        tot += 1;
        nx(m) < nx(n) || (nx(m) == nx(n) && m < n) ? k += 1;
      );
      m += 1);
    tot > 1 ? strcat(dst, sprintf(#num, " %d", k + 1));
  );
  dst;
);
function jack_menu(j, isin) local(n, cnt, r) (
  strcpy(#jm, "");
  cnt = n = 0;
  loop(10,
    (isin ? n <= 8 && live(n) && has(n, j) && vis(n, j) : n >= 1 && live(n) && has(j, n) && vis(j, n)) ? (
      cnt > 0 ? strcat(#jm, "|");
      strcat(#jm, isin ? "Disconnect from " : "Disconnect to ");
      strcat(#jm, node_name(#nm, n));
      JL[cnt] = n;
      cnt += 1;
    );
    n += 1);
  cnt > 1 ? strcat(#jm, "|Disconnect all");
  cnt ? (
    r = gfx_showmenu(#jm);
    r >= 1 && r <= cnt ? (
      isin ? link(JL[r - 1], j, 0) : link(j, JL[r - 1], 0);
    ) : r == cnt + 1 ? (
      isin ? unlink_in(j) : put(CB + j, 0);
    );
  );
);
function add_menu(x, y) local(r) (
  gfx_x = mouse_x;
  gfx_y = mouse_y;
  r = gfx_showmenu(#addmenu);
  r > 0 ? add_filter(r, x, y, !(mouse_cap & 8));
);
function reset_params(s) local(t, k) (
  t = ftype(s);
  k = 0;
  loop(FD[t * 4 + 3], put(PB + (s - 1) * 16 + k, pdefault(t, k)); k += 1);
);
function block_at() local(n, r) (
  r = 0;
  n = 1;
  loop(8, live(n) && dmx >= nx(n) && dmx < nx(n) + BW && dmy >= ny(n) && dmy < ny(n) + BH ? r = n; n += 1);
  sel >= 1 && live(sel) && dmx >= nx(sel) && dmx < nx(sel) + BW && dmy >= ny(sel) && dmy < ny(sel) + BH ? r = sel;
  r;
);
function out_jack_at() local(n, r) ( r = -1; n = 0; loop(9, live(n) && near(jox(n), jy(n), JR + 8) ? r = n; n += 1); r; );
function in_jack_at() local(n, r) ( r = -1; n = 1; loop(9, live(n) && near(jix(n), jy(n), JR + 8) ? r = n; n += 1); r; );
function in_canvas() ( dmx >= CX && dmx < CX + CW && dmy >= CY && dmy < CY + CH; );

function rope_init(r, x0, y0, x1, y1) local(p) (
  p = RP + r * 8;
  memset(p, 0, 8);
  p[4] = (x0 + x1) * 0.5;
  p[5] = (y0 + y1) * 0.5;
  RI[r] = 1;
);
function rope_copy(dst, src) ( memcpy(RP + dst * 8, RP + src * 8, 8); RI[dst] = 1; );
function low_y(y0, yc, y3) local(i, t, u, m) (
  m = max(y0, y3);
  i = 1;
  loop(15,
    t = i / 16;
    u = 1 - t;
    m = max(m, u * u * u * y0 + 3 * u * t * yc + t * t * t * y3);
    i += 1);
  m;
);
function rope_target(r, x0, y0, x1, y1) local(p, v, goal, lo, hi, md) (
  p = RP + r * 8;
  v = sin(r * 12.9898) * 43758.5453;
  v = 0.8 + 0.4 * (v - floor(v));
  goal = min(max(y0, y1) + (CDROP + CDROPK * abs(x1 - x0) + 0.05 * abs(y1 - y0)) * v * CSL, CY + CH - 6);
  goal = max(goal, max(y0, y1) + 6);
  lo = min(y0, y1);
  hi = lo + 2000;
  loop(16,
    md = (lo + hi) * 0.5;
    low_y(y0, md, y1) < goal ? lo = md : hi = md);
  p[6] = 0;
  p[7] = lo - (y0 + y1) * 0.5;
);
function rope_lim(p, lm) local(dv) (
  dv = sqrt(sqr(p[0] - p[6]) + sqr(p[1] - p[7]));
  dv > lm ? (
    p[0] = p[6] + (p[0] - p[6]) * lm / dv;
    p[1] = p[7] + (p[1] - p[7]) * lm / dv;
  );
);
function rope_step(r, x0, y0, x1, y1, h) local(p, mx2, my2, dv, lm) (
  p = RP + r * 8;
  mx2 = (x0 + x1) * 0.5;
  my2 = (y0 + y1) * 0.5;
  dv = sqrt(sqr(p[0] - p[6]) + sqr(p[1] - p[7]));
  lm = max(dv, sqrt(sqr(p[6]) + sqr(p[7])) * 0.4);
  p[0] -= (mx2 - p[4]) * CLAG;
  p[1] -= (my2 - p[5]) * CLAG;
  rope_lim(p, lm);
  p[4] = mx2;
  p[5] = my2;
  p[2] += (CK * (p[6] - p[0]) - CD * p[2]) * h;
  p[3] += (CK * (p[7] - p[1]) - CD * p[3]) * h;
  p[0] += p[2] * h;
  p[1] += p[3] * h;
  rope_lim(p, lm);
);
function cub(a, b, c, d, t) local(u) ( u = 1 - t; u * u * u * a + 3 * u * u * t * b + 3 * u * t * t * c + t * t * t * d; );
function cable_geo(r, x0, y0, x1, y1) local(p, k, f) (
  p = RP + r * 8;
  QX0 = x0; QY0 = y0; QX3 = x1; QY3 = y1;
  k = max(0, CUW - abs(x1 - x0)) * 0.5 * (x1 >= x0 ? 1 : -1);
  f = clamp((abs(x1 - x0) - CUW) / 500, 0, 1) / 3 * (x1 - x0);
  QX1 = x0 - k + f + p[0];
  QX2 = x1 + k - f + p[0];
  QY1 = QY2 = (y0 + y1) * 0.5 + p[1];
);
function rope_smooth(r, x0, y0, x1, y1) local(i) (
  cable_geo(r, x0, y0, x1, y1);
  i = 0;
  loop(25,
    SM[i * 2] = sx(cub(QX0, QX1, QX2, QX3, i / 24));
    SM[i * 2 + 1] = sy(cub(QY0, QY1, QY2, QY3, i / 24));
    i += 1);
  SMN = 25;
);
function seg_norm(i) local(l) (
  SAX = SM[i * 2]; SAY = SM[i * 2 + 1];
  SBX = SM[i * 2 + 2]; SBY = SM[i * 2 + 3];
  l = max(0.001, sqrt(sqr(SBX - SAX) + sqr(SBY - SAY)));
  SUX = (SAY - SBY) / l;
  SUY = (SBX - SAX) / l;
  SUY < 0 ? ( SUX = -SUX; SUY = -SUY; );
);
function rope_pass(ox2, oy2, hw) local(i, k) (
  i = 0;
  loop(SMN - 1,
    seg_norm(i);
    k = -hw;
    loop(floor(hw * 2) + 1,
      gfx_line(SAX + ox2 + SUX * k, SAY + oy2 + SUY * k, SBX + ox2 + SUX * k, SBY + oy2 + SUY * k, 1);
      k += 1);
    i += 1);
);
function tube(hw) local(i, k, f, lt, sp) (
  i = 0;
  loop(SMN - 1,
    seg_norm(i);
    k = -hw;
    while (k <= hw) (
      f = k / hw;
      lt = 0.38 + 0.62 * sqrt(max(0, 1 - f * f));
      sp = 0.28 * exp(-sqr((f + 0.45) / 0.22));
      gfx_set(min(1, CCR * lt + sp), min(1, CCG * lt + sp), min(1, CCB * lt + sp), 1);
      gfx_line(SAX + SUX * k, SAY + SUY * k, SBX + SUX * k, SBY + SUY * k, 1);
      k += 0.5;
    );
    i += 1);
);
function cable_rgb(s) local(c, gr) (
  c = s ? FD[ftype(s) * 4 + 1] * 3 : 0;
  gr = (CATC[c] + CATC[c + 1] + CATC[c + 2]) / 3;
  CCR = CATC[c] * 0.72 + gr * 0.16;
  CCG = CATC[c + 1] * 0.72 + gr * 0.16;
  CCB = CATC[c + 2] * 0.72 + gr * 0.16;
);
function plug_cap(x, y, hot) (
  gfx_set(0.03, 0.03, 0.035, 1);
  gfx_circle(sx(x), sy(y), JR * z, 1, 1);
  gfx_set(0.24, 0.25, 0.27, 1);
  gfx_circle(sx(x), sy(y), JR * z, 0, 1);
  gfx_set(0.11, 0.11, 0.12, 1);
  gfx_circle(sx(x), sy(y), (JR - 1.6) * z, 1, 1);
  hot ? (
    gfx_set(0.35, 0.90, 0.55, 1);
    gfx_circle(sx(x), sy(y), (JR + 3.5) * z, 0, 1);
  );
);
function plug_free(x, y) local(yt) (
  yt = y - PLUGL;
  gfx_set(0, 0, 0, 0.3);
  box(x - 3, yt + 2, 8, PLUGL, 1);
  gfx_set(0.62, 0.64, 0.67, 1);
  box(x - 1.6, yt - PINL, 3.2, PINL, 1);
  gfx_set(0.86, 0.87, 0.89, 1);
  box(x - 1.6, yt - PINL, 0.8, PINL, 1);
  gfx_set(0.10, 0.10, 0.11, 1);
  box(x - 1.6, yt - PINL * 0.55, 3.2, 0.8, 1);
  gfx_set(0.72, 0.73, 0.76, 1);
  gfx_circle(sx(x), sy(yt - PINL), 1.6 * z, 1, 1);
  gfx_set(0.62, 0.64, 0.67, 1);
  box(x - 4.5, yt - 1.5, 9, 1.5, 1);
  gfx_set(0.09, 0.09, 0.10, 1);
  box(x - 4, yt, 8, PLUGL - 3, 1);
  gfx_set(0.30, 0.31, 0.34, 1);
  box(x - 4, yt, 1.5, PLUGL - 3, 1);
  gfx_set(CCR, CCG, CCB, 1);
  box(x - 4, yt + PLUGL - 7, 8, 2.5, 1);
  gfx_set(0.07, 0.07, 0.08, 1);
  box(x - 2.5, y - 3, 5, 3, 1);
);
function draw_cable(r, s, x0, y0, x1, y1, fr) (
  cable_rgb(s);
  rope_smooth(r, x0, y0, x1, y1);
  fr != 1 ? plug_cap(x0, y0, fr == 3);
  fr != 2 ? plug_cap(x1, y1, fr == 4);
  gfx_set(0, 0, 0, 0.08);
  rope_pass(2.5 * z, 6 * z, 3.5 * z);
  gfx_set(0, 0, 0, 0.16);
  rope_pass(1.5 * z, 3.5 * z, 2.2 * z);
  tube(2 * z);
  gfx_set(CCR * 0.85, CCG * 0.85, CCB * 0.85, 1);
  fr != 1 ? gfx_circle(sx(x0), sy(y0), 1.8 * z, 1, 1);
  fr != 2 ? gfx_circle(sx(x1), sy(y1), 1.8 * z, 1, 1);
  fr == 1 ? plug_free(x0, y0);
  fr == 2 ? plug_free(x1, y1);
);
function hexagon(x, y, r) local(i) (
  i = 1;
  loop(4,
    gfx_triangle(sx(x + r), sy(y),
      sx(x + r * cos(i * 1.0472)), sy(y + r * sin(i * 1.0472)),
      sx(x + r * cos((i + 1) * 1.0472)), sy(y + r * sin((i + 1) * 1.0472)));
    i += 1);
);
function jack(x, y, st) (
  gfx_set(0, 0, 0, 0.4);
  hexagon(x + 0.8, y + 1.2, JR + 3.2);
  st == 1 ? gfx_set(0.30, 0.75, 0.45, 1) : st == 2 ? gfx_set(0.75, 0.28, 0.24, 1) : gfx_set(0.40, 0.41, 0.44, 1);
  hexagon(x, y, JR + 3);
  st == 1 ? gfx_set(0.45, 0.92, 0.60, 1) : st == 2 ? gfx_set(0.92, 0.40, 0.34, 1) : gfx_set(0.64, 0.66, 0.69, 1);
  hexagon(x, y - 0.6, JR + 2.2);
  gfx_set(0.20, 0.21, 0.23, 1);
  gfx_circle(sx(x), sy(y), JR * z, 1, 1);
  gfx_set(0.02, 0.02, 0.03, 1);
  gfx_circle(sx(x), sy(y), (JR - 1.5) * z, 1, 1);
);
function led(x, y, n) local(a) (
  a = max(0, 1 - (now - ACT[n]) / 0.25);
  gfx_set(0.05, 0.05, 0.06, 1);
  gfx_circle(sx(x), sy(y), 4.5 * z, 1, 1);
  gfx_set(0.15 + 0.20 * a, 0.25 + 0.70 * a, 0.15 + 0.30 * a, 1);
  gfx_circle(sx(x), sy(y), 3 * z, 1, 1);
);
function jack_state(n, isin) (
  isin ? (
    mode == 2 && near(jix(n), jy(n), JR + 8) ? ( can_link(csrc, n) ? 1 : 2; ) : 0;
  ) : (
    mode == 3 && near(jox(n), jy(n), JR + 8) ? ( can_link(n, cdst) ? 1 : 2; ) : 0;
  );
);
function io_block(n, label) local(x, y, k) (
  x = nx(n);
  y = ny(n);
  gfx_set(0.17, 0.18, 0.20, 1);
  box(x, y, 80, 64, 1);
  gfx_set(0.36, 0.37, 0.41, 1);
  box(x, y, 80, 64, 0);
  gfx_set(0.05, 0.05, 0.06, 1);
  gfx_circle(sx(x + 40), sy(y + 24), 12 * z, 1, 1);
  gfx_set(0.50, 0.52, 0.55, 1);
  gfx_circle(sx(x + 40), sy(y + 24), 12 * z, 0, 1);
  k = 0;
  loop(5,
    gfx_circle(sx(x + 40 + 7 * cos(3.14159 * k / 4 + 3.14159)), sy(y + 24 - 7 * sin(3.14159 * k / 4)), 1.5 * z, 1, 1);
    k += 1);
  font(12, 'b');
  gfx_set(0.88, 0.89, 0.92, 1);
  text_c(label, x + 40, y + 44);
  led(x + 70, y + 10, n);
  n == 0 ? jack(jox(0), jy(0), jack_state(0, 0)) : jack(jix(9), jy(9), jack_state(9, 1));
);
function draw_block(n) local(x, y, t, c, i) (
  x = nx(n);
  y = ny(n);
  t = ftype(n);
  c = FD[t * 4 + 1];
  gfx_set(0, 0, 0, 0.35);
  box(x + 3, y + 4, BW, BH, 1);
  gfx_set(0.20, 0.21, 0.24, 1);
  box(x, y, BW, BH, 1);
  gfx_set(0.25, 0.26, 0.29, 1);
  box(x, y + 6, BW, 18, 1);
  catcol(c, 1);
  box(x, y, BW, 5, 1);
  gfx_set(0.42, 0.43, 0.47, 1);
  i = 0;
  loop(2, gfx_circle(sx(x + 6 + i * (BW - 12)), sy(y + BH - 6), 2 * z, 1, 1); i += 1);
  font(13, 'b');
  gfx_set(0.93, 0.93, 0.95, 1);
  text_c(FD[t * 4], x + BW * 0.5, y + 9);
  led(x + BW * 0.5, y + BH - 12, n);
  LBY[n] ? (
    gfx_set(0, 0, 0, 0.5);
    box(x, y, BW, BH, 1);
    font(12, 'b');
    gfx_set(0.90, 0.50, 0.20, 1);
    text_cc("BYPASSED", x + BW * 0.5, y + (24 + BH - 16.5) * 0.5);
  ) : (
    font(12, 0);
    catcol(c, 1.15);
    text_cc(catname(c), x + BW * 0.5, y + (24 + BH - 16.5) * 0.5);
  );
  sel == n ? gfx_set(0.82, 0.42, 0.15, 1) : gfx_set(0.38, 0.39, 0.43, 1);
  box(x, y, BW, BH, 0);
  sel == n ? box(x + 1, y + 1, BW - 2, BH - 2, 0);
  jack(jix(n), jy(n), jack_state(n, 1));
  jack(jox(n), jy(n), jack_state(n, 0));
);
function cable_at() local(s, d, r, i) (
  r = -1;
  s = 0;
  loop(9,
    d = 1;
    loop(9,
      live(s) && live(d) && has(s, d) && vis(s, d) && RI[s * 10 + d] ? (
        cable_geo(s * 10 + d, jox(s), jy(s), jix(d), jy(d));
        i = 1;
        loop(31,
          near(cub(QX0, QX1, QX2, QX3, i / 32), cub(QY0, QY1, QY2, QY3, i / 32), 8) ? r = s * 10 + d;
          i += 1);
      );
      d += 1);
    s += 1);
  r;
);

CSL = pval(SLK, slack);
dt = min(max(now - last_frame, 0), 0.1);
last_frame = now;
nsub = min(6, ceil(dt * 120));

gfx_getchar() == 6579564 && sel >= 1 && live(sel) && mode == 0 ? remove_slot(sel);

in_canvas() && !drag_i && mode == 0 ? (
  mouse_click ? (
    (j = out_jack_at()) >= 0 ? (
      mode = 2;
      csrc = j;
      rope_init(99, jox(j), jy(j), jox(j), jy(j));
    ) : (j = in_jack_at()) >= 1 ? (
      mode = 3;
      cdst = j;
      rope_init(99, jix(j), jy(j), jix(j), jy(j));
    ) : (j = cable_at()) >= 0 ? (
      mode = 4;
      gpair = j;
      gx0 = dmx;
      gy0 = dmy;
      gp0 = RP[j * 8];
      gp1 = RP[j * 8 + 1];
    ) : (j = block_at()) >= 1 ? (
      sel = j;
      mode = 1;
      dnode = j;
      doffx = dmx - nx(j);
      doffy = dmy - ny(j);
    ) : sel = 0;
    mouse_click = 0;
  );
  rclick ? (
    gfx_x = mouse_x;
    gfx_y = mouse_y;
    (j = in_jack_at()) >= 1 ? (
      jack_menu(j, 1);
    ) : (j = out_jack_at()) >= 0 ? (
      jack_menu(j, 0);
    ) : (j = block_at()) >= 1 ? (
      sel = j;
      r = gfx_showmenu(LBY[j] ? "!Bypass|Remove|Disconnect|Reset parameters" : "Bypass|Remove|Disconnect|Reset parameters");
      r == 1 ? put(BB + j, LBY[j] ? 0 : 1) :
      r == 2 ? remove_slot(j) :
      r == 3 ? (
        put(CB + j, 0);
        unlink_in(j);
      ) :
      r == 4 ? reset_params(j);
    ) : (j = cable_at()) >= 0 ? (
      gfx_showmenu("Disconnect cable") == 1 ? link(floor(j / 10), j % 10, 0);
    ) : free_slot() ? add_menu(dmx - BW * 0.5, dmy - BH * 0.5);
  );
);

mode == 1 ? (
  set_pos(dnode, dmx - doffx, dmy - doffy, !down);
  !down ? mode = 0;
);
mode == 2 && !down ? (
  j = in_jack_at();
  j >= 1 && can_link(csrc, j) ? (
    link(csrc, j, 1);
    rope_copy(csrc * 10 + j, 99);
  );
  RI[99] = 0;
  mode = 0;
);
mode == 4 && !down ? (
  sqrt(sqr(dmx - gx0) + sqr(dmy - gy0)) > CYANK ? link(floor(gpair / 10), gpair % 10, 0);
  mode = 0;
);
mode == 3 && !down ? (
  j = out_jack_at();
  j >= 0 && can_link(j, cdst) ? (
    link(j, cdst, 1);
    rope_copy(j * 10 + cdst, 99);
  );
  RI[99] = 0;
  mode = 0;
);

gfx_set(0.13, 0.13, 0.15, 1);
gfx_rect(0, 0, gfx_w, gfx_h, 1);

font(20, 'b');
gfx_set(0.85, 0.35, 0.35, 1);
text_l("SPAGHETTI JUNCTION", 24, 8);
font(13, 0);
gfx_set(0.60, 0.60, 0.63, 1);
text_l("by chmaha", 26, 30);
button(816, 12, 120, 28, "ADD FILTER", 0, !free_slot()) ? add_menu(-1, -1);
knob_ctl(738, 26, 14, 170, SLK);
knob_face(738, 26, 10, knob_pos(SLK, slack), 0);
font(12, 0);
gfx_set(0.70, 0.72, 0.76, 1);
text_r("CABLE SLACK", 722, 20);
text_l(fmt_par(SLK, pval(SLK, slack)), 754, 20);

gfx_set(0.09, 0.095, 0.11, 1);
box(CX, CY, CW, CH, 1);
gfx_set(1, 1, 1, 0.05);
j = 0;
loop(floor(CW / 24) - 1,
  i = 0;
  loop(floor(CH / 24) - 1, box(CX + 24 + j * 24, CY + 24 + i * 24, 1.5, 1.5, 1); i += 1);
  j += 1);
gfx_set(0.30, 0.31, 0.35, 1);
box(CX, CY, CW, CH, 0);

io_block(0, "MIDI IN");
io_block(9, "MIDI OUT");
n = 1;
loop(8, live(n) && n != sel ? draw_block(n); n += 1);
sel >= 1 && live(sel) ? draw_block(sel);

s = 0;
loop(9,
  d = 1;
  loop(9,
    r = s * 10 + d;
    live(s) && live(d) && has(s, d) && vis(s, d) ? (
      !RI[r] ? rope_init(r, jox(s), jy(s), jix(d), jy(d));
      rope_target(r, jox(s), jy(s), jix(d), jy(d));
      loop(nsub, rope_step(r, jox(s), jy(s), jix(d), jy(d), 1 / 120));
      mode == 4 && r == gpair ? (
        RP[r * 8] = gp0 + (dmx - gx0) / 0.75;
        RP[r * 8 + 1] = gp1 + (dmy - gy0) / 0.75;
        RP[r * 8 + 2] = RP[r * 8 + 3] = 0;
      );
      draw_cable(r, s, jox(s), jy(s), jix(d), jy(d), 0);
    ) : RI[r] = 0;
    d += 1);
  s += 1);

mode == 4 && sqrt(sqr(dmx - gx0) + sqr(dmy - gy0)) > CYANK ? (
  font(12, 'b');
  gfx_set(0.95, 0.40, 0.32, 1);
  text_l("release to unplug", dmx + 14, dmy - 6);
);
mode == 2 ? (
  j = in_jack_at();
  j >= 1 && can_link(csrc, j) ? ( ex = jix(j); ey = jy(j); fr = 4; ) : ( ex = dmx; ey = dmy + PLUGL + PINL; fr = 2; );
  rope_target(99, jox(csrc), jy(csrc), ex, ey);
  loop(nsub, rope_step(99, jox(csrc), jy(csrc), ex, ey, 1 / 120));
  draw_cable(99, csrc, jox(csrc), jy(csrc), ex, ey, fr);
);
mode == 3 ? (
  j = out_jack_at();
  j >= 0 && can_link(j, cdst) ? ( ex = jox(j); ey = jy(j); fr = 3; ) : ( j = 0; ex = dmx; ey = dmy + PLUGL + PINL; fr = 1; );
  rope_target(99, ex, ey, jix(cdst), jy(cdst));
  loop(nsub, rope_step(99, ex, ey, jix(cdst), jy(cdst), 1 / 120));
  draw_cable(99, j, ex, ey, jix(cdst), jy(cdst), fr);
);

panel(24, 412, 912, 240);
sel >= 1 && !live(sel) ? sel = 0;
sel >= 1 ? (
  t = ftype(sel);
  c = FD[t * 4 + 1];
  catcol(c, 1);
  box(24, 412, 4, 240, 1);
  head_text();
  text_l(FD[t * 4], 40, 422);
  small_text();
  text_l(FD[t * 4 + 2], 40, 440);
  button(724, 420, 100, 26, "BYPASS", LBY[sel], 0) ? put(BB + sel, LBY[sel] ? 0 : 1);
  button(836, 420, 92, 26, "REMOVE", 0, 0) ? remove_slot(sel);
  sel >= 1 ? (
    FD[t * 4 + 3] == 0 ? (
      small_text();
      text_c("No parameters", 480, 548);
    );
    np = FD[t * 4 + 3];
    r0 = np > 8 ? ceil(np / 2) : np;
    k = 0;
    loop(np,
      p = ptr(t, k);
      x = 480 + (k >= r0 ? k - r0 - (np - r0 - 1) * 0.5 : k - (r0 - 1) * 0.5) * 114;
      y = np > 8 ? (k >= r0 ? 592 : 502) : 547;
      i = PB + (sel - 1) * 16 + k;
      p[1] == KN ? pknob(x, y, i, p, c) : p[1] == EN ? penum(x, y, i, p, c) : ptog(x, y, i, p);
      k += 1);
  );
) : (
  font(15, 'b');
  gfx_set(0.88, 0.89, 0.92, 1);
  text_c("GETTING STARTED", 480, 466);
  font(14, 0);
  gfx_set(0.72, 0.74, 0.78, 1);
  text_c("Right-click the canvas or use ADD FILTER: inserts after the selected block, else at the chain's end (Shift: unpatched).", 480, 494);
  text_c("Drag between an output jack (right side) and an input jack (left side), in either direction, to add a cable.", 480, 518);
  text_c("Pull a cable well away and release to unplug it. An output can feed several inputs; an input merges all its cables.", 480, 542);
  text_c("Right-click cables, jacks or blocks to disconnect, bypass, remove or reset. Delete removes the selected block.", 480, 566);
  text_c("Drag blocks to arrange them and click one to edit it. Notes still sounding are released whenever the patch changes.", 480, 590);
);

!down && drag_i ? (
  j = 0;
  loop(drag_n, automate(drag_i + j, 1); j += 1; );
  drag_i = 0;
);
prev_down = down;
prev_rdown = rdown;
