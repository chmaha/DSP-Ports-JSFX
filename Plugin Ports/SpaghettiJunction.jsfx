    );
  );
);
function pre_chord() local(same, nc, i, ns, os, c, k, o, t0, t1, oc, cb, b) (
  same = 1;
  nc = 0;
  i = 0;
  loop(12,
    cfg[i + 3] != 0 ? nc |= 2 ^ i;
    floor(lcfg[i + 3]) != floor(cfg[i + 3]) ? same = 0;
    i += 1);
  floor(lcfg[1]) != floor(cfg[1]) ? same = 0;
  !same && !floor(cfg[2]) ? (
    ns = clamp(floor(cfg[1]), 0, 11);
    os = clamp(floor(lcfg[1]), 0, 11);
    c = 0;
    loop(16,
      k = 0;
      loop(128,
        o = c * 256 + k;
        memcm[o] != 0 && memci[o] != -1000 ? (
          t0 = (k + 12 - os) % 12;
          t1 = (k + 12 - ns) % 12;
          oc = memci[o];
          cb = MAJ[t1] ? nc : 1;
          i = 0;
