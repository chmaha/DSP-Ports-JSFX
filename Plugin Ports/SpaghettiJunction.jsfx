);

function host_bpm(src, man) local(b) ( b = src ? tempo : man; b <= 0 ? 60 : b; );

function f_chfilt() ( esz > 3 || !isch() || cfg[chn] > 0 ? fwd(); );
function f_chsingle() ( esz > 3 || !isch() || cfg[0] == chn + 1 ? fwd(); );
function f_chmap() (
  esz > 3 || !isch() ? fwd() : cfg[chn] != 0 ? emit6(et, mst | limc(floor(cfg[chn] - 1)), d1, d2, esz, esx);
);
function f_unison() local(cs, cd) (
  fwd();
  cs = limc(floor(cfg[0]) - 1);
  cd = limc(floor(cfg[1]) - 1);
  !(cs == cd || mst == 0xF0 || mst < 0x80 || chn != cs || esz > 3) ? emit(et, mst | cd, d1, d2, esz);
);
function f_keychan() local(km) (
  !noteish() ? fwd() : (
    km = clamp(floor(cfg[key % 12]), 0, 16);
    km > 0 ? emit(et, mst | (km - 1), d1, d2, 3);
  );
);
function init_keysplit() local(k) ( k = 0; loop(128, memi[k] = -1000; k += 1); );
function f_keysplit() local(m, c0, c1, lo, cs, tr) (
  !(esz == 3 && (mst == 0x80 || mst == 0x90 || mst == 0xA0 || mst == 0xB0) && chok()) ? fwd() : (
    m = offconv();
    c0 = limc(floor(cfg[2]) - 1);
    c1 = limc(floor(cfg[4]) - 1);
    lo = key < lim(floor(cfg[1]));
    cs = m | (lo ? c0 : c1);
    tr = rnd(lo ? cfg[3] : cfg[5]);
    m == 0x90 || m == 0xA0 ? (
      emit(et, cs, lim(key + tr), d2, 3);
      m == 0x90 ? memi[key] = tr;
    ) : m == 0x80 ? (
      emit(et, cs, lim(key + memi[key]), d2, 3);
      memi[key] = -1000;
    ) : (
      c0 != c1 ? emit(et, m | c0, d1, d2, 3);
      emit(et, m | c1, d1, d2, 3);
    );
  );
);

function mirror(k, inv, tr) ( (inv <= 0 ? k : inv - (k - inv)) + tr; );
function init_transpose() ( fill_ci(-1000, 128); );
function f_transpose() local(m, n, o) (
  !(noteorpoly() && chok()) ? fwd() : (
    m = offconv();
    o = chn * 256 + key;
    n = m == 0x80 ? key + memci[o] : mirror(key, rnd(cfg[2]), rnd(cfg[1]));
    valid(n) ? emit(et, s0, n, d2, 3);
    m == 0x90 ? (
      memcm[o] = vel;
      memci[o] = n - key;
    ) : m == 0x80 ? (
      memcm[o] = 0;
      memci[o] = -1000;
    );
  );
);
function pre_transpose() local(tr, inv, c, k, o, n) (
  rnd(lcfg[1]) != rnd(cfg[1]) || rnd(lcfg[2]) != rnd(cfg[2]) ? (
    tr = rnd(cfg[1]);
    inv = rnd(cfg[2]);
    c = 0;
    loop(16,
      k = 0;
      loop(128,
        o = c * 256 + k;
        memcm[o] ? (
