          keymap(k) >= -12 && valid(n) ? (
            memci[o] = n - k;
            non(0, c, n, memcm[o]);
          ) : (
            memcm[o] = 0;
            memci[o] = -1000;
          );
        );
        k += 1);
      c += 1);
  );
);

function onscale(sc, k) ( MAJ[(k - sc + 12) % 12]; );
function f_enforce() local(sc, md, tp, ok, m, n, o) (
  is_panic() ? panic_cs(et, chn, 0, -1);
  !(noteorpoly() && chok()) ? fwd() : (
    sc = clamp(floor(cfg[1]), 0, 11);
    md = clamp(floor(cfg[2]), 0, 2);
    tp = 0;
    ok = 1;
    !onscale(sc, key) ? ( md == 1 ? tp = -1 : md == 2 ? tp = 1 : ok = 0; );
    ok && valid(key + tp) ? ( onscale(sc, key + tp) ? (
      m = offconv();
      o = chn * 256;
      m == 0x90 ? (
        non(et, chn, key + tp, vel);
        memci[o + key] = tp;
      ) : m == 0x80 ? (
        n = key + memci[o + key];
        valid(n) && memcs[o + n] > 0 ? (
          noff(et, chn, n, vel);
          memci[o + key] = 0;
        );
      ) : emit(et, s0, key + tp, d2, 3);
    ); );
  );
);
function pre_enforce() local(sc, c, k, o) (
  floor(lcfg[1]) != floor(cfg[1]) ? (
    sc = clamp(floor(cfg[1]), 0, 11);
    c = 0;
    loop(16,
      k = 0;
      loop(128,
        o = c * 256 + k;
        memcs[o] != 0 ? (
          onscale(sc, k) ? memci[o] = 0 : (
            emit(0, 0x80 | c, k, 0, 3);
            memcs[o] = 0;
            memci[o] = 0;
          );
        );
        k += 1);
      c += 1);
  );
);

function hto(b, i) ( CHT[b * 12 + i]; );
function init_chord() ( fill_ci(-1000, 128); );
function f_chord() local(sc, cb, i, tk, m, o, oc) (
  sc = clamp(floor(cfg[1]), 0, 11);
  cb = 0;
  i = 0;
  loop(12, cfg[i + 3] > 0 ? cb |= 2 ^ i; i += 1);
  is_panic() ? panic_cs(et, chn, -1000, 0);
  !(noteorpoly() && chok()) ? fwd() : (
    tk = (key + 12 - sc) % 12;
    !MAJ[tk] ? cb = 1;
    m = offconv();
    o = chn * 256 + key;
    m == 0x90 ? (
      memci[o] = cb;
      memcm[o] = vel;
      i = 0;
      loop(12, (cb & (2 ^ i)) ? non(et, chn, key + hto(tk, i), vel); i += 1);
    ) : m == 0x80 ? (
      oc = memci[o];
      oc > 0 ? ( i = 0; loop(12, (oc & (2 ^ i)) ? noff(et, chn, key + hto(tk, i), vel); i += 1); );
