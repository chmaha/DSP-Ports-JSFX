          n = mirror(k, inv, tr);
          emit(0, 0x90 | c, lim(n), memcm[o], 3);
          memci[o] = n - k;
        );
        k += 1);
      c += 1);
  );
);

function keymap(k) ( clamp(floor(cfg[1 + k % 12]), -13, 12); );
function init_notemap() ( fill_ci(-1000, 128); );
function f_notemap() local(m, n, o, ok) (
  is_panic() ? panic_cs(et, chn, -1000, 0);
  !(noteorpoly() && chok()) ? fwd() : (
    m = offconv();
    o = chn * 256 + key;
    n = key + keymap(key);
    ok = keymap(key) >= -12 && valid(n);
    m == 0x90 ? (
      ok ? (
        non(et, chn, n, vel);
        memcm[o] = vel;
        memci[o] = n - key;
      );
    ) : m == 0x80 ? (
      noff(et, chn, key + memci[o], vel);
      memcm[o] = 0;
      memci[o] = -1000;
    ) : ok ? emit(et, s0, n, d2, 3);
  );
);
function pre_notemap() local(same, i, c, k, o, n) (
  same = 1;
  i = 1;
  loop(12, floor(lcfg[i]) != floor(cfg[i]) ? same = 0; i += 1);
  !same ? (
    c = 0;
    loop(16,
      k = 0;
      loop(128,
        o = c * 256 + k;
        memcm[o] && floor(lcfg[1 + k % 12]) != floor(cfg[1 + k % 12]) ? (
          noff(0, c, k + memci[o], 0);
