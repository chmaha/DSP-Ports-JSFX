slider1:p_mode=0.6<0,1,0.001>-Mode
slider2:p_width=0.75<0,1,0.001>-S Width
slider3:p_skew=0.5<0,1,0.001>-S Pan
slider4:p_centre=0.75<0,1,0.001>-M Level
slider5:p_bal=0.5<0,1,0.001>-M Pan
slider6:p_out=0.5<0,1,0.001>-Output

in_pin:Left input
in_pin:Right input
out_pin:Left output
out_pin:Right output
options:no_meter

@init

ext_noinit = gfx_ext_retina = 1;
ext_nodenorm = 1;

IM_FIX = 1;

function itrunc(x) ( x < 0 ? ceil(x) : floor(x); );

function im_set() local(w, k, c, b, g, m)
(
  w = 4 * p_width - 2;
  k = 2 * p_skew;
  c = 4 * p_centre - 2;
  b = 2 * p_bal;
  g = 10 ^ (2 * p_out - 1);
  m = itrunc(p_mode * 3.9);
  m == 0 ? (
    im_rl = g * c * (2 - b);
    im_ll = g * w * (2 - k);
    im_rr = g * c * b;
    im_lr = -g * w * k;
  ) : m == 1 ? (
    im_ll = g * c * (2 - b);
    im_rl = g * w * (2 - k);
    im_lr = g * c * b;
    im_rr = -g * w * k;
  ) : m == 2 ? (
    g *= 0.5;
    im_ll = g * (c * (2 - b) + w * (2 - k));
    im_rl = g * (c * (2 - b) - w * (2 - k));
    im_lr = g * (c * b - w * k);
    im_rr = g * (c * b + w * k);
  ) : m == 3 ? (
    g *= 0.5;
    im_ll = g * (2 - b) * (2 - k);
    im_rl = g * (2 - b) * k;
    IM_FIX ? (
      im_lr = g * b * (2 - k);
      im_rr = -g * b * k;
    ) : (
      im_lr = -g * b * (2 - k);
      im_rr = g * b * k;
    );
  );
);

im_set();

@slider

last_srate != srate ? (
  last_srate = srate;
  meter_decay = 0.001 ^ (1 / (0.4 * srate));
);
im_set();

@block

im_set();

@sample

im_a = spl0; im_b = spl1;
spl1 = im_rr * im_b + im_lr * im_a;
spl0 = im_ll * im_a + im_rl * im_b;

im_m = max(abs(im_a), abs(im_b));
im_m > ipk ? ipk = im_m : ipk *= meter_decay;
im_m = max(abs(spl0), abs(spl1));
im_m > opk ? opk = im_m : opk *= meter_decay;

@gfx 760 380

DW = 760;
DH = 380;
scale = max(0.5, min(gfx_w / DW, gfx_h / DH));
ox = floor((gfx_w - DW*scale) * 0.5);
oy = 0;

MARGIN = 14*scale;
CW = 112*scale;
KR = 30*scale;
PANEL_H = 128*scale;

function automate(s, end_touch)
(
<?
  max_sliders > 6 ? printf("slider_automate(2^(s-1), end_touch);") :
    printf("s == 1 ? slider_automate(p_mode, end_touch) : s == 2 ? slider_automate(p_width, end_touch) : s == 3 ? slider_automate(p_skew, end_touch) : s == 4 ? slider_automate(p_centre, end_touch) : s == 5 ? slider_automate(p_bal, end_touch) : s == 6 ? slider_automate(p_out, end_touch) :");
?> 0;
);
function set_slider(s, gv) ( slider(s) = gv; automate(s, 0); automate(s, 1); );
function hit_circle(mx, my, cx, cy, rad) ( sqr(mx - cx) + sqr(my - cy) <= sqr(rad); );
function hit_rect(mx, my, x, y, w, h) ( mx >= x && mx <= x+w && my >= y && my <= y+h; );
function g_trunc(x) ( x < 0 ? ceil(x) : floor(x); );
function g_int(x) ( g_trunc(x + (x < 0 ? -0.000001 : 0.000001)); );

function set_norm(s, v)
local(old)
(
  old = slider(s);
  slider(s) = floor(v*1000 + 0.5) / 1000;
  slider(s) !== old ? automate(s, 0);
);

function upper(str)
local(i, c)
(
  i = 0;
  loop(strlen(str),
    c = str_getchar(str, i);
    (c >= 97 && c <= 122) ? str_setchar(str, i, c - 32);
    i += 1;
  );
  str;
);

function draw_knob(cx, cy, rad, pos, cr, cg, cb, valtext, name)
local(ang0, ang1, ang, i, tx, ty)
(
  ang0 = -2.35619;
  ang1 =  2.35619;
  gfx_set(0.05, 0.05, 0.06, 1);
  gfx_circle(cx, cy, rad + 2*scale, 1, 1);
  gfx_set(cr*0.55, cg*0.55, cb*0.55, 1);
  gfx_circle(cx, cy, rad, 1, 1);
  gfx_set(cr, cg, cb, 1);
  gfx_circle(cx, cy, rad*0.72, 1, 1);
  gfx_set(1, 1, 1, 0.18);
  gfx_circle(cx - rad*0.28, cy - rad*0.28, rad*0.42, 1, 1);
  i = 0;
  loop(9,
    ang = ang0 + (ang1 - ang0) * (i / 8);
    gfx_set(0.85, 0.85, 0.85, 0.7);
    gfx_line(cx + sin(ang)*rad*0.82, cy - cos(ang)*rad*0.82, cx + sin(ang)*rad*0.98, cy - cos(ang)*rad*0.98, 1);
    i += 1;
  );
  ang = ang0 + (ang1 - ang0) * pos;
  gfx_set(0.05, 0.05, 0.05, 1);
  gfx_line(cx, cy, cx + sin(ang)*rad*0.85, cy - cos(ang)*rad*0.85, 1);
  gfx_setfont(1, "Arial", 14*scale);
  gfx_set(0.85, 0.85, 0.85, 1);
  gfx_measurestr(valtext, tx, ty);
  gfx_x = cx - tx*0.5; gfx_y = cy - rad - 18*scale;
  gfx_drawstr(valtext);
  gfx_set(0.8, 0.8, 0.82, 1);
  gfx_measurestr(name, tx, ty);
  gfx_x = cx - tx*0.5; gfx_y = cy + rad + 7*scale;
  gfx_drawstr(name);
);

function lcd_touch(s) ( lcd_sl = s; lcd_t = time_precise(); );

function def_val(s) ( s == 1 ? 0.6 : (s == 2 || s == 4) ? 0.75 : 0.5; );

function knob_name(s)
(
  s == 1 ? "Mode" : s == 2 ? "S Width" : s == 3 ? "S Pan" : s == 4 ? "M Level" : s == 5 ? "M Pan" : "Output";
);

function mode_name(m) ( m == 0 ? "SM->LR" : m == 1 ? "MS->LR" : m == 2 ? "LR->LR" : "LR->MS"; );

function hint_text(s)
(
  s == 1 ? "Mode: SM->LR / MS->LR decode mid-side inputs, LR->LR adjusts stereo, LR->MS encodes to mid (left) and side (right)" :
  s == 2 ? "S Width: side level, -200 to +200 %; 0 % is mono, negative values flip the side polarity" :
  s == 3 ? "S Pan: moves the side signal towards the left or right output" :
  s == 4 ? "M Level: mid (centre) level, -200 to +200 %; negative values flip the mid polarity" :
  s == 5 ? "M Pan: moves the mid signal towards the left or right output" :
  s == 6 ? "Output: overall level, plus or minus 20 dB" :
  "Drag or scroll a knob to adjust  ·  Ctrl for fine control  ·  double-click to reset";
);

function ptext(s)
(
  s == 1 ? strcpy(#ptxt, mode_name(g_trunc(p_mode * 3.9))) :
  s == 2 ? sprintf(#ptxt, "%d%%", g_int(400 * p_width - 200)) :
  s == 3 ? sprintf(#ptxt, "%d L<>R", g_int(200 * p_skew - 100)) :
  s == 4 ? sprintf(#ptxt, "%d%%", g_int(400 * p_centre - 200)) :
  s == 5 ? sprintf(#ptxt, "%d L<>R", g_int(200 * p_bal - 100)) :
  sprintf(#ptxt, "%d dB", g_int(40 * p_out - 20));
  #ptxt;
);

function row_begin(y, nk, ns)
(
  rx = ox + (DW*scale - (nk*CW + ns*8*scale + (ns - 1)*10*scale)) * 0.5;
  ry = oy + y;
);

function sec(nk, title, cr, cg, cb)
local(w, tw, th)
(
  w = nk*CW + 8*scale;
  gfx_set(0.035, 0.035, 0.04, 1);
  gfx_rect(rx - scale, ry - scale, w + 2*scale, PANEL_H + 2*scale, 1);
  gfx_set(0.125, 0.125, 0.14, 1);
  gfx_rect(rx, ry, w, PANEL_H, 1);
  gfx_set(cr, cg, cb, 0.8);
  gfx_rect(rx, ry, w, max(1, 2*scale), 1);
  gfx_setfont(1, "Arial", 12*scale, 'b');
  gfx_set(cr*0.75 + 0.15, cg*0.75 + 0.15, cb*0.75 + 0.15, 1);
  gfx_measurestr(title, tw, th);
  gfx_x = rx + (w - tw)*0.5; gfx_y = ry + 5*scale;
  gfx_drawstr(title);
  k_sx = rx + 4*scale; k_col = 0;
  k_r = cr; k_g = cg; k_b = cb;
  rx += w + 10*scale;
);

function seg_btn(s, x, y, w, h, label, act, fs)
local(tw, th, gap, hov)
(
  hov = hit_rect(mouse_x, mouse_y, x, y, w, h);
  hov ? hov_s = s;
  gap = max(1, scale);
  gfx_set(0.03, 0.03, 0.04, 1);
  gfx_rect(x - gap, y - gap, w + 2*gap, h + 2*gap, 1);
  act ? gfx_set(acc_r*0.62, acc_g*0.62, acc_b*0.62, 1) : gfx_set(hov ? 0.17 : 0.14, hov ? 0.17 : 0.14, hov ? 0.19 : 0.16, 1);
  gfx_rect(x, y, w, h, 1);
  act ? gfx_set(acc_r, acc_g, acc_b, 1) : gfx_set(0.21, 0.21, 0.24, 1);
  gfx_rect(x + gap, y + gap, w - 2*gap, h*0.5, 1);
  gfx_set(1, 1, 1, act ? 0.22 : 0.08);
  gfx_rect(x + gap, y + gap, w - 2*gap, h*0.3, 1);
  gfx_setfont(1, "Arial", fs*scale, 'b');
  act ? gfx_set(0.08, 0.08, 0.10, 1) : gfx_set(0.78, 0.78, 0.80, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + (w - tw)*0.5; gfx_y = y + (h - th)*0.5;
  gfx_drawstr(label);
  mouse_just_down && hov;
);

function knob_at(s, cx, cy, rad, cr, cg, cb)
local(hov, gv)
(
  hov = hit_circle(mouse_x, mouse_y, cx, cy, rad + 4*scale);
  hov ? hov_s = s;
  (mouse_just_down && hov) ? (
    (click_target == s && time_precise() - click_time < 0.3) ? (
      set_slider(s, def_val(s));
      drag_target = 0;
      lcd_touch(s);
    ) : (
      drag_target = s; drag_y0 = mouse_y; drag_v0 = slider(s); drag_fine = mouse_cap & 4;
    );
    click_target = s; click_time = time_precise();
  );
  (hov && mouse_wheel != 0 && drag_target == 0) ? (
    gv = slider(s) + (mouse_wheel / 120) * ((mouse_cap & 4) ? 0.001 : 0.01);
    set_norm(s, max(0, min(1, gv)));
    automate(s, 1);
    lcd_touch(s);
    mouse_wheel = 0;
  );
  draw_knob(cx, cy, rad, slider(s), cr, cg, cb, ptext(s), knob_name(s));
);

function knob(s)
local(cx, cy)
(
  cx = k_sx + CW*(k_col + 0.5);
  cy = ry + 72*scale;
  k_col += 1;
  knob_at(s, cx, cy, KR, k_r, k_g, k_b);
);

function glow_text(str, x, y, r, g, b)
(
  gfx_set(r, g, b, 0.16);
  gfx_x = x - scale; gfx_y = y; gfx_drawstr(str);
  gfx_x = x + scale; gfx_y = y; gfx_drawstr(str);
  gfx_x = x; gfx_y = y - scale; gfx_drawstr(str);
  gfx_x = x; gfx_y = y + scale; gfx_drawstr(str);
  gfx_set(r, g, b, 1);
  gfx_x = x; gfx_y = y; gfx_drawstr(str);
);

function meter(x, y, w, h, pk, label)
local(db, fy, tw, th)
(
  gfx_setfont(1, "Arial", 11*scale, 'b');
  gfx_set(0.62, 0.63, 0.66, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + w*0.5 - tw*0.5; gfx_y = y;
  gfx_drawstr(label);
  y += th + 3*scale;
  h -= th + 3*scale;
  gfx_set(0.04, 0.04, 0.05, 1);
  gfx_rect(x - scale, y - scale, w + 2*scale, h + 2*scale, 1);
  gfx_set(acc_r*0.22, acc_g*0.22, acc_b*0.22, 1);
  gfx_rect(x, y, w, h, 1);
  db = pk > 0.000001 ? 20 * log10(pk) : -100;
  fy = y + h * (1 - max(0, min(1, (db + 60) / 60)));
  db > -1 ? gfx_set(1.0, 0.35, 0.30, 1) : gfx_set(acc_r, acc_g, acc_b, 1);
  gfx_rect(x, fy, w, y + h - fy, 1);
);

function g_sep(y)
(
  gfx_set(0.04, 0.04, 0.05, 1);
  gfx_rect(0, oy + y*scale, gfx_w, max(1, scale), 1);
);

function g_header(title, sub)
(
  gfx_set(bg_r, bg_g, bg_b, 1);
  gfx_rect(0, 0, gfx_w, gfx_h, 1);
  gfx_setfont(1, "Arial", 20*scale, 'b');
  gfx_set(acc_r, acc_g, acc_b, 1);
  gfx_x = ox + MARGIN; gfx_y = oy + 8*scale;
  gfx_drawstr(title);
  gfx_setfont(1, "Arial", 13*scale);
  gfx_set(0.58, 0.60, 0.64, 1);
  gfx_x = ox + MARGIN + 2*scale; gfx_y = oy + 30*scale;
  gfx_drawstr(sub);
  g_sep(46);
);

function g_lcd(lw0, taw0)
(
  LX = ox + MARGIN; LY = oy + 56*scale; LW = lw0*scale; LH = 96*scale;
  gfx_set(0.03, 0.03, 0.04, 1);
  gfx_rect(LX - 2*scale, LY - 2*scale, LW + 4*scale, LH + 4*scale, 1);
  gfx_set(0.17, 0.17, 0.19, 1);
  gfx_rect(LX, LY, LW, LH, 1);
  GX = LX + 6*scale; GY = LY + 6*scale; GW = LW - 12*scale; GH = LH - 12*scale;
  gfx_set(0.02, 0.02, 0.02, 1);
  gfx_rect(GX - scale, GY - scale, GW + 2*scale, GH + 2*scale, 1);
  gfx_set(0.035 + acc_r*0.05, 0.035 + acc_g*0.05, 0.035 + acc_b*0.05, 1);
  gfx_rect(GX, GY, GW, GH, 1);
  lc_r = min(1, 0.35 + acc_r*0.75); lc_g = min(1, 0.35 + acc_g*0.75); lc_b = min(1, 0.35 + acc_b*0.75);
  TAW = taw0*scale;
  SDX = GX + TAW + 12*scale;
  gfx_set(lc_r, lc_g, lc_b, 0.18);
  gfx_rect(SDX, GY + 8*scale, max(1, scale), GH - 16*scale, 1);
  VX = SDX + 12*scale; VW = GX + GW - 10*scale - VX;
  VY = GY + 8*scale; VH = GH - 16*scale;
);

function g_lcd_text(top_l, top_r, big)
local(tw, th)
(
  gfx_setfont(2, "Courier New", 14*scale, 'b');
  glow_text(top_l, GX + 10*scale, GY + 6*scale, lc_r, lc_g, lc_b);
  gfx_measurestr(top_r, tw, th);
  glow_text(top_r, GX + TAW - tw, GY + 6*scale, lc_r, lc_g, lc_b);
  gfx_setfont(2, "Courier New", 26*scale, 'b');
  gfx_measurestr(big, tw, th);
  glow_text(big, GX + 10*scale + (TAW - 10*scale - tw)*0.5, GY + 26*scale + (26*scale - th)*0.5, lc_r, lc_g, lc_b);
);

function g_lcd_bottom(idle)
local(tw, th, y3)
(
  gfx_setfont(2, "Courier New", 14*scale, 'b');
  y3 = GY + GH - 20*scale;
  (lcd_sl > 0 && time_precise() - lcd_t < 1.5) ? (
    strcpy(#lt, knob_name(lcd_sl)); upper(#lt);
    glow_text(#lt, GX + 10*scale, y3, lc_r, lc_g, lc_b);
    strcpy(#lv, ptext(lcd_sl)); upper(#lv);
    gfx_measurestr(#lv, tw, th);
    glow_text(#lv, GX + TAW - tw, y3, lc_r, lc_g, lc_b);
  ) : (
    gfx_measurestr(idle, tw, th);
    glow_text(idle, GX + 10*scale + (TAW - 10*scale - tw)*0.5, y3, lc_r, lc_g, lc_b);
  );
);

function g_lcd_end()
local(scy)
(
  gfx_set(0, 0, 0, 0.22);
  scy = GY;
  while (scy < GY + GH) ( gfx_rect(GX, scy, GW, max(1, scale), 1); scy += 3*scale; );
  gfx_set(1, 1, 1, 0.035);
  gfx_rect(GX, GY, GW, GH*0.45, 1);
);

function g_meters()
local(mw, m0, msp)
(
  mw = 16*scale;
  m0 = LX + LW + 26*scale;
  msp = (ox + DW*scale - MARGIN - m0 - mw);
  meter(m0, LY, mw, LH, ipk, "IN");
  meter(m0 + msp, LY, mw, LH, opk, "OUT");
);

function g_hint(y)
local(hs, htw, hth)
(
  g_sep(y);
  hs = drag_target > 0 ? drag_target : hov_s;
  gfx_setfont(1, "Arial", 13*scale);
  gfx_set(0.62, 0.63, 0.66, 1);
  strcpy(#ghint, hint_text(hs));
  gfx_measurestr(#ghint, htw, hth);
  htw > (DW - 20)*scale ? ( gfx_setfont(1, "Arial", 13*scale*(DW - 20)*scale/htw); gfx_measurestr(#ghint, htw, hth); );
  gfx_x = ox + (DW*scale - htw)*0.5; gfx_y = oy + y*scale + (32*scale - hth)*0.5;
  gfx_drawstr(#ghint);
);

function g_drag()
local(fine_now, gv)
(
  drag_target > 0 ? (
    mouse_down ? (
      mouse_cap |= 65536;
      fine_now = mouse_cap & 4;
      fine_now != drag_fine ? ( drag_y0 = mouse_y; drag_v0 = slider(drag_target); drag_fine = fine_now; );
      gv = max(0, min(1, drag_v0 + (drag_y0 - mouse_y) / (150*scale) * (fine_now ? 0.1 : 1)));
      set_norm(drag_target, gv);
      lcd_touch(drag_target);
    ) : ( automate(drag_target, 1); drag_target = 0; );
  );
  mouse_wheel = 0;
  mouse_state = mouse_down;
);

function g_cell(px, py, pw, ph, v, lab)
local(fr, tw, th, mid, bw0)
(
  gfx_set(lc_r, lc_g, lc_b, 0.10);
  gfx_rect(px, py, pw, ph, 1);
  mid = px + pw * 0.5;
  fr = max(-1, min(1, v / 2));
  bw0 = pw * 0.5 * abs(fr);
  v < 0 ? gfx_set(1.0, 0.55, 0.45, 0.85) : gfx_set(lc_r, lc_g, lc_b, 0.85);
  gfx_rect(v < 0 ? mid - bw0 : mid, py + ph - 6*scale, max(1, bw0), 4*scale, 1);
  gfx_set(lc_r, lc_g, lc_b, 0.35);
  gfx_rect(mid, py + ph - 8*scale, max(1, scale), 8*scale, 1);
  gfx_setfont(1, "Arial", 11*scale, 'b');
  gfx_set(lc_r, lc_g, lc_b, 0.75);
  gfx_x = px + 4*scale; gfx_y = py + 3*scale; gfx_drawstr(lab);
  abs(v) < 0.0001 ? strcpy(#gcv, "OFF") : sprintf(#gcv, v < 0 ? "INV %.1f dB" : "%+.1f dB", 20 * log10(abs(v)));
  gfx_set(lc_r, lc_g, lc_b, 1);
  gfx_measurestr(#gcv, tw, th);
  gfx_x = px + pw - tw - 4*scale; gfx_y = py + 3*scale; gfx_drawstr(#gcv);
);

mouse_down = mouse_cap & 1;
mouse_just_down = mouse_down && !mouse_state;
hov_s = 0;
acc_r = 0.98; acc_g = 0.78; acc_b = 0.32;
bg_r = 0.09; bg_g = 0.085; bg_b = 0.075;
g_md = g_trunc(p_mode * 3.9);

g_header("IMAGE CONSCIOUS", "by chmaha  ·  based on mda Image");

g_lcd(600, 220);
sprintf(#gtr, "%d DB", g_int(40 * p_out - 20));
g_lcd_text("MATRIX", #gtr, mode_name(g_md));
sprintf(#gidle, "S %d%%  M %d%%", g_int(400 * p_width - 200), g_int(400 * p_centre - 200));
g_lcd_bottom(#gidle);

strcpy(#gi1, g_md == 0 ? "S" : g_md == 1 ? "M" : "L");
strcpy(#gi2, g_md == 0 ? "M" : g_md == 1 ? "S" : "R");
strcpy(#go1, g_md == 3 ? "M" : "L");
strcpy(#go2, g_md == 3 ? "S" : "R");
gcw = (VW - 6*scale) * 0.5; gch = (VH - 6*scale) * 0.5;
sprintf(#gcl, "%s > %s", #gi1, #go1); g_cell(VX, VY, gcw, gch, im_ll, #gcl);
sprintf(#gcl, "%s > %s", #gi2, #go1); g_cell(VX + gcw + 6*scale, VY, gcw, gch, im_rl, #gcl);
sprintf(#gcl, "%s > %s", #gi1, #go2); g_cell(VX, VY + gch + 6*scale, gcw, gch, im_lr, #gcl);
sprintf(#gcl, "%s > %s", #gi2, #go2); g_cell(VX + gcw + 6*scale, VY + gch + 6*scale, gcw, gch, im_rr, #gcl);
g_lcd_end();
g_meters();

SY = oy + 164*scale; SH = 26*scale;
gfx_setfont(1, "Arial", 12*scale, 'b');
gfx_set(0.62, 0.63, 0.66, 1);
gfx_measurestr("MODE", gtw, gth);
gfx_x = ox + MARGIN; gfx_y = SY + (SH - gth)*0.5;
gfx_drawstr("MODE");
TBX = ox + MARGIN + gtw + 10*scale; TBW = 104*scale;
gti = 0;
loop(4,
  seg_btn(1, TBX + gti*(TBW + 4*scale), SY, TBW, SH, mode_name(gti), g_md == gti, 12) ? (
    set_slider(1, gti == 0 ? 0.13 : gti == 1 ? 0.38 : gti == 2 ? 0.64 : 0.9); mouse_just_down = 0; lcd_touch(1);
  );
  gti += 1;
);

g_sep(200);
row_begin(208*scale, 5, 3);
sec(2, "SIDE", 0.98, 0.78, 0.32); knob(2); knob(3);
sec(2, "MID", 0.45, 0.80, 0.95); knob(4); knob(5);
sec(1, "OUTPUT", 0.80, 0.80, 0.84); knob(6);

g_hint(346);
g_drag();
