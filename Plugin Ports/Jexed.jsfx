name_keys();

(gfx_w != bg_w || gfx_h != bg_h || bg_dirty) ? (
  gfx_setimgdim(1, gfx_w, gfx_h);
  gfx_dest = 1;
  gfx_set(0.075, 0.078, 0.088, 1);
  gfx_rect(0, 0, gfx_w, gfx_h, 1);
  gfx_gradrect(0, 0, gfx_w, gfx_h, 0.11, 0.115, 0.13, 1, 0, 0, 0, 0, -0.05 / gfx_h, -0.05 / gfx_h, -0.05 / gfx_h, 0);
  i_ = 0;
  loop(floor(gfx_h / max(2, 2 * z)),
    gfx_set(1, 1, 1, 0.008 + 0.006 * sin(i_ * 1.7) * sin(i_ * 0.31));
    gfx_line(0, i_ * max(2, 2 * z), gfx_w, i_ * max(2, 2 * z), 0);
    i_ += 1;
  );
  pass = 0;
  layout();
  gfx_dest = -1;
  bg_w = gfx_w; bg_h = gfx_h; bg_dirty = 0;
);
gfx_x = gfx_y = 0;
gfx_blit(1, 1, 0);

pass = 1;
hov_n = -1; tip_on = 0;
layout();
tip_on ? ( acc(0); tip_below(tip_x, tip_y, "Switch to the User cartridge to store, init or rename voices"); );
hov_n > 0 ? ( acc(hov_c); sl_name(hov_n, #tn); fmt_sl(hov_n, #tv); sprintf(#tt, "%s  %s", #tn, #tv); tooltip(hov_x, hov_y, #tt); );

mouse_wheel = 0;
mouse_prev = mouse_down;
