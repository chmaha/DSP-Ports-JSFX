function voice(n) ( vbase + n*vstride; );

function choose_note(pitch) local(best, bscore, n, i, s, v, bv)
(
  best = cur_note;
  bscore = -1;
  n = cur_note;
  i = 0;
  loop(nvoices,
    v = voice(n);
    s = 0;
    !note_playing(v) ? s += 4;
    !v[4] ? s += 2;
    v[0] == pitch ? s += 1;
    bv = voice(best);
    (s > bscore || (s == bscore && v[3] < bv[3])) ? ( best = n; bscore = s; );
    n = (n + 1) % nvoices;
    i += 1;
  );
  best;
