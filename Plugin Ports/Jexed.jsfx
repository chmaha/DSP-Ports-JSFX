function sx(x) ( ox + x * z; );
function sy(y) ( oy + y * z; );
function hit(x, y, w, h) ( mouse_x >= sx(x) && mouse_x < sx(x + w) && mouse_y >= sy(y) && mouse_y < sy(y + h); );
function hitc(x, y, r) ( sqr(mouse_x - sx(x)) + sqr(mouse_y - sy(y)) <= sqr(r * z); );
function font(n, sz, fl) ( n == 1 ? gfx_setfont(1, "Arial", sz * z, fl) : gfx_setfont(n, "Courier New", sz * z, fl); );
function clamp01(x) ( max(0, min(1, x)); );

function upper(str) local(i, c)
(
  i = 0;
  loop(strlen(str), c = str_getchar(str, i); (c >= 97 && c <= 122) ? str_setchar(str, i, c - 32); i += 1; );
  str;
);

function text_c(str, cx, y) local(tw, th) ( gfx_measurestr(str, tw, th); gfx_x = sx(cx) - tw * 0.5; gfx_y = sy(y); gfx_drawstr(str); );
function text_r(str, rx, y) local(tw, th) ( gfx_measurestr(str, tw, th); gfx_x = sx(rx) - tw; gfx_y = sy(y); gfx_drawstr(str); );
function text_l(str, lx, y) ( gfx_x = sx(lx); gfx_y = sy(y); gfx_drawstr(str); );

function glow_str(str, x, y, r, g, b) local(d)
(
  d = max(1, z);
  gfx_set(r, g, b, 0.14);
  gfx_x = x - d; gfx_y = y; gfx_drawstr(str);
  gfx_x = x + d; gfx_y = y; gfx_drawstr(str);
  gfx_x = x; gfx_y = y - d; gfx_drawstr(str);
  gfx_x = x; gfx_y = y + d; gfx_drawstr(str);
  gfx_set(r, g, b, 1);
  gfx_x = x; gfx_y = y; gfx_drawstr(str);
);

function rrect(x, y, w, h, rad) local(QX, QY, QW, QH, QR)
(
  QX = sx(x); QY = sy(y); QW = w * z; QH = h * z; QR = rad * z;
  gfx_rect(QX + QR, QY, QW - 2*QR, QH, 1);
  gfx_rect(QX, QY + QR, QR, QH - 2*QR, 1);
  gfx_rect(QX + QW - QR, QY + QR, QR, QH - 2*QR, 1);
  gfx_circle(QX + QR, QY + QR, QR, 1, 1);
  gfx_circle(QX + QW - QR - 1, QY + QR, QR, 1, 1);
  gfx_circle(QX + QR, QY + QH - QR - 1, QR, 1, 1);
  gfx_circle(QX + QW - QR - 1, QY + QH - QR - 1, QR, 1, 1);
);

function soft_shadow(x, y, w, h, rad, n, a) local(i)
(
  i = 1;
  loop(n,
    gfx_set(0, 0, 0, a * (1 - (i - 1) / n));
    gfx_roundrect(sx(x) - i, sy(y) - i + 2 * z, w * z + 2 * i, h * z + 2 * i, (rad + i / z) * z, 1);
    i += 1;
  );
);

function acc(c)
(
  c == 0 ? ( acc_r = 1.00; acc_g = 0.66; acc_b = 0.26; ) :
  c == 1 ? ( acc_r = 0.30; acc_g = 0.82; acc_b = 0.96; ) :
  c == 2 ? ( acc_r = 0.46; acc_g = 0.92; acc_b = 0.56; ) :
  c == 3 ? ( acc_r = 0.74; acc_g = 0.54; acc_b = 1.00; ) :
  c == 4 ? ( acc_r = 0.46; acc_g = 0.64; acc_b = 1.00; ) :
  c == 5 ? ( acc_r = 1.00; acc_g = 0.42; acc_b = 0.56; ) :
  ( acc_r = 0.30; acc_g = 0.76; acc_b = 0.62; );
);

function panel(x, y, w, h, title, c) local(tw, th)
(
  pass == 0 ? (
    soft_shadow(x, y, w, h, 7, max(3, floor(6 * z)), 0.10);
    gfx_set(0.115, 0.122, 0.140, 1);
    rrect(x, y, w, h, 7);
    gfx_gradrect(sx(x + 7), sy(y + 1), (w - 14) * z, 40 * z, 1, 1, 1, 0.035, 0, 0, 0, 0, 0, 0, 0, -0.035 / (40 * z));
    gfx_set(1, 1, 1, 0.05);
    gfx_line(sx(x + 7), sy(y) + 1, sx(x + w - 7), sy(y) + 1, 1);
    acc(c);
    font(1, 11, 'b');
    gfx_measurestr(title, tw, th);
    gfx_set(acc_r, acc_g, acc_b, 0.95);
    gfx_x = sx(x + 12); gfx_y = sy(y + 8);
    gfx_drawstr(title);
    gfx_set(acc_r, acc_g, acc_b, 0.35);
    gfx_rect(sx(x + 12) + tw + 8 * z, sy(y + 14), sx(x + w - 12) - (sx(x + 12) + tw + 8 * z), max(1, z), 1);
  );
);

function screen(x, y, w, h) local(QX, QY, QW, QH)
(
  QX = sx(x); QY = sy(y); QW = w * z; QH = h * z;
  gfx_set(0, 0, 0, 0.55);
  gfx_rect(QX - z, QY - z, QW + 2 * z, QH + 2 * z, 1);
  gfx_set(0.035, 0.038, 0.045, 1);
  gfx_rect(QX, QY, QW, QH, 1);
  gfx_set(1, 1, 1, 0.025);
  gfx_rect(QX, QY, QW, QH * 0.45, 1);
);


function cart_label(c, str) ( c == 0 ? strcpy(str, "Dexed_01") : c == 33 ? strcpy(str, "User") : sprintf(str, "SynprezFM_%02d", c); str; );
function vo(n) ( n - 35; );
function is_voice(n) ( n >= 35 && n < 35 + 145; );
function sl_norm(n) ( (slider(n) - slMin[n]) / (slMax[n] - slMin[n]); );

function note_str(v, str) local(pc)
(
  pc = v % 12;
  strcpy(str, pc == 0 ? "C" : pc == 1 ? "C#" : pc == 2 ? "D" : pc == 3 ? "D#" : pc == 4 ? "E" : pc == 5 ? "F" :
              pc == 6 ? "F#" : pc == 7 ? "G" : pc == 8 ? "G#" : pc == 9 ? "A" : pc == 10 ? "A#" : "B");
);

function op_freq(op, str) local(b, md, co, fi, de, f)
(
  b = 35 + op * 21;
  md = floor(slider(b + 17) + 0.5); co = floor(slider(b + 18) + 0.5); fi = floor(slider(b + 19) + 0.5); de = floor(slider(b + 20) + 0.5) - 7;
  !md ? (
    f = co == 0 ? 0.5 : co;
    f = f + f * fi / 100;
    sprintf(str, "%.2f", f);
  ) : (
    f = 10 ^ (co & 3) * exp(log(10) * fi / 100);
    f < 10 ? sprintf(str, "%.3f Hz", f) : f < 100 ? sprintf(str, "%.2f Hz", f) : f < 1000 ? sprintf(str, "%.1f Hz", f) : sprintf(str, "%.0f Hz", f);
  );
  de != 0 ? strcat(str, sprintf(#dtn, " %+d", de));
  str;
);

function fmt_sl(n, str) local(v, o, k, f)
(
  v = slider(n);
  is_voice(n) ? (
    o = vo(n); v = floor(v + 0.5);
    o < 126 ? (
      k = o % 21;
      k == 8 ? ( note_str(v + 9, #ns); sprintf(str, "%s%d", #ns, floor((v + 9) / 12) - 1); ) :
      (k == 11 || k == 12) ? strcpy(str, v == 0 ? "-LIN" : v == 1 ? "-EXP" : v == 2 ? "+EXP" : "+LIN") :
      k == 17 ? strcpy(str, v ? "Fixed" : "Ratio") :
      k == 20 ? sprintf(str, "%+d", v - 7) :
      (k == 18 || k == 19) ? op_freq(floor(o / 21), str) :
      sprintf(str, "%d", v);
    ) :
    o == 134 ? sprintf(str, "%d", v + 1) :
    (o == 136 || o == 141) ? strcpy(str, v ? "On" : "Off") :
    o == 142 ? strcpy(str, v == 0 ? "Triangle" : v == 1 ? "Saw Down" : v == 2 ? "Saw Up" : v == 3 ? "Square" : v == 4 ? "Sine" : "S&H") :
    o == 144 ? ( note_str(v, #ns); sprintf(str, "%s%d", #ns, floor(v / 12) + 1); ) :
    sprintf(str, "%d", v);
  ) :
  n == 3 ? sprintf(str, "%+.1f dB", v) :
  n == 6 ? ( v >= 1 ? strcpy(str, "Open") : ( f = ((exp(v * log(20)) - 1) / 19) * 18940 + 60; f < 1000 ? sprintf(str, "%.0f Hz", f) : sprintf(str, "%.1f kHz", f / 1000); ); ) :
  n == 7 ? sprintf(str, "%.0f %%", v * 100) :
  n == 9 ? sprintf(str, "%+.1f cents", v) :
  (n == 10 || n == 11) ? sprintf(str, "%d semi", floor(v + 0.5)) :
  n == 12 ? ( floor(v + 0.5) == 0 ? strcpy(str, "Off") : sprintf(str, "%d semi", floor(v + 0.5)); ) :
  (n == 13 || n == 17 || n == 21 || n == 25) ? sprintf(str, "%d", floor(v + 0.5)) :
  n == 5 ? sprintf(str, "%d", 2 ^ floor(v + 0.5)) :
  n == 4 ? ( floor(v + 0.5) == 0 ? strcpy(str, "Omni") : sprintf(str, "Ch %d", floor(v + 0.5)); ) :
  n == 1 ? cart_label(floor(v + 0.5), str) : n == 2 ? sprintf(str, "%d", floor(v + 0.5) + 1) :
  n == 8 ? strcpy(str, v >= 0.5 ? "Mono" : "Poly") :
  strcpy(str, v >= 0.5 ? "On" : "Off");
  str;
);

function sl_name(n, str) local(o)
(
  is_voice(n) ? (
    o = vo(n);
    o < 126 ? ( op_name(o % 21, #on); sprintf(str, "OP%d %s", 6 - floor(o / 21), #on); ) : glob_name(o, str);
  ) : perf_name(n, str);
  upper(str);
);

function set_sl(n, v)
(
  v = max(slMin[n], min(slMax[n], v));
  slStep[n] >= 1 ? v = floor(v / slStep[n] + 0.5) * slStep[n];
  slider(n) !== v ? ( slider(n) = v; automate(n, 0); );
  touched_n = n; touched_t = now;
);
function end_sl(n) ( automate(n, 1); );
function tap_sl(n, v) ( set_sl(n, v); end_sl(n); );


function knob_body(x, y, r) local(QX, QY, QR, i, t, c, a0, a1)
(
  QX = sx(x); QY = sy(y); QR = r * z;
  gfx_set(0, 0, 0, 0.45);
  gfx_circle(QX, QY + 2 * z, QR + 2 * z, 1, 1);
  a0 = -2.35619; a1 = 2.35619;
  gfx_set(0.035, 0.037, 0.045, 1);
  i = 0; loop(ceil(5 * z) + 1, gfx_arc(QX, QY, QR + 2 * z + i * 0.5, a0, a1, 1); i += 1; );
  gfx_set(0.05, 0.052, 0.06, 1);
  gfx_circle(QX, QY, QR, 1, 1);
  i = 0;
  loop(ceil(QR),
    t = i / ceil(QR);
    c = 0.14 + 0.16 * t;
    gfx_set(c, c * 1.01, c * 1.06, 1);
    gfx_circle(QX - QR * 0.18 * t, QY - QR * 0.22 * t, (QR - 1.5 * z) * (1 - t * 0.92), 1, 1);
    i += 1;
  );
  gfx_set(1, 1, 1, 0.10);
  gfx_arc(QX, QY, QR - 1.5 * z, -1.9, 0.2, 1);
);

function knob_value(x, y, r, pos, style, hot) local(QX, QY, QR, a0, a1, as, ae, a, i, px, py, br)
(
  QX = sx(x); QY = sy(y); QR = r * z;
  a0 = -2.35619; a1 = 2.35619;
  a = a0 + (a1 - a0) * clamp01(pos);
  style == 1 ? ( as = min(0, a); ae = max(0, a); ) : ( as = a0; ae = a; );
  br = hot ? 1 : 0.85;
  ae > as + 0.001 ? (
    gfx_set(acc_r, acc_g, acc_b, 0.10 * br);
    i = 0; loop(3, gfx_arc(QX, QY, QR + (4.5 + i * 0.7) * z, as, ae, 1); i += 1; );
    gfx_set(acc_r * br, acc_g * br, acc_b * br, 1);
    i = 0; loop(ceil(5 * z) + 1, gfx_arc(QX, QY, QR + 2 * z + i * 0.5, as, ae, 1); i += 1; );
  );
  style == 1 ? ( gfx_set(1, 1, 1, 0.35); gfx_line(QX, QY - QR - 1.5 * z, QX, QY - QR - 4.5 * z, 1); );
  px = sin(a); py = -cos(a);
  gfx_set(0.95, 0.95, 0.97, 1);
  gfx_circle(QX + px * QR * 0.72, QY + py * QR * 0.72, max(1.5, 2.2 * z), 1, 1);
);

function tooltip(x, y, str) local(tw, th, bx, by, bw, bh)
(
  font(1, 11, 'b');
  gfx_measurestr(str, tw, th);
  bw = tw + 12 * z; bh = th + 6 * z;
  bx = max(2, min(gfx_w - bw - 2, sx(x) - bw * 0.5)); by = sy(y) - bh;
  gfx_set(0.02, 0.02, 0.03, 0.92);
  gfx_rect(bx, by, bw, bh, 1);
  gfx_set(acc_r, acc_g, acc_b, 0.8);
  gfx_rect(bx, by + bh - max(1, z), bw, max(1, z), 1);
  gfx_set(1, 1, 1, 1);
  gfx_x = bx + 6 * z; gfx_y = by + 3 * z;
  gfx_drawstr(str);
);

function tip_below(x, y, str) local(tw, th, bx, by, bw, bh)
(
  font(1, 11, 'b');
  gfx_measurestr(str, tw, th);
  bw = tw + 12 * z; bh = th + 6 * z;
  bx = max(2, min(gfx_w - bw - 2, sx(x) - bw * 0.5)); by = sy(y);
  gfx_set(0.02, 0.02, 0.03, 0.92);
  gfx_rect(bx, by, bw, bh, 1);
  gfx_set(acc_r, acc_g, acc_b, 0.8);
  gfx_rect(bx, by, bw, max(1, z), 1);
  gfx_set(1, 1, 1, 1);
  gfx_x = bx + 6 * z; gfx_y = by + 3 * z;
  gfx_drawstr(str);
);

function knob(x, y, r, n, style, label, c) local(pos, hov, nv, d, st, fine, steps)
(
  acc(c);
  pass == 0 ? (
    knob_body(x, y, r);
    font(1, r >= 14 ? 10 : 9, 'b');
    gfx_set(0.62, 0.64, 0.68, 1);
    text_c(label, x, y + r + 6);
  ) : (
    hov = hitc(x, y, r + 4);
    (mouse_click && hov) ? (
      (last_click_n == n && now - last_click_t < 0.3) ? ( tap_sl(n, slDef[n]); drag_n = -1; ) :
        ( drag_n = n; drag_y0 = mouse_y; drag_v0 = slider(n); );
      last_click_n = n; last_click_t = now;
      mouse_click = 0;
    );
    drag_n == n ? (
      fine = (mouse_cap & 4) || (mouse_cap & 8);
      d = (drag_y0 - mouse_y) / (220 * z) * (fine ? 0.12 : 1);
      st = slStep[n];
      st >= 1 ? (
        steps = (slMax[n] - slMin[n]) / st;
        nv = drag_v0 + floor(d * steps * (fine ? 4 : 1.2) + 0.5) * st;
      ) : nv = drag_v0 + d * (slMax[n] - slMin[n]);
      set_sl(n, nv);
    );
    (hov && mouse_wheel != 0 && drag_n < 0) ? (
      st = slStep[n];
      nv = slider(n) + (mouse_wheel > 0 ? 1 : -1) * (st >= 1 ? st : (slMax[n] - slMin[n]) * ((mouse_cap & 4) ? 0.002 : 0.02));
      tap_sl(n, nv);
      mouse_wheel = 0;
    );
    pos = sl_norm(n);
    knob_value(x, y, r, pos, style, hov || drag_n == n);
    (hov || drag_n == n) ? ( hov_n = n; hov_x = x; hov_y = y - r - 6; hov_c = c; );
  );
);

function dropdown(x, y, w, h, label, str, c) local(hov, tw, th, QX, QY, QW, QH)
(
  acc(c);
  QX = sx(x); QY = sy(y); QW = w * z; QH = h * z;
  pass == 0 ? (
    strlen(label) ? (
      font(1, 9, 'b');
      gfx_set(0.62, 0.64, 0.68, 1);
      gfx_x = QX; gfx_y = QY - 12 * z;
      gfx_drawstr(label);
    );
    gfx_set(0, 0, 0, 0.5);
    gfx_rect(QX - z, QY - z, QW + 2 * z, QH + 2 * z, 1);
    gfx_set(0.075, 0.08, 0.09, 1);
    gfx_rect(QX, QY, QW, QH, 1);
    0;
  ) : (
    hov = hit(x, y, w, h);
    hov ? ( gfx_set(1, 1, 1, 0.05); gfx_rect(QX, QY, QW, QH, 1); );
    font(1, 10.5, 'b');
    gfx_set(0.90, 0.91, 0.93, 1);
    gfx_measurestr(str, tw, th);
    gfx_x = QX + 6 * z; gfx_y = QY + (QH - th) * 0.5;
    gfx_drawstr(str);
    gfx_set(acc_r, acc_g, acc_b, hov ? 1 : 0.8);
    gfx_triangle(QX + QW - 12 * z, QY + QH * 0.5 - 2 * z, QX + QW - 5 * z, QY + QH * 0.5 - 2 * z, QX + QW - 8.5 * z, QY + QH * 0.5 + 2.5 * z);
    gfx_rect(QX, QY + QH - max(1, z), QW, max(1, z), 1);
    ret = mouse_click && hov;
    ret ? ( mouse_click = 0; gfx_x = QX; gfx_y = QY + QH; );
    ret;
  );
);

function enum_dd(x, y, w, h, n, label, c) local(i, cur, sel)
(
  fmt_sl(n, #dd);
  dropdown(x, y, w, h, label, #dd, c) ? (
    cur = floor(slider(n) + 0.5);
    strcpy(#menu, "");
    i = slMin[n];
    while (i <= slMax[n]) (
      i > slMin[n] ? strcat(#menu, "|");
      i == cur ? strcat(#menu, "!");
      slider(n) = i; fmt_sl(n, #mi); slider(n) = cur;
      strcat(#menu, #mi);
      i += 1;
    );
    sel = gfx_showmenu(#menu);
    sel > 0 ? tap_sl(n, slMin[n] + sel - 1);
  );
  pass == 1 && hit(x, y, w, h) ? ( hov_n = n; hov_x = x + w * 0.5; hov_y = y - 14; hov_c = c; );
);

function toggle_btn(x, y, w, h, n, label, c) local(hov, on, QX, QY, QW, QH, tw, th)
(
  acc(c);
  QX = sx(x); QY = sy(y); QW = w * z; QH = h * z;
  pass == 0 ? (
    gfx_set(0, 0, 0, 0.5);
    gfx_rect(QX - z, QY - z, QW + 2 * z, QH + 2 * z, 1);
  ) : (
    hov = hit(x, y, w, h);
    on = slider(n) >= 0.5;
    on ? gfx_set(acc_r * 0.28, acc_g * 0.28, acc_b * 0.28, 1) : gfx_set(0.075, 0.08, 0.09, 1);
    gfx_rect(QX, QY, QW, QH, 1);
    hov ? ( gfx_set(1, 1, 1, 0.06); gfx_rect(QX, QY, QW, QH, 1); );
    on ? ( gfx_set(acc_r, acc_g, acc_b, 0.25); gfx_circle(QX + 8 * z, QY + QH * 0.5, 4.5 * z, 1, 1); );
    on ? gfx_set(acc_r, acc_g, acc_b, 1) : gfx_set(0.25, 0.26, 0.28, 1);
    gfx_circle(QX + 8 * z, QY + QH * 0.5, 2.4 * z, 1, 1);
    font(1, 9.5, 'b');
    on ? gfx_set(1, 1, 1, 1) : gfx_set(0.62, 0.64, 0.68, 1);
    gfx_measurestr(label, tw, th);
    gfx_x = QX + 15 * z; gfx_y = QY + (QH - th) * 0.5;
    gfx_drawstr(label);
    hov ? ( hov_n = n; hov_x = x + w * 0.5; hov_y = y - 4; hov_c = c; );
    (mouse_click && hov) ? ( tap_sl(n, on ? 0 : 1); mouse_click = 0; );
  );
);

function btn_en(x, y, w, h, label, lit, c, en) local(QX, QY, QW, QH, hov, tw, th)
(
  acc(c);
  QX = sx(x); QY = sy(y); QW = w * z; QH = h * z;
  pass == 1 ? (
    hov = hit(x, y, w, h);
    gfx_set(0, 0, 0, 0.5);
    gfx_rect(QX - z, QY - z, QW + 2 * z, QH + 2 * z, 1);
    !en ? ( gfx_set(0.10, 0.105, 0.115, 1); gfx_rect(QX, QY, QW, QH, 1); ) :
    lit ? gfx_gradrect(QX, QY, QW, QH, acc_r * 0.55, acc_g * 0.55, acc_b * 0.55, 1, 0, 0, 0, 0, -0.1 / QH, -0.1 / QH, -0.1 / QH, 0)
        : gfx_gradrect(QX, QY, QW, QH, 0.16, 0.165, 0.18, 1, 0, 0, 0, 0, -0.05 / QH, -0.05 / QH, -0.05 / QH, 0);
    hov && en ? ( gfx_set(1, 1, 1, 0.07); gfx_rect(QX, QY, QW, QH, 1); );
    font(1, 10, 'b');
    !en ? gfx_set(0.34, 0.35, 0.38, 1) : lit ? gfx_set(1, 1, 1, 1) : gfx_set(0.82, 0.83, 0.86, 1);
    gfx_measurestr(label, tw, th);
    gfx_x = QX + (QW - tw) * 0.5; gfx_y = QY + (QH - th) * 0.5;
    gfx_drawstr(label);
    hov && !en ? ( tip_on = 1; tip_x = x + w * 0.5; tip_y = y + h + 4; );
    ret = mouse_click && hov;
    ret ? ( mouse_click = 0; gfx_x = QX; gfx_y = QY + QH; );
    ret && en;
  ) : 0;
);

function btn(x, y, w, h, label, lit, c) ( btn_en(x, y, w, h, label, lit, c, 1); );

function arrow(x, y, w, h, dir) local(hov, QX, QY, QW, QH, cx, cy, s)
(
  pass == 1 ? (
    QX = sx(x); QY = sy(y); QW = w * z; QH = h * z;
    hov = hit(x, y, w, h);
    gfx_set(0.02, 0.022, 0.025, 1);
    gfx_rect(QX - z, QY - z, QW + 2 * z, QH + 2 * z, 1);
    gfx_set(hov ? 0.19 : 0.13, hov ? 0.19 : 0.13, hov ? 0.21 : 0.15, 1);
    gfx_rect(QX, QY, QW, QH, 1);
    cx = QX + QW * 0.5; cy = QY + QH * 0.5; s = min(6 * z, QH * 0.3);
    acc(0);
    gfx_set(acc_r, acc_g, acc_b, hov ? 1 : 0.85);
    dir < 0 ? gfx_triangle(cx + s * 0.55, cy - s, cx + s * 0.55, cy + s, cx - s * 0.65, cy)
            : gfx_triangle(cx - s * 0.55, cy - s, cx - s * 0.55, cy + s, cx + s * 0.65, cy);
    ret = mouse_click && hov;
    ret ? mouse_click = 0;
    ret;
  ) : 0;
);


function lvl_q24(L) ( ((scaleout(max(0, min(99, floor(L + 0.5)))) >> 1) * 64 + 3168 - 4256) / 256; );

function stage_time(rate, la, lb) local(qr, inc, a, b, blocks, sr_)
(
  rate = max(0, min(99, floor(rate + 0.5)));
  qr = min(63, (rate * 41) >> 6);
  inc = (4 + (qr & 3)) * 2 ^ (8 + (qr >> 2));
  a = lvl_q24(la); b = lvl_q24(lb);
  abs(b - a) < 0.001 ? (
    sr_ = min(99, rate);
    (sr_ < 77 ? statics_t[sr_] : 20 * (99 - sr_)) / 44100;
  ) : b < a ? (
    blocks = (a - b) * 16777216 / inc;
    blocks * 64 / 44100;
  ) : (
    a = max(a, 6.703125);
    b = min(b, 16.9);
    blocks = b > a ? 16777216 / inc * log((17 - a) / (17 - b)) : 0;
    blocks * 64 / 44100;
  );
);

function env_w(t) ( 0.18 + log(1 + t / 0.004); );

function env_xy(P) local(i, f)
(
  i = min(4, floor(P)); f = P - i;
  env_px = ex_[i] + (ex_[i + 1] - ex_[i]) * f;
  env_py = ey_[i] + (ey_[i + 1] - ey_[i]) * f;
);

function env_path(Pa, Pb) local(p, q, xa, ya)
(
  p = Pa;
  env_xy(p); xa = env_px; ya = env_py;
  while (p < Pb - 0.0001) (
    q = min(Pb, floor(p) + 1);
    env_xy(q);
    gfx_line(xa, ya, env_px, env_py, 1);
    gfx_line(xa, ya + 1, env_px, env_py + 1, 1);
    xa = env_px; ya = env_py; p = q;
  );
);

function dx_env(x, y, w, h, rb, lb, c, opi) local(QX, QY, QW, QH, L1, L2, L3, L4, w0, w1, w2, w3, wh, tot, i, k, p, ix, lv, frac, la, lbb, P, hb, n, j, a)
(
  acc(c);
  pass == 0 ? screen(x, y, w, h) : (
    QX = sx(x + 6); QY = sy(y + 6); QW = (w - 12) * z; QH = (h - 12) * z;
    L1 = slider(lb); L2 = slider(lb + 1); L3 = slider(lb + 2); L4 = slider(lb + 3);
    w0 = env_w(stage_time(slider(rb), L4, L1)); w1 = env_w(stage_time(slider(rb + 1), L1, L2));
    w2 = env_w(stage_time(slider(rb + 2), L2, L3)); w3 = env_w(stage_time(slider(rb + 3), L3, L4));
    wh = 0.25 * (w0 + w1 + w2 + w3) + 0.3;
    tot = w0 + w1 + w2 + wh + w3;
    ex_ = 6650000; ey_ = 6650010;
    ex_[0] = QX;                        ey_[0] = QY + QH - L4 / 99 * QH;
    ex_[1] = QX + QW * w0 / tot;        ey_[1] = QY + QH - L1 / 99 * QH;
    ex_[2] = QX + QW * (w0 + w1) / tot; ey_[2] = QY + QH - L2 / 99 * QH;
    ex_[3] = QX + QW * (w0 + w1 + w2) / tot; ey_[3] = QY + QH - L3 / 99 * QH;
    ex_[4] = QX + QW * (w0 + w1 + w2 + wh) / tot; ey_[4] = ey_[3];
    ex_[5] = QX + QW;                   ey_[5] = QY + QH - L4 / 99 * QH;
    gfx_set(acc_r, acc_g, acc_b, 0.08);
    i = 0; loop(5, gfx_triangle(ex_[i], ey_[i], ex_[i + 1], ey_[i + 1], ex_[i + 1], QY + QH, ex_[i], QY + QH); i += 1; );
    gfx_set(acc_r, acc_g, acc_b, 1);
    i = 0;
    loop(5,
      i == 3 ? gfx_set(acc_r, acc_g, acc_b, 0.45) : gfx_set(acc_r, acc_g, acc_b, 1);
      gfx_line(ex_[i], ey_[i], ex_[i + 1], ey_[i + 1], 1);
      i != 3 ? gfx_circle(ex_[i + 1], ey_[i + 1], 2 * z, 1, 1);
      i += 1;
    );
    opi >= 0 ? (
      k = 0;
      loop(nvoices,
        p = voice(k);
        hb = 6600000 + k * 16;
        (p[6] && p[32 + opi * 32 + 14] < 4) ? (
          p = p + 32 + opi * 32;
          ix = p[14];
          lv = (p[11] / 65536 - p[9] + 4256) / 32;
          lv = lv >= 48 ? lv - 28 : lv * 20 / 48;
          lv = max(0, min(99, lv));
          ix == 0 ? ( la = L4; lbb = L1; ) : ix == 1 ? ( la = L1; lbb = L2; ) : ix == 2 ? ( la = L2; lbb = L3; ) :
          ix == 3 ? ( la = L3; lbb = L4; ) : ( la = L4; lbb = L4; );
          frac = abs(lbb - la) >= 0.5 ? clamp01((lv - la) / (lbb - la)) : 0.5;
          P = ix < 3 ? ix + frac : (ix == 3 && p[17]) ? 3.5 : ix == 3 ? 4 + frac : 5;
          (hb[8] < 0.5 || P < hb[9] - 0.001) ? ( hb[8] = 1; j = 0; loop(6, hb[j] = 0; j += 1; ); );
          n = 0;
          loop(5,
            a = 0.10 + n * 0.12;
            gfx_set(1, 1, 1, a);
            env_path(hb[n], hb[n + 1]);
            n += 1;
          );
          gfx_set(1, 1, 1, 0.7);
          env_path(hb[5], P);
          j = 0; loop(5, hb[j] = hb[j + 1]; j += 1; );
          hb[5] = P; hb[9] = P;
          env_xy(P);
          gfx_set(1, 1, 1, 0.25); gfx_circle(env_px, env_py, 4.5 * z, 1, 1);
          gfx_set(1, 1, 1, 0.95); gfx_circle(env_px, env_py, 2.5 * z, 1, 1);
        ) : ( hb[8] = 0; );
        k += 1;
      );
    );
  );
);


function algo_diagram(x, y, sc) local(a, i, id, gx, gy, lk, fb, bx, by, cw, ch, on, QX, QY, lw, t)
(
  a = floor(slider(35 + 134) + 0.5);
  cw = 25 * sc; ch = 21 * sc; lw = max(1, floor(2 * z));
  i = 0;
  loop(6,
    id = alg_t[a * 30 + i * 5]; gx = alg_t[a * 30 + i * 5 + 1]; gy = alg_t[a * 30 + i * 5 + 2];
    lk = alg_t[a * 30 + i * 5 + 3]; fb = alg_t[a * 30 + i * 5 + 4];
    on = slider(28 + id) >= 0.5;
    bx = x + gx * cw + 3 * sc; by = y + gy * ch + 5 * sc;
    acc(1);
    on ? gfx_set(acc_r, acc_g, acc_b, 0.9) : gfx_set(0.3, 0.32, 0.35, 1);
    t = 0;
    loop(lw,
      lk == 0 ? gfx_line(sx(bx + 8 * sc) + t, sy(by + 12 * sc), sx(bx + 8 * sc) + t, sy(by + 21 * sc), 1) :
      lk == 1 ? ( gfx_line(sx(bx + 8 * sc) + t, sy(by + 12 * sc), sx(bx + 8 * sc) + t, sy(by + 18 * sc), 1); gfx_line(sx(bx + 7 * sc), sy(by + 18 * sc) + t, sx(bx + 34 * sc), sy(by + 18 * sc) + t, 1); ) :
      lk == 2 ? gfx_line(sx(bx + 8 * sc) + t, sy(by + 12 * sc), sx(bx + 8 * sc) + t, sy(by + 19 * sc), 1) :
      lk == 3 ? ( gfx_line(sx(bx + 8 * sc) + t, sy(by + 12 * sc), sx(bx + 8 * sc) + t, sy(by + 21 * sc), 1); gfx_line(sx(bx + 7 * sc), sy(by + 18 * sc) + t, sx(bx + 34 * sc), sy(by + 18 * sc) + t, 1);
                  gfx_line(sx(bx + 34 * sc) + t, sy(by + 17 * sc), sx(bx + 34 * sc) + t, sy(by + 21 * sc), 1); ) :
      lk == 4 ? ( gfx_line(sx(bx + 8 * sc) + t, sy(by + 12 * sc), sx(bx + 8 * sc) + t, sy(by + 21 * sc), 1); gfx_line(sx(bx - 17 * sc), sy(by + 18 * sc) + t, sx(bx + 34 * sc), sy(by + 18 * sc) + t, 1);
                  gfx_line(sx(bx + 34 * sc) + t, sy(by + 17 * sc), sx(bx + 34 * sc) + t, sy(by + 21 * sc), 1); gfx_line(sx(bx - 17 * sc) + t, sy(by + 17 * sc), sx(bx - 17 * sc) + t, sy(by + 21 * sc), 1); ) :
      lk == 6 ? ( gfx_line(sx(bx + 8 * sc) + t, sy(by + 12 * sc), sx(bx + 8 * sc) + t, sy(by + 18 * sc), 1); gfx_line(sx(bx + 7 * sc), sy(by + 18 * sc) + t, sx(bx + 58 * sc), sy(by + 18 * sc) + t, 1); ) :
      lk == 7 ? ( gfx_line(sx(bx + 8 * sc) + t, sy(by + 12 * sc), sx(bx + 8 * sc) + t, sy(by + 19 * sc), 1); gfx_line(sx(bx - 17 * sc), sy(by + 18 * sc) + t, sx(bx + 9 * sc), sy(by + 18 * sc) + t, 1); );
      fb == 1 ? ( gfx_line(sx(bx + 8 * sc) + t, sy(by), sx(bx + 8 * sc) + t, sy(by - 4 * sc), 1); gfx_line(sx(bx + 8 * sc), sy(by - 4 * sc) + t, sx(bx + 20 * sc), sy(by - 4 * sc) + t, 1);
                  gfx_line(sx(bx + 20 * sc) + t, sy(by - 4 * sc), sx(bx + 20 * sc) + t, sy(by + 15 * sc), 1); gfx_line(sx(bx + 8 * sc), sy(by + 15 * sc) + t, sx(bx + 20 * sc), sy(by + 15 * sc) + t, 1); ) :
      fb == 2 ? ( gfx_line(sx(bx + 8 * sc) + t, sy(by), sx(bx + 8 * sc) + t, sy(by - 4 * sc), 1); gfx_line(sx(bx + 8 * sc), sy(by - 4 * sc) + t, sx(bx + 20 * sc), sy(by - 4 * sc) + t, 1);
                  gfx_line(sx(bx + 20 * sc) + t, sy(by - 4 * sc), sx(bx + 20 * sc) + t, sy(by + 58 * sc), 1); gfx_line(sx(bx + 8 * sc), sy(by + 58 * sc) + t, sx(bx + 20 * sc), sy(by + 58 * sc) + t, 1); ) :
      fb == 3 ? ( gfx_line(sx(bx + 8 * sc) + t, sy(by), sx(bx + 8 * sc) + t, sy(by - 4 * sc), 1); gfx_line(sx(bx + 8 * sc), sy(by - 4 * sc) + t, sx(bx + 20 * sc), sy(by - 4 * sc) + t, 1);
                  gfx_line(sx(bx + 20 * sc) + t, sy(by - 4 * sc), sx(bx + 20 * sc) + t, sy(by + 37 * sc), 1); gfx_line(sx(bx + 8 * sc), sy(by + 37 * sc) + t, sx(bx + 20 * sc), sy(by + 37 * sc) + t, 1); ) :
      fb == 4 ? ( gfx_line(sx(bx + 8 * sc) + t, sy(by), sx(bx + 8 * sc) + t, sy(by - 4 * sc), 1); gfx_line(sx(bx - 3 * sc), sy(by - 4 * sc) + t, sx(bx + 8 * sc), sy(by - 4 * sc) + t, 1);
                  gfx_line(sx(bx - 3 * sc) + t, sy(by - 4 * sc), sx(bx - 3 * sc) + t, sy(by + 15 * sc), 1); gfx_line(sx(bx - 3 * sc), sy(by + 15 * sc) + t, sx(bx + 8 * sc), sy(by + 15 * sc) + t, 1); );
      t += 1;
    );
    QX = sx(bx); QY = sy(by);
    on ? gfx_set(0.13, 0.30, 0.36, 1) : gfx_set(0.10, 0.105, 0.12, 1);
    id == sel_op + 1 ? ( acc(1); gfx_set(acc_r * 0.55, acc_g * 0.55, acc_b * 0.55, 1); );
    gfx_rect(QX, QY, 17 * sc * z, 12 * sc * z, 1);
    on ? gfx_set(1, 1, 1, 1) : gfx_set(0.45, 0.47, 0.5, 1);
    font(1, 9 * sc, 'b');
    sprintf(#oid, "%d", id);
    text_c(#oid, bx + 8.5 * sc, by + 0.5 * sc);
    (mouse_click && hit(bx, by, 17 * sc, 12 * sc)) ? ( sel_op = id - 1; mouse_click = 0; );
    i += 1;
  );
);



function voice_name(c, n, str) local(b, k, ch, last)
(
  b = carts + c * cart_bytes + 6 + n * 128 + 118;
  strcpy(str, "          ");
  last = 0; k = 0;
  loop(10, ch = b[k]; (ch < 32 || ch > 126) ? ch = 32; str_setchar(str, k, ch); ch != 32 ? last = k + 1; k += 1; );
  str_setlen(str, last);
  str;
);

function patch_name(str) local(k, ch, last)
(
  strcpy(str, "          ");
  last = 0; k = 0;
  loop(10, ch = patch[145 + k]; (ch < 32 || ch > 126) ? ch = 32; str_setchar(str, k, ch); ch != 32 ? last = k + 1; k += 1; );
  str_setlen(str, last);
  str;
);

function menu_name(c, n, str) local(b, k, ch, last)
(
  b = carts + c * cart_bytes + 6 + n * 128 + 118;
  last = 0; k = 0;
  loop(10, ch = b[k]; (ch > 32 && ch < 127) ? last = k + 1; k += 1; );
  k = 0;
  loop(last, ch = b[k]; (ch < 32 || ch > 126) ? ch = 32; ch == 38 ? strcat(str, "&&") : strcat(str, sprintf(#mc, "%c", ch)); k += 1; );
  str;
);

function pick_voice(c, n)
(
  slider1 = c; slider2 = n;
  slider_automate(slider1, 0); slider_automate(slider1, 1);
  slider_automate(slider2, 0); slider_automate(slider2, 1);
);

function step_voice(d)
(
  pick_voice(floor(slider1 + 0.5), (floor(slider2 + 0.5) + d + 32) % 32);
);

function voice_menu() local(c, n, cc, cp, sel)
(
  cc = floor(slider1 + 0.5); cp = floor(slider2 + 0.5);
  strcpy(#vm, "");
  c = 0;
  loop(ncarts + 1,
    c > 0 ? strcat(#vm, "|");
    strcat(#vm, ">"); strcat(#vm, cart_label(c, #cl));
    n = 0;
    loop(32,
      strcat(#vm, "|");
      n == 31 ? strcat(#vm, "<");
      (c == cc && n == cp) ? strcat(#vm, "!");
      strcat(#vm, sprintf(#mn, "%02d ", n + 1));
      menu_name(c, n, #vm);
      n += 1;
    );
    c += 1;
  );
  sel = gfx_showmenu(#vm);
  sel > 0 ? pick_voice(floor((sel - 1) / 32), (sel - 1) % 32);
);

function cart_menu() local(c, cc, sel)
(
  cc = floor(slider1 + 0.5);
  strcpy(#vm, "");
  c = 0;
  loop(ncarts + 1, c > 0 ? strcat(#vm, "|"); c == cc ? strcat(#vm, "!"); strcat(#vm, cart_label(c, #cl)); c += 1; );
  sel = gfx_showmenu(#vm);
  (sel > 0 && sel - 1 != cc) ? pick_voice(sel - 1, 0);
);

function store_menu() local(n, sel)
(
  strcpy(#vm, "#STORE CURRENT VOICE IN USER SLOT|");
  n = 0;
  loop(32, strcat(#vm, sprintf(#mn, "|%02d ", n + 1)); menu_name(33, n, #vm); n += 1; );
  sel = gfx_showmenu(#vm);
  sel > 1 ? (
    pack_voice(userc + 6 + (sel - 2) * 128);
    sliderchange(-1);
    pick_voice(33, sel - 2);
  );
);

function lcd(x, y, w, h) local(gx, gy, gw, gh, lr, lg, lb, tw, th, c, p, led, ly, np, seg, sw, lit, hovc, hovn, hovv)
(
  pass == 0 ? (
    gfx_set(0, 0, 0, 0.6);
    gfx_rect(sx(x) - 2 * z, sy(y) - 2 * z, (w + 4) * z, (h + 4) * z, 1);
    gfx_set(0.10, 0.105, 0.12, 1);
    gfx_rect(sx(x), sy(y), w * z, h * z, 1);
  ) : (
    arrow(x + 5, y + 6, 22, h - 12, -1) ? step_voice(-1);
    arrow(x + w - 27, y + 6, 22, h - 12, 1) ? step_voice(1);
    gx = x + 32; gy = y + 5; gw = w - 64; gh = h - 10;
    lr = 1.0; lg = 0.62; lb = 0.28;
    gfx_set(0.012, 0.012, 0.012, 1);
    gfx_rect(sx(gx) - z, sy(gy) - z, (gw + 2) * z, (gh + 2) * z, 1);
    gfx_set(0.07, 0.045, 0.028, 1);
    gfx_rect(sx(gx), sy(gy), gw * z, gh * z, 1);
    c = floor(slider1 + 0.5); p = floor(slider2 + 0.5);
    hovc = hit(gx, gy, gw * 0.6, 16);
    hovv = hit(gx, gy + 16, gw, 30) && !name_edit;
    (hit(gx, gy, gw, gh) && mouse_wheel != 0) ? ( step_voice(mouse_wheel > 0 ? -1 : 1); mouse_wheel = 0; );
    font(2, 11, 'b');
    upper(cart_label(c, #lt));
    glow_str(#lt, sx(gx + 8), sy(gy + 4), lr, lg, lb);
    gfx_measurestr(#lt, tw, th);
    midi_flag ? ( midi_led_t = now; midi_flag = 0; );
    led = now - midi_led_t < 0.12;
    gfx_set(lr, lg, lb, led ? 1 : 0.16);
    gfx_circle(sx(gx + 8) + tw + 9 * z, sy(gy + 4) + th * 0.5, 2.8 * z, 1, 1);
    sprintf(#lt, "%02d/32", p + 1);
    voice_edited ? strcat(#lt, " *");
    gfx_measurestr(#lt, tw, th);
    glow_str(#lt, sx(gx + gw - 8) - tw, sy(gy + 4), lr, lg, lb);
    font(2, 21, 'b');
    name_edit ? ( strcpy(#ln, #ned); (floor(now * 2.5) & 1) ? strcat(#ln, "_") : strcat(#ln, " "); ) :
    carts_ok ? upper(patch_name(#ln)) : strcpy(#ln, "- - -");
    gfx_measurestr(#ln, tw, th);
    glow_str(#ln, sx(gx + gw * 0.5) - tw * 0.5, sy(gy + 29) - th * 0.5, lr, lg, lb);
    hovv ? ( gfx_set(lr, lg, lb, 0.35); gfx_rect(sx(gx + gw * 0.5) - tw * 0.5, sy(gy + 29) + th * 0.5, tw, max(1, z), 1); );
    font(2, 11, 'b');
    ly = gy + gh - 15;
    !carts_ok ? (
      strcpy(#lt, "JexedCarts.txt NOT FOUND");
      gfx_measurestr(#lt, tw, th);
      glow_str(#lt, sx(gx + gw * 0.5) - tw * 0.5, sy(ly), 1, 0.35, 0.3);
    ) : name_edit ? (
      strcpy(#lt, "TYPE A NAME, ENTER TO KEEP, ESC TO CANCEL");
      gfx_measurestr(#lt, tw, th);
      glow_str(#lt, sx(gx + gw * 0.5) - tw * 0.5, sy(ly), lr, lg, lb);
    ) : (hov_n > 0 || now - touched_t < 1.6) ? (
      sl_name(hov_n > 0 ? hov_n : touched_n, #lt);
      glow_str(#lt, sx(gx + 8), sy(ly), lr, lg, lb);
      fmt_sl(hov_n > 0 ? hov_n : touched_n, #lv);
      upper(#lv);
      gfx_measurestr(#lv, tw, th);
      glow_str(#lv, sx(gx + gw - 8) - tw, sy(ly), lr, lg, lb);
    ) : (
      np = nvoices;
      sprintf(#lt, "VOICES %d/%d", min(n_active, np), np);
      glow_str(#lt, sx(gx + 8), sy(ly), lr, lg, lb);
      gfx_measurestr(#lt, tw, th);
      seg = 0;
      sw = (gw - 24) * z - tw - 8 * z;
      lit = ceil(16 * min(1, n_active / max(1, np)));
      loop(16,
        gfx_set(lr, lg, lb, seg < lit ? 0.9 : 0.12);
        gfx_rect(sx(gx + 8) + tw + 10 * z + seg * sw / 16, sy(ly) + 2 * z, sw / 16 - 2 * z, th - 4 * z, 1);
        seg += 1;
      );
    );
    gfx_set(0, 0, 0, 0.22);
    i_ = sy(gy);
    while (i_ < sy(gy + gh)) ( gfx_rect(sx(gx), i_, gw * z, max(1, floor(z)), 1); i_ += 3 * z; );
    gfx_set(1, 1, 1, 0.03);
    gfx_rect(sx(gx), sy(gy), gw * z, gh * z * 0.42, 1);
    (mouse_click && hovc) ? ( gfx_x = sx(gx); gfx_y = sy(gy + 16); cart_menu(); mouse_click = 0; );
    (mouse_click && hovv) ? ( gfx_x = sx(gx + gw * 0.5 - 60); gfx_y = sy(gy + 46); voice_menu(); mouse_click = 0; );
  );
);

function name_keys() local(ch, k, n)
(
  name_edit ? (
    ch = gfx_getchar();
    while (ch > 0) (
      ch == 13 ? (
        n = strlen(#ned);
        k = 0; loop(10, patch[145 + k] = k < n ? str_getchar(#ned, k) : 32; k += 1; );
        floor(slider1 + 0.5) == 33 ? ( k = 0; loop(10, userc[6 + floor(slider2 + 0.5) * 128 + 118 + k] = patch[145 + k]; k += 1; ); );
        name_edit = 0; sliderchange(-1);
      ) : ch == 27 ? ( name_edit = 0; ) :
      ch == 8 ? ( strlen(#ned) > 0 ? str_setlen(#ned, strlen(#ned) - 1); ) :
      (ch >= 32 && ch < 127 && strlen(#ned) < 10) ? ( ch >= 97 && ch <= 122 ? ch -= 32; strcat(#ned, sprintf(#nc, "%c", ch)); );
      ch = name_edit ? gfx_getchar() : 0;
    );
  );
);

function meters(x, y, w, h) local(QX, QY, QW, f, db)
(
  pass == 0 ? (
    font(1, 9, 'b'); gfx_set(0.62, 0.64, 0.68, 1);
    gfx_x = sx(x); gfx_y = sy(y - 12); gfx_drawstr("LEVEL");
  ) : (
    QX = sx(x); QY = sy(y); QW = w * z;
    db = meter_peak > 0.000001 ? 20 * log10(meter_peak) : -100;
    f = clamp01((db + 48) / 48);
    gfx_set(0, 0, 0, 0.5); gfx_rect(QX - z, QY - z, QW + 2 * z, h * z + 2 * z, 1);
    gfx_set(0.05, 0.055, 0.06, 1); gfx_rect(QX, QY, QW, h * z, 1);
    gfx_gradrect(QX, QY, QW * f, h * z, 0.30, 0.85, 0.50, 1, 0.9 / (QW + 1), -0.2 / (QW + 1), -0.35 / (QW + 1), 0);
    clip_latch ? ( gfx_set(1, 0.28, 0.28, 1); gfx_rect(QX + QW - 5 * z, QY, 5 * z, h * z, 1); );
    (mouse_click && hit(x, y, w, h)) ? ( clip_latch = 0; mouse_click = 0; );
  );
);

function keyboard(x, y, w, h) local(kw, lo, nw, ww, n, kx, pc, isb, bx, bw, bh, hovn, down, vel, QX, QY, QH, oct, wi, col, lit, snd, kg)
(
  lo = 36; nw = 36;
  ww = w / nw; bw = ww * 0.62; bh = h * 0.62;
  QX = sx(x); QY = sy(y); QH = h * z;
  pass == 0 ? soft_shadow(x, y, w, h, 3, max(3, floor(5 * z)), 0.12) : (
    hovn = -1;
    (mouse_y >= QY && mouse_y < QY + QH && mouse_x >= QX && mouse_x < QX + w * z) ? (
      n = lo; wi = 0;
      loop(61,
        pc = n % 12; isb = pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10;
        isb ? ( bx = x + wi * ww - bw * 0.5; (mouse_y < QY + bh * z && mouse_x >= sx(bx) && mouse_x < sx(bx + bw)) ? hovn = n; );
        !isb ? wi += 1;
        n += 1;
      );
      hovn < 0 ? ( wi = floor((mouse_x - QX) / (ww * z)); oct = floor(wi / 7); pc = wi - oct * 7;
        hovn = lo + oct * 12 + (pc == 0 ? 0 : pc == 1 ? 2 : pc == 2 ? 4 : pc == 3 ? 5 : pc == 4 ? 7 : pc == 5 ? 9 : 11); );
    );
    down = mouse_cap & 1;
    (mouse_click && hovn >= 0) ? ( kb_note = -1; kb_on = 1; mouse_click = 0; );
    kb_on && !down ? (
      kb_note >= 0 ? ( gq[gq_w*3] = 128; gq[gq_w*3+1] = kb_note; gq[gq_w*3+2] = 0; gq_w = (gq_w + 1) % 64; );
      kb_note = -1; kb_on = 0;
    );
    (kb_on && down && hovn != kb_note && hovn >= 0 && hovn <= 127) ? (
      kb_note >= 0 ? ( gq[gq_w*3] = 128; gq[gq_w*3+1] = kb_note; gq[gq_w*3+2] = 0; gq_w = (gq_w + 1) % 64; );
      vel = floor(40 + 87 * clamp01((mouse_y - QY) / QH));
      gq[gq_w*3] = 144; gq[gq_w*3+1] = hovn; gq[gq_w*3+2] = vel; gq_w = (gq_w + 1) % 64;
      kb_note = hovn;
    );
    acc(6);
    n = lo; wi = 0;
    loop(61,
      pc = n % 12; isb = pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10;
      !isb ? (
        kg = max(1, floor(z));
        kx = floor(sx(x + wi * ww)) + kg;
        kw = floor(sx(x + (wi + 1) * ww)) - kx;
        lit = kdown[n] || kb_note == n;
        snd = vact[n];
        lit ? gfx_gradrect(kx, QY, kw, QH, acc_r, acc_g, acc_b, 1, 0, 0, 0, 0, -0.2 / QH, -0.2 / QH, -0.2 / QH, 0) : (
          col = snd ? 0.80 : 0.90;
          gfx_gradrect(kx, QY, kw, QH, col * 0.86, col * 0.87, col * 0.9, 1, 0, 0, 0, 0, 0.12 / QH, 0.12 / QH, 0.12 / QH, 0);
          snd ? ( gfx_set(acc_r, acc_g, acc_b, 0.35); gfx_rect(kx, QY + QH - 5 * z, kw, 5 * z, 1); );
        );
        gfx_set(0, 0, 0, 0.18); gfx_rect(kx, QY, kw, 2 * z, 1);
        pc == 0 ? ( font(1, 8, 'b'); gfx_set(0.35, 0.36, 0.4, 1); sprintf(#kl, "C%d", floor(n / 12) - 1); text_c(#kl, x + wi * ww + ww * 0.5, y + h - 12); );
        wi += 1;
      );
      n += 1;
    );
    n = lo; wi = 0;
    loop(61,
      pc = n % 12; isb = pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10;
      isb ? (
        bx = floor(sx(x + wi * ww - bw * 0.5));
        lit = kdown[n] || kb_note == n;
        snd = vact[n];
        gfx_set(0, 0, 0, 0.35); gfx_rect(bx + z, QY, bw * z, bh * z + 2 * z, 1);
        lit ? gfx_gradrect(bx, QY, bw * z, bh * z, acc_r * 0.8, acc_g * 0.8, acc_b * 0.8, 1, 0, 0, 0, 0, 0.1 / (bh * z), 0.1 / (bh * z), 0.1 / (bh * z), 0) : (
          gfx_gradrect(bx, QY, bw * z, bh * z, 0.08, 0.085, 0.095, 1, 0, 0, 0, 0, 0.1 / (bh * z), 0.1 / (bh * z), 0.1 / (bh * z), 0);
          gfx_set(1, 1, 1, 0.10); gfx_rect(bx + 2 * z, QY + bh * z - 7 * z, bw * z - 4 * z, 5 * z, 1);
          snd ? ( gfx_set(acc_r, acc_g, acc_b, 0.55); gfx_rect(bx + 2 * z, QY + bh * z - 7 * z, bw * z - 4 * z, 5 * z, 1); );
        );
      );
      !isb ? wi += 1;
      n += 1;
    );
  );
);

function tab(x, y, w, h, pg, label) local(QX, QY, QW, QH, hov, on, tw, th)
(
  pass == 1 ? (
    QX = sx(x); QY = sy(y); QW = w * z; QH = h * z;
    on = page == pg; hov = hit(x, y, w, h);
    acc(0);
    gfx_set(0, 0, 0, 0.5); gfx_rect(QX - z, QY - z, QW + 2 * z, QH + 2 * z, 1);
    on ? gfx_gradrect(QX, QY, QW, QH, acc_r * 0.62, acc_g * 0.62, acc_b * 0.62, 1, 0, 0, 0, 0, -0.1 / QH, -0.1 / QH, -0.1 / QH, 0)
       : gfx_gradrect(QX, QY, QW, QH, 0.15, 0.155, 0.17, 1, 0, 0, 0, 0, -0.04 / QH, -0.04 / QH, -0.04 / QH, 0);
    hov && !on ? ( gfx_set(1, 1, 1, 0.07); gfx_rect(QX, QY, QW, QH, 1); );
    font(1, 11, 'b');
    on ? gfx_set(1, 1, 1, 1) : gfx_set(0.72, 0.73, 0.77, 1);
    gfx_measurestr(label, tw, th);
    gfx_x = QX + (QW - tw) * 0.5; gfx_y = QY + (QH - th) * 0.5; gfx_drawstr(label);
    (mouse_click && hov) ? ( page = pg; bg_dirty = 1; mouse_click = 0; );
  );
);

function logo() local(tw, th)
(
  pass == 0 ? (
    font(1, 30, 'b');
    acc(6);
    gfx_set(acc_r, acc_g, acc_b, 0.18);
    gfx_x = sx(18) + z; gfx_y = sy(14) + 2 * z; gfx_drawstr("JEXED");
    gfx_set(acc_r, acc_g, acc_b, 1);
    gfx_x = sx(18); gfx_y = sy(14); gfx_drawstr("JEXED");
    font(1, 11, 0);
    gfx_set(0.50, 0.52, 0.56, 1);
    gfx_x = sx(20); gfx_y = sy(50); gfx_drawstr("by chmaha  ·  based on Dexed");
  );
);


function play_page() local(c, i, n, x, y, cur, hov, QX, QY, tw, th)
(
  panel(10, 92, 560, 452, "VOICES", 0);
  pass == 1 ? (
    c = floor(slider1 + 0.5); cur = floor(slider2 + 0.5);
    i = 0;
    loop(32,
      x = 22 + floor(i / 8) * 136; y = 124 + (i % 8) * 51;
      QX = sx(x); QY = sy(y);
      hov = hit(x, y, 128, 44);
      acc(0);
      i == cur ? gfx_gradrect(QX, QY, 128 * z, 44 * z, acc_r * 0.4, acc_g * 0.4, acc_b * 0.4, 1, 0, 0, 0, 0, -0.1 / (44 * z), -0.1 / (44 * z), -0.1 / (44 * z), 0)
               : ( gfx_set(0.075, 0.08, 0.09, 1); gfx_rect(QX, QY, 128 * z, 44 * z, 1); );
      hov ? ( gfx_set(1, 1, 1, 0.07); gfx_rect(QX, QY, 128 * z, 44 * z, 1); );
      font(1, 9, 'b');
      gfx_set(acc_r, acc_g, acc_b, i == cur ? 1 : 0.6);
      sprintf(#vn, "%02d", i + 1); text_l(#vn, x + 8, y + 6);
      font(2, 12.5, 'b');
      i == cur ? gfx_set(1, 1, 1, 1) : gfx_set(0.85, 0.86, 0.89, 1);
      voice_name(c, i, #vn); upper(#vn); text_l(#vn, x + 8, y + 21);
      (mouse_click && hov) ? ( pick_voice(c, i); mouse_click = 0; );
      i += 1;
    );
  );

  panel(580, 92, 370, 196, "PERFORMANCE", 5);
  knob(616, 150, 16, 3, 1, "OUTPUT", 5);
  knob(682, 150, 16, 6, 0, "CUTOFF", 5);
  knob(748, 150, 16, 7, 0, "RESONANCE", 5);
  knob(814, 150, 16, 9, 1, "TUNE", 5);
  toggle_btn(854, 136, 82, 22, 8, "MONO", 5);
  enum_dd(596, 222, 70, 22, 5, "VOICES", 5);
  enum_dd(676, 222, 70, 22, 4, "MIDI CH", 5);
  enum_dd(756, 222, 58, 22, 10, "BEND UP", 5);
  enum_dd(820, 222, 58, 22, 11, "BEND DN", 5);
  enum_dd(884, 222, 54, 22, 12, "STEP", 5);
  pass == 1 ? (
    font(1, 9, 'b');
    sustain ? ( acc(5); gfx_set(acc_r, acc_g, acc_b, 1); ) : gfx_set(0.3, 0.31, 0.34, 1);
    text_c("SUSTAIN", 895, 170);
    gfx_circle(sx(895), sy(188), 3 * z, 1, 1);
  );

  panel(580, 296, 370, 248, "CONTROLLERS", 3);
  i = 0;
  loop(4,
    y = 344 + i * 48;
    pass == 0 ? ( font(1, 10, 'b'); gfx_set(0.72, 0.73, 0.77, 1); text_l(i == 0 ? "MOD WHEEL" : i == 1 ? "FOOT" : i == 2 ? "BREATH" : "AFTERTOUCH", 596, y - 6); );
    knob(710, y, 13, 13 + i * 4, 0, "", 3);
    toggle_btn(740, y - 10, 62, 20, 14 + i * 4, "PITCH", 3);
    toggle_btn(808, y - 10, 58, 20, 15 + i * 4, "AMP", 3);
    toggle_btn(872, y - 10, 66, 20, 16 + i * 4, "EG BIAS", 3);
    i += 1;
  );
  pass == 0 ? ( font(1, 9, 'b'); gfx_set(0.5, 0.52, 0.56, 1); text_c("RANGE", 710, 318); );
);

function op_card(op, x, y, w, h) local(b, QX, QY, QW, QH, on, hov, lvl, sel, i, sn)
(
  b = 35 + (5 - op) * 21;
  sn = 29 + op;
  sel = sel_op == op;
  acc(1);
  pass == 0 ? (
    gfx_set(0, 0, 0, 0.5); gfx_rect(sx(x) - z, sy(y) - z, (w + 2) * z, (h + 2) * z, 1);
  ) : (
    QX = sx(x); QY = sy(y); QW = w * z; QH = h * z;
    on = slider(sn) >= 0.5;
    hov = hit(x, y, w, h);
    sel ? gfx_gradrect(QX, QY, QW, QH, acc_r * 0.22, acc_g * 0.22, acc_b * 0.22, 1, 0, 0, 0, 0, -0.06 / QH, -0.06 / QH, -0.06 / QH, 0)
        : ( gfx_set(0.085, 0.09, 0.1, 1); gfx_rect(QX, QY, QW, QH, 1); );
    sel ? ( gfx_set(acc_r, acc_g, acc_b, 1); gfx_rect(QX, QY, QW, 2 * z, 1); );
    hov && !sel ? ( gfx_set(1, 1, 1, 0.05); gfx_rect(QX, QY, QW, QH, 1); );
    font(1, 13, 'b');
    on ? gfx_set(1, 1, 1, 1) : gfx_set(0.42, 0.44, 0.48, 1);
    sprintf(#oc, "OP%d", op + 1); text_l(#oc, x + 8, y + 6);
    font(2, 11, 'b');
    gfx_set(acc_r, acc_g, acc_b, on ? 1 : 0.4);
    floor(slider(b + 17) + 0.5) ? strcpy(#of, "") : strcpy(#of, "x ");
    op_freq(5 - op, #oq); strcat(#of, #oq);
    text_r(#of, x + w - 8, y + 8);
    lvl = slider(b + 16) / 99;
    gfx_set(0.04, 0.045, 0.05, 1); gfx_rect(QX + 8 * z, QY + 28 * z, QW - 16 * z, 4 * z, 1);
    gfx_set(acc_r, acc_g, acc_b, on ? 0.9 : 0.3); gfx_rect(QX + 8 * z, QY + 28 * z, (QW - 16 * z) * lvl, 4 * z, 1);
    (mouse_click && hit(x + 4, y + 4, 44, 20)) ? ( tap_sl(sn, on ? 0 : 1); mouse_click = 0; ) :
    (mouse_click && hov) ? ( sel_op = op; bg_dirty = 1; mouse_click = 0; );
  );
);

function ks_graph(x, y, w, h, b) local(QX, QY, QW, QH, bp, ld, rd, lc, rc, i, n, d, gg, px, py, lx, ly, s)
(
  screen(x, y, w, h);
  acc(4);
  QX = sx(x + 4); QY = sy(y + 4); QW = (w - 8) * z; QH = (h - 8) * z;
  bp = floor(slider(b + 8) + 0.5) + 21; ld = slider(b + 9); rd = slider(b + 10);
  lc = floor(slider(b + 11) + 0.5); rc = floor(slider(b + 12) + 0.5);
  gfx_set(1, 1, 1, 0.12); gfx_line(QX, QY + QH * 0.5, QX + QW, QY + QH * 0.5, 1);
  px = QX + (bp - 21) / 99 * QW; gfx_line(px, QY, px, QY + QH, 1);
  gfx_set(acc_r, acc_g, acc_b, 1);
  i = 0;
  loop(100,
    n = 21 + i;
    d = n < bp ? (bp - n) : (n - bp);
    s = n < bp ? lc : rc;
    gg = (s == 1 || s == 2) ? (1 - exp(-d / 20)) : d / 60;
    gg = min(1, gg) * (n < bp ? ld : rd) / 99 * (s < 2 ? -1 : 1);
    py = QY + QH * 0.5 - gg * QH * 0.48;
    px = QX + i / 99 * QW;
    i > 0 ? gfx_line(lx, ly, px, py, 1);
    lx = px; ly = py;
    i += 1;
  );
);

function alg_step(d) local(v, n, i) (
  i = 35 + 134;
  v = floor(slider(i) + 0.5) - slMin[i];
  n = slMax[i] - slMin[i] + 1;
  tap_sl(i, slMin[i] + (v + d + n) % n);
);

function edit_page() local(b, op, i, x, lab)
(
  panel(10, 92, 226, 196, "ALGORITHM", 0);
  algo_diagram(26, 112, 1.25);
  arrow(20, 246, 22, 26, -1) ? alg_step(-1);
  arrow(126, 246, 22, 26, 1) ? alg_step(1);
  pass == 1 ? (
    acc(0); font(1, 15, 'b'); gfx_set(1, 1, 1, 1);
    sprintf(#an, "ALG %d", floor(slider(35 + 134) + 0.5) + 1); text_c(#an, 84, 250);
    hit(44, 244, 80, 30) && mouse_wheel != 0 ? ( alg_step(mouse_wheel > 0 ? 1 : -1); mouse_wheel = 0; );
  );
  knob(194, 256, 12, 35 + 135, 0, "FEEDBACK", 0);

  panel(10, 296, 226, 248, "LFO & GLOBAL", 3);
  enum_dd(24, 332, 96, 22, 35 + 142, "WAVE", 3);
  toggle_btn(130, 332, 94, 22, 35 + 141, "KEY SYNC", 3);
  knob(40, 398, 14, 35 + 137, 0, "SPEED", 3);
  knob(94, 398, 14, 35 + 138, 0, "DELAY", 3);
  knob(148, 398, 14, 35 + 139, 0, "PM DEPTH", 3);
  knob(202, 398, 14, 35 + 140, 0, "AM DEPTH", 3);
  knob(44, 476, 14, 35 + 143, 0, "PM SENS", 3);
  knob(110, 476, 14, 35 + 144, 1, "TRANSPOSE", 3);
  toggle_btn(146, 466, 80, 22, 35 + 136, "OSC SYNC", 3);

  panel(244, 92, 472, 196, "OPERATORS", 1);
  i = 0;
  loop(6, op_card(i, 256 + (i % 3) * 152, 120 + floor(i / 3) * 80, 146, 72); i += 1; );
  pass == 0 ? ( font(1, 9, 'b'); gfx_set(0.5, 0.52, 0.56, 1); text_l("CLICK A CARD TO EDIT IT, ITS NAME TO SWITCH IT", 256, 276); );

  op = sel_op;
  b = 35 + (5 - op) * 21;
  sprintf(#pt, "OPERATOR %d", op + 1);
  panel(244, 296, 472, 248, #pt, 2);
  dx_env(256, 322, 212, 92, b, b + 4, 2, 5 - op);
  i = 0;
  loop(4,
    sprintf(#kr, "R%d", i + 1); knob(274 + i * 50, 446, 11, b + i, 0, #kr, 2);
    sprintf(#kr, "L%d", i + 1); knob(274 + i * 50, 506, 11, b + 4 + i, 0, #kr, 2);
    i += 1;
  );
  knob(508, 350, 15, b + 16, 0, "OUTPUT", 1);
  enum_dd(548, 334, 72, 22, b + 17, "MODE", 1);
  knob(652, 350, 13, b + 20, 1, "DETUNE", 1);
  knob(508, 418, 13, b + 18, 0, "COARSE", 1);
  knob(560, 418, 13, b + 19, 0, "FINE", 1);
  pass == 0 ? ( screen(598, 406, 106, 26); font(1, 9, 'b'); gfx_set(0.62, 0.64, 0.68, 1); text_l("FREQUENCY", 598, 393); );
  pass == 1 ? ( acc(1); font(2, 12, 'b'); gfx_set(acc_r, acc_g, acc_b, 1); op_freq(5 - op, #of); text_c(#of, 651, 412); );
  knob(516, 490, 12, b + 13, 0, "RATE SCALE", 2);
  knob(588, 490, 12, b + 15, 0, "VELOCITY", 1);
  knob(660, 490, 12, b + 14, 0, "AMP MOD", 3);

  panel(724, 92, 226, 196, "PITCH ENVELOPE", 4);
  dx_env(736, 118, 202, 72, 35 + 126, 35 + 130, 4, -1);
  i = 0;
  loop(4,
    sprintf(#kr, "R%d", i + 1); knob(760 + i * 50, 220, 11, 35 + 126 + i, 0, #kr, 4);
    sprintf(#kr, "L%d", i + 1); knob(760 + i * 50, 266, 11, 35 + 130 + i, 1, #kr, 4);
    i += 1;
  );

  panel(724, 296, 226, 248, "KEY SCALING", 4);
  knob(770, 350, 14, b + 9, 0, "L DEPTH", 4);
  knob(837, 350, 14, b + 8, 0, "BREAK PT", 4);
  knob(904, 350, 14, b + 10, 0, "R DEPTH", 4);
  enum_dd(740, 406, 64, 22, b + 11, "L CURVE", 4);
  enum_dd(872, 406, 64, 22, b + 12, "R CURVE", 4);
  pass == 1 ? ks_graph(740, 440, 196, 92, b);
);

function layout()
(
  logo();
  lcd(210, 10, 400, 72);
  tab(624, 14, 78, 26, 0, "PLAY");
  tab(706, 14, 78, 26, 1, "EDIT");
  user_cart = floor(slider1 + 0.5) == 33;
  !user_cart ? name_edit = 0;
  btn_en(624, 50, 78, 24, "STORE", 0, 0, user_cart) ? store_menu();
  btn_en(706, 50, 78, 24, "INIT", 0, 0, user_cart) ? init_req = 1;
  btn_en(870, 50, 78, 24, "NAME", name_edit, 0, user_cart) ? ( name_edit = !name_edit; name_edit ? patch_name(#ned); );
  meters(798, 26, 150, 12);
  page == 0 ? play_page() : edit_page();
  keyboard(10, 552, 940, 80);
);


