function key_up(pitch) local(n, v, found, high, tgt, src)
(
  pitch += patch[144] - 24;
  found = -1;
  n = 0;
  while (found < 0 && n < nvoices) (
    v = voice(n);
    (v[0] == pitch && v[4]) ? ( v[4] = 0; found = n; );
    n += 1;
