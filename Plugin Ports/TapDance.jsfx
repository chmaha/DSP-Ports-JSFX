slider1:k_level=0.75<0,1,0.001>-Level
slider2:k_time=0.5<0,1,0.001>-Time
slider3:k_fb=0.25<0,1,0.001>-Feedback
slider4:k_mod=0<0,1,0.001>-Modulation
slider5:k_dw=0.5<0,1,0.001>-Dry/Wet
slider6:k_morph=0<0,1,0.001>-Morph
slider7:sw_edit=2<0,2,1{Ins,Off,Add}>-Edit
slider8:sw_velo=1<0,2,1{LPF,Amp,Res}>-Velocity Mode
slider9:alt_vel=2<0,4,1{Min,Low,Med,High,Max}>-Velocity Amount
slider10:alt_bank=0<0,3,1{A,B,C,D}>-Bank
slider11:alt_pan=2<0,2,1{Sum/R,Random,Alternate}>-Panning
slider12:alt_mode=0<0,1,1{Edit,Sequencer}>-Mode
slider13:clk_host=0<0,1,1{Off,On}>-Clock From Host
slider14:rep_note=36<0,127,1>-Repeat MIDI Note

in_pin:Left input
in_pin:Right input
out_pin:Left output
out_pin:Right output
options:maxmem=4194304 no_meter

@init

function f32k(x) local(c) ( c = x * 536870913; c - (c - x); );
function alloc(n) local(r) instance(mp) global() ( r = mp; mp += n; memset(r, 0, n); r; );
function itr(x) ( x >= 0 ? floor(x) : -floor(-x); );
function clip16(x) ( x < -32768 ? -32768 : x > 32767 ? 32767 : x; );

