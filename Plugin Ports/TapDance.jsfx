  cmot ? ( png_gate == 0 ? png_gate = 8; );

  dw = pp_dw;
  dwi = ((p_dw - dw) / 64);
  mi = f32k(prev_mt + 64);
  mii = f32k(f32k(mt - mi) / 64);
  dwc = dwi === 0;
  dwc ? (
    ff = (dw * 16);
    ii = itr(ff);
    fr = (ff - ii);
    fi0 = (XIN[ii] + ((XIN[ii + 1] - XIN[ii]) * fr));
    fo0 = (XOUT[ii] + ((XOUT[ii + 1] - XOUT[ii]) * fr));
  );
  i = 0;
  loop(64,
    sl = (SUML[i] * 2);
    sr = (SUMR[i] * 2);
    f = (sl + sr);
    hp = ((((f - (dc_r * dc_s1)) - (dc_g * dc_s1)) - dc_s2) * dc_h);
    bp = ((dc_g * hp) + dc_s1);
    dc_s1 = ((dc_g * hp) + bp);
    lp = ((dc_g * bp) + dc_s2);
    dc_s2 = ((dc_g * bp) + lp);
    FBUF[i] = hp;
    dry = RXB[i] / 32768;
    dwc ? ( fi = fi0; fo = fo0; ) : (
      ff = (dw * 16);
      ii = itr(ff);
      fr = (ff - ii);
      fi = (XIN[ii] + ((XIN[ii + 1] - XIN[ii]) * fr));
      fo = (XOUT[ii] + ((XOUT[ii + 1] - XOUT[ii]) * fr));
    );
    sl = ((dry * fo) + (sl * fi));
    p_pm == 0 ? (
      ip = itr(mi);
      fr = f32k(mi - ip);
      x = cursor - ip;
      xm1 = BUF[x & BMASK]; x0 = BUF[(x - 1) & BMASK]; x1 = BUF[(x - 2) & BMASK]; x2 = BUF[(x - 3) & BMASK];
      c = ((x1 - xm1) * 0.5);
      v = (x0 - x1);
      w = (c + v);
      aa = ((w + v) + ((x2 - x0) * 0.5));
      bneg = (w + aa);
      sr = ((((((((aa * fr) - bneg) * fr) + c) * fr) + x0) / 32768) * 2);
    ) : sr = ((dry * fo) + (sr * fi));
    s = sl; s = ((s * (27 + (s * s))) / (27 + ((9 * s) * s)));
    TXL[i] = clip16(itr((s * 32768)));
    s = sr; s = ((s * (27 + (s * s))) / (27 + ((9 * s) * s)));
    TXR[i] = clip16(itr((s * 32768)));
    dw = (dw + dwi);
    mi = f32k(mi + mii);
    i += 1;
  );

  prev_mt = mt;
  pp_gain = p_gain; pp_scale = p_scale; pp_fb = p_fb; pp_ma = p_ma; pp_mf = p_mf; pp_morph = p_morph; pp_dw = p_dw;
  clk_cnt += 64;
  clk_cnt > maxq_clk ? quant = 0;
);

function ui_event(id, data) (
  ui_mode == 4 ? (
    id + 6 * bank == save_cand ? (
      png_save == 0 ? png_save = 512;
      al_save(save_cand);
      SCUS[save_cand] = 1;
      cur_slot = save_cand;
    );
    ui_mode = 1;
  ) : ui_mode == 1 ? (
    id == 7 ? (
      data >= 400 ? d_set_sync(!dsync) : d_remove_last();
    ) : id == 6 ? (
      data >= 400 ? ( !seq_mode ? d_clear(); ) : d_set_repeat(!(rvol > 0));
    ) : (
      data >= 1200 ? (
        save_cand = bank * 6 + id;
        ui_mode = 4;
      ) : data < 400 ? ui_load_slot(bank * 6 + id, 0);
    );
  );
);

function ui_paint() local(cn, tp, blink, rp, del, i, c, s) (
  cn = cnt_run && p_em != 0;
  tp = cn ? !(png_reset > 0) : (png_reset > 0);
  led_tap = tp;
  blink = (anim % 4) == 0;
  rp = rvol <= 0 ? 0 : rvol < 1 ? blink : 1;
  LEDC[6] = rp ? 7 : 0;
  del = 0;
  png_gate > 0 ? del = 7 : dsync ? del = 1 : quant ? del = 4;
  LEDC[7] = del;
  ui_mode == 4 ? (
    i = 0; loop(6, LEDC[i] = 0; i += 1; );
    s = save_cand % 6;
    LEDC[s] = (anim & 2) ? 1 : 0;
  ) : (
    i = 0;
    loop(6,
      seq_mode ? LEDC[i] = 1 : LEDC[i] = (i <= f32k(vmeter * 6)) ? vmcol : 0;
      i += 1;
    );
    cur_slot >= 0 ? ( floor(cur_slot / 6) == bank ? LEDC[cur_slot % 6] = 2; );
    next_slot >= 0 ? ( floor(next_slot / 6) == bank ? LEDC[next_slot % 6] = ((anim % 4) == 0) ? 2 : 0; );
    save_cand >= 0 ? ( floor(save_cand / 6) == bank && png_save > 0 ? LEDC[save_cand % 6] = 1; );
  );
  (ms & 15) == 0 ? anim = (anim + 1) & 65535;
  png_reset > 0 ? png_reset -= 1;
  png_gate > 0 ? png_gate -= 1;
  png_save > 0 ? png_save -= 1;
  vmeter > 0 ? vmeter = f32k(vmeter - K_C0005);
);

function ui_tick(bdown, swe, swv, av0, av1, av2, av3) local(i, st, ne, pt, v)
(
  i = 0;
  loop(8,
    BST[i] = ((BST[i] * 2) + (bdown[i] ? 0 : 1)) & 255;
    i += 1;
  );
  sw_p0 = sw_s0; sw_s0 = swe == 0 ? 1 : swe == 1 ? 0 : 2;
  sw_p1 = sw_s1; sw_s1 = swv == 0 ? 1 : swv == 1 ? 0 : 2;
  av0 != ALTO[0] ? ( ALTO[0] = av0; SETI[0] = av0; ui_parse(); );
  av1 != ALTO[1] ? ( ALTO[1] = av1; SETI[1] = av1; ui_parse(); );
  av2 != ALTO[2] ? ( ALTO[2] = av2; SETI[2] = av2; ui_parse(); );
  av3 != ALTO[3] ? ( ALTO[3] = av3; SETI[3] = av3; ui_parse(); );
  ms += 1;
  ne = 0;
  i = 0;
  loop(8,
    st = BST[i];
    st == 128 ? ( EVI[ne] = i; EVD[ne] = 0; ne += 1; PRT[i] = ms; LPRT[i] = ms; );
    st == 0 && PRT[i] != 0 ? (
      pt = ms - PRT[i];
      pt > 400 ? ( EVI[ne] = i; EVD[ne] = pt; ne += 1; PRT[i] = 0; );
    );
    st == 0 && LPRT[i] != 0 ? (
      pt = ms - LPRT[i];
      pt > 1200 ? ( EVI[ne] = i; EVD[ne] = pt; ne += 1; LPRT[i] = 0; );
    );
    st == 127 && PRT[i] != 0 ? ( EVI[ne] = i; EVD[ne] = (ms - PRT[i]) + 1; ne += 1; PRT[i] = 0; );
    i += 1;
  );
  sw_s0 != sw_p0 ? ( EVI[ne] = 100; EVD[ne] = sw_s0; ne += 1; );
  sw_s1 != sw_p1 ? ( EVI[ne] = 101; EVD[ne] = sw_s1; ne += 1; );
  ne > 0 ? last_ev = ms;
  ui_paint();
  i = 0;
  loop(ne,
    v = EVI[i];
    v == 100 ? ( p_em = EVD[i]; p_sd = EVD[i]; )
    : v == 101 ? p_vt = EVD[i]
    : EVD[i] != 0 ? ui_event(v, EVD[i]);
    i += 1;
  );
  (ms - last_ev) > 3000 && ui_mode == 4 ? ( ui_mode = 1; last_ev = ms; );
);

function live_keep() ( cur_slot < 0 && next_slot < 0; );

function core_set_sr2(sr) local(nsr, srep, scur, ssy, lk) (
  nsr = floor(sr + 0.5);
  nsr != cur_sr ? (
    srep = rvol > 0; scur = cur_slot; ssy = dsync;
    lk = fixq && live_keep();
    lk ? al_save(24);
    cur_sr = nsr;
    d_change_sr(nsr);
    ld_apply(srep, scur, ssy);
    lk ? ( d_load(24); ui_slot_modified(); );
  );
  uic_th = f32k(f32k(cur_sr) / 1000);
);

function sideload() (
  ADC[0] = f32k(k_time); ADC[1] = f32k(k_fb); ADC[2] = f32k(k_mod); ADC[3] = f32k(k_dw); ADC[4] = f32k(k_morph); ADC[5] = f32k(k_level);
  ADC[6] = 0.5; ADC[7] = 0.5; ADC[8] = 0.5; ADC[9] = 0.5;
  jv_vel = f32k(f32k(jk_vel) / 8);
  ADC[12] = jv_vel < 0 ? 0 : jv_vel > 1 ? 1 : jv_vel;
  gr_prev = gr_val; gr_val = jk_rep > 0.5;
  ADC[13] = jk_tap > 0.5 ? 1 : 0;
  ADC[10] = jk_clk > 0.5 ? 1 : 0;
  ADC[11] = g_tap ? 0.5 : 0;
  GBD[0] = g_b1; GBD[1] = g_b2; GBD[2] = g_b3; GBD[3] = g_b4; GBD[4] = g_b5; GBD[5] = g_b6; GBD[6] = g_rep; GBD[7] = g_del;
  ui_tick(GBD, sw_edit, sw_velo, alt_vel, alt_bank, alt_pan, alt_mode);
);

ext_noinit = gfx_ext_retina = 1;
GBD = alloc(8);
MQ = alloc(1024);
fixq = 1;
g_b1 = g_b2 = g_b3 = g_b4 = g_b5 = g_b6 = g_rep = g_del = g_tap = 0;
jk_rep = jk_tap = jk_vel = jk_clk = 0;
tap_left = clk_left = 0;
mq_n = 0; mq_p = 0;
last_beat = -1;
core_init();
core_set_sr2(srate);
last_srate = srate;
pdc_delay = 64;
pdc_bot_ch = 0;
pdc_top_ch = 2;

@slider

last_srate != srate ? (
  last_srate = srate;
  core_set_sr2(srate);
);

@block

mq_n = 0; mq_p = 0;
while (midirecv(mofs, m1, m2, m3)) (
  mt_s = m1 & 240;
  (mt_s == 144 || mt_s == 128) && mq_n < 340 ? (
    MQ[mq_n * 3] = mofs; MQ[mq_n * 3 + 1] = mt_s == 144 && m3 > 0 ? m3 : 0; MQ[mq_n * 3 + 2] = m2;
    mq_n += 1;
  );
  midisend(mofs, m1, m2, m3);
);
trig_len = floor(srate * 0.01 + 0.5);
clk_on = clk_host && (play_state & 1);
bpos0 = beat_position;
bstep = tempo / (60 * srate);
!clk_on ? last_beat = -1;
smp_i = 0;

@sample

while (mq_p < mq_n && MQ[mq_p * 3] <= smp_i) (
  mv = MQ[mq_p * 3 + 1];
  MQ[mq_p * 3 + 2] == rep_note ? jk_rep = mv > 0 ? 5 : 0
  : mv > 0 ? ( jk_vel = f32k(f32k(mv / 127) * 8); jk_tap = 5; tap_left = trig_len; );
  mq_p += 1;
);
tap_left > 0 ? ( tap_left -= 1; tap_left == 0 ? jk_tap = 0; );
clk_on ? (
  cb = floor(bpos0 + (smp_i * bstep));
  cb != last_beat ? ( last_beat >= 0 || (bpos0 + (smp_i * bstep)) - cb < bstep ? ( jk_clk = 5; clk_left = trig_len; ); last_beat = cb; );
);
clk_left > 0 ? ( clk_left -= 1; clk_left == 0 ? jk_clk = 0; );
smp_i += 1;

uic >= uic_th ? ( uic = 0; sideload(); ) : uic += 1;
fill == 64 ? (
  ui_read_params();
  al_poll();
  d_process();
  fill = 0;
);
vin = f32k(f32k((spl0 + spl1) * 5) / 22);
vin > 1 ? vin = 1 : vin < -1 ? vin = -1;
RXB[fill] = itr(vin * 32767);
spl0 = f32k((TXL[fill] / 32768) * 17) / 10;
spl1 = f32k((TXR[fill] / 32768) * 17) / 10;
fill += 1;

@serialize

sv_ver = 1;
file_var(0, sv_ver);
file_avail(0) < 0 ? (
  sv_rep = rvol > 0; sv_cur = cur_slot; sv_sync = dsync;
  al_save(24);
);
file_var(0, sv_rep);
file_var(0, sv_cur);
file_var(0, sv_sync);
sv_s = 0;
loop(25,
  file_var(0, SCUS[sv_s]);
  SCUS[sv_s] || sv_s == 24 ? (
    file_var(0, SSIZE[sv_s]);
    SSIZE[sv_s] = min(max(SSIZE[sv_s], 0), 32);
    sv_i = 0;
    loop(SSIZE[sv_s],
      file_var(0, STIM[sv_s * 32 + sv_i]); file_var(0, SVEL[sv_s * 32 + sv_i]);
      file_var(0, STYP[sv_s * 32 + sv_i]); file_var(0, SPAN[sv_s * 32 + sv_i]);
      sv_i += 1;
    );
  );
  sv_s += 1;
);
file_avail(0) >= 0 ? (
  ld_apply(sv_rep, sv_cur, sv_sync);
  fixq && sv_cur < 0 ? ( d_load(24); ui_slot_modified(); );
);

@gfx 780 606

UDW = 780;
UDH = 606;
uscale = max(0.5, min(gfx_w / UDW, gfx_h / UDH));
uox = floor((gfx_w - UDW * uscale) * 0.5);
uoy = 0;

function automate(s, e)
(
<?
  max_sliders > 14 ? printf("slider_automate(2^(s-1), e);") :
    printf("s == 1 ? slider_automate(k_level, e) : s == 2 ? slider_automate(k_time, e) : s == 3 ? slider_automate(k_fb, e) : s == 4 ? slider_automate(k_mod, e) : s == 5 ? slider_automate(k_dw, e) : s == 6 ? slider_automate(k_morph, e) : s == 7 ? slider_automate(sw_edit, e) : s == 8 ? slider_automate(sw_velo, e) : s == 9 ? slider_automate(alt_vel, e) : s == 10 ? slider_automate(alt_bank, e) : s == 11 ? slider_automate(alt_pan, e) : s == 12 ? slider_automate(alt_mode, e) : s == 13 ? slider_automate(clk_host, e) : s == 14 ? slider_automate(rep_note, e) :");
?> 0;
);

function smax(s) ( (s == 7 || s == 8 || s == 11) ? 2 : s == 9 ? 4 : s == 10 ? 3 : s == 14 ? 127 : 1; );
function sdef(s) ( s == 1 ? 0.75 : s == 2 ? 0.5 : s == 3 ? 0.25 : s == 5 ? 0.5 : (s == 7 || s == 9 || s == 11) ? 2 : s == 8 ? 1 : s == 14 ? 36 : 0; );
function set_slider(s, x) ( slider(s) = x; automate(s, 0); automate(s, 1); );
function hit_circle(mx, my, cx, cy, rad) ( sqr(mx - cx) + sqr(my - cy) <= sqr(rad); );
function hit_rect(mx, my, x, y, w, h) ( mx >= x && mx <= x + w && my >= y && my <= y + h; );
function px(x) ( floor(uox + x * uscale + 0.5); );
function py(y) ( floor(uoy + y * uscale + 0.5); );
function pl(v) ( floor(v * uscale + 0.5); );
function set_norm(s, x) local(old, nv)
(
  old = slider(s);
  nv = max(0, min(1, x));
  nv = floor(nv * 1000 + 0.5) / 1000;
  slider(s) = nv;
  slider(s) !== old ? automate(s, 0);
);
function ctextm(str, cx, cy, fz, fl) local(tw, th)
(
  gfx_setfont(1, "Arial", floor(fz * uscale + 0.5), fl);
  gfx_measurestr(str, tw, th);
  gfx_x = floor(cx - tw * 0.5 + 0.5); gfx_y = floor(cy - th * 0.5 + 0.5);
  gfx_drawstr(str);
);
function ltext(str, x, y, fz, fl)
(
  gfx_setfont(1, "Arial", floor(fz * uscale + 0.5), fl);
  gfx_x = px(x); gfx_y = py(y);
  gfx_drawstr(str);
);
function ledcol(c, k)
(
  c == 0 ? gfx_set(k * 0.80, k * 0.80, k * 0.81, 1)
  : gfx_set((c & 1) ? 0.98 : 0.10, (c & 2) ? ((c & 1) ? 0.82 : 0.80) : 0.12, (c & 4) ? 0.98 : 0.12, 1);
);
function notename(n) local(o, k)
(
  o = floor(n / 12) - 1; k = n - 12 * floor(n / 12);
  sprintf(#unn, "%s%d", k == 0 ? "C" : k == 1 ? "C#" : k == 2 ? "D" : k == 3 ? "D#" : k == 4 ? "E" : k == 5 ? "F" : k == 6 ? "F#" : k == 7 ? "G" : k == 8 ? "G#" : k == 9 ? "A" : k == 10 ? "A#" : "B", o);
  #unn;
);

function knob_name(s)
(
  s == 1 ? "Level" : s == 2 ? "Time" : s == 3 ? "Feedback" : s == 4 ? "Modulation" : s == 5 ? "Dry/Wet" : "Morph";
);
function knob_value(s) local(x, r)
(
  x = slider(s);
  s == 1 ? ( p_gain > 0.0001 ? sprintf(#uval, "%+.1f dB", 20 * log10(p_gain)) : strcpy(#uval, "-inf dB"); )
  : s == 2 ? (
    dsync ? (
      r = p_sr;
      r < 1 ? sprintf(#uval, "sync 1/%d", floor(1 / r + 0.5)) : sprintf(#uval, "sync x%d", r);
    ) : sprintf(#uval, "x%.2f", p_scale);
  )
  : s == 5 ? sprintf(#uval, "%.0f%% wet", x * 100)
  : s == 6 ? sprintf(#uval, "%.0f ms", 1000 * p_morph / max(1, cur_sr))
  : sprintf(#uval, "%.0f%%", x * 100);
  #uval;
);
function hint_text(h)
(
  h == 1 ? strcpy(#uhint, "Level: input gain into the delay line")
  : h == 2 ? strcpy(#uhint, "Time: stretches or squeezes the whole tap rhythm (with Sync: the clock ratio)")
  : h == 3 ? strcpy(#uhint, "Feedback: how often the rhythm repeats")
  : h == 4 ? strcpy(#uhint, "Modulation: random wobble of every tap's delay time (more = slower and deeper)")
  : h == 5 ? strcpy(#uhint, "Dry/Wet: balance between the input and the taps")
  : h == 6 ? strcpy(#uhint, "Morph: fade time when taps appear, disappear or patterns change")
  : h == 7 ? strcpy(#uhint, alt_mode >= 0.5 ? "Sequencer direction: Random / Forward / Walk" : "Edit: Add appends taps, Off ignores taps, Ins inserts taps into the running loop")
  : h == 8 ? strcpy(#uhint, "Velocity mode for new taps: Res = band-pass, Amp = level, LPF = low-pass")
  : h == 9 ? strcpy(#uhint, "Velocity amount: how much tap velocity changes the sound")
  : h == 10 ? strcpy(#uhint, "Bank: which six rhythms the buttons recall")
  : h == 11 ? strcpy(#uhint, "Pan: Sum/R = mix on the left, last tap alone on the right; Rnd = random; Alt = alternate")
  : h == 12 ? strcpy(#uhint, "Mode: Edit records taps; Seq steps through the six rhythms on every tap")
  : h == 13 ? strcpy(#uhint, "Clock from host: one clock pulse per beat while the transport plays (Sync, tap quantise)")
  : h == 14 ? strcpy(#uhint, "Repeat note: this MIDI note works like the Repeat gate; every other note taps")
  : h == 20 ? strcpy(#uhint, "Buttons 1-6: click = recall rhythm; hold 1.2 s until it blinks red, then click it again = save")
  : h == 21 ? strcpy(#uhint, "Repeat: click = loop the current pattern; hold = clear all taps")
  : h == 22 ? strcpy(#uhint, "Delete: click = remove the last tap; hold = toggle Sync to the clock")
  : h == 23 ? strcpy(#uhint, alt_mode >= 0.5 ? "Tap: step to the next rhythm" : "Tap: the first tap starts the count, each next tap adds an echo at that time")
  : strcpy(#uhint, "Tap a rhythm on the pad (or play MIDI notes): every tap becomes an echo  ·  drag knobs, double-click = default");
  #uhint;
);

function stripe(cx, y) local(w, h, g, x0)
(
  w = pl(13); h = max(2, pl(3)); g = pl(4);
  x0 = floor(px(cx) - (3 * w + 2 * g) * 0.5);
  gfx_set(0.91, 0.12, 0.15, 1); gfx_rect(x0, py(y), w, h, 1);
  gfx_set(0.15, 0.64, 0.88, 1); gfx_rect(x0 + w + g, py(y), w, h, 1);
  gfx_set(0.0, 0.62, 0.32, 1); gfx_rect(x0 + 2 * (w + g), py(y), w, h, 1);
);

function arcw(cx, cy, r, a0, a1, th) local(k, n)
(
  n = max(1, ceil(th * 2));
  k = 0;
  loop(n, gfx_arc(cx, cy, r - th * 0.5 + k * th / n, a0, a1, 1); k += 1; );
);

function knob(s, x, y, rb0, cr, cg, cb) local(cx, cy, hov, kn, a, ca, sa, rb, ra, k, d)
(
  cx = px(x); cy = py(y);
  hov = hit_circle(mouse_x, mouse_y, cx, cy, (rb0 + 9) * uscale);
  hov ? u_hov = s;
  (u_click && hov) ? (
    (u_ctarget == s && time_precise() - u_ctime < 0.3) ? (
      set_slider(s, sdef(s));
      u_drag = 0;
    ) : (
      u_drag = s; u_dy0 = mouse_y; u_dv0 = slider(s); u_dfine = mouse_cap & 4;
      automate(s, 0);
    );
    u_ctarget = s; u_ctime = time_precise();
    u_click = 0;
  );
  (hov && u_wheel != 0 && u_drag == 0) ? (
    set_norm(s, slider(s) + (u_wheel / 120) * ((mouse_cap & 4) ? 0.004 : 0.02));
    automate(s, 1);
    u_wheel = 0;
  );
  kn = max(0, min(1, slider(s)));
  ra = (rb0 + 6.5) * uscale; rb = rb0 * uscale;
  a = (-150 + 300 * kn) * $pi / 180;
  gfx_set(0.78, 0.78, 0.79, 1);
  arcw(cx, cy, ra, -150 * $pi / 180, 150 * $pi / 180, 3 * uscale);
  gfx_set(cr, cg, cb, 1);
  kn > 0.002 ? arcw(cx, cy, ra, -150 * $pi / 180, a, 3 * uscale);
  gfx_set(0.05, 0.05, 0.055, 1);
  gfx_circle(cx, cy, rb, 1, 1);
  gfx_set((hov || u_drag == s) ? 0.42 : 0.26, (hov || u_drag == s) ? 0.42 : 0.26, (hov || u_drag == s) ? 0.44 : 0.27, 1);
  gfx_circle(cx, cy, rb, 0, 1);
  ca = cos(a); sa = sin(a);
  gfx_set(0.98, 0.98, 0.98, 1);
  d = -1.2;
  loop(9,
    k = d * uscale;
    gfx_line(cx + sa * 5 * uscale + ca * k, cy - ca * 5 * uscale + sa * k, cx + sa * (rb - 3.5 * uscale) + ca * k, cy - ca * (rb - 3.5 * uscale) + sa * k, 1);
    d += 0.3;
  );
  gfx_set(0.09, 0.09, 0.10, 1);
  ctextm(knob_name(s), cx, py(y + rb0 + 19), 13, 'b');
  gfx_set(0.38, 0.39, 0.41, 1);
  ctextm(knob_value(s), cx, py(y + rb0 + 34), 11, 0);
);

function tswitch(s, x, y, l2, l1, l0) local(i, on, hov, yy, lab, v)
(
  v = floor(slider(s) + 0.5);
  gfx_set(0.58, 0.58, 0.60, 1);
  gfx_roundrect(px(x - 7), py(y - 26), pl(14), pl(52), pl(6), 1);
  gfx_set(0.20, 0.20, 0.21, 1);
  gfx_rect(px(x - 6) + 1, py(y - 25) + 1, pl(12) - 1, pl(50) - 1, 1);
  gfx_set(0.86, 0.86, 0.87, 1);
  gfx_circle(px(x), py(y + (1 - v) * 16), 5.5 * uscale, 1, 1);
  i = 0;
  loop(3,
    yy = y + (1 - i) * 16;
    lab = i == 2 ? l2 : i == 1 ? l1 : l0;
    hov = hit_rect(mouse_x, mouse_y, px(x - 46), py(yy - 8), pl(92), pl(16));
    hov ? u_hov = s;
    (u_click && hov) ? ( v != i ? set_slider(s, i); u_click = 0; );
    on = v == i;
    on ? gfx_set(0.09, 0.09, 0.10, 1) : gfx_set(hov ? 0.22 : 0.40, hov ? 0.22 : 0.41, hov ? 0.24 : 0.43, 1);
    s == 7 ? ltext(lab, x - 46, yy - 7, 11, 'b') : ltext(lab, x + 12, yy - 7, 11, 'b');
    i += 1;
  );
);

function button(id, x, y, r0, led) local(cx, cy, r, hov, dn)
(
  cx = px(x); cy = py(y); r = r0 * uscale;
  hov = hit_circle(mouse_x, mouse_y, cx, cy, r + 4 * uscale);
  hov ? u_hov = id < 6 ? 20 : id == 6 ? 21 : 22;
  (u_click && hov) ? ( u_btn = id + 1; u_click = 0; );
  dn = u_btn == id + 1 && u_down;
  gfx_set(0.58, 0.58, 0.60, 1); gfx_circle(cx, cy, r + 2.5 * uscale, 1, 1);
  ledcol(led, 1);
  gfx_circle(cx, cy, r + 1.2 * uscale, 1, 1);
  led ? ledcol(led, 1) : gfx_set(hov ? 1 : 0.975, hov ? 1 : 0.975, hov ? 1 : 0.98, 1);
  dn ? gfx_set(0.72, 0.73, 0.75, 1);
  gfx_circle(cx, cy, r - 1.5 * uscale, 1, 1);
  led && !dn ? ( gfx_set(1, 1, 1, 0.35); gfx_circle(cx - r * 0.25, cy - r * 0.25, r * 0.35, 1, 1); );
);

function tag(str, cx, y, w)
(
  gfx_set(0.09, 0.09, 0.10, 1);
  gfx_rect(px(cx - w * 0.5), py(y), pl(w), pl(14), 1);
  gfx_set(0.97, 0.97, 0.98, 1);
  ctextm(str, px(cx), py(y + 7), 11, 'b');
);

function gcol(c) ( px(96 + c * 64); );
function cells(s, row, lab, n, l0, l1, l2, l3, l4) local(y0, y1, c0, i, on, hov, xa, xb, lb)
(
  y0 = py(46 + row * 17); y1 = py(46 + row * 17 + 16);
  c0 = 5 - n;
  xa = gcol(c0 - 1); xb = gcol(c0);
  gfx_set(0.09, 0.09, 0.10, 1);
  gfx_rect(xa, y0, xb - xa + 1, y1 - y0 + 1, 1);
  gfx_set(0.97, 0.97, 0.98, 1);
  ctextm(lab, (xa + xb) * 0.5, (y0 + y1) * 0.5, 11, 'b');
  i = 0;
  loop(n,
    xa = gcol(c0 + i); xb = gcol(c0 + i + 1);
    on = floor(slider(s) + 0.5) == i;
    hov = hit_rect(mouse_x, mouse_y, xa, y0, xb - xa, y1 - y0);
    hov ? u_hov = s;
    (u_click && hov) ? ( !on ? set_slider(s, i); u_click = 0; );
    gfx_set(0.09, 0.09, 0.10, 1);
    gfx_rect(xa, y0, xb - xa + 1, y1 - y0 + 1, 0);
    on ? gfx_set(0.15, 0.64, 0.88, 1) : gfx_set(hov ? 0.86 : 0.97, hov ? 0.87 : 0.97, hov ? 0.88 : 0.98, 1);
    gfx_rect(xa + 1, y0 + 1, xb - xa - 1, y1 - y0 - 1, 1);
    on ? gfx_set(0.02, 0.05, 0.08, 1) : gfx_set(0.09, 0.09, 0.10, 1);
    lb = i == 0 ? l0 : i == 1 ? l1 : i == 2 ? l2 : i == 3 ? l3 : l4;
    ctextm(lb, (xa + xb) * 0.5, (y0 + y1) * 0.5, 11, 'b');
    i += 1;
  );
);

function seg(s, x, y, w, h, l0, l1) local(qx, qy, qw, qh, i, on, hov, bx, bw)
(
  qx = px(x); qy = py(y); qw = pl(w); qh = pl(h);
  gfx_set(0.06, 0.06, 0.07, 1);
  gfx_roundrect(qx - 1, qy - 1, qw + 2, qh + 2, pl(5), 1);
  i = 0;
  loop(2,
    bx = qx + floor(i * qw * 0.5);
    bw = i == 0 ? floor(qw * 0.5) : qw - floor(qw * 0.5);
    on = floor(slider(s) + 0.5) == i;
    hov = hit_rect(mouse_x, mouse_y, bx, qy, bw, qh);
    hov ? u_hov = s;
    (u_click && hov) ? ( !on ? set_slider(s, i); u_click = 0; );
    on ? gfx_set(0.15, 0.64, 0.88, 1) : gfx_set(hov ? 0.27 : 0.21, hov ? 0.27 : 0.21, hov ? 0.29 : 0.23, 1);
    gfx_rect(bx + 1, qy + 1, bw - 2, qh - 2, 1);
    on ? gfx_set(0.03, 0.06, 0.09, 1) : gfx_set(0.86, 0.87, 0.89, 1);
    ctextm(i == 0 ? l0 : l1, bx + bw * 0.5, qy + qh * 0.5, 12, 'b');
    i += 1;
  );
);

function stepper(s, x, y, w, h) local(qx, qy, qw, qh, hl, hr, v)
(
  qx = px(x); qy = py(y); qw = pl(w); qh = pl(h);
  v = floor(slider(s) + 0.5);
  hl = hit_rect(mouse_x, mouse_y, qx, qy, pl(28), qh);
  hr = hit_rect(mouse_x, mouse_y, qx + qw - pl(28), qy, pl(28), qh);
  (hl || hr || hit_rect(mouse_x, mouse_y, qx, qy, qw, qh)) ? u_hov = s;
  (u_click && hl) ? ( set_slider(s, max(0, v - 1)); u_click = 0; );
  (u_click && hr) ? ( set_slider(s, min(127, v + 1)); u_click = 0; );
  (hit_rect(mouse_x, mouse_y, qx, qy, qw, qh) && u_wheel != 0) ? ( set_slider(s, max(0, min(127, v + (u_wheel > 0 ? 1 : -1)))); u_wheel = 0; );
  gfx_set(0.06, 0.06, 0.07, 1);
  gfx_roundrect(qx - 1, qy - 1, qw + 2, qh + 2, pl(5), 1);
  gfx_set(0.21, 0.21, 0.23, 1);
  gfx_rect(qx + 1, qy + 1, qw - 2, qh - 2, 1);
  gfx_set(hl ? 0.32 : 0.26, hl ? 0.32 : 0.26, hl ? 0.34 : 0.28, 1); gfx_rect(qx + 1, qy + 1, pl(28) - 1, qh - 2, 1);
  gfx_set(hr ? 0.32 : 0.26, hr ? 0.32 : 0.26, hr ? 0.34 : 0.28, 1); gfx_rect(qx + qw - pl(28), qy + 1, pl(28) - 1, qh - 2, 1);
  gfx_set(0.86, 0.87, 0.89, 1);
  ctextm("-", qx + pl(14), qy + qh * 0.5, 14, 'b');
  ctextm("+", qx + qw - pl(14), qy + qh * 0.5, 14, 'b');
  sprintf(#ustp, "%s  (%d)", notename(v), v);
  ctextm(#ustp, qx + qw * 0.5, qy + qh * 0.5, 12, 'b');
);

function glabel(str, x, y)
(
  gfx_set(0.62, 0.64, 0.68, 1);
  ltext(str, x, y, 12, 'b');
);

function timeline(x, y, w, h) local(qx, qy, qw, qh, tot, i, n, tx, th, vt, act, ph, mtv)
(
  qx = px(x); qy = py(y); qw = pl(w); qh = pl(h);
  gfx_set(0.06, 0.06, 0.07, 1);
  gfx_rect(qx, qy, qw, qh, 1);
  gfx_set(0.30, 0.31, 0.33, 1);
  gfx_rect(qx, qy + qh - pl(10), qw, 1, 1);
  tot = al_max;
  n = 0;
  tot > 0 ? (
    i = 0;
    loop(32,
      act = TVOL[i] > 0 || TINC[i] > 0;
      act ? (
        n += 1;
        tx = qx + pl(4) + floor((qw - pl(8)) * TTIM[i] / tot);
        th = max(pl(3), floor((qh - pl(16)) * max(0.08, TVEL[i])));
        vt = TVT[i];
        vt == 1 ? gfx_set(0.98, 0.62, 0.10, 0.4 + 0.6 * min(1, TVOL[i])) : vt == 2 ? gfx_set(0.15, 0.64, 0.88, 0.4 + 0.6 * min(1, TVOL[i])) : gfx_set(0.92, 0.93, 0.95, 0.4 + 0.6 * min(1, TVOL[i]));
        gfx_rect(tx - max(1, pl(1)), qy + qh - pl(10) - th, max(2, pl(3)), th, 1);
        gfx_set(0.56, 0.58, 0.62, 1);
        gfx_circle(tx, qy + qh - pl(5) - floor(pl(3) * (TPAN[i] - 0.5)), max(1, pl(1.4)), 1, 1);
      );
      i += 1;
    );
    mtv = floor(tot * p_scale);
    cnt_run && mtv > 0 ? (
      ph = (cnt - mtv * floor(cnt / mtv)) / mtv;
      gfx_set(0.91, 0.12, 0.15, 1);
      gfx_rect(qx + pl(4) + floor((qw - pl(8)) * min(1, ph)), qy + pl(2), max(1, pl(1.5)), qh - pl(12), 1);
    );
  );
  gfx_set(0.62, 0.64, 0.68, 1);
  n == 0 ? strcpy(#utl, cnt_run ? "counting - tap again" : "no taps") : sprintf(#utl, "%d tap%s  ·  %.2f s", n, n == 1 ? "" : "s", tot * p_scale / max(1, cur_sr));
  ltext(#utl, x, y + h + 4, 11, 0);
  i = 0;
  loop(3,
    i == 0 ? gfx_set(0.98, 0.62, 0.10, 1) : i == 1 ? gfx_set(0.92, 0.93, 0.95, 1) : gfx_set(0.15, 0.64, 0.88, 1);
    gfx_rect(px(x + i * 64), py(y + h + 22), pl(3), pl(10), 1);
    gfx_set(0.62, 0.64, 0.68, 1);
    ltext(i == 0 ? "LPF" : i == 1 ? "Amp" : "Res", x + i * 64 + 8, y + h + 20, 11, 0);
    i += 1;
  );
);

u_down = mouse_cap & 1;
u_click = u_down && !u_pstate;
u_wheel = mouse_wheel;
mouse_wheel = 0;
u_hov = 0;

gfx_set(0.10, 0.10, 0.105, 1);
gfx_rect(0, 0, gfx_w, gfx_h, 1);

gfx_set(0.70, 0.70, 0.71, 1);
gfx_roundrect(px(12), py(12), pl(520), pl(552), pl(6), 1);
gfx_set(0.925, 0.925, 0.93, 1);
gfx_rect(px(12) + 1, py(12) + 1, pl(520) - 1, pl(552) - 1, 1);
stripe(272, 24);

cells(12, 0, "MODE", 2, "EDIT", "SEQ", "", "", "");
cells(11, 1, "PAN", 3, "SUM/R", "RND", "ALT", "", "");
cells(10, 2, "BANK", 4, "A", "B", "C", "D", "");
cells(9, 3, "VEL", 5, "MIN", "LOW", "MED", "HIGH", "MAX");

u_i = 0;
loop(6,
  gfx_set(0.09, 0.09, 0.10, 1);
  sprintf(#ubn, "%d", alt_bank * 6 + u_i + 1);
  ctextm(#ubn, px(90 + u_i * 72), py(134), 12, 'b');
  button(u_i, 90 + u_i * 72, 158, 13, LEDC[u_i]);
  u_i += 1;
);

knob(1, 82, 214, 16, 0.15, 0.64, 0.88);
knob(6, 460, 214, 16, 0.15, 0.64, 0.88);
knob(3, 200, 262, 26, 0.91, 0.12, 0.15);
knob(4, 342, 262, 26, 0.0, 0.62, 0.32);
knob(2, 82, 326, 26, 0.15, 0.64, 0.88);
knob(5, 460, 326, 26, 0.15, 0.64, 0.88);

gfx_set(0.09, 0.09, 0.10, 1);
ctextm(alt_mode >= 0.5 ? "Next" : "Tap", px(271), py(404), 14, 'b');
gfx_set(0.58, 0.58, 0.60, 1); gfx_circle(px(271), py(422), 5 * uscale, 1, 1);
led_tap ? gfx_set(0.98, 0.16, 0.14, 1) : gfx_set(0.34, 0.20, 0.20, 1);
gfx_circle(px(271), py(422), 3.6 * uscale, 1, 1);

u_tx = px(271); u_ty = py(480); u_tr = 44 * uscale;
u_thov = hit_circle(mouse_x, mouse_y, u_tx, u_ty, u_tr);
u_thov ? u_hov = 23;
(u_click && u_thov) ? ( u_btn = 9; u_click = 0; );
u_tdn = u_btn == 9 && u_down;
gfx_set(0.09, 0.09, 0.10, 1); gfx_circle(u_tx, u_ty, u_tr + 4 * uscale, 1, 1);
gfx_set(0.80, 0.62, 0.30, 1); gfx_circle(u_tx, u_ty, u_tr, 1, 1);
gfx_set(u_tdn ? 0.62 : 0.72, u_tdn ? 0.46 : 0.55, u_tdn ? 0.20 : 0.26, 1); gfx_circle(u_tx, u_ty, u_tr - 4 * uscale, 1, 1);
gfx_set(0.48, 0.34, 0.14, 1);
u_i = 1;
loop(5, gfx_circle(u_tx, u_ty, (u_tr - 4 * uscale) * u_i / 6, 0, 1); u_i += 1; );
u_thov && !u_tdn ? ( gfx_set(1, 1, 1, 0.12); gfx_circle(u_tx, u_ty, u_tr - 4 * uscale, 1, 1); );

button(6, 140, 466, 13, LEDC[6]);
gfx_set(0.09, 0.09, 0.10, 1);
ctextm("Repeat", px(140), py(492), 14, 'b');
tag("Clear", 140, 502, 46);
button(7, 402, 466, 13, LEDC[7]);
gfx_set(0.09, 0.09, 0.10, 1);
ctextm("Delete", px(402), py(492), 14, 'b');
tag("Sync", 402, 502, 46);

alt_mode >= 0.5 ? tswitch(7, 74, 486, "RND", "FWD", "WALK") : tswitch(7, 74, 486, "ADD", "OFF", "INS");
tswitch(8, 470, 486, "RES", "AMP", "LPF");

gfx_set(0.09, 0.09, 0.10, 1);
ctextm("TAPOGRAPHIC DELAY", px(272), py(546), 17, 'b');

gfx_set(0.15, 0.155, 0.165, 1);
gfx_roundrect(px(542), py(12), pl(226), pl(552), pl(7), 1);
gfx_set(0.95, 0.95, 0.96, 1);
ltext("Tap Dance", 558, 28, 24, 'b');
gfx_set(0.15, 0.64, 0.88, 1);
ltext("4ms Tapographic Delay", 559, 62, 12, 0);
gfx_set(0.62, 0.64, 0.68, 1);
ltext("by chmaha", 559, 79, 12, 0);

glabel("TAPS", 559, 110);
timeline(559, 128, 192, 92);

glabel("CLOCK FROM HOST", 559, 266);
seg(13, 559, 284, 192, 28, "OFF", "ON");
gfx_set(0.62, 0.64, 0.68, 1);
u_ls = dsync ? "SYNC on" : quant ? "quantising taps to clock" : "free";
ltext(u_ls, 559, 320, 11, 0);

glabel("REPEAT NOTE", 559, 350);
stepper(14, 559, 368, 192, 28);

gfx_set(0.56, 0.58, 0.62, 1);
ltext("MIDI: notes tap with their velocity;", 559, 408, 11, 0);
ltext("the Repeat note toggles Repeat on", 559, 423, 11, 0);
ltext("press and on release.", 559, 438, 11, 0);
ltext("Hold a button 1.2 s, click again:", 559, 466, 11, 0);
ltext("saves the rhythm with the project.", 559, 481, 11, 0);
ltext("Tapo by Matthias Puech (MIT)", 559, 520, 11, 0);
ltext("4ms CoreModules  ·  GPLv3", 559, 535, 11, 0);

u_btn > 0 ? (
  u_down ? (
    u_btn == 1 ? g_b1 = 1 : u_btn == 2 ? g_b2 = 1 : u_btn == 3 ? g_b3 = 1 : u_btn == 4 ? g_b4 = 1 : u_btn == 5 ? g_b5 = 1 : u_btn == 6 ? g_b6 = 1
    : u_btn == 7 ? g_rep = 1 : u_btn == 8 ? g_del = 1 : g_tap = 1;
  ) : (
    g_b1 = g_b2 = g_b3 = g_b4 = g_b5 = g_b6 = g_rep = g_del = g_tap = 0;
    u_btn = 0;
  );
);

u_drag > 0 ? (
  u_down ? (
    mouse_cap |= 65536;
    u_fine = mouse_cap & 4;
    u_fine != u_dfine ? ( u_dy0 = mouse_y; u_dv0 = slider(u_drag); u_dfine = u_fine; );
    set_norm(u_drag, u_dv0 + (u_dy0 - mouse_y) / (150 * uscale) * (u_fine ? 0.1 : 1));
  ) : (
    automate(u_drag, 1);
    u_drag = 0;
  );
);

gfx_set(0.17, 0.17, 0.18, 1);
gfx_rect(px(0), py(576), pl(UDW), pl(30), 1);
gfx_setfont(1, "Arial", floor(13 * uscale + 0.5));
gfx_set(0.82, 0.83, 0.85, 1);
hint_text(u_drag > 0 ? u_drag : u_hov);
gfx_measurestr(#uhint, u_tw, u_th);
u_tw > (UDW - 20) * uscale ? ( gfx_setfont(1, "Arial", 13 * uscale * (UDW - 20) * uscale / u_tw); gfx_measurestr(#uhint, u_tw, u_th); );
gfx_x = floor(uox + (UDW * uscale - u_tw) * 0.5); gfx_y = floor(py(576) + (30 * uscale - u_th) * 0.5);
gfx_drawstr(#uhint);

u_pstate = u_down;
