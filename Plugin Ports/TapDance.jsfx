function tdec(t, s) local(i, n, c, m, k, st, ind, idx)
(
  i = 0; n = strlen(s); m = 0; k = 0; st = 0; ind = 0; idx = 0;
  while (i <= n) (
    c = i < n ? str_getchar(s, i) : 44;
    c == 44 ? (
      ind ? ( t[idx] = m / (2 ^ k); idx += 1; );
      m = 0; k = 0; st = 0; ind = 0;
    ) : c == 47 ? (
      st = 1;
    ) : (
      st ? k = (k * 10) + (c - 48) : m = (m * 10) + (c - 48);
      ind = 1;
    );
    i += 1;
  );
  idx;
);

