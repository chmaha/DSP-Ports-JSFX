Version: 1.1
desc: Potato Quality Lo-Fi Degrader (mda port) by chmaha
tags: lo-fi bitcrusher distortion
author: chmaha
changelog:
  The GUI sits at the top of the window instead of being centred vertically.
about:
  Sample quality reduction: lower the bit depth and sample rate, add harmonic "thickening",
  clip the peaks and muffle the result with a steep low-pass filter.
  Starts clean (24 bits, full rate, no thickening, filter off) so you can dial the damage in.
  Turn Rate left of centre to hold single samples (gritty, aliased) or right to hold averaged samples (smoother);
  turn Non-Lin left for even harmonics or right for odd harmonics.
  Mono sums the input like the original plugin; Stereo degrades each channel on its own.
  Ported from mda-lv2 by Paul Kellett (Maxim Digital Audio) and David Robillard
  https://gitlab.com/drobilla/mda-lv2 (GPLv3+)
  JSFX version released under GPLv3+ license
  Claude generated some of this code

slider1:1<0,1,0.001>-Headroom
slider2:24<4,24,1>-Quant (bits)
slider3:0.5<0,1,0.001>-Rate
slider4:0.9<0,1,0.001>-Post Filter
slider5:0.5<0,1,0.001>-Non-Lin
slider6:0.5<0,1,0.001>-Output
slider7:1<0,1,1{Mono,Stereo}>-Channels
slider8:0<0,1,1{Off,On}>-Post Filter Enable

in_pin:Left input
in_pin:Right input
out_pin:Left output
out_pin:Right output
options:no_meter

@init

ext_noinit = gfx_ext_retina = 1;
ext_nodenorm = 1;

SC_N = 4096;
sc_buf = 0;
memset(sc_buf, 0, SC_N);
sc_wp = 0;

c_sr = -1;
c_p7 = slider7;

function itrunc(x) ( x < 0 ? ceil(x) : floor(x); );

function rate_tn(p) ( floor(exp(18 * (p > 0.5 ? p - 0.5 : 0.5 - p))); );

function filter_freq(hz)
local(j, k, r)
(
  r = 0.999;
  j = r * r - 1;
  k = 2 - 2 * r * r * cos(0.647 * hz / srate);
  (sqrt(k * k - 4 * j * j) - k) / (2 * j);
);

function set_params()
local(g)
(
  d_mode = slider3 > 0.5 ? 1 : 0;
  d_tn = rate_tn(slider3);
  d_clp = pow(10, -1.5 + 1.5 * slider1);
  d_fo2 = filter_freq(pow(10, 2.30104 + 2 * slider4));
  d_fi2 = 1 - d_fo2; d_fi2 = d_fi2 * d_fi2; d_fi2 = d_fi2 * d_fi2;
  g = pow(2, slider2 - 2);
  d_g2 = 1 / (2 * g);
  d_g1 = slider3 > 0.5 ? -g / d_tn : -g;
  d_g3 = pow(10, 2 * slider6 - 1);
  slider5 > 0.5 ? (
    d_lin = pow(10, 0.3 * (0.5 - slider5)); d_lin2 = d_lin;
  ) : (
    d_lin = pow(10, 0.3 * (slider5 - 0.5)); d_lin2 = 1;
  );
);

function ch_reset()
instance(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, t, tblock)
(
  b0 = b1 = b2 = b3 = b4 = b5 = b6 = b7 = b8 = b9 = 0;
  t = tblock = 1;
);

function ch_block()
instance(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, t, tblock)
(
  abs(b1) < 0.0000000001 ? (
    b0 = b1 = b2 = b3 = b4 = b5 = b6 = b7 = b8 = b9 = 0;
    t = tblock;
  );
  tblock = t;
);

function ch_restart() instance(t, tblock) ( t = tblock = 1; );

function ch_proc(x)
instance(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, t)
(
  b0 = x + d_mode * b0;

  t === d_tn ? (
    t = 0;
    b5 = d_g2 * itrunc(b0 * d_g1);
    b5 > 0 ? (
      b5 = pow(b5, d_lin2); b5 > d_clp ? b5 = d_clp;
    ) : (
      b5 = -pow(-b5, d_lin); b5 < -d_clp ? b5 = -d_clp;
    );
    b0 = 0;
  );
  t += 1;

  b1 = d_fi2 * (b5 * d_g3) + d_fo2 * b1;
  b2 = b1 + d_fo2 * b2;
  b3 = b2 + d_fo2 * b3;
  b4 = b3 + d_fo2 * b4;
  b6 = d_fi2 * b4 + d_fo2 * b6;
  b7 = b6 + d_fo2 * b7;
  b8 = b7 + d_fo2 * b8;
  b9 = b8 + d_fo2 * b9;

  slider8 >= 0.5 ? -b9 : -(b5 * d_g3);
);

dl.ch_reset();
dr.ch_reset();

@block

dl.ch_block();
dr.ch_block();

slider7 !== c_p7 ? (
  c_p7 = slider7;
  dr.ch_reset();
);

(srate !== c_sr || slider1 !== c_p1 || slider2 !== c_p2 || slider3 !== c_p3 ||
 slider4 !== c_p4 || slider5 !== c_p5 || slider6 !== c_p6) ? (
  srate !== c_sr ? meter_decay = pow(0.001, 1 / (0.4 * srate));
  c_sr = srate;
  c_p1 = slider1; c_p2 = slider2; c_p3 = slider3;
  c_p4 = slider4; c_p5 = slider5; c_p6 = slider6;
  set_params();
  dl.ch_restart();
  dr.ch_restart();
);

@sample

slider7 >= 0.5 ? (
  spl0 = dl.ch_proc(spl0 + spl0);
  spl1 = dr.ch_proc(spl1 + spl1);
) : (
  spl0 = spl1 = dl.ch_proc(spl0 + spl1);
);

sc_buf[sc_wp] = spl0;
sc_wp = (sc_wp + 1) & (SC_N - 1);

lvl_now = max(abs(spl0), abs(spl1));
lvl_now > meter_peak ? meter_peak = lvl_now : meter_peak *= meter_decay;
lvl_now >= 0.999 ? clip_latch = 1;

@gfx 800 344

scale = max(0.5, min(gfx_w / 800, gfx_h / 344));
ox = floor((gfx_w - 800*scale) * 0.5);
oy = 0;

MARGIN = 14*scale;
CW = 118*scale;
KR = 30*scale;
PANEL_H = 136*scale;

function automate(s, end_touch)
(
<? loop(i = 1; 8,
  printf("  s == %d ? slider_automate(slider%d, end_touch) :\n", i, i);
  i += 1;
); ?>  0;
);

function hit_circle(mx, my, cx, cy, rad) ( sqr(mx - cx) + sqr(my - cy) <= sqr(rad); );
function hit_rect(mx, my, x, y, w, h) ( mx >= x && mx <= x+w && my >= y && my <= y+h; );

function def_val(s)
(
  s == 1 ? 1 : s == 2 ? 24 : s == 4 ? 0.9 : 0.5;
);

function knob_name(s)
(
  s == 1 ? "Headroom" : s == 2 ? "Quant" : s == 3 ? "Rate" :
  s == 4 ? "Post Filter" : s == 5 ? "Non-Lin" : "Output";
);

function hint_text(s)
(
  s == 1 ? "Headroom: peak clipping threshold (0 dB clips only above full scale)" :
  s == 2 ? "Quant: bit depth (24 is clean; 8 or below for telephone quality)" :
  s == 3 ? "Rate: centre is full rate; left holds single samples (gritty), right holds averages (smoother)" :
  s == 4 ? "Post Filter: low-pass filter to muffle the distortion (turning it switches the filter on)" :
  s == 5 ? "Non-Lin: harmonic thickening (centre is clean; left adds even harmonics, right odd)" :
  s == 6 ? "Output: output level" :
  s == 7 ? "Mono sums the input like the original plugin; Stereo degrades each channel on its own" :
  "Switch the post filter on or off (off keeps the full frequency range)";
);

function upper(str)
local(i, c)
(
  i = 0;
  loop(strlen(str),
    c = str_getchar(str, i);
    (c >= 97 && c <= 122) ? str_setchar(str, i, c - 32);
    i += 1;
  );
  str;
);

function ptext(s)
local(p)
(
  p = slider(s);
  s == 1 ? sprintf(#ptxt, "%d dB", itrunc(-30 * (1 - p))) :
  s == 2 ? sprintf(#ptxt, "%d bits", p) :
  s == 3 ? sprintf(#ptxt, "%d Hz", itrunc(srate / rate_tn(p))) :
  s == 4 ? ( slider8 < 0.5 ? strcpy(#ptxt, "Off") : sprintf(#ptxt, "%d Hz", itrunc(pow(10, 2.30104 + 2 * p))); ) :
  s == 5 ? (
    p < 0.5 ? sprintf(#ptxt, "Even %d", itrunc(200 * abs(p - 0.5))) :
    p > 0.5 ? sprintf(#ptxt, "Odd %d", itrunc(200 * abs(p - 0.5))) :
    strcpy(#ptxt, "0");
  ) :
  sprintf(#ptxt, "%+d dB", itrunc(40 * p - 20));
  #ptxt;
);

function draw_knob(cx, cy, rad, pos, cr, cg, cb, valtext, name)
local(ang0, ang1, ang, i, tx, ty)
(
  ang0 = -2.35619;
  ang1 =  2.35619;

  gfx_set(0.05, 0.05, 0.06, 1);
  gfx_circle(cx, cy, rad + 2*scale, 1, 1);
  gfx_set(cr*0.55, cg*0.55, cb*0.55, 1);
  gfx_circle(cx, cy, rad, 1, 1);
  gfx_set(cr, cg, cb, 1);
  gfx_circle(cx, cy, rad*0.72, 1, 1);
  gfx_set(1, 1, 1, 0.18);
  gfx_circle(cx - rad*0.28, cy - rad*0.28, rad*0.42, 1, 1);

  i = 0;
  loop(9,
    ang = ang0 + (ang1 - ang0) * (i / 8);
    gfx_set(0.85, 0.85, 0.85, 0.7);
    gfx_line(cx + sin(ang)*rad*0.82, cy - cos(ang)*rad*0.82,
             cx + sin(ang)*rad*0.98, cy - cos(ang)*rad*0.98, 1);
    i += 1;
  );

  ang = ang0 + (ang1 - ang0) * pos;
  gfx_set(0.05, 0.05, 0.05, 1);
  gfx_line(cx, cy, cx + sin(ang)*rad*0.85, cy - cos(ang)*rad*0.85, 1);

  gfx_setfont(1, "Arial", 14*scale);
  gfx_set(0.85, 0.85, 0.85, 1);
  gfx_measurestr(valtext, tx, ty);
  gfx_x = cx - tx*0.5; gfx_y = cy - rad - 18*scale;
  gfx_drawstr(valtext);

  gfx_setfont(1, "Arial", 14*scale);
  gfx_set(0.8, 0.8, 0.82, 1);
  gfx_measurestr(name, tx, ty);
  gfx_x = cx - tx*0.5; gfx_y = cy + rad + 7*scale;
  gfx_drawstr(name);
);

function end_labels(cx, cy, rad, lo, hi)
local(tw, th)
(
  gfx_setfont(1, "Arial", 11*scale, 'b');
  gfx_set(0.58, 0.60, 0.64, 1);
  gfx_measurestr(lo, tw, th);
  gfx_x = cx - rad - 5*scale - tw; gfx_y = cy + rad*0.55;
  gfx_drawstr(lo);
  gfx_x = cx + rad + 5*scale; gfx_y = cy + rad*0.55;
  gfx_drawstr(hi);
);

function lcd_touch(s) ( lcd_sl = s; lcd_t = time_precise(); );

function row_begin(y, nk, ns)
(
  rx = ox + (800*scale - (nk*CW + ns*8*scale + (ns - 1)*10*scale)) * 0.5;
  ry = oy + y;
);

function sec(nk, title, cr, cg, cb)
local(w, tw, th)
(
  w = nk*CW + 8*scale;
  gfx_set(0.035, 0.035, 0.04, 1);
  gfx_rect(rx - scale, ry - scale, w + 2*scale, PANEL_H + 2*scale, 1);
  gfx_set(0.125, 0.125, 0.14, 1);
  gfx_rect(rx, ry, w, PANEL_H, 1);
  gfx_set(cr, cg, cb, 0.8);
  gfx_rect(rx, ry, w, max(1, 2*scale), 1);
  gfx_setfont(1, "Arial", 12*scale, 'b');
  gfx_set(cr*0.75 + 0.15, cg*0.75 + 0.15, cb*0.75 + 0.15, 1);
  gfx_measurestr(title, tw, th);
  gfx_x = rx + (w - tw)*0.5; gfx_y = ry + 5*scale;
  gfx_drawstr(title);
  k_sx = rx + 4*scale; k_col = 0;
  k_r = cr; k_g = cg; k_b = cb;
  rx += w + 10*scale;
);

function get_norm(s) ( s == 2 ? (slider2 - 4) / 20 : slider(s); );

function set_norm(s, v)
local(old)
(
  old = slider(s);
  s == 2 ? slider2 = 4 + floor(v*20 + 0.5) : slider(s) = floor(v*1000 + 0.5) / 1000;
  slider(s) !== old ? (
    automate(s, 0);
    (s == 4 && slider8 < 0.5) ? ( slider8 = 1; automate(8, 0); automate(8, 1); );
  );
);

function knob_at(s, cx, cy, rad, cr, cg, cb)
local(hov, v)
(
  hov = hit_circle(mouse_x, mouse_y, cx, cy, rad + 4*scale);
  hov ? hov_s = s;
  (mouse_just_down && hov) ? (
    (click_target == s && time_precise() - click_time < 0.3) ? (
      slider(s) = def_val(s);
      automate(s, 0); automate(s, 1);
      drag_target = 0;
      lcd_touch(s);
    ) : (
      drag_target = s; drag_y0 = mouse_y; drag_v0 = get_norm(s); drag_fine = mouse_cap & 4;
    );
    click_target = s; click_time = time_precise();
  );
  (hov && mouse_wheel != 0 && drag_target == 0) ? (
    v = s == 2 ? get_norm(s) + (mouse_wheel > 0 ? 0.05 : -0.05) :
        get_norm(s) + (mouse_wheel / 120) * ((mouse_cap & 4) ? 0.001 : 0.01);
    set_norm(s, max(0, min(1, v)));
    automate(s, 1);
    lcd_touch(s);
    mouse_wheel = 0;
  );
  draw_knob(cx, cy, rad, get_norm(s), cr, cg, cb, ptext(s), knob_name(s));
);

function seg_btn(s, x, y, w, h, label, act, fs)
local(tw, th, gap, hov)
(
  hov = hit_rect(mouse_x, mouse_y, x, y, w, h);
  hov ? hov_s = s;
  gap = max(1, scale);
  gfx_set(0.03, 0.03, 0.04, 1);
  gfx_rect(x - gap, y - gap, w + 2*gap, h + 2*gap, 1);
  act ? gfx_set(acc_r*0.62, acc_g*0.62, acc_b*0.62, 1) : gfx_set(hov ? 0.17 : 0.14, hov ? 0.17 : 0.14, hov ? 0.19 : 0.16, 1);
  gfx_rect(x, y, w, h, 1);
  act ? gfx_set(acc_r, acc_g, acc_b, 1) : gfx_set(0.21, 0.21, 0.24, 1);
  gfx_rect(x + gap, y + gap, w - 2*gap, h*0.5, 1);
  gfx_set(1, 1, 1, act ? 0.22 : 0.08);
  gfx_rect(x + gap, y + gap, w - 2*gap, h*0.3, 1);
  gfx_setfont(1, "Arial", fs*scale, 'b');
  act ? gfx_set(0.08, 0.08, 0.10, 1) : gfx_set(0.78, 0.78, 0.80, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + (w - tw)*0.5; gfx_y = y + (h - th)*0.5;
  gfx_drawstr(label);
  mouse_just_down && hov;
);

function knob(s)
local(cx, cy)
(
  cx = k_sx + CW*(k_col + 0.5);
  cy = ry + 74*scale;
  k_col += 1;
  knob_at(s, cx, cy, KR, k_r, k_g, k_b);
  s == 3 ? end_labels(cx, cy, KR, "Hold", "Avg");
  s == 5 ? end_labels(cx, cy, KR, "Even", "Odd");
);

function glow_text(str, x, y, r, g, b)
(
  gfx_set(r, g, b, 0.16);
  gfx_x = x - scale; gfx_y = y; gfx_drawstr(str);
  gfx_x = x + scale; gfx_y = y; gfx_drawstr(str);
  gfx_x = x; gfx_y = y - scale; gfx_drawstr(str);
  gfx_x = x; gfx_y = y + scale; gfx_drawstr(str);
  gfx_set(r, g, b, 1);
  gfx_x = x; gfx_y = y; gfx_drawstr(str);
);

mouse_down = mouse_cap & 1;
mouse_just_down = mouse_down && !mouse_state;
hov_s = 0;

acc_r = 0.45; acc_g = 0.80; acc_b = 0.50;

// ---------------------------------------------------------------------- background + header
gfx_set(0.09, 0.09, 0.10, 1);
gfx_rect(0, 0, gfx_w, gfx_h, 1);

gfx_setfont(1, "Arial", 20*scale, 'b');
gfx_set(acc_r, acc_g, acc_b, 1);
gfx_x = ox + MARGIN; gfx_y = oy + 8*scale;
gfx_drawstr("POTATO QUALITY");
gfx_setfont(1, "Arial", 13*scale);
gfx_set(0.55, 0.55, 0.58, 1);
gfx_x = ox + MARGIN + 2*scale; gfx_y = oy + 30*scale;
gfx_drawstr("by chmaha  ·  based on mda Degrade");

TABW = 84*scale; TABH = 26*scale; TABG = 5*scale;
tx0 = ox + 800*scale - MARGIN - 2*TABW - TABG;
seg_btn(7, tx0, oy + 11*scale, TABW, TABH, "MONO", slider7 < 0.5, 14) ? ( slider7 = 0; automate(7, 0); automate(7, 1); mouse_just_down = 0; );
seg_btn(7, tx0 + TABW + TABG, oy + 11*scale, TABW, TABH, "STEREO", slider7 >= 0.5, 14) ? ( slider7 = 1; automate(7, 0); automate(7, 1); mouse_just_down = 0; );

gfx_set(0.04, 0.04, 0.05, 1);
gfx_rect(0, oy + 46*scale, gfx_w, max(1, scale), 1);

// ---------------------------------------------------------------------- LCD
LX = ox + MARGIN; LY = oy + 56*scale; LW = 636*scale; LH = 90*scale;
gfx_set(0.03, 0.03, 0.04, 1);
gfx_rect(LX - 2*scale, LY - 2*scale, LW + 4*scale, LH + 4*scale, 1);
gfx_set(0.17, 0.17, 0.19, 1);
gfx_rect(LX, LY, LW, LH, 1);
gfx_set(1, 1, 1, 0.06);
gfx_rect(LX, LY, LW, max(1, scale), 1);

GX = LX + 6*scale; GY = LY + 6*scale; GW = LW - 12*scale; GH = LH - 12*scale;
gfx_set(0.02, 0.02, 0.02, 1);
gfx_rect(GX - scale, GY - scale, GW + 2*scale, GH + 2*scale, 1);
gfx_set(0.035 + acc_r*0.05, 0.035 + acc_g*0.05, 0.035 + acc_b*0.05, 1);
gfx_rect(GX, GY, GW, GH, 1);
lc_r = min(1, 0.35 + acc_r*0.75); lc_g = min(1, 0.35 + acc_g*0.75); lc_b = min(1, 0.35 + acc_b*0.75);

TAW = 250*scale;

gfx_setfont(2, "Courier New", 14*scale, 'b');
glow_text("DEGRADE", GX + 10*scale, GY + 6*scale, lc_r, lc_g, lc_b);
gfx_measurestr("DEGRADE", ltw, lth);
gfx_set(lc_r, lc_g, lc_b, meter_peak > 0.001 ? 1 : 0.18);
gfx_circle(GX + 20*scale + ltw, GY + 6*scale + lth*0.5, 3*scale, 1, 1);
sprintf(#lt, "%d HZ", itrunc(srate / rate_tn(slider3)));
gfx_measurestr(#lt, ltw, lth);
glow_text(#lt, GX + TAW - ltw, GY + 6*scale, lc_r, lc_g, lc_b);

sprintf(#ln, "%d-BIT", slider2);
gfx_setfont(2, "Courier New", 26*scale, 'b');
gfx_measurestr(#ln, ltw, lth);
glow_text(#ln, GX + 10*scale + (TAW - 10*scale - ltw)*0.5, GY + 24*scale + (26*scale - lth)*0.5, lc_r, lc_g, lc_b);

gfx_setfont(2, "Courier New", 14*scale, 'b');
LY3 = GY + GH - 20*scale;
(lcd_sl > 0 && time_precise() - lcd_t < 1.5) ? (
  strcpy(#lt, knob_name(lcd_sl));
  upper(#lt);
  glow_text(#lt, GX + 10*scale, LY3, lc_r, lc_g, lc_b);
  strcpy(#lv, ptext(lcd_sl));
  upper(#lv);
  gfx_measurestr(#lv, ltw, lth);
  glow_text(#lv, GX + TAW - ltw, LY3, lc_r, lc_g, lc_b);
) : (
  strcpy(#lt, rate_tn(slider3) <= 1 ? "FULL RATE" : slider3 > 0.5 ? "AVERAGE" : "HOLD");
  gfx_measurestr(#lt, ltw, lth);
  glow_text(#lt, GX + 10*scale + (TAW - 10*scale - ltw)*0.5, LY3, lc_r, lc_g, lc_b);
);

SDX = GX + TAW + 12*scale;
gfx_set(lc_r, lc_g, lc_b, 0.18);
gfx_rect(SDX, GY + 8*scale, max(1, scale), GH - 16*scale, 1);

SCX = SDX + 12*scale; SCW = GX + GW - 10*scale - SCX;
SCY = GY + 8*scale; SCH = GH - 16*scale;
SCM = SCY + SCH*0.5;
gfx_set(lc_r, lc_g, lc_b, 0.14);
gfx_rect(SCX, floor(SCM), SCW, max(1, scale), 1);

SC_SHOW = 400;
sc_end = sc_wp;
sc_start = sc_end - SC_SHOW;
sc_i = sc_start - 1;
sc_found = 0;
while (!sc_found && sc_i > sc_end - SC_N + 2) (
  sc_a = sc_buf[(sc_i - 1) & (SC_N - 1)];
  sc_b = sc_buf[sc_i & (SC_N - 1)];
  (sc_a < 0 && sc_b >= 0) ? ( sc_found = 1; sc_start = sc_i; ) : sc_i -= 1;
);
sc_pk = 0;
sc_k = 0;
loop(SC_SHOW, sc_pk = max(sc_pk, abs(sc_buf[(sc_start + sc_k) & (SC_N - 1)])); sc_k += 1; );
sc_pk > 0.0001 ? (
  sc_g = (SCH*0.45) / sc_pk;
  sc_pass = 0;
  loop(2,
    gfx_set(lc_r, lc_g, lc_b, sc_pass == 0 ? 0.2 : 0.95);
    sc_k = 0;
    loop(SC_SHOW,
      sc_px = SCX + SCW * sc_k / (SC_SHOW - 1);
      sc_py = SCM - sc_buf[(sc_start + sc_k) & (SC_N - 1)] * sc_g + (sc_pass == 0 ? scale : 0);
      sc_k == 0 ? ( gfx_x = sc_px; gfx_y = sc_py; ) : gfx_lineto(sc_px, sc_py, 1);
      sc_k += 1;
    );
    sc_pass += 1;
  );
);

gfx_set(0, 0, 0, 0.22);
sy = GY;
while (sy < GY + GH) ( gfx_rect(GX, sy, GW, max(1, scale), 1); sy += 3*scale; );
gfx_set(1, 1, 1, 0.035);
gfx_rect(GX, GY, GW, GH*0.45, 1);

// ---------------------------------------------------------------------- output + meter
knob_at(6, ox + 684*scale, oy + 104*scale, 22*scale, 0.85, 0.85, 0.85);

gfx_setfont(1, "Arial", 11*scale, 'b');
gfx_measurestr("CLIP", cltw, clth);
MX = ox + 736*scale; MW = 16*scale;
CLY = LY;
MY = CLY + clth + 3*scale;
MH = LY + LH - MY;
(mouse_just_down && hit_rect(mouse_x, mouse_y, MX - 4*scale, CLY, MW + 8*scale, MY + MH - CLY)) ? clip_latch = 0;
gfx_set(0.04, 0.04, 0.05, 1);
gfx_rect(MX - scale, MY - scale, MW + 2*scale, MH + 2*scale, 1);
function meter_y(db) ( MY + MH * (1 - max(0, min(1, (db + 60) / 60))) );
y9 = meter_y(-9); y1 = meter_y(-1);
gfx_set(0.10, 0.22, 0.14, 1); gfx_rect(MX, y9, MW, MY + MH - y9, 1);
gfx_set(0.28, 0.24, 0.08, 1); gfx_rect(MX, y1, MW, y9 - y1, 1);
gfx_set(0.30, 0.08, 0.08, 1); gfx_rect(MX, MY, MW, y1 - MY, 1);
mdb = meter_peak > 0.000001 ? 20 * log10(meter_peak) : -100;
fy = meter_y(mdb);
mdb > -1 ? gfx_set(1.0, 0.35, 0.30, 1) : mdb > -9 ? gfx_set(1.0, 0.80, 0.25, 1) : gfx_set(0.30, 0.85, 0.50, 1);
gfx_rect(MX, fy, MW, MY + MH - fy, 1);
gfx_setfont(1, "Arial", 11*scale, 'b');
clip_latch ? gfx_set(1, 0.25, 0.25, 1) : gfx_set(0.32, 0.18, 0.18, 1);
gfx_x = MX + MW*0.5 - cltw*0.5; gfx_y = CLY;
gfx_drawstr("CLIP");

gfx_set(0.04, 0.04, 0.05, 1);
gfx_rect(0, oy + 152*scale, gfx_w, max(1, scale), 1);

// ---------------------------------------------------------------------- knob panels
row_begin(164*scale, 5, 3);
sec(2, "CRUSH", 0.35, 0.60, 0.90); knob(2); knob(3);
sec(2, "SATURATE", 0.90, 0.55, 0.25); knob(5); knob(1);
sec(1, "FILTER", 0.65, 0.40, 0.80); knob(4);
PLW = 30*scale; PLH = 16*scale;
seg_btn(8, rx - 10*scale - PLW - 5*scale, ry + 4*scale, PLW, PLH, slider8 >= 0.5 ? "ON" : "OFF", slider8 >= 0.5, 10) ? (
  slider8 = slider8 >= 0.5 ? 0 : 1; automate(8, 0); automate(8, 1); mouse_just_down = 0;
);

// ---------------------------------------------------------------------- hint bar
gfx_set(0.04, 0.04, 0.05, 1);
gfx_rect(0, oy + 310*scale, gfx_w, max(1, scale), 1);
hs = drag_target > 0 ? drag_target : hov_s;
gfx_setfont(1, "Arial", 13*scale);
gfx_set(0.62, 0.63, 0.66, 1);
strcpy(#hint, hs > 0 ? hint_text(hs) : "Drag or scroll a knob to adjust  ·  Ctrl for fine control  ·  double-click to reset");
gfx_measurestr(#hint, htw, hth);
htw > 780*scale ? ( gfx_setfont(1, "Arial", 13*scale*780*scale/htw); gfx_measurestr(#hint, htw, hth); );
gfx_x = ox + (800*scale - htw)*0.5; gfx_y = oy + 310*scale + (34*scale - hth)*0.5;
gfx_drawstr(#hint);

// knob drag (Ctrl = fine)
drag_target > 0 ? (
  mouse_down ? (
    mouse_cap |= 65536;
    fine_now = mouse_cap & 4;
    fine_now != drag_fine ? ( drag_y0 = mouse_y; drag_v0 = get_norm(drag_target); drag_fine = fine_now; );
    v = max(0, min(1, drag_v0 + (drag_y0 - mouse_y) / (150*scale) * (fine_now ? 0.1 : 1)));
    set_norm(drag_target, v);
    lcd_touch(drag_target);
  ) : ( automate(drag_target, 1); drag_target = 0; );
);

mouse_wheel = 0;
mouse_state = mouse_down;
