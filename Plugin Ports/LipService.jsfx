Version: 1.0
desc: Lip Service TalkBox & Vocoder (mda port) by chmaha
tags: vocoder talkbox vocal robot
author: chmaha
changelog:
  Initial release.
about:
  Make a synth talk. TalkBox mode models your voice with LPC (like a talk box tube in your mouth),
  Vocoder mode is a classic 8 or 16 band channel vocoder with five presets.
  By default the voice is the track's own audio (channels 1+2) and the synth comes in on the sidechain
  (channels 3+4): send a synth track to this track's channels 3/4. You can also feed a stereo signal
  with the voice on one side and the synth on the other.
  Bright, buzzy synths (saws, squares, pads) work best as the carrier.
  Ported from mda TalkBox and mda Vocoder by Paul Kellett (Maxim Digital Audio), via mda-effects
  https://github.com/pluginguru/mda-effects (MIT or GPLv2+)
  JSFX version released under GPLv3+ license
  Claude generated some of this code

slider1:p_mode=0<0,1,1{TalkBox,Vocoder}>-Mode
slider2:p_route=2<0,2,1{Voice L / Synth R,Synth L / Voice R,Voice 1+2 / Synth 3+4}>-Input
slider3:p_wet=0.5<0,1,0.001>-TalkBox Wet
slider4:p_dry=0<0,1,0.001>-TalkBox Dry
slider5:p_qual=1<0,1,0.001>-TalkBox Quality
slider6:p_out=0.5<0,1,0.001>-Vocoder Output
slider7:p_thru=0.4<0,1,0.001>-Vocoder Hi Thru
slider8:p_hiband=0.4<0,1,0.001>-Vocoder Hi Band
slider9:p_env=0.16<0,1,0.001>-Vocoder Envelope
slider10:p_fq=0.55<0,1,0.001>-Vocoder Filter Q
slider11:p_mid=0.6667<0,1,0.0001>-Vocoder Mid Freq
slider12:p_bands=0<0,1,1{8,16}>-Vocoder Bands

in_pin:Left input
in_pin:Right input
in_pin:Sidechain left
in_pin:Sidechain right
out_pin:Left output
out_pin:Right output
options:no_meter

@init

ext_noinit = gfx_ext_retina = 1;
ext_nodenorm = 1;

function alloc(n) local(r) instance(mp) global() ( r = mp; mp += n; memset(r, 0, n); r; );
alloc.mp = 0;

TB_MAX = 1600;
TB_ORD = 50;
VC_ROW = 13;
tb_buf0 = alloc(TB_MAX);
tb_buf1 = alloc(TB_MAX);
tb_win = alloc(TB_MAX);
tb_car0 = alloc(TB_MAX);
tb_car1 = alloc(TB_MAX);
lp_z = alloc(TB_ORD);
lp_r = alloc(TB_ORD);
lp_k = alloc(TB_ORD);
lp_a = alloc(TB_ORD);
lp_at = alloc(TB_ORD);
fm_a = alloc(TB_ORD);
fm_db = alloc(256);
vc_f = alloc(16 * VC_ROW);
vc_base = alloc(16);
vc_bar = alloc(16);
pv = alloc(16);
i = 0;
loop(16, vc_bar[i] = -200; i += 1; );
vc_max = -200;

TINY = pow(10, -20);
DEN = pow(10, -10);
tb_N = 1;
c_mode = -1;

function itrunc(x) ( x < 0 ? ceil(x) : floor(x); );

function tb_reset()
(
  tb_pos = tb_K = 0;
  tb_e = tb_fx = 0;
  tb_d0 = tb_d1 = tb_d2 = tb_d3 = tb_d4 = 0;
  tb_u0 = tb_u1 = tb_u2 = tb_u3 = tb_u4 = 0;
  memset(tb_buf0, 0, TB_MAX);
  memset(tb_buf1, 0, TB_MAX);
  memset(tb_car0, 0, TB_MAX);
  memset(tb_car1, 0, TB_MAX);
  fm_g = 0;
);

function vc_reset()
local(i)
(
  i = 0;
  loop(16, memset(vc_f + i * VC_ROW + 3, 0, 9); i += 1; );
  vc_oo = 0;
  vc_k = 0;
);

function lpc_durbin(ord)
local(i, j, e, brk, ki)
(
  memset(lp_a, 0, ord + 1);
  memset(lp_at, 0, ord + 1);
  e = lp_r[0];
  i = 1;
  brk = 0;
  while (i <= ord && !brk) (
    ki = -lp_r[i];
    j = 1;
    loop(i - 1, lp_at[j] = lp_a[j]; ki -= lp_a[j] * lp_r[i - j]; j += 1; );
    abs(e) < TINY ? (
      e = 0;
      lp_k[i] = ki;
      brk = 1;
    ) : (
      ki /= e;
      lp_k[i] = ki;
      lp_a[i] = ki;
      j = 1;
      loop(i - 1, lp_a[j] = lp_at[j] + ki * lp_at[i - j]; j += 1; );
      e *= 1 - ki * ki;
      i += 1;
    );
  );
  e < TINY ? e = 0;
  sqrt(e);
);

function lpc(lbuf, lcar, ln, lord)
local(i, j, nn, acc, g, xv)
(
  nn = ln;
  j = 0;
  loop(lord + 1,
    lp_z[j] = 0;
    acc = 0;
    i = 0;
    loop(nn, acc += lbuf[i] * lbuf[i + j]; i += 1; );
    lp_r[j] = acc;
    j += 1;
    nn -= 1;
  );
  lp_r[0] *= 1.001;

  lp_r[0] < 0.00001 ? (
    memset(lbuf, 0, ln);
    fm_g = 0;
  ) : (
    g = lpc_durbin(lord);
    j = 0;
    loop(lord + 1, lp_k[j] = max(-0.995, min(0.995, lp_k[j])); j += 1; );
    memcpy(fm_a, lp_a, lord + 1);
    fm_o = lord;
    fm_g = g;
    i = 0;
    loop(ln,
      xv = g * lcar[i];
      j = lord;
      loop(lord,
        xv -= lp_k[j] * lp_z[j - 1];
        lp_z[j] = lp_z[j - 1] + lp_k[j] * xv;
        j -= 1;
      );
      lbuf[i] = lp_z[0] = xv;
      i += 1;
    );
  );
);

function tb_set()
local(fs, n, ph, dp, i)
(
  fs = max(8000, min(96000, srate));
  n = min(TB_MAX, floor(0.01633 * fs));
  tb_O = floor((0.0001 + 0.0004 * p_qual) * fs);
  n !== tb_N ? (
    tb_N = n;
    dp = 2 * $pi / n;
    ph = 0;
    i = 0;
    loop(n, tb_win[i] = 0.5 - 0.5 * cos(ph); ph += dp; i += 1; );
  );
  tb_wet = 0.5 * p_wet * p_wet;
  tb_dry = 2 * p_dry * p_dry;
);

function vc_set()
local(tp, rr, th, shf, i, p, env, fr)
(
  tp = 2 * $pi / srate;
  vc_gain = pow(10, 2 * p_out - 3 * p_fq - 2);
  vc_thru = pow(10, 0.5 + 2 * p_out);
  vc_high = p_hiband * p_hiband * p_hiband * vc_thru;
  vc_thru *= p_thru * p_thru * p_thru;

  p_bands < 0.5 ? (
    vc_nb = 8;
    vc_base[1] = 3000; vc_base[2] = 2200; vc_base[3] = 1500; vc_base[4] = 1080;
    vc_base[5] = 700; vc_base[6] = 390; vc_base[7] = 190;
  ) : (
    vc_nb = 16;
    vc_base[1] = 5000; vc_base[2] = 4000; vc_base[3] = 3250; vc_base[4] = 2750;
    vc_base[5] = 2300; vc_base[6] = 2000; vc_base[7] = 1750; vc_base[8] = 1500;
    vc_base[9] = 1250; vc_base[10] = 1000; vc_base[11] = 750; vc_base[12] = 540;
    vc_base[13] = 350; vc_base[14] = 195; vc_base[15] = 95;
  );

  p_env < 0.05 ? (
    i = 0;
    loop(vc_nb, vc_f[i * VC_ROW + 12] = 0; i += 1; );
  ) : (
    env = pow(10, -1.7 - 2.7 * p_env);
    rr = 0.022 / vc_nb;
    i = 1;
    loop(vc_nb - 1,
      p = vc_f + i * VC_ROW;
      p[12] = 0.025 - rr * i;
      env < p[12] ? p[12] = env;
      i += 1;
    );
    vc_f[12] = 0.5 * env;
  );

  rr = 1 - pow(10, -1 - 1.2 * p_fq);
  shf = pow(2, 3 * p_mid - 1);
  vc_sh = shf;
  i = 1;
  loop(vc_nb - 1,
    p = vc_f + i * VC_ROW;
    fr = vc_base[i] * shf;
    th = acos((2 * rr * cos(tp * fr)) / (1 + rr * rr));
    p[0] = 2 * rr * cos(th);
    p[1] = -rr * rr;
    fr *= 0.96;
    th = acos((2 * rr * cos(tp * fr)) / (1 + rr * rr));
    p[2] = 2 * rr * cos(th);
    i += 1;
  );
);

@slider

last_srate != srate ? (
  last_srate = srate;
  meter_decay = pow(0.001, 1 / (0.4 * srate));
  tb_set();
  vc_set();
);

@block

p_mode !== c_mode ? (
  c_mode = p_mode;
  tb_reset();
  vc_reset();
);

chg = 0;
i = 3;
loop(10,
  slider(i) !== pv[i] ? ( chg = 1; pv[i] = slider(i); );
  i += 1;
);
chg ? (
  tb_set();
  vc_set();
);

p_mode < 0.5 ? (
  abs(tb_d0) < DEN ? tb_d0 = 0;
  abs(tb_d1) < DEN ? tb_d1 = 0;
  abs(tb_d2) < DEN ? tb_d2 = 0;
  abs(tb_d3) < DEN ? tb_d3 = 0;
  abs(tb_u0) < DEN ? tb_u0 = 0;
  abs(tb_u1) < DEN ? tb_u1 = 0;
  abs(tb_u2) < DEN ? tb_u2 = 0;
  abs(tb_u3) < DEN ? tb_u3 = 0;
  tb_p1 = (tb_pos + floor(tb_N / 2)) % tb_N;
) : (
  abs(vc_f[11]) < DEN ? vc_f[11] = 0;
  vp = vc_f + VC_ROW;
  loop(vc_nb - 1,
    (abs(vp[3]) < DEN || abs(vp[7]) < DEN) ? memset(vp + 3, 0, p_env < 0.05 ? 8 : 9);
    vp += VC_ROW;
  );
);

@sample

p_route < 0.5 ? (
  v_in = spl0; c_in = spl1;
) : p_route < 1.5 ? (
  v_in = spl1; c_in = spl0;
) : (
  v_in = 0.5 * (spl0 + spl1); c_in = 0.5 * (spl2 + spl3);
);

p_mode < 0.5 ? (
  tb_x = c_in;
  tb_p = tb_d0 + 0.3 * tb_x; tb_d0 = tb_d1; tb_d1 = tb_x - 0.3 * tb_p;
  tb_q = tb_d2 + 0.77 * tb_d4; tb_d2 = tb_d3; tb_d3 = tb_d4 - 0.77 * tb_q;
  tb_d4 = tb_x;
  tb_x = tb_p + tb_q;

  tb_K ? (
    tb_K = 0;
    tb_car0[tb_pos] = tb_car1[tb_p1] = tb_x;
    tb_x = v_in - tb_e;
    tb_e = v_in;
    tb_w = tb_win[tb_pos];
    tb_fx = tb_buf0[tb_pos] * tb_w;
    tb_buf0[tb_pos] = tb_x * tb_w;
    tb_pos += 1;
    tb_pos >= tb_N ? ( lpc(tb_buf0, tb_car0, tb_N, tb_O); tb_pos = 0; );
    tb_w = 1 - tb_w;
    tb_fx += tb_buf1[tb_p1] * tb_w;
    tb_buf1[tb_p1] = tb_x * tb_w;
    tb_p1 += 1;
    tb_p1 >= tb_N ? ( lpc(tb_buf1, tb_car1, tb_N, tb_O); tb_p1 = 0; );
  ) : tb_K = 1;

  tb_p = tb_u0 + 0.3 * tb_fx; tb_u0 = tb_u1; tb_u1 = tb_fx - 0.3 * tb_p;
  tb_q = tb_u2 + 0.77 * tb_u4; tb_u2 = tb_u3; tb_u3 = tb_u4 - 0.77 * tb_q;
  tb_u4 = tb_fx;
  out = tb_wet * (tb_p + tb_q) + tb_dry * v_in;
) : (
  va = v_in;
  vb = c_in;
  vt = va - vc_f[7];
  vc_f[7] = va;
  va = vt;
  vc_f[11] -= vc_f[12] * (vc_f[11] - abs(vt));
  out = vc_f[11] * (vc_thru * va + vc_high * (vb - vc_f[3]));
  vc_f[3] = vb;

  vc_k = 1 - vc_k;
  vc_k ? (
    vc_oo = 0;
    vaa = va + vc_f[9] - vc_f[8] - vc_f[8];
    vc_f[9] = vc_f[8]; vc_f[8] = va;
    vbb = vb + vc_f[5] - vc_f[4] - vc_f[4];
    vc_f[5] = vc_f[4]; vc_f[4] = vb;
    vp = vc_f + VC_ROW;
    loop(vc_nb - 1,
      vt = vp[0] * vp[3] + vp[1] * vp[4] + vbb;
      vp[4] = vp[3]; vp[3] = vt;
      vt += vp[2] * vp[5] + vp[1] * vp[6];
      vp[6] = vp[5]; vp[5] = vt;
      vt = vp[0] * vp[7] + vp[1] * vp[8] + vaa;
      vp[8] = vp[7]; vp[7] = vt;
      vt += vp[2] * vp[9] + vp[1] * vp[10];
      vp[10] = vp[9]; vp[9] = vt;
      vp[11] -= vp[12] * (vp[11] - abs(vt));
      vc_oo += vp[5] * vp[11];
      vp += VC_ROW;
    );
  );
  out += vc_oo * vc_gain;
  (out >= -1 && out <= 1) ? 0 : out = out > 1 ? 1 : out < -1 ? -1 : 0;
);

spl0 = spl1 = out;

lvl = abs(v_in);
lvl > vpk ? vpk = lvl : vpk *= meter_decay;
lvl = abs(c_in);
lvl > cpk ? cpk = lvl : cpk *= meter_decay;
lvl = abs(out);
lvl > opk ? opk = lvl : opk *= meter_decay;

@gfx 860 376

DW = 860;
DH = 376;
scale = max(0.5, min(gfx_w / DW, gfx_h / DH));
ox = floor((gfx_w - DW*scale) * 0.5);
oy = 0;

MARGIN = 14*scale;
CW = 118*scale;
KR = 30*scale;
PANEL_H = 136*scale;

function automate(s, end_touch)
(
<?
  max_sliders > 12 ? printf("slider_automate(2^(s-1), end_touch);") :
    loop(i = 1; 12,
      printf("  s == %d ? slider_automate(slider%d, end_touch) :\n", i, i);
      i += 1;
    );
?> 0;
);

function set_slider(s, v) ( slider(s) = v; automate(s, 0); automate(s, 1); );

function hit_circle(mx, my, cx, cy, rad) ( sqr(mx - cx) + sqr(my - cy) <= sqr(rad); );
function hit_rect(mx, my, x, y, w, h) ( mx >= x && mx <= x+w && my >= y && my <= y+h; );

function def_val(s)
(
  s == 3 ? 0.5 : s == 4 ? 0 : s == 5 ? 1 : s == 6 ? 0.5 : s == 7 ? 0.4 : s == 8 ? 0.4 :
  s == 9 ? 0.16 : s == 10 ? 0.55 : 0.6667;
);

function knob_name(s)
(
  s == 3 ? "Wet" : s == 4 ? "Dry" : s == 5 ? "Quality" : s == 6 ? "Output" :
  s == 7 ? "Hi Thru" : s == 8 ? "Hi Band" : s == 9 ? "Envelope" : s == 10 ? "Filter Q" : "Mid Freq";
);

function preset_name(n)
(
  n == 1 ? "CLASSIC" : n == 2 ? "16 BAND" : n == 3 ? "OLD" : n == 4 ? "CHORAL" : "PAD";
);

function hint_text(s)
(
  s == 1 ? "TalkBox shapes the synth with the formants of your voice; Vocoder uses a filter bank for the classic robot voice" :
  s == 2 ? "Where the voice and synth come in. Sidechain: voice on this track, send the synth to channels 3/4" :
  s == 3 ? "Wet: level of the talking synth" :
  s == 4 ? "Dry: level of the unprocessed voice mixed back in" :
  s == 5 ? "Quality: detail of the voice model (LPC order); lower sounds rougher and more muffled" :
  s == 6 ? "Output: level of the vocoded signal" :
  s == 7 ? "Hi Thru: lets the voice's own highs (s, t, ch) through for clearer words" :
  s == 8 ? "Hi Band: adds the synth's highs, shaped by the voice's high end, for extra brightness" :
  s == 9 ? "Envelope: how fast the bands follow the voice; fully left freezes the current sound" :
  s == 10 ? "Filter Q: band sharpness; higher is more resonant and ringing" :
  s == 11 ? "Mid Freq: shifts the whole filter bank up or down to change the voice character" :
  s == 12 ? "Bands: 8 for a gritty vintage sound, 16 for clearer speech" :
  s == 21 ? "Classic: the default 8-band vocoder" :
  s == 22 ? "16 Band: clearer, more intelligible speech" :
  s == 23 ? "Old: darker vintage sound without the high band" :
  s == 24 ? "Choral: resonant, choir-like bands" :
  s == 25 ? "Pad: slow envelope for smooth, washy pads" :
  "Drag or scroll a knob to adjust  ·  Ctrl for fine control  ·  double-click to reset";
);

function apply_preset(n)
(
  set_slider(6, 0.5); set_slider(7, 0.4); set_slider(8, 0.4); set_slider(9, 0.16);
  set_slider(10, 0.55); set_slider(11, 0.6667); set_slider(12, 0);
  n == 2 ? set_slider(12, 1);
  n == 3 ? ( set_slider(7, 0); set_slider(8, 0); set_slider(11, 0.5); );
  n == 4 ? ( set_slider(8, 0); set_slider(10, 0.7); set_slider(11, 0.5); );
  n == 5 ? ( set_slider(9, 0.78); set_slider(11, 0.3); );
);

function preset_match(n)
local(ht, hb, en, fq, mf, bd)
(
  ht = 0.4; hb = 0.4; en = 0.16; fq = 0.55; mf = 0.6667; bd = 0;
  n == 2 ? bd = 1;
  n == 3 ? ( ht = 0; hb = 0; mf = 0.5; );
  n == 4 ? ( hb = 0; fq = 0.7; mf = 0.5; );
  n == 5 ? ( en = 0.78; mf = 0.3; );
  p_out === 0.5 && p_thru === ht && p_hiband === hb && p_env === en &&
  p_fq === fq && p_mid === mf && (p_bands >= 0.5) === bd;
);

function upper(str)
local(i, c)
(
  i = 0;
  loop(strlen(str),
    c = str_getchar(str, i);
    (c >= 97 && c <= 122) ? str_setchar(str, i, c - 32);
    i += 1;
  );
  str;
);

function env_ms(p) ( pow(10, 1 + 3 * p); );
function mid_hz(p) ( 800 * pow(2, 3 * p - 2); );

function ptext(s)
local(p, t)
(
  p = slider(s);
  (s == 3 || s == 4) ? sprintf(#ptxt, "%d%%", floor(200 * p + 0.5)) :
  s == 6 ? sprintf(#ptxt, "%+.1f dB", 40 * p - 20) :
  s == 9 ? (
    p < 0.05 ? strcpy(#ptxt, "Freeze") : (
      t = env_ms(p);
      t >= 1000 ? sprintf(#ptxt, "%.1f s", t / 1000) : sprintf(#ptxt, "%d ms", floor(t + 0.5));
    );
  ) :
  s == 11 ? sprintf(#ptxt, "%d Hz", floor(mid_hz(p) + 0.5)) :
  sprintf(#ptxt, "%d%%", floor(100 * p + 0.5));
  #ptxt;
);

function draw_knob(cx, cy, rad, pos, cr, cg, cb, valtext, name)
local(ang0, ang1, ang, i, tx, ty)
(
  ang0 = -2.35619;
  ang1 =  2.35619;

  gfx_set(0.05, 0.05, 0.06, 1);
  gfx_circle(cx, cy, rad + 2*scale, 1, 1);
  gfx_set(cr*0.55, cg*0.55, cb*0.55, 1);
  gfx_circle(cx, cy, rad, 1, 1);
  gfx_set(cr, cg, cb, 1);
  gfx_circle(cx, cy, rad*0.72, 1, 1);
  gfx_set(1, 1, 1, 0.18);
  gfx_circle(cx - rad*0.28, cy - rad*0.28, rad*0.42, 1, 1);

  i = 0;
  loop(9,
    ang = ang0 + (ang1 - ang0) * (i / 8);
    gfx_set(0.85, 0.85, 0.85, 0.7);
    gfx_line(cx + sin(ang)*rad*0.82, cy - cos(ang)*rad*0.82,
             cx + sin(ang)*rad*0.98, cy - cos(ang)*rad*0.98, 1);
    i += 1;
  );

  ang = ang0 + (ang1 - ang0) * pos;
  gfx_set(0.05, 0.05, 0.05, 1);
  gfx_line(cx, cy, cx + sin(ang)*rad*0.85, cy - cos(ang)*rad*0.85, 1);

  gfx_setfont(1, "Arial", 14*scale);
  gfx_set(0.85, 0.85, 0.85, 1);
  gfx_measurestr(valtext, tx, ty);
  gfx_x = cx - tx*0.5; gfx_y = cy - rad - 18*scale;
  gfx_drawstr(valtext);

  gfx_setfont(1, "Arial", 14*scale);
  gfx_set(0.8, 0.8, 0.82, 1);
  gfx_measurestr(name, tx, ty);
  gfx_x = cx - tx*0.5; gfx_y = cy + rad + 7*scale;
  gfx_drawstr(name);
);

function end_labels(cx, cy, rad, lo, hi)
local(tw, th)
(
  gfx_setfont(1, "Arial", 11*scale, 'b');
  gfx_set(0.58, 0.60, 0.64, 1);
  gfx_measurestr(lo, tw, th);
  gfx_x = cx - rad - 5*scale - tw; gfx_y = cy + rad*0.55;
  gfx_drawstr(lo);
  gfx_x = cx + rad + 5*scale; gfx_y = cy + rad*0.55;
  gfx_drawstr(hi);
);

function lcd_touch(s) ( lcd_sl = s; lcd_t = time_precise(); );

function row_begin(y, nk, ns)
(
  rx = ox + (DW*scale - (nk*CW + ns*8*scale + (ns - 1)*10*scale)) * 0.5;
  ry = oy + y;
);

function sec(nk, title, cr, cg, cb)
local(w, tw, th)
(
  w = nk*CW + 8*scale;
  gfx_set(0.035, 0.035, 0.04, 1);
  gfx_rect(rx - scale, ry - scale, w + 2*scale, PANEL_H + 2*scale, 1);
  gfx_set(0.125, 0.125, 0.14, 1);
  gfx_rect(rx, ry, w, PANEL_H, 1);
  gfx_set(cr, cg, cb, 0.8);
  gfx_rect(rx, ry, w, max(1, 2*scale), 1);
  gfx_setfont(1, "Arial", 12*scale, 'b');
  gfx_set(cr*0.75 + 0.15, cg*0.75 + 0.15, cb*0.75 + 0.15, 1);
  gfx_measurestr(title, tw, th);
  gfx_x = rx + (w - tw)*0.5; gfx_y = ry + 5*scale;
  gfx_drawstr(title);
  k_sx = rx + 4*scale; k_col = 0;
  k_r = cr; k_g = cg; k_b = cb;
  rx += w + 10*scale;
);

function set_norm(s, v)
local(old)
(
  old = slider(s);
  slider(s) = s == 11 ? floor(v*10000 + 0.5) / 10000 : floor(v*1000 + 0.5) / 1000;
  slider(s) !== old ? automate(s, 0);
);

function knob_at(s, cx, cy, rad, cr, cg, cb)
local(hov, v)
(
  hov = hit_circle(mouse_x, mouse_y, cx, cy, rad + 4*scale);
  hov ? hov_s = s;
  (mouse_just_down && hov) ? (
    (click_target == s && time_precise() - click_time < 0.3) ? (
      set_slider(s, def_val(s));
      drag_target = 0;
      lcd_touch(s);
    ) : (
      drag_target = s; drag_y0 = mouse_y; drag_v0 = slider(s); drag_fine = mouse_cap & 4;
    );
    click_target = s; click_time = time_precise();
  );
  (hov && mouse_wheel != 0 && drag_target == 0) ? (
    v = slider(s) + (mouse_wheel / 120) * ((mouse_cap & 4) ? 0.001 : 0.01);
    set_norm(s, max(0, min(1, v)));
    automate(s, 1);
    lcd_touch(s);
    mouse_wheel = 0;
  );
  draw_knob(cx, cy, rad, slider(s), cr, cg, cb, ptext(s), knob_name(s));
);

function seg_btn(s, x, y, w, h, label, act, fs)
local(tw, th, gap, hov)
(
  hov = hit_rect(mouse_x, mouse_y, x, y, w, h);
  hov ? hov_s = s;
  gap = max(1, scale);
  gfx_set(0.03, 0.03, 0.04, 1);
  gfx_rect(x - gap, y - gap, w + 2*gap, h + 2*gap, 1);
  act ? gfx_set(acc_r*0.62, acc_g*0.62, acc_b*0.62, 1) : gfx_set(hov ? 0.17 : 0.14, hov ? 0.17 : 0.14, hov ? 0.19 : 0.16, 1);
  gfx_rect(x, y, w, h, 1);
  act ? gfx_set(acc_r, acc_g, acc_b, 1) : gfx_set(0.21, 0.21, 0.24, 1);
  gfx_rect(x + gap, y + gap, w - 2*gap, h*0.5, 1);
  gfx_set(1, 1, 1, act ? 0.22 : 0.08);
  gfx_rect(x + gap, y + gap, w - 2*gap, h*0.3, 1);
  gfx_setfont(1, "Arial", fs*scale, 'b');
  act ? gfx_set(0.08, 0.08, 0.10, 1) : gfx_set(0.78, 0.78, 0.80, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + (w - tw)*0.5; gfx_y = y + (h - th)*0.5;
  gfx_drawstr(label);
  mouse_just_down && hov;
);

function knob(s)
local(cx, cy)
(
  cx = k_sx + CW*(k_col + 0.5);
  cy = ry + 74*scale;
  k_col += 1;
  knob_at(s, cx, cy, KR, k_r, k_g, k_b);
  s == 9 ? end_labels(cx, cy, KR, "Fast", "Slow");
);

function glow_text(str, x, y, r, g, b)
(
  gfx_set(r, g, b, 0.16);
  gfx_x = x - scale; gfx_y = y; gfx_drawstr(str);
  gfx_x = x + scale; gfx_y = y; gfx_drawstr(str);
  gfx_x = x; gfx_y = y - scale; gfx_drawstr(str);
  gfx_x = x; gfx_y = y + scale; gfx_drawstr(str);
  gfx_set(r, g, b, 1);
  gfx_x = x; gfx_y = y; gfx_drawstr(str);
);

function meter(x, y, w, h, pk, label)
local(db, fy, tw, th)
(
  gfx_setfont(1, "Arial", 11*scale, 'b');
  gfx_set(0.62, 0.63, 0.66, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + w*0.5 - tw*0.5; gfx_y = y;
  gfx_drawstr(label);
  y += th + 3*scale;
  h -= th + 3*scale;
  gfx_set(0.04, 0.04, 0.05, 1);
  gfx_rect(x - scale, y - scale, w + 2*scale, h + 2*scale, 1);
  gfx_set(acc_r*0.22, acc_g*0.22, acc_b*0.22, 1);
  gfx_rect(x, y, w, h, 1);
  db = pk > 0.000001 ? 20 * log10(pk) : -100;
  fy = y + h * (1 - max(0, min(1, (db + 60) / 60)));
  db > -1 ? gfx_set(1.0, 0.35, 0.30, 1) : gfx_set(acc_r, acc_g, acc_b, 1);
  gfx_rect(x, fy, w, y + h - fy, 1);
);

mouse_down = mouse_cap & 1;
mouse_just_down = mouse_down && !mouse_state;
hov_s = 0;
is_vc = p_mode >= 0.5;

is_vc ? ( acc_r = 0.40; acc_g = 0.76; acc_b = 0.92; ) : ( acc_r = 0.94; acc_g = 0.48; acc_b = 0.56; );

// ---------------------------------------------------------------------- background + header
gfx_set(0.09, 0.09, 0.10, 1);
gfx_rect(0, 0, gfx_w, gfx_h, 1);

gfx_setfont(1, "Arial", 20*scale, 'b');
gfx_set(acc_r, acc_g, acc_b, 1);
gfx_x = ox + MARGIN; gfx_y = oy + 8*scale;
gfx_drawstr("LIP SERVICE");
gfx_setfont(1, "Arial", 13*scale);
gfx_set(0.58, 0.60, 0.64, 1);
gfx_x = ox + MARGIN + 2*scale; gfx_y = oy + 30*scale;
gfx_drawstr("by chmaha  ·  based on mda TalkBox & Vocoder");

TABW = 96*scale; TABH = 26*scale; TABG = 5*scale;
tx0 = ox + DW*scale - MARGIN - 2*TABW - TABG;
seg_btn(1, tx0, oy + 11*scale, TABW, TABH, "TALKBOX", !is_vc, 14) ? ( set_slider(1, 0); mouse_just_down = 0; );
seg_btn(1, tx0 + TABW + TABG, oy + 11*scale, TABW, TABH, "VOCODER", is_vc, 14) ? ( set_slider(1, 1); mouse_just_down = 0; );
is_vc = p_mode >= 0.5;

gfx_set(0.04, 0.04, 0.05, 1);
gfx_rect(0, oy + 46*scale, gfx_w, max(1, scale), 1);

// ---------------------------------------------------------------------- LCD
LX = ox + MARGIN; LY = oy + 56*scale; LW = 692*scale; LH = 90*scale;
gfx_set(0.03, 0.03, 0.04, 1);
gfx_rect(LX - 2*scale, LY - 2*scale, LW + 4*scale, LH + 4*scale, 1);
gfx_set(0.17, 0.17, 0.19, 1);
gfx_rect(LX, LY, LW, LH, 1);
gfx_set(1, 1, 1, 0.06);
gfx_rect(LX, LY, LW, max(1, scale), 1);

GX = LX + 6*scale; GY = LY + 6*scale; GW = LW - 12*scale; GH = LH - 12*scale;
gfx_set(0.02, 0.02, 0.02, 1);
gfx_rect(GX - scale, GY - scale, GW + 2*scale, GH + 2*scale, 1);
gfx_set(0.035 + acc_r*0.05, 0.035 + acc_g*0.05, 0.035 + acc_b*0.05, 1);
gfx_rect(GX, GY, GW, GH, 1);
lc_r = min(1, 0.35 + acc_r*0.75); lc_g = min(1, 0.35 + acc_g*0.75); lc_b = min(1, 0.35 + acc_b*0.75);

TAW = 250*scale;
frozen = is_vc && p_env < 0.05;

gfx_setfont(2, "Courier New", 14*scale, 'b');
strcpy(#lt, is_vc ? "VOCODER" : "TALKBOX");
glow_text(#lt, GX + 10*scale, GY + 6*scale, lc_r, lc_g, lc_b);
gfx_measurestr(#lt, ltw, lth);
gfx_set(lc_r, lc_g, lc_b, opk > 0.001 ? 1 : 0.18);
gfx_circle(GX + 20*scale + ltw, GY + 6*scale + lth*0.5, 3*scale, 1, 1);
is_vc ? sprintf(#lt, "%d BANDS", p_bands >= 0.5 ? 16 : 8) : sprintf(#lt, "%d MS", floor(2000 * tb_N / srate + 0.5));
gfx_measurestr(#lt, ltw, lth);
glow_text(#lt, GX + TAW - ltw, GY + 6*scale, lc_r, lc_g, lc_b);

is_vc ? (
  frozen ? strcpy(#ln, "FROZEN") : sprintf(#ln, "%d HZ", floor(mid_hz(p_mid) + 0.5));
) : sprintf(#ln, "ORDER %d", tb_O);
gfx_setfont(2, "Courier New", 26*scale, 'b');
gfx_measurestr(#ln, ltw, lth);
glow_text(#ln, GX + 10*scale + (TAW - 10*scale - ltw)*0.5, GY + 24*scale + (26*scale - lth)*0.5, lc_r, lc_g, lc_b);

gfx_setfont(2, "Courier New", 14*scale, 'b');
LY3 = GY + GH - 20*scale;
(lcd_sl > 0 && time_precise() - lcd_t < 1.5) ? (
  strcpy(#lt, knob_name(lcd_sl));
  upper(#lt);
  glow_text(#lt, GX + 10*scale, LY3, lc_r, lc_g, lc_b);
  strcpy(#lv, ptext(lcd_sl));
  upper(#lv);
  gfx_measurestr(#lv, ltw, lth);
  glow_text(#lv, GX + TAW - ltw, LY3, lc_r, lc_g, lc_b);
) : (
  (vpk > 0.01 && cpk < 0.0005) ? (
    strcpy(#lt, "NO SYNTH SIGNAL");
    gfx_measurestr(#lt, ltw, lth);
    (time_precise() * 2) % 2 < 1 ? glow_text(#lt, GX + 10*scale + (TAW - 10*scale - ltw)*0.5, LY3, 1, 0.45, 0.4);
  ) : (
    strcpy(#lt, p_route < 0.5 ? "VOICE L · SYNTH R" : p_route < 1.5 ? "SYNTH L · VOICE R" : "SIDECHAIN 3/4");
    gfx_measurestr(#lt, ltw, lth);
    glow_text(#lt, GX + 10*scale + (TAW - 10*scale - ltw)*0.5, LY3, lc_r, lc_g, lc_b);
  );
);

SDX = GX + TAW + 12*scale;
gfx_set(lc_r, lc_g, lc_b, 0.18);
gfx_rect(SDX, GY + 8*scale, max(1, scale), GH - 16*scale, 1);

VX = SDX + 12*scale; VW = GX + GW - 10*scale - VX;
VY = GY + 8*scale; VH = GH - 16*scale;
gfx_setfont(1, "Arial", 11*scale);

is_vc ? (
  nbar = p_bands >= 0.5 ? 16 : 8;
  cur_max = -200;
  bi = 0;
  loop(nbar,
    be = bi < nbar - 1 ? vc_f[(nbar - 1 - bi) * VC_ROW + 11] : vc_f[11];
    bdb = 20 * log10(abs(be) + 0.000000001);
    cur_max = max(cur_max, bdb);
    vc_bar[bi] = max(bdb, vc_bar[bi] - 1.5);
    bi += 1;
  );
  vc_max = max(-90, max(cur_max, vc_max - 0.3));
  bgap = 3*scale;
  bw = (VW - (nbar - 1)*bgap) / nbar;
  BBOT = VY + VH - 12*scale;
  BH = BBOT - VY;
  bi = 0;
  loop(nbar,
    bx = VX + bi*(bw + bgap);
    gfx_set(lc_r, lc_g, lc_b, 0.08);
    gfx_rect(bx, VY, bw, BH, 1);
    bf = max(0, min(1, (vc_bar[bi] - (vc_max - 48)) / 48));
    bf > 0 ? (
      gfx_set(lc_r, lc_g, lc_b, bi == nbar - 1 ? 0.6 : 0.9);
      gfx_rect(bx, BBOT - BH*bf, bw, BH*bf, 1);
      gfx_set(1, 1, 1, 0.25);
      gfx_rect(bx, BBOT - BH*bf, bw, max(1, scale), 1);
    );
    bi += 1;
  );
  gfx_set(lc_r, lc_g, lc_b, 0.7);
  sprintf(#lt, "%d HZ", floor(vc_base[nbar - 1] * vc_sh * 0.5 + 0.5));
  gfx_x = VX; gfx_y = BBOT + 2*scale; gfx_drawstr(#lt);
  sprintf(#lt, "%d HZ", floor(vc_base[1] * vc_sh * 0.5 + 0.5));
  gfx_measurestr(#lt, ltw, lth);
  gfx_x = VX + (nbar - 2)*(bw + bgap) + bw - ltw; gfx_y = BBOT + 2*scale; gfx_drawstr(#lt);
  gfx_measurestr("HI", ltw, lth);
  gfx_x = VX + (nbar - 1)*(bw + bgap) + (bw - ltw)*0.5; gfx_y = BBOT + 2*scale; gfx_drawstr("HI");
  frozen ? (
    gfx_setfont(2, "Courier New", 12*scale, 'b');
    gfx_measurestr("FREEZE", ltw, lth);
    gfx_set(0.02, 0.02, 0.02, 0.7);
    gfx_rect(VX + VW - ltw - 10*scale, VY, ltw + 10*scale, lth + 4*scale, 1);
    glow_text("FREEZE", VX + VW - ltw - 5*scale, VY + 2*scale, lc_r, lc_g, lc_b);
  );
) : (
  FN = 128;
  f_lo = 80;
  f_hi = min(12000, srate / 4);
  BBOT = VY + VH - 12*scale;
  BH = BBOT - VY;
  gl = 100;
  loop(3,
    gl > f_lo && gl < f_hi ? (
      gxp = VX + VW * log(gl / f_lo) / log(f_hi / f_lo);
      gfx_set(lc_r, lc_g, lc_b, 0.14);
      gfx_rect(gxp, VY, max(1, scale), BH, 1);
      gfx_set(lc_r, lc_g, lc_b, 0.7);
      strcpy(#lt, gl == 100 ? "100" : gl == 1000 ? "1K" : "10K");
      gfx_measurestr(#lt, ltw, lth);
      gfx_x = gxp - ltw*0.5; gfx_y = BBOT + 2*scale; gfx_drawstr(#lt);
    );
    gl *= 10;
  );
  act = fm_g > 0 ? min(1, vpk * 30) : 0;
  fmax = -200;
  fi = 0;
  loop(FN,
    fw = 2 * $pi * f_lo * pow(f_hi / f_lo, fi / (FN - 1)) / (srate * 0.5);
    fre = 1; fim = 0;
    fj = 1;
    loop(fm_o, fre += fm_a[fj] * cos(fj * fw); fim -= fm_a[fj] * sin(fj * fw); fj += 1; );
    fdb = -10 * log10(fre*fre + fim*fim + 0.000000000001);
    fm_db[128 + fi] = fdb;
    fmax = max(fmax, fdb);
    fi += 1;
  );
  fi = 0;
  loop(FN,
    ft = act > 0 ? fm_db[128 + fi] - fmax : -48;
    fm_db[fi] = fm_db[fi] * 0.6 + ft * 0.4;
    fi += 1;
  );
  fade = max(0.25, act);
  fi = 0;
  loop(FN,
    fxp = VX + VW * fi / (FN - 1);
    fyp = BBOT - BH * max(0, min(1, (fm_db[fi] + 48) / 48));
    gfx_set(lc_r, lc_g, lc_b, 0.12 * fade);
    fi > 0 ? gfx_rect(fpx, fyp, fxp - fpx + 1, BBOT - fyp, 1);
    gfx_set(lc_r, lc_g, lc_b, 0.95 * fade);
    fi == 0 ? ( gfx_x = fxp; gfx_y = fyp; ) : gfx_lineto(fxp, fyp, 1);
    fpx = fxp;
    fi += 1;
  );
);

gfx_set(0, 0, 0, 0.22);
scan_y = GY;
while (scan_y < GY + GH) ( gfx_rect(GX, scan_y, GW, max(1, scale), 1); scan_y += 3*scale; );
gfx_set(1, 1, 1, 0.035);
gfx_rect(GX, GY, GW, GH*0.45, 1);

// ---------------------------------------------------------------------- input + output meters
MW = 16*scale;
MAX0 = LX + LW + 14*scale;
MSP = (ox + DW*scale - MARGIN - MAX0 - MW) / 2;
meter(MAX0, LY, MW, LH, vpk, "VOICE");
meter(MAX0 + MSP, LY, MW, LH, cpk, "SYNTH");
meter(MAX0 + 2*MSP, LY, MW, LH, opk, "OUT");

// ---------------------------------------------------------------------- input + preset strip
SY = oy + 158*scale; SH = 24*scale;
gfx_setfont(1, "Arial", 12*scale, 'b');
gfx_set(0.62, 0.63, 0.66, 1);
gfx_measurestr("INPUT", ltw, lth);
gfx_x = ox + MARGIN; gfx_y = SY + (SH - lth)*0.5;
gfx_drawstr("INPUT");
IBW = 118*scale; IBG = 4*scale;
ibx = ox + MARGIN + ltw + 10*scale;
seg_btn(2, ibx, SY, IBW, SH, "VOICE L · SYNTH R", p_route < 0.5, 11) ? ( set_slider(2, 0); mouse_just_down = 0; );
seg_btn(2, ibx + IBW + IBG, SY, IBW, SH, "SYNTH L · VOICE R", p_route >= 0.5 && p_route < 1.5, 11) ? ( set_slider(2, 1); mouse_just_down = 0; );
seg_btn(2, ibx + 2*(IBW + IBG), SY, IBW, SH, "SIDECHAIN 3/4", p_route >= 1.5, 11) ? ( set_slider(2, 2); mouse_just_down = 0; );

is_vc ? (
  PBW = 66*scale; PBG = 4*scale;
  pbx = ox + DW*scale - MARGIN - 5*PBW - 4*PBG;
  gfx_setfont(1, "Arial", 12*scale, 'b');
  gfx_set(0.62, 0.63, 0.66, 1);
  gfx_measurestr("PRESET", ltw, lth);
  gfx_x = pbx - ltw - 10*scale; gfx_y = SY + (SH - lth)*0.5;
  gfx_drawstr("PRESET");
  pn = 1;
  loop(5,
    seg_btn(20 + pn, pbx + (pn - 1)*(PBW + PBG), SY, PBW, SH, preset_name(pn), preset_match(pn), 11) ? (
      apply_preset(pn); mouse_just_down = 0;
    );
    pn += 1;
  );
) : (
  gfx_setfont(1, "Arial", 13*scale);
  gfx_set(0.62, 0.63, 0.66, 1);
  strcpy(#lt, "Tip: bright, buzzy synths (saws, squares) talk best");
  gfx_measurestr(#lt, ltw, lth);
  gfx_x = ox + DW*scale - MARGIN - ltw; gfx_y = SY + (SH - lth)*0.5;
  gfx_drawstr(#lt);
);

gfx_set(0.04, 0.04, 0.05, 1);
gfx_rect(0, oy + 192*scale, gfx_w, max(1, scale), 1);

// ---------------------------------------------------------------------- knob panels
is_vc ? (
  row_begin(200*scale, 6, 4);
  sec(2, "FILTER BANK", 0.40, 0.76, 0.92); knob(11); knob(10);
  PLW = 24*scale; PLH = 16*scale;
  plx = rx - 10*scale - 2*PLW - 2*scale - 5*scale;
  seg_btn(12, plx, ry + 4*scale, PLW, PLH, "8", p_bands < 0.5, 11) ? ( set_slider(12, 0); mouse_just_down = 0; );
  seg_btn(12, plx + PLW + 2*scale, ry + 4*scale, PLW, PLH, "16", p_bands >= 0.5, 11) ? ( set_slider(12, 1); mouse_just_down = 0; );
  sec(1, "ENVELOPE", 0.55, 0.85, 0.55); knob(9);
  sec(2, "HIGHS", 0.95, 0.75, 0.35); knob(8); knob(7);
  sec(1, "OUTPUT", 0.80, 0.80, 0.84); knob(6);
) : (
  row_begin(200*scale, 3, 2);
  sec(2, "MIX", 0.94, 0.48, 0.56); knob(3); knob(4);
  sec(1, "DETAIL", 0.70, 0.55, 0.92); knob(5);
);

// ---------------------------------------------------------------------- hint bar
gfx_set(0.04, 0.04, 0.05, 1);
gfx_rect(0, oy + 342*scale, gfx_w, max(1, scale), 1);
hs = drag_target > 0 ? drag_target : hov_s;
gfx_setfont(1, "Arial", 13*scale);
gfx_set(0.62, 0.63, 0.66, 1);
strcpy(#hint, hint_text(hs));
gfx_measurestr(#hint, htw, hth);
htw > (DW - 20)*scale ? ( gfx_setfont(1, "Arial", 13*scale*(DW - 20)*scale/htw); gfx_measurestr(#hint, htw, hth); );
gfx_x = ox + (DW*scale - htw)*0.5; gfx_y = oy + 342*scale + (34*scale - hth)*0.5;
gfx_drawstr(#hint);

drag_target > 0 ? (
  mouse_down ? (
    mouse_cap |= 65536;
    fine_now = mouse_cap & 4;
    fine_now != drag_fine ? ( drag_y0 = mouse_y; drag_v0 = slider(drag_target); drag_fine = fine_now; );
    v = max(0, min(1, drag_v0 + (drag_y0 - mouse_y) / (150*scale) * (fine_now ? 0.1 : 1)));
    set_norm(drag_target, v);
    lcd_touch(drag_target);
  ) : ( automate(drag_target, 1); drag_target = 0; );
);

mouse_wheel = 0;
mouse_state = mouse_down;
