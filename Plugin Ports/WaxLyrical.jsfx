  GDEF[8] = 13500; GDEF[21] = -12000; GDEF[23] = -12000; GDEF[25] = -12000; GDEF[26] = -12000; GDEF[27] = -12000;
  GDEF[28] = -12000; GDEF[30] = -12000; GDEF[33] = -12000; GDEF[34] = -12000; GDEF[35] = -12000; GDEF[36] = -12000;
  GDEF[38] = -12000; GDEF[46] = -1; GDEF[47] = -1; GDEF[56] = 100; GDEF[58] = -1;
  memset(GNRPN, 0, 63);
  GNRPN[0] = 1; GNRPN[1] = 1; GNRPN[2] = 1; GNRPN[3] = 1; GNRPN[4] = 1; GNRPN[5] = 2; GNRPN[6] = 2; GNRPN[7] = 2;
  GNRPN[8] = 2; GNRPN[9] = 1; GNRPN[10] = 2; GNRPN[11] = 2; GNRPN[12] = 1; GNRPN[13] = 1; GNRPN[15] = 1; GNRPN[16] = 1;
  GNRPN[17] = 1; GNRPN[21] = 2; GNRPN[22] = 4; GNRPN[23] = 2; GNRPN[24] = 4; GNRPN[25] = 2; GNRPN[26] = 2; GNRPN[27] = 2;
  GNRPN[28] = 2; GNRPN[29] = 1; GNRPN[30] = 2; GNRPN[31] = 1; GNRPN[32] = 1; GNRPN[33] = 2; GNRPN[34] = 2; GNRPN[35] = 2;
  GNRPN[36] = 2; GNRPN[37] = 1; GNRPN[38] = 2; GNRPN[39] = 1; GNRPN[40] = 1; GNRPN[45] = 1; GNRPN[47] = 1; GNRPN[48] = 1;
  GNRPN[50] = 1; GNRPN[51] = 1; GNRPN[52] = 1; GNRPN[56] = 1; GNRPN[61] = 2; GNRPN[62] = 1;
  i = 0; loop(128, TUNE[i] = i * 100; TUNEM[i] = i * 100; i += 1; );
  mem_set_values(GINIT, 0, 1, 2, 3, 5, 6, 7, 8, 9, 10, 11, 13, 15, 16, 17, 21, 22, 23, 24, 25, 26, 27, 28, 30,
                 33, 34, 35, 36, 38, 46, 47, 48, 58, 59, 60, 61, 62);
);
SINC_SP = 30003; SINC_EP = 30020; SINC_S = 30040; GDEF = 30200; GNRPN = 30300; GINIT = 30400; BMLOFS = 710000; BMLN = 712000; TUNE = 5300; TUNEM = 5450;

function bank_parse() local(p, i, n, k, ns, nml, np, nrec, g, gp, e, rc, ofs)
(
  p = BTXT;
  ns = p[1]; nsmpl = p[2]; nml = p[3]; np = p[4]; nrec = p[5];
  p += 8;
  i = 0;
  loop(ns,
    k = BSAMP + 8 * i;
    k[0] = p[0]; k[1] = p[1]; k[2] = p[2]; k[3] = p[3]; k[4] = p[4]; k[5] = p[5]; k[6] = p[6];
    k[7] = p[8] ? noise_floor / (p[7] / 8388608) : 0;
    p += 9; i += 1;
  );
  ofs = 0; i = 0;
  loop(nml,
    n = p[0]; p += 1;
    BMLOFS[i] = ofs; BMLN[i] = n;
    memcpy(BML + ofs, p, 7 * n);
    ofs += 7 * n; p += 7 * n; i += 1;
  );
  npresets = np; i = 0; rc = 0;
  loop(np,
    BPRE[5 * i] = p[0]; BPRE[5 * i + 1] = p[1]; BPRE[5 * i + 2] = rc; BPRE[5 * i + 3] = p[2];
    BPRE[5 * i + 4] = p + 3;
    rc += p[2];
    p += 4 + p[3]; i += 1;
  );
  gp = 0; i = 0;
  loop(nrec,
    k = BREC + 12 * i;
    memcpy(k, p, 11);
    k[11] = gp;
    n = p[10]; p += 11;
    loop(n,
      g = p[0]; e = p[2];
      BGEN[gp] = g; BGEN[gp + 1] = p[1] / P2[e];
      gp += 2; p += 3;
    );
    i += 1;
  );
);

function render_block() local(a, r, rp, s, f, av, j, k)
(
  memset(MIXL, 0, 64); memset(MIXR, 0, 64);
  memset(MIXREV, 0, 64); memset(MIXCHO, 0, 64);
  synth_ticks += 64;
  nfin0 = nfin;
  a = 0;
  loop(nact,
    r = ACT[a]; rp = RV + RS * r;
    s = rv_write(rp);
    s > 0 ? rv_mix(rp, s);
    s >= 0 && s < 64 ? ( FIN[nfin] = r; nfin += 1; );
    a += 1;
  );
  k = nfin0;
  loop(nfin - nfin0,
    f = FIN[k]; av = nact; j = 0;
    while (j < av) (
      ACT[j] === f ? ( av -= 1; j < av ? ACT[j] = ACT[av]; );
      j += 1;
    );
    nact = av;
    k += 1;
  );
);

function wl_open(ext) local(h)
(
  strcpy(#bank_fn, "WaxLyrical/WaxLyrical"); strcat(#bank_fn, ext);
  h = file_open(#bank_fn);
  h < 0 ? (
    strcpy(#bank_fn, "Dependencies/WaxLyrical/WaxLyrical"); strcat(#bank_fn, ext);
    h = file_open(#bank_fn);
  );
  h;
);

function wl_load() local(h, n, nch, sr, ok)
(
  ok = 0;
  h = wl_open(".txt");
  h >= 0 ? (
    n = file_mem(h, BTXT, TXTMAX);
    file_close(h);
    n > 8 && BTXT[0] === 1 ? (
      h = wl_open(".flac");
      h >= 0 ? (
        nch = 0; sr = 0;
        file_riff(h, nch, sr);
        nch === 1 && file_avail(h) >= BTXT[2] ? ( file_mem(h, SMPL, BTXT[2]) === BTXT[2] ? ok = 1; );
        file_close(h);
      );
    );
  );
  ok ? (
    memset(SMPL + BTXT[2], 0, 8);
    bank_parse();
  ) : npresets = 0;
  ok;
);

function wl_reset() local(j)
(
  synth_reset_all();
  j = 0;
  loop(7,
    program_change(j, j);
    CHB[CHS * j + C_PWS] = 12;
    WL_LAST[j] = 0;
    WL_BEND[j] = -1;
    j += 1;
  );
);

function bq_hp(fc, q, esr) local(omega, sn, cs, alpha, inv) instance(a0, a1, a2, b1, b2)
(
  omega = ((2 * $pi) * fc) / esr;
  sn = sin(omega); cs = cos(omega);
  alpha = sn / (2 * q);
  inv = 1 / (1 + alpha);
  a0 = (inv * (1 + cs)) / 2;
  a1 = -2 * a0;
  a2 = a0;
  b1 = (-2 * cs) * inv;
  b2 = (1 - alpha) * inv;
);

function bq_lp(fc, q, sr) local(omega, sn, cs, alpha, inv) instance(a0, a1, a2, b1, b2)
(
  omega = ((2 * $pi) * fc) / sr;
  sn = sin(omega); cs = cos(omega);
  alpha = sn / (2 * q);
  inv = 1 / (1 + alpha);
  a0 = (inv * (1 - cs)) * 0.5;
  a2 = a0;
  a1 = a0 + a0;
  b1 = (-2 * cs) * inv;
  b2 = (1 - alpha) * inv;
);

function bq_peak(freq, q, peak, sr) local(aa, w0, alpha, ib0) instance(a0, a1, a2, b1, b2)
(
  aa = sqrt(peak);
  w0 = ((freq * 2) * $pi) * (1 / sr);
  alpha = sin(w0) / (2 * q);
  ib0 = 1 / (1 + alpha / aa);
  a1 = (-2 * cos(w0)) * ib0;
  b1 = a1;
  a0 = ib0 * (1 + alpha * aa);
  a2 = ib0 * (1 - alpha * aa);
  b2 = ib0 * (1 - alpha / aa);
);

function bq_run(x) local(n, t, o) instance(a0, a1, a2, b1, b2, w1, w2)
(
  n = abs(x) < WL_SMALL ? 0 : x;
  abs(w1) < WL_SMALL ? w1 = 0;
  abs(w2) < WL_SMALL ? w2 = 0;
  t = (n - w1 * b1) - w2 * b2;
  o = (t * a0 + w1 * a1) + w2 * a2;
  w2 = w1;
  w1 = t;
  o;
);

function bq_san() instance(w1, w2)
(
  abs(w1) < WL_SMALL ? w1 = 0;
  abs(w2) < WL_SMALL ? w2 = 0;
);

function bq_clear() instance(w1, w2) ( w1 = w2 = 0; );

function wl_filters(ag, fr) local(lp, hp, q)
(
  lp = f32((fr + 500) * pow(f32(20000 / (fr + 500)), f32(1 - ag)));
  hp = f32(10 * pow(f32((fr - 250) / 10), ag));
  q = f32(0.707 + ag * 0.5);
  la.bq_hp(hp, q, srate);
  lb.bq_hp(hp, q, srate);
  lc.bq_peak(fr, 1, f32(1 + ag * 4), srate);
  ld.bq_lp(lp, q, srate);
  le.bq_hp(hp, q, srate);
  ra.bq_hp(hp, q, srate);
  rb.bq_hp(hp, q, srate);
  rc.bq_peak(fr, 1, f32(1 + ag * 4), srate);
  rd.bq_lp(lp, q, srate);
  re.bq_hp(hp, q, srate);
  wl_areduce = f32(1 - ag * 0.9);
);

function wl_f32(x) local(a, e, q, m, r, f)
(
  x === 0 ? 0 : (
    a = abs(x);
    e = floor(log(a) * 1.4426950408889634);
    a < WL_P2[e] ? e -= 1;
    a >= WL_P2[e + 1] ? e += 1;
    e < -126 ? e = -126;
    q = WL_P2[e - 23];
    m = a / q; r = floor(m); f = m - r;
    (f > 0.5 || (f === 0.5 && (r - 2 * floor(r / 2)) === 1)) ? r += 1;
    x < 0 ? -(r * q) : r * q;
  );
);

function wl_rate() local(n)
(
  n = floor((srate + 49) / 50);
  WL_DSZ = 1;
  while (WL_DSZ < n) ( WL_DSZ *= 2; );
  memset(DBUF, 0, 2 * WL_DSZ);
  wl_dpos = 0;
  wl_drange = f32(srate / 100);
  wl_dr_k = 1 - exp(-1 / (0.04 * srate));
  wl_g_k = 1 - exp(-1 / (0.02 * srate));
  wl_f_k = 1 - exp(-16 / (0.04 * srate));
  wl_phase = 0;
  la.bq_clear(); lb.bq_clear(); lc.bq_clear(); ld.bq_clear(); le.bq_clear();
  ra.bq_clear(); rb.bq_clear(); rc.bq_clear(); rd.bq_clear(); re.bq_clear();
  wl_ag_s = wl_ag_t; wl_fq_s = wl_fq_t;
  wl_filters(wl_ag_s, wl_fq_s);
);

function wl_controls() local(j, g, b, p)
(
  wl_in_t = f32(10 ^ (p_in / 20));
  wl_out_t = f32(10 ^ (p_out / 20));
  wl_ag_t = f32(p_aging * 0.01);
  wl_fq_t = p_freq;
  wl_drone = f32(p_drone * 0.01);
  wl_lfo_f = f32(1 / f32(60 / p_speed));
  j = 0;
  loop(7,
    p = f32(slider(9 + 3 * j) / 12);
    b = floor(f32(f32(p * 8191) + 8192));
    b !== WL_BEND[j] ? ( WL_BEND[j] = b; midi_bend(j, b); );
    g = slider(7 + 3 * j) >= 0.5 ? f32(10 ^ (slider(8 + 3 * j) / 20)) : 0;
    !wl_bp_full && g !== WL_LAST[j] ? (
      WL_LAST[j] === 0 && g !== 0 ? noteon(j, 60, 127);
      WL_LAST[j] !== 0 && g === 0 ? noteoff(j, 60);
      g > 0 ? set_gen(j, 48, 200 * log10(1 / g));
      WL_LAST[j] = g;
    );
    j += 1;
  );
);

WL_LAST = 7700000; WL_BEND = 7700010; DBUF = 7710000; WL_P2 = 7705000;
wl_i = -160; loop(300, WL_P2[wl_i] = 2 ^ wl_i; wl_i += 1; );
WL_SMALL = 1 / 16777216;

build_tables(); gen_tables();
synth_setup(srate);
set_polyphony(32);
wl_ok = wl_load();
wl_reset();
wl_rate();
bpos = 64;
wl_bp = p_bypass >= 0.5;
wl_bp_full = wl_bp;
wl_controls();
wl_dr_s = wl_drone;
wl_lin_in = wl_in_t; wl_lin_out = wl_out_t;
wl_ag_s = wl_ag_t; wl_fq_s = wl_fq_t;
wl_filters(wl_ag_s, wl_fq_s);

@slider
last_srate != srate ? (
  last_srate = srate;
  all_sounds_off(-1);
  synth_rate(srate);
  wl_reset();
  wl_rate();
  bpos = 64;
);
wl_controls();

@block
wl_bp_full = wl_bp >= 1 && p_bypass >= 0.5;
wl_controls();

@sample
s_d0 = spl0;
s_d1 = spl1;
wl_bp += p_bypass >= 0.5 ? 1 / 1024 : -1 / 1024;
wl_bp = max(0, min(1, wl_bp));
wl_bp < 1 || p_bypass < 0.5 ? (
  bpos >= 64 ? (
    render_block();
    check_finished();
    bpos = 0;
  );
  wl_lin_in !== wl_in_t ? (
    wl_lin_in += (wl_in_t - wl_lin_in) * wl_g_k;
    abs(wl_in_t - wl_lin_in) < 0.000001 * wl_in_t ? wl_lin_in = wl_in_t;
  );
  wl_lin_out !== wl_out_t ? (
    wl_lin_out += (wl_out_t - wl_lin_out) * wl_g_k;
    abs(wl_out_t - wl_lin_out) < 0.000001 * wl_out_t ? wl_lin_out = wl_out_t;
  );
  wl_fcnt += 1;
  wl_fcnt >= 16 ? (
    wl_fcnt = 0;
    wl_ag_s !== wl_ag_t || wl_fq_s !== wl_fq_t ? (
      wl_ag_s += (wl_ag_t - wl_ag_s) * wl_f_k;
      wl_fq_s += (wl_fq_t - wl_fq_s) * wl_f_k;
      abs(wl_ag_t - wl_ag_s) < 0.0002 ? wl_ag_s = wl_ag_t;
      abs(wl_fq_t - wl_fq_s) < 0.05 ? wl_fq_s = wl_fq_t;
      wl_filters(wl_ag_s, wl_fq_s);
    );
  );
  s_l = spl0 * wl_lin_in;
  s_r = spl1 * wl_lin_in;
  DBUF[2 * wl_dpos] = s_l;
  DBUF[2 * wl_dpos + 1] = s_r;
  wl_dr_s !== wl_drone ? (
    wl_dr_s += (wl_drone - wl_dr_s) * wl_dr_k;
    abs(wl_drone - wl_dr_s) < 0.00002 ? wl_dr_s = wl_drone;
  );
  wl_dr_s > 0 ? (
    s_v = wl_f32(sin((wl_f32(wl_phase * 360) * $pi) / 180)) * 0.5;
    s_b = floor(((s_v + 0.5) * wl_dr_s) * wl_drange);
    s_b = (wl_dpos - s_b + WL_DSZ) & (WL_DSZ - 1);
    s_l = DBUF[2 * s_b];
    s_r = DBUF[2 * s_b + 1];
    wl_phase = wl_f32(abs(wl_phase + wl_lfo_f * (1 / srate)));
    wl_phase >= 1 ? wl_phase -= floor(wl_phase);
  );
  wl_dpos = (wl_dpos + 1) & (WL_DSZ - 1);
  s_l += MIXL[bpos];
  s_r += MIXR[bpos];
  s_fl = le.bq_run(ld.bq_run(lc.bq_run(lb.bq_run(la.bq_run(s_l)))));
  s_fr = re.bq_run(rd.bq_run(rc.bq_run(rb.bq_run(ra.bq_run(s_r)))));
  wl_ag_s > 0 ? ( s_l = s_fl; s_r = s_fr; );
  s_g = f32(wl_lin_out * wl_areduce);
  spl0 = s_l * s_g;
  spl1 = s_r * s_g;
  (
    la.bq_san(); lb.bq_san(); lc.bq_san(); ld.bq_san(); le.bq_san();
    ra.bq_san(); rb.bq_san(); rc.bq_san(); rd.bq_san(); re.bq_san();
  );
  bpos += 1;
  wl_bp > 0 ? (
    spl0 += (s_d0 - spl0) * wl_bp;
    spl1 += (s_d1 - spl1) * wl_bp;
  );
);

@gfx 900 530

DW = 900;
DH = 530;
scale = max(0.5, min(gfx_w / DW, gfx_h / DH));
ox = floor((gfx_w - DW * scale) * 0.5);
oy = 0;

function px(x) ( ox + x * scale; );
function py(y) ( oy + y * scale; );
function font(sz, fl) ( gfx_setfont(1, "Arial", (sz + 2) * scale, fl); );

function automate(s, e)
(
<?
  max_sliders > 16 ? printf("slider_automate(2^(s-1), e);") :
    loop(i = 1; 28,
      printf("  s == %d ? slider_automate(slider%d, e) :\n", i, i);
      i += 1;
    );
?> 0;
);

function set_slider(s, sval) ( slider(s) = sval; automate(s, 0); automate(s, 1); );

function hit_circle(mx_, my_, cx, cy, rad) ( sqr(mx_ - cx) + sqr(my_ - cy) <= sqr(rad); );
function hit_rect(mx_, my_, x, y, w, h) ( mx_ >= x && mx_ <= x + w && my_ >= y && my_ <= y + h; );

function s_kind(s) ( s <= 6 ? s : 7 + (s - 7) % 3; );
function s_min(s) local(k) ( k = s_kind(s); k <= 2 ? -36 : k == 4 ? 33 : k == 6 ? 600 : k == 8 ? -96 : k == 9 ? -12 : 0; );
function s_max(s) local(k) ( k = s_kind(s); k <= 2 ? 36 : k == 4 ? 78 : k == 6 ? 1800 : k == 8 ? 0 : k == 9 ? 12 : 100; );
function s_def(s) local(k, j) (
  k = s_kind(s); j = floor((s - 7) / 3);
  k == 4 ? 33 : k == 6 ? 1000 :
  k == 8 ? ( j == 2 ? -36.1236 : j == 4 ? -30.103 : j >= 5 ? -24.0824 : -42.1442 ) : 0;
);
function s_bip(s) local(k) ( k = s_kind(s); k <= 2 || k == 9; );
function to_pos(s) local(lo, hi) (
  lo = s_min(s); hi = s_max(s);
  s_kind(s) == 6 ? log(slider(s) / lo) / log(hi / lo) : (slider(s) - lo) / (hi - lo);
);
function set_pos(s, p) local(lo, hi, k, qpos) (
  lo = s_min(s); hi = s_max(s); k = s_kind(s);
  p = max(0, min(1, p));
  qpos = k == 6 ? lo * (hi / lo) ^ p : lo + (hi - lo) * p;
  qpos = k == 4 || k == 6 ? floor(qpos + 0.5) : k == 8 ? floor(qpos * 10 + 0.5) / 10 : k == 9 ? floor(qpos * 100 + 0.5) / 100 : floor(qpos * 10 + 0.5) / 10;
  slider(s) = max(lo, min(hi, qpos));
  automate(s, 0);
);
function s_text(s) local(k, sv) (
  k = s_kind(s); sv = slider(s);
  k <= 2 ? sprintf(#vt, "%+.1f dB", sv) :
  k == 3 || k == 5 ? sprintf(#vt, "%.0f %%", sv) :
  k == 4 ? sprintf(#vt, "%d rpm", sv) :
  k == 6 ? sprintf(#vt, "%d Hz", sv) :
  k == 8 ? ( sv <= -95.95 ? strcpy(#vt, "-inf dB") : sprintf(#vt, "%.1f dB", sv) ) :
  ( abs(sv) < 0.005 ? strcpy(#vt, "0 st") : sprintf(#vt, "%+.2f st", sv) );
  #vt;
);

function arc_band(cx, cy, r0, r1, a0, a1) local(r) (
  r = r0;
  while (r <= r1) ( gfx_arc(cx, cy, r, a0, a1, 1); r += 0.6; );
);

function draw_knob(s, cx, cy, rad, name) local(p, a0, a1, a, tr, hov, kv, tw, th) (
  hov = hit_circle(mouse_x, mouse_y, cx, cy, rad + 8 * scale);
  hov ? g_hov = s;
  mouse_just_down && hov ? (
    (click_target == s && time_precise() - click_time < 0.3) ? (
      set_slider(s, s_def(s)); drag_target = 0;
    ) : (
      drag_target = s; drag_y0 = mouse_y; drag_p0 = to_pos(s);
    );
    click_target = s; click_time = time_precise(); mouse_just_down = 0;
  );
  hov && wheel != 0 && drag_target == 0 ? (
    set_pos(s, to_pos(s) + wheel / 120 * ((mouse_cap & 4) ? 0.002 : 0.02));
    automate(s, 1); wheel = 0;
  );
  p = max(0, min(1, to_pos(s)));
  a0 = -2.35619; a1 = 2.35619;
  a = a0 + (a1 - a0) * p;
  tr = rad + 5 * scale;
  gfx_set(0.30, 0.27, 0.25, 1);
  arc_band(cx, cy, tr, tr + 3.5 * scale, a0, a1);
  gfx_set(0.918, 0.663, 0.173, 1);
  s_bip(s) ? ( a < 0 ? arc_band(cx, cy, tr, tr + 3.5 * scale, a, 0) : a > 0 ? arc_band(cx, cy, tr, tr + 3.5 * scale, 0, a); )
           : ( p > 0.002 ? arc_band(cx, cy, tr, tr + 3.5 * scale, a0, a); );
  gfx_set(0.04, 0.03, 0.03, 0.6);
  gfx_circle(cx + 1.5 * scale, cy + 2.5 * scale, rad, 1, 1);
  gfx_set(0.42, 0.43, 0.46, 1);
  gfx_circle(cx, cy, rad, 1, 1);
  gfx_set(0.62, 0.63, 0.66, 1);
  gfx_circle(cx, cy, rad - 2 * scale, 1, 1);
  gfx_set(0.72, 0.73, 0.76, 1);
  gfx_circle(cx - 0.12 * rad, cy - 0.12 * rad, rad * 0.78, 1, 1);
  gfx_set(0.80, 0.81, 0.83, 0.55);
  gfx_circle(cx - 0.25 * rad, cy - 0.28 * rad, rad * 0.45, 1, 1);
  gfx_set(0.13, 0.13, 0.15, 1);
  kv = -1.2;
  loop(5,
    gfx_line(cx + sin(a) * rad * 0.22 + cos(a) * kv * scale * 0.6, cy - cos(a) * rad * 0.22 + sin(a) * kv * scale * 0.6,
             cx + sin(a) * rad * 0.92 + cos(a) * kv * scale * 0.6, cy - cos(a) * rad * 0.92 + sin(a) * kv * scale * 0.6, 1);
    kv += 0.6;
  );
  font(13, 'b');
  gfx_set(1, 1, 1, 1);
  gfx_measurestr(name, tw, th);
  gfx_x = cx - tw * 0.5; gfx_y = cy - rad - 11 * scale - th;
  gfx_drawstr(name);
  font(11, 0);
  gfx_set(0.92, 0.90, 0.88, 1);
  gfx_measurestr(s_text(s), tw, th);
  gfx_x = cx - tw * 0.5; gfx_y = cy + rad + 8 * scale;
  gfx_drawstr(#vt);
);

function draw_switch(s, x, y, w, h, label) local(on, hov, tw, th) (
  hov = hit_rect(mouse_x, mouse_y, x, y, w, h);
  hov ? g_hov = s;
  mouse_just_down && hov ? ( set_slider(s, slider(s) >= 0.5 ? 0 : 1); mouse_just_down = 0; );
  on = slider(s) >= 0.5;
  on ? gfx_set(0.918, 0.663, 0.173, 1) : gfx_set(0.17, 0.15, 0.14, 1);
  gfx_roundrect(x, y, w, h, 5 * scale, 1);
  gfx_rect(x + scale, y + scale, w - 2 * scale, h - 2 * scale, 1);
  gfx_set(0.30, 0.27, 0.25, 1);
  gfx_roundrect(x, y, w, h, 5 * scale, 1);
  font(13, 'b');
  on ? gfx_set(0.10, 0.08, 0.06, 1) : gfx_set(0.85, 0.83, 0.80, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + (w - tw) * 0.5; gfx_y = y + (h - th) * 0.5;
  gfx_drawstr(label);
);

function draw_panel(x, y, w, h) (
  gfx_set(0.135, 0.12, 0.11, 1);
  gfx_rect(px(x) + 4 * scale, py(y), (w - 8) * scale, h * scale, 1);
  gfx_rect(px(x), py(y) + 4 * scale, w * scale, (h - 8) * scale, 1);
  gfx_circle(px(x) + 4 * scale, py(y) + 4 * scale, 4 * scale, 1, 1);
  gfx_circle(px(x + w) - 4 * scale - 1, py(y) + 4 * scale, 4 * scale, 1, 1);
  gfx_circle(px(x) + 4 * scale, py(y + h) - 4 * scale - 1, 4 * scale, 1, 1);
  gfx_circle(px(x + w) - 4 * scale - 1, py(y + h) - 4 * scale - 1, 4 * scale, 1, 1);
  gfx_set(0.25, 0.22, 0.20, 1);
  gfx_roundrect(px(x), py(y), w * scale, h * scale, 4 * scale, 1);
);

function draw_record(cx, cy, r) local(i, a, rr, ox_, oy_, k, sx, sy, n, al)
(
  g_st0 > 0 ? (
    al = g_st0 * (0.55 + 0.45 * sin(g_now * 2 * $pi * 0.8));
    i = 0;
    loop(14,
      gfx_set(1.0, 0.60, 0.12, al * 0.32 * (1 - i / 14));
      gfx_circle(cx, cy, r + (9 + i) * scale, 0, 1);
      i += 1;
    );
  );
  gfx_set(0.05, 0.045, 0.04, 1);
  gfx_circle(cx, cy, r + 8 * scale, 1, 1);
  gfx_set(0.20, 0.18, 0.17, 1);
  gfx_circle(cx, cy, r + 8 * scale, 0, 1);
  g_st1 > 0 ? (
    g_la = 3.93;
    g_lx = cx + sin(g_la) * (r + 17 * scale); g_ly = cy - cos(g_la) * (r + 17 * scale);
    g_fl = g_st1 * (0.88 + 0.12 * sin(g_now * 31) * sin(g_now * 7.3));
    i = 0;
    loop(6,
      gfx_set(1.0, 0.45, 0.12, g_fl * 0.10 * (1 - i / 6));
      gfx_circle(g_lx, g_ly, (4 + i * 2.2) * scale, 1, 1);
      i += 1;
    );
    gfx_set(1.0, 0.62, 0.30, 0.6 + 0.4 * g_fl);
    gfx_circle(g_lx, g_ly, 3.5 * scale, 1, 1);
    gfx_set(1.0, 0.90, 0.75, 0.5 + 0.5 * g_fl);
    gfx_circle(g_lx, g_ly, 1.4 * scale, 1, 1);
    g_sw = 0.035 * g_wob * sin(g_ang);
    i = 0;
    loop(60,
      a = i * 2 * $pi / 60 + g_sw;
      k = a - g_la; k -= 2 * $pi * floor((k + $pi) / (2 * $pi));
      al = g_fl * (0.12 + 0.88 * exp(-sqr(k / 1.1)));
      gfx_set(1.0, 0.72, 0.45, min(1, al * 1.3));
      gfx_line(cx + sin(a) * (r + 2.5 * scale), cy - cos(a) * (r + 2.5 * scale), cx + sin(a) * (r + 6.5 * scale), cy - cos(a) * (r + 6.5 * scale), 1);
      scale >= 1.5 ? gfx_line(cx + sin(a + 0.004) * (r + 2.5 * scale), cy - cos(a + 0.004) * (r + 2.5 * scale), cx + sin(a + 0.004) * (r + 6.5 * scale), cy - cos(a + 0.004) * (r + 6.5 * scale), 1);
      i += 1;
    );
  );
  g_wa = 2 * $pi * wl_phase;
  ox_ = cx + sin(g_wa) * g_wob * r * 0.03;
  oy_ = cy - cos(g_wa) * g_wob * r * 0.03;
  g_st4 > 0 && g_spd > 0.5 ? (
    ox_ += (sin(g_now * 41) + 0.6 * sin(g_now * 67)) * 0.7 * scale * g_st4;
    oy_ += (cos(g_now * 37) + 0.6 * sin(g_now * 59)) * 0.7 * scale * g_st4;
  );
  gfx_set(0.035, 0.035, 0.04, 1);
  gfx_circle(ox_, oy_, r, 1, 1);
  i = 0;
  loop(26,
    rr = r * (0.40 + 0.58 * i / 25);
    gfx_set(0.11, 0.11, 0.12, 0.55 + 0.25 * ((i % 3) == 0));
    gfx_circle(ox_, oy_, rr, 0, 1);
    i += 1;
  );
  g_st6 > 0 ? (
    n = floor(3 + 6 * g_st6);
    i = 0;
    loop(n,
      a = g_ang + i * 2.39996 + 0.7;
      rr = r * (0.45 + 0.5 * ((i * 0.381966) - floor(i * 0.381966)));
      gfx_set(0.85, 0.82, 0.75, 0.22 + 0.25 * g_st6);
      gfx_arc(ox_, oy_, rr, a, a + 0.25 + 0.3 * ((i * 0.7548) - floor(i * 0.7548)), 1);
      i += 1;
    );
  );
  k = 0;
  loop(2,
    a = g_ang + k * $pi + 0.6;
    gfx_set(1, 1, 1, 0.05);
    i = 0;
    loop(14,
      rr = r * (0.42 + 0.56 * i / 13);
      gfx_arc(ox_, oy_, rr, a, a + 0.35, 1);
      i += 1;
    );
    k += 1;
  );
  gfx_set(0.62, 0.20, 0.13, 1);
  gfx_circle(ox_, oy_, r * 0.34, 1, 1);
  gfx_set(0.76, 0.30, 0.18, 1);
  gfx_circle(ox_, oy_, r * 0.30, 1, 1);
  gfx_set(0.95, 0.85, 0.65, 0.9);
  gfx_arc(ox_, oy_, r * 0.24, g_ang, g_ang + 1.6, 1);
  gfx_arc(ox_, oy_, r * 0.25, g_ang, g_ang + 1.6, 1);
  gfx_arc(ox_, oy_, r * 0.24, g_ang + $pi, g_ang + $pi + 0.9, 1);
  gfx_set(0.85, 0.84, 0.82, 1);
  gfx_circle(ox_, oy_, r * 0.035, 1, 1);
  g_st5 > 0 ? (
    n = floor(8 + 22 * g_st5);
    i = 0;
    loop(n,
      a = g_ang + i * 2.39996;
      rr = r * (0.45 + 0.5 * ((i * 0.618034) - floor(i * 0.618034)));
      gfx_set(0.90, 0.84, 0.72, 0.6);
      gfx_rect(ox_ + sin(a) * rr, oy_ - cos(a) * rr, max(1, scale), max(1, scale), 1);
      i += 1;
    );
    loop(floor(rand(1) + 0.15 + 0.6 * g_st5),
      a = rand(2 * $pi); rr = r * (0.45 + (rand(1) * 0.5));
      gfx_set(1, 0.95, 0.80, 0.85);
      gfx_circle(ox_ + sin(a) * rr, oy_ - cos(a) * rr, 1.5 * scale, 1, 1);
      gfx_set(1, 0.9, 0.7, 0.25);
      gfx_circle(ox_ + sin(a) * rr, oy_ - cos(a) * rr, 3.5 * scale, 1, 1);
    );
  );
  g_st2 > 0 ? (
    loop(floor(8 + 24 * g_st2),
      a = rand(2 * $pi); rr = r * (0.38 + (rand(1) * 0.55));
      sx = ox_ + sin(a) * rr; sy = oy_ - cos(a) * rr;
      gfx_set(0.70, 0.85, 1.0, 0.5 + (rand(1) * 0.5));
      gfx_rect(sx, sy, max(1, 1.5 * scale), max(1, 1.5 * scale), 1);
      rand(1) < 0.25 ? ( gfx_set(0.70, 0.85, 1.0, 0.35); gfx_line(sx, sy, sx + rand(6) - 3, sy + rand(6) - 3, 1); );
    );
  );
  g_st3 > 0 ? (
    loop(floor(200 + 500 * g_st3),
      a = rand(2 * $pi); rr = r * sqrt(0.12 + (rand(1) * 0.88));
      gfx_set(0.62, 0.62, 0.66, 0.16 + 0.22 * g_st3);
      gfx_rect(ox_ + sin(a) * rr, oy_ - cos(a) * rr, max(1, scale), max(1, scale), 1);
    );
  );
  k = cx + r * 0.98; n = cy - r * 0.92;
  a = -0.10;
  sx = k - sin(a) * r * 1.25; sy = n + cos(a) * r * 1.25;
  gfx_set(0.22, 0.20, 0.19, 1);
  gfx_rect(sx - 3 * scale, sy - 2 * scale, 6 * scale, 10 * scale, 1);
  gfx_set(0.40, 0.38, 0.36, 1);
  gfx_rect(sx - 4 * scale, sy - 3 * scale, 8 * scale, 3 * scale, 1);
  g_lift = sin($pi * min(1, max(0, g_arm)));
  a = 0.45 + (-0.10 - 0.45) * (0.5 - 0.5 * cos($pi * g_arm));
  g_arm < 0.01 ? a += 0.012 * sin(g_ang * 3) * g_wob + (g_st4 > 0 ? 0.004 * g_st4 * (sin(g_now * 53) + 0.5 * sin(g_now * 31)) : 0);
  sx = k - sin(a) * r * 1.25; sy = n + cos(a) * r * 1.25;
  g_lift > 0.02 ? (
    gfx_set(0.30, 0.28, 0.27, 0.6 * g_lift);
    gfx_line(k, n, sx, sy, 1);
    gfx_rect(sx - 4 * scale, sy - 3 * scale, 9 * scale, 12 * scale, 1);
    sx -= 4 * scale * g_lift; sy -= 7 * scale * g_lift;
  );
  gfx_set(0.55, 0.55, 0.58, 1);
  gfx_circle(k, n, 9 * scale, 1, 1);
  gfx_set(0.35, 0.35, 0.38, 1);
  gfx_circle(k, n, 5 * scale, 1, 1);
  gfx_set(0.70 + 0.12 * g_lift, 0.70 + 0.12 * g_lift, 0.73 + 0.12 * g_lift, 1);
  gfx_line(k, n, sx, sy, 1);
  gfx_line(k + scale, n, sx + scale, sy, 1);
  gfx_set(0.80 + 0.1 * g_lift, 0.80 + 0.1 * g_lift, 0.82 + 0.1 * g_lift, 1);
  gfx_rect(sx - (4 + 2 * g_lift) * scale, sy - (3 + 2 * g_lift) * scale, (9 + 4 * g_lift) * scale, (12 + 4 * g_lift) * scale, 1);
);

g_now = time_precise();
g_dt = g_last > 0 ? max(0, min(0.1, g_now - g_last)) : 0;
g_last = g_now;
g_spd_t = (play_state & 1) ? p_speed : 0;
g_spd += (g_spd_t - g_spd) * min(1, g_dt * 3);
abs(g_spd - g_spd_t) < (g_spd_t == 0 ? 0.05 : 0.000001) ? g_spd = g_spd_t;
g_ang += g_dt * g_spd / 60 * 2 * $pi;
g_ang > 2 * $pi ? g_ang -= 2 * $pi;
g_wob = p_drone * 0.01 * min(1, g_spd / max(1, p_speed));
g_arm_t = p_bypass >= 0.5 ? 1 : 0;
g_arm += max(-g_dt * 1.4, min(g_dt * 1.4, g_arm_t - g_arm));
gi = 0;
loop(7,
  g_lv = slider(7 + 3 * gi) >= 0.5 ? max(0.15, min(1, 0.6 * 10 ^ ((slider(8 + 3 * gi) - s_def(8 + 3 * gi)) / 40))) : 0;
  gi == 0 ? g_st0 = g_lv : gi == 1 ? g_st1 = g_lv : gi == 2 ? g_st2 = g_lv : gi == 3 ? g_st3 = g_lv :
  gi == 4 ? g_st4 = g_lv : gi == 5 ? g_st5 = g_lv : g_st6 = g_lv;
  gi += 1;
);

mouse_down = mouse_cap & 1;
mouse_just_down = mouse_down && !g_mouse_last;
wheel = mouse_wheel; mouse_wheel = 0;
g_hov = 0;

gfx_set(0.115, 0.10, 0.09, 1);
gfx_rect(0, 0, gfx_w, gfx_h, 1);
gfx_gradrect(0, 0, gfx_w, gfx_h, 0.115, 0.10, 0.09, 1, 0, 0, 0, 0, -0.035 / max(1, gfx_h), -0.03 / max(1, gfx_h), -0.03 / max(1, gfx_h), 0);

font(30, 'b');
gfx_set(1, 1, 1, 1);
gfx_x = px(16); gfx_y = py(10);
gfx_drawstr("Wax Lyrical");
font(11, 0);
gfx_set(0.918, 0.663, 0.173, 1);
gfx_x = px(18); gfx_y = py(52);
gfx_drawstr("by chmaha  ·  based on Calf Vinyl by Markus Schmidt");
!wl_ok ? (
  font(12, 'b'); gfx_set(1, 0.45, 0.35, 1);
  gfx_x = px(470); gfx_y = py(26);
  gfx_drawstr("Missing Dependencies/WaxLyrical (noise layers are silent)");
);

draw_panel(8, 76, 300, 268);
draw_record(px(158), py(210), floor(112 * scale));
hit_circle(mouse_x, mouse_y, px(158), py(210), 122 * scale) ? (
  g_hov = 29;
  mouse_just_down ? ( set_slider(28, p_bypass >= 0.5 ? 0 : 1); mouse_just_down = 0; );
);

draw_panel(316, 76, 576, 268);
KR = 26 * scale;
draw_knob(3, px(404), py(152), KR, "Drone");
draw_knob(4, px(544), py(152), KR, "Speed");
gi = 0;
loop(3,
  g_bx = px(500 + gi * 30);
  g_bv = gi == 0 ? 33 : gi == 1 ? 45 : 78;
  hit_rect(mouse_x, mouse_y, g_bx - 13 * scale, py(206), 26 * scale, 18 * scale) ? (
    g_hov = 40;
    mouse_just_down ? ( set_slider(4, g_bv); mouse_just_down = 0; );
  );
  abs(p_speed - g_bv) < 0.5 ? gfx_set(0.918, 0.663, 0.173, 1) : gfx_set(0.17, 0.15, 0.14, 1);
  gfx_rect(g_bx - 12 * scale, py(207), 24 * scale, 16 * scale, 1);
  gfx_set(0.30, 0.27, 0.25, 1);
  gfx_roundrect(g_bx - 13 * scale, py(206), 26 * scale, 18 * scale, 4 * scale, 1);
  font(10, 'b');
  abs(p_speed - g_bv) < 0.5 ? gfx_set(0, 0, 0, 1) : gfx_set(0.85, 0.83, 0.80, 1);
  sprintf(#g_t, "%d", g_bv); gfx_measurestr(#g_t, g_tw, g_th);
  gfx_x = g_bx - g_tw * 0.5; gfx_y = py(206) + (18 * scale - g_th) * 0.5; gfx_drawstr(#g_t);
  gi += 1;
);
draw_knob(5, px(684), py(152), KR, "Aging");
draw_knob(6, px(824), py(152), KR, "Frequency");
draw_knob(1, px(474), py(282), KR, "Input");
draw_knob(2, px(754), py(282), KR, "Output");

draw_panel(8, 352, 884, 146);
gi = 0;
loop(7,
  g_sx = 8 + gi * 126.3;
  g_s0 = 7 + 3 * gi;
  gi == 0 ? strcpy(#g_nm, "Hum") : gi == 1 ? strcpy(#g_nm, "Motor") : gi == 2 ? strcpy(#g_nm, "Static") :
  gi == 3 ? strcpy(#g_nm, "Noise") : gi == 4 ? strcpy(#g_nm, "Rumble") : gi == 5 ? strcpy(#g_nm, "Crackle") : strcpy(#g_nm, "Crinkle");
  draw_switch(g_s0, px(g_sx + 14), py(364), 98 * scale, 26 * scale, #g_nm);
  gi > 0 ? ( gfx_set(0.25, 0.22, 0.20, 1); gfx_line(px(g_sx), py(362), px(g_sx), py(488)); );
  draw_knob(g_s0 + 1, px(g_sx + 36), py(446), 18 * scale, "Level");
  draw_knob(g_s0 + 2, px(g_sx + 92), py(446), 18 * scale, "Pitch");
  gi += 1;
);

drag_target > 0 ? (
  mouse_down ? (
    mouse_cap |= 65536;
    set_pos(drag_target, drag_p0 + (drag_y0 - mouse_y) / (((mouse_cap & 4) ? 1500 : 150) * scale));
    g_hov = drag_target;
  ) : (
    automate(drag_target, 1);
    drag_target = 0;
  );
);

gfx_set(0.07, 0.06, 0.055, 1);
gfx_rect(0, py(504), gfx_w, gfx_h - py(504), 1);
font(11, 0);
gfx_set(0.92, 0.90, 0.88, 1);
gfx_x = px(16); gfx_y = py(509);
g_hk = g_hov <= 6 ? g_hov : g_hov <= 27 ? 7 + (g_hov - 7) % 3 : g_hov;
g_hk == 1 ? gfx_drawstr("Input: gain before the record simulation.") :
g_hk == 2 ? gfx_drawstr("Output: gain after the record simulation.") :
g_hk == 3 ? gfx_drawstr("Drone: off-centre wobble, up to 10 ms, once per revolution of the record.") :
g_hk == 4 || g_hk == 40 ? gfx_drawstr("Speed: record speed in rpm; sets how fast the drone wobbles.") :
g_hk == 5 ? gfx_drawstr("Aging: narrows the frequency range around Frequency, like a worn record.") :
g_hk == 6 ? gfx_drawstr("Frequency: centre of the aged, honky midrange.") :
g_hk == 7 ? gfx_drawstr("Switches this noise layer on or off.") :
g_hk == 8 ? gfx_drawstr("Level of this noise layer.") :
g_hk == 9 ? gfx_drawstr("Pitch of this noise layer, up to an octave up or down.") :
g_hov == 29 ? gfx_drawstr(p_bypass >= 0.5 ? "Bypassed. Click the record to drop the needle." : "Click the record to lift the needle and bypass (1024-sample crossfade).") :
gfx_drawstr("Click the record to bypass (the needle lifts).  Drag or scroll knobs (Ctrl = fine), double-click to reset.");

g_mouse_last = mouse_down;
