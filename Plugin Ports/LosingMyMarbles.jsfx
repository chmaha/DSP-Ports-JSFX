knob_at(6, px(780), py(170), 52 * uscale, 1, 0);
knob_at(4, px(84), py(290), 34 * uscale, 0, 0);
knob_at(7, px(896), py(290), 34 * uscale, 0, 0);
knob_at(2, px(490), py(240), 32 * uscale, 0, 0);
knob_at(5, px(330), py(316), 32 * uscale, 0, 0);
knob_at(8, px(650), py(316), 32 * uscale, 0, 0);

gfx_set(0.37, 0.40, 0.46, 1);
gfx_rect(px(60), py(388), 860 * uscale, 36 * uscale, 1);
gi = 0;
loop(7,
  gcx = 104 + gi * 122;
  gidx = gi == 0 ? 0 : gi == 1 ? 1 : gi == 2 ? 2 : -1;
  gidx >= 0 ? ( LEDV[gidx] *= 0.82; led(px(gcx - 26), py(406), 1, 0.75, 0.25, LEDV[gidx]); );
  gfx_set(1, 1, 1, 1);
  ltext(gi == 0 ? "t1" : gi == 1 ? "t2" : gi == 2 ? "t3" : gi == 3 ? "Y" : gi == 4 ? "X1" : gi == 5 ? "X2" : "X3", px(gcx - 12), py(398), 15, 'i');
  gi >= 4 ? (
    gfx_set(0.68, 0.92, 0.70, 1);
    k_voice >= 0.5 ? strcpy(#gn, "-") : VACT[gi - 4] ? strcpy(#gn, note_str(VNOTE[gi - 4])) : strcpy(#gn, "·");
    ltext(#gn, px(gcx + 14), py(398), 14, 'b');
  ) : gi == 3 ? (
    gfx_set(0.68, 0.92, 0.70, 1);
    sprintf(#gyv, "%d", max(0, y_last));
    ltext(#gyv, px(gcx + 14), py(398), 14, 'b');
  );
  gi += 1;
);

gfx_set(0.62, 0.63, 0.65, 1);
gfx_rect(px(20), py(432), (UDW - 40) * uscale, max(1, uscale), 1);
gfx_set(0.97, 0.97, 0.97, 1);
gfx_rect(px(20), py(433), (UDW - 40) * uscale, max(1, uscale), 1);

gh = 22 * uscale;
gcw = 110;
sel(11, px(92), py(442), 136 * uscale, gh, "T MODEL");
sel(12, px(310), py(442), gcw * uscale, gh, "T RANGE");
