k_clock >= 0.5 ? (
  dark_btn(25, px(816), py(570), 144 * uscale, gh, k_run >= 0.5 ? "STOP" : "RUN", k_run >= 0.5, 12) ? ( set_slider(25, k_run >= 0.5 ? 0 : 1); u_click = 0; );
);

!tables_ok ? (
  gfx_set(0.10, 0.13, 0.20, 0.92);
  gfx_rect(px(200), py(240), 580 * uscale, 50 * uscale, 1);
