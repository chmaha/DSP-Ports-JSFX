sel(15, px(506), py(474), gcw * uscale, gh, "SCALE");
sel(16, px(702), py(474), gcw * uscale, gh, "X CLOCK");
sel(35, px(888), py(474), 72 * uscale, gh, "X INPUT");
fld(17, px(92), py(506), 136 * uscale, gh, "GATE LEN");
fld(18, px(310), py(506), gcw * uscale, gh, "GATE RND");
fld(19, px(506), py(506), gcw * uscale, gh, "Y SPREAD");
fld(20, px(702), py(506), gcw * uscale, gh, "Y BIAS");
fld(21, px(888), py(506), 72 * uscale, gh, "Y STEPS");
fld(22, px(92), py(538), 136 * uscale, gh, "Y DIVIDE");
sel(23, px(310), py(538), gcw * uscale, gh, "Y RANGE");
fld(33, px(506), py(538), 70 * uscale, gh, "Y CC");
sel(34, px(580), py(538), 40 * uscale, gh, "");
fld(28, px(702), py(538), gcw * uscale, gh, "CHANNEL");
