desc: Losing My Marbles Random Sampler (Mutable Instruments Marbles port) by chmaha
tags: midi generator sequencer random melody
author: chmaha
version: 1.0
changelog:
  Initial release.
about:
  A port of Mutable Instruments Marbles, the random sampler. Three gate streams (t1, t2, t3) make rhythms and
  three random pitch streams (X1, X2, X3) make melodies. Y is a slower random value sent as a MIDI CC.
  Deja Vu is the heart of it: below 12 o'clock the randomness starts to repeat, at 12 o'clock it locks into a
  loop of the set Length, and above that it scrambles the loop. T and X each have their own Deja Vu button.
  Marbles makes MIDI only, so put an instrument after it on the same track. In Pitch mode each gate plays its
  own X value through the chosen scale; in Drums mode each gate plays a fixed note. It follows REAPER's
  transport, where Rate picks a multiple of the beat, or runs free at its own rate.
  Steps below 12 o'clock glides; above it quantizes to the scale, keeping fewer of the notes as it turns up.
  Needs Dependencies/LosingMyMarbles/marbles_tables.txt.
  Ported from Marbles by Emilie Gillet (Mutable Instruments)
  https://github.com/pichenettes/eurorack (MIT)
  JSFX version released under GPLv3+ license
  Claude generated some of this code
provides:
  Dependencies/LosingMyMarbles/marbles_tables.txt

slider1:k_dj=0.5<0,1,0.001>-Deja Vu
slider2:k_len=0.5<0,1,0.001>-Length
slider3:k_rate=0.5<0,1,0.001>-Rate
slider4:k_tbias=0.5<0,1,0.001>-T Bias
slider5:k_jit=0<0,1,0.001>-Jitter
slider6:k_spread=0.5<0,1,0.001>-Spread
slider7:k_xbias=0.5<0,1,0.001>-X Bias
slider8:k_steps=0.75<0,1,0.001>-Steps
slider9:k_tdeja=0<0,2,1{Off,On,Locked}>-T Deja Vu
slider10:k_xdeja=0<0,2,1{Off,On,Locked}>-X Deja Vu
slider11:k_model=0<0,6,1{Complementary Bernoulli,Clusters,Drums,Independent Bernoulli,Divider,Three States,Markov}>-T Model
slider12:k_trange=1<0,2,1{/4,x1,x4}>-T Range
slider13:k_xctrl=0<0,2,1{Identical,Bump,Tilt}>-X Control
slider14:k_xrange=0<0,2,1{+2V,+5V,+/-5V}>-X Range
slider15:k_scale=0<0,5,1{Major,Minor,Pentatonic,Pelog,Bhairav,Shri}>-Scale
slider16:k_xclk=0<0,3,1{t1 t2 t3,t1,t2,t3}>-X Clock
slider17:k_pwm=128<0,255,1>-Gate Length
slider18:k_pws=0<0,255,1>-Gate Random
slider19:k_ysp=128<0,255,1>-Y Spread
slider20:k_yb=128<0,255,1>-Y Bias
slider21:k_yst=0<0,255,1>-Y Steps
slider22:k_ydiv=128<0,255,1>-Y Divider
slider23:k_yr=2<0,2,1{+2V,+5V,+/-5V}>-Y Range
slider24:k_clock=0<0,1,1{Follow Transport,Free}>-Clock
slider25:k_run=0<0,1,1{Stopped,Running}>-Free Run
slider26:k_voice=0<0,1,1{Pitch,Drums}>-Voice Mode
slider27:k_root=48<0,127,1>-Root Note
slider28:k_chan=1<1,16,1>-MIDI Channel
slider29:k_vel=100<1,127,1>-Velocity
slider30:k_n1=36<0,127,1>-Drum Note 1
slider31:k_n2=38<0,127,1>-Drum Note 2
slider32:k_n3=42<0,127,1>-Drum Note 3
slider33:k_ycc=1<0,127,1>-Y CC
slider34:k_yon=1<0,1,1{Off,On}>-Y Output
slider35:k_reg=0<0,1,1{Random,MIDI In}>-X Source
slider36:k_thru=1<0,1,1{Off,On}>-MIDI Thru
slider37:k_seed=1<1,9999,1>-Seed

in_pin:none
out_pin:none

options:no_meter

@init
ext_noinit = gfx_ext_retina = 1;

function alloc(n) local(r) instance(mp) global() ( r = mp; mp += n; memset(r, 0, n); r; );
alloc.mp = 0;

TRAW = alloc(26000);
TBL = alloc(26000);
TOFF = alloc(8);
tables_ok = 0;

function tables_load() local(h, n, nt, i, p, q, len) (
  h = file_open("LosingMyMarbles/marbles_tables.txt");
  h < 0 ? h = file_open("Dependencies/LosingMyMarbles/marbles_tables.txt");
  h >= 0 ? (
    n = file_mem(h, TRAW, 26000);
    file_close(h);
    nt = TRAW[0];
    (n > 100 && nt == 6) ? (
      q = 1; p = 0; i = 0;
      loop(nt,
        len = TRAW[q];
        TOFF[i] = TBL + p;
        memcpy(TBL + p, TRAW + q + 1, len);
        p += len;
        q += len + 1;
        i += 1;
      );
      tables_ok = q == n;
    );
  );
);
tables_load();
T_PRH = TOFF[0]; T_PRL = TOFF[1]; T_RC = TOFF[2]; T_LOGIT = TOFF[3]; T_I43 = TOFF[4]; T_DIST = TOFF[5];

