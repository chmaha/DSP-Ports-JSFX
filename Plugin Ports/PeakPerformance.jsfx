shape(TOPL, TOPR, os_cnt);
td_n ? top_delay(TOPL, TOPR, os_cnt);
os_n >= 1 ? ( os_n >= 2 ? ( os_n >= 3 ? ( os_n >= 4 ? ( os_n >= 5 ? dn4(); dn3(); ); dn2(); ); dn1(); ); dn0(); );
yl = BL0[0]; yr = BR0[0];
