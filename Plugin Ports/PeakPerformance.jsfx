MU0 = 38; MD0 = 26; QN0 = 13;
UL0 = alloc(2 * MU0); UR0 = alloc(2 * MU0); DL0 = alloc(2 * MD0); DR0 = alloc(2 * MD0); QL0 = alloc(QN0); QR0 = alloc(QN0);
BL1 = alloc(2); BR1 = alloc(2);
MU1 = 18; MD1 = 12; QN1 = 6;
