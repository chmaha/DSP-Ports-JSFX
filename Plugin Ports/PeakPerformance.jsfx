BL2 = alloc(4); BR2 = alloc(4);
MU2 = 16; MD2 = 10; QN2 = 5;
UL2 = alloc(2 * MU2); UR2 = alloc(2 * MU2); DL2 = alloc(2 * MD2); DR2 = alloc(2 * MD2); QL2 = alloc(QN2); QR2 = alloc(QN2);
BL3 = alloc(8); BR3 = alloc(8);
