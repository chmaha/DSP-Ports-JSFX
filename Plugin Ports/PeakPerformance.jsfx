function top_delay(a, b, n) local(i, v) (
  i = 0;
  loop(n,
    v = a[i]; a[i] = TDL[tdp]; TDL[tdp] = v;
    v = b[i]; b[i] = TDR[tdp]; TDR[tdp] = v;
    tdp += 1; tdp >= td_n ? tdp = 0;
    i += 1;
  );
);

function tilt(f, g) local(tk, bk, wp, b0, b1, a0, a1) (
  tk = 10 ^ (g / 40);
  bk = 2 * srate;
  wp = 2 * srate * tan($pi * min(f, 0.45 * srate) / srate);
  b0 = tk * bk + wp; b1 = wp - tk * bk;
  a0 = bk + tk * wp; a1 = tk * wp - bk;
  ep_b0 = b0 / a0; ep_b1 = b1 / a0; ep_a1 = a1 / a0;
  ed_b0 = a0 / b0; ed_b1 = a1 / b0; ed_a1 = b1 / b0;
);

function os_apply(s) (
  os_n = s;
  memset(STATE0, 0, STATE1 - STATE0);
  PU0 = PU1 = PU2 = PU3 = PU4 = 0; DP0 = DP1 = DP2 = DP3 = DP4 = 0; QP0 = QP1 = QP2 = QP3 = QP4 = 0; tdp = 0;
  os_cnt = 2 ^ os_n;
  TOPL = os_n === 0 ? BL0 : os_n === 1 ? BL1 : os_n === 2 ? BL2 : os_n === 3 ? BL3 : os_n === 4 ? BL4 : BL5;
  TOPR = os_n === 0 ? BR0 : os_n === 1 ? BR1 : os_n === 2 ? BR2 : os_n === 3 ? BR3 : os_n === 4 ? BR4 : BR5;
  lat = LATS[os_n]; td_n = TDS[os_n];
  pdc_delay = lat; pdc_bot_ch = 0; pdc_top_ch = 2;
  g_steps = floor(0.1 * srate * os_cnt);
  GPRE.cnt = 0; GPRE.cur = GPRE.tgt; GPOST.cnt = 0; GPOST.cur = GPOST.tgt;
  epl1 = epr1 = edl1 = edr1 = 0;
);

function params() local(t, d) (
  link === 1 ? (
    in_db !== lk_in ? ( out_db = -in_db; sliderchange(out_db); ) :
    out_db !== lk_out ? ( in_db = max(-36, min(36, -out_db)); sliderchange(in_db); ) :
    out_db !== -in_db ? ( out_db = -in_db; sliderchange(out_db); );
  ) : link === 2 ? (
    ceil_db !== lk_ceil ? ( out_db = -ceil_db; sliderchange(out_db); ) :
    out_db !== lk_out ? ( ceil_db = max(-36, min(0, -out_db)); out_db = -ceil_db; sliderchange(ceil_db); sliderchange(out_db); ) :
    out_db !== -ceil_db ? ( out_db = -ceil_db; sliderchange(out_db); );
  );
  lk_in = in_db; lk_out = out_db; lk_ceil = ceil_db;
  GIN.sv_set(10 ^ (in_db / 20), io_steps);
  GOUT.sv_set(10 ^ (out_db / 20), io_steps);
  GPRE.sv_set(10 ^ (-ceil_db / 20), g_steps);
  GPOST.sv_set(10 ^ (ceil_db / 20), g_steps);
  t = bypass >= 0.5 ? 0 : max(0, min(1, mix / 100));
  WET.sv_set(t, mx_steps);
  DRY.sv_set(1 - t, mx_steps);
  algo_i = max(0, min(7, floor(algo + 0.5)));
  t = max(0, min(1, soft / 100));
  sk0 = 1 - t; sk1 = 1 + t; sk4 = t > 0 ? 1 / (4 * t) : 0;
  guard_on = guard >= 0.5;
  delta_on = delta >= 0.5;
  (emph !== em_g || pivot !== em_f || srate !== em_sr) ? (
    em_g = emph; em_f = pivot; em_sr = srate;
    em_on = abs(emph) >= 0.05;
    em_on ? tilt(pivot, emph) : (epl1 = epr1 = edl1 = edr1 = 0;);
  );
  d = max(0, min(5, floor(osr + 0.5)));
  d !== os_want ? (
    os_want = d;
    fd_state === 0 && os_init ? ( fd_state = 1; fd_n = fd_len; );
  );
  !os_init ? ( os_init = 1; os_apply(os_want); );
  first ? (
    first = 0;
    GIN.sv_snap(GIN.tgt); GOUT.sv_snap(GOUT.tgt); GPRE.sv_snap(GPRE.tgt); GPOST.sv_snap(GPOST.tgt);
    WET.sv_snap(WET.tgt); DRY.sv_snap(DRY.tgt);
  );
);

function gauto(s, e) (
<?
max_sliders > 16 ? printf("slider_automate(2^(s-1), e);") : (
  printf("s == 1 ? slider_automate(in_db, e) : s == 2 ? slider_automate(out_db, e) : s == 3 ? slider_automate(ceil_db, e) :\n");
  printf("s == 4 ? slider_automate(link, e) : s == 5 ? slider_automate(bypass, e) : s == 6 ? slider_automate(algo, e) :\n");
  printf("s == 7 ? slider_automate(osr, e) : s == 8 ? slider_automate(mix, e) : s == 9 ? slider_automate(soft, e) :\n");
  printf("s == 10 ? slider_automate(guard, e) : s == 11 ? slider_automate(delta, e) : s == 12 ? slider_automate(emph, e) :\n");
  printf("s == 13 ? slider_automate(pivot, e) : s == 14 ? slider_automate(disp, e) : s == 15 ? slider_automate(zoom, e) : s == 16 ? slider_automate(theme, e) : 0;");
);
?>
);

function gsx(x) ( G_OX + x * G_SC; );
function gsy(y) ( y * G_SC; );
function gclamp(x, a, b) ( min(b, max(a, x)); );

function grspan(qx0, qy0, qx1, qy1, qrad, yc) local(dy, ins) (
  dy = yc < qy0 + qrad ? qy0 + qrad - yc : yc > qy1 - qrad ? yc - (qy1 - qrad) : 0;
  G_RC = max(0, min(1, qrad - dy + 0.5));
  dy = min(qrad, dy);
  ins = qrad - sqrt(max(0, qrad * qrad - dy * dy));
  G_RL = qx0 + ins; G_RR = qx1 - ins;
);

function gspan(lx, rx, j, a) local(lc, rc) (
  lc = ceil(lx); rc = floor(rx);
  rc >= lc ? (
    gfx_a = a; rc > lc ? gfx_rect(lc, j, rc - lc, 1);
    lc - lx > 0 ? ( gfx_a = a * (lc - lx); gfx_rect(lc - 1, j, 1, 1); );
    rx - rc > 0 ? ( gfx_a = a * (rx - rc); gfx_rect(rc, j, 1, 1); );
  ) : rx > lx ? ( gfx_a = a * (rx - lx); gfx_rect(floor(lx), j, 1, 1); );
);

function gfrr(qx0, qy0, qx1, qy1, qrad, cr, cg, cb, a0) local(j) (
  qx0 = floor(qx0 + 0.5); qy0 = floor(qy0 + 0.5); qx1 = floor(qx1 + 0.5); qy1 = floor(qy1 + 0.5);
  qrad = max(0, min(qrad, min(qy1 - qy0, qx1 - qx0) * 0.5));
  gfx_set(cr, cg, cb, a0);
  j = qy0;
  loop(qy1 - qy0,
    grspan(qx0, qy0, qx1, qy1, qrad, j + 0.5);
    G_RC > 0 ? gspan(G_RL, G_RR, j, a0 * G_RC);
    j += 1;
  );
  gfx_a = 1;
);

function gbord(qx0, qy0, qx1, qy1, qrad, t, cr, cg, cb, a0) local(j, ol, orr, oc, il, ir, ic) (
  qx0 = floor(qx0 + 0.5); qy0 = floor(qy0 + 0.5); qx1 = floor(qx1 + 0.5); qy1 = floor(qy1 + 0.5);
  qrad = max(0, min(qrad, min(qy1 - qy0, qx1 - qx0) * 0.5));
  gfx_set(cr, cg, cb, a0);
  j = qy0;
  loop(qy1 - qy0,
    grspan(qx0, qy0, qx1, qy1, qrad, j + 0.5); ol = G_RL; orr = G_RR; oc = G_RC;
    (j + 0.5 > qy0 + t && j + 0.5 < qy1 - t) ? (
      grspan(qx0 + t, qy0 + t, qx1 - t, qy1 - t, max(0, qrad - t), j + 0.5); il = G_RL; ir = G_RR; ic = G_RC;
    ) : ( ic = 0; );
    oc > 0 ? (
      ic <= 0 ? gspan(ol, orr, j, a0 * oc) : (
        gspan(ol, il, j, a0 * oc);
        gspan(ir, orr, j, a0 * oc);
        oc - ic > 0.004 ? gspan(il, ir, j, a0 * (oc - ic));
      );
    );
    j += 1;
  );
  gfx_a = 1;
);

function gcard(x, y, w, h, r, a0, ba) local(xx, yy, ww, hh, rr) (
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC); rr = max(2, floor(r * G_SC));
  gfrr(xx, yy, xx + ww, yy + hh, rr, 0.165, 0.17, 0.18, a0);
  gbord(xx, yy, xx + ww, yy + hh, rr, max(1, floor(G_SC + 0.5)), 0.62, 0.66, 0.70, ba);
);

function gtext(x, y, s, fnt, r, g, b, a, ctr) local(tw, th) (
  gfx_setfont(fnt);
  gfx_set(r, g, b, a);
  gfx_measurestr(s, tw, th);
  gfx_x = ctr === 1 ? gsx(x) - tw * 0.5 : ctr === 2 ? gsx(x) - tw : gsx(x);
  gfx_y = gsy(y) - th * 0.5;
  gfx_drawstr(s);
);

function gann(cx, cy, ri, ro, aa, ab, cr, cg, cb, al) local(py, px, dy, dx, hwo, hwi, d, cv, th, ca, x0, x1, x2, x3) (
  py = floor(cy - ro - 1);
  loop(ceil(2 * ro + 3),
    dy = py + 0.5 - cy;
    hwo = sqrt(max(0, (ro + 0.5) * (ro + 0.5) - dy * dy));
    hwo > 0 ? (
      hwi = ri > 0.5 ? sqrt(max(0, (ri - 0.5) * (ri - 0.5) - dy * dy)) : 0;
      x0 = floor(cx - hwo); x1 = ceil(cx - hwi); x2 = floor(cx + hwi); x3 = ceil(cx + hwo);
      hwi <= 0 ? x1 = x3 + 1;
      px = x0;
      while (px <= x3) (
        dx = px + 0.5 - cx;
        d = sqrt(dx * dx + dy * dy);
        cv = min(1, min(ro - d + 0.5, d - ri + 0.5));
        cv > 0 ? (
          th = atan2(dx, -dy);
          ca = min(1, min((th - aa) * d + 0.5, (ab - th) * d + 0.5));
          ca > 0 ? (
            gfx_set(cr, cg, cb, al * cv * ca);
            gfx_rect(px, py, 1, 1);
          );
        );
        px += 1;
        (px > x1 && px < x2) ? px = x2;
      );
    );
    py += 1;
  );
  gfx_a = 1;
);

function gbar(x0, y0, x1, y1, w) local(dx, dy, ll, hw, bx0, by0, bx1, by1, px, py, qx, qy, t, ex, ey, d, cv, cr, cg, cb, ca) (
  cr = gfx_r; cg = gfx_g; cb = gfx_b; ca = gfx_a;
  dx = x1 - x0; dy = y1 - y0; ll = max(0.000001, dx * dx + dy * dy);
  hw = w * 0.5;
  bx0 = floor(min(x0, x1) - hw - 1); bx1 = ceil(max(x0, x1) + hw + 1);
  by0 = floor(min(y0, y1) - hw - 1); by1 = ceil(max(y0, y1) + hw + 1);
  py = by0;
  while (py <= by1) (
    px = bx0;
    while (px <= bx1) (
      qx = px + 0.5; qy = py + 0.5;
      t = max(0, min(1, ((qx - x0) * dx + (qy - y0) * dy) / ll));
      ex = qx - (x0 + t * dx); ey = qy - (y0 + t * dy);
      d = sqrt(ex * ex + ey * ey);
      cv = min(1, hw - d + 0.5);
      cv > 0 ? ( gfx_set(cr, cg, cb, ca * cv); gfx_rect(px, py, 1, 1); );
      px += 1;
    );
    py += 1;
  );
  gfx_set(cr, cg, cb, ca);
);

function gknob(kx, ky, kr, v, ctr, hov, nm, vs, dim) local(cx, cy, r, a0, a1, sa, ca, px0, py0, al) (
  cx = gsx(kx); cy = gsy(ky); r = kr * G_SC;
  al = dim ? 0.66 : 1;
  a0 = -$pi * 0.75; a1 = $pi * 0.75;
  gfx_set(0.02, 0.02, 0.03, 0.5 * al);
  gfx_circle(cx, cy, r + 3 * G_SC, 1, 1);
  gfx_set(0.11, 0.12, 0.13, 1);
  gfx_circle(cx, cy, r - 5 * G_SC, 1, 1);
  gfx_set(0.20, 0.21, 0.23, 1);
  gfx_circle(cx, cy, r - 7 * G_SC, 1, 1);
  gfx_set(0.13, 0.14, 0.15, 1);
  gfx_circle(cx, cy + 1.2 * G_SC, r - 9 * G_SC, 1, 1);
  gann(cx, cy, r - 1.2 * G_SC, r + 1.2 * G_SC, a0, a1, 0.62, 0.66, 0.70, 0.35 * al);
  sa = a0 + (a1 - a0) * v;
  ca = a0 + (a1 - a0) * ctr;
  abs(sa - ca) > 0.001 ? (
    gann(cx, cy, r - 3.5 * G_SC, r + 3.5 * G_SC, min(ca, sa), max(ca, sa), G_ACR, G_ACG, G_ACB, 0.18 * al);
    gann(cx, cy, r - 1.5 * G_SC, r + 1.5 * G_SC, min(ca, sa), max(ca, sa), G_ACR, G_ACG, G_ACB, al);
  );
  px0 = cx + sin(sa) * (r - 8 * G_SC);
  py0 = cy - cos(sa) * (r - 8 * G_SC);
  gfx_set(0.95, 0.97, 0.98, (hov ? 1 : 0.86) * al);
  gbar(cx + sin(sa) * (r * 0.22), cy - cos(sa) * (r * 0.22), px0, py0, max(1.5, 2.4 * G_SC));
  gtext(kx, ky - kr - 13, nm, 1, 0.93, 0.95, 0.96, 0.95 * al, 1);
  gtext(kx, ky + kr + 13, vs, 2, 0.80, 0.84, 0.88, 0.95 * al, 1);
);

function gbtn(x, y, w, h, lb, on, hov) local(xx, yy, ww, hh, rr) (
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC); rr = floor(h * 0.5 * G_SC);
  on ? (
    gfrr(xx, yy, xx + ww, yy + hh, rr, G_ACR, G_ACG, G_ACB, hov ? 1 : 0.9);
    gtext(x + w * 0.5, y + h * 0.5, lb, 3, 0.06, 0.12, 0.10, 1, 1);
  ) : (
    gfrr(xx, yy, xx + ww, yy + hh, rr, 0.10, 0.11, 0.12, hov ? 0.95 : 0.8);
    gbord(xx, yy, xx + ww, yy + hh, rr, max(1, floor(G_SC + 0.5)), 0.62, 0.66, 0.70, hov ? 0.7 : 0.4);
    gtext(x + w * 0.5, y + h * 0.5, lb, 3, 0.85, 0.88, 0.90, hov ? 1 : 0.8, 1);
  );
);

function gseg(x, y, w, h, n, sel, hov) local(sw, i, xx, yy, ww, hh, lb) (
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC);
  gfrr(xx, yy, xx + ww, yy + hh, floor(h * 0.5 * G_SC), 0.10, 0.11, 0.12, 0.85);
  gbord(xx, yy, xx + ww, yy + hh, floor(h * 0.5 * G_SC), max(1, floor(G_SC + 0.5)), 0.62, 0.66, 0.70, 0.4);
  sw = w / n;
  i = 0;
  loop(n,
    lb = i === 0 ? "OFF" : i === 1 ? "IN / OUT" : "CEIL / OUT";
    i === sel ? (
      xx = floor(gsx(x + i * sw + 3)); yy = floor(gsy(y + 3)); ww = ceil((sw - 6) * G_SC); hh = ceil((h - 6) * G_SC);
      gfrr(xx, yy, xx + ww, yy + hh, floor((h - 6) * 0.5 * G_SC), G_ACR, G_ACG, G_ACB, hov === i ? 1 : 0.9);
      gtext(x + i * sw + sw * 0.5, y + h * 0.5, lb, 3, 0.06, 0.12, 0.10, 1, 1);
    ) : (
      gtext(x + i * sw + sw * 0.5, y + h * 0.5, lb, 3, 0.85, 0.88, 0.90, hov === i ? 1 : 0.75, 1);
    );
    i += 1;
  );
);

function gbypass(x, y, r, on, hov) local(cx, cy, rr, u, ox, oy, w, cr, cg, cb, al) (
  cx = gsx(x); cy = gsy(y); rr = r * G_SC;
  cr = on ? G_ACR : 0.70; cg = on ? G_ACG : 0.70; cb = on ? G_ACB : 0.70;
  al = hov ? 1 : 0.8;
  gfx_set(G_BGR * 0.7, G_BGG * 0.7, G_BGB * 0.7, 1);
  gfx_circle(cx, cy, rr, 1, 1);
  gfx_set(cr, cg, cb, al * 0.4);
  gfx_circle(cx, cy, rr, 1, 1);
  gann(cx, cy, rr - max(1, G_SC), rr, -$pi, $pi, cr, cg, cb, al);
  u = 2 * rr / 200; ox = cx - rr; oy = cy - rr; w = max(1.5, 11 * u);
  gann(ox + 100 * u, oy + 103 * u, 55 * u - w * 0.5, 55 * u + w * 0.5, -$pi * 0.5, $pi * 0.5, cr, cg, cb, al);
  gann(ox + 100 * u, oy + 108 * u, 27 * u - w * 0.5, 27 * u + w * 0.5, -$pi, $pi, cr, cg, cb, al);
  gfx_set(cr, cg, cb, al);
  gbar(ox + 18 * u, oy + 103 * u, ox + 46 * u, oy + 103 * u, w);
