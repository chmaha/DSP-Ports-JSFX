UL4 = alloc(2 * MU4); UR4 = alloc(2 * MU4); DL4 = alloc(2 * MD4); DR4 = alloc(2 * MD4); QL4 = alloc(QN4); QR4 = alloc(QN4);
BL5 = alloc(32); BR5 = alloc(32);
TDL = alloc(64); TDR = alloc(64);
RN = 64;
RDL = alloc(RN); RDR = alloc(RN); RGL = alloc(RN); RGR = alloc(RN);
HN = 4096;
H_IN = alloc(HN); H_CL = alloc(HN); H_OUT = alloc(HN); H_EAT = alloc(HN);
LATS = alloc(6); mem_set_values(LATS, 0, 31, 38, 41, 43, 43);
TDS = alloc(6); mem_set_values(TDS, 0, 0, 0, 0, 14, 14);
STATE0 = UL0; STATE1 = TDR + 64;

