slider1:in_db=0<-36,36,0.1>-Input (dB)
slider2:out_db=0<-36,36,0.1>-Output (dB)
slider3:ceil_db=0<-36,0,0.1>-Ceiling (dB)
slider4:link=0<0,2,1{Off,Input / Output,Ceiling / Output}>-Link
slider5:bypass=0<0,1,1{Off,On}>-Bypass
slider6:algo=0<0,7,1{Hard,Quintic,Cubic,Tangent,Algebraic,Arctangent,Sine,Custom}>-Type
slider7:osr=0<0,5,1{Off,x2,x4,x8,x16,x32}>-Oversample
slider8:mix=100<0,100,0.1>-Dry/Wet (%)
slider9:soft=50<0,100,0.1>-Softness (%)
slider10:guard=1<0,1,1{Off,On}>-Ceiling Guard
slider11:delta=0<0,1,1{Off,On}>-Delta
slider12:emph=0<-12,12,0.1>-Emphasis (dB)
slider13:pivot=1000<100,5000,1:log>-Emphasis Pivot (Hz)
slider14:disp=0<0,2,1{0 dB,+3 dB,+6 dB}>-Display Top
slider15:zoom=0<0,3,1{1x,2x,4x,8x}>-Display Zoom
slider16:theme=0<0,4,1{Classic,Neon,Ember,Aurora,Mono}>-Theme

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output
options:no_meter

@init

ext_noinit = gfx_ext_retina = 1;

function alloc(n) local(r) instance(mp) global() ( r = mp; mp += n; memset(r, 0, n); r; );
alloc.mp = 0;

function sv_set(v, steps) instance(cur, tgt, cnt, stp) (
  v !== tgt ? (
    steps <= 0 ? ( cur = tgt = v; cnt = 0; ) : ( tgt = v; cnt = steps; stp = (tgt - cur) / cnt; );
  );
);
function sv_snap(v) instance(cur, tgt, cnt) ( cur = tgt = v; cnt = 0; );
function sv_next() instance(cur, tgt, cnt, stp) (
  cnt > 0 ? ( cnt -= 1; cnt > 0 ? cur += stp : cur = tgt; );
  cur;
);

