      );
    ) : (
      gp = GPRE.cur; gq = GPOST.cur;
      loop(n,
        x = a[i] * gp; a[i] = (1 - 2 / (exp(2 * x) + 1)) * gq;
        x = b[i] * gp; b[i] = (1 - 2 / (exp(2 * x) + 1)) * gq;
        i += 1;
      );
