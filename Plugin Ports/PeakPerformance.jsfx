  ) :
  algo_i === 5 ? (
    (GPRE.cnt > 0 || GPOST.cnt > 0) ? (
      loop(n,
        gp = GPRE.sv_next(); gq = GPOST.sv_next();
        x = a[i] * gp; a[i] = ((2 / $pi) * atan(1.6 * x)) * gq;
        x = b[i] * gp; b[i] = ((2 / $pi) * atan(1.6 * x)) * gq;
        i += 1;
      );
    ) : (
      gp = GPRE.cur; gq = GPOST.cur;
      loop(n,
        x = a[i] * gp; a[i] = ((2 / $pi) * atan(1.6 * x)) * gq;
        x = b[i] * gp; b[i] = ((2 / $pi) * atan(1.6 * x)) * gq;
        i += 1;
      );
    );
  ) :
  algo_i === 6 ? (
    (GPRE.cnt > 0 || GPOST.cnt > 0) ? (
      loop(n,
        gp = GPRE.sv_next(); gq = GPOST.sv_next();
        x = a[i] * gp; a[i] = (abs(x) < 0.5 * $pi ? sin(x) : sign(x)) * gq;
        x = b[i] * gp; b[i] = (abs(x) < 0.5 * $pi ? sin(x) : sign(x)) * gq;
        i += 1;
