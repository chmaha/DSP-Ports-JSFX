function shape(a, b, n) local(i, x, ax, gp, gq) (
  i = 0;
  algo_i === 0 ? (
    (GPRE.cnt > 0 || GPOST.cnt > 0) ? (
      loop(n,
        gp = GPRE.sv_next(); gq = GPOST.sv_next();
        x = a[i] * gp; a[i] = (x > 1 ? 1 : x < -1 ? -1 : x) * gq;
        x = b[i] * gp; b[i] = (x > 1 ? 1 : x < -1 ? -1 : x) * gq;
        i += 1;
      );
    ) : (
      gp = GPRE.cur; gq = GPOST.cur;
      loop(n,
        x = a[i] * gp; a[i] = (x > 1 ? 1 : x < -1 ? -1 : x) * gq;
        x = b[i] * gp; b[i] = (x > 1 ? 1 : x < -1 ? -1 : x) * gq;
        i += 1;
      );
    );
  ) :
  algo_i === 1 ? (
    (GPRE.cnt > 0 || GPOST.cnt > 0) ? (
      loop(n,
        gp = GPRE.sv_next(); gq = GPOST.sv_next();
        x = a[i] * gp; a[i] = (abs(x) < 1.25 ? x - 0.08192 * x * x * x * x * x : sign(x)) * gq;
        x = b[i] * gp; b[i] = (abs(x) < 1.25 ? x - 0.08192 * x * x * x * x * x : sign(x)) * gq;
        i += 1;
      );
    ) : (
      gp = GPRE.cur; gq = GPOST.cur;
      loop(n,
        x = a[i] * gp; a[i] = (abs(x) < 1.25 ? x - 0.08192 * x * x * x * x * x : sign(x)) * gq;
        x = b[i] * gp; b[i] = (abs(x) < 1.25 ? x - 0.08192 * x * x * x * x * x : sign(x)) * gq;
        i += 1;
      );
    );
  ) :
  algo_i === 2 ? (
    (GPRE.cnt > 0 || GPOST.cnt > 0) ? (
      loop(n,
        gp = GPRE.sv_next(); gq = GPOST.sv_next();
        x = a[i] * gp; a[i] = (abs(x) < 1.5 ? x - (4 / 27) * x * x * x : sign(x)) * gq;
        x = b[i] * gp; b[i] = (abs(x) < 1.5 ? x - (4 / 27) * x * x * x : sign(x)) * gq;
        i += 1;
      );
    ) : (
      gp = GPRE.cur; gq = GPOST.cur;
      loop(n,
        x = a[i] * gp; a[i] = (abs(x) < 1.5 ? x - (4 / 27) * x * x * x : sign(x)) * gq;
        x = b[i] * gp; b[i] = (abs(x) < 1.5 ? x - (4 / 27) * x * x * x : sign(x)) * gq;
        i += 1;
      );
    );
  ) :
  algo_i === 3 ? (
    (GPRE.cnt > 0 || GPOST.cnt > 0) ? (
      loop(n,
        gp = GPRE.sv_next(); gq = GPOST.sv_next();
        x = a[i] * gp; a[i] = (1 - 2 / (exp(2 * x) + 1)) * gq;
        x = b[i] * gp; b[i] = (1 - 2 / (exp(2 * x) + 1)) * gq;
