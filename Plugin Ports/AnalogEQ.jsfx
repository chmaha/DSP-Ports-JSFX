Version: 1.0
desc: Analog EQ (Luftikus port) by chmaha
author: chmaha
changelog:
  Initial release.
// Ported from Luftikus (lkjb). MIT.
// https://github.com/lkjbdsp/lkjb-plugins/tree/master/Luftikus
// Claude generated some of this code

slider1:0<-10,10,0.01>-10 Hz
slider2:0<-10,10,0.01>-40 Hz
slider3:0<-10,10,0.01>-160 Hz
slider4:0<-10,10,0.01>-640 Hz
slider5:0<-10,10,0.01>-2.5 kHz
slider6:0<0,10,0.01>-Air Gain (High Shelf)
slider7:0<0,5,1{Off,2.5kHz,5kHz,10kHz,20kHz,40kHz}>-Air Type
slider8:0<0,1,1{Off,On}>-Analog
slider9:0<0,1,1{Off,On}>-Mastering
slider10:0<0,1,1{Off,On}>-Keep Gain
slider11:0<-20,20,0.01>-Master Volume (dB)

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

options:no_meter

@init
gfx_ext_retina = 1;
