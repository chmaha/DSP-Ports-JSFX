function render_more() local(k, ix, v) (
  engine_block();
  k = 0;
  loop(24,
    v = EOB[k] * (1 / 32768);
    ix = eo_n & 8191;
    EOR[ix] = v;
    EOR[ix + 8192] = v;
    eo_n += 1;
    k += 1;
