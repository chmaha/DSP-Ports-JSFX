function note_on(nt, vel) local(i) (
  i = 0;
  while (i < n_held && NSTACK[i] !== nt) ( i += 1; );
  i < n_held ? ( memcpy(NSTACK + i, NSTACK + i + 1, n_held - i - 1); n_held -= 1; );
