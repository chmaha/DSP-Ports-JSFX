function host_block(n) local(i, mi, og, oc, ot, vo, mm, ep, cop, q, r, cnt, ut, m1, fast48, c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16, c17, c18, c19, c20, c21, c22, c23, c24, c25, c26, c27, c28, c29, c30, c31, c32) (
  fast48 = poly && rta === 1 && BUCN[0] === 33;
  fast48 ? ( c0 = BUCO[0]; c1 = BUCO[1]; c2 = BUCO[2]; c3 = BUCO[3]; c4 = BUCO[4]; c5 = BUCO[5]; c6 = BUCO[6]; c7 = BUCO[7]; c8 = BUCO[8]; c9 = BUCO[9]; c10 = BUCO[10]; c11 = BUCO[11]; c12 = BUCO[12]; c13 = BUCO[13]; c14 = BUCO[14]; c15 = BUCO[15]; c16 = BUCO[16]; c17 = BUCO[17]; c18 = BUCO[18]; c19 = BUCO[19]; c20 = BUCO[20]; c21 = BUCO[21]; c22 = BUCO[22]; c23 = BUCO[23]; c24 = BUCO[24]; c25 = BUCO[25]; c26 = BUCO[26]; c27 = BUCO[27]; c28 = BUCO[28]; c29 = BUCO[29]; c30 = BUCO[30]; c31 = BUCO[31]; c32 = BUCO[32]; );
  i = 0;
  mi = 0;
  og = out_g; oc = gn_c; ot = out_t;
  q = upq; r = upr;
  while (i < n) (
    while (mi < mq_n && MQ[mi * 4] <= i) ( midi_event(mi); mi += 1; );
    vo = 0;
