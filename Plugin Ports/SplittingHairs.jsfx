kern_build();

function gcd(a, b) local(t) ( while (b > 0) ( t = a % b; a = b; b = t; ); a; );

function host_setup() local(fl, gg, ri, st, en, j) (
  bypass = srate === SR_E;
  fl = min(srate, SR_E);
  up_scale = fl / SR_E;
  up_half = KW * SR_E / fl;
  up_step = SR_E / srate;
