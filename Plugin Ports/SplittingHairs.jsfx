// ---------------------------------------------------------------------- module glue

SR_E = 96000;
EOB = alloc(24);
SYNCIN = alloc(24);
MQ = alloc(1024);
NSTACK = alloc(128);
MBUF = alloc(4);
OUTH = alloc(16384);

function ar_block() local(inc, ph) (
  ar_gate !== ar_pg ? (
    ar_a = ar_v;
