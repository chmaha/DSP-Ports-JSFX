function note_off(nt) local(i) (
  i = 0;
  while (i < n_held && NSTACK[i] !== nt) ( i += 1; );
  i < n_held ? (
    memcpy(NSTACK + i, NSTACK + i + 1, n_held - i - 1);
    n_held -= 1;
    n_held > 0 ? n_note = NSTACK[n_held - 1] : n_gate = 0;
