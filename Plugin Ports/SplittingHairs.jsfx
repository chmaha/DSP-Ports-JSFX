n_note = 60; n_vel = 0; n_press = 0; n_wheel = 0; n_bend = 0; n_gate = 0; n_held = 0; n_trig = 0;
mq_n = mq_r = mq_w = 0;
out_g = 10 ^ (k_out / 20);
last_srate = 0;
ext_noinit = gfx_ext_retina = 1;

@slider

last_srate !== srate ? (
  last_srate = srate;
  tables_ok ? engine_reset();
  host_setup();
);

@block

mq_n = 0;
while ((mlen = midirecv_buf(mofs, MBUF, 3)) > 0) (
  mst = MBUF[0] & 240;
  (mlen === 3 && mq_n < 256 && (mst === 144 || mst === 128 || mst === 176 || mst === 224)) ? (
    MQ[mq_n * 4] = mofs;
    MQ[mq_n * 4 + 1] = mst;
    MQ[mq_n * 4 + 2] = MBUF[1];
