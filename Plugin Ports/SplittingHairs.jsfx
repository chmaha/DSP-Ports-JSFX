// ---------------------------------------------------------------------- host bridge (96 kHz engine to host rate, windowed sinc)

KT = alloc(4100);
BUCO = alloc(65536);
BUST = alloc(4096); BUCN = alloc(4096);
EOR = alloc(16384);

function bessel_i0(x) local(s, t, k) (
  s = 1; t = 1; k = 1;
  loop(30, t *= (x / (2 * k)) * (x / (2 * k)); s += t; k += 1; );
  s;
