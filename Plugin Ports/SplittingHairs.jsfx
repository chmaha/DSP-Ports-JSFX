);
function cell_text(s) ( cell_textv(s, slider(s)); );
function model_name(m) (
  m == 0 ? "CSAW" : m == 1 ? "Morph" : m == 2 ? "Saw / Square" : m == 3 ? "Fold" : m == 4 ? "Buzz" :
  m == 5 ? "Square Sub" : m == 6 ? "Saw Sub" : m == 7 ? "Square Sync" : m == 8 ? "Saw Sync" : m == 9 ? "Saw x3" :
  m == 10 ? "Square x3" : m == 11 ? "Triangle x3" : m == 12 ? "Sine x3" : m == 13 ? "Ring Mod" : m == 14 ? "Saw Swarm" :
