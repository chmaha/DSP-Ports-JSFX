  c_fine = floor(32768 + k_fine * 32767 + 0.5);
  c_meta = k_meta >= 0.5;
  c_res = k_bits | 0;
  c_rate = k_rate | 0;
  c_sign = k_sign | 0;
  c_flat = k_flat >= 0.5;
  c_drift = k_drift | 0;
  c_autotrig = k_tsrc >= 0.5;
  c_att = k_att | 0;
  c_dec = k_dec | 0;
  c_adfm = k_adfm | 0;
  c_adtim = k_adtim | 0;
  c_adcol = k_adcol | 0;
  c_vca = k_advca >= 0.5;
  c_range = k_range < 0.5 ? 0 : k_range < 1.5 ? 3 : 4;
  c_octave = k_octave | 0;
  c_qscale = k_qntz | 0;
  c_qroot = k_root | 0;
