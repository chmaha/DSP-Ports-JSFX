desc: Splitting Hairs Macro Oscillator (Mutable Instruments Braids port) by chmaha
tags: synth oscillator macro-oscillator wavetable fm physical-modelling drums instrument
author: chmaha
version: 1.0
changelog:
  Initial release.
about:
  A port of Mutable Instruments Braids, the macro oscillator: 47 synthesis models from the classic CSAW,
  morphing, folded, buzz, sub, synced and triple oscillators through ring modulation, supersaw swarm, comb,
  toy, direct filter synthesis, VOSIM, vowels and formants, additive harmonics and three kinds of FM, to
  plucked, bowed, blown and fluted physical models, bell, drum, kick, cymbal and snare, wavetables, wave map,
  wave line, paraphonic chords and five kinds of noise, plus QPSK.
  The module's fixed-point firmware runs bit for bit at its own 96 kHz rate, including its settings menu:
  META (the FM input picks the model), bit and sample-rate reduction, the AD envelope and its routings to
  FM, TIMBRE, COLOR and the VCA, auto-trigger, octave, pitch quantiser, VCO flattening, drift and signature.
  MIDI notes drive V/OCT and TRIG (with pitch bend); velocity feeds the TIMBRE CV through MODULATION,
  channel aftertouch the COLOR CV, and the mod wheel the FM input through the FM attenuverter.
  Play mode GATE sounds while notes are held (AD attack and decay shape the note); DRONE sounds all the time.
  Needs Dependencies/SplittingHairs/braids_tables.txt.
  Ported from Braids by Emilie Gillet (Mutable Instruments)
  https://github.com/pichenettes/eurorack (MIT)
  JSFX version released under GPLv3+ license
  Claude generated some of this code
provides:
  Dependencies/SplittingHairs/braids_tables.txt

slider1:k_model=0<0,46,1{CSAW,Morph,Saw / Square,Fold,Buzz,Square Sub,Saw Sub,Square Sync,Saw Sync,Saw x3,Square x3,Triangle x3,Sine x3,Ring Mod,Saw Swarm,Saw Comb,Toy,Filter LP,Filter Peak,Filter BP,Filter HP,VOSIM,Vowel,Vowel FOF,Harmonics,FM,Feedback FM,Chaotic FM,Plucked,Bowed,Blown,Fluted,Bell,Drum,Kick,Cymbal,Snare,Wavetables,Wave Map,Wave Line,Wave Chords,Filtered Noise,Twin Peaks Noise,Clocked Noise,Granular Cloud,Particle Noise,QPSK}>-Model
slider2:k_fine=0<-1,1,0.001>-Fine
slider3:k_coarse=0<-48,48,1>-Coarse
slider4:k_fm=0<-1,1,0.001>-FM
slider5:k_timbre=0.5<0,1,0.001>-Timbre
slider6:k_mod=0<-1,1,0.001>-Modulation
slider7:k_color=0.5<0,1,0.001>-Color
slider8:k_meta=0<0,1,1{Off,On}>-META
slider9:k_bits=6<0,6,1{2 bit,3 bit,4 bit,6 bit,8 bit,12 bit,16 bit}>-BITS
slider10:k_rate=6<0,6,1{4 kHz,8 kHz,16 kHz,24 kHz,32 kHz,48 kHz,96 kHz}>-RATE
slider11:k_sign=0<0,4,1{Off,1,2,3,Full}>-SIGN
slider12:k_flat=0<0,1,1{Off,On}>-FLAT
slider13:k_drift=0<0,4,1{Off,1,2,3,Full}>-DRFT
slider14:k_tsrc=0<0,1,1{External,Auto}>-TSRC
slider15:k_att=0<0,15,1>-AD Attack
slider16:k_dec=5<0,15,1>-AD Decay
slider17:k_adfm=0<0,15,1>-AD to FM
slider18:k_adtim=0<0,15,1>-AD to Timbre
slider19:k_adcol=0<0,15,1>-AD to Color
slider20:k_advca=0<0,1,1{Off,On}>-AD to VCA
slider21:k_play=0<0,1,1{Gate,Drone}>-Play
slider22:k_range=0<0,2,1{External,440,LFO}>-RANG
slider23:k_octave=2<0,4,1{-2,-1,0,+1,+2}>-OCTV
slider24:k_qntz=0<0,48,1>-QNTZ
slider25:k_root=0<0,11,1{C,Db,D,Eb,E,F,Gb,G,Ab,A,Bb,B}>-ROOT
slider26:k_bend=2<1,12,1>-Bend Range
slider27:k_out=0<-24,12,0.1>-Output (dB)

in_pin:none
out_pin:Left output
out_pin:Right output
options:no_meter

@init

function alloc(n) local(r) instance(mp) global() ( r = mp; mp += n; memset(r, 0, n); r; );
alloc.mp = 0;
// ---------------------------------------------------------------------- tables

NTAB = 48;
TTOT = 46678;
TRAW = alloc(TTOT + NTAB + 8);
TBL = alloc(TTOT);
tables_ok = 0;

function tables_load() local(h, n, q, p, len, k) (
  h = file_open("SplittingHairs/braids_tables.txt");
  h < 0 ? h = file_open("Dependencies/SplittingHairs/braids_tables.txt");
  h >= 0 ? (
    n = file_mem(h, TRAW, TTOT + NTAB + 8);
    file_close(h);
    (n === TTOT + NTAB + 1 && TRAW[0] === NTAB) ? (
      q = 1;
      p = 0;
      k = 0;
      loop(NTAB,
        len = TRAW[q];
        memcpy(TBL + p, TRAW + q + 1, len);
        p += len;
        q += len + 1;
        k += 1;
      );
      tables_ok = p === TTOT;
    );
  );
);
tables_load();
T_RESCOEF = TBL + 0;
T_RESSCALE = TBL + 129;
T_SVFCUT = TBL + 258;
T_SVFDAMP = TBL + 515;
T_SVFSCALE = TBL + 772;
T_GRANENV = TBL + 1029;
T_GRANRATE = TBL + 1542;
T_BOWENV = TBL + 1799;
T_BOWFRIC = TBL + 2551;
T_BLOWENV = TBL + 2808;
T_FLUTE = TBL + 3200;
T_FMQ = TBL + 3328;
T_VCODET = TBL + 3457;
T_BELL = TBL + 3714;
T_ENVEXPO = TBL + 3971;
T_BLOWJET = TBL + 4228;
T_INC = TBL + 4485;
T_DEL = TBL + 4582;
T_ENVPORT = TBL + 4679;
T_FSINE = TBL + 4807;
T_FSQUARE = TBL + 5063;
T_SINE = TBL + 5319;
T_COMB = TBL + 5576;
T_MODOD = TBL + 9431;
T_VIOLOD = TBL + 9688;
T_SINEFOLD = TBL + 9945;
T_TRIFOLD = TBL + 10202;
T_WAVES = TBL + 10459;
T_WTMAP = TBL + 43483;
T_WTCODE = TBL + 43739;
T_VOWELS = TBL + 44803;
T_CONS = TBL + 44857;
T_FMTF = TBL + 44905;
T_FMTA = TBL + 45030;
T_BELLP = TBL + 45155;
T_BELLAMP = TBL + 45166;
T_BELLLONG = TBL + 45177;
T_BELLSHORT = TBL + 45188;
T_DRUMP = TBL + 45199;
T_DRUMAMP = TBL + 45205;
T_DRUMLONG = TBL + 45211;
T_DRUMSHORT = TBL + 45217;
T_WTDEFS = TBL + 45223;
T_WLINE = TBL + 45583;
T_MINI = TBL + 45647;
T_INTERVALS = TBL + 45680;
T_CHORDS = TBL + 45745;
T_SCALES = TBL + 45796;
tables_ok ? tables_ok = T_SINE[0] === -32512 && T_INC[96] > 0 && T_WAVES[0] >= 0;

T_FIR4 = alloc(4); T_FIR4[0] = 10530; T_FIR4[1] = 14751; T_FIR4[2] = 16384; T_FIR4[3] = 14751;
T_PHRESET = alloc(4); T_PHRESET[0] = 0; T_PHRESET[1] = 2147483648; T_PHRESET[2] = 1073741824; T_PHRESET[3] = 2147483648;
T_CQ = alloc(4); T_CQ[0] = 23100; T_CQ[1] = -23100; T_CQ[2] = -23100; T_CQ[3] = 23100;
T_CI = alloc(4); T_CI[0] = 23100; T_CI[1] = 23100; T_CI[2] = -23100; T_CI[3] = -23100;
T_DECIM = alloc(7); T_DECIM[0] = 24; T_DECIM[1] = 12; T_DECIM[2] = 6; T_DECIM[3] = 4; T_DECIM[4] = 3; T_DECIM[5] = 2; T_DECIM[6] = 1;
T_BITMASK = alloc(7); T_BITMASK[0] = 49152; T_BITMASK[1] = 57344; T_BITMASK[2] = 61440; T_BITMASK[3] = 63488; T_BITMASK[4] = 65280; T_BITMASK[5] = 65520; T_BITMASK[6] = 65535;
T_FLUTEX = alloc(141); memcpy(T_FLUTEX, T_FLUTE, 128); memcpy(T_FLUTEX + 128, T_BLOWENV, 13); T_FLUTE = T_FLUTEX;
T_WLINEX = alloc(65); memcpy(T_WLINEX, T_WLINE, 64); T_WLINEX[64] = T_WTDEFS[0]; T_WLINE = T_WLINEX;
TMPB = alloc(24); SYNCB = alloc(24); QCB = alloc(128); WSTR = alloc(257);
SIGSEED = 711671185;
// ---------------------------------------------------------------------- integer helpers

function s16(x) ( ((x + 32768) & 65535) - 32768; );
function s8(x) ( ((x + 128) & 255) - 128; );
function w32(x) ( ((x + 2147483648) & 4294967295) - 2147483648; );
function cl16(x) ( x < -32767 ? -32767 : x > 32767 ? 32767 : x; );
function idiv(n, d) ( n < 0 ? -floor(-n / d) : floor(n / d); );

function mix(a, b, bal) ( floor((a * (65535 - bal) + b * bal) / 65536); );
function i824(t, ph) local(i, a) (
  i = ph >> 24;
  a = t[i];
  a + floor((t[i + 1] - a) * ((ph >> 8) & 65535) / 65536);
);
function i88(t, ix) local(i, a) (
  i = ix >> 8;
  a = t[i];
  a + floor((t[i + 1] - a) * (ix & 255) / 256);
);
function i824b(t, ph) local(i, a) (
  i = ph >> 24;
  a = t[i];
  s16(a * 256 + floor(w32((t[i + 1] - a) * (ph & 16777215)) / 65536) - 32768);
);
function xf8(ta, tb, ph, bal) local(a, b) (
  a = i824b(ta, ph);
  b = i824b(tb, ph);
  s16(a + floor(w32((b - a) * bal) / 65536));
);
function xf16(ta, tb, ph, bal) local(a, b) (
  a = i824(ta, ph);
  b = i824(tb, ph);
  s16(a + floor(w32((b - a) * bal) / 65536));
);
function i1022(t, ph) local(i, a) (
  i = ph >> 22;
  a = t[i];
  s16(a + floor(w32((t[i + 1] - a) * ((ph >> 6) & 65535)) / 65536));
);

function rand_word() (
  rng = (rng * 1664525 + 1013904223) & 4294967295;
);
function rand_sample() (
  rand_word();
  s16(rng >> 16);
);

function cpi(mp) local(rp, ns, a, b) (
  mp >= 16384 ? mp = 16383;
  rp = mp - 16384;
  ns = 0;
  while (rp < 0) ( rp += 1536; ns += 1; );
  a = T_INC[rp >> 4];
  b = T_INC[(rp >> 4) + 1];
  ns >= 32 ? 0 : ((a + floor(w32(b - a) * (rp & 15) / 16)) & 4294967295) >> ns;
);

function cdelay(mp) local(rp, ns, a, b, d, sh) (
  mp >= 16384 ? mp = 16384;
  rp = mp - 16384;
  ns = 0;
  while (rp < 0) ( rp += 1536; ns += 1; );
  a = T_DEL[rp >> 4];
  b = T_DEL[(rp >> 4) + 1];
  d = (a + floor(w32(b - a) * (rp & 15) / 16)) & 4294967295;
  sh = 12 - ns;
  sh < 0 ? 0 : d >> sh;
);

function tbs(t) ( t > 65535 ? t = 65535; (t * t) >> 18; );
function nbs(t) ( t > 65535 ? t = 65535; t = 65535 - t; -((t * t) >> 18); );
function udiv(a, b) ( b > 0 ? floor(a / b) : 0; );

// ---------------------------------------------------------------------- analog oscillator

function ao_init() instance(phase, pinc, high, par, ppar, aux, ddepth, pitch, nsamp) (
  phase = 0; pinc = 1; high = 0; par = ppar = 0; aux = 0; ddepth = -16383; pitch = 7680; nsamp = 0;
);

function ao_csaw(sin, buf, sout, size) instance(phase, pinc, ppinc, high, par, aux, ddepth, nsamp)
  local(pi, pii, nx, th, sr, slr, tdr, rt, par_at, pw, bef, aft, disc, t, go, cont) (
  pi = ppinc;
  pii = ppinc < pinc ? floor((pinc - ppinc) / size) : 4294967295 - floor((ppinc - pinc) / size);
  nx = nsamp;
  loop(size,
    sr = 0; slr = 0; tdr = 0; rt = 0;
    pi = (pi + pii) & 4294967295;
    pw = (par * 49152) & 4294967295;
    pw < ((8 * pi) & 4294967295) ? pw = (8 * pi) & 4294967295;
    th = nx;
    nx = 0;
    sin[0] ? (
      rt = (sin[0] - 1) * 512;
      par_at = (phase + (65535 - rt) * (pi >> 16)) & 4294967295;
      sr = 1;
      tdr = 0;
      (par_at < phase || (!high && par_at >= pw)) ? tdr = 1;
      phase >= pw ? (
        ddepth = -2048 + floor(aux / 4);
        bef = par_at >> 18;
        aft = ddepth;
        disc = aft - bef;
        th += floor(disc * tbs(rt) / 32768);
        nx += floor(disc * nbs(rt) / 32768);
      );
    );
    sin += 1;
    phase = (phase + pi) & 4294967295;
    phase < pi ? slr = 1;
    sout >= 0 ? (
      sout[0] = phase < pi ? (udiv(phase, pi >> 7) + 1) & 255 : 0;
      sout += 1;
    );
    go = tdr || !sr;
    while (go) (
      go = 0;
      cont = 1;
      !high ? (
        phase < pw ? cont = 0 : (
          t = udiv(phase - pw, pi >> 16);
          bef = ddepth;
          aft = phase >> 18;
          disc = s16(aft - bef);
          th += floor(disc * tbs(t) / 32768);
          nx += floor(disc * nbs(t) / 32768);
          high = 1;
        );
      );
      cont ? (
        slr ? (
          slr = 0;
          ddepth = -2048 + floor(aux / 4);
          t = udiv(phase, pi >> 16);
          disc = s16(ddepth - 16383);
          th += floor(disc * tbs(t) / 32768);
          nx += floor(disc * nbs(t) / 32768);
          high = 0;
          go = 1;
        );
      );
    );
    sr ? (
      phase = (rt * (pi >> 16)) & 4294967295;
      high = 0;
    );
    nx += phase < pw ? ddepth : phase >> 18;
    buf[0] = s16((th - 8192) * 2);
    buf += 1;
  );
  nsamp = nx;
  ppinc = pi;
);

function ao_square(sin, buf, sout, size) instance(phase, pinc, ppinc, high, par, nsamp)
  local(pi, pii, nx, th, sr, slr, tdr, rt, par_at, pw, t, go, cont) (
  pi = ppinc;
  pii = ppinc < pinc ? floor((pinc - ppinc) / size) : 4294967295 - floor((ppinc - pinc) / size);
  par > 32000 ? par = 32000;
  nx = nsamp;
  loop(size,
    sr = 0; slr = 0; tdr = 0; rt = 0;
    pi = (pi + pii) & 4294967295;
    pw = ((32768 - par) * 65536) & 4294967295;
    th = nx;
    nx = 0;
    sin[0] ? (
      rt = (sin[0] - 1) * 512;
      par_at = (phase + (65535 - rt) * (pi >> 16)) & 4294967295;
      sr = 1;
      (par_at < phase || (!high && par_at >= pw)) ? tdr = 1;
      par_at >= pw ? (
        th -= tbs(rt);
        nx -= nbs(rt);
      );
    );
    sin += 1;
    phase = (phase + pi) & 4294967295;
    phase < pi ? slr = 1;
    sout >= 0 ? (
      sout[0] = phase < pi ? (udiv(phase, pi >> 7) + 1) & 255 : 0;
      sout += 1;
    );
    go = tdr || !sr;
    while (go) (
      go = 0;
      cont = 1;
      !high ? (
        phase < pw ? cont = 0 : (
          t = udiv(phase - pw, pi >> 16);
          th += tbs(t);
          nx += nbs(t);
          high = 1;
        );
      );
      cont ? (
        slr ? (
          slr = 0;
          t = udiv(phase, pi >> 16);
          th -= tbs(t);
          nx -= nbs(t);
          high = 0;
          go = 1;
        );
      );
    );
    sr ? (
      phase = (rt * (pi >> 16)) & 4294967295;
      high = 0;
    );
    nx += phase < pw ? 0 : 32767;
    buf[0] = s16((th - 16384) * 2);
    buf += 1;
  );
  nsamp = nx;
  ppinc = pi;
);

function ao_saw(sin, buf, sout, size) instance(phase, pinc, ppinc, high, nsamp)
  local(pi, pii, nx, th, sr, slr, tdr, rt, par_at, disc, t) (
  pi = ppinc;
  pii = ppinc < pinc ? floor((pinc - ppinc) / size) : 4294967295 - floor((ppinc - pinc) / size);
  nx = nsamp;
  loop(size,
    sr = 0; slr = 0; tdr = 0; rt = 0;
    pi = (pi + pii) & 4294967295;
    th = nx;
    nx = 0;
    sin[0] ? (
      rt = (sin[0] - 1) * 512;
      par_at = (phase + (65535 - rt) * (pi >> 16)) & 4294967295;
      sr = 1;
      par_at < phase ? tdr = 1;
      disc = par_at >> 17;
      th -= floor(disc * tbs(rt) / 32768);
      nx -= floor(disc * nbs(rt) / 32768);
    );
    sin += 1;
    phase = (phase + pi) & 4294967295;
    phase < pi ? slr = 1;
    sout >= 0 ? (
      sout[0] = phase < pi ? (udiv(phase, pi >> 7) + 1) & 255 : 0;
      sout += 1;
    );
    ((tdr || !sr) && slr) ? (
      t = udiv(phase, pi >> 16);
      th -= tbs(t);
      nx -= nbs(t);
    );
    sr ? (
      phase = (rt * (pi >> 16)) & 4294967295;
      high = 0;
    );
    nx += phase >> 17;
    buf[0] = s16((th - 16384) * 2);
    buf += 1;
  );
  nsamp = nx;
  ppinc = pi;
);

function ao_vsaw(sin, buf, sout, size) instance(phase, pinc, ppinc, high, par, nsamp)
  local(pi, pii, nx, th, sr, slr, tdr, rt, par_at, pw, bef, aft, disc, t, go, cont) (
  pi = ppinc;
  pii = ppinc < pinc ? floor((pinc - ppinc) / size) : 4294967295 - floor((ppinc - pinc) / size);
  nx = nsamp;
  par < 1024 ? par = 1024;
  loop(size,
    sr = 0; slr = 0; tdr = 0; rt = 0;
    pi = (pi + pii) & 4294967295;
    pw = (par * 65536) & 4294967295;
    th = nx;
    nx = 0;
    sin[0] ? (
      rt = (sin[0] - 1) * 512;
      par_at = (phase + (65535 - rt) * (pi >> 16)) & 4294967295;
      sr = 1;
      (par_at < phase || (!high && par_at >= pw)) ? tdr = 1;
      bef = (par_at >> 18) + (((par_at - pw) & 4294967295) >> 18);
      aft = ((0 - pw) & 4294967295) >> 18;
      disc = aft - bef;
      th += floor(disc * tbs(rt) / 32768);
      nx += floor(disc * nbs(rt) / 32768);
    );
    sin += 1;
    phase = (phase + pi) & 4294967295;
    phase < pi ? slr = 1;
    sout >= 0 ? (
      sout[0] = phase < pi ? (udiv(phase, pi >> 7) + 1) & 255 : 0;
      sout += 1;
    );
    go = tdr || !sr;
    while (go) (
      go = 0;
      cont = 1;
      !high ? (
        phase < pw ? cont = 0 : (
          t = udiv(phase - pw, pi >> 16);
          th -= tbs(t) >> 1;
          nx -= floor(nbs(t) / 2);
          high = 1;
        );
      );
      cont ? (
        slr ? (
          slr = 0;
          t = udiv(phase, pi >> 16);
          th -= tbs(t) >> 1;
          nx -= floor(nbs(t) / 2);
          high = 0;
          go = 1;
        );
      );
    );
    sr ? (
      phase = (rt * (pi >> 16)) & 4294967295;
      high = 0;
    );
    nx += phase >> 18;
    nx += ((phase - pw) & 4294967295) >> 18;
    buf[0] = s16((th - 16384) * 2);
    buf += 1;
  );
  nsamp = nx;
  ppinc = pi;
);

function ao_tri(sin, buf, sout, size) instance(phase, pinc, ppinc)
  local(pi, pii, ph, p16, tr, h) (
  pi = ppinc;
  pii = ppinc < pinc ? floor((pinc - ppinc) / size) : 4294967295 - floor((ppinc - pinc) / size);
  ph = phase;
  loop(size,
    pi = (pi + pii) & 4294967295;
    sin[0] ? ph = 0;
    sin += 1;
    ph = (ph + (pi >> 1)) & 4294967295;
    p16 = ph >> 16;
    tr = s16(((p16 * 2) ~ (p16 & 32768 ? 65535 : 0)) + 32768);
    h = floor(tr / 2);
    ph = (ph + (pi >> 1)) & 4294967295;
    p16 = ph >> 16;
    tr = s16(((p16 * 2) ~ (p16 & 32768 ? 65535 : 0)) + 32768);
    buf[0] = s16(h + floor(tr / 2));
    buf += 1;
  );
  phase = ph;
  ppinc = pi;
);

function ao_sine(sin, buf, sout, size) instance(phase, pinc, ppinc)
  local(pi, pii, ph) (
  ph = phase;
  pi = ppinc;
  pii = ppinc < pinc ? floor((pinc - ppinc) / size) : 4294967295 - floor((ppinc - pinc) / size);
  loop(size,
    pi = (pi + pii) & 4294967295;
    ph = (ph + pi) & 4294967295;
    sin[0] ? ph = 0;
    sin += 1;
    buf[0] = i824(T_SINE, ph);
    buf += 1;
  );
  ppinc = pi;
  phase = ph;
);

function ao_trifold(sin, buf, sout, size) instance(phase, pinc, ppinc, par, ppar)
  local(pi, pii, ph, ps, pd, pinc_, pxf, p, gain, p16, tr, h) (
  ph = phase;
  pi = ppinc;
  pii = ppinc < pinc ? floor((pinc - ppinc) / size) : 4294967295 - floor((ppinc - pinc) / size);
  ps = ppar; pd = par - ppar; pinc_ = floor(32767 / size); pxf = 0;
  loop(size,
    pxf += pinc_;
    p = ps + floor(pd * pxf / 32768);
    pi = (pi + pii) & 4294967295;
    gain = s16(2048 + floor(p * 30720 / 32768));
    sin[0] ? ph = 0;
    sin += 1;
    ph = (ph + (pi >> 1)) & 4294967295;
    p16 = ph >> 16;
    tr = s16(((p16 * 2) ~ (p16 & 32768 ? 65535 : 0)) + 32768);
    tr = s16(floor(tr * gain / 32768));
    tr = i88(T_TRIFOLD, (tr + 32768) & 65535);
    h = floor(tr / 2);
    ph = (ph + (pi >> 1)) & 4294967295;
    p16 = ph >> 16;
    tr = s16(((p16 * 2) ~ (p16 & 32768 ? 65535 : 0)) + 32768);
    tr = s16(floor(tr * gain / 32768));
    tr = i88(T_TRIFOLD, (tr + 32768) & 65535);
    buf[0] = s16(h + floor(tr / 2));
    buf += 1;
  );
  ppar = par;
  ppinc = pi;
  phase = ph;
);

function ao_sinefold(sin, buf, sout, size) instance(phase, pinc, ppinc, par, ppar)
  local(pi, pii, ph, ps, pd, pinc_, pxf, p, gain, sn, h) (
  ph = phase;
  pi = ppinc;
  pii = ppinc < pinc ? floor((pinc - ppinc) / size) : 4294967295 - floor((ppinc - pinc) / size);
  ps = ppar; pd = par - ppar; pinc_ = floor(32767 / size); pxf = 0;
  loop(size,
    pxf += pinc_;
    p = ps + floor(pd * pxf / 32768);
    pi = (pi + pii) & 4294967295;
    gain = s16(2048 + floor(p * 30720 / 32768));
    sin[0] ? ph = 0;
    sin += 1;
    ph = (ph + (pi >> 1)) & 4294967295;
    sn = i824(T_SINE, ph);
    sn = s16(floor(sn * gain / 32768));
    sn = i88(T_SINEFOLD, (sn + 32768) & 65535);
    h = floor(sn / 2);
    ph = (ph + (pi >> 1)) & 4294967295;
    sn = i824(T_SINE, ph);
    sn = s16(floor(sn * gain / 32768));
    sn = i88(T_SINEFOLD, (sn + 32768) & 65535);
    buf[0] = s16(h + floor(sn / 2));
    buf += 1;
  );
  ppar = par;
  ppinc = pi;
  phase = ph;
);

function ao_buzz(sin, buf, sout, size) instance(phase, pinc, par, pitch)
  local(sp, xf, ix, w1, w2) (
  sp = pitch + floor((32767 - par) / 2);
  xf = (sp * 64) & 65535;
  ix = sp >> 10;
  ix >= 15 ? ix = 14;
  w1 = T_COMB + ix * 257;
  ix += 1;
  ix >= 15 ? ix = 14;
  w2 = T_COMB + ix * 257;
  loop(size,
    phase = (phase + pinc) & 4294967295;
    sin[0] ? phase = 0;
    sin += 1;
    buf[0] = xf16(w1, w2, phase, xf);
    buf += 1;
  );
);

function ao_render(sin, buf, sout, size) instance(shape, pshape, pinc, pitch) (
  shape !== pshape ? (
    this.ao_init();
    pshape = shape;
  );
  pinc = cpi(pitch);
  pitch > 16384 ? pitch = 16384 : pitch < 0 ? pitch = 0;
  shape === 0 ? this.ao_saw(sin, buf, sout, size) :
  shape === 1 ? this.ao_vsaw(sin, buf, sout, size) :
  shape === 2 ? this.ao_csaw(sin, buf, sout, size) :
  shape === 3 ? this.ao_square(sin, buf, sout, size) :
  shape === 4 ? this.ao_tri(sin, buf, sout, size) :
  shape === 5 ? this.ao_sine(sin, buf, sout, size) :
  shape === 6 ? this.ao_trifold(sin, buf, sout, size) :
  shape === 7 ? this.ao_sinefold(sin, buf, sout, size) :
  this.ao_buzz(sin, buf, sout, size);
);

// ---------------------------------------------------------------------- excitation and svf (drum models)

function ex_init() instance(delay, decay, counter, state, level) ( delay = 0; decay = 4093; counter = 0; state = 0; );
function ex_trigger(lv) instance(delay, counter, level) ( level = lv; counter = delay + 1; );
function ex_process() instance(decay, counter, state, level) (
  state = floor(state * decay / 4096);
  counter > 0 ? (
    counter -= 1;
    counter === 0 ? state += abs(level);
  );
  level < 0 ? -state : state;
);

function sv_init() instance(lp, bp, freq, res, dirty, punch, mode) (
  lp = 0; bp = 0; freq = 4224; res = 16384; dirty = 1; punch = 0; mode = 1;
);
function sv_freq(fr) instance(freq, dirty) ( dirty = dirty || freq !== fr; freq = fr; );
function sv_res(r) instance(res, dirty) ( res = r; dirty = 1; );
function sv_punch(p) instance(punch) ( punch = (p * p) >> 24; );
function sv_process(in) instance(lp, bp, freq, res, dirty, punch, mode, f_, damp_) local(f, damp, ps, notch, hp) (
  dirty ? (
    f_ = i824(T_SVFCUT, (freq * 131072) & 4294967295);
    damp_ = i824(T_SVFDAMP, (res * 131072) & 4294967295);
    dirty = 0;
  );
  f = f_;
  damp = damp_;
  punch ? (
    ps = lp > 4096 ? lp : 2048;
    f += floor(floor(ps / 16) * punch / 512);
    damp += floor((ps - 2048) / 8);
  );
  notch = in - floor(w32(bp * damp) / 32768);
  lp += floor(w32(f * bp) / 32768);
  lp = cl16(lp);
  hp = notch - lp;
  bp += floor(w32(f * hp) / 32768);
  bp = cl16(bp);
  mode === 1 ? bp : mode === 2 ? hp : lp;
);

// ---------------------------------------------------------------------- digital oscillator

DS = alloc(64);
DSN = 64;
SW_PH = alloc(8);
HR_AMP = alloc(12); HR_TGT = alloc(12);
AD_PH = alloc(11); AD_PI = alloc(11); AD_AMP = alloc(11); AD_TGT = alloc(11); AD_PART = alloc(6);
PK_SIZE = alloc(4); PK_WP = alloc(4); PK_SHIFT = alloc(4); PK_MASK = alloc(4); PK_INIT = alloc(4);
PK_PH = alloc(4); PK_PI = alloc(4); PK_MAXPI = alloc(4);
GR_PH = alloc(4); GR_PI = alloc(4); GR_EP = alloc(4); GR_EI = alloc(4);
FOF_LP = alloc(5); FOF_BP = alloc(5); FOF_F = alloc(5); FOF_A = alloc(5);
HT_PH = alloc(6);
SW_INC = alloc(8);
VW_FI = alloc(3); VW_FP = alloc(3); VW_FA = alloc(3);
PN_Y1 = alloc(3); PN_Y2 = alloc(3); PN_S = alloc(3); PN_C = alloc(3);
DL16 = alloc(8192);
DLB8 = alloc(1024); DLN8 = alloc(4096);
DLJ8 = alloc(1024); DLF8 = alloc(4096);
dl_view = 0;

function dl_to16(lo8, n8) local(k, lo, hi) (
  k = 0;
  loop(n8 / 2,
    lo = lo8[2 * k] & 255;
    hi = lo8[2 * k + 1] & 255;
    DL16[k] = s16(lo + hi * 256);
    k += 1;
  );
);
function dl_to16_n() local(k, lo, hi) (
  k = 0;
  loop(2048,
    lo = DLN8[2 * k] & 255;
    hi = DLN8[2 * k + 1] & 255;
    DL16[512 + k] = s16(lo + hi * 256);
    k += 1;
  );
);
function dl_to16_f() local(k, lo, hi) (
  k = 0;
  loop(2048,
    lo = DLF8[2 * k] & 255;
    hi = DLF8[2 * k + 1] & 255;
    DL16[512 + k] = s16(lo + hi * 256);
    k += 1;
  );
);

function dl_use16() (
  dl_view === 1 ? ( dl_to16(DLB8, 1024); dl_to16_n(); ) :
  dl_view === 2 ? ( dl_to16(DLJ8, 1024); dl_to16_f(); );
  dl_view = 0;
);
function d_state_clear() (
  memset(DS, 0, DSN);
  memset(SW_PH, 0, 8); memset(HR_AMP, 0, 12);
  memset(AD_PH, 0, 11); memset(AD_PI, 0, 11); memset(AD_AMP, 0, 11); memset(AD_TGT, 0, 11);
  memset(PK_SIZE, 0, 4); memset(PK_WP, 0, 4); memset(PK_SHIFT, 0, 4); memset(PK_MASK, 0, 4); memset(PK_INIT, 0, 4);
  memset(PK_PH, 0, 4); memset(PK_PI, 0, 4); memset(PK_MAXPI, 0, 4);
  memset(GR_PH, 0, 4); memset(GR_PI, 0, 4); memset(GR_EP, 0, 4); memset(GR_EI, 0, 4);
  memset(FOF_LP, 0, 5); memset(FOF_BP, 0, 5);
  memset(HT_PH, 0, 6);
  memset(VW_FI, 0, 3); memset(VW_FP, 0, 3); memset(VW_FA, 0, 3);
  memset(PN_Y1, 0, 3); memset(PN_Y2, 0, 3); memset(PN_S, 0, 3); memset(PN_C, 0, 3);
);

function d_init() (
  d_state_clear();
  pl0.ex_init(); pl1.ex_init(); pl2.ex_init(); pl3.ex_init();
  sf0.sv_init(); sf1.sv_init(); sf2.sv_init();
  d_phase = 0;
  d_strike = 1;
  d_init_ = 1;
);

function d_set_pitch(p) (
  (d_pitch > 11520 && p > 11520) ? d_pitch = floor((d_pitch + p) / 2) : d_pitch = p;
);

function d_ringmod(sync, buf, size) local(ph, inc, mp, mp2, mpi, mpi2, r) (
  ph = (d_phase + 1073741824) & 4294967295;
  inc = d_pinc;
  mp = VW_FP[0];
  mp2 = VW_FP[1];
  mpi = cpi(d_pitch + floor((d_par0 - 16384) / 4));
  mpi2 = cpi(d_pitch + floor((d_par1 - 16384) / 4));
  loop(size,
    ph = (ph + inc) & 4294967295;
    sync[0] ? ( ph = 0; mp = 0; mp2 = 0; );
    sync += 1;
    mp = (mp + mpi) & 4294967295;
    mp2 = (mp2 + mpi2) & 4294967295;
    r = i824(T_SINE, ph);
    r = s16(floor(r * i824(T_SINE, mp) / 65536));
    r = s16(floor(r * i824(T_SINE, mp2) / 65536));
    buf[0] = i88(T_MODOD, (r + 32768) & 65535);
    buf += 1;
  );
  d_phase = (ph - 1073741824) & 4294967295;
  VW_FP[0] = mp;
  VW_FP[1] = mp2;
);

function d_swarm(sync, buf, size) local(det, i, sd, di, dfr, ia, ib, hp, f, damp, bp, lp, notch, hpo, smp, ph, p0, p1, p2, p3, p4, p5, q0, q1, q2, q3, q4, q5, q6) (
  det = d_par0 + 1024;
  det = (det * det) >> 9;
  i = 0;
  loop(7,
    sd = det * (i - 3);
    di = floor(sd / 65536);
    dfr = sd & 65535;
    ia = cpi(d_pitch + di);
    ib = cpi(d_pitch + di + 1);
    SW_INC[i] = (ia + floor(w32((ib - ia) * dfr) / 65536)) & 4294967295;
    i += 1;
  );
  d_strike ? (
    i = 0;
    loop(6, SW_PH[i] = rand_word(); i += 1;);
    d_strike = 0;
  );
  hp = d_pitch;
  d_par1 < 10922 ? hp += floor((d_par1 - 10922) * 24 / 32) : hp += floor((d_par1 - 10922) * 12 / 32);
  hp < 0 ? hp = 0 : hp > 32767 ? hp = 32767;
  f = i824(T_SVFCUT, (hp * 131072) & 4294967295);
  damp = T_SVFDAMP[0];
  bp = DS[0];
  lp = DS[1];
  p0 = SW_PH[0]; p1 = SW_PH[1]; p2 = SW_PH[2]; p3 = SW_PH[3]; p4 = SW_PH[4]; p5 = SW_PH[5];
  q0 = SW_INC[0]; q1 = SW_INC[1]; q2 = SW_INC[2]; q3 = SW_INC[3]; q4 = SW_INC[4]; q5 = SW_INC[5]; q6 = SW_INC[6];
  ph = d_phase;
  loop(size,
    sync[0] ? ( p0 = 0; p1 = 0; p2 = 0; p3 = 0; p4 = 0; p5 = 0; );
    sync += 1;
    ph = (ph + q0) & 4294967295;
    p0 = (p0 + q1) & 4294967295;
    p1 = (p1 + q2) & 4294967295;
    p2 = (p2 + q3) & 4294967295;
    p3 = (p3 + q4) & 4294967295;
    p4 = (p4 + q5) & 4294967295;
    p5 = (p5 + q6) & 4294967295;
    smp = -28672 + (ph >> 19) + (p0 >> 19) + (p1 >> 19) + (p2 >> 19) + (p3 >> 19) + (p4 >> 19) + (p5 >> 19);
    smp = i88(T_MODOD, (smp + 32768) & 65535);
    notch = smp - floor(w32(bp * damp) / 32768);
    lp += floor(w32(f * bp) / 32768);
    lp = cl16(lp);
    hpo = notch - lp;
    bp = w32(bp + floor(w32(f * hpo) / 32768));
    buf[0] = cl16(hpo);
    buf += 1;
  );
  d_phase = ph;
  SW_PH[0] = p0; SW_PH[1] = p1; SW_PH[2] = p2; SW_PH[3] = p3; SW_PH[4] = p4; SW_PH[5] = p5;
  DS[0] = bp;
  DS[1] = lp;
);

function d_comb(sync, buf, size) local(pitch, fp, dl, delay, di, dfr, res, dp, in, off, a, b, dsm, fb, out) (
  pitch = d_pitch + floor((d_par0 - 16384) / 2);
  fp = DS[0];
  fp = floor((15 * fp + pitch) / 16);
  DS[0] = s16(fp);
  delay = cdelay(s16(fp));
  delay > 536870912 ? delay = 536870912;
  di = delay >> 16;
  dfr = delay & 65535;
  res = s16(d_par1 * 2 - 32768);
  res = i88(T_MODOD, (res + 32768) & 65535);
  dp = d_phase & 8191;
  loop(size,
    in = buf[0];
    off = dp + 16384 - di;
    a = DL16[off & 8191];
    b = DL16[(off - 1) & 8191];
    dsm = a + floor((b - a) * (dfr >> 1) / 32768);
    fb = floor(dsm * res / 32768) + floor(in / 2);
    DL16[dp] = cl16(fb);
    out = floor((in + dsm * 2) / 2);
    buf[0] = cl16(out);
    buf += 1;
    dp = (dp + 1) & 8191;
  );
  d_phase = dp;
);

function d_toy(sync, buf, size) local(pi, ph, dc, dcount, held, fs, tap, x) (
  d_pinc = d_pinc >> 2;
  pi = d_pinc;
  ph = d_phase;
  dc = DS[1];
  dcount = (512 - (d_par0 >> 6)) & 65535;
  held = DS[0];
  loop(size,
    fs = 0;
    sync[0] ? ph = 0;
    sync += 1;
    tap = 0;
    loop(4,
      ph = (ph + pi) & 4294967295;
      dc >= dcount ? (
        x = (d_par1 >> 8) & 255;
        held = ((((ph >> 24) ~ (x * 2)) & (65535 ~ x)) + (x >> 1)) & 255;
        dc = 0;
      );
      fs += T_FIR4[tap] * held;
      dc = (dc + 1) & 65535;
      tap += 1;
    );
    buf[0] = s16((fs >> 8) - 28208);
    buf += 1;
  );
  DS[0] = held;
  DS[1] = dc;
  d_phase = ph;
);

function d_filter(sync, buf, size) local(sp, mp, smp, si, ft, mpi, ti, mpii, ig, car, scar, saw, dsaw, tri, win, pulse, st, sq, bal, pol, v) (
  sp = s16(d_pitch + floor((d_par0 - 2048) / 2));
  sp > 16383 ? sp = 16383;
  mp = DS[0];
  smp = DS[1];
  si = DS[2];
  pol = DS[3];
  mpi = DS[4];
  ft = d_shape - 4;
  ti = cpi(sp);
  mpii = mpi < ti ? floor((ti - mpi) / size) : 4294967295 - floor((mpi - ti) / size);
  loop(size,
    d_phase = (d_phase + d_pinc) & 4294967295;
    mpi = (mpi + mpii) & 4294967295;
    mp = (mp + mpi) & 4294967295;
    ig = (mpi >> 14) & 65535;
    sync[0] ? (
      pol = 1;
      d_phase = 0;
      mp = 0;
      smp = 0;
      si = 0;
    );
    sync += 1;
    smp = (smp + mpi) & 4294967295;
    d_phase < d_pinc ? mp = T_PHRESET[ft];
    ((d_phase * 2) & 4294967295) < ((d_pinc * 2) & 4294967295) ? (
      pol = !pol;
      smp = T_PHRESET[(ft & 1) + 2];
    );
    car = i824(T_SINE, mp);
    scar = i824(T_SINE, smp);
    saw = 65535 - (d_phase >> 16);
    dsaw = 65535 - ((d_phase >> 15) & 65535);
    v = d_phase >> 15;
    tri = (v ~ (d_phase >= 2147483648 ? 65535 : 0)) & 65535;
    win = d_par1 < 16384 ? saw : tri;
    pulse = floor(scar * dsaw / 65536);
    pol ? pulse = -pulse;
    si += floor(pulse * ig / 65536);
    si = cl16(si);
    ft & 2 ? (
      st = s16(floor(car * win / 65536));
      sq = s16(pulse);
    ) : (
      st = s16(floor(win * (car + 32768) / 65536) - 32768);
      sq = s16(si);
      ft === 1 ? sq = s16(floor((pulse + si) / 2));
    );
    bal = ((d_par1 < 16384 ? d_par1 : -d_par1 - 1) * 4) & 65535;
    buf[0] = mix(st, sq, bal);
    buf += 1;
  );
  DS[0] = mp;
  DS[1] = smp;
  DS[2] = si;
  DS[3] = pol;
  DS[4] = mpi;
);

function d_vosim(sync, buf, size) local(smp, f0, f1, i0, i1, ph, pi) (
  VW_FI[0] = cpi(d_par0 >> 1);
  VW_FI[1] = cpi(d_par1 >> 1);
  f0 = VW_FP[0]; f1 = VW_FP[1]; i0 = VW_FI[0]; i1 = VW_FI[1];
  ph = d_phase; pi = d_pinc;
  loop(size,
    ph = (ph + pi) & 4294967295;
    sync[0] ? ph = 0;
    sync += 1;
    smp = 24576;
    f0 = (f0 + i0) & 4294967295;
    smp += floor(i824(T_SINE, f0) / 2);
    f1 = (f1 + i1) & 4294967295;
    smp += floor(i824(T_SINE, f1) / 4);
    smp = floor(smp * (i824(T_BELL, ph) >> 1) / 32768);
    ph < pi ? (
      f0 = 0;
      f1 = 0;
      smp = 0;
    );
    smp -= 24576;
    buf[0] = s16(smp);
    buf += 1;
  );
  d_phase = ph;
  VW_FP[0] = f0; VW_FP[1] = f1;
);

function d_vowel(sync, buf, size) local(vi, bal, fsh, ix, i, cs, v0, v1, noise, smp, pn, f0, f1, f2, i0, i1, i2, a0, a1, a2, ph, pi) (
  vi = d_par0 >> 12;
  bal = d_par0 & 4095;
  fsh = (200 + (d_par1 >> 6)) & 65535;
  d_strike ? (
    d_strike = 0;
    DS[0] = 160;
    ix = (rand_sample() + 1) & 7;
    cs = T_CONS + ix * 6;
    i = 0;
    loop(3,
      VW_FI[i] = (cs[i] * 4096 * fsh) & 4294967295;
      VW_FA[i] = cs[3 + i];
      i += 1;
    );
    DS[1] = ix >= 6 ? 4095 : 0;
  );
  DS[0] ? DS[0] -= 1 : (
    v0 = T_VOWELS + vi * 6;
    v1 = v0 + 6;
    i = 0;
    loop(3,
      VW_FI[i] = ((v0[i] * (4096 - bal) + v1[i] * bal) * fsh) & 4294967295;
      VW_FA[i] = (v0[3 + i] * (4096 - bal) + v1[3 + i] * bal) >> 12;
      i += 1;
    );
    DS[1] = 0;
  );
  noise = DS[1];
  f0 = VW_FP[0]; f1 = VW_FP[1]; f2 = VW_FP[2];
  i0 = VW_FI[0]; i1 = VW_FI[1]; i2 = VW_FI[2];
  a0 = VW_FA[0]; a1 = VW_FA[1]; a2 = VW_FA[2];
  ph = d_phase; pi = d_pinc;
  loop(size,
    ph = (ph + pi) & 4294967295;
    f0 = (f0 + i0) & 4294967295;
    smp = s16(T_FSINE[((f0 >> 24) & 240) | a0]);
    f1 = (f1 + i1) & 4294967295;
    smp = s16(smp + T_FSINE[((f1 >> 24) & 240) | a1]);
    f2 = (f2 + i2) & 4294967295;
    smp = s16(smp + T_FSQUARE[((f2 >> 24) & 240) | a2]);
    smp = s16(smp * (255 - (ph >> 24)));
    pn = rand_sample() * noise;
    ((ph + pn) & 4294967295) < pi ? (
      f0 = 0;
      f1 = 0;
      f2 = 0;
      smp = 0;
    );
    buf[0] = i88(T_MODOD, (smp + 32768) & 65535);
    buf += 1;
  );
  d_phase = ph;
  VW_FP[0] = f0; VW_FP[1] = f1; VW_FP[2] = f2;
);

function fmt_interp(tb, x, y, fm) local(xi, xm, yi, ym, a, b, c, d) (
  xi = (x >> 13) & 65535;
  xm = (x * 8) & 65535;
  yi = (y >> 13) & 65535;
  ym = (y * 8) & 65535;
  a = tb[(xi * 5 + yi) * 5 + fm];
  b = tb[((xi + 1) * 5 + yi) * 5 + fm];
  c = tb[(xi * 5 + yi + 1) * 5 + fm];
  d = tb[((xi + 1) * 5 + yi + 1) * 5 + fm];
  a = s16(a + floor((b - a) * xm / 65536));
  c = s16(c + floor((d - c) * xm / 65536));
  s16(a + floor((c - a) * ym / 65536));
);

function d_fof(sync, buf, size) local(i, fr, ph, prev, nss, tss, inc, t, in, out, notch, hp, a0, f0, f1, f2, f3, f4, l0, l1, l2, l3, l4, b0, b1, b2, b3, b4) (
  i = 0;
  loop(5,
    fr = fmt_interp(T_FMTF, d_par1, d_par0, i) + 1536;
    FOF_F[i] = s16(i824(T_SVFCUT, (fr * 131072) & 4294967295));
    FOF_A[i] = fmt_interp(T_FMTA, d_par1, d_par0, i);
    d_init_ ? ( FOF_LP[i] = 0; FOF_BP[i] = 0; );
    i += 1;
  );
  d_init_ = 0;
  ph = d_phase;
  prev = DS[0];
  nss = DS[1];
  inc = (d_pinc * 2) & 4294967295;
  a0 = FOF_A[0];
  f0 = FOF_F[0]; f1 = FOF_F[1]; f2 = FOF_F[2]; f3 = FOF_F[3]; f4 = FOF_F[4];
  l0 = FOF_LP[0]; l1 = FOF_LP[1]; l2 = FOF_LP[2]; l3 = FOF_LP[3]; l4 = FOF_LP[4];
  b0 = FOF_BP[0]; b1 = FOF_BP[1]; b2 = FOF_BP[2]; b3 = FOF_BP[3]; b4 = FOF_BP[4];
  loop(size / 2,
    tss = nss;
    nss = 0;
    ph = (ph + inc) & 4294967295;
    ph < inc ? (
      t = udiv(ph, inc >> 16);
      t > 65535 ? t = 65535;
      tss -= (t * t) >> 18;
      t = 65535 - t;
      nss += (t * t) >> 18;
    );
    nss += ph >> 17;
    in = tss;
    out = 0;
      notch = in - floor(b0 / 64);
      l0 = cl16(l0 + floor(f0 * b0 / 32768));
      hp = notch - l0;
      b0 = cl16(b0 + floor(f0 * hp / 32768));
      out += floor(b0 * a0 / 131072);
      notch = in - floor(b1 / 64);
      l1 = cl16(l1 + floor(f1 * b1 / 32768));
      hp = notch - l1;
      b1 = cl16(b1 + floor(f1 * hp / 32768));
      out += floor(b1 * a0 / 131072);
      notch = in - floor(b2 / 64);
      l2 = cl16(l2 + floor(f2 * b2 / 32768));
      hp = notch - l2;
      b2 = cl16(b2 + floor(f2 * hp / 32768));
      out += floor(b2 * a0 / 131072);
      notch = in - floor(b3 / 64);
      l3 = cl16(l3 + floor(f3 * b3 / 32768));
      hp = notch - l3;
      b3 = cl16(b3 + floor(f3 * hp / 32768));
      out += floor(b3 * a0 / 131072);
      notch = in - floor(b4 / 64);
      l4 = cl16(l4 + floor(f4 * b4 / 32768));
      hp = notch - l4;
      b4 = cl16(b4 + floor(f4 * hp / 32768));
      out += floor(b4 * a0 / 131072);
    out = cl16(out);
    buf[0] = s16(floor((out + prev) / 2));
    buf[1] = out;
    buf += 2;
    prev = out;
  );
  FOF_LP[0] = l0; FOF_LP[1] = l1; FOF_LP[2] = l2; FOF_LP[3] = l3; FOF_LP[4] = l4;
  FOF_BP[0] = b0; FOF_BP[1] = b1; FOF_BP[2] = b2; FOF_BP[3] = b3; FOF_BP[4] = b4;
  d_phase = ph;
  DS[1] = nss;
  DS[0] = prev;
);

function d_harm(sync, buf, size) local(ph, prev, pi, peak, sp, spa, sqw, sw, width, total, i, x, d, g, att, out, hit, a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, t0, t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11) (
  ph = d_phase;
  prev = DS[0];
  pi = (d_pinc * 2) & 4294967295;
  peak = (12 * d_par0) >> 7;
  sp = (peak >> 1) + 1536;
  spa = (d_par1 * d_par1) >> 15;
  sqw = d_par1 < 16384 ? d_par1 >> 6 : 511 - (d_par1 >> 6);
  sw = (sqw * sqw) >> 10;
  width = sw * sw + 4;
  total = 0;
  i = 0;
  loop(12,
    x = i * 256;
    d = x - peak;
    g = floor(4194304 / (128 + floor(d * d / width)));
    d = x - sp;
    g += floor(spa * 128 / (128 + floor(d * d / width)));
    total += g;
    HR_TGT[i] = g;
    i += 1;
  );
  att = floor(2147483647 / total);
  i = 0;
  loop(12,
    (pi >> 16) * (i + 1) > 16384 ? HR_TGT[i] = 0 : HR_TGT[i] = floor(HR_TGT[i] * att / 65536);
    i += 1;
  );
  a0 = HR_AMP[0]; a1 = HR_AMP[1]; a2 = HR_AMP[2]; a3 = HR_AMP[3]; a4 = HR_AMP[4]; a5 = HR_AMP[5]; a6 = HR_AMP[6]; a7 = HR_AMP[7]; a8 = HR_AMP[8]; a9 = HR_AMP[9]; a10 = HR_AMP[10]; a11 = HR_AMP[11];
  t0 = HR_TGT[0]; t1 = HR_TGT[1]; t2 = HR_TGT[2]; t3 = HR_TGT[3]; t4 = HR_TGT[4]; t5 = HR_TGT[5]; t6 = HR_TGT[6]; t7 = HR_TGT[7]; t8 = HR_TGT[8]; t9 = HR_TGT[9]; t10 = HR_TGT[10]; t11 = HR_TGT[11];
  loop(size / 2,
    ph = (ph + pi) & 4294967295;
    hit = sync[0];
    sync += 1;
    !hit ? (
      hit = sync[0];
      sync += 1;
    );
    hit ? ph = 0;
    out = 0;
    out += floor(i824(T_SINE, (ph * 1) & 4294967295) * a0 / 32768);
    a0 += floor((t0 - a0) / 256);
    out += floor(i824(T_SINE, (ph * 2) & 4294967295) * a1 / 32768);
    a1 += floor((t1 - a1) / 256);
    out += floor(i824(T_SINE, (ph * 3) & 4294967295) * a2 / 32768);
    a2 += floor((t2 - a2) / 256);
    out += floor(i824(T_SINE, (ph * 4) & 4294967295) * a3 / 32768);
    a3 += floor((t3 - a3) / 256);
    out += floor(i824(T_SINE, (ph * 5) & 4294967295) * a4 / 32768);
    a4 += floor((t4 - a4) / 256);
    out += floor(i824(T_SINE, (ph * 6) & 4294967295) * a5 / 32768);
    a5 += floor((t5 - a5) / 256);
    out += floor(i824(T_SINE, (ph * 7) & 4294967295) * a6 / 32768);
    a6 += floor((t6 - a6) / 256);
    out += floor(i824(T_SINE, (ph * 8) & 4294967295) * a7 / 32768);
    a7 += floor((t7 - a7) / 256);
    out += floor(i824(T_SINE, (ph * 9) & 4294967295) * a8 / 32768);
    a8 += floor((t8 - a8) / 256);
    out += floor(i824(T_SINE, (ph * 10) & 4294967295) * a9 / 32768);
    a9 += floor((t9 - a9) / 256);
    out += floor(i824(T_SINE, (ph * 11) & 4294967295) * a10 / 32768);
    a10 += floor((t10 - a10) / 256);
    out += floor(i824(T_SINE, (ph * 12) & 4294967295) * a11 / 32768);
    a11 += floor((t11 - a11) / 256);
    out = cl16(out);
    buf[0] = s16(floor((out + prev) / 2));
    buf[1] = out;
    buf += 2;
    prev = out;
  );
  HR_AMP[0] = a0; HR_AMP[1] = a1; HR_AMP[2] = a2; HR_AMP[3] = a3; HR_AMP[4] = a4; HR_AMP[5] = a5; HR_AMP[6] = a6; HR_AMP[7] = a7; HR_AMP[8] = a8; HR_AMP[9] = a9; HR_AMP[10] = a10; HR_AMP[11] = a11;
  DS[0] = prev;
  d_phase = ph;
);

function d_fm(sync, buf, size) local(mp, mpi, ps, pd, pinc_, pxf, p0, pm) (
  mp = DS[0];
  mpi = cpi(1536 + d_pitch + floor((d_par1 - 16384) / 2)) >> 1;
  ps = d_ppar0; pd = d_par0 - d_ppar0; pinc_ = floor(32767 / size); pxf = 0;
  loop(size,
    pxf += pinc_;
    p0 = ps + floor(pd * pxf / 32768);
    d_phase = (d_phase + d_pinc) & 4294967295;
    sync[0] ? ( d_phase = 0; mp = 0; );
    sync += 1;
    mp = (mp + mpi) & 4294967295;
    pm = (i824(T_SINE, mp) * p0 * 4) & 4294967295;
    buf[0] = i824(T_SINE, (d_phase + pm) & 4294967295);
    buf += 1;
  );
  d_ppar0 = d_par0;
  DS[0] = mp;
);

function d_ffm(sync, buf, size) local(prev, mp, att, mpi, ps, pd, pinc_, pxf, p0, p, pm) (
  prev = DS[1];
  mp = DS[0];
  att = d_pitch - 9216 + floor((d_par1 - 16384) / 2);
  att = 32767 - att * 4;
  att < 0 ? att = 0;
  att > 32767 ? att = 32767;
  mpi = cpi(1536 + d_pitch + floor((d_par1 - 16384) / 2)) >> 1;
  ps = d_ppar0; pd = d_par0 - d_ppar0; pinc_ = floor(32767 / size); pxf = 0;
  loop(size,
    pxf += pinc_;
    p0 = ps + floor(pd * pxf / 32768);
    d_phase = (d_phase + d_pinc) & 4294967295;
    sync[0] ? ( d_phase = 0; mp = 0; );
    sync += 1;
    mp = (mp + mpi) & 4294967295;
    p = floor(p0 * att / 32768);
    pm = prev * 16384;
    pm = w32(i824(T_SINE, (mp + pm) & 4294967295) * p * 2);
    prev = i824(T_SINE, (d_phase + pm) & 4294967295);
    buf[0] = prev;
    buf += 1;
  );
  d_ppar0 = d_par0;
  DS[1] = prev;
  DS[0] = mp;
);

function d_cfm(sync, buf, size) local(prev, mp, mpi, ps, pd, pinc_, pxf, p0, pm) (
  mpi = cpi(1536 + d_pitch + floor((d_par1 - 16384) / 2)) >> 1;
  prev = DS[1];
  mp = DS[0];
  ps = d_ppar0; pd = d_par0 - d_ppar0; pinc_ = floor(32767 / size); pxf = 0;
  loop(size,
    pxf += pinc_;
    p0 = ps + floor(pd * pxf / 32768);
    d_phase = (d_phase + d_pinc) & 4294967295;
    sync[0] ? ( d_phase = 0; mp = 0; );
    sync += 1;
    pm = w32(i824(T_SINE, mp) * p0 * 2);
    prev = i824(T_SINE, (d_phase + pm) & 4294967295);
    buf[0] = prev;
    buf += 1;
    mp = (mp + (mpi >> 8) * (129 + floor(prev / 512))) & 4294967295;
  );
  d_ppar0 = d_par0;
  DS[1] = prev;
  DS[0] = mp;
);

function d_pluck(sync, buf, size) local(v, inc, sh, width, upd, loss, prev, smp, es, rp, wp, nx, a, b, sum, cur, n0, n1, n2, p0, p1, p2, q0, q1, q2, h0, h1, h2, k0, k1, k2, w0, w1, w2, z0, z1, z2, d0, d1, d2) (
  d_pinc = (d_pinc * 2) & 4294967295;
  d_strike ? (
    d_voice += 1;
    d_voice >= 3 ? d_voice = 0;
    v = d_voice;
    inc = w32(d_pinc);
    sh = 0;
    while (inc > 8388608) ( inc = floor(inc / 2); sh += 1; );
    PK_SHIFT[v] = sh;
    PK_SIZE[v] = 1024 >> sh;
    PK_MASK[v] = PK_SIZE[v] - 1;
    PK_WP[v] = 0;
    PK_MAXPI[v] = (d_pinc * 2) & 4294967295;
    PK_PI[v] = d_pinc;
    width = d_par1;
    width = (3 * width) >> 1;
    PK_INIT[v] = (PK_SIZE[v] * (8192 + width)) >> 16;
    d_strike = 0;
  );
  cur = d_voice;
  PK_PI[cur] = min(d_pinc, PK_MAXPI[cur]);
  upd = d_par0 < 16384 ? 65535 : 131072 - (d_par0 >> 3) * 31;
  loss = s16(4096 - (d_pinc >> 14));
  loss < 256 ? loss = 256;
  d_par0 < 16384 ? loss = s16((loss * (16384 - d_par0)) >> 14) : loss = 0;
  prev = DS[0];
  n0 = PK_INIT[0]; p0 = PK_PH[0]; q0 = PK_PI[0]; h0 = PK_SHIFT[0]; k0 = PK_MASK[0]; w0 = PK_WP[0]; z0 = PK_SIZE[0]; d0 = DL16 + 0 * 1025;
  n1 = PK_INIT[1]; p1 = PK_PH[1]; q1 = PK_PI[1]; h1 = PK_SHIFT[1]; k1 = PK_MASK[1]; w1 = PK_WP[1]; z1 = PK_SIZE[1]; d1 = DL16 + 1 * 1025;
  n2 = PK_INIT[2]; p2 = PK_PH[2]; q2 = PK_PI[2]; h2 = PK_SHIFT[2]; k2 = PK_MASK[2]; w2 = PK_WP[2]; z2 = PK_SIZE[2]; d2 = DL16 + 2 * 1025;
  loop(size / 2,
    smp = 0;
    n0 ? (
      n0 -= 1;
      es = floor((d0[n0] + 3 * rand_sample()) / 4);
      d0[n0] = es;
      smp += es;
    ) : (
      p0 = (p0 + q0) & 4294967295;
      rp = ((p0 >> (22 + h0)) + 2) & k0;
      wp = w0;
      while (wp !== rp) (
        nx = (wp + 1) & k0;
        a = d0[wp];
        b = d0[nx];
        rand_word();
        (rng & 65535) <= upd ? (
          sum = a + b;
          sum = sum < 0 ? -((-sum) >> 1) : sum >> 1;
          loss ? sum = floor(sum * (32768 - loss) / 32768);
          d0[wp] = s16(sum);
        );
        wp === 0 ? d0[z0] = d0[0];
        wp = nx;
      );
      w0 = wp;
      smp += i1022(d0, p0 >> h0);
    );
    n1 ? (
      n1 -= 1;
      es = floor((d1[n1] + 3 * rand_sample()) / 4);
      d1[n1] = es;
      smp += es;
    ) : (
      p1 = (p1 + q1) & 4294967295;
      rp = ((p1 >> (22 + h1)) + 2) & k1;
      wp = w1;
      while (wp !== rp) (
        nx = (wp + 1) & k1;
        a = d1[wp];
        b = d1[nx];
        rand_word();
        (rng & 65535) <= upd ? (
          sum = a + b;
          sum = sum < 0 ? -((-sum) >> 1) : sum >> 1;
          loss ? sum = floor(sum * (32768 - loss) / 32768);
          d1[wp] = s16(sum);
        );
        wp === 0 ? d1[z1] = d1[0];
        wp = nx;
      );
      w1 = wp;
      smp += i1022(d1, p1 >> h1);
    );
    n2 ? (
      n2 -= 1;
      es = floor((d2[n2] + 3 * rand_sample()) / 4);
      d2[n2] = es;
      smp += es;
    ) : (
      p2 = (p2 + q2) & 4294967295;
      rp = ((p2 >> (22 + h2)) + 2) & k2;
      wp = w2;
      while (wp !== rp) (
        nx = (wp + 1) & k2;
        a = d2[wp];
        b = d2[nx];
        rand_word();
        (rng & 65535) <= upd ? (
          sum = a + b;
          sum = sum < 0 ? -((-sum) >> 1) : sum >> 1;
          loss ? sum = floor(sum * (32768 - loss) / 32768);
          d2[wp] = s16(sum);
        );
        wp === 0 ? d2[z2] = d2[0];
        wp = nx;
      );
      w2 = wp;
      smp += i1022(d2, p2 >> h2);
    );
    smp = cl16(smp);
    buf[0] = s16(floor((prev + smp) / 2));
    buf[1] = smp;
    buf += 2;
    prev = smp;
  );
  PK_INIT[0] = n0; PK_PH[0] = p0; PK_WP[0] = w0;
  PK_INIT[1] = n1; PK_PH[1] = p1; PK_WP[1] = w1;
  PK_INIT[2] = n2; PK_PH[2] = p2; PK_WP[2] = w2;
  DS[0] = prev;
);

function d_bowed(sync, buf, size) local(p0, p1, dp, ep, lp, by0, by1, delay, bd, bdi, bdf, nd, ndi, ndf, prev, bdp, ndp, bda, bdb, nua, nub, bv, nv, br, nr, sv, bow, vd, fr, nvel, tmp, out) (
  d_strike ? (
    memset(DLB8, 0, 1024);
    memset(DLN8, 0, 4096);
    d_state_clear();
    d_strike = 0;
  );
  p0 = s16(172 - (d_par0 >> 8));
  p1 = s16(6 + (d_par1 >> 9));
  dp = DS[0];
  ep = DS[1];
  lp = DS[2];
  by0 = DS[3];
  by1 = DS[4];
  delay = ((d_delay >> 1) - 131072) & 4294967295;
  bd = ((delay >> 8) * p1) & 4294967295;
  while (((delay - bd) & 4294967295) > 268369920 || bd > 67043328) (
    delay = delay >> 1;
    bd = bd >> 1;
  );
  bdi = (bd >> 16) & 65535;
  bdf = bd & 65535;
  nd = (delay - bd) & 4294967295;
  ndi = nd >> 16;
  ndf = nd & 65535;
  prev = DS[5];
  loop(size / 2,
    d_phase = (d_phase + d_pinc) & 4294967295;
    bdp = (dp + 2048 - bdi) & 65535;
    ndp = (dp + 8192 - ndi) & 65535;
    bda = DLB8[bdp & 1023];
    bdb = DLB8[(bdp - 1) & 1023];
    nua = DLN8[ndp & 4095];
    nub = DLN8[(ndp - 1) & 4095];
    bv = mix(bda, bdb, bdf) * 256;
    nv = mix(nua, nub, ndf) * 256;
    lp = floor((bv * 14008 + lp * 18022) / 32768);
    br = -lp;
    nr = -nv;
    sv = br + nr;
    bow = T_BOWENV[ep >> 1];
    bow += T_BOWENV[(ep + 1) >> 1];
    bow = bow >> 1;
    vd = bow - sv;
    fr = floor(vd * p0 / 32);
    fr < 0 ? fr = -fr;
    fr >= 131072 ? fr = 131071;
    fr = T_BOWFRIC[fr >> 9];
    nvel = floor(fr * vd / 32768);
    DLN8[dp & 4095] = s8(floor((br + nvel) / 256));
    DLB8[dp & 1023] = s8(floor((nr + nvel) / 256));
    dp = (dp + 1) & 65535;
    tmp = floor(bv * 6553 / 32768);
    tmp += floor(by0 * 6948 / 4096);
    tmp += floor(by1 * -2959 / 4096);
    out = tmp - by1;
    by1 = by0;
    by0 = tmp;
    out = cl16(out);
    buf[0] = s16(floor((out + prev) / 2));
    buf[1] = out;
    buf += 2;
    prev = out;
    ep = (ep + 1) & 65535;
  );
  (ep >> 1) >= 720 ? ep = 1440;
  DS[0] = dp & 4095;
  DS[1] = ep;
  DS[2] = lp;
  DS[3] = by0;
  DS[4] = by1;
  DS[5] = prev;
);

function d_blown(sync, buf, size) local(dp, lp, delay, bdi, bdf, prm, fs, np, fc, bp, bdp, a, b, dv, pd, reed, out) (
  dp = DS[0];
  lp = DS[2];
  d_strike ? (
    memset(DL16, 0, 2048);
    d_strike = 0;
  );
  delay = ((d_delay >> 1) - 65536) & 4294967295;
  while (delay > 134152192) ( delay = delay >> 1; );
  bdi = (delay >> 16) & 65535;
  bdf = delay & 65535;
  prm = (28000 - (d_par0 >> 1)) & 65535;
  fs = s16(DS[3]);
  np = s16(floor((d_pitch - 8192 + (d_par1 >> 1)) / 128));
  np < 0 ? np = 0 : np > 127 ? np = 127;
  fc = T_FLUTE[np];
  loop(size,
    d_phase = (d_phase + d_pinc) & 4294967295;
    bp = floor(rand_sample() * prm / 32768);
    bp = floor(bp * 26214 / 32768);
    bp += 26214;
    bdp = (dp + 4096 - bdi) & 65535;
    a = DL16[bdp & 2047];
    b = DL16[(bdp - 1) & 2047];
    dv = mix(a, b, bdf);
    pd = floor(dv / 2) + lp;
    lp = floor(dv / 2);
    pd = floor(-3891 * pd / 4096);
    pd -= bp;
    reed = floor(pd * -1229 / 4096) + 22938;
    reed = cl16(reed);
    out = floor(pd * reed / 32768);
    out += bp;
    out = cl16(out);
    DL16[dp & 2047] = out;
    dp = (dp + 1) & 65535;
    fs = s16(floor((fc * out + (4096 - fc) * fs) / 4096));
    buf[0] = fs;
    buf += 1;
  );
  DS[3] = fs;
  DS[0] = dp & 2047;
  DS[2] = lp;
);

function d_fluted(sync, buf, size) local(dp, ep, lp, dcx, dcy, bd, jd, bdi, bdf, jdi, jdf, bi, fc, sz, bdp, jdp, ba, bb, ja, jb, bv, jv, bp, rp, refl, pd, jti, out) (
  dp = DS[0];
  ep = DS[1];
  lp = DS[2];
  dcx = DS[3];
  dcy = DS[4];
  d_strike ? (
    ep = 0;
    memset(DLF8, 0, 4096);
    memset(DLJ8, 0, 1024);
    lp = 0;
    d_strike = 0;
  );
  bd = ((d_delay * 2) - 131072) & 4294967295;
  jd = ((bd >> 8) * (48 + (d_par1 >> 10))) & 4294967295;
  bd = (bd - jd) & 4294967295;
  while (bd > 268369920 || jd > 67043328) (
    bd = bd >> 1;
    jd = jd >> 1;
  );
  bdi = (bd >> 16) & 65535;
  bdf = bd & 65535;
  jdi = jd >> 16;
  jdf = jd & 65535;
  bi = (2100 - (d_par0 >> 4)) & 65535;
  fc = T_FLUTE[d_pitch >> 7];
  sz = size;
  while (sz > 0) (
    sz -= 1;
    d_phase = (d_phase + d_pinc) & 4294967295;
    bdp = (dp + 8192 - bdi) & 65535;
    jdp = (dp + 2048 - jdi) & 65535;
    ba = DLF8[bdp & 4095];
    bb = DLF8[(bdp - 1) & 4095];
    ja = DLJ8[jdp & 1023];
    jb = DLJ8[(jdp - 1) & 1023];
    bv = mix(ba, bb, bdf) * 512;
    jv = mix(ja, jb, jdf) * 512;
    bp = T_BLOWENV[ep];
    bp *= 2;
    rp = floor(rand_sample() * bi / 4096);
    rp = floor(rp * bp / 32768);
    bp += rp;
    lp = floor((-fc * bv + (4096 - fc) * lp) / 4096);
    refl = lp;
    dcy = floor(4055 * dcy / 4096);
    dcy += refl - dcx;
    dcx = refl;
    refl = dcy;
    pd = bp - floor(refl / 2);
    DLJ8[dp & 1023] = s8(floor(pd / 512));
    jti = jv;
    jti < 0 ? jti = 0;
    jti > 65535 ? jti = 65535;
    pd = T_BLOWJET[jti >> 8] + floor(refl / 2);
    DLF8[dp & 4095] = s8(floor(pd / 512));
    dp = (dp + 1) & 65535;
    out = cl16(floor(bv / 2));
    buf[0] = out;
    buf += 1;
    sz & 3 ? ep = (ep + 1) & 65535;
  );
  ep >= 360 ? ep = 360;
  DS[0] = dp;
  DS[1] = ep;
  DS[2] = lp;
  DS[3] = dcx;
  DS[4] = dcy;
);

function d_bell(sync, buf, size) local(fp, lp_, i, pp, dl_, ds_, bal, decay, prev, out, p0, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, q0, q1, q2, q3, q4, q5, q6, q7, q8, q9, q10, a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10) (
  fp = DS[1];
  lp_ = min(fp + 3, 11);
  DS[1] = (fp + 3) % 11;
  d_strike ? (
    i = 0;
    loop(11,
      AD_AMP[i] = T_BELLAMP[i];
      AD_PH[i] = 1073741824;
      i += 1;
    );
    d_strike = 0;
    fp = 0;
    lp_ = 11;
  );
  i = fp;
  while (i < lp_) (
    pp = s16(d_pitch + T_BELLP[i]);
    i & 1 ? pp = s16(pp + (d_par1 >> 7)) : pp = s16(pp - (d_par1 >> 7));
    AD_PI[i] = (cpi(pp) * 2) & 4294967295;
    i += 1;
  );
  d_par0 < 32000 ? (
    i = 0;
    loop(11,
      dl_ = T_BELLLONG[i];
      ds_ = T_BELLSHORT[i];
      bal = s16((32767 - d_par0) >> 8);
      bal = s16((bal * bal) >> 7);
      decay = dl_ - floor((dl_ - ds_) * bal / 128);
      AD_AMP[i] = floor(AD_AMP[i] * decay / 65536);
      i += 1;
    );
  );
  prev = DS[0];
  p0 = AD_PH[0]; p1 = AD_PH[1]; p2 = AD_PH[2]; p3 = AD_PH[3]; p4 = AD_PH[4]; p5 = AD_PH[5]; p6 = AD_PH[6]; p7 = AD_PH[7]; p8 = AD_PH[8]; p9 = AD_PH[9]; p10 = AD_PH[10];
  q0 = AD_PI[0]; q1 = AD_PI[1]; q2 = AD_PI[2]; q3 = AD_PI[3]; q4 = AD_PI[4]; q5 = AD_PI[5]; q6 = AD_PI[6]; q7 = AD_PI[7]; q8 = AD_PI[8]; q9 = AD_PI[9]; q10 = AD_PI[10];
  a0 = AD_AMP[0]; a1 = AD_AMP[1]; a2 = AD_AMP[2]; a3 = AD_AMP[3]; a4 = AD_AMP[4]; a5 = AD_AMP[5]; a6 = AD_AMP[6]; a7 = AD_AMP[7]; a8 = AD_AMP[8]; a9 = AD_AMP[9]; a10 = AD_AMP[10];
  loop(size / 2,
    out = 0;
    p0 = (p0 + q0) & 4294967295;
    out += floor(i824(T_SINE, p0) * a0 / 131072);
    p1 = (p1 + q1) & 4294967295;
    out += floor(i824(T_SINE, p1) * a1 / 131072);
    p2 = (p2 + q2) & 4294967295;
    out += floor(i824(T_SINE, p2) * a2 / 131072);
    p3 = (p3 + q3) & 4294967295;
    out += floor(i824(T_SINE, p3) * a3 / 131072);
    p4 = (p4 + q4) & 4294967295;
    out += floor(i824(T_SINE, p4) * a4 / 131072);
    p5 = (p5 + q5) & 4294967295;
    out += floor(i824(T_SINE, p5) * a5 / 131072);
    p6 = (p6 + q6) & 4294967295;
    out += floor(i824(T_SINE, p6) * a6 / 131072);
    p7 = (p7 + q7) & 4294967295;
    out += floor(i824(T_SINE, p7) * a7 / 131072);
    p8 = (p8 + q8) & 4294967295;
    out += floor(i824(T_SINE, p8) * a8 / 131072);
    p9 = (p9 + q9) & 4294967295;
    out += floor(i824(T_SINE, p9) * a9 / 131072);
    p10 = (p10 + q10) & 4294967295;
    out += floor(i824(T_SINE, p10) * a10 / 131072);
    out = cl16(out);
    buf[0] = s16(floor((out + prev) / 2));
    buf[1] = out;
    buf += 2;
    prev = out;
  );
  AD_PH[0] = p0; AD_PH[1] = p1; AD_PH[2] = p2; AD_PH[3] = p3; AD_PH[4] = p4; AD_PH[5] = p5; AD_PH[6] = p6; AD_PH[7] = p7; AD_PH[8] = p8; AD_PH[9] = p9; AD_PH[10] = p10;
  DS[0] = prev;
);

function d_drum(sync, buf, size) local(rst, i, dl_, ds_, bal, decay, prev, cut, f, l0, l1, l2, hg, nmg, finc, fade, harm, noise, smp, nm1, nm2, p0, p1, p2, p3, p4, p5, q0, q1, q2, q3, q4, q5, a0, a1, a2, a3, a4, a5, t0, t1, t2, t3, t4, t5, r0, r1, r2, r3, r4, r5) (
  d_strike ? (
    rst = AD_AMP[0] < 1024;
    i = 0;
    loop(6,
      AD_TGT[i] = T_DRUMAMP[i];
      rst ? AD_PH[i] = 1073741824;
      i += 1;
    );
    d_strike = 0;
  ) : (
    d_par0 < 32000 ? (
      i = 0;
      loop(6,
        dl_ = T_DRUMLONG[i];
        ds_ = T_DRUMSHORT[i];
        bal = s16((32767 - d_par0) >> 8);
        bal = s16((bal * bal) >> 7);
        decay = dl_ - floor((dl_ - ds_) * bal / 128);
        AD_TGT[i] = floor(AD_AMP[i] * decay / 65536);
        i += 1;
      );
    );
  );
  i = 0;
  loop(6,
    AD_PI[i] = (cpi(s16(d_pitch + T_DRUMP[i])) * 2) & 4294967295;
    i += 1;
  );
  prev = DS[0];
  cut = (d_pitch - 1536) + (d_par1 >> 2);
  cut < 0 ? cut = 0 : cut > 32767 ? cut = 32767;
  f = i824(T_SVFCUT, (cut * 65536) & 4294967295);
  l0 = DS[2]; l1 = DS[3]; l2 = DS[4];
  hg = d_par1 < 12888 ? d_par1 + 4096 : 16384;
  nmg = d_par1 < 16384 ? 0 : d_par1 - 16384;
  nmg = (nmg * 12888) >> 14;
  finc = floor(65536 / size);
  fade = 0;
  p0 = AD_PH[0]; p1 = AD_PH[1]; p2 = AD_PH[2]; p3 = AD_PH[3]; p4 = AD_PH[4]; p5 = AD_PH[5];
  q0 = AD_PI[0]; q1 = AD_PI[1]; q2 = AD_PI[2]; q3 = AD_PI[3]; q4 = AD_PI[4]; q5 = AD_PI[5];
  a0 = AD_AMP[0]; a1 = AD_AMP[1]; a2 = AD_AMP[2]; a3 = AD_AMP[3]; a4 = AD_AMP[4]; a5 = AD_AMP[5];
  t0 = AD_TGT[0]; t1 = AD_TGT[1]; t2 = AD_TGT[2]; t3 = AD_TGT[3]; t4 = AD_TGT[4]; t5 = AD_TGT[5];
  loop(size / 2,
    fade += finc;
    harm = 0;
    noise = rand_sample();
    noise > 16384 ? noise = 16384;
    noise < -16384 ? noise = -16384;
    l0 += floor((noise - l0) * f / 32768);
    l1 += floor((l0 - l1) * f / 32768);
    l2 += floor((l1 - l2) * f / 32768);
    p0 = (p0 + q0) & 4294967295;
    r0 = floor(w32(i824(T_SINE, p0) * (a0 + floor(w32((t0 - a0) * fade) / 32768))) / 65536);
    harm += r0;
    p1 = (p1 + q1) & 4294967295;
    r1 = floor(w32(i824(T_SINE, p1) * (a1 + floor(w32((t1 - a1) * fade) / 32768))) / 65536);
    harm += r1;
    p2 = (p2 + q2) & 4294967295;
    r2 = floor(w32(i824(T_SINE, p2) * (a2 + floor(w32((t2 - a2) * fade) / 32768))) / 65536);
    harm += r2;
    p3 = (p3 + q3) & 4294967295;
    r3 = floor(w32(i824(T_SINE, p3) * (a3 + floor(w32((t3 - a3) * fade) / 32768))) / 65536);
    harm += r3;
    p4 = (p4 + q4) & 4294967295;
    r4 = floor(w32(i824(T_SINE, p4) * (a4 + floor(w32((t4 - a4) * fade) / 32768))) / 65536);
    harm += r4;
    p5 = (p5 + q5) & 4294967295;
    r5 = floor(w32(i824(T_SINE, p5) * (a5 + floor(w32((t5 - a5) * fade) / 32768))) / 65536);
    harm += r5;
    smp = r0;
    nm1 = floor(w32(r1 * l2) / 256);
    nm2 = floor(w32(r3 * l2) / 512);
    smp += floor(w32(nm1 * (12288 - nmg)) / 16384);
    smp += floor(w32(nm2 * nmg) / 16384);
    smp += floor(w32(harm * hg) / 16384);
    smp = cl16(smp);
    buf[0] = s16(floor((smp + prev) / 2));
    buf[1] = smp;
    buf += 2;
    prev = smp;
  );
  AD_PH[0] = p0; AD_PH[1] = p1; AD_PH[2] = p2; AD_PH[3] = p3; AD_PH[4] = p4; AD_PH[5] = p5;
  DS[0] = prev;
  DS[2] = l0; DS[3] = l1; DS[4] = l2;
  i = 0;
  loop(11, AD_AMP[i] = AD_TGT[i]; i += 1;);
);

function d_kick(sync, buf, size) local(dec, sc, sq, co, lpc, lp, exc, ro, j) (
  d_init_ ? (
    pl0.ex_init(); pl0.delay = 0; pl0.decay = 3340;
    pl1.ex_init(); pl1.delay = 48; pl1.decay = 3072;
    pl2.ex_init(); pl2.delay = 192; pl2.decay = 4093;
    sf0.sv_init(); sf0.sv_punch(32768); sf0.mode = 1;
    d_init_ = 0;
  );
  d_strike ? (
    d_strike = 0;
    pl0.ex_trigger(275251);
    pl1.ex_trigger(-13763);
    pl2.ex_trigger(18000);
    sf0.sv_punch(24000);
  );
  dec = d_par0;
  sc = 65535 - dec * 2;
  sq = (sc * sc) >> 16;
  sc = (sq * sc) >> 18;
  sf0.sv_res(s16(32640 - sc));
  co = d_par1;
  co = (co * co) >> 15;
  co = (co * co) >> 15;
  lpc = 128 + (co >> 1) * 3;
  lp = DS[0];
  loop(size / 2,
    exc = 0;
    exc += pl0.ex_process();
    exc += pl1.counter !== 0 ? 16384 : 0;
    exc += pl1.ex_process();
    pl2.ex_process();
    sf0.sv_freq(s16(d_pitch + (pl2.counter === 0 ? 0 : 2176)));
    j = 0;
    loop(2,
      ro = floor(exc / 16) + sf0.sv_process(exc);
      lp += floor(w32((ro - lp) * lpc) / 32768);
      lp = cl16(lp);
      buf[0] = lp;
      buf += 1;
      j += 1;
    );
  );
  DS[0] = lp;
);

function d_cymbal(sync, buf, size) local(note, i0, root, xf, hn, noise, rs, ph, q6, p0, p1, p2, p3, p4, p5, q0, q1, q2, q3, q4, q5) (
  d_init_ ? (
    sf0.sv_init(); sf0.mode = 1; sf0.sv_res(12000);
    sf1.sv_init(); sf1.mode = 2; sf1.sv_res(2000);
    d_init_ = 0;
  );
  note = 5120 + floor(d_pitch / 2);
  i0 = cpi(note);
  root = i0 >> 10;
  q0 = i0;
  q1 = ((root * 24273) & 4294967295) >> 4;
  q2 = ((root * 12561) & 4294967295) >> 4;
  q3 = ((root * 18417) & 4294967295) >> 4;
  q4 = ((root * 22452) & 4294967295) >> 4;
  q5 = ((root * 31858) & 4294967295) >> 4;
  q6 = (i0 * 24) & 4294967295;
  xf = d_par1;
  sf0.sv_freq(d_par0 >> 1);
  sf1.sv_freq(d_par0 >> 1);
  p0 = HT_PH[0]; p1 = HT_PH[1]; p2 = HT_PH[2]; p3 = HT_PH[3]; p4 = HT_PH[4]; p5 = HT_PH[5];
  rs = DS[0];
  ph = d_phase;
  loop(size,
    ph = (ph + q6) & 4294967295;
    ph < q6 ? rs = (rs * 1664525 + 1013904223) & 4294967295;
    p0 = (p0 + q0) & 4294967295;
    p1 = (p1 + q1) & 4294967295;
    p2 = (p2 + q2) & 4294967295;
    p3 = (p3 + q3) & 4294967295;
    p4 = (p4 + q4) & 4294967295;
    p5 = (p5 + q5) & 4294967295;
    hn = (((p0 >> 31) + (p1 >> 31) + (p2 >> 31) + (p3 >> 31) + (p4 >> 31) + (p5 >> 31)) - 3) * 5461;
    hn = cl16(sf0.sv_process(hn));
    noise = (rs >> 16) - 32768;
    noise = cl16(sf1.sv_process(floor(noise / 2)));
    buf[0] = s16(hn + floor((noise - hn) * xf / 32768));
    buf += 1;
  );
  d_phase = ph;
  DS[0] = rs;
  HT_PH[0] = p0; HT_PH[1] = p1; HT_PH[2] = p2; HT_PH[3] = p3; HT_PH[4] = p4; HT_PH[5] = p5;
);

function d_snare(sync, buf, size) local(dec, sn, g1, g2, e1, e2, ns, sd) (
  d_init_ ? (
    pl0.ex_init(); pl0.delay = 0; pl0.decay = 1536;
    pl1.ex_init(); pl1.delay = 48; pl1.decay = 3072;
    pl2.ex_init(); pl2.delay = 48; pl2.decay = 1200;
    pl3.ex_init(); pl3.delay = 0;
    sf0.sv_init();
    sf1.sv_init();
    sf2.sv_init(); sf2.sv_res(2000); sf2.mode = 1;
    d_init_ = 0;
  );
  d_strike ? (
    dec = 49152 - d_pitch;
    dec += d_par1 < 16384 ? 0 : d_par1 - 16384;
    dec > 65535 ? dec = 65535;
    sf0.sv_res(s16(29000 + (dec >> 5)));
    sf1.sv_res(s16(26500 + (dec >> 5)));
    pl3.decay = (4092 + (dec >> 14)) & 65535;
    pl0.ex_trigger(491520);
    pl1.ex_trigger(-32768);
    pl2.ex_trigger(13107);
    sn = d_par1;
    sn >= 14336 ? sn = 14336;
    pl3.ex_trigger(512 + sn * 2);
    d_strike = 0;
  );
  sf0.sv_freq(s16(d_pitch + 1536));
  sf1.sv_freq(s16(d_pitch + 3072));
  sf2.sv_freq(s16(d_pitch + 7680));
  g1 = 22000 - (d_par0 >> 1);
  g2 = 22000 + (d_par0 >> 1);
  loop(size / 2,
    e1 = 0;
    e1 += pl0.ex_process();
    e1 += pl1.ex_process();
    e1 += pl1.counter !== 0 ? 2621 : 0;
    e2 = 0;
    e2 += pl2.ex_process();
    e2 += pl2.counter !== 0 ? 13107 : 0;
    ns = floor(w32(rand_sample() * pl3.ex_process()) / 32768);
    sd = 0;
    sd += floor(w32((sf0.sv_process(e1) + floor(e1 / 16)) * g1) / 32768);
    sd += floor(w32((sf1.sv_process(e2) + floor(e2 / 16)) * g2) / 32768);
    sd += sf2.sv_process(ns);
    sd = cl16(sd);
    buf[0] = sd;
    buf[1] = sd;
    buf += 2;
  );
);

function d_wtbl(sync, buf, size) local(wti, wt, wp, w0, w1, pi, s, bal) (
  (d_par1 > d_ppar1 + 64 || d_par1 < d_ppar1 - 64) ? d_ppar1 = d_par1;
  wti = (d_ppar1 * 20) >> 15;
  wt = T_WTDEFS + wti * 18;
  wp = ((d_par0 * 2) * wt[0]) & 4294967295;
  w0 = T_WAVES + wt[1 + (wp >> 16)] * 129;
  w1 = T_WAVES + wt[2 + (wp >> 16)] * 129;
  bal = wp & 65535;
  pi = d_pinc >> 1;
  loop(size,
    d_phase = (d_phase + pi) & 4294967295;
    sync[0] ? d_phase = 0;
    sync += 1;
    s = floor(xf8(w0, w1, d_phase >> 1, bal) / 2);
    d_phase = (d_phase + pi) & 4294967295;
    s += floor(xf8(w0, w1, d_phase >> 1, bal) / 2);
    buf[0] = s16(s);
    buf += 1;
  );
);

function d_wmap(sync, buf, size) local(p0, p1, xf0, xf1, c0, c1, w00, w01, w10, w11, pi, s) (
  p0 = ((d_par0 * 15) >> 4) & 65535;
  p1 = ((d_par1 * 15) >> 4) & 65535;
  xf0 = (p0 * 32) & 65535;
  xf1 = (p1 * 32) & 65535;
  c0 = p0 >> 11;
  c1 = p1 >> 11;
  w00 = T_WAVES + T_WTMAP[c0 * 16 + c1] * 129;
  w01 = T_WAVES + T_WTMAP[c0 * 16 + c1 + 1] * 129;
  w10 = T_WAVES + T_WTMAP[(c0 + 1) * 16 + c1] * 129;
  w11 = T_WAVES + T_WTMAP[(c0 + 1) * 16 + c1 + 1] * 129;
  pi = d_pinc >> 1;
  loop(size,
    d_phase = (d_phase + pi) & 4294967295;
    sync[0] ? d_phase = 0;
    sync += 1;
    s = floor(mix(xf8(w00, w01, d_phase >> 1, xf1), xf8(w10, w11, d_phase >> 1, xf1), xf0) / 2);
    d_phase = (d_phase + pi) & 4294967295;
    s += floor(mix(xf8(w00, w01, d_phase >> 1, xf1), xf8(w10, w11, d_phase >> 1, xf1), xf0) / 2);
    buf[0] = s16(s);
    buf += 1;
  );
);

function d_wline(sync, buf, size) local(scan, w0, w1, w2, sxf, rx, rinc, bal, ph, pi, s, r, sm) (
  d_smooth = floor((3 * d_smooth + d_par0 * 2) / 4);
  scan = d_smooth & 65535;
  w0 = T_WAVES + T_WLINE[d_ppar0 >> 9] * 129;
  w1 = T_WAVES + T_WLINE[scan >> 10] * 129;
  w2 = T_WAVES + T_WLINE[(scan >> 10) + 1] * 129;
  sxf = (scan * 64) & 65535;
  rx = 0;
  rinc = floor(32768 / size);
  bal = (d_par1 * 8) & 65535;
  ph = d_phase;
  pi = d_pinc >> 1;
  d_par1 < 8192 ? (
    loop(size,
      sync[0] ? ph = 0;
      sync += 1;
      s = 0;
      r = xf8(w0, w1, (ph >> 1) & 4261412864, rx);
      sm = xf8(w0, w1, ph >> 1, rx);
      s += mix(r, sm, bal);
      ph = (ph + pi) & 4294967295;
      rx = (rx + rinc) & 65535;
      r = xf8(w0, w1, (ph >> 1) & 4261412864, rx);
      sm = xf8(w0, w1, ph >> 1, rx);
      s += mix(r, sm, bal);
      ph = (ph + pi) & 4294967295;
      rx = (rx + rinc) & 65535;
      buf[0] = s16(floor(s / 2));
      buf += 1;
    );
  ) : d_par1 < 16384 ? (
    loop(size,
      sync[0] ? ph = 0;
      sync += 1;
      s = 0;
      r = xf8(w0, w1, ph >> 1, rx);
      sm = xf8(w1, w2, ph >> 1, sxf);
      s += mix(r, sm, bal);
      ph = (ph + pi) & 4294967295;
      rx = (rx + rinc) & 65535;
      r = xf8(w0, w1, ph >> 1, rx);
      sm = xf8(w1, w2, ph >> 1, sxf);
      s += mix(r, sm, bal);
      ph = (ph + pi) & 4294967295;
      rx = (rx + rinc) & 65535;
      buf[0] = s16(floor(s / 2));
      buf += 1;
    );
  ) : d_par1 < 24576 ? (
    loop(size,
      sync[0] ? ph = 0;
      sync += 1;
      s = 0;
      sm = xf8(w1, w2, ph >> 1, sxf);
      r = xf8(w1, w2, (ph >> 1) & 4261412864, sxf);
      s += mix(sm, r, bal);
      ph = (ph + pi) & 4294967295;
      sm = xf8(w1, w2, ph >> 1, sxf);
      r = xf8(w1, w2, (ph >> 1) & 4261412864, sxf);
      s += mix(sm, r, bal);
      ph = (ph + pi) & 4294967295;
      buf[0] = s16(floor(s / 2));
      buf += 1;
    );
  ) : (
    loop(size,
      sync[0] ? ph = 0;
      sync += 1;
      s = 0;
      sm = xf8(w1, w2, (ph >> 1) & 4261412864, sxf);
      r = xf8(w1, w2, (ph >> 1) & 4160749568, sxf);
      s += mix(sm, r, bal);
      ph = (ph + pi) & 4294967295;
      sm = xf8(w1, w2, (ph >> 1) & 4261412864, sxf);
      r = xf8(w1, w2, (ph >> 1) & 4160749568, sxf);
      s += mix(sm, r, bal);
      ph = (ph + pi) & 4294967295;
      buf[0] = s16(floor(s / 2));
      buf += 1;
    );
  );
  d_phase = ph;
  d_ppar0 = d_smooth >> 1;
);

function d_wpara(sync, buf, size) local(i, p0, p1, p2, p3, q0, ci, cf, dd1, dd2, det, w1, w2, wxf, s) (
  d_strike ? (
    i = 0;
    loop(4, SW_PH[i] = rand_word(); i += 1;);
    d_strike = 0;
  );
  q0 = d_pinc;
  p0 = SW_PH[0]; p1 = SW_PH[1]; p2 = SW_PH[2]; p3 = SW_PH[3];
  ci = d_par1 >> 11;
  cf = (d_par1 * 32) & 65535;
  cf < 30720 ? cf = 0 : cf >= 34816 ? cf = 65535 : cf = ((cf - 30720) * 16) & 65535;
  i = 0;
  loop(3,
    dd1 = T_CHORDS[ci * 3 + i];
    dd2 = T_CHORDS[(ci + 1) * 3 + i];
    det = (dd1 + floor((dd2 - dd1) * cf / 65536)) & 65535;
    SW_INC[i] = cpi(s16(d_pitch + det));
    i += 1;
  );
  w1 = T_WAVES + T_MINI[d_par0 >> 10] * 129;
  w2 = T_WAVES + T_MINI[(d_par0 >> 10) + 1] * 129;
  wxf = (d_par0 * 64) & 65535;
  loop(size / 2,
    p0 = (p0 + q0) & 4294967295;
    p1 = (p1 + SW_INC[0]) & 4294967295;
    p2 = (p2 + SW_INC[1]) & 4294967295;
    p3 = (p3 + SW_INC[2]) & 4294967295;
    s = xf8(w1, w2, p0 >> 1, wxf) + xf8(w1, w2, p1 >> 1, wxf) + xf8(w1, w2, p2 >> 1, wxf) + xf8(w1, w2, p3 >> 1, wxf);
    buf[0] = floor(s / 4);
    p0 = (p0 + q0) & 4294967295;
    p1 = (p1 + SW_INC[0]) & 4294967295;
    p2 = (p2 + SW_INC[1]) & 4294967295;
    p3 = (p3 + SW_INC[2]) & 4294967295;
    s = xf8(w1, w2, p0 >> 1, wxf) + xf8(w1, w2, p1 >> 1, wxf) + xf8(w1, w2, p2 >> 1, wxf) + xf8(w1, w2, p3 >> 1, wxf);
    buf[1] = floor(s / 4);
    buf += 2;
  );
  SW_PH[0] = p0; SW_PH[1] = p1; SW_PH[2] = p2; SW_PH[3] = p3;
);

function d_fnoise(sync, buf, size) local(f, damp, sc, bp, lp, bpg, lpg, hpg, gc, notch, hp, in, r) (
  f = i824(T_SVFCUT, (d_pitch * 131072) & 4294967295);
  damp = i824(T_SVFDAMP, (d_par0 * 131072) & 4294967295);
  sc = i824(T_SVFSCALE, (d_par0 * 131072) & 4294967295);
  bp = DS[0];
  lp = DS[1];
  d_par1 < 16384 ? (
    bpg = d_par1; lpg = 16384 - bpg; hpg = 0;
  ) : (
    bpg = 32767 - d_par1; hpg = d_par1 - 16384; lpg = 0;
  );
  gc = f > sc ? floor(sc * 32767 / f) : 32767;
  loop(size,
    in = floor(rand_sample() / 2);
    notch = in - floor(w32(bp * damp) / 32768);
    lp += floor(w32(f * bp) / 32768);
    lp = cl16(lp);
    hp = notch - lp;
    bp = w32(bp + floor(w32(f * hp) / 32768));
    r = floor(w32(lpg * lp) / 16384) + floor(w32(bpg * bp) / 16384) + floor(w32(hpg * hp) / 16384);
    r = cl16(r);
    r = floor(r * gc / 32768);
    buf[0] = i88(T_MODOD, (r + 32768) & 65535);
    buf += 1;
  );
  DS[0] = bp;
  DS[1] = lp;
);

function d_twinq(sync, buf, size) local(y10, y20, y11, y12, y21, y22, q, q2, p1, p2, c1, s1, c2, s2, mg, s) (
  y11 = PN_Y1[0]; y12 = PN_Y2[0]; y21 = PN_Y1[1]; y22 = PN_Y2[1];
  q = 65240 + (d_par0 >> 7);
  q2 = (q * q) >> 17;
  p1 = d_pitch;
  p1 < 0 ? p1 = 0 : p1 > 16383 ? p1 = 16383;
  c1 = i824(T_RESCOEF, (p1 * 131072) & 4294967295);
  s1 = i824(T_RESSCALE, (p1 * 131072) & 4294967295);
  p2 = s16(d_pitch + floor((d_par1 - 16384) / 2));
  p2 < 0 ? p2 = 0 : p2 > 16383 ? p2 = 16383;
  c2 = i824(T_RESCOEF, (p2 * 131072) & 4294967295);
  s2 = i824(T_RESSCALE, (p2 * 131072) & 4294967295);
  c1 = ((c1 * q) & 4294967295) >> 16;
  c2 = ((c2 * q) & 4294967295) >> 16;
  mg = 8191 - (d_par0 >> 2);
  loop(size / 2,
    s = floor(rand_sample() / 2);
    s > 0 ? (
      y10 = floor(s * s1 / 65536);
      y20 = floor(s * s2 / 65536);
    ) : (
      y10 = -floor(-s * s1 / 65536);
      y20 = -floor(-s * s2 / 65536);
    );
    y10 += floor(w32(y11 * c1) / 32768);
    y10 -= floor(w32(y12 * q2) / 32768);
    y10 = cl16(y10);
    y12 = y11;
    y11 = y10;
    y20 += floor(w32(y21 * c2) / 32768);
    y20 -= floor(w32(y22 * q2) / 32768);
    y20 = cl16(y20);
    y22 = y21;
    y21 = y20;
    y10 += y20;
    y10 += floor(y10 * mg / 8192);
    y10 = cl16(y10);
    s = i88(T_MODOD, (y10 + 32768) & 65535);
    buf[0] = s;
    buf[1] = s;
    buf += 2;
  );
  PN_Y1[0] = y11; PN_Y2[0] = y12; PN_Y1[1] = y21; PN_Y2[1] = y22;
);

function d_clkn(sync, buf, size) local(ph, pi, cpinc, ns, qd, smp, cp, rs, sd, smv) (
  (d_par1 > d_ppar1 + 64 || d_par1 < d_ppar1 - 64) ? d_ppar1 = d_par1;
  (d_par0 > d_ppar0 + 16 || d_par0 < d_ppar0 - 16) ? d_ppar0 = d_par0;
  d_strike ? (
    DS[3] = w32(rand_word());
    d_strike = 0;
  );
  ph = d_phase;
  pi = d_pinc;
  loop(3, pi < 2147483648 ? pi *= 2;);
  cpinc = (cpi(d_ppar0 - 16384) * 2) & 4294967295;
  DS[1] = cpinc;
  ns = 1 + (d_ppar1 >> 10);
  ns === 1 ? ns = 2;
  qd = floor(65536 / ns);
  cp = DS[0]; rs = DS[2]; sd = DS[3]; smv = DS[4];
  loop(size,
    ph = (ph + pi) & 4294967295;
    sync[0] ? ph = 0;
    sync += 1;
    ph < pi ? (
      rs = (rs * 1664525 + 1013904223) & 4294967295;
      cp = (cp + cpinc) & 4294967295;
      cp < cpinc ? (
        rs = sd & 4294967295;
        cp = cpinc;
      );
      smp = rs & 65535;
      smp = (smp - (smp % qd)) & 65535;
      smp = (smp + (qd >> 1)) & 65535;
      smv = s16(smp);
      ph = pi;
    );
    buf[0] = smv;
    buf += 1;
  );
  DS[0] = cp; DS[2] = rs; DS[4] = smv;
  d_phase = ph;
);

function d_cloud(sync, buf, size) local(i, pm, phi, s, p0, p1, p2, p3, q0, q1, q2, q3, e0, e1, e2, e3, r0, r1, r2, r3) (
  i = 0;
  loop(4,
    (GR_EP[i] > 16777216 || GR_EI[i] === 0) ? (
      GR_EI[i] = 0;
      (rand_word() & 65535) < 16384 ? (
        GR_EI[i] = (T_GRANRATE[d_par0 >> 7] * 8) & 4294967295;
        GR_EP[i] = 0;
        GR_PI[i] = d_pinc;
        pm = floor(rand_sample() * d_par1 / 65536);
        phi = d_pinc >> 8;
        pm < 0 ? GR_PI[i] = (GR_PI[i] + phi * floor(pm / 256)) & 4294967295
               : GR_PI[i] = (GR_PI[i] + phi * (pm >> 7)) & 4294967295;
      );
    );
    i += 1;
  );
  p0 = GR_PH[0]; p1 = GR_PH[1]; p2 = GR_PH[2]; p3 = GR_PH[3];
  q0 = GR_PI[0]; q1 = GR_PI[1]; q2 = GR_PI[2]; q3 = GR_PI[3];
  e0 = GR_EP[0]; e1 = GR_EP[1]; e2 = GR_EP[2]; e3 = GR_EP[3];
  r0 = GR_EI[0]; r1 = GR_EI[1]; r2 = GR_EI[2]; r3 = GR_EI[3];
  loop(size,
    s = 0;
    p0 = (p0 + q0) & 4294967295;
    e0 = (e0 + r0) & 4294967295;
    s += floor(i824(T_SINE, p0) * T_GRANENV[e0 >> 16] / 131072);
    p1 = (p1 + q1) & 4294967295;
    e1 = (e1 + r1) & 4294967295;
    s += floor(i824(T_SINE, p1) * T_GRANENV[e1 >> 16] / 131072);
    p2 = (p2 + q2) & 4294967295;
    e2 = (e2 + r2) & 4294967295;
    s += floor(i824(T_SINE, p2) * T_GRANENV[e2 >> 16] / 131072);
    p3 = (p3 + q3) & 4294967295;
    e3 = (e3 + r3) & 4294967295;
    s += floor(i824(T_SINE, p3) * T_GRANENV[e3 >> 16] / 131072);
    s < -32768 ? s = -32768;
    s > 32767 ? s = 32767;
    buf[0] = s;
    buf += 1;
  );
  GR_PH[0] = p0; GR_PH[1] = p1; GR_PH[2] = p2; GR_PH[3] = p3;
  GR_EP[0] = e0; GR_EP[1] = e1; GR_EP[2] = e2; GR_EP[3] = e3;
);

function d_prtc(sync, buf, size) local(amp, dens, y10, y20, y30, y11, y12, y21, y22, y31, y32, s1, s2, s3, c1, c2, c3, noise, na, nb, p1, p2, p3, s) (
  amp = DS[0];
  dens = 1024 + d_par0;
  y11 = PN_Y1[0]; y12 = PN_Y2[0]; s1 = PN_S[0]; c1 = PN_C[0];
  y21 = PN_Y1[1]; y22 = PN_Y2[1]; s2 = PN_S[1]; c2 = PN_C[1];
  y31 = PN_Y1[2]; y32 = PN_Y2[2]; s3 = PN_S[2]; c3 = PN_C[2];
  loop(size / 2,
    noise = rand_word();
    (noise & 8388607) < dens ? (
      amp = 65535;
      na = s16((noise & 4095) - 2048);
      nb = s16(((noise >> 15) & 8191) - 4096);
      p1 = s16(d_pitch + floor(3 * na * d_par1 / 131072) + 1536);
      p1 < 0 ? p1 = 0 : p1 > 16383 ? p1 = 16383;
      c1 = i824(T_RESCOEF, (p1 * 131072) & 4294967295);
      s1 = i824(T_RESSCALE, (p1 * 131072) & 4294967295);
      p2 = s16(d_pitch + floor(na * d_par1 / 32768) + 2432);
      p2 < 0 ? p2 = 0 : p2 > 16383 ? p2 = 16383;
      c2 = i824(T_RESCOEF, (p2 * 131072) & 4294967295);
      s2 = i824(T_RESSCALE, (p2 * 131072) & 4294967295);
      p3 = s16(d_pitch + floor(nb * d_par1 / 65536) + 1936);
      p3 < 0 ? p3 = 0 : p3 > 16383 ? p3 = 16383;
      c3 = i824(T_RESCOEF, (p3 * 131072) & 4294967295);
      s3 = i824(T_RESSCALE, (p3 * 131072) & 4294967295);
      c1 = floor(c1 * 32636 / 32768);
      c2 = floor(c2 * 32636 / 32768);
      c3 = floor(c3 * 32636 / 32768);
    );
    s = floor(s16(noise) * amp / 65536);
    amp = (amp * 64763) >> 16;
    s > 0 ? (
      y10 = floor(s * s1 / 65536);
      y20 = floor(s * s2 / 65536);
      y30 = floor(s * s3 / 65536);
    ) : (
      y10 = -floor(-s * s1 / 65536);
      y20 = -floor(-s * s2 / 65536);
      y30 = -floor(-s * s3 / 65536);
    );
    y10 += floor(w32(y11 * c1) / 32768);
    y10 -= floor(w32(y12 * 32506) / 32768);
    y10 = cl16(y10);
    y12 = y11; y11 = y10;
    y20 += floor(w32(y21 * c2) / 32768);
    y20 -= floor(w32(y22 * 32506) / 32768);
    y20 = cl16(y20);
    y22 = y21; y21 = y20;
    y30 += floor(w32(y31 * c3) / 32768);
    y30 -= floor(w32(y32 * 32506) / 32768);
    y30 = cl16(y30);
    y32 = y31; y31 = y30;
    y10 += y20 + y30;
    y10 = cl16(y10);
    buf[0] = y10;
    buf[1] = y10;
    buf += 2;
  );
  DS[0] = amp;
  PN_Y1[0] = y11; PN_Y2[0] = y12; PN_S[0] = s1; PN_C[0] = c1;
  PN_Y1[1] = y21; PN_Y2[1] = y22; PN_S[1] = s2; PN_C[1] = c2;
  PN_Y1[2] = y31; PN_Y2[2] = y32; PN_S[2] = s3; PN_C[2] = c3;
);

function d_qpsk(sync, buf, size) local(ph, inc, ssp, sspi, db, sc, fs, ii, qq) (
  ph = d_phase;
  inc = d_pinc;
  ssp = DS[0];
  sspi = cpi(s16(d_pitch - 1536 + floor((d_par0 - 32767) / 8)));
  db = DS[1];
  d_strike ? (
    DS[2] = 0;
    d_strike = 0;
  );
  sc = DS[2];
  fs = DS[3];
  loop(size,
    ph = (ph + inc) & 4294967295;
    ssp = (ssp + sspi) & 4294967295;
    ssp < sspi ? (
      sc = (sc + 1) & 65535;
      !(sc & 3) ? (
        sc >= 1088 ? sc = 0;
        sc < 32 ? db = 0 : sc < 48 ? db = 153 : sc < 64 ? db = 204 : (
          fs = floor((fs * 3 + d_par1) / 4);
          db = (fs >> 7) & 255;
        );
      ) : (
        db = db >> 2;
      );
    );
    ii = i824(T_SINE, ph);
    qq = i824(T_SINE, (ph + 1073741824) & 4294967295);
    buf[0] = s16(floor(T_CQ[db & 3] * qq / 32768) + floor(T_CI[db & 3] * ii / 32768));
    buf += 1;
  );
  d_phase = ph;
  DS[0] = ssp;
  DS[1] = db;
  DS[2] = sc;
  DS[3] = fs;
);

function d_qmark(sync, buf, size) local(ph, inc, dit, nth, smp, addr, sh, ni, noise, dist, cp, cpi_, rs, smv, sd) (
  d_strike ? (
    DS[2] = 0;
    DS[0] = 0;
    DS[4] = 10;
    DS[1] = 4294967295;
    DS[3] = 32767;
    d_strike = 0;
  );
  ph = d_phase;
  inc = d_pinc;
  dit = 3600 + ((32767 - d_par0) >> 2);
  nth = 1024 + (d_par1 >> 3);
  cp = DS[0]; cpi_ = DS[1]; rs = DS[2]; sd = DS[3]; smv = DS[4];
  loop(size,
    ph = (ph + inc) & 4294967295;
    smp = rs ? floor(i824(T_SINE, ph) * 3 / 4) : 0;
    cp = (cp + 1) & 4294967295;
    cp > dit ? (
      smv = s16(smv - 1);
      smv === 0 ? (
        cpi_ = (cpi_ + 1) & 4294967295;
        rs = !rs;
        addr = cpi_ >> 2;
        sh = (cpi_ & 3) * 2;
        smv = s16((2 << ((T_WTCODE[addr] >> sh) & 3)) - 1);
        smv === 15 ? (
          smv = 100;
          rs = 0;
          cpi_ = 4294967295;
        );
        ph = 1073741824;
      );
      cp = 0;
    );
    sd = w32(sd + floor(rand_sample() / 4));
    ni = floor(sd / 256);
    ni < 0 ? ni = -ni;
    ni < nth ? ni = nth;
    ni > 16000 ? ni = 16000;
    noise = floor(rand_sample() * ni / 32768);
    noise = floor(noise * T_SINE[(ph >> 22) & 255] / 32768);
    smp += noise;
    smp = cl16(smp);
    dist = floor(smp * smp / 16384);
    smp += floor(dist * d_par1 / 32768);
    smp = cl16(smp);
    buf[0] = smp;
    buf += 1;
  );
  DS[0] = cp; DS[1] = cpi_; DS[2] = rs; DS[3] = sd; DS[4] = smv;
  d_phase = ph;
);

function d_render(sync, buf, size) local(ig, fr, a, b, s) (
  (d_shape >= 12 && d_shape <= 14) ? (
    ig = d_par1 >> 8;
    fr = d_par1 & 255;
    a = s16(T_FMQ[ig]);
    b = s16(T_FMQ[ig + 1]);
    d_par1 = s16(a + floor((b - a) * fr / 256));
  );
  d_shape !== d_pshape ? (
    d_init();
    d_pshape = d_shape;
    d_init_ = 1;
  );
  d_pinc = cpi(d_pitch);
  d_delay = cdelay(d_pitch);
  d_pitch > 17920 ? d_pitch = 17920 : d_pitch < 0 ? d_pitch = 0;
  s = d_shape;
  (s === 2 || s === 15 || s === 17) ? dl_use16();
  s === 16 ? dl_view = 1 : (s === 18 ? dl_view = 2);
  s < 8 ? (
    s === 0 ? d_ringmod(sync, buf, size) :
    s === 1 ? d_swarm(sync, buf, size) :
    s === 2 ? d_comb(sync, buf, size) :
    s === 3 ? d_toy(sync, buf, size) :
    d_filter(sync, buf, size);
  ) : s < 16 ? (
    s === 8 ? d_vosim(sync, buf, size) :
    s === 9 ? d_vowel(sync, buf, size) :
    s === 10 ? d_fof(sync, buf, size) :
    s === 11 ? d_harm(sync, buf, size) :
    s === 12 ? d_fm(sync, buf, size) :
    s === 13 ? d_ffm(sync, buf, size) :
    s === 14 ? d_cfm(sync, buf, size) :
    d_pluck(sync, buf, size);
  ) : s < 24 ? (
    s === 16 ? d_bowed(sync, buf, size) :
    s === 17 ? d_blown(sync, buf, size) :
    s === 18 ? d_fluted(sync, buf, size) :
    s === 19 ? d_bell(sync, buf, size) :
    s === 20 ? d_drum(sync, buf, size) :
    s === 21 ? d_kick(sync, buf, size) :
    s === 22 ? d_cymbal(sync, buf, size) :
    d_snare(sync, buf, size);
  ) : (
    s === 24 ? d_wtbl(sync, buf, size) :
    s === 25 ? d_wmap(sync, buf, size) :
    s === 26 ? d_wline(sync, buf, size) :
    s === 27 ? d_wpara(sync, buf, size) :
    s === 28 ? d_fnoise(sync, buf, size) :
    s === 29 ? d_twinq(sync, buf, size) :
    s === 30 ? d_clkn(sync, buf, size) :
    s === 31 ? d_cloud(sync, buf, size) :
    s === 32 ? d_prtc(sync, buf, size) :
    s === 33 ? d_qpsk(sync, buf, size) :
    d_qmark(sync, buf, size);
  );
);

// ---------------------------------------------------------------------- macro oscillator

function m_init() (
  ao0.ao_init(); ao1.ao_init(); ao2.ao_init();
  d_init();
  m_lp = 0;
  m_ppar0 = 0;
  m_ppar1 = 0;
);

function m_set_shape(sh) (
  sh !== m_shape ? d_strike = 1;
  m_shape = sh;
);

function m_csaw(sync, buf, size) local(sh, k) (
  ao0.pitch = m_pitch; ao0.shape = 2; ao0.par = m_par0; ao0.aux = m_par1;
  ao0.ao_render(sync, buf, -1, size);
  sh = s16(floor(-(m_par1 - 32767) / 16));
  k = 0;
  loop(size, buf[k] = s16(floor((buf[k] + sh) * 13 / 8)); k += 1;);
);

function m_morph(sync, buf, size) local(bal, cut, f, lp, fz, k, smp, sh, fzd) (
  ao0.pitch = m_pitch;
  ao1.pitch = m_pitch;
  m_par0 <= 10922 ? (
    ao0.par = 0; ao1.par = 0; ao0.shape = 4; ao1.shape = 0;
    bal = (m_par0 * 6) & 65535;
  ) : m_par0 <= 21845 ? (
    ao0.par = 0; ao1.par = 0; ao0.shape = 3; ao1.shape = 0;
    bal = (65535 - (m_par0 - 10923) * 6) & 65535;
  ) : (
    ao0.par = s16((m_par0 - 21846) * 3); ao1.par = 0; ao0.shape = 3; ao1.shape = 5;
    bal = 0;
  );
  ao0.ao_render(sync, buf, -1, size);
  ao1.ao_render(sync, TMPB, -1, size);
  cut = m_pitch - (m_par1 >> 1) + 16384;
  cut < 0 ? cut = 0 : cut > 32767 ? cut = 32767;
  f = i824(T_SVFCUT, (cut * 131072) & 4294967295);
  lp = m_lp;
  fz = m_par1 * 2;
  m_pitch > 10240 ? (
    fz -= (m_pitch - 10240) * 16;
    fz < 0 ? fz = 0;
  );
  k = 0;
  loop(size,
    smp = mix(buf[k], TMPB[k], bal);
    lp += floor(w32((smp - lp) * f) / 32768);
    lp = cl16(lp);
    sh = lp + 32768;
    fzd = i88(T_VIOLOD, sh);
    buf[k] = mix(smp, fzd, fz & 65535);
    k += 1;
  );
  m_lp = lp;
);

function m_sawsq(sync, buf, size) local(ps, pd, pinc_, pxf, p1, k) (
  ao0.par = m_par0; ao1.par = m_par0;
  ao0.pitch = m_pitch; ao1.pitch = m_pitch;
  ao0.shape = 1; ao1.shape = 3;
  ao0.ao_render(sync, buf, -1, size);
  ao1.ao_render(sync, TMPB, -1, size);
  ps = m_ppar1; pd = m_par1 - m_ppar1; pinc_ = floor(32767 / size); pxf = 0;
  k = 0;
  loop(size,
    pxf += pinc_;
    p1 = ps + floor(pd * pxf / 32768);
    buf[k] = mix(buf[k], floor(TMPB[k] * 148 / 256), (p1 * 2) & 65535);
    k += 1;
  );
  m_ppar1 = m_par1;
);

function m_triple(sync, buf, size) local(base, i, pr, d1, d2, xf, det, j) (
  base = m_shape === 9 ? 0 : m_shape === 11 ? 4 : m_shape === 10 ? 3 : 5;
  ao0.par = 0; ao1.par = 0; ao2.par = 0;
  ao0.pitch = m_pitch;
  i = 0;
  loop(2,
    pr = i === 0 ? m_par0 : m_par1;
    d1 = T_INTERVALS[pr >> 9];
    d2 = T_INTERVALS[((pr >> 8) + 1) >> 1];
    xf = (pr * 256) & 65535;
    det = s16(d1 + floor((d2 - d1) * xf / 65536));
    i === 0 ? ao1.pitch = s16(m_pitch + det) : ao2.pitch = s16(m_pitch + det);
    i += 1;
  );
  ao0.shape = base; ao1.shape = base; ao2.shape = base;
  memset(buf, 0, size);
  ao0.ao_render(sync, TMPB, -1, size);
  j = 0; loop(size, buf[j] = s16(buf[j] + floor(TMPB[j] * 21 / 64)); j += 1;);
  ao1.ao_render(sync, TMPB, -1, size);
  j = 0; loop(size, buf[j] = s16(buf[j] + floor(TMPB[j] * 21 / 64)); j += 1;);
  ao2.ao_render(sync, TMPB, -1, size);
  j = 0; loop(size, buf[j] = s16(buf[j] + floor(TMPB[j] * 21 / 64)); j += 1;);
);

function m_sub(sync, buf, size) local(oc, ps, pd, pinc_, pxf, p1, k, sg) (
  ao0.par = m_par0;
  ao0.shape = m_shape === 5 ? 3 : 1;
  ao0.pitch = m_pitch;
  ao1.par = 0;
  ao1.shape = 3;
  oc = m_par1 < 16384 ? 3072 : 1536;
  ao1.pitch = s16(m_pitch - oc);
  ao0.ao_render(sync, buf, -1, size);
  ao1.ao_render(sync, TMPB, -1, size);
  ps = m_ppar1; pd = m_par1 - m_ppar1; pinc_ = floor(32767 / size); pxf = 0;
  k = 0;
  loop(size,
    pxf += pinc_;
    p1 = ps + floor(pd * pxf / 32768);
    sg = ((p1 < 16384 ? 16383 - p1 : p1 - 16384) * 2) & 65535;
    buf[k] = mix(buf[k], TMPB[k], sg);
    k += 1;
  );
  m_ppar1 = m_par1;
);

