  midisend_buf(mofs, MBUF, mlen);
);
g_kbon > 0 ? ( note_on(g_kbon - 1, 100); g_kbon = 0; );
g_kboff > 0 ? ( note_off(g_kboff - 1); g_kboff = 0; );
out_t = 10 ^ (k_out / 20);
gn_c = 1 - exp(-1 / (0.005 * srate));
host_block(samplesblock);
spos = 0;
pdc_bot_ch = 0;
pdc_top_ch = 0;
pdc_delay = 0;

@sample

spl0 = spl1 = OUTH[spos];
spos += 1;

@gfx 900 578

UDW = 900;
UDH = 578;
uscale = max(0.5, min(gfx_w / UDW, gfx_h / UDH));
uox = floor((gfx_w - UDW * uscale) * 0.5);
uoy = 0;

