  s == 10 ? strcpy(#uct, v < 0.5 ? "4KHZ" : v < 1.5 ? "8KHZ" : v < 2.5 ? "16K" : v < 3.5 ? "24K" : v < 4.5 ? "32K" : v < 5.5 ? "48K" : "96K") :
  (s == 11 || s == 13) ? strcpy(#uct, inten(v)) :
