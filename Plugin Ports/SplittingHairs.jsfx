  m == 25 ? "FM" : m == 26 ? "Feedback FM" : m == 27 ? "Chaotic FM" : m == 28 ? "Plucked" : m == 29 ? "Bowed" :
  m == 30 ? "Blown" : m == 31 ? "Fluted" : m == 32 ? "Bell" : m == 33 ? "Drum" : m == 34 ? "Kick" :
  m == 35 ? "Cymbal" : m == 36 ? "Snare" : m == 37 ? "Wavetables" : m == 38 ? "Wave Map" : m == 39 ? "Wave Line" :
  m == 40 ? "Wave Chords" : m == 41 ? "Filtered Noise" : m == 42 ? "Twin Peaks Noise" : m == 43 ? "Clocked Noise" :
  m == 44 ? "Granular Cloud" : m == 45 ? "Particle Noise" : "QPSK";
);
function tim_name(m) (
  m == 0 ? "notch width" : m == 1 ? "waveform" : m == 2 ? "shape" : m == 3 ? "fold" : m == 4 ? "brightness" :
  m == 5 ? "pulse width" : m == 6 ? "saw shape" : m <= 8 ? "slave pitch" : m <= 12 ? "voice 2 interval" :
  m == 13 ? "modulator 1" : m == 14 ? "detune" : m == 15 ? "comb delay" : m == 16 ? "sample rate" :
  m <= 20 ? "cutoff" : m == 21 ? "formant 1" : m <= 23 ? "vowel" : m == 24 ? "peak" : m <= 27 ? "index" :
  m == 28 ? "decay" : m == 29 ? "friction" : m <= 31 ? "breath" : m <= 34 ? "decay" : m == 35 ? "cutoff" :
  m == 36 ? "tone / noise" : m == 37 ? "position" : m == 38 ? "x" : m == 39 ? "scan" : m == 40 ? "wave" :
  m == 41 ? "resonance" : m == 42 ? "resonance" : m == 43 ? "cycle length" : m <= 45 ? "density" : "symbol rate";
);
function col_name(m) (
  m == 0 ? "notch depth" : m == 1 ? "filter + fuzz" : m == 2 ? "saw / square" : m == 3 ? "sine / triangle" : m == 4 ? "detune" :
  m <= 6 ? "sub level + octave" : m <= 8 ? "master / slave" : m <= 12 ? "voice 3 interval" :
  m == 13 ? "modulator 2" : m == 14 ? "high-pass" : m == 15 ? "feedback" : m == 16 ? "bit pattern" :
  m <= 20 ? "waveform" : m == 21 ? "formant 2" : m == 22 ? "formant shift" : m == 23 ? "voice type" : m == 24 ? "width" :
  m <= 27 ? "ratio" : m == 28 ? "pluck position" : m == 29 ? "bow position" : m == 30 ? "body" : m == 31 ? "jet length" :
  m == 32 ? "inharmonicity" : m == 33 ? "noise / tone" : m == 34 ? "brightness" : m == 35 ? "noise / metal" : m == 36 ? "snappy" :
  m == 37 ? "table" : m == 38 ? "y" : m == 39 ? "smoothing" : m == 40 ? "chord" : m == 41 ? "LP / BP / HP" : m == 42 ? "second peak" :
  m == 43 ? "quantisation" : m <= 45 ? "dispersion" : "data";
);
function model_hint(m) (
  m == 0 ? "CSAW: the CS-80's notched sawtooth. TIMBRE widens the notch, COLOR sets its depth." :
  m == 1 ? "Morph: triangle, saw, square and pulse in one sweep. COLOR adds a low-pass filter and fuzz." :
  m == 2 ? "Saw / Square: variable saw and square with the same shape control. COLOR blends them." :
  m == 3 ? "Fold: sine and triangle through wavefolders. TIMBRE folds, COLOR blends the two." :
  m == 4 ? "Buzz: two band-limited comb waves. TIMBRE sets the brightness, COLOR detunes the pair." :
  m == 5 ? "Square Sub: square with a sub-oscillator. TIMBRE is the pulse width; COLOR the sub level, one octave down then two." :
  m == 6 ? "Saw Sub: saw with a sub-oscillator. TIMBRE shapes the saw; COLOR the sub level, one octave down then two." :
  m == 7 ? "Square Sync: two hard-synced squares. TIMBRE tunes the slave, COLOR blends master and slave." :
  m == 8 ? "Saw Sync: two hard-synced saws. TIMBRE tunes the slave, COLOR blends master and slave." :
  m <= 12 ? "Triple oscillator: TIMBRE and COLOR set the intervals of the second and third voices (unison in the middle)." :
  m == 13 ? "Ring Mod: a sine ring-modulated by two more. TIMBRE and COLOR tune the two modulators." :
  m == 14 ? "Saw Swarm: seven detuned saws. TIMBRE detunes, COLOR sets a high-pass filter." :
  m == 15 ? "Saw Comb: saw through a comb filter. TIMBRE sets the delay, COLOR the feedback, negative to positive." :
  m == 16 ? "Toy: bit-twiddled clocked wave of a toy keyboard. TIMBRE sets the clock rate, COLOR the bit pattern." :
  m <= 20 ? "Direct synthesis of a resonant filter's output. TIMBRE is the cutoff, COLOR the input waveform." :
  m == 21 ? "VOSIM: formant synthesis. TIMBRE and COLOR set the two formant frequencies." :
  m == 22 ? "Vowel: speech-like vowels; each note speaks a consonant first. TIMBRE picks the vowel, COLOR shifts formants." :
  m == 23 ? "Vowel FOF: a formant filter bank. TIMBRE picks the vowel, COLOR the voice, from bass to soprano." :
  m == 24 ? "Harmonics: additive, 12 harmonics. TIMBRE moves the spectral peak, COLOR its width and a second peak." :
  m == 25 ? "FM: two-operator FM. TIMBRE is the index, COLOR the frequency ratio." :
  m == 26 ? "Feedback FM: FM with modulator feedback. TIMBRE is the index, COLOR the ratio." :
  m == 27 ? "Chaotic FM: the carrier feeds back into the modulator's pitch. TIMBRE is the index, COLOR the ratio." :
  m == 28 ? "Plucked: three-voice plucked string. Each note plucks; TIMBRE sets the decay, COLOR the pluck position." :
  m == 29 ? "Bowed: bowed string. Each note restarts the bow; TIMBRE sets the friction, COLOR the bow position." :
  m == 30 ? "Blown: reed instrument. TIMBRE adds breath noise, COLOR changes the body." :
  m == 31 ? "Fluted: flute. Each note blows; TIMBRE adds breath noise, COLOR sets the jet length." :
  m == 32 ? "Bell: struck bell, 11 partials. TIMBRE sets the decay (fully right never decays), COLOR the inharmonicity." :
  m == 33 ? "Drum: struck drum. TIMBRE sets the decay, COLOR moves from tone to noise." :
  m == 34 ? "Kick: analog-style kick. TIMBRE sets the decay, COLOR the brightness." :
  m == 35 ? "Cymbal: TIMBRE sets the filter cutoff, COLOR blends metallic tones and noise." :
  m == 36 ? "Snare: TIMBRE balances the two drum modes, COLOR adds snappy noise." :
  m == 37 ? "Wavetables: 20 tables. TIMBRE scans the table, COLOR picks it." :
  m == 38 ? "Wave Map: a 16 x 16 map of waves. TIMBRE and COLOR are the coordinates." :
  m == 39 ? "Wave Line: scans a line of waves. TIMBRE scans, COLOR goes from stepped to smooth to stepped again." :
  m == 40 ? "Wave Chords: four-voice paraphonic chords. TIMBRE picks the wave, COLOR the chord." :
  m == 41 ? "Filtered Noise: TIMBRE sets the resonance, COLOR moves from low-pass to band-pass to high-pass." :
  m == 42 ? "Twin Peaks Noise: noise through two resonators. TIMBRE sets the resonance, COLOR the second peak." :
  m == 43 ? "Clocked Noise: sample-and-hold noise at the note's clock. TIMBRE sets the cycle length, COLOR the quantisation." :
  m == 44 ? "Granular Cloud: sine grains. TIMBRE sets the density, COLOR the pitch spread." :
  m == 45 ? "Particle Noise: dust through resonators. TIMBRE sets the density, COLOR the frequency spread." :
  "QPSK: digital modulation noise. TIMBRE sets the symbol rate, COLOR the data.";
);
function hint_text(s) (
  s == 1 ? "EDIT: drag or scroll to choose the model  ·  right-click for a menu" :
  s == 2 ? "FINE: fine tune, one semitone either way." :
  s == 3 ? "COARSE: tuning in semitones, four octaves either way." :
  s == 4 ? "FM: attenuverter for the FM input, fed by the mod wheel. In META mode it selects the model instead." :
  s == 5 ? "TIMBRE: the model's main timbre control (see the description under the knob)." :
  s == 6 ? "MODULATION: TIMBRE CV attenuverter; the CV is the note velocity." :
  s == 7 ? "COLOR: the model's second timbre control; channel aftertouch adds to it." :
  s == 8 ? "META: the FM input (mod wheel x FM knob) scans the models instead of modulating pitch." :
  s == 9 ? "BITS: bit-depth reduction of the output, 2 to 16 bits." :
  s == 10 ? "RATE: sample-rate reduction of the output, 4 to 96 kHz." :
  s == 11 ? "SIGN: the module's signature waveshaper (a fixed unit here)." :
  s == 12 ? "FLAT: emulates analog VCO tracking errors at the extremes." :
  s == 13 ? "DRFT: slow random pitch drift." :
  s == 14 ? "TSRC: EXT. triggers on note-ons; AUTO also on every pitch change of half a semitone or more." :
  s == 15 ? "AD ATT: attack of the internal AD envelope (and of the note in GATE play mode)." :
  s == 16 ? "AD DEC: decay of the internal AD envelope (and the release of the note in GATE play mode)." :
  s == 17 ? "AD→FM: envelope amount to pitch." :
  s == 18 ? "AD→TIM: envelope amount to TIMBRE." :
  s == 19 ? "AD→COL: envelope amount to COLOR." :
  s == 20 ? "AD→VCA: the AD envelope sets the output level, for percussive notes." :
  s == 21 ? "PLAY: GATE sounds while notes are held; DRONE always sounds, as the module with no VCA." :
  s == 22 ? "RANG: EXT. follows the notes; 440 is a fixed A4; LFO drops everything three octaves." :
  s == 23 ? "OCTV: octave transposition." :
  s == 24 ? "QNTZ: pitch quantiser scale (49 scales and ragas)." :
  s == 25 ? "ROOT: root of the quantiser scale." :
  s == 26 ? "BEND: pitch-bend range in semitones." :
  s == 27 ? "OUT: output level (the module's own level is 0 dB)." :
  s >= 100 && s < 147 ? model_hint(s - 100) :
  s == 200 ? "Keyboard: click to play" :
  "Drag or scroll a knob or setting  ·  click a setting to step it, right-click for a list  ·  double-click to reset";
);
function automate(s, e)
(
<?
  max_sliders > 27 ? printf("slider_automate(2^(s-1), e);") :
    printf("s == 1 ? slider_automate(k_model, e) : s == 2 ? slider_automate(k_fine, e) : s == 3 ? slider_automate(k_coarse, e) : s == 4 ? slider_automate(k_fm, e) : s == 5 ? slider_automate(k_timbre, e) : s == 6 ? slider_automate(k_mod, e) : s == 7 ? slider_automate(k_color, e) : s == 8 ? slider_automate(k_meta, e) : s == 9 ? slider_automate(k_bits, e) : s == 10 ? slider_automate(k_rate, e) : s == 11 ? slider_automate(k_sign, e) : s == 12 ? slider_automate(k_flat, e) : s == 13 ? slider_automate(k_drift, e) : s == 14 ? slider_automate(k_tsrc, e) : s == 15 ? slider_automate(k_att, e) : s == 16 ? slider_automate(k_dec, e) : s == 17 ? slider_automate(k_adfm, e) : s == 18 ? slider_automate(k_adtim, e) : s == 19 ? slider_automate(k_adcol, e) : s == 20 ? slider_automate(k_advca, e) : s == 21 ? slider_automate(k_play, e) : s == 22 ? slider_automate(k_range, e) : s == 23 ? slider_automate(k_octave, e) : s == 24 ? slider_automate(k_qntz, e) : s == 25 ? slider_automate(k_root, e) : s == 26 ? slider_automate(k_bend, e) : s == 27 ? slider_automate(k_out, e) : 0;");
?> 0;
);

function set_slider(s, x) ( slider(s) = x; automate(s, 0); automate(s, 1); );
function hit_circle(mx, my, cx, cy, rad) ( sqr(mx - cx) + sqr(my - cy) <= sqr(rad); );
function hit_rect(mx, my, x, y, w, h) ( mx >= x && mx <= x + w && my >= y && my <= y + h; );
function px(x) ( uox + x * uscale; );
function py(y) ( uoy + y * uscale; );

function norm_of(s) ( (slider(s) - s_min(s)) / (s_max(s) - s_min(s)); );
function set_norm(s, x) local(old, st) (
  old = slider(s);
  st = s_step(s);
  slider(s) = st > 0 ? s_min(s) + floor(x * (s_max(s) - s_min(s)) / st + 0.5) * st : s_min(s) + x * (s_max(s) - s_min(s));
  slider(s) !== old ? ( automate(s, 0); );
);

function ctext(str, cx, y, fs, fl) local(tw, th)
(
  gfx_setfont(1, "Arial", fs * uscale, fl);
  gfx_measurestr(str, tw, th);
  gfx_x = cx - tw * 0.5; gfx_y = y;
  gfx_drawstr(str);
);

function ltext(str, x, y, fs, fl)
(
  gfx_setfont(1, "Arial", fs * uscale, fl);
  gfx_x = x; gfx_y = y;
  gfx_drawstr(str);
);

function rk_draw(cx, cy, rad, pos, cr, cg, cb) local(ang0, ang1, ang, i, a, rr, ca, sa, n)
(
  ang0 = -2.35619;
  ang1 = 2.35619;
  gfx_set(0, 0, 0, 0.18);
  gfx_circle(cx + rad * 0.06, cy + rad * 0.10, rad * 1.02, 1, 1);
  gfx_set(0.07, 0.07, 0.08, 1);
  gfx_circle(cx, cy, rad, 1, 1);
  i = 0;
  loop(36,
    a = i * 2 * $pi / 36;
    gfx_set(0.20, 0.20, 0.22, 1);
    gfx_line(cx + sin(a) * rad * 0.80, cy - cos(a) * rad * 0.80, cx + sin(a) * rad * 0.97, cy - cos(a) * rad * 0.97, 1);
    i += 1;
  );
  gfx_set(0.13, 0.13, 0.14, 1);
  gfx_circle(cx, cy, rad * 0.76, 1, 1);
  ang = ang0 + (ang1 - ang0) * pos;
  sa = sin(ang); ca = cos(ang);
  rr = rad * 0.08;
  n = max(7, 2 * floor(rad * 0.16) + 1);
  i = 0;
  loop(n,
    a = (i - (n - 1) / 2) / ((n - 1) / 2) * rr;
    gfx_set(cr, cg, cb, 1);
    gfx_line(cx + sa * rad * 0.50 + ca * a, cy - ca * rad * 0.50 + sa * a, cx + sa * rad * 0.96 + ca * a, cy - ca * rad * 0.96 + sa * a, 1);
    i += 1;
  );
  gfx_set(cr * 0.64, cg * 0.64, cb * 0.64, 1);
  gfx_circle(cx, cy, rad * 0.56, 1, 1);
  gfx_set(cr, cg, cb, 1);
  gfx_circle(cx, cy, rad * 0.53, 1, 1);
  gfx_set(1, 1, 1, 0.45);
  gfx_circle(cx - rad * 0.10, cy - rad * 0.12, rad * 0.30, 1, 1);
  gfx_set(cr * 0.78, cg * 0.78, cb * 0.78, 1);
  gfx_line(cx + sa * rad * 0.20, cy - ca * rad * 0.20, cx + sa * rad * 0.50, cy - ca * rad * 0.50, 1);
);

function pill_col(kind)
(
  kind == 1 ? gfx_set(0.91, 0.18, 0.42, 1) :
  kind == 2 ? gfx_set(0.10, 0.72, 0.78, 1) :
  kind == 3 ? gfx_set(0.70, 0.08, 0.42, 1) :
  gfx_set(0.95, 0.55, 0.15, 1);
);

function label_pill(str, cx, y, kind, big) local(tw, th, fs)
(
  fs = big ? 15 : 14;
  gfx_setfont(1, "Arial", fs * uscale, 'b');
  gfx_measurestr(str, tw, th);
  kind > 0 ? (
    pill_col(kind);
    gfx_rect(cx - tw * 0.5 - 5 * uscale, y - 1 * uscale, tw + 10 * uscale, th + 2 * uscale, 1);
    gfx_set(1, 1, 1, 1);
  ) : gfx_set(0.12, 0.12, 0.13, 1);
  gfx_x = cx - tw * 0.5; gfx_y = y;
  gfx_drawstr(str);
);

function rosette(cx, cy, r0) local(i, a, r1)
(
  i = 0;
  loop(60,
    a = i * 2 * $pi / 60;
    r1 = r0 * ((i & 1) ? 1.20 : 1.12);
    gfx_set(0.45, 0.46, 0.48, (i & 1) ? 0.30 : 0.18);
    gfx_line(cx + sin(a) * r0 * 1.04, cy - cos(a) * r0 * 1.04, cx + sin(a) * r1, cy - cos(a) * r1, 1);
    gfx_circle(cx + sin(a + 0.05) * r0 * 1.26, cy - cos(a + 0.05) * r0 * 1.26, max(1, 1.2 * uscale), 0, 1);
    i += 1;
  );
);

function knob_core(s, cx, cy, rad, kind) local(hov, x, cr, cg, cb)
(
  hov = hit_circle(mouse_x, mouse_y, cx, cy, rad + 4 * uscale);
  hov ? u_hov = s;
  (u_click && hov) ? (
    (u_ctarget == s && time_precise() - u_ctime < 0.3) ? (
      set_slider(s, def_val(s));
      u_drag = 0;
    ) : (
      u_drag = s; u_dy0 = mouse_y; u_dv0 = norm_of(s); u_dfine = mouse_cap & 4;
      automate(s, 0);
    );
    u_ctarget = s; u_ctime = time_precise();
    u_click = 0;
  );
  (hov && u_wheel != 0 && u_drag == 0) ? (
    x = norm_of(s) + (u_wheel / 120) * ((mouse_cap & 4) ? 0.002 : 0.02);
    set_norm(s, max(0, min(1, x)));
    automate(s, 1);
    u_wheel = 0;
  );
  kind == 1 ? ( cr = 0.93; cg = 0.27; cb = 0.47; ) :
  kind == 2 ? ( cr = 0.20; cg = 0.78; cb = 0.84; ) :
  kind == 3 ? ( cr = 0.72; cg = 0.10; cb = 0.45; ) :
  ( cr = 0.97; cg = 0.97; cb = 0.96; );
  rk_draw(cx, cy, rad, norm_of(s), cr, cg, cb);
  hov;
);

function knob_at(s, cx, cy, rad, big, kind) local(hov, ly)
(
  big ? rosette(cx, cy, rad);
  hov = knob_core(s, cx, cy, rad, kind);
  ly = cy + rad * (big ? 1.30 : 1.12) + 4 * uscale;
  label_pill(knob_name(s), cx, ly, kind, big);
  gfx_set((hov || u_drag == s) ? 0.78 : 0.36, (hov || u_drag == s) ? 0.42 : 0.37, (hov || u_drag == s) ? 0.10 : 0.40, 1);
  ctext(ptext(s), cx, ly + 18 * uscale, 12, 0);
);

function led(cx, cy, r, g, b, lv)
(
  gfx_set(0.55, 0.55, 0.56, 1);
  gfx_circle(cx, cy, 8 * uscale, 1, 1);
  gfx_set(0.93, 0.93, 0.92, 1);
  gfx_circle(cx, cy, 6.5 * uscale, 1, 1);
  lv > 0.01 ? (
    gfx_set(r, g, b, 0.35 * lv); gfx_circle(cx, cy, 11 * uscale, 1, 1);
    gfx_set(r, g, b, 0.25 + 0.75 * lv); gfx_circle(cx, cy, 6.5 * uscale, 1, 1);
  );
  gfx_set(1, 1, 1, 0.6);
  gfx_circle(cx - 2 * uscale, cy - 2 * uscale, 2 * uscale, 1, 1);
);

function dark_btn(s, x, y, w, h, label, act, fs) local(tw, th, hov)
(
  hov = hit_rect(mouse_x, mouse_y, x, y, w, h);
  hov ? u_hov = s;
  gfx_set(0.10, 0.10, 0.11, 1);
  gfx_rect(x - uscale, y - uscale, w + 2 * uscale, h + 2 * uscale, 1);
  act ? gfx_set(0.93, 0.50, 0.16, 1) : gfx_set(hov ? 0.30 : 0.24, hov ? 0.30 : 0.24, hov ? 0.32 : 0.26, 1);
  gfx_rect(x, y, w, h, 1);
  gfx_set(1, 1, 1, act ? 0.20 : 0.07);
  gfx_rect(x, y, w, h * 0.45, 1);
  gfx_setfont(1, "Arial", fs * uscale, 'b');
  act ? gfx_set(0.10, 0.07, 0.04, 1) : gfx_set(0.90, 0.90, 0.91, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + (w - tw) * 0.5; gfx_y = y + (h - th) * 0.5;
  gfx_drawstr(label);
  u_click && hov;
);

function seg(s, x, y, w, h, n, base) local(i, sw)
(
  sw = w / n;
  i = 0;
  loop(n,
    dark_btn(s, x + i * sw, y, sw - 2 * uscale, h, seg_label(s, i), (slider(s) | 0) == i + base, 12) ? ( set_slider(s, i + base); u_click = 0; );
    i += 1;
  );
);

function cap(str, x, y)
(
  gfx_set(0.12, 0.12, 0.13, 1);
  ltext(str, x, y, 12, 'b');
);

function field(s, x, y, w, h) local(hov, v)
(
  hov = hit_rect(mouse_x, mouse_y, x, y, w, h);
  hov ? u_hov = s;
  gfx_set(0.10, 0.10, 0.11, 1);
  gfx_rect(x - uscale, y - uscale, w + 2 * uscale, h + 2 * uscale, 1);
  gfx_set(hov || u_drag == s ? 0.30 : 0.24, hov || u_drag == s ? 0.30 : 0.24, hov || u_drag == s ? 0.32 : 0.26, 1);
  gfx_rect(x, y, w, h, 1);
  gfx_set(0.90, 0.90, 0.91, 1);
  ctext(ptext(s), x + w * 0.5, y + (h - 14 * uscale) * 0.5, 12, 'b');
  (u_click && hov) ? (
    (u_ctarget == s && time_precise() - u_ctime < 0.3) ? ( set_slider(s, def_val(s)); u_drag = 0; ) :
    ( u_drag = s; u_dy0 = mouse_y; u_dv0 = norm_of(s); u_dfine = mouse_cap & 4; automate(s, 0); );
    u_ctarget = s; u_ctime = time_precise();
    u_click = 0;
  );
  (hov && u_wheel != 0 && u_drag == 0) ? (
    v = slider(s) + (u_wheel > 0 ? 1 : -1) * s_step(s);
    slider(s) = max(s_min(s), min(s_max(s), v));
    automate(s, 0); automate(s, 1);
    u_wheel = 0;
  );
);

function dots_h(x0, x1, y) local(x)
(
  gfx_set(0.16, 0.16, 0.18, 0.75);
  x = x0;
  while (x < x1) ( gfx_rect(x, y - uscale, max(1, 2 * uscale), max(1, 2 * uscale), 1); x += 6 * uscale; );
);
function dots_v(x, y0, y1) local(y)
(
  gfx_set(0.16, 0.16, 0.18, 0.75);
  y = y0;
  while (y < y1) ( gfx_rect(x - uscale, y, max(1, 2 * uscale), max(1, 2 * uscale), 1); y += 6 * uscale; );
);

function screw(cx, cy)
(
  gfx_set(0.62, 0.62, 0.63, 1); gfx_circle(cx, cy, 6 * uscale, 1, 1);
  gfx_set(0.93, 0.93, 0.93, 1); gfx_circle(cx, cy, 4.5 * uscale, 1, 1);
  gfx_set(0.55, 0.55, 0.57, 1);
  gfx_line(cx - 3 * uscale, cy - 3 * uscale, cx + 3 * uscale, cy + 3 * uscale, 1);
);

function panel_bg() local(useed)
(
  gfx_set(0.86, 0.865, 0.875, 1);
  gfx_rect(0, 0, gfx_w, gfx_h, 1);
  useed = 7;
  loop(140,
    useed = (useed * 1103 + 12345) % 65536;
    gfx_set(useed & 1 ? 1 : 0, useed & 1 ? 1 : 0, useed & 1 ? 1 : 0, 0.028);
    gfx_rect(px(0), py(useed / 65536 * UDH), UDW * uscale, max(1, uscale), 1);
  );
  screw(px(14), py(12)); screw(px(UDW - 14), py(12));
);

function panel_band(y) local(uby, i)
(
  uby = py(y);
  gfx_set(0.70, 0.71, 0.73, 1);
  gfx_rect(px(0), uby, UDW * uscale, 9 * uscale, 1);
  i = 0;
  loop(UDW / 4,
    gfx_set(0.52, 0.53, 0.56, 1);
    gfx_line(px(i * 4), uby + 8 * uscale, px(i * 4 + 6), uby + uscale, 1);
    i += 1;
  );
  gfx_set(0.97, 0.97, 0.97, 1);
  gfx_rect(px(0), uby + 9 * uscale, UDW * uscale, max(1, uscale), 1);
);

function panel_title(tt, sub, origin) local(tw, th)
(
  gfx_set(0.14, 0.14, 0.15, 1);
  gfx_setfont(1, "Arial", 30 * uscale);
  gfx_x = px(70); gfx_y = py(8);
  gfx_drawstr(tt);
  gfx_measurestr(tt, tw, th);
  gfx_setfont(1, "Arial", 17 * uscale);
  gfx_x = px(70) + tw + 16 * uscale; gfx_y = py(17);
  gfx_drawstr(sub);
  gfx_setfont(1, "Arial", 12 * uscale);
  gfx_set(0.36, 0.37, 0.40, 1);
  gfx_x = px(71); gfx_y = py(41);
  gfx_drawstr(origin);
);

function hint_bar(y) local(uhs, tw, th)
(
  gfx_set(0.20, 0.20, 0.21, 1);
  gfx_rect(px(0), py(y), UDW * uscale, 36 * uscale, 1);
  uhs = u_drag > 0 ? u_drag : u_hov;
  gfx_setfont(1, "Arial", 13 * uscale);
  gfx_set(0.80, 0.80, 0.82, 1);
  strcpy(#uhint, hint_text(uhs));
  gfx_measurestr(#uhint, tw, th);
  tw > (UDW - 20) * uscale ? ( gfx_setfont(1, "Arial", 13 * uscale * (UDW - 20) * uscale / tw); gfx_measurestr(#uhint, tw, th); );
  gfx_x = uox + (UDW * uscale - tw) * 0.5; gfx_y = py(y) + (36 * uscale - th) * 0.5;
  gfx_drawstr(#uhint);
);

function frame_begin()
(
  u_down = mouse_cap & 1;
  u_click = u_down && !u_pstate;
  u_wheel = mouse_wheel;
  mouse_wheel = 0;
  u_hov = 0;
);

function frame_end() local(ufine)
(
  u_drag > 0 ? (
    u_down ? (
      mouse_cap |= 65536;
      ufine = mouse_cap & 4;
      ufine != u_dfine ? ( u_dy0 = mouse_y; u_dv0 = norm_of(u_drag); u_dfine = ufine; );
      set_norm(u_drag, max(0, min(1, u_dv0 + (u_dy0 - mouse_y) / (150 * uscale) * (ufine ? 0.1 : 1))));
    ) : ( automate(u_drag, 1); u_drag = 0; );
  );
  u_pstate = u_down;
);

function gquad(x0, y0, x1, y1, t) local(dx, dy, ln, nx, ny) (
  dx = x1 - x0; dy = y1 - y0;
  ln = sqrt(dx * dx + dy * dy);
  ln > 0 ? (
    nx = -dy / ln * t * 0.5; ny = dx / ln * t * 0.5;
    gfx_triangle(x0 + nx, y0 + ny, x1 + nx, y1 + ny, x1 - nx, y1 - ny, x0 - nx, y0 - ny);
  );
);
function gsx(x, y) ( x; );
function gseg(bit, x0, y0, x1, y1) (
  ((g_cm & bit) ? 1 : 0) == g_cpass ? gquad(gsx(x0, y0), y0, gsx(x1, y1), y1, g_ct);
);
function ch14(x, y, w, h, code, pass) local(ll, rr, tt, bb, mm, cc, gg, t, d) (
  g_cm = FONT14[code & 255];
  g_cpass = pass;
  t = max(1, w * 0.14);
  g_ct = t;
  g_cb = y + h;
  ll = x; rr = x + w; tt = y; bb = y + h; mm = y + h * 0.5; cc = x + w * 0.5;
  gg = t * 0.75;
  d = t * 0.9;
  gseg(32768, ll + gg, tt, rr - gg, tt);
  gseg(16384, rr, tt + gg, rr, mm - gg);
  gseg(8192, rr, mm + gg, rr, bb - gg);
  gseg(4096, ll + gg, bb, rr - gg, bb);
  gseg(2048, ll, mm + gg, ll, bb - gg);
  gseg(1024, ll, tt + gg, ll, mm - gg);
  gseg(512, ll + d, tt + d, cc - t * 0.6, mm - d);
  gseg(256, cc, tt + gg, cc, mm - gg);
  gseg(128, rr - d, tt + d, cc + t * 0.6, mm - d);
  gseg(64, cc + gg, mm, rr - gg, mm);
  gseg(32, cc + t * 0.6, mm + d, rr - d, bb - d);
  gseg(16, cc, mm + gg, cc, bb - gg);
  gseg(8, cc - t * 0.6, mm + d, ll + d, bb - d);
  gseg(4, ll + gg, mm, cc - gg, mm);
);
function word14(codes, x, y, w, h, sp, lr, lg, lb, dr, dg, db) local(i) (
  dr >= 0 ? (
    gfx_set(dr, dg, db, 1);
    i = 0; loop(4, ch14(x + i * sp, y, w, h, codes[i], 0); i += 1;);
  );
  gfx_set(lr, lg, lb, 1);
  i = 0; loop(4, ch14(x + i * sp, y, w, h, codes[i], 1); i += 1;);
);
function str_codes(str) local(n, i) (
  n = strlen(str);
  i = 0;
  loop(4,
    DISPC[i] = i >= 4 - n ? str_getchar(str, i - (4 - n)) : 32;
    i += 1;
  );
  DISPC;
);

function grid_cache() local(i, cx, cy) (
  g_gw = floor(410 * uscale); g_gh = floor(158 * uscale);
  gfx_setimgdim(3, g_gw, g_gh);
  gfx_dest = 3;
  gfx_set(0.15, 0.16, 0.16, 1);
  gfx_rect(0, 0, g_gw, g_gh, 1);
  i = 0;
  loop(47,
    cx = (4 + (i % 8) * 51) * uscale;
    cy = (4 + floor(i / 8) * 26) * uscale;
    gfx_set(0.07, 0.08, 0.075, 1);
    gfx_rect(cx, cy, 47 * uscale, 22 * uscale, 1);
    word14(MCH + i * 4, cx + 6 * uscale, cy + 4 * uscale, 6.5 * uscale, 14 * uscale, 9.5 * uscale, 0.55, 0.66, 0.28, 0.14, 0.16, 0.13);
    i += 1;
  );
  gfx_dest = -1;
  g_cache_s = uscale;
);

function cell_menu(s) local(i, n, r, v) (
  #gm = "";
  n = s_max(s) - s_min(s) + 1;
  i = 0;
  loop(n,
    v = s_min(s) + i;
    i > 0 ? strcat(#gm, "|");
    (slider(s) | 0) == v ? strcat(#gm, "!");
    s == 24 ? strcat(#gm, qname(v)) :
    s == 26 ? ( sprintf(#gm2, "±%d semitones", v); strcat(#gm, #gm2); ) :
    strcat(#gm, cell_textv(s, v));
    i += 1;
  );
  gfx_x = mouse_x; gfx_y = mouse_y;
  r = gfx_showmenu(#gm);
  r > 0 ? ( set_slider(s, s_min(s) + r - 1); g_sets = s; g_sett = time_precise(); );
);

function cell(s, x, y, w) local(hov, v, h) (
  h = 26 * uscale;
  gfx_set(0.12, 0.12, 0.13, 1);
  ctext(cell_label(s), x + w * 0.5, y, 12, 'b');
  y += 15 * uscale;
  hov = hit_rect(mouse_x, mouse_y, x, y - 15 * uscale, w, h + 15 * uscale);
  hov ? u_hov = s;
  gfx_set(0.07, 0.08, 0.075, 1);
  gfx_rect(x - uscale, y - uscale, w + 2 * uscale, h + 2 * uscale, 1);
  gfx_set(hov ? 0.17 : 0.12, hov ? 0.19 : 0.135, hov ? 0.15 : 0.12, 1);
  gfx_rect(x, y, w, h, 1);
  v = slider(s);
  (s != 27 && v != def_val(s)) ? gfx_set(0.86, 1, 0.34, 1) : gfx_set(0.62, 0.74, 0.32, 1);
  ctext(cell_text(s), x + w * 0.5, y + (h - 15 * uscale) * 0.5, 13, 'b');
  hov && u_click ? (
    s == 27 ? (
      (u_ctarget == s && time_precise() - u_ctime < 0.3) ? ( set_slider(s, def_val(s)); u_drag = 0; ) :
      ( u_drag = s; u_dy0 = mouse_y; u_dv0 = norm_of(s); u_dfine = mouse_cap & 4; automate(s, 0); );
      u_ctarget = s; u_ctime = time_precise();
    ) : (
      v = (v | 0) + 1;
      v > s_max(s) ? v = s_min(s);
      set_slider(s, v);
      g_sets = s; g_sett = time_precise();
    );
    u_click = 0;
  );
  hov && u_rclick && s != 27 ? ( cell_menu(s); u_rclick = 0; );
  hov && u_wheel != 0 && u_drag == 0 ? (
    v = slider(s) + (u_wheel > 0 ? 1 : -1) * s_step(s);
    set_slider(s, max(s_min(s), min(s_max(s), v)));
    g_sets = s; g_sett = time_precise();
    u_wheel = 0;
  );
);

function model_menu() local(i, r) (
  #gm = "";
  i = 0;
  loop(47,
    i == 0 ? strcat(#gm, ">Classic|") : i == 13 ? strcat(#gm, "<|>Digital|") : i == 28 ? strcat(#gm, "<|>Physical and percussion|") :
    i == 37 ? strcat(#gm, "<|>Wavetables|") : i == 41 ? strcat(#gm, "<|>Noise|") : strcat(#gm, "|");
    (i == 12 || i == 27 || i == 36 || i == 40 || i == 46) ? strcat(#gm, "<");
    (k_model | 0) == i ? strcat(#gm, "!");
    strcat(#gm, model_name(i));
    i += 1;
  );
  gfx_x = mouse_x; gfx_y = mouse_y;
  r = gfx_showmenu(#gm);
  r > 0 ? set_slider(1, r - 1);
);

function pm_marks(cx, cy, rad) (
  gfx_set(0.12, 0.12, 0.13, 1);
  gfx_rect(cx - rad * 0.95 - 5 * uscale, cy - rad - 6 * uscale, 9 * uscale, max(1, 2 * uscale), 1);
  gfx_rect(cx + rad * 0.95 - 4 * uscale, cy - rad - 6 * uscale, 9 * uscale, max(1, 2 * uscale), 1);
  gfx_rect(cx + rad * 0.95 - uscale, cy - rad - 9.5 * uscale, max(1, 2 * uscale), 9 * uscale, 1);
);

function jkb_draw(x, y, w, h, nw, lo, held, ar, ag, ab, sc) local(ww, bw, bh, n, wi, pc, isb, kx, kwid, kg, l, i, wr, wg, wb)
(
  ww = w / nw;
  bw = ww * 0.64; bh = h * 0.6;
  i = 1;
  loop(4,
    gfx_set(0, 0, 0, 0.12 * (1 - (i - 1) / 4));
    gfx_roundrect(x - i, y - i + 2 * sc, w + 2 * i, h + 2 * i, 3 * sc + i, 1);
    i += 1;
  );
  gfx_set(0.10, 0.10, 0.11, 1);
  gfx_rect(x, y, w, h, 1);
  kg = max(1, floor(sc));
  n = lo; wi = 0;
  while (wi < nw) (
    pc = n % 12;
    isb = pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10;
    !isb ? (
      kx = floor(x + wi * ww) + kg;
      kwid = floor(x + (wi + 1) * ww) - kx;
      l = n == held ? 1 : 0;
      wr = 0.86 + (ar - 0.86) * l; wg = 0.87 + (ag - 0.87) * l; wb = 0.90 + (ab - 0.90) * l;
      gfx_gradrect(kx, y, kwid, h, wr, wg, wb, 1, 0, 0, 0, 0, (0.12 - 0.12 * l) / h, (0.12 - 0.12 * l) / h, (0.12 - 0.12 * l) / h, 0);
      gfx_set(0, 0, 0, 0.18); gfx_rect(kx, y, kwid, 2 * sc, 1);
      pc == 0 ? (
        gfx_setfont(1, "Arial", 11 * sc, 'b');
        gfx_set(0.35, 0.36, 0.40, 1);
        sprintf(#jkbl, "C%d", floor(n / 12) - 1);
        gfx_measurestr(#jkbl, kwid, l);
        gfx_x = x + wi * ww + (ww - kwid) * 0.5; gfx_y = y + h - 15 * sc;
        gfx_drawstr(#jkbl);
      );
      wi += 1;
    );
    n += 1;
  );
  n = lo; wi = 0;
  while (wi < nw) (
    pc = n % 12;
    isb = pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10;
    isb ? (
      kx = floor(x + wi * ww - bw * 0.5);
      gfx_set(0, 0, 0, 0.35); gfx_rect(kx + sc, y, bw, bh + 2 * sc, 1);
      n == held ? (
        gfx_gradrect(kx, y, bw, bh, 0.08 + (ar * 0.8 - 0.08), 0.085 + (ag * 0.8 - 0.085), 0.095 + (ab * 0.8 - 0.095), 1, 0, 0, 0, 0, 0.1 / bh, 0.1 / bh, 0.1 / bh, 0);
      ) : (
        gfx_gradrect(kx, y, bw, bh, 0.08, 0.085, 0.095, 1, 0, 0, 0, 0, 0.1 / bh, 0.1 / bh, 0.1 / bh, 0);
        gfx_set(1, 1, 1, 0.10); gfx_rect(kx + 2 * sc, y + bh - 7 * sc, bw - 4 * sc, 5 * sc, 1);
      );
    ) : wi += 1;
    n += 1;
  );
);

frame_begin();
u_rclick = (mouse_cap & 2) && !g_rstate;
g_rstate = mouse_cap & 2;
panel_bg();

gfx_set(0.14, 0.14, 0.15, 1);
gfx_rect(px(30), py(10), 30 * uscale, 30 * uscale, 0);
gfx_rect(px(31), py(11), 28 * uscale, 28 * uscale, 0);
gfx_line(px(36), py(16), px(54), py(34), 1);
gfx_line(px(37), py(16), px(55), py(34), 1);
gfx_line(px(36), py(34), px(43), py(27), 1);
gfx_line(px(37), py(34), px(44), py(27), 1);
gfx_line(px(47), py(23), px(54), py(16), 1);
gfx_line(px(48), py(23), px(55), py(16), 1);
panel_title("Splitting Hairs", "macro oscillator", "by chmaha  ·  based on Mutable Instruments Braids");
panel_band(60);

g_hs = u_drag > 0 ? u_drag : g_lhov;
g_show = (g_hs >= 8 && g_hs <= 27) ? g_hs : (time_precise() - g_sett < 1.2 ? g_sets : 0);
gfx_set(0.07, 0.07, 0.08, 1);
gfx_rect(px(30), py(82), 272 * uscale, 94 * uscale, 1);
gfx_set(0.30, 0.34, 0.30, 1);
gfx_rect(px(40), py(92), 122 * uscale, 74 * uscale, 1);
gfx_rect(px(170), py(92), 122 * uscale, 74 * uscale, 1);
g_codes = g_show ? str_codes(cell_text(g_show)) : MCH + (k_meta >= 0.5 ? ui_shape : (k_model | 0)) * 4;
gi = 0;
loop(4,
  gfx_set(0.36, 0.41, 0.35, 1);
  ch14(px(58 + (gi >= 2 ? 22 : 0) + gi * 54), py(100), 40 * uscale, 58 * uscale, g_codes[gi], 0);
  gfx_set(0.86, 1, 0.34, 1);
  ch14(px(58 + (gi >= 2 ? 22 : 0) + gi * 54), py(100), 40 * uscale, 58 * uscale, g_codes[gi], 1);
  gi += 1;
);

g_ecx = px(382); g_ecy = py(128); g_er = 38 * uscale;
g_ehov = hit_circle(mouse_x, mouse_y, g_ecx, g_ecy, g_er + 4 * uscale);
g_ehov ? u_hov = 1;
gfx_set(0, 0, 0, 0.18); gfx_circle(g_ecx + 3 * uscale, g_ecy + 4 * uscale, g_er, 1, 1);
gfx_set(0.16, 0.16, 0.17, 1); gfx_circle(g_ecx, g_ecy, g_er, 1, 1);
gi = 0;
loop(40,
  gang = gi * 2 * $pi / 40 + (k_model | 0) * 0.21;
  gfx_set(0.28, 0.28, 0.30, 1);
  gfx_line(g_ecx + sin(gang) * g_er * 0.82, g_ecy - cos(gang) * g_er * 0.82, g_ecx + sin(gang) * g_er * 0.98, g_ecy - cos(gang) * g_er * 0.98, 1);
  gi += 1;
);
gfx_set(0.24, 0.24, 0.26, 1); gfx_circle(g_ecx, g_ecy, g_er * 0.76, 1, 1);
gfx_set(0.33, 0.33, 0.35, 1); gfx_circle(g_ecx, g_ecy, g_er * 0.66, 1, 1);
gfx_set(1, 1, 1, 0.10); gfx_circle(g_ecx - g_er * 0.18, g_ecy - g_er * 0.2, g_er * 0.32, 1, 1);
gfx_set(0.12, 0.12, 0.13, 1);
ctext("EDIT", g_ecx, py(170), 14, 'b');
(g_ehov && u_click) ? ( g_edrag = 1; g_ey0 = mouse_y; g_em0 = k_model | 0; u_click = 0; );
g_edrag ? (
  u_down ? (
    mouse_cap |= 65536;
    g_ev = max(0, min(46, g_em0 + floor((g_ey0 - mouse_y) / (8 * uscale))));
    g_ev != (k_model | 0) ? set_slider(1, g_ev);
  ) : g_edrag = 0;
);
(g_ehov && u_wheel != 0) ? ( set_slider(1, max(0, min(46, (k_model | 0) + (u_wheel > 0 ? 1 : -1)))); u_wheel = 0; );
(g_ehov && u_rclick) ? ( model_menu(); u_rclick = 0; );

knob_at(2, px(95), py(236), 30 * uscale, 0, 0);
knob_at(3, px(238), py(236), 30 * uscale, 0, 0);
pm_marks(px(382), py(236), 30 * uscale);
knob_at(4, px(382), py(236), 30 * uscale, 0, 0);

knob_at(5, px(95), py(370), 40 * uscale, 0, 2);
pm_marks(px(238), py(370), 28 * uscale);
knob_at(6, px(238), py(370), 28 * uscale, 0, 2);
knob_at(7, px(382), py(370), 40 * uscale, 0, 1);
g_dm = k_meta >= 0.5 ? ui_shape : (k_model | 0);
gfx_set(0.36, 0.37, 0.40, 1);
ctext(tim_name(g_dm), px(95), py(453), 12, 0);
ctext(col_name(g_dm), px(382), py(453), 12, 0);
ctext("velocity", px(238), py(440), 12, 0);

dots_v(px(456), py(80), py(460));

cap("MODEL", px(476), py(78));
g_cache_s != uscale ? grid_cache();
gfx_x = px(474); gfx_y = py(96);
gfx_blit(3, 1, 0);
gi = 0;
g_mhov = -1;
loop(47,
  gcx = px(478 + (gi % 8) * 51);
  gcy = py(100 + floor(gi / 8) * 26);
  hit_rect(mouse_x, mouse_y, gcx, gcy, 47 * uscale, 22 * uscale) ? g_mhov = gi;
  gi += 1;
);
g_mhov >= 0 ? (
  u_hov = 100 + g_mhov;
  u_click ? ( set_slider(1, g_mhov); u_click = 0; );
  u_rclick ? ( model_menu(); u_rclick = 0; );
  gcx = px(478 + (g_mhov % 8) * 51); gcy = py(100 + floor(g_mhov / 8) * 26);
  gfx_set(0.62, 0.74, 0.32, 1);
  gfx_rect(gcx - uscale, gcy - uscale, 49 * uscale, 24 * uscale, 0);
);
gsel = k_model | 0;
gcx = px(478 + (gsel % 8) * 51); gcy = py(100 + floor(gsel / 8) * 26);
gfx_set(0.20, 0.25, 0.12, 1);
gfx_rect(gcx, gcy, 47 * uscale, 22 * uscale, 1);
word14(MCH + gsel * 4, gcx + 6 * uscale, gcy + 4 * uscale, 6.5 * uscale, 14 * uscale, 9.5 * uscale, 0.88, 1, 0.36, 0.26, 0.31, 0.18);
(k_meta >= 0.5 && ui_shape != gsel) ? (
  gcx = px(478 + (ui_shape % 8) * 51); gcy = py(100 + floor(ui_shape / 8) * 26);
  gfx_set(0.88, 1, 0.36, 1);
  gfx_rect(gcx - uscale, gcy - uscale, 49 * uscale, 24 * uscale, 0);
  gfx_rect(gcx - 2 * uscale, gcy - 2 * uscale, 51 * uscale, 26 * uscale, 0);
);

cap("SETTINGS", px(476), py(270));
gi = 0;
loop(20,
  cell(8 + gi, px(476 + (gi % 7) * 58), py(290 + floor(gi / 7) * 60), 54 * uscale);
  gi += 1;
);

gfx_set(0.62, 0.63, 0.65, 1);
gfx_rect(px(20), py(470), (UDW - 40) * uscale, max(1, uscale), 1);
gfx_set(0.97, 0.97, 0.97, 1);
gfx_rect(px(20), py(471), (UDW - 40) * uscale, max(1, uscale), 1);

g_kby = py(480); g_kbh = 56 * uscale;
g_kbx = px(20); g_kbw = (UDW - 40) * uscale;
g_wkw = g_kbw / 36;
g_kbhit = -1;
gi = 0;
loop(36,
  goc = floor(gi / 7); gwn = gi % 7;
  gkn = 36 + goc * 12 + (gwn == 0 ? 0 : gwn == 1 ? 2 : gwn == 2 ? 4 : gwn == 3 ? 5 : gwn == 4 ? 7 : gwn == 5 ? 9 : 11);
  hit_rect(mouse_x, mouse_y, g_kbx + gi * g_wkw, g_kby, g_wkw, g_kbh) ? g_kbhit = gkn;
  gi += 1;
);
gi = 0;
loop(35,
  gwn = gi % 7;
  (gwn != 2 && gwn != 6) ? (
    goc = floor(gi / 7);
    gkn = 36 + goc * 12 + (gwn == 0 ? 1 : gwn == 1 ? 3 : gwn == 3 ? 6 : gwn == 4 ? 8 : 10);
    hit_rect(mouse_x, mouse_y, g_kbx + (gi + 1) * g_wkw - g_wkw * 0.32, g_kby, g_wkw * 0.64, g_kbh * 0.6) ? g_kbhit = gkn;
  );
  gi += 1;
);
jkb_draw(g_kbx, g_kby, g_kbw, g_kbh, 36, 36, g_kbheld, 0.86, 1, 0.34, uscale);
g_kbhit >= 0 ? (
  u_hov = 200;
  u_click ? ( g_kbon = g_kbhit + 1; g_kbheld = g_kbhit; u_click = 0; );
);
(g_kbheld > 0 && !u_down) ? ( g_kboff = g_kbheld + 1; g_kbheld = 0; );

!tables_ok ? (
  gfx_set(0.10, 0.13, 0.20, 1);
  gfx_rect(px(200), py(200), 500 * uscale, 50 * uscale, 1);
  gfx_set(1, 0.8, 0.5, 1);
  ctext("Missing or unreadable Dependencies/SplittingHairs/braids_tables.txt", px(450), py(216), 14, 'b');
);

(u_drag >= 8 && u_drag <= 27) ? ( g_sets = u_drag; g_sett = time_precise(); );
g_lhov = u_hov;
hint_bar(542);
frame_end();
