Version: 1.0
desc: Final Touch (ReFine port) by chmaha
author: chmaha
changelog:
  Initial release.
// Ported from ReFine (lkjb). MIT.
// https://github.com/lkjbdsp/lkjb-plugins/tree/master/ReFine
// Claude generated some of this code

slider1:0<0,100,0.1>-Warm
slider2:0<0,100,0.1>-Space
slider3:0<0,100,0.1>-Punch
slider4:0<0,1,1{Off,On}>-X2
slider5:0<0,1,1{Off,On}>-Delta
slider6:0<0,1,1{Off,On}>-Bypass

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

options:no_meter

@init
gfx_ext_retina = 1;
w0_warm = 2*$pi*80/srate;
cosw0_warm = cos(w0_warm);
alpha_warm = sin(w0_warm);
a0_warm = 1 + alpha_warm;
b0_warm = alpha_warm / a0_warm;
b1_warm = 0;
b2_warm = -alpha_warm / a0_warm;
a1_warm = -2*cosw0_warm / a0_warm;
a2_warm = (1 - alpha_warm) / a0_warm;

w0_punch = 2*$pi*10000/srate;
tanh0_punch = tan(w0_punch/2);
a1_punch = (tanh0_punch - 1) / (tanh0_punch + 1);
b0_punch = (1 - a1_punch) * 0.5;
b1_punch = (a1_punch - 1) * 0.5;

warm_x1l=0; warm_x2l=0; warm_y1l=0; warm_y2l=0;
warm_x1r=0; warm_x2r=0; warm_y1r=0; warm_y2r=0;
punch_x1l=0; punch_y1l=0;
punch_x1r=0; punch_y1r=0;

dither_level = pow(10, -140/20);

drag_target = 0; drag_start_y = 0; drag_start_pos = 0;
click_target = 0; click_time = -1;
mouse_state = 0;

@block
kW = slider1/100; kS = slider2/100; kP = slider3/100;
gain_warm  = 0.9*kW + 0.05*kS + 0.05*kP;
gain_space = 0.9*kS + 0.05*kP + 0.05*kW;
gain_punch = 0.9*kP + 0.05*kW + 0.05*kS;

x2_on = slider4 >= 0.5;
x2gain = x2_on ? 1.9475 : 1;
delta_on = slider5 >= 0.5;
bypass_on = slider6 >= 0.5;

warm_on = gain_warm > 0;
space_on = gain_space > 0;
punch_on = gain_punch > 0;

warm_t = warm_on ? pow(10, x2gain*0.95*sqrt(gain_warm)/20) - 1 : 0;
space_t = space_on ? pow(10, x2gain*1.25*sqrt(gain_space)/20) : 1;
punch_t = punch_on ? pow(10, x2gain*1.28*sqrt(gain_punch)/20) - 1 : 0;
!sm_init ? ( warm_add_gain = warm_t; space_mul_gain = space_t; punch_add_gain = punch_t; sm_init = 1; );
sm_k = 1 - exp(-1 / (0.02 * srate));

@sample
warm_add_gain += sm_k * (warm_t - warm_add_gain); abs(warm_t - warm_add_gain) < 0.000000001 ? warm_add_gain = warm_t;
space_mul_gain += sm_k * (space_t - space_mul_gain); abs(space_t - space_mul_gain) < 0.000000001 ? space_mul_gain = space_t;
punch_add_gain += sm_k * (punch_t - punch_add_gain); abs(punch_t - punch_add_gain) < 0.000000001 ? punch_add_gain = punch_t;
in_l = spl0; in_r = spl1;

!bypass_on ? (
  dith = (rand(1)-0.5)*2*dither_level;
  spl0 += dith;
  spl1 += dith;

  abs(spl0) < 0.00000001 ? spl0 = 0;
  abs(spl1) < 0.00000001 ? spl1 = 0;

  warm_in_l = spl0; warm_in_r = spl1;
  punch_in_l = spl0; punch_in_r = spl1;

  !(space_mul_gain === 1) ? ( spl0 *= space_mul_gain; spl1 *= space_mul_gain; );

  !(warm_add_gain === 0) ? (
    y0 = warm_in_l*b0_warm + warm_x1l*b1_warm + warm_x2l*b2_warm - warm_y1l*a1_warm - warm_y2l*a2_warm;
    abs(y0) < 0.00000001 ? y0 = 0;
    warm_out_l = y0;
    warm_x2l = warm_x1l; warm_x1l = warm_in_l;
    warm_y2l = warm_y1l; warm_y1l = y0;

    y0 = warm_in_r*b0_warm + warm_x1r*b1_warm + warm_x2r*b2_warm - warm_y1r*a1_warm - warm_y2r*a2_warm;
    abs(y0) < 0.00000001 ? y0 = 0;
    warm_out_r = y0;
    warm_x2r = warm_x1r; warm_x1r = warm_in_r;
    warm_y2r = warm_y1r; warm_y1r = y0;

    spl0 += warm_out_l * warm_add_gain;
    spl1 += warm_out_r * warm_add_gain;
  );

  !(punch_add_gain === 0) ? (
    y0 = punch_in_l*b0_punch + punch_x1l*b1_punch - punch_y1l*a1_punch;
    abs(y0) < 0.00000001 ? y0 = 0;
    punch_out_l = y0;
    punch_x1l = punch_in_l;
    punch_y1l = y0;

    y0 = punch_in_r*b0_punch + punch_x1r*b1_punch - punch_y1r*a1_punch;
    abs(y0) < 0.00000001 ? y0 = 0;
    punch_out_r = y0;
    punch_x1r = punch_in_r;
    punch_y1r = y0;

    spl0 += punch_out_l * punch_add_gain;
    spl1 += punch_out_r * punch_add_gain;
  );

  delta_on ? (
    spl0 -= in_l;
    spl1 -= in_r;
  );
);

@gfx 620 230

scale = max(0.5, min(gfx_w / 620, gfx_h / 230));
win_w = gfx_w; win_h = gfx_h;
gfx_w = floor(620*scale); gfx_h = floor(230*scale);
ox = floor((win_w - gfx_w) * 0.5);
oy = 0;
mouse_x -= ox; mouse_y -= oy;
gfx_setimgdim(127, gfx_w, gfx_h);
gfx_dest = 127;

MARGIN = 14*scale;
HEADER_H = 46*scale;

function taper_pos(val, minv, maxv, uselog)
(
  uselog ? log(val/minv) / log(maxv/minv) : (val - minv) / (maxv - minv);
);
function taper_val(pos, minv, maxv, uselog)
(
  uselog ? minv * pow(maxv/minv, pos) : minv + pos * (maxv - minv);
);
function hit_circle(mx, my, cx, cy, rad)
(
  sqr(mx - cx) + sqr(my - cy) <= sqr(rad);
);
function hit_rect(mx, my, x, y, w, h)
(
  mx >= x && mx <= x+w && my >= y && my <= y+h;
);

function draw_knob(cx, cy, rad, pos, cr, cg, cb, valtext, minlabel, maxlabel, name)
local(ang0, ang1, ang, i, tx, ty)
(
  ang0 = -2.35619;
  ang1 =  2.35619;

  gfx_set(0.05, 0.05, 0.06, 1);
  gfx_circle(cx, cy, rad + 2*scale, 1, 1);
  gfx_set(cr*0.55, cg*0.55, cb*0.55, 1);
  gfx_circle(cx, cy, rad, 1, 1);
  gfx_set(cr, cg, cb, 1);
  gfx_circle(cx, cy, rad*0.72, 1, 1);
  gfx_set(1, 1, 1, 0.18);
  gfx_circle(cx - rad*0.28, cy - rad*0.28, rad*0.42, 1, 1);

  i = 0;
  loop(9,
    ang = ang0 + (ang1 - ang0) * (i / 8);
    gfx_set(0.85, 0.85, 0.85, 0.7);
    gfx_line(cx + sin(ang)*rad*0.82, cy - cos(ang)*rad*0.82,
             cx + sin(ang)*rad*0.98, cy - cos(ang)*rad*0.98);
    i += 1;
  );

  ang = ang0 + (ang1 - ang0) * pos;
  gfx_set(0.05, 0.05, 0.05, 1);
  gfx_line(cx, cy, cx + sin(ang)*rad*0.85, cy - cos(ang)*rad*0.85, 1);

  gfx_setfont(1, "Arial", 14*scale);
  gfx_set(0.85, 0.85, 0.85, 1);
  gfx_measurestr(valtext, tx, ty);
  gfx_x = cx - tx*0.5; gfx_y = cy - rad - 16*scale;
  gfx_drawstr(valtext);

  gfx_setfont(1, "Arial", 12*scale);
  gfx_set(0.6, 0.6, 0.63, 1);
  gfx_x = cx - rad - 4*scale; gfx_y = cy + rad + 4*scale;
  gfx_drawstr(minlabel);
  gfx_measurestr(maxlabel, tx, ty);
  gfx_x = cx + rad - tx + 4*scale; gfx_y = cy + rad + 4*scale;
  gfx_drawstr(maxlabel);

  gfx_setfont(1, "Arial", 14*scale);
  gfx_set(0.8, 0.8, 0.82, 1);
  gfx_measurestr(name, tx, ty);
  gfx_x = cx - tx*0.5; gfx_y = cy + rad + 18*scale;
  gfx_drawstr(name);
);

function header_btn(txt, active, right_edge, by)
local(tw, th, bw, bh, bx, cr, cg, cb, gap)
global(gfx_x, gfx_y, hb_x, hb_y, hb_w, hb_h, scale)
(
  gfx_setfont(1, "Arial", 14*scale);
  gfx_measurestr(txt, tw, th);
  bw = tw + 16*scale; bh = 20*scale;
  bx = right_edge - bw;

  active ? ( cr = 0.82; cg = 0.42; cb = 0.15; ) : ( cr = 0.22; cg = 0.22; cb = 0.25; );
  gap = max(1, scale);

  gfx_set(0.04, 0.04, 0.05, 1);
  gfx_rect(bx - gap, by - gap, bw + 2*gap, bh + 2*gap, 1);

  gfx_set(cr*0.6, cg*0.6, cb*0.6, 1);
  gfx_rect(bx, by, bw, bh, 1);

  gfx_set(cr, cg, cb, 1);
  gfx_rect(bx + gap, by + gap, bw - 2*gap, bh*0.5, 1);

  gfx_set(1, 1, 1, active ? 0.22 : 0.10);
  gfx_rect(bx + gap, by + gap, bw - 2*gap, bh*0.32, 1);

  gfx_set(1, 1, 1, active ? 0.4 : 0.22);
  gfx_rect(bx, by, bw, gap, 1);

  gfx_set(0, 0, 0, 0.3);
  gfx_rect(bx, by + bh - gap, bw, gap, 1);

  gfx_set(0.03, 0.03, 0.04, 1);
  gfx_rect(bx - gap, by - gap, bw + 2*gap, bh + 2*gap, 0);

  gfx_set(1, 1, 1, 0.9);
  gfx_x = bx + 8*scale; gfx_y = by + 3*scale;
  gfx_drawstr(txt);
  hb_x = bx; hb_y = by; hb_w = bw; hb_h = bh;
  bx;
);

mouse_down = mouse_cap & 1;
wheel = mouse_wheel; mouse_wheel = 0;
wheel_once = 0;
mouse_just_down = mouse_down && !mouse_state;

gfx_set(0.13, 0.13, 0.15, 1);
gfx_rect(0, 0, gfx_w, gfx_h, 1);

gfx_setfont(1, "Arial", 20*scale, 'b');
gfx_set(0.85, 0.35, 0.35, 1);
gfx_x = MARGIN; gfx_y = 8*scale;
gfx_drawstr("FINAL TOUCH");
gfx_setfont(1, "Arial", 13*scale);
gfx_set(0.6, 0.6, 0.63, 1);
gfx_x = MARGIN + 2*scale; gfx_y = 30*scale;
gfx_drawstr("by chmaha  ·  based on ReFine");

KNRAD = 32*scale;
knx1 = gfx_w*0.2;
knx2 = gfx_w*0.5;
knx3 = gfx_w*0.8;
KNOB_Y = HEADER_H + 20*scale + KNRAD;

draw_knob(knx1, KNOB_Y, KNRAD, taper_pos(slider1,0,100,0), 0.85,0.35,0.30,
  sprintf(#, "%.0f%%", slider1), "0", "100", "Warm");
draw_knob(knx2, KNOB_Y, KNRAD, taper_pos(slider2,0,100,0), 0.30,0.70,0.35,
  sprintf(#, "%.0f%%", slider2), "0", "100", "Space");
draw_knob(knx3, KNOB_Y, KNRAD, taper_pos(slider3,0,100,0), 0.30,0.45,0.85,
  sprintf(#, "%.0f%%", slider3), "0", "100", "Punch");

x2_on = slider4 >= 0.5;
delta_on = slider5 >= 0.5;
bypass_on = slider6 >= 0.5;

BTN_ROW_Y = KNOB_Y + KNRAD + 50*scale;
right_edge = knx3 + KNRAD;
right_edge = header_btn("Bypass", bypass_on, right_edge, BTN_ROW_Y);
bypass_x = hb_x; bypass_y = hb_y; bypass_w = hb_w; bypass_h = hb_h;
right_edge = header_btn("Delta", delta_on, right_edge - 10*scale, BTN_ROW_Y);
delta_x = hb_x; delta_y = hb_y; delta_w = hb_w; delta_h = hb_h;
right_edge = header_btn("X2", x2_on, right_edge - 10*scale, BTN_ROW_Y);
x2_x = hb_x; x2_y = hb_y; x2_w = hb_w; x2_h = hb_h;

mouse_just_down && hit_circle(mouse_x, mouse_y, knx1, KNOB_Y, KNRAD) ? (
  (click_target == 1 && time_precise() - click_time < 0.3) ? (
    slider1 = 0; slider_automate(slider1);
  ) : (
    drag_target = 1; drag_start_y = mouse_y; drag_start_pos = taper_pos(slider1,0,100,0);
  );
  click_target = 1; click_time = time_precise();
);
wheel != 0 && hit_circle(mouse_x, mouse_y, knx1, KNOB_Y, KNRAD) ? (
  drag_target = 1; drag_start_y = mouse_y; drag_start_pos = max(0, min(1, taper_pos(slider1,0,100,0) + wheel/120*0.02)); wheel_once = 1;
);
mouse_just_down && hit_circle(mouse_x, mouse_y, knx2, KNOB_Y, KNRAD) ? (
  (click_target == 2 && time_precise() - click_time < 0.3) ? (
    slider2 = 0; slider_automate(slider2);
  ) : (
    drag_target = 2; drag_start_y = mouse_y; drag_start_pos = taper_pos(slider2,0,100,0);
  );
  click_target = 2; click_time = time_precise();
);
wheel != 0 && hit_circle(mouse_x, mouse_y, knx2, KNOB_Y, KNRAD) ? (
  drag_target = 2; drag_start_y = mouse_y; drag_start_pos = max(0, min(1, taper_pos(slider2,0,100,0) + wheel/120*0.02)); wheel_once = 1;
);
mouse_just_down && hit_circle(mouse_x, mouse_y, knx3, KNOB_Y, KNRAD) ? (
  (click_target == 3 && time_precise() - click_time < 0.3) ? (
    slider3 = 0; slider_automate(slider3);
  ) : (
    drag_target = 3; drag_start_y = mouse_y; drag_start_pos = taper_pos(slider3,0,100,0);
  );
  click_target = 3; click_time = time_precise();
);
wheel != 0 && hit_circle(mouse_x, mouse_y, knx3, KNOB_Y, KNRAD) ? (
  drag_target = 3; drag_start_y = mouse_y; drag_start_pos = max(0, min(1, taper_pos(slider3,0,100,0) + wheel/120*0.02)); wheel_once = 1;
);

mouse_just_down && hit_rect(mouse_x, mouse_y, x2_x, x2_y, x2_w, x2_h) ? (
  slider4 = x2_on ? 0 : 1; slider_automate(slider4);
);
mouse_just_down && hit_rect(mouse_x, mouse_y, delta_x, delta_y, delta_w, delta_h) ? (
  slider5 = delta_on ? 0 : 1; slider_automate(slider5);
);
mouse_just_down && hit_rect(mouse_x, mouse_y, bypass_x, bypass_y, bypass_w, bypass_h) ? (
  slider6 = bypass_on ? 0 : 1; slider_automate(slider6);
);

drag_target > 0 && (mouse_down || wheel_once) ? (
  mouse_down ? mouse_cap |= 65536;
  newpos = max(0, min(1, drag_start_pos + (drag_start_y - mouse_y) / (150*scale)));
  (drag_target == 1) ? ( slider1 = taper_val(newpos,0,100,0); slider_automate(slider1); );
  (drag_target == 2) ? ( slider2 = taper_val(newpos,0,100,0); slider_automate(slider2); );
  (drag_target == 3) ? ( slider3 = taper_val(newpos,0,100,0); slider_automate(slider3); );
);
!mouse_down ? drag_target = 0;
mouse_state = mouse_down;

gfx_dest = -1; gfx_a = 1; gfx_mode = 6;
ox > 0 ? (
  gfx_blit(127, 1, 0, 0, 0, 1, gfx_h, 0, 0, ox, win_h);
  gfx_blit(127, 1, 0, 0, 0, 1, gfx_h, ox + gfx_w, 0, win_w - ox - gfx_w, win_h);
);
win_h > gfx_h ? (
  gfx_blit(127, 1, 0, 0, gfx_h - 1, gfx_w, 1, ox, gfx_h, gfx_w, win_h - gfx_h);
);
gfx_blit(127, 1, 0, 0, 0, gfx_w, gfx_h, ox, oy, gfx_w, gfx_h);
gfx_mode = 0;
gfx_w = win_w; gfx_h = win_h;
