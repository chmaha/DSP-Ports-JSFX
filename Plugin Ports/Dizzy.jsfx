nch = 2;
DRYG = 1;
GEO_LIVE = 1;
wh_defaults();
wh_state_reset();
wh_initialize();
f_t[0] = haT; f_f[0] = haF; f_g[0] = haG; f_q[0] = haQ;
f_t[1] = hbT; f_f[1] = hbF; f_g[1] = hbG; f_q[1] = hbQ;
f_t[2] = lpT; f_f[2] = lpF; f_g[2] = lpG; f_q[2] = lpQ;
o_horn_radius = hornRadiusCm; o_drum_radius = drumRadiusCm; o_mic_dist = micDistCm;
o_horn_xoff = hornXOffsetCm; o_horn_zoff = hornZOffsetCm; o_horn_leak = leakLevel;
o_mic_angle = 0; o_rev_select = 0;
o_horn_brake = o_horn_accel = o_horn_decel = o_horn_slow = o_horn_fast = 0;
o_drum_brake = o_drum_accel = o_drum_decel = o_drum_slow = o_drum_fast = 0;
fade_dir = 0; fade = 0;
o_horn_level = 0; o_drum_level = 0; o_drum_width = 0; o_horn_width = 0;
x_drum_width = 0; x_dll = x_drr = 1; x_dlr = x_drl = 0;
x_horn_width = 0; x_hll = x_hrr = 1; x_hlr = x_hrl = 0;

@slider
last_srate != srate ? rate_change();

@block
nch = max(1, min(MAXCH, num_ch > 0 ? num_ch : 2));
sp(10) !== o_horn_brake ? ( hnBrakePos = sp(10); o_horn_brake = sp(10); );
sp(8) !== o_horn_accel ? ( hornAcc = sp(8); o_horn_accel = sp(8); );
sp(9) !== o_horn_decel ? ( hornDec = sp(9); o_horn_decel = sp(9); );
sp(6) !== o_horn_slow ? ( hornRPMslow = sp(6); o_horn_slow = sp(6); computeRotationSpeeds(); o_rev_select = -1; );
sp(7) !== o_horn_fast ? ( hornRPMfast = sp(7); o_horn_fast = sp(7); computeRotationSpeeds(); o_rev_select = -1; );
sp(19) !== o_drum_slow ? ( drumRPMslow = sp(19); o_drum_slow = sp(19); computeRotationSpeeds(); o_rev_select = -1; );
sp(20) !== o_drum_fast ? ( drumRPMfast = sp(20); o_drum_fast = sp(20); computeRotationSpeeds(); o_rev_select = -1; );
sp(23) !== o_drum_brake ? ( drBrakePos = sp(23); o_drum_brake = sp(23); );
sp(21) !== o_drum_accel ? ( drumAcc = sp(21); o_drum_accel = sp(21); );
sp(22) !== o_drum_decel ? ( drumDec = sp(22); o_drum_decel = sp(22); );
set_speed();
enabled = sp(1) > 0;
spos = 0;

@sample
ck = spos & 63;
ck == 0 ? ( cn = min(64, samplesblock - spos); chunk_begin(cn); );
nch === 2 ? xin = (spl0 + spl1) * 0.5 : (
  xin = spl0 + spl1; c = 2; loop(nch - 2, xin += spl(c); c += 1; ); xin /= nch;
);
wp_sample(xin);
yl = wo_HL * c_hll + wo_HR * c_hlr + wo_DL * c_dll + wo_DR * c_dlr;
yr = wo_HL * c_hrl + wo_HR * c_hrr + wo_DL * c_drl + wo_DR * c_drr;
tg === 0 ? (
  spl0 *= DRYG; spl1 *= DRYG;
  c = 2; loop(nch - 2, spl(c) *= DRYG; c += 1; );
) : (
  tg !== 1 ? ( yl *= tg; yr *= tg; );
  spl0 = yl + spl0 * ig; spl1 = yr + spl1 * ig;
