Version: 1.0
desc: Dizzy (setBfree b_whirl port) by chmaha
author: chmaha
changelog:
  Initial release.
about:
  Rotary speaker (Leslie) with horn and drum rotors, speed switching,
  brake, filters and cabinet geometry,
  ported from setBfree's b_whirl by Fredrik Kilander, Robin Gareus, Ken Restivo and Will Panther
  https://github.com/pantherb/setBfree (GPLv2+)
  JSFX version released under GPLv3+ license
  Claude generated some of this code

slider1:1<0,1,1{Off,On}>-Enable
slider2:4<0,8,1{Horn Stop Drum Stop,Horn Stop Drum Slow,Horn Stop Drum Fast,Horn Slow Drum Stop,Horn Slow Drum Slow,Horn Slow Drum Fast,Horn Fast Drum Stop,Horn Fast Drum Slow,Horn Fast Drum Fast}>-Speed
slider3:0<-20,20,0.1>-Horn Level (dB)
slider4:0<-20,20,0.1>-Drum Level (dB)
slider5:1<0,2,0.01>-Drum Stereo Width
slider6:40.32<5,200,0.01>-Horn Slow RPM
slider7:423.36<100,1000,0.01>-Horn Fast RPM
slider8:0.161<0.001,10,0.001>-Horn Acceleration
slider9:0.321<0.001,10,0.001>-Horn Deceleration
slider10:0<0,1,0.001>-Horn Brake Position
slider11:0<0,8,1{Low Pass,High Pass,Band Pass (skirt),Band Pass (peak),Notch,All Pass,Peaking,Low Shelf,High Shelf}>-Horn Filter 1 Type
slider12:4500<250,8000,0.01>-Horn Filter 1 Frequency
slider13:2.7456<0.01,6,0.0001>-Horn Filter 1 Q
slider14:-30<-48,48,0.0001>-Horn Filter 1 Gain
slider15:7<0,8,1{Low Pass,High Pass,Band Pass (skirt),Band Pass (peak),Notch,All Pass,Peaking,Low Shelf,High Shelf}>-Horn Filter 2 Type
slider16:300<250,8000,0.01>-Horn Filter 2 Frequency
slider17:1<0.01,6,0.0001>-Horn Filter 2 Q
slider18:-30<-48,48,0.0001>-Horn Filter 2 Gain
slider19:36<5,100,0.01>-Drum Slow RPM
slider20:357.3<60,600,0.01>-Drum Fast RPM
slider21:4.127<0.01,20,0.001>-Drum Acceleration
slider22:1.371<0.01,20,0.001>-Drum Deceleration
slider23:0<0,1,0.001>-Drum Brake Position
slider24:8<0,8,1{Low Pass,High Pass,Band Pass (skirt),Band Pass (peak),Notch,All Pass,Peaking,Low Shelf,High Shelf}>-Drum Filter Type
slider25:811.9695<50,8000,0.0001>-Drum Filter Frequency
slider26:1.6016<0.01,6,0.0001>-Drum Filter Q
slider27:-38.9291<-48,48,0.0001>-Drum Filter Gain
slider28:-16.47<-80,-3,0.01>-Horn Leakage (dB)
slider29:19.2<9,50,0.1>-Horn Radius (cm)
slider30:22<9,50,0.1>-Drum Radius (cm)
slider31:0<-20,20,0.1>-Horn X Offset (cm)
slider32:0<-20,20,0.1>-Horn Z Offset (cm)
slider33:42<9,150,0.1>-Mic Distance (cm)
slider34:0<-1,1,1{Horn follows drum,Independent,Drum follows horn}>-Link Speed Control
slider35:180<0,180,0.5>-Mic Angle
slider36:1<0,2,0.01>-Horn Stereo Width

options:no_meter


@init
ext_noinit = gfx_ext_retina = 1;

function alloc(n) local(p) ( p = mp; mp += n; memset(p, 0, n); p; );
function imod(a, b) ( a - floor(a / b) * b; );
function idiv(a, b) ( floor(a / b); );
function roundf_(x) local(r) ( r = floor(x); x - r >= 0.5 ? r + 1 : r; );

DENORM = 1 / 100000000000000;
TINY = 1 / 1000000000000000;
mp = 0;
WDS = 16384; WDM = 16383; WBS = 2048; WBM = 2047;
bfw = alloc(WDS * 5); bbw = alloc(WDS * 5);
hnF = alloc(WDS); hnB = alloc(WDS); drF = alloc(WDS); drB = alloc(WDS);
hlBuf = alloc(WBS); hrBuf = alloc(WBS); dlBuf = alloc(WBS); drBuf = alloc(WBS);
adx0 = alloc(8); adx1 = alloc(8); adx2 = alloc(8);
hPh = alloc(6); dPh = alloc(6); hnSpc = alloc(6); drSpc = alloc(6);
hafw = alloc(8); hbfw = alloc(8); drfL = alloc(8); drfR = alloc(8);
MAXCH = 64;
wz = alloc(4); rv_ht = alloc(9); rv_dt = alloc(9); revsel = alloc(3);
f_t = alloc(3); f_f = alloc(3); f_q = alloc(3); f_g = alloc(3);
slLast = alloc(64);
slDef = alloc(64); slMin = alloc(64); slMax = alloc(64); slStep = alloc(64);
mem_set_values(slDef+1, 1,4,0,0,1,40.32,423.36,.161,.321,0,0,4500,2.7456,-30,7,300,1,-30,36,357.3,
  4.127,1.371,0,8,811.9695,1.6016,-38.9291,-16.47,19.2,22,0,0,42,0,180,1);
mem_set_values(slMin+1, 0,0,-20,-20,0,5,100,.001,.001,0,0,250,.01,-48,0,250,.01,-48,5,60,
  .01,.01,0,0,50,.01,-48,-80,9,9,-20,-20,9,-1,0,0);
mem_set_values(slMax+1, 1,8,20,20,2,200,1000,10,10,1,8,8000,6,48,8,8000,6,48,100,600,
  20,20,1,8,8000,6,48,-3,50,50,20,20,150,1,180,2);
mem_set_values(slStep+1, 1,1,.1,.1,.01,.01,.01,.001,.001,.001,1,.01,.0001,.0001,1,.01,.0001,.0001,.01,.01,
  .001,.001,.001,1,.0001,.0001,.0001,.01,.1,.1,.1,.1,.1,1,.5,.01);

function eqCompute(type, fq, Q, dbG) local(A, omega, sn, cs, alpha, beta) (
  A = pow(10.0, (dbG / 40.0));
  omega = (2.0 * $pi * fq) / srate;
  sn = sin(omega); cs = cos(omega);
  alpha = sn / (2.0 * Q);
  beta = sqrt(A) / Q;
  type == 0 ? ( eqB0 = (1.0 - cs) / 2.0; eqB1 = 1.0 - cs; eqB2 = (1.0 - cs) / 2.0; eqA0 = 1.0 + alpha; eqA1 = -2.0 * cs; eqA2 = 1.0 - alpha; ) :
  type == 1 ? ( eqB0 = (1.0 + cs) / 2.0; eqB1 = -(1.0 + cs); eqB2 = (1.0 + cs) / 2.0; eqA0 = 1.0 + alpha; eqA1 = -2.0 * cs; eqA2 = 1.0 - alpha; ) :
  type == 2 ? ( eqB0 = sn / 2.0; eqB1 = 0.0; eqB2 = -sn / 2.0; eqA0 = 1.0 + alpha; eqA1 = -2.0 * cs; eqA2 = 1.0 - alpha; ) :
  type == 3 ? ( eqB0 = alpha; eqB1 = 0.0; eqB2 = -alpha; eqA0 = 1.0 + alpha; eqA1 = -2.0 * cs; eqA2 = 1.0 - alpha; ) :
  type == 4 ? ( eqB0 = 1.0; eqB1 = -2.0 * cs; eqB2 = 1.0; eqA0 = 1.0 + alpha; eqA1 = -2.0 * cs; eqA2 = 1.0 - alpha; ) :
  type == 5 ? ( eqB0 = 1.0 - alpha; eqB1 = -2.0 * cs; eqB2 = 1.0 + alpha; eqA0 = 1.0 + alpha; eqA1 = -2.0 * cs; eqA2 = 1.0 - alpha; ) :
  type == 6 ? ( eqB0 = 1.0 + (alpha * A); eqB1 = -2.0 * cs; eqB2 = 1.0 - (alpha * A); eqA0 = 1.0 + (alpha / A); eqA1 = -2.0 * cs; eqA2 = 1.0 - (alpha / A); ) :
  type == 7 ? (
    eqB0 = A * ((A + 1) - ((A - 1) * cs) + (beta * sn));
    eqB1 = (2.0 * A) * ((A - 1) - ((A + 1) * cs));
    eqB2 = A * ((A + 1) - ((A - 1) * cs) - (beta * sn));
    eqA0 = (A + 1) + ((A - 1) * cs) + (beta * sn);
    eqA1 = -2.0 * ((A - 1) + ((A + 1) * cs));
    eqA2 = (A + 1) + ((A - 1) * cs) - (beta * sn);
  ) :
  type == 8 ? (
    eqB0 = A * ((A + 1) + ((A - 1) * cs) + (beta * sn));
    eqB1 = -(2.0 * A) * ((A - 1) + ((A + 1) * cs));
    eqB2 = A * ((A + 1) + ((A - 1) * cs) - (beta * sn));
    eqA0 = (A + 1) - ((A - 1) * cs) + (beta * sn);
    eqA1 = 2.0 * ((A - 1) - ((A + 1) * cs));
    eqA2 = (A + 1) - ((A - 1) * cs) - (beta * sn);
  );
  eqB0 /= eqA0; eqB1 /= eqA0; eqB2 /= eqA0; eqA1 /= eqA0; eqA2 /= eqA0;
);

function wh_defaults() (
  wh_bypass = 0; hnBrakePos = 0; drBrakePos = 0;
  hornRPMslow = 60.0 * 0.672; hornRPMfast = 60.0 * 7.056;
  drumRPMslow = 60.0 * 0.600; drumRPMfast = 60.0 * 5.955;
  hornAcc = 0.161; hornDec = 0.321; drumAcc = 4.127; drumDec = 1.371;
  micAngle = 0;
  airSpeed = 340.0; micDistCm = 42.0; hornXOffsetCm = 0.0; hornZOffsetCm = 0.0;
  hornRadiusCm = 19.2; drumRadiusCm = 22.0;
  lpT = 8; lpF = 811.9695; lpQ = 1.6016; lpG = -38.9291;
  haT = 0; haF = 4500; haQ = 2.7456; haG = -30.0;
  hbT = 7; hbF = 300.0; hbQ = 1.0; hbG = -30.0;
  hornMicWidth = drumMicWidth = 0;
  hMic_ll = dMic_ll = 1.0; hMic_lr = dMic_lr = 0.0; hMic_rl = dMic_rl = 0.0; hMic_rr = dMic_rr = 1.0;
  hornLevel = 0.7; leakLevel = 0.15; leakage = 0;
);
function wh_state_reset() (
  hornAcDc = drumAcDc = 0;
  hornAngleGRD = 0; drumAngleGRD = 0;
  hornIncr = 0; drumIncr = 0; hornTarget = 0; drumTarget = 0;
  revSelect = 0;
);
function fsetDrumMicWidth(dw) local(p, n) (
  drumMicWidth !== dw ? (
    drumMicWidth = dw;
    p = dw > 0 ? (dw > 1 ? 1 : dw) : 0;
    n = dw < 0 ? (dw < -1 ? 1 : -dw) : 0;
    dMic_ll = sqrt(1 - p); dMic_lr = sqrt(0 + p); dMic_rl = sqrt(0 + n); dMic_rr = sqrt(1 - n);
  );
);
function fsetHornMicWidth(hw) local(p, n) (
  hornMicWidth !== hw ? (
    hornMicWidth = hw;
    p = hw > 0 ? (hw > 1 ? 1 : hw) : 0;
    n = hw < 0 ? (hw < -1 ? 1 : -hw) : 0;
    hMic_ll = sqrt(1 - p); hMic_lr = sqrt(0 + p); hMic_rl = sqrt(0 + n); hMic_rr = sqrt(1 - n);
  );
);
function useRevOption(n, signals) local(i, hr) (
  i = imod(n, 9);
  hornTarget = rv_ht[i]; drumTarget = rv_dt[i];
  hornIncr < hornTarget ? hornAcDc = 1 : hornTarget < hornIncr ? hornAcDc = -1;
  drumIncr < drumTarget ? drumAcDc = 1 : drumTarget < drumIncr ? drumAcDc = -1;
  signals & 2 ? (
    hr = imod(idiv(n, 3), 3);
    revSelect = hr == 2 ? 2 : hr == 1 ? 0 : 1;
  );
  lesSel = i;
);
function setRevSelect(n) ( revSelect = imod(n, 3); useRevOption(revsel[revSelect], 1); );
function computeRotationSpeeds() local(hf, hs, df, ds) (
  hf = hornRPMfast / (srate * 60.0); hs = hornRPMslow / (srate * 60.0);
  df = drumRPMfast / (srate * 60.0); ds = drumRPMslow / (srate * 60.0);
  rv_ht[8] = hf; rv_dt[8] = df; rv_ht[7] = hf; rv_dt[7] = ds; rv_ht[6] = hf; rv_dt[6] = 0;
  rv_ht[5] = hs; rv_dt[5] = df; rv_ht[4] = hs; rv_dt[4] = ds; rv_ht[3] = hs; rv_dt[3] = 0;
  rv_ht[2] = 0; rv_dt[2] = df; rv_ht[1] = 0; rv_dt[1] = ds; rv_ht[0] = 0; rv_dt[0] = 0;
  revsel[0] = 4; revsel[1] = 0; revsel[2] = 8;
  setRevSelect(revSelect);
);

function ipoldraw(deg, level, partial) local(d, e, from, to, range, i, x) (
  d = ipx; while (d < 0.0) ( d += 360.0; );
  from = floor((d * WDS) / 360.0);
  ipx = deg;
  e = ipx; while (e < d) ( e += 360.0; );
  to = floor((e * WDS) / 360.0);
  range = to - from;
  i = from;
  loop(to - from + 1,
    x = i - from;
    bfw[(i & WDM) * 5 + partial] = ipy + ((x / range) * (level - ipy));
    i += 1;
  );
  ipy = level;
);
function ipolmark(deg, level) ( ipx = deg; ipy = level; );

function initTables() local(i, j, sum, colsum) (
  ipolmark(-180.0, 1.052);
  ipoldraw(-166.4, .881, 0); ipoldraw(-150.5, .881, 0); ipoldraw(-135.3, .881, 0); ipoldraw(-122.4, .792, 0);
  ipoldraw(-106.5, .792, 0); ipoldraw(-91.2, .836, 0); ipoldraw(-75.8, .881, 0); ipoldraw(-59.4, .851, 0);
  ipoldraw(-44.7, .941, 0); ipoldraw(-30.0, 1.298, 0); ipoldraw(-14.7, 2.119, 0); ipoldraw(0.0, 2.820, 0);
  ipoldraw(15.6, 2.313, 0); ipoldraw(30.0, 1.492, 0); ipoldraw(44.7, .926, 0); ipoldraw(60.0, .836, 0);
  ipoldraw(74.7, .866, 0); ipoldraw(90.6, .792, 0); ipoldraw(100.0, .777, 0); ipoldraw(105.0, .777, 0);
  ipoldraw(120.0, .836, 0); ipoldraw(135.3, .836, 0); ipoldraw(150.0, .881, 0); ipoldraw(164.5, .874, 0);
  ipoldraw(180.0, 1.052, 0);

  ipolmark(-180.0, -0.07);
  ipoldraw(-150.0, 0.10, 1); ipoldraw(-135.0, -0.10, 1); ipoldraw(-122.2, 0.16, 1); ipoldraw(-105.0, 0.15, 1);
  ipoldraw(-91.2, 0.37, 1); ipoldraw(-75.3, 0.32, 1); ipoldraw(-60.1, 0.39, 1); ipoldraw(-44.5, 0.70, 1);
  ipoldraw(-30.0, 0.53, 1); ipoldraw(-12.0, -0.40, 1); ipoldraw(0.0, -0.81, 1); ipoldraw(2.7, -0.77, 1);
  ipoldraw(15.0, -0.52, 1); ipoldraw(33.1, 0.38, 1); ipoldraw(43.7, 0.68, 1); ipoldraw(57.7, 0.49, 1);
  ipoldraw(74.1, 0.19, 1); ipoldraw(89.4, 0.33, 1); ipoldraw(105.0, 0.03, 1); ipoldraw(120.0, 0.12, 1);
  ipoldraw(134.0, -0.13, 1); ipoldraw(153.3, 0.08, 1); ipoldraw(180.0, -0.07, 1);

  ipolmark(-180.0, 0.40);
  ipoldraw(-165.0, 0.20, 2); ipoldraw(-150.0, 0.48, 2); ipoldraw(-135.0, 0.27, 2); ipoldraw(-121.2, 0.22, 2);
  ipoldraw(-89.2, 0.30, 2); ipoldraw(-69.2, 0.22, 2); ipoldraw(-58.0, 0.11, 2); ipoldraw(-40.2, -0.43, 2);
  ipoldraw(-29.0, -0.53, 2); ipoldraw(-15.6, -0.43, 2); ipoldraw(0.0, 0.00, 2); ipoldraw(14.3, -0.44, 2);
  ipoldraw(30.3, -0.60, 2); ipoldraw(60.3, 0.11, 2); ipoldraw(74.9, 0.32, 2); ipoldraw(91.5, 0.23, 2);
  ipoldraw(104.9, 0.32, 2); ipoldraw(121.7, 0.19, 2); ipoldraw(135.0, 0.27, 2); ipoldraw(150.0, 0.45, 2);
  ipoldraw(165.0, 0.20, 2); ipoldraw(180.0, 0.40, 2);

  ipolmark(-180.0, -0.08);
  ipoldraw(-165.2, -0.19, 3); ipoldraw(-150.0, 0.00, 3); ipoldraw(-133.9, -0.20, 3); ipoldraw(-120.0, -0.15, 3);
  ipoldraw(-106.0, 0.09, 3); ipoldraw(-89.3, -0.15, 3); ipoldraw(-76.3, 0.00, 3); ipoldraw(-60.3, 0.29, 3);
  ipoldraw(-44.6, -0.02, 3); ipoldraw(-15.6, -0.22, 3); ipoldraw(0.0, 0.24, 3); ipoldraw(14.5, 0.11, 3);
  ipoldraw(30.1, -0.10, 3); ipoldraw(44.6, 0.17, 3); ipoldraw(60.4, 0.22, 3); ipoldraw(75.9, 0.16, 3);
  ipoldraw(90.4, -0.05, 3); ipoldraw(104.9, 0.07, 3); ipoldraw(122.8, -0.07, 3); ipoldraw(136.2, -0.07, 3);
  ipoldraw(150.0, 0.08, 3); ipoldraw(165.0, -0.19, 3); ipoldraw(180.0, -0.08, 3);

  ipolmark(-180.0, 0.13);
  ipoldraw(-165.2, 0.00, 4); ipoldraw(-150.0, 0.17, 4); ipoldraw(-135.2, -0.20, 4); ipoldraw(-120.5, 0.00, 4);
  ipoldraw(-105.0, 0.00, 4); ipoldraw(-90.0, 0.04, 4); ipoldraw(-75.0, -0.09, 4); ipoldraw(-60.3, -0.14, 4);
  ipoldraw(-45.0, 0.16, 4); ipoldraw(-15.6, 0.00, 4); ipoldraw(0.0, 0.22, 4); ipoldraw(15.6, -0.21, 4);
  ipoldraw(30.1, -0.09, 4); ipoldraw(45.0, 0.10, 4); ipoldraw(60.3, -0.07, 4); ipoldraw(74.8, -0.15, 4);
  ipoldraw(90.4, -0.03, 4); ipoldraw(104.9, -0.14, 4); ipoldraw(120.5, 0.00, 4); ipoldraw(135.2, -0.26, 4);
  ipoldraw(150.0, 0.16, 4); ipoldraw(165.0, -0.02, 4); ipoldraw(180.0, 0.13, 4);

  sum = 0.0; i = 0;
  loop(WDS,
    colsum = 0.0; j = 0; loop(5, colsum += abs(bfw[i * 5 + j]); j += 1; );
    sum < colsum ? sum = colsum;
    i += 1;
  );
  i = 0;
  loop(WDS,
    j = 0;
    loop(5,
      bfw[i * 5 + j] *= 1.0 / sum;
      bbw[(WDS - i - 1) * 5 + j] = bfw[i * 5 + j];
      j += 1;
    );
    i += 1;
  );
);

function computeOffsetsKeep(keep) local(i, hrs, drs, mds, mxs, mzs, v, a, b, dist) (
  !keep ? (
    wh_adi0 = wh_adi1 = wh_adi2 = 0; wh_outpos = 0;
    memset(hlBuf, 0, WBS); memset(hrBuf, 0, WBS); memset(dlBuf, 0, WBS); memset(drBuf, 0, WBS);
    memset(adx0, 0, 8); memset(adx1, 0, 8); memset(adx2, 0, 8);
  );
  hnSpc[0] = 12.0; hnSpc[1] = 18.0; hnSpc[2] = 53.0; hnSpc[3] = 50.0; hnSpc[4] = 106.0; hnSpc[5] = 116.0;
  drSpc[0] = 36.0; drSpc[1] = 39.0; drSpc[2] = 79.0; drSpc[3] = 86.0; drSpc[4] = 123.0; drSpc[5] = 116.0;
  hrs = (hornRadiusCm * srate / 100.0) / airSpeed;
  drs = (drumRadiusCm * srate / 100.0) / airSpeed;
  mds = (micDistCm * srate / 100.0) / airSpeed;
  mxs = (hornXOffsetCm * srate / 100.0) / airSpeed;
  mzs = (hornZOffsetCm * srate / 100.0) / airSpeed;
  i = 0;
  loop(WDS,
    v = (2.0 * $pi * i) / WDS;
    a = mds - (hrs * cos(v));
    b = mzs + hrs * sin(v);
    dist = sqrt((a * a) + (b * b));
    hnF[i] = dist + mxs;
    hnB[WDS - (i + 1)] = dist - mxs;
    a = mds - (drs * cos(v));
    b = drs * sin(v);
    drF[i] = sqrt((a * a) + (b * b));
    drB[WDS - (i + 1)] = drF[i];
    i += 1;
  );
  hPh[0] = 0; hPh[1] = WDS >> 1; hPh[2] = idiv(WDS * 2, 6); hPh[3] = idiv(WDS * 5, 6); hPh[4] = idiv(WDS, 6); hPh[5] = idiv(WDS * 4, 6);
  i = 0; loop(6, hnSpc[i] = hnSpc[i] * srate / 22100.0 + hrs + 1.0; i += 1; );
  dPh[0] = 0; dPh[1] = WDS >> 1; dPh[2] = idiv(WDS * 2, 6); dPh[3] = idiv(WDS * 5, 6); dPh[4] = idiv(WDS, 6); dPh[5] = idiv(WDS * 4, 6);
  i = 0; loop(6, drSpc[i] = drSpc[i] * srate / 22100.0 + drs + 1.0; i += 1; );
);

function computeOffsets() ( computeOffsetsKeep(0); );

function wh_initialize() (
  memset(wz, 0, 4);
  leakage = leakLevel * hornLevel;
  memset(drfL, 0, 8); memset(drfR, 0, 8); memset(hafw, 0, 8); memset(hbfw, 0, 8);
  initTables();
);
function rate_change() local(r) (
  r = last_srate / srate;
  hornIncr *= r; drumIncr *= r;
  last_srate = srate;
  nyq = srate * 0.4998; lpf1 = 2000.0 / srate; lpf2 = 880.0 / srate;
  f_t[0] = f_t[1] = f_t[2] = -1;
  computeOffsets();
  computeRotationSpeeds();
  o_rev_select = -1;
);

function eq_iir(W, X) local(temp, y) (
  temp = X - (W[1] * W[6]) - (W[2] * W[7]);
  y = (temp * W[3]) + (W[4] * W[6]) + (W[5] * W[7]);
  W[7] = W[6]; W[6] = temp;
  y;
);

function hn_motion(P, buf, dsp, bw, dx, di, ang, x) local(h1, hd, hl, hh, intp, k, t, r, xa, q, n) (
  h1 = ang * WDS + hPh[P];
  hd = h1 - floor(h1);
  hl = floor(h1) & WDM;
  hh = (hl + 1) & WDM;
  intp = dsp[hl] * (1 - hd) + hd * dsp[hh];
  k = roundf_(h1) & WDM;
  t = hnSpc[P] + intp + wh_outpos;
  r = floor(t);
  xa = bw[k * 5] * x;
  xa += bw[k * 5 + 1] * dx[di];
  xa += bw[k * 5 + 2] * dx[(di + 1) & 7];
  xa += bw[k * 5 + 3] * dx[(di + 2) & 7];
  xa += bw[k * 5 + 4] * dx[(di + 3) & 7];
  q = xa * (t - r);
  n = r & WBM;
  buf[n] += xa - q;
  n = (n + 1) & WBM;
  buf[n] += q;
);
function dr_motion(P, buf, dsp, x) local(d1, dd, dl, dh, intp, t, r, q, n) (
  d1 = wh_dang * WDS + dPh[P];
  dd = d1 - floor(d1);
  dl = floor(d1) & WDM;
  dh = (dl + 1) & WDM;
