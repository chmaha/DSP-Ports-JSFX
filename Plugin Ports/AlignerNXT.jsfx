  gbtn(432.6, cy - 14, 28, 28, slider(gl_s(i, 2)) >= 0.5, 0x0066ff) ? set_sl_done(gl_s(i, 2), slider(gl_s(i, 2)) >= 0.5 ? 0 : 1);
  hexc(0xfdfeff, 1); gicon_phase(446.6, cy + 1.2);
