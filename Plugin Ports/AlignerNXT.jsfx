function gfreq_x(f) ( 693 + 316 * log(max(f, 20) / 20) / log(1000); );
function gfreq_f(x) ( 20 * (1000 ^ ((x - 693) / 316)); );
function gfreq_y(db) ( 90 + 129 * (6 - db) / 66; );
function gdet_db(f, hs, ls, hf, lf) local(x2, d, db)
(
  db = 0;
  hs > 0 ? ( x2 = sqr(f / hf); d = sqr(1 - x2) + x2 / sqr(0.707); db += hs * 10 * log10(sqr(x2) / d); );
  ls > 0 ? ( x2 = sqr(f / lf); d = sqr(1 - x2) + x2 / sqr(0.707); db += ls * 10 * log10(1 / d); );
  db;
);

function gdet() local(i, f, x, y, px, py, db, hs, ls, hf, lf, t, r, hv, ex, ey, xa, xb)
(
  hs = floor(g_hpm + 0.5); ls = floor(g_lpm + 0.5);
  hf = g_hp; lf = g_lp;
  hexc(0x000000, 1); grect(693, 90, 316, 129);
  xa = hs > 0 ? gfreq_x(hf) : 693; xb = ls > 0 ? gfreq_x(lf) : 1009;
  hexc(0xfdfeff, 0.17);
  grect(693, 90, xa - 693, 129);
  grect(xb, 90, 1009 - xb, 129);
  hexc(0xffffff, 0.15);
  i = 0;
  loop(5,
    ghl(693, gfreq_y(-12 * i), 316);
    i += 1;
  );
  hexc(0xffffff, 0.35); ghl(693, gfreq_y(0), 316);
  f = 20;
  loop(28,
    f < 20000.5 ? ( hexc(0xffffff, (f === 100 || f === 1000 || f === 10000 || f === 20) ? 0.25 : 0.12); gvl(gfreq_x(f), 90, 129); );
    f += f < 100 ? 10 : f < 1000 ? 100 : f < 10000 ? 1000 : 10000;
  );
  hs > 0 ? ( hexc(0xfdfeff, 0.85); gvl(xa, 90, 129); );
  ls > 0 ? ( hexc(0xfdfeff, 0.85); gvl(xb, 90, 129); );
  gfont(10, 0); hexc(0x9498a2, 1);
  i = 0;
  loop(5,
    txt_r(1007, gfreq_y(-12 * i) + (i === 0 ? 7 : -7), i === 0 ? "0dB" : sprintf(#gv, "%ddB", -12 * i));
    i += 1;
  );
  txt_l(696, 211, "20Hz"); txt_c(gfreq_x(100) - 14, 211, "100Hz"); txt_c(gfreq_x(1000) - 14, 211, "1kHz"); txt_c(gfreq_x(10000) - 17, 211, "10kHz");
  px = -1;
  x = 693;
  loop(159,
    f = gfreq_f(x);
    db = min(6, gdet_db(f, hs, ls, hf, lf));
    y = gfreq_y(db);
    t = 1 - (y - 90) / 129;
    (px >= 0 && py <= 219 && y <= 219) ? ( grad_at(t); gthick(gxp(px), gyp(py), gxp(x), gyp(y)); );
    px = x; py = y;
    x += 2;
  );
  i = 0;
  loop(2,
    r = i ? ls : hs;
    f = i ? lf : hf;
    r > 0 ? (
      ex = gfreq_x(f);
      hv = abs(gmx - ex) <= 6 && gmy >= 90 && gmy <= 219;
      hv && gclick && gdrag === 0 ? ( gdrag = 103 + i; gclick = 0; );
    );
    i += 1;
  );
  gdrag === 103 && gdown ? ( mouse_cap |= 65536; gnv = max(20, min(20000, gfreq_f(max(693, min(1009, gmx))))); gnv !== g_hp ? set_sl(6, gnv); );
  gdrag === 104 && gdown ? ( mouse_cap |= 65536; gnv = max(20, min(20000, gfreq_f(max(693, min(1009, gmx))))); gnv !== g_lp ? set_sl(7, gnv); );
);

function gslopemenu(x, y, w, h, m, sl) local(r)
(
  gselbox(x, y, w, h, m === 0 ? "Off" : sprintf(#gv, "%d dB", m * 12)) ? (
    r = gmenu_at("Off|12 dB|24 dB|36 dB|48 dB");
    r >= 0 ? set_sl_done(sl, r);
