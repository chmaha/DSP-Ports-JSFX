function ghl(x, y, w) local(th) ( th = max(1, floor(gsc + 0.5)); gfx_rect(floor(gxp(x)), floor(gyp(y)), w * gsc, th); );
function gvl(x, y, h) local(th) ( th = max(1, floor(gsc + 0.5)); gfx_rect(floor(gxp(x)), floor(gyp(y)), th, h * gsc); );

function gthick(x1, y1, x2, y2) ( gfx_line(x1, y1, x2, y2, 1); gfx_line(x1, y1 + 1, x2, y2 + 1, 1); );

function gdash(x1, y1, x2, y2, dsh) local(n, k, dx, dy, ln)
(
  ln = sqrt(sqr(x2 - x1) + sqr(y2 - y1));
  n = max(1, floor(ln / (dsh * 2)));
  dx = (x2 - x1) / (n * 2); dy = (y2 - y1) / (n * 2);
  k = 0;
  loop(n,
    gfx_line(x1 + dx * k * 2, y1 + dy * k * 2, x1 + dx * (k * 2 + 1), y1 + dy * (k * 2 + 1), 1);
    k += 1;
  );
);

function lin2db(x) ( x > 0.000000000001 ? 20 * log10(x) : -120; );

function gmeter8(x, y, w) local(i, v, db, fp, by, bh)
(
  bh = max(1, floor(2 * gsc + 0.5));
