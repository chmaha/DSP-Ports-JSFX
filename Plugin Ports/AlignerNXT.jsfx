    );
    pk >= 0.0001 ? (
      mode === 0 ? grad_at(pcol) : mode === 1 ? hexc(0x0066ff, 1) : hexc(0xff0066, 1);
      c = 0;
      loop(n,
        u = c / (n - 1);
        yy = gsamp(o, u * (bins - 1), bins, pk, -1);
