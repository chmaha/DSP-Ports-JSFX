    );
  );
  hexc(0xfdfeff, 0);
);

function gdrag_strip(x, y, w, h, slv, id, mn, mx) local(hv, span)
(
  hv = inr(x, y, w, h);
  span = gwv_ok ? WV[3] + WV[4] : 32;
