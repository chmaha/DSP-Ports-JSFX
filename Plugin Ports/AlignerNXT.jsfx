  gknob(568.3, cy - 2, 24, gl_s(i, 6), 0, -1, 1, 0, 0, 2, 1, 10, "Pan");
  gknob(634.7, cy - 2, 24, gl_s(i, 5), 3, -60, 12, 0, 0, 2, 1, 11, "Gain");
  gk_lfs = 9;
