    gnv = gdrag_p + (gmx - gdrag_x) / w * span * (((mouse_cap & 4) || (mouse_cap & 32)) ? 0.25 : (mouse_cap & 8) ? 4 : 1);
    gnv = max(mn, min(mx, floor(gnv * 100 + 0.5) / 100));
    gnv !== slider(slv) ? set_sl(slv, gnv);
