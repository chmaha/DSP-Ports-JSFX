);

function ganalyze()
(
  gpanel(682.67, 56, 333.33, 281, "Analyze");
  gdet();
  gslopemenu(692.6, 236, 70.8, 39.4, floor(g_hpm + 0.5), 8);
  gknob(810.7, 256.7, 24, 6, 1, 20, 20000, 40, -10000000, 1, 1, 3, "HP Hz");
  gknob(876.3, 256.7, 24, 7, 1, 20, 20000, 250, -10000000, 1, 1, 3, "LP Hz");
  gslopemenu(939, 236, 68.6, 39.4, floor(g_lpm + 0.5), 9);
