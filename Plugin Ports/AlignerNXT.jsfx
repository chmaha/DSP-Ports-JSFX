function glane(i, ty, lh) local(a, role, root, end, lroot, lend, side, g1, g2, jn, jdown, x0, cy, ms, sl, c, col, lk, pa)
(
  a = max(0, min(7, floor(g_anchor + 0.5)));
  jn = gjn(i); jdown = (i + 1 < 8) && gjn(i + 1);
  hexc(0x0b0c10, 1); grect(8, ty, 666.67, lh);
