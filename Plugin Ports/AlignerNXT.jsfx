    v = MTIV[i];
    db = v > 0.00000001 ? 20 * log10(v) : -120;
    fp = gm_t(db);
    by = floor(gyp(y + i * 3.6) + 0.5);
    gm_track(x, by, w, bh, fp);
    hexc(db > 0 ? 0xff6600 : 0x32353d, 1);
    gfx_rect(gxp(x + w + 4.5), by, 5 * gsc, bh);
    i += 1;
  );
  gm_ticks(x, w, y + 27.8);
  gm_labels(x, w, y + 34, 9);
);

function gmeter2(x, y, w, vl, vr) local(i, v, db, fp, by, bh, tw, th)
(
  bh = max(1, floor(8 * gsc + 0.5));
  i = 0;
  loop(2,
    v = i ? vr : vl;
    db = v > 0.00000001 ? 20 * log10(v) : -120;
    fp = gm_t(db);
    by = floor(gyp(y + i * 12.4) + 0.5);
