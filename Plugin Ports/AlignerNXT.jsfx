  ghl(8, ty, 666.67); ghl(8, ty + lh - 1, 666.67); gvl(8, ty, lh); gvl(8 + 665.67, ty, lh);
  jn ? ( hexc(0x0b0c10, 1); ghl(9, ty, 664.67); );
  jdown ? ( hexc(0x0b0c10, 1); ghl(9, ty + lh - 1, 664.67); );
  cy = ty + lh * 0.5;
  root = groot(a); end = gend(a);
  role = i === a ? 1 : (end === root + 1 && (i === root || i === end)) ? 2 : 0;
  col = role === 1 ? 0xff0066 : role === 2 ? 0x0066ff : 0;
  gbtn(17, cy - 14, 54, 28, role > 0, col) ? set_sl_done(4, i);
  gfont(24, 0); hexc(0xfdfeff, 1);
