  gtoggle(800.1, 306.5, 102.2, 22.5, g_fwave >= 0.5, 0x0066ff, "Waves") ? set_sl_done(69, g_fwave >= 0.5 ? 0 : 1);
  gtoggle(907.4, 306.5, 102.2, 22.5, g_fcorr >= 0.5, 0x0066ff, "Corr") ? set_sl_done(70, g_fcorr >= 0.5 ? 0 : 1);
);

function gmaster() local(ttl)
(
  strcpy(#ttl, "Master");
  vz_maxlag > 0.005 ? sprintf(#ttl, "%s · lanes max %.2f ms", #ttl, vz_maxlag);
  vz_lat > 0.005 ? sprintf(#ttl, "%s · latency %.2f ms", #ttl, vz_lat);
  gpanel(682.67, 345, 333.33, 327, #ttl);
  gfont(14, 0); hexc(0xfdfeff, 0.7);
  txt_cc(694.5, 410, "L"); txt_cc(694.5, 479.5, "R");
  gstrip(713.5, 379.4, 292.8, 64, 8, 10, -1, 1, 0, 0, 0);
  gdrag_strip(713.5, 379.4, 292.8, 64, 5, 310, -50, 50);
  gstrip(713.5, 448.3, 292.8, 63, 9, 11, -1, 2, 0, 0, 0);
  gdrag_strip(713.5, 448.3, 292.8, 63, 5, 311, -50, 50);
  gknob(768, 591.5, 59, 5, 0, -50, 50, 0, 0, 2, 1, 9, "Delay");
  gknob(929.5, 591.5, 59, 10, 3, -60, 12, 0, 0, 2, 1, 11, "Volume");
);

!gk_ready ? (
  gk_ready = 1;
  gdrag = 0; mt_vl = mt_vr = 0; gwv_ok = 0;
  i_g = 0; loop(8, MTIV[i_g] = 0; i_g += 1; );
);


function th_set() local(d, s, i)
(
  d = g_day >= 0.5; s = floor(max(0, min(4, g_acc)) + 0.5);
  th_key = d * 10 + s;
  th_day = d; th_sch = s;
  i = 0; loop(24, TC[i] = THPAL[d * 24 + i]; i += 1; );
  i = 0; loop(15, TC[24 + i] = THPAL[48 + s * 15 + i]; i += 1; );
  th_ir = TC[12]; th_ig = TC[13]; th_ib = TC[14];
);

function gtheme_ui() local(y, r)
(
  y = gH - 20;
  gfont(11, 0);
  gbtn(10, y, 50, 16, 0, 0x0066ff) ? set_sl_done(71, th_day ? 0 : 1);
  hexc(0xfdfeff, 1); txt_cc(35, y + 8, th_day ? "Light" : "Dark");
  gbtn(68, y, 90, 16, 0, 0x0066ff) ? (
    r = gmenu_at("calfnxt|fire|lime|sea|slick");
    r >= 0 ? set_sl_done(72, r);
  );
  hexc(0xfdfeff, 1);
  txt_l(76, y + 8, th_sch === 0 ? "calfnxt" : th_sch === 1 ? "fire" : th_sch === 2 ? "lime" : th_sch === 3 ? "sea" : "slick");
  gfx_triangle(gxp(144), gyp(y + 6), gxp(152), gyp(y + 6), gxp(148), gyp(y + 11));
);

th_set();
gmx = (mouse_x - gox) / gsc;
gmy = (mouse_y - goy) / gsc;
gdown = mouse_cap & 1;
gclick = gdown && !gprev_down;
gdbl = gclick && gnow - glast_click < 0.3 && abs(gmx - glast_cx) < 4 && abs(gmy - glast_cy) < 4;
gclick ? ( glast_click = gnow; glast_cx = gmx; glast_cy = gmy; );

i_g = 0;
loop(8,
  MTIV[i_g] = max(MTI[i_g], MTIV[i_g] * 0.88);
  MTI[i_g] = 0;
  i_g += 1;
);
mt_vl = max(mt_ol, mt_vl * 0.88); mt_vr = max(mt_or, mt_vr * 0.88);
mt_ol = mt_or = 0;

gwn = wv_take(max(24, min(240, (g_span))), max(-50, min(50, (g_trim))), g_bypass >= 0.5, max(0, min(7, vrnd((g_anchor)))));
gwn > 0 ? gwv_ok = 1;

hexc(0x010203, 1); gfx_rect(0, 0, gfx_w, gfx_h);
gheader();

gjy = 56; gjh_n = 0;
i_g = 1; loop(7, gjn(i_g) ? gjh_n += 1; i_g += 1; );
gjlh = (616 - 8 * (7 - gjh_n)) / 8;
i_g = 0;
loop(8,
  i_g > 0 && !gjn(i_g) ? gjy += 8;
  glane(i_g, gjy, gjlh);
  gjy += gjlh;
  i_g += 1;
);
ganalyze();
gmaster();

nxt_credit(); gtheme_ui();

gdrag > 0 && !gdown ? (
  gdrag >= 300 ? automate(gdrag === 310 || gdrag === 311 ? 5 : gl_s(gdrag - 300, 4), 1) :
  gdrag >= 103 ? automate(gdrag === 103 ? 6 : 7, 1) :
  automate(gdrag, 1);
  gdrag = 0;
);

gprev_down = gdown;
