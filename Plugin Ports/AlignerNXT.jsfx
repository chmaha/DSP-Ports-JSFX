  gtoggle(79, cy - 30, 28, 28, slider(gl_s(i, 0)) >= 0.5, 0x0066ff, "M") ? set_sl_done(gl_s(i, 0), slider(gl_s(i, 0)) >= 0.5 ? 0 : 1);
  gtoggle(79, cy + 2, 28, 28, slider(gl_s(i, 1)) >= 0.5, 0xff0066, "S") ? set_sl_done(gl_s(i, 1), slider(gl_s(i, 1)) >= 0.5 ? 0 : 1);
  lroot = groot(i); lend = gend(i);
  g2 = -1;
  root !== end ? (
    (lend >= lroot + 1) ? (
      side = i - lroot;
      side === 0 ? g1 = root : side === 1 ? g1 = root + 1 : ( g1 = root; g2 = root + 1; );
    ) : ( g1 = root; g2 = root + 1; );
