    hh = (h - 2) * 0.5;
    cy = gyp(y + h * 0.5);
    ogk = 0;
    og = 5 + g1 * bins; og2 = g2 >= 0 ? 5 + g2 * bins : -1;
    gk = g2 >= 0 ? gpeak2(g1, g2) : gpeak(g1);
    o = 5 + ch * bins;
    pk = gpeak(ch);
    gk >= 0.0001 ? (
      hexc(0xfdfeff, 0.2);
      c = 0;
      loop(n,
        u = c / (n - 1);
        yy = gsamp(og, u * (bins - 1), bins, gk, og2);
        a0 = min(cy, cy - yy * hh * gsc);
        gfx_rect(floor(gxp(x + 1)) + c, a0, 1, max(1, abs(yy * hh * gsc)));
        c += 1;
