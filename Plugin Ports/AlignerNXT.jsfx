  gstrip(116.2, ty + 2, 307.2, lh - 4, i, g1, g2, 0, floor(i / 7 * 100 / 5 + 0.5) * 5 / 100, 0, 0);
  gdrag_strip(116.2, ty + 2, 307.2, lh - 4, gl_s(i, 4), 300 + i, -50, 50);
  gcorr(119.2, ty + lh - 7, 76, CRS[i]);
