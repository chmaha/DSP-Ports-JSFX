@init
ext_noinit = gfx_ext_retina = 1;

function alloc(n) local(r) instance(mp) global() ( r = mp; mp += n; memset(r, 0, n); r; );
alloc.mp = 0;

function f32(x) local(c) ( c = x * 536870913; c - (c - x); );

K005 = (0.05);
SM50 = 10 ^ -50;
QHP = (0.707);
PI2 = $pi * 2;
HALFPI = 1.5707963267948966;
PIF = (3.14159265);
NLN = 8;
DSZ = 32768;
DMASK = 32767;

LPA = alloc(64);
LMU = alloc(8); LSO = alloc(8); LPH = alloc(8); LJN = alloc(8); LDL = alloc(8); LGN = alloc(8); LPN = alloc(8);
PGL = alloc(8); PGR = alloc(8); JPV = alloc(8); DSM = alloc(8); AFL = alloc(8); ARW = alloc(8);
DLB = alloc(24 * DSZ);
WP = alloc(24);
XL = alloc(DSZ); XR = alloc(DSZ);
SCS = alloc(10 * 8 * 4);
CRN = alloc(8); CRA = alloc(8); CRB = alloc(8); CRS = alloc(8);
RAWV = alloc(8); FILV = alloc(8);
MTI = alloc(8); MTIV = alloc(8);
mt_ol = mt_or = 0;

function dblin(db) ( (10 ^ (db * K005)); );
function clampms(v) ( max(-50, min(50, v)); );
function rnd(x) ( x >= 0 ? floor(x + 0.5) : -floor(-x + 0.5); );
function vrnd(x) ( x >= 0 ? floor(x + 0.5) : -floor(-x + 0.5); );

function dl_w(k, x) local(w) ( w = WP[k]; DLB[k * DSZ + w] = x; WP[k] = (w + 1) & DMASK; );
function dl_r(k, d) ( d = max(1, min(DSZ - 1, d)); DLB[k * DSZ + ((WP[k] - d) & DMASK)]; );

function pan_l(p) local(a) ( a = (((p + 1) * 0.25) * PIF); (cos(a)); );
function pan_r(p) local(a) ( a = (((p + 1) * 0.25) * PIF); (sin(a)); );

function lane_load() (
  LPA[0] = l1_mute;
  LPA[1] = l1_solo;
  LPA[2] = l1_phase;
  LPA[3] = l1_join;
  LPA[4] = l1_delay;
  LPA[5] = l1_gain;
  LPA[6] = l1_pan;
  LPA[8] = l2_mute;
  LPA[9] = l2_solo;
  LPA[10] = l2_phase;
  LPA[11] = l2_join;
  LPA[12] = l2_delay;
  LPA[13] = l2_gain;
  LPA[14] = l2_pan;
  LPA[16] = l3_mute;
  LPA[17] = l3_solo;
  LPA[18] = l3_phase;
  LPA[19] = l3_join;
  LPA[20] = l3_delay;
  LPA[21] = l3_gain;
  LPA[22] = l3_pan;
  LPA[24] = l4_mute;
  LPA[25] = l4_solo;
  LPA[26] = l4_phase;
  LPA[27] = l4_join;
  LPA[28] = l4_delay;
  LPA[29] = l4_gain;
  LPA[30] = l4_pan;
  LPA[32] = l5_mute;
  LPA[33] = l5_solo;
  LPA[34] = l5_phase;
  LPA[35] = l5_join;
  LPA[36] = l5_delay;
  LPA[37] = l5_gain;
  LPA[38] = l5_pan;
  LPA[40] = l6_mute;
  LPA[41] = l6_solo;
  LPA[42] = l6_phase;
  LPA[43] = l6_join;
  LPA[44] = l6_delay;
  LPA[45] = l6_gain;
  LPA[46] = l6_pan;
  LPA[48] = l7_mute;
  LPA[49] = l7_solo;
  LPA[50] = l7_phase;
  LPA[51] = l7_join;
  LPA[52] = l7_delay;
  LPA[53] = l7_gain;
  LPA[54] = l7_pan;
  LPA[56] = l8_mute;
  LPA[57] = l8_solo;
  LPA[58] = l8_phase;
  LPA[59] = l8_join;
  LPA[60] = l8_delay;
  LPA[61] = l8_gain;
  LPA[62] = l8_pan;
);
function lane_set_delay(i, v) (
  i === 0 ? ( l1_delay = v; slider_automate(l1_delay, 1); ) :
  i === 1 ? ( l2_delay = v; slider_automate(l2_delay, 1); ) :
  i === 2 ? ( l3_delay = v; slider_automate(l3_delay, 1); ) :
  i === 3 ? ( l4_delay = v; slider_automate(l4_delay, 1); ) :
  i === 4 ? ( l5_delay = v; slider_automate(l5_delay, 1); ) :
  i === 5 ? ( l6_delay = v; slider_automate(l6_delay, 1); ) :
  i === 6 ? ( l7_delay = v; slider_automate(l7_delay, 1); ) :
  i === 7 ? ( l8_delay = v; slider_automate(l8_delay, 1); ) :
  0;
);


function group_root(l) ( while (l > 0 && LJN[l]) ( l -= 1; ); l; );
function eff_delay(l) local(root, base)
(
  root = group_root(l);
  base = LDL[root];
  l === root ? clampms(base) : clampms((base + LDL[l]));
);

function ms_samp(ms) local(cap)
(
  ms <= 0 ? 0 : (
    cap = min(max_pad > 0 ? max_pad : DSZ - 2, DSZ - 2);
    max(0, min(cap, rnd(ms * 0.001 * srate)));
  );
);

function make_plan(trim) local(i, d, mn)
(
  mn = eff_delay(0);
  i = 1;
  loop(7, d = eff_delay(i); mn = min(mn, d); i += 1; );
  pl_pad = max(0, -mn);
  pl_ms = clampms(trim);
  pl_mdel = max(0, pl_ms);
  pl_rep = (pl_pad + max(0, -pl_ms));
);

function sc_design_hp(fc) local(om, sn, cs, al, iv)
(
  om = (PI2 * fc) / srate_f;
  sn = sin(om); cs = cos(om);
  al = sn / (2 * QHP);
  iv = 1 / (1 + al);
  c_ha0 = ((1 * iv) * (1 + cs)) * 0.5;
  c_ha1 = -2 * c_ha0;
  c_ha2 = c_ha0;
  c_hb1 = ((-2 * cs) * iv);
  c_hb2 = (1 - al) * iv;
);

function sc_design_lp(fc) local(om, sn, cs, al, iv)
(
  om = (PI2 * fc) / srate_f;
  sn = sin(om); cs = cos(om);
  al = sn / (2 * QHP);
  iv = 1 / (1 + al);
  c_la0 = ((1 * iv) * (1 - cs)) * 0.5;
  c_la2 = c_la0;
  c_la1 = c_la0 + c_la0;
  c_lb1 = ((-2 * cs) * iv);
  c_lb2 = (1 - al) * iv;
);

function sc_params(hz, lz, hs, ls) local(i, j)
(
  hs = max(0, min(4, floor(max(0, min(4, hs)) + 0.5)));
  ls = max(0, min(4, floor(max(0, min(4, ls)) + 0.5)));
  hz = max(20, min(20000, hz));
  lz = max(20, min(20000, lz));
  hs !== c_hn ? (
    hs === 0 ? ( j = 0; loop(10, i = 0; loop(16, SCS[j * 32 + i] = 0; i += 1; ); j += 1; ); );
    c_hn = hs; c_hf = -1;
  );
  ls !== c_ln ? (
    ls === 0 ? ( j = 0; loop(10, i = 0; loop(16, SCS[j * 32 + 16 + i] = 0; i += 1; ); j += 1; ); );
    c_ln = ls; c_lf = -1;
  );
  (hs > 0 && (hz !== c_hf || c_sr !== srate)) ? ( sc_design_hp(hz); c_hf = hz; );
  (ls > 0 && (lz !== c_lf || c_sr !== srate)) ? ( sc_design_lp(lz); c_lf = lz; );
  c_sr = srate;
);

function sc_proc(inst, s) local(i, p, o, x1, y1)
(
  i = 0;
  loop(c_hn,
    p = SCS + inst * 32 + i * 4;
    x1 = p[0]; y1 = p[2];
    o = ((((s * c_ha0) + (x1 * c_ha1)) + (p[1] * c_ha2)) - (y1 * c_hb1)) - (p[3] * c_hb2);
    p[1] = x1; p[3] = y1; p[0] = s; p[2] = o;
    s = (o);
    i += 1;
  );
  i = 0;
  loop(c_ln,
    p = SCS + inst * 32 + 16 + i * 4;
    x1 = p[0]; y1 = p[2];
    o = ((((s * c_la0) + (x1 * c_la1)) + (p[1] * c_la2)) - (y1 * c_lb1)) - (p[3] * c_lb2);
    p[1] = x1; p[3] = y1; p[0] = s; p[2] = o;
    s = (o);
    i += 1;
  );
  s;
);

function sc_sanitize() local(i)
(
  i = 0;
  loop(320, abs(SCS[i]) < SM50 ? SCS[i] = 0; i += 1; );
);

function xd_reset(n)
(
  memset(XL, 0, DSZ); memset(XR, 0, DSZ);
  xd_w = xd_d = xd_from = xd_to = xd_pos = xd_len = 0;
  xd_set = max(1, n);
);

function xd_blend() local(t)
(
  xd_len <= 0 ? xd_d : (
    t = (xd_pos / max(1, xd_len));
    max(0, floor((xd_from + ((xd_to - xd_from) * t)) + 0.5));
  );
);

function xd_rd(dl) ( dl <= 0 ? xd_w : (xd_w - dl) & DMASK; );

function xd_proc(inL, inR, ds) local(t, a, b, i0, i1)
(
  ds = max(0, min(DSZ - 1, ds));
  XL[xd_w] = inL; XR[xd_w] = inR;
  ds !== xd_d ? (
    xd_from = xd_len > 0 ? xd_blend() : xd_d;
    xd_to = ds; xd_d = ds; xd_len = xd_set; xd_pos = 0;
  );
  xd_len > 0 ? (
    t = (xd_pos / max(1, xd_len));
    a = (sin((t * HALFPI))); b = (cos((t * HALFPI)));
    i0 = xd_rd(xd_from); i1 = xd_rd(xd_to);
    xd_oL = ((XL[i0] * b) + (XL[i1] * a));
    xd_oR = ((XR[i0] * b) + (XR[i1] * a));
    xd_pos += 1;
    xd_pos >= xd_len ? ( xd_len = 0; xd_pos = 0; xd_from = xd_to; );
  ) : (
    i0 = xd_rd(xd_d);
    xd_oL = XL[i0]; xd_oR = XR[i0];
  );
  xd_w = (xd_w + 1) & DMASK;
);

c_hn = c_ln = 0; c_hf = c_lf = -1; c_sr = 0;
xd_oL = xd_oR = 0;
srate_f = (srate);
max_pad = max(1, ceil((50 + 50) * 0.001 * srate));
xd_reset(floor(0.005 * srate));
corr_coef = 1 - exp(-1 / max(1, 0.05 * srate));
rep_ms = 0;

function load_lanes() local(i, k)
(
  lane_load();
  i = 0;
  loop(8,
    k = i * 8;
    LMU[i] = LPA[k] >= 0.5;
    LSO[i] = LPA[k + 1] >= 0.5;
    LPH[i] = LPA[k + 2] >= 0.5;
    LJN[i] = i > 0 && LPA[k + 3] >= 0.5;
    LDL[i] = clampms((LPA[k + 4]));
    LGN[i] = dblin((LPA[k + 5]));
    LPN[i] = max(-1, min(1, (LPA[k + 6])));
    PGL[i] = pan_l(LPN[i]); PGR[i] = pan_r(LPN[i]);
    i += 1;
  );
);

load_lanes();
i_ = 0; loop(8, JPV[i_] = LJN[i_]; i_ += 1; );
make_plan(clampms((g_trim)));
rep_ms = pl_rep;
lat_cur = 0;

WRK = 32768;
WR = alloc(8 * WRK); WM = alloc(2 * WRK); WF = alloc(2 * WRK);
WV = alloc(5 + 12 * 1024);
WSG = alloc(32); WSS = alloc(32);
wv_len = 0; wv_peak_i = 0; wv_cpre = 0; wv_cpost = 0; wv_tail = 0; wv_age = 1;
wv_fill = 0; wv_pend = 0; wv_have = 0; wv_gen = 0; wv_seq = 0; wv_sent = 0;
wh_phase = 0; wh_max = 0; wh_last = 0; wh_prev = 0; wh_pp = 0; wh_ppage = 1; wh_ref = 0;
wv_filt = 1;
WONSET = (0.02);

function wave_post_only(spanMs) local(span, preMs, postMs)
(
  span = max(24, min(240, spanMs));
  preMs = (span * 0.25);
  postMs = (span - preMs);
  max(32, min(16384, rnd(postMs * 0.001 * srate)));
);

function wave_geom(spanMs) local(span, preMs, postMs, room, sc)
(
  span = max(24, min(240, spanMs));
  preMs = (span * 0.25);
  postMs = (span - preMs);
  wg_pre = max(16, min(16384, vrnd(preMs * 0.001 * srate)));
  wg_post = max(32, min(16384, vrnd(postMs * 0.001 * srate)));
  wg_pad = max(64, min(8192, vrnd(50 * 0.001 * srate)));
  wg_win = wg_pad + wg_pre + wg_post + wg_pad;
  wg_win > WRK ? (
    room = WRK - wg_pre - wg_post;
    room < 128 ? (
      sc = ((WRK - 128) / (wg_pre + wg_post));
      wg_pre = max(16, floor(wg_pre * sc));
      wg_post = max(32, WRK - 128 - wg_pre);
      room = WRK - wg_pre - wg_post;
    );
    wg_pad = max(64, floor(room / 2));
    wg_win = wg_pad + wg_pre + wg_post + wg_pad;
  );
);

wave_geom(240);
wm_pre = wg_pre; wm_post = wg_post; wm_pad = wg_pad; wm_win = wg_win;

function wv_reset()
(
  wv_have = 0; wv_fill = 0; wv_pend = 0; wv_age = 1; wv_tail = 0;
  wv_len = wv_peak_i = wv_cpre = wv_cpost = 0;
  wv_gen = 0; wv_seq = 0; wv_sent = 0;
  wh_phase = 0; wh_max = wh_last = 0; wh_prev = 0; wh_pp = 0; wh_ppage = 1; wh_ref = 0;
);

function ring_copy(k, dst, win) local(w, st, n1)
(
  w = WP[k];
  st = (w - win) & DMASK;
  st + win <= DSZ ? memcpy(dst, DLB + k * DSZ + st, win) : (
    n1 = DSZ - st;
    memcpy(dst, DLB + k * DSZ + st, n1);
    memcpy(dst + n1, DLB + k * DSZ, win - n1);
  );
);

function wv_snap(peakAge, publish) local(pk, tail, win, l, c)
(
  pk = wm_pad + wm_pre;
  tail = wm_win - pk;
  peakAge = max(1, min(tail, peakAge));
  win = pk + peakAge;
  (pk < 8 || win < pk + 1 || win > WRK - 1) ? 0 : (
    wv_peak_i = pk; wv_len = win; wv_cpre = wm_pre; wv_cpost = wm_post; wv_tail = tail; wv_age = peakAge;
    l = 0;
    loop(8, ring_copy(wv_filt ? 8 + l : l, WR + l * WRK, win); l += 1; );
    c = 0;
    loop(2,
      ring_copy(wv_filt ? 16 + c : 18 + c, WM + c * WRK, win);
      ring_copy(wv_filt ? 20 + c : 22 + c, WF + c * WRK, win);
      c += 1;
    );
    wv_have = 1;
    publish ? wv_seq += 1;
  );
);

LKD = alloc(256); lk_n = 0; sm_pos = 0;
function wv_arm(peakAge)
(
  lk_n < 100 ? ( LKD[lk_n * 2] = sm_pos; LKD[lk_n * 2 + 1] = peakAge; lk_n += 1; );
  wv_peak_i = wm_pad + wm_pre;
  wv_cpre = wm_pre; wv_cpost = wm_post;
  wv_tail = wm_win - wv_peak_i;
  wv_age = max(1, min(wv_tail, peakAge));
  wv_fill = 1; wv_pend = 1;
  wv_gen += 1;
  wv_snap(wv_age, 0);
);

function wv_try_lock(peakAge) local(sm)
(
  (wv_fill || wh_ref > 0) ? 0 : (
    wv_arm(peakAge);
    wh_ref = max(1, rnd(0.5 * (max(24, min(240, (g_span)))) * 0.001 * srate));
  );
);

function wv_tick(x, active) local(ax, zc, P, pa)
(
  wv_fill ? (
    wv_age += 1;
    wv_age >= wv_tail ? (
      pa = wv_pend; wv_pend = 0;
      wv_snap(wv_tail, pa);
      wv_fill = 0;
    ) : (wv_pend && wv_age >= want_post) ? (
      wv_pend = 0;
      wv_snap(wv_age, 1);
    ) : (wv_age % 64) === 0 ? (
      wv_snap(wv_age, 0);
    );
  );
  wh_ref > 0 ? wh_ref -= 1;
  !active ? (
    wh_phase = 0; wh_max = wh_last = 0; wh_prev = 0; wh_pp = 0; wh_ppage = 1; wh_ref = 0;
  ) : (
    ax = abs(x);
    ax >= wh_pp ? ( wh_pp = ax; wh_ppage = 1; ) : wh_ppage += 1;
    zc = (wh_prev < 0 && x >= 0) || (wh_prev > 0 && x <= 0);
    wh_prev = x;
    zc ? (
      P = wh_pp; pa = max(1, wh_ppage);
      wh_pp = ax; wh_ppage = 1;
      (P <= WONSET && wh_last <= WONSET) ? ( wh_last = P; ) : (
        wh_phase === 0 ? (
          P > WONSET ? ( wv_try_lock(pa); wh_max = wh_last = P; wh_phase = 1; );
        ) : wh_phase === 1 ? (
          P >= wh_last ? ( wh_max = max(wh_max, P); wh_last = P; ) : ( wh_last = P; wh_phase = 2; );
        ) : (
          P > wh_last ? ( wv_try_lock(pa); wh_max = wh_last = P; wh_phase = 1; ) : wh_last = P;
        );
      );
    );
  );
);

function vjoin(l) ( l > 0 && slider(12 + l * 7 + 3) >= 0.5; );
function vdel(l) ( max(-50, min(50, (slider(12 + l * 7 + 4)))); );
function vroot(l) ( while (l > 0 && vjoin(l)) ( l -= 1; ); l; );
function veff(l) local(root, base)
(
  root = vroot(l);
  base = vdel(root);
  l === root ? base : max(-50, min(50, (base + vdel(l))));
);

function wv_sig(sp, trim, byp, anc)
(
  WSG[0] = wv_gen; WSG[1] = wv_seq; WSG[2] = max(24, min(240, sp)); WSG[3] = max(-50, min(50, trim));
  WSG[4] = byp; WSG[5] = anc;
  i_s = 0; loop(8, WSG[8 + i_s] = veff(i_s); WSG[16 + i_s] = slider(12 + i_s * 7 + 2) >= 0.5; i_s += 1; );
);

function wv_sig_same() local(i, sm)
(
  i = 0; sm = 1;
  loop(24, WSG[i] !== WSS[i] ? sm = 0; i += 1; );
  sm;
);

function wv_sample_raw(base, idx, win) local(i0, fr)
(
  (idx < 0 || idx > max(0, win - 1)) ? 0 : win <= 1 ? base[0] : (
    i0 = floor(idx); fr = idx - i0;
    i0 >= win - 1 ? base[win - 1] : base[i0] + (base[i0 + 1] - base[i0]) * fr;
  );
);

function wv_pack(dst, base, delaySamp, sgn) local(b)
(
  b = 0;
  loop(wp_bins,
    dst[b] = wv_sample_raw(base, wp_start + b * wp_scale - delaySamp, wv_len) * sgn;
    b += 1;
  );
);

function wv_take(sp, trim, byp, anc) local(win, pk, view_pre, view_post, view_len, bins, pre_bins, byp_on, ad, l, ds, sg, mt)
(
  (!wv_have || wv_len < 8 || wv_pend) ? 0 : (
    wv_sig(sp, trim, byp, anc);
    (wv_sent && wv_sig_same()) ? 0 : (
      win = wv_len;
      pk = max(1, min(max(1, win - 1), wv_peak_i));
      wave_geom(WSG[2]);
      view_pre = max(1, min(pk, wg_pre));
      view_post = max(1, wg_post);
      view_len = view_pre + view_post;
      (view_len < 2 || pk - view_pre < 0) ? 0 : (
        wp_start = pk - view_pre;
        bins = max(64, min(1024, view_len));
        pre_bins = max(1, min(bins - 2, vrnd(view_pre / (view_len - 1) * (bins - 1))));
        wp_bins = bins;
        wp_scale = (view_len - 1) / (bins - 1);
        WV[0] = bins; WV[1] = 8; WV[2] = pre_bins;
        WV[3] = view_pre * 1000 / srate; WV[4] = view_post * 1000 / srate;
        ad = WSG[4] ? 0 : WSG[8 + WSG[5]] * 0.001 * srate;
        l = 0;
        loop(8,
          ds = WSG[4] ? 0 : WSG[8 + l] * 0.001 * srate - ad;
          sg = (!WSG[4] && WSG[16 + l]) ? -1 : 1;
          wv_pack(WV + 5 + l * bins, WR + l * WRK, ds, sg);
          l += 1;
        );
        mt = WSG[4] ? 0 : WSG[3] * 0.001 * srate;
        wv_pack(WV + 5 + 8 * bins, WM, mt, 1);
        wv_pack(WV + 5 + 9 * bins, WM + WRK, mt, 1);
        wv_pack(WV + 5 + 10 * bins, WF, 0, 1);
        wv_pack(WV + 5 + 11 * bins, WF + WRK, 0, 1);
        memcpy(WSS, WSG, 24);
        wv_sent = 1;
        5 + 12 * bins;
      );
    );
  );
);

