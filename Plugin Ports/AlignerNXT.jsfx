  gm_labels(x, w, y + 34, 8);
);

function gl_s(n, k) ( 12 + n * 7 + k; );
function gjn(l) ( l > 0 && slider(gl_s(l, 3)) >= 0.5; );
function groot(l) ( while (l > 0 && gjn(l)) ( l -= 1; ); l; );
function gend(l) ( while (l + 1 < 8 && gjn(l + 1)) ( l += 1; ); l; );

function gstep(span) ( span >= 200 ? 50 : span >= 120 ? 25 : span >= 64 ? 20 : span >= 40 ? 10 : span >= 24 ? 5 : 4; );

function gpeak(ch) local(o, i, p, bins)
(
  bins = WV[0]; o = 5 + ch * bins; p = 0; i = 0;
  loop(bins, p = max(p, abs(WV[o + i])); i += 1; );
  p;
);

function gpeak2(c1, c2) local(o1, o2, i, p, bins)
(
  bins = WV[0]; o1 = 5 + c1 * bins; o2 = 5 + c2 * bins; p = 0; i = 0;
  loop(bins, p = max(p, abs(WV[o1 + i] + WV[o2 + i])); i += 1; );
  p;
);

function gsamp(o, b, bins, sc, c2) local(i0, fr, a, b1)
(
  i0 = max(0, min(bins - 2, floor(b)));
  fr = b - i0;
  c2 >= 0 ? (
    a = WV[o + i0] + WV[c2 + i0]; b1 = WV[o + i0 + 1] + WV[c2 + i0 + 1];
  ) : (
    a = WV[o + i0]; b1 = WV[o + i0 + 1];
  );
  (a + (b1 - a) * fr) / sc;
);

function gstrip(x, y, w, h, ch, g1, g2, mode, pcol, slv, trimv) local(pre, post, span, step, t, lx, bins, n, c, u, b, yy, py, px, pk, gk, hh, cy, o, og, og2, ok, ogk, a0, lab, fw, bw)
(
  hexc(0x000103, 1); grect(x, y, w, h);
  hexc(0x14151a, 1); ghl(x, y, w); ghl(x, y + h - 1, w); gvl(x, y, h); gvl(x + w - 1, y, h);
  pre = 8; post = 24;
  gwv_ok ? ( pre = WV[3]; post = WV[4]; );
  span = pre + post;
  step = gstep(span);
  t = ceil(-pre / step - 0.000000001) * step;
  gfont(9, 0);
  while (t <= post + 0.000001) (
    lx = x + (t + pre) / span * w;
    hexc(0xfdfeff, t === 0 ? 0.55 : 0.15);
    gvl(lx, y + 1, h - 2);
    (t === 0 || (floor(t / step + 0.5) % 2) === 0) ? (
      hexc(0xfdfeff, 0.85);
