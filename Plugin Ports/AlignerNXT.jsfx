th_day = 0; th_sch = 0; th_key = -1; th_on = 0; th_fr = th_fg = th_fb = 0; th_ir = 0.99216; th_ig = 0.99608; th_ib = 1;
GLC = alloc(64);

@block
load_lanes();
i = 1;
loop(7,
  on = LJN[i];
  (on && !JPV[i]) ? (
    rootms = LDL[group_root(i)];
    nd = clampms((LDL[i] - rootms));
    lane_set_delay(i, nd); LDL[i] = nd;
  ) : (!on && JPV[i]) ? (
    LJN[i] = 1; root = group_root(i); LJN[i] = 0;
    nd = clampms((LDL[root] + LDL[i]));
    lane_set_delay(i, nd); LDL[i] = nd;
  );
  JPV[i] = on;
  i += 1;
);

bypass = g_bypass >= 0.5;
in_gain = bypass ? 1 : dblin((g_in));
out_gain = bypass ? 1 : dblin((g_out));
trim_ms = bypass ? 0 : clampms((g_trim));
master_vol = dblin((g_vol));
anchor = max(0, min(7, rnd((g_anchor))));
f_hit = g_fhit >= 0.5; f_wave = g_fwave >= 0.5; f_corr = g_fcorr >= 0.5;

gui_beat !== gb_prev ? ( gb_prev = gui_beat; gb_idle = 0; ) : gb_idle += samplesblock;
viz_on = viz_force || gb_idle < srate * 0.5;
wv_filt = f_wave;
want_post = wave_post_only((g_span));
viz_on && wv_have && bypass !== byp_prev ? wv_snap(max(1, wv_age), 1);
byp_prev = bypass;

viz_on ? (
  sc_params((g_hp), (g_lp), floor(max(0, min(4, (g_hpm))) + 0.5), floor(max(0, min(4, (g_lpm))) + 0.5));
  sc_sanitize();
);

any_solo = 0;
i = 0; loop(8, LSO[i] ? any_solo = 1; i += 1; );

mx = bypass ? 0 : eff_delay(0);
!bypass ? ( i = 1; loop(7, mx = max(mx, eff_delay(i)); i += 1; ); );
vz_maxlag = mx;

bypass ? (
  rep_use = rep_ms;
  pl_pad = 0; pl_mdel = 0;
) : (
  make_plan(trim_ms);
  rep_ms = pl_rep; rep_use = pl_rep;
);
lane_pad_s = bypass ? 0 : ms_samp(pl_pad);
out_del_c = bypass ? 0 : ms_samp(pl_mdel);
rep_lat = ms_samp(rep_use);
vz_lat = rep_use;
pdc_delay = rep_lat; pdc_bot_ch = 0; pdc_top_ch = 2;

i = 0;
loop(8,
  DSM[i] = max(0, min(DSZ - 2, lane_pad_s + rnd(eff_delay(i) * 0.001 * srate)));
  i += 1;
);

@sample
sm_pos += 1;
i = 0;
loop(8,
  RAWV[i] = (spl(i) * in_gain);
  abs(RAWV[i]) > MTI[i] ? MTI[i] = abs(RAWV[i]);
  i += 1;
);
refL = (spl(8) * in_gain); refR = (spl(9) * in_gain);

i = 0;
loop(8,
  dl_w(i, RAWV[i]);
  i += 1;
);

viz_on ? (
  i = 0;
  loop(8,
    FILV[i] = sc_proc(i, RAWV[i]);
    dl_w(8 + i, FILV[i]);
    i += 1;
  );
  dl_w(20, sc_proc(8, refL)); dl_w(21, sc_proc(9, refR));
  dl_w(22, refL); dl_w(23, refR);
  wv_tick(f_hit ? FILV[anchor] : RAWV[anchor], 1);
);

sumL = sumR = dryL = dryR = 0;
mfL = mfR = mrL = mrR = 0;
i = 0;
loop(8,
  d = DSM[i];
  raw = RAWV[i];
  r = (d <= 0 || bypass) ? raw : dl_r(i, max(1, d));
  viz_on ? ( f = ((d <= 0 || bypass) ? FILV[i] : dl_r(8 + i, max(1, d))); );
  !bypass && LPH[i] ? ( r = -r; viz_on ? f = -f; );
  ARW[i] = r;
  viz_on ? AFL[i] = f;
  y = bypass ? (raw * LGN[i]) : (r * LGN[i]);
  audible = !LMU[i] && (!any_solo || LSO[i]);
  gl = PGL[i]; gr = PGR[i];
  audible ? (
    sumL = (sumL + (y * gl));
    sumR = (sumR + (y * gr));
    viz_on ? (
      mfL = (mfL + ((f * LGN[i]) * gl));
      mfR = (mfR + ((f * LGN[i]) * gr));
      mrL = (mrL + ((r * LGN[i]) * gl));
      mrR = (mrR + ((r * LGN[i]) * gr));
    );
    bypass ? (
      dryL = (dryL + (y * gl));
      dryR = (dryR + (y * gr));
    );
  );
  i += 1;
);

viz_on ? (
  dl_w(16, mfL); dl_w(17, mfR); dl_w(18, mrL); dl_w(19, mrR);
  xa = f_corr ? AFL[anchor] : ARW[anchor];
  i = 0;
  loop(8,
    xb = f_corr ? AFL[i] : ARW[i];
    CRN[i] += corr_coef * (xa * xb - CRN[i]);
    CRA[i] += corr_coef * (xa * xa - CRA[i]);
    CRB[i] += corr_coef * (xb * xb - CRB[i]);
    den = sqrt(max(0, CRA[i] * CRB[i])) + 0.00000000000000000001;
    cv = max(-1, min(1, CRN[i] / den));
    CRS[i] += corr_coef * (cv - CRS[i]);
    i += 1;
  );
);

useL = bypass ? dryL : sumL;
useR = bypass ? dryR : sumR;
useL = (useL * master_vol);
useR = (useR * master_vol);
xd_proc(useL, useR, bypass ? rep_lat : out_del_c);
spl0 = (xd_oL * out_gain);
spl1 = (xd_oR * out_gain);
abs(spl0) > mt_ol ? mt_ol = abs(spl0);
abs(spl1) > mt_or ? mt_or = abs(spl1);

@gfx 1024 700

grr_hl = 0;
gk_lfs = 9;
gW = 1024; gH = 700;
gsc = max(0.4, min(gfx_w / gW, gfx_h / gH));
gox = floor((gfx_w - gW * gsc) * 0.5);
goy = 0;
gwheel = mouse_wheel; mouse_wheel = 0;
gui_beat += 1;
gnow = time_precise();
gdest0 = gfx_dest;

function automate(s, e)
(
<?
  loop(i = 1; 70,
    printf("  s == %d ? slider_automate(slider%d, e) :\n", i, i);
    i += 1;
  );
?> 0;
);

function gxp(x) ( gox + x * gsc; );
function gyp(y) ( goy + y * gsc; );
function gfont(sz, fl) ( gfx_setfont(1, "Arial", sz * gsc, fl); );
function hexc(h, a) local(i)
(
  (h === 0xfdfeff && th_on) ? ( th_on = 0; gfx_set(TC[40], TC[41], TC[42], a); ) : (
    i = h === 0x0066ff ? 24 : h === 0xff0066 ? 30 : h === 0xff6600 ? 33 :
        (h === 0x010203 || h === 0x000000 || h === 0x020305 || h === 0x000103) ? 0 : (h === 0x0a0d10 || h === 0x0b0c10) ? 3 :
        (h === 0x1a1d22 || h === 0x15181d || h === 0x1d2025 || h === 0x14151a || h === 0x1d1e22) ? 6 : h === 0x32353d ? 9 :
        (h === 0xfdfeff || h === 0xffffff) ? 12 : h === 0xd8dde2 ? 15 : h === 0xb6bac1 ? 18 : h === 0x9498a2 ? 21 : -1;
    h === 0x2a2e35 ? gfx_set((TC[6] + TC[9]) * 0.5, (TC[7] + TC[10]) * 0.5, (TC[8] + TC[11]) * 0.5, a) :
    i >= 0 ? gfx_set(TC[i], TC[i + 1], TC[i + 2], a) :
    gfx_set(((h >> 16) & 255) / 255, ((h >> 8) & 255) / 255, (h & 255) / 255, a);
  );
);
function grect(x, y, w, h) ( gfx_rect(gxp(x), gyp(y), w * gsc, h * gsc); );
function grr(x, y, w, h, r) local(px, py, ix, iy, iw, ih, rp, j, yc, ins, x0, x1, a0, cv, cr, cg, cb, hl, hh)
(
  px = gxp(x); py = gyp(y);
  ix = floor(px + 0.5); iy = floor(py + 0.5);
  iw = floor(px + w * gsc + 0.5) - ix; ih = floor(py + h * gsc + 0.5) - iy;
  rp = min(r * gsc, min(ih, iw) * 0.5);
  a0 = gfx_a; cr = gfx_r; cg = gfx_g; cb = gfx_b;
  hh = ih * 0.45;
  j = 0;
  loop(ih,
    yc = min(j + 0.5, ih - j - 0.5);
    ins = yc < rp ? rp - sqrt(max(0, rp * rp - sqr(rp - yc))) : 0;
    x0 = ceil(ix + ins); x1 = floor(ix + iw - ins);
    gfx_a = a0; gfx_r = cr; gfx_g = cg; gfx_b = cb;
