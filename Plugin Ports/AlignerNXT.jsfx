);

function gcorr(x, y, w, v) local(hw, bw)
(
  hw = w * 0.5;
  hexc(0x010203, 1); grect(x, y, w, 2);
  hexc(0xff6600, 0.2); grect(x, y, hw, 2);
  hexc(0x0066ff, 0.2); grect(x + hw, y, hw, 2);
