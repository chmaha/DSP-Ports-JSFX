  r0 = 0; r1 = ceil(61.32243 * p) + 2;
  r = r0;
  pw = 1 / max(0.0001, p * (LGB1 - LGB0));
  loop(r1 - r0 + 1,
    sub = 0;
    loop(4,
      yy = r + (sub + 0.5) * 0.25;
      n = 0;
      q = LGY + LGO[sh]; ns = q[0]; q += 1; si = 0;
      loop(ns,
        np = q[0]; pgb = q + 1;
        k = 0;
        loop(np,
          pt = pgb + k * 2;
          x1 = 1 + pt[0] * p; y1 = 1 + pt[1] * p;
          k + 1 < np ? ( x2 = 1 + pt[2] * p; y2 = 1 + pt[3] * p; ) : ( x2 = 1 + pgb[0] * p; y2 = 1 + pgb[1] * p; );
          (y1 <= yy) !== (y2 <= yy) ? (
            LGX[n] = x1 + (yy - y1) / (y2 - y1) * (x2 - x1);
            LGX[128 + n] = y2 > y1 ? 1 : -1;
            n += 1;
          );
          k += 1;
        );
        q += 1 + np * 2;
      );
      i = 1;
      loop(max(n - 1, 0),
        t = LGX[i]; wd = LGX[128 + i]; j = i - 1;
        while (j >= 0 && LGX[j] > t) ( LGX[j + 1] = LGX[j]; LGX[129 + j] = LGX[128 + j]; j -= 1; );
        LGX[j + 1] = t; LGX[129 + j] = wd;
        i += 1;
      );
      i = 0; wn = 0; xa = 0;
      loop(n,
        wn === 0 ? xa = LGX[i];
        wn += LGX[128 + i];
        wn === 0 ? (
          xb = LGX[i];
          ia = floor(xa); ib = floor(xb);
          px = ia;
          loop(ib - ia + 1,
            grad ? ( grad_at(max(0, min(1, ((px + 0.5 - 1) / p - LGB0) * pw * p))); ) : gfx_set(th_ir, th_ig, th_ib, 1);
            gfx_a = (min(xb, px + 1) - max(xa, px)) / (4 - sub);
            gfx_rect(px, r, 1, 1);
            px += 1;
          );
        );
        i += 1;
      );
      sub += 1;
    );
    r += 1;
  );
);

function nxt_logo(x, y) local(p, iw, ih, dr, dg, db, da, dm)
(
  p = 32 * gsc / 61.32243;
  iw = ceil(160.33209 * p) + 3; ih = ceil(61.32243 * p) + 3;
  (LGK[0] !== gsc || LGK[1] !== th_key) ? (
    dr = gfx_r; dg = gfx_g; db = gfx_b; da = gfx_a; dm = gfx_mode;
    gfx_setimgdim(20, iw, ih);
    gfx_dest = 20;
    th_day ? gfx_set(TC[0], TC[1], TC[2], 1) : gfx_set(0, 0, 0, 1); gfx_mode = 0;
    gfx_rect(0, 0, iw, ih);
    lg_raster(0, p, 0);
    lg_raster(1, p, 1);
    gfx_dest = gdest0;
    gfx_r = dr; gfx_g = dg; gfx_b = db; gfx_a = da; gfx_mode = dm;
    LGK[0] = gsc; LGK[1] = th_key;
  );
  dm = gfx_mode; da = gfx_a; gfx_mode = th_day ? 0 : 1; gfx_a = 1;
  gfx_blit(20, 1, 0, 0, 0, iw, ih, floor(gxp(x) - 1), floor(gyp(y) - 1), iw, ih);
  gfx_mode = dm; gfx_a = da;
);

function title_logo(x, y, name) local(tw, th)
