    c_gr0 = s0_gr;
    c_gm0 = s0_gr - c_comp;
  ) : (
    k_ = s0_gr * 2; k_ < 0 ? ( k_ = 0; ) : ( k_ = k_ | 0; ); k_ > 73 ? ( k_ = 73; );
    s0_gr > s0_op ? ( a_ = OPA[k_]; s0_op = (a_ * s0_op) + (1 - a_) * s0_gr; ) : ( a_ = OPR[k_]; s0_op = (a_ * s0_op) + (1 - a_) * s0_gr; );
    s0_op < s0_id ? ( d_ = s0_id - s0_op; d_ = 24 - (24 / (1 + (d_ / 24))); c_gr0 = s0_id - d_; ) : c_gr0 = s0_op;
    FIXQ ? c_gm0 = c_gr0 - c_comp : (
      s0_gr > s0_op ? ( a_ = OPA[k_]; s0_op = (a_ * s0_op) + (1 - a_) * s0_gr; ) : ( a_ = OPR[k_]; s0_op = (a_ * s0_op) + (1 - a_) * s0_gr; );
      s0_op < s0_id ? ( d_ = s0_id - s0_op; d_ = 24 - (24 / (1 + (d_ / 24))); c_gm0 = s0_id - d_; ) : c_gm0 = s0_op;
