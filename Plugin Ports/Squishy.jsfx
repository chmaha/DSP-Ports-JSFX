    s1_op < s1_id ? ( d_ = s1_id - s1_op; d_ = 24 - (24 / (1 + (d_ / 24))); c_gr1 = s1_id - d_; ) : c_gr1 = s1_op;
    FIXQ ? c_gm1 = c_gr1 - c_comp : (
