slider1:sq_bypass=0<0,1,1{Active,Bypassed}>-Bypass
slider2:sq_rms=0<0,1,1{Peak (0 ms),RMS (30 ms)}>-Detector Sensing
slider3:sq_design=1<0,1,1{Feed-Forward,Feed-Back}>-Design
slider4:sq_detector=2<0,2,1{Linear,Smooth,Logarithmic}>-Release Curve
slider5:sq_stage=0<0,1,1{FET,Optical}>-Gain Stage
slider6:sq_thresh=-12<-48,19,1>-Threshold (dB)
slider7:sq_ratio=3<0.1,20,0.01>-Ratio
slider8:sq_knee=0<0,2,1{Hard (0 dB),Medium (24 dB),Soft (48 dB)}>-Knee
slider9:sq_attack=10<0.02,500,0.01>-Attack (ms)
slider10:sq_release=175<0,8000,1>-Release (ms)
slider11:sq_automu=0<0,1,1{Manual,Auto}>-Auto Make-Up Gain
slider12:sq_makeup=0<-36,36,0.1>-Make-Up Gain (dB)
slider13:sq_wet=100<0,100,1>-Wet Mix (%)
slider14:sq_scext=0<0,1,1{Internal,External}>-Side-Chain Input
slider15:sq_hpf=20<20,15000,1>-Side-Chain HPF (Hz)
slider16:sq_lpf=15000<20,15000,1>-Side-Chain LPF (Hz)
slider17:sq_listen=0<0,1,1{Compressor,Side-Chain}>-Side-Chain Listen
slider18:sq_trim=0<-36,36,0.1>-Input Trim (dB)
slider19:sq_link=100<0,100,1>-Stereo Link (%)
slider20:sq_m_thr=0<0,1,1{Presets,Continuous}>-Threshold Mode
slider21:sq_m_rat=0<0,1,1{Presets,Continuous}>-Ratio Mode
slider22:sq_m_att=0<0,1,1{Presets,Continuous}>-Attack Mode
slider23:sq_m_rel=0<0,1,1{Presets,Continuous}>-Release Mode
slider24:sq_m_mku=0<0,1,1{Presets,Continuous}>-Make-Up Gain Mode
slider25:sq_m_wet=0<0,1,1{Presets,Continuous}>-Wet Mix Mode
slider26:sq_m_hpf=0<0,1,1{Presets,Continuous}>-Side-Chain HPF Mode
slider27:sq_m_lpf=0<0,1,1{Presets,Continuous}>-Side-Chain LPF Mode
slider28:sq_m_trm=0<0,1,1{Presets,Continuous}>-Input Trim Mode
slider29:sq_m_lnk=0<0,1,1{Presets,Continuous}>-Stereo Link Mode
slider30:sq_skin=0<0,3,1{Default,Lemonade,Lime,Blood Orange}>-Skin

in_pin:Left input
in_pin:Right input
in_pin:Side-chain left
in_pin:Side-chain right
out_pin:Left output
out_pin:Right output
options:no_meter

@init
ext_noinit = gfx_ext_retina = 1;
last_srate = srate;
FIXQ = 1;

function f32(x) local(c) ( c = x * 536870913; c - (c - x); );
function rnd_az(x) ( x < 0 ? -floor(-x + 0.5) : floor(x + 0.5); );
function l2db(l) local(d) ( l === 0 ? -70.01 : ( d = 20 * log10(l); d < -70.01 ? -70.01 : d; ); );
function db2l(d) ( 10 ^ (d / 20); );

function alloc(n) local(r) instance(mp) global() ( r = mp; mp += n; memset(r, 0, n); r; );

OPA = alloc(80);
OPR = alloc(80);

PR_THR = alloc(32); PR_RAT = alloc(32); PR_ATT = alloc(32); PR_REL = alloc(32); PR_MKU = alloc(48);
PR_WET = alloc(16); PR_HPF = alloc(20); PR_LPF = alloc(20); PR_TRM = alloc(48); PR_LNK = alloc(8);
i_ = 0; loop(28, PR_THR[i_] = -36 + 2 * i_; i_ += 1; ); PR_THR_N = 28;
mem_set_values(PR_RAT, 0.5, 0.67, 0.83, 0.91, 1, 1.1, 1.2, 1.5, 2, 2.5, 3, 4, 6, 8, 10, 14, 20); PR_RAT_N = 17;
mem_set_values(PR_ATT, 0.02, 0.05, 0.1, 0.2, 0.5, 1, 2, 5, 10, 20, 50, 100, 200, 500); PR_ATT_N = 14;
mem_set_values(PR_REL, 50, 75, 100, 125, 150, 175, 200, 250, 375, 500, 750, 1000, 1500, 2000); PR_REL_N = 14;
i_ = 0; loop(37, PR_MKU[i_] = -18 + i_; PR_TRM[i_] = -18 + i_; i_ += 1; ); PR_MKU_N = PR_TRM_N = 37;
mem_set_values(PR_WET, 0, 5, 10, 15, 20, 25, 30, 40, 50, 75, 100); PR_WET_N = 11;
mem_set_values(PR_HPF, 20, 47, 68, 100, 150, 220, 330, 470, 680, 1000, 1500, 2200, 3300, 4700, 6800, 10000); PR_HPF_N = 16;
mem_set_values(PR_LPF, 47, 68, 100, 150, 220, 330, 470, 680, 1000, 1500, 2200, 3300, 4700, 6800, 10000, 15000); PR_LPF_N = 16;
mem_set_values(PR_LNK, 0, 25, 50, 70, 80, 90, 100); PR_LNK_N = 7;
i_ = 0; loop(PR_RAT_N, PR_RAT[i_] = f32(PR_RAT[i_]); PR_ATT[i_] = f32(PR_ATT[i_]); i_ += 1; );

function nearest(tab, n, v) local(k, best, bd, dd)
(
  v = f32(v);
  best = 0; bd = abs(f32(v - tab[0]));
  k = 1;
  loop(n - 1,
    dd = abs(f32(v - tab[k]));
    dd < bd ? ( best = k; bd = dd; );
    k += 1;
  );
  tab[best];
);

function cround(v, lo, hi, dp, adapt) local(a, f)
(
  v = max(lo, min(hi, v));
  adapt ? ( a = abs(v); a >= 10 ? dp = 0 : a >= 1 ? dp = 1; );
  f = 10 ^ dp;
  f32(rnd_az(f32(v * f)) / f);
);

function pval(v, cont, tab, n, lo, hi, dp, adapt)
(
  cont >= 0.5 ? cround(v, lo, hi, dp, adapt) : nearest(tab, n, v);
);

function gain_comp(x) local(ab, fa)
(
  ab = x - c_thr;
  c_knee === 0 ? (
    x <= c_thr ? 0 : ab * c_ri;
  ) : (
    ab < -c_kh ? 0 : ab > c_kh ? ab * c_ri : (
      fa = ab + c_kh;
      ((fa * fa) / c_kd) * c_ri;
    );
  );
);

function set_comp() ( c_comp = gain_comp(20) / 2; );

function set_attack() local(s)
(
  c_att <= 0 ? c_ac = 0 : ( s = c_att / 1000; c_ac = exp(log(0.10) / (s * srate)); );
  c_ac1 = 1 - c_ac;
);

function set_release() local(s)
(
  c_rel <= 0 ? c_rc = 0 : (
    s = c_rel / 1000;
    c_curve === 0 ? c_rc = 10 / (s * srate) : c_rc = exp(log(0.10) / (s * srate));
  );
  c_rc1 = 1 - c_rc;
);

function set_rms()
(
  c_rmsms <= 0 ? ( c_rmsms = 0; c_wc = 0; ) : c_wc = exp(log(0.10) / ((c_rmsms / 1000) * srate));
  c_wc1 = 1 - c_wc;
);

function hp_coefs(fc) local(th, d, be, ga)
(
  th = ((2 * $pi) * fc) / srate;
  d = 1 / 0.707;
  be = (0.5 * (1 - ((d / 2) * sin(th)))) / (1 + ((d / 2) * sin(th)));
  ga = (0.5 + be) * cos(th);
  h_a0 = (0.5 + be + ga) / 2;
  h_a1 = -(0.5 + be + ga);
  h_a2 = h_a0;
  h_b1 = -2 * ga;
  h_b2 = 2 * be;
);

function lp_coefs(fc) local(th, d, be, ga)
(
  th = ((2 * $pi) * fc) / srate;
  d = 1 / 0.707;
  be = (0.5 * (1 - ((d / 2) * sin(th)))) / (1 + ((d / 2) * sin(th)));
  ga = (0.5 + be) * cos(th);
  l_a0 = ((0.5 + be) - ga) / 2;
  l_a1 = (0.5 + be) - ga;
  l_a2 = l_a0;
  l_b1 = -2 * ga;
  l_b2 = 2 * be;
);

function opto_tables() local(k, dbv, res, ar, rr)
(
  k = 0;
  loop(74,
    dbv = k / 2;
    res = 480 / (3 + dbv);
    ar = res / 10;
    rr = res;
    OPA[k] = exp(log(0.27) / ((ar / 1000) * srate));
    OPR[k] = exp(log(0.27) / ((rr / 1000) * srate));
    k += 1;
  );
);

function reset_all()
(
  opto_tables();
  s0_gr = s1_gr = s0_id = s1_id = s0_im = s1_im = s0_sq = s1_sq = 0;
  s0_op = s1_op = 0;
  c_gr0 = c_gr1 = c_gm0 = c_gm1 = c_os0 = c_os1 = 0;
  h0_x1 = h0_x2 = h0_y1 = h0_y2 = h1_x1 = h1_x2 = h1_y1 = h1_y2 = 0;
  l0_x1 = l0_x2 = l0_y1 = l0_y2 = l1_x1 = l1_x2 = l1_y1 = l1_y2 = 0;
  c_hpon = c_lpon = 0;
  mt_n = floor(srate * 0.050); mt_pos = 0;
  mt_pi0 = mt_pi1 = mt_po0 = mt_po1 = 0;
  mt_si0 = mt_si1 = mt_so0 = mt_so1 = 0;
  m_pi0 = m_pi1 = m_po0 = m_po1 = m_ai0 = m_ai1 = m_ao0 = m_ao1 = -(70.01 + 20);
  m_rel = (26 * 0.050) / 3;
  m_avc = 0.01 ^ (0.050 / 0.300);
  pv_byp = pv_rms = pv_des = pv_cur = pv_stg = pv_thr = pv_rat = pv_kne = pv_att = pv_rel = -1000000;
  pv_amu = pv_mku = pv_wet = pv_sci = pv_hpf = pv_lpf = pv_lis = pv_trm = pv_lnk = -1000000;
  c_thr = -12; c_ri = 1 - (1 / 2); c_knee = 0; c_kh = 0; c_kd = 0; c_curve = 2; c_stage = 0;
  c_att = 10; c_rel = 100; c_rmsms = 10;
  c_hpf = c_lpf = 0;
);

function apply_params() local(v)
(
  v = sq_bypass >= 0.5;
  v !== pv_byp ? ( pv_byp = v; c_byp = v; );
  v = sq_rms >= 0.5 ? 30 : 0;
  v !== pv_rms ? ( pv_rms = v; c_rmsms = v; set_rms(); );
  v = sq_design >= 0.5 ? 1 : 0;
  v !== pv_des ? ( pv_des = v; c_ff = v === 0; );
  v = max(0, min(2, floor(sq_detector + 0.5)));
  v !== pv_cur ? ( pv_cur = v; c_curve = v; s0_im = s1_im = 0; set_attack(); set_release(); );
  v = sq_stage >= 0.5 ? 1 : 0;
  v !== pv_stg ? ( pv_stg = v; c_stage = v; set_comp(); s0_op = s0_gr; s1_op = s1_gr; );
  v = pval(sq_thresh, sq_m_thr, PR_THR, PR_THR_N, -48, 19, 0, 0);
  v !== pv_thr ? ( pv_thr = v; c_thr = v; set_comp(); );
  v = pval(sq_ratio, sq_m_rat, PR_RAT, PR_RAT_N, 0.1, 20, 2, 1);
  v !== pv_rat ? (
    pv_rat = v;
    v < 1 ? ( c_up = 1; v = 1 / v; ) : c_up = 0;
    c_ri = 1 - (1 / v);
    set_comp();
  );
  v = sq_knee >= 1.5 ? 48 : sq_knee >= 0.5 ? 24 : 0;
  v !== pv_kne ? ( pv_kne = v; c_knee = v; c_kh = v / 2; c_kd = v * 2; set_comp(); );
  v = pval(sq_attack, sq_m_att, PR_ATT, PR_ATT_N, 0.02, 500, 2, 1);
  v !== pv_att ? ( pv_att = v; c_att = v; set_attack(); );
  v = rnd_az(pval(sq_release, sq_m_rel, PR_REL, PR_REL_N, 0, 8000, 1, 1));
  v !== pv_rel ? ( pv_rel = v; c_rel = v; set_release(); );
  v = pval(sq_trim, sq_m_trm, PR_TRM, PR_TRM_N, -36, 36, 1, 0);
  v !== pv_trm ? ( pv_trm = v; c_trim = v; );
  v = sq_automu >= 0.5;
  v !== pv_amu ? ( pv_amu = v; c_amu = v; );
  v = pval(sq_makeup, sq_m_mku, PR_MKU, PR_MKU_N, -36, 36, 1, 0);
  v !== pv_mku ? ( pv_mku = v; c_mkdb = v; c_mk = db2l(v); );
  v = rnd_az(pval(sq_link, sq_m_lnk, PR_LNK, PR_LNK_N, 0, 100, 0, 0));
  v !== pv_lnk ? ( pv_lnk = v; c_lnk = v; c_lwo = v / 200; c_lw = 1 - c_lwo; );
  v = rnd_az(pval(sq_wet, sq_m_wet, PR_WET, PR_WET_N, 0, 100, 0, 0));
  v !== pv_wet ? ( pv_wet = v; c_wetp = v; c_wet = v / 100; c_dry = 1 - c_wet; );
  v = sq_scext >= 0.5;
  v !== pv_sci ? ( pv_sci = v; c_ext = v; );
  v = rnd_az(pval(sq_hpf, sq_m_hpf, PR_HPF, PR_HPF_N, 20, 15000, 0, 0));
  v !== pv_hpf ? (
    pv_hpf = v; c_hpf = v;
    (v > 20) !== c_hpon ? ( c_hpon = v > 20; h0_x1 = h0_x2 = h0_y1 = h0_y2 = h1_x1 = h1_x2 = h1_y1 = h1_y2 = 0; );
    hp_coefs(v);
  );
  v = rnd_az(pval(sq_lpf, sq_m_lpf, PR_LPF, PR_LPF_N, 20, 15000, 0, 0));
  v !== pv_lpf ? (
    pv_lpf = v; c_lpf = v;
    (v < 15000) !== c_lpon ? ( c_lpon = v < 15000; l0_x1 = l0_x2 = l0_y1 = l0_y2 = l1_x1 = l1_x2 = l1_y1 = l1_y2 = 0; );
    lp_coefs(v);
  );
  v = sq_listen >= 0.5;
  v !== pv_lis ? ( pv_lis = v; c_lis = v; );
  c_bypc = c_byp || (c_wetp === 0);
);

function pk_bal(pk, old) local(c, o)
(
  c = l2db(pk);
  c >= 0 ? 0 : c >= old ? c : ( o = old - m_rel; c > o ? c : o; );
);

function av_bal(sm, old) local(c)
(
  c = l2db(sqrt(sm / mt_n));
  c !== old ? (m_avc * (old - c)) + c : old;
);

function mt_tick()
(
  mt_pos += 1;
  mt_pos >= mt_n ? (
    mt_pos = 0;
    m_rq ? ( m_rq = 0; m_pi0 = m_pi1 = m_po0 = m_po1 = m_ai0 = m_ai1 = m_ao0 = m_ao1 = -(70.01 + 20); );
    m_pi0 = pk_bal(mt_pi0, m_pi0); m_po0 = pk_bal(mt_po0, m_po0);
    m_pi1 = pk_bal(mt_pi1, m_pi1); m_po1 = pk_bal(mt_po1, m_po1);
    m_ai0 = av_bal(mt_si0, m_ai0); m_ao0 = av_bal(mt_so0, m_ao0);
    m_ai1 = av_bal(mt_si1, m_ai1); m_ao1 = av_bal(mt_so1, m_ao1);
    mt_pi0 = mt_pi1 = mt_po0 = mt_po1 = mt_si0 = mt_si1 = mt_so0 = mt_so1 = 0;
    m_gr0 = c_bypc ? 0 : c_gr0; m_gr1 = c_bypc ? 0 : c_gr1;
    m_beat += 1;
  );
);

reset_all();

@slider
last_srate !== srate ? ( last_srate = srate; reset_all(); );
apply_params();

@block
apply_params();

@sample
i0 = spl0; i1 = spl1;
mt_pi0 = max(mt_pi0, abs(i0)); mt_pi1 = max(mt_pi1, abs(i1));
mt_si0 += i0 * i0; mt_si1 += i1 * i1;
c_bypc ? (
  mt_po0 = max(mt_po0, abs(i0)); mt_po1 = max(mt_po1, abs(i1));
  mt_so0 += i0 * i0; mt_so1 += i1 * i1;
  c_gr0 = c_gr1 = c_gm0 = c_gm1 = 0;
) : (
  c_ff ? (
    c_ext ? ( z0 = spl2; z1 = spl3; ) : ( z0 = i0; z1 = i1; );
  ) : (
    c_ext ? ( z0 = spl2 * db2l(-c_gm0); z1 = spl3 * db2l(-c_gm1); ) : ( z0 = c_os0; z1 = c_os1; );
  );
  c_hpon ? (
    t_ = ((((h_a0 * z0) + (h_a1 * h0_x1)) + (h_a2 * h0_x2)) - (h_b1 * h0_y1)) - (h_b2 * h0_y2);
    h0_x2 = h0_x1; h0_x1 = z0; h0_y2 = h0_y1; h0_y1 = t_; z0 = t_;
  );
  c_lpon ? (
    t_ = ((((l_a0 * z0) + (l_a1 * l0_x1)) + (l_a2 * l0_x2)) - (l_b1 * l0_y1)) - (l_b2 * l0_y2);
    l0_x2 = l0_x1; l0_x1 = z0; l0_y2 = l0_y1; l0_y1 = t_; z0 = t_;
  );
  c_hpon ? (
    t_ = ((((h_a0 * z1) + (h_a1 * h1_x1)) + (h_a2 * h1_x2)) - (h_b1 * h1_y1)) - (h_b2 * h1_y2);
    h1_x2 = h1_x1; h1_x1 = z1; h1_y2 = h1_y1; h1_y1 = t_; z1 = t_;
  );
  c_lpon ? (
    t_ = ((((l_a0 * z1) + (l_a1 * l1_x1)) + (l_a2 * l1_x2)) - (l_b1 * l1_y1)) - (l_b2 * l1_y2);
    l1_x2 = l1_x1; l1_x1 = z1; l1_y2 = l1_y1; l1_y1 = t_; z1 = t_;
  );
  c_lnk === 0 ? ( q0 = abs(z0); q1 = abs(z1); ) : (
    q0 = abs(z0 * c_lw) + abs(z1 * c_lwo);
    q1 = abs(z1 * c_lw) + abs(z0 * c_lwo);
  );
  x_ = l2db(q0) + 20 + c_trim;
  ab_ = x_ - c_thr;
  c_knee === 0 ? (
    s0_id = x_ <= c_thr ? 0 : ab_ * c_ri;
  ) : (
    s0_id = ab_ < -c_kh ? 0 : ab_ > c_kh ? ab_ * c_ri : ( fa_ = ab_ + c_kh; ((fa_ * fa_) / c_kd) * c_ri; );
  );
  c_rmsms <= 0 ? n_ = s0_id : (
    s0_sq = (c_wc * s0_sq) + c_wc1 * (s0_id * s0_id);
    n_ = sqrt(s0_sq);
  );
  c_curve === 2 ? (
    n_ > s0_gr ? (
      c_ac === 0 ? s0_gr = n_ : s0_gr = (c_ac * s0_gr) + c_ac1 * n_;
    ) : (
      c_rc === 0 ? s0_gr = n_ : s0_gr = (c_rc * s0_gr) + c_rc1 * n_;
    );
  ) : c_curve === 1 ? (
    c_rc === 0 ? s0_im = n_ : (
      s0_im = (c_rc * s0_im) + c_rc1 * n_;
      n_ > s0_im ? s0_im = n_;
    );
    c_ac === 0 ? s0_gr = s0_im : s0_gr = (c_ac * s0_gr) + c_ac1 * s0_im;
  ) : (
    n_ >= s0_gr ? (
      c_ac === 0 ? s0_gr = n_ : s0_gr = (c_ac * s0_gr) + c_ac1 * n_;
    ) : (
      c_rc === 0 ? s0_gr = n_ : (
        s0_gr -= c_rc;
        s0_gr < n_ ? s0_gr = n_;
      );
    );
  );
  x_ = l2db(q1) + 20 + c_trim;
  ab_ = x_ - c_thr;
  c_knee === 0 ? (
    s1_id = x_ <= c_thr ? 0 : ab_ * c_ri;
  ) : (
    s1_id = ab_ < -c_kh ? 0 : ab_ > c_kh ? ab_ * c_ri : ( fa_ = ab_ + c_kh; ((fa_ * fa_) / c_kd) * c_ri; );
  );
  c_rmsms <= 0 ? n_ = s1_id : (
    s1_sq = (c_wc * s1_sq) + c_wc1 * (s1_id * s1_id);
    n_ = sqrt(s1_sq);
  );
  c_curve === 2 ? (
    n_ > s1_gr ? (
      c_ac === 0 ? s1_gr = n_ : s1_gr = (c_ac * s1_gr) + c_ac1 * n_;
    ) : (
      c_rc === 0 ? s1_gr = n_ : s1_gr = (c_rc * s1_gr) + c_rc1 * n_;
    );
  ) : c_curve === 1 ? (
    c_rc === 0 ? s1_im = n_ : (
      s1_im = (c_rc * s1_im) + c_rc1 * n_;
      n_ > s1_im ? s1_im = n_;
    );
    c_ac === 0 ? s1_gr = s1_im : s1_gr = (c_ac * s1_gr) + c_ac1 * s1_im;
  ) : (
