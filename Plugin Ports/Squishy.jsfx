@gfx 1160 320

function g_rgb(r, g, b) ( gfx_set(r / 255, g / 255, b / 255, 1); );

function g_sx(x) ( gox + x * gz; );
function g_sy(y) ( y * gz; );

function g_text(s, cx, cy, sz, bold) local(w, h)
(
  gfx_setfont(1, "Arial", max(1, floor(sz * gz + 0.5)), bold ? 'b' : 0);
  gfx_measurestr(s, w, h);
  gfx_x = floor(g_sx(cx) - w / 2 + 0.5);
  gfx_y = floor(g_sy(cy) - h / 2 + 0.5);
  gfx_drawstr(s);
);

function g_stad(X0, Y0, X1, Y1) local(SR, cy, cx, hw, j, yc, dy, cov, half, SL_, Rt, lc, rc)
(
  SR = (Y1 - Y0) / 2; cy = (Y0 + Y1) / 2; cx = (X0 + X1) / 2; hw = (X1 - X0) / 2 - SR;
  j = floor(Y0);
  while (j < ceil(Y1)) (
    yc = j + 0.5; dy = abs(yc - cy);
    cov = max(0, min(1, SR - dy + 0.5));
    cov > 0 ? (
      half = hw + sqrt(max(0, SR * SR - min(SR, dy) * min(SR, dy)));
      SL_ = cx - half; Rt = cx + half;
      lc = ceil(SL_); rc = floor(Rt);
      gfx_a = cov;
      rc > lc ? gfx_rect(lc, j, rc - lc, 1);
      lc - SL_ > 0 ? ( gfx_a = cov * (lc - SL_); gfx_rect(lc - 1, j, 1, 1); );
      Rt - rc > 0 ? ( gfx_a = cov * (Rt - rc); gfx_rect(rc, j, 1, 1); );
    );
    j += 1;
  );
  gfx_a = 1;
);

function g_pill(x, y, w, h, r1, g1, b1, r2, g2, b2) local(X0, Y0, X1, Y1, t)
(
  X0 = floor(g_sx(x) + 0.5); Y0 = floor(g_sy(y) + 0.5); X1 = floor(g_sx(x + w) + 0.5); Y1 = floor(g_sy(y + h) + 0.5);
  t = max(1, floor(gz + 0.5));
  g_rgb(r1, g1, b1);
  g_stad(X0, Y0, X1, Y1);
  g_rgb(r2, g2, b2);
  g_stad(X0 + t, Y0 + t, X1 - t, Y1 - t);
);

function g_rnd(x) ( x < 0 ? -floor(-x + 0.5) : floor(x + 0.5); );

function g_near(tab, n, v) local(k, best, bd, dd)
(
  best = 0; bd = abs(v - tab[0]); k = 1;
  loop(n - 1, dd = abs(v - tab[k]); dd < bd ? ( best = k; bd = dd; ); k += 1; );
  best;
);

function g_dp(k, v) local(dp)
(
  dp = GK_DP[k];
  GK_AD[k] ? ( abs(v) >= 10 ? dp = 0 : abs(v) >= 1 ? dp = 1; );
  dp;
);

function g_i2r(k, p) local(v, f, dp, sf)
(
  p = max(0, min(1, p));
  sf = GK_SF[k];
  v = sf !== 0 ? (10 ^ (p * sf) - 1) / (10 ^ sf - 1) : p;
  v = v * (GK_HI[k] - GK_LO[k]) + GK_LO[k];
  dp = g_dp(k, v);
  f = 10 ^ dp;
  g_rnd(v * f) / f;
);

function g_r2i(k, v) local(sf, l)
(
  sf = GK_SF[k];
  l = (max(GK_LO[k], min(GK_HI[k], v)) - GK_LO[k]) / (GK_HI[k] - GK_LO[k]);
  sf !== 0 ? log10(l * (10 ^ sf - 1) + 1) / sf : l;
);

function g_get(s)
(
  s === 1 ? sq_bypass :
  s === 2 ? sq_rms :
  s === 3 ? sq_design :
  s === 4 ? sq_detector :
  s === 5 ? sq_stage :
  s === 6 ? sq_thresh :
