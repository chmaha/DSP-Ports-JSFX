  s === 19 ? sq_link = v :
  s === 20 ? sq_m_thr = v :
  s === 21 ? sq_m_rat = v :
  s === 22 ? sq_m_att = v :
  s === 23 ? sq_m_rel = v :
  s === 24 ? sq_m_mku = v :
  s === 25 ? sq_m_wet = v :
