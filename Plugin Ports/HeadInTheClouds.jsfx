function gfmt(id, v) local(s) (
  s = gscale(id, v);
  (id === 3 || id === 18 || id === 11 || id === 30 || id === 40 || id === 17 || id === 25 || id === 27) ? sprintf(#g_str, "%d%%", (s * 100) | 0)
  : id >= 41 ? sprintf(#g_str, "%03d", s | 0)
  : (id === 4 || id === 5 || id === 35 || id === 36 || id === 37) ? sprintf(#g_str, "%d Hz", s | 0)
  : (id >= 6 && id <= 8) ? ( s <= -30 ? strcpy(#g_str, "Mute") : sprintf(#g_str, "%.1f dB", s) )
  : (id === 10 || id === 15 || id === 21 || id === 23) ? sprintf(#g_str, "%d", s | 0)
  : (id === 12 || id === 13 || id === 16 || id === 24 || id === 26) ? sprintf(#g_str, "%d ms", s | 0)
  : id === 28 ? ( s < 1 ? sprintf(#g_str, "%d ms", (s * 1000) | 0) : s < 10 ? sprintf(#g_str, "%.2f s", s) : sprintf(#g_str, "%.1f s", s) )
  : (id === 19 || id === 29 || id === 31) ? sprintf(#g_str, "%.2f Hz", s)
  : (id === 38 || id === 39) ? sprintf(#g_str, "%.1f dB", s)
