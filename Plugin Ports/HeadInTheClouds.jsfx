);

function gglass(x, y, w, h, r, a0) local(i, ins, ii, xx, yy, ww, hh, rr, fr) (
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC); rr = max(2, floor(r * G_SC));
  gfx_set(0.075, 0.07, 0.13, a0);
  gfx_rect(xx, yy + rr, ww, hh - 2 * rr);
  i = 0;
  loop(rr,
    ii = rr - i - 0.5;
    ins = rr - sqrt(max(0, rr * rr - ii * ii));
    fr = ceil(ins) - ins;
    gfx_set(0.075, 0.07, 0.13, a0);
    gfx_rect(xx + ceil(ins), yy + i, ww - 2 * ceil(ins), 1);
    gfx_rect(xx + ceil(ins), yy + hh - 1 - i, ww - 2 * ceil(ins), 1);
    gfx_set(0.075, 0.07, 0.13, a0 * fr);
    gfx_rect(xx + ceil(ins) - 1, yy + i, 1, 1);
    gfx_rect(xx + ww - ceil(ins), yy + i, 1, 1);
    gfx_rect(xx + ceil(ins) - 1, yy + hh - 1 - i, 1, 1);
    gfx_rect(xx + ww - ceil(ins), yy + hh - 1 - i, 1, 1);
    i += 1;
  );
  gfx_set(1, 0.93, 0.85, 0.20);
  gfx_roundrect(xx, yy, ww - 1, hh - 1, rr, 1);
);

function gtext(x, y, s, fnt, r, g, b, a, ctr) local(tw, th) (
  gfx_setfont(fnt);
  gfx_set(r, g, b, a);
  gfx_measurestr(s, tw, th);
  gfx_x = ctr ? gsx(x) - tw * 0.5 : gsx(x);
  gfx_y = gsy(y) - th * 0.5;
  gfx_drawstr(s);
);

function gring(cx, cy, r, a1, a2, cr, cg, cb, al, th) local(i, q, nn) (
  gfx_set(cr, cg, cb, al);
  nn = max(1, ceil(th * 2));
  i = 0;
  loop(nn,
    q = r + (i - (nn - 1) * 0.5) * 0.5;
    gfx_arc(cx, cy, q, a1, a2, 1);
    i += 1;
  );
);

function gknob(i) local(id, cx, cy, r, v, a0, a1, cd, active, hov, dim, sa, sb, f, cr, cg, cb, nn, j, ta, tb, px0, py0) (
  id = GK_ID[i];
  id >= 0 ? (
    cx = gsx(GK_X[i]); cy = gsy(GK_Y[i]); r = GK_R[i] * G_SC;
    v = slider(id + 1);
    a0 = -$pi * 0.75; a1 = $pi * 0.75;
    cd = GK_CD[i];
    active = cd < 0 ? 1 : (slider(cd + 1) >= 0.5);
    hov = G_HOV === i;
    dim = active ? 1 : 0.62;
    gfx_set(0.02, 0.02, 0.05, 0.42 * dim);
    gfx_circle(cx, cy, r + 2 * G_SC, 1, 1);
    gring(cx, cy, r, a0, a1, 1, 0.95, 0.9, 0.16 * dim, 3 * G_SC);
    sa = a0 + (a1 - a0) * v;
    active ? (
      gring(cx, cy, r, a0, sa, 1, 0.55, 0.3, 0.18, 7 * G_SC);
      nn = 14;
      j = 0;
      loop(nn,
        ta = a0 + (sa - a0) * j / nn;
        tb = a0 + (sa - a0) * (j + 1) / nn;
        f = j / max(1, nn - 1);
        cr = 1; cg = 0.72 - 0.34 * f + 0.1 * (1 - v); cb = 0.36 + 0.34 * f;
        gring(cx, cy, r, ta, tb, cr, cg, cb, 1, 3 * G_SC);
        j += 1;
      );
    );
    px0 = cx + sin(sa) * (r - 7 * G_SC);
    py0 = cy - cos(sa) * (r - 7 * G_SC);
    gfx_set(1, 0.96, 0.9, (hov ? 1 : 0.86) * dim);
    gfx_circle(px0, py0, 2.3 * G_SC, 1, 1);
    gfmt(id, v);
    gtext(GK_X[i], GK_Y[i] + GK_R[i] + 18, GK_NM[i], 1, 0.92, 0.91, 0.96, 0.92 * dim, 1);
    gtext(GK_X[i], GK_Y[i] + GK_R[i] + 34, #g_str, 2, 1, 0.83, 0.62, 0.97 * dim, 1);
  );
);

function gpillf(xx, yy, ww, hh, cr, cg, cb, al) local(i, rr, ii, ins, nn, fr) (
  rr = hh * 0.5;
  nn = floor(hh);
  i = 0;
  loop(nn,
    ii = i + 0.5 - rr;
    ins = rr - sqrt(max(0, rr * rr - ii * ii));
    fr = ceil(ins) - ins;
    gfx_set(cr, cg, cb, al);
    gfx_rect(xx + ceil(ins), yy + i, ww - 2 * ceil(ins), 1);
    gfx_set(cr, cg, cb, al * fr);
    gfx_rect(xx + ceil(ins) - 1, yy + i, 1, 1);
    gfx_rect(xx + ww - ceil(ins), yy + i, 1, 1);
    i += 1;
  );
);

function gtoggle(i) local(id, x, y, w, h, on, xx, yy, ww, hh, nm, k) (
  id = GT_ID[i];
  x = GT_X[i]; y = GT_Y[i]; w = GT_W[i]; h = 18;
  on = slider(id + 1) >= 0.5;
  nm = GT_NM[i];
  k = GT_K[i];
  k === 2 ? nm = on ? "POST" : "PRE";
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC);
  on ? gpillf(xx, yy, ww, hh, 1, 0.62, 0.36, G_THOV === i ? 1 : 0.92) : gpillf(xx, yy, ww, hh, 1, 0.95, 0.9, G_THOV === i ? 0.28 : 0.16);
  on ? gtext(x + w * 0.5, y + h * 0.5, nm, 3, 0.11, 0.08, 0.14, 1, 1)
     : gtext(x + w * 0.5, y + h * 0.5, nm, 3, 0.92, 0.90, 0.95, 0.85, 1);
);

function gpill(x, y, w, h, hov) local(xx, yy, ww, hh) (
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC);
  gpillf(xx, yy, ww, hh, 0.075, 0.07, 0.13, hov ? 0.82 : 0.62);
  gfx_set(1, 0.93, 0.85, hov ? 0.5 : 0.25);
  gfx_roundrect(xx, yy, ww - 1, hh - 1, hh * 0.5, 1);
);

function gload(p) local(i) (
  i = 0;
  loop(45, gset(i, PRESET[p * 45 + i]); i += 1;);
  p_preset = p;
  i = 1;
  loop(47, gauto(i, 0); i += 1;);
);

function gnoise() local(oc, per, nl, x, y, xl, yl, fx, fy, ix, iy, x1, y1, a0, a1, amp, mn, mx, o, v) (
  memset(G_NZ, 0, 65536);
  per = 64; amp = 1;
  oc = 0;
  loop(6,
    nl = floor(256 / per);
    x = 0;
    loop(nl * nl, G_NL[x] = rand(1); x += 1;);
    y = 0; o = 0;
    loop(256,
      yl = y / per; iy = floor(yl); fy = yl - iy; fy = fy * fy * (3 - 2 * fy);
      y1 = (iy + 1) % nl;
      x = 0;
      loop(256,
        xl = x / per; ix = floor(xl); fx = xl - ix; fx = fx * fx * (3 - 2 * fx);
        x1 = (ix + 1) % nl;
        a0 = G_NL[iy * nl + ix]; a0 += (G_NL[iy * nl + x1] - a0) * fx;
        a1 = G_NL[y1 * nl + ix]; a1 += (G_NL[y1 * nl + x1] - a1) * fx;
        G_NZ[o] += (a0 + (a1 - a0) * fy) * amp;
        o += 1;
        x += 1;
      );
      y += 1;
    );
    per = max(1, floor(per / 2)); amp *= 0.54;
    oc += 1;
  );
  mn = 9; mx = -9; o = 0;
  loop(65536, v = G_NZ[o]; v < mn ? mn = v; v > mx ? mx = v; o += 1;);
  o = 0;
  loop(65536, G_NZ[o] = (G_NZ[o] - mn) / max(0.0001, mx - mn); o += 1;);
);

function gcl_size() local(i, j, o, fy, dx, dy, d2, ln, w0, h0, sx, sy, ii, jj) (
  w0 = 240;
  h0 = min(GM_MAXH, floor(w0 * gfx_h / max(1, gfx_w)));
  (w0 !== G_CW || h0 !== G_CH) ? (
    G_CW = w0; G_CH = h0;
    gfx_setimgdim(10, w0, h0);
    memset(G_D1, 0, GM_MAXW * GM_MAXH); memset(G_D2, 0, GM_MAXW * GM_MAXH);
    sx = w0 * 0.40; sy = h0 * 0.40;
    j = 0;
    loop(h0,
      fy = j / (h0 - 1);
      i = 0;
      o = j * GM_MAXW;
      loop(w0,
        dx = (i / w0 - 0.40) * 1.7; dy = (fy - 0.40) * (h0 / w0) * 3.3;
        d2 = dx * dx + dy * dy;
        G_GLW[o] = exp(-d2 * 9) * 0.75 + exp(-d2 * 60) * 0.9;
        dx = sx - i; dy = sy - j;
        ln = max(1, sqrt(dx * dx + dy * dy));
        ii = floor(dx / ln * 5 + 0.5); jj = floor(dy / ln * 5 + 0.5);
        ii = max(-i, min(w0 - 1 - i, ii)); jj = max(-j, min(h0 - 1 - j, jj));
        G_LOF[o] = jj * GM_MAXW + ii;
        i += 1; o += 1;
      );
      j += 1;
    );
    i = 0;
    loop(40,
      G_STAR[i * 3] = rand(1);
      G_STAR[i * 3 + 1] = rand(1) * 0.34;
      G_STAR[i * 3 + 2] = rand(1) * 6.28;
      i += 1;
    );
  );
  G_NZOK ? 0 : ( gnoise(); G_NZOK = 1; );
);

function gth_step() local(p, i, rate) (
  p = gclamp(p_preset | 0, 0, 9);
  rate = G_THI ? 1 - exp(-G_DT / 0.45) : 1;
  G_THI = 1;
  i = 0;
  loop(21, G_THC[i] += (G_THT[p * 21 + i] - G_THC[i]) * rate; i += 1;);
);

function glayer(d, scx, scy, ox, oy, wx, wy, wamp, dtx, dty, th, soft, ytop, ybot) local(gw, gh, i, j, o, fy, mk, u, vv, wu, wv, wi, wj, du, dv, q, xi, yi, fx, fy2, x1, y1, a0, a1, bs, dt0, tt, n, ux, vy, ms) (
  gw = G_CW; gh = G_CH; n = G_NZ;
  j = 0;
  loop(gh,
    fy = j / (gh - 1);
    mk = min(gclamp((fy - ytop) / 0.14, 0, 1), gclamp((ybot - fy) / 0.20, 0, 1));
    mk = mk * mk * (3 - 2 * mk);
    ms = (mk - 1) * 0.5;
    vv = j * scy + oy;
    o = j * GM_MAXW;
    i = 0;
    loop(gw,
      u = i * scx + ox;
      wu = u * 0.42 + wx; wv = vv * 0.42 + wy;
      wi = floor(wu) & 255; wj = floor(wv) & 255;
      du = (n[wj * 256 + wi] - 0.5) * wamp;
      wi = (wi + 97) & 255; wj = (wj + 131) & 255;
      dv = (n[wj * 256 + wi] - 0.5) * wamp * 0.55;
      ux = u + du; vy = vv + dv;
      xi = floor(ux); yi = floor(vy); fx = ux - xi; fy2 = vy - yi;
      xi &= 255; yi &= 255; x1 = (xi + 1) & 255; y1 = (yi + 1) & 255;
      a0 = n[yi * 256 + xi]; a0 += (n[yi * 256 + x1] - a0) * fx;
      a1 = n[y1 * 256 + xi]; a1 += (n[y1 * 256 + x1] - a1) * fx;
      bs = a0 + (a1 - a0) * fy2;
      ux = u * 2.9 + du * 1.4 + dtx; vy = vv * 2.9 + dv * 1.4 + dty;
      xi = floor(ux); yi = floor(vy); fx = ux - xi; fy2 = vy - yi;
      xi &= 255; yi &= 255; x1 = (xi + 1) & 255; y1 = (yi + 1) & 255;
      a0 = n[yi * 256 + xi]; a0 += (n[yi * 256 + x1] - a0) * fx;
      a1 = n[y1 * 256 + xi]; a1 += (n[y1 * 256 + x1] - a1) * fx;
      dt0 = a0 + (a1 - a0) * fy2;
      q = bs + (dt0 - 0.5) * 0.36 + ms;
      tt = (q - th) / soft;
      tt = tt < 0 ? 0 : tt > 1 ? 1 : tt;
      d[o] = tt * tt * (3 - 2 * tt);
      i += 1;
      o += 1;
    );
    j += 1;
  );
);

function gwrap(x) ( x - 256 * floor(x / 256); );

function gsm_step(dt) local(gw, gh, sr, ds, i, j, o, em, t, row, k, q, cx, sgm, k0, k1, ee, dd, wgt, cur, px0, py0, a1, a2, a3, a4, a5, u, v, xs, ys, xi, yi, fx, fy, c1, c2, c3, dec, wind, rise, ts, hf) (
  gw = G_CW; gh = G_CH;
  G_FLIP ? ( sr = G_D2; ds = G_D1; ) : ( sr = G_D1; ds = G_D2; );
  G_CT += dt * 0.32;
  t = G_CT * 0.8;
  sgm = max(1.2, gw * 0.022);
  row = floor(gh * 0.375);
  em = dt * 0.62;
  k = 0;
  loop(13,
    q = 0.5 + 0.5 * sin(G_CT * (0.05 + 0.017 * k) + k * 2.17);
    cx = gw * (0.03 + 0.94 * ((k + q) / 13));
    ee = (0.55 + 0.45 * sin(G_CT * (0.27 + 0.05 * k) + k * 1.3)) * em;
    k0 = max(0, floor(cx - sgm * 3));
    k1 = min(gw - 1, ceil(cx + sgm * 3));
    i = k0;
    loop(k1 - k0 + 1,
      dd = (i - cx) / sgm;
      wgt = ee * exp(-dd * dd * 0.5);
      j = row;
      loop(3,
        o = j * GM_MAXW + i;
        cur = sr[o];
        wgt *= max(0, 1 - cur / 1.4);
        sr[o] = cur + wgt;
        wgt *= 0.6;
        j -= 1;
      );
      i += 1;
    );
    k += 1;
  );
  wind = -0.008 * gw * 0.35;
  rise = 0.075 * gh;
  dec = exp(-dt / G_TAU);
  j = 0;
  loop(gh,
    hf = 1 - j / (gh - 1);
    ts = (0.15 + 1.4 * hf * hf) * 0.34 * gh;
    py0 = j / gh;
    o = j * GM_MAXW;
    i = 0;
    loop(gw,
      px0 = i / gh;
      a1 = cos(4.1 * px0 + 3.3 * py0 + t * 0.9);
      a2 = cos(-6.7 * px0 + 5.2 * py0 - t * 1.3 + 1.7);
      a3 = cos(11.3 * px0 - 9.1 * py0 + t * 2.1 + 0.4);
      a4 = cos(19.7 * px0 + 14.3 * py0 - t * 3.3 + 2.9);
      a5 = cos(-31.3 * px0 + 27.1 * py0 + t * 4.7 + 1.1);
      u = 0.1 * 3.3 * a1 + 0.06 * 5.2 * a2 - 0.045 * 9.1 * a3 + 0.025 * 14.3 * a4 + 0.012 * 27.1 * a5;
      v = -(0.1 * 4.1 * a1 - 0.06 * 6.7 * a2 + 0.045 * 11.3 * a3 + 0.025 * 19.7 * a4 - 0.012 * 31.3 * a5);
      xs = i - (u * ts + wind) * dt;
      ys = j - (v * ts - rise) * dt;
      xs = max(0, min(gw - 1.001, xs));
      ys = max(0, min(gh - 1.001, ys));
      xi = floor(xs); yi = floor(ys);
      fx = xs - xi; fy = ys - yi;
      c1 = yi * GM_MAXW + xi;
      c2 = (1 - fx) * (1 - fy); c3 = fx * (1 - fy);
      ds[o] = min(2, (sr[c1] * c2 + sr[c1 + 1] * c3 + (sr[c1 + GM_MAXW] * (1 - fx) + sr[c1 + GM_MAXW + 1] * fx) * fy) * dec);
      i += 1;
      o += 1;
    );
    j += 1;
  );
  G_FLIP = !G_FLIP;
);

function glayer(d, scx, scy, ox, oy, wx, wy, wamp, dtx, dty, th, soft, ytop, ybot) local(gw, gh, i, j, o, fy, mk, u, vv, wu, wv, wi, wj, du, dv, q, xi, yi, fx, fy2, x1, y1, a0, a1, bs, dt0, tt, n, ux, vy, ms) (
  gw = G_CW; gh = G_CH; n = G_NZ;
  j = 0;
  loop(gh,
    fy = j / (gh - 1);
    mk = min(gclamp((fy - ytop) / 0.14, 0, 1), gclamp((ybot - fy) / 0.20, 0, 1));
    mk = mk * mk * (3 - 2 * mk);
    ms = (mk - 1) * 0.5;
    vv = j * scy + oy;
    o = j * GM_MAXW;
    i = 0;
    loop(gw,
      u = i * scx + ox;
      wu = u * 0.42 + wx; wv = vv * 0.42 + wy;
      wi = floor(wu) & 255; wj = floor(wv) & 255;
      du = (n[wj * 256 + wi] - 0.5) * wamp;
      wi = (wi + 97) & 255; wj = (wj + 131) & 255;
      dv = (n[wj * 256 + wi] - 0.5) * wamp * 0.55;
      ux = u + du; vy = vv + dv;
      xi = floor(ux); yi = floor(vy); fx = ux - xi; fy2 = vy - yi;
      xi &= 255; yi &= 255; x1 = (xi + 1) & 255; y1 = (yi + 1) & 255;
      a0 = n[yi * 256 + xi]; a0 += (n[yi * 256 + x1] - a0) * fx;
      a1 = n[y1 * 256 + xi]; a1 += (n[y1 * 256 + x1] - a1) * fx;
      bs = a0 + (a1 - a0) * fy2;
      ux = u * 2.9 + du * 1.4 + dtx; vy = vv * 2.9 + dv * 1.4 + dty;
      xi = floor(ux); yi = floor(vy); fx = ux - xi; fy2 = vy - yi;
      xi &= 255; yi &= 255; x1 = (xi + 1) & 255; y1 = (yi + 1) & 255;
      a0 = n[yi * 256 + xi]; a0 += (n[yi * 256 + x1] - a0) * fx;
      a1 = n[y1 * 256 + xi]; a1 += (n[y1 * 256 + x1] - a1) * fx;
      dt0 = a0 + (a1 - a0) * fy2;
      q = bs + (dt0 - 0.5) * 0.36 + ms;
      tt = (q - th) / soft;
      tt = tt < 0 ? 0 : tt > 1 ? 1 : tt;
      d[o] = tt * tt * (3 - 2 * tt);
      i += 1;
      o += 1;
    );
    j += 1;
  );
);

function gwrap(x) ( x - 256 * floor(x / 256); );

function gcl_step(dt) local(spd, th1, th2) (
  gsm_step(dt);
  spd = dt * (1 + 0.35 * G_LV);
  G_F1 = gwrap(G_F1 - 1.5 * spd);
  G_F2 = gwrap(G_F2 - 0.8 * spd);
  G_W1 = gwrap(G_W1 + 0.62 * dt);
  G_W2 = gwrap(G_W2 - 0.41 * dt);
  G_W3 = gwrap(G_W3 + 0.37 * dt);
  G_W4 = gwrap(G_W4 + 0.53 * dt);
  G_DD1 = gwrap(G_DD1 - 1.5 * 2.9 * spd * 0.82);
  G_DD2 = gwrap(G_DD2 - 0.8 * 2.9 * spd * 0.82);
  G_CON = G_LV > 0.01;
  G_CON ? (
    th1 = 0.62 - 0.15 * G_LV;
    th2 = 0.65 - 0.13 * G_LV;
    glayer(G_D3, 0.62, 1.05, G_F2 + 256, 40, G_W3, G_W4, 26, G_DD2 + 256, 70, th2, 0.36, 0.16, 0.66);
    glayer(G_D4, 0.86, 1.65, G_F1 + 256, 170, G_W1, G_W2, 34, G_DD1 + 256, 170, th1, 0.38, 0.0, 0.52);
  );
);

function gcl_draw() local(gw, gh, ds, d1, d2, i, j, o, a, dn, gl, r, g, b, cr, cg, cb, gg, hf, th1, t0, t1, rs, gs, bs, lo, sh, cl, ca, br, pk, m0, fr, con) (
  gw = G_CW; gh = G_CH;
  ds = G_FLIP ? G_D2 : G_D1;
  d1 = G_D3; d2 = G_D4;
  gfx_dest = 10;
  gfx_a = 1; gfx_mode = 0;
  gg = 0.34 + 0.70 * G_LV;
  ca = sqrt(G_LV);
  con = G_CON;
  br = min(1.6, max(0.5, 1.05 / max(0.0001, G_CPK))) * 0.5;
  pk = 0;
  j = 0;
  loop(gh,
    hf = j / (gh - 1);
    hf < 0.26 ? (
      th1 = hf / 0.26; t0 = 0; t1 = 3;
    ) : hf < 0.48 ? (
      th1 = (hf - 0.26) / 0.22; t0 = 3; t1 = 6;
    ) : (
      th1 = min(1, (hf - 0.48) / 0.3); t0 = 6; t1 = 9;
    );
    rs = G_THC[t0] + (G_THC[t1] - G_THC[t0]) * th1;
    gs = G_THC[t0 + 1] + (G_THC[t1 + 1] - G_THC[t0 + 1]) * th1;
    bs = G_THC[t0 + 2] + (G_THC[t1 + 2] - G_THC[t0 + 2]) * th1;
    th1 = gclamp((0.68 - hf) / 0.5, 0, 1);
    cr = G_THC[15] + (G_THC[18] - G_THC[15]) * th1;
    cg = G_THC[16] + (G_THC[19] - G_THC[16]) * th1;
    cb = G_THC[17] + (G_THC[20] - G_THC[17]) * th1;
    o = j * GM_MAXW;
    i = 0;
    loop(gw,
      gl = G_GLW[o] * gg;
      r = rs + gl * G_THC[12]; g = gs + gl * G_THC[13]; b = bs + gl * G_THC[14];
      dn = ds[o];
      dn > 0.002 ? (
        dn > pk ? pk = dn;
        a = min(0.92, (1 - exp(-dn * 1.15)) * br);
        m0 = gl * 0.5;
        r += (cr + m0 * G_THC[12] - r) * a;
        g += (cg + m0 * G_THC[13] - g) * a;
        b += (cb + m0 * G_THC[14] - b) * a;
      );
      con ? (
        lo = G_LOF[o];
        dn = d1[o];
        dn > 0.002 ? (
          sh = exp(-d1[o + lo] * 2.3);
          cl = 0.26 + 0.62 * sh;
          a = dn * 0.62 * ca;
          r += (cr * cl + (rs * 0.28) + gl * 0.42 * G_THC[12] - r) * a;
          g += (cg * cl + (gs * 0.28) + gl * 0.42 * G_THC[13] - g) * a;
          b += (cb * cl + (bs * 0.28) + gl * 0.42 * G_THC[14] - b) * a;
        );
        dn = d2[o];
        dn > 0.002 ? (
          sh = exp(-d2[o + lo] * 2.6);
          cl = 0.30 + 0.78 * sh;
          a = dn * 0.92 * ca;
          r += (cr * cl + (rs * 0.22) + gl * 0.5 * G_THC[12] - r) * a;
          g += (cg * cl + (gs * 0.22) + gl * 0.5 * G_THC[13] - g) * a;
          b += (cb * cl + (bs * 0.22) + gl * 0.5 * G_THC[14] - b) * a;
        );
      );
      gfx_x = i; gfx_y = j;
      gfx_setpixel(min(1, r), min(1, g), min(1, b));
      i += 1;
      o += 1;
    );
    j += 1;
  );
  fr = pk > G_CPK ? 0.6 : 2.5;
  G_CPK += (max(0.5, pk) - G_CPK) * (1 - exp(-G_DT / fr));
  gfx_dest = -1;
  gfx_blit(10, 1, 0, 0, 0, gw, gh, 0, 0, gfx_w, gfx_h);
);

function gstars() local(i, x, y, a) (
  i = 0;
  loop(40,
    x = G_STAR[i * 3] * gfx_w; y = G_STAR[i * 3 + 1] * gfx_h;
    a = (0.25 + 0.35 * (0.5 + 0.5 * sin(G_T * 0.7 + G_STAR[i * 3 + 2]))) * (1 - G_STAR[i * 3 + 1] / 0.34);
    gfx_set(1, 0.96, 0.9, a);
    gfx_circle(x, y, (i % 5 === 0 ? 1.1 : 0.6) * G_SC, 1, 1);
    i += 1;
  );
);

@slider
last_srate !== srate ? (
  last_srate = srate;
  cs_rebuild();
);

@block
CS_ALLOCATED ? (
  (p_eco >= 0.5) !== ECO ? cs_rebuild();
  cs_poll();
  cs_fbsetup();
);

@sample
ECO ? (
  es_a = spl0; es_b = spl1;
  HBL[30 + CS_HP] = es_a; HBR[30 + CS_HP] = es_b;
  spl0 = UPL[CS_HP] + DRL[CS_DP];
  spl1 = UPR[CS_HP] + DRR[CS_DP];
  DRL[CS_DP] = (es_a * CMIXI + es_b * CMIX) * G_DRY;
  DRR[CS_DP] = (es_b * CMIXI + es_a * CMIX) * G_DRY;
  CS_DP += 1; CS_DP >= 94 ? CS_DP = 0;
  CS_HP += 1;
  CS_HP >= 64 ? ( CS_HP = 0; eco_chunk(); );
) : (
  INL[CS_POS] = spl0; INR[CS_POS] = spl1;
  spl0 = OUTL[CS_POS]; spl1 = OUTR[CS_POS];
  CS_POS += 1;
  CS_POS >= CHUNK ? ( CS_POS = 0; cs_chunk(); );
);

@gfx 1180 640
G_NOW = time_precise();
G_DT = G_LAST > 0 ? min(0.05, G_NOW - G_LAST) : 0.033;
G_LAST = G_NOW;
G_T += G_DT;
G_WHEEL = mouse_wheel; mouse_wheel = 0;

G_SC = min(gfx_w / 1180, gfx_h / 640);
G_SC = max(0.45, G_SC);
G_OX = floor((gfx_w - 1180 * G_SC) * 0.5);

G_SC !== G_FSC ? (
  G_FSC = G_SC;
  gfx_setfont(1, "Arial", 12.5 * G_SC);
  gfx_setfont(2, "Arial", 12.5 * G_SC, 'b');
  gfx_setfont(3, "Arial", 11.5 * G_SC, 'b');
  gfx_setfont(4, "Georgia", 40 * G_SC, 'b');
  gfx_setfont(5, "Arial", 11.5 * G_SC, 'b');
  gfx_setfont(6, "Arial", 14 * G_SC, 'b');
  gfx_setfont(7, "Arial", 12 * G_SC);
);

G_PK = G_CHUNKPK; G_CHUNKPK = 0;
G_LVDB = G_PK > 0.00001 ? 20 * log10(G_PK) : -100;
G_TGT = gclamp((G_LVDB + 60) / 54, 0, 1);
G_E1 += (G_TGT - G_E1) * (1 - exp(-G_DT / (G_TGT > G_E1 ? 0.18 : 1.1)));
G_LV += (G_E1 - G_LV) * (1 - exp(-G_DT / 0.32));

G_TAU = gclamp(gscale(28, p_latelinedecay) * 0.42, 1.8, 4.6);
gcl_size();
gth_step();
gcl_step(G_DT);
gcl_draw();
gstars();

G_MD = mouse_cap & 1;
G_PRESS = G_MD && !G_LMD;
G_REL = !G_MD && G_LMD;

G_HOV = -1; G_THOV = -1;
G_I = 0;
loop(G_KN,
  GK_ID[G_I] >= 0 ? (
    (mouse_x - gsx(GK_X[G_I])) * (mouse_x - gsx(GK_X[G_I])) + (mouse_y - gsy(GK_Y[G_I])) * (mouse_y - gsy(GK_Y[G_I])) <= ((GK_R[G_I] + 6) * G_SC) * ((GK_R[G_I] + 6) * G_SC) ? G_HOV = G_I;
  );
  G_I += 1;
);
G_I = 0;
loop(G_TN,
  (mouse_x >= gsx(GT_X[G_I]) && mouse_x <= gsx(GT_X[G_I] + GT_W[G_I]) && mouse_y >= gsy(GT_Y[G_I]) && mouse_y <= gsy(GT_Y[G_I] + 18)) ? G_THOV = G_I;
  G_I += 1;
);
G_HVPRE = mouse_x >= gsx(800) && mouse_x <= gsx(1080) && mouse_y >= gsy(24) && mouse_y <= gsy(58);
G_HVECO = mouse_x >= gsx(718) && mouse_x <= gsx(790) && mouse_y >= gsy(24) && mouse_y <= gsy(58);
G_HVBUF = mouse_x >= gsx(1090) && mouse_x <= gsx(1150) && mouse_y >= gsy(24) && mouse_y <= gsy(58);

G_PRESS ? (
  G_HOV >= 0 && GK_ID[G_HOV] >= 0 ? (
    (G_NOW - G_LCLK < 0.28 && G_LCLKI === G_HOV) ? (
      gset(GK_ID[G_HOV], PRESET[p_preset * 45 + GK_ID[G_HOV]]);
      gauto(GK_ID[G_HOV] + 1, 1);
    ) : (
      G_DRAG = G_HOV + 1;
      G_DY = mouse_y;
      G_DV = slider(GK_ID[G_HOV] + 1);
      gauto(GK_ID[G_HOV] + 1, 0);
    );
    G_LCLK = G_NOW; G_LCLKI = G_HOV;
  );
  G_THOV >= 0 ? (
    G_V = slider(GT_ID[G_THOV] + 1) >= 0.5 ? 0 : 1;
    gset(GT_ID[G_THOV], G_V);
    gauto(GT_ID[G_THOV] + 1, 1);
  );
  G_HVPRE ? (
    gfx_x = mouse_x; gfx_y = mouse_y;
    G_V = gfx_showmenu(PRESET_MENU);
    G_V > 0 ? gload(G_V - 1);
  );
  G_HVECO ? ( p_eco = p_eco >= 0.5 ? 0 : 1; gauto(48, 1); );
  G_HVBUF ? (
    gfx_x = mouse_x; gfx_y = mouse_y;
    G_V = gfx_showmenu("64 samples|128 samples|256 samples (default)|512 samples|1024 samples");
    G_V > 0 ? ( p_fbbuf = G_V - 1; gauto(46, 1); );
  );
);
G_DRAG > 0 && G_MD ? (
  G_I = GK_ID[G_DRAG - 1];
  G_NV = gclamp(G_DV + (G_DY - mouse_y) * ((mouse_cap & 8) ? 0.0006 : 0.0042) / G_SC, 0, 1);
  gset(G_I, G_NV);
  gauto(G_I + 1, 0);
  mouse_cap |= 65536;
);
(G_REL && G_DRAG > 0) ? ( gauto(GK_ID[G_DRAG - 1] + 1, 1); G_DRAG = 0; );
(G_WHEEL !== 0 && G_HOV >= 0) ? (
  G_I = GK_ID[G_HOV];
  G_STP = G_I >= 41 ? 1 / 999.999 : (G_I === 10 ? 1 / 255 : (G_I === 15 || G_I === 21 ? 1 / 11.999 : (G_I === 23 ? 1 / 7.999 : 0.02)));
  gset(G_I, gclamp(slider(G_I + 1) + G_WHEEL / 120 * G_STP, 0, 1));
  gauto(G_I + 1, 1);
);
G_LMD = G_MD;

G_I = 0;
loop(G_CARDN,
  gglass(GC_X[G_I], GC_Y[G_I], GC_W[G_I], GC_H[G_I], 14, 0.70);
  gtext(GC_X[G_I] + 18, GC_Y[G_I] + 19, GC_TT[G_I], 5, 1, 0.82, 0.62, 0.95, 0);
  G_I += 1;
);

G_I = 0;
loop(G_KN, gknob(G_I); G_I += 1;);
G_I = 0;
loop(G_TN, gtoggle(G_I); G_I += 1;);

gtext(36, 46, "Head in the Clouds", 4, 1, 0.97, 0.92, 0.98, 0);
gtext(38, 80, "Algorithmic reverb for huge spaces, based on Cloud Seed by Ghost Note Audio", 7, 1, 0.92, 0.84, 0.74, 0);

gpill(800, 24, 280, 34, G_HVPRE);
G_PI = p_preset | 0;
gtext(940, 41, PRESET_NAME(G_PI), 6, 1, 0.97, 0.92, 0.98, 1);
gfx_set(1, 0.82, 0.62, 0.9);
G_TX = gsx(1058); G_TY = gsy(39);
gfx_line(G_TX - 5 * G_SC, G_TY - 2 * G_SC, G_TX, G_TY + 3 * G_SC, 1);
gfx_line(G_TX + 5 * G_SC, G_TY - 2 * G_SC, G_TX, G_TY + 3 * G_SC, 1);

p_eco >= 0.5 ? ( G_XX = floor(gsx(718)); G_YY = floor(gsy(24)); G_WW = ceil(72 * G_SC); G_HH = ceil(34 * G_SC); gpillf(G_XX, G_YY, G_WW, G_HH, 1, 0.62, 0.36, G_HVECO ? 1 : 0.92); gtext(754, 41, "ECO", 6, 0.11, 0.08, 0.14, 1, 1); ) : ( gpill(718, 24, 72, 34, G_HVECO); gtext(754, 41, "ECO", 6, 0.92, 0.90, 0.95, 0.85, 1); );
gpill(1090, 24, 60, 34, G_HVBUF);
sprintf(#g_str, "%d", 64 * 2 ^ p_fbbuf);
gtext(1120, 41, #g_str, 6, 1, 0.97, 0.92, 0.98, 1);
gtext(1120, 15, "Buffer", 3, 1, 0.9, 0.82, 0.8, 1);
sprintf(#g_ftr, "Click to drag  ·  Shift for fine  ·  Wheel to step  ·  Double-click to reset  ·  Latency %d samples", p_eco >= 0.5 ? 94 : 32);
gtext(590, 618, #g_ftr, 7, 1, 0.92, 0.86, 0.72, 1);
