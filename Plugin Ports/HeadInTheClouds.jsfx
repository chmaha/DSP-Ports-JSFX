options:maxmem=67108864 no_meter
in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
function alloc(n) local(r) instance(mp) global() ( r = mp; mp += n; memset(r, 0, n); r; );
function ff(x) local(c) ( c = x * 536870913; c - (c - x); );

function db2gf(x) ( ff(10 ^ ff(ff(x) * K005F)); );
function ms2s(x) ( ff(ff(ff(x) / 1000) * SRF); );
function resp1dec(x) ( ff(ff((ff(10 ^ ff(x))) - 1) * DEC1M); );
function resp2dec(x) ( ff(ff((ff(10 ^ ff(2 * ff(x)))) - 1) * DEC2M); );
function resp3dec(x) ( ff(ff((ff(10 ^ ff(3 * ff(x)))) - 1) * DEC3M); );
function resp3oct(x) ( ff(ff((ff(2 ^ ff(3 * ff(x)))) - 1) * OCT3M); );
function resp4oct(x) ( ff(ff((ff(2 ^ ff(4 * ff(x)))) - 1) * OCT4M); );

function cs_scale(id, v) local(r) (
  r = 0;
  (id === 3 || id === 18 || id === 11 || id === 30 || id === 40) ? r = v
  : (id === 1 || id === 2 || id === 0 || id === 9 || id === 22 || id === 32 || id === 33 || id === 34 || id === 14 || id === 20) ? r = (v < 0.5 ? 0 : 1)
  : (id >= 41) ? r = floor(v * 999.999)
  : id === 4 ? r = ff(20 + ff(resp4oct(v) * 980))
  : (id === 5 || id === 36 || id === 37) ? r = ff(400 + ff(resp4oct(v) * 19600))
  : (id >= 6 && id <= 8) ? r = -30 + v * 30
  : id === 10 ? r = (1 + v * 255) | 0
  : id === 12 ? r = ff(resp1dec(v) * 500)
  : id === 13 ? r = 10 + v * 990
  : (id === 15 || id === 21) ? r = (1 + v * 11.999) | 0
  : (id === 16 || id === 26) ? r = 10 + v * 90
  : (id === 17 || id === 25 || id === 27) ? r = v * 2.5
  : (id === 19 || id === 29 || id === 31) ? r = ff(resp2dec(v) * 5)
  : id === 23 ? r = (1 + v * 7.999) | 0
  : id === 24 ? r = ff(20 + ff(resp2dec(v) * 980))
  : id === 28 ? r = 0.05 + resp3dec(v) * 59.95
  : id === 35 ? r = ff(20 + ff(resp3oct(v) * 980))
  : (id === 38 || id === 39) ? r = -20 + v * 20;
  r;
);

function lcg_series(seed, cnt, dst) local(x, lo, hi, rr, cr, hh) (
  x = seed;
  loop(cnt,
    lo = x - 65536 * floor(x / 65536);
    hi = floor(x / 65536);
    rr = 22695477 * lo + 1;
    cr = floor(rr / 65536);
    rr -= cr * 65536;
    hh = 22695477 * hi + cr;
    hh -= 65536 * floor(hh / 65536);
    x = hh * 65536 + rr;
    dst[0] = ff(x) / 4294967296;
    dst += 1;
  );
);

function rnd_gen(seed, cnt, xc, dst) local(i, a1m) (
  lcg_series(seed, cnt, RND_A);
  lcg_series(4294967295 - seed, cnt, RND_B);
  a1m = ff(1 - xc);
  i = 0;
  loop(cnt,
    dst[i] = ff(ff(RND_A[i] * a1m) + ff(RND_B[i] * xc));
    i += 1;
  );
);

function ap_new() local(s) (
  s = mem.alloc(14);
  s[0] = mem.alloc(AP_SZ);
  s[1] = AP_SZ - 1;
  s[3] = 100; s[4] = 101; s[5] = 1; s[6] = 0;
  s[7] = 0.5;
  s[8] = ff(0.01 + 0.98 * rand(1));
  s[10] = 100;
  s[12] = 1;
  s;
);

function dl_new() local(s) (
  s = mem.alloc(12);
  s[0] = mem.alloc(DL_SZ);
  s[1] = 0;
  s[3] = DL_SZ - 100; s[4] = 0; s[5] = 1; s[6] = 0;
  s[8] = ff(0.01 + 0.98 * rand(1));
  s[10] = 100;
  s;
);

function cs_setup() local(c, l, k, s) (
  mem.mp = 0;
  SRF = ff(CS_SR);
  AP_SZ = ceil(CS_SR * 0.11) + 16;
  DL_SZ = ceil(CS_SR * 1.6) + 16;
  PD_SZ = ceil(CS_SR * 0.52) + 16;
  MT_SZ = ceil(CS_SR * 1.02) + 16;

  PARV = mem.alloc(48); SC = mem.alloc(48);
  RND_A = mem.alloc(800); RND_B = mem.alloc(800);
  INL = mem.alloc(CHUNK); INR = mem.alloc(CHUNK);
  OUTL = mem.alloc(CHUNK); OUTR = mem.alloc(CHUNK);
  MIXL = mem.alloc(CHUNK); MIXR = mem.alloc(CHUNK);
  CT = mem.alloc(CHUNK); CE = mem.alloc(CHUNK); CS = mem.alloc(CHUNK); LO_B = mem.alloc(CHUNK); L_T = mem.alloc(CHUNK);

  C_PRE = mem.alloc(2); C_HP = mem.alloc(2); C_LP = mem.alloc(2); C_TAPB = mem.alloc(2); C_TAPW = mem.alloc(2);
  TAP_G = mem.alloc(512); TAP_P = mem.alloc(512); TAP_O = mem.alloc(512);
  TAP_C = mem.alloc(512);
  SEED_T = mem.alloc(1536);
  SEED_E = mem.alloc(72);
  SEED_L = mem.alloc(72);
  SEED_P = mem.alloc(864);
  C_EAP = mem.alloc(24);
  C_LN = mem.alloc(24);

  CROSS = mem.alloc(2);

  c = 0;
  loop(2,
    s = mem.alloc(12);
    s[0] = mem.alloc(PD_SZ);
    s[3] = PD_SZ - 100;
    C_PRE[c] = s;
    C_HP[c] = mem.alloc(2);
    C_LP[c] = mem.alloc(2);
    C_TAPB[c] = mem.alloc(MT_SZ);

    k = 0;
    loop(12, C_EAP[c * 12 + k] = ap_new(); k += 1;);

    l = 0;
    loop(12,
      s = mem.alloc(32);
      s[0] = mem.alloc(1040);
      s[1] = 0.0;
      s[2] = 0;
      s[3] = dl_new();
      k = 0;
      loop(8, s[4 + k] = ap_new(); k += 1;);
      s[20] = mem.alloc(5);
      s[21] = mem.alloc(5);
      s[22] = mem.alloc(1);
      C_LN[c * 12 + l] = s;
      l += 1;
    );
    c += 1;
  );
  HBL = mem.alloc(96); HBR = mem.alloc(96); UPL = mem.alloc(64); UPR = mem.alloc(64); WEL = mem.alloc(48); WER = mem.alloc(48); DRL = mem.alloc(94); DRR = mem.alloc(94);
  CS_HP = 0; CS_DP = 0;
  CS_LFP = 0;
  CS_POS = 0;
  CS_IDLE = 0;
  CS_AWAKE = 1;
  EN_LOWC = EN_HIGHC = EN_TAP = EN_EAR = EN_LD = -1;
  LAST_BUF = -1;
  CS_ALLOCATED = 1;
);

function lp_coef(cut) local(fsv, x, nn, al) (
  fsv = SRF;
  cut >= ff(fsv * 0.5) ? cut = ff(fsv * ff(0.499));
  x = ((2 * $pi) * cut) / fsv;
  nn = ff(2 - ff(cos(ff(x))));
  al = ff(nn - ff(sqrt(ff(ff(nn * nn) - 1))));
  CF_AL = al; CF_B0 = ff(1 - al);
);

function shelf_coef(hi, fc, db) local(v, k, kk, s2, s2k, sv, svk, vk, nm, g0, g1, g2, h1, h2) (
  db = max(-60, min(60, db));
  fc = min(fc, 0.49 * CS_SR);
  v = ff(10 ^ ff(abs(db) / 20));
  k = ff(tan(ff(($pi * fc) * FSINV)));
  kk = ff(k * k);
  s2 = ff(sqrt(2));
  s2k = ff(s2 * k);
  sv = ff(sqrt(ff(2 * v)));
  svk = ff(sv * k);
  vk = ff(ff(v * k) * k);
  hi === 0 ? (
    db >= 0 ? (
      nm = ff(1 / ff(ff(1 + s2k) + kk));
      g0 = ff(1 + svk); g0 = ff(g0 + vk);
      g1 = ff(2 * ff(vk - 1));
      g2 = ff(1 - svk); g2 = ff(g2 + vk);
      h1 = ff(2 * ff(kk - 1));
      h2 = ff(ff(1 - s2k) + kk);
    ) : (
      nm = ff(1 / ff(ff(1 + svk) + vk));
      g0 = ff(ff(1 + s2k) + kk);
      g1 = ff(2 * ff(kk - 1));
      g2 = ff(ff(1 - s2k) + kk);
      h1 = ff(2 * ff(vk - 1));
      h2 = ff(ff(1 - svk) + vk);
    );
  ) : (
    db >= 0 ? (
      nm = ff(1 / ff(ff(1 + s2k) + kk));
      g0 = ff(ff(v + svk) + kk);
      g1 = ff(2 * ff(kk - v));
      g2 = ff(ff(v - svk) + kk);
      h1 = ff(2 * ff(kk - 1));
      h2 = ff(ff(1 - s2k) + kk);
    ) : (
      nm = ff(1 / ff(ff(v + svk) + kk));
      g0 = ff(ff(1 + s2k) + kk);
      g1 = ff(2 * ff(kk - 1));
      g2 = ff(ff(1 - s2k) + kk);
      h1 = ff(2 * ff(kk - v));
      h2 = ff(ff(v - svk) + kk);
    );
  );
  CF_0 = ff(g0 * nm); CF_1 = ff(g1 * nm); CF_2 = ff(g2 * nm); CF_3 = ff(h1 * nm); CF_4 = ff(h2 * nm);
);

function cs_tapderive() local(c, j, cnt, lenv, dec, scl, tot, off, ev) (
  cnt = max(1, SC[10]);
  lenv = max(10, ms2s(SC[13]) | 0);
  dec = ff(SC[11]);
  scl = ff(lenv / cnt);
  tot = ff(3 / ff(sqrt(ff(1 + cnt))));
  tot = ff(tot * ff(1 + ff(dec * 2)));
  c = 0;
  loop(2,
    j = 0;
    loop(cnt,
      off = ff(TAP_P[c * 256 + j] * scl);
      ev = ff(ff(ff(exp(ff(ff(-off / lenv) * 3.3))) * dec) + ff(1 - dec));
      TAP_O[c * 256 + j] = off | 0;
      TAP_C[c * 256 + j] = TAP_G[c * 256 + j] * ev * tot;
      j += 1;
    );
    c += 1;
  );
  TAP_N = cnt;
  TAP_T = tot;
);

function cs_tapseed() local(c, i, p) (
  c = 0;
  loop(2,
    rnd_gen(SC[41], 768, CROSS[c], SEED_T + c * 768);
    p = SEED_T + c * 768;
    i = 0;
    loop(256,
      TAP_G[c * 256 + i] = ff(db2gf(ff(-20 + ff(p[1] * 20))) * (p[0] < 0.5 ? 1 : -1));
      TAP_P[c * 256 + i] = ff(i + p[2]);
      p += 3;
      i += 1;
    );
    c += 1;
  );
);

function ap_cfg(s, dly, r, amt, rate, seedm, seedr, fb, mod) local(sd, ma) (
  sd = (dly * ((10 ^ r) * 0.1)) | 0;
  ma = ff(amt * (0.85 + 0.3 * seedm));
  ma >= sd ? ma = sd - 1;
  s[10] = sd;
  s[11] = ma;
  s[9] = ff((rate * (0.85 + 0.3 * seedr)) / CS_SR);
  s[7] = fb;
  s[12] = mod;
);

function cs_early() local(c, i, dly, amt, rate, fb, mod, p) (
  dly = ms2s(SC[16]) | 0;
  amt = ms2s(SC[17]);
  rate = ff(SC[19]);
  fb = ff(SC[18]);
  mod = SC[17] > 0.5;
  c = 0;
  loop(2,
    p = SEED_E + c * 36;
    i = 0;
    loop(12,
      ap_cfg(C_EAP[c * 12 + i], dly, p[i], amt, rate, p[12 + i], p[24 + i], fb, mod);
      i += 1;
    );
    c += 1;
  );
);

function cs_lines() local(c, l, dsamp, dec, mamt, mrate, p, s, d, ma, mr, ds, db, gf) (
  dsamp = ms2s(SC[24]) | 0;
  dec = ms2s(SC[28] * 1000);
  mamt = ms2s(SC[25]);
  mrate = SC[29];
  c = 0;
  loop(2,
    p = SEED_L + c * 36;
    l = 0;
    loop(12,
      s = C_LN[c * 12 + l];
      d = s[3];
      ma = mamt * (0.7 + 0.3 * p[l]);
      mr = (mrate * (0.7 + 0.3 * p[12 + l])) / CS_SR;
      ds = (0.5 + p[24 + l]) * dsamp;
      ds < ma + 2 ? ds = ma + 2;
      db = (ds / dec) * (-60);
      gf = db2gf(db);
      d[10] = ds | 0;
      s[2] = gf;
      d[11] = ff(ma);
      d[9] = ff(mr);
      l += 1;
    );
    c += 1;
  );
);

function cs_latediff() local(c, l, k, dly, amt, rate, fb, mod, p, s) (
  dly = ms2s(SC[26]) | 0;
  amt = ms2s(SC[27]);
  rate = ff(SC[31]);
  fb = ff(SC[30]);
  mod = amt > 0;
  c = 0;
  loop(2,
    l = 0;
    loop(12,
      s = C_LN[c * 12 + l];
      p = SEED_P + (c * 12 + l) * 36;
      k = 0;
      loop(8,
        ap_cfg(s[4 + k], dly, p[k], amt, rate, p[12 + k], p[24 + k], fb, mod);
        k += 1;
      );
      l += 1;
    );
    c += 1;
  );
);

function cs_clear_ld() local(c, l, k, s) (
  c = 0;
  loop(2,
    l = 0;
    loop(12,
      s = C_LN[c * 12 + l];
      k = 0;
      loop(8, memset((s[4 + k])[0], 0, AP_SZ); (s[4 + k])[13] = 0; k += 1;);
      l += 1;
    );
    c += 1;
  );
);

function cs_mark(id) (
  (id === 41 || id === 40) ? D_TSEED = 1;
  (id === 10 || id === 11 || id === 13 || id === 41 || id === 40) ? D_TDER = 1;
  ((id >= 15 && id <= 19) || id === 42 || id === 40) ? D_EAR = 1;
  (id === 42 || id === 40) ? D_ESEED = 1;
  (id === 24 || id === 25 || id === 28 || id === 29 || id === 43 || id === 40) ? D_LN = 1;
  (id === 43 || id === 40) ? D_LSEED = 1;
  (id === 26 || id === 27 || id === 30 || id === 31 || id === 44 || id === 40) ? D_LD = 1;
  (id === 44 || id === 40) ? D_PSEED = 1;
  (id === 4) ? D_HPC = 1;
  (id === 5) ? D_LPC = 1;
  (id === 35 || id === 38) ? D_LOS = 1;
  (id === 36 || id === 39) ? D_HIS = 1;
  (id === 37) ? D_CUT = 1;
);

function cs_apply() local(c, l, nv, i) (
  (D_TSEED || D_ESEED || D_LSEED || D_PSEED) ? (
    CROSS[0] = ff(1 - ff(0.5 * SC[40]));
    CROSS[1] = ff(0.5 * SC[40]);
  );
  D_TSEED ? cs_tapseed();
  D_ESEED ? ( c = 0; loop(2, rnd_gen(SC[42], 36, CROSS[c], SEED_E + c * 36); c += 1;); );
  D_LSEED ? ( c = 0; loop(2, rnd_gen(SC[43], 36, CROSS[c], SEED_L + c * 36); c += 1;); );
  D_PSEED ? (
    c = 0;
    loop(2,
      l = 0;
      loop(12, rnd_gen(SC[44] * (l + 1), 36, CROSS[c], SEED_P + (c * 12 + l) * 36); l += 1;);
      c += 1;
    );
  );
  D_TDER ? cs_tapderive();
  D_EAR ? cs_early();
  D_LN ? cs_lines();
  D_LD ? cs_latediff();
  D_HPC ? ( lp_coef(ff(SC[4])); HP_B0 = CF_B0; HP_A1 = CF_AL; );
  D_LPC ? ( lp_coef(ff(SC[5])); LP_B0 = CF_B0; LP_A1 = CF_AL; );
  D_CUT ? ( lp_coef(ff(SC[37])); EC_B0 = CF_B0; EC_A1 = CF_AL; );
  D_LOS ? ( shelf_coef(0, ff(SC[35]), ff(SC[38])); LS_0 = CF_0; LS_1 = CF_1; LS_2 = CF_2; LS_3 = CF_3; LS_4 = CF_4; );
  D_HIS ? ( shelf_coef(1, ff(SC[36]), ff(SC[39])); HS_0 = CF_0; HS_1 = CF_1; HS_2 = CF_2; HS_3 = CF_3; HS_4 = CF_4; );
  D_TSEED = D_TDER = D_EAR = D_ESEED = D_LN = D_LSEED = D_LD = D_PSEED = D_HPC = D_LPC = D_CUT = D_LOS = D_HIS = 0;

  nv = SC[1] >= 0.5;
  (nv && !EN_LOWC) ? ( c = 0; loop(2, memset(C_HP[c], 0, 2); c += 1;); );
  EN_LOWC = nv;
  nv = SC[2] >= 0.5;
  (nv && !EN_HIGHC) ? ( c = 0; loop(2, memset(C_LP[c], 0, 2); c += 1;); );
  EN_HIGHC = nv;

  nv = SC[9] >= 0.5;
  (nv != EN_TAP && EN_TAP >= 0) ? ( memset(C_TAPB[0], 0, MT_SZ); memset(C_TAPB[1], 0, MT_SZ); );
  EN_TAP = nv;
  nv = SC[14] >= 0.5;
  (nv != EN_EAR && EN_EAR >= 0) ? (
    c = 0; loop(24, memset((C_EAP[c])[0], 0, AP_SZ); (C_EAP[c])[13] = 0; c += 1;);
  );
  EN_EAR = nv;
  nv = SC[22] >= 0.5;
  (nv != EN_LD && EN_LD >= 0) ? cs_clear_ld();
  EN_LD = nv;

  CMIX = ff(ff(SC[3]) * 0.5);
  CMIXI = ff(1 - CMIX);
  G_DRY = SC[6] <= -30 ? 0 : db2gf(SC[6]);
  CH_DRY = ECO ? 0 : G_DRY;
  G_EARLY = SC[7] <= -30 ? 0 : db2gf(SC[7]);
  G_LATE = SC[8] <= -30 ? 0 : db2gf(SC[8]);
  PRE_D = ms2s(SC[12]) | 0;
