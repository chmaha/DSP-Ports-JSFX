KT[30] = 0.28829195; KT[31] = 0.26276832; KT[32] = 0.23854851; KT[33] = 0.21567274; KT[34] = 0.19416736; KT[35] = 0.17404546;
KT[36] = 0.15530766; KT[37] = 0.13794294; KT[38] = 0.12192957; KT[39] = 0.10723616; KT[40] = 0.09382272; KT[41] = 0.08164178;
KT[42] = 0.07063950; KT[43] = 0.06075685; KT[44] = 0.05193064; KT[45] = 0.04409466; KT[46] = 0.03718069; KT[47] = 0.03111947;
KT[48] = 0.02584161; KT[49] = 0.02127838; KT[50] = 0.01736250; KT[51] = 0.01402878; KT[52] = 0.01121463; KT[53] = 0.00886058;
KT[54] = 0.00691064; KT[55] = 0.00531256; KT[56] = 0.00401805; KT[57] = 0.00298291; KT[58] = 0.00216702; KT[59] = 0.00153438;
KT[60] = 0.00105297; KT[61] = 0.00069463; KT[62] = 0.00043489; KT[63] = 0.00025272; KT[64] = 0.00013031; KT[65] = 0.0000527734;
KT[66] = 0.00001000; KT[67] = 0.00000000;

function data_load() local(h, n, p, i, k, e, eq)
(
  h = file_open(#data_a);
  h < 0 ? h = file_open(#data_b);
  n = 0;
  h >= 0 ? (
    n = file_text(h) ? file_mem(h, STAGE, 520000) : 0;
    file_close(h);
  );
  n > 400000 && STAGE[0] === ND && STAGE[1] === HLEN0 && STAGE[3] === NTAB ? (
    NPRE = STAGE[5];
    p = STAGE + 6;
    eq = 2 / sqrt(5.487604141);
    k = 0;
    loop(HL,
      PF[HL - k - 1] = p[k] * eq * 0.5;
      PFI[HL - k - 1] = p[k] * eq / 256;
      k += 1;
    );
    p += HL;
    memcpy(HDIR, p, ND * 2); p += ND * 2;
    memcpy(GW, p, ND); p += ND;
    i = 0;
    loop(NTAB * 3, GIDX[i] = p[0]; GG[i] = p[1]; p += 2; i += 1;);
    i = 0;
    loop(NPRE,
      e = p[0]; PRN[i] = e; p += 1;
      memcpy(PRD + i * 128, p, 2 * e); p += 2 * e;
      i += 1;
    );
    memcpy(HR0, p, ND * 2 * HLEN0);
    D_END = p + ND * 2 * HLEN0;
    data_ok = 1;
  );
);
data_load();

function stft_fwd(x, ib, hb, hin, lp, pre, pim) local(h2, n, lt, b, s6, s4, s2, s0, re, im, ab, q0, q1, q2, q3, q4, q5, q6, q7, q8, q9, f)
(
  memcpy(ib + hin * HOP, x, HOP);
  h2 = hin + 1; h2 >= 10 ? h2 = 0;
  q0 = ib + h2 * HOP; h2 += 1; h2 >= 10 ? h2 = 0;
  q1 = ib + h2 * HOP; h2 += 1; h2 >= 10 ? h2 = 0;
  q2 = ib + h2 * HOP; h2 += 1; h2 >= 10 ? h2 = 0;
  q3 = ib + h2 * HOP; h2 += 1; h2 >= 10 ? h2 = 0;
  q4 = ib + h2 * HOP; h2 += 1; h2 >= 10 ? h2 = 0;
  q5 = ib + h2 * HOP; h2 += 1; h2 >= 10 ? h2 = 0;
  q6 = ib + h2 * HOP; h2 += 1; h2 >= 10 ? h2 = 0;
  q7 = ib + h2 * HOP; h2 += 1; h2 >= 10 ? h2 = 0;
  q8 = ib + h2 * HOP; h2 += 1; h2 >= 10 ? h2 = 0;
  q9 = ib + h2 * HOP;
  f = PF;
  n = 0;
  loop(HOP,
    FT[n] = ((((q0[n] * f[0]) + (q2[n] * f[256])) + (q4[n] * f[512])) + (q6[n] * f[768])) + (q8[n] * f[1024]);
    FT[HOP + n] = ((((q1[n] * f[128]) + (q3[n] * f[384])) + (q5[n] * f[640])) + (q7[n] * f[896])) + (q9[n] * f[1152]);
    f += 1; n += 1;
  );
  fft_real(FT, 2 * HOP);
  fft_permute(FT, HOP);
  ab = hb + lp * 258;
  ab[0] = FT[0]; ab[129] = 0;
  ab[128] = FT[1]; ab[257] = 0;
  n = 1;
  loop(HOP - 1, ab[n] = FT[2 * n]; ab[129 + n] = FT[2 * n + 1]; n += 1;);
  lt = lp - 3; lt < 0 ? lt += 7;
  ab = hb + lt * 258;
  pre[0] = ab[0];
  pre[1] = pre[2] = ab[1] * 0.5;
  pre[3] = pre[4] = ab[2] * 0.5;
  pre[5] = pre[6] = ab[3] * 0.5;
  pre[7] = pre[8] = ab[4] * 0.5;
  memcpy(pre + 9, ab + 5, HOP - 4);
  pim[0] = ab[129];
  pim[1] = pim[2] = ab[130] * 0.5;
  pim[3] = pim[4] = ab[131] * 0.5;
  pim[5] = pim[6] = ab[132] * 0.5;
  pim[7] = pim[8] = ab[133] * 0.5;
  memcpy(pim + 9, ab + 134, HOP - 4);
  s6 = hb + lp * 258;
  s4 = lp + 5; s4 >= 7 ? s4 -= 7; s4 = hb + s4 * 258;
  s2 = lp + 3; s2 >= 7 ? s2 -= 7; s2 = hb + s2 * 258;
  s0 = lp + 1; s0 >= 7 ? s0 -= 7; s0 = hb + s0 * 258;
  b = 1;
  loop(4,
    re = -C1 * s6[129 + b];
    im = C1 * s6[b];
    re -= C2 * s4[129 + b];
    im += C2 * s4[b];
    re += C2 * s2[129 + b];
    im -= C2 * s2[b];
    re += C1 * s0[129 + b];
    im -= C1 * s0[b];
    (b & 1) ? (
      pre[b * 2 - 1] -= re; pim[b * 2 - 1] -= im;
      pre[b * 2] += re; pim[b * 2] += im;
    ) : (
      pre[b * 2 - 1] += re; pim[b * 2 - 1] += im;
      pre[b * 2] -= re; pim[b * 2] -= im;
    );
    b += 1;
  );
);

function stft_inv(ire, iim, ob, hout, y) local(n, h, f, q0, q1, q2, q3, q4, q5, q6, q7, q8, q9)
(
  ire[1] = ire[1] + ire[2]; ire[2] = ire[3] + ire[4]; ire[3] = ire[5] + ire[6]; ire[4] = ire[7] + ire[8];
  memcpy(ire + 5, ire + 9, HOP - 4);
  iim[1] = iim[1] + iim[2]; iim[2] = iim[3] + iim[4]; iim[3] = iim[5] + iim[6]; iim[4] = iim[7] + iim[8];
  memcpy(iim + 5, iim + 9, HOP - 4);
  q0 = ob + hout * 2 * HOP;
  q0[0] = ire[0]; q0[1] = ire[HOP];
  n = 1;
  loop(HOP - 1, q0[2 * n] = ire[n]; q0[2 * n + 1] = iim[n]; n += 1;);
  fft_ipermute(q0, HOP);
  ifft_real(q0, 2 * HOP);
  h = hout - 1; h < 0 ? h = 9; q1 = ob + h * 2 * HOP + HOP;
  h -= 1; h < 0 ? h = 9; q2 = ob + h * 2 * HOP;
  h -= 1; h < 0 ? h = 9; q3 = ob + h * 2 * HOP + HOP;
  h -= 1; h < 0 ? h = 9; q4 = ob + h * 2 * HOP;
  h -= 1; h < 0 ? h = 9; q5 = ob + h * 2 * HOP + HOP;
  h -= 1; h < 0 ? h = 9; q6 = ob + h * 2 * HOP;
  h -= 1; h < 0 ? h = 9; q7 = ob + h * 2 * HOP + HOP;
  h -= 1; h < 0 ? h = 9; q8 = ob + h * 2 * HOP;
  h -= 1; h < 0 ? h = 9; q9 = ob + h * 2 * HOP + HOP;
  f = PFI;
  n = 0;
  loop(HOP,
    y[n] = ((((((((((f[1152] * q9[n]) + (f[1024] * q8[n])) + (f[896] * q7[n])) + (f[768] * q6[n])) + (f[640] * q5[n]))
      + (f[512] * q4[n])) + (f[384] * q3[n])) + (f[256] * q2[n])) + (f[128] * q1[n])) + (f[0] * q0[n]));
    f += 1; n += 1;
  );
);

function freq_vec(fs) local(k)
(
  FREQ[0] = 0;
  FREQ[1] = 0.7501 * fs / 256; FREQ[2] = 1.2499 * fs / 256;
  FREQ[3] = 0.8751 * 2 * fs / 256; FREQ[4] = 1.1249 * 2 * fs / 256;
  FREQ[5] = 0.9167 * 3 * fs / 256; FREQ[6] = 1.0833 * 3 * fs / 256;
  FREQ[7] = 0.9375 * 4 * fs / 256; FREQ[8] = 1.0625 * 4 * fs / 256;
  k = 9;
  loop(NB - 9, FREQ[k] = (k - 4) * fs / 256; k += 1;);
);

function kaiser12(x) local(y, ind, frac, i0, i1, i2, i3)
(
  y = x * 64; ind = floor(y); frac = y - ind;
  i3 = -0.1666666667 * frac + 0.1666666667 * (frac * frac * frac);
  i2 = frac + 0.5 * (frac * frac) - 0.5 * (frac * frac * frac);
  i0 = -0.3333333333 * frac + 0.5 * (frac * frac) - 0.1666666667 * (frac * frac * frac);
  i1 = 1 - i3 - i2 - i0;
  i0 * KT[ind] + i1 * KT[ind + 1] + i2 * KT[ind + 2] + i3 * KT[ind + 3];
);

function spx_sinc(cutoff, x, n) local(xx)
(
  xx = x * cutoff;
  abs(x) < 0.000001 ? cutoff :
  abs(x) > 0.5 * n ? 0 :
  cutoff * sin($pi * xx) / ($pi * xx) * kaiser12(abs(2 * x / n));
);

function gcd(a, b) local(t) ( while (b > 0) ( t = a % b; a = b; b = t; ); a; );

function resample(fs) local(g, num, den, fl, cut, os, direct, ia, fa, olen, i, j, ch, ls, sfn, src, dst, acc, off, frac, a0, a1, a2, a3, p, tb, mj, rm, x0, x1, x2, x3, pad)
(
  olen = ceil(HLEN0 * fs / 48000);
  HLEN = 2 ^ ceil(log(olen) / log(2));
  fs == 48000 ? (
    memcpy(HRS, HR0, ND * 2 * HLEN0);
  ) : (
    g = gcd(48000, fs); num = 48000 / g; den = fs / g;
    ia = floor(num / den); fa = num - ia * den;
    os = 32; fl = 256;
    num > den ? (
      cut = 0.975 * den / num;
      mj = floor(fl / den); rm = fl - mj * den;
      fl = floor(rm * num / den) + mj * num;
      fl = floor((fl - 1) / 8) * 8 + 8;
      2 * den < num ? os = os / 2; 4 * den < num ? os = os / 2;
      8 * den < num ? os = os / 2; 16 * den < num ? os = os / 2;
      os < 1 ? os = 1;
    ) : cut = 0.975;
    direct = fl * den <= fl * os + 8;
    tb = HRS + ND * 2 * HLEN;
    direct ? (
      i = 0;
      loop(den,
        j = 0;
        loop(fl, tb[i * fl + j] = spx_sinc(cut, (j - floor(fl / 2) + 1) - i / den, fl); j += 1;);
        i += 1;
      );
    ) : (
      i = -4;
      loop(os * fl + 8, tb[i + 4] = spx_sinc(cut, i / os - floor(fl / 2), fl); i += 1;);
    );
    pad = tb + (direct ? den * fl : os * fl + 8);
    ch = 0;
    loop(ND * 2,
      memset(pad, 0, fl - 1 + HLEN0 + 4 * fl + 2 * HLEN);
      memcpy(pad + fl - 1, HR0 + ch * HLEN0, HLEN0);
      dst = HRS + ch * HLEN;
      ls = floor(fl / 2); sfn = 0;
      i = 0;
      loop(HLEN,
        src = pad + ls;
        direct ? (
          p = tb + sfn * fl; acc = 0; j = 0;
          loop(fl, acc += p[j] * src[j]; j += 1;);
          dst[i] = acc;
        ) : (
          off = floor(sfn * os / den);
          frac = ((sfn * os) % den) / den;
          a0 = a1 = a2 = a3 = 0;
          p = tb + 4 + os - off - 2;
          j = 0;
          loop(fl,
            x0 = src[j];
            a0 += x0 * p[0]; a1 += x0 * p[1]; a2 += x0 * p[2]; a3 += x0 * p[3];
            p += os; j += 1;
          );
          x0 = -0.16667 * frac + 0.16667 * frac * frac * frac;
          x1 = frac + 0.5 * frac * frac - 0.5 * frac * frac * frac;
          x3 = -0.33333 * frac + 0.5 * frac * frac - 0.16667 * frac * frac * frac;
          x2 = 1 - x0 - x1 - x3;
          dst[i] = x0 * a0 + x1 * a1 + x2 * a2 + x3 * a3;
        );
        ls += ia; sfn += fa;
        sfn >= den ? ( sfn -= den; ls += 1; );
        i += 1;
      );
      ch += 1;
    );
  );
);

function est_itds(fs) local(fc, q, kk, k2, dd, b0, b1, b2, a1, a2, i, n, j, w1, w2, v1, v2, wq, xl, xr, mx, mi, bnd, len, m, lag, r, sl, sr)
(
  fc = 750; q = 0.7071;
  kk = tan($pi * fc / fs); k2 = kk * kk;
  dd = k2 * q + kk + q;
  b0 = (k2 * q) / dd; b1 = (2 * k2 * q) / dd; b2 = (k2 * q) / dd;
  a1 = (2 * q * (k2 - 1)) / dd; a2 = (k2 * q - kk + q) / dd;
  bnd = sqrt(2) / 2000;
  len = 2 * HLEN;
  i = 0;
  loop(ND,
    memset(XC, 0, 2 * len);
    sl = HRS + i * 2 * HLEN; sr = sl + HLEN;
    w1 = w2 = v1 = v2 = 0;
    n = 0;
    loop(HLEN,
      wq = sl[n] - a1 * w1 - a2 * w2;
      XC[n] = b0 * wq + b1 * w1 + b2 * w2;
      w2 = w1; w1 = wq;
      wq = sr[n] - a1 * v1 - a2 * v2;
      XC[len + n] = b0 * wq + b1 * v1 + b2 * v2;
      v2 = v1; v1 = wq;
      n += 1;
    );
    m = 0;
    loop(len,
      XD[2 * m] = XC[m]; XD[2 * m + 1] = 0;
      XE[2 * m] = XC[len + m]; XE[2 * m + 1] = 0;
      m += 1;
    );
    fft(XD, len); fft(XE, len);
    m = 0;
    loop(len,
      xl = XD[2 * m]; xr = XD[2 * m + 1];
      v1 = XE[2 * m]; v2 = XE[2 * m + 1];
      XD[2 * m] = xl * v1 + xr * v2;
      XD[2 * m + 1] = xr * v1 - xl * v2;
      m += 1;
    );
    ifft(XD, len);
    mi = 0; mx = 0;
    m = 1;
    loop(2 * HLEN - 1,
      lag = m - HLEN;
      j = lag < 0 ? len + lag : lag;
      r = XD[2 * j] / len;
      r > mx ? ( mi = m - 1; mx = r; );
      m += 1;
    );
    r = (HLEN - mi - 1) / fs;
    r > bnd ? r = bnd; r < -bnd ? r = -bnd;
    ITD[i] = r;
    i += 1;
  );
);

function analyse(x, nch, nts, dre, dim) local(t, ch, b)
(
  memset(ABUF, 0, 2 * HL); memset(AHYB, 0, 2 * 7 * 258);
  a_hin = 0; a_lp = 0;
  t = 0;
  loop(nts,
    a_lp += 1; a_lp >= 7 ? a_lp = 0;
    ch = 0;
    loop(nch,
      stft_fwd(x + ch * nts * HOP + t * HOP, ABUF + ch * HL, AHYB + ch * 7 * 258, a_hin, a_lp, BR, BI);
      b = 0;
      loop(NB,
        dre[(b * nts + t) * nch + ch] = BR[b];
        dim[(b * nts + t) * nch + ch] = BI[b];
        b += 1;
      );
      ch += 1;
    );
    a_hin += 1; a_hin >= 10 ? a_hin = 0;
    t += 1;
  );
);

function fir_to_fb() local(nts, tl, mi, mv, i, j, del, b, t, e, ch, d, gn, cr, ci, xr, xi, yr, yi, ph, src)
(
  tl = max(HLEN, HOP) + 1024;
  nts = ceil(tl / HOP);
  del = 0;
  j = 0;
  loop(2,
    mv = 0.000000000000223; mi = 0;
    i = 0;
    loop(HLEN, HRS[j * HLEN + i] > mv ? ( mv = HRS[j * HLEN + i]; mi = i; ); i += 1;);
    del += mi;
    j += 1;
  );
  del = floor(del / 2 + 1.5);
  memset(XC, 0, nts * HOP * 2);
  XC[del] = 1;
  analyse(XC, 1, nts, CRE, CIM);
  b = 0;
  loop(NB,
    e = 0; t = 0;
    loop(nts, e += sqr(CRE[b * nts + t]) + sqr(CIM[b * nts + t]); t += 1;);
    CEN[b] = max(e, 0.0000000223);
    b += 1;
  );
  d = 0;
  loop(ND,
    memset(XC, 0, nts * HOP * 2);
    src = HRS + d * 2 * HLEN;
    memcpy(XC, src, HLEN);
    memcpy(XC + nts * HOP, src + HLEN, HLEN);
    analyse(XC, 2, nts, TRE, TIM);
    ch = 0;
    loop(2,
      b = 0;
      loop(NB,
        e = 0; cr = ci = 0; t = 0;
        loop(nts,
          xr = TRE[(b * nts + t) * 2 + ch]; xi = TIM[(b * nts + t) * 2 + ch];
          e += sqr(xr) + sqr(xi);
          yr = CRE[b * nts + t]; yi = -CIM[b * nts + t];
          cr += xr * yr - xi * yi;
          ci += xr * yi + xi * yr;
          t += 1;
        );
        gn = sqrt(e / CEN[b]);
        ph = atan2(ci, cr);
        FBR[(b * 2 + ch) * ND + d] = cos(ph) * gn;
        FBI[(b * 2 + ch) * ND + d] = sin(ph) * gn;
        b += 1;
      );
      ch += 1;
    );
    d += 1;
  );
);

function diffuse_eq() local(b, e, j, s, o, dv)
(
  b = 0;
  loop(NB,
    e = 0;
    loop(2,
      o = (b * 2 + e) * ND;
      s = 0; j = 0;
      loop(ND, s += GW[j] / (4 * $pi) * (sqr(FBR[o + j]) + sqr(FBI[o + j])); j += 1;);
      dv = sqrt(max(s, 0.00001)) + 0.0000000223;
      j = 0;
      loop(ND,
        FQR[o + j] = FBR[o + j] / dv; FQI[o + j] = FBI[o + j] / dv;
        j += 1;
      );
      e += 1;
    );
    b += 1;
  );
  j = 0;
  loop(NB * 2 * ND,
    FBM[j] = sqrt(sqr(FBR[j]) + sqr(FBI[j]));
    FQM[j] = sqrt(sqr(FQR[j]) + sqr(FQI[j]));
    j += 1;
  );
);

function clear_tft()
(
  memset(INB, 0, MAXS * HL); memset(HYB, 0, MAXS * 7 * 258); memset(OUB, 0, 2 * 10 * 2 * HOP);
);

function prep_alloc(fs) local(mx)
(
  moremem.mp = __memtop() / 2;
  mx = 2 ^ ceil(log(ceil(HLEN0 * fs / 48000)) / log(2));
  HRS = moremem.alloc(ND * 2 * mx + 16384 * 4 + 2 * mx * 8 + 4096);
  ITD = moremem.alloc(ND);
  FBR = moremem.alloc(NB * 2 * ND); FBI = moremem.alloc(NB * 2 * ND); FBM = moremem.alloc(NB * 2 * ND);
  FQR = moremem.alloc(NB * 2 * ND); FQI = moremem.alloc(NB * 2 * ND); FQM = moremem.alloc(NB * 2 * ND);
  XD = 65536 * ceil(moremem.mp / 65536); moremem.mp = XD + 65536;
  XE = XD + 32768;
  XC = moremem.alloc(4 * mx + 4096);
);

function prep(fs)
(
  prep_alloc(fs);
  resample(fs);
  est_itds(fs);
  freq_vec(fs);
  fir_to_fb();
  diffuse_eq();
  clear_tft();
  ready = 1;
);

SHMS = 64;
SH_F = alloc(48); SH_L = alloc(24); SH_L1 = alloc(24); SH_L2 = alloc(24);
SR1 = alloc(9); SRLM1 = alloc(SHMS * SHMS); SRL = alloc(SHMS * SHMS);
sh_k = 0; SH_F[0] = 1; loop(47, sh_k += 1; SH_F[sh_k] = SH_F[sh_k - 1] * sh_k;);

function sh_legendre(n, x) local(i, x2, om, k, df, kk, m)
(
  x2 = x * x;
  n === 1 ? (
    SH_L[0] = x; SH_L[1] = sqrt(1 - x2);
  ) : n === 2 ? (
    SH_L[0] = (3 * x2 - 1) / 2; SH_L[1] = x * 3 * sqrt(1 - x2); SH_L[2] = 3 * (1 - x2);
  ) : (
    om = 1 - x2;
    k = 2 * n - 1;
    df = 1; kk = 1;
    loop((k + 1) / 2, df *= (2 * kk - 1); kk += 1;);
    SH_L[n] = df * om ^ (n / 2);
    SH_L[n - 1] = k * x * SH_L1[n - 1];
    m = 0;
    loop(n - 1,
      SH_L[m] = ((k * x * SH_L1[m]) - ((n + m - 1) * SH_L2[m])) / (n - m);
      m += 1;
    );
  );
);

function sh_real(order, az, el, y) local(n, m, idx, x, nn0, nnm, a)
(
  x = sin(el * $pi / 180);
  a = az * $pi / 180;
  y[0] = 1;
  idx = 1;
  memset(SH_L1, 0, 24); memset(SH_L2, 0, 24);
  n = 1;
  loop(order,
    sh_legendre(n, x);
    nn0 = sqrt(2 * n + 1);
    y[idx + n] = nn0 * SH_L[0];
    m = 1;
    loop(n,
      nnm = nn0 * sqrt(2 * SH_F[n - m] / SH_F[n + m]);
      y[idx + n - m] = nnm * SH_L[m] * sin(m * a);
      y[idx + n + m] = nnm * SH_L[m] * cos(m * a);
      m += 1;
    );
    idx += 2 * n + 1;
    memcpy(SH_L2, SH_L1, 24); memcpy(SH_L1, SH_L, 24);
    n += 1;
  );
);

function sh_p(i, l, a, b) local(r1, rm1, r0, row)
(
  r1 = SR1[(i + 1) * 3 + 2]; rm1 = SR1[(i + 1) * 3]; r0 = SR1[(i + 1) * 3 + 1];
  row = SRLM1 + (a + l - 1) * SHMS;
  b === -l ? r1 * row[0] + rm1 * row[2 * l - 2] :
  b === l ? r1 * row[2 * l - 2] - rm1 * row[0] :
  r0 * row[b + l - 1];
);

function sh_v(l, m, n) local(d)
(
  m === 0 ? sh_p(1, l, 1, n) + sh_p(-1, l, -1, n) :
  m > 0 ? ( d = m === 1; sh_p(1, l, m - 1, n) * sqrt(1 + d) - sh_p(-1, l, -m + 1, n) * (1 - d); ) :
  ( d = m === -1; sh_p(1, l, m + 1, n) * (1 - d) + sh_p(-1, l, -m - 1, n) * sqrt(1 + d); );
);

function sh_w(l, m, n)
(
  m === 0 ? 0 :
  m > 0 ? sh_p(1, l, m + 1, n) + sh_p(-1, l, -m - 1, n) :
  sh_p(1, l, m - 1, n) - sh_p(-1, l, -m + 1, n);
);

function sh_rotmtx(r, order, out) local(nsh, i, j, l, m, n, d, den, u, v, w, bix, am)
(
  nsh = (order + 1) * (order + 1);
  memset(out, 0, SHMS * SHMS);
  out[0] = 1;
  SR1[0] = r[4]; SR1[1] = r[5]; SR1[2] = r[3];
  SR1[3] = r[7]; SR1[4] = r[8]; SR1[5] = r[6];
  SR1[6] = r[1]; SR1[7] = r[2]; SR1[8] = r[0];
  i = 1;
  loop(3,
    SRLM1[(i - 1) * SHMS] = SR1[(i - 1) * 3]; SRLM1[(i - 1) * SHMS + 1] = SR1[(i - 1) * 3 + 1]; SRLM1[(i - 1) * SHMS + 2] = SR1[(i - 1) * 3 + 2];
    j = 1; loop(3, out[i * SHMS + j] = SR1[(i - 1) * 3 + j - 1]; j += 1;);
    i += 1;
  );
  bix = 4;
  l = 2;
  loop(order - 1,
    m = -l;
    loop(2 * l + 1,
      n = -l;
      loop(2 * l + 1,
        d = m === 0;
        am = abs(m);
        den = abs(n) === l ? (2 * l) * (2 * l - 1) : (l * l - n * n);
        u = sqrt((l * l - m * m) / den);
        v = sqrt(((1 + d) * (l + am - 1) * (l + am)) / den) * (1 - 2 * d) * 0.5;
        w = sqrt(((l - am - 1) * (l - am)) / den) * (1 - d) * -0.5;
        u !== 0 ? u = u * sh_p(0, l, m, n);
        v !== 0 ? v = v * sh_v(l, m, n);
        w !== 0 ? w = w * sh_w(l, m, n);
        SRL[(m + l) * SHMS + (n + l)] = (u + v) + w;
        n += 1;
      );
      m += 1;
    );
    i = 0;
    loop(2 * l + 1,
      j = 0; loop(2 * l + 1, out[(bix + i) * SHMS + bix + j] = SRL[i * SHMS + j]; j += 1;);
      memcpy(SRLM1 + i * SHMS, SRL + i * SHMS, 2 * l + 1);
      i += 1;
    );
    bix += 2 * l + 1;
    l += 1;
  );
);

function rot_euler(y, p, r, rpy, a) local(c, s, t)
(
