function apply_bin() local(b, i, c)
(
  b = binaural >= 0.5 && data_ok;
  b && hrtf_fs !== srate ? hrtf_prep(srate);
  b !== a_bin ? ( memset(DOB, 0, 64 * 20 * HOP); a_bin = b; );
  i = 0; loop(a_nls, LSAZ[i] = LSA_A[i]; LSEL[i] = LSE_A[i]; i += 1;);
  a_bin && have_dec && bin_dirty ? bin_mats();
);

function zero_list() local(c, i, w, n)
(
  n = 0; c = 0;
  loop(min(64, max(num_ch, 2)),
    w = 0;
    a_bin ? ( w = c < 2; ) : ( i = 0; loop(a_nls, OMAP[i] === c ? w = 1; i += 1;); );
    !w ? ( ZL[n] = c; n += 1; );
    c += 1;
  );
