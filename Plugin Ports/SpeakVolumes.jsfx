);

data_ok ? tdesign_load(D_END);
!dec_inited ? (
  b = 0; loop(NB, BOR[b] = floor(in_order + 0.5) + 1; b += 1;);
  dec_inited = 1;
);
ready = 0; pos = 0; last_srate = 0; have_dec = 0; d_state = 0; a_order = 1; a_nsh = 4; a_nls = 0; a_bin = 0;
rt_hin = rt_hout = rt_lp = 0; hrtf_fs = 0; bin_dirty = 1; z_dirty = 1; nz = 0;
p_order = p_m0 = p_m1 = p_nls = p_lfe = -1; p_bin = -1; p_pre = -1; p_tf = -1; p_re1 = p_re2 = p_eq1 = p_eq2 = -1;
p_numch = -1; mic_req = 0; all_req = 0;

function dec_key_changed() local(i, n, chg, a, e)
(
  chg = 0;
  n = max(1, min(64, floor(num_ls + 0.5)));
  (floor(in_order + 0.5) !== p_order || floor(dec1 + 0.5) !== p_m0 || floor(dec2 + 0.5) !== p_m1 ||
   n !== p_nls || floor(lfe_ch + 0.5) !== p_lfe) ? chg = 1;
  i = 0;
  loop(n,
    a = slider(SL0 + 2 * i); e = slider(SL0 + 1 + 2 * i);
    (a !== PDA[i] || e !== PDE[i]) ? ( PDA[i] = a; PDE[i] = e; chg = 1; );
    i += 1;
  );
  chg ? (
    floor(in_order + 0.5) !== p_order && p_order >= 0 ? ( a = floor(in_order + 0.5) + 1; i = 0; loop(NB, BOR[i] = a; i += 1;); );
    p_order = floor(in_order + 0.5); p_m0 = floor(dec1 + 0.5); p_m1 = floor(dec2 + 0.5); p_nls = n; p_lfe = floor(lfe_ch + 0.5);
  );
