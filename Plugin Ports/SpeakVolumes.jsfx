            loop(3,
              a = CNV[3 * k + l];
              CF0[l] = (a === s0 || a === s1 || a === s2) ? 1 : 0;
              cnt += CF0[l];
              l += 1;
            );
            cnt === 2 ? (
              h = 0; l = 0;
              loop(3, CF0[l] ? ( CHOR[2 * nh + h] = CNV[3 * k + l]; h += 1; ); l += 1;);
              nh += 1;
            );
            k += 1;
          );
        );
        j += 1;
      );
      l = 0; j = 0;
      loop(nf,
        !CVIS[j] ? (
          CHF[3 * l] = CHF[3 * j]; CHF[3 * l + 1] = CHF[3 * j + 1]; CHF[3 * l + 2] = CHF[3 * j + 2];
          CHCF[3 * l] = CHCF[3 * j]; CHCF[3 * l + 1] = CHCF[3 * j + 1]; CHCF[3 * l + 2] = CHCF[3 * j + 2];
          CHDF[l] = CHDF[j];
          l += 1;
        );
        j += 1;
      );
      nf = l;
      st = nf;
      j = 0;
      loop(nh,
        nf < MAXF ? (
          CHF[3 * nf] = CHOR[2 * j]; CHF[3 * nf + 1] = CHOR[2 * j + 1]; CHF[3 * nf + 2] = pt;
          ch_plane(nf);
          nf += 1;
        ) : fail = 1;
        j += 1;
      );
      k = st;
      while (k < nf && !fail) (
        cand = 0; dt = 0;
        while (dt === 0 && cand < nf) (
          while (cand < nf && ch_has(k, cand)) ( cand += 1; );
          cand < nf ? ( dt = ch_det(k, cand); cand += 1; );
        );
        dt < 0 ? ch_flip(k);
        k += 1;
      );
    );
  );
  hull_raw = nf; hull_fail = fail;
  fail ? 0 : nf;
);

function ls_triplets(nv) local(nf, i, v0, v1, v2, ax, ay, az, bx, by, bz, cx, cy, cz, d, n)
(
  nf = hull_build(nv);
  n = 0;
  i = 0;
  loop(nf,
    v0 = CHV + CHF[3 * i] * 3; v1 = CHV + CHF[3 * i + 1] * 3; v2 = CHV + CHF[3 * i + 2] * 3;
    ax = v1[0] - v0[0]; ay = v1[1] - v0[1]; az = v1[2] - v0[2];
    bx = v2[0] - v1[0]; by = v2[1] - v1[1]; bz = v2[2] - v1[2];
    cx = (ay * bz) - (az * by); cy = (az * bx) - (ax * bz); cz = (ax * by) - (ay * bx);
    d = ((cx * (v0[0] + v1[0] + v2[0]) / 3) + (cy * (v0[1] + v1[1] + v2[1]) / 3)) + (cz * (v0[2] + v1[2] + v2[2]) / 3);
    f32(acos(max(min(d, 0.99999999), -0.99999999))) < 1.57079637050628662 ? (
      VF[3 * n] = CHF[3 * i]; VF[3 * n + 1] = CHF[3 * i + 1]; VF[3 * n + 2] = CHF[3 * i + 2];
      n += 1;
    );
    i += 1;
  );
  n;
);

function ls_invert(nf) local(n, a, b, c, d, e, f, g, h, k, p0, p1, p2, det, o)
(
  n = 0;
  loop(nf,
    p0 = CHV + VF[3 * n] * 3; p1 = CHV + VF[3 * n + 1] * 3; p2 = CHV + VF[3 * n + 2] * 3;
    a = p0[0]; b = p1[0]; c = p2[0];
    d = p0[1]; e = p1[1]; f = p2[1];
    g = p0[2]; h = p1[2]; k = p2[2];
    det = a * (e * k - f * h) - b * (d * k - f * g) + c * (d * h - e * g);
    o = VINV + 9 * n;
    o[0] = (e * k - f * h) / det; o[1] = (c * h - b * k) / det; o[2] = (b * f - c * e) / det;
    o[3] = (f * g - d * k) / det; o[4] = (a * k - c * g) / det; o[5] = (c * d - a * f) / det;
    o[6] = (d * h - e * g) / det; o[7] = (b * g - a * h) / det; o[8] = (a * e - b * d) / det;
    n += 1;
  );
);

function vbap_dir(azd, eld, nf) local(ar, er, ux, uy, uz, i, o, g0, g1, g2, mn, rms, found)
(
  ar = azd * $pi / 180; er = eld * $pi / 180;
  ux = cos(ar) * cos(er); uy = sin(ar) * cos(er); uz = sin(er);
  found = -1; i = 0;
  while (found < 0 && i < nf) (
    o = VINV + 9 * i;
    g0 = ((o[0] * ux) + (o[1] * uy)) + (o[2] * uz);
    g1 = ((o[3] * ux) + (o[4] * uy)) + (o[5] * uz);
    g2 = ((o[6] * ux) + (o[7] * uy)) + (o[8] * uz);
    mn = min(min(g0, g1), g2);
    mn > -0.001 ? found = i : i += 1;
  );
  found >= 0 ? (
    rms = sqrt(((g0 * g0) + (g1 * g1)) + (g2 * g2));
    g0 /= rms; g1 /= rms; g2 /= rms;
    rms = sqrt(((g0 * g0) + (g1 * g1)) + (g2 * g2));
    vb_i0 = VF[3 * found]; vb_i1 = VF[3 * found + 1]; vb_i2 = VF[3 * found + 2];
    vb_g0 = max(g0 / rms, 0); vb_g1 = max(g1 / rms, 0); vb_g2 = max(g2 / rms, 0);
    1;
  ) : 0;
);

function sh_n3d(order, az, el) ( sh_real(order, az, el, YS); );

function jac_init(n) local(i)
(
  memset(JV, 0, n * n);
  i = 0; loop(n, JV[i * n + i] = 1; i += 1;);
  jac_n = n; jac_p = 0; jac_sw = 0; jac_done = 0;
);

function jac_row() local(n, p, q, k, apq, th, t, c, s, akp, akq, off, tot)
(
  n = jac_n; p = jac_p;
  q = p + 1;
  loop(n - p - 1,
    apq = JA[p * n + q];
    abs(apq) > JTINY ? (
      th = (JA[q * n + q] - JA[p * n + p]) / (2 * apq);
      t = (th >= 0 ? 1 : -1) / (abs(th) + sqrt(th * th + 1));
      c = 1 / sqrt(t * t + 1); s = t * c;
      k = 0;
      loop(n,
        akp = JA[k * n + p]; akq = JA[k * n + q];
        JA[k * n + p] = c * akp - s * akq; JA[k * n + q] = s * akp + c * akq;
        k += 1;
      );
      k = 0;
      loop(n,
        akp = JA[p * n + k]; akq = JA[q * n + k];
        JA[p * n + k] = c * akp - s * akq; JA[q * n + k] = s * akp + c * akq;
        k += 1;
      );
      JA[p * n + q] = JA[q * n + p] = 0;
      k = 0;
      loop(n,
        akp = JV[k * n + p]; akq = JV[k * n + q];
        JV[k * n + p] = c * akp - s * akq; JV[k * n + q] = s * akp + c * akq;
        k += 1;
      );
    );
    q += 1;
  );
  jac_p += 1;
  jac_p >= n - 1 ? (
    jac_p = 0; jac_sw += 1;
    off = tot = 0; p = 0;
    loop(n, q = 0; loop(n, p !== q ? off += sqr(JA[p * n + q]) : tot += sqr(JA[p * n + q]); q += 1;); p += 1;);
    (off <= JREL * tot || jac_sw >= 60 || n < 2) ? jac_done = 1;
  );
  n < 2 ? jac_done = 1;
);

function gs_complete(base, stride, dim, cnt, idx) local(m, i, j, d, nm, ok, w)
(
  ok = 0; m = 0;
  w = XW;
  while (!ok && m < dim) (
    memset(w, 0, dim); w[m] = 1;
    loop(2,
      i = 0;
      loop(cnt,
        i !== idx && PZ[i] >= 0 ? (
          d = 0; j = 0; loop(dim, d += base[i * stride + j] * w[j]; j += 1;);
          j = 0; loop(dim, w[j] -= d * base[i * stride + j]; j += 1;);
        );
        i += 1;
      );
    );
    nm = 0; j = 0; loop(dim, nm += w[j] * w[j]; j += 1;);
    nm > 0.25 ? (
      nm = sqrt(nm);
      j = 0; loop(dim, base[idx * stride + j] = w[j] / nm; j += 1;);
      ok = 1;
    );
    m += 1;
  );
);

function svd_setup(nsh, nl) local(i, j, k, s)
(
  i = 0;
  loop(nl,
    sh_n3d(dz_order, LSA[i], LSE[i]);
    j = 0; loop(nsh, YLS[j * MAXL + i] = YS[j] / SQ4PI; j += 1;);
    i += 1;
  );
  sv_a = nsh <= nl;
  sv_n = sv_a ? nsh : nl;
  i = 0;
  loop(sv_n,
    j = 0;
    loop(sv_n,
      s = 0; k = 0;
      sv_a ? loop(nl, s += YLS[i * MAXL + k] * YLS[j * MAXL + k]; k += 1;) : loop(nsh, s += YLS[k * MAXL + i] * YLS[k * MAXL + j]; k += 1;);
      JA[i * sv_n + j] = s;
      j += 1;
    );
    i += 1;
  );
  jac_init(sv_n);
);

function svd_finish(nsh, nl) local(n, i, j, k, s, smax, sgv)
(
  n = sv_n;
  smax = 0;
  i = 0; loop(n, PS[i] = sqrt(max(JA[i * n + i], 0)); smax = max(smax, PS[i]); i += 1;);
  i = 0;
  loop(n,
    sgv = PS[i];
    PZ[i] = sgv > smax * 0.0000001 ? 1 : -1;
    sv_a ? (
      j = 0; loop(nsh, PU[i * 64 + j] = JV[j * n + i]; j += 1;);
      PZ[i] > 0 ? (
        j = 0; loop(nl, s = 0; k = 0; loop(nsh, s += YLS[k * MAXL + j] * PU[i * 64 + k]; k += 1;); PV[i * MAXL + j] = s / sgv; j += 1;);
      );
    ) : (
      j = 0; loop(nl, PV[i * MAXL + j] = JV[j * n + i]; j += 1;);
      PZ[i] > 0 ? (
        j = 0; loop(nsh, s = 0; k = 0; loop(nl, s += YLS[j * MAXL + k] * PV[i * MAXL + k]; k += 1;); PU[i * 64 + j] = s / sgv; j += 1;);
      );
    );
    i += 1;
  );
  i = 0;
  loop(n,
    PZ[i] < 0 ? (
      sv_a ? gs_complete(PV, MAXL, nl, n, i) : gs_complete(PU, 64, nsh, n, i);
      PZ[i] = 0;
    );
    i += 1;
  );
);

function dec_from_pairs(d, nsh, nl, epad) local(o, i, l, j, s, f, v, u)
(
  o = DMN + d * MAXL * 64;
  memset(o, 0, MAXL * 64);
  i = 0;
  loop(sv_n,
    f = epad ? 1 : (PS[i] > 0.00001 ? 1 / PS[i] : 0);
    f !== 0 ? (
      l = 0;
      loop(nl,
        v = PV[i * MAXL + l] * f;
        j = 0; loop(nsh, o[l * 64 + j] += v * PU[i * 64 + j]; j += 1;);
        l += 1;
      );
    );
    i += 1;
  );
  epad ? (
    s = sqrt(4 * $pi / nl);
    i = 0; loop(MAXL * 64, o[i] *= s; i += 1;);
  );
);

function dec_sad(d, nsh, nl) local(o, i, j)
(
  o = DMN + d * MAXL * 64;
  memset(o, 0, MAXL * 64);
  i = 0;
  loop(nl,
    sh_n3d(dz_order, LSA[i], LSE[i]);
    j = 0; loop(nsh, o[i * 64 + j] = (SQ4PI * YS[j]) / nl; j += 1;);
    i += 1;
  );
);

function maxre_weights() local(n, x, l, p0, p1, p2, j, k)
(
  memset(WJ, 0, 8 * 64);
  n = 1;
  loop(7,
    x = cos(137.9 * ($pi / 180) / (n + 1.51));
    p0 = 1; p1 = x;
    j = 0;
    l = 0;
    loop(n + 1,
      l === 0 ? p2 = 1 : l === 1 ? p2 = x : (
        p2 = ((2 * l - 1) * x * p1 - (l - 1) * p0) / l;
        p0 = p1; p1 = p2;
      );
      k = 0; loop(2 * l + 1, WJ[n * 64 + j] = p2; j += 1; k += 1;);
      l += 1;
    );
    n += 1;
  );
);
maxre_weights();

function design_start()
(
  d_state = 1;
);

function design_setup() local(i, k, n, a, e, se, has)
(
  dz_order = floor(in_order + 0.5) + 1; dz_nsh = (dz_order + 1) * (dz_order + 1);
  dz_m0 = floor(dec1 + 0.5); dz_m1 = floor(dec2 + 0.5);
  n = max(1, min(64, floor(num_ls + 0.5)));
  dz_lfe = floor(lfe_ch + 0.5) - 1;
  k = 0; i = 0;
  loop(n,
    i !== dz_lfe ? (
      a = slider(SL0 + 2 * i); e = slider(SL0 + 1 + 2 * i);
      a > 180 ? a = -360 + a;
      a = max(-180, min(180, a)); e = max(-90, min(90, e));
      LSA[k] = a; LSE[k] = e; NOMAP[k] = i;
      k += 1;
    );
    i += 1;
  );
  dz_nls = k;
  se = 0; i = 0; loop(dz_nls, se += abs(LSE[i]); i += 1;);
  dz_dims = ((se < 5 && se > -5) || dz_nls < 4) ? 2 : 3;
  dz_nall = dz_nls;
  has = dz_m0 === 3 || dz_m1 === 3;
  dz_dims === 2 && has ? (
    LSA[dz_nall] = 0; LSE[dz_nall] = -90;
    LSA[dz_nall + 1] = 0; LSE[dz_nall + 1] = 90;
    dz_nall += 2;
  );
  i = 0;
  loop(dz_nall,
    a = f32(LSA[i]) * $pi / 180; e = f32(LSE[i]) * $pi / 180;
    CHV[i * 3 + 2] = f32(sin(e));
    CHV[i * 3] = f32(cos(e) * cos(a));
    CHV[i * 3 + 1] = f32(cos(e) * sin(a));
    i += 1;
  );
  grand_seed();
  dz_d = 0;
  d_state = 2;
);

function design_method() local(m)
(
  m = dz_d === 0 ? dz_m0 : dz_m1;
  m === 0 ? (
    dec_sad(dz_d, dz_nsh, dz_nall);
    d_state = 5;
  ) : m === 3 ? (
    dz_nf = ls_triplets(dz_nall);
    ls_invert(dz_nf);
    memset(DMN + dz_d * MAXL * 64, 0, MAXL * 64);
    dz_t = 0;
    d_state = 3;
  ) : (
    svd_setup(dz_nsh, dz_nall);
    d_state = 4;
  );
);

function design_allrad_chunk() local(o, k, j, s)
(
  o = DMN + dz_d * MAXL * 64;
  loop(min(200, 5100 - dz_t),
    vbap_dir(TD100[2 * dz_t], TD100[2 * dz_t + 1], dz_nf) ? (
      sh_n3d(dz_order, TD100[2 * dz_t], TD100[2 * dz_t + 1]);
      j = 0;
      loop(dz_nsh,
        o[vb_i0 * 64 + j] += vb_g0 * YS[j];
        o[vb_i1 * 64 + j] += vb_g1 * YS[j];
        o[vb_i2 * 64 + j] += vb_g2 * YS[j];
        j += 1;
      );
    );
    dz_t += 1;
  );
  dz_t >= 5100 ? (
    s = SQ4PI / 5100;
    k = 0; loop(MAXL * 64, o[k] *= s; k += 1;);
    d_state = 5;
  );
);

function design_svd_step() local(m)
(
  jac_row();
  jac_done ? (
    svd_finish(dz_nsh, dz_nall);
    m = dz_d === 0 ? dz_m0 : dz_m1;
    dec_from_pairs(dz_d, dz_nsh, dz_nall, m === 2);
    d_state = 5;
  );
);

function design_norm_start()
(
  memset(AS, 0, 8); memset(ES, 0, 8);
  dz_t = 0;
  d_state = 6;
);

function design_norm_chunk() local(o, l, n, j, acc, g, r, ns)
(
  o = DMN + dz_d * MAXL * 64;
  loop(min(24, 480 - dz_t),
    sh_n3d(dz_order, TD30[2 * dz_t], TD30[2 * dz_t + 1]);
    l = 0;
    loop(dz_nall,
      r = o + l * 64;
      acc = r[0] * YS[0];
      j = 1; n = 1;
      loop(dz_order,
        ns = (n + 1) * (n + 1);
        while (j < ns) ( acc += r[j] * YS[j]; j += 1; );
        g = acc / SQ4PI;
        AS[n] += g; ES[n] += g * g;
        n += 1;
      );
      l += 1;
    );
    dz_t += 1;
  );
  dz_t >= 480 ? (
    n = 1;
    loop(dz_order,
      NRMN[(dz_d * 8 + n) * 2] = 1 / (AS[n] / 480 + 0.00000223);
      NRMN[(dz_d * 8 + n) * 2 + 1] = sqrt(1 / (ES[n] / 480 + 0.00000223));
      n += 1;
    );
    dz_d += 1;
    d_state = dz_d < 2 ? 2 : 7;
  );
);

function design_finish() local(chg, i, c)
(
  chg = !have_dec || dz_order !== a_order || dz_nls !== a_nls;
  i = 0; loop(dz_nls, NOMAP[i] !== OMAP[i] ? chg = 1; i += 1;);
  memcpy(DM, DMN, 2 * MAXL * 64);
  memcpy(NRM, NRMN, 2 * 8 * 2);
  memcpy(OMAP, NOMAP, MAXL);
  a_order = dz_order; a_nsh = dz_nsh; a_nls = dz_nls;
  i = 0; loop(NB, BOR[i] = min(BOR[i], a_order); i += 1;);
  chg ? ( clear_tft(); memset(DOB, 0, 64 * 20 * HOP); memset(DYT, 0, 64 * HOP); memset(XT, 0, MAXS * HOP); pos = 0; );
  have_dec = 1; bin_dirty = 1; z_dirty = 1;
  d_state = 0;
);

function design_step()
(
  d_state === 1 ? design_setup() :
  d_state === 2 ? design_method() :
  d_state === 3 ? design_allrad_chunk() :
  d_state === 4 ? design_svd_step() :
  d_state === 5 ? design_norm_start() :
  d_state === 6 ? design_norm_chunk() :
  d_state === 7 ? design_finish();
);

function mic_preset(id) local(b, ri, cur, rev, mo, r)
(
  b = 0;
  id === 0 ? (
    loop(NB, BOR[b] = a_order; b += 1;);
  ) : (
    ri = 0; cur = 1; rev = 0; mo = MICN[id]; r = MICR + (id - 1) * 8;
    loop(NB,
      ri < 2 * (mo - 1) ? (
        FREQ[b] > r[ri] ? (
          !rev ? cur += 1 : cur -= 1;
          rev = (cur === mo) || rev ? 1 : 0;
          ri += 1;
        );
      );
      BOR[b] = min(a_order, cur);
      b += 1;
    );
  );
  bin_dirty = 1;
);

function interp_to(hr, hi, az, el) local(ai, ei, ix, w0, w1, w2, i0, i1, i2, b, o, am, td, ipd, m0, m1, c, s)
(
  ai = floor(fmodp(az + 180, 360) / 2 + 0.5);
  ei = floor((el + 90) / 5 + 0.5);
  ix = (ei * NAZ + ai) * 3;
  w0 = GG[ix]; w1 = GG[ix + 1]; w2 = GG[ix + 2];
  i0 = GIDX[ix]; i1 = GIDX[ix + 1]; i2 = GIDX[ix + 2];
  am = hrir_pre >= 0.5 ? FQM : FBM;
  td = w0 * ITD[i0] + w1 * ITD[i1] + w2 * ITD[i2];
  b = 0;
  loop(NB,
    o = b * 2 * ND;
    m0 = w0 * am[o + i0] + w1 * am[o + i1] + w2 * am[o + i2];
    o += ND;
    m1 = w0 * am[o + i0] + w1 * am[o + i1] + w2 * am[o + i2];
    ipd = FREQ[b] < 1500 ? (fmodp(2 * $pi * FREQ[b] * td + $pi, 2 * $pi) - $pi) / 2 : 0;
    c = cos(ipd); s = sin(ipd);
    hr[b * 2] = c * m0; hi[b * 2] = s * m0;
    hr[b * 2 + 1] = c * m1; hi[b * 2 + 1] = -s * m1;
    b += 1;
  );
);

function hrtf_prep(fs)
(
  prep_alloc(fs);
  resample(fs);
  est_itds(fs);
  fir_to_fb();
  diffuse_eq();
  hrtf_fs = fs;
);

function bin_mats() local(i, b, e, j, l, ob, d, sc, wr, m, hr, hi, ur, ui, nso, o, w, q)
(
  bin_dirty = 0;
  i = 0;
  loop(a_nls, interp_to(HRE + i * 2 * NB, HIM + i * 2 * NB, LSAZ[i], LSEL[i]); i += 1;);
  q = 1 / sqrt(a_nls);
  memset(BBR, 0, NB * 2 * 64); memset(BBI, 0, NB * 2 * 64);
  b = 0;
  loop(NB,
    ob = max(1, min(BOR[b], a_order)); nso = (ob + 1) * (ob + 1);
    d = FREQ[b] < trans_freq ? 0 : 1;
    sc = NRM[(d * 8 + ob) * 2 + ((d ? eq2 : eq1) >= 0.5 ? 1 : 0)] * q;
    wr = (d ? re2 : re1) >= 0.5;
    e = 0;
    loop(2,
      o = (b * 2 + e) * 64;
      l = 0;
      loop(a_nls,
        hr = HRE[l * 2 * NB + b * 2 + e]; hi = HIM[l * 2 * NB + b * 2 + e];
        m = DM + d * MAXL * 64 + l * 64; w = WJ + ob * 64;
        j = 0;
        loop(nso,
          ur = m[j] * (wr ? w[j] : 1) * sc;
          BBR[o + j] += hr * ur; BBI[o + j] += hi * ur;
          j += 1;
        );
        l += 1;
      );
      e += 1;
    );
    b += 1;
  );

);

function dec_frame() local(ch, b, x, g, n, ns, fu, nt, ob, nso, d, sc, wr, w, px, qx, l, m, sr, si, j, o, a0, a1, a2, a3, v, mb, mc, md, r0, r1, r2, r3, q0, q1, q2, q3, ea, ec)
(
  rt_lp += 1; rt_lp >= 7 ? rt_lp = 0;
  ns = a_nsh;
  fu = a_order === 1 && ch_order >= 0.5;
  nt = floor(norm_type + 0.5); a_order !== 1 && nt === 2 ? nt = 1;
  fu ? (
    memcpy(XTT, XT + HOP, HOP);
    memcpy(XT + HOP, XT + 2 * HOP, HOP);
    memcpy(XT + 2 * HOP, XT + 3 * HOP, HOP);
    memcpy(XT + 3 * HOP, XTT, HOP);
  );
  ch = 0;
  loop(ns,
    x = XT + ch * HOP;
    g = nt === 1 ? sqrt(2 * floor(sqrt(ch)) + 1) : nt === 2 ? (ch === 0 ? sqrt(2) : sqrt(3)) : 1;
    g !== 1 ? ( n = 0; loop(HOP, x[n] *= g; n += 1;); );
    stft_fwd(x, INB + ch * HL, HYB + ch * 7 * 258, rt_hin, rt_lp, BR, BI);
    b = 0; o = ch;
    loop(NB, XBR[o] = BR[b]; XBI[o] = BI[b]; o += 64; b += 1;);
    ch += 1;
  );
  rt_hin += 1; rt_hin >= 10 ? rt_hin = 0;
  a_bin ? (
    b = 0;
    loop(NB,
      px = XBR + b * 64; qx = XBI + b * 64;
      o = b * 128;
      a0 = a1 = a2 = a3 = 0;
      j = 0;
      loop(ns,
        v = px[j]; sr = qx[j];
        m = BBR[o + j]; si = BBI[o + j];
        a0 += m * v - si * sr; a1 += m * sr + si * v;
        m = BBR[o + 64 + j]; si = BBI[o + 64 + j];
        a2 += m * v - si * sr; a3 += m * sr + si * v;
        j += 1;
