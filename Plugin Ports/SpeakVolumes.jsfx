G_HMI ? G_TID = 10 : G_HOD >= 0 ? G_TID = 11 : G_HCO >= 0 ? G_TID = 12 : G_HNT >= 0 ? G_TID = 13 :
(G_HM1 >= 0 || G_HM2 >= 0) ? G_TID = 14 : (G_HR1 || G_HR2) ? G_TID = 15 : (G_HE1 >= 0 || G_HE2 >= 0) ? G_TID = 16 : G_HKN ? G_TID = 17;
(G_TID !== G_TLAST || G_MD || G_DRAG > 0 || G_WHEEL !== 0) ? ( G_TLAST = G_TID; G_TT0 = G_NOW; );
(G_TID > 0 && !G_MD && G_DRAG === 0 && G_EDIT < 0 && G_NOW - G_TT0 >= 0.5) ? (
  gtip_text(G_TID);
  gfx_setfont(4);
  gfx_measurestr(#g_tip, G_TW, G_TH);
  G_TPW = G_TW + floor(16 * G_SC); G_TPH = G_TH + floor(10 * G_SC);
  G_TPX = mouse_x + floor(14 * G_SC); G_TPY = mouse_y + floor(20 * G_SC);
  G_TPX + G_TPW > gfx_w - 2 ? G_TPX = max(2, gfx_w - 2 - G_TPW);
  G_TPY + G_TPH > gfx_h - 2 ? G_TPY = max(2, mouse_y - floor(8 * G_SC) - G_TPH);
  gfrr(G_TPX + 2, G_TPY + 3, G_TPX + G_TPW + 2, G_TPY + G_TPH + 3, floor(5 * G_SC), 0, 0, 0, 0.35);
  gfrr(G_TPX, G_TPY, G_TPX + G_TPW, G_TPY + G_TPH, floor(5 * G_SC), 0.07, 0.09, 0.11, 0.97);
  gbord(G_TPX, G_TPY, G_TPX + G_TPW, G_TPY + G_TPH, floor(5 * G_SC), max(1, floor(G_SC + 0.5)), G_ACR, G_ACG, G_ACB, 0.55);
  gfx_set(0.93, 0.95, 0.96, 1);
  gfx_x = G_TPX + floor(8 * G_SC); gfx_y = G_TPY + floor(5 * G_SC);
  gfx_drawstr(#g_tip);
);
G_LMD = G_MD;

