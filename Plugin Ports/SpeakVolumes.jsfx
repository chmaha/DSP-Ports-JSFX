      ob = max(1, min(BOR[b], a_order)); nso = (ob + 1) * (ob + 1);
      d = FREQ[b] < trans_freq ? 0 : 1;
      sc = NRM[(d * 8 + ob) * 2 + ((d ? eq2 : eq1) >= 0.5 ? 1 : 0)];
      wr = (d ? re2 : re1) >= 0.5;
      px = XBR + b * 64; qx = XBI + b * 64;
      wr ? (
        w = WJ + ob * 64;
        j = 0; loop(nso, XW[j] = px[j] * w[j]; XW[64 + j] = qx[j] * w[j]; j += 1;);
        px = XW; qx = XW + 64;
      );
      m = DM + d * MAXL * 64;
      l = 0; o = b;
      loop(a_nls >> 2,
        mb = m + 64; mc = m + 128; md = m + 192;
        r0 = q0 = r1 = q1 = r2 = q2 = r3 = q3 = 0; j = 0;
        loop(nso,
          ea = px[j]; ec = qx[j];
          v = m[j]; r0 += v * ea; q0 += v * ec;
          v = mb[j]; r1 += v * ea; q1 += v * ec;
          v = mc[j]; r2 += v * ea; q2 += v * ec;
          v = md[j]; r3 += v * ea; q3 += v * ec;
          j += 1;
        );
        OLR[o] = r0 * sc; OLI[o] = q0 * sc; o += NB;
        OLR[o] = r1 * sc; OLI[o] = q1 * sc; o += NB;
        OLR[o] = r2 * sc; OLI[o] = q2 * sc; o += NB;
        OLR[o] = r3 * sc; OLI[o] = q3 * sc; o += NB;
        m += 256; l += 4;
      );
      loop(a_nls - l,
        sr = si = 0; j = 0;
        loop(nso, v = m[j]; sr += v * px[j]; si += v * qx[j]; j += 1;);
        OLR[o] = sr * sc; OLI[o] = si * sc;
        m += 64; o += NB;
      );
      b += 1;
    );
    l = 0;
    loop(a_nls,
