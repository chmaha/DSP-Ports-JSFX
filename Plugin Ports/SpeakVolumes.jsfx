function gfx_of(f) ( G_BX + G_BW * log(f / 100) / log(200); );
function gf_at(x) ( 100 * 200 ^ ((x - G_BX) / G_BW); );

function gmeth(i) ( i === 0 ? "SAD" : i === 1 ? "MMD" : i === 2 ? "EPAD" : "AllRAD"; );

function gtip_text(id) (
  id === 1 ? strcpy(#g_tip, "Load a loudspeaker layout (REAPER surround layouts keep a silent LFE channel)") :
  id === 2 ? strcpy(#g_tip, "Number of output channels (drag, wheel or +/-)") :
