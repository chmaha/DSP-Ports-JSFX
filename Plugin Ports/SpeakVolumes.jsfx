);
PDA = alloc(64); PDE = alloc(64);
LSAZ = alloc(64); LSEL = alloc(64);

function sync() local(b)
(
  ready ? (
    dec_key_changed() ? design_start();
    (re1 !== p_re1 || re2 !== p_re2 || eq1 !== p_eq1 || eq2 !== p_eq2 || trans_freq !== p_tf || hrir_pre !== p_pre) ? (
      p_re1 = re1; p_re2 = re2; p_eq1 = eq1; p_eq2 = eq2; p_tf = trans_freq; p_pre = hrir_pre; bin_dirty = 1;
    );
    b = binaural >= 0.5;
    b !== p_bin ? ( p_bin = b; z_dirty = 1; bin_dirty = 1; );
    num_ch !== p_numch ? ( p_numch = num_ch; z_dirty = 1; );
  );
