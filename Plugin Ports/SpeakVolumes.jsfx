#data_a = "SpeakVolumes/hrtf.txt"; #data_b = "Dependencies/SpeakVolumes/hrtf.txt";
function alloc(n) local(r) instance(mp) global() ( r = mp; mp += n; memset(r, 0, n); r; );

HOP = 128; NB = 133; HL = 1280; NTAB = 6697; NAZ = 181; MAXS = 64;
C1 = 0.031273141818515176604; C2 = 0.28127313041521179171;
FT = 0; FT2 = 512; FT3 = 1024;
OUB = 2048;
alloc.mp = 8192;
ND = 836; HLEN0 = 256; NPRE = 0;
PF = alloc(HL); PFI = alloc(HL);
KT = alloc(68);
HDIR = alloc(ND * 2); GW = alloc(ND); GIDX = alloc(NTAB * 3); GG = alloc(NTAB * 3);
PRN = alloc(64); PRD = alloc(64 * 128);
HR0 = alloc(ND * 2 * HLEN0);
FREQ = alloc(NB);
XT = alloc(MAXS * HOP); YT = alloc(2 * HOP);
INB = alloc(MAXS * HL); HYB = alloc(MAXS * 7 * 258);
BR = alloc(NB); BI = alloc(NB);
ORE = alloc(2 * NB); OIM = alloc(2 * NB);
HRE = alloc(MAXS * 2 * NB); HIM = alloc(MAXS * 2 * NB);
SAZ = alloc(MAXS); SEL = alloc(MAXS); RAZ = alloc(MAXS); REL = alloc(MAXS);
SG = alloc(MAXS); SGU = alloc(MAXS); RECALC = alloc(MAXS);
ABUF = alloc(2 * HL); AHYB = alloc(2 * 7 * 258);
CRE = alloc(NB * 24); CIM = alloc(NB * 24); CEN = alloc(NB);
TRE = alloc(NB * 24 * 2); TIM = alloc(NB * 24 * 2);
STAGE = alloc(520000);
RS = alloc(16384);
LFB = alloc(2048);
data_ok = 0;
KT[0] = 0.99859849; KT[1] = 1.00000000; KT[2] = 0.99859849; KT[3] = 0.99440475; KT[4] = 0.98745105; KT[5] = 0.97779076;
KT[6] = 0.96549770; KT[7] = 0.95066529; KT[8] = 0.93340547; KT[9] = 0.91384741; KT[10] = 0.89213598; KT[11] = 0.86843014;
KT[12] = 0.84290116; KT[13] = 0.81573067; KT[14] = 0.78710866; KT[15] = 0.75723148; KT[16] = 0.72629970; KT[17] = 0.69451601;
