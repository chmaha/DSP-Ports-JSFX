function gtitle_w(sid, cap) ( TTW[sid] * cap / TTCAP; );


@slider
last_srate !== srate ? (
  last_srate = srate;
  ea.e_load_cancel(); eb.e_load_cancel();
  ea.act = eb.act = 0; ea.ready = eb.ready = 0;
  cur = old = ld_e = 0; akey = lkey = fail_key = -1;
  ga = 2950 / srate;
  dtg = enable >= 0.5 ? db_coeff(dry_db) : 1; wtg = enable >= 0.5 ? db_coeff(wet_db) : 0;
  gd = dtg; gw = wtg;
  FADE = floor(FADE_MS * 0.001 * srate);
);
control(0);

@block
dtg = enable >= 0.5 ? db_coeff(dry_db) : 1; wtg = enable >= 0.5 ? db_coeff(wet_db) : 0;
pdt = floor(predelay * 0.001 * srate + 0.5);
control(0);
G_CUR = cur; G_LD = ld_e; G_ERR = load_err;

@sample
xl = spl0; xr = spl1;
DRL[dw] = xl; DRR[dw] = xr;
PDL[pw] = xl; PDR[pw] = xr;
pd_x > 0 || pdt !== pd_cur || pd_cur > 0 ? (
  pd_x <= 0 && pdt !== pd_cur ? ( pd_old = pd_cur; pd_cur = pdt; pd_x = 1024; );
  pj = (pw - pd_cur) & 65535; cl = PDL[pj]; cr = PDR[pj];
  pd_x > 0 ? (
    pj = (pw - pd_old) & 65535; pf = pd_x / 1024;
    cl = cl * (1 - pf) + PDL[pj] * pf; cr = cr * (1 - pf) + PDR[pj] * pf;
    pd_x -= 1;
  );
) : ( cl = xl; cr = xr; );
pw = (pw + 1) & 65535;
(cl !== 0 || cr !== 0) ? quiet = 0 : quiet += 1;
cm = 0.5 * (cl + cr);
CINL[wi] = cl; CINL[wi + RSI] = cl; CINR[wi] = cr; CINR[wi + RSI] = cr; CINM[wi] = cm; CINM[wi + RSI] = cm;
gcnt === 0 ? (
  gd !== dtg ? ( gd += ga * (dtg - gd) + 0.0000000001; abs(gd - dtg) < 0.00001 ? gd = dtg; );
  gw !== wtg ? ( gw += ga * (wtg - gw) + 0.0000000001; abs(gw - wtg) < 0.00001 ? gw = wtg; );
);
gcnt = (gcnt + 1) & 63;
wl = wr = 0;
old ? (
  fpos += 1; fa = min(1, fpos / FADE);
  fo = cos(fa * $pi * 0.5); fn = sin(fa * $pi * 0.5);
  old === 1 ? ( ea.gsc = fo; eb.gsc = fn; ) : ( eb.gsc = fo; ea.gsc = fn; );
  fa >= 1 ? ( old === 1 ? ( ea.act = 0; ea.ready = 0; ) : ( eb.act = 0; eb.ready = 0; ); old === 1 ? eb.gsc = 1 : ea.gsc = 1; old = 0; );
);
ea.act ? ( ea.e_sample(); wl += ea.ywl * ea.gsc; wr += ea.ywr * ea.gsc; );
eb.act ? ( eb.e_sample(); wl += eb.ywl * eb.gsc; wr += eb.ywr * eb.gsc; );
dj = (dw - e_lat(cur)) & 1023;
spl0 = gd * DRL[dj] + gw * wl;
spl1 = gd * DRR[dj] + gw * wr;
dw = (dw + 1) & 1023;
wi += 1; wi >= RSI ? wi = 0;
opos += 1; opos >= RSO ? opos = 0;

@gfx 1060 520
G_NOW = time_precise();
G_WHEEL = mouse_wheel; mouse_wheel = 0;
G_SC = max(0.45, min(gfx_w / 1060, gfx_h / 520));
G_OX = floor((gfx_w - 1060 * G_SC) * 0.5);
