function e_init(ebp, ez) instance(ebase, eend, LVT, OBL, OBR, HD, WV, DYN, ready, nlev, lst, act, QB0, L, nin, npath, mode, irlen, ncov, span, ph, ywl, ywr, lh, lopen, lerr, lnch, lfsr, lfr, lg, lim, lzl, lsr, lpos, lnc, lrs, lrn, lc, lk, lp, lnin, lnp, lmd, lpm0, lpm1, lpm2, lpm3, wpk, wver, cin0, gsc, age, lpd, lpo) (
  ebase = ebp; eend = ebp + ez;
  LVT = ebp; OBL = ebp + 256; OBR = OBL + RSO; HD = OBR + RSO; WV = HD + 512; DYN = WV + 4 * NWB;
  ready = 0; nlev = 0; lst = 0; act = 0;
);

function e_layout(nn, qb, lat, ni, np, md) instance(ebase, eend, LVT, OBL, OBR, HD, WV, DYN, ready, nlev, lst, act, QB0, L, nin, npath, mode, irlen, ncov, span, ph, ywl, ywr, lh, lopen, lerr, lnch, lfsr, lfr, lg, lim, lzl, lsr, lpos, lnc, lrs, lrn, lc, lk, lp, lnin, lnp, lmd, lpm0, lpm1, lpm2, lpm3, wpk, wver, cin0, gsc, age, lpd, lpo) local(k, bb, oo, pp, pn, ptr, tb, nb) (
  QB0 = qb; L = lat; nin = ni; npath = np; mode = md; irlen = nn; cin0 = md === 2 ? CINM : CINL;
  oo = lat ? 0 : qb;
  bb = qb; k = 0; ptr = DYN;
  while (oo < nn && k < 15) (
    tb = LVT + k * 16;
    nb = min(16384, bb * GROW);
    bb >= 16384 ? pp = ceil((nn - oo) / bb) : (
      pn = max(1, ceil((2 * nb - qb - lat - oo) / bb));
      pp = nn - oo <= (pn + 2) * bb ? ceil((nn - oo) / bb) : pn;
    );
    tb[0] = bb; tb[1] = pp; tb[2] = oo; tb[3] = bb / qb;
    tb[10] = 2 * bb; tb[11] = pp * 2 * bb;
    ptr = ceil(ptr / (2 * bb)) * 2 * bb;
    tb[4] = ptr; ptr += ni * pp * 2 * bb;
    tb[5] = ptr; ptr += pp * bb * 2 * np;
    tb[13] = bb * 2 * np;
    ptr = ceil(ptr / (2 * bb)) * 2 * bb;
    tb[6] = ptr; ptr += 2 * bb;
    tb[7] = ptr; ptr += 2 * bb;
    tb[8] = pp - 1; tb[9] = 0;
    tb[12] = oo + lat + 1 - bb - (bb / qb - 1) * qb;
    oo += pp * bb;
    bb = nb;
    k += 1;
  );
  nlev = k; ncov = oo;
  span = oo + lat + 2 * 16384 + 2 * qb;
  ptr <= eend ? ( memset(DYN, 0, ptr - DYN); memset(OBL, 0, 2 * RSO); memset(HD, 0, 512); ph = 0; 1; ) : 0;
);


function e_reset() instance(ebase, eend, LVT, OBL, OBR, HD, WV, DYN, ready, nlev, lst, act, QB0, L, nin, npath, mode, irlen, ncov, span, ph, ywl, ywr, lh, lopen, lerr, lnch, lfsr, lfr, lg, lim, lzl, lsr, lpos, lnc, lrs, lrn, lc, lk, lp, lnin, lnp, lmd, lpm0, lpm1, lpm2, lpm3, wpk, wver, cin0, gsc, age, lpd, lpo) local(k, tb) (
  k = 0;
  loop(nlev,
    tb = LVT + k * 16;
    memset(tb[4], 0, nin * tb[1] * tb[10]);
    memset(tb[6], 0, tb[10]); memset(tb[7], 0, tb[10]);
    tb[8] = tb[1] - 1; tb[9] = 0;
    k += 1;
  );
  memset(OBL, 0, RSO); memset(OBR, 0, RSO);
  ph = 0; age = 0;
);

function mac_ts(xx, xc, hq, hb, al, ar, pp, sq, n2, q0, q1) local(b, xp, hp, lr, li, rr, ri, xa, xb, xe, xf, xc1, na) (
  xc1 = xc + 1; na = sq + 1; b = q0;
  b === 0 ? (
      lr = li = rr = ri = 0;
      xp = xx + sq * n2 + 2 * 0; hp = hq + 0 * 8;
      loop(na,
        xa = xp[0]; xb = xp[1]; xe = xp[xc]; xf = xp[xc1];
          lr += xa * hp[0] + xe * hp[4]; li += xb * hp[1] + xf * hp[5];
          rr += xa * hp[2] + xe * hp[6]; ri += xb * hp[3] + xf * hp[7];
          xp -= n2; hp += hb;
      );
      xp = xx + (pp - 1) * n2 + 2 * 0;
      loop(pp - na,
        xa = xp[0]; xb = xp[1]; xe = xp[xc]; xf = xp[xc1];
          lr += xa * hp[0] + xe * hp[4]; li += xb * hp[1] + xf * hp[5];
          rr += xa * hp[2] + xe * hp[6]; ri += xb * hp[3] + xf * hp[7];
          xp -= n2; hp += hb;
      );
      al[2 * 0] = lr; al[2 * 0 + 1] = li; ar[2 * 0] = rr; ar[2 * 0 + 1] = ri;
      b = 1;
  );
  while (b < q1) (
      lr = li = rr = ri = 0;
      xp = xx + sq * n2 + 2 * b; hp = hq + b * 8;
      loop(na,
        xa = xp[0]; xb = xp[1]; xe = xp[xc]; xf = xp[xc1];
          lr += xa * hp[0] - xb * hp[1] + xe * hp[4] - xf * hp[5];
          li += xa * hp[1] + xb * hp[0] + xe * hp[5] + xf * hp[4];
          rr += xa * hp[2] - xb * hp[3] + xe * hp[6] - xf * hp[7];
          ri += xa * hp[3] + xb * hp[2] + xe * hp[7] + xf * hp[6];
          xp -= n2; hp += hb;
      );
      xp = xx + (pp - 1) * n2 + 2 * b;
      loop(pp - na,
        xa = xp[0]; xb = xp[1]; xe = xp[xc]; xf = xp[xc1];
          lr += xa * hp[0] - xb * hp[1] + xe * hp[4] - xf * hp[5];
          li += xa * hp[1] + xb * hp[0] + xe * hp[5] + xf * hp[4];
          rr += xa * hp[2] - xb * hp[3] + xe * hp[6] - xf * hp[7];
          ri += xa * hp[3] + xb * hp[2] + xe * hp[7] + xf * hp[6];
          xp -= n2; hp += hb;
      );
      al[2 * b] = lr; al[2 * b + 1] = li; ar[2 * b] = rr; ar[2 * b + 1] = ri;
      b += 1;
  );
);

function mac_st(xx, xc, hq, hb, al, ar, pp, sq, n2, q0, q1) local(b, xp, hp, lr, li, rr, ri, xa, xb, xe, xf, xc1, na) (
  xc1 = xc + 1; na = sq + 1; b = q0;
  b === 0 ? (
      lr = li = rr = ri = 0;
      xp = xx + sq * n2 + 2 * 0; hp = hq + 0 * 4;
      loop(na,
        xa = xp[0]; xb = xp[1]; xe = xp[xc]; xf = xp[xc1];
          lr += xa * hp[0]; li += xb * hp[1]; rr += xe * hp[2]; ri += xf * hp[3];
          xp -= n2; hp += hb;
      );
      xp = xx + (pp - 1) * n2 + 2 * 0;
      loop(pp - na,
        xa = xp[0]; xb = xp[1]; xe = xp[xc]; xf = xp[xc1];
          lr += xa * hp[0]; li += xb * hp[1]; rr += xe * hp[2]; ri += xf * hp[3];
          xp -= n2; hp += hb;
      );
      al[2 * 0] = lr; al[2 * 0 + 1] = li; ar[2 * 0] = rr; ar[2 * 0 + 1] = ri;
      b = 1;
  );
  while (b < q1) (
      lr = li = rr = ri = 0;
      xp = xx + sq * n2 + 2 * b; hp = hq + b * 4;
      loop(na,
        xa = xp[0]; xb = xp[1]; xe = xp[xc]; xf = xp[xc1];
          lr += xa * hp[0] - xb * hp[1]; li += xa * hp[1] + xb * hp[0];
          rr += xe * hp[2] - xf * hp[3]; ri += xe * hp[3] + xf * hp[2];
          xp -= n2; hp += hb;
      );
      xp = xx + (pp - 1) * n2 + 2 * b;
      loop(pp - na,
        xa = xp[0]; xb = xp[1]; xe = xp[xc]; xf = xp[xc1];
          lr += xa * hp[0] - xb * hp[1]; li += xa * hp[1] + xb * hp[0];
          rr += xe * hp[2] - xf * hp[3]; ri += xe * hp[3] + xf * hp[2];
          xp -= n2; hp += hb;
      );
      al[2 * b] = lr; al[2 * b + 1] = li; ar[2 * b] = rr; ar[2 * b + 1] = ri;
      b += 1;
  );
);

function mac_ms(xx, hq, hb, al, ar, pp, sq, n2, q0, q1) local(b, xp, hp, lr, li, rr, ri, xa, xb, xe, xf, xc1, na) (
  xc1 = 0; na = sq + 1; b = q0;
  b === 0 ? (
      lr = li = rr = ri = 0;
      xp = xx + sq * n2 + 2 * 0; hp = hq + 0 * 4;
      loop(na,
        xa = xp[0]; xb = xp[1];
          lr += xa * hp[0]; li += xb * hp[1]; rr += xa * hp[2]; ri += xb * hp[3];
          xp -= n2; hp += hb;
      );
      xp = xx + (pp - 1) * n2 + 2 * 0;
      loop(pp - na,
        xa = xp[0]; xb = xp[1];
          lr += xa * hp[0]; li += xb * hp[1]; rr += xa * hp[2]; ri += xb * hp[3];
          xp -= n2; hp += hb;
      );
      al[2 * 0] = lr; al[2 * 0 + 1] = li; ar[2 * 0] = rr; ar[2 * 0 + 1] = ri;
      b = 1;
  );
  while (b < q1) (
      lr = li = rr = ri = 0;
      xp = xx + sq * n2 + 2 * b; hp = hq + b * 4;
      loop(na,
        xa = xp[0]; xb = xp[1];
          lr += xa * hp[0] - xb * hp[1]; li += xa * hp[1] + xb * hp[0];
          rr += xa * hp[2] - xb * hp[3]; ri += xa * hp[3] + xb * hp[2];
          xp -= n2; hp += hb;
      );
      xp = xx + (pp - 1) * n2 + 2 * b;
      loop(pp - na,
        xa = xp[0]; xb = xp[1];
          lr += xa * hp[0] - xb * hp[1]; li += xa * hp[1] + xb * hp[0];
          rr += xa * hp[2] - xb * hp[3]; ri += xa * hp[3] + xb * hp[2];
          xp -= n2; hp += hb;
      );
      al[2 * b] = lr; al[2 * b + 1] = li; ar[2 * b] = rr; ar[2 * b + 1] = ri;
      b += 1;
  );
);


function e_tick() instance(ebase, eend, LVT, OBL, OBR, HD, WV, DYN, ready, nlev, lst, act, QB0, L, nin, npath, mode, irlen, ncov, span, ph, ywl, ywr, lh, lopen, lerr, lnch, lfsr, lfr, lg, lim, lzl, lsr, lpos, lnc, lrs, lrn, lc, lk, lp, lnin, lnp, lmd, lpm0, lpm1, lpm2, lpm3, wpk, wver, cin0, gsc, age, lpd, lpo) local(k, tb, bb, pp, tt, tcn, n2, xx, xc, al, ar, sq, q0, q1, os, n1, src, dst) (
  k = 0;
  loop(nlev,
    tb = LVT + k * 16;
    bb = tb[0]; pp = tb[1]; tt = tb[3]; n2 = tb[10]; tcn = tb[9]; xx = tb[4]; xc = tb[11];
    al = tb[6]; ar = tb[7];
    tcn === 0 ? (
      sq = tb[8] + 1; sq >= pp ? sq = 0; tb[8] = sq;
      memcpy(xx + sq * n2, cin0 + wi + 1 - n2 + RSI, n2);
      age < n2 ? memset(xx + sq * n2, 0, n2 - age);
      fft_real(xx + sq * n2, n2);
      nin > 1 ? (
        memcpy(xx + xc + sq * n2, CINR + wi + 1 - n2 + RSI, n2);
        age < n2 ? memset(xx + xc + sq * n2, 0, n2 - age);
        fft_real(xx + xc + sq * n2, n2);
      );
    ) : sq = tb[8];
    q0 = floor(tcn * bb / tt); q1 = floor((tcn + 1) * bb / tt);
    q1 > q0 ? (
      mode === 0 ? mac_ts(xx, xc, tb[5], tb[13], al, ar, pp, sq, n2, q0, q1) :
      mode === 1 ? mac_st(xx, xc, tb[5], tb[13], al, ar, pp, sq, n2, q0, q1) :
      mac_ms(xx, tb[5], tb[13], al, ar, pp, sq, n2, q0, q1);
    );
    tcn === tt - 1 ? (
      ifft_real(al, n2); ifft_real(ar, n2);
      os = opos + tb[12]; os >= RSO ? os -= RSO;
      n1 = min(bb, RSO - os);
      src = al + bb; dst = OBL + os; loop(n1, dst[] += src[]; dst += 1; src += 1;);
      dst = OBL; loop(bb - n1, dst[] += src[]; dst += 1; src += 1;);
      src = ar + bb; dst = OBR + os; loop(n1, dst[] += src[]; dst += 1; src += 1;);
      dst = OBR; loop(bb - n1, dst[] += src[]; dst += 1; src += 1;);
      tb[9] = 0;
    ) : tb[9] = tcn + 1;
    k += 1;
  );
);

function e_sample() instance(ebase, eend, LVT, OBL, OBR, HD, WV, DYN, ready, nlev, lst, act, QB0, L, nin, npath, mode, irlen, ncov, span, ph, ywl, ywr, lh, lopen, lerr, lnch, lfsr, lfr, lg, lim, lzl, lsr, lpos, lnc, lrs, lrn, lc, lk, lp, lnin, lnp, lmd, lpm0, lpm1, lpm2, lpm3, wpk, wver, cin0, gsc, age, lpd, lpo) local(xl, xr, hp, a0, a1, v0, v1) (
  quiet > span ? (
    ywl = ywr = 0;
    ph += 1; ph >= QB0 ? ph = 0;
  ) : (
    age < 65536 ? age += 1;
    ph += 1; ph >= QB0 ? ( ph = 0; this.e_tick(); );
    ywl = OBL[opos]; ywr = OBR[opos]; OBL[opos] = 0; OBR[opos] = 0;
    L === 0 ? (
      mode === 0 ? (
      xl = CINL + wi + RSI; xr = CINR + wi + RSI; hp = HD; a0 = a1 = 0;
      loop(min(QB0, age), v0 = xl[]; v1 = xr[]; a0 += v0 * hp[0] + v1 * hp[2]; a1 += v0 * hp[1] + v1 * hp[3]; xl -= 1; xr -= 1; hp += 4;);
      ywl += a0; ywr += a1;
      ) : mode === 1 ? (
      xl = CINL + wi + RSI; xr = CINR + wi + RSI; hp = HD; a0 = a1 = 0;
      loop(min(QB0, age), a0 += xl[] * hp[0]; a1 += xr[] * hp[1]; xl -= 1; xr -= 1; hp += 2;);
      ywl += a0; ywr += a1;
      ) : (
      xl = cin0 + wi + RSI; hp = HD; a0 = a1 = 0;
      loop(min(QB0, age), v0 = xl[]; a0 += v0 * hp[0]; a1 += v0 * hp[1]; xl -= 1; hp += 2;);
      ywl += a0; ywr += a1;
      );
    );
  );
);

function bessel_i0(x) local(s, t, k) (
  s = 1; t = 1; k = 1;
  loop(60, t *= (x * 0.5 / k) * (x * 0.5 / k); s += t; k += 1;);
  s;
);

function rs_kernel(u) local(x, w) (
  x = u / RS_WD;
  abs(x) >= 1 ? 0 : (
    w = bessel_i0(RS_BETA * sqrt(1 - x * x)) / RS_I0B;
    x = RS_FC * u;
    abs(x) < 0.000000000001 ? RS_FC * w : RS_FC * sin($pi * x) / ($pi * x) * w;
  );
);

function rs_setup(fsr, dsr) local(a, b, t, g, rph, tp) (
  a = floor(fsr + 0.5); b = floor(dsr + 0.5);
  while (b > 0) ( t = a - b * floor(a / b); a = b; b = t; );
  g = a;
  RS_L = floor(dsr + 0.5) / g; RS_M = floor(fsr + 0.5) / g;
  RS_FC = 0.975 * min(1, dsr / fsr);
  RS_WD = 40 / RS_FC;
  RS_NT = 2 * ceil(RS_WD);
  RS_BETA = 8.6; RS_I0B = bessel_i0(RS_BETA);
  RS_TAB = RS_L * RS_NT <= RSTMAX && floor(fsr + 0.5) === fsr && floor(dsr + 0.5) === dsr;
  RS_TAB ? (
    rph = 0;
    loop(RS_L,
      tp = 0;
      loop(RS_NT,
        RST[rph * RS_NT + tp] = rs_kernel(tp - (RS_NT / 2 - 1) - rph / RS_L);
        tp += 1;
      );
      rph += 1;
    );
  );
  RS_R = dsr / fsr;
);

function rs_run(dst, src, nch, ch, nfr, m0, m1) local(m, base, rph, n0, sp, cp, acc, t, pos, u) (
  RS_TAB ? (
    base = floor(m0 * RS_M / RS_L); rph = m0 * RS_M - base * RS_L;
    m = m0;
    while (m < m1) (
      n0 = base - (RS_NT / 2 - 1);
      cp = RST + rph * RS_NT;
      acc = 0;
      n0 >= 0 && n0 + RS_NT <= nfr ? (
        sp = src + n0 * nch + ch;
        loop(RS_NT, acc += cp[] * sp[]; cp += 1; sp += nch;);
      ) : (
        t = 0;
        loop(RS_NT,
          (n0 + t >= 0 && n0 + t < nfr) ? acc += cp[t] * src[(n0 + t) * nch + ch];
          t += 1;
        );
      );
      dst[m] = acc;
      rph += RS_M; base += floor(rph / RS_L); rph -= floor(rph / RS_L) * RS_L;
      m += 1;
    );
  ) : (
    m = m0;
    while (m < m1) (
      pos = m / RS_R;
      n0 = floor(pos) - (RS_NT / 2 - 1);
      acc = 0; t = 0;
      loop(RS_NT,
        (n0 + t >= 0 && n0 + t < nfr) ? ( u = n0 + t - pos; acc += rs_kernel(u) * src[(n0 + t) * nch + ch]; );
        t += 1;
      );
      dst[m] = acc;
      m += 1;
    );
  );
  (m1 - m0) * RS_NT * (RS_TAB ? 1 : 40);
);

function e_load_begin(lgain, imode, zl) instance(ebase, eend, LVT, OBL, OBR, HD, WV, DYN, ready, nlev, lst, act, QB0, L, nin, npath, mode, irlen, ncov, span, ph, ywl, ywr, lh, lopen, lerr, lnch, lfsr, lfr, lg, lim, lzl, lsr, lpos, lnc, lrs, lrn, lc, lk, lp, lnin, lnp, lmd, lpm0, lpm1, lpm2, lpm3, wpk, wver, cin0, gsc, age, lpd, lpo) local(n) (
  ready = 0; lst = 0; lerr = 0;
  lh >= 0 && lopen ? file_close(lh);
  lopen = 0;
  lh = file_open(#ldpath);
  lh < 0 ? ( lerr = 1; lst = -1; ) : (
    lopen = 1;
    lnch = 0; lfsr = 0;
    file_riff(lh, lnch, lfsr);
    (lnch < 1 || lfsr < 1000) ? ( file_close(lh); lopen = 0; lerr = 2; lst = -1; ) : (
      lfr = floor(file_avail(lh) / lnch);
      lfr = min(lfr, floor(4 * MAXF / lnch));
      lfr < 1 ? ( file_close(lh); lopen = 0; lerr = 2; lst = -1; ) : (
        lg = lgain; lim = imode; lzl = zl; lsr = srate; lpd = lppd;
        lpos = 0; lst = 1;
      );
    );
  );
  lst;
);

function e_load_cancel() instance(ebase, eend, LVT, OBL, OBR, HD, WV, DYN, ready, nlev, lst, act, QB0, L, nin, npath, mode, irlen, ncov, span, ph, ywl, ywr, lh, lopen, lerr, lnch, lfsr, lfr, lg, lim, lzl, lsr, lpos, lnc, lrs, lrn, lc, lk, lp, lnin, lnp, lmd, lpm0, lpm1, lpm2, lpm3, wpk, wver, cin0, gsc, age, lpd, lpo) (
  lopen ? file_close(lh); lopen = 0; lst = 0; ready = 0;
);

function e_load_step(budget) instance(ebase, eend, LVT, OBL, OBR, HD, WV, DYN, ready, nlev, lst, act, QB0, L, nin, npath, mode, irlen, ncov, span, ph, ywl, ywr, lh, lopen, lerr, lnch, lfsr, lfr, lg, lim, lzl, lsr, lpos, lnc, lrs, lrn, lc, lk, lp, lnin, lnp, lmd, lpm0, lpm1, lpm2, lpm3, wpk, wver, cin0, gsc, age, lpd, lpo) local(work, n, got, c, m1, tb, bb, n2, oo, cnt, sp, dp, sc, hp, hs, b, src, j, pk, v) (
  work = 0;
  while (work < budget && lst > 0 && lst < 6) (
    lst === 1 ? (
      n = min(65536, lfr * lnch - lpos);
      got = n > 0 ? file_mem(lh, STAGE + lpos, n) : 0;
      lpos += n; work += n;
      (lpos >= lfr * lnch || got < n) ? (
        file_close(lh); lopen = 0;
        lnc = min(lnch, 4);
        lrs = abs(lfsr - lsr) >= 0.5;
        lrs ? ( rs_setup(lfsr, lsr); lrn = min(MAXF, ceil(lfr * RS_R) - 1); lpo = floor(lpd * RS_R); ) : ( lrn = min(MAXF, lfr); lpo = lpd; );
        lrn = max(1, lrn); lpo = max(0, min(lpo, MAXF - lrn));
        lc = 0; lpos = 0; lst = 2;
      );
    ) : lst === 2 ? (
      lrs ? (
        m1 = min(lrn, lpos + 4096);
        work += rs_run(PATHS + lc * MAXF, STAGE, lnch, lc, lfr, lpos, m1);
        lpos = m1;
      ) : (
        m1 = min(lrn, lpos + 65536);
        dp = PATHS + lc * MAXF + lpos; sp = STAGE + lpos * lnch + lc;
        loop(m1 - lpos, dp[] = sp[]; dp += 1; sp += lnch;);
        work += 2 * (m1 - lpos);
        lpos = m1;
      );
      lpos >= lrn ? (
        lpos = 0; lc += 1;
        lc >= lnc ? (
          lpo > 0 ? (
            lc = 0;
            loop(lnc, memcpy(PATHS + lc * MAXF + lpo, PATHS + lc * MAXF, lrn); memset(PATHS + lc * MAXF, 0, lpo); lc += 1;);
            lrn += lpo; work += lnc * lrn;
          );
          lim === 1 ? (
            lnin = 1; lnp = 2; lmd = 2;
            PMAP[0] = 0; PMAP[1] = lnc >= 2 ? 1 : 0;
          ) : lnc >= 4 ? (
            lnin = 2; lnp = 4; lmd = 0;
            PMAP[0] = 0; PMAP[1] = 1; PMAP[2] = 2; PMAP[3] = 3;
          ) : (
            lnin = 2; lnp = 2; lmd = 1;
            PMAP[0] = 0; PMAP[1] = lnc >= 2 ? 1 : 0;
          );
          lpm0 = PMAP[0]; lpm1 = PMAP[1]; lpm2 = PMAP[2]; lpm3 = PMAP[3];
          FIXQ && lrs ? lg *= lfsr / lsr;
          this.e_layout(lrn, lzl ? ZB0 : BB0, lzl ? 0 : BB0, lnin, lnp, lmd) ? (
            lc = 0; lk = 0; lp = 0; lst = 3;
          ) : ( lerr = 3; lst = -1; );
        );
      );
    ) : lst === 3 ? (
      tb = LVT + lk * 16;
      bb = tb[0]; n2 = tb[10]; oo = tb[2] + lp * bb;
      src = PATHS + (lc === 0 ? lpm0 : lc === 1 ? lpm1 : lc === 2 ? lpm2 : lpm3) * MAXF;
      memset(TMP, 0, n2);
      cnt = max(0, min(bb, lrn - oo));
      sc = lg / (4 * n2);
      sp = src + oo; dp = TMP;
      loop(cnt, dp[] = sp[] * sc; dp += 1; sp += 1;);
      fft_real(TMP, n2);
      hs = 2 * npath;
      hp = tb[5] + lp * tb[13] + 2 * lc; sp = TMP;
      loop(bb, hp[0] = sp[0]; hp[1] = sp[1]; hp += hs; sp += 2;);
      work += 6 * n2;
      lp += 1;
      lp >= tb[1] ? (
        lp = 0; lk += 1;
        lk >= nlev ? (
          L === 0 ? (
            j = 0;
            loop(min(QB0, lrn), HD[j * npath + lc] = src[j] * lg; j += 1;);
          );
          lk = 0; lc += 1;
          lc >= npath ? ( lc = 0; lpos = 0; lst = 4; memset(WV, 0, 4 * NWB); );
        );
      );
    ) : lst === 4 ? (
      src = PATHS + (lc === 0 ? lpm0 : lc === 1 ? lpm1 : lc === 2 ? lpm2 : lpm3) * MAXF;
      b = 0;
      loop(NWB,
        sp = src + floor(b * lrn / NWB); n = max(1, floor((b + 1) * lrn / NWB) - floor(b * lrn / NWB));
        pk = 0; loop(n, v = abs(sp[]); v > pk ? pk = v; sp += 1;);
        WV[lc * NWB + b] = pk * lg;
        b += 1;
      );
      work += lrn;
      lc += 1;
      lc >= npath ? (
        wpk = 0; j = 0; loop(npath * NWB, wpk = max(wpk, WV[j]); j += 1;);
        wver += 1; lst = 6; ready = 1;
      );
    );
  );
  work;
);


function db_coeff(d) ( d <= -60 ? 0 : d > 6.02 ? 2 : 10 ^ (0.05 * d); );

function e_ready(e) ( e === 1 ? ea.ready : e === 2 ? eb.ready : 0; );
function e_lat(e) ( e === 1 ? ea.L : e === 2 ? eb.L : 0; );

function want_key() (
  wprog = max(0, min(387, floor(program + 0.5)));
  wim = in_mode >= 0.5; wzl = zero_lat >= 0.5;
  wprog * 100 + wim * 10 + wzl;
);

function set_path(k) (
  strcpy(#ldpath, k ? "Dependencies/WallToWall/" : "WallToWall/");
  strncat(#ldpath, 100 + wprog, PSP[wprog]); strcat(#ldpath, ".flac");
);

function start_load(tgt) local(g, r) (
  g = PGS[wprog]; lppd = PPD[wprog];
  set_path(0);
  r = tgt === 1 ? ea.e_load_begin(g, wim, wzl) : eb.e_load_begin(g, wim, wzl);
  r < 0 ? ( set_path(1); r = tgt === 1 ? ea.e_load_begin(g, wim, wzl) : eb.e_load_begin(g, wim, wzl); );
  r < 0 ? ( fail_key = lkey; ld_e = 0; load_err = 1; ) : ( ld_e = tgt; load_err = 0; );
);

function activate(tgt) (
  cur ? ( old = cur; fpos = 0; ) : old = 0;
  cur = tgt; akey = lkey;
  tgt === 1 ? ( ea.act = 1; ea.age = 0; ea.gsc = old ? 0 : 1; ) : ( eb.act = 1; eb.age = 0; eb.gsc = old ? 0 : 1; );
  ld_e = 0;
);

function control(sync) local(k, tgt, w) (
  k = want_key();
  k !== akey && k !== fail_key && !old ? (
    (ld_e === 0 || k !== lkey) ? (
      ld_e === 1 ? ea.e_load_cancel() : ld_e === 2 ? eb.e_load_cancel();
      lkey = k;
      tgt = cur === 1 ? 2 : 1;
      start_load(tgt);
    );
  );
  ld_e ? (
    (sync || !cur) ? (
      w = 0; while (ld_e && (ld_e === 1 ? ea.lst : eb.lst) > 0 && (ld_e === 1 ? ea.lst : eb.lst) < 6 && w < 1000000000) (
        w += ld_e === 1 ? ea.e_load_step(10000000) : eb.e_load_step(10000000);
      );
    ) : (
      ld_e === 1 ? ea.e_load_step(LBUDGET * samplesblock) : eb.e_load_step(LBUDGET * samplesblock);
    );
    e_ready(ld_e) ? activate(ld_e) : (ld_e === 1 ? ea.lst : eb.lst) < 0 ? ( fail_key = lkey; load_err = ld_e === 1 ? ea.lerr : eb.lerr; ld_e = 0; );
  );
  pdc_delay = e_lat(cur); pdc_bot_ch = 0; pdc_top_ch = 2;
);

LBUDGET = 400;
ea.e_init(EMA, ESZ); eb.e_init(EMB, ESZ);
ea.lh = eb.lh = -1;
cur = old = ld_e = 0; akey = lkey = fail_key = -1; 
wi = opos = dw = pw = gcnt = quiet = 0; pd_cur = pd_old = 0; pd_x = 0;
last_srate = 0;
gd = 0; gw = 1;
function gsx(x) ( G_OX + x * G_SC; );
function gsy(y) ( y * G_SC; );
function gclamp(x, a, b) ( min(b, max(a, x)); );

function grspan(qx0, qy0, qx1, qy1, qrad, yc) local(dy, ins) (
  dy = yc < qy0 + qrad ? qy0 + qrad - yc : yc > qy1 - qrad ? yc - (qy1 - qrad) : 0;
  G_RC = max(0, min(1, qrad - dy + 0.5));
  dy = min(qrad, dy);
  ins = qrad - sqrt(max(0, qrad * qrad - dy * dy));
  G_RL = qx0 + ins; G_RR = qx1 - ins;
);

function gspan(lx, rx, j, a) local(lc, rc) (
  lc = ceil(lx); rc = floor(rx);
  rc >= lc ? (
    gfx_a = a; rc > lc ? gfx_rect(lc, j, rc - lc, 1);
    lc - lx > 0 ? ( gfx_a = a * (lc - lx); gfx_rect(lc - 1, j, 1, 1); );
    rx - rc > 0 ? ( gfx_a = a * (rx - rc); gfx_rect(rc, j, 1, 1); );
  ) : rx > lx ? ( gfx_a = a * (rx - lx); gfx_rect(floor(lx), j, 1, 1); );
);

function gfrr(qx0, qy0, qx1, qy1, qrad, cr, cg, cb, a0) local(j) (
  qx0 = floor(qx0 + 0.5); qy0 = floor(qy0 + 0.5); qx1 = floor(qx1 + 0.5); qy1 = floor(qy1 + 0.5);
  qrad = max(0, min(qrad, min(qy1 - qy0, qx1 - qx0) * 0.5));
  gfx_set(cr, cg, cb, a0);
  j = qy0;
  loop(qy1 - qy0,
    grspan(qx0, qy0, qx1, qy1, qrad, j + 0.5);
    G_RC > 0 ? gspan(G_RL, G_RR, j, a0 * G_RC);
    j += 1;
  );
  gfx_a = 1;
);

function gbord(qx0, qy0, qx1, qy1, qrad, t, cr, cg, cb, a0) local(j, ol, orr, oc, il, ir, ic) (
  qx0 = floor(qx0 + 0.5); qy0 = floor(qy0 + 0.5); qx1 = floor(qx1 + 0.5); qy1 = floor(qy1 + 0.5);
  qrad = max(0, min(qrad, min(qy1 - qy0, qx1 - qx0) * 0.5));
  gfx_set(cr, cg, cb, a0);
  j = qy0;
  loop(qy1 - qy0,
    grspan(qx0, qy0, qx1, qy1, qrad, j + 0.5); ol = G_RL; orr = G_RR; oc = G_RC;
    (j + 0.5 > qy0 + t && j + 0.5 < qy1 - t) ? (
      grspan(qx0 + t, qy0 + t, qx1 - t, qy1 - t, max(0, qrad - t), j + 0.5); il = G_RL; ir = G_RR; ic = G_RC;
    ) : ( ic = 0; );
    oc > 0 ? (
      ic <= 0 ? gspan(ol, orr, j, a0 * oc) : (
        gspan(ol, il, j, a0 * oc);
        gspan(ir, orr, j, a0 * oc);
        oc - ic > 0.004 ? gspan(il, ir, j, a0 * (oc - ic));
      );
    );
    j += 1;
  );
  gfx_a = 1;
);

function gcard(x, y, w, h, r, a0, ba) local(xx, yy, ww, hh, rr) (
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC); rr = max(2, floor(r * G_SC));
  gfrr(xx, yy, xx + ww, yy + hh, rr, 0.165, 0.17, 0.18, a0);
  gbord(xx, yy, xx + ww, yy + hh, rr, max(1, floor(G_SC + 0.5)), 0.62, 0.66, 0.70, ba);
);

function gtext(x, y, s, fnt, r, g, b, a, ctr) local(tw, th) (
  gfx_setfont(fnt);
  gfx_set(r, g, b, a);
  gfx_measurestr(s, tw, th);
  gfx_x = ctr === 1 ? gsx(x) - tw * 0.5 : ctr === 2 ? gsx(x) - tw : gsx(x);
  gfx_y = gsy(y) - th * 0.5;
  gfx_drawstr(s);
);

function gann(cx, cy, ri, ro, aa, ab, cr, cg, cb, al) local(py, px, dy, dx, hwo, hwi, d, cv, th, ca, x0, x1, x2, x3) (
  py = floor(cy - ro - 1);
  loop(ceil(2 * ro + 3),
    dy = py + 0.5 - cy;
    hwo = sqrt(max(0, (ro + 0.5) * (ro + 0.5) - dy * dy));
    hwo > 0 ? (
      hwi = ri > 0.5 ? sqrt(max(0, (ri - 0.5) * (ri - 0.5) - dy * dy)) : 0;
      x0 = floor(cx - hwo); x1 = ceil(cx - hwi); x2 = floor(cx + hwi); x3 = ceil(cx + hwo);
      hwi <= 0 ? x1 = x3 + 1;
      px = x0;
      while (px <= x3) (
        dx = px + 0.5 - cx;
        d = sqrt(dx * dx + dy * dy);
        cv = min(1, min(ro - d + 0.5, d - ri + 0.5));
        cv > 0 ? (
          th = atan2(dx, -dy);
          ca = min(1, min((th - aa) * d + 0.5, (ab - th) * d + 0.5));
          ca > 0 ? (
            gfx_set(cr, cg, cb, al * cv * ca);
            gfx_rect(px, py, 1, 1);
          );
        );
        px += 1;
        (px > x1 && px < x2) ? px = x2;
      );
    );
    py += 1;
  );
  gfx_a = 1;
);

function gbar(x0, y0, x1, y1, w) local(dx, dy, ll, hw, bx0, by0, bx1, by1, px, py, qx, qy, t, ex, ey, d, cv, cr, cg, cb, ca) (
  cr = gfx_r; cg = gfx_g; cb = gfx_b; ca = gfx_a;
  dx = x1 - x0; dy = y1 - y0; ll = max(0.000001, dx * dx + dy * dy);
  hw = w * 0.5;
  bx0 = floor(min(x0, x1) - hw - 1); bx1 = ceil(max(x0, x1) + hw + 1);
  by0 = floor(min(y0, y1) - hw - 1); by1 = ceil(max(y0, y1) + hw + 1);
  py = by0;
  while (py <= by1) (
    px = bx0;
    while (px <= bx1) (
      qx = px + 0.5; qy = py + 0.5;
      t = max(0, min(1, ((qx - x0) * dx + (qy - y0) * dy) / ll));
      ex = qx - (x0 + t * dx); ey = qy - (y0 + t * dy);
      d = sqrt(ex * ex + ey * ey);
      cv = min(1, hw - d + 0.5);
      cv > 0 ? ( gfx_set(cr, cg, cb, ca * cv); gfx_rect(px, py, 1, 1); );
      px += 1;
    );
    py += 1;
  );
  gfx_set(cr, cg, cb, ca);
);

function gknob(kx, ky, kr, v, ctr, hov, nm, vs, dim) local(cx, cy, r, a0, a1, sa, ca, px0, py0, al) (
  cx = gsx(kx); cy = gsy(ky); r = kr * G_SC;
  al = dim ? 0.66 : 1;
  a0 = -$pi * 0.75; a1 = $pi * 0.75;
  gfx_set(0.02, 0.02, 0.03, 0.5 * al);
  gfx_circle(cx, cy, r + 3 * G_SC, 1, 1);
  gfx_set(G_KRR, G_KRG, G_KRB, 1);
  gfx_circle(cx, cy, r - 5 * G_SC, 1, 1);
  gfx_set(G_KFR, G_KFG, G_KFB, 1);
  gfx_circle(cx, cy, r - 7 * G_SC, 1, 1);
  gfx_set(G_KIR, G_KIG, G_KIB, 1);
  gfx_circle(cx, cy + 1.2 * G_SC, r - 9 * G_SC, 1, 1);
  gann(cx, cy, r - 1.2 * G_SC, r + 1.2 * G_SC, a0, a1, G_KTR, G_KTG, G_KTB, 0.6 * al);
  sa = a0 + (a1 - a0) * v;
  ca = a0 + (a1 - a0) * ctr;
  abs(sa - ca) > 0.001 ? (
    gann(cx, cy, r - 3.5 * G_SC, r + 3.5 * G_SC, min(ca, sa), max(ca, sa), G_ACR, G_ACG, G_ACB, 0.18 * al);
    gann(cx, cy, r - 1.5 * G_SC, r + 1.5 * G_SC, min(ca, sa), max(ca, sa), G_ACR, G_ACG, G_ACB, al);
  );
  px0 = cx + sin(sa) * (r - 8 * G_SC);
  py0 = cy - cos(sa) * (r - 8 * G_SC);
  gfx_set(G_KPR, G_KPG, G_KPB, (hov ? 1 : 0.86) * al);
  gbar(cx + sin(sa) * (r * 0.22), cy - cos(sa) * (r * 0.22), px0, py0, max(1.5, 2.4 * G_SC));
  gtext(kx, ky - kr - 13, nm, 1, G_T1R, G_T1G, G_T1B, 0.95 * al, 1);
  gtext(kx, ky + kr + 13, vs, 2, G_ACR, G_ACG, G_ACB, 0.95 * al, 1);
);
function gbtn(x, y, w, h, lb, on, hov) local(xx, yy, ww, hh, rr) (
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC); rr = floor(h * 0.5 * G_SC);
  on ? (
    gfrr(xx, yy, xx + ww, yy + hh, rr, G_ACR, G_ACG, G_ACB, hov ? 1 : 0.9);
    gtext(x + w * 0.5, y + h * 0.5, lb, 3, G_DKR, G_DKG, G_DKB, 1, 1);
  ) : (
    gfrr(xx, yy, xx + ww, yy + hh, rr, G_BFR, G_BFG, G_BFB, hov ? 0.95 : 0.8);
    gbord(xx, yy, xx + ww, yy + hh, rr, max(1, floor(G_SC + 0.5)), G_BDR, G_BDG, G_BDB, hov ? 0.7 : 0.4);
    gtext(x + w * 0.5, y + h * 0.5, lb, 3, G_T2R, G_T2G, G_T2B, hov ? 1 : 0.8, 1);
  );
);

function gauto(s, e) (
<?
max_sliders > 8 ? printf("slider_automate(2^(s-1), e);") : (
  printf("s == 1 ? slider_automate(program, e) :\n");
  printf("s == 2 ? slider_automate(in_mode, e) :\n");
  printf("s == 3 ? slider_automate(dry_db, e) :\n");
  printf("s == 4 ? slider_automate(wet_db, e) :\n");
  printf("s == 5 ? slider_automate(predelay, e) :\n");
  printf("s == 6 ? slider_automate(zero_lat, e) :\n");
  printf("s == 7 ? slider_automate(enable, e) :\n");
  printf("s == 8 ? slider_automate(theme, e) : 0;");
);
?>
);

function gpanel(x, y, w, h, ttl) local(xx, yy, ww, hh, rr) (
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC); rr = max(2, floor(10 * G_SC));
  gfrr(xx, yy, xx + ww, yy + hh, rr, G_PFR, G_PFG, G_PFB, 0.92);
  gbord(xx, yy, xx + ww, yy + hh, rr, max(1, floor(G_SC + 0.5)), G_BDR, G_BDG, G_BDB, 0.45);
  gtext(x + w * 0.5, y + 16, ttl, 3, G_T2R, G_T2G, G_T2B, 1, 1);
);

function gbox(x, y, w, h, s, hov, act) local(xx, yy, ww, hh, rr) (
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC); rr = max(2, floor(5 * G_SC));
  gfrr(xx, yy, xx + ww, yy + hh, rr, G_BXR, G_BXG, G_BXB, 0.95);
  gbord(xx, yy, xx + ww, yy + hh, rr, max(1, floor(G_SC + 0.5)), act ? G_ACR : G_BDR, act ? G_ACG : G_BDG, act ? G_ACB : G_BDB, act ? 0.95 : hov ? 0.75 : 0.4);
  gtext(x + w * 0.5, y + h * 0.5, s, 2, G_T1R, G_T1G, G_T1B, 1, 1);
);

function gseg2(x, y, w, h, la, lb, cur, hov, dim) local(sw, i, xx, yy, ww, hh) (
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC);
  gfrr(xx, yy, xx + ww, yy + hh, floor(h * 0.5 * G_SC), G_BXR, G_BXG, G_BXB, 0.9);
  gbord(xx, yy, xx + ww, yy + hh, floor(h * 0.5 * G_SC), max(1, floor(G_SC + 0.5)), G_BDR, G_BDG, G_BDB, 0.4);
  sw = w / 2;
  i = 0;
  loop(2,
    i === cur ? (
      xx = floor(gsx(x + i * sw + 3)); yy = floor(gsy(y + 3)); ww = ceil((sw - 6) * G_SC); hh = ceil((h - 6) * G_SC);
      gfrr(xx, yy, xx + ww, yy + hh, floor((h - 6) * 0.5 * G_SC), G_ACR, G_ACG, G_ACB, (hov === i ? 1 : 0.9) * (dim ? 0.6 : 1));
      gtext(x + i * sw + sw * 0.5, y + h * 0.5, i ? lb : la, 3, G_DKR, G_DKG, G_DKB, 1, 1);
    ) : (
      gtext(x + i * sw + sw * 0.5, y + h * 0.5, i ? lb : la, 3, G_T2R, G_T2G, G_T2B, hov === i ? 1 : 0.75, 1);
    );
    i += 1;
  );
);

function gwrap(w, fnt) local(n, i, c, ls, lb, ln, tw, th) (
  gfx_setfont(fnt);
  n = strlen(#g_desc); i = 0; ls = 0; lb = -1; ln = 0;
  while (i <= n && ln < 8) (
    c = i < n ? str_getchar(#g_desc, i) : 32;
    c === 32 ? (
      strcpy_substr(#g_tx, #g_desc, ls, i - ls);
      gfx_measurestr(#g_tx, tw, th);
      tw > w * G_SC && lb > ls ? (
        strcpy_substr(40 + ln, #g_desc, ls, lb - ls); ln += 1; ls = lb + 1;
      );
      lb = i;
    );
    i += 1;
  );
  ls < n && ln < 8 ? ( strcpy_substr(40 + ln, #g_desc, ls, n - ls); ln += 1; );
  ln;
);

function gtip_text(id) (
  id === 1 ? strcpy(#g_tip, "Programs in this group") :
  id === 2 ? strcpy(#g_tip, "Click to load this program") :
  id === 3 ? strcpy(#g_tip, "Drag up/down or use the wheel; Ctrl = fine; double-click resets") :
  id === 4 ? strcpy(#g_tip, "Stereo: L feeds the left IR and R the right one (4-channel IRs are true stereo). Mono to Stereo: L+R feeds both") :
  id === 5 ? strcpy(#g_tip, "No latency (direct-form head, more CPU); off = 256 samples, compensated by REAPER") :
  id === 6 ? strcpy(#g_tip, "Off passes the dry signal only") :
  id === 7 ? strcpy(#g_tip, "Click to show or hide the programs under this heading") :
  id === 9 ? strcpy(#g_tip, "Colour theme") : strcpy(#g_tip, "");
  #g_tip;
);

function gdbstr(d) ( d <= -60 ? strcpy(#g_tx, "Off") : sprintf(#g_tx, "%.1f dB", d); #g_tx; );


G_SCROLL = 0; G_CAT = -1; G_OPEN = -1; G_LPRG = -1; G_VKY = -1000000; G_VN = 0; G_FOC = 0; G_DRAG = 0; G_MBLK = 0; G_WCAT = -1; G_WSC = 0; G_NWL = 0;

