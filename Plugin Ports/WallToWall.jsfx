G_PRESS ? ( G_LCLK = G_DCLK ? 0 : G_NOW; G_LCX = G_MX; G_LCY = G_MY; );

G_PRG = max(0, min(387, floor(program + 0.5)));
G_PRG !== G_LPRG ? ( G_LPRG = G_PRG; G_CAT !== PCAT[G_PRG] ? G_OPEN = -1; G_CAT = PCAT[G_PRG]; !PSG[G_PRG] ? G_OPEN = PHD[G_PRG]; G_FOC = 1; );

gtext(1046, 28, "based on x42 Convolver by Robin Gareus", 4, G_T3R, G_T3G, G_T3B, 1, 2);
