function lcrDelay_run(st, pv, n) local(ldel, llev, cdel, clev, rdel, rlev, feedback, high_d, low_d, spread, wet,
    in_l, in_r, out_l, out_r, buf, bpos, size, fs, f1, f2, sc_r, spr_t, spr_o, fb, ll, cl, rl, ld, cd, rd,
    ll_d, cl_d, rl_d, ld_d, cd_d, rd_d, left, right, fbs, x, cv, pos) global(swh_sr) (
