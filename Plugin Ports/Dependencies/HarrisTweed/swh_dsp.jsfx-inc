    peak_dist === 0 ? (
      peak_dist = swh_round(delay);
      peak = 0;
    ) : peak_dist -= 1;
    gain = amp_buffer[(bp - swh_round(delay)) & (len - 1)];
    amp_buffer[(bp - swh_round(delay)) & (len - 1)] = 1 / swh_db2lin(atten);
    gain = 1 / swh_db2lin(atten);
    out1[pos] = buffer[(2 * (bp + 1)) & msk] * gain;
    out2[pos] = buffer[((2 * (bp + 1)) + 1) & msk] * gain;
