function rk_prime() (
  SWH_DB = 0; SWH_LIN = 0; SWH_RT = 0; swh_rp = 0; surroundEncoder_xc = 0; hilbert_xc = 0; bodeShifter_xc = 0; bodeShifterCV_xc = 0; ringmod_1i1o1l_tri = 0; ringmod_1i1o1l_sr = 0; ringmod_1i1o1l_squ = 0; ringmod_1i1o1l_sin = 0; ringmod_1i1o1l_saw = 0; blo_cache = 0;
  swh_db_init(); swh_srand(1);
