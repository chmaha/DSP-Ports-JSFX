function lookaheadLimiter_run(st, pv, n) local(limit, delay_s, in1, in2, out1, out2, buffer, len, bp, fs, atten, peak,
    peak_dist, delay, msk, pos, a, b, sig, gain, mx) global(SWH_FIX) (
  limit = pv[0]; delay_s = pv[1]; in1 = pv[3]; in2 = pv[4]; out1 = pv[5]; out2 = pv[6];
  buffer = st[0]; len = st[1]; bp = st[2]; fs = st[3]; atten = st[4]; peak = st[5]; peak_dist = st[6];
  delay = floor(delay_s * fs);
  msk = len - 1;
