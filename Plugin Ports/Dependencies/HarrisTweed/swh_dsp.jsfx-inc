function allpass_l_run(st, pv, n) local(in, out, dt, dc, buf, mask, size, sr, ds, wp, fb, rph, r, w, remain, tp, i, x, wr, nds, slope, nfb, fslope, frac) global(SWH_FIX) (
  in = pv[0]; out = pv[1]; dt = pv[3]; dc = pv[4];
  buf = st[0]; mask = st[1]; size = mask + 1; sr = st[2]; ds = st[3]; wp = st[4]; fb = st[6];
  wp === 0 ? (
    st[5] = dt; st[7] = dc;
    st[3] = ds = swh_f_clamp(dt * sr, 1, size);
    st[6] = fb = allpass_l_fb(dt, dc);
  );
  dt === st[5] && dc === st[7] ? (
    frac = ds - floor(ds);
    i = 0;
    loop(n,
      rph = wp - floor(ds);
      x = buf[rph & mask] + (frac * (buf[(rph - 1) & mask] - buf[rph & mask]));
      wr = (x * fb) + in[i];
      buf[wp & mask] = wr;
      out[i] = x - (fb * wr);
      wp += SWH_FIX ? 1 : 2;
      i += 1;
    );
  ) : (
    nds = swh_f_clamp(dt * sr, 1, size);
    slope = (nds - ds) / n;
    nfb = allpass_l_fb(dt, dc);
    fslope = (nfb - fb) / n;
    i = 0;
    loop(n,
      ds += slope;
      wp += 1;
      rph = wp - floor(ds);
      frac = ds - floor(ds);
      x = buf[rph & mask] + (frac * (buf[(rph - 1) & mask] - buf[rph & mask]));
      wr = (x * fb) + in[i];
      buf[wp & mask] = wr;
      out[i] = x - (fb * wr);
      fb += fslope;
      i += 1;
    );
    st[5] = dt; st[7] = dc; st[6] = fb; st[3] = ds;
  );
  st[4] = wp;
);

function allpass_n_fb(dt, dc) (
  dt === 0 ? 0 : dc > 0 ? exp((-6.9077552789 * dt) / dc) : dc < 0 ? -exp((-6.9077552789 * dt) / (-dc)) : 0;
);

function allpass_n_inst(st) local(sr, size) global(swh_sr) (
  sr = floor(swh_sr);
  size = 1; while (size < (sr * 10)) ( size *= 2; );
  st[0] = swh_alloc(size); st[1] = size - 1; st[2] = sr; st[3] = 0; st[4] = 0; st[5] = 0; st[6] = 0; st[7] = 0;
);

function allpass_n_run(st, pv, n) local(in, out, dt, dc, buf, mask, size, sr, ds, wp, fb, rph, r, w, remain, tp, i, x, wr, nds, slope, nfb, fslope, frac, o) global(SWH_FIX) (
  in = pv[0]; out = pv[1]; dt = pv[3]; dc = pv[4];
  buf = st[0]; mask = st[1]; size = mask + 1; sr = st[2]; ds = st[3]; wp = st[4]; fb = st[6];
  wp === 0 ? (
    st[5] = dt; st[7] = dc;
    st[3] = ds = swh_f_clamp(dt * sr, 1, size);
    st[6] = fb = allpass_n_fb(dt, dc);
  );
  dt === st[5] ? (
    rph = wp - floor(ds);
    r = rph & mask; w = wp & mask;
    dc === st[7] ? (
      remain = n; o = 0;
      while (remain > 0) (
        tp = min(min(size - r, remain), size - w);
        remain -= tp;
        i = 0;
        loop(tp,
          x = buf[r + i];
          wr = (x * fb) + in[o + i];
          buf[w + i] = wr;
          out[o + i] = x - (fb * wr);
          i += 1;
        );
        r += tp; w += tp;
        SWH_FIX ? o += tp;
        r === size ? r = 0;
        w === size ? w = 0;
      );
    ) : (
      nfb = allpass_n_fb(dt, dc);
      fslope = (nfb - fb) / n;
      remain = n; o = 0;
      while (remain > 0) (
        tp = min(min(size - r, remain), size - w);
        remain -= tp;
        i = 0;
        loop(tp,
          x = buf[r + i];
          wr = (x * fb) + in[o + i];
          buf[w + i] = wr;
          out[o + i] = x - (fb * wr);
          fb += fslope;
          i += 1;
        );
        r += tp; w += tp;
        SWH_FIX ? o += tp;
        r === size ? r = 0;
        w === size ? w = 0;
      );
      st[7] = dc; st[6] = fb;
    );
    wp += n;
  ) : (
    nds = swh_f_clamp(dt * sr, 1, size);
    slope = (nds - ds) / n;
    nfb = allpass_n_fb(dt, dc);
    fslope = (nfb - fb) / n;
    i = 0;
    loop(n,
      ds += slope;
      wp += 1;
      rph = wp - floor(ds);
      x = buf[rph & mask];
      wr = (x * fb) + in[i];
      buf[wp & mask] = wr;
      out[i] = x - (fb * wr);
      fb += fslope;
      i += 1;
    );
    st[5] = dt; st[7] = dc; st[6] = fb; st[3] = ds;
  );
  st[4] = wp;
);

function amPitchshift_inst(st) (
  st[0] = swh_alloc(8192);
  st[1] = 0; st[2] = 0;
  st[3] = 0;
  st[4] = -1;
  st[5] = 255; st[6] = 128;
  st[7] = 0.5; st[8] = 0; st[9] = 0;
);

function amPitchshift_run(st, pv, n) local(pitch, size, input, output, delay, rin, rfr, wptr, mask, ofs, gain, gain_inc,
    count, om, size_tmp, pos, out, tmp, i, fr, tot) (
  pitch = pv[0]; size = pv[1]; input = pv[2]; output = pv[3];
  delay = st[0]; rfr = st[1]; rin = st[2]; wptr = st[3]; mask = st[5]; ofs = st[6]; gain = st[7]; gain_inc = st[8];
  count = st[9];
  om = swh_round(pitch * 65536);
  size !== st[4] ? (
    size_tmp = swh_round(size);
    size_tmp > 7 ? size_tmp = 5 : size_tmp < 1 ? size_tmp = 1;
    st[4] = size < 0 ? ceil(size) : floor(size);
    mask = (2 ^ (size_tmp + 6)) - 1;
    ofs = 2 ^ (size_tmp + 5);
  );
  pos = 0;
  loop(n,
    out = 0;
    count > 14 ? (
      count = 0;
      tmp = (0.5 * (((rin - wptr) + (ofs / 2)) & mask)) / ofs;
      tmp = (sin((3.141592653589793 * 2) * tmp) * 0.5) + 0.5;
      gain_inc = (tmp - gain) / 15;
    ) : count += 1;
    gain += gain_inc;
    delay[wptr] = input[pos];
    i = rin;
    fr = rfr * 0.0000152587;
    out += swh_cube(fr, delay[(i - 1) & mask], delay[i], delay[(i + 1) & mask], delay[(i + 2) & mask]) * (1 - gain);
    i += ofs;
    out += swh_cube(fr, delay[(i - 1) & mask], delay[i & mask], delay[(i + 1) & mask], delay[(i + 2) & mask]) * gain;
    output[pos] = out;
    wptr = (wptr + 1) & mask;
    tot = rfr + om;
    rin += floor(tot / 65536);
    rfr = tot - (65536 * floor(tot / 65536));
    rin = rin & mask;
    pos += 1;
  );
  st[1] = rfr; st[2] = rin; st[3] = wptr; st[5] = mask; st[6] = ofs; st[7] = gain; st[9] = count; st[8] = gain_inc;
  pv[4] = floor(ofs / 2);
);

function amp_inst(st) ( 0; );

function amp_run(st, pv, n) local(input, output, coef, pos) (
  input = pv[1]; output = pv[2];
  coef = swh_db_co(pv[0]);
  pos = 0;
  loop(n, output[pos] = input[pos] * coef; pos += 1;);
);

function analogueOsc_inst(st) global(swh_sr) (
  st[0] = blo_h_tables_new(512);
  st[1] = blo_h_new(st[0], 512, 0, swh_sr);
  st[2] = swh_sr;
  st[3] = 0; st[4] = 0; st[5] = 0;
  st[6] = 43437; st[7] = 111145;
);

function analogueOsc_run(st, pv, n) local(wave, freq, warm, instab, output, osc, fs, itm1, otm1, otm2, rnda, rndb, q,
    leak, max_jump, w, pos, x, y, k) (
  wave = pv[0]; freq = pv[1]; warm = pv[2]; instab = pv[3]; output = pv[4];
  osc = st[1]; fs = st[2]; itm1 = st[3]; otm1 = st[4]; otm2 = st[5]; rnda = st[6]; rndb = st[7];
  q = warm - 0.999;
  leak = 1 - (warm * 0.02);
  max_jump = blo_iround(instab * 30000);
  max_jump < 0 ? max_jump += 4294967296;
  max_jump = max_jump + 1;
  max_jump >= 4294967296 ? max_jump -= 4294967296;
  w = blo_iround(wave) - 1;
  osc[1] = w < 0 ? 0 : (w > 3 ? 3 : w);
  osc[11] = fs * (0.47 - (swh_f_clamp(warm, 0, 1) * 0.41));
  blo_hd_set_freq(osc, freq);
  pos = 0;
  loop(n,
    x = blo_hd_run_cub(osc);
    rnda += 432577; rnda -= 4294967296 * floor(rnda / 4294967296);
    rnda *= 47; rnda -= 4294967296 * floor(rnda / 4294967296);
    rndb += 7643113; rndb -= 4294967296 * floor(rndb / 4294967296);
    rnda *= 59; rnda -= 4294967296 * floor(rnda / 4294967296);
    k = rnda + rndb; k -= 4294967296 * floor(k / 4294967296);
    k = floor(k / 2);
    osc[2] = ((osc[2] + (k - (max_jump * floor(k / max_jump)))) - floor(max_jump / 2)) & osc[5];
    y = ((x - q) / (1 - swh_exp(-1.2 * (x - q)))) + (q / (1 - swh_exp(1.2 * q)));
    abs(y) > 1 ? y = 0.83333 + (q / (1 - swh_exp(1.2 * q)));
    otm2 = otm1;
    otm1 = ((leak * otm1) + y) - itm1;
    itm1 = y;
    output[pos] = (otm1 + otm2) * 0.5;
    pos += 1;
  );
  st[3] = itm1; st[4] = otm1; st[5] = otm2; st[6] = rnda; st[7] = rndb;
);

function autoPhaser_inst(st) global(swh_sr) (
  st[0] = swh_alloc(12);
  st[1] = 0;
  st[2] = 0; st[3] = 0; st[4] = 0;
  st[5] = swh_sr;
);

function autoPhaser_run(st, pv, n) local(attack, decay, depth, fb, spread, input, output, ap, ym1, ga, gr, env, sr,
    d, ofs, pos, in, x, y, a0, a1, a2, a3, a4, a5, z0, z1, z2, z3, z4, z5) (
  attack = pv[0]; decay = pv[1]; depth = pv[2] * 0.5; fb = pv[3]; spread = pv[4]; input = pv[5]; output = pv[6];
  ap = st[0]; ym1 = st[1]; env = st[4]; sr = st[5];
  a0 = ap[0]; a1 = ap[1]; a2 = ap[2]; a3 = ap[3]; a4 = ap[4]; a5 = ap[5];
  z0 = ap[6]; z1 = ap[7]; z2 = ap[8]; z3 = ap[9]; z4 = ap[10]; z5 = ap[11];
  attack < 0.01 ? attack = 0.01;
  decay < 0.01 ? decay = 0.01;
  ga = swh_exp(-1 / ((attack * sr) * 0.25));
  gr = swh_exp(-1 / ((decay * sr) * 0.25));
  pos = 0;
  loop(n,
    in = input[pos];
    (pos & 3) === 0 ? (
      x = abs(in);
      env < x ? env = (ga * (env - x)) + x : env = (gr * (env - x)) + x;
      d = env * depth;
      a0 = (1 - d) / (1 + d);
      ofs = spread * 0.01562;
      a1 = (1 - (d + ofs)) / (1 + (d + ofs));
      ofs *= 2;
      a2 = (1 - (d + ofs)) / (1 + (d + ofs));
      ofs *= 2;
      a3 = (1 - (d + ofs)) / (1 + (d + ofs));
      ofs *= 2;
      a4 = (1 - (d + ofs)) / (1 + (d + ofs));
      ofs *= 2;
      a5 = (1 - (d + ofs)) / (1 + (d + ofs));
    );
    x = in + (ym1 * fb);
    y = (x * (-a0)) + z0; z0 = (y * a0) + x; x = y;
    y = (x * (-a1)) + z1; z1 = (y * a1) + x; x = y;
    y = (x * (-a2)) + z2; z2 = (y * a2) + x; x = y;
    y = (x * (-a3)) + z3; z3 = (y * a3) + x; x = y;
    y = (x * (-a4)) + z4; z4 = (y * a4) + x; x = y;
    y = (x * (-a5)) + z5; z5 = (y * a5) + x;
    output[pos] = y;
    ym1 = y;
    pos += 1;
  );
  ap[0] = a0; ap[1] = a1; ap[2] = a2; ap[3] = a3; ap[4] = a4; ap[5] = a5;
  ap[6] = z0; ap[7] = z1; ap[8] = z2; ap[9] = z3; ap[10] = z4; ap[11] = z5;
