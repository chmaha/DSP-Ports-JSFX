  bodeShifterCV_inst(RK_PST); memset(RK_PST, 0, 4096);
  hilbert_inst(RK_PST); memset(RK_PST, 0, 4096);
  surroundEncoder_inst(RK_PST); memset(RK_PST, 0, 4096);
  ringmod_1i1o1l_inst(RK_PST); memset(RK_PST, 0, 4096);
  analogueOsc_inst(RK_PST); memset(RK_PST, 0, 4096);
  fmOsc_inst(RK_PST); memset(RK_PST, 0, 4096);
);
RK_NT = 106; RK_MDS = 100;
RK_BLK = 128;
RK_MD = 1000;
RK_PST = 20000;
RK_OB = 30000;
RK_IB = 36000;
RK_ZB = 41000;
RK_OUT = 42000;
RK_PV = 43000;
RK_SRC = 45000;
RK_ORD = 46600;
RK_CT = 46700;
RK_ST = 46720;
RK_LAT = 46740;
RK_CAB = 46760;
RK_BYP = 46800;
RK_NOW = 46820;
RK_PL = 46900;
RK_PK = 46950;
RK_GBASE = 65536;
RK_GEND = 1600000;
RK_ARENA = 2200000;
RK_SL0 = 65;
RK_CB0 = 17;
RK_NCAB = 32;

function rk_obuf(n, p) ( RK_OB + ((n * 4) + p) * 128; );
function rk_pvec(s) ( RK_PV + s * 64; );
function rk_mdp(t) ( RK_MD + t * RK_MDS; );
function rk_srcl(s, k) ( RK_SRC + ((s * 4) + k) * 33; );
function rk_base(s) ( RK_GEND + (s - 1) * RK_ARENA; );

function rk_map(t, k, u) local(m, lo, hi, f, v) (
  m = rk_mdp(t) + 15 + k * 5;
  lo = m[1]; hi = m[2]; f = m[4];
  (f & 8) ? ( lo *= srate; hi *= srate; );
  u = max(0, min(1, u));
  (f & 4) ? v = (u >= 0.5) :
  (f & 1) ? v = lo * (hi / lo) ^ u :
  v = lo + (u * (hi - lo));
  (f & 2) ? v = floor(v + 0.5);
  v;
);

function rk_unmap(t, k, v) local(m, lo, hi, f) (
  m = rk_mdp(t) + 15 + k * 5;
  lo = m[1]; hi = m[2]; f = m[4];
  (f & 8) ? ( lo *= srate; hi *= srate; );
  (f & 4) ? (v >= 0.5) :
  (f & 1) ? max(0, min(1, log(v / lo) / log(hi / lo))) :
  hi > lo ? max(0, min(1, (v - lo) / (hi - lo))) : 0;
