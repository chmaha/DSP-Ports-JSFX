function tapeDelay_run(st, pv, n) local(buf, size, mask, phase, last_phase, l1, l2, l3, sr, pos, inc, lin_int, lin_inc,
    track, fph, out, da, t1a, t2a, t3a, t4a, t1s, t2s, t3s, t4s, input, output, x) (
  input = pv[10]; output = pv[11];
  buf = st[0]; size = st[1]; mask = st[2]; phase = st[3]; last_phase = st[4]; l1 = st[5]; l2 = st[6]; l3 = st[7];
  sr = st[8];
