function gsm_decode(g, f, s) local(j, k, drp, erp, wt, xMp, Nr, brp, drpp) (
  gsm_bits(g, f, 1);
  drp = g + 120; erp = g + 920; wt = g + 760; xMp = g + 747;
  j = 0;
  loop(4,
    gsm_exp_mant(g, g[580 + j]);
    gsm_apcm_inv(g + 584 + (13 * j), g[1091], g[1090], xMp);
    gsm_grid_pos(g[576 + j], xMp, erp);
    Nr = g[568 + j] < 40 || g[568 + j] > 120 ? g[308] : g[568 + j];
    g[308] = Nr;
    brp = g[572 + j]; brp = brp === 0 ? 3277 : brp === 1 ? 11469 : brp === 2 ? 21299 : 32767;
    k = 0;
    loop(40,
      drpp = gsm_w16(gsm_mr(brp, drp[k - Nr]));
      drp[k] = gsm_sat(erp[k] + drpp);
      k += 1;
    );
    memcpy(drp - 120, drp - 80, 120);
    k = 0; loop(40, wt[(j * 40) + k] = drp[k]; k += 1;);
    j += 1;
  );
  gsm_st_synthesis(g, g + 560, wt, s);
  k = 0;
  loop(160,
    drpp = gsm_w16(gsm_mr(g[318], 28180));
    g[318] = gsm_sat(s[k] + drpp);
    s[k] = gsm_w16(gsm_sat(g[318] + g[318]) & 65528);
    k += 1;
  );
);

function pitchscale_falloc(n) local(o) global(swh_mp) (
  o = swh_mp - (floor(swh_mp / 65536) * 65536);
  o + n > 65536 ? swh_mp += 65536 - o;
  swh_alloc(n);
);

function pitchscale_new(fl) local(b) (
  b = swh_alloc(16);
  b[0] = swh_alloc(fl);
  b[1] = swh_alloc(fl);
  b[2] = swh_alloc(fl);
  b[3] = swh_alloc(fl);
  b[4] = swh_alloc(2 * fl);
  b[5] = swh_alloc(fl);
  b[6] = swh_alloc(fl);
  b[7] = swh_alloc(fl);
  b[8] = swh_alloc(fl);
  b[9] = swh_alloc(fl);
  b[10] = 0;
  b[11] = swh_alloc(8192);
  b[13] = swh_alloc(8192);
  b[14] = swh_alloc(4096);
  b[12] = pitchscale_falloc(fl);
  b;
);

function pitchscale_trunc(x) ( x < 0 ? ceil(x) : floor(x); );

function pitchscale_run(b, pitchScale, fl, osamp, nsamps, sampleRate, indata, outdata, adding, gain)
    local(gInFIFO, gOutFIFO, gLastPhase, gSumPhase, gOutputAccum, gAnaFreq, gAnaMagn, gSynFreq, gSynMagn, gWindow, gRover,
    ps_in, ps_out, f, phaseArr, magn, phase, tmp, freqPerBin, expct, i, k, j, qpd, index, inFifoLatency, stepSize,
    fs2, r0, r1) (
  gInFIFO = b[0]; gOutFIFO = b[1]; gLastPhase = b[2]; gSumPhase = b[3]; gOutputAccum = b[4]; gAnaFreq = b[5];
  gAnaMagn = b[6]; gSynFreq = b[7]; gSynMagn = b[8]; gWindow = b[9]; gRover = b[10];
  ps_in = b[11]; f = b[12]; ps_out = b[13]; phaseArr = b[14];
  fs2 = (fl / 2) | 0;
  stepSize = (fl / osamp) | 0;
  freqPerBin = (sampleRate * 2) / fl;
  expct = ((2 * $pi) * stepSize) / fl;
  inFifoLatency = fl - stepSize;
  gRover === 0 ? gRover = inFifoLatency;
  i = 0;
  loop(nsamps,
    gInFIFO[gRover] = indata[i];
    adding ? outdata[i] += gOutFIFO[gRover - inFifoLatency] * gain : outdata[i] = gOutFIFO[gRover - inFifoLatency];
    gRover += 1;
    gRover >= fl ? (
      gRover = inFifoLatency;
      k = 0; loop(fl, ps_in[k] = gInFIFO[k] * gWindow[k]; k += 1;);
      memcpy(f, ps_in, fl);
      fft_real(f, fl);
      fft_permute(f, fs2);
      ps_out[0] = 0.5 * f[0];
      ps_out[fs2] = 0.5 * f[1];
      k = 1; loop(fs2 - 1, ps_out[k] = 0.5 * f[2 * k]; ps_out[fl - k] = 0.5 * f[(2 * k) + 1]; k += 1;);
      k = 1;
      while (k <= fs2) (
        j = 0; loop(SWH_FIX ? 8 : 4,
          r0 = ps_out[k + j]; r1 = ps_out[fl - (k + j)];
          gAnaMagn[k + j] = sqrt((r0 * r0) + (r1 * r1));
          j += 1;
        );
        j = 0; loop(8,
          phaseArr[k + j] = atan2(ps_out[fl - (k + j)], ps_out[k + j]);
          j += 1;
        );
        k += 8;
      );
      k = 1;
      loop(fs2,
        tmp = phaseArr[k] - gLastPhase[k];
        gLastPhase[k] = phaseArr[k];
        tmp -= k * expct;
        qpd = pitchscale_trunc(tmp / $pi);
        qpd >= 0 ? qpd += qpd & 1 : qpd -= qpd & 1;
        tmp -= $pi * qpd;
        tmp = (osamp * tmp) / (2 * $pi);
        tmp = (k * freqPerBin) + (tmp * freqPerBin);
        gAnaFreq[k] = tmp;
        k += 1;
      );
      memset(gSynMagn, 0, fl);
      memset(gSynFreq, 0, fl);
      k = 0;
      loop(fs2 + 1,
        index = pitchscale_trunc(k / pitchScale);
        index <= fs2 ? (
          gAnaMagn[index] > gSynMagn[k] ? (
            gSynMagn[k] = gAnaMagn[index];
            gSynFreq[k] = gAnaFreq[index] * pitchScale;
          );
          gSynFreq[k] === 0 && k > 0 ? (
            gSynFreq[k] = gSynFreq[k - 1];
            gSynMagn[k] = gSynMagn[k - 1];
          );
        );
        k += 1;
      );
      k = 1;
      loop(fs2,
        magn = gSynMagn[k];
        tmp = gSynFreq[k];
        tmp -= k * freqPerBin;
        tmp /= freqPerBin;
        tmp = ((2 * $pi) * tmp) / osamp;
        tmp += k * expct;
        gSumPhase[k] += tmp;
        phase = gSumPhase[k];
        ps_in[k] = magn * cos(phase);
        ps_in[fl - k] = magn * sin(phase);
        k += 1;
      );
      f[0] = ps_in[0];
      f[1] = ps_in[fs2];
      k = 1; loop(fs2 - 1, f[2 * k] = ps_in[k]; f[(2 * k) + 1] = ps_in[fl - k]; k += 1;);
      fft_ipermute(f, fs2);
      ifft_real(f, fl);
      memcpy(ps_out, f, fl);
      k = 0; loop(fl, gOutputAccum[k] += ((2 * gWindow[k]) * ps_out[k]) / (fs2 * osamp); k += 1;);
      k = 0; loop(stepSize, gOutFIFO[k] = gOutputAccum[k]; k += 1;);
      memcpy(gOutputAccum, gOutputAccum + stepSize, fl);
      k = 0; loop(inFifoLatency, gInFIFO[k] = gInFIFO[k + stepSize]; k += 1;);
    );
    i += 1;
  );
  b[10] = gRover;
);

