function fourByFourPole_run(st, pv, n) local(fb0, fb1, fb2, fb3, input, output, z, y0, y1, y2, y3, r, d, a0, a1, a2,
    a3, pos, x, y, z0, z1, z2, z3, z4, z5, z6, z7, z8, z9, z10, z11, z12, z13, z14, z15) (
