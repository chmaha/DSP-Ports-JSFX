  rms_peak = pv[0]; attack = pv[1]; release = pv[2]; threshold = pv[3]; ratio = pv[4]; knee = pv[5]; attenuation = pv[6];
  li = pv[9]; ri = pv[10]; lo = pv[11]; ro = pv[12];
  rms = st[0]; as = st[1]; sum = st[2]; amp = st[3]; gain = st[4]; gain_t = st[5]; env = st[6]; env_rms = st[7];
  env_peak = st[8]; count = st[9];
