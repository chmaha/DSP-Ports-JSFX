function svf_run(st, pv, n) local(in, out, ftype, freq, q, res, sv, f, qq, qnrm, h, b, l, p, nn, op, x, o, pos) (
  in = pv[0]; out = pv[1]; ftype = pv[2]; freq = pv[3]; q = pv[4]; res = pv[5];
  sv = st[1];
