function transient_mod(v, bs) ( v < 0 ? v + bs : v >= bs ? v - bs : v; );

function transient_run(st, pv, n) local(attack, sustain, input, output, buffer, fast_buffer_sum, medi_buffer_sum,
    slow_buffer_sum, buffer_pos, fast_track, medi_track, slow_track, count, sample_rate, fast_sum_size,
    medi_sum_size, slow_sum_size, fast_track_lag, medi_track_lag, slow_track_lag, ratio, in, pos, bs) (
  attack = pv[0]; sustain = pv[1]; input = pv[2]; output = pv[3];
  buffer = st[0]; fast_buffer_sum = st[1]; medi_buffer_sum = st[2]; slow_buffer_sum = st[3]; buffer_pos = st[4];
  fast_track = st[5]; medi_track = st[6]; slow_track = st[7]; count = st[8]; sample_rate = st[9]; bs = st[10];
  fast_sum_size = floor((2 * sample_rate) / 1000);
  medi_sum_size = floor((25 * sample_rate) / 1000);
  slow_sum_size = floor((100 * sample_rate) / 1000);
  fast_track_lag = 1.5 / fast_sum_size;
  medi_track_lag = 1 / medi_sum_size;
  slow_track_lag = 1.3 / slow_sum_size;
  pos = 0;
  loop(n,
    in = input[pos];
    buffer[buffer_pos] = abs(in);
