      a3 = (1 - (d + ofs)) / (1 + (d + ofs));
      ofs *= 2;
      a4 = (1 - (d + ofs)) / (1 + (d + ofs));
      ofs *= 2;
      a5 = (1 - (d + ofs)) / (1 + (d + ofs));
