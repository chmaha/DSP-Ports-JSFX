function lfoPhaser_run(st, pv, n) local(lfo_rate, lfo_depth, fb, spread, input, output, ap, ym1, tbl, lfo_pos,
    f_per_lv, count, mod, d, ofs, pos, x, y, a0, a1, a2, a3, a4, a5, z0, z1, z2, z3, z4, z5) (
  lfo_rate = pv[0]; lfo_depth = pv[1]; fb = pv[2]; spread = pv[3]; input = pv[4]; output = pv[5];
  ap = st[0]; ym1 = st[1]; tbl = st[2]; lfo_pos = st[3]; f_per_lv = st[4]; count = st[5];
  a0 = ap[0]; a1 = ap[1]; a2 = ap[2]; a3 = ap[3]; a4 = ap[4]; a5 = ap[5];
  z0 = ap[6]; z1 = ap[7]; z2 = ap[8]; z3 = ap[9]; z4 = ap[10]; z5 = ap[11];
