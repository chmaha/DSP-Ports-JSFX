    medi_buffer_sum += buffer[buffer_pos];
    slow_buffer_sum += buffer[buffer_pos];
    fast_buffer_sum -= buffer[transient_mod(buffer_pos - fast_sum_size, bs)];
    medi_buffer_sum -= buffer[transient_mod(buffer_pos - medi_sum_size, bs)];
    slow_buffer_sum -= buffer[transient_mod(buffer_pos - slow_sum_size, bs)];
    count > slow_sum_size ? (
      fast_track += ((fast_buffer_sum / fast_sum_size) - fast_track) * fast_track_lag;
      medi_track += ((medi_buffer_sum / medi_sum_size) - medi_track) * medi_track_lag;
      slow_track += ((slow_buffer_sum / slow_sum_size) - slow_track) * slow_track_lag;
    );
    count += 1;
    ratio = (fast_track + 0.02) / (medi_track + 0.02);
    ratio * attack > 1 ? in *= ratio * attack : ratio * attack < -1 ? in /= ratio * (-attack);
    ratio = (slow_track + 0.00001) / (medi_track + 0.00001);
    ratio * sustain > 1 ? in *= ratio * sustain : ratio * sustain < -1 ? in /= ratio * (-sustain);
    output[pos] = in;
    buffer_pos = (buffer_pos + 1) % bs;
    pos += 1;
  );
  st[1] = fast_buffer_sum; st[2] = medi_buffer_sum; st[3] = slow_buffer_sum; st[4] = buffer_pos;
  st[5] = fast_track; st[6] = medi_track; st[7] = slow_track; st[8] = count;
);

