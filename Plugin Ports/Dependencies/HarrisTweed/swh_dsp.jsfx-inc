function sifter_qsort(a, l0, r0, stk) local(sp, l, r, left, right, pivot) (
  stk[0] = l0; stk[1] = r0; sp = 2;
  while (sp > 0) (
    sp -= 2; l = stk[sp]; r = stk[sp + 1];
    left = l; right = r;
    pivot = a[left];
    while (left < right) (
      while (a[right] >= pivot && left < right) ( right -= 1; );
      left !== right ? ( a[left] = a[right]; left += 1; );
      while (a[left] <= pivot && left < right) ( left += 1; );
      left !== right ? ( a[right] = a[left]; right -= 1; );
    );
    a[left] = pivot;
    l < left ? ( stk[sp] = l; stk[sp + 1] = left - 1; sp += 2; );
    r > left ? ( stk[sp] = left + 1; stk[sp + 1] = r; sp += 2; );
  );
);

function sifter_inst(st) local(rc, i, scla, sclb) (
  st[2] = swh_alloc(1001); st[3] = swh_alloc(1001); st[4] = swh_alloc(1000);
