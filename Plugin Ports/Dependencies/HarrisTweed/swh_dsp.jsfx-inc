function alaw_inst(st) ( 0; );

function alaw_run(st, pv, n) local(input, output, ainv, aloginv, aexp, pos, s, sabs) (
  input = pv[0]; output = pv[1];
  ainv = 0.011402508551881;
  aloginv = 0.182684374819744;
  aexp = 16.021419671691538;
  pos = 0;
  loop(n,
    s = input[pos];
    sabs = abs(s);
    sabs < ainv ? s *= aexp : s >= 0 ? s = 1 + (log(sabs) * aloginv) : s = -1 - (log(sabs) * aloginv);
    output[pos] = s;
    pos += 1;
  );
);

function alias_inst(st) ( 0; );

function alias_run(st, pv, n) local(level, input, output, coef, pos) (
  level = pv[0]; input = pv[1]; output = pv[2];
  coef = 1 - (2 * level);
  output !== input ? (
    pos = 0;
    while (pos < n) ( output[pos] = input[pos]; pos += 2; );
  );
  pos = 1;
  while (pos < n) ( output[pos] = input[pos] * coef; pos += 2; );
);

function allpass_c_fb(dt, dc) (
  dt === 0 ? 0 : dc > 0 ? exp((-6.9077552789 * dt) / dc) : dc < 0 ? -exp((-6.9077552789 * dt) / (-dc)) : 0;
);

function allpass_c_inst(st) local(sr, size) global(swh_sr) (
  sr = floor(swh_sr);
  size = 1; while (size < (sr * 10)) ( size *= 2; );
  st[0] = swh_alloc(size); st[1] = size - 1; st[2] = sr; st[3] = 0; st[4] = 0; st[5] = 0; st[6] = 0; st[7] = 0;
);

function allpass_c_run(st, pv, n) local(in, out, dt, dc, buf, mask, size, sr, ds, wp, fb, rph, r, w, remain, tp, i, x, wr, nds, slope, nfb, fslope, frac) (
  in = pv[0]; out = pv[1]; dt = pv[3]; dc = pv[4];
  buf = st[0]; mask = st[1]; size = mask + 1; sr = st[2]; ds = st[3]; wp = st[4]; fb = st[6];
  wp === 0 ? (
    st[5] = dt; st[7] = dc;
    st[3] = ds = swh_f_clamp(dt * sr, 1, size);
    st[6] = fb = allpass_c_fb(dt, dc);
  );
  dt === st[5] && dc === st[7] ? (
    frac = ds - floor(ds);
    i = 0;
    loop(n,
      rph = wp - floor(ds);
      x = swh_cube(frac, buf[(rph - 1) & mask], buf[rph & mask], buf[(rph + 1) & mask], buf[(rph + 2) & mask]);
      wr = (x * fb) + in[i];
      buf[wp & mask] = wr;
      out[i] = x - (fb * wr);
      wp += 1;
      i += 1;
    );
