function lookaheadLimiterConst_run(st, pv, n) local(limit, delay_s, in1, in2, out1, out2, buffer, amp_buffer, len, msk,
    bp, fs, atten, peak, peak_dist, last_delay, max, delay, delay_delta, pos, a, b, r, sig, rel, gain) global(SWH_FIX) (
  limit = pv[0]; delay_s = pv[1]; in1 = pv[3]; in2 = pv[4]; out1 = pv[5]; out2 = pv[6];
  buffer = st[0]; amp_buffer = st[1]; len = st[2]; msk = st[3]; bp = st[4]; fs = st[5]; atten = st[6]; peak = st[7];
  peak_dist = st[8]; last_delay = st[9];
  max = swh_db_co(limit);
  delay = last_delay;
  delay < 0 ? (
    delay = delay_s * fs;
    delay_delta = 0;
  ) : delay_delta = ((delay_s * fs) - last_delay) / (n - 1);
  pos = 0;
  loop(n,
    delay += delay_delta;
    buffer[(bp * 2) & msk] = in1[pos];
    buffer[((bp * 2) + 1) & msk] = in2[pos];
    r = swh_round(delay);
    a = abs(buffer[((bp + r) * 2) & msk]);
    b = abs(buffer[(((bp + r) * 2) + 1) & msk]);
    sig = a > b ? a : b;
    sig > max ? (
      rel = swh_lin2db(sig) - limit;
      peak_dist !== 0 && (rel / delay) > (peak / peak_dist) ? (
        peak_dist = floor(delay);
        peak = rel;
      );
    );
