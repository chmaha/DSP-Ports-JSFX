      sv = d[k];
      d[k] = (2 * d[k - 1]) - dd[k];
      dd[k] = sv;
      k -= 1;
    );
    sv = d[0];
    d[0] = (-dd[0]) + c[j];
    dd[0] = sv;
    j -= 1;
  );
  j = 10;
  while (j >= 1) ( d[j] = d[j - 1] - dd[j]; j -= 1; );
  d[0] = (-dd[0]) + (0.5 * c[0]);
