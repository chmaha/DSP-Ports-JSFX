    new_d_base, delay_depth, frac, step, pos, d_base, n_ph, p_ph, law, dp, dp_idx, dp_frac, out, v, half) global(SWH_FIX) (
  delay_base = pv[0]; detune = pv[1]; law_freq = pv[2]; feedback = pv[3]; input = pv[4]; output = pv[5];
  sample_rate = st[0]; count = st[1]; prev_law_peak = st[2]; next_law_peak = st[3]; prev_law_pos = st[4];
  next_law_pos = st[5]; tbl = st[6]; delay_pos = st[7]; size = st[8]; old_d_base = st[9];
  mask = size - 1;
