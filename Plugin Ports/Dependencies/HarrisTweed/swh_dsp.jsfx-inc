function rk_setup() local(s) (
  memset(RK_OB, 0, 41000 + 128 - RK_OB);
  memset(RK_OUT, 0, 256);
  swh_mp = RK_GBASE;
  swh_sr = srate;
  rk_prime();
  RK_GUSED = swh_mp - RK_GBASE;
  s = 1; loop(8, RK_CT[s] = -1; s += 1;);
  RK_GV = -1;
