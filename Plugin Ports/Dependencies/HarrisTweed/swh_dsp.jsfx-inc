    nds = swh_f_clamp(dt * sr, 1, size);
    slope = (nds - ds) / n;
    nfb = allpass_c_fb(dt, dc);
    fslope = (nfb - fb) / n;
    i = 0;
    loop(n,
      ds += slope;
      wp += 1;
      rph = wp - floor(ds);
      frac = ds - floor(ds);
      x = swh_cube(frac, buf[(rph - 1) & mask], buf[rph & mask], buf[(rph + 1) & mask], buf[(rph + 2) & mask]);
      wr = (x * fb) + in[i];
      buf[wp & mask] = wr;
      out[i] = x - (fb * wr);
      fb += fslope;
      i += 1;
    );
    st[5] = dt; st[7] = dc; st[6] = fb; st[3] = ds;
  );
  st[4] = wp;
);

function allpass_l_fb(dt, dc) (
  dt === 0 ? 0 : dc > 0 ? exp((-6.9077552789 * dt) / dc) : dc < 0 ? -exp((-6.9077552789 * dt) / (-dc)) : 0;
);

function allpass_l_inst(st) local(sr, size) global(swh_sr) (
  sr = floor(swh_sr);
  size = 1; while (size < (sr * 10)) ( size *= 2; );
  st[0] = swh_alloc(size); st[1] = size - 1; st[2] = sr; st[3] = 0; st[4] = 0; st[5] = 0; st[6] = 0; st[7] = 0;
