      out1[pos] < -max ? out1[pos] = -max : out1[pos] > max ? out1[pos] = max;
      out2[pos] < -max ? out2[pos] = -max : out2[pos] > max ? out2[pos] = max;
    );
    bp = (bp + 1) & (len - 1);
