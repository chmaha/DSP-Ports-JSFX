  hermesFilter_inst(MM_STR);
  mm_params();
  mm_setup(MM_STL, MM_PV); mmL.mm_load(MM_STL);
  mm_setup(MM_STR, MM_PV); mmR.mm_load(MM_STR);
);

function mm_block() (
