@init
// Real British fixture lists for 2026, 2027 (dates, courses, flat / jumps / all-weather, evening and floodlit markers),
// transcribed from the British Horseracing Authority published lists. Other years reuse them by weekday.
// Generated by notes/breakroom-dev/tools/racing/calendar/make_calendar.py; to add a year, rerun it with the new PDF appended.
// Entry value = course * 16 + kind * 4 + flag. kind: 0 turf flat, 1 all-weather, 2 jumps. flag: 0 none, 1 evening, 2 floodlit.
CAL_Y0 = 2026; CAL_NY = 2; CAL_S = 372;
ct_n = alloc(CAL_NY * CAL_S); ct_o = alloc(CAL_NY * CAL_S); ct_v = alloc(2936); ct_t = 0;
function cd(t, doy, s) local(p, n, v, ch, have)
(
  ct_o[t * CAL_S + doy] = ct_t; n = 0; v = 0; have = 0; p = 0;
  while (p <= strlen(s)) (
    ch = p < strlen(s) ? str_getchar(s, p) : 32;
    ch == 32 ? ( have ? ( ct_v[ct_t] = v; ct_t += 1; n += 1; ); v = 0; have = 0; ) : ( v = v * 10 + ch - 48; have = 1; );
    p += 1;
  );
  ct_n[t * CAL_S + doy] = n;
);
