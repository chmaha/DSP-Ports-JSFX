    hp_box(u + 0.12 * sc, v - 0.2 * sc, h - 0.2 * sc, 0.1 * sc, 0.34 * sc, 0.22 * sc, 1, 0.78, 0.15);
  );
);

function hp_playerdraw(hb) local(sq, hl, fd, f, e, g, eu, ev, ez, ang, ra)
(
  g_hp_ph = hb;
  sq = 1; hl = 0;
  fd = g_hp_fd;
  g_hp_dead == 3 ? (
    g_hp_dt < g_hp_t1 ? (
      f = g_hp_dt / g_hp_t1; e = f * f * (3 - 2 * f);
      hp_animal(g_hp_pu, g_hp_pv + 0.5, 0, fd, g_hp_ch, 1, 0);
      eu = g_hp_e0u + (g_hp_pu - g_hp_e0u) * e; ev = g_hp_e0v + (g_hp_pv + 0.5 - g_hp_e0v) * e; ez = g_hp_e0z + (hb + 1.5 - g_hp_e0z) * e;
      gfx_set(0.04, 0.07, 0.09, 0.15 + 0.35 * e);
      hp_q(hp_x(eu - 1.6, ev - 0.6), hp_y(eu - 1.6, ev - 0.6, hb), hp_x(eu + 1.6, ev - 0.6), hp_y(eu + 1.6, ev - 0.6, hb), hp_x(eu + 1.6, ev + 0.6), hp_y(eu + 1.6, ev + 0.6, hb), hp_x(eu - 1.6, ev + 0.6), hp_y(eu - 1.6, ev + 0.6, hb));
      hp_eagle(eu, ev, ez, g_t, g_hp_warn ? 1.4 + 0.3 * e : 1.7, g_hp_e0v > g_hp_pv + 0.5 ? -1 : 1, e > 0.7);
    ) : (
      g = g_hp_dt - g_hp_t1;
      eu = g_hp_pu + 7 * g * g; ev = g_hp_pv + 0.5 + 6 * g * g; hl = 1.6 * g + 16 * g * g;
      hp_animal(eu, ev, hl, floor(g_hp_dt * 18) & 3, g_hp_ch, 1.1, 0);
      hp_eagle(eu, ev, hb + hl + 1.5, g_hp_dt, 1.7, 1, 1);
    );
  ) : (
    g_hp_hop ? ( hl = 0.7 * sin($pi * g_hp_ht); sq = 1 + 0.12 * sin($pi * g_hp_ht) - (g_hp_ht < 0.15 ? 0.15 * (1 - g_hp_ht / 0.15) : 0); );
    g_hp_dead == 1 ? sq = max(0.08, 1 - g_hp_dt * 16);
    (g_hp_dead == 2 && g_hp_dt > 0.15) ? ( sq = max(0.01, 1 - (g_hp_dt - 0.15) * 3); hl = -0.25 * (g_hp_dt - 0.15) * 3; );
    g_hp_dead == 4 ? ( hl = 0.4 + 2.4 * sin(min(1, g_hp_dt * 2.2) * $pi); sq = 0.72; fd = floor(g_hp_dt * 14) & 3; );
    hp_animal(g_hp_pu, g_hp_pv + 0.5, hl, fd, g_hp_ch, sq, 0);
    (g_hp_dead == 0 && g_hp_st == 1 && g_hp_ef > 0.02) ? (
      f = g_hp_ef;
      hp_wpos(hb, f); eu = g_hp_ex; ev = g_hp_ey; ez = g_hp_ez;
      gfx_set(0.04, 0.07, 0.09, 0.2 + 0.2 * f);
      hp_q(hp_x(eu - 1.2, ev - 0.5), hp_y(eu - 1.2, ev - 0.5, hb), hp_x(eu + 1.2, ev - 0.5), hp_y(eu + 1.2, ev - 0.5, hb), hp_x(eu + 1.2, ev + 0.5), hp_y(eu + 1.2, ev + 0.5, hb), hp_x(eu - 1.2, ev + 0.5), hp_y(eu - 1.2, ev + 0.5, hb));
      hp_eagle(eu, ev, ez, g_t, 1.4 * min(1, f * 5), g_hp_edv, 0);
    );
  );
);

function hp_drawplayers(n, h) local(p)
(
  g_hp_bt ? (
    p = 0;
    loop(2,
      hp_cx[p * 48 + 3] == n ? ( hp_dswap(p); hp_playerdraw(h); hp_dswap(p); );
      p += 1;
    );
  ) : ( g_hp_pln == n ? hp_playerdraw(h); );
);

function hp_lane(n) local(r, t, v0, h, a0, a1, ua, ub, u, k, f, base, c, uo0, uo1, x0, tt, dd, vs, wt, gl, ga, gb, gc, ph, i)
(
  r = n & 1023; t = hp_lt[r]; v0 = n - HP_BASE; base = r * HP_NO;
  gl = (t == 0 || t == 4 || t == 6);
  h = t == 0 ? 0.3 : t == 4 ? 0.3 : t == 6 ? 0.2 : t == 1 ? 0.06 : t == 2 ? -0.2 : 0.12;
  vs = v0 - g_hp_cv; wt = hp_tv(19);
  a0 = g_hp_cu + (g_hp_xl - HP_OX - vs * HP_VX) / HP_UX; a1 = g_hp_cu + (g_hp_xr - HP_OX - vs * HP_VX) / HP_UX;
  ua = max(a0, g_hp_cu + (46 - HP_OY - vs * HP_VY) / HP_UY); ub = min(a1, g_hp_cu + (690 - HP_OY - vs * HP_VY) / HP_UY);
  uo0 = ua - 2; uo1 = min(a1, g_hp_cu + (870 - HP_OY - vs * HP_VY) / HP_UY) + 2;
  ua = floor(ua) - 1; ub = ceil(ub) + 1; uo0 = floor(uo0); uo1 = ceil(uo1);
  ub >= ua ? (
    t == 0 ? hp_c(hp_tv(0), hp_tv(1), hp_tv(2), 0.78) : t == 4 ? hp_c(0.6, 0.78, 0.92, 1) : t == 6 ? hp_c(0.25, 0.2, 0.28, 1) :
    t == 1 ? hp_c(hp_tv(6), hp_tv(7), hp_tv(8), 0.6) : t == 2 ? hp_c(hp_tv(9), hp_tv(10), hp_tv(11), 0.7) : hp_c(0.45, 0.4, 0.5, 0.7);
    hp_q(hp_x(ua, v0), hp_y(ua, v0, h), hp_x(ub, v0), hp_y(ub, v0, h), hp_x(ub, v0), hp_y(ub, v0, -1), hp_x(ua, v0), hp_y(ua, v0, -1));
    t == 0 ? (
      u = ua;
      loop(ub - ua + 1,
        ((u + n) & 1) ? hp_c(hp_tv(0), hp_tv(1), hp_tv(2), 1) : hp_c(hp_tv(3), hp_tv(4), hp_tv(5), 1);
        hp_q(hp_x(u, v0), hp_y(u, v0, h), hp_x(u + 1, v0), hp_y(u + 1, v0, h), hp_x(u + 1, v0 + 1), hp_y(u + 1, v0 + 1, h), hp_x(u, v0 + 1), hp_y(u, v0 + 1, h));
        u += 1;
      );
    );
    t == 4 ? (
      u = ua;
      loop(ub - ua + 1,
        ((u + n) & 1) ? hp_c(0.82, 0.93, 1, 1) : hp_c(0.76, 0.89, 0.98, 1);
        hp_q(hp_x(u, v0), hp_y(u, v0, h), hp_x(u + 1, v0), hp_y(u + 1, v0, h), hp_x(u + 1, v0 + 1), hp_y(u + 1, v0 + 1, h), hp_x(u, v0 + 1), hp_y(u, v0 + 1, h));
        hp_hash(u * 2.3 + n * 5.1) > 0.7 ? hp_flat(u + 0.2, v0 + 0.3, h, 0.6, 0.06, 1, 1, 1, 1);
        u += 1;
      );
    );
    t == 6 ? (
      hp_c(0.3, 0.24, 0.34, 1);
      hp_q(hp_x(ua, v0), hp_y(ua, v0, h), hp_x(ub, v0), hp_y(ub, v0, h), hp_x(ub, v0 + 1), hp_y(ub, v0 + 1, h), hp_x(ua, v0 + 1), hp_y(ua, v0 + 1, h));
      ph = hp_mod(g_t * hp_ls[r] * hp_ld[r] * 0.6, 1);
      u = ua - 1;
      loop(ub - ua + 3,
        hp_flat(u + ph, v0 + 0.1, h + 0.005, 0.28, 0.8, 1, 0.78, 0.25, 1);
        hp_flat(u + ph + 0.5, v0 + 0.1, h + 0.005, 0.12, 0.8, 0.9, 0.5, 0.6, 1);
        u += 1;
      );
    );
    t == 1 ? (
      hp_c(hp_tv(6), hp_tv(7), hp_tv(8), 1);
      hp_q(hp_x(ua, v0), hp_y(ua, v0, h), hp_x(ub, v0), hp_y(ub, v0, h), hp_x(ub, v0 + 1), hp_y(ub, v0 + 1, h), hp_x(ua, v0 + 1), hp_y(ua, v0 + 1, h));
      ((n - 1) & 1023) >= 0 && hp_lt[(n - 1) & 1023] == 1 && hp_ln[(n - 1) & 1023] == n - 1 ? (
        u = floor(ua / 2) * 2;
        loop(floor((ub - ua) / 2) + 2,
          hp_flat(u + 0.2, v0 - 0.03, h, 1.1, 0.07, 0.62, 0.65, 0.74, 1);
          u += 2;
        );
      );
    );
    t == 2 ? (
      u = ua;
      loop(ub - ua + 1,
        f = hp_hash(u * 3.1 + n * 7.7 + floor(g_t * 1.2) * 5.3);
        ((u + n) & 1) ? hp_c(hp_tv(9), hp_tv(10), hp_tv(11), 1) : hp_c(hp_tv(12), hp_tv(13), hp_tv(14), 1);
        hp_q(hp_x(u, v0), hp_y(u, v0, h), hp_x(u + 1, v0), hp_y(u + 1, v0, h), hp_x(u + 1, v0 + 1), hp_y(u + 1, v0 + 1, h), hp_x(u, v0 + 1), hp_y(u, v0 + 1, h));
        wt == 0 ? (
          f > 0.78 ? hp_flat(u + f * 0.4, v0 + 0.02, h, 0.5, 0.16, 1, 1, 1, 1);
          hp_hash(u * 1.7 + n * 3.3 + floor(g_t * 1.2) * 2.1) > 0.8 ? hp_flat(u + 0.2, v0 + 0.82, h, 0.5, 0.16, 1, 1, 1, 1);
        ) : wt == 1 ? (
          hp_em(1);
          hp_hash(u * 2.7 + n * 1.9 + floor(g_t * 2) * 3.3) > 0.72 ? hp_flat(u + f * 0.5, v0 + 0.2 + f * 0.4, h + 0.01, 0.3, 0.2, 1, 0.9, 0.3, 1);
          hp_em(0);
        ) : (
          hp_em(1);
          hp_hash(u * 2.7 + n * 1.9) > 0.6 ? hp_flat(u + f * 0.8, v0 + 0.1 + f * 0.7, h + 0.01, 0.08, 0.08, 1, 1, 1, 0.5 + 0.5 * sin(g_t * 3 + u * 2 + n));
          hp_em(0);
        );
        u += 1;
      );
    );
    t == 3 ? (
      hp_c(0.5, 0.45, 0.55, 1);
      hp_q(hp_x(ua, v0), hp_y(ua, v0, h), hp_x(ub, v0), hp_y(ub, v0, h), hp_x(ub, v0 + 1), hp_y(ub, v0 + 1, h), hp_x(ua, v0 + 1), hp_y(ua, v0 + 1, h));
      u = ua;
      loop(ub - ua + 1,
        hp_flat(u + 0.1, v0 + 0.08, h, 0.2, 0.84, 0.42, 0.26, 0.25, 1);
        hp_flat(u + 0.6, v0 + 0.08, h, 0.2, 0.84, 0.42, 0.26, 0.25, 1);
        u += 1;
      );
      hp_flat(ua, v0 + 0.22, h + 0.01, ub - ua, 0.08, 0.7, 0.72, 0.8, 1);
      hp_flat(ua, v0 + 0.7, h + 0.01, ub - ua, 0.08, 0.7, 0.72, 0.8, 1);
    );
    g_hp_ph = h;
    gl ? (
      u = uo0;
      loop(uo1 - uo0 + 1,
        dd = hp_dc[r * HP_DW + u + 40];
        (u + 40 >= 0 && u + 40 < HP_DW && dd > 0 && !(g_hp_pln == n && u > floor(g_hp_pu))) ? hp_deco(dd, u, v0, h);
        u += 1;
      );
    );
    t == 1 && hp_lv2[r] == 1 ? (
      hp_box(HP_LAMP, v0 + 0.1, h, 0.16, 0.16, 1.5, 0.25, 0.26, 0.3);
      hp_box(HP_LAMP - 0.12, v0 + 0.02, h + 1.5, 0.4, 0.32, 0.5, 0.18, 0.19, 0.22);
      hp_em(1);
      hp_flat(HP_LAMP - 0.04, v0 + 0.04, h + 2.0, 0.28, 0.24, hp_lf[r] < 0.5 ? 1 : 0.35, hp_lf[r] < 0.5 ? 0.2 : 0.28, 0.2, 1);
      hp_vq(HP_LAMP - 0.08, HP_LAMP + 0.28, v0 + 0.02, h + 1.62, h + 1.78, hp_lf[r] < 0.5 ? 1 : 0.35, hp_lf[r] < 0.5 ? 0.2 : 0.28, 0.2);
      hp_vq(HP_LAMP - 0.08, HP_LAMP + 0.28, v0 + 0.02, h + 1.82, h + 1.98, hp_lf[r] < 0.5 ? 0.25 : 0.4, hp_lf[r] < 0.5 ? 0.3 : 1, 0.3);
      hp_em(0);
    );
    t == 3 ? (
      f = hp_lw[r] > 0 && sin(g_t * 16) > 0;
      hp_box(HP_LAMP, v0 + 0.1, h, 0.18, 0.18, 1.3, 0.35, 0.3, 0.35);
      hp_box(HP_LAMP - 0.1, v0 + 0.05, h + 1.3, 0.38, 0.3, 0.3, 0.2, 0.19, 0.22);
      hp_em(hp_lw[r] > 0);
      hp_lw[r] > 0 ? ( f ? hp_box(HP_LAMP - 0.1, v0 + 0.05, h + 1.3, 0.38, 0.3, 0.3, 1, 0.2, 0.2) : hp_box(HP_LAMP - 0.1, v0 + 0.05, h + 1.3, 0.38, 0.3, 0.3, 0.5, 0.1, 0.1); ) : hp_box(HP_LAMP - 0.1, v0 + 0.05, h + 1.3, 0.38, 0.3, 0.3, 0.3, 0.07, 0.07);
      hp_em(0);
    );
    k = 0;
    loop(hp_on[r],
      x0 = hp_ou[base + k];
      (x0 > uo0 - 4 && x0 < uo1 + 4) ? (
        tt = hp_ok[base + k];
        tt == 0 || tt == 1 ? hp_car(x0, v0, hp_ol[base + k], tt, hp_oc[base + k], hp_ld[r], h) :
        tt == 2 ? ( hp_solid(r, k) ? ( (hp_lv2[r] == 2 && hp_mod(g_t * 0.7 + hp_oc[base + k] * 0.37, 4) > 2.7 && sin(g_t * 40) > 0) ? 0 : hp_log(x0, v0, hp_ol[base + k], h, k) ); ) :
        tt == 3 ? hp_train(x0, v0, hp_ol[base + k], hp_ld[r], h) :
        tt == 4 ? hp_tumble(x0, v0, h) :
        tt == 5 ? ( hp_oc[base + k] >= 0 ? hp_pad(x0, v0, h, hp_oc[base + k]); ) :
        hp_ghost(x0, v0, h, hp_oc[base + k]);
      );
      k += 1;
    );
    t != 3 ? (
      u = max(uo0, HP_PMIN - 2);
      loop(min(uo1, HP_PMAX + 2) - u + 1,
        hp_cn[r * HP_DW + u + 40] == 2 ? hp_token(u, v0, h) : hp_cn[r * HP_DW + u + 40] ? hp_coin(u, v0, h);
        u += 1;
      );
    );
    i = 0;
    loop(8,
      hp_mn[i] == n ? (
        hp_mt[i] > 0 ? (
          hp_em(1);
          hp_flat(hp_mu[i] + 0.05, v0 + 0.05, h + 0.02, 0.9, 0.9, 1, 0.25, 0.1, 0.4 + 0.4 * sin(g_t * 20));
          hp_flat(hp_mu[i] + 0.2, v0 + 0.2, h + 0.03, 0.6, 0.6, 1, 0.4, 0.1, 0.5);
          hp_em(0);
          hp_mt[i] < 0.4 ? ( hp_box(hp_mu[i] + 0.15, v0 + 0.15, h + hp_mt[i] * 14, 0.7, 0.7, 0.7, 0.3, 0.22, 0.2); hp_em(1); hp_flat(hp_mu[i] + 0.25, v0 + 0.25, h + hp_mt[i] * 14 + 0.7, 0.5, 0.5, 1, 0.5, 0.1, 1); hp_em(0); );
        ) : hp_mt[i] > -3 ? (
          hp_flat(hp_mu[i] + 0.0, v0 + 0.0, h + 0.015, 1, 1, 0.1, 0.07, 0.07, 1);
          hp_em(1); hp_flat(hp_mu[i] + 0.25, v0 + 0.25, h + 0.02, 0.5, 0.5, 1, 0.45, 0.1, max(0, 1 + hp_mt[i] / 3)); hp_em(0);
        );
      );
      i += 1;
    );
    hp_drawplayers(n, h);
    gl && g_hp_pln == n ? (
      u = floor(g_hp_pu) + 1;
