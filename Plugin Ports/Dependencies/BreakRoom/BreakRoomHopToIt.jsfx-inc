function hp_x(u, v) ( HP_OX + (u - g_hp_cu) * HP_UX + (v - g_hp_cv) * HP_VX; );
function hp_y(u, v, h) ( HP_OY + (u - g_hp_cu) * HP_UY + (v - g_hp_cv) * HP_VY - h * HP_HU; );
function hp_c(r, g, b, f) local(m) ( m = g_hp_em ? 1 : g_hp_br; g_hp_em ? gfx_set(min(1, r * f), min(1, g * f), min(1, b * f), 1) : gfx_set(min(1, r * f * m * g_hp_lr), min(1, g * f * m * g_hp_lg), min(1, b * f * m * g_hp_lb), 1); );
function hp_em(x) ( g_hp_em = x; );
function hp_q(ax, ay, bx, by, cx, cy, dx, dy) ( gfx_triangle(sx(ax), sy(ay), sx(bx), sy(by), sx(cx), sy(cy), sx(dx), sy(dy)); );

function hp_box(u0, v0, h0, du, dv, dh, r, g, b) local(u1, v1, h1)
(
  u1 = u0 + du; v1 = v0 + dv; h1 = h0 + dh;
  hp_c(r, g, b, 0.8);
  hp_q(hp_x(u0, v0), hp_y(u0, v0, h0), hp_x(u1, v0), hp_y(u1, v0, h0), hp_x(u1, v0), hp_y(u1, v0, h1), hp_x(u0, v0), hp_y(u0, v0, h1));
  hp_c(r, g, b, 0.62);
  hp_q(hp_x(u1, v0), hp_y(u1, v0, h0), hp_x(u1, v1), hp_y(u1, v1, h0), hp_x(u1, v1), hp_y(u1, v1, h1), hp_x(u1, v0), hp_y(u1, v0, h1));
  hp_c(r, g, b, 1);
  hp_q(hp_x(u0, v0), hp_y(u0, v0, h1), hp_x(u1, v0), hp_y(u1, v0, h1), hp_x(u1, v1), hp_y(u1, v1, h1), hp_x(u0, v1), hp_y(u0, v1, h1));
);

function hp_flat(u0, v0, h, du, dv, r, g, b, f) local(u1, v1)
(
  u1 = u0 + du; v1 = v0 + dv;
  hp_c(r, g, b, f);
  hp_q(hp_x(u0, v0), hp_y(u0, v0, h), hp_x(u1, v0), hp_y(u1, v0, h), hp_x(u1, v1), hp_y(u1, v1, h), hp_x(u0, v1), hp_y(u0, v1, h));
);

function hp_vq(u0, u1, v, z0, z1, r, g, b) ( hp_c(r, g, b, 1); hp_q(hp_x(u0, v), hp_y(u0, v, z0), hp_x(u1, v), hp_y(u1, v, z0), hp_x(u1, v), hp_y(u1, v, z1), hp_x(u0, v), hp_y(u0, v, z1)); );
function hp_uq(v0, v1, u, z0, z1, r, g, b) ( hp_c(r, g, b, 1); hp_q(hp_x(u, v0), hp_y(u, v0, z0), hp_x(u, v1), hp_y(u, v1, z0), hp_x(u, v1), hp_y(u, v1, z1), hp_x(u, v0), hp_y(u, v0, z1)); );

function hp_shadow(u0, v0, du, dv, h, hb, a) local(u1, v1, s)
(
  s = (h * 0.9 + 0.08) * g_hp_sl; u1 = u0 + du; v1 = v0 + dv;
  gfx_set(0.1 * g_hp_lr, 0.18 * g_hp_lg, 0.05 * g_hp_lb + 0.02, a);
  hp_q(hp_x(u0, v0), hp_y(u0, v0, hb), hp_x(u1 + s, v0 - s * 0.15), hp_y(u1 + s, v0 - s * 0.15, hb), hp_x(u1 + s, v1 - s * 0.15), hp_y(u1 + s, v1 - s * 0.15, hb), hp_x(u0, v1), hp_y(u0, v1, hb));
);

function hp_hash(a) local(x) ( x = sin(a * 12.9898) * 43758.5453; x - floor(x); );

function hp_lvthr(l) ( 30 + 20 * l; );
function hp_setsc(sc) ( HP_SC = sc; HP_UX = 64 * sc; HP_UY = 17 * sc; HP_VX = 28 * sc; HP_VY = -68 * sc; HP_HU = 60 * sc; );
function hp_sfx(k) local(i, f)
(
  g_sfxg = 0.3162 * (k == 0 ? 5.5 : k == 1 ? 14 : k == 2 ? 3 : (k == 3 || k == 4) ? 7 : k == 5 ? 3.5 : 14);
  k == 0 ? db_snd(17, 800 * (0.97 + rand(1) * 0.06), 0.1, 0, 0) :
  k == 1 ? ( db_snd(0, 1319, 0.12, 0, 0.1); db_snd(0, 1760, 0.1, 0.07, 0.1); ) :
  k == 2 ? (
    db_snd(7, 110, 0.5, 0, 0); db_snd(2, 90, 0.4, 0, 0); db_snd(14, 34, 0.22, 0, 0);
    db_snl(8, 330, 0.14, 0.05, -0.2, 0.07); db_snl(8, 415, 0.14, 0.05, 0.2, 0.07); db_snl(8, 330, 0.14, 0.2, -0.2, 0.07); db_snl(8, 415, 0.14, 0.2, 0.2, 0.07);
    db_snl(11, 1500, 0.09, 0.14, 0, 0.13); db_snl(11, 1000, 0.09, 0.2, 0, 0.13); db_snl(11, 650, 0.08, 0.27, 0, 0.13);
  ) :
  k == 3 ? (
    db_snd(14, 14, 0.3, 0, 0); db_snd(1, 380, 0.3, 0, 0); db_snd(2, 130, 0.25, 0.02, 0);
    i = 0; loop(4, db_snl(11, 720 - i * 110, 0.11, 0.18 + i * 0.15, (i & 1) ? 0.15 : -0.15, 0.13); i += 1; );
    db_snd(4, 311, 0.14, 0.55, 0); db_snd(4, 262, 0.14, 0.75, 0);
  ) :
  k == 4 ? (
    i = 0; loop(7, db_snl(11, 2600 - i * 170 + rand(1) * 120, 0.085, i * 0.04, 0.2 - i * 0.07, 0.13); i += 1; );
    db_snd(14, 16, 0.15, 0, 0); db_snd(14, 40, 0.1, 0.18, 0); db_snd(2, 110, 0.4, 0.42, 0); db_snl(11, 420, 0.1, 0.5, 0, 0.13);
  ) :
  k == 5 ? (
    db_snd(3, 196, 0.22, 0, -0.1); db_snd(3, 247, 0.2, 0, 0); db_snd(3, 294, 0.18, 0, 0.1);
    db_snd(14, 9, 0.3, 0, 0); db_snd(1, 260, 0.2, 0, 0); db_snd(7, 90, 0.55, 0.12, 0); db_snd(2, 70, 0.4, 0.12, 0);
    db_snl(11, 1100, 0.08, 0.3, 0, 0.13); db_snl(11, 750, 0.08, 0.37, 0, 0.13);
  ) :
  k == 6 ? ( i = 0; loop(6, db_snd(0, 523 * 2 ^ (floor(i * 5 / 2) / 12 * 2), 0.13, i * 0.09, (i & 1) ? 0.2 : -0.2); i += 1; ); ) :
  0;
  g_sfxg = g_sfxd;
);

function hp_hop(l) ( l == 0 ? 10 : l; );
function hp_hasl(l) ( (floor(sv7[5]) & (1 << l)) ? 1 : 0; );
function hp_hasc(c) ( c < 11 ? 1 : ((floor(sv7[22]) & (1 << (c - 11))) ? 1 : 0); );

function hp_coinfree(r, u) ( u >= HP_PMIN && u <= HP_PMAX && hp_dc[r * HP_DW + u + 40] == 0; );

function hp_coinfrom(n, u) local(p, d)
(
  p = (n - 1) & 1023; d = hp_dc[p * HP_DW + u + 40];
  hp_ln[p] != n - 1 || !(hp_lt[p] == 0 || hp_lt[p] == 4 || hp_lt[p] == 6) || d == 0 || d == 5;
);

function hp_coinok(n, u, t) local(r)
(
  r = n & 1023;
  t != 2 && t != 3 && hp_coinfree(r, u) && (hp_coinfrom(n, u) || (hp_coinfree(r, u - 1) && hp_coinfrom(n, u - 1)) || (hp_coinfree(r, u + 1) && hp_coinfrom(n, u + 1)));
);

function hp_gen(n) local(r, t, k, u, x, d, pos, len, ty, dir, base, lv, sm, w1, w2, sp, pr)
(
  lv = g_hp_lv;
  r = n & 1023; hp_ln[r] = n; hp_lu[r] = -1; hp_wd[r] = 98; hp_on[r] = 0; hp_lw[r] = 0; hp_lc[r] = 0; hp_lv2[r] = 0; hp_lf[r] = 1; hp_ls[r] = 0; hp_ld[r] = 1;
  memset(hp_dc + r * HP_DW, 0, HP_DW); memset(hp_cn + r * HP_DW, 0, HP_DW);
  sm = 1 + lv * 0.05 + 0.6 * min(1, max(0, n - 13) / 160);
  t = 0;
  n >= 13 ? (
    g_hp_gl <= 0 ? (
      g_hp_gt == 0 ? (
        x = rand(1); w1 = hp_ww[lv * 2]; w2 = w1 + hp_ww[lv * 2 + 1];
        g_hp_gt = x < w1 ? 1 : x < w2 ? 2 : 3;
        g_hp_gl = g_hp_gt == 3 ? 1 + floor(rand(1) * 2) : g_hp_gt == 2 ? 1 + floor(rand(1) * 3) : 1 + floor(rand(1) * 4);
      ) : ( g_hp_gt = 0; g_hp_gl = 1 + floor(rand(1) * 2); );
    );
    t = g_hp_gt; g_hp_gl -= 1;
  );
  (lv == 2 && t == 0 && n >= 13 && rand(1) < 0.55) ? t = 4;
  (lv == 5 && t == 0 && n >= 13 && rand(1) < 0.45) ? t = 6;
  hp_lt[r] = t;
  base = r * HP_NO;
  (t == 0 || t == 4 || t == 6) ? (
    u = HP_UMIN;
    loop(HP_UMAX - HP_UMIN + 1,
      d = 0;
      (u < HP_PMIN - 1 || u > HP_PMAX + 1) ? (
        rand(1) < 0.8 ? d = rand(1) < 0.5 ? 2 : 1;
      ) : (
        n > 12 && rand(1) < ((hp_ln[(n - 1) & 1023] == n - 1 && hp_lt[(n - 1) & 1023] == 2) ? 0.04 : 0.08) ? ( x = rand(1); d = x < 0.5 ? 1 : x < 0.62 ? 2 : x < 0.85 ? 3 : 4; );
        (lv == 7 && n > 14 && d == 0 && t == 0 && rand(1) < 0.035) ? d = 5;
      );
      hp_dc[r * HP_DW + u + 40] = d;
      u += 1;
    );
    t == 6 ? ( hp_ld[r] = rand(1) < 0.5 ? 1 : -1; hp_ls[r] = 1.0 + rand(1) * 0.9; );
    (lv == 1 && t == 0 && n >= 13 && rand(1) < 0.5) ? (
      hp_ld[r] = rand(1) < 0.5 ? 1 : -1; hp_ls[r] = (1.8 + rand(1) * 1.4) * sm; hp_lv2[r] = 3;
      pos = HP_UMIN + rand(1) * 10; k = 0; sp = pos;
      while (pos < HP_UMAX - 2 && k < HP_NO) ( hp_ou[base + k] = pos; hp_ol[base + k] = 0.8; hp_ok[base + k] = 4; hp_oc[base + k] = 0; pos += 11 + rand(1) * 9; k += 1; );
      hp_on[r] = k; hp_wd[r] = max(60, pos - sp);
    );
    (lv == 8 && t == 0 && n >= 13 && rand(1) < 0.45) ? (
      hp_ld[r] = rand(1) < 0.5 ? 1 : -1; hp_ls[r] = (1.1 + rand(1) * 1.1) * sm; hp_lv2[r] = 4;
      pos = HP_UMIN + rand(1) * 10; k = 0; sp = pos;
      while (pos < HP_UMAX - 2 && k < HP_NO) ( hp_ou[base + k] = pos; hp_ol[base + k] = 0.9; hp_ok[base + k] = 6; hp_oc[base + k] = rand(1) * 10; pos += 10 + rand(1) * 9; k += 1; );
      hp_on[r] = k; hp_wd[r] = max(60, pos - sp);
    );
  );
  n > 12 && t != 3 && rand(1) < 0.45 ? (
    u = floor(HP_PMIN + rand(1) * (HP_PMAX - HP_PMIN + 1));
    hp_coinok(n, u, t) ? hp_cn[r * HP_DW + u + 40] = 1;
  );
  ((t == 0 || t == 4 || t == 6) && n >= g_hp_tokn && !hp_hasc(hp_hop(lv)) && 0) ? (
    k = 0; u = floor(HP_PMIN + rand(1) * (HP_PMAX - HP_PMIN + 1));
    while (k < 8 && hp_dc[r * HP_DW + u + 40] != 0) ( u = floor(HP_PMIN + rand(1) * (HP_PMAX - HP_PMIN + 1)); k += 1; );
    hp_dc[r * HP_DW + u + 40] == 0 ? ( hp_cn[r * HP_DW + u + 40] = 2; g_hp_tokn += 50; );
  );
  t == 1 ? (
    hp_ld[r] = rand(1) < 0.5 ? 1 : -1; hp_ls[r] = (1.3 + rand(1) * 2.4) * sm;
    (lv == 3 && rand(1) < 0.7) ? ( hp_lv2[r] = 1; hp_lr[r] = rand(1) * 7; );
    pos = HP_UMIN + rand(1) * 6; k = 0; sp = pos;
    while (pos < HP_UMAX - 2 && k < HP_NO) (
      ty = rand(1) < 0.28 ? 1 : 0;
      len = ty ? 3.2 + rand(1) * 0.5 : 1.7 + rand(1) * 0.4;
      hp_ou[base + k] = pos + len * 0.5; hp_ol[base + k] = len; hp_ok[base + k] = ty; hp_oc[base + k] = floor(rand(1) * 6);
      pos += len + 3.2 + rand(1) * 5 + hp_ls[r] * 0.8;
      k += 1;
    );
    hp_on[r] = k; hp_wd[r] = max(50, pos - sp);
  );
  t == 2 ? (
    hp_ld[r] = rand(1) < 0.5 ? 1 : -1; hp_ls[r] = (1.2 + rand(1) * 1.1 + 0.5 * min(1, n / 200)) * (1 + lv * 0.04);
    pr = (n - 1) & 1023;
    (hp_ln[pr] == n - 1 && (hp_lt[pr] == 0 || hp_lt[pr] == 4 || hp_lt[pr] == 6)) ? (
      u = HP_PMIN;
      loop(HP_PMAX - HP_PMIN + 1, (rand(1) < 0.8 && hp_dc[pr * HP_DW + u + 40] != 5) ? hp_dc[pr * HP_DW + u + 40] = 0; u += 1; );
    );
    (hp_ln[pr] == n - 1 && hp_lt[pr] == 2 && hp_ls[pr] > 0) ? ( hp_ld[r] = -hp_ld[pr]; hp_ls[r] = hp_ls[pr] * (0.85 + rand(1) * 0.3); );
    (lv == 4 && rand(1) < 0.65) ? (
      hp_lv2[r] = 5; hp_ls[r] = 0; k = 0; u = HP_PMIN - 1;
      loop(HP_PMAX - HP_PMIN + 3, rand(1) < 0.6 && k < HP_NO ? ( hp_ou[base + k] = u + 0.5; hp_ol[base + k] = 1; hp_ok[base + k] = 5; hp_oc[base + k] = 0; k += 1; ); u += 1; );
      hp_on[r] = k;
    ) : (
      (lv == 9 && rand(1) < 0.7) ? hp_lv2[r] = 2;
      pos = HP_UMIN + rand(1) * 4; k = 0; sp = pos;
      while (pos < HP_UMAX - 2 && k < HP_NO) (
        len = 2 + floor(rand(1) * 3);
        hp_ou[base + k] = pos + len * 0.5; hp_ol[base + k] = len; hp_ok[base + k] = 2; hp_oc[base + k] = rand(1) * 10;
        pos += len + 1.4 + rand(1) * 1.2;
        k += 1;
      );
      hp_on[r] = k; hp_wd[r] = max(50, pos - sp);
    );
  );
  t == 3 ? (
    hp_ld[r] = rand(1) < 0.5 ? 1 : -1; hp_lr[r] = 1.5 + rand(1) * 4;
    hp_ou[base] = -1000; hp_ol[base] = 26; hp_ok[base] = 3; hp_oc[base] = 0; hp_on[r] = 1;
  );
  g_hp_gn = n;
);

function hp_solid(ln, k) local(kd, b)
(
  b = ln * HP_NO + k; kd = hp_ok[b];
  kd == 5 ? hp_oc[b] >= 0 :
  (kd == 2 && hp_lv2[ln] == 2) ? hp_mod(g_t * 0.7 + hp_oc[b] * 0.37, 4) < 3.1 :
  1;
);

function hp_updlanes(dt) local(n, r, t, k, base, w, dir, sp, v2, ph, c)
(
  n = floor(g_hp_cv) + HP_BASE - ceil(8 / HP_SC);
  loop(floor(36 / HP_SC),
    n >= 0 ? (
      r = n & 1023;
      (hp_ln[r] == n && hp_lu[r] !== g_hp_fr) ? (
        hp_lu[r] = g_hp_fr;
        t = hp_lt[r]; base = r * HP_NO; dir = hp_ld[r]; v2 = hp_lv2[r];
        v2 == 1 ? (
          ph = hp_mod(g_t * 0.9 + hp_lr[r], 7);
          hp_lf[r] += ((ph > 4.4 ? 0 : 1) - hp_lf[r]) * min(1, dt * 3);
        );
        (hp_on[r] > 0 && hp_ls[r] > 0 && t != 3 && t != 6) ? (
          sp = hp_ls[r] * hp_lf[r] * dt; w = hp_wd[r]; k = 0;
          loop(hp_on[r],
            hp_ou[base + k] += dir * sp;
            dir > 0 && hp_ou[base + k] - hp_ol[base + k] * 0.5 > HP_UMAX + 4 ? hp_ou[base + k] -= w;
            dir < 0 && hp_ou[base + k] + hp_ol[base + k] * 0.5 < HP_UMIN - 4 ? hp_ou[base + k] += w;
            k += 1;
          );
        );
        v2 == 5 ? (
          k = 0;
          loop(hp_on[r],
            c = hp_oc[base + k];
            c > 0 ? ( c -= dt; c <= 0 ? c = -3.2; ) : c < 0 ? ( c += dt; c >= 0 ? c = 0; );
            hp_oc[base + k] = c;
            k += 1;
          );
        );
        t == 3 ? (
          hp_lc[r] ? (
            hp_ou[base] += dir * 26 * dt;
            (dir > 0 && hp_ou[base] > g_hp_cu + 45) || (dir < 0 && hp_ou[base] < g_hp_cu - 45) ? ( hp_lc[r] = 0; hp_lr[r] = 3 + rand(1) * 6; hp_lw[r] = 0; hp_ou[base] = -1000; );
          ) : (
            hp_lr[r] -= dt;
            hp_lr[r] < 1.5 ? hp_lw[r] = 1;
            hp_lr[r] <= 0 ? ( hp_lc[r] = 1; hp_ou[base] = dir > 0 ? g_hp_cu - 28 : g_hp_cu + 28; );
          );
        );
      );
    );
    n += 1;
  );
);

function hp_chcol(ch) ( g_hp_cr = hp_cbr[ch] * 0.6 + 0.4; g_hp_cg = hp_cbg[ch] * 0.6 + 0.4; g_hp_cb = hp_cbb[ch] * 0.6 + 0.4; );

function hp_part(u, v, h, vu, vv, vh, life, kind) local(i)
(
  i = g_hp_pb + g_hp_pp % NPP; g_hp_pp += 1;
  hp_px[i] = u; hp_py[i] = v; hp_pz[i] = h; hp_pvx[i] = vu; hp_pvy[i] = vv; hp_pvz[i] = vh; hp_pl[i] = life; hp_pk[i] = kind;
);

function hp_updparts(dt) local(i)
(
  i = g_hp_pb;
  loop(NPP,
    hp_pl[i] > 0 ? (
      hp_pl[i] -= dt;
      hp_px[i] += hp_pvx[i] * dt; hp_py[i] += hp_pvy[i] * dt; hp_pz[i] += hp_pvz[i] * dt;
      hp_pk[i] == 5 ? (
        hp_pvz[i] -= 3.2 * dt; hp_pvz[i] < -0.9 ? hp_pvz[i] = -0.9;
        hp_pvx[i] *= 1 - dt * 1.4; hp_pvy[i] *= 1 - dt * 1.4;
        hp_px[i] += sin(hp_pl[i] * 9 + i) * 0.5 * dt; hp_py[i] += cos(hp_pl[i] * 7 + i) * 0.4 * dt;
        hp_pz[i] <= 0 ? ( hp_pz[i] = 0; hp_pvz[i] = 0; hp_pvx[i] = 0; hp_pvy[i] = 0; );
      ) : (
        hp_pvz[i] -= 9 * dt;
        hp_pz[i] < 0 && hp_pk[i] != 2 ? ( hp_pz[i] = 0; hp_pvz[i] = abs(hp_pvz[i]) * 0.4; hp_pvx[i] *= 0.6; hp_pvy[i] *= 0.6; );
      );
    );
    i += 1;
  );
);

function hp_drawparts() local(i, f)
(
  i = g_hp_pb;
  loop(NPP,
    hp_pl[i] > 0 ? (
      f = min(1, hp_pl[i] * 2);
