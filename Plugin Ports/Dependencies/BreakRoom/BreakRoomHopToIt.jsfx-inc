  txt_c(g_hp_bt ? "Player 1: W A S D     Player 2: arrow keys     Get far enough ahead and the eagle takes the other one!" : "Player 1: W A S D     Player 2: arrow keys", 18, 534, 864, 22);
  sprintf(#hp_s7, "Your best here: %d", sv7[10 + g_hp_blv]);
  d = hp_selcard(28, 566, h2 ? 280 : 420, 78, "WORLD", hp_wn[g_hp_blv], #hp_s7, 0, 0.62, 0.86, 0.3);
  d != 0 ? (
