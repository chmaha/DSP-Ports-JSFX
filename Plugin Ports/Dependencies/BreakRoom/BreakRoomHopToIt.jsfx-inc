hp_lt = alloc(HP_NL); hp_ld = alloc(HP_NL); hp_ls = alloc(HP_NL); hp_ln = alloc(HP_NL); hp_lr = alloc(HP_NL); hp_lw = alloc(HP_NL); hp_lc = alloc(HP_NL);
