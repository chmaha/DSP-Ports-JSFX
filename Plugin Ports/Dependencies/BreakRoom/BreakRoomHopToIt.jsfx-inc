        dd = hp_dc[r * HP_DW + u + 40];
        (u + 40 >= 0 && u + 40 < HP_DW && dd > 0) ? hp_deco(dd, u, v0, h);
        u += 1;
      );
    );
  );
);

function hp_req(d) ( hp_rqin[0] = d + 1; );

function hp_blocked(n, u) local(r)
(
  r = n & 1023;
  (hp_ln[r] == n && (hp_lt[r] == 0 || hp_lt[r] == 4 || hp_lt[r] == 6)) ? ( u + 40 >= 0 && u + 40 < HP_DW && hp_dc[r * HP_DW + u + 40] > 0 && hp_dc[r * HP_DW + u + 40] != 5; ) : 0;
);

function hp_snap(n, u, adv) local(lr, base, k, lc, left, cell, out)
(
  out = u; lr = n & 1023; base = lr * HP_NO; k = 0;
  loop(hp_on[lr],
    lc = hp_ou[base + k] + hp_ld[lr] * hp_ls[lr] * adv;
    (abs(u - lc) < hp_ol[base + k] * 0.5 + 0.1 && hp_solid(lr, k)) ? (
      left = lc - hp_ol[base + k] * 0.5;
      cell = max(0, min(hp_ol[base + k] - 1, floor(u - left)));
      out = left + cell + 0.5;
    );
    k += 1;
  );
  out;
);

function hp_checkunlocks() local(sc, l)
(
  sc = g_hp_score; l = g_hp_lv;
  (l < HP_NLV - 1 && sc >= hp_lvthr(l) && !hp_hasl(l + 1)) ? ( sv7[5] = floor(sv7[5]) | (1 << (l + 1)); g_hp_nl = l + 1; g_hp_ttl = 3; );
);

function hp_coinadd() local(w)
(
  w = g_hp_lv;
  sv7[30 + w] += 1; hp_sfx(1);
  (sv7[30 + w] >= HP_BCOIN && !hp_hasc(11 + w)) ? ( sv7[22] = floor(sv7[22]) | (1 << w); g_hp_nc = 11 + w; g_hp_nl = -1; g_hp_ttl = 3.5; hp_sfx(6); );
);

function hp_progress(nn)
(
  nn > g_hp_best_n ? ( g_hp_best_n = nn; g_hp_score = nn - 10; g_hp_pnmin = max(g_hp_pnmin, nn - 6); hp_checkunlocks(); );
);

function hp_dohop(d) local(nu, nn, ok, cu, rl, tn, o)
(
  nu = g_hp_pu; nn = g_hp_pn;
  d == 0 ? nn += 1 : d == 1 ? nn -= 1 : d == 2 ? nu -= 1 : nu += 1;
  d == 0 ? g_hp_fd = 0 : d == 1 ? g_hp_fd = 1 : d == 2 ? g_hp_fd = 3 : g_hp_fd = 2;
  g_hp_st == 0 ? ( g_hp_st = 1; g_hp_idle = 0; );
  ok = 1;
  d >= 2 ? (
    ok = floor(nu) >= HP_PMIN && floor(nu) <= HP_PMAX;
    ok && hp_blocked(nn, floor(nu)) ? ok = 0;
    (ok && hp_ln[nn & 1023] == nn && hp_lt[nn & 1023] == 4) ? (
      tn = d == 2 ? nu - 1 : nu + 1;
      (floor(tn) >= HP_PMIN && floor(tn) <= HP_PMAX && !hp_blocked(nn, floor(tn))) ? nu = tn;
    );
  ) : (
    (d == 0 || d == 1) ? (
      rl = hp_lt[nn & 1023] == 2 && hp_ln[nn & 1023] == nn;
      rl ? nu = hp_snap(nn, g_hp_pu, 0.17) : nu = floor(g_hp_pu) + 0.5;
      ok && hp_blocked(nn, floor(nu)) ? ok = 0;
    );
  );
  (ok && g_hp_bt) ? ( o = 1 - g_hp_cp; (hp_qa[o] && hp_qn[o] == nn && floor(hp_qu[o]) == floor(nu)) ? ok = 0; );
  ok ? (
    g_hp_hu0 = g_hp_pu; g_hp_hv0 = g_hp_pn - HP_BASE; g_hp_hu1 = nu; g_hp_hn1 = nn;
    g_hp_hop = 1; g_hp_ht = 0; hp_sfx(0);
    hp_progress(nn);
  ) : (
    g_hp_bump = 0.2;
  );
);

function hp_nexthop(c) local(k, cand, out)
(
  out = c; k = 1;
  loop(HP_NCH - 1, cand = (c + k) % HP_NCH; (out == c && hp_hasc(cand)) ? out = cand; k += 1; );
  out;
);

function hp_initp(p) local(k)
(
  g_hp_pu = (g_hp_np == 2 && g_hp_bt) ? (p == 0 ? 7.5 : 9.5) : 8.5; g_hp_pn = 10; g_hp_pv = 2; g_hp_pln = 10; g_hp_hop = 0; g_hp_ht = 0; g_hp_fd = 0; g_hp_dead = 0; g_hp_dt = 0; g_hp_rq = 0;
  g_hp_hu0 = g_hp_pu; g_hp_hv0 = 2; g_hp_hu1 = g_hp_pu; g_hp_hn1 = 10;
  g_hp_cu = 8.5; g_hp_cv = 2; g_hp_cvmin = 0; g_hp_st = 0; g_hp_idle = 0; g_hp_best_n = 10; g_hp_score = 0; g_hp_pnmin = 4; g_hp_coins_run = 0; g_hp_bump = 0; g_hp_shk = 0;
  g_hp_nl = -1; g_hp_nc = -1; g_hp_ttl = 0; g_hp_mtmr = 2.5 + p * 1.3; g_hp_grab = 0; g_hp_flash = 0; g_hp_ef = 0; g_hp_pp = 0; g_hp_t1 = 0.6; g_hp_warn = 0; g_hp_tdir = 1;
  g_hp_e0u = 0; g_hp_e0v = 0; g_hp_e0z = 0;
  memset(hp_pl + p * NPP, 0, NPP);
  k = 0; loop(4, hp_mn[p * 4 + k] = -1; k += 1; );
);

function hp_start() local(n, p)
(
  g_hp_lv = sv7[6]; g_hp_trk = 40 + g_hp_lv; g_hp_br = hp_tv(20);
  hp_setsc(0.5);
  g_hp_np = sv7[8] ? 2 : 1; g_hp_bt = sv7[8] == 2;
  memset(hp_ln, -1, HP_NL);
  g_hp_gt = 0; g_hp_gl = 0; g_hp_gn = 0; g_hp_tokn = 10 + 50 - 4;
  n = 0;
  loop(floor(36 / HP_SC) + 8, hp_gen(n); n += 1; );
  g_hp_scu = 8.5; g_hp_scv = 2; g_hp_shc = 0; g_hp_alld = 0;
  p = 0;
  loop(g_hp_np,
    hp_initp(p); g_hp_ch = p == 0 ? sv7[3] : sv7[21];
    hp_ctxsave(p);
    p += 1;
  );
  hp_rqin[0] = 0; hp_rqin[1] = 0;
  hp_ctxload(0);
  g_hp_ready = 1;
);

function hp_die(kind) local(i)
(
  g_hp_dead == 0 ? (
    g_hp_dead = kind; g_hp_dt = 0; g_hp_hop = 0; g_hp_grab = 0;
    hp_sfx(kind == 1 ? 2 : kind == 2 ? 3 : kind == 4 ? 5 : 4);
    kind == 3 ? (
      (g_hp_st == 1 && g_hp_ef > 0.5) ? (
        hp_wpos(hp_lh(g_hp_pn), min(1, g_hp_ef)); g_hp_e0u = g_hp_ex; g_hp_e0v = g_hp_ey; g_hp_e0z = g_hp_ez; g_hp_t1 = 0.32; g_hp_warn = 1;
      ) : (
        g_hp_e0u = g_hp_pu + 9; g_hp_e0v = g_hp_pv + 9.5; g_hp_e0z = hp_lh(g_hp_pn) + 11.5; g_hp_t1 = 0.6; g_hp_warn = 0;
      );
    );
    kind == 1 ? ( i = 0; loop(26, hp_part(g_hp_pu + (rand(1) - 0.5) * 0.4, g_hp_pv + 0.5 + (rand(1) - 0.5) * 0.4, 0.3 + rand(1) * 0.4, (rand(1) - 0.5) * 5, (rand(1) - 0.5) * 5, 2 + rand(1) * 2.6, 1.8 + rand(1) * 0.8, 5); i += 1; ); g_hp_shk = 8; );
    kind == 2 ? ( i = 0; loop(18, hp_part(g_hp_pu, g_hp_pv + 0.5, 0.2, (rand(1) - 0.5) * 4, (rand(1) - 0.5) * 4, 3 + rand(1) * 4, 1.0, 2); i += 1; ); );
    kind == 4 ? ( g_hp_tdir = hp_ld[g_hp_pln & 1023]; i = 0; loop(22, hp_part(g_hp_pu, g_hp_pv + 0.5, 0.4 + rand(1) * 0.5, g_hp_tdir * (6 + rand(1) * 8), (rand(1) - 0.5) * 4, 1 + rand(1) * 2.5, 1.8 + rand(1) * 0.8, 5); i += 1; ); g_hp_shk = 12; );
    sv7[0] = max(sv7[0], g_hp_score); sv7[10 + g_hp_lv] = max(sv7[10 + g_hp_lv], g_hp_score); sv7[1] += g_hp_coins_run; sv7[4] += 1;
  );
);

function hp_meteors(dt) local(i, k, nn, uu, tries, ok)
(
  g_hp_lv == 6 && g_hp_st == 1 && g_hp_dead == 0 ? (
    g_hp_mtmr -= dt;
    g_hp_mtmr <= 0 ? (
      g_hp_mtmr = max(0.8, 2.0 - g_hp_score * 0.012);
      i = g_hp_mb; k = -1;
      loop(4, (hp_mn[i] < 0 && k < 0) ? k = i; i += 1; );
      k >= 0 ? (
        tries = 0; ok = 0;
        while (tries < 6 && !ok) (
          nn = g_hp_pn + floor(rand(1) * 5) - 1; uu = floor(g_hp_pu + rand(1) * 7 - 3.5);
          uu = max(HP_PMIN, min(HP_PMAX, uu));
          (hp_ln[nn & 1023] == nn && hp_lt[nn & 1023] != 2 && hp_lt[nn & 1023] != 3 && !hp_blocked(nn, uu)) ? ok = 1;
          tries += 1;
        );
        ok ? ( hp_mn[k] = nn; hp_mu[k] = uu; hp_mt[k] = 1.2; );
      );
    );
  );
  i = g_hp_mb;
  loop(4,
    hp_mn[i] >= 0 ? (
      hp_mt[i] -= dt;
      (hp_mt[i] <= 0 && hp_mt[i] + dt > 0) ? (
        g_hp_shk = max(g_hp_shk, 6);
        k = 0; loop(10, hp_part(hp_mu[i] + 0.5, hp_mn[i] - HP_BASE + 0.5, 0.2, (rand(1) - 0.5) * 5, (rand(1) - 0.5) * 5, 2 + rand(1) * 3, 0.9, 6); k += 1; );
        (g_hp_dead == 0 && g_hp_pln == hp_mn[i] && floor(g_hp_pu) == hp_mu[i] && (!g_hp_hop || g_hp_ht > 0.7)) ? hp_die(1);
      );
      hp_mt[i] < -3 ? hp_mn[i] = -1;
    );
    i += 1;
  );
);

function hp_portal() local(tn, k, ok, u)
(
  u = floor(g_hp_pu); tn = g_hp_pn + 3; ok = 0;
  loop(4,
    (!ok && hp_ln[tn & 1023] == tn && hp_lt[tn & 1023] == 0 && !hp_blocked(tn, u) && hp_dc[(tn & 1023) * HP_DW + u + 40] != 5) ? ok = 1 : !ok ? tn += 1;
  );
  ok ? (
    k = 0; loop(12, hp_part(g_hp_pu, g_hp_pv + 0.5, 0.2, (rand(1) - 0.5) * 3, (rand(1) - 0.5) * 3, 2 + rand(1) * 3, 0.8, 0); k += 1; );
    g_hp_pn = tn; g_hp_pv = tn - HP_BASE; g_hp_pln = tn;
    hp_progress(tn);
    k = 0; loop(12, hp_part(g_hp_pu, g_hp_pv + 0.5, 0.2, (rand(1) - 0.5) * 3, (rand(1) - 0.5) * 3, 2 + rand(1) * 3, 0.8, 3); k += 1; );
  );
);

function hp_player(dt) local(r, t, k, base, ux, hit, onlog, ln, i, kd, c, tt)
(
  g_hp_dead > 0 ? (
    g_hp_dt += dt;
    g_hp_dead == 3 ? (
      (g_hp_dt >= g_hp_t1 && g_hp_grab == 0) ? (
        g_hp_grab = 1; g_hp_shk = 18; g_hp_flash = 1;
        i = 0; loop(40, hp_part(g_hp_pu, g_hp_pv + 0.5, 0.4 + rand(1) * 0.8, (rand(1) - 0.5) * 10, (rand(1) - 0.5) * 10, 2 + rand(1) * 5, 1.8 + rand(1), 5); i += 1; );
        i = 0; loop(14, hp_part(g_hp_pu, g_hp_pv + 0.5, 0.2, (rand(1) - 0.5) * 8, (rand(1) - 0.5) * 8, 1 + rand(1) * 2, 0.7, 0); i += 1; );
      );
      (g_hp_dt > g_hp_t1 && g_hp_dt < 1.9 + g_hp_t1 && rand(1) < 0.9) ? hp_part(g_hp_pu + 7 * sqr(g_hp_dt - g_hp_t1), g_hp_pv + 0.5 + 6 * sqr(g_hp_dt - g_hp_t1), 1.6 * (g_hp_dt - g_hp_t1) + 16 * sqr(g_hp_dt - g_hp_t1) + 0.5, (rand(1) - 0.5) * 3, (rand(1) - 0.5) * 3, 0.5 + rand(1), 1.4, 5);
    );
    g_hp_dead == 4 ? (
      g_hp_dt < 1.2 ? (
        g_hp_pu += g_hp_tdir * 30 * dt;
        rand(1) < 0.8 ? hp_part(g_hp_pu, g_hp_pv + 0.5, 0.5 + 1.2 * sin(min(1, g_hp_dt * 2.2) * $pi), -g_hp_tdir * 2 + (rand(1) - 0.5) * 2, (rand(1) - 0.5) * 3, 0.6 + rand(1), 1.5, 5);
      );
    );
  ) : (
    g_hp_hop ? (
      g_hp_ht += dt / 0.17;
      g_hp_ht >= 1 ? (
        g_hp_ht = 1; g_hp_hop = 0; g_hp_pu = g_hp_hu1; g_hp_pn = g_hp_hn1; g_hp_pv = g_hp_pn - HP_BASE; g_hp_pln = g_hp_pn;
        r = g_hp_pn & 1023;
        hp_ln[r] == g_hp_pn && hp_lt[r] == 2 ? g_hp_pu = hp_snap(g_hp_pn, g_hp_pu, 0);
        (hp_ln[r] == g_hp_pn && hp_lt[r] != 3 && hp_cn[r * HP_DW + floor(g_hp_pu) + 40] == 2) ? (
          hp_cn[r * HP_DW + floor(g_hp_pu) + 40] = 0;
          !hp_hasc(hp_hop(g_hp_lv)) ? ( sv7[2] = floor(sv7[2]) | (1 << hp_hop(g_hp_lv)); g_hp_nc = hp_hop(g_hp_lv); g_hp_ttl = 3.5; );
          i = 0; loop(24, hp_part(g_hp_pu, g_hp_pv + 0.5, 0.6, (rand(1) - 0.5) * 6, (rand(1) - 0.5) * 6, 2 + rand(1) * 4, 1.2, 3); i += 1; );
        ) : (hp_ln[r] == g_hp_pn && hp_lt[r] != 3 && hp_cn[r * HP_DW + floor(g_hp_pu) + 40]) ? ( hp_cn[r * HP_DW + floor(g_hp_pu) + 40] = 0; g_hp_coins_run += 1; hp_coinadd(); i = 0; loop(6, hp_part(g_hp_pu, g_hp_pv + 0.5, 0.6, (rand(1) - 0.5) * 3, (rand(1) - 0.5) * 3, 3, 0.6, 3); i += 1; ); );
        (hp_ln[r] == g_hp_pn && hp_lt[r] == 0 && hp_dc[r * HP_DW + floor(g_hp_pu) + 40] == 5) ? hp_portal();
        g_hp_idle = 0;
      ) : (
        g_hp_pu = g_hp_hu0 + (g_hp_hu1 - g_hp_hu0) * g_hp_ht;
        g_hp_pv = g_hp_hv0 + (g_hp_hn1 - HP_BASE - g_hp_hv0) * g_hp_ht;
        g_hp_ht > 0.5 ? g_hp_pln = g_hp_hn1 : g_hp_pln = g_hp_pn;
      );
    ) : (
      g_hp_pln = g_hp_pn;
    );
    ln = g_hp_pln & 1023; hit = 0;
    (!g_hp_hop || g_hp_ht > 0.6) && hp_ln[ln] == g_hp_pln ? (
      t = hp_lt[ln]; base = ln * HP_NO;
      t != 2 ? (
        k = 0;
        loop(hp_on[ln],
          kd = hp_ok[base + k];
          ((kd == 0 || kd == 1 || kd == 3 || kd == 4 || kd == 6) && abs(g_hp_pu - hp_ou[base + k]) < hp_ol[base + k] * 0.5 + 0.28) ? hit = 1 + (kd == 3);
          k += 1;
        );
        hit ? hp_die(hit == 2 ? 4 : 1);
      );
      (t == 6 && !g_hp_hop) ? (
        g_hp_pu += hp_ld[ln] * hp_ls[ln] * dt;
        g_hp_pu = max(HP_PMIN + 0.5, min(HP_PMAX + 0.5, g_hp_pu));
      );
      (t == 2 && !g_hp_hop) ? (
        onlog = 0; k = 0;
        loop(hp_on[ln],
          (abs(g_hp_pu - hp_ou[base + k]) < hp_ol[base + k] * 0.5 + 0.12 && hp_solid(ln, k)) ? (
            onlog = 1; ux = hp_ou[base + k];
            (hp_ok[base + k] == 5 && hp_oc[base + k] == 0) ? hp_oc[base + k] = 1.3;
          );
          k += 1;
        );
        onlog ? ( g_hp_pu += hp_ld[ln] * hp_ls[ln] * dt; ) : hp_die(2);
        (g_hp_pu < HP_PMIN - 0.5 || g_hp_pu > HP_PMAX + 1.5) ? hp_die(2);
      );
      (t == 2 && g_hp_hop && g_hp_ht > 0.9) ? (
        onlog = 0; k = 0;
        loop(hp_on[ln],
          (abs(g_hp_pu - hp_ou[base + k]) < hp_ol[base + k] * 0.5 + 0.12 && hp_solid(ln, k)) ? onlog = 1;
          k += 1;
        );
        !onlog ? hp_die(2);
      );
    );
    (g_hp_dead == 0 && !g_hp_hop && g_hp_rq > 0) ? ( hp_dohop(g_hp_rq - 1); g_hp_rq = 0; );
    g_hp_st == 1 && !g_hp_hop ? (
      g_hp_idle += dt;
      !g_hp_bt ? g_hp_cvmin += dt * (0.9 + min(0.9, g_hp_score * 0.012));
      g_hp_pn < g_hp_best_n - 6 ? hp_die(3);
    );
    (g_hp_st == 1 && g_hp_hop && !g_hp_bt) ? g_hp_cvmin += dt * (0.9 + min(0.9, g_hp_score * 0.012));
    g_hp_st == 1 && g_hp_dead == 0 ? (
      g_hp_cvmin = max(g_hp_cvmin, g_hp_pv);
      c = (g_hp_cvmin - g_hp_pv) / (3.38 / HP_SC);
      tt = max(min(1, max(0, (g_hp_idle - 5) / 3.2)), min(1, max(0, (c - 0.55) / 0.45)));
      tt > g_hp_ef ? g_hp_ef = tt : g_hp_ef = max(tt, g_hp_ef - dt * 0.7);
      g_hp_ef >= 0.999 ? hp_die(3);
    );
  );
);

function hp_ctrl() local(ev, k, a)
(
  k = 0; a = g_hp_np == 2 ? 1 : 0;
  while (k < 32 && (ev = gfx_getchar()) > 0) (
    (ev == 'p' || ev == 'P') ? g_pz_req = 1 :
    (ev == 13 || ev == 10) ? ( g_hp_alld ? hp_start(); ) :
    (ev == 'w' || ev == 'W') ? hp_rqin[0] = 1 :
    (ev == 's' || ev == 'S') ? hp_rqin[0] = 2 :
    (ev == 'a' || ev == 'A') ? hp_rqin[0] = 3 :
    (ev == 'd' || ev == 'D') ? hp_rqin[0] = 4 :
    ev == 'up' ? hp_rqin[a] = 1 :
    ev == 'down' ? hp_rqin[a] = 2 :
    ev == 'left' ? hp_rqin[a] = 3 :
    ev == 'rght' ? hp_rqin[a] = 4;
    k += 1;
  );
);

function hp_clickp(p) local(dx, dy)
(
  (g_click && g_hp_dead == 0 && hit(g_hp_xl, BRD_Y, g_hp_xr - g_hp_xl, BRD_H) && !(g_hp_st == 0 && g_my > 556)) ? (
    dx = g_mx - (HP_OX + (g_hp_pu - g_hp_cu) * HP_UX + (g_hp_pv + 0.5 - g_hp_cv) * HP_VX);
    dy = g_my - (HP_OY + (g_hp_pu - g_hp_cu) * HP_UY + (g_hp_pv + 0.5 - g_hp_cv) * HP_VY - 30);
    hp_rqin[p] = ((dx > 0 && dy < 0) ? 0 : (dx < 0 && dy > 0) ? 1 : (dx < 0 && dy < 0) ? 2 : 3) + 1;
  );
);

function hp_otxt(str, cx, y, sz, fr, fg, fb, orr, og, ob, ow) local(tw, th, k, a, x0)
(
  gfx_setfont(3, "Arial Black", sz * g_s, 'b');
  gfx_measurestr(str, tw, th);
  x0 = sx(cx) - tw * 0.5;
  gfx_set(0, 0, 0, 0.35); gfx_x = x0 + 3 * g_s; gfx_y = sy(y) + 4 * g_s; gfx_drawstr(str);
  k = 0;
  loop(16, a = k / 16 * 2 * $pi; gfx_set(orr, og, ob, 1); gfx_x = x0 + cos(a) * ow * g_s; gfx_y = sy(y) + sin(a) * ow * g_s; gfx_drawstr(str); k += 1; );
  gfx_set(fr, fg, fb, 1); gfx_x = x0; gfx_y = sy(y); gfx_drawstr(str);
);

function hp_scene() local(n, nlo, nhi, os, ox0, oy0)
(
  hp_c(hp_tv(0), hp_tv(1), hp_tv(2), 1); gfx_rect(sx(g_hp_xl), sy(BRD_Y), (g_hp_xr - g_hp_xl) * g_s, BRD_H * g_s);
  nhi = floor(g_hp_cv) + HP_BASE + ceil(16 / HP_SC); nlo = floor(g_hp_cv) + HP_BASE - ceil(9 / HP_SC);
  n = nhi;
  loop(nhi - nlo + 1,
    n >= 0 && hp_ln[n & 1023] == n ? hp_lane(n);
    n -= 1;
  );
  g_hp_bt ? ( g_hp_pb = 0; hp_drawparts(); g_hp_pb = NPP; hp_drawparts(); g_hp_pb = g_hp_cp * NPP; ) : hp_drawparts();
);

function hp_selcard(x, y, w, h, label, name, sub, lock, cr, cg, cb) local(res)
(
  res = 0;
  gfx_set(0.07, 0.09, 0.13, 1); fill_rr(x, y, w, h, 10);
  gfx_set(cr, cg, cb, 1); outline_rr(x, y, w, h, 10);
  font(11, 'b'); gfx_set(cr, cg, cb, 1); txt_c(label, x, y + 6, w, 14);
  font(18, 'b'); gfx_set(lock ? 0.55 : 1, lock ? 0.58 : 1, lock ? 0.62 : 1, 1); txt_c(name, x + 44, y + 22, w - 88, 26);
  font(11, 0); gfx_set(0.82, 0.88, 0.78, 1); txt_c(sub, x + 10, y + 54, w - 20, 16);
  button("<", x + 8, y + 24, 32, 32, cr, cg, cb) ? res = -1;
  button(">", x + w - 40, y + 24, 32, 32, cr, cg, cb) ? res = 1;
  res;
);

function hp_tags() local(p, x, y, cr, cg, cb)
(
  p = 0;
  loop(2,
    hp_cx[p * 48 + 11] == 0 ? (
      x = hp_x(hp_cx[p * 48], hp_cx[p * 48 + 1] + 0.5); y = hp_y(hp_cx[p * 48], hp_cx[p * 48 + 1] + 0.5, 2.6 + (hp_cx[p * 48 + 4] ? 0.7 * sin($pi * hp_cx[p * 48 + 5]) : 0));
      cr = p == 0 ? 0.9 : 0.25; cg = p == 0 ? 0.25 : 0.55; cb = p == 0 ? 0.2 : 0.95;
      gfx_set(cr, cg, cb, 1);
      gfx_triangle(sx(x - 7), sy(y + 9), sx(x + 7), sy(y + 9), sx(x), sy(y + 18));
      fill_rr(x - 16, y - 8, 32, 19, 5);
      font(11, 'b'); gfx_set(1, 1, 1, 1); txt_c(p == 0 ? "P1" : "P2", x - 16, y - 8, 32, 19);
    );
    p += 1;
  );
);

function hp_panerender(p) local(dst, ox0, oy0, os, cw, cvh, rk, xl, xw, d, i, x, y)
(
  xl = g_hp_xl; xw = g_hp_xr - g_hp_xl; rk = min(g_s, 2048 / xw); cw = floor(xw * rk); cvh = floor(BRD_H * rk);
  gfx_setimgdim(IMG_HP, cw, cvh);
  dst = gfx_dest; ox0 = g_ox; oy0 = g_oy; os = g_s;
  gfx_dest = IMG_HP; g_s = rk; g_ox = -xl * rk; g_oy = -BRD_Y * rk;
  gfx_mode = 0; gfx_a = 1;
  hp_scene();
  g_ox = ox0; g_oy = oy0; g_s = os; gfx_dest = dst;
  gfx_mode = 4; gfx_a = 1;
  x = sx(xl) + (rand(2) - 1) * g_hp_shk * g_s * 0.4; y = sy(BRD_Y) + (rand(2) - 1) * g_hp_shk * g_s * 0.4;
  gfx_blit(IMG_HP, 1, 0, 0, 0, cw, cvh, x, y, xw * g_s, BRD_H * g_s);
  gfx_mode = 0;
  g_hp_bt ? hp_tags();
  g_hp_dead == 3 ? ( gfx_set(0, 0, 0, 0.5 * sin(min(1, g_hp_dt / 2.2) * $pi)); gfx_rect(sx(xl), sy(BRD_Y), xw * g_s, BRD_H * g_s); );
  (g_hp_dead == 0 && g_hp_st == 1 && g_hp_ef > 0.02) ? (
    d = g_hp_ef * (0.55 + 0.45 * sin(g_t * 9));
    i = 0;
    loop(7,
      gfx_set(0.35, 0, 0, d * 0.16 * (7 - i) / 7);
      gfx_rect(sx(xl) + i * 9 * g_s, sy(BRD_Y) + i * 9 * g_s, (xw - i * 18) * g_s, 9 * g_s);
      gfx_rect(sx(xl) + i * 9 * g_s, sy(BRD_Y + BRD_H) - (i + 1) * 9 * g_s, (xw - i * 18) * g_s, 9 * g_s);
      gfx_rect(sx(xl) + i * 9 * g_s, sy(BRD_Y) + i * 9 * g_s, 9 * g_s, (BRD_H - i * 18) * g_s);
      gfx_rect(sx(xl + xw) - (i + 1) * 9 * g_s, sy(BRD_Y) + i * 9 * g_s, 9 * g_s, (BRD_H - i * 18) * g_s);
      i += 1;
    );
  );
  g_hp_flash > 0.02 ? ( gfx_set(1, 1, 0.9, g_hp_flash * 0.75); gfx_rect(sx(xl), sy(BRD_Y), xw * g_s, BRD_H * g_s); g_hp_flash *= exp(-g_dt * 12); );
  (g_hp_np == 2 && !g_hp_bt && g_hp_dead > 0 && g_hp_dt > (g_hp_dead == 3 ? 2.3 : 1.1)) ? (
    gfx_set(0, 0, 0, 0.5); gfx_rect(sx(xl), sy(BRD_Y), xw * g_s, BRD_H * g_s);
    hp_otxt("OUT!", xl + xw * 0.5, 250, 44, 1, 1, 1, 0.5, 0.15, 0.1, 4);
    sprintf(#hp_s4, "Score %d", g_hp_score);
    hp_otxt(#hp_s4, xl + xw * 0.5, 320, 28, 1, 1, 1, 0.2, 0.3, 0.1, 3);
  );
  gfx_set(0.3, 0.32, 0.36, 1); outline_rr(xl - 1, BRD_Y - 1, xw + 2, BRD_H + 2, 4);
);

function hp_setch(p, c) ( hp_cx[p * 48 + 23] = c; p == 0 ? g_hp_ch = c; );

function hp_hcard(x, y, w, label, c, cr, cg, cb) local(lk)
(
  lk = !hp_hasc(c);
  lk ? sprintf(#hp_sh, "Collect %d coins in %s (%d)", HP_BCOIN, hp_wn[c - 11], sv7[30 + c - 11]) : c >= 11 ? sprintf(#hp_sh, "Bonus hopper - %s", hp_wn[c - 11]) : sprintf(#hp_sh, "Hop as the %s", hp_cnm[c]);
  hp_selcard(x, y, w, 78, label, lk ? "???" : hp_cnm[c], #hp_sh, lk, cr, cg, cb);
);

function hp_startui() local(lk, d, h2)
(
  h2 = g_hp_np == 2;
  hp_otxt("Hop forward!", 450, 500, 28, 1, 1, 1, 0.2, 0.4, 0.1, 3);
  font(13, 0); gfx_set(1, 1, 1, 0.95);
