function hp_ctxsave(p) local(b)
(
  b = p * 48;
  hp_cx[b + 0] = g_hp_pu;
  hp_cx[b + 1] = g_hp_pv;
  hp_cx[b + 2] = g_hp_pn;
  hp_cx[b + 3] = g_hp_pln;
  hp_cx[b + 4] = g_hp_hop;
  hp_cx[b + 5] = g_hp_ht;
  hp_cx[b + 6] = g_hp_hu0;
  hp_cx[b + 7] = g_hp_hv0;
  hp_cx[b + 8] = g_hp_hu1;
  hp_cx[b + 9] = g_hp_hn1;
  hp_cx[b + 10] = g_hp_fd;
  hp_cx[b + 11] = g_hp_dead;
  hp_cx[b + 12] = g_hp_dt;
  hp_cx[b + 13] = g_hp_rq;
  hp_cx[b + 14] = g_hp_idle;
  hp_cx[b + 15] = g_hp_st;
  hp_cx[b + 16] = g_hp_cvmin;
  hp_cx[b + 17] = g_hp_cu;
  hp_cx[b + 18] = g_hp_cv;
  hp_cx[b + 19] = g_hp_best_n;
  hp_cx[b + 20] = g_hp_score;
  hp_cx[b + 21] = g_hp_pnmin;
  hp_cx[b + 22] = g_hp_coins_run;
  hp_cx[b + 23] = g_hp_ch;
  hp_cx[b + 24] = g_hp_bump;
  hp_cx[b + 25] = g_hp_shk;
  hp_cx[b + 26] = g_hp_nl;
  hp_cx[b + 27] = g_hp_nc;
  hp_cx[b + 28] = g_hp_ttl;
  hp_cx[b + 29] = g_hp_mtmr;
  hp_cx[b + 30] = g_hp_grab;
  hp_cx[b + 31] = g_hp_flash;
  hp_cx[b + 32] = g_hp_t1;
  hp_cx[b + 33] = g_hp_warn;
  hp_cx[b + 34] = g_hp_e0u;
  hp_cx[b + 35] = g_hp_e0v;
  hp_cx[b + 36] = g_hp_e0z;
  hp_cx[b + 37] = g_hp_tdir;
  hp_cx[b + 38] = g_hp_pp;
  hp_cx[b + 39] = g_hp_ef;
  hp_qu[p] = g_hp_pu; hp_qn[p] = g_hp_hop ? g_hp_hn1 : g_hp_pn; hp_qa[p] = g_hp_dead == 0;
);

function hp_ctxload(p) local(b)
(
  b = p * 48;
  g_hp_pu = hp_cx[b + 0];
  g_hp_pv = hp_cx[b + 1];
  g_hp_pn = hp_cx[b + 2];
  g_hp_pln = hp_cx[b + 3];
  g_hp_hop = hp_cx[b + 4];
  g_hp_ht = hp_cx[b + 5];
  g_hp_hu0 = hp_cx[b + 6];
  g_hp_hv0 = hp_cx[b + 7];
  g_hp_hu1 = hp_cx[b + 8];
  g_hp_hn1 = hp_cx[b + 9];
  g_hp_fd = hp_cx[b + 10];
  g_hp_dead = hp_cx[b + 11];
  g_hp_dt = hp_cx[b + 12];
  g_hp_rq = hp_cx[b + 13];
  g_hp_idle = hp_cx[b + 14];
  g_hp_st = hp_cx[b + 15];
  g_hp_cvmin = hp_cx[b + 16];
  g_hp_cu = hp_cx[b + 17];
  g_hp_cv = hp_cx[b + 18];
  g_hp_best_n = hp_cx[b + 19];
  g_hp_score = hp_cx[b + 20];
  g_hp_pnmin = hp_cx[b + 21];
  g_hp_coins_run = hp_cx[b + 22];
  g_hp_ch = hp_cx[b + 23];
  g_hp_bump = hp_cx[b + 24];
  g_hp_shk = hp_cx[b + 25];
  g_hp_nl = hp_cx[b + 26];
  g_hp_nc = hp_cx[b + 27];
  g_hp_ttl = hp_cx[b + 28];
  g_hp_mtmr = hp_cx[b + 29];
  g_hp_grab = hp_cx[b + 30];
  g_hp_flash = hp_cx[b + 31];
  g_hp_t1 = hp_cx[b + 32];
  g_hp_warn = hp_cx[b + 33];
  g_hp_e0u = hp_cx[b + 34];
  g_hp_e0v = hp_cx[b + 35];
  g_hp_e0z = hp_cx[b + 36];
  g_hp_tdir = hp_cx[b + 37];
  g_hp_pp = hp_cx[b + 38];
  g_hp_ef = hp_cx[b + 39];
  g_hp_cp = p; g_hp_pb = p * NPP; g_hp_mb = p * 4;
  (g_hp_np == 2 && !g_hp_bt) ? (
    p == 0 ? ( g_hp_xl = 18; g_hp_xr = 448; HP_OX = 223; ) : ( g_hp_xl = 452; g_hp_xr = 882; HP_OX = 657; );
  ) : ( g_hp_xl = 18; g_hp_xr = 882; HP_OX = 430; );
  (hp_rqin[p] > 0 && g_hp_rq == 0) ? ( g_hp_rq = hp_rqin[p]; hp_rqin[p] = 0; );
);

function hp_dswap(p) local(b, t)
(
  b = p * 48;
  t = g_hp_pu; g_hp_pu = hp_cx[b + 0]; hp_cx[b + 0] = t;
  t = g_hp_pv; g_hp_pv = hp_cx[b + 1]; hp_cx[b + 1] = t;
  t = g_hp_pln; g_hp_pln = hp_cx[b + 3]; hp_cx[b + 3] = t;
  t = g_hp_hop; g_hp_hop = hp_cx[b + 4]; hp_cx[b + 4] = t;
  t = g_hp_ht; g_hp_ht = hp_cx[b + 5]; hp_cx[b + 5] = t;
  t = g_hp_fd; g_hp_fd = hp_cx[b + 10]; hp_cx[b + 10] = t;
  t = g_hp_dead; g_hp_dead = hp_cx[b + 11]; hp_cx[b + 11] = t;
  t = g_hp_dt; g_hp_dt = hp_cx[b + 12]; hp_cx[b + 12] = t;
