function draw_hop() local(dt, p, np, lead, act, avgu, na, m, st0, anyst, anyd, w, d0, d1, i, x, sc)
(
  g_hp_ready < 1 ? (
    sv7[63] !== 8 ? ( sv7[63] !== 7 ? memset(sv7, 0, 32); sv7[63] = 8; );
    sv7[2] = 2047; sv7[5] = 1023;
    sv7[62] !== 1 ? ( sv7[20] = 0; sv7[21] = 1; sv7[62] = 1; );
    g_hp_blv = sv7[6]; g_hp_bch = sv7[3]; g_hp_bch2 = sv7[21];
    hp_start();
  );
  np = g_hp_np; g_hp_fr += 1;
  dt = min(0.05, g_dt);
  hp_ctrl();
  p = 0;
  loop(np,
    hp_ctxload(p);
    g_hp_bt ? ( g_hp_cvmin = g_hp_shc; g_hp_cv = g_hp_scv; g_hp_cu = g_hp_scu; );
    (!g_hp_bt || p == 0) ? hp_clickp(p);
    !g_pz ? (
      hp_light(max(0, g_hp_best_n - 10));
      hp_player(dt);
      hp_updlanes(dt);
      hp_meteors(dt);
      hp_updparts(dt);
      g_hp_shk *= exp(-dt * 8);
      g_hp_bump > 0 ? g_hp_bump -= dt;
      g_hp_ttl > 0 ? g_hp_ttl -= dt;
      loop(40, g_hp_cv + HP_BASE + ceil(24 / HP_SC) > g_hp_gn ? ( hp_gen(g_hp_gn + 1); ); );
      !g_hp_bt ? (
        g_hp_cu += (8.5 + max(-5, min(5, (g_hp_pu - 8.5) * 0.7)) - g_hp_cu) * min(1, dt * 5);
        g_hp_cv += (max(g_hp_pv, g_hp_cvmin) - g_hp_cv) * min(1, dt * 6);
        g_hp_cv < g_hp_cvmin ? g_hp_cv = g_hp_cvmin;
      );
    );
    hp_ctxsave(p);
    p += 1;
  );
  g_hp_bt && !g_pz ? (
    lead = (hp_qa[0] && hp_qa[1]) ? max(hp_cx[1], hp_cx[49]) : hp_qa[0] ? hp_cx[1] : hp_qa[1] ? hp_cx[49] : max(hp_cx[1], hp_cx[49]);
    act = (hp_cx[15] == 1 || hp_cx[63] == 1) && (hp_qa[0] || hp_qa[1]);
    act ? g_hp_shc += dt * (0.9 + min(0.9, max(hp_cx[20], hp_cx[68]) * 0.012));
    g_hp_shc = max(g_hp_shc, lead);
    g_hp_scv += (g_hp_shc - g_hp_scv) * min(1, dt * 6); g_hp_scv < g_hp_shc ? g_hp_scv = g_hp_shc;
    avgu = 0; na = 0;
    (hp_qa[0] || !hp_qa[1]) ? ( avgu += hp_cx[0]; na += 1; );
    (hp_qa[1] || !hp_qa[0]) ? ( avgu += hp_cx[48]; na += 1; );
    g_hp_scu += (8.5 + max(-5, min(5, (avgu / na - 8.5) * 0.7)) - g_hp_scu) * min(1, dt * 5);
  );
  (np == 2 && !g_hp_bt) ? (
    p = 0;
    loop(2, hp_ctxload(p); hp_light(max(0, g_hp_best_n - 10)); hp_panerender(p); hp_ctxsave(p); p += 1; );
  ) : (
    hp_ctxload(0);
    g_hp_bt ? (
      g_hp_cu = g_hp_scu; g_hp_cv = g_hp_scv;
      g_hp_best_n = max(hp_cx[19], hp_cx[67]);
      g_hp_ef = max(hp_cx[39], hp_cx[87]); g_hp_flash = max(hp_cx[31], hp_cx[79]);
      g_hp_dead = 0; g_hp_dt = 0; g_hp_st = max(hp_cx[15], hp_cx[63]);
      hp_light(max(0, g_hp_best_n - 10));
      hp_panerender(0);
      hp_cx[31] *= exp(-g_dt * 12); hp_cx[79] *= exp(-g_dt * 12);
    ) : (
      hp_light(max(0, g_hp_best_n - 10));
      hp_panerender(0);
      hp_ctxsave(0);
    );
  );
  hp_ctxload(0);
  d0 = hp_cx[11] > 0 && hp_cx[12] > (hp_cx[11] == 3 ? 2.3 : 1.1);
  d1 = hp_cx[59] > 0 && hp_cx[60] > (hp_cx[59] == 3 ? 2.3 : 1.1);
  g_hp_alld = np == 1 ? d0 : g_hp_bt ? (d0 || d1) : (d0 && d1);
  anyst = hp_cx[15] == 1 || (np == 2 && hp_cx[63] == 1);
  anyd = hp_cx[11] > 0 || (np == 2 && hp_cx[59] > 0);
  button("< Games", 18, 14, 96, 36, 0.62, 0.86, 0.3) ? g_screen = 0;
  button(snd_lbl(), 774, HINT_Y - 4, 108, 28, 0.6, 1, 0.75) ? sv2[13] = snd_next();
  button(sv7[8] == 0 ? "1 player" : sv7[8] == 1 ? "2 players: split" : "2 players: battle", 126, 10, 150, 28, 0.62, 0.86, 0.3) ? ( sv7[8] = (sv7[8] + 1) % 3; hp_start(); );
  hp_otxt("HOP TO IT", 450, 8, 34, 1, 1, 1, 0.25, 0.5, 0.12, 3);
  gfx_set(0.98, 0.78, 0.15, 1); fill_rr(786, 20, 24, 24, 5);
  gfx_set(1, 0.93, 0.5, 1); fill_rr(791, 25, 14, 14, 3);
  font(18, 'b'); gfx_set(1, 1, 1, 1); sprintf(#hp_s2, "%d", sv7[1] + hp_cx[22] + (np == 2 ? hp_cx[70] : 0)); txt_l(#hp_s2, 818, 21);
  font(10, 0); hp_hasc(11 + g_hp_lv) ? ( gfx_set(0.6, 0.95, 0.5, 1); txt_r("Bonus hopper unlocked!", 882, 47); ) : ( gfx_set(1, 0.88, 0.45, 1); txt_r(sprintf(#hp_sb, "Bonus hopper: %d/%d coins", sv7[30 + g_hp_lv], HP_BCOIN), 882, 47); );
  font(11, 0); gfx_set(0.85, 0.9, 0.75, 1); txt_l(sprintf(#hp_s3, "%s   Best %d   %s, %s", hp_wn[g_hp_lv], sv7[10 + g_hp_lv], g_hp_se == 0 ? "Spring" : g_hp_se == 1 ? "Summer" : g_hp_se == 2 ? "Autumn" : "Winter", g_hp_tod < 0.1 ? "dawn" : g_hp_tod < 0.62 ? "day" : g_hp_tod < 0.82 ? "sunset" : g_hp_tod < 0.92 ? "dusk" : "night"), 126, 42);
  np == 1 ? (
    sprintf(#hp_s1, "%d", g_hp_score);
    hp_otxt(#hp_s1, 76, 72, 46, 1, 1, 1, 0.2, 0.3, 0.1, 4);
  ) : g_hp_bt ? (
    sprintf(#hp_s1, "%d", hp_cx[20]); hp_otxt(#hp_s1, 70, 72, 44, 1, 1, 1, 0.6, 0.15, 0.1, 4);
    sprintf(#hp_s1, "%d", hp_cx[68]); hp_otxt(#hp_s1, 830, 72, 44, 1, 1, 1, 0.15, 0.3, 0.7, 4);
  ) : (
    sprintf(#hp_s1, "%d", hp_cx[20]); hp_otxt(#hp_s1, 76, 72, 44, 1, 1, 1, 0.6, 0.15, 0.1, 4);
    sprintf(#hp_s1, "%d", hp_cx[68]); hp_otxt(#hp_s1, 510, 72, 44, 1, 1, 1, 0.15, 0.3, 0.7, 4);
    font(11, 'b'); gfx_set(0.95, 0.5, 0.45, 1); txt_l("P1  W A S D", 26, 616); gfx_set(0.55, 0.75, 1, 1); txt_l("P2  ARROW KEYS", 462, 616);
  );
  p = 0;
  loop(np,
    hp_cx[p * 48 + 28] > 0 ? (
      sprintf(#hp_s6, "%s", hp_cx[p * 48 + 27] >= 0 && hp_cx[p * 48 + 26] < 0 ? "NEW HOPPER UNLOCKED!" : hp_cx[p * 48 + 26] >= 0 && hp_cx[p * 48 + 27] < 0 ? "NEW WORLD UNLOCKED!" : "NEW UNLOCKS!");
      hp_otxt(#hp_s6, np == 1 || g_hp_bt ? 450 : p == 0 ? 233 : 667, 56 + (hp_cx[p * 48 + 28] < 0.4 ? (0.4 - hp_cx[p * 48 + 28]) * -60 : 0) + p * (g_hp_bt ? 30 : 0), np == 1 ? 24 : 18, 1, 0.9, 0.3, 0.45, 0.25, 0.05, 3);
    );
    p += 1;
  );
  (!anyst && !anyd) ? hp_startui();
  (np == 1 && g_hp_alld) ? (
    gfx_set(0, 0, 0, 0.45); gfx_rect(sx(BRD_X), sy(BRD_Y), BRD_W * g_s, BRD_H * g_s);
    gfx_set(0.12, 0.14, 0.18, 1); fill_rr(290, 200, 320, 290, 12);
    gfx_set(0.62, 0.86, 0.3, 1); outline_rr(290, 200, 320, 290, 12);
    hp_otxt(g_hp_dead == 1 ? "SQUASHED!" : g_hp_dead == 2 ? "SPLASH!" : g_hp_dead == 4 ? "TRAIN WRECK!" : "CAUGHT!", 450, 214, 36, 1, 1, 1, 0.5, 0.15, 0.1, 3);
    font(18, 'b'); gfx_set(1, 1, 1, 1); txt_c(sprintf(#hp_s4, "Score %d", g_hp_score), 290, 274, 320, 28);
    font(14, 0); gfx_set(0.8, 0.9, 0.7, 1); txt_c(sprintf(#hp_s5, "Best %d     Coins +%d", sv7[10 + g_hp_lv], g_hp_coins_run), 290, 304, 320, 22);
    g_hp_nc >= 0 ? ( font(14, 'b'); gfx_set(1, 0.85, 0.3, 1); txt_c(sprintf(#hp_s9, "New hopper: %s!", hp_cnm[g_hp_nc]), 290, 332, 320, 20); );
    g_hp_nl >= 0 ? ( font(14, 'b'); gfx_set(0.6, 0.95, 0.5, 1); txt_c(sprintf(#hp_sa, "New world: %s!", hp_wn[g_hp_nl]), 290, 354, 320, 20); );
    button("Hop again", 330, 396, 240, 50, 0.62, 0.86, 0.3) ? ( hp_start(); );
    font(12, 0); gfx_set(0.8, 0.88, 0.7, 1); txt_c("or press Enter", 290, 454, 320, 18);
  );
  (np == 2 && g_hp_alld) ? (
    w = 2;
    g_hp_bt ? (
      (hp_cx[11] > 0 && hp_cx[59] == 0) ? w = 1 : (hp_cx[59] > 0 && hp_cx[11] == 0) ? w = 0 : ( hp_cx[20] > hp_cx[68] ? w = 0 : hp_cx[68] > hp_cx[20] ? w = 1 );
    ) : ( hp_cx[20] > hp_cx[68] ? w = 0 : hp_cx[68] > hp_cx[20] ? w = 1 );
    hp_result2(w);
  );
