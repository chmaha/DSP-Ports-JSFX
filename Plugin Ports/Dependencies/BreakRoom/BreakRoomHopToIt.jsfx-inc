hp_tc(9, 0.9, 0.66, 1, 0.85, 0.6, 0.98, 0.3, 0.3, 0.45, 0.4, 0.9, 1, 0.36, 0.86, 0.98, 0.9, 0.5, 0.6, 9, 0, 1);
hp_ww[0] = 0.5; hp_ww[1] = 0.32; hp_ww[2] = 0.5; hp_ww[3] = 0.2; hp_ww[4] = 0.35; hp_ww[5] = 0.4; hp_ww[6] = 0.6; hp_ww[7] = 0.15; hp_ww[8] = 0.3; hp_ww[9] = 0.55;
hp_ww[10] = 0.5; hp_ww[11] = 0.3; hp_ww[12] = 0.3; hp_ww[13] = 0.5; hp_ww[14] = 0.35; hp_ww[15] = 0.5; hp_ww[16] = 0.45; hp_ww[17] = 0.3; hp_ww[18] = 0.4; hp_ww[19] = 0.4;
hp_wn[0] = "Meadow"; hp_wn[1] = "Dusty Dunes"; hp_wn[2] = "Frosty Fields"; hp_wn[3] = "Neon City"; hp_wn[4] = "Jungle Jumble"; hp_wn[5] = "Sugar Rush"; hp_wn[6] = "Magma Mile"; hp_wn[7] = "Moon Hop"; hp_wn[8] = "Spooky Spinney"; hp_wn[9] = "Rainbow Run";
hp_cnm[0] = "Chicken"; hp_cnm[1] = "Cat"; hp_cnm[2] = "Penguin"; hp_cnm[3] = "Robot"; hp_cnm[4] = "Frog"; hp_cnm[5] = "Bunny"; hp_cnm[6] = "Pig"; hp_cnm[7] = "Panda"; hp_cnm[8] = "Cow"; hp_cnm[9] = "Duck"; hp_cnm[10] = "Sheep"; hp_cnm[11] = "Fox"; hp_cnm[12] = "Llama"; hp_cnm[13] = "Polar Bear"; hp_cnm[14] = "Raccoon"; hp_cnm[15] = "Monkey"; hp_cnm[16] = "Unicorn"; hp_cnm[17] = "Dragon"; hp_cnm[18] = "Alien"; hp_cnm[19] = "Ghost"; hp_cnm[20] = "Parrot";
