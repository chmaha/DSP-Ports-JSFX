function hp_tc(lv, a1, a2, a3, b1, b2, b3, c1, c2, c3, d1, d2, d3, e1, e2, e3, f1, f2, f3, st, wt, br) local(o)
(
  o = lv * 24;
  hp_thv[o] = a1; hp_thv[o + 1] = a2; hp_thv[o + 2] = a3; hp_thv[o + 3] = b1; hp_thv[o + 4] = b2; hp_thv[o + 5] = b3;
  hp_thv[o + 6] = c1; hp_thv[o + 7] = c2; hp_thv[o + 8] = c3; hp_thv[o + 9] = d1; hp_thv[o + 10] = d2; hp_thv[o + 11] = d3;
  hp_thv[o + 12] = e1; hp_thv[o + 13] = e2; hp_thv[o + 14] = e3; hp_thv[o + 15] = f1; hp_thv[o + 16] = f2; hp_thv[o + 17] = f3;
  hp_thv[o + 18] = st; hp_thv[o + 19] = wt; hp_thv[o + 20] = br;
);
function hp_ct(i, r, g, b, fr, fg, fb) ( hp_cbr[i] = r; hp_cbg[i] = g; hp_cbb[i] = b; hp_cfr[i] = fr; hp_cfg[i] = fg; hp_cfb[i] = fb; );
function hp_mod(x, y) ( x - y * floor(x / y); );
hp_wtb = alloc(HP_NLV); hp_wta = alloc(HP_NLV); hp_wsn = alloc(HP_NLV);
hp_wtb[0] = 0.14; hp_wta[0] = 1;   hp_wsn[0] = 0;
hp_wtb[1] = 0.45; hp_wta[1] = 1; hp_wsn[1] = 1;
hp_wtb[2] = 0.22; hp_wta[2] = 1; hp_wsn[2] = 3;
hp_wtb[3] = 0.95; hp_wta[3] = 1; hp_wsn[3] = 2;
hp_wtb[4] = 0.3;  hp_wta[4] = 1; hp_wsn[4] = 1;
hp_wtb[5] = 0.3;  hp_wta[5] = 1; hp_wsn[5] = 0;
hp_wtb[6] = 0.78; hp_wta[6] = 1; hp_wsn[6] = 2;
hp_wtb[7] = 0.95; hp_wta[7] = 1; hp_wsn[7] = 3;
hp_wtb[8] = 0.88; hp_wta[8] = 1; hp_wsn[8] = 2;
hp_wtb[9] = 0.3;  hp_wta[9] = 1; hp_wsn[9] = 0;
hp_wsf = alloc(HP_NLV);
hp_wsf[0] = 1; hp_wsf[1] = 0.4; hp_wsf[4] = 0.85; hp_wsf[8] = 0.6;
hp_tk = alloc(32);
hp_tk[0] = 0;    hp_tk[1] = 1;    hp_tk[2] = 0.8;  hp_tk[3] = 0.78;
hp_tk[4] = 0.12; hp_tk[5] = 1;    hp_tk[6] = 0.97; hp_tk[7] = 0.9;
hp_tk[8] = 0.4;  hp_tk[9] = 1.04; hp_tk[10] = 1.04; hp_tk[11] = 1.04;
hp_tk[12] = 0.62; hp_tk[13] = 1;  hp_tk[14] = 0.96; hp_tk[15] = 0.86;
hp_tk[16] = 0.74; hp_tk[17] = 1;  hp_tk[18] = 0.7;  hp_tk[19] = 0.5;
hp_tk[20] = 0.84; hp_tk[21] = 0.62; hp_tk[22] = 0.5; hp_tk[23] = 0.72;
hp_tk[24] = 0.95; hp_tk[25] = 0.36; hp_tk[26] = 0.44; hp_tk[27] = 0.74;
hp_tk[28] = 1;    hp_tk[29] = 1;    hp_tk[30] = 0.8; hp_tk[31] = 0.78;

function hp_light(prog) local(p, i, a, b, f, k, sr, sg, sb)
(
  p = hp_mod(prog / 130 + hp_wtb[g_hp_lv], 1);
  g_hp_se = (hp_wsn[g_hp_lv] + floor(prog / 130 + hp_wtb[g_hp_lv])) % 4;
  g_hp_tod = p;
  i = 0; k = 0;
  loop(7, (p >= hp_tk[i * 4] && p <= hp_tk[i * 4 + 4]) ? k = i; i += 1; );
  a = k * 4; b = k * 4 + 4;
  f = (p - hp_tk[a]) / max(0.0001, hp_tk[b] - hp_tk[a]); f = f * f * (3 - 2 * f);
  g_hp_lr = hp_tk[a + 1] + (hp_tk[b + 1] - hp_tk[a + 1]) * f;
  g_hp_lg = hp_tk[a + 2] + (hp_tk[b + 2] - hp_tk[a + 2]) * f;
  g_hp_lb = hp_tk[a + 3] + (hp_tk[b + 3] - hp_tk[a + 3]) * f;
  sr = g_hp_se == 0 ? 0.98 : g_hp_se == 1 ? 1.03 : g_hp_se == 2 ? 1.07 : 0.93;
  sg = g_hp_se == 0 ? 1.03 : g_hp_se == 1 ? 1 : g_hp_se == 2 ? 0.93 : 0.98;
  sb = g_hp_se == 0 ? 0.98 : g_hp_se == 1 ? 0.92 : g_hp_se == 2 ? 0.8 : 1.08;
  g_hp_lr *= sr; g_hp_lg *= sg; g_hp_lb *= sb;
  g_hp_dk = max(0, min(1, (0.88 - (g_hp_lr + g_hp_lg + g_hp_lb) / 3) * 2.4));
  g_hp_lr += (1 - g_hp_lr) * 0.16; g_hp_lg += (1 - g_hp_lg) * 0.16; g_hp_lb += (1 - g_hp_lb) * 0.16;
  g_hp_sl = 0.7 + 1.2 * (p > 0.62 && p < 0.9 ? (1 - abs(p - 0.76) / 0.14) : p < 0.12 ? 0.6 : 0) ;
);
function hp_tvs(k) local(v, m, tr, f)
(
  v = hp_thv[g_hp_lv * 24 + k];
  k < 6 ? (
    f = hp_wsf[g_hp_lv];
    (g_hp_lv == 2) ? (
      g_hp_se != 3 ? ( tr = k % 3 == 0 ? 0.55 : k % 3 == 1 ? 0.78 : 0.38; v += (tr - v) * (g_hp_se == 2 ? 0.45 : 0.6); );
    ) : f > 0 ? (
      m = (g_hp_se == 2 ? 0.62 : g_hp_se == 3 ? 0.92 : g_hp_se == 0 ? 0.35 : 0) * f;
      tr = g_hp_se == 2 ? (k % 3 == 0 ? 0.8 : k % 3 == 1 ? 0.68 : 0.3) : g_hp_se == 3 ? (k % 3 == 0 ? 0.94 : k % 3 == 1 ? 0.96 : 1) : (k % 3 == 0 ? 0.6 : k % 3 == 1 ? 0.92 : 0.4);
      v += (tr - v) * m;
    );
  );
  v;
);
function hp_tv(k) ( hp_tvs(k); );

hp_tc(0, 0.68, 0.88, 0.33, 0.64, 0.84, 0.3, 0.3, 0.32, 0.4, 0.4, 0.82, 1, 0.36, 0.78, 0.98, 0.56, 0.31, 0.29, 0, 0, 1);
