    hp_hasl(g_hp_blv) ? ( sv7[6] = g_hp_blv; hp_start(); );
  );
  d = hp_hcard(h2 ? 316 : 452, 566, h2 ? 280 : 420, h2 ? "PLAYER 1" : "HOPPER", g_hp_bch, h2 ? 0.95 : 1, h2 ? 0.4 : 0.8, h2 ? 0.35 : 0.3);
  d != 0 ? (
    g_hp_bch = (g_hp_bch + d + HP_NCH) % HP_NCH;
    hp_hasc(g_hp_bch) ? ( sv7[3] = g_hp_bch; hp_setch(0, g_hp_bch); );
  );
  h2 ? (
