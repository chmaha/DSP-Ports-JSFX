  t = g_hp_e0v; g_hp_e0v = hp_cx[b + 35]; hp_cx[b + 35] = t;
  t = g_hp_e0z; g_hp_e0z = hp_cx[b + 36]; hp_cx[b + 36] = t;
  t = g_hp_ef; g_hp_ef = hp_cx[b + 39]; hp_cx[b + 39] = t;
  t = g_hp_st; g_hp_st = hp_cx[b + 15]; hp_cx[b + 15] = t;
