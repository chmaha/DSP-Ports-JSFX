  hp_otxt(w == 2 ? "DRAW!" : w == 0 ? "PLAYER 1 WINS!" : "PLAYER 2 WINS!", 450, 216, 34, 1, 1, 1, w == 0 ? 0.6 : 0.2, 0.2, w == 1 ? 0.7 : 0.2, 3);
  font(18, 'b'); gfx_set(0.95, 0.4, 0.35, 1); txt_c(sprintf(#hp_s4, "Player 1:  %d", s0), 270, 282, 360, 26);
  gfx_set(0.45, 0.7, 1, 1); txt_c(sprintf(#hp_s5, "Player 2:  %d", s1), 270, 312, 360, 26);
