function pv_hop(x, y, w, h) local(ox0, oy0, os, k)
(
  g_hp_ready < 1 ? (
    sv7[63] !== 8 ? ( sv7[63] !== 7 ? memset(sv7, 0, 32); sv7[63] = 8; );
    sv7[2] = 2047; sv7[5] = 1023;
    sv7[62] !== 1 ? ( sv7[20] = 0; sv7[21] = 1; sv7[62] = 1; );
    g_hp_blv = sv7[6]; g_hp_bch = sv7[3]; g_hp_bch2 = sv7[21];
    hp_start();
  );
  hp_light(60);
  g_hp_xl = 18; g_hp_xr = 882; HP_OX = 430; g_hp_bt = 0;
  gfx_setimgdim(IMG_HP, 432, 292);
  g_pv_dst2 = gfx_dest; ox0 = g_ox; oy0 = g_oy; os = g_s;
  gfx_dest = IMG_HP; g_s = 0.5; g_ox = -BRD_X * 0.5; g_oy = -BRD_Y * 0.5;
  gfx_mode = 0; gfx_a = 1;
  hp_scene();
  g_ox = ox0; g_oy = oy0; g_s = os; gfx_dest = g_pv_dst2;
  pv_begin(x, y, w, h, 1);
  gfx_mode = 4; gfx_a = 1;
  gfx_blit(IMG_HP, 1, 0, 0, 0, 432, 292, sx(BRD_X), sy(BRD_Y), BRD_W * g_s, BRD_H * g_s);
  gfx_mode = 0;
  pv_end();
);
