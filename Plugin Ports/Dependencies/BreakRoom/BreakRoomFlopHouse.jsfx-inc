      while (x < 930) (
        k = 0;
        loop(5,
          gfx_set(0.72, 0.56, 0.24, 0.5);
          gfx_arc(sx(x), sy(66 + y + 45), (45 - k * 9) * g_s, -$pi * 0.5, $pi * 0.5, 1);
