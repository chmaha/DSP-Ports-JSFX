    i = 0; loop(110, gfx_set(1, 1, 1, 0.3 + hash(i) * 0.6); gfx_rect(sx(hash(i + 1) * 900), sy(66 + hash(i + 2) * 150), g_s, g_s); i += 1; );
    gfx_set(0.95, 0.93, 0.8, 1); gfx_circle(sx(720), sy(106), 20 * g_s, 1, 1);
    gfx_set(0.04, 0.05, 0.13, 1); gfx_circle(sx(712), sy(100), 18 * g_s, 1, 1);
    j = 0;
    loop(2,
      x = -10 - j * 22;
      while (x < 900) (
        a = 40 + hash(x * 0.3 + j) * (j ? 150 : 100);
        k = 26 + hash(x + 5 + j) * 40;
