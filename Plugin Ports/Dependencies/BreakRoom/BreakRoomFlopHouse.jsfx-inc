function pk_wall(v, bw, bh) local(x, y, i, j, a, r, g, b, k)
(
  v == 0 ? (
    gfx_set(0.2, 0.09, 0.06, 1); gfx_rect(0, 0, bw, bh);
    y = 0; j = 0;
    while (y < 340) (
      x = (j & 1) * -26;
      while (x < 900) (
        k = hash(x * 0.37 + y * 1.3);
        gfx_set(0.3 + k * 0.17, 0.13 + k * 0.05, 0.08 + k * 0.03, 1);
        gfx_rect(sx(x), sy(66 + y), 49 * g_s, 21 * g_s);
        x += 52;
      );
      y += 24; j += 1;
    );
    gfx_set(0.14, 0.08, 0.05, 1); gfx_rect(sx(560), sy(136), 280 * g_s, 8 * g_s);
    i = 0;
    loop(13,
      r = hash(i + 2); g = hash(i + 7); b = hash(i + 11);
      a = 34 + hash(i + 3) * 22;
      gfx_set(r * 0.4, 0.2 + g * 0.4, 0.05 + b * 0.25, 1);
      fill_rr(574 + i * 20, 136 - a, 12, a, 3);
      gfx_set(1, 1, 1, 0.2); gfx_rect(sx(576 + i * 20), sy(146 - a), 2 * g_s, (a - 18) * g_s);
      i += 1;
    );
    gfx_set(0.05, 0.05, 0.05, 1); gfx_circle(sx(125), sy(140), 46 * g_s, 1, 1);
    gfx_set(0.8, 0.75, 0.6, 1); gfx_circle(sx(125), sy(140), 37 * g_s, 1, 1);
    gfx_set(0.1, 0.1, 0.1, 1); i = 0; loop(10, gfx_triangle(sx(125), sy(140), sx(125 + 37 * cos(i * 0.628)), sy(140 + 37 * sin(i * 0.628)), sx(125 + 37 * cos(i * 0.628 + 0.314)), sy(140 + 37 * sin(i * 0.628 + 0.314))); i += 1; );
    gfx_set(0.8, 0.15, 0.12, 1); gfx_circle(sx(125), sy(140), 7 * g_s, 1, 1);
    gfx_mode = 1;
    gfx_set(1, 0.1, 0.3, 0.1); gfx_circle(sx(345), sy(112), 60 * g_s, 1, 1);
    gfx_mode = 0;
    gfx_setfont(4, "Arial Black", 30 * g_s, 'b'); gfx_set(1, 0.35, 0.5, 1); txt_c("OPEN", 285, 90, 120, 44);
    gfx_set(1, 0.8, 0.85, 0.7); gfx_setfont(4, "Arial Black", 29 * g_s, 'b'); txt_c("OPEN", 285, 90, 120, 44);
  ) : v == 1 ? (
    gfx_set(0.16, 0.08, 0.05, 1); gfx_rect(0, 0, bw, bh);
    x = 0; i = 0;
    while (x < 900) (
      k = hash(i + 4);
      gfx_set(0.26 + k * 0.1, 0.13 + k * 0.05, 0.06 + k * 0.03, 1);
