@init
function pk_top(m, n) local(v, r, c)
(
  v = 0; r = 12; c = 0;
  while (c < n && r >= 0) ( (m >> r) & 1 ? ( v = v * 13 + r; c += 1; ); r -= 1; );
  while (c < n) ( v *= 13; c += 1; );
  v;
);

function pk_eval(n) local(i, c, r, s, mask, fs, q, t, t2, p1, p2, v, hi)
(
  memset(pk_rc, 0, 13); memset(pk_sm, 0, 4); memset(pk_sc, 0, 4);
  mask = 0; i = 0;
  loop(n,
    c = pk_h7[i]; r = c % 13; s = (c - r) / 13;
    pk_rc[r] += 1; pk_sm[s] |= 1 << r; pk_sc[s] += 1; mask |= 1 << r;
    i += 1;
  );
  fs = -1; s = 0;
  loop(4, pk_sc[s] >= 5 ? fs = s; s += 1; );
  q = -1; t = -1; t2 = -1; p1 = -1; p2 = -1; r = 12;
  loop(13,
    c = pk_rc[r];
    c == 4 ? q = r :
    c == 3 ? ( t < 0 ? t = r : t2 < 0 ? t2 = r; ) :
    c == 2 ? ( p1 < 0 ? p1 = r : p2 < 0 ? p2 = r; );
    r -= 1;
  );
  hi = fs >= 0 ? pk_sth[pk_sm[fs]] : 0;
  hi ? v = 8 * 371293 + (hi - 1) * 28561 :
  q >= 0 ? v = 7 * 371293 + q * 28561 + pk_top(mask - (1 << q), 1) * 2197 :
  (t >= 0 && (t2 >= 0 || p1 >= 0)) ? v = 6 * 371293 + t * 28561 + max(t2, p1) * 2197 :
  fs >= 0 ? v = 5 * 371293 + pk_top(pk_sm[fs], 5) :
  (hi = pk_sth[mask]) ? v = 4 * 371293 + (hi - 1) * 28561 :
  t >= 0 ? v = 3 * 371293 + t * 28561 + pk_top(mask - (1 << t), 2) * 169 :
  p2 >= 0 ? v = 2 * 371293 + p1 * 28561 + p2 * 2197 + pk_top(mask - (1 << p1) - (1 << p2), 1) * 169 :
  p1 >= 0 ? v = 371293 + p1 * 28561 + pk_top(mask - (1 << p1), 3) * 13 :
  v = pk_top(mask, 5);
  v;
);

function pk_rs(r) ( r == 12 ? "ace" : r == 11 ? "king" : r == 10 ? "queen" : r == 9 ? "jack" : r == 8 ? "ten" : r == 7 ? "nine" : r == 6 ? "eight" : r == 5 ? "seven" : r == 4 ? "six" : r == 3 ? "five" : r == 2 ? "four" : r == 1 ? "three" : "two"; );
function pk_rp2(r) ( r == 12 ? "aces" : r == 11 ? "kings" : r == 10 ? "queens" : r == 9 ? "jacks" : r == 8 ? "tens" : r == 7 ? "nines" : r == 6 ? "eights" : r == 5 ? "sevens" : r == 4 ? "sixes" : r == 3 ? "fives" : r == 2 ? "fours" : r == 1 ? "threes" : "twos"; );

function pk_name(v, d) local(c, a, b)
(
  c = floor(v / 371293); v -= c * 371293;
  a = floor(v / 28561); b = floor((v - a * 28561) / 2197);
  c == 8 ? ( a == 12 ? strcpy(d, "Royal flush") : sprintf(d, "Straight flush, %s high", pk_rs(a)); ) :
  c == 7 ? sprintf(d, "Four %s", pk_rp2(a)) :
  c == 6 ? sprintf(d, "Full house, %s over %s", pk_rp2(a), pk_rp2(b)) :
  c == 5 ? sprintf(d, "Flush, %s high", pk_rs(a)) :
  c == 4 ? sprintf(d, "Straight, %s high", pk_rs(a)) :
  c == 3 ? sprintf(d, "Three %s", pk_rp2(a)) :
  c == 2 ? sprintf(d, "Two pair, %s and %s", pk_rp2(a), pk_rp2(b)) :
  c == 1 ? sprintf(d, "Pair of %s", pk_rp2(a)) :
  sprintf(d, "%s high", a == 12 ? "Ace" : a == 11 ? "King" : a == 10 ? "Queen" : a == 9 ? "Jack" : a == 8 ? "Ten" : a == 7 ? "Nine" : a == 6 ? "Eight" : a == 5 ? "Seven" : "Low cards");
  d;
);

function pk_tables() local(m, h, r, a, b, ra, rb, v, g, hiv)
(
  m = 0;
  loop(8192,
    r = 0; h = 12;
    while (h >= 4 && !r) ( ((m >> (h - 4)) & 31) == 31 ? r = h + 1; h -= 1; );
    (!r && (m & 4111) == 4111) ? r = 4;
    pk_sth[m] = r;
    m += 1;
  );
  a = 0;
  loop(52,
    b = 0;
    loop(52,
      ra = a % 13; rb = b % 13;
      hiv = max(ra, rb);
      v = hiv == 12 ? 10 : hiv == 11 ? 8 : hiv == 10 ? 7 : hiv == 9 ? 6 : (hiv + 2) * 0.5;
      ra == rb ? v = max(5, v * 2) : (
        g = abs(ra - rb) - 1;
        v -= g == 0 ? 0 : g == 1 ? 1 : g == 2 ? 2 : g == 3 ? 4 : 5;
        (g <= 1 && hiv < 10) ? v += 1;
      );
      (floor(a / 13) == floor(b / 13) && a != b) ? v += 2;
      pk_cht[a * 52 + b] = v;
      b += 1;
    );
    a += 1;
  );
  g_pk_tb = 1;
);

function pk_bblind(i) ( i == 0 ? 50 : i == 1 ? 100 : i == 2 ? 150 : i == 3 ? 200 : i == 4 ? 300 : i == 5 ? 400 : i == 6 ? 600 : i == 7 ? 800 : i == 8 ? 1000 : i == 9 ? 1500 : i == 10 ? 2000 : i == 11 ? 3000 : i == 12 ? 5000 : 8000; );

function pk_wt(x) ( g_pk_t + x * g_pk_sp * (g_pk_fast ? 0.6 : 1) * (g_pk_skip ? 0.12 : pk_in[0] ? 1 : 0.8); );

function pk_fly(x0, y0, x1, y1, n, dur, dl) local(i, k)
(
  n = min(n, 9); k = 0;
  while (k < n) (
    i = g_pf_i; g_pf_i = (i + 1) % NPF;
    pf_x0[i] = x0 + (rand(1) - 0.5) * 14; pf_y0[i] = y0 + (rand(1) - 0.5) * 8;
    pf_x1[i] = x1 + (rand(1) - 0.5) * 18; pf_y1[i] = y1 + (rand(1) - 0.5) * 8;
    pf_t[i] = g_pk_t + dl + k * 0.035; pf_d[i] = dur; pf_k[i] = floor(rand(1) * 4); pf_on[i] = 1;
    k += 1;
  );
);

function pk_chipsnd(pan, n) local(k)
(
  k = 0;
  loop(min(n, 5),
    db_snd(1, 2500 + rand(1) * 1300, 0.09, 0.02 + k * 0.045, pan);
    k += 1;
  );
);

function pk_say(s, k, p) local(c)
(
  c = pk_ch[s];
  (s > 0 && c >= 0 && rand(1) < p && g_pk_t - g_pk_saylast > 2.4) ? (
    pk_sayl[s] = pk_ln[c * 16 + k * 2 + floor(rand(1) * 2) % 2];
    pk_sayt[s] = g_pk_t;
    g_pk_saylast = g_pk_t;
    g_pk_sayn = strlen(pk_sayl[s]);
  );
);

function pk_setmood(s, m, d) ( pk_mood[s] = m; pk_moodt[s] = g_pk_t + d; );

function pk_put(s, a) local(n)
(
  a = min(a, pk_st[s]);
  a > 0 ? (
    pk_st[s] -= a; pk_bet[s] += a; pk_tot[s] += a;
    pk_st[s] <= 0 ? pk_ai[s] = 1;
    n = 1 + floor(sqrt(a / g_pk_bb) * 1.4);
    pk_fly(pk_px[s], pk_py[s] - 8, pk_bx[s], pk_by[s], n, 0.26, 0);
    pk_bett[s] = g_pk_t + 0.26;
    pk_chipsnd((pk_bx[s] - 450) / 500, n);
  );
);

function pk_nextp(s) local(k)
(
  k = 0;
  while (k < 6) (
    s = (s + 1) % 6;
    !pk_out[s] && pk_ch[s] >= -1 && (s == 0 || pk_ch[s] >= 0) ? k = 99 : k += 1;
  );
  s;
);

function pk_count() local(i)
(
  g_pk_nin = 0; g_pk_nac = 0; i = 0;
  loop(6, pk_in[i] ? ( g_pk_nin += 1; !pk_ai[i] ? g_pk_nac += 1; ); i += 1; );
);

function pk_need(s) ( pk_in[s] && !pk_ai[s] && (g_pk_nac > 1 || pk_bet[s] < g_pk_cur) && (!pk_acted[s] || pk_bet[s] < g_pk_cur); );

function pk_find(from) local(k, s, r)
(
  pk_count();
  r = -1; k = 0; s = from;
  while (k < 6 && r < 0) (
    s = (s + 1) % 6;
    pk_need(s) ? r = s;
    k += 1;
  );
  r;
);

function pk_potall() local(i, p)
(
  p = 0; i = 0;
  loop(6, p += pk_tot[i]; i += 1; );
  p;
);

function pk_collect_begin() local(i, n)
(
  g_pk_s = 3;
  n = 0; i = 0;
  loop(6, pk_bet[i] > 0 ? n += 1; i += 1; );
  g_pk_w = pk_wt(n > 0 ? 1.1 : 0.4);
);

function pk_think(a) local(c, n)
(
  c = pk_ch[a];
  a > 0 ? (
    n = 1.7 + rand(1) * 1.1;
    (g_pk_cur - pk_bet[a]) > pk_st[a] * 0.4 ? n += 1.1;
    g_pk_t - g_pk_saylast < 0.05 ? n += 0.7 + 0.035 * g_pk_sayn;
    g_pk_w = pk_wt(n);
  );
);

function pk_round(first) local(i, a)
(
  i = 0;
  loop(6, pk_acted[i] = 0; pk_canr[i] = 1; i += 1; );
  g_pk_minr = g_pk_bb;
  a = pk_find(first);
  g_pk_a = a;
  a < 0 ? pk_collect_begin() : (
    g_pk_s = 2;
    pk_think(a);
    a == 0 ? g_pk_raise = 0;
  );
);

function pk_deal() local(i, j, k, c, s, nl)
(
  g_pk_hand += 1;
  sv2[47] += 1;
  (g_pk_hand > 1 && g_pk_hup <= 1) ? ( g_pk_bl += 1; g_pk_hup = g_pk_hupn; g_pk_blt = g_pk_t; ) : g_pk_hand > 1 ? g_pk_hup -= 1;
  g_pk_bb = pk_bblind(g_pk_bl); g_pk_sb = g_pk_bb * 0.5;
  i = 0;
  loop(52, pk_dk[i] = i; i += 1; );
  i = 51;
  while (i > 0) ( j = floor(rand(1) * (i + 1)); k = pk_dk[i]; pk_dk[i] = pk_dk[j]; pk_dk[j] = k; i -= 1; );
  g_pk_dp = 0; g_pk_nb = 0; g_pk_street = 0; g_pk_cur = g_pk_bb; g_pk_runout = 0; g_pk_lastr = -1; g_pk_bn = 0; g_pk_skip = 0; g_pk_raised = 0;
  g_pk_wamt = 0; g_pk_wn = 0; g_pk_rdm = 0; g_pk_wcat = -1; g_pk_paid = 0; g_pk_rot = 0; g_pk_alln = -9;
  memset(pk_bhl, 0, 5); memset(pk_hl, 0, 14); memset(pk_won, 0, 6); memset(pk_bt, 0, 5); memset(pk_tvp, 0, 6); memset(pk_rdt, 0, 6);
  g_pk_ceq = -1; g_pk_cstamp = -1;
  g_pk_hagg_adj = min(3, 6 * max(0, g_pk_haggn / max(4, g_pk_hand) - 0.3));
  nl = 0; i = 0;
  loop(6,
    pk_bet[i] = 0; pk_betv[i] = 0; pk_tot[i] = 0; pk_ai[i] = 0; pk_acted[i] = 0; pk_rf[i] = 0; pk_rp[i] = 0; pk_eqs[i] = 0.5; pk_tell[i] = 0; pk_foldt[i] = 0; pk_flipt[i] = 0; pk_scr[i] = 0; pk_lblt[i] = -9;
    pk_in[i] = (!pk_out[i] && (i == 0 || pk_ch[i] >= 0) && pk_st[i] > 0);
    pk_in[i] ? nl += 1;
    i += 1;
  );
  g_pk_btn = pk_nextp(g_pk_btn);
  s = g_pk_btn;
  g_pk_sbs = nl == 2 ? s : pk_nextp(s);
  g_pk_bbs = pk_nextp(g_pk_sbs);
  k = 0; s = pk_nextp(g_pk_btn);
  loop(nl,
    pk_c1[s] = pk_dk[g_pk_dp]; pk_cdt[s * 2] = g_pk_t + 0.12 * k * g_pk_sp;
    db_snd(14, 75, 0.1, 0.12 * k, (pk_bx[s] - 450) / 500);
    g_pk_dp += 1; k += 1; s = pk_nextp(s);
  );
  loop(nl,
    pk_c2[s] = pk_dk[g_pk_dp]; pk_cdt[s * 2 + 1] = g_pk_t + 0.12 * k * g_pk_sp;
    db_snd(14, 75, 0.1, 0.12 * k, (pk_bx[s] - 450) / 500);
    g_pk_dp += 1; k += 1; s = pk_nextp(s);
  );
  g_pk_cdn = 0;
  pk_put(g_pk_sbs, g_pk_sb);
  pk_put(g_pk_bbs, g_pk_bb);
  g_pk_s = 1;
  g_pk_w = g_pk_t + (0.12 * k + 0.4) * g_pk_sp;
);

function pk_startbet() local(i)
(
  g_pk_cur = g_pk_street == 0 ? g_pk_bb : 0;
  pk_round(g_pk_street == 0 ? g_pk_bbs : g_pk_btn);
);

function pk_equity(s, n, ranged) local(i, j, m, p, a, b, tr, ok, sc, sb, w, t, nb, bm, sq, ra, rb, x)
(
  memset(pk_mk, 0, 52);
  pk_mk[pk_c1[s]] = 1; pk_mk[pk_c2[s]] = 1;
  nb = g_pk_nb; bm = 0;
  i = 0; loop(nb, pk_mk[pk_bd[i]] = 1; bm |= 1 << (pk_bd[i] % 13); i += 1; );
  m = 0; i = 0;
  loop(52, !pk_mk[i] ? ( pk_pl[m] = i; m += 1; ); i += 1; );
  w = 0;
  loop(n,
    p = 0; j = 0;
    loop(6,
      (pk_in[j] && j != s) ? (
        tr = 0; ok = 0;
        while (!ok && tr < 8) (
          x = p + floor(rand(1) * (m - p)); a = pk_pl[x]; pk_pl[x] = pk_pl[p]; pk_pl[p] = a;
          x = p + 1 + floor(rand(1) * (m - p - 1)); b = pk_pl[x]; pk_pl[x] = pk_pl[p + 1]; pk_pl[p + 1] = b;
          ok = !ranged || pk_cht[a * 52 + b] >= pk_rf[j];
          (ok && ranged && nb >= 3 && pk_rp[j] && rand(1) < 0.8) ? (
            ra = a % 13; rb = b % 13;
            ok = ra == rb || ((bm >> ra) & 1) || ((bm >> rb) & 1) || (floor(a / 13) == floor(b / 13));
          );
          tr += 1;
        );
        pk_oa[j] = a; pk_ob[j] = b;
        p += 2;
      );
      j += 1;
    );
    i = nb;
    while (i < 5) (
      x = p + floor(rand(1) * (m - p)); a = pk_pl[x]; pk_pl[x] = pk_pl[p]; pk_pl[p] = a;
      pk_bd[i] = a; p += 1; i += 1;
    );
    pk_h7[2] = pk_bd[0]; pk_h7[3] = pk_bd[1]; pk_h7[4] = pk_bd[2]; pk_h7[5] = pk_bd[3]; pk_h7[6] = pk_bd[4];
    pk_h7[0] = pk_c1[s]; pk_h7[1] = pk_c2[s];
    sc = pk_eval(7);
    sb = 0; t = 1; j = 0;
    loop(6,
      (pk_in[j] && j != s) ? (
        pk_h7[0] = pk_oa[j]; pk_h7[1] = pk_ob[j];
        x = pk_eval(7);
        x > sb ? ( sb = x; t = 1; ) : x == sb ? t += 1;
      );
      j += 1;
    );
    sc > sb ? w += 1 : sc == sb ? w += 1 / (t + 1);
  );
  i = nb;
  while (i < 5) ( pk_bd[i] = -1; i += 1; );
  w / n;
);

function pk_tv() local(n, i, j, nb, m, p, x, a, sb, t, cnt)
(
  memset(pk_mk, 0, 52); memset(pk_tvp, 0, 6);
  nb = g_pk_nb;
  i = 0; loop(nb, pk_mk[pk_bd[i]] = 1; i += 1; );
  j = 0; loop(6, pk_in[j] ? ( pk_mk[pk_c1[j]] = 1; pk_mk[pk_c2[j]] = 1; ); j += 1; );
  m = 0; i = 0;
  loop(52, !pk_mk[i] ? ( pk_pl[m] = i; m += 1; ); i += 1; );
  n = nb >= 5 ? 1 : 1500;
  loop(n,
    p = 0; i = nb;
    while (i < 5) (
      x = p + floor(rand(1) * (m - p)); a = pk_pl[x]; pk_pl[x] = pk_pl[p]; pk_pl[p] = a;
      pk_bd[i] = a; p += 1; i += 1;
    );
    pk_h7[2] = pk_bd[0]; pk_h7[3] = pk_bd[1]; pk_h7[4] = pk_bd[2]; pk_h7[5] = pk_bd[3]; pk_h7[6] = pk_bd[4];
    sb = -1; t = 0; j = 0;
    loop(6,
      pk_in[j] ? (
        pk_h7[0] = pk_c1[j]; pk_h7[1] = pk_c2[j];
        x = pk_eval(7);
        pk_oa[j] = x;
        x > sb ? sb = x;
      );
      j += 1;
    );
    j = 0; t = 0; loop(6, (pk_in[j] && pk_oa[j] == sb) ? t += 1; j += 1; );
    j = 0; loop(6, (pk_in[j] && pk_oa[j] == sb) ? pk_tvp[j] += 1 / t; j += 1; );
  );
  j = 0; loop(6, pk_tvp[j] /= n; j += 1; );
  i = nb;
  while (i < 5) ( pk_bd[i] = -1; i += 1; );
);

function pk_label(s, k, a) ( pk_lbl[s] = k; pk_lblt[s] = g_pk_t; pk_hn[s] = a; );

function pk_act(s, ty, amt) local(need, inc, oldc, i, c)
(
  c = pk_ch[s];
  pk_acted[s] = 1;
  need = g_pk_cur - pk_bet[s];
  ty == 0 ? (
    pk_in[s] = 0; pk_foldt[s] = g_pk_t;
    pk_label(s, 0, 0);
    db_snd(14, 60, 0.07, 0, (pk_bx[s] - 450) / 500);
    s > 0 ? pk_say(s, 2, 0.28);
  ) : ty == 1 ? (
    need <= 0 ? (
      pk_label(s, 1, 0);
      db_snd(7, 210, 0.2, 0, (pk_bx[s] - 450) / 500); db_snd(7, 210, 0.16, 0.13, (pk_bx[s] - 450) / 500);
      s > 0 ? pk_say(s, 1, 0.08);
    ) : (
      pk_put(s, need);
      pk_label(s, 2, pk_bet[s]);
      pk_ai[s] ? pk_label(s, 4, pk_bet[s]);
      g_pk_street == 0 ? pk_rf[s] = max(pk_rf[s], g_pk_raised ? 6 : 3);
      s > 0 ? pk_say(s, pk_ai[s] ? 5 : 1, pk_ai[s] ? 0.8 : 0.16);
      s == 0 && g_pk_street == 0 ? g_pk_hv = 1;
    );
  ) : (
    oldc = g_pk_cur;
    amt = max(amt, min(oldc + g_pk_minr, pk_bet[s] + pk_st[s]));
    amt = min(amt, pk_bet[s] + pk_st[s]);
    pk_put(s, amt - pk_bet[s]);
    inc = amt - oldc;
    inc > 0 ? (
      i = 0;
      inc >= g_pk_minr ? (
        g_pk_minr = inc;
        loop(6, i != s ? ( pk_acted[i] = 0; pk_canr[i] = 1; ); i += 1; );
      ) : (
        loop(6, (i != s && pk_acted[i]) ? pk_canr[i] = 0; i += 1; );
      );
      g_pk_cur = amt;
      g_pk_lastr = s;
      g_pk_raised += 1;
    );
    pk_label(s, pk_ai[s] ? 4 : oldc > 0 ? 3 : 5, amt);
    pk_ai[s] ? (
      g_pk_alln = g_pk_t; g_pk_shake = g_pk_t;
      db_snd(7, 60, 0.5, 0, 0); db_snd(14, 5, 0.1, 0, 0);
      s > 0 ? pk_say(s, 5, 0.9);
    ) : ( s > 0 ? pk_say(s, 0, 0.3); );
    g_pk_street == 0 ? pk_rf[s] = max(pk_rf[s], g_pk_raised > 1 ? 9 : 7) : pk_rp[s] = 1;
    s == 0 ? ( g_pk_haggn += 1; g_pk_street == 0 ? g_pk_hv = 1; );
  );
  (s == 0 && g_pk_hagg_adj) ? pk_rf[0] = max(0, pk_rf[0] - g_pk_hagg_adj);
  pk_count();
  g_pk_nin <= 1 ? pk_collect_begin() : (
    g_pk_a = pk_find(s);
    g_pk_a < 0 ? pk_collect_begin() : pk_think(g_pk_a);
  );
);

function pk_ai_move(s) local(c, eq, n, tc, pot, po, fair, bb, agg, bluff, call, trap, tight, r, amt, ty, stk, need, lv, sw, cando, tl, i, rel, oth)
(
  c = pk_ch[s]; lv = g_pk_lv;
  pk_count();
  n = g_pk_nin - 1;
  eq = pk_equity(s, 260, 1);
  pk_eqs[s] = eq;
  fair = 1 / (n + 1);
  tc = g_pk_cur - pk_bet[s];
  pot = pk_potall();
  po = tc > 0 ? tc / (pot + tc) : 0;
  bb = pk_st[s] / g_pk_bb;
  tl = min(1, pk_tilt[s]);
  tight = pa_tight[c] * (1 - 0.6 * tl);
  agg = min(1, pa_agg[c] + 0.25 * tl);
  bluff = pa_bluff[c] + 0.2 * tl;
  call = min(1, pa_call[c] + 0.2 * tl);
  trap = pa_trap[c];
  eq += (rand(1) + rand(1) - 1) * max(0.02, 0.2 - 0.022 * lv);
  lv <= 3 ? ( agg *= 0.8; bluff *= 0.7; );
  sw = pa_adapt[c] * max(0, min(1, (g_pk_haggn / max(4, g_pk_hand)) - 0.25)) * 0.14;
  oth = 0; i = 0; loop(6, (pk_in[i] && !pk_ai[i] && i != s) ? oth += 1; i += 1; );
  cando = pk_canr[s] && oth > 0 && pk_st[s] > tc;
  r = rand(1);
  ty = 1; amt = 0; rel = 0;
  tc <= 0 ? (
    (eq > fair + 0.1 * (1.25 - agg) && r < 0.3 + 0.62 * agg && cando) ? ty = 2 :
    (eq < fair && cando && r < bluff * (g_pk_street > 0 ? 1 : 0.5) * (n == 1 ? 1.5 : n == 2 ? 0.8 : 0.35)) ? ( ty = 2; rel = 1; );
    (ty == 2 && !rel && eq > 0.78 && g_pk_street < 3 && rand(1) < trap) ? ty = 1;
  ) : (
    need = po + (1 - call) * 0.1 - call * 0.05 - sw + 0.07 * min(1, tc / max(1, pk_st[s]));
    g_pk_street == 0 ? need += 0.5 * tight * fair;
    (eq > max(0.6, fair + 0.24) - agg * 0.1 && rand(1) < 0.25 + 0.65 * agg && cando) ? (
      ty = 2; (eq > 0.8 && rand(1) < trap * 0.7 && g_pk_street < 3) ? ty = 1;
    ) : (cando && rand(1) < bluff * 0.3 && tc <= pot * 0.7 && eq < need) ? ( ty = 2; rel = 1; ) :
    eq < need ? ty = 0;
  );
  (g_pk_street == 0 && bb <= 9) ? (
    (eq > fair + 0.06 - agg * 0.04 + tight * 0.05) ? ( cando ? ty = 2 : ty = 1; rel = 0; amt = pk_bet[s] + pk_st[s]; ) : tc > 0 ? ty = 0;
  );
  ty == 2 && amt <= 0 ? (
    g_pk_street == 0 ? (
      amt = g_pk_cur + g_pk_bb * (1.5 + rand(1) * 1.5 + agg) + (g_pk_raised ? tc * 1.5 : 0);
    ) : (
      amt = g_pk_cur + pot * (0.45 + rand(1) * 0.45 + (c == 9 ? 0.5 : 0));
    );
    amt = floor(amt / (g_pk_sb)) * g_pk_sb;
    amt > (pk_bet[s] + pk_st[s]) * 0.72 ? amt = pk_bet[s] + pk_st[s];
  );
  (ty == 0 && tc <= 0) ? ty = 1;
  (tc > 0 && ty == 1 && tc >= pk_st[s] * 0.97 && eq < po) ? ty = 0;
  rand(1) < pa_rel[c] ? (
    pk_tell[s] = (ty >= 1 && eq > 0.68) ? 1 : (ty == 2 && (rel || eq < fair)) ? 2 : 0;
  ) : (
    pk_tell[s] = rand(1) < 0.15 ? 1 + floor(rand(1) * 2) % 2 : 0;
  );
  (c == 7 && pk_tell[s] == 0) ? pk_tell[s] = eq > 0.6 ? 1 : eq < 0.35 ? 2 : 0;
  pk_tellt[s] = g_pk_t;
  ty == 2 ? pk_setmood(s, 5, 1.6) : ty == 0 ? pk_setmood(s, 3, 1.2);
  pk_act(s, ty, amt);
);

function pk_collected() local(i, hi, h2, x)
(
  hi = 0; h2 = 0; x = -1; i = 0;
  loop(6,
    pk_bet[i] > hi ? ( h2 = hi; hi = pk_bet[i]; x = i; ) : pk_bet[i] > h2 ? h2 = pk_bet[i];
    i += 1;
  );
  (x >= 0 && hi > h2) ? (
    pk_st[x] += hi - h2; pk_tot[x] -= hi - h2; pk_bet[x] -= hi - h2; pk_ai[x] = 0;
    (g_pk_t > 0 && hi - h2 > 0) ? pk_fly(pk_bx[x], pk_by[x], pk_px[x], pk_py[x] - 8, 2, 0.25, 0);
  );
  i = 0;
  loop(6,
    pk_bet[i] > 0 ? pk_fly(pk_bx[i], pk_by[i], g_pk_ptx - 60, g_pk_pty, 1 + floor(sqrt(pk_bet[i] / g_pk_bb)), 0.28, 0);
    pk_bet[i] = 0; pk_betv[i] = 0;
    i += 1;
  );
  pk_count();
);

function pk_dealcards(n) local(i)
(
  i = 0;
  g_pk_dp += 1;
  loop(n,
    pk_bd[g_pk_nb] = pk_dk[g_pk_dp]; g_pk_dp += 1;
    pk_bt[g_pk_nb] = g_pk_t + i * 0.17 * g_pk_sp;
    db_snd(14, 60, 0.13, i * 0.17, (g_pk_nb - 2) * 0.2);
    g_pk_nb += 1;
    i += 1;
  );
  g_pk_s = 4;
);

function pk_nextstreet() local(i, sl)
(
  g_pk_street += 1;
  g_pk_nac = 0; pk_count();
  (g_pk_nac <= 1 && !g_pk_runout) ? (
    g_pk_runout = 1; g_pk_rot = g_pk_t;
    i = 0; loop(6, pk_in[i] && !pk_flipt[i] ? pk_flipt[i] = g_pk_t; i += 1; );
    pk_tv();
    db_snd(7, 55, 0.4, 0, 0);
  );
  g_pk_street == 1 ? pk_dealcards(3) : pk_dealcards(1);
  sl = g_pk_runout && g_pk_street == 3;
  sl ? ( pk_bt[4] = g_pk_t + 1.5 * g_pk_sp; g_pk_w = g_pk_t + 3.4 * g_pk_sp; g_pk_sq = 1; ) :
  g_pk_w = pk_wt(g_pk_runout ? 2.2 : g_pk_street == 1 ? 1.7 : 1.3);
);

function pk_besthl(s) local(i, a, b, n, v, fa, fb)
(
  pk_lays[0] = pk_c1[s]; pk_lays[1] = pk_c2[s];
  i = 0; loop(5, pk_lays[2 + i] = pk_bd[i]; i += 1; );
  i = 0; loop(7, pk_h7[i] = pk_lays[i]; i += 1; );
  v = pk_eval(7);
  fa = -1; a = 0;
  while (a < 6 && fa < 0) (
    b = a + 1;
    while (b < 7 && fa < 0) (
      n = 0; i = 0;
      loop(7, (i != a && i != b) ? ( pk_h7[n] = pk_lays[i]; n += 1; ); i += 1; );
      pk_eval(5) == v ? ( fa = a; fb = b; );
      b += 1;
    );
    a += 1;
  );
  (fa != 0 && fb != 0) ? pk_hl[s * 2] = 1;
  (fa != 1 && fb != 1) ? pk_hl[s * 2 + 1] = 1;
  i = 0;
  loop(5, (fa != i + 2 && fb != i + 2) ? pk_bhl[i] = 1; i += 1; );
);

function pk_toast(s, t) ( strcpy(#pk_tt, s); g_pk_tt = g_pk_t; g_pk_tk = t; );

function pk_settle() local(i, j, lv, prev, amt, best, n, odd, sh, nextl, lastw, k, hmax, c, ww, ph)
(
  memset(pk_won, 0, 6);
  i = 0;
  loop(6,
    pk_in[i] ? (
      pk_h7[0] = pk_c1[i]; pk_h7[1] = pk_c2[i];
      j = 0; loop(5, pk_h7[2 + j] = pk_bd[j]; j += 1; );
      pk_scr[i] = g_pk_nb >= 5 ? pk_eval(7) : 0;
    );
    i += 1;
  );
  prev = 0; lastw = -1; k = 0;
  while (k < 7) (
    nextl = 1000000000;
    i = 0; loop(6, (pk_tot[i] > prev && pk_tot[i] < nextl) ? nextl = pk_tot[i]; i += 1; );
    nextl >= 1000000000 ? k = 99 : (
      amt = 0; i = 0;
      loop(6, amt += min(pk_tot[i], nextl) - min(pk_tot[i], prev); i += 1; );
      best = -1; n = 0; i = 0;
      loop(6, (pk_in[i] && pk_tot[i] >= nextl) ? ( pk_scr[i] > best ? ( best = pk_scr[i]; n = 1; ) : pk_scr[i] == best ? n += 1; ); i += 1; );
      n == 0 ? (
        lastw >= 0 ? pk_won[lastw] += amt;
      ) : (
        sh = floor(amt / n);
        odd = amt - sh * n;
        j = g_pk_btn; i = 0;
        loop(6,
          j = (j + 1) % 6;
          (pk_in[j] && pk_tot[j] >= nextl && pk_scr[j] == best) ? (
            pk_won[j] += sh + odd; odd = 0; lastw = j;
          );
          i += 1;
        );
      );
      prev = nextl;
      k += 1;
    );
  );
  hmax = 0; g_pk_wn = 0; ww = -1; i = 0;
  loop(6,
    pk_won[i] > 0 ? (
      g_pk_wn += 1;
      pk_won[i] > hmax ? ( hmax = pk_won[i]; ww = i; );
      pk_st[i] += pk_won[i];
      pk_fly(g_pk_ptx - 60, g_pk_pty, pk_px[i], pk_py[i] - 8, 3 + floor(sqrt(pk_won[i] / g_pk_bb)), 0.5, 0.35);
    );
    i += 1;
  );
  ph = pk_potall();
  g_pk_wamt = ph; g_pk_ww = ww;
  g_pk_paid = 1;
  g_pk_wcat = g_pk_nb >= 5 && g_pk_nin > 1 ? floor(pk_scr[ww] / 371293) : -1;
  (g_pk_wcat >= 0) ? ( pk_besthl(ww); pk_name(pk_scr[ww], #pk_wname); ) : strcpy(#pk_wname, "");
  pk_chipsnd(0, 5);
  db_snd(1, 3000, 0.08, 0.4, 0); db_snd(1, 2600, 0.08, 0.5, 0);
  pk_won[0] > 0 ? ( db_snd(13, 784, 0.16, 0.25, -0.15); db_snd(13, 1175, 0.14, 0.36, 0.15); );
);

function pk_collect_hero() local(c, bit, v, nb)
(
  pk_in[0] && g_pk_nb >= 5 ? (
    v = pk_scr[0];
    c = floor(v / 371293);
    (c == 8 && floor((v - c * 371293) / 28561) == 12) ? c = 9;
    bit = 1 << c;
    c >= 2 && !(sv2[49] & bit) ? (
      sv2[49] |= bit;
      sv[0] = 1;
      g_pk_newhand = c; g_pk_newt = g_pk_t;
    );
  );
);

function pk_after() local(i, c, was, tot, big, wn, lo)
(
  tot = g_pk_wamt;
  wn = g_pk_ww;
  big = tot >= g_pk_bb * 12;
  pk_won[0] > 0 ? (
    sv2[46] = max(sv2[46], tot);
    g_pk_hw += 1;
  );
  pk_collect_hero();
  (g_pk_wcat >= 6 && pk_won[0] > 0) ? ( g_pk_fanfare = g_pk_t; );
  i = 1;
  loop(5,
    pk_ch[i] >= 0 && !pk_out[i] ? (
      pk_tilt[i] *= 0.7;
      pk_tot[i] > g_pk_bb * 8 && pk_won[i] <= 0 && pk_flipt[i] > 0 ? (
        pk_scr[i] >= 371293 * 2 ? pk_tilt[i] = min(1, pk_tilt[i] + 0.7) : pk_tilt[i] = min(1, pk_tilt[i] + 0.25);
      );
    );
    i += 1;
  );
  i = 1; loop(5, (pk_won[i] > 0 && !pk_out[i] && pk_ch[i] >= 0) ? pk_setmood(i, 2, 2.2); (pk_won[i] <= 0 && pk_tot[i] > g_pk_bb * 8 && !pk_out[i] && pk_ch[i] >= 0) ? pk_setmood(i, 6, 2.2); i += 1; );
  wn > 0 ? pk_say(wn, 3, big ? 0.85 : 0.3) : (
    lo = 0; i = 1; loop(5, (pk_ch[i] >= 0 && pk_tot[i] > g_pk_bb * 6 && !pk_out[i]) ? lo = i; i += 1; );
    lo > 0 ? pk_say(lo, 4, big ? 0.85 : 0.3);
  );
  g_pk_s = 7;
  g_pk_w = pk_wt(g_pk_nin > 1 ? 5 : 3);
  g_pk_cwait = 1;
);

function pk_finish() local(i, n, heroko, c, p)
(
  n = 0;
  i = 1;
  loop(5,
    (pk_ch[i] >= 0 && !pk_out[i] && pk_st[i] <= 0) ? (
      pk_out[i] = 1; pk_kot[i] = g_pk_t;
      c = pk_ch[i];
      pk_setmood(i, 4, 3);
      pk_sayl[i] = pk_ln[c * 16 + 14 + floor(rand(1) * 2) % 2]; pk_sayt[i] = g_pk_t; g_pk_saylast = g_pk_t; g_pk_sayn = strlen(pk_sayl[i]);
      db_snd(7, 70, 0.5, 0, (pk_px[i] - 450) / 500);
      pk_won[0] > 0 ? (
        g_pk_kos += 1;
        sv2[52] += 1;
        g_pk_reads = min(5, g_pk_reads + 1);
        !(sv2[50] & (1 << c)) ? (
          sv2[50] |= 1 << c;
          sprintf(#pk_tt2, "Tell learned: %s", pk_tl[c]);
          pk_toast(#pk_tt2, 2);
        );
      );
    );
    i += 1;
  );
  n = 0; i = 1; loop(5, (pk_ch[i] >= 0 && !pk_out[i]) ? n += 1; i += 1; );
  pk_st[0] <= 0 ? (
    g_pk_s = 9; g_pk_place = n + 1; g_pk_w = g_pk_t + 0.9; g_pk_endt = g_pk_t;
  ) : n == 0 ? (
    p = 500 * g_pk_lv + 250 * g_pk_kos;
    g_pk_prize = p;
    sv2[44] = g_pk_lv + 1; sv2[45] += 1; sv2[53] += p;
    i = 1; loop(5, pk_ch[i] >= 0 ? sv2[50] |= 1 << pk_ch[i]; i += 1; );
    sv[0] = 1;
    g_pk_s = 8; g_pk_endt = g_pk_t;
  ) : (
    g_pk_s = 0;
    g_pk_w = pk_wt(0.9);
  );
);

function pk_tick() local(i, a, n, c)
(
  i = 0;
  loop(6,
    g_pk_t >= pk_bett[i] ? pk_betv[i] = pk_bet[i];
    i += 1;
  );
  g_pk_s == 0 ? (
    g_pk_t >= g_pk_w ? pk_deal();
  ) : g_pk_s == 1 ? (
    g_pk_t >= g_pk_w ? pk_startbet();
  ) : g_pk_s == 2 ? (
    a = g_pk_a;
    a < 0 ? pk_collect_begin() : (a > 0 && g_pk_t >= g_pk_w) ? pk_ai_move(a);
  ) : g_pk_s == 3 ? (
    g_pk_t >= g_pk_w ? (
      pk_collected();
      g_pk_nin <= 1 ? (
        pk_settle();
        g_pk_s = 6; g_pk_w = pk_wt(0.9);
      ) : g_pk_street >= 3 ? (
        g_pk_s = 5; g_pk_si = g_pk_lastr >= 0 ? g_pk_lastr : pk_nextp(g_pk_btn); g_pk_sn = 0; g_pk_w = pk_wt(0.9);
      ) : pk_nextstreet();
    );
  ) : g_pk_s == 4 ? (
    g_pk_t >= g_pk_w ? (
      g_pk_sq = 0;
      g_pk_runout ? ( pk_tv(); g_pk_street >= 3 ? ( g_pk_s = 5; g_pk_si = g_pk_lastr >= 0 ? g_pk_lastr : pk_nextp(g_pk_btn); g_pk_sn = 0; g_pk_w = pk_wt(0.4); ) : pk_nextstreet(); ) : (
        pk_count();
        g_pk_nac >= 2 ? pk_startbet() : g_pk_street >= 3 ? ( g_pk_s = 5; g_pk_si = g_pk_lastr >= 0 ? g_pk_lastr : pk_nextp(g_pk_btn); g_pk_sn = 0; g_pk_w = pk_wt(0.4); ) : pk_nextstreet();
      );
    );
  ) : g_pk_s == 5 ? (
    g_pk_t >= g_pk_w ? (
      n = 0;
      while (n < 6 && !(pk_in[g_pk_si] && !pk_flipt[g_pk_si])) ( g_pk_si = (g_pk_si + 1) % 6; n += 1; );
      n < 6 ? (
        pk_flipt[g_pk_si] = g_pk_t;
        db_snd(14, 50, 0.1, 0, (pk_bx[g_pk_si] - 450) / 500);
        g_pk_w = pk_wt(1);
      ) : (
        pk_settle();
        g_pk_s = 6; g_pk_w = pk_wt(1.1);
      );
    );
  ) : g_pk_s == 6 ? (
    g_pk_t >= g_pk_w ? pk_after();
  ) : g_pk_s == 7 ? (
    g_pk_t >= g_pk_w ? pk_finish();
  );
);

function pk_table(lv) local(i, j, nop, c, sl, idx, used, k, base)
(
  !g_pk_tb ? pk_tables();
  g_pk_lv = lv;
  memset(pk_ch, -1, 6);
  idx = min(lv, 10) - 1;
  i = 0; nop = 0;
  lv <= 10 ? (
    loop(5, pk_lvc[idx * 5 + i] >= 0 ? nop += 1; i += 1; );
  ) : nop = 5;
  j = 0;
  while (j < nop) (
    sl = nop == 2 ? (j == 0 ? 2 : 4) : nop == 3 ? (j == 0 ? 1 : j == 1 ? 3 : 5) : nop == 4 ? (j == 0 ? 1 : j == 1 ? 2 : j == 2 ? 4 : 5) : j + 1;
    lv <= 10 ? c = pk_lvc[idx * 5 + j] : (
      k = 0; c = -1;
      while (c < 0) (
        c = floor(rand(1) * 12) % 12;
        i = 1; loop(5, pk_ch[i] == c ? c = -1; i += 1; );
      );
    );
    pk_ch[sl] = c;
    j += 1;
  );
  g_pk_ven = lv <= 10 ? floor((lv - 1) / 2) : floor((lv - 1) / 2) % 5;
  base = 1500;
  g_pk_chips = 0;
  i = 0;
  loop(6,
    pk_out[i] = (i == 0 || pk_ch[i] >= 0) ? 0 : 1;
    pk_st[i] = pk_out[i] ? 0 : (i == 0 ? base * (1 + max(0, (4 - lv) * 0.2)) : base); pk_std[i] = pk_st[i];
    g_pk_chips += pk_st[i];
    pk_bet[i] = 0; pk_betv[i] = 0; pk_tot[i] = 0; pk_in[i] = 0; pk_tilt[i] = 0; pk_vp[i] = 0; pk_kot[i] = 0; pk_flipt[i] = 0; pk_foldt[i] = 0; pk_sayt[i] = -9;
    pk_lblt[i] = -9;
    i += 1;
  );
  g_pk_nop = nop;
  g_pk_hand = 0; g_pk_bl = 0; g_pk_hupn = 5 + floor(nop / 2); g_pk_hup = g_pk_hupn; g_pk_kos = 0; g_pk_haggn = 0; g_pk_hw = 0; g_pk_nb = 0;
  g_pk_reads = 2;
  g_pk_bb = 50; g_pk_sb = 25;
  g_pk_btn = floor(rand(1) * 6) % 6;
  g_pk_t = max(g_pk_t, 1);
  g_pk_s = 10;
  g_pk_intro = g_pk_t;
  g_pk_trk = 32 + (g_pk_ven % 5);
  g_pk_bgw = 0;
  g_pk_nst += 1;
);

function pk_begin() local(i)
(
  g_pk_s = 0; g_pk_w = g_pk_t + 0.9;
  g_pk_saylast = -9;
  i = 1; 
  while (i < 6 && pk_ch[i] < 0) ( i += 1; );
  i < 6 ? pk_say(i + floor(rand(1) * 2) * 0, 6, 1);
);

function pk_ef(cx, cy, rx, ry) local(y, h, w)
(
  y = -ceil(ry);
  loop(2 * ceil(ry) + 1,
    h = y / ry;
    abs(h) < 1 ? ( w = rx * sqrt(1 - h * h); gfx_rect(cx - w, cy + y, 2 * w, 1); );
    y += 1;
  );
);

function pk_fmt(v, d)
(
  v = floor(v + 0.5);
  v >= 1000000 ? sprintf(d, "%d,%03d,%03d", floor(v / 1000000), floor(v / 1000) % 1000, v % 1000) :
  v >= 1000 ? sprintf(d, "%d,%03d", floor(v / 1000), v % 1000) : sprintf(d, "%d", v);
  d;
);

function pc_tri(a, b, c, d, e, f) ( gfx_triangle(g_cx0 + a * g_ck, g_cy0 + b * g_ck, g_cx0 + c * g_ck, g_cy0 + d * g_ck, g_cx0 + e * g_ck, g_cy0 + f * g_ck); );
function pc_q(a, b, c, d, e, f, g, h) ( gfx_triangle(g_cx0 + a * g_ck, g_cy0 + b * g_ck, g_cx0 + c * g_ck, g_cy0 + d * g_ck, g_cx0 + e * g_ck, g_cy0 + f * g_ck, g_cx0 + g * g_ck, g_cy0 + h * g_ck); );
function pc_c(u, v, r) ( gfx_circle(g_cx0 + u * g_ck, g_cy0 + v * g_ck, r * g_ck, 1, 1); );
function pc_r(u, v, w, h) ( gfx_rect(g_cx0 + u * g_ck, g_cy0 + v * g_ck, w * g_ck, h * g_ck); );
function pc_l(a, b, c, d, w) ( tline(g_cx0 + a * g_ck, g_cy0 + b * g_ck, g_cx0 + c * g_ck, g_cy0 + d * g_ck, w * g_ck); );

function pk_suit(s, u, v, z, f)
(
  s == 2 ? (
    pc_c(u - 0.48 * z, v - 0.3 * z * f, 0.52 * z); pc_c(u + 0.48 * z, v - 0.3 * z * f, 0.52 * z);
    pc_q(u - 0.97 * z, v - 0.14 * z * f, u + 0.97 * z, v - 0.14 * z * f, u + 0.3 * z, v + 0.6 * z * f, u - 0.3 * z, v + 0.6 * z * f);
    pc_tri(u - 0.34 * z, v + 0.56 * z * f, u + 0.34 * z, v + 0.56 * z * f, u, v + z * f);
  ) : s == 1 ? (
    pc_q(u, v - z, u + 0.74 * z, v, u, v + z, u - 0.74 * z, v);
  ) : s == 3 ? (
    pc_c(u - 0.48 * z, v + 0.26 * z * f, 0.5 * z); pc_c(u + 0.48 * z, v + 0.26 * z * f, 0.5 * z);
    pc_q(u - 0.95 * z, v + 0.1 * z * f, u + 0.95 * z, v + 0.1 * z * f, u + 0.3 * z, v - 0.62 * z * f, u - 0.3 * z, v - 0.62 * z * f);
    pc_tri(u - 0.34 * z, v - 0.58 * z * f, u + 0.34 * z, v - 0.58 * z * f, u, v - z * f);
    pc_q(u - 0.09 * z, v + 0.3 * z * f, u + 0.09 * z, v + 0.3 * z * f, u + 0.34 * z, v + z * f, u - 0.34 * z, v + z * f);
  ) : (
    pc_c(u, v - 0.46 * z * f, 0.44 * z); pc_c(u - 0.5 * z, v + 0.14 * z * f, 0.44 * z); pc_c(u + 0.5 * z, v + 0.14 * z * f, 0.44 * z);
    pc_c(u, v, 0.2 * z);
    pc_q(u - 0.09 * z, v + 0.1 * z * f, u + 0.09 * z, v + 0.1 * z * f, u + 0.34 * z, v + z * f, u - 0.34 * z, v + z * f);
  );
);

function pk_cardbase(w, h) local(r, px, py, pw, ph)
(
  px = g_cx0; py = g_cy0; pw = w * g_ck; ph = h * g_ck; r = 7 * g_ck;
  gfx_rect(px + r, py, pw - 2 * r, ph);
  gfx_rect(px, py + r, pw, ph - 2 * r);
  gfx_circle(px + r, py + r, r, 1, 1); gfx_circle(px + pw - r - 1, py + r, r, 1, 1);
  gfx_circle(px + r, py + ph - r - 1, r, 1, 1); gfx_circle(px + pw - r - 1, py + ph - r - 1, r, 1, 1);
);

function pk_pip(s, u, f) ( pk_suit(s, u, 22 + f * 68, 7.6, f > 0.5 ? -1 : 1); );

function pk_courtier(r, s) local(cr, cg, cb, dr, dg, db, k)
(
  cr = s == 0 || s == 3 ? 0.12 : 0.76; cg = s == 0 || s == 3 ? 0.17 : 0.12; cb = s == 0 || s == 3 ? 0.42 : 0.13;
  dr = 0.92; dg = 0.68; db = 0.14;
  gfx_set(cr, cg, cb, 1);
  pc_q(19, 57, 61, 57, 61, 41, 19, 41);
  gfx_set(dr, dg, db, 1);
  pc_q(34, 57, 46, 57, 44, 40, 36, 40);
  gfx_set(cr * 0.55, cg * 0.55, cb * 0.55, 1);
  k = 0; loop(4, pc_c(40, 43 + k * 4.2, 1.15); k += 1; );
  gfx_set(0.97, 0.95, 0.88, 1);
  pc_q(30, 42, 50, 42, 45, 37, 35, 37);
  k = 0;
  gfx_set(dr, dg, db, 1);
  loop(3, pc_c(23 + k * 2, 46 + k * 4, 1.2); pc_c(57 - k * 2, 46 + k * 4, 1.2); k += 1; );
  r == 10 ? ( gfx_set(0.72, 0.42, 0.12, 1); pc_c(29, 30, 6.2); pc_c(51, 30, 6.2); pc_c(30, 37, 5); pc_c(50, 37, 5); ) :
  r == 9 ? ( gfx_set(0.62, 0.38, 0.12, 1); pc_c(29, 33, 5.6); pc_c(51, 33, 5.6); ) :
  ( gfx_set(0.82, 0.8, 0.76, 1); pc_c(30, 30, 5); pc_c(50, 30, 5); );
  gfx_set(0.96, 0.8, 0.66, 1);
  pc_c(40, 29, 10.2);
  gfx_set(0.1, 0.1, 0.14, 1);
  pc_c(36.2, 28, 1.25); pc_c(43.8, 28, 1.25);
  gfx_set(0.85, 0.45, 0.35, 1);
  pc_l(40, 28.5, 39.2, 32.2, 1);
  gfx_set(0.72, 0.14, 0.14, 1);
  pc_l(37, 35, 43, 35, 1.2);
  r == 11 ? (
    gfx_set(0.82, 0.8, 0.76, 1);
    pc_q(32, 33, 48, 33, 45, 44, 35, 44);
    gfx_set(0.72, 0.14, 0.14, 1); pc_l(37, 34.4, 43, 34.4, 1.3);
    gfx_set(0.82, 0.8, 0.76, 1); pc_l(33.5, 31.5, 39.5, 33, 1.8); pc_l(46.5, 31.5, 40.5, 33, 1.8);
    gfx_set(dr, dg, db, 1);
    pc_q(29, 22, 51, 22, 54, 12, 26, 12);
    pc_tri(26, 13, 33, 13, 28, 5); pc_tri(35.5, 13, 44.5, 13, 40, 3); pc_tri(47, 13, 54, 13, 52, 5);
    gfx_set(cr, cg, cb, 1); pc_c(40, 16.5, 2); pc_c(32, 17, 1.5); pc_c(48, 17, 1.5);
    gfx_set(0.76, 0.12, 0.13, 1); pc_c(40, 3.5, 1.5);
    gfx_set(0.72, 0.74, 0.8, 1); pc_l(60, 6, 54, 50, 1.6); gfx_set(dr, dg, db, 1); pc_l(52, 42, 62, 44, 2);
  ) : r == 10 ? (
    gfx_set(dr, dg, db, 1);
    pc_q(31, 21, 49, 21, 51, 16, 29, 16);
    pc_tri(29, 17, 35, 17, 31, 9); pc_tri(36, 17, 44, 17, 40, 7); pc_tri(45, 17, 51, 17, 49, 9);
    gfx_set(0.76, 0.12, 0.13, 1); pc_c(40, 9, 1.4);
    gfx_set(cr, cg, cb, 1); pc_c(40, 18.5, 1.3); pc_c(33, 18.8, 1); pc_c(47, 18.8, 1);
    gfx_set(0.85, 0.2, 0.3, 1); pc_c(25, 45, 3); pc_c(22, 49, 2.6); pc_c(28, 49, 2.6); gfx_set(dr, dg, db, 1); pc_c(25, 48, 1.4);
  ) : (
    gfx_set(cr, cg, cb, 1);
    pc_q(29, 23, 51, 23, 49, 14, 30, 16);
    gfx_set(dr, dg, db, 1); pc_l(29, 22.5, 51, 22.5, 2);
    gfx_set(0.96, 0.95, 0.9, 1);
    pc_tri(49, 20, 56, 20, 60, 5);
    gfx_set(0.72, 0.72, 0.76, 1); pc_l(50, 19.5, 59, 6.5, 0.7);
  );
);

function pk_atlas() local(cw, ch, wk, c, r, s, i, x, y, u, a, n, z, tw, th, dst)
(
  cw = ceil(84 * g_s); ch = ceil(118 * g_s); g_pk_acw = cw; g_pk_ach = ch;
  dst = gfx_dest;
  g_ck = 2 * g_s;
  gfx_setimgdim(IMG_PKW, 0, 0);
  gfx_setimgdim(IMG_PKW, 13 * cw * 2, 5 * ch * 2);
  gfx_setimgdim(IMG_PKO, 0, 0);
  gfx_setimgdim(IMG_PKO, ceil(84 * g_ck), ceil(118 * g_ck));
  gfx_mode = 0;
  c = 0;
  loop(52,
    r = c % 13; s = (c - r) / 13;
    gfx_dest = IMG_PKW;
    g_cx0 = (c % 13) * cw * 2 + 2 * g_ck; g_cy0 = s * ch * 2 + 3 * g_ck;
    gfx_set(0.08, 0.06, 0.05, 1); pk_cardbase(80, 112);
    g_cx0 += 0.5 * g_ck; g_cy0 += 0.5 * g_ck;
    gfx_set(0.985, 0.97, 0.93, 1); pk_cardbase(79, 111);
    g_cx0 -= 0.5 * g_ck; g_cy0 -= 0.5 * g_ck;
    s == 1 || s == 2 ? gfx_set(0.8, 0.09, 0.12, 1) : gfx_set(0.09, 0.09, 0.12, 1);
    r <= 8 ? (
      n = r + 2;
      (n == 2 || n == 3) ? ( pk_pip(s, 40, 0); pk_pip(s, 40, 1); n == 3 ? pk_pip(s, 40, 0.5); ) :
      (n >= 4 && n <= 8) ? (
        pk_pip(s, 26, 0); pk_pip(s, 54, 0); pk_pip(s, 26, 1); pk_pip(s, 54, 1);
        n == 5 ? pk_pip(s, 40, 0.5);
        n >= 6 ? ( pk_pip(s, 26, 0.5); pk_pip(s, 54, 0.5); );
        n >= 7 ? pk_pip(s, 40, 0.25);
        n == 8 ? pk_pip(s, 40, 0.75);
      ) : (
        pk_pip(s, 26, 0); pk_pip(s, 54, 0); pk_pip(s, 26, 0.34); pk_pip(s, 54, 0.34);
        pk_pip(s, 26, 0.66); pk_pip(s, 54, 0.66); pk_pip(s, 26, 1); pk_pip(s, 54, 1);
        n == 9 ? pk_pip(s, 40, 0.5) : ( pk_pip(s, 40, 0.17); pk_pip(s, 40, 0.83); );
      );
    ) : r == 12 ? (
      s == 3 ? (
        pk_suit(s, 40, 56, 25, 1);
        gfx_set(0.985, 0.97, 0.93, 1); pk_suit(s, 40, 55, 15, 1);
        gfx_set(0.76, 0.12, 0.13, 1); pk_suit(s, 40, 55, 8, 1);
      ) : pk_suit(s, 40, 56, 17, 1);
    ) : (
      pk_courtier(r, s);
    );
    gfx_setfont(3, r == 8 ? "Arial Narrow" : "Georgia", (r == 8 ? 19 : 21) * g_ck, 'b');
    s == 1 || s == 2 ? gfx_set(0.8, 0.09, 0.12, 1) : gfx_set(0.09, 0.09, 0.12, 1);
    r == 8 ? strcpy(#pk_rk, "10") : r == 9 ? strcpy(#pk_rk, "J") : r == 10 ? strcpy(#pk_rk, "Q") : r == 11 ? strcpy(#pk_rk, "K") : r == 12 ? strcpy(#pk_rk, "A") : sprintf(#pk_rk, "%d", r + 2);
    gfx_measurestr(#pk_rk, tw, th);
    gfx_x = g_cx0 + 10 * g_ck - tw * 0.5; gfx_y = g_cy0 + 2 * g_ck;
    gfx_drawstr(#pk_rk);
    pk_suit(s, 10, 27, 5.8, 1);
    x = g_cx0; y = g_cy0;
    gfx_dest = IMG_PKO;
    gfx_mode = 2;
    gfx_blit(IMG_PKW, 1, 0, x, y, 80 * g_ck, 56 * g_ck, 0, 0, 80 * g_ck, 56 * g_ck);
    gfx_dest = IMG_PKW;
    (r >= 9 && r <= 11) ? (
      gfx_blit(IMG_PKO, 1, $pi, 0, 0, 80 * g_ck, 56 * g_ck, x, y + 56 * g_ck, 80 * g_ck, 56 * g_ck);
      gfx_mode = 0;
      gfx_set(0.1, 0.1, 0.25, 1);
      pc_l(21, 12, 59, 12, 0.8); pc_l(21, 100, 59, 100, 0.8); pc_l(19, 13, 19, 99, 0.8); pc_l(61, 13, 61, 99, 0.8);
      gfx_set(0.1, 0.1, 0.25, 0.8); pc_l(19, 57, 61, 55, 0.8);
    ) : (
      gfx_blit(IMG_PKO, 1, $pi, 0, 0, 20 * g_ck, 38 * g_ck, x + 60 * g_ck, y + 74 * g_ck, 20 * g_ck, 38 * g_ck);
    );
    gfx_mode = 0;
    c += 1;
  );
  gfx_dest = IMG_PKW;
  g_cx0 = 2 * g_ck; g_cy0 = 4 * ch * 2 + 3 * g_ck;
  gfx_set(0.08, 0.06, 0.05, 1); pk_cardbase(80, 112);
  g_cx0 += 0.5 * g_ck; g_cy0 += 0.5 * g_ck;
  gfx_set(0.97, 0.95, 0.9, 1); pk_cardbase(79, 111);
  g_cx0 += 4 * g_ck; g_cy0 += 4 * g_ck;
  gfx_set(0.42, 0.06, 0.1, 1); pk_cardbase(71, 103);
  a = 0;
  gfx_set(0.72, 0.2, 0.22, 1);
  y = 0;
  while (y < 11) (
    x = 0;
    while (x < 8) (
      pc_q(x * 9 + 4, y * 9.5 + 1, x * 9 + 8, y * 9.5 + 5.5, x * 9 + 4, y * 9.5 + 10, x * 9, y * 9.5 + 5.5);
      x += 1;
    );
    y += 1;
  );
  gfx_set(0.42, 0.06, 0.1, 1); pc_q(35.5, 34, 58, 52, 35.5, 70, 13, 52);
  gfx_set(0.93, 0.74, 0.3, 1); pc_q(35.5, 37, 55, 52, 35.5, 67, 16, 52);
  gfx_set(0.42, 0.06, 0.1, 1); pc_q(35.5, 40, 52, 52, 35.5, 64, 19, 52);
  gfx_set(0.93, 0.74, 0.3, 1); pk_suit(3, 35.5, 52, 8, 1);
  g_cx0 -= 4.5 * g_ck; g_cy0 -= 4.5 * g_ck;
  i = 0;
  loop(6,
    g_cx0 = (84 + i * 42) * g_s * 2; g_cy0 = 4 * ch * 2 + 4 * g_ck;
    r = i == 0 ? 0.12 : i == 1 ? 0.1 : i == 2 ? 0.42 : i == 3 ? 0.9 : i == 4 ? 0.85 : 0.1;
    n = i == 0 ? 0.58 : i == 1 ? 0.1 : i == 2 ? 0.14 : i == 3 ? 0.68 : i == 4 ? 0.3 : 0.32;
    z = i == 0 ? 0.28 : i == 1 ? 0.12 : i == 2 ? 0.62 : i == 3 ? 0.12 : i == 4 ? 0.08 : 0.82;
    u = g_ck;
    gfx_set(r * 0.42, n * 0.42, z * 0.42, 1);
    pk_ef(g_cx0 + 20 * u, g_cy0 + 19 * u, 19 * u, 11.5 * u);
    gfx_rect(g_cx0 + u, g_cy0 + 13.5 * u, 38 * u, 5.5 * u);
    gfx_set(r * 0.9, n * 0.9, z * 0.9, 1);
    pk_ef(g_cx0 + 20 * u, g_cy0 + 13.5 * u, 19 * u, 11.5 * u);
    gfx_set(0.95, 0.94, 0.9, 1);
    a = 0;
    loop(6,
      x = a + 0.17;
      gfx_triangle(g_cx0 + (20 + 19 * cos(a)) * u, g_cy0 + (13.5 + 11.5 * sin(a)) * u, g_cx0 + (20 + 19 * cos(x)) * u, g_cy0 + (13.5 + 11.5 * sin(x)) * u,
                   g_cx0 + (20 + 14 * cos(x)) * u, g_cy0 + (13.5 + 8.5 * sin(x)) * u, g_cx0 + (20 + 14 * cos(a)) * u, g_cy0 + (13.5 + 8.5 * sin(a)) * u);
      (sin(a) > -0.2) ? gfx_rect(g_cx0 + (20 + 19 * cos(a + 0.08)) * u - u, g_cy0 + (13.5 + 11.5 * sin(a + 0.08)) * u, 2 * u, 5 * u);
      a += $pi / 3;
    );
    gfx_set(r * 1.08 + 0.05, n * 1.08 + 0.05, z * 1.08 + 0.05, 1);
    pk_ef(g_cx0 + 20 * u, g_cy0 + 13.5 * u, 12 * u, 7.2 * u);
    gfx_set(0.95, 0.94, 0.9, 0.85);
    pk_ef(g_cx0 + 20 * u, g_cy0 + 13.5 * u, 8 * u, 4.8 * u);
    gfx_set(r, n, z, 1);
    pk_ef(g_cx0 + 20 * u, g_cy0 + 13.5 * u, 6.6 * u, 3.9 * u);
    i += 1;
  );
  gfx_setimgdim(IMG_PKA, 0, 0);
  gfx_setimgdim(IMG_PKA, 13 * cw, 5 * ch);
  gfx_dest = IMG_PKA;
  gfx_mode = 2; gfx_a = 1;
  gfx_blit(IMG_PKW, 1, 0, 0, 0, 13 * cw * 2, 5 * ch * 2, 0, 0, 13 * cw, 5 * ch);
  gfx_mode = 0;
  gfx_dest = dst;
);

function pk_card(c, x, y, w, h, rot, a) local(sx0, sy0, r, dw, dh)
(
  c < 0 ? ( sx0 = 0; sy0 = 4 * g_pk_ach; ) : ( r = c % 13; sx0 = r * g_pk_acw; sy0 = ((c - r) / 13) * g_pk_ach; );
  dw = w * 84 / 80 * g_s; dh = h * 118 / 112 * g_s;
  gfx_a = a; gfx_mode = 0;
  gfx_blit(IMG_PKA, 1, rot, sx0, sy0, g_pk_acw, g_pk_ach, sx(x) - dw * 0.5, sy(y) - dh * 0.5, dw, dh);
  gfx_a = 1;
);

function pk_cardf(c, x, y, w, h, rot, fl, a) local(k, dw, dh)
(
  k = abs(2 * fl - 1);
  k < 0.04 ? k = 0.04;
  pk_card(fl >= 0.5 ? c : -1, x, y - sin(fl * $pi) * h * 0.18, w * k, h * (1 + 0.08 * sin(fl * $pi)), rot, a);
);

function pk_chip1(i, x, y, z) local(sx0, sy0, w, h)
(
  sx0 = (84 + i * 42) * g_s; sy0 = 4 * g_pk_ach + 8 * g_s;
  w = 40 * g_s; h = 34 * g_s;
  gfx_mode = 0; gfx_a = 1;
  gfx_blit(IMG_PKA, 1, 0, sx0, sy0, w, h, sx(x) - 20 * z * g_s * 0.5, sy(y) - 14 * z * g_s * 0.5, 20 * z * g_s, 17 * z * g_s);
);

function pk_stack(amt, x, y, z) local(v, d, n, col, h, i, cx, cols, tot, k, dv)
(
  v = amt; tot = 0; cols = 0;
  d = 5;
  while (d >= 0) (
    dv = d == 5 ? 25000 : d == 4 ? 5000 : d == 3 ? 1000 : d == 2 ? 500 : d == 1 ? 100 : 25;
    n = min(floor(v / dv), 14);
    v -= floor(v / dv) * dv;
    n > 0 ? ( pk_lays[cols] = d; pk_lays[cols + 4] = n; cols < 3 ? cols += 1; );
    d -= 1;
  );
  (amt > 0 && cols == 0) ? ( pk_lays[0] = 0; pk_lays[4] = 1; cols = 1; );
  col = 0;
  while (col < cols) (
    cx = x + (col - (cols - 1) * 0.5) * 19 * z;
    h = 0; n = pk_lays[col + 4]; i = pk_lays[col];
    loop(n, pk_chip1(i, cx, y - h * 3.6 * z - 2, z); h += 1; );
    col += 1;
  );
);

function rt_noise(x, y) local(ix, iy, fx, fy, a, b, c, d)
(
  ix = floor(x); iy = floor(y); fx = x - ix; fy = y - iy;
  fx = fx * fx * (3 - 2 * fx); fy = fy * fy * (3 - 2 * fy);
  a = frac(sin(ix * 127.1 + iy * 311.7) * 43758.5453); b = frac(sin((ix + 1) * 127.1 + iy * 311.7) * 43758.5453);
  c = frac(sin(ix * 127.1 + (iy + 1) * 311.7) * 43758.5453); d = frac(sin((ix + 1) * 127.1 + (iy + 1) * 311.7) * 43758.5453);
  a + (b - a) * fx + (c - a) * fy + (a - b - c + d) * fx * fy;
);

function rt_cam(w, h)
(
  rt_w = w; rt_h = h;
  rt_ex = 0; rt_ey = 2.45; rt_ez = 3.75;
  rt_fx = 0 - rt_ex; rt_fy = -0.2 - rt_ey; rt_fz = -0.28 - rt_ez;
  rt_l = sqrt(rt_fx ^ 2 + rt_fy ^ 2 + rt_fz ^ 2);
  rt_fx /= rt_l; rt_fy /= rt_l; rt_fz /= rt_l;
  rt_rx = 1; rt_ry = 0; rt_rz = 0;
  rt_ux = 0; rt_uy = rt_fz * -1; rt_uz = rt_fy;
  rt_foc = 0.9 * w;
);

function rt_proj(x, y, z) local(dx, dy, dz, c)
(
  dx = x - rt_ex; dy = y - rt_ey; dz = z - rt_ez;
  c = dx * rt_fx + dy * rt_fy + dz * rt_fz;
  rt_px = rt_w * 0.5 + rt_foc * (dx * rt_rx) / c;
  rt_py = rt_h * 0.5 - rt_foc * (dx * rt_ux + dy * rt_uy + dz * rt_uz) / c;
  rt_ps = rt_foc / c;
);

function rt_mat(v)
(
  rt_v = v;
  v == 0 ? ( rt_fr = 0.06; rt_fg = 0.3; rt_fb = 0.17; rt_lr = 0.1; rt_lg = 0.045; rt_lb = 0.028; rt_ambr = 0.3; rt_ambg = 0.22; rt_ambb = 0.15; rt_trr = 0.86; rt_trg = 0.7; rt_trb = 0.42; ) :
  v == 1 ? ( rt_fr = 0.36; rt_fg = 0.05; rt_fb = 0.07; rt_lr = 0.07; rt_lg = 0.035; rt_lb = 0.02; rt_ambr = 0.3; rt_ambg = 0.2; rt_ambb = 0.13; rt_trr = 0.92; rt_trg = 0.72; rt_trb = 0.36; ) :
  v == 2 ? ( rt_fr = 0.05; rt_fg = 0.17; rt_fb = 0.36; rt_lr = 0.02; rt_lg = 0.022; rt_lb = 0.03; rt_ambr = 0.1; rt_ambg = 0.13; rt_ambb = 0.26; rt_trr = 0.75; rt_trg = 0.85; rt_trb = 1; ) :
  v == 3 ? ( rt_fr = 0.2; rt_fg = 0.07; rt_fb = 0.32; rt_lr = 0.022; rt_lg = 0.018; rt_lb = 0.02; rt_ambr = 0.22; rt_ambg = 0.18; rt_ambb = 0.18; rt_trr = 1; rt_trg = 0.82; rt_trb = 0.45; ) :
  ( rt_fr = 0.07; rt_fg = 0.07; rt_fb = 0.08; rt_lr = 0.012; rt_lg = 0.012; rt_lb = 0.014; rt_ambr = 0.14; rt_ambg = 0.14; rt_ambb = 0.17; rt_trr = 1; rt_trg = 0.8; rt_trb = 0.35; );
);

function rt_floor(x, z) local(u, w, n, k, a, b, pl, s)
(
  rt_gloss = 0;
  rt_v == 0 || rt_v == 1 ? (
    pl = floor(z / 0.22);
    u = x + hash(pl * 3.1) * 7;
    a = floor(u / 1.6);
    w = rt_noise(u * 1.1 + pl * 9, z * 30) * 0.55 + rt_noise(u * 3, z * 90) * 0.3;
    k = (rt_v == 0 ? 0.2 : 0.14) * (0.62 + 0.75 * hash(pl * 7.7 + a) * 0.6 + w * 0.6);
    rt_ar = k; rt_ag = k * 0.62; rt_ab = k * 0.36;
    (frac(z / 0.22) < 0.018 || frac(u / 1.6) < 0.0035) ? ( rt_ar *= 0.25; rt_ag *= 0.25; rt_ab *= 0.25; );
    rt_gloss = 0.25;
  ) : rt_v == 2 ? (
    a = floor(x / 0.6); b = floor(z / 0.6);
    k = 0.1 + 0.04 * hash(a * 1.7 + b * 3.3) + 0.035 * rt_noise(x * 9, z * 9);
    rt_ar = k * 0.9; rt_ag = k * 0.95; rt_ab = k * 1.2;
    (frac(x / 0.6) < 0.02 || frac(z / 0.6) < 0.02) ? ( rt_ar *= 0.35; rt_ag *= 0.35; rt_ab *= 0.35; );
    rt_gloss = 0.5;
  ) : rt_v == 3 ? (
    a = floor(x / 0.8); b = floor(z / 0.8);
    s = (a + b) & 1;
    n = rt_noise(x * 3 + rt_noise(z * 4, x * 2) * 3, z * 3);
    k = s ? 0.5 + 0.2 * n : 0.035 + 0.05 * n;
    rt_ar = k; rt_ag = k * 0.97; rt_ab = k * (s ? 0.88 : 1.1);
    (frac(x / 0.8) < 0.012 || frac(z / 0.8) < 0.012) ? ( rt_ar = 0.5; rt_ag = 0.38; rt_ab = 0.14; );
    rt_gloss = 1;
  ) : (
    k = 0.11 + 0.05 * rt_noise(x * 2.3, z * 2.3) + 0.03 * rt_noise(x * 15, z * 15);
    a = floor(x / 1.3); b = floor(z / 1.3);
    rt_ar = k; rt_ag = k; rt_ab = k * 1.04;
    (frac(x / 1.3) < 0.008 || frac(z / 1.3) < 0.008) ? ( rt_ar *= 0.4; rt_ag *= 0.4; rt_ab *= 0.4; );
    rt_gloss = 0.35;
  );
);

function rt_row(py, W) local(px, dx, dy, dz, l, u, v, t, x, y, z, ax, d2, gx, gz, hit, k, sd, tb, i, nx, ny, nz, hl, lx, ly, lz, dd, ndl, hx, hy, hz, ndh, sp, rr, gg, bb, ao, e, fr, rfy, rfx, rfz, env, gr, s, tube, H, RF, RC, R, TBL, sh, qx, qz, q, c, tx, tz, q2)
(
  TBL = 0.92; RF = 1.06; RC = 1.2; R = 0.13; H = 0.055;
  v = (rt_h * 0.5 - py) / rt_foc;
  px = 0;
  loop(W,
    u = (px - rt_w * 0.5) / rt_foc;
    dx = rt_fx + u * rt_rx + v * rt_ux; dy = rt_fy + u * rt_ry + v * rt_uy; dz = rt_fz + u * rt_rz + v * rt_uz;
    l = 1 / sqrt(dx * dx + dy * dy + dz * dz); dx *= l; dy *= l; dz *= l;
    hit = 0; y = 1;
    t = (0.26 - rt_ey) / dy;
    x = rt_ex + dx * t; z = rt_ez + dz * t;
    ax = abs(x) - TBL; ax = ax < 0 ? 0 : ax;
    q = sqrt(ax * ax + z * z);
    t = (0 - rt_ey) / dy;
    tx = rt_ex + dx * t; tz = rt_ez + dz * t;
    ax = abs(tx) - TBL; ax = ax < 0 ? 0 : ax;
    d2 = sqrt(ax * ax + tz * tz);
    (d2 < RF - 0.1 && q < RF - 0.1) ? (
      hit = 2; x = tx; y = 0; z = tz;
    ) : (q < 1.8 || d2 < 1.8) ? (
      t = (0.26 - rt_ey) / dy;
      i = 0;
      while (i < 60 && !hit && y > -0.9) (
        x = rt_ex + dx * t; y = rt_ey + dy * t; z = rt_ez + dz * t;
        ax = abs(x) - TBL; ax = ax < 0 ? 0 : ax;
        d2 = sqrt(ax * ax + z * z);
        tube = sqrt((d2 - RC) * (d2 - RC) + (y - H) * (y - H) * 1.4) - R;
        k = max(max(d2 - 1.2, y + 0.03), -0.72 - y);
        sd = min(tube, k);
        (y <= 0.0005 && d2 < RF) ? hit = 2 :
        sd < 0.0009 ? ( hit = tube < k ? 1 : 3; ) :
        t += max(sd * 0.82, 0.0012);
        i += 1;
      );
    );
    (!(px & 1) && !(py & 1) && rt_ds) ? rt_dep[(px >> 1) + (py >> 1) * (rt_w >> 1)] = hit ? ((x - rt_ex) * dx + (y - rt_ey) * dy + (z - rt_ez) * dz) : 1000;
    !hit ? (
      t = (-0.75 - rt_ey) / dy;
      tz = rt_ez + dz * t;
      tz > RT_WZ ? (
        hit = 4; x = rt_ex + dx * t; y = -0.75; z = tz;
      ) : (
        t = (RT_WZ - rt_ez) / dz;
        hit = 5; x = rt_ex + dx * t; y = rt_ey + dy * t; z = RT_WZ;
      );
    );
    ax = abs(x) - TBL; ax = ax < 0 ? 0 : ax;
    d2 = sqrt(ax * ax + z * z);
    gx = (x < 0 ? -ax : ax) / max(d2, 0.0001); gz = z / max(d2, 0.0001);
    lx = 0 - x; ly = 1.85 - y; lz = 0 - z;
    dd = sqrt(lx * lx + ly * ly + lz * lz); lx /= dd; ly /= dd; lz /= dd;
    e = 1.9 / (1 + 0.32 * dd * dd);
    hit == 2 ? (
      s = rt_noise(x * 6, z * 6) * 0.5 + rt_noise(x * 21, z * 21) * 0.3;
      k = 0.74 + 0.16 * s + (rand(1) - 0.5) * 0.09;
      ao = 1 - 0.68 * exp(-(RF - d2) / 0.06);
      ao *= 1 - 0.34 * exp(-(RF - d2) / 0.24);
      fr = e * ly * k * ao;
      rr = rt_fr * fr; gg = rt_fg * fr; bb = rt_fb * fr;
      q = rt_mask[floor((x + 2.2) / 4.4 * 1024) + floor((z + 1.2) / 2.4 * 560) * 1024];
      q > 0 ? ( rr += rt_trr * q * 0.24 * fr; gg += rt_trg * q * 0.24 * fr; bb += rt_trb * q * 0.24 * fr; );
    ) : (hit == 1 || hit == 3) ? (
      tb = d2 - RC;
      hit == 3 ? (
        nx = gx; nz = gz; ny = 0;
        k = 0.012 + 0.01 * rt_noise(x * 14, y * 200);
        ndl = max(0, nx * lx + ny * ly + nz * lz);
        rr = rt_lr * 0.4 * (0.25 + e * ndl); gg = rt_lg * 0.4 * (0.25 + e * ndl); bb = rt_lb * 0.4 * (0.25 + e * ndl);
      ) : (
        nx = gx * tb / R; ny = (y - H) * 1.4 / R; nz = gz * tb / R;
        l = 1 / sqrt(nx * nx + ny * ny + nz * nz); nx *= l; ny *= l; nz *= l;
        nx += 0.016 * (rt_noise(x * 150, z * 150) - 0.5); ny += 0.016 * (rt_noise(z * 150, y * 150) - 0.5);
        ndl = max(0, nx * lx + ny * ly + nz * lz);
        hx = lx - dx; hy = ly - dy; hz = lz - dz;
        l = 1 / sqrt(hx * hx + hy * hy + hz * hz); hx *= l; hy *= l; hz *= l;
        ndh = max(0, nx * hx + ny * hy + nz * hz);
        sp = (ndh ^ 18) * 0.05 + (ndh ^ 140) * 0.3 + (ndh ^ 900) * 0.5;
        k = max(0, -(dx * nx + dy * ny + dz * nz));
        rfy = dy + 2 * k * ny; rfx = dx + 2 * k * nx; rfz = dz + 2 * k * nz;
        fr = 0.04 + 0.96 * (1 - k) ^ 5;
        env = max(0, rfy); env = 0.07 + 0.6 * env * env;
        sp = sp * e * 0.8 + fr * env;
        ao = min(1, 0.4 + 0.8 * max(0, ny + 0.5));
        k = abs(tb + 0.09) < 0.004 || abs(tb - 0.09) < 0.004 ? 0.7 : 1;
        rr = (rt_lr * (0.1 + e * ndl) * k + sp) * ao;
        gg = (rt_lg * (0.1 + e * ndl) * k + sp * 0.96) * ao;
        bb = (rt_lb * (0.1 + e * ndl) * k + sp * 0.9) * ao;
      );
    ) : hit == 4 ? (
      rt_floor(x, z);
      t = (0.06 + 0.75) / (1.85 + 0.75);
      qx = x * (1 - t); qz = z * (1 - t);
      ax = abs(qx) - TBL; ax = ax < 0 ? 0 : ax;
      q = sqrt(ax * ax + qz * qz);
      sh = q < 1.0 ? 0.08 : q > 1.55 ? 1 : 0.08 + 0.92 * (q - 1.0) / 0.55;
      ndl = ly;
      k = e * ndl * sh;
      rr = rt_ar * (rt_ambr * 1.1 + k); gg = rt_ag * (rt_ambg * 1.1 + k); bb = rt_ab * (rt_ambb * 1.1 + k);
      rt_gloss > 0 ? (
        hx = lx - dx; hy = ly - dy; hz = lz - dz;
        l = 1 / sqrt(hx * hx + hy * hy + hz * hz);
        ndh = hy * l;
        sp = (ndh ^ 90) * rt_gloss * 0.7 * sh * e;
        rr += sp; gg += sp * 0.95; bb += sp * 0.85;
      );
      k = 1 - 0.55 * exp(-(z - RT_WZ) / 0.5);
      rr *= k; gg *= k; bb *= k;
    ) : (
      i = rt_wt[floor(frac((x + 3.05) / 6.1) * 1023.9) + floor(max(0, min(0.999, 1 - (y + 0.75) / 2.2)) * 400) * 1024];
      rr = ((i >> 16) & 255) / 255; gg = ((i >> 8) & 255) / 255; bb = (i & 255) / 255;
      rr = rr ^ 2.2; gg = gg ^ 2.2; bb = bb ^ 2.2;
      k = (rt_v == 2 ? 1 : (rt_ambr * 1.2 + e * max(0, lz + 0.25) * 1.5)) * (1 - 0.55 * exp(-(y + 0.75) / 0.24));
      rr *= k; gg *= k; bb *= k;
    );
    rr = 1 - exp(-rr * 1.25); gg = 1 - exp(-gg * 1.25); bb = 1 - exp(-bb * 1.25);
    gfx_x = px; gfx_y = py; gfx_setpixel(rr ^ 0.4545, gg ^ 0.4545, bb ^ 0.4545);
    px += 1;
  );
);

function cm(i, r, g, b, s, n, p) ( cm_r[i] = r ^ 2.2; cm_g[i] = g ^ 2.2; cm_b[i] = b ^ 2.2; cm_s[i] = s; cm_n[i] = n; cm_p[i] = p; );
function cp_e(x, y, z, rx, ry, rz, m, bl) local(i)
( i = g_cn; g_cn += 1; cp_t[i] = 0; cp_ax[i] = x; cp_ay[i] = y; cp_az[i] = z; cp_bx[i] = rx; cp_by[i] = ry; cp_bz[i] = rz; cp_m[i] = m; cp_bl[i] = bl; cp_cx[i] = x; cp_cy[i] = y; cp_cz[i] = z; cp_rad[i] = max(rx, max(ry, rz)) + bl; );
function cp_c(x, y, z, x2, y2, z2, r1, r2, m, bl) local(i)
( i = g_cn; g_cn += 1; cp_t[i] = 1; cp_ax[i] = x; cp_ay[i] = y; cp_az[i] = z; cp_bx[i] = x2 - x; cp_by[i] = y2 - y; cp_bz[i] = z2 - z; cp_r1[i] = r1; cp_r2[i] = r2; cp_m[i] = m; cp_bl[i] = bl;
  cp_cx[i] = (x + x2) * 0.5; cp_cy[i] = (y + y2) * 0.5; cp_cz[i] = (z + z2) * 0.5; cp_rad[i] = 0.5 * sqrt((x2 - x) ^ 2 + (y2 - y) ^ 2 + (z2 - z) ^ 2) + max(r1, r2) + bl; );
function cp_box(x, y, z, hx, hy, hz, r, m, bl) local(i)
( i = g_cn; g_cn += 1; cp_t[i] = 2; cp_ax[i] = x; cp_ay[i] = y; cp_az[i] = z; cp_bx[i] = hx; cp_by[i] = hy; cp_bz[i] = hz; cp_r1[i] = r; cp_m[i] = m; cp_bl[i] = bl; cp_cx[i] = x; cp_cy[i] = y; cp_cz[i] = z; cp_rad[i] = sqrt(hx * hx + hy * hy + hz * hz) + r + bl; );
function cp_tor(x, y, z, rmaj, rmin, m, bl) local(i)
( i = g_cn; g_cn += 1; cp_t[i] = 3; cp_ax[i] = x; cp_ay[i] = y; cp_az[i] = z; cp_r1[i] = rmaj; cp_r2[i] = rmin; cp_m[i] = m; cp_bl[i] = bl; cp_cx[i] = x; cp_cy[i] = y; cp_cz[i] = z; cp_rad[i] = rmaj + rmin + bl; );

function cp_ring(x, y, z, rmaj, rmin, m) local(i)
( i = g_cn; g_cn += 1; cp_t[i] = 4; cp_ax[i] = x; cp_ay[i] = y; cp_az[i] = z; cp_r1[i] = rmaj; cp_r2[i] = rmin; cp_m[i] = m; cp_bl[i] = 0; cp_cx[i] = x; cp_cy[i] = y; cp_cz[i] = z; cp_rad[i] = rmaj + rmin; );

function sd_prim(i, x, y, z) local(t, qx, qy, qz, k0, k1, h, a, b, c)
(
  t = cp_t[i];
  qx = x - cp_ax[i]; qy = y - cp_ay[i]; qz = z - cp_az[i];
  t == 0 ? (
    a = cp_bx[i]; b = cp_by[i]; c = cp_bz[i];
    k0 = sqrt((qx * qx) / (a * a) + (qy * qy) / (b * b) + (qz * qz) / (c * c));
    k1 = sqrt((qx * qx) / (a * a * a * a) + (qy * qy) / (b * b * b * b) + (qz * qz) / (c * c * c * c));
    k1 < 0.000001 ? -min(a, min(b, c)) : k0 * (k0 - 1) / k1;
  ) : t == 1 ? (
    a = cp_bx[i]; b = cp_by[i]; c = cp_bz[i];
    h = (qx * a + qy * b + qz * c) / (a * a + b * b + c * c + 0.000001);
    h = h < 0 ? 0 : h > 1 ? 1 : h;
    qx -= a * h; qy -= b * h; qz -= c * h;
    sqrt(qx * qx + qy * qy + qz * qz) - (cp_r1[i] + (cp_r2[i] - cp_r1[i]) * h);
  ) : t == 2 ? (
    qx = abs(qx) - cp_bx[i]; qy = abs(qy) - cp_by[i]; qz = abs(qz) - cp_bz[i];
    a = max(qx, 0); b = max(qy, 0); c = max(qz, 0);
    sqrt(a * a + b * b + c * c) + min(max(qx, max(qy, qz)), 0) - cp_r1[i];
  ) : t == 3 ? (
    a = sqrt(qx * qx + qz * qz) - cp_r1[i];
    sqrt(a * a + qy * qy) - cp_r2[i];
  ) : (
    a = sqrt(qx * qx + qy * qy) - cp_r1[i];
    sqrt(a * a + qz * qz) - cp_r2[i];
  );
);

function sd_map(x, y, z) local(i, d, di, j, k, h)
(
  d = 100000; j = 0; g_cmat = 0;
  loop(g_cna,
    i = cp_a[j];
    di = sd_prim(i, x, y, z);
    k = cp_bl[i];
    k > 0 ? (
      h = 0.5 + 0.5 * (d - di) / k;
      h = h < 0 ? 0 : h > 1 ? 1 : h;
      di < d ? g_cmat = cp_m[i];
      d = d + (di - d) * h - k * h * (1 - h);
    ) : (
      di < d ? ( d = di; g_cmat = cp_m[i]; );
    );
    j += 1;
  );
  d;
);

function sd_list(ox, oy, oz, dx, dy, dz, ex) local(i, cx, cy, cz, t, dd)
(
  g_cna = 0; i = 0;
  loop(g_cn,
    cx = cp_cx[i] - ox; cy = cp_cy[i] - oy; cz = cp_cz[i] - oz;
    t = cx * dx + cy * dy + cz * dz;
    cx -= dx * t; cy -= dy * t; cz -= dz * t;
    dd = cp_rad[i] + ex;
    (cx * cx + cy * cy + cz * cz) < dd * dd ? ( cp_a[g_cna] = i; g_cna += 1; );
    i += 1;
  );
);

function char_setup(sx0, sy0, sz0, yaw, tilt, k)
(
  g_cwx = sx0; g_cwy = sy0; g_cwz = sz0; g_ck0 = k;
  g_ccy = cos(yaw); g_csy = sin(yaw); g_cct = cos(tilt); g_cst = sin(tilt);
);
function to_local(x, y, z) local(a, b, c)
(
  x -= g_cwx; y -= g_cwy; z -= g_cwz;
  b = y * g_cct - z * g_cst; c = y * g_cst + z * g_cct;
  g_lx = x * g_ccy - c * g_csy; g_ly = b; g_lz = x * g_csy + c * g_ccy;
);

function char_begin(img, x0, y0, w, h)
(
  g_cimg = img; g_cx0 = x0; g_cy0 = y0; g_cw = w; g_ch = h;
  to_local(rt_ex, rt_ey, rt_ez); g_cox = g_lx / g_ck0; g_coy = g_ly / g_ck0; g_coz = g_lz / g_ck0;
  to_local(0, 1.85, 0); g_clx = g_lx / g_ck0; g_cly = g_ly / g_ck0; g_clz = g_lz / g_ck0;
);

function char_row(py) local(px, u, v, dx, dy, dz, l, ox, oy, oz, rx, ry, rz, t, t1, d, i, hit, x, y, z, nx, ny, nz, e, m, lx, ly, lz, ndl, ao, sh, rr, gg, bb, n, sp, h1, k, st, vx, vy, vz, rim, dep, wt, ax, ay, az, hx, hy, hz, ld, ar, ag, ab, p, x0, y0)
(
  gfx_dest = g_cimg; gfx_mode = 0; gfx_a = 1;
  ox = g_cox; oy = g_coy; oz = g_coz; lx = g_clx; ly = g_cly; lz = g_clz; x0 = g_cx0; y0 = g_cy0;
  v = (rt_h * 0.5 - (py + y0)) / rt_foc;
  px = 0;
  loop(g_cw,
    u = (px + x0 - rt_w * 0.5) / rt_foc;
    dx = rt_fx + u * rt_rx + v * rt_ux; dy = rt_fy + u * rt_ry + v * rt_uy; dz = rt_fz + u * rt_rz + v * rt_uz;
    l = 1 / sqrt(dx * dx + dy * dy + dz * dz); dx *= l; dy *= l; dz *= l;
    ay = dy * g_cct - dz * g_cst; az = dy * g_cst + dz * g_cct;
    rx = dx * g_ccy - az * g_csy; ry = ay; rz = dx * g_csy + az * g_ccy;
    sd_list(ox, oy, oz, rx, ry, rz, 1.5);
    hit = 0;
    g_cna > 0 ? (
      t = sqrt(ox * ox + (oy + 40) * (oy + 40) + oz * oz) - 300;
      t1 = t + 700;
      i = 0;
      while (i < 56 && !hit && t < t1) (
        x = ox + rx * t; y = oy + ry * t; z = oz + rz * t;
        d = sd_map(x, y, z);
        d < 0.25 ? hit = 1 : t += d * 0.92;
        i += 1;
      );
    );
    (hit && !g_cnodep) ? (
      dep = rt_dep[((px + x0) >> 1) + ((py + y0) >> 1) * (rt_w >> 1)];
      t * g_ck0 > dep + 0.015 ? hit = 0;
    );
    hit ? (
      m = g_cmat;
      e = 0.6;
      nx = sd_map(x + e, y - e, z - e); ny = sd_map(x - e, y + e, z - e); nz = sd_map(x - e, y - e, z + e); n = sd_map(x + e, y + e, z + e);
      vx = nx - ny - nz + n; vy = ny - nx - nz + n; vz = nz - nx - ny + n;
      l = 1 / sqrt(vx * vx + vy * vy + vz * vz + 0.0000001); nx = vx * l; ny = vy * l; nz = vz * l;
      p = cm_p[m];
      ar = cm_r[m]; ag = cm_g[m]; ab = cm_b[m];
      cm_n[m] > 0 ? (
        k = cm_n[m] * (rt_noise(x * 0.9 + z * 0.5, y * 0.9) - 0.5);
        nx += k; ny += k * 0.6;
      );
      p == 1 ? (
        k = (frac((x + 200) / 26) < 0.22 ? 1 : 0) + (frac((y + 400) / 26) < 0.22 ? 1 : 0);
        k = 1 - 0.42 * k * 0.5 + (frac((x + 200) / 26) < 0.08 ? 0.5 : 0);
        ar *= k; ag *= k; ab *= k;
      ) : p == 2 ? (
        (y < -14 && rt_noise(x * 1.9, y * 1.9 + z) > 0.56) ? ( ar *= 0.45; ag *= 0.4; ab *= 0.38; );
      ) : p == 3 ? (
        k = rt_noise(x * 1.5, y * 1.5 + z);
        k > 0.74 ? ( ar = min(1, ar * 5); ag = min(1, ag * 5); ab = min(1, ab * 5); );
      ) : p == 4 ? (
        k = 0.72 + 0.56 * rt_noise(x * 1.2 + z, y * 1.2);
        ar *= k; ag *= k; ab *= k;
      ) : p == 5 ? (
        k = rt_noise(x * 0.32 + z * 0.2, y * 0.32);
        k > 0.62 ? ( ar = 0.3; ag = 0.11; ab = 0.03; );
      ) : p == 6 ? (
        k = max(abs(frac((x + 200) / 22) - 0.5), abs(frac((y + 400) / 22) - 0.5));
        k > 0.44 ? ( nx *= 0.8; ar *= 0.5; ag *= 0.5; ab *= 0.5; );
      );
      ax = lx - x; ay = ly - y; az = lz - z;
      ld = 1 / sqrt(ax * ax + ay * ay + az * az); ax *= ld; ay *= ld; az *= ld;
      ndl = nx * ax + ny * ay + nz * az;
      wt = max(0, (ndl + 0.3) / 1.3);
      sd_list(x, y, z, ax, ay, az, 2);
      sh = 1; st = 3; i = 0;
      while (i < 14 && sh > 0.05 && st < 140) (
        d = sd_map(x + ax * st, y + ay * st, z + az * st);
        sh = min(sh, max(0, 7 * d / st));
        st += max(d, 2.5);
        i += 1;
      );
      sd_list(x, y, z, nx, ny, nz, 16);
      ao = 1;
      d = sd_map(x + nx * 4, y + ny * 4, z + nz * 4); ao -= max(0, 4 - d) * 0.09;
      d = sd_map(x + nx * 11, y + ny * 11, z + nz * 11); ao -= max(0, 11 - d) * 0.035;
      ao = max(0.25, ao);
      vx = -rx; vy = -ry; vz = -rz;
      k = 1 - max(0, nx * vx + ny * vy + nz * vz);
      rim = k * k * k;
      hx = ax + vx; hy = ay + vy; hz = az + vz;
      l = 1 / sqrt(hx * hx + hy * hy + hz * hz);
      h1 = max(0, (nx * hx + ny * hy + nz * hz) * l);
      sp = (h1 ^ 46) * cm_s[m] * sh * 1.2;
      k = (0.5 + 0.5 * ny) * ao;
      ld = 1.5 * wt * (0.22 + 0.78 * sh);
      rr = ar * (k * rt_ambr * 1.7 + ld + rim * 0.4 * ao) + sp;
      gg = ag * (k * rt_ambg * 1.7 + ld * 0.95 + rim * 0.34 * ao) + sp;
      bb = ab * (k * rt_ambb * 1.7 + ld * 0.86 + rim * 0.28 * ao) + sp;
      rr = 1 - exp(-rr * 1.25); gg = 1 - exp(-gg * 1.25); bb = 1 - exp(-bb * 1.25);
      gfx_x = px; gfx_y = py; gfx_setpixel(rr ^ 0.4545, gg ^ 0.4545, bb ^ 0.4545);
    );
    px += 1;
  );
);

function ch_body(m, w)
