    );
    i = 0;
    loop(28,
      x = 8 + i * 33; y = 118 + 26 * (1 - ((i % 14 - 6.5) / 6.5) ^ 2);
      gfx_set(0.03, 0.03, 0.04, 1); gfx_rect(sx(x), sy(y - 2), 34 * g_s, 1.6 * g_s);
      gfx_mode = 1; gfx_set(1, 0.74, 0.35, 0.16); gfx_circle(sx(x), sy(y + 5), 15 * g_s, 1, 1); gfx_set(1, 0.85, 0.5, 0.95); gfx_circle(sx(x), sy(y + 4), 3.3 * g_s, 1, 1); gfx_mode = 0;
      i += 1;
    );
  ) : v == 3 ? (
    gfx_set(0.05, 0.11, 0.13, 1); gfx_rect(0, 0, bw, bh);
    y = 0; j = 0;
    while (y < 360) (
