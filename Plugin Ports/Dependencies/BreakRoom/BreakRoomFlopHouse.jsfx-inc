      gfx_set(1, 0.95, 0.75, 1); gfx_circle(sx(450 + i * 18), sy(114 - abs(i) * 2), 4 * g_s, 1, 1);
      gfx_mode = 1; gfx_set(1, 0.85, 0.5, 0.2); gfx_circle(sx(450 + i * 18), sy(114 - abs(i) * 2), 13 * g_s, 1, 1); gfx_mode = 0;
      gfx_set(0.9, 0.95, 1, 0.8); gfx_triangle(sx(450 + i * 18 - 3), sy(121 - abs(i) * 2), sx(450 + i * 18 + 3), sy(121 - abs(i) * 2), sx(450 + i * 18), sy(134 - abs(i) * 2));
