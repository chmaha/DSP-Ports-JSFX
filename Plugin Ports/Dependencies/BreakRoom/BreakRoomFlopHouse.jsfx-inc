);

function p3(x, y, z) local(dx, dy, dz, c)
(
  dx = x - rt_ex; dy = y - rt_ey; dz = z - rt_ez;
  c = dx * rt_fx + dy * rt_fy + dz * rt_fz;
  g_3x = BRD_X + 432 + 777.6 * dx / c;
  g_3y = BRD_Y + 292 - 777.6 * (dx * rt_ux + dy * rt_uy + dz * rt_uz) / c;
  g_3s = 777.6 / c;
);

function pk_layout() local(s, v)
(
  rt_cam(864, 584);
  s = 1;
  loop(5,
    p3(pk_wx[s], pk_wy[s], pk_wz[s]);
    pk_sxs[s] = g_3x; pk_sys[s] = g_3y; pk_ppu[s] = 0.0058 * g_3s;
    p3(pk_rx[s], 0.2, pk_rz[s]); pk_px[s] = g_3x; pk_py[s] = g_3y;
    p3(pk_bwx[s], 0, pk_bwz[s]); pk_bx[s] = g_3x; pk_by[s] = g_3y;
    s += 1;
  );
  p3(-0.78, 0, 0.72); pk_bx[0] = g_3x; pk_by[0] = g_3y;
  pk_sxs[0] = 450; pk_sys[0] = 700; pk_px[0] = 625; pk_py[0] = 556; pk_cx[0] = 450; pk_cy[0] = 536;
  p3(0.42, 0, 0.72); g_pk_ptx = g_3x; g_pk_pty = g_3y;
  p3(1.52, 0, 0.42); g_pk_dkx = g_3x; g_pk_dky = g_3y;
);

function pf_pt(u, v) local(z, q, a, b, c, x)
(
  q = 1 - (u * u) / 1400 - (v * v) / 1800;
  z = g_fzf * (q > 0 ? sqrt(q) : 0) + g_fz0;
  x = u * g_ccy2 + z * g_csy2; c = -u * g_csy2 + z * g_ccy2;
  b = -v * g_cct2 + c * g_cst2; c = v * g_cst2 + c * g_cct2;
  p3(g_fwx + x * 0.0058, g_fwy + b * 0.0058, g_fwz + c * 0.0058);
  g_qx = sx(g_3x); g_qy = sy(g_3y + g_fdy);
);
function pf_c(u, v, r) ( pf_pt(u, v); gfx_circle(g_qx, g_qy, max(0.6, r * g_fsc), 1, 1); );
function pf_l(a, b, c, d, w) local(x0, y0)
(
  pf_pt(a, b); x0 = g_qx; y0 = g_qy;
  pf_pt(c, d);
  aa_tline(x0, y0, g_qx, g_qy, max(0.6, (w - 0.8) * g_fsc));
);
function pf_e(u, v, rx, ry) ( pf_pt(u, v); pk_ef(g_qx, g_qy, max(0.8, rx * g_fsc * g_fxk), max(0.8, ry * g_fsc * 0.96)); );
function pf_q(a, b, c, d) local(x0, y0, x1, y1, x2, y2)
(
  pf_pt(a, b); x0 = g_qx; y0 = g_qy;
  pf_pt(c, b); x1 = g_qx; y1 = g_qy;
  pf_pt(c, d); x2 = g_qx; y2 = g_qy;
  pf_pt(a, d);
  gfx_triangle(x0, y0, x1, y1, x2, y2, g_qx, g_qy);
);
function pf_cv(x0, y0, x1, y1, x2, y2, w) local(t, ax, ay, bx, by)
(
  ax = x0; ay = y0; t = 0;
  loop(8,
    t += 0.125;
    bx = (1 - t) * (1 - t) * x0 + 2 * t * (1 - t) * x1 + t * t * x2;
    by = (1 - t) * (1 - t) * y0 + 2 * t * (1 - t) * y1 + t * t * y2;
    pf_l(ax, ay, bx, by, w);
    ax = bx; ay = by;
  );
);

function pf_eye(u, v, gx, gy, bl, lid, r, g, b, ir, ig, ib)
(
  bl > 0.85 ? (
    gfx_set(r * 0.72, g * 0.66, b * 0.62, 1);
    pf_e(u, v, 8.6, 7.8);
    gfx_set(r * 0.3, g * 0.24, b * 0.22, 1);
    pf_cv(u - 8.4, v + 0.5, u, v + 3.5, u + 8.4, v + 0.5, 1.7);
  ) : (
    gfx_set(ir * 0.55, ig * 0.55, ib * 0.55, 1); pf_c(u + gx * 2.9, v + gy * 2.5, 5);
    gfx_set(ir, ig, ib, 1); pf_c(u + gx * 3, v + gy * 2.6 + 0.4, 3.9);
    gfx_set(0.02, 0.02, 0.03, 1); pf_c(u + gx * 3.2, v + gy * 2.8, 2.3);
    gfx_set(1, 1, 1, 0.95); pf_c(u + gx * 2.6 - 1.3, v + gy * 2.1 - 1.5, 1.05);
    gfx_set(0.12, 0.08, 0.07, 1);
    pf_cv(u - 8.6, v - 1, u, v - 10 + lid * 8, u + 8.6, v - 1, 1.5);
    lid > 0.05 ? (
      gfx_set(r * 0.86, g * 0.8, b * 0.76, 1);
      pf_q(u - 8.3, v - 8.2, u + 8.3, v - 8.2 + lid * 14);
      gfx_set(0.14, 0.09, 0.08, 1);
      pf_l(u - 8.3, v - 8.2 + lid * 14, u + 8.3, v - 8.2 + lid * 14, 1.4);
    );
  );
);

function pk_face(s, md, tl, gx, gy, bl, talk, tt, dyy) local(c, r, g, b, m, wide, op, bra, brh, lid, lidr, er, eg, eb, k, t, x, y, a, sl, ab)
(
  c = pk_ch[s];
  g_fwx = pk_wx[s]; g_fwy = pk_wy[s]; g_fwz = pk_wz[s]; g_fdy = dyy;
  g_ccy2 = cos(pk_yaw[s]); g_csy2 = sin(pk_yaw[s]); g_cct2 = cos(0.36); g_cst2 = sin(0.36);
  g_fsc = pk_ppu[s] * g_s; g_fxk = 0.42 + 0.58 * g_ccy2;
  g_fzf = 34; g_fz0 = 0.5;
  r = pk_sr[c]; g = pk_sg[c]; b = pk_sb[c];
  t = g_t;
  bra = md == 6 ? 3.6 : md == 3 ? -2.5 : md == 4 ? -1 : 0;
  brh = md == 4 ? -5 : md == 6 ? 2 : 0;
  lid = md == 5 ? 0.38 : md == 6 ? 0.28 : md == 3 ? 0.16 : 0;
  lidr = lid;
  er = 0.3; eg = 0.42; eb = 0.25;
  (c == 3 || c == 5 || c == 9) ? ( er = 0.28; eg = 0.18; eb = 0.1; );
  c == 8 ? ( er = 0.1; eg = 0.45; eb = 0.48; );
  c == 2 ? ( er = 0.18; eg = 0.38; eb = 0.6; );
  c == 7 ? (
    k = (tl == 1 && tt) ? 2 : (tl == 2 && tt) ? 1 : 0;
    gfx_set(0.2, 0.9, 1, 1);
    g_fzf = 0; g_fz0 = 34;
    bl > 0.85 ? pf_l(-23, -4, -5, -4, 2) : pf_q(-23, -11, -5, md == 3 ? 1 : 3);
    bl > 0.85 ? pf_l(5, -4, 23, -4, 2) : pf_q(5, -11, 23, md == 3 ? 1 : 3);
    gfx_set(0.02, 0.05, 0.08, 1); pf_c(-14 + gx * 4, -4 + gy * 3, 2.8); pf_c(14 + gx * 4, -4 + gy * 3, 2.8);
    x = 0;
    loop(7,
      a = talk ? 0.5 + 0.3 * sin(t * 9 + x * 2) : (md == 2 || md == 1) ? 1 - abs(x - 3) * 0.2 : md == 3 ? abs(x - 3) * 0.24 : md == 4 ? 1 : 0.35;
      gfx_set(0.95, 0.72, 0.2, 1);
      pf_q(-19 + x * 5.5, 24 - a * 5, -14.6 + x * 5.5, 24 + a * 5);
      x += 1;
    );
    gfx_set(k == 2 ? 0.2 : k == 1 ? 1 : 0.62, k == 2 ? 1 : k == 1 ? 0.15 : 0.6, k == 2 ? 0.35 : k == 1 ? 0.1 : 0.3, 1);
    g_fzf = 0; g_fz0 = 0;
    pf_c(0, -64, 4.5);
    k ? ( gfx_mode = 1; gfx_a = 0.25; pf_c(0, -64, 10); gfx_mode = 0; );
  ) : c == 11 ? (
    a = (tl == 1 && tt) ? 1 : 0.34;
    g_fzf = 0; g_fz0 = 36;
    gfx_mode = 1;
    gfx_set(1, 0.2, 0.08, a * 0.32); pf_c(-14 + gx * 2, -6 + gy, 9 + 3 * a); pf_c(14 + gx * 2, -6 + gy, 9 + 3 * a);
    gfx_set(1, 0.5, 0.2, a); pf_c(-14 + gx * 2, -6 + gy, 2.6); pf_c(14 + gx * 2, -6 + gy, 2.6);
    gfx_mode = 0;
    talk ? ( gfx_set(0.02, 0.01, 0.03, 1); pf_e(0, 32 + 2 * sin(t * 20), 10, 3); );
  ) : (
    (c == 1 && tl == 1 && tt) ? ( gy = -1; lid = 0; lidr = 0; );
    (c == 6 && tl == 2 && tt) ? ( gy = -1; gx = 0.2; lid = 0; lidr = 0; brh = -4; bra = -1.5; );
    (c == 5 && tl == 2 && tt) ? lidr = 1;
    g_fzf = 8; g_fz0 = 25;
    pf_eye(-14, -5, gx, gy, bl, lid, r, g, b, er, eg, eb);
    lidr >= 1 ? pf_eye(14, -5, gx, gy, 1, 0, r, g, b, er, eg, eb) : pf_eye(14, -5, gx, gy, bl, lidr, r, g, b, er, eg, eb);
    g_fzf = 34; g_fz0 = 1;
    gfx_set(pk_br[c], pk_bg[c], pk_bb[c], 1);
    a = (c == 3 || c == 2 || c == 9) ? 3.8 : (c == 5 || c == 1) ? 1.9 : 2.8;
    pf_l(-24, -19 + brh - bra * 0.3, -6, -19 + brh + bra, a);
    pf_l(24, -19 + brh - bra * 0.3, 6, -19 + brh + bra, a);
    c == 9 ? (
      gfx_set(0.82, 0.68, 0.3, 1);
      (tl == 1 && tt) ? (
        pf_l(20, 4, 22, 28, 0.9);
        pf_pt(22, 34); gfx_circle(g_qx, g_qy, 7 * g_fsc, 0, 1);
      ) : (
        g_fzf = 8; g_fz0 = 28;
        pf_pt(14, -5); gfx_circle(g_qx, g_qy, 11 * g_fsc, 0, 1); gfx_circle(g_qx, g_qy, 10.4 * g_fsc, 0, 1);
        g_fzf = 34; g_fz0 = 1;
        pf_cv(24, -1, 32, 16, 27, 34, 0.9);
      );
    );
    c == 10 ? (
      sl = (tl == 2 && tt) ? 6 : 0;
      g_fzf = 8; g_fz0 = 28;
      gfx_set(0.015, 0.015, 0.02, 1);
      pf_q(-27, sl - 13, -3, sl + 2); pf_q(3, sl - 13, 27, sl + 2);
      pf_l(-4, sl - 10, 4, sl - 10, 1.8);
      gfx_set(0.55, 0.62, 0.78, 0.6); pf_l(-23, sl - 2, -13, sl - 11, 2); pf_l(9, sl - 2, 19, sl - 11, 2);
      g_fzf = 34; g_fz0 = 1;
    );
    m = md;
    op = talk ? 0.5 + 0.5 * sin(t * 9) : 0;
    wide = c == 3 ? 14 : 12;
    y = c == 3 ? 21 : c == 2 ? 27 : (c == 4 || c == 9) ? 26 : 24;
    (c == 0 && tl == 1 && tt) ? (
      gfx_set(0.3, 0.1, 0.1, 1); pf_c(2, y, 3.2);
      gfx_set(0.9, 0.9, 1, 0.9 * (0.5 + 0.5 * sin(t * 3)));
      k = 0;
      loop(3,
        a = frac(t * 0.6 + k / 3);
        x = 26 + a * 26 + 4 * sin(a * 8);
        pf_c(x, y - 8 - a * 30, 2.4); pf_l(x + 2, y - 8 - a * 30, x + 2, y - 17 - a * 30, 1);
        k += 1;
      );
    ) : (op > 0.45 || m == 4) ? (
      gfx_set(0.24, 0.05, 0.06, 1);
      pf_e(0, y + 2, m == 4 ? 9 : 7, m == 4 ? 11 : 1.5 + 2.5 * op);
      m == 4 ? ( gfx_set(0.9, 0.46, 0.46, 1); pf_e(0, y + 7, 4.5, 2); );
    ) : m == 2 ? (
      gfx_set(0.22, 0.05, 0.05, 1); pf_q(-wide, y - 1, wide, y + 6);
      gfx_set(0.97, 0.96, 0.9, 1); pf_q(-wide + 1, y - 1, wide - 1, y + 3);
      gfx_set(0.3, 0.1, 0.09, 1); pf_cv(-wide - 3, y - 2, 0, y, wide + 3, y - 2, 1.5);
    ) : m == 6 ? (
      gfx_set(0.14, 0.06, 0.06, 1); pf_q(-11, y - 1, 11, y + 6);
      gfx_set(0.95, 0.94, 0.88, 1); k = 0; loop(5, pf_q(-10 + k * 4.2, y, -7 + k * 4.2, y + 5); k += 1; );
    ) : (
      gfx_set(c == 5 ? 0.72 : r * 0.42, c == 5 ? 0.08 : g * 0.24, c == 5 ? 0.14 : b * 0.24, 1);
      a = m == 1 ? 6 : m == 3 ? -5 : 0;
      m == 5 ? pf_cv(-wide, y + 1, 0, y + 2, wide + 2, y - 5, c == 5 ? 3 : 2.1) : pf_cv(-wide, y, 0, y + a, wide, y, c == 5 ? 3.2 : 2.1);
    );
    (c == 8 && tl == 1 && tt) ? (
      a = 0.5 + 0.5 * sin(t * 2.1);
      gfx_set(0.98, 0.45, 0.72, 0.92); pf_c(9, y, 3 + a * 8);
      gfx_set(1, 0.8, 0.9, 0.9); pf_c(6, y - a * 3, 0.5 + a * 1.4);
    );
    (c == 3 && tl == 2 && tt) ? (
      gfx_set(0.55, 0.85, 1, 0.92);
      k = 0;
      loop(3, a = frac(t * 0.9 + k * 0.37); pf_c((k - 1) * 22 + 2, -26 + a * 26, 2.6); k += 1; );
    );
    (c == 2 && tl == 2 && tt) ? (
      a = sin(t * 13) * 2;
      gfx_set(r * 0.9, g * 0.86, b * 0.84, 1);
      pf_c(16, 44 + a, 9); k = 0; loop(3, pf_l(10 + k * 6, 40 + a, 8 + k * 4, 31 + a, 3.6); k += 1; );
    );
    (c == 4 && tl == 1 && tt) ? (
      a = (sin(t * 11) > 0) * 2;
      gfx_set(r * 0.9, g * 0.86, b * 0.84, 1);
      pf_l(31, -9 + a, 36, 12, 4); pf_c(36, 16, 7);
    );
  );
);

function pk_mkmask() local(x, y, r, g, b, tw, th, i, t, dst)
(
  gfx_setimgdim(IMG_PKO, 1024, 560); gfx_dest = IMG_PKO; gfx_mode = 0; gfx_set(0, 0, 0, 1); gfx_rect(0, 0, 1024, 560);
  gfx_set(1, 1, 1, 1);
  i = 0;
  loop(1600,
    t = i / 1600 * 2 * $pi;
    x = (cos(t) > 0 ? 0.92 : -0.92) + 0.82 * cos(t); y = 0.82 * sin(t);
    gfx_circle((x + 2.2) / 4.4 * 1024, (y + 1.2) / 2.4 * 560, 1.2, 1, 1);
    i += 1;
  );
  gfx_setfont(4, "Georgia", 56, 'bi'); gfx_set(1, 1, 1, 0.55);
  gfx_measurestr("Flop House", tw, th); gfx_x = 512 - tw * 0.5; gfx_y = 280 - 118 - th * 0.5; gfx_drawstr("Flop House");
  y = 0;
  loop(560,
    gfx_y = y; x = 0;
    loop(1024, gfx_x = x; gfx_getpixel(r, g, b); rt_mask[x + y * 1024] = r; x += 1; );
    y += 1;
  );
);

function pk_mkwall(v) local(x, y, r, g, b, s0, ox0, oy0)
(
  s0 = g_s; ox0 = g_ox; oy0 = g_oy;
  g_s = 1024 / 900; g_ox = 0; g_oy = -66 * g_s;
  gfx_setimgdim(IMG_PKO, 1024, 400); gfx_dest = IMG_PKO; gfx_mode = 0; gfx_a = 1;
  pk_wall(v, 1024, 400);
  y = 0;
  loop(400,
    gfx_y = y; x = 0;
    loop(1024, gfx_x = x; gfx_getpixel(r, g, b); rt_wt[x + y * 1024] = (floor(r * 255) << 16) + (floor(g * 255) << 8) + floor(b * 255); x += 1; );
    y += 1;
  );
  g_s = s0; g_ox = ox0; g_oy = oy0;
);

function pk_textures(v) local(dst)
(
  dst = gfx_dest;
  !g_pk_maskok ? ( pk_mkmask(); g_pk_maskok = 1; );
  g_pk_txv !== v + 1 ? ( pk_mkwall(v); g_pk_txv = v + 1; );
  rt_mat(v);
  gfx_dest = dst;
);

function pk_seatbox(s) local(p, x0, y0, w, h)
(
  p = pk_ppu[s];
  x0 = max(BRD_X, pk_sxs[s] - 118 * p); w = min(BRD_X + BRD_W, pk_sxs[s] + 118 * p) - x0;
  y0 = max(BRD_Y, pk_sys[s] - 90 * p); h = min(BRD_Y + BRD_H, pk_sys[s] + 260 * p) - y0;
  pk_spx[s] = x0; pk_spy[s] = y0; pk_spw[s] = w; pk_sph[s] = h;
);

function pk_bake_step() local(t0, n, s, w, h, x0, y0, dst, bw, bh, v)
(
  dst = gfx_dest;
  t0 = time_precise();
  n = 0;
  while (!g_pk_ready && n < 500 && time_precise() - t0 < 0.05) (
    g_pk_bk == 0 ? (
      pk_textures(g_pk_ven);
      g_pk_bs = min(2 * g_s, 2.4);
      g_pk_bw = ceil(864 * g_pk_bs); g_pk_bh = ceil(584 * g_pk_bs);
      rt_cam(g_pk_bw, g_pk_bh);
      rt_ds = 1;
      gfx_setimgdim(IMG_PKW, 0, 0); gfx_setimgdim(IMG_PKW, g_pk_bw, g_pk_bh);
      g_pk_br = 0; g_pk_bk = 1; g_pk_bsz = g_s;
      n += 40;
    ) : g_pk_bk == 1 ? (
      gfx_dest = IMG_PKW; gfx_mode = 0; gfx_a = 1;
      rt_row(g_pk_br, g_pk_bw);
      g_pk_br += 1; n += 2;
      g_pk_br >= g_pk_bh ? ( g_pk_bk = 2; g_pk_bse = 1; g_pk_br = -1; );
    ) : g_pk_bk == 2 ? (
      s = g_pk_bse;
      s > 5 ? ( g_pk_bk = 3; ) : pk_ch[s] < 0 ? g_pk_bse += 1 : (
        g_pk_br < 0 ? (
          pk_seatbox(s);
          ch_chair(0);
          char_setup(pk_wx[s], pk_wy[s], pk_wz[s], pk_yaw[s], 0.08, 0.0058);
          x0 = floor((pk_spx[s] - BRD_X) * g_pk_bs); y0 = floor((pk_spy[s] - BRD_Y) * g_pk_bs);
          g_pk_bpw = ceil(pk_spw[s] * g_pk_bs); g_pk_bph = ceil(pk_sph[s] * g_pk_bs);
          gfx_setimgdim(IMG_PKD, 0, 0); gfx_setimgdim(IMG_PKD, g_pk_bpw, g_pk_bph);
          g_cnodep = 0;
          char_begin(IMG_PKD, x0, y0, g_pk_bpw, g_pk_bph);
          g_pk_br = 0;
        ) : (
          char_row(g_pk_br);
          g_pk_br += 1; n += 2;
          g_pk_br >= g_pk_bph ? (
            gfx_dest = IMG_PKW; gfx_mode = 0; gfx_a = 1;
            gfx_blit(IMG_PKD, 1, 0, 0, 0, g_pk_bpw, g_pk_bph, g_cx0, g_cy0, g_pk_bpw, g_pk_bph);
            g_pk_br = -1; g_pk_bse += 1;
          );
        );
      );
    ) : g_pk_bk == 3 ? (
      bw = ceil(BRD_W * g_s); bh = ceil(BRD_H * g_s);
      gfx_setimgdim(IMG_PKR, bw, bh);
      gfx_dest = IMG_PKR; gfx_mode = 2; gfx_a = 1;
      gfx_blit(IMG_PKW, 1, 0, 0, 0, g_pk_bw, g_pk_bh, 0, 0, bw, bh);
      gfx_mode = 0;
      g_pk_bk = 4; g_pk_bse = 1; g_pk_br = -1;
      n += 20;
    ) : (
      s = g_pk_bse;
      s > 5 ? ( g_pk_ready = 1; g_pk_bk = 0; g_pk_bgw = 1; rt_cam(g_pk_bw, g_pk_bh); ) : pk_ch[s] < 0 ? g_pk_bse += 1 : (
        g_pk_br < 0 ? (
          g_cbakeface = 0;
          ch_build(pk_ch[s]);
          char_setup(pk_wx[s], pk_wy[s], pk_wz[s], pk_yaw[s], 0.36, 0.0058);
          x0 = floor((pk_spx[s] - BRD_X) * g_pk_bs); y0 = floor((pk_spy[s] - BRD_Y) * g_pk_bs);
          g_pk_bpw = ceil(pk_spw[s] * g_pk_bs); g_pk_bph = ceil(pk_sph[s] * g_pk_bs);
          gfx_setimgdim(IMG_PKD, 0, 0); gfx_setimgdim(IMG_PKD, g_pk_bpw, g_pk_bph);
          g_cnodep = 0;
          char_begin(IMG_PKD, x0, y0, g_pk_bpw, g_pk_bph);
          g_pk_br = 0;
        ) : (
          char_row(g_pk_br);
          g_pk_br += 1; n += 3;
          g_pk_br >= g_pk_bph ? (
            w = ceil(pk_spw[s] * g_s); h = ceil(pk_sph[s] * g_s);
            gfx_setimgdim(IMG_PKP + s, 0, 0); gfx_setimgdim(IMG_PKP + s, w, h);
            gfx_dest = IMG_PKP + s; gfx_mode = 2; gfx_a = 1;
            gfx_blit(IMG_PKD, 1, 0, 0, 0, g_pk_bpw, g_pk_bph, 0, 0, w, h);
            gfx_mode = 0;
            pk_spiw[s] = w; pk_spih[s] = h;
            g_pk_br = -1; g_pk_bse += 1;
          );
        );
      );
    );
  );
  gfx_dest = dst; gfx_mode = 0; gfx_a = 1;
);

function pk_gal_step() local(c, w, h, s0, dst, bw, bh)
(
  g_pk_gi < 12 ? (
    c = g_pk_gi;
    dst = gfx_dest;
    w = ceil(100 * g_s); h = ceil(118 * g_s);
    g_pk_gi == 0 ? ( gfx_setimgdim(IMG_PKG, 0, 0); gfx_setimgdim(IMG_PKG, w * 6, h * 2); );
    bw = ceil(w * 1.5); bh = ceil(h * 1.5);
    rt_w = bw; rt_h = bh; rt_foc = bw * 2.9 / 0.78;
    rt_ex = 0; rt_ey = -0.1; rt_ez = 2.9; rt_fx = 0; rt_fy = 0; rt_fz = -1; rt_rx = 1; rt_ry = 0; rt_rz = 0; rt_ux = 0; rt_uy = 1; rt_uz = 0;
    g_cbakeface = 1;
    ch_build(c);
    g_cbakeface = 0;
    char_setup(0, 0, 0, 0, 0, 0.0058);
    g_cnodep = 1;
    gfx_setimgdim(IMG_PKD, 0, 0); gfx_setimgdim(IMG_PKD, bw, bh);
    char_begin(IMG_PKD, 0, 0, bw, bh);
    s0 = 0; loop(bh, char_row(s0); s0 += 1; );
    g_cnodep = 0;
    gfx_dest = IMG_PKG; gfx_mode = 2; gfx_a = 1;
    gfx_blit(IMG_PKD, 1, 0, 0, 0, bw, bh, (c % 6) * w, floor(c / 6) * h, w, h);
    gfx_mode = 0;
    gfx_dest = dst;
    rt_cam(864, 584);
    g_pk_gi += 1;
  );
);

function pk_gal_blit(c, x, y, w, h, a) local(cw, ch)
(
  cw = ceil(100 * g_s); ch = ceil(118 * g_s);
  gfx_mode = 0; gfx_a = a;
  c < g_pk_gi ? gfx_blit(IMG_PKG, 1, 0, (c % 6) * cw, floor(c / 6) * ch, cw, ch, sx(x), sy(y), w * g_s, h * g_s);
  gfx_a = 1;
);

function pk_wrap(s, x, y, w) local(n, st, br, i, tw, th, ln)
(
  strcpy(#pk_w0, s);
  n = strlen(#pk_w0); st = 0; ln = 0;
  while (st < n && ln < 6) (
    i = st; br = -1;
    while (i <= n && br !== -2) (
      (i == n || str_getchar(#pk_w0, i) == 32) ? (
        strcpy_substr(#pk_w1, #pk_w0, st, i - st);
        gfx_measurestr(#pk_w1, tw, th);
        tw / g_s <= w ? br = i : br = br >= 0 ? br : i;
        (tw / g_s > w) ? ( i = n + 1; );
      );
      i += 1;
    );
    strcpy_substr(#pk_w1, #pk_w0, st, br - st);
    txt_l(#pk_w1, x, y + ln * (th / g_s));
    st = br + 1; ln += 1;
  );
);

function pk_vname(v) ( v == 0 ? "The Back Room" : v == 1 ? "The Riverboat" : v == 2 ? "The Rooftop" : v == 3 ? "The Penthouse" : "The Vault"; );
function pk_title(lv) ( lv >= 11 ? "Legend of the Felt" : lv >= 10 ? "Vault Challenger" : lv >= 8 ? "High Roller" : lv >= 6 ? "Skyline Shark" : lv >= 4 ? "River Rat" : lv >= 2 ? "Pub Regular" : "Fresh Meat"; );


function pk_softsprite() local(i, dst, r)
(
  dst = gfx_dest;
  gfx_setimgdim(IMG_PKF, 96, 96);
  gfx_dest = IMG_PKF; gfx_mode = 2; gfx_set(0, 0, 0, 1); gfx_rect(0, 0, 96, 96); gfx_mode = 0;
  i = 0;
  loop(47,
    r = 47 - i;
    gfx_set(0.82, 0.8, 0.74, 1);
    gfx_a = 0.003 + 0.0005 * i;
    gfx_mode = 1; gfx_circle(48, 48, r, 1, 1);
    i += 1;
  );
  gfx_mode = 0; gfx_a = 1;
  gfx_dest = dst;
  g_pk_sf = 1;
);

function pk_assets() local(i, k)
(
  !g_pk_tb ? pk_tables();
  !g_pk_sf ? pk_softsprite();
  g_pk_as !== g_s ? ( pk_atlas(); g_pk_as = g_s; g_pk_gi = 0; );
  g_pk_layn !== g_pk_nst ? ( g_pk_layn = g_pk_nst; pk_layout(); g_pk_ready = 0; g_pk_bk = 0; g_pk_bse = 0; );
  (g_pk_ready && abs(g_s / g_pk_bsz - 1) > 0.06) ? (
    g_pk_rzt == 0 ? g_pk_rzt = g_t;
    g_t - g_pk_rzt > 0.7 ? ( g_pk_ready = 0; g_pk_bk = 0; g_pk_rzt = 0; );
  ) : g_pk_rzt = 0;
);

function pk_gaze(s) local(a, tx, ty, h, cam)
(
  a = g_pk_a;
  cam = -0.75 * sin(pk_yaw[s]);
  tx = cam; ty = 0.05;
  (g_pk_s == 2 && a > 0 && a != s) ? (
    tx = cam + max(-0.5, min(0.5, (pk_sxs[a] - pk_sxs[s]) / 500));
  ) : (g_pk_s == 4 || (g_pk_s >= 5 && g_pk_s <= 6)) ? (
    tx = cam + max(-0.3, min(0.3, (450 - pk_sxs[s]) / 900)); ty = 0.45;
  ) : (
    h = floor(g_t / 3.7 + s * 0.61);
    frac(sin(h * 12.9898 + s * 78.233) * 43758.5453) < 0.14 ? ( tx = cam + (frac(sin(h * 4.1 + s) * 9143.17) < 0.5 ? -0.3 : 0.3); );
  );
  tx = max(-1, min(1, tx)); ty = max(-1, min(1, ty));
  pk_gx[s] += (tx - pk_gx[s]) * min(1, g_dt * 11);
  pk_gy[s] += (ty - pk_gy[s]) * min(1, g_dt * 11);
);

function pk_seat_bust(s) local(c, bob, d, m, bl, talk, tt, a, x, y, w, h, img)
(
  c = pk_ch[s];
  c >= 0 ? (
    d = pk_out[s] ? max(0, g_pk_t - pk_kot[s] - 1.1) * 240 : 0;
    d < 190 ? (
      bob = 0;
      w = pk_spw[s] * g_s; h = pk_sph[s] * g_s;
      gfx_mode = 0; gfx_a = 1;
      gfx_blit(IMG_PKP + s, 1, 0, 0, 0, pk_spiw[s], pk_spih[s], sx(pk_spx[s]), sy(pk_spy[s] + bob + d), w, h);
      m = g_pk_t < pk_moodt[s] ? pk_mood[s] : (pk_tilt[s] > 0.5 ? 3 : 0);
      a = frac(g_t * 0.21 + s * 0.31);
      bl = (a < 0.022 || (frac(g_t * 0.13 + s * 0.17) < 0.012)) ? 1 : 0;
      pk_gaze(s);
      talk = g_pk_t - pk_sayt[s] < 1.5;
      tt = g_pk_t - pk_tellt[s] < 5 && pk_tell[s] && pk_in[s];
      (c == 7 && pk_in[s] && pk_tell[s]) ? tt = 1;
      pk_face(s, m, pk_tell[s], pk_gx[s], pk_gy[s], bl, talk, tt, bob + d);
      (pk_tilt[s] > 0.5 && !pk_out[s]) ? (
        gfx_set(1, 0.3, 0.2, 0.3);
        a = 0; x = pk_sxs[s]; y = pk_sys[s] + bob;
        loop(3, d = frac(g_t * 1.3 + a / 3); gfx_circle(sx(x + (a - 1) * 34 + sin(d * 8) * 4), sy(y - 34 - d * 26), (3 + d * 6) * g_s, 1, 1); a += 1; );
      );
    );
  );
);

function pk_qcard(c, wx, wz, w, d, lift, skew, kw, a) local(x0, x1, x2, x3, y0, y1, s0, s1, py, t, v, sx0, sy0, r, xl, xr, m, n, hh, lw)
(
  c < 0 ? ( sx0 = 0; sy0 = 4 * g_pk_ach; ) : ( r = c % 13; sx0 = r * g_pk_acw; sy0 = ((c - r) / 13) * g_pk_ach; );
  w *= kw;
  p3(wx - w * 0.5 + skew, lift, wz - d * 0.5); x0 = g_3x; y0 = g_3y; s0 = g_3s;
  p3(wx + w * 0.5 + skew, lift, wz - d * 0.5); x1 = g_3x;
  p3(wx - w * 0.5 - skew, lift, wz + d * 0.5); x2 = g_3x; y1 = g_3y; s1 = g_3s;
  p3(wx + w * 0.5 - skew, lift, wz + d * 0.5); x3 = g_3x;
  hh = (y1 - y0) * g_s;
  n = ceil(hh);
  gfx_mode = 0; gfx_a = a;
  py = 0;
  m = max(1, g_pk_ach / max(1, n));
  loop(n,
    t = (py + 0.5) / n;
    v = (t * s1) / ((1 - t) * s0 + t * s1);
    xl = x0 + (x2 - x0) * t; xr = x1 + (x3 - x1) * t;
    gfx_blit(IMG_PKA, 1, 0, sx0, sy0 + v * (g_pk_ach - m), g_pk_acw, m, sx(xl), sy(y0) + py, (xr - xl) * g_s, 1);
    py += 1;
  );
  gfx_a = 1;
);

function pk_qpoly(wx, wz, w, d, lift, ox) local(a, b, c, dd, e, f, g, h)
(
  p3(wx - w * 0.5 + ox, lift, wz - d * 0.5); a = sx(g_3x); b = sy(g_3y);
  p3(wx + w * 0.5 + ox, lift, wz - d * 0.5); c = sx(g_3x); dd = sy(g_3y);
  p3(wx + w * 0.5 + ox, lift, wz + d * 0.5); e = sx(g_3x); f = sy(g_3y);
  p3(wx - w * 0.5 + ox, lift, wz + d * 0.5); g = sx(g_3x); h = sy(g_3y);
  gfx_triangle(a, b, c, dd, e, f, g, h);
);

function pk_cards3(s) local(i, c, wx, wz, t, tf, fl, a, fy, hl, w, d, x, y, kw, rot, sk)
(
  (pk_ch[s] >= 0 && !pk_out[s] && g_pk_hand > 0 && g_pk_s < 8) ? (
    i = 0;
    loop(2,
      c = i ? pk_c2[s] : pk_c1[s];
      t = g_pk_t - pk_cdt[s * 2 + i];
      w = pk_flipt[s] > 0 ? 0.34 : 0.26; d = pk_flipt[s] > 0 ? 0.68 : 0.36;
      (t >= 0 && pk_st[s] + pk_tot[s] > 0 && (pk_foldt[s] == 0 || g_pk_t - pk_foldt[s] < 0.4)) ? (
        wx = pk_cwx[s] + (i - 0.5) * (pk_flipt[s] > 0 ? 0.33 : 0.17); wz = pk_cwz[s];
        p3(wx, 0, wz); x = g_3x; y = g_3y;
        sk = (i - 0.5) * 0.05;
        tf = min(1, t / 0.28);
        tf < 1 ? (
          tf = 1 - (1 - tf) * (1 - tf);
          rot = (1 - tf) * 5.5 * (i ? -1 : 1);
          pk_card(-1, g_pk_dkx + (x - g_pk_dkx) * tf, g_pk_dky + (y - g_pk_dky) * tf - sin(tf * $pi) * 26, 38, 42, rot, 1);
        ) : (
          a = 1; fy = 0;
          pk_foldt[s] > 0 ? (
            fy = min(1, (g_pk_t - pk_foldt[s]) / 0.34);
            wx += (0 - wx) * fy * 0.7; wz += (0 - wz) * fy * 0.7; a = 1 - fy;
          );
          fl = pk_flipt[s] > 0 ? min(1, (g_pk_t - pk_flipt[s]) / 0.3) : 0;
          kw = max(0.05, abs(2 * fl - 1));
          hl = pk_hl[s * 2 + i] && g_pk_paid;
          hl ? ( gfx_mode = 1; gfx_set(1, 0.85, 0.3, 0.4 + 0.12 * sin(g_t * 6)); pk_qpoly(wx, wz, w + 0.06, d + 0.06, 0.004, 0); gfx_mode = 0; );
          pk_flipt[s] > 0 ? sk = 0;
          gfx_set(0, 0, 0, 0.16 * a); pk_qpoly(wx, wz + 0.01, w * kw * 0.96, d * 0.97, 0.002, 0.006);
          pk_qcard(fl >= 0.5 ? c : -1, wx, wz, w, d, 0.01 + sin(fl * $pi) * 0.1, sk, kw, a);
          (g_pk_paid && g_pk_wcat >= 0 && !hl && pk_flipt[s] > 0) ? ( gfx_set(0, 0, 0, 0.2); pk_qpoly(wx, wz, w * 0.97, d * 0.97, 0.01, 0); );
        );
      );
      i += 1;
    );
  );
);

function pk_hero() local(i, c, x, y, w, h, rot, t, tf, fl, a, hl)
(
  (!pk_out[0] && g_pk_hand > 0 && g_pk_s < 8) ? (
    i = 0; w = 78; h = 110;
    loop(2,
      c = i ? pk_c2[0] : pk_c1[0];
      t = g_pk_t - pk_cdt[i];
      (t >= 0 && pk_st[0] + pk_tot[0] > 0) ? (
        x = pk_cx[0] + (i - 0.5) * 54; y = pk_cy[0] + abs(i - 0.5) * 6;
        rot = (i - 0.5) * 0.15;
        tf = min(1, t / 0.28); tf = 1 - (1 - tf) * (1 - tf);
        x = g_pk_dkx + (x - g_pk_dkx) * tf; y = g_pk_dky + (y - g_pk_dky) * tf - sin(tf * $pi) * 26;
        rot += (1 - tf) * 5.5 * (i ? -1 : 1);
        a = 1;
        fl = pk_foldt[0] == 0 ? min(1, max(0, (t - 0.3) / 0.28)) : 1;
        pk_foldt[0] > 0 ? a = 0.45;
        hl = pk_hl[i] && g_pk_paid;
        hl ? ( y -= 8; gfx_mode = 1; gfx_set(1, 0.85, 0.3, 0.3 + 0.1 * sin(g_t * 6)); fill_rr(x - w * 0.5 - 5, y - h * 0.5 - 5, w + 10, h + 10, 9); gfx_mode = 0; );
        (fl <= 0 || fl >= 1) && tf >= 1 ? ( gfx_set(0, 0, 0, 0.38 * a); fill_rr(x - w * 0.5 + 3, y - h * 0.5 + 6, w, h, 7); );
        pk_cardf(c, x, y, w, h, rot, fl, a);
      );
      i += 1;
    );
  );
);

function pk_board3() local(i, t, c, wx, wz, w, d, tf, fl, hl, a, kw, x, y, x0, y0, pul)
(
  i = 0; w = 0.42; d = 0.84; wz = 0.04;
  while (i < 5) (
    wx = (i - 2) * 0.47;
    i >= g_pk_nb && g_pk_hand > 0 ? (
      gfx_set(1, 1, 1, 0.05); pk_qpoly(wx, wz, w, d, 0.001, 0);
    );
    i += 1;
  );
  i = 0;
  while (i < g_pk_nb) (
    wx = (i - 2) * 0.47;
    c = pk_bd[i];
    t = g_pk_t - pk_bt[i];
    (i == 4 && g_pk_sq && t < 0) ? (
      pul = 0.5 + 0.5 * sin(g_t * 7);
      gfx_mode = 1; gfx_set(1, 0.3, 0.22, 0.2 + pul * 0.3); pk_qpoly(wx, wz, w + 0.08, d + 0.08, 0.003, 0); gfx_mode = 0;
      pk_qcard(-1, wx, wz, w, d, 0.015 + pul * 0.02, 0, 1, 1);
    ) : t >= 0 ? (
      tf = min(1, t / 0.2);
      p3(wx, 0, wz); x = g_3x; y = g_3y;
      (tf < 1 && !(i == 4 && g_pk_sq)) ? (
        tf = 1 - (1 - tf) * (1 - tf);
        pk_card(-1, g_pk_dkx + (x - g_pk_dkx) * tf, g_pk_dky + (y - g_pk_dky) * tf - sin(tf * $pi) * 18, 62, 76, (1 - tf) * 3, 1);
      ) : (
        fl = min(1, max(0, (t - 0.16) / (i == 4 && g_pk_runout ? 0.7 : 0.24)));
        kw = max(0.05, abs(2 * fl - 1));
        hl = pk_bhl[i] && g_pk_paid;
        hl ? ( gfx_mode = 1; gfx_set(1, 0.85, 0.3, 0.4 + 0.12 * sin(g_t * 6)); pk_qpoly(wx, wz, w + 0.07, d + 0.07, 0.003, 0); gfx_mode = 0; );
        gfx_set(0, 0, 0, 0.16); pk_qpoly(wx, wz + 0.012, w * kw * 0.96, d * 0.97, 0.002, 0.006);
        pk_qcard(fl >= 0.5 ? c : -1, wx, wz, w, d, 0.012 + (hl ? 0.03 : 0) + sin(fl * $pi) * 0.13, 0, kw, 1);
        (g_pk_paid && g_pk_wcat >= 0 && !hl) ? ( gfx_set(0, 0, 0, 0.2); pk_qpoly(wx, wz, w * 0.97, d * 0.97, 0.012, 0); );
      );
    );
    i += 1;
  );
);

function pk_shadow(x, y, r)
(
  gfx_set(0, 0, 0, 0.22); pk_ef(sx(x), sy(y), r * g_s, r * 0.5 * g_s);
  gfx_set(0, 0, 0, 0.24); pk_ef(sx(x), sy(y), r * 0.74 * g_s, r * 0.38 * g_s);
);

function pk_smoke() local(i)
(
  i = 0;
  gfx_mode = 1;
  loop(NPM,
    pm_a[i] -= g_dt * 0.02;
    (pm_a[i] <= 0) ? (
      pm_x[i] = 120 + rand(1) * 660; pm_y[i] = 110 + rand(1) * 330; pm_r[i] = 28 + rand(1) * 70; pm_a[i] = 0.04 + rand(1) * 0.05; pm_v[i] = 3 + rand(1) * 6; pm_s[i] = rand(1) * 6;
      (pk_ch[3] == 9 || pk_ch[2] == 9 || pk_ch[1] == 9 || pk_ch[4] == 9 || pk_ch[5] == 9) && i < 4 ? (
        pm_x[i] = pk_sxs[1] * (pk_ch[1] == 9) + pk_sxs[2] * (pk_ch[2] == 9) + pk_sxs[3] * (pk_ch[3] == 9) + pk_sxs[4] * (pk_ch[4] == 9) + pk_sxs[5] * (pk_ch[5] == 9) + 40;
        pm_y[i] = pk_sys[1] * (pk_ch[1] == 9) + pk_sys[2] * (pk_ch[2] == 9) + pk_sys[3] * (pk_ch[3] == 9) + pk_sys[4] * (pk_ch[4] == 9) + pk_sys[5] * (pk_ch[5] == 9) + 34;
        pm_r[i] = 6; pm_a[i] = 0.12; pm_v[i] = 16;
      );
    );
    pm_y[i] -= pm_v[i] * g_dt; pm_x[i] += sin(g_t * 0.4 + pm_s[i]) * 5 * g_dt; pm_r[i] += g_dt * 5;
    gfx_a = min(0.2, pm_a[i] * 2);
    gfx_blit(IMG_PKF, 1, 0, 0, 0, 96, 96, sx(pm_x[i] - pm_r[i]), sy(pm_y[i] - pm_r[i]), 2 * pm_r[i] * g_s, 2 * pm_r[i] * g_s);
    i += 1;
  );
  gfx_mode = 0; gfx_a = 1;
);

function pk_plate(s) local(x, y, w, h, c, act, a, tt, dead)
(
  c = pk_ch[s];
  (s == 0 || c >= 0) ? (
    w = 116; h = 38;
    x = pk_px[s] - w * 0.5; y = pk_py[s] - h * 0.5;
    act = g_pk_a == s && g_pk_s == 2;
    dead = pk_out[s];
    pk_std[s] += (pk_st[s] - pk_std[s]) * min(1, g_dt * 7);
    abs(pk_std[s] - pk_st[s]) < 1 ? pk_std[s] = pk_st[s];
    act ? (
      a = 0.5 + 0.5 * sin(g_t * 6);
      gfx_mode = 1; gfx_set(1, 0.8, 0.3, 0.14 + 0.18 * a); fill_rr(x - 5, y - 5, w + 10, h + 10, 12); gfx_mode = 0;
    );
    gfx_set(0, 0, 0, 0.4); fill_rr(x + 1, y + 3, w, h, 9);
    gfx_set(0.07, 0.07, 0.09, (pk_in[s] || g_pk_s >= 10 || g_pk_s == 0) ? 0.93 : 0.65); fill_rr(x, y, w, h, 9);
    act ? gfx_set(1, 0.82, 0.32, 1) : gfx_set(0.46, 0.4, 0.28, 0.9);
    outline_rr(x, y, w, h, 9);
    font(11, 'b');
    dead ? gfx_set(0.6, 0.5, 0.5, 1) : (pk_in[s] || g_pk_s >= 10) ? gfx_set(0.96, 0.96, 0.98, 1) : gfx_set(0.6, 0.6, 0.62, 1);
    txt_c(s == 0 ? "You" : pk_nm[c], x, y + 2, w, 18);
    dead ? (
      font(12, 'b'); gfx_set(1, 0.3, 0.25, 1); txt_c("BUSTED", x, y + 19, w, 18);
    ) : (
      font(12, 'b');
      gfx_set(1, 0.84, 0.36, 1);
      pk_ai[s] && pk_in[s] && pk_st[s] <= 0 && g_pk_s < 8 ? ( gfx_set(1, 0.42, 0.3, 1); txt_c("ALL IN", x, y + 19, w, 18); ) : txt_c(pk_fmt(pk_std[s], #pk_t1), x, y + 19, w, 18);
    );
    g_pk_btn == s && g_pk_s < 8 && g_pk_hand > 0 ? (
      gfx_set(0, 0, 0, 0.4); gfx_circle(sx(x + w + 2), sy(y + 4), 11 * g_s, 1, 1);
      gfx_set(0.97, 0.96, 0.92, 1); gfx_circle(sx(x + w + 1), sy(y + 2), 10.5 * g_s, 1, 1);
      gfx_set(0.1, 0.1, 0.12, 1); font(11, 'b'); txt_c("D", x + w - 9, y - 8, 20, 20);
    );
    tt = g_pk_t - pk_lblt[s];
    (tt < 4.2 && tt >= 0 && !(g_pk_runout && g_pk_s >= 3 && g_pk_s <= 5)) ? (
      a = min(1, (4.2 - tt) * 2.5);
      y -= min(8, tt * 40);
      pk_lbl[s] == 0 ? strcpy(#pk_t2, "FOLD") : pk_lbl[s] == 1 ? strcpy(#pk_t2, "CHECK") :
      pk_lbl[s] == 2 ? sprintf(#pk_t2, "CALL %s", pk_fmt(pk_hn[s], #pk_t1)) :
      pk_lbl[s] == 3 ? sprintf(#pk_t2, "RAISE %s", pk_fmt(pk_hn[s], #pk_t1)) :
      pk_lbl[s] == 5 ? sprintf(#pk_t2, "BET %s", pk_fmt(pk_hn[s], #pk_t1)) : strcpy(#pk_t2, "ALL IN!");
      font(12, 'b');
      pk_lbl[s] == 0 ? gfx_set(0.3, 0.3, 0.33, a) : pk_lbl[s] <= 2 ? gfx_set(0.1, 0.42, 0.26, a) : gfx_set(0.72, 0.16, 0.12, a);
      fill_rr(pk_px[s] - 56, y - 25, 112, 22, 6);
      gfx_set(1, 1, 1, a); txt_c(#pk_t2, pk_px[s] - 56, y - 25, 112, 22);
    );
  );
);

function pk_bubble(s) local(t, x, y, w, h, l1, n, a, i, k, tw, th, c, up)
(
  t = g_pk_t - pk_sayt[s];
  l1 = 5.6 + 0.14 * strlen(pk_sayl[s]);
  (t >= 0 && t < l1 && pk_ch[s] >= 0) ? (
    a = min(1, min(t * 7, (l1 - t) * 3));
    strcpy(#pk_b1, pk_sayl[s]);
    n = strlen(#pk_b1);
    strcpy(#pk_b2, "");
    n > 22 ? (
      k = floor(n / 2); i = 0;
      while (i < n * 0.5 && str_getchar(#pk_b1, k + i) != 32 && str_getchar(#pk_b1, k - i) != 32) ( i += 1; );
      k = str_getchar(#pk_b1, k + i) == 32 ? k + i : k - i;
      strcpy_substr(#pk_b2, #pk_b1, k + 1);
      str_setlen(#pk_b1, k);
    );
    font(11, 'b');
    gfx_measurestr(#pk_b1, w, h); gfx_measurestr(#pk_b2, tw, th);
    w = max(w, tw) / g_s + 22; h = (strlen(#pk_b2) ? 44 : 28);
    x = s <= 3 ? pk_sxs[s] + 46 : pk_sxs[s] - 46 - w;
    x = max(BRD_X + 4, min(BRD_X + BRD_W - w - 4, x));
    y = max(BRD_Y + 4, pk_sys[s] - 44 - h * 0.5);
    gfx_set(0, 0, 0, 0.3 * a); fill_rr(x + 2, y + 3, w, h, 11);
    gfx_set(0.99, 0.98, 0.94, a); fill_rr(x, y, w, h, 11);
    s <= 3 ? gfx_triangle(sx(x + 2), sy(y + h - 18), sx(x + 2), sy(y + h - 6), sx(x - 12), sy(y + h + 2)) :
    gfx_triangle(sx(x + w - 2), sy(y + h - 18), sx(x + w - 2), sy(y + h - 6), sx(x + w + 12), sy(y + h + 2));
    gfx_set(0.08, 0.08, 0.1, a);
    txt_c(#pk_b1, x, y + 4, w, 20);
    strlen(#pk_b2) ? txt_c(#pk_b2, x, y + 21, w, 20);
  );
);

function pk_scene(live) local(s, i, a, k, x, y, pot, t, n, d, z, v, b)
(
  gfx_mode = 0; gfx_a = 1;
  gfx_blit(IMG_PKR, 1, 0, 0, 0, ceil(BRD_W * g_pk_bsz), ceil(BRD_H * g_pk_bsz), sx(BRD_X), sy(BRD_Y), BRD_W * g_s, BRD_H * g_s);
  s = 3;
  pk_seat_bust(3); pk_seat_bust(2); pk_seat_bust(4); pk_seat_bust(1); pk_seat_bust(5);
  (g_pk_runout && g_pk_s >= 3 && g_pk_s <= 7) ? (
    a = min(1, (g_pk_t - g_pk_rot) * 2) * 0.32;
    gfx_set(0, 0, 0, a); gfx_rect(sx(BRD_X), sy(BRD_Y), BRD_W * g_s, BRD_H * g_s);
  );
  gfx_mode = 0; gfx_a = 1;
  live ? pk_smoke();
  (g_pk_hand > 0 && g_pk_s < 8) ? (
    gfx_set(0, 0, 0, 0.2); pk_qpoly(1.52, 0.42, 0.26, 0.36, 0.002, 0.012);
    pk_qcard(-1, 1.52, 0.42, 0.26, 0.36, 0.02, 0.02, 1, 1);
    pk_qcard(-1, 1.52, 0.42, 0.26, 0.36, 0.05, 0.02, 1, 1);
  );
  s = 1;
  loop(5, pk_cards3(s); s += 1; );
  pk_board3();
  s = 0;
  loop(6,
    (g_t > 0 && pk_betv[s] > 0) ? (
      x = pk_bx[s]; y = pk_by[s];
      pk_shadow(x, y + 1, 17);
      pk_stack(pk_betv[s], x, y, 1.25);
      font(11, 'b'); gfx_set(0.03, 0.03, 0.04, 0.82); fill_rr(x + 15, y - 12, 48, 17, 8);
      gfx_set(1, 0.95, 0.75, 1); txt_c(pk_fmt(pk_betv[s], #pk_t1), x + 15, y - 12, 48, 17);
    );
    s += 1;
  );
  s = 0;
  loop(6,
    pk_plate(s);
    s += 1;
  );
  pot = 0; s = 0; loop(6, pot += pk_tot[s] - pk_bet[s]; s += 1; );
  g_pk_paid ? pot = 0;
  (pot > 0 && g_pk_s >= 1 && g_pk_s < 8) ? (
    x = g_pk_ptx; y = g_pk_pty;
    pk_shadow(x - 60, y + 2, 26);
    pk_stack(pot, x - 60, y, 1.4);
    gfx_set(0.04, 0.04, 0.06, 1); fill_rr(x - 30, y - 22, 124, 26, 13);
    gfx_set(1, 0.84, 0.36, 0.7); outline_rr(x - 30, y - 22, 124, 26, 13);
    font(13, 'b'); gfx_set(1, 0.92, 0.6, 1); sprintf(#pk_t2, "Pot %s", pk_fmt(pot, #pk_t1)); txt_c(#pk_t2, x - 30, y - 22, 124, 26);
  );
  i = 0;
  loop(NPF,
    pf_on[i] ? (
      t = (g_pk_t - pf_t[i]) / pf_d[i];
      t >= 1 ? pf_on[i] = 0 : t >= 0 ? (
        k = t * t * (3 - 2 * t);
        pk_chip1(pf_k[i], pf_x0[i] + (pf_x1[i] - pf_x0[i]) * k, pf_y0[i] + (pf_y1[i] - pf_y0[i]) * k - sin(t * $pi) * 26, 1);
      );
    );
    i += 1;
  );
  pk_hero();
  live ? (
    g_pgrav = 300;
    particles();
    s = 1;
    loop(5, pk_bubble(s); s += 1; );
    s = 0;
    loop(6,
      (pk_rdt[s] > 0 && pk_in[s] && pk_ch[s] >= 0) ? (
        v = pk_vp[s];
        x = pk_sxs[s]; y = pk_sys[s] - 56;
        v > 0.72 ? strcpy(#pk_t2, "MONSTER") : v > 0.55 ? strcpy(#pk_t2, "STRONG") : v > 0.36 ? strcpy(#pk_t2, "SO-SO") : strcpy(#pk_t2, "WEAK");
        font(13, 'b');
        gfx_set(0.06, 0.1, 0.16, 0.95); fill_rr(x - 44, y - 14, 88, 26, 13);
        gfx_set(0.45, 0.85, 1, 1); outline_rr(x - 44, y - 14, 88, 26, 13);
        v > 0.55 ? gfx_set(1, 0.5, 0.35, 1) : v > 0.36 ? gfx_set(1, 0.9, 0.5, 1) : gfx_set(0.55, 1, 0.65, 1);
        txt_c(#pk_t2, x - 44, y - 14, 88, 26);
      );
      s += 1;
    );
    (g_pk_runout && g_pk_s >= 3 && g_pk_s <= 5) ? (
      s = 0;
      loop(6,
        (pk_in[s] && pk_flipt[s] > 0) ? (
          x = pk_px[s]; y = pk_py[s] - 33;
          s == 0 ? ( x = pk_px[0] + 118; y = pk_py[0]; );
          v = pk_tvp[s];
          gfx_set(0.03, 0.03, 0.05, 0.92); fill_rr(x - 46, y - 11, 92, 22, 5);
          v > 0.5 ? gfx_set(0.22, 0.85, 0.42, 1) : v > 0.2 ? gfx_set(0.95, 0.76, 0.2, 1) : gfx_set(0.92, 0.25, 0.2, 1);
          fill_rr(x - 44, y - 9, max(4, 88 * v), 18, 4);
          font(12, 'b'); gfx_set(1, 1, 1, 1); sprintf(#pk_t1, "%d%%", floor(v * 100 + 0.5)); txt_c(#pk_t1, x - 46, y - 11, 92, 22);
        );
        s += 1;
      );
    );
    t = g_pk_t - g_pk_alln;
    (t >= 0 && t < 1) ? (
      k = min(1, t * 7); a = min(1, (1 - t) * 3);
      gfx_mode = 1; gfx_set(1, 0.5, 0.1, 0.22 * (1 - t)); gfx_rect(sx(BRD_X), sy(BRD_Y), BRD_W * g_s, BRD_H * g_s); gfx_mode = 0;
      db_otext("ALL IN!", 250, 310, 400, 100, 70 + 34 * (1 - k), 1, 0.74, 0.18, a);
    );
    (g_pk_paid && g_pk_s >= 6 && g_pk_s <= 7 && g_pk_ww >= 0) ? (
      t = g_pk_t - g_pk_paidt;
      a = min(1, t * 5);
      (g_pk_ww == 0 ? strcpy(#pk_t3, "You win") : strcpy(#pk_t3, pk_nm[pk_ch[g_pk_ww]]));
      g_pk_ww != 0 ? strcat(#pk_t3, " wins");
      g_pk_wn > 1 ? ( strcpy(#pk_t3, "Pot is split"); );
      sprintf(#pk_t2, "%s %s", #pk_t3, pk_fmt(g_pk_wamt, #pk_t1));
      strlen(#pk_wname) ? ( strcat(#pk_t2, "  -  "); strcat(#pk_t2, #pk_wname); );
      font(14, 'b');
      gfx_measurestr(#pk_t2, d, z);
      d = d / g_s + 36;
      gfx_set(0.05, 0.04, 0.03, a >= 1 ? 1 : a); fill_rr(450 - d * 0.5, 448, d, 32, 16);
      g_pk_ww == 0 ? gfx_set(1, 0.84, 0.36, a) : gfx_set(0.6, 0.6, 0.62, a);
      outline_rr(450 - d * 0.5, 448, d, 32, 16);
      g_pk_ww == 0 ? gfx_set(1, 0.92, 0.6, a) : gfx_set(0.92, 0.92, 0.94, a);
      txt_c(#pk_t2, 450 - d * 0.5, 448, d, 32);
    );
    (g_pk_s >= 6 && g_pk_s <= 7 && pk_won[0] > 0 && g_pk_wcat >= 4) ? (
      t = g_pk_t - g_pk_paidt;
      t < 2.6 ? (
        a = min(1, min(t * 5, (2.6 - t) * 2));
        k = min(1, t * 6);
        strcpy(#pk_t1, g_pk_wcat == 8 ? (floor((pk_scr[0] - 8 * 371293) / 28561) == 12 ? "ROYAL FLUSH!" : "STRAIGHT FLUSH!") : g_pk_wcat == 7 ? "FOUR OF A KIND!" : g_pk_wcat == 6 ? "FULL HOUSE!" : g_pk_wcat == 5 ? "FLUSH!" : "STRAIGHT!");
        db_otext(#pk_t1, 150, 240, 600, 90, 58 + 40 * (1 - k), 1, 0.84, 0.22, a);
      );
    );
    t = g_pk_t - g_pk_blt;
    (t >= 0 && t < 2.4 && g_pk_blt > 0) ? (
      a = min(1, min(t * 5, (2.4 - t) * 3));
      sprintf(#pk_t2, "Blinds up: %s / %s", pk_fmt(g_pk_sb, #pk_t1), pk_fmt(g_pk_bb, #pk_t3));
      db_otext(#pk_t2, 200, 318, 500, 46, 30, 1, 0.5, 0.35, a);
    );
    s = 1;
    loop(5,
      (pk_ch[s] >= 0 && pk_out[s]) ? (
        t = g_pk_t - pk_kot[s];
        t < 1.4 ? (
          a = min(1, min(t * 6, (1.4 - t) * 3));
          k = min(1, t * 8);
          db_otext("K.O.", pk_sxs[s] - 90, pk_sys[s] - 40, 180, 80, 44 + 40 * (1 - k), 1, 0.3, 0.2, a);
        );
      );
      s += 1;
    );
  );
);

function pk_btn(s, x, y, w, h, r, g, b, on) local(hov, k)
(
  hov = on && hit(x, y, w, h);
  k = !on ? 0.34 : hov ? 1.18 : 0.92;
  gfx_set(0, 0, 0, 0.45); fill_rr(x + 1, y + 3, w, h, 8);
  gfx_set(r * 0.42 * k, g * 0.42 * k, b * 0.42 * k, 1); fill_rr(x, y, w, h, 8);
  gfx_set(r * 0.78 * k, g * 0.78 * k, b * 0.78 * k, 1); fill_rr(x + 1, y + 1, w - 2, h - 5, 7);
  gfx_set(1, 1, 1, 0.14 * k); fill_rr(x + 3, y + 2, w - 6, (h - 6) * 0.42, 5);
  font(13, 'b');
  gfx_set(1, 1, 1, on ? 1 : 0.5);
  txt_c(s, x, y - 1, w, h);
  hov && g_click ? ( g_click = 0; 1; ) : 0;
);

function pk_coach() local(i, tc, pot, po, n, v)
(
  (g_pk_s >= 1 && g_pk_s <= 7 && pk_in[0] && !sv2[51] && g_pk_hand > 0 && g_pk_t > pk_cdt[1] + 0.5) ? (
    n = g_pk_nb * 10 + g_pk_nin;
    pk_count();
    n = g_pk_nb * 10 + g_pk_nin;
    n !== g_pk_cstamp ? (
      g_pk_cstamp = n;
      g_pk_ceq = pk_equity(0, 700, 0);
      g_pk_nb >= 3 ? (
        pk_h7[0] = pk_c1[0]; pk_h7[1] = pk_c2[0];
        i = 0; loop(g_pk_nb, pk_h7[2 + i] = pk_bd[i]; i += 1; );
        pk_name(pk_eval(2 + g_pk_nb), #pk_cn);
      ) : (
        (pk_c1[0] % 13) == (pk_c2[0] % 13) ? (
          sprintf(#pk_cn, "Pocket %s", pk_rp2(pk_c1[0] % 13));
        ) : (
          strcpy(#pk_t1, pk_rs(max(pk_c1[0] % 13, pk_c2[0] % 13)));
          str_setchar(#pk_t1, 0, str_getchar(#pk_t1, 0) - 32);
          sprintf(#pk_cn, "%s-%s %s", #pk_t1, pk_rs(min(pk_c1[0] % 13, pk_c2[0] % 13)), floor(pk_c1[0] / 13) == floor(pk_c2[0] / 13) ? "suited" : "offsuit");
        );
      );
    );
    gfx_set(0.05, 0.05, 0.07, 1); fill_rr(92, 490, 240, 86, 9);
    gfx_set(0.46, 0.4, 0.28, 0.7); outline_rr(92, 490, 240, 86, 9);
    font(13, 'b'); gfx_set(1, 0.92, 0.6, 1); txt_c(#pk_cn, 92, 494, 240, 22);
    font(11, 0); gfx_set(0.8, 0.82, 0.86, 1);
    v = g_pk_ceq;
    sprintf(#pk_t1, "Win chance vs %d: %d%%", g_pk_nin - 1, floor(v * 100 + 0.5));
    txt_c(#pk_t1, 92, 514, 240, 18);
    gfx_set(0.16, 0.16, 0.2, 1); fill_rr(112, 533, 200, 8, 4);
    v > 0.5 ? gfx_set(0.3, 0.9, 0.5, 1) : v > 0.25 ? gfx_set(0.95, 0.78, 0.25, 1) : gfx_set(0.95, 0.35, 0.28, 1);
    fill_rr(112, 533, max(8, 200 * v), 8, 4);
    (g_pk_s == 2 && g_pk_a == 0) ? (
      tc = g_pk_cur - pk_bet[0]; pot = pk_potall();
      po = tc > 0 ? tc / (pot + tc) : 0;
      tc > 0 ? (
        sprintf(#pk_t1, "Calling needs %d%%: %s", floor(po * 100 + 0.5), v > po + 0.1 ? "good price" : v > po ? "close" : "too pricey");
      ) : strcpy(#pk_t1, v > 0.6 ? "You look ahead: bet for value" : v > 1 / g_pk_nin ? "Decent: small bet or check" : "Check is free");
      font(11, 'b'); gfx_set(0.9, 0.92, 0.96, 1); txt_c(#pk_t1, 92, 546, 240, 22);
    );
  );
);

function pk_controls() local(tc, minto, maxto, can, pot, x0, x1, w, r, t, hv, ybar, a, s, snap)
(
  ybar = 592;
  gfx_set(0.03, 0.03, 0.04, 0.82); gfx_rect(sx(BRD_X), sy(ybar), BRD_W * g_s, 58 * g_s);
  gfx_set(0.3, 0.26, 0.18, 0.8); gfx_rect(sx(BRD_X), sy(ybar), BRD_W * g_s, g_s);
  (g_pk_s == 2 && g_pk_a == 0) ? (
    tc = g_pk_cur - pk_bet[0];
    pot = pk_potall();
    minto = min(g_pk_cur + g_pk_minr, pk_bet[0] + pk_st[0]);
    maxto = pk_bet[0] + pk_st[0];
    can = pk_canr[0] && maxto > g_pk_cur && g_pk_nac > 1;
    (g_pk_raise < minto || g_pk_raise > maxto) ? g_pk_raise = minto;
    pk_btn("FOLD", 30, ybar + 8, 100, 42, 0.78, 0.2, 0.17, tc > 0) ? pk_act(0, 0, 0);
    tc <= 0 ? strcpy(#pk_t2, "CHECK") : tc >= pk_st[0] ? sprintf(#pk_t2, "ALL IN %s", pk_fmt(pk_st[0], #pk_t1)) : sprintf(#pk_t2, "CALL %s", pk_fmt(tc, #pk_t1));
    g_pk_a == 0 && pk_btn(#pk_t2, 140, ybar + 8, 150, 42, 0.2, 0.68, 0.36, 1) ? pk_act(0, 1, 0);
    (g_pk_s == 2 && g_pk_a == 0 && can) ? (
      g_pk_raise >= maxto ? strcpy(#pk_t2, "ALL IN!") : sprintf(#pk_t2, "%s %s", g_pk_cur > 0 ? "RAISE TO" : "BET", pk_fmt(g_pk_raise, #pk_t1));
      pk_btn(#pk_t2, 300, ybar + 8, 170, 42, 0.92, 0.62, 0.14, 1) ? pk_act(0, 2, g_pk_raise);
      x0 = 492; x1 = 742; w = x1 - x0;
      gfx_set(0.13, 0.13, 0.16, 1); fill_rr(x0, ybar + 13, w, 8, 4);
      r = (g_pk_raise - minto) / max(1, maxto - minto);
      gfx_set(0.92, 0.62, 0.14, 1); fill_rr(x0, ybar + 13, max(8, w * r), 8, 4);
      (g_click && hit(x0 - 8, ybar + 4, w + 16, 26)) ? ( g_click = 0; g_pk_drag = 1; );
      !g_mdown ? g_pk_drag = 0;
      g_pk_drag ? (
        r = max(0, min(1, (g_mx - x0) / w));
        g_pk_raise = minto + r * (maxto - minto);
      );
      mouse_wheel != 0 ? ( g_pk_raise += (mouse_wheel > 0 ? 1 : -1) * g_pk_bb; mouse_wheel = 0; );
      snap = g_pk_sb;
      g_pk_raise < maxto ? g_pk_raise = floor(g_pk_raise / snap + 0.5) * snap;
      g_pk_raise = max(minto, min(maxto, g_pk_raise));
      r = (g_pk_raise - minto) / max(1, maxto - minto);
      pk_chip1(3, x0 + w * r, ybar + 16, 1.15);
      font(11, 'b');
      pk_btn("Min", x0, ybar + 30, 54, 22, 0.42, 0.42, 0.5, 1) ? g_pk_raise = minto;
      pk_btn("1/2 pot", x0 + 60, ybar + 30, 62, 22, 0.42, 0.42, 0.5, 1) ? g_pk_raise = g_pk_cur + tc * 0 + floor((pot + tc) * 0.5);
      pk_btn("Pot", x0 + 128, ybar + 30, 54, 22, 0.42, 0.42, 0.5, 1) ? g_pk_raise = g_pk_cur + pot + tc;
      pk_btn("All in", x0 + 188, ybar + 30, 62, 22, 0.75, 0.22, 0.18, 1) ? g_pk_raise = maxto;
    );
  ) : (
    font(13, 'b');
    gfx_set(0.82, 0.84, 0.88, 1);
    g_pk_s == 2 && g_pk_a > 0 ? sprintf(#pk_t2, "%s is thinking...", pk_nm[pk_ch[g_pk_a]]) :
    g_pk_s == 7 ? strcpy(#pk_t2, "Click anywhere for the next hand") :
    (g_pk_s == 1 ? strcpy(#pk_t2, "Dealing...") : strcpy(#pk_t2, ""));
    txt_c(#pk_t2, 30, ybar, 470, 58);
    (!pk_in[0] && g_pk_hand > 0 && g_pk_s >= 1 && g_pk_s <= 6) ? (
      pk_btn(g_pk_skip ? "Skipping..." : "Skip this hand >>", 510, ybar + 12, 180, 34, 0.25, 0.5, 0.75, 1) ? g_pk_skip = 1;
    );
  );
  a = g_pk_rdm;
  sprintf(#pk_t2, "READ  x%d", g_pk_reads);
  pk_btn(a ? "Pick a face..." : #pk_t2, 756, ybar + 8, 116, 42, 0.2, 0.62, 0.86, g_pk_reads > 0 && pk_in[0] && g_pk_s >= 2 && g_pk_s <= 4) ? g_pk_rdm = !g_pk_rdm;
);

function pk_faces_click() local(s, h)
(
  h = -1; s = 1;
  loop(5,
    (pk_ch[s] >= 0 && (g_mx - pk_sxs[s]) ^ 2 + (g_my - pk_sys[s]) ^ 2 < 46 * 46) ? h = s;
    s += 1;
  );
  (h > 0 && g_click && g_pk_s != 10) ? (
    g_click = 0;
    (g_pk_rdm && pk_in[h]) ? (
      g_pk_rdm = 0; g_pk_reads -= 1;
      pk_vp[h] = pk_equity(h, 500, 0);
      pk_rdt[h] = g_pk_t;
      db_snd(13, 1320, 0.2, 0, 0); db_snd(13, 1760, 0.15, 0.08, 0);
    ) : !g_pk_rdm ? g_pk_dos = pk_ch[h] + 1;
  );
);

function pk_dossier() local(c, x, y, w, h, known, tx)
(
  c = g_pk_dos - 1;
  x = 210; y = 190; w = 480; h = 240;
  gfx_set(0, 0, 0, 0.55); gfx_rect(sx(BRD_X), sy(BRD_Y), BRD_W * g_s, BRD_H * g_s);
  gfx_set(0.09, 0.09, 0.11, 1); fill_rr(x, y, w, h, 12);
  gfx_set(0.9, 0.72, 0.3, 0.9); outline_rr(x, y, w, h, 12);
  pk_gal_step();
  pk_gal_blit(c, x + 14, y + 26, 150, 176, 1);
  font(20, 'b'); gfx_set(1, 0.9, 0.6, 1); txt_l(pk_nm[c], x + 176, y + 20);
  font(12, 0); gfx_set(0.85, 0.86, 0.9, 1);
  pk_wrap(pk_sty[c], x + 176, y + 56, 286);
  known = (sv2[50] >> c) & 1;
  font(12, 'b'); gfx_set(0.45, 0.85, 1, 1); txt_l("TELL", x + 176, y + 118);
  font(12, 0); gfx_set(0.85, 0.86, 0.9, 1);
  pk_wrap(known ? pk_tl[c] : "Unknown. Knock them out yourself to learn it, or just watch closely.", x + 176, y + 140, 286);
  button("Close", x + w - 110, y + h - 48, 96, 36, 0.9, 0.72, 0.3) ? g_pk_dos = 0;
  g_click ? ( g_click = 0; g_pk_dos = 0; );
);

function pk_charts() local(i, y, x, c, got, k, n, cols)
(
  gfx_set(0, 0, 0, 0.72); gfx_rect(sx(BRD_X), sy(BRD_Y), BRD_W * g_s, BRD_H * g_s);
  gfx_set(0.09, 0.09, 0.11, 1); fill_rr(110, 76, 680, 564, 12);
  gfx_set(0.9, 0.72, 0.3, 0.9); outline_rr(110, 76, 680, 564, 12);
  db_otext("Hand ranks and your collection", 110, 82, 680, 40, 24, 1, 0.84, 0.36, 1);
  i = 0;
  while (i < 10) (
    k = 9 - i;
    y = 130 + i * 49;
    got = k < 2 ? 1 : (sv2[49] >> k) & 1;
    x = 130;
    n = 0;
    loop(5,
      c = k == 9 ? 8 + n + 39 : k == 8 ? 5 + n + 39 - 0 : k == 7 ? (n < 4 ? 7 + n * 13 : 25) : k == 6 ? (n < 3 ? 10 + n * 13 : 4 + (n - 3) * 13 + 13) :
          k == 5 ? (n == 0 ? 25 : n == 1 ? 22 : n == 2 ? 19 : n == 3 ? 16 : 14) : k == 4 ? (5 + n + (n & 1) * 13 + (n == 4 ? 26 : 0)) : k == 3 ? (n < 3 ? 9 + n * 13 : n == 3 ? 3 + 26 : 12) :
          k == 2 ? (n < 2 ? 11 + n * 13 : n < 4 ? 4 + (n - 1) * 13 : 8 + 39) : k == 1 ? (n < 2 ? 12 + n * 13 : n == 2 ? 5 + 13 : n == 3 ? 2 : 8 + 26) : (n == 0 ? 12 : n == 1 ? 9 + 13 : n == 2 ? 6 + 26 : n == 3 ? 3 + 39 : 1);
      pk_card(c, x + n * 33 + 16, y + 21, 30, 42, 0, got ? 1 : 0.42);
      n += 1;
    );
    font(13, 'b');
    got ? gfx_set(1, 0.92, 0.65, 1) : gfx_set(0.6, 0.6, 0.64, 1);
    txt_l(k == 9 ? "Royal flush" : k == 8 ? "Straight flush" : k == 7 ? "Four of a kind" : k == 6 ? "Full house" : k == 5 ? "Flush" : k == 4 ? "Straight" : k == 3 ? "Three of a kind" : k == 2 ? "Two pair" : k == 1 ? "One pair" : "High card", 310, y + 1);
    font(11, 0); gfx_set(0.68, 0.7, 0.74, 1);
    txt_l(k == 9 ? "A K Q J 10, all one suit. Once in a lifetime." : k == 8 ? "Five in a row, all one suit." : k == 7 ? "Four cards of the same rank." : k == 6 ? "Three of one rank and two of another." : k == 5 ? "Any five of one suit." : k == 4 ? "Five in a row, any suits. Aces high or low." : k == 3 ? "Three cards of the same rank." : k == 2 ? "Two different pairs." : k == 1 ? "Two cards of the same rank." : "Nothing made. Highest card plays.", 310, y + 21);
    k >= 2 ? (
      got ? ( gfx_set(1, 0.8, 0.25, 1); star_shape(sx(760), sy(y + 20), 13 * g_s, 0); ) : ( gfx_set(0.26, 0.26, 0.3, 1); star_shape(sx(760), sy(y + 20), 13 * g_s, 0); );
    );
    i += 1;
  );
  font(11, 0); gfx_set(0.68, 0.7, 0.74, 1); txt_c("Reach the river holding one of these to collect it. Click to close.", 110, 616, 680, 20);
  g_click ? ( g_click = 0; g_pk_chart = 0; );
);

function pk_gallery_screen() local(i, x, y, c, k, n, known, beat)
(
  gfx_set(0, 0, 0, 0.72); gfx_rect(sx(BRD_X), sy(BRD_Y), BRD_W * g_s, BRD_H * g_s);
  gfx_set(0.09, 0.09, 0.11, 1); fill_rr(60, 76, 780, 564, 12);
  gfx_set(0.9, 0.72, 0.3, 0.9); outline_rr(60, 76, 780, 564, 12);
  pk_gal_step();
  n = 0; i = 0; loop(12, n += (sv2[50] >> i) & 1; i += 1; );
  sprintf(#pk_t2, "Rogues' gallery  -  %d of 12 tells learned", n);
  db_otext(#pk_t2, 60, 82, 780, 40, 24, 1, 0.84, 0.36, 1);
  i = 0;
  loop(12,
    x = 72 + (i % 6) * 127; y = 128 + floor(i / 6) * 248;
    known = (sv2[50] >> i) & 1;
    gfx_set(0.13, 0.13, 0.16, 1); fill_rr(x, y, 120, 240, 8);
    known ? gfx_set(0.9, 0.72, 0.3, 0.8) : gfx_set(0.3, 0.3, 0.34, 1);
    outline_rr(x, y, 120, 240, 8);
    pk_gal_blit(i, x + 8, y + 6, 104, 122, 1);
    font(11, 'b'); gfx_set(1, 0.92, 0.65, 1); txt_c(pk_nm[i], x, y + 128, 120, 20);
    font(10, 0); known ? gfx_set(0.55, 0.88, 1, 1) : gfx_set(0.55, 0.55, 0.6, 1);
    pk_wrap(known ? pk_tl[i] : "Tell unknown.", x + 7, y + 150, 106);
    i += 1;
  );
  font(11, 0); gfx_set(0.68, 0.7, 0.74, 1); txt_c("Click to close.", 60, 616, 780, 20);
  g_click ? ( g_click = 0; g_pk_rog = 0; );
);

function pk_intro() local(n, i, t, a, y, c, x, w)
(
  t = g_pk_t - g_pk_intro;
  a = min(1, t * 3);
  gfx_set(0.04, 0.03, 0.03, 0.88 * a); fill_rr(150, 270, 600, 310, 14);
  gfx_set(0.9, 0.72, 0.3, 0.9 * a); outline_rr(150, 270, 600, 310, 14);
  sprintf(#pk_t2, "Table %d: %s", g_pk_lv, pk_vname(g_pk_ven));
  db_otext(#pk_t2, 150, 276, 600, 46, 28, 1, 0.84, 0.36, a);
  font(12, 0); gfx_set(0.78, 0.8, 0.85, a);
  g_pk_lv <= 3 ? sprintf(#pk_t2, "You get %s chips, they get 1,500. Blinds rise every %d hands. Last one standing wins.", pk_fmt(pk_st[0], #pk_t1), g_pk_hupn) :
  sprintf(#pk_t2, "Everyone starts with 1,500 chips. Blinds rise every %d hands. Last one standing wins.", g_pk_hupn);
  txt_c(#pk_t2, 150, 318, 600, 22);
  y = 344; i = 1;
  loop(5,
    c = pk_ch[i];
    c >= 0 ? (
      font(13, 'b'); gfx_set(1, 0.92, 0.65, a); txt_l(pk_nm[c], 176, y);
      font(11, 0); gfx_set(0.76, 0.78, 0.82, a); txt_l(pk_sty[c], 310, y + 2);
      y += 25;
    );
    i += 1;
  );
  font(12, 0); gfx_set(0.8, 0.82, 0.88, a);
  sprintf(#pk_t2, "Rank: %s", pk_title(g_pk_lv)); txt_l(#pk_t2, 176, 480);
  sprintf(#pk_t2, "Career winnings: %s", pk_fmt(sv2[53], #pk_t1)); txt_l(#pk_t2, 176, 500);
  sprintf(#pk_t2, "Tables won: %d    Knockouts: %d", sv2[45], sv2[52]); txt_l(#pk_t2, 176, 520);
  sprintf(#pk_t2, "Biggest pot: %s", pk_fmt(sv2[46], #pk_t1)); txt_l(#pk_t2, 176, 540);
  pk_btn("DEAL ME IN", 530, 490, 196, 62, 0.92, 0.62, 0.14, t > 0.3) ? ( pk_begin(); );
);

function pk_end() local(i, r, a)
(
  r = 0;
  g_pk_s == 8 ? (
    (g_pk_t - g_pk_endt < 4) ? (
      rand(1) < 0.35 ? (
        i = 0; a = rand(1);
        hue(a);
        loop(18, spawn(180 + rand(1) * 540, 120 + rand(1) * 220, (rand(1) - 0.5) * 320, (rand(1) - 0.6) * 320, g_hr, g_hg, g_hb, 0.7 + rand(1)); );
      );
    );
    sprintf(#g_l1, "Prize %s for table %d, with %d knockouts", pk_fmt(g_pk_prize, #pk_t1), g_pk_lv, g_pk_kos);
    sprintf(#g_l2, "Rank: %s     Career winnings: %s", pk_title(g_pk_lv + 1), pk_fmt(sv2[53], #pk_t3));
    i = win_card(g_pk_lv == 10 ? "You beat Mr Grim!" : "You cleaned them out!", g_pk_endt + 0.5, 1, 0.84, 0.36);
    i == 1 ? pk_table(g_pk_lv + 1) : i == 2 ? g_screen = 0;
  ) : (
    sprintf(#g_l1, "Knocked out in place %d of %d", g_pk_place, g_pk_nop + 1);
    sprintf(#g_l2, "Hands played: %d     Knockouts this table: %d", g_pk_hand, g_pk_kos);
    g_wcl = 3;
    i = win_card("Busted!", g_pk_endt + 0.6, 1, 0.5, 0.42);
    g_wcl = 0;
    i == 1 ? pk_table(g_pk_lv) : i == 2 ? g_screen = 0;
  );
);

function pk_bake_screen() local(p, a)
(
  gfx_set(0.04, 0.035, 0.04, 1); gfx_rect(sx(BRD_X), sy(BRD_Y), BRD_W * g_s, BRD_H * g_s);
  p = g_pk_bk == 0 ? 0 : g_pk_bk == 1 ? 0.03 + 0.25 * g_pk_br / max(1, g_pk_bh) : g_pk_bk == 2 ? 0.28 + 0.03 * g_pk_bse : g_pk_bk == 3 ? 0.45 : 0.45 + 0.11 * (g_pk_bse - 1) + 0.11 * max(0, g_pk_br) / max(1, g_pk_bph);
  g_pk_bpv = max(g_pk_bpv, min(1, p));
  db_otext(pk_vname(g_pk_ven), 150, 260, 600, 56, 34, 1, 0.84, 0.36, 1);
  font(13, 0); gfx_set(0.78, 0.8, 0.85, 1);
  txt_c(g_pk_bk <= 3 ? "Setting the table..." : "The players are sitting down...", 150, 318, 600, 24);
  gfx_set(0.14, 0.13, 0.14, 1); fill_rr(280, 352, 340, 12, 6);
  gfx_set(1, 0.78, 0.3, 1); fill_rr(280, 352, max(12, 340 * g_pk_bpv), 12, 6);
);

function draw_poker() local(bw, bh, dst, s0, ox0, oy0, z, t, zm, sh, sx0, sy0, i, over, hbn)
(
  g_pk_lv < 1 ? pk_table(max(1, sv2[44]));
  pk_assets();
  !g_pk_ready ? (
    pk_bake_step();
    pk_bake_screen();
    button("< Games", 18, 14, 96, 36, 0.95, 0.78, 0.4) ? g_screen = 0;
  ) : (
  g_pk_bpv = 0;
  g_pk_fast = sv2[54];
  over = g_pk_dos || g_pk_chart || g_pk_rog;
  !over ? g_pk_t += g_dt;
  !over ? pk_tick();
  g_pk_paid && !g_pk_paidk ? ( g_pk_paidk = 1; g_pk_paidt = g_pk_t; ) : !g_pk_paid ? g_pk_paidk = 0;
  (g_pk_fanfare > 0 && g_pk_t - g_pk_fanfare < 0.1) ? (
    g_pk_fanfare = 0;
    i = 0; loop(5, db_snd(13, 523.25 * 2 ^ (i * 4 / 12), 0.28, i * 0.09, (i - 2) * 0.3); i += 1; );
    loop(90, spawn(450 + (rand(1) - 0.5) * 300, 280 + rand(1) * 120, (rand(1) - 0.5) * 520, -rand(1) * 400, 1, 0.76 + rand(1) * 0.2, 0.2, 0.7 + rand(1)); );
  );
  g_pk_sq ? (
    g_pk_t >= g_pk_hbt ? (
      g_pk_hbt = g_pk_t + 0.62;
      db_snd(7, 52, 0.45, 0, 0); db_snd(7, 46, 0.34, 0.16, 0);
    );
  );
  zm = 1;
  (g_pk_runout && g_pk_s >= 3 && g_pk_s <= 5) ? zm = g_pk_sq ? 1.06 : 1.03;
  g_pk_z += (zm - g_pk_z) * min(1, g_dt * 2.4);
  t = g_pk_t - g_pk_shake;
  sh = (t >= 0 && t < 0.42) ? 12 * (0.42 - t) : 0;
  bw = ceil(BRD_W * g_s); bh = ceil(BRD_H * g_s);
  s0 = g_s; ox0 = g_ox; oy0 = g_oy; dst = gfx_dest;
  gfx_setimgdim(IMG_PKS, bw, bh);
  gfx_dest = IMG_PKS;
  z = g_pk_z;
  g_s = s0 * z;
  g_ox = -BRD_X * g_s + (450 - BRD_X) * s0 * (1 - z) + (rand(1) - 0.5) * sh * s0;
  g_oy = -BRD_Y * g_s + (385 - BRD_Y) * s0 * (1 - z) + (rand(1) - 0.5) * sh * s0;
  gfx_set(0, 0, 0, 1); gfx_rect(0, 0, bw, bh);
  pk_scene(1);
  g_s = s0; g_ox = ox0; g_oy = oy0;
  gfx_dest = dst;
  gfx_mode = 0; gfx_a = 1;
  gfx_blit(IMG_PKS, 1, 0, 0, 0, bw, bh, floor(sx(BRD_X)), floor(sy(BRD_Y)), bw, bh);
  gfx_set(0.2, 0.21, 0.24, 1); outline_rr(BRD_X, BRD_Y, BRD_W, BRD_H, 8);

  button("< Games", 18, 14, 96, 36, 0.95, 0.78, 0.4) ? g_screen = 0;
  g_t - g_pk_rst > 3 ? g_pk_rst = -1000;
  g_pk_rst > 0 ? (
    button("Sure?", 122, 14, 100, 36, 1, 0.4, 0.35) ? ( sv2[44] = 1; sv2[45] = 0; sv2[46] = 0; sv2[47] = 0; sv2[49] = 0; sv2[50] = 0; sv2[52] = 0; sv2[53] = 0; pk_table(1); g_pk_rst = -1000; );
  ) : (
    button("Start over", 122, 14, 100, 36, 1, 0.4, 0.35) ? g_pk_rst = g_t;
  );
  button("Hands", 230, 14, 70, 36, 0.95, 0.78, 0.4) ? ( g_pk_chart = !g_pk_chart; );
  button("Rogues", 308, 14, 76, 36, 0.95, 0.78, 0.4) ? ( g_pk_rog = !g_pk_rog; );
  font(15, 'b');
  gfx_set(0.95, 0.96, 0.98, 1);
  sprintf(#pk_t2, "Flop House  -  %s", pk_vname(g_pk_ven));
  txt_c(#pk_t2, 390, 9, 300, 22);
  font(12, 0); gfx_set(0.68, 0.7, 0.75, 1);
  sprintf(#pk_t2, "Table %d    Hand %d", g_pk_lv, g_pk_hand);
  txt_c(#pk_t2, 390, 31, 300, 20);
  font(13, 'b');
  sprintf(#pk_t2, "Blinds %s / %s", pk_fmt(g_pk_sb, #pk_t1), pk_fmt(g_pk_bb, #pk_t3));
  pill(#pk_t2, 700, 10, 182, 24, 1, 0.84, 0.36, 1);
  font(11, 0); gfx_set(0.68, 0.7, 0.75, 1);
  g_pk_hand > 0 ? ( sprintf(#pk_t2, "Up in %d hand%s", g_pk_hup, g_pk_hup == 1 ? "" : "s"); txt_c(#pk_t2, 700, 35, 182, 20); );

  i = g_click;
  over ? g_click = 0;
  (g_pk_s >= 8 && g_pk_s != 10) ? 0 : pk_coach();
  (g_pk_s != 10 && g_pk_s < 8) ? pk_controls();
  (g_pk_s == 7 && g_click && hit(BRD_X, BRD_Y, BRD_W, BRD_H)) ? ( g_click = 0; g_pk_w = g_pk_t; );
  (!over && g_pk_s < 8) ? pk_faces_click();
  g_pk_s == 10 ? pk_intro();
  (g_pk_s == 8 || g_pk_s == 9) ? pk_end();

  t = g_pk_t - g_pk_tt;
  (t >= 0 && t < 3.8 && g_pk_tt > 0) ? (
    i = min(1, min(t * 5, (3.8 - t) * 3));
    font(13, 'b');
    gfx_set(0.04, 0.08, 0.13, 0.95 * i); fill_rr(180, 74, 540, 32, 16);
    gfx_set(0.45, 0.85, 1, i); outline_rr(180, 74, 540, 32, 16);
    txt_c(#pk_tt, 180, 74, 540, 32);
  );
  t = g_pk_t - g_pk_newt;
  (g_pk_newt > 0 && t >= 0 && t < 3.8) ? (
    i = min(1, min(t * 5, (3.8 - t) * 3));
    font(13, 'b');
    gfx_set(0.13, 0.09, 0.03, 0.95 * i); fill_rr(180, 110, 540, 32, 16);
    gfx_set(1, 0.84, 0.36, i); outline_rr(180, 110, 540, 32, 16);
    g_pk_newhand == 9 ? strcpy(#pk_t2, "Collected: Royal flush!") : g_pk_newhand == 8 ? strcpy(#pk_t2, "Collected: Straight flush!") : g_pk_newhand == 7 ? strcpy(#pk_t2, "Collected: Four of a kind!") : g_pk_newhand == 6 ? strcpy(#pk_t2, "Collected: Full house!") : g_pk_newhand == 5 ? strcpy(#pk_t2, "Collected: Flush!") : g_pk_newhand == 4 ? strcpy(#pk_t2, "Collected: Straight!") : g_pk_newhand == 3 ? strcpy(#pk_t2, "Collected: Three of a kind!") : strcpy(#pk_t2, "Collected: Two pair!");
    txt_c(#pk_t2, 180, 110, 540, 32);
  );

  font(12, 0); gfx_set(0.62, 0.64, 0.68, 1);
  g_pk_rdm ? txt_c("Click an opponent's face to see how strong their hand really is.", 18, HINT_Y, 600, 22) :
  txt_c("Click a face to see that player's file. Watch for tells. Mouse wheel changes your raise.", 18, HINT_Y, 610, 22);
  button(sv2[51] ? "Coach OFF" : "Coach ON", 640, HINT_Y - 4, 84, 28, 0.6, 1, 0.75) ? sv2[51] = !sv2[51];
  button(sv2[54] ? "Fast" : "Normal", 730, HINT_Y - 4, 60, 28, 0.6, 1, 0.75) ? sv2[54] = !sv2[54];
  button(snd_lbl(), 796, HINT_Y - 4, 86, 28, 0.6, 1, 0.75) ? sv2[13] = snd_next();
  over ? g_click = i;
  g_pk_dos ? pk_dossier();
  g_pk_chart ? pk_charts();
  g_pk_rog ? pk_gallery_screen();
  );
  mouse_wheel = 0;
);

function pv_poker(x, y, w, h) local(i, a, r, mw, mh, dst)
(
  g_pk_lv < 1 ? pk_table(max(1, sv2[44]));
  !g_pk_tb ? pk_tables();
  g_pk_as !== g_s ? ( pk_atlas(); g_pk_as = g_s; g_pk_gi = 0; );
  g_pk_layn !== g_pk_nst ? ( g_pk_layn = g_pk_nst; pk_layout(); g_pk_ready = 0; g_pk_bk = 0; );
  g_pk_ready ? (
    pv_begin(x, y, w, h, 1);
    pk_scene(0);
    pv_end();
  ) : g_pk_bk == 0 ? (
    mw = ceil(w * 2 * g_s); mh = ceil(mw * 584 / 864);
    g_pk_mini !== g_pk_ven + 1 + g_s * 1000 ? (
      dst = gfx_dest;
      g_pk_mini = g_pk_ven + 1 + g_s * 1000;
      pk_textures(g_pk_ven);
      rt_cam(mw, mh);
      rt_ds = 0;
      gfx_setimgdim(IMG_PKM, 0, 0); gfx_setimgdim(IMG_PKM, mw, mh);
      gfx_dest = IMG_PKM; gfx_mode = 0; gfx_a = 1;
      r = 0; loop(mh, rt_row(r, mw); r += 1; );
      rt_cam(864, 584);
      gfx_dest = dst;
    );
    a = min(mw, mh * w / h);
    gfx_mode = 0; gfx_a = 1;
    gfx_blit(IMG_PKM, 1, 0, (mw - a) * 0.5, 0, a, mh, sx(x), sy(y), w * g_s, h * g_s);
    i = 0;
    loop(5,
      pk_card(47 + i, x + w * 0.5 + (i - 2) * 22, y + h * 0.56, 20, 30, 0, 1);
      i += 1;
    );
  );
);
