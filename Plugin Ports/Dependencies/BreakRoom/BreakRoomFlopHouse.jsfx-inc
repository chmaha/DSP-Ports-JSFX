        gfx_set(0.72, 0.52, 0.12, 1); gfx_rect(sx(x + a * 28 + k * 14), sy(y - k * 16), 26 * g_s, 14 * g_s);
        gfx_set(1, 0.84, 0.32, 1); gfx_rect(sx(x + a * 28 + k * 14 + 3), sy(y - k * 16 + 1), 20 * g_s, 5 * g_s);
        j += 1;
      );
      i += 1;
