function hr_leap(y) ( ((y % 4) == 0 && (y % 100) != 0) || (y % 400) == 0; );
function hr_mlen(y, m) ( hr_dm[m] + (m == 2 && hr_leap(y) ? 1 : 0); );
function hr_ylen(y) ( 365 + (hr_leap(y) ? 1 : 0); );
function hr_abs(y, m, d) local(a, i)
(
  a = 0; i = 2026;
  while (i < y) ( a += hr_ylen(i); i += 1; );
  i = 1;
  while (i < m) ( a += hr_mlen(y, i); i += 1; );
  a + d - 1;
);
function hr_date(a) local(y, m, l)
(
  y = 2026;
  while (a >= (l = hr_ylen(y))) ( a -= l; y += 1; );
  m = 1;
  while (a >= (l = hr_mlen(y, m))) ( a -= l; m += 1; );
  g_hy = y; g_hm = m; g_hd = a + 1;
);
function hr_wd(a) ( (a + 4) % 7; );
function hr_easter(y) local(a, b, c, d, e, f, g, h, i, k, l, m, mo, da)
(
  a = y % 19; b = floor(y / 100); c = y % 100; d = floor(b / 4); e = b % 4;
  f = floor((b + 8) / 25); g = floor((b - f + 1) / 3);
  h = (19 * a + b - d - g + 15) % 30; i = floor(c / 4); k = c % 4;
  l = (32 + 2 * e + 2 * i - h - k) % 7;
  m = floor((a + 11 * h + 22 * l) / 451);
  mo = floor((h + l - 7 * m + 114) / 31);
  da = ((h + l - 7 * m + 114) % 31) + 1;
  hr_abs(y, mo, da);
);
