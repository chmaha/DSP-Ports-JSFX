  c == 2 ? ( w ? hb_church(x, 0.9, sr, sg, sb, 0) : ( i = 0; loop(9, hb_b(x + i * 22, 244 - sin(i / 8 * $pi) * 14, 22, 28 + sin(i / 8 * $pi) * 14, 0.84, 0.74, 0.52); hb_win(x + i * 22 + 2, 248 - sin(i / 8 * $pi) * 14, 18, 18, 2, 2, 0.28, 0.26, 0.26); i += 1; ); ) ) :
  c == 3 ? ( w ? hb_hs(x, 5, 272, 0.56, 0.32, 0.26, 0.26, 0.26, 0.3) : hb_cath(x, 0.84, 0.82, 0.76, 0.6, 2, 0, 0) ) :
