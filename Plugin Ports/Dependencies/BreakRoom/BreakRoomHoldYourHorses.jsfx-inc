  g_hr_rm = (g_hr_rm + 1) % max(1, g_hr_mn);
  g_hr_rc = md_c[g_hr_rm]; g_hr_ri = 0;
);
function hr_begin(mode, a)
(
  g_hr_dm = sv2[62];
  g_hr_mode = mode; g_hr_rd = a; hr_day(a);
  g_hr_rm = g_hr_mn > 0 ? floor(rand(1) * g_hr_mn) : 0;
