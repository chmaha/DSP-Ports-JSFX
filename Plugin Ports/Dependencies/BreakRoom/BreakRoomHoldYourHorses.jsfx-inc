function hr_rload()
(
  hr_field(g_hr_rd, g_hr_rc, g_hr_ri);
  hr_setlight(g_hr_rd, g_hr_rc, rc_min);
  hr_track(rc_c, rc_f);
  g_rs_ride = 0; g_hr_ride = -1; g_rs_follow = -1; g_rs_camf = 0; g_hr_sel = -1;
  g_hr_chip = 2; g_hr_ewt = 0;
  g_rs_placed = 0;
);

function hr_go_race(a, c, i)
(
  g_hr_rd = a; g_hr_rc = c; g_hr_ri = i;
  g_hr_sd = a; g_hr_sc = c; g_hr_si = i;
  hr_date(a); g_hr_vy = g_hy; g_hr_vm = g_hm;
  hr_rload();
  g_hr_v = 10;
);
function hr_next_entry_slot() local(e, f, best, b, t)
(
  best = 100000000000; b = -1; e = 0;
  loop(HEN,
    f = sv3 + HEB + e * 6;
    f[0] > 0 ? (
      hr_mkrace(f[0] - 1, f[1], f[2]);
      t = (f[0] - 1) * 2000 + rc_min;
      t < best ? ( best = t; b = e; );
    );
    e += 1;
  );
  b;
);
function hr_next_runner_go() local(b, f, guard, d)
(
  guard = 0; b = hr_next_entry_slot();
  while (b >= 0 && guard < 30) (
    f = sv3 + HEB + b * 6;
    d = f[0] - 1;
    hr_abandon(d, f[1]) ? ( f[0] = 0; b = hr_next_entry_slot(); ) : guard = 1000;
    guard += 1;
  );
  b >= 0 ? (
    f = sv3 + HEB + b * 6;
    d = f[0] - 1;
    while (sv3[1] < d) ( hr_nextday(); );
    hr_go_race(d, f[1], f[2]);
    1;
  ) : 0;
);
function hr_next_race_go() local(tries, a, j, n, c, i, bt, bc, bi, found)
(
  tries = 0; found = 0;
  while (!found && tries < 8) (
    a = sv3[1];
    n = hr_day(a);
    bt = 100000; j = 0;
    loop(n,
      hr_day(a); c = md_c[j];
      !hr_abandon(a, c) ? (
        i = 0;
        loop(7,
          hr_mkrace(a, c, i);
          (rc_min > sv3[6] && rc_min < bt) ? ( bt = rc_min; bc = c; bi = i; found = 1; );
          i += 1;
        );
      );
      j += 1;
    );
    !found ? hr_nextday();
    tries += 1;
  );
  found ? hr_go_race(sv3[1], bc, bi);
  found;
);

function hr_pickday() local(a, t, n)
(
  n = hr_abs(max(CAL_Y0 + CAL_NY - 1, hr_ycur()) + 1, 1, 1);
  t = 0; a = floor(rand(1) * n);
  while (hr_day(a) == 0 && t < 40) ( a = floor(rand(1) * n); t += 1; );
  a;
);
function hr_nextracing(a)
(
  a += 1;
  while (hr_day(a) == 0) ( a += 1; );
  a;
);
function hr_nextrace()
(
  hr_day(g_hr_rd);
  g_hr_ri += 1;
  g_hr_ri >= 7 ? ( g_hr_ri = 0; g_hr_rm = (g_hr_rm + 1) % max(1, g_hr_mn); );
  g_hr_rc = md_c[g_hr_rm];
