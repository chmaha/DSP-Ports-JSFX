);

function hr_rankup() local(i, j, k, n)
(
  i = 0;
  loop(g_hr_rn - 1,
    j = i + 1;
    loop(g_hr_rn - 1 - i,
      n = ru_ord[j]; k = ru_ord[i];
      ((ru_fall[n] > 0) < (ru_fall[k] > 0) || ((ru_fall[n] > 0) == (ru_fall[k] > 0) && ((ru_ft[n] > 0 && ru_ft[k] > 0) ? ru_ft[n] < ru_ft[k] : (ru_ft[n] > 0 && ru_ft[k] <= 0) || (ru_ft[k] <= 0 && ru_s[n] > ru_s[k])))) ? ( ru_ord[j] = k; ru_ord[i] = n; );
      j += 1;
    );
    i += 1;
  );
  i = 0; loop(g_hr_rn, ru_rank[ru_ord[i]] = i; i += 1; );
);

function hr_commentary() local(l, left, a, b)
(
  hr_rankup();
  l = ru_ord[0];
  left = g_rs_d - ru_s[l];
  g_rs_ph == 0 ? ( g_rs_ph = 1; sprintf(#hr_sy2, "And they're off in the %s at %s!", hr_tstr(rc_min), hc_n[rc_c]); hr_say(#hr_sy2); );
  (l !== g_rs_lead && g_rs_t > 6 && g_rs_t - g_rs_sayt > 3 && left > 0) ? (
    a = ru_ord[1];
    sprintf(#hr_sy2, "%s %s from %s.", ru_nm[l], left < 400 ? "hits the front" : "takes it up", ru_nm[a]);
    hr_say(#hr_sy2);
    g_rs_lead = l;
  );
  (rc_nf > 0 && ru_next[l] !== g_rs_fsaid && ru_next[l] > 0) ? (
    g_rs_fsaid = ru_next[l]; a = hr_fkind(ru_next[l] - 1, rc_nf);
    b = g_rs_t - g_rs_sayt > 2.5;
    ru_next[l] == rc_nf ? ( sprintf(#hr_sy2, "Over the last, and %s leads them home!", ru_nm[l]); hr_say(#hr_sy2); ) :
    (b && a == 5) ? hr_say("Over The Chair, the biggest fence on the course!") :
    (b && a == 6) ? hr_say("Over Becher's Brook, and down the far side!") :
    (b && a == 7) ? hr_say("Round the Canal Turn!") :
    (b && a == 3) ? hr_say("Over the water.") :
    (b && a == 2) ? hr_say("Over the open ditch.") : 0;
  );
  (g_tk_hasb && !g_rs_turn && left < g_tk_s + 150 && left > g_tk_s && g_rs_t - g_rs_sayt > 2) ? (
    g_rs_turn = 1; sprintf(#hr_sy2, "Turning for home, %s leads!", ru_nm[l]); hr_say(#hr_sy2);
  );
  (g_tk_hasb && !g_rs_home && left < g_tk_s && left > 402) ? (
    g_rs_home = 1;
    sprintf(#hr_sy2, "Into the straight with %s to run, %s in front!", hr_fstr(floor(g_tk_s / 100.584 + 0.5) / 2), ru_nm[l]); hr_say(#hr_sy2);
  );
  (left < 402 && !g_rs_2f) ? ( g_rs_2f = 1; sprintf(#hr_sy2, "Two furlongs out: %s from %s and %s.", ru_nm[l], ru_nm[ru_ord[1]], ru_nm[ru_ord[2]]); hr_say(#hr_sy2); );
  (left < 201 && !g_rs_1f) ? ( g_rs_1f = 1; sprintf(#hr_sy2, "Inside the final furlong! %s, %s, here they come!", ru_nm[l], ru_nm[ru_ord[1]]); hr_say(#hr_sy2); );
);

function hr_btl(q) local(m)
(
  m = q;
  m < 0.04 ? "nse" : m < 0.12 ? "shd" : m < 0.25 ? "hd" : m < 0.4 ? "nk" : m < 0.6 ? "1/2" : m < 0.85 ? "3/4" : m < 1.2 ? "1" : (sprintf(#hr_bb, "%.1f", floor(m * 2 + 0.5) / 2); #hr_bb);
);

function hr_btw(m)
(
  m < 0.04 ? "a nose" : m < 0.12 ? "a short head" : m < 0.25 ? "a head" : m < 0.4 ? "a neck" : m < 0.6 ? "half a length" : m < 0.85 ? "three-quarters of a length" : m < 1.25 ? "a length" : m > 30 ? "a distance" : ( sprintf(#hr_bw, "%.1f lengths", floor(m * 2 + 0.5) / 2); #hr_bw; );
);

function hr_headless() local(i, guard, n)
(
  g_rs_ride = 0;
  hr_rstart();
  guard = 0;
  while (guard < 60000 && (g_rs_fin + g_rs_nf < g_hr_rn)) (
    hr_step(0.05);
    guard += 1;
  );
  hr_rankup();
);

function hr_load(r)
(
  hr_coat(ru_coat[r], ru_sock[r]); hr_blz = ru_blz[r];
  hr_silkset(ru_s1[r], ru_s2[r], ru_pat[r]);
);

function hr_setlight(a, c, mn) local(m, ss, wx)
(
  hr_date(a); m = g_hm;
  ss = m == 12 || m == 1 ? 16.2 : m == 2 || m == 11 ? 17 : m == 3 || m == 10 ? 18.1 : m == 4 || m == 9 ? 19.8 : m == 5 || m == 8 ? 20.8 : 21.4;
  wx = hr_wx(a, c);
  g_rs_wx = wx;
  g_rs_light = mn / 60 > ss ? 2 : mn / 60 > ss - 1 && wx < 3 ? 1 : 0;
  (g_rs_light == 2 && !hc_aw[c]) ? g_rs_light = 1;
);

function hr_lit() ( g_hl_r = g_hb_lr; g_hl_g = g_hb_lg; g_hl_b = g_hb_lb; );
function hr_hublit() ( g_hl_r = 1; g_hl_g = 1; g_hl_b = 1; );
function hr_scene_ready() local(key, i)
(
  key = rc_a * 100 + rc_c + g_rs_light * 1000000;
  key !== g_hb_key ? (
    g_hb_key = key; g_hb_pv = 0;
    hb_bake(rc_c, g_rs_wx, g_rs_light, rc_going);
  );
);

function hr_cam(dt, rdt) local(i, r, lead, tail, zt, mid, f, v, err, hw, acc, top, bot, zs)
(
  hr_rankup();
  r = ru_ord[0];
  lead = ru_s[r]; v = ru_v[r];
  f = g_rs_camf ? g_rs_follow : -1;
  (f >= 0 && ru_fall[f] == 0) ? ( lead = ru_s[f]; v = ru_v[f]; ) : f = -1;
  zs = 0.35;
  g_rs_cam == 1 ? (
    top = 0; bot = 1000000; i = 0;
    loop(g_hr_rn, ru_fall[i] == 0 ? ( top = max(top, ru_s[i]); bot = min(bot, ru_s[i]); ); i += 1; );
    bot > top ? ( top = lead; bot = lead; );
    g_hc_span += ((top - bot) - g_hc_span) * min(1, rdt * 1.5);
    zt = 860 / (g_hc_span * 96 + 330);
    zt = zt < 0.1 ? 0.1 : zt > 0.82 ? 0.82 : zt;
    mid = (top + bot) * 50 + 40;
    zs = 1.1;
  ) : g_rs_cam == 2 ? (
    g_hc_span += (0 - g_hc_span) * min(1, rdt);
    zt = 1.1;
    mid = lead * 100;
    zs = 0.9;
  ) : (
    tail = lead; i = 0;
    loop(min(6, g_hr_rn),
      r = ru_ord[i];
      (ru_fall[r] == 0 && lead - ru_s[r] < 12) ? tail = min(tail, ru_s[r]);
      i += 1;
    );
    g_hc_span += ((lead - tail) - g_hc_span) * min(1, rdt * 0.6);
    zt = 900 / (g_hc_span * 100 + 620);
    zt = zt < 0.52 ? 0.52 : zt > 0.82 ? 0.82 : zt;
    hw = 450 / (hb_k(500) * 100);
    mid = (f >= 0 ? lead : lead - min(g_hc_span * 0.5, hw * 0.28)) * 100;
    g_rs_camp !== 0 ? zs = 0.9;
  );
  g_rs_camp = g_rs_cam;
  g_hc_z += (zt - g_hc_z) * min(1, rdt * zs);
  g_hc_h = 400 / hb_k_u(60);
  g_hc_hy = 212 + ((g_rs_pre <= 0 && g_rs_t < 1.5) ? (1 - g_rs_t / 1.5) * 3.5 * sin(g_rs_t * 62) : 0);
  hw = g_rs_t < 5 ? 3.2 : g_rs_t < 9 ? 3.2 - 0.5 * (g_rs_t - 5) : 1.2;
  g_hc_vr += (v * 100 - g_hc_vr) * min(1, dt * (g_rs_t < 9 ? 10 : 2));
  err = mid - g_hc_x;
  abs(err) > 2500 ? ( g_hc_x = mid; g_hc_vc = v * 100; g_hc_vr = g_hc_vc; g_hc_dx = 0; ) : (
    acc = hw * hw * err + 2 * hw * (g_hc_vr - g_hc_vc);
    g_hc_vc += acc * dt;
    g_hc_dx = g_hc_vc * dt;
    g_hc_x += g_hc_dx;
  );
);

function hb_furlongs() local(i, x, k, y, xs, f)
(
  k = hb_k(1150); y = hb_gy(1150);
  f = 1;
  loop(max(1, floor(rc_f)),
    x = (g_rs_d - f * 201.168) * 100;
    xs = hb_sxw(x, 1150);
    xs > -20 && xs < 920 ? (
      gfx_set(0.95, 0.95, 0.92, 1); gfx_rect(sx(xs - 3 * k), sy(y - 210 * k), 6 * k * g_s, 210 * k * g_s);
      gfx_set(0.9, 0.2, 0.15, 1); gfx_circle(sx(xs), sy(y - 215 * k), 22 * k * g_s, 1, 1);
      font(9, 'b'); gfx_set(1, 1, 1, 1);
      sprintf(#hr_tmp, "%d", f); txt_c(#hr_tmp, xs - 20, y - 215 * k - 8, 40, 16);
