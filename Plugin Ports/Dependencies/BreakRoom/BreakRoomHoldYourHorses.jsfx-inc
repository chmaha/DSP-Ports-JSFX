  c == 9 ? ( w ? hb_cath(x, 0.7, 0.62, 0.42, 0.34, 0, 74, 0) : ( hb_tint(0.66, 0.42, 0.34, 1); gfx_rect(x, 246, 220, 26); i = 0; loop(22, gfx_rect(x + i * 10, 240, 6, 7); i += 1; ); hb_hs(x + 20, 7, 240, 0.86, 0.84, 0.78, 0.3, 0.26, 0.28); hb_b(x + 96, 226, 28, 22, 0.66, 0.42, 0.34); hb_tint(0.56, 0.68, 0.78, 1); gfx_rect(x + 103, 236, 14, 12); gfx_circle(x + 110, 236, 7, 1, 1); hb_tint(0.22, 0.24, 0.26, 1); gfx_rect(x + 106, 224, 2, 6); gfx_rect(x + 112, 224, 2, 6); hb_tint(0.8, 0.7, 0.3, 1); gfx_circle(x + 110, 216, 11, 1, 1); hb_tint(0.95, 0.95, 0.92, 1); gfx_circle(x + 110, 216, 8, 1, 1); ) ) :
  c == 10 ? ( w ? ( hb_cool(x + 40, 0.8); hb_cool(x + 120, 0.8); ) : hb_cath(x, 0.86, 0.56, 0.52, 0.46, 0, 110, 44) ) :
  c == 11 ? ( w ? ( hb_b(x, 216, 16, 54, 0.4, 0.45, 0.55); hb_spire(x, 216, 16, 62, 0.5, 0.6, 0.7); hb_b(x + 24, 196, 14, 74, 0.34, 0.38, 0.48); hb_b(x + 46, 226, 20, 44, 0.46, 0.5, 0.58); hb_b(x + 72, 208, 16, 62, 0.42, 0.44, 0.52); hb_b(x + 96, 232, 26, 38, 0.46, 0.48, 0.56); ) : (
