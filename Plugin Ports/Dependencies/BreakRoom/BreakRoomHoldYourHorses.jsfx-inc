function hs_p(h) ( sv3 + HSH + h * HSF; );
function hr_ab_of(p, a) local(ag, c, j)
(
  hr_date(a); ag = g_hy - p[hs_by];
  j = p[hs_type] ;
  c = j ? (ag <= 4 ? 0.9 : ag == 5 ? 0.95 : ag <= 9 ? 1 : ag == 10 ? 0.97 : 0.92) : (ag <= 2 ? 0.86 : ag == 3 ? 1 : ag == 4 ? 1.01 : ag == 5 ? 1 : ag == 6 ? 0.97 : 0.93);
  p[hs_pot] * c;
);
function hr_age(p, a) ( hr_date(a); g_hy - p[hs_by]; );

function hr_elig(h, a) local(p, ag)
(
  p = hs_p(h);
  ag = hr_age(p, a);
  g_hr_why = 0;
  !p[hs_used] ? 0 :
  p[hs_inj] > 0 ? ( g_hr_why = "Injured"; 0; ) :
  ag < rc_a0 || (rc_a1 > 0 && ag > rc_a1) ? ( g_hr_why = "Wrong age"; 0; ) :
  rc_sx == 1 && p[hs_sex] !== 1 ? ( g_hr_why = "Fillies and mares only"; 0; ) :
  (rc_j > 0 && rc_j < 3) && p[hs_jmp] < 20 ? ( g_hr_why = "Has not been schooled over jumps"; 0; ) :
  rc_mdn && p[hs_wins] > 0 ? ( g_hr_why = "Maidens only"; 0; ) :
  rc_nov && p[hs_wins] > 1 ? ( g_hr_why = "Novices only"; 0; ) :
  rc_hc && p[hs_runs] < 3 ? ( g_hr_why = "Needs 3 runs for a handicap mark"; 0; ) :
  rc_hc && (p[hs_or] > rc_mx || p[hs_or] < rc_mn - 15) ? ( g_hr_why = "Outside the handicap band"; 0; ) :
  1;
);

function hr_entry_find(a, c, i, h) local(e, f, r)
(
  r = -1; e = 0;
  loop(HEN, f = sv3 + HEB + e * 6; (f[0] > 0 && f[0] - 1 === a && f[1] === c && f[2] === i && (h < 0 || f[3] === h)) ? r = e; e += 1; );
  r;
