    hr_2bone(sx1, sy1, fx, fy, 40, 52, 1);
    kx = hr_jx; ky = hr_jy; ttx = hr_ex; tty = hr_ey;
    ky > sy1 - 6 ? (
      ky = sy1 - 6; kx = sx1 + 39.5;
      a = sqrt((fx - kx) * (fx - kx) + (fy - ky) * (fy - ky));
      a < 0.1 ? a = 0.1;
      ttx = kx + (fx - kx) / a * 52; tty = ky + (fy - ky) / a * 52;
    );
    hr_st_mode ? (
      pa = -20; tty = 19; ky = 57; sy1 = 94;
      z > 0 ? ( sx1 = 48; kx = 52; ttx = 51; ) : ( sx1 = 44; kx = 42; ttx = 35; );
    );
    gx = kx + (sx1 - kx) * 0.5; gy = ky + (sy1 - ky) * 0.5;
    hr_rot(34, 142);
    hr_cap(hr_wx, hr_wy, z, 12, sx1, sy1, z, 13.5, 0);
    hr_cap(sx1, sy1, z, 12.5, gx, gy, z, 9.5, 0);
    hr_cap(gx, gy, z, 9.5, kx, ky, z, 6.4, 0);
    hr_cap(kx, ky, z, 6.4, kx * 0.82 + ttx * 0.18, ky * 0.82 + tty * 0.18, z, 4.9, 5);
    hr_cap(kx * 0.82 + ttx * 0.18, ky * 0.82 + tty * 0.18, z, 4.6, ttx, tty, z, 4.2, 5);
  ) : (
    fx = hr_key(hr_khx, p) - 52; fy = hr_key(hr_khy, p); pa = hr_key(hr_khp, p); sw = hr_key(hr_khs, p);
    a = (sw + 8) * 0.01745;
    hr_rot(-58, 120); hx = hr_wx; hy = hr_wy;
    hr_rot(-58 + sin(a + 0.55) * 44, 120 - cos(a + 0.55) * 44); sx1 = hr_wx; sy1 = hr_wy;
    w > 0 ? (
      hr_rot(hr_jf > 0.5 ? -40 : -128, hr_jf > 0.5 ? 74 : 62); ux = hr_wx; uy = hr_wy;
      fx += (ux - fx) * w; fy += (uy - fy) * w; pa += ((hr_jf > 0.5 ? 140 : 120) - pa) * w;
    );
    hr_limp > 0 ? ( hr_rot(-60 + z * 0.4, 30); fx += (hr_wx - fx) * hr_limp; fy += (hr_wy - fy) * hr_limp; );
    hr_2bone(sx1, sy1, fx, fy, 44, 42, -1);
    kx = hr_jx; ky = hr_jy; ttx = hr_ex; tty = hr_ey;
    hr_st_mode ? (
      pa = -20; tty = 19;
      z > 0 ? ( sx1 = -50; sy1 = 100; kx = -90; ky = 66; ttx = -94; ) : ( sx1 = -50; sy1 = 90; kx = -70; ky = 60; ttx = -54; );
    );
    hr_cap(hx, hy, z * 0.7, 18, sx1, sy1, z * 0.95, 11.5, 0);
    hr_rot(-80, 116);
    hr_cap(hr_wx, hr_wy, z * 0.7, 11, sx1 + (kx - sx1) * 0.3 - 3, sy1 + (ky - sy1) * 0.3, z * 0.95, 9, 0);
    gx = kx + (sx1 - kx) * 0.4; gy = ky + (sy1 - ky) * 0.4;
    hr_cap(sx1, sy1, z, 10.5, gx, gy, z, 8, 0);
    hr_cap(gx, gy, z, 8, kx, ky, z, 6.2, 0);
    a = max(1, abs(ttx - kx) + abs(tty - ky));
    hr_cap(kx, ky, z, 5.6, kx - 8 * (ttx - kx) / a, ky - 8 * (tty - ky) / a, z, 2.8, 0);
    hr_cap(kx, ky, z, 6.2, kx * 0.8 + ttx * 0.2, ky * 0.8 + tty * 0.2, z, 5, 5);
    hr_cap(kx * 0.8 + ttx * 0.2, ky * 0.8 + tty * 0.2, z, 4.8, ttx, tty, z, 4.3, 5);
  );
  a = pa * 0.01745;
  phx = ttx - sin(a) * 11 + cos(a) * 5;
  phy = tty - cos(a) * 11 - sin(a) * 5;
  hr_cap(ttx, tty, z, 5.6, ttx, tty, z, 5.6, mlow);
  hr_cap(ttx, tty, z, 4.6, phx, phy, z, 4.4, mlow);
  tx = phx + cos(a + 0.25) * 8; ty = phy + sin(a + 0.25) * 8 - 3.2;
  hr_st_mode ? (
    phy = 6.5; tx = phx + 6; ty = 5.5;
    hr_cap(ttx, tty, z, 4.6, phx, phy + 1, z, 4.6, mlow);
    hr_cap(phx - 2, phy, z, 6, tx, ty, z, 5.5, mh);
  ) : hr_cap(phx - 1, phy - 1, z, 6.2, tx, ty, z, 5.4, mh);
);

function hf_silk_pat(u0, v0, u1, v1) local(i, t, a, b, c, d, ww, n)
(
  hr_pat ? (
    gfx_a = 1;
    hf_rgb(hr_sr2, hr_sg2, hr_sb2);
    hr_pat == 1 ? (
      i = 0;
      loop(3,
        t = 0.2 + i * 0.3;
        a = u0 + (u1 - u0) * t; b = v0 + (v1 - v0) * t;
        hf_pt(a + 2.5, b + 11, 9); c = hr_px; d = hr_py;
        hf_pt(a - 2.5, b - 11, 9);
        hf_seg(c, d, hr_px, hr_py, 2.8 * hr_sc, 2.8 * hr_sc);
        i += 1;
      );
    ) : hr_pat == 2 ? (
      hf_pt(u0, v0 + 7, 9); c = hr_px; d = hr_py; hf_pt(u1, v1 + 7, 9); hf_seg(c, d, hr_px, hr_py, 2.2 * hr_sc, 2.2 * hr_sc);
      hf_pt(u0, v0 - 5, 9); c = hr_px; d = hr_py; hf_pt(u1, v1 - 5, 9); hf_seg(c, d, hr_px, hr_py, 2.2 * hr_sc, 2.2 * hr_sc);
    ) : hr_pat == 3 ? (
      hf_pt(u0 + 6, v0 - 10, 9); c = hr_px; d = hr_py; hf_pt(u1 - 2, v1 + 10, 9); hf_seg(c, d, hr_px, hr_py, 4 * hr_sc, 4 * hr_sc);
    ) : hr_pat == 4 ? (
      a = (u0 + u1) * 0.5; b = (v0 + v1) * 0.5;
      hf_pt(a, b, 9); c = hr_px; d = hr_py; hf_pt(u1, v1, 9); hf_seg(c, d, hr_px, hr_py, 10 * hr_sc, 11 * hr_sc);
    ) : hr_pat == 5 ? (
      i = 0;
      loop(3,
        t = 0.2 + i * 0.3;
        a = u0 + (u1 - u0) * t; b = v0 + (v1 - v0) * t;
        hf_pt(a - 5, b + 10, 9); c = hr_px; d = hr_py;
        hf_pt(a + 3, b, 9); hf_seg(c, d, hr_px, hr_py, 2 * hr_sc, 2 * hr_sc);
        c = hr_px; d = hr_py;
        hf_pt(a - 5, b - 10, 9); hf_seg(c, d, hr_px, hr_py, 2 * hr_sc, 2 * hr_sc);
        i += 1;
      );
    ) : hr_pat == 6 ? (
      i = 0;
      loop(8,
        t = 0.08 + (i % 4) * 0.28; a = u0 + (u1 - u0) * t; b = v0 + (v1 - v0) * t + (i > 3 ? -5 : 5);
        hf_pt(a, b, 9); gfx_circle(hr_px, hr_py, 2.6 * hr_sc, 1, 1);
        i += 1;
      );
    ) : (
      a = (u0 + u1) * 0.5; b = (v0 + v1) * 0.5;
      hf_pt(a, b, 9); gfx_circle(hr_px, hr_py, 7 * hr_sc, 1, 1);
    );
  );
);

function hr_jockey_on(p, st) local(ax, ay, ex, ey, kx, ky, mx, my, hx, hy, rw, hh, tx, ty, tx2, ty2, u0, v0, u1, v1, wa)
(
  rw = st ? 0 : hr_row * (1 + 0.55 * hr_drv);
  hh = st ? -11 : -3 - (5 + 1.5 * hr_drv) * sin(6.2832 * (p + 0.6)) + 1.2 * hr_row * (1 + hr_drv);
  hr_jw > 0 ? ( hh -= 7 * hr_jw; rw *= 1 - hr_jw; );
  hr_rot(-14, 148); ax = hr_wx; ay = hr_wy;
  hr_rot(24, 152);
  hr_cap(ax, ay, 12, 4.5, hr_wx, hr_wy, 12, 3.5, 10);

  hr_rot(26 + rw * 3, 208 + hh); ex = hr_wx; ey = hr_wy;
  hr_rot(70 + rw * 13, 172 + rw * 3); kx = hr_wx; ky = hr_wy;
  hr_rot(38 + rw * 7, 190 + hh + rw * 2); mx = hr_wx; my = hr_wy;
  hr_cap(ex, ey, -13, 6.5, mx, my, -13, 5, 13);
  hr_cap(mx, my, -13, 5, kx, ky, -10, 3.8, 13);

  hr_rot(-24 - rw * 2, 186 + hh); ax = hr_wx; ay = hr_wy;
  u0 = -24 - rw * 2; v0 = 186 + hh; u1 = 26 + rw * 3; v1 = 208 + hh;
  hr_cap(ax, ay, 0, 12, ex, ey, 0, 15, 12);
  hf_silk_pat(u0, v0, u1, v1);
  hr_rot(-26 - rw * 2, 180 + hh); ax = hr_wx; ay = hr_wy;
  hr_rot(-14 - rw * 2, 180 + hh);
  hr_cap(ax, ay, 2, 12.5, hr_wx, hr_wy, 2, 12, 14);
  hf_strip(-30 - rw * 2, 174 + hh, -10 - rw * 2, 174 + hh, 3.5, 3, 14, 0.85);

  hr_rot(-18 - rw * 2, 180 + hh); kx = hr_wx; ky = hr_wy;
  hr_rot(32, 172 + hh * 0.5); mx = hr_wx; my = hr_wy;
  hr_cap(kx, ky, 11, 11, mx, my, 15, 7, 14);
  hr_rot(-2, 136); ax = hr_wx; ay = hr_wy;
  hr_cap(mx, my, 15, 6.6, ax, ay, 21, 4.6, 15);
  hr_cap(ax - 3, ay - 1, 21, 4, ax + 10, ay - 3, 21, 3.2, 15);
  hr_rot(6, 128); tx = hr_wx; ty = hr_wy;
  hr_cap(tx - 3, ty, 21, 1.1, tx + 6, ty, 21, 1.1, 19);
  hr_rot(18, 150);
  hr_cap(tx, ty, 20, 0.8, hr_wx, hr_wy, 19, 0.8, 10);

  hr_rot(28 + rw * 3, 208 + hh); ax = hr_wx; ay = hr_wy;
  hr_rot(40 + rw * 7, 190 + hh + rw * 2); mx = hr_wx; my = hr_wy;
  hr_cap(ax, ay, 13, 7, mx, my, 14, 5.2, 13);
  hr_rot(70 + rw * 13, 172 + rw * 3); kx = hr_wx; ky = hr_wy;
  hr_cap(mx, my, 14, 5.2, kx, ky, 11, 3.8, 13);
  hr_cap(kx, ky, 9, 4, kx + 2, ky - 1, 9, 4, 15);
  hr_rot(hr_nx - 2, hr_ny - 18); hx = hr_wx; hy = hr_wy;
  hr_cap(kx + 2, ky, 9, 0.9, hx, hy, 9, 0.9, 10);
  hr_whip > 0 ? (
    wa = 2.4 + hr_whip * 1.3;
    hr_rot(38 + rw * 7, 190 + hh); ax = hr_wx; ay = hr_wy;
    hr_cap(mx, my, 15, 3.6, ax - 26, ay + 16 * (hr_whip - 0.3), 15, 3, 13);
    hr_cap(ax - 26, ay + 16 * (hr_whip - 0.3), 15, 0.9, ax - 26 + cos(wa) * 40, ay + 16 * (hr_whip - 0.3) + sin(wa) * 40, 15, 0.5, 15);
  );

  hr_rot(50 + rw * 3, 224 + hh); ax = hr_wx; ay = hr_wy;
  hr_rot(36 + rw * 3, 212 + hh); hx = hr_wx; hy = hr_wy;
  hr_cap(hx, hy, 0, 6.5, ax, ay, 0, 6, 17);
  hr_cap(ax - 1, ay + 1.5, 0, 10.5, ax + 1, ay + 1.5, 0, 10.5, 16);
  hr_cap(ax + 7, ay - 2.5, 0, 3.8, ax + 13, ay - 3, 0, 1.6, 16);
  hr_cap(ax + 7.5, ay - 3.5, 7, 2.8, ax + 8.5, ay - 3.5, 7, 2.8, 18);
  hr_cap(ax + 2, ay - 5.5, 8.5, 2.2, ax + 5, ay - 6, 8.2, 2.2, 17);
);

function hr_pose(p, st, rider) local(i, a, nk, hx, hy, mx, my, tx, ty, tx2, ty2, q, ax, ay, ex, ey, hdx, hdy, hl)
(
  hr_st_mode = st;
  hr_row = sin(6.2832 * (p + 0.1));
  st ? (
    hr_by0 = hr_lift + 3; hr_bx0 = 0; a = hr_pitch;
  ) : (
    a = 0.05 * sin(6.2832 * (p - 0.07)) + hr_pitch;
    hr_bx0 = 0;
    hr_by0 = -4 + 6 * sin(6.2832 * (p + 0.6)) * (1 - hr_jw) + hr_lift;
  );
  hr_bc = cos(a); hr_bs = sin(a);

  hr_leg(1, p - 0.38 + 1, -13, 2, 6);
  hr_leg(0, p - 0.10 + 1, -11, 2, 5);

  hr_rot(-84, 138); tx = hr_wx; ty = hr_wy;
  i = 0; q = 6.5;
  loop(8,
    a = st ? -1.5 : -0.25 - 0.022 * i + 0.25 * sin(i * 0.62 - p * 6.2832) * (0.3 + i * 0.1);
    tx2 = tx + (st ? -0.8 : -cos(a) * 11); ty2 = ty + (st ? -10.5 : sin(a) * 11);
    hr_cap(tx, ty, 0, q, tx2, ty2, 0, q * 0.92, 1);
    i > 2 ? ( hr_cap(tx, ty - q * 0.5, 0, q * 0.45, tx2 - 3, ty2 - q * 0.8, 0, q * 0.3, 1); );
    tx = tx2; ty = ty2;
    q = i < 3 ? q + 0.4 : max(1.2, q - 1.2);
    i += 1;
  );

  hr_rot(-64, 124); ax = hr_wx; ay = hr_wy;
  hr_rot(-32, 125); ex = hr_wx; ey = hr_wy;
  hr_cap(ax, ay, 0, 23, ex, ey, 0, 25, 0);
  hr_rot(-5, 121); ax = hr_wx; ay = hr_wy;
  hr_cap(ex, ey, 0, 25, ax, ay, 0, 29, 0);
  hr_rot(25, 118); ex = hr_wx; ey = hr_wy;
  hr_cap(ax, ay, 0, 29, ex, ey, 0, 33, 0);
  hr_rot(48, 119); ax = hr_wx; ay = hr_wy;
  hr_cap(ex, ey, 0, 33, ax, ay, 0, 27, 0);
  hr_rot(63, 113); ex = hr_wx; ey = hr_wy;
  hr_cap(ax, ay, 0, 27, ex, ey, 0, 15, 0);
  hr_rot(18, 146); ax = hr_wx; ay = hr_wy;
  hr_rot(44, 150); ex = hr_wx; ey = hr_wy;
  hr_cap(ax, ay, 0, 11, ex, ey, 0, 13, 0);

  hf_strip(-58, 108, -8, 101, 6, 10, 0, 1.1);
  hf_strip(-8, 101, 34, 97, 10, 12, 0, 1.17);
  hf_strip(-52, 146, -14, 147, 3, 3, 0, 0.76);
  hf_strip(-14, 147, 12, 148, 3, 3, 0, 0.76);
  hf_strip(32, 142, 56, 110, 8, 9, 0, 1.03);
  hf_strip(36, 128, 54, 104, 3, 3, 0, 1.16);
  hf_strip(-68, 132, -56, 100, 8, 9, 0, 1.03);
  hf_strip(-74, 122, -62, 92, 2.5, 2.5, 0, 1.14);
  hf_strip(-34, 128, -40, 104, 1.6, 1.2, 0, 0.8);

  nk = st ? 0 : 3 * hr_row;
  st ? ( hr_nx = 126; hr_ny = 198; ) : ( hr_nx = 116 + nk * 2 - hr_jw * 8; hr_ny = 176 + nk * 2.4 + hr_jw * 8; );
  hr_rot(hr_nx, hr_ny); hdx = hr_wx; hdy = hr_wy;
  hr_rot(50, 136); ax = hr_wx; ay = hr_wy;
  hr_rot((50 + hr_nx) * 0.5 - 2, (136 + hr_ny) * 0.5 + 1); mx = hr_wx; my = hr_wy;
  hr_cap(ax, ay, 0, 26, mx, my, 0, 15.5, 0);
  hr_cap(mx, my, 0, 15.5, hdx, hdy, 0, 10.5, 0);
  hr_rot(60, 114); ax = hr_wx; ay = hr_wy;
  hr_rot(hr_nx - 7, hr_ny - 9); ex = hr_wx; ey = hr_wy;
  hr_cap(ax, ay, 0, 16, ex, ey, 0, 9.5, 0);
  hf_strip(62, 118, hr_nx - 8, hr_ny - 12, 7, 3.5, 0, 1.1);

  i = 0;
  loop(9,
    q = i / 8;
    hr_rot(38 + (hr_nx - 38) * q, 158 + (hr_ny - 158) * q + 3); mx = hr_wx; my = hr_wy;
    tx = st ? -7 - 3 * sin(i * 2.4) : -27 - 8 * sin(i * 2.4);
    ty = st ? -22 - 5 * sin(i * 1.3) : 4 * sin(i * 1.7 + p * 6.2832) - 4;
    hr_cap(mx, my, 2, 4.8, mx + tx, my + ty, 2, 1.1, 1);
    i += 1;
  );

  st ? ( q = 1.0; hl = 56; ) : ( q = 0.56 + nk * 0.03 + hr_jw * 0.1; hl = 52; );
  hx = hdx + cos(-q) * hl; hy = hdy + sin(-q) * hl;
  hr_cap(hdx, hdy - 2, 0, 14.5, hdx + (hx - hdx) * 0.32, hdy - 2 + (hy - hdy) * 0.32, 0, 11.5, 7);
  hr_cap(hdx + (hx - hdx) * 0.32, hdy - 2 + (hy - hdy) * 0.32, 0, st ? 12.5 : 11.5, hx, hy, 0, st ? 8.6 : 8, 7);
  hr_cap(hx - 1, hy - 1, 0, 8.4, hx + 2.5, hy - 2.5, 0, 7, 8);
  mx = hdx + (hx - hdx) * 0.14 - sin(q) * 8; my = hdy + (hy - hdy) * 0.14 - cos(q) * 8;
  hr_cap(mx, my, 0, 13, mx + (hx - hdx) * 0.2, my + (hy - hdy) * 0.2, 0, 8, 7);
  hr_blz ? (
    hf_rgb(0.92, 0.9, 0.86);
    hr_prj(hdx + (hx - hdx) * 0.2 + sin(q) * 8, hdy + (hy - hdy) * 0.2 + cos(q) * 8, 9); ax = hr_px; ay = hr_py;
    hr_prj(hdx + (hx - hdx) * 0.85 + sin(q) * 5, hdy + (hy - hdy) * 0.85 + cos(q) * 5, 9);
    hf_seg(ax, ay, hr_px, hr_py, 2.6 * hr_sc, 2 * hr_sc);
  );
  ax = hdx + (hx - hdx) * 0.3 + sin(q) * 6; ay = hdy + (hy - hdy) * 0.3 + cos(q) * 6 - 1;
  hr_cap(ax, ay, 9.2, 3.1, ax, ay, 9.2, 3.1, 9);
  hr_cap(hdx - 3, hdy + 9, 4.5, 3.6, hdx - 9 + (st ? 4 : 0), hdy + 24, 3, 1, 7);
  hr_cap(hx + 2, hy + 2.5, 5.2, 1.5, hx + 2, hy + 2.5, 5.2, 1.5, 9);

  rider != 2 ? (
    mx = hdx + (hx - hdx) * 0.76; my = hdy + (hy - hdy) * 0.76 - 2;
    hr_cap(mx - sin(q) * 8, my - cos(q) * 8, 8, 0.9, mx + sin(q) * 8, my + cos(q) * 8, 8, 0.9, 10);
    hr_cap(mx + sin(q) * 8, my + cos(q) * 8, 8, 0.9, hdx + (hx - hdx) * 0.05 + 2, hdy + (hy - hdy) * 0.05 + 12, 10, 0.9, 10);
    hr_cap(hdx + (hx - hdx) * 0.05 + 2, hdy + (hy - hdy) * 0.05 + 12, 10, 1, hdx + 14, hdy - 16, 12, 1, 10);
    hr_cap(mx, my - 3, 9, 2, mx, my - 3, 9, 2, 19);

    hf_quad(-34, 150, 6, 152, 8, 124, -36, 120, 11, 1);
    hf_quad(-34, 124, 8, 128, 8, 124, -36, 120, 11, 0.8);
    hf_strip(10, 150, 11, 92, 2.2, 2.2, 10, 1);
    hr_rot(-14, 149); ax = hr_wx; ay = hr_wy;
    hr_rot(14, 152);
    hr_cap(ax, ay, 8, 3.6, hr_wx, hr_wy, 8, 3, 10);
    hr_rot(-14, 136);
    hf_pt(-14, 138, 20); g_hf_nx = hr_px; g_hf_ny = hr_py;
  );

  hr_leg(1, p - 0.28 + 1, 13, 2, 4);
  hr_leg(0, p + 1, 11, 2, 3);
  rider == 1 ? hr_jockey_on(p, st);
);

function hr_tumble(x, y, ang, sc, dir, roll) local(c, s0, ax, ay, bx, by, hx, hy)
(
  c = cos(ang); s0 = sin(ang);
  hr_view(dir, 0.2, sc, x, y);
  hr_bx0 = 0; hr_by0 = 12; hr_bc = c; hr_bs = s0;
  hr_rot(-14, 0); ax = hr_wx; ay = hr_wy; hr_rot(14, 0); bx = hr_wx; by = hr_wy;
  hr_cap(ax, ay, -3, 6, bx + 8 * s0, by - 8 * c, -3, 5, 13);
  hr_rot(-14, 0); hr_cap(hr_wx, hr_wy, 0, 9, bx, by, 0, 10.5, 12);
  hr_rot(-14, 0); ax = hr_wx; ay = hr_wy; hr_rot(-34, -8 * roll); hx = hr_wx; hy = hr_wy;
  hr_cap(ax, ay, 2, 8, hx, hy, 2, 5.5, 14);
  hr_rot(-46, 6 * roll); hr_cap(hx, hy, 2, 5, hr_wx, hr_wy, 2, 3.8, 15);
  hr_rot(22, 2); hr_cap(bx, by, 4, 5, hr_wx + 14 * c, hr_wy + 14 * s0, 4, 3.6, 13);
  hr_rot(25, 0); hr_cap(hr_wx, hr_wy, 0, 7.5, hr_wx, hr_wy, 0, 7.5, 16);
);

function hr_stdcol()
(
  hr_mr[2] = 0.13; hr_mg[2] = 0.11; hr_mb2[2] = 0.1;
  hr_mr[9] = 0.02; hr_mg[9] = 0.015; hr_mb2[9] = 0.012;
  hr_mr[10] = 0.1; hr_mg[10] = 0.06; hr_mb2[10] = 0.04;
  hr_mr[19] = 0.72; hr_mg[19] = 0.72; hr_mb2[19] = 0.75;
  hr_mr[14] = 0.84; hr_mg[14] = 0.83; hr_mb2[14] = 0.79;
  hr_mr[15] = 0.06; hr_mg[15] = 0.06; hr_mb2[15] = 0.06;
  hr_mr[17] = 0.82; hr_mg[17] = 0.62; hr_mb2[17] = 0.5;
  hr_mr[18] = 0.03; hr_mg[18] = 0.03; hr_mb2[18] = 0.04;
  hr_mr[11] = 0.9; hr_mg[11] = 0.89; hr_mb2[11] = 0.84;
);
hr_stdcol();
function hr_coat(c, socks) local(pr, pg, pb, r, g, b, k)
(
  c == 0 ? ( r = 0.46; g = 0.23; b = 0.11; pr = 0.06; pg = 0.05; pb = 0.05; ) :
  c == 1 ? ( r = 0.68; g = 0.33; b = 0.13; pr = 0.5; pg = 0.22; pb = 0.09; ) :
  c == 2 ? ( r = 0.13; g = 0.1; b = 0.09; pr = 0.05; pg = 0.045; pb = 0.05; ) :
  c == 3 ? ( r = 0.68; g = 0.68; b = 0.68; pr = 0.32; pg = 0.32; pb = 0.33; ) :
  c == 4 ? ( r = 0.26; g = 0.14; b = 0.09; pr = 0.06; pg = 0.05; pb = 0.05; ) :
           ( r = 0.8; g = 0.5; b = 0.22; pr = 0.9; pg = 0.84; pb = 0.72; );
  hr_mr[0] = r; hr_mg[0] = g; hr_mb2[0] = b;
  hr_mr[1] = pr; hr_mg[1] = pg; hr_mb2[1] = pb;
  hr_mr[7] = r * 0.97; hr_mg[7] = g * 0.97; hr_mb2[7] = b * 0.97;
  hr_mr[8] = r * 0.42 + 0.03; hr_mg[8] = g * 0.38 + 0.03; hr_mb2[8] = b * 0.38 + 0.03;
  k = c == 3 || c == 1;
  hr_mr[3] = socks & 1 ? 0.94 : k ? r : pr; hr_mg[3] = socks & 1 ? 0.92 : k ? g : pg; hr_mb2[3] = socks & 1 ? 0.88 : k ? b : pb;
  hr_mr[4] = socks & 2 ? 0.94 : k ? r : pr; hr_mg[4] = socks & 2 ? 0.92 : k ? g : pg; hr_mb2[4] = socks & 2 ? 0.88 : k ? b : pb;
  hr_mr[5] = k ? r : pr; hr_mg[5] = k ? g : pg; hr_mb2[5] = k ? b : pb;
  hr_mr[6] = hr_mr[5]; hr_mg[6] = hr_mg[5]; hr_mb2[6] = hr_mb2[5];
);
function hr_silks(r, g, b, r2, g2, b2, pat, cr, cg, cb)
(
  hr_mr[12] = r; hr_mg[12] = g; hr_mb2[12] = b;
  hr_mr[13] = pat == 0 ? r2 : r; hr_mg[13] = pat == 0 ? g2 : g; hr_mb2[13] = pat == 0 ? b2 : b;
  hr_mr[16] = cr; hr_mg[16] = cg; hr_mb2[16] = cb;
  hr_sr2 = r2; hr_sg2 = g2; hr_sb2 = b2; hr_pat = pat;
);
hrc_r = alloc(14); hrc_g = alloc(14); hrc_b = alloc(14);
function hrc_set(i, r, g, b) ( hrc_r[i] = r; hrc_g[i] = g; hrc_b[i] = b; );
hrc_set(0, 0.85, 0.12, 0.1); hrc_set(1, 0.1, 0.25, 0.75); hrc_set(2, 0.1, 0.55, 0.3); hrc_set(3, 0.95, 0.8, 0.15); hrc_set(4, 0.5, 0.1, 0.55); hrc_set(5, 0.93, 0.93, 0.92); hrc_set(6, 0.08, 0.08, 0.1); hrc_set(7, 0.95, 0.5, 0.1); hrc_set(8, 0.9, 0.4, 0.68); hrc_set(9, 0.1, 0.65, 0.72); hrc_set(10, 0.05, 0.1, 0.3); hrc_set(11, 0.45, 0.12, 0.14); hrc_set(12, 0.35, 0.72, 0.9); hrc_set(13, 0.55, 0.72, 0.2);
function hr_silkset(a, b2, pat)
(
  hr_silks(hrc_r[a], hrc_g[a], hrc_b[a], hrc_r[b2], hrc_g[b2], hrc_b[b2], pat, hrc_r[b2], hrc_g[b2], hrc_b[b2]);
);

IMG_HRF1 = 37; IMG_HRF2 = 38; IMG_HRF3 = 39; IMG_HRF4 = 40; IMG_HRT = 41; IMG_HRSK = 42;
HTW = 1024; HTH = 128;

function hb_tint(r, g, b, a) ( gfx_set(min(1, r * g_hl_r), min(1, g * g_hl_g), min(1, b * g_hl_b), a); );

function hb_ridge(img, w, h, base, amp, f1, f2, f3, seed, r, g, b, r2, g2, b2) local(x, t, y, q)
(
  gfx_dest = img; gfx_mode = 0; gfx_a = 1;
  x = 0;
  loop(w,
    t = x / w * 2 * $pi;
    y = base - amp * (0.55 * sin(t * f1 + seed) + 0.3 * sin(t * f2 + seed * 2.3) + 0.15 * sin(t * f3 + seed * 3.1));
    y = floor(y);
    q = (h - y);
    gfx_gradrect(x, y, 1, q, min(1, r * g_hl_r), min(1, g * g_hl_g), min(1, b * g_hl_b), 1, 0, 0, 0, 0, (r2 - r) * g_hl_r / q, (g2 - g) * g_hl_g / q, (b2 - b) * g_hl_b / q, 0);
    x += 1;
  );
);

function hb_tree(x, y, s, r, g, b) local(i, a, d, k)
(
  hb_tint(r * 0.45, g * 0.4, b * 0.4, 1); gfx_rect(x - s * 0.06, y - s * 0.5, s * 0.12, s * 0.5);
  i = 0;
  loop(16,
    a = hash(x * 0.13 + i * 3.1) * 6.283; d = hash(x * 0.37 + i * 1.7) * s * 0.42;
    k = 0.72 + 0.5 * (0.5 - 0.5 * sin(a)) * (d / (s * 0.42) * 0.6 + 0.4);
    hb_tint(r * k, g * k, b * k, 1);
    gfx_circle(x + cos(a) * d * 1.05, y - s * 0.68 + sin(a) * d * 0.9, s * (0.2 + 0.1 * hash(x + i)), 1, 1);
    i += 1;
  );
);

function hb_crowd(x0, y0, w, h, dens) local(x, y, k, c)
(
  y = y0;
  while (y < y0 + h) (
    x = x0 + hash(y) * 2;
    while (x < x0 + w) (
      k = hash(x * 1.3 + y * 7.1);
      k < dens ? (
        c = hash(x * 3.3 + y);
        c < 0.25 ? hb_tint(0.12, 0.13, 0.2, 1) : c < 0.42 ? hb_tint(0.75, 0.74, 0.7, 1) : c < 0.56 ? hb_tint(0.55, 0.14, 0.16, 1) : c < 0.68 ? hb_tint(0.18, 0.3, 0.55, 1) : c < 0.8 ? hb_tint(0.25, 0.25, 0.26, 1) : c < 0.9 ? hb_tint(0.75, 0.6, 0.25, 1) : hb_tint(0.4, 0.5, 0.3, 1);
        gfx_rect(x, y + 1.5, 2, 3);
        hb_tint(0.82, 0.65, 0.52, 1); gfx_rect(x, y, 2, 2);
      );
      x += 3;
    );
    y += 4;
  );
);

function hb_b(x, y, w, h, r, g, b)
(
  hb_tint(r, g, b, 1); gfx_rect(x, y, w, h);
  hb_tint(r * 0.8, g * 0.8, b * 0.8, 1); gfx_rect(x + w * 0.68, y, w * 0.32, h);
  hb_tint(min(1, r * 1.12), min(1, g * 1.12), min(1, b * 1.12), 1); gfx_rect(x, y, w, 1);
);
function hb_win(x, y, w, h, nx, ny, r, g, b) local(i, j, dx, dy)
(
  dx = w / nx; dy = h / ny;
  hb_tint(r, g, b, 1);
  j = 0;
  loop(ny,
    i = 0;
    loop(nx, gfx_rect(x + i * dx + dx * 0.22, y + j * dy + dy * 0.18, dx * 0.56, dy * 0.6); i += 1; );
    j += 1;
  );
);
function hb_cren(x, y, w, r, g, b) local(i, n)
(
  hb_tint(r, g, b, 1);
  n = floor(w / 7); i = 0;
  loop(n, gfx_rect(x + i * w / n, y - 4, w / n * 0.55, 4); i += 1; );
);
function hb_twr(x, base, w, h, r, g, b)
(
  hb_b(x, base - h, w, h, r, g, b);
  hb_cren(x - 1, base - h, w + 2, r, g, b);
  hb_win(x + w * 0.25, base - h * 0.85, w * 0.5, h * 0.5, 1, 3, r * 0.3, g * 0.3, b * 0.34);
);
function hb_spire(x, y, w, h, r, g, b)
(
  hb_tint(r, g, b, 1); gfx_triangle(x, y, x + w * 0.5, y - h, x + w, y);
  hb_tint(r * 0.76, g * 0.76, b * 0.76, 1); gfx_triangle(x + w * 0.5, y, x + w * 0.5, y - h, x + w, y);
);
function hb_castle(x, s, r, g, b)
(
  hb_b(x, 270 - 34 * s, 150 * s, 34 * s, r * 0.94, g * 0.94, b * 0.94);
  hb_cren(x, 270 - 34 * s, 150 * s, r * 0.94, g * 0.94, b * 0.94);
  hb_twr(x - 8 * s, 270, 24 * s, 56 * s, r, g, b);
  hb_twr(x + 132 * s, 270, 24 * s, 52 * s, r, g, b);
  hb_twr(x + 58 * s, 270, 38 * s, 84 * s, r, g, b);
);
function hb_cath(x, s, r, g, b, twin, ctr, sp) local(w)
(
  w = 150 * s;
  hb_b(x, 270 - 42 * s, w, 42 * s, r, g, b);
  hb_tint(r * 0.62, g * 0.62, b * 0.66, 1); gfx_triangle(x, 270 - 42 * s, x + w, 270 - 42 * s, x + w, 270 - 54 * s, x, 270 - 54 * s);
  hb_win(x + 10 * s, 270 - 36 * s, w - 20 * s, 22 * s, 9, 1, r * 0.34, g * 0.36, b * 0.46);
  twin ? (
    hb_b(x - 6 * s, 270 - 88 * s, 18 * s, 88 * s, r, g, b); hb_b(x + 18 * s, 270 - 88 * s, 18 * s, 88 * s, r, g, b);
    hb_win(x - 2 * s, 270 - 80 * s, 10 * s, 44 * s, 1, 3, r * 0.34, g * 0.36, b * 0.46); hb_win(x + 22 * s, 270 - 80 * s, 10 * s, 44 * s, 1, 3, r * 0.34, g * 0.36, b * 0.46);
    twin == 2 ? ( hb_spire(x - 6 * s, 270 - 88 * s, 18 * s, 26 * s, r * 0.5, g * 0.5, b * 0.56); hb_spire(x + 18 * s, 270 - 88 * s, 18 * s, 26 * s, r * 0.5, g * 0.5, b * 0.56); );
  );
  ctr ? (
    hb_b(x + 76 * s, 270 - ctr * s, 28 * s, ctr * s, r, g, b);
    hb_win(x + 82 * s, 270 - (ctr - 8) * s, 16 * s, 36 * s, 1, 2, r * 0.34, g * 0.36, b * 0.46);
    sp ? hb_spire(x + 76 * s, 270 - ctr * s, 28 * s, sp * s, r * 0.82, g * 0.82, b * 0.84) : hb_cren(x + 75 * s, 270 - ctr * s, 30 * s, r, g, b);
  );
);
function hb_church(x, s, r, g, b, sp)
(
  hb_b(x + 26 * s, 270 - 24 * s, 54 * s, 24 * s, r, g, b);
  hb_tint(r * 0.5, g * 0.42, b * 0.4, 1); gfx_triangle(x + 24 * s, 270 - 24 * s, x + 82 * s, 270 - 24 * s, x + 53 * s, 270 - 38 * s);
  hb_b(x, 270 - 56 * s, 26 * s, 56 * s, r, g, b);
  sp ? hb_spire(x, 270 - 56 * s, 26 * s, sp * s, r * 0.56, g * 0.56, b * 0.6) : hb_cren(x, 270 - 56 * s, 26 * s, r, g, b);
);
function hb_hs(x, n, base, r, g, b, rr, rg, rb) local(i, h, w)
(
  i = 0;
  loop(n,
    w = 24 + hash(x + i) * 12; h = 16 + hash(x * 2 + i) * 12;
    hb_b(x, base - h, w, h, r, g, b);
    hb_tint(rr, rg, rb, 1); gfx_triangle(x - 2, base - h, x + w + 2, base - h, x + w * 0.5, base - h - 11);
    hb_win(x + 3, base - h + 3, w - 6, h - 7, 2, 1, 0.2, 0.22, 0.26);
    x += w;
    i += 1;
  );
);
function hb_hill(x, w, h, r, g, b) local(i, n, a0, a1)
(
  n = 28; i = 0;
  hb_tint(r, g, b, 1);
  loop(n,
    a0 = i / n * $pi; a1 = (i + 1) / n * $pi;
    gfx_triangle(x + w * i / n, 276, x + w * (i + 1) / n, 276, x + w * (i + 1) / n, 276 - sin(a1) * h, x + w * i / n, 276 - sin(a0) * h);
    i += 1;
  );
);
function hb_chim(x, h, r, g, b)
(
  hb_tint(r, g, b, 1); gfx_triangle(x, 270, x + 14, 270, x + 11, 270 - h, x + 3, 270 - h);
  hb_tint(r * 0.5, g * 0.5, b * 0.5, 1); gfx_rect(x + 2, 270 - h, 10, 4);
);
function hb_cool(x, s) local(i, n, a, b, w0, w1)
(
  n = 12; i = 0;
  loop(n,
    a = i / n; b = (i + 1) / n;
    w0 = (1 - 0.46 * sin(a * 2.2)) * 34 * s; w1 = (1 - 0.46 * sin(b * 2.2)) * 34 * s;
    hb_tint(0.74 - a * 0.08, 0.74 - a * 0.08, 0.72 - a * 0.08, 1);
    gfx_triangle(x - w0, 270 - a * 90 * s, x + w0, 270 - a * 90 * s, x + w1, 270 - b * 90 * s, x - w1, 270 - b * 90 * s);
    i += 1;
  );
  hb_tint(0.9, 0.9, 0.9, 0.5); gfx_circle(x + 8 * s, 270 - 104 * s, 13 * s, 1, 1); gfx_circle(x - 4 * s, 270 - 118 * s, 10 * s, 1, 1);
);
function hb_turb(x, base, h, a) local(i, q)
(
  hb_tint(0.88, 0.89, 0.9, 1);
  gfx_triangle(x - 2, base, x + 2, base, x + 0.6, base - h, x - 0.6, base - h);
