);

function hb_post() local(x, k, y, xs, k2, y2, xs2)
(
  x = g_rs_d * 100;
  k = hb_k(1150); y = hb_gy(1150); xs = hb_sxw(x, 1150);
  k2 = hb_k(-130); y2 = hb_gy(-130); xs2 = hb_sxw(x, -130);
  xs > -60 && xs < 960 ? (
    gfx_set(0.95, 0.95, 0.95, 0.75);
    gfx_triangle(sx(xs - 3), sy(y), sx(xs + 3), sy(y), sx(xs2 + 5), sy(y2), sx(xs2 - 5), sy(y2));
    gfx_set(0.95, 0.95, 0.92, 1); gfx_rect(sx(xs - 4 * k), sy(y - 260 * k), 8 * k * g_s, 260 * k * g_s);
    gfx_set(0.85, 0.12, 0.1, 1); gfx_circle(sx(xs), sy(y - 270 * k), 30 * k * g_s, 1, 1);
    gfx_set(1, 1, 1, 1); gfx_circle(sx(xs), sy(y - 270 * k), 14 * k * g_s, 1, 1);
  );
);

function hb_stalls() local(i, z, k, y, x, op)
(
  op = min(1, max(0, g_rs_pre2) * 3);
  i = 9;
  loop(10,
    z = 60 + i * 100; k = hb_k(z); y = hb_gy(z); x = hb_sxw(120, z);
    gfx_set(0.12 * g_hl_r, 0.34 * g_hl_g, 0.2 * g_hl_b, 1);
    gfx_rect(sx(x - 95 * k), sy(y - 220 * k), 190 * k * g_s, 26 * k * g_s);
    gfx_rect(sx(x - 95 * k), sy(y - 220 * k), 8 * k * g_s, 220 * k * g_s);
    gfx_rect(sx(x + 87 * k), sy(y - 220 * k), 8 * k * g_s, 220 * k * g_s);
    gfx_set(0.85, 0.82, 0.74, 1);
    font(9, 'b'); sprintf(#hr_tmp, "%d", 10 - i); txt_c(#hr_tmp, x - 16 * k, y - 216 * k, 32 * k, 18 * k);
    i -= 1;
  );
);

function hr_clods(dt) local(i, k, y, x)
(
  i = 0;
  loop(HNC,
    hk_l[i] > 0 ? (
      hk_l[i] -= dt;
      hk_vy[i] -= 900 * dt;
      hk_x[i] += hk_vx[i] * dt; hk_y[i] += hk_vy[i] * dt;
      hk_y[i] < 0 ? hk_l[i] = 0;
      k = hb_k(hk_z[i]); y = hb_gy(hk_z[i]) - hk_y[i] * k; x = hb_sxw(hk_x[i], hk_z[i]);
      hc_aw[rc_c] ? hf_rgb(0.2, 0.14, 0.09) : rc_going >= 4 ? hf_rgb(0.22, 0.16, 0.09) : hf_rgb(0.2, 0.3, 0.12);
      gfx_rect(sx(x), sy(y), max(1, 5 * k * g_s), max(1, 4 * k * g_s));
    );
    i += 1;
  );
);

function hr_clod(x, z) local(i)
(
  g_hk_i = (g_hk_i + 1) % HNC;
  i = g_hk_i;
  hk_x[i] = x; hk_z[i] = z; hk_y[i] = 4; hk_vx[i] = -g_hc_dir * 0 + (rand(1) - 0.5) * 120 - 600 * (g_hc_dirx); hk_vy[i] = 160 + rand(1) * 200; hk_l[i] = 0.6;
);

function hr_draw_runner(r) local(z, k, y, x, s0, q, sf, t, h, tx, px, py, ang)
(
  z = 60 + ru_lane[r] * 100; k = hb_k(z); y = hb_gy(z); x = hb_sxw(ru_s[r] * 100, z);
  (x > -220 && x < 1120) ? (
    hr_load(r);
    hr_jw = 0; hr_lift = 0; hr_pitch = 0; hr_limp = 0; hr_whip = 0; hr_jf = 0; hr_drv = 0;
    s0 = k * g_s;
    gfx_a = 1;
    hb_shadow(sx(x + g_hc_dir * -4 * k), sy(y + 2), s0);
    ru_fall[r] == 1 ? (
      t = ru_ftt[r] / 3.2;
      hr_lift = t < 0.3 ? 40 - t * 170 : -46 * min(1, (t - 0.3) * 4) * (t < 0.82 ? 1 : max(0, 1 - (t - 0.82) * 5));
      hr_pitch = t < 0.3 ? -t * 4 : t < 0.82 ? -1.2 + (t - 0.3) * 2.3 : 0;
      hr_limp = min(1, t * 3) * (t > 0.82 ? max(0, 1 - (t - 0.82) * 5) : 1);
      hr_view(g_hc_dir, 0.2, s0, sx(x), sy(y));
      hr_pose(0.35 + t * 0.3, 0, 2);
      hr_limp = 0; hr_lift = 0; hr_pitch = 0;
      t = ru_ftt[r];
      px = x + g_hc_dir * min(1.1, t) * 240 * k;
      py = y - (t < 0.9 ? 100 * sin(t / 0.9 * $pi) * k : 0) - 10 * k;
      hr_tumble(sx(px), sy(py), t < 1.1 ? t * 8 : 8.8, s0, g_hc_dir, 1);
    ) : ru_fall[r] == 2 ? (
      hr_view(g_hc_dir, 0.2, s0, sx(x), sy(y));
      hr_pose(ru_ph[r], 0, 2);
      t = g_rs_t;
      px = hb_sxw((ru_fx[r] + 4) * 100, 60 + ru_fz[r] * 100);
      hr_tumble(sx(px), sy(hb_gy(60 + ru_fz[r] * 100) - 8 * hb_k(60 + ru_fz[r] * 100)), 8.8, hb_k(60 + ru_fz[r] * 100) * g_s, g_hc_dir, 1);
    ) : (
      rc_nf > 0 ? (
        q = -1;
        ru_next[r] < rc_nf ? ( sf = hr_fenceat(ru_next[r]); (ru_s[r] > sf - 5) ? q = (ru_s[r] - (sf - 5)) / 10; );
        (q < 0 && ru_next[r] > 0) ? ( sf = hr_fenceat(ru_next[r] - 1); (ru_s[r] < sf + 5) ? q = (ru_s[r] - (sf - 5)) / 10; );
        q >= 0 && q <= 1 ? (
          hr_jf = q;
          hr_jw = min(1, sin($pi * q) * 1.7);
          hr_pitch = 0.34 * cos($pi * q) * hr_jw;
          sf = hr_fkind(q < 0.5 ? ru_next[r] : ru_next[r] - 1, rc_nf);
          hr_lift = (rc_j == 2 ? (sf == 5 ? 112 : sf == 3 ? 76 : 92) : 62) * sin($pi * q);
        );
      );
      hr_whip = ru_whip[r] > 0 ? 0.5 + 0.5 * sin(ru_whip[r] * 22) : 0;
      q = g_rs_d - ru_s[r];
      hr_drv = (r === g_hr_ride && g_rs_ride && g_rs_push) ? 1 : (q > 0 && q < 450) ? min(1, (450 - q) / 200) : 0;
      (g_rs_t < 1.3 && ru_v[r] > 0.2) ? hr_pitch += 0.16 * (1 - g_rs_t / 1.3);
      hr_view(g_hc_dir, 0.2, s0, floor(sx(x) + 0.5), floor(sy(y) + 0.5));
      g_rs_pre > 0 ? hr_pose(0.2, 1, 1) : hr_pose(ru_ph[r], 0, 1);
      k > 0.26 ? (
        font(max(8, 12 * k), 'b');
        gfx_set(0.08, 0.08, 0.1, 1);
        sprintf(#hr_tmp, "%d", r + 1);
        gfx_measurestr(#hr_tmp, tx, h);
        gfx_x = g_hf_nx - tx * 0.5; gfx_y = g_hf_ny - h * 0.5;
        gfx_drawstr(#hr_tmp);
      );
      (r === g_rs_follow) ? (
        gfx_set(1, 0.9, 0.35, 1);
        hf_pt(10, 244, 0);
        h = max(g_s * 0.62, s0) * 1.4; gfx_triangle(hr_px - 7 * h, hr_py - 12 * h, hr_px + 7 * h, hr_py - 12 * h, hr_px, hr_py);
      );
      ((ru_v[r] > (g_rs_t < 3 ? 2 : 8)) && hr_lift == 0) ? (
        rand(1) < (g_rs_t < 3 ? 0.9 : 0.25) ? ( g_hc_dirx = 1; hr_clod(ru_s[r] * 100 - 40, z + rand(30) - 15); );
        g_rs_t < 3 ? ( g_hc_dirx = 1; hr_clod(ru_s[r] * 100 - 70, z + rand(40) - 20); );
      );
    );
  );
);

function hr_tk_fit(x0, y0, w, h) local(i, a, b, c, d, k, tx, ty)
(
  hr_geom(rc_c);
  a = 1000000; b = -1000000; c = 1000000; d = -1000000; i = 0;
  loop(g_gp_n, a = min(a, gp_x[i]); b = max(b, gp_x[i]); c = min(c, gp_y[i]); d = max(d, gp_y[i]); i += 1; );
  tx = hg_tx[rc_c]; ty = hg_ty[rc_c];
  (tx !== 0 || ty !== 0) ? ( a = min(a, tx); b = max(b, tx); c = min(c, ty); d = max(d, ty); );
  k = min(w / max(1, b - a), h / max(1, d - c));
  g_tf_k = k; g_tf_x = x0 + (w - (b - a) * k) * 0.5 - a * k; g_tf_y = y0 + (h - (d - c) * k) * 0.5 + d * k;
);
function hr_tfx(v) ( sx(g_tf_x + v * g_tf_k); );
function hr_tfy(v) ( sy(g_tf_y - v * g_tf_k); );
function hr_tk_seg(x0, y0, x1, y1) local(dx, dy, d, nx, ny, o)
(
  dx = x1 - x0; dy = y1 - y0; d = sqrt(dx * dx + dy * dy);
  d > 0.001 ? (
    o = 0.45 * g_s; nx = -dy / d * o; ny = dx / d * o;
    gfx_line(x0 + nx, y0 + ny, x1 + nx, y1 + ny, 1);
    gfx_line(x0 - nx, y0 - ny, x1 - nx, y1 - ny, 1);
  );
);
function hr_tk_draw(cr, cg, cb) local(i, x, y, a, b)
(
  gfx_set(cr, cg, cb, 1); gfx_a = 1;
  x = hr_tfx(gp_x[0]); y = hr_tfy(gp_y[0]);
  i = 1;
  loop(g_gp_n - 1,
    a = hr_tfx(gp_x[i]); b = hr_tfy(gp_y[i]);
    hr_tk_seg(x, y, a, b);
    x = a; y = b; i += 1;
  );
  (hg_tx[rc_c] !== 0 || hg_ty[rc_c] !== 0) ? hr_tk_seg(hr_tfx(gp_x[0]), hr_tfy(gp_y[0]), hr_tfx(hg_tx[rc_c]), hr_tfy(hg_ty[rc_c]));
  gfx_set(0.95, 0.16, 0.13, 1); gfx_circle(hr_tfx(gp_x[0]), hr_tfy(gp_y[0]), 2.6 * g_s, 1, 1);
);
function hr_map() local(i, k)
(
  gfx_set(0, 0, 0, 0.42); gfx_rect(sx(14), sy(60), 154 * g_s, 86 * g_s);
  hr_tk_fit(24, 66, 134, 56);
  hr_tk_draw(0.9, 0.9, 0.86);
  i = g_hr_rn - 1;
  loop(g_hr_rn,
    k = hr_tki(g_rs_d - ru_s[i]);
    i === g_rs_follow ? gfx_set(1, 0.9, 0.3, 1) : gfx_set(hrc_r[ru_s1[i]], hrc_g[ru_s1[i]], hrc_b[ru_s1[i]], 1);
    ru_fall[i] !== 1 ? gfx_circle(hr_tfx(tk_x[k]), hr_tfy(tk_y[k]), (i === g_rs_follow ? 3.6 : 2.6) * g_s, 1, 1);
    i -= 1;
  );
  font(9, 0); gfx_set(0.85, 0.87, 0.82, 1);
  sprintf(#hr_tmp, "%s, %s-handed", hc_n[rc_c], hc_l[rc_c] ? "left" : "right");
  txt_c(#hr_tmp, 14, 126, 154, 18);
);

function hr_swatch(r, x, y, sz) local(a, b)
(
  a = ru_s1[r]; b = ru_s2[r];
  gfx_set(hrc_r[a], hrc_g[a], hrc_b[a], 1); gfx_rect(sx(x), sy(y), sz * g_s, sz * g_s);
  gfx_set(hrc_r[b], hrc_g[b], hrc_b[b], 1);
  ru_pat[r] == 1 ? ( gfx_rect(sx(x), sy(y + sz * 0.3), sz * g_s, sz * 0.2 * g_s); gfx_rect(sx(x), sy(y + sz * 0.7), sz * g_s, sz * 0.2 * g_s); ) :
  ru_pat[r] == 2 ? ( gfx_rect(sx(x + sz * 0.3), sy(y), sz * 0.2 * g_s, sz * g_s); gfx_rect(sx(x + sz * 0.7), sy(y), sz * 0.2 * g_s, sz * g_s); ) :
  ru_pat[r] == 4 ? ( gfx_rect(sx(x), sy(y), sz * 0.5 * g_s, sz * 0.5 * g_s); gfx_rect(sx(x + sz * 0.5), sy(y + sz * 0.5), sz * 0.5 * g_s, sz * 0.5 * g_s); ) :
  gfx_rect(sx(x + sz * 0.25), sy(y + sz * 0.25), sz * 0.5 * g_s, sz * 0.5 * g_s);
  gfx_set(0, 0, 0, 0.6); gfx_a = 1; gfx_rect(sx(x), sy(y), sz * g_s, sz * g_s, 0);
);

function hr_weather() local(i, x, y, n)
(
  g_rs_wx == 3 || g_rs_wx == 4 ? (
    n = g_rs_wx == 3 ? 70 : 170;
    gfx_set(0.78, 0.82, 0.92, 0.45);
    i = 0;
    loop(n, x = (hash(i) * 2000 - g_t * 240) % 900; x < 0 ? x += 900; y = (hash(i * 3) * 2000 + g_t * 900) % 700; gfx_line(sx(x), sy(y), sx(x - 3), sy(y + 16)); i += 1; );
  ) : g_rs_wx == 6 ? (
    gfx_set(0.95, 0.96, 1, 0.8);
    i = 0;
    loop(110, x = (hash(i) * 2000 + g_t * 70 + 30 * sin(g_t + i)) % 900; y = (hash(i * 3) * 2000 + g_t * 110) % 700; gfx_circle(sx(x), sy(y), 1.6 * g_s, 1, 1); i += 1; );
  ) : g_rs_wx == 5 ? (
    gfx_set(0.72, 0.74, 0.76, 0.26); gfx_rect(sx(0), sy(200), 900 * g_s, 280 * g_s);
    gfx_set(0.72, 0.74, 0.76, 0.2); gfx_rect(sx(0), sy(330), 900 * g_s, 120 * g_s);
  );
);

function hr_sky() local(x, y, i, a, n, p)
(
  p = g_hc_x * 0.04 + g_hb_rot;
  (g_rs_wx <= 3 && g_rs_light !== 2) ? (
    (!g_bd_on && g_t > g_bd_next && g_hc_dx > 0) ? (
      g_bd_on = 1; g_bd_t0 = g_t; g_bd_p0 = p; g_bd_y = 200 + rand(130); g_bd_n = 3 + floor(rand(6)); g_bd_f = rand(1) < 0.5 ? 10 : -10;
    );
    g_bd_on ? (
      x = 970 - (p - g_bd_p0) + (g_t - g_bd_t0) * g_bd_f;
      (x < -90 || x > 1000 || g_t - g_bd_t0 > 40) ? ( g_bd_on = 0; g_bd_next = g_t + 25 + rand(40); ) : (
        gfx_set(0.16, 0.16, 0.2, 1);
        i = 0;
        loop(g_bd_n,
          n = x + abs(i - g_bd_n * 0.5) * 12 + hash(i) * 4;
          y = g_bd_y + abs(i - g_bd_n * 0.5) * 5 + hash(i * 2) * 5;
          a = sin(g_t * 7 + i * 1.9) * 2;
          gfx_line(sx(n - 4), sy(y - a), sx(n), sy(y)); gfx_line(sx(n), sy(y), sx(n + 4), sy(y - a));
          i += 1;
        );
      );
    );
  );
);

function hr_race_scene() local(wa, wx, wy, c, i, j, k, x, z, f, sf, xs, dt)
(
  wa = 20 * max(0, g_hc_z - 0.35) ^ 1.5;
  wx = wa * (0.6 * sin(g_t * 1.13) + 0.4 * sin(g_t * 2.37 + 1.1));
  wy = wa * 0.6 * (0.6 * sin(g_t * 1.61 + 0.7) + 0.4 * sin(g_t * 2.93));
  g_wb_jx += (rand(2) - 1 - g_wb_jx) * 0.55; g_wb_jy += (rand(2) - 1 - g_wb_jy) * 0.55;
  wa = min(3.4, 7 * max(0, g_hc_z - 0.3) ^ 1.3) * min(1, abs(g_hc_vc) / 1200);
  wx += g_wb_jx * wa * 0.7; wy += g_wb_jy * wa;
  g_hc_x += wx / g_hc_z; g_hc_hy += wy;
  gfx_mode = 0; gfx_a = 1;
  gfx_gradrect(sx(0), sy(0), 900 * g_s, 470 * g_s, g_sk_r0, g_sk_g0, g_sk_b0, 1, 0, 0, 0, 0, (g_sk_r1 - g_sk_r0) / (470 * g_s), (g_sk_g1 - g_sk_g0) / (470 * g_s), (g_sk_b1 - g_sk_b0) / (470 * g_s), 0);
  c = (g_hc_x - g_rs_d * 100) * g_hc_dir;
  i = g_rs_d - g_hc_x / 100;
  j = i < 0 ? 0 : i / 10; k = hr_tki(j * 10);
  g_hb_rot = -(tk_t[k] + (tk_t[min(g_tk_n - 1, k + 1)] - tk_t[k]) * (j - floor(j))) * 286.5;
  hr_sky();
  hb_layer(IMG_HRF1, 0.012, c, 140, 1);
  hb_layer(IMG_HRF2, 0.03, c, 148, 1);
  hb_layer(IMG_HRF3, 0.09, c, 158, 1);
  x = 450 + (g_rs_d * 100 - g_hc_x) * g_hc_dir * 0.3 - 900;
  (x > -1800 && x < 900) ? ( i = max(0, -x); j = max(0, x); k = min(1800 - i, 900 - j); gfx_blit(IMG_HRF4, 1, 0, i, 0, k, 300, sx(j), sy(158), k * g_s, 300 * g_s); );
  hf_rgb(0.22, 0.38, 0.17); gfx_rect(sx(0), sy(450), 900 * g_s, 60 * g_s);
  hb_draw_ground();
  hb_furlongs();
  hb_rail(1150, 105, 300);
  rc_nf > 0 ? (
    f = 0;
    loop(rc_nf,
      sf = hr_fenceat(f) * 100;
      xs = hb_sxw(sf, 500);
      (xs > -500 && xs < 1400) ? (rc_j == 2 ? hb_fence(sf, -60, 1100, hr_fkind(f, rc_nf)) : hb_hurdle(sf, -60, 1100));
      f += 1;
    );
  );
  hb_post();
  i = 0;
  loop(g_hr_rn, ru_lz_o[i] = i; i += 1; );
  i = 0;
  loop(g_hr_rn - 1, j = i + 1; loop(g_hr_rn - 1 - i, ru_lane[ru_lz_o[j]] > ru_lane[ru_lz_o[i]] ? ( k = ru_lz_o[i]; ru_lz_o[i] = ru_lz_o[j]; ru_lz_o[j] = k; ); j += 1; ); i += 1; );
  (g_rs_pre > 0 || g_rs_t < 2.5) && !rc_j ? hb_stalls();
  i = 0;
  loop(g_hr_rn, hr_draw_runner(ru_lz_o[i]); i += 1; );
  hr_clods(g_dt);
  hb_rail(-130, 120, 300);
  hr_weather();
  g_hc_x -= wx / g_hc_z; g_hc_hy -= wy;
);
ru_lz_o = alloc(NR);
hr_ph_o = alloc(NR);

IMG_HRP = 43;
function hr_photo_draw(x0, y0, w, h) local(i, j, k, r, t0, x, sc, cnt, y, s0, ox, oy, dst, fit, span, bw, bh)
(
  s0 = g_s; ox = g_ox; oy = g_oy; dst = gfx_dest;
  bw = ceil(w * s0); bh = ceil(h * s0);
  gfx_setimgdim(IMG_HRP, bw, bh);
  gfx_dest = IMG_HRP; gfx_mode = 0; gfx_a = 1;
  g_ox = -x0 * s0; g_oy = -y0 * s0;
  gfx_set(0.82, 0.8, 0.72, 1); gfx_rect(0, 0, bw, bh);
  gfx_set(0.7, 0.68, 0.6, 1); gfx_rect(0, h * 0.68 * s0, bw, h * 0.32 * s0 + 1);
  g_hf_gray = 1;
  t0 = ru_ft[ru_ord[0]];
  cnt = min(4, g_rs_fin);
  fit = 0.95;
  span = (ru_ft[ru_ord[cnt - 1]] - t0) * 1600;
  span > 0 ? fit = min(0.95, w * 0.56 / span);
  sc = max(0.5, fit);
  i = 0; loop(cnt, hr_ph_o[i] = ru_ord[i]; i += 1; );
  i = 0;
  loop(cnt - 1, j = i + 1; loop(cnt - 1 - i, ru_lane[hr_ph_o[j]] > ru_lane[hr_ph_o[i]] ? ( k = hr_ph_o[i]; hr_ph_o[i] = hr_ph_o[j]; hr_ph_o[j] = k; ); j += 1; ); i += 1; );
  i = 0;
  loop(cnt,
    r = hr_ph_o[i];
    hr_load(r);
