    loop(NOD, hod_d[j] <= q + 1 ? o = j; j += 1; );
    ru_odd[k] = o;
    ru_bet[k] = 0; ru_ew[k] = 0;
    k += 1;
  );
);

NTK = 1000; HR_NGP = 400; g_gp_c = -1;
tk_x = alloc(NTK); tk_y = alloc(NTK); tk_k = alloc(NTK); tk_t = alloc(NTK); tk_h = alloc(NTK); fz = alloc(44);
gp_x = alloc(HR_NGP); gp_y = alloc(HR_NGP);
function hr_geom(c) local(p, n, ch, v, neg, have, odd, s0)
(
  c !== g_gp_c ? (
    g_gp_c = c; s0 = hg_s[c]; p = 0; n = 0; v = 0; neg = 0; have = 0; odd = 0;
    while (p <= strlen(s0)) (
      ch = p < strlen(s0) ? str_getchar(s0, p) : 32;
      ch == 45 ? neg = 1 : ch == 32 ? (
        have ? (
          odd ? ( gp_y[n] = neg ? -v : v; n += 1; ) : gp_x[n] = neg ? -v : v;
          odd = !odd;
        );
        v = 0; neg = 0; have = 0;
      ) : ( v = v * 10 + ch - 48; have = 1; );
      p += 1;
    );
    g_gp_n = n;
  );
);
function hr_track(c, f) local(dst, n, i, j, x, y, ax, ay, bx, by, d, rem, sp, q, tt, a0, a1, k, st, t0)
(
  hr_geom(c);
  dst = f * 201.168; sp = hc_spur[c] * 201.168;
  n = floor(min(NTK - 2, max(dst, hc_lap[c] * 201.168) / 10 + 3));
  g_tk_chute = (sp > 0 && dst <= sp + 20);
  g_tk_open = !hg_cl[c];
  g_tk_n = n;
  g_tk_chute ? (
    ax = hg_tx[c]; ay = hg_ty[c];
    (ax === 0 && ay === 0) ? ( ax = gp_x[1] - gp_x[0]; ay = gp_y[1] - gp_y[0]; );
    d = sqrt(ax * ax + ay * ay); d < 1 ? d = 1;
    i = 0;
    loop(n, tk_x[i] = gp_x[0] + ax / d * 10 * i; tk_y[i] = gp_y[0] + ay / d * 10 * i; tk_k[i] = 0; tk_t[i] = 0; i += 1; );
    g_tk_s = dst; g_tk_hasb = 0;
  ) : (
    j = 0; x = gp_x[0]; y = gp_y[0]; i = 0;
    loop(n,
      tk_x[i] = x; tk_y[i] = y;
      rem = 10;
      while (rem > 0) (
        j >= g_gp_n - 1 ? (
          hg_cl[c] ? ( j = hg_rn[c]; x = gp_x[j]; y = gp_y[j]; ) : (
            bx = gp_x[g_gp_n - 1] - gp_x[g_gp_n - 2]; by = gp_y[g_gp_n - 1] - gp_y[g_gp_n - 2]; d = max(1, sqrt(bx * bx + by * by));
            x += bx / d * rem; y += by / d * rem; rem = 0;
          );
        );
        rem > 0 ? (
          bx = gp_x[j + 1] - x; by = gp_y[j + 1] - y; d = sqrt(bx * bx + by * by);
          d <= rem ? ( x = gp_x[j + 1]; y = gp_y[j + 1]; j += 1; rem -= max(d, 0.01); ) : ( x += bx / d * rem; y += by / d * rem; rem = 0; );
        );
      );
      i += 1;
    );
    i = 0; loop(n - 1, tk_h[i] = atan2(tk_y[i + 1] - tk_y[i], tk_x[i + 1] - tk_x[i]); i += 1; ); tk_h[n - 1] = tk_h[n - 2];
    tt = 0; st = -1; i = 0;
    loop(n,
      a0 = tk_h[max(0, i - 5)]; a1 = tk_h[min(n - 1, i + 5)];
      q = a1 - a0; q > $pi ? q -= 2 * $pi : q < -$pi ? q += 2 * $pi;
      k = abs(q) / 100;
      k < 0.0012 ? k = 0;
      tk_k[i] = k; tk_t[i] = tt; tt += k * 10;
      (k > 0 && st < 0) ? st = i * 10;
      i += 1;
    );
    g_tk_s = st < 0 ? dst : max(100, hc_st[c] > 0 ? hc_st[c] * 201.168 : st);
    g_tk_hasb = dst > g_tk_s + 60;
  );
);
function hr_tki(left) ( max(0, min(g_tk_n - 1, floor(left / 10))); );
function hr_fence_build(n) local(i, j, left, tot, u, run, D, q, gp, m)
(
  D = g_rs_d; run = max(1, hc_run[rc_c]) * 201.168;
  rc_j == 2 && g_hr_gn ? run = 2.2 * 201.168;
  tot = 0; left = run;
  while (left < D - 100) ( q = tk_k[hr_tki(left)] + tk_k[hr_tki(left + 40)] + tk_k[hr_tki(left - 40)]; q == 0 ? tot += 10; left += 10; );
  gp = n > 1 ? tot / (n - 1) : tot;
  m = 0; u = 0; left = run;
  fz[n - 1] = D - run; j = n - 2;
  while (left < D - 100 && j >= 0) (
    q = tk_k[hr_tki(left)] + tk_k[hr_tki(left + 40)] + tk_k[hr_tki(left - 40)];
    q == 0 ? ( u += 10; u >= gp ? ( fz[j] = D - left; j -= 1; u -= gp; ); );
    left += 10;
  );
  while (j >= 0) ( fz[j] = 100 + j * 30; j -= 1; );
);
function hr_fenceat(k) ( fz[k]; );

function hr_rstart() local(i, j, ls, q, b)
(
  g_rs_rec = 0; g_rs_rn = 0; g_rs_rnext = 0; g_rs_fsaid = 0; g_rs_turn = 0;
  g_rs_t = 0; g_rs_on = 0; g_rs_fin = 0; g_rs_nf = 0; g_rs_lead = -1; g_rs_lsay = 0; g_rs_bendc = 0; g_rs_ph = 0; g_rs_2f = 0; g_rs_1f = 0; g_rs_home = 0;
  g_rs_d = rc_f * 201.168;
  g_rs_vb = (17.3 - 1.4 * log(rc_f / 5)) * (rc_going == 0 ? 1.01 : rc_going == 1 ? 1.005 : rc_going == 2 ? 1 : rc_going == 3 ? 0.987 : rc_going == 4 ? 0.97 : rc_going == 5 ? 0.945 : 0.998);
  rc_j == 2 ? g_rs_vb *= 0.95 : rc_j == 1 ? g_rs_vb *= 0.97;
  g_rs_up = hc_up[rc_c];
  g_rs_st = hc_st[rc_c] * 201.168;
  g_rs_lap = hc_lap[rc_c] * 201.168;
  g_hr_gn = strcmp(rc_name, "Grand National") == 0;
  hr_track(rc_c, rc_f);
  rc_nf > 0 ? ( g_rs_fgap = (g_rs_d - 260) / rc_nf; hr_fence_build(rc_nf); );
  hr_seed(rc_a * 3 + rc_c * 5 + rc_i * 7 + floor(time_precise() * 13) % 9973);
  i = 0;
  loop(g_hr_rn,
    ru_s[i] = 0; ru_v[i] = 0; ru_en[i] = 1; ru_ft[i] = 0; ru_fall[i] = 0; ru_ftt[i] = 0; ru_next[i] = 0; ru_err[i] = 0; ru_whip[i] = 0; ru_wn[i] = 0; ru_lift[i] = 0; ru_jq[i] = 0;
    ru_ph[i] = hr_r();
    ru_brk[i] = hr_r() * 0.22 + (hr_r() < 0.08 ? 0.35 : 0);
    ru_lane[i] = i * min(0.9, 9 / max(1, g_hr_rn - 1)) ;
    ru_lt[i] = ru_lane[i];
    ru_e[i] += hr_gauss() * 3.8;
    ru_ord[i] = i;
    i += 1;
  );
  g_rs_mid = 0; i = 0; loop(g_hr_rn, g_rs_mid += ru_e[i]; i += 1; ); g_rs_mid /= max(1, g_hr_rn);
  i = 0;
  loop(HNC, hk_l[i] = 0; i += 1; );
);



function hr_fkind(k, n) local(g)
(
  rc_j == 2 ? (
    g_hr_gn ? (
      g = k % 16;
      ((k == 14) ? 5 : (k == 15) ? 3 : (g == 5) ? 6 : (g == 7) ? 7 : 4);
    ) : (
      k == n - 1 ? 1 : (k % 7) == 4 ? 3 : (k % 4) == 1 ? 2 : 1;
    );
  ) : 0;
);
function hr_say(s) ( strcpy(#hr_sy, s); g_rs_sayt = g_rs_t; );

function hr_rec() local(i, p)
(
  while (g_rs_rec && g_rs_t >= g_rs_rnext && (g_rs_rn + 1) * g_hr_rn * RCF <= RCM) (
    p = hr_rc + g_rs_rn * g_hr_rn * RCF;
    i = 0;
    loop(g_hr_rn,
      p[0] = ru_s[i]; p[1] = ru_lane[i]; p[2] = ru_ph[i]; p[3] = ru_whip[i];
      p[4] = ru_fall[i] == 1 ? ru_ftt[i] + 0.001 : ru_fall[i] == 2 ? -1 : 0;
      p += RCF;
      i += 1;
    );
    g_rs_rn += 1;
    g_rs_rnext += RCDT;
  );
);

function hr_step(dt) local(i, j, left, vt, f, va, t, q, gap, b, dk, ls, inb, ds, bl, r, sf, u, cap)
(
  g_rs_t += dt;
  g_rs_on = 1;
  i = 0;
  loop(g_hr_rn,
    ru_fall[i] == 1 ? (
      ru_ftt[i] += dt;
      ru_v[i] = max(0, ru_v[i] - 16 * dt);
      ru_s[i] += ru_v[i] * dt;
      ru_ftt[i] > 3.2 ? ( ru_fall[i] = 2; ru_v[i] = 2; ru_lt[i] = 9.5; );
    ) : (
    left = g_rs_d - ru_s[i];
    va = g_rs_vb + (ru_e[i] - g_rs_mid) * 0.0085 + (g_rs_mid - 100) * 0.012;
    ru_fall[i] == 2 ? (
      vt = g_rs_vb * 0.93;
    ) : (
      dk = max(220, min(650, g_rs_d * 0.26 + ru_kick[i] * 0.8));
      left > dk ? (
        f = ru_tac[i] == 0 ? 1.016 : ru_tac[i] == 1 ? 1.006 : ru_tac[i] == 2 ? 0.998 : 0.99;
      ) : (
        t = max(0.5, left / max(8, va));
        q = ru_en[i] * (g_rs_d / va) / t;
        f = q > 0.01 ? q ^ 0.16667 : 0.9;
        f = min(1.018 + ru_kick[i] * 0.00045, f);
        f = max(0.93, f);
      );
      ru_en[i] <= 0 ? f = 0.905;
      (i === g_hr_ride && g_rs_ride) ? (
        f = g_rs_push ? 1.05 : left > dk ? 0.99 : 1;
        ru_en[i] <= 0 ? f = 0.9;
        ru_whip[i] > 0 && ru_en[i] > 0 ? f += 0.012;
      );
      ru_whip[i] > 0 ? ru_whip[i] -= dt;
      ru_err[i] > 0 ? ( ru_err[i] -= dt; f -= 0.1; );
      vt = f * va;
      left < 0 ? vt = 9;
      (g_rs_up && left < 200 && left > 0) ? vt *= 0.992 - 0.014 * (1 - max(0, ru_en[i]));
    );
    bl = 0; gap = 99;
    j = 0;
    loop(g_hr_rn,
      (j !== i && ru_fall[j] !== 1 && abs(ru_lane[j] - ru_lane[i]) < 0.78) ? (
        q = ru_s[j] - ru_s[i];
        q > 0.2 && q < gap ? ( gap = q; bl = j + 1; );
      );
      j += 1;
    );
    (bl && gap < 2.8 && left > -2) ? (
      vt = min(vt, ru_v[bl - 1] + (gap - 2.4) * 2);
      (i !== g_hr_ride || !g_rs_ride) ? (
        ((left < dk * 1.1 || ru_tac[i] < 2) && hr_r() < dt * 2) ? ru_lt[i] = min(9.5, ru_lane[i] + 1.05);
      );
    ) : (
      (i !== g_hr_ride || !g_rs_ride) && ru_fall[i] !== 2 && ru_lt[i] > 0.1 && left > dk * 0.8 ? (
        cap = 0; j = 0;
        loop(g_hr_rn, (j !== i && ru_lane[j] < ru_lane[i] && ru_lane[j] > ru_lane[i] - 1.1 && abs(ru_s[j] - ru_s[i]) < 5) ? cap = 1; j += 1; );
        !cap && hr_r() < dt * 0.9 ? ru_lt[i] = max(0, ru_lane[i] - 1);
      );
    );
    g_rs_t < ru_brk[i] ? vt = 0;
    ru_v[i] += min((ru_v[i] < 12 ? 14 : 6.5) * dt, max(-5 * dt, vt - ru_v[i]));
    u = ru_v[i] * dt;
    tk_k[hr_tki(left)] > 0 ? u *= 1 - ru_lane[i] * 0.0035;
    ru_s[i] += u;
    (ru_fall[i] !== 2 && ru_ft[i] <= 0) ? (
      q = ru_v[i] / max(1, va);
      q = q * q * q; q = q * q;
      bl && gap < 6 ? q *= 0.94;
      ru_en[i] -= q * dt * va / g_rs_d * (rc_f > 16 ? 1 : 1);
    );
    ru_lane[i] += max(-0.75 * dt, min(0.75 * dt, ru_lt[i] - ru_lane[i]));
    ru_ph[i] += dt * (ru_v[i] > 0.2 ? max(ru_v[i] / 7.1, 2) : 0); ru_ph[i] -= floor(ru_ph[i]);
    rc_nf > 0 && ru_next[i] < rc_nf ? (
      sf = hr_fenceat(ru_next[i]);
      ru_s[i] >= sf ? (
        ru_next[i] += 1;
        ru_fall[i] !== 2 ? (
          q = (rc_j == 2 ? 0.0024 : 0.0014) * (1.6 - ru_jump[i] / 100) * (1 + (1 - max(0, ru_en[i])) * 1.5) * (rc_going >= 4 ? 1.25 : 1);
          g_hr_gn ? q *= 4.5;
          b = hr_fkind(ru_next[i] - 1, rc_nf);
          q *= b == 2 ? 1.25 : b == 3 ? 0.7 : b == 5 ? 1.7 : b == 6 ? 1.5 : b == 7 ? 1.25 : 1;
          (i === g_hr_ride && g_rs_ride) ? (
            abs(g_rs_jclk - ru_s[i]) < 3.5 ? q *= 0.2 : q *= 1.4;
            abs(g_rs_jclk - ru_s[i]) >= 3.5 ? ru_err[i] = 0.6;
          );
          hr_r() < q ? (
            ru_fall[i] = 1; ru_ftt[i] = 0; ru_fx[i] = ru_s[i]; ru_fz[i] = ru_lane[i];
            g_rs_nf += 1;
            sprintf(#hr_sy2, "%s %s at the fence!", ru_nm[i], hr_r() < 0.5 ? "falls" : "comes down");
            hr_say(#hr_sy2);
