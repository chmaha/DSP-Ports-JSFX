function hr_today() local(t, z, era, doe, yoe, y, doy, mp, d, m)
(
  t = floor(time() / 86400); z = t + 719468; era = floor(z / 146097); doe = z - era * 146097;
  yoe = floor((doe - floor(doe / 1460) + floor(doe / 36524) - floor(doe / 146096)) / 365);
  y = yoe + era * 400; doy = doe - (365 * yoe + floor(yoe / 4) - floor(yoe / 100));
  mp = floor((5 * doy + 2) / 153); d = doy - floor((153 * mp + 2) / 5) + 1; m = mp < 10 ? mp + 3 : mp - 9;
  m <= 2 ? y += 1;
  y < CAL_Y0 ? 0 : hr_abs(y, m, d);
);
function hr_ycur() ( hr_date(hr_today()); g_hy; );
function hr_ystart() ( hr_abs(hr_ycur(), 1, 1); );

function hr_new_career(a0) local(s)
(
  memset(sv3, 0, NS3);
  memset(sv4, 0, 2000); memset(sv5, 0, HRNJ); g_hp_y = 0;
  sv3[14] = floor(time_precise()) % 9973;
  sv3[0] = 1; sv3[1] = a0; sv3[2] = 250000; sv3[3] = 1; sv3[4] = 3; sv3[5] = 1;
  s = floor(time_precise()) % 100000;
  hr_seed(s + 17);
  hr_date(sv3[1]);
  hr_new_horse(0, hr_ri(HRNN), g_hy - 3, 2, 0, 3, 72 + hr_r() * 10, 8, 60, 10, 0, 68);
  hr_new_horse(1, hr_ri(HRNN), g_hy - 5, 2, 1, 1, 104 + hr_r() * 8, 20, 50, 62, 1, 100);
  hs_p(0)[hs_runs] = 4; hs_p(1)[hs_runs] = 6;
  g_hr_cm = -1;
);
function hr_prize_of(pos) ( pos == 0 ? 0.57 : pos == 1 ? 0.22 : pos == 2 ? 0.11 : pos == 3 ? 0.05 : 0; );

function hr_payout() local(i, r, tot, od, st, pl, ret)
(
  tot = 0; i = 0;
  pl = g_hr_rn >= 16 ? 4 : g_hr_rn >= 8 ? 3 : g_hr_rn >= 5 ? 2 : 1;
  loop(g_hr_rn,
    st = ru_bet[i];
    st > 0 ? (
      od = hod_d[ru_odd[i]];
      r = ru_rank[i];
      ru_fall[i] ? 0 : ru_ew[i] ? (
        r == 0 ? tot += st * 0.5 * od;
        r < pl ? tot += st * 0.5 * (1 + (od - 1) * 0.2);
      ) : ( r == 0 ? tot += st * od; );
    );
    i += 1;
  );
  tot;
);

function hr_rival_prize(i, a) local(y0, d)
(
  hr_date(a); y0 = hr_abs(g_hy, 1, 1); d = a - y0 + 1;
  (900000 + 3400000 * hash(i * 3.7 + g_hy * 0.31) ^ 1.3) * d / 365;
);

function hr_apply_result(watched) local(i, r, p, pos, pr, mk, f, e, l, d, cost)
(
  g_hr_news_w = 0;
  i = 0;
  loop(g_hr_rn,
    ru_p[i] > 0 ? (
      p = sv4 + (ru_p[i] - 1) * 4;
      p[0] = rc_a; p[1] += 1;
      (ru_rank[i] == 0 && !ru_fall[i]) ? p[2] += 1;
    );
    (ru_rank[i] == 0 && !ru_fall[i]) ? sv5[ru_jk[i]] += 1;
    ru_own[i] ? (
      p = hs_p(ru_own[i] - 1);
      pos = ru_rank[i];
      pr = ru_fall[i] ? 0 : rc_p * hr_prize_of(pos);
      cost = hj_fee[ru_jk[i]];
      sv3[2] += pr * 0.82 - cost;
      sv3[7] += pr; sv3[10] += pr;
      p[hs_earn] += pr; p[hs_runs] += 1;
      p[hs_last] = rc_a;
      p[hs_form] = (p[hs_form] * 10 + (ru_fall[i] ? 0 : min(9, pos + 1))) % 1000000;
      p[hs_fit] = max(15, p[hs_fit] - 12 - rc_f * 0.5);
      pos < 3 && !ru_fall[i] ? p[hs_plc] += 1;
      pos == 0 && !ru_fall[i] ? (
        p[hs_wins] += 1; sv3[8] += 1; sv3[9] += 1;
        rc_gr == 1 ? ( sv3[11] += 1; p[hs_grp] += 1; );
        mk = strcmp(rc_name, "2000 Guineas") == 0 ? 1 : strcmp(rc_name, "1000 Guineas") == 0 ? 2 : strcmp(rc_name, "The Oaks") == 0 ? 4 : strcmp(rc_name, "The Derby") == 0 ? 8 : strcmp(rc_name, "St Leger") == 0 ? 16 : strcmp(rc_name, "Cheltenham Gold Cup") == 0 ? 32 : strcmp(rc_name, "Grand National") == 0 ? 64 : strcmp(rc_name, "Champion Hurdle") == 0 ? 128 : 0;
        sv3[12] |= mk;
        p[hs_or] += 4;
      ) : pos < 3 ? p[hs_or] += 1 : pos > g_hr_rn * 0.6 ? p[hs_or] -= 1;
      p[hs_or] = max(30, min(p[hs_type] ? 180 : 140, p[hs_or]));
      ru_fall[i] && rand(1) < 0.35 ? p[hs_inj] = 21 + floor(rand(1) * 60);
      (!ru_fall[i] && rand(1) < 0.012) ? p[hs_inj] = 14 + floor(rand(1) * 40);
      e = hr_entry_find(rc_a, rc_c, rc_i, ru_own[i] - 1);
      e >= 0 ? ( f = sv3 + HEB + e * 6; f[0] = 0; );
    );
    i += 1;
  );
);

function hr_nextday() local(a, e, f, h, p, ag, y, y0, dif, i, n, r)
(
  a = sv3[1];
  e = 0;
  loop(HEN,
    f = sv3 + HEB + e * 6;
    (f[0] > 0 && f[0] - 1 <= a) ? (
      f[0] - 1 < a ? f[0] = 0 : (
        hr_field(a, f[1], f[2]);
        hr_day(a);
        hr_setlight(a, f[1], rc_min);
        hr_abandon(a, f[1]) ? f[0] = 0 : (
          hr_headless();
          hr_apply_result(0);
        );
      );
    );
    e += 1;
  );
  a += 1;
  sv3[1] = a; sv3[6] = 0;
  hr_date(a - 1); y0 = g_hy;
  hr_date(a);
  g_hy !== y0 ? (
    n = 0; i = 0; loop(6, sv3[7] > hr_rival_prize(i, a - 1) ? n += 1; i += 1; );
    n == 6 ? sv3[13] += 1;
    sv3[7] = 0; sv3[8] = 0;
  );
  h = 0;
  loop(HSN,
    p = hs_p(h);
    p[hs_used] ? (
      sv3[2] -= 48;
      p[hs_inj] > 0 ? ( p[hs_inj] -= 1; p[hs_fit] = max(20, p[hs_fit] - 0.3); ) : (
        p[hs_tr] == 0 ? p[hs_fit] = min(82, p[hs_fit] + 1.2) :
        p[hs_tr] == 1 ? p[hs_fit] = min(90, p[hs_fit] + 1) :
        p[hs_tr] == 2 ? p[hs_fit] = min(97, p[hs_fit] + 0.9) :
        p[hs_tr] == 3 ? ( p[hs_fit] = min(100, p[hs_fit] + 1.1); rand(1) < 0.0035 ? p[hs_inj] = 10 + floor(rand(1) * 30); ) :
        ( p[hs_fit] = min(90, p[hs_fit] + 0.6); p[hs_jmp] = min(100, p[hs_jmp] + 0.3); );
      );
    );
    h += 1;
  );
  g_hr_cm = -1;
);

function hr_next_entry() local(a, e, f, b)
(
  a = 1000000000; e = 0;
  loop(HEN, f = sv3 + HEB + e * 6; f[0] > 0 ? a = min(a, f[0] - 1); e += 1; );
  a;
);

function hr_cal_month(y, m) local(i, a, n, j, b, bg)
(
  (g_hr_cy !== y || g_hr_cm !== m) ? (
