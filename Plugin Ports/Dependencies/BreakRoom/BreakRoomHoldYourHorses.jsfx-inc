HP = 500;
hp_nm = alloc(HP); hp_by = alloc(HP); hp_sx = alloc(HP); hp_coat = alloc(HP); hp_sock = alloc(HP); hp_blz = alloc(HP); hp_s1 = alloc(HP); hp_s2 = alloc(HP); hp_pat = alloc(HP); hp_pot = alloc(HP); hp_opt = alloc(HP); hp_kick = alloc(HP); hp_jmp = alloc(HP); hp_type = alloc(HP); hp_gpr = alloc(HP); hp_tac = alloc(HP); hp_jk = alloc(HP); hp_genr = alloc(HP); hp_scr = alloc(HP); hp_or = alloc(HP);
sv4 = alloc(HP * 4);
sv5 = alloc(HRNJ);
ru_p = alloc(NR);
function hp_year(y) local(i, ty, l, b0, g, q, u, st)
(
  (y !== g_hp_y || sv3[14] !== g_hp_w) ? (
    g_hp_y = y; g_hp_w = sv3[14];
    i = 0;
    loop(HP,
      ty = i >= 300;
      l = ty ? 8 : 5;
      b0 = 2020 + (i % l) - (ty ? 4 : 2);
      g = floor((y - b0 - (ty ? 4 : 2) + l * 100) / l) - 100 + 1;
      hr_seed(floor(hash(i * 1.371 + g * 0.733 + sv3[14] * 0.113 + 0.17) * 2147483000) + 1);
      hr_r(); hr_r();
      hp_genr[i] = g;
      hp_type[i] = ty;
      hp_by[i] = y - ((y - b0 - (ty ? 4 : 2) + l * 100) % l) - (ty ? 4 : 2);
      hp_nm[i] = (i * 283 + sv3[14] * 7) % HRNN;
      q = hr_r();
      hp_sx[i] = ty ? (q < 0.2 ? 1 : 2) : (q < 0.45 ? 1 : q < 0.8 ? 0 : 2);
      q = hr_r();
      hp_coat[i] = q < 0.42 ? 0 : q < 0.66 ? 1 : q < 0.76 ? 4 : q < 0.84 ? 2 : q < 0.97 ? 3 : 5;
      hp_sock[i] = hr_r() < 0.4 ? 1 + hr_ri(3) : 0; hp_blz[i] = hr_r() < 0.4;
      hp_s1[i] = hr_ri(14); hp_s2[i] = (hp_s1[i] + 1 + hr_ri(12)) % 14; hp_pat[i] = hr_ri(8);
      u = hr_r();
      hp_pot[i] = ty ? 82 + 86 * u * u : 46 + 82 * (u ^ 2.1);
      q = hr_r();
      hp_opt[i] = ty ? 16 + q * 16 : (q < 0.3 ? 5 + hr_r() * 2 : q < 0.65 ? 7 + hr_r() * 3 : q < 0.9 ? 10 + hr_r() * 4 : 14 + hr_r() * 6);
      hp_kick[i] = 35 + hr_r() * 65; hp_jmp[i] = ty ? 40 + hr_r() * 60 : hr_r() * 15; hp_gpr[i] = hr_ri(5); hp_tac[i] = hr_ri(4);
      u = ty ? (hp_pot[i] - 82) / 86 : (hp_pot[i] - 46) / 82;
      hp_jk[i] = (ty ? 60 : 0) + floor((1 - u) * (ty ? 39 : 59) * (0.35 + 0.65 * hr_r()));
      hp_scr[i] = hr_r();
      st = sv4 + i * 4;
      st[3] !== g + 1000 ? ( st[0] = -30; st[1] = 0; st[2] = 0; st[3] = g + 1000; );
      i += 1;
    );
  );
);
function hp_ab(i, y) local(ag, c)
(
  ag = y - hp_by[i];
  hp_type[i] ? ( c = ag <= 4 ? 0.9 : ag == 5 ? 0.95 : ag <= 9 ? 1 : ag == 10 ? 0.97 : 0.92; ) : ( c = ag <= 2 ? 0.88 : ag == 3 ? 1 : ag == 4 ? 1.01 : ag == 5 ? 1 : 0.97; );
  hp_pot[i] * c;
