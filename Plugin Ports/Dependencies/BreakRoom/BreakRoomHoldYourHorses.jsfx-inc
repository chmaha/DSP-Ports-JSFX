  loop(3,
    q = a + i * 2.094;
    gfx_triangle(x - 1, base - h, x + 1, base - h, x + cos(q) * h * 0.46, base - h + sin(q) * h * 0.46);
    i += 1;
  );
);
function hb_arch(x, n, w, h, r, g, b) local(i)
(
  hb_tint(r, g, b, 1); gfx_rect(x, 272 - h, n * w, h);
  hb_tint(r * 0.5, g * 0.5, b * 0.5, 1); gfx_rect(x, 272 - h, n * w, 2);
