function hp_rate(i, y) ( floor(hp_ab(i, y) - 2 + (hp_scr[i] - 0.5) * 8 + (sv4 + i * 4)[2] * 0 + 0.5); );
function hp_form(i, y, a) local(k, d, q, r, s0)
(
  strcpy(#hp_f, "");
  r = hp_type[i] ? (hp_pot[i] - 82) / 86 : (hp_pot[i] - 46) / 82;
  k = 0;
  loop(5,
    q = hash(i * 2.173 + floor(a / 12) * 0.917 + k * 5.31 + 0.3) ^ (0.7 + r * 1.8);
    d = 1 + floor(q * 9);
    hp_type[i] && hash(i * 3.71 + k * 7.13 + floor(a / 12) * 0.51) < 0.05 ? strcat(#hp_f, "F") : ( sprintf(#hp_t, "%d", d); strcat(#hp_f, #hp_t); );
    k += 1;
  );
  #hp_f;
);

function hr_field(a, c, i) local(n, k, e, f, p, q, base, top, w, ag, j, x, seed, tot, b, o, y0, need, picks)
(
  hr_mkrace(a, c, i);
  g_hr_rn = 0;
  seed = a * 131 + c * 1777 + i * 37 + 4091;
  n = 0;
  g_hr_mode == 0 ? (
    e = 0;
    loop(HEN,
      f = sv3 + HEB + e * 6;
      (f[0] > 0 && f[0] - 1 === a && f[1] === c && f[2] === i && n < rc_n) ? (
        p = hs_p(f[3]);
        ru_own[n] = f[3] + 1; ru_p[n] = 0;
        ru_nm[n] = hr_nm[p[hs_nm]];
        ru_ab[n] = hr_ab_of(p, a) * (0.92 + 0.08 * p[hs_fit] / 100);
        ru_or[n] = p[hs_or];
        ru_coat[n] = p[hs_coat]; ru_sock[n] = p[hs_blz] >> 1; ru_blz[n] = p[hs_blz] & 1;
        ru_s1[n] = sv3[3]; ru_s2[n] = sv3[4]; ru_pat[n] = sv3[5];
        ru_jk[n] = f[4]; ru_tac[n] = f[5];
        j = 0;
        while (j < n) ( ru_jk[j] === ru_jk[n] ? ( ru_jk[n] = (ru_jk[n] + 1) % HRNJ; j = 0; ) : j += 1; );
        ru_age[n] = hr_age(p, a);
        ru_kick[n] = p[hs_kick]; ru_jump[n] = p[hs_jmp]; ru_opt[n] = p[hs_opt];
        ru_form[n] = p[hs_form];
        ru_good[n] = p[hs_gpr];
        n += 1;
      );
      e += 1;
    );
  );
  hr_date(a); y0 = g_hy;
  hp_year(y0);
  hr_seed(seed);
  need = rc_n;
  picks = 0;
  while (n < need && picks < need + 2) (
    b = -1; base = -1000000; j = 0;
    loop(HP,
      w = hp_type[j] == (rc_j > 0);
      w && rc_j > 0 && rc_j < 3 && hp_jmp[j] < 20 ? w = 0;
      ag = y0 - hp_by[j];
      (ag < rc_a0 || (rc_a1 > 0 && ag > rc_a1)) ? w = 0;
      (rc_sx == 1 && hp_sx[j] !== 1) ? w = 0;
      (rc_j == 2 && ag < 5) ? w = 0;
      (w && g_hr_mode == 0 && a - (sv4 + j * 4)[0] < 7) ? w = 0;
      w ? (
        k = 0; while (k < n) ( ru_p[k] === j + 1 ? ( w = 0; k = n; ) : k += 1; );
      );
      w ? (
        q = hp_rate(j, y0);
        x = (rc_gr >= 1 && rc_gr <= 4) || rc_gr == 5 ? q : rc_mx > 200 ? -abs(q - (rc_j ? 100 : 70)) : (q > rc_mx ? rc_mx - q : q < rc_mn ? q - rc_mn : 0);
        x -= ((rc_f - hp_opt[j]) / hp_opt[j]) ^ 2 * 140;
        x += hash(j * 3.1 + seed * 0.0007 + n * 0.37) * ((rc_gr >= 1 && rc_gr <= 5) ? 10 : 24);
        x > base ? ( base = x; b = j; );
      );
      j += 1;
    );
    b < 0 ? picks = need + 2 : (
      j = b;
      ru_p[n] = j + 1;
      ru_own[n] = 0;
      ru_nm[n] = hr_nm[hp_nm[j]];
      ag = y0 - hp_by[j];
      ru_or[n] = hp_rate(j, y0) + (sv4 + j * 4)[2] * 2 - min((sv4 + j * 4)[1], 8) * 0;
      ru_ab[n] = hp_ab(j, y0);
      ru_coat[n] = hp_coat[j]; ru_sock[n] = hp_sock[j]; ru_blz[n] = hp_blz[j];
      ru_s1[n] = hp_s1[j]; ru_s2[n] = hp_s2[j]; ru_pat[n] = hp_pat[j];
      ru_jk[n] = hp_jk[j];
      k = 0;
      while (k < n) ( ru_jk[k] === ru_jk[n] ? ( ru_jk[n] = ru_jk[n] < 60 ? (ru_jk[n] + 1) % 60 : 60 + (ru_jk[n] - 59) % 40; k = 0; ) : k += 1; );
      ru_tac[n] = hp_tac[j];
      ru_age[n] = ag;
      ru_kick[n] = hp_kick[j]; ru_jump[n] = hp_jmp[j]; ru_opt[n] = hp_opt[j];
      ru_form[n] = j;
      ru_good[n] = hc_aw[c] ? 2 : hp_gpr[j];
      n += 1;
    );
    picks += 0;
  );
  g_hr_rn = n;
  top = 0; k = 0;
  loop(n, top = max(top, ru_or[k]); k += 1; );
  tot = 0; k = 0;
  loop(n,
    ru_wt[k] = rc_hc ? 136 - min(24, top - ru_or[k]) : rc_gr >= 1 && rc_gr <= 4 ? (rc_a0 >= 3 && ru_age[k] >= 4 ? 133 : 126) - (rc_sx ? 3 : 0) : 126;
    w = rc_hc ? ru_wt[k] - 126 : ru_wt[k] - 126;
    q = rc_hc ? ru_or[k] - 100 : 0;
    x = ru_ab[k] - w * (rc_hc ? 1 : 0.5);
    x -= ((rc_f - ru_opt[k]) / max(4, ru_opt[k])) ^ 2 * 70;
    x -= abs(min(rc_going, 5) - ru_good[k]) * (rc_going >= 6 ? 0 : 1.1);
    x += (hj_sk[ru_jk[k]] - 75) * 0.09;
