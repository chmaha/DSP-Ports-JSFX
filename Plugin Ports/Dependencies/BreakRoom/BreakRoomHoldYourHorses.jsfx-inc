  hr_rload();
);
function hr_pick(mode) local(a)
(
  a = sv2[62] ? hr_today() : hr_pickday();
  (sv2[62] && hr_day(a) == 0) ? ( g_hr_nrm = mode; g_hr_nra = a; ) : hr_begin(mode, a);
