function hr_sale_gen(m) local(i, q, jm)
(
  m !== g_hr_slm ? (
    g_hr_slm = m;
    hr_seed(m * 991 + 7);
    i = 0;
    loop(6,
      jm = hr_r() < 0.4;
      sl_nm[i] = hr_ri(HRNN);
      sl_age[i] = jm ? 4 + hr_ri(3) : 2 + hr_ri(3);
      sl_sex[i] = (q = hr_r()) < 0.4 ? 2 : q < 0.72 ? 0 : 1;
      jm && sl_sex[i] == 0 ? sl_sex[i] = 2;
      q = hr_r();
      sl_pot[i] = (jm ? 95 : 60) + q * q * 55;
      sl_or[i] = floor(sl_pot[i] - 6 + hr_gauss() * 3);
      sl_opt[i] = jm ? 16 + hr_ri(14) : 5 + hr_ri(11);
      sl_kick[i] = 40 + hr_r() * 60; sl_jmp[i] = jm ? 45 + hr_r() * 45 : hr_r() * 15;
      sl_coat[i] = hr_ri(5); sl_type[i] = jm;
      sl_val[i] = floor((sl_pot[i] - (jm ? 60 : 30)) ^ 2.1 * 8 * (0.8 + hr_r() * 0.5) / 100) * 100 + 3000;
      sl_sold[i] = 0;
      i += 1;
    );
    g_hr_ai = -1;
  );
);
