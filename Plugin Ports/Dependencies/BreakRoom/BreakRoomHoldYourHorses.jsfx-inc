function hr_m(s, x, y, sz) ( hr_t(s, x, y, sz, 0, 0.62, 0.7, 0.62); );

function hr_new_horse(h, nm, by, sex, coat, blz, pot, opt, kick, jmp, ty, orv) local(p)
(
  p = hs_p(h);
  memset(p, 0, HSF);
  p[hs_used] = 1; p[hs_nm] = nm; p[hs_by] = by; p[hs_sex] = sex; p[hs_coat] = coat; p[hs_blz] = blz; p[hs_pot] = pot; p[hs_opt] = opt; p[hs_kick] = kick; p[hs_jmp] = jmp; p[hs_type] = ty; p[hs_or] = orv;
