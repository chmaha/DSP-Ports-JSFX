hod(18, "11/2", 6.5); hod(19, "6/1", 7); hod(20, "13/2", 7.5); hod(21, "7/1", 8); hod(22, "15/2", 8.5); hod(23, "8/1", 9); hod(24, "9/1", 10); hod(25, "10/1", 11); hod(26, "12/1", 13); hod(27, "14/1", 15);
