        g_click = 0;
        (g_rs_camf && r === g_rs_follow) ? g_rs_camf = 0 : ( g_rs_follow = r; g_rs_camf = 1; );
      );
    );
    (g_rs_camf && r === g_rs_follow) ? ( gfx_set(0.95, 0.75, 0.25, 0.3); gfx_rect(sx(680), sy(left), 202 * g_s, k * g_s); );
    hr_swatch(r, 688, left + (k - 14) * 0.5, 14);
    font(10, r === g_rs_follow ? 'b' : 0); r === g_rs_follow ? gfx_set(1, 0.9, 0.4, 1) : ru_fall[r] ? gfx_set(0.6, 0.6, 0.6, 1) : gfx_set(0.95, 0.95, 0.9, 1);
    sprintf(#hr_tmp, "%d %s", r + 1, ru_nm[r]);
    txt_l(#hr_tmp, 708, left + (k - 20) * 0.5 + 2);
    i += 1;
  );
  gfx_set(0, 0, 0, 0.6); gfx_rect(sx(14), sy(14), 110 * g_s, 36 * g_s);
  left = g_rs_d - ru_s[ru_ord[0]];
  left > 0 ? (
    k = left / 201.168;
    k >= 8 ? sprintf(#hr_tmp, "%dm %.0ff", floor(k / 8), k - floor(k / 8) * 8) : sprintf(#hr_tmp, "%.1ff", k);
  ) : strcpy(#hr_tmp, "Finish!");
  font(14, 'b'); gfx_set(1, 0.92, 0.6, 1); txt_c(#hr_tmp, 14, 14, 110, 36);
  gfx_set(0, 0, 0, 0.6); gfx_rect(sx(0), sy(658), 900 * g_s, 42 * g_s);
  font(13, 'b'); gfx_set(1, 0.97, 0.88, 1);
  txt_c(#hr_sy, 10, 658, 880, 42);
);

function hr_camui()
(
  hr_btn("Field", 440, 48, 60, 28, g_rs_cam == 1) ? g_rs_cam = 1;
  hr_btn("Pack", 504, 48, 60, 28, g_rs_cam == 0) ? g_rs_cam = 0;
  hr_btn("Close", 568, 48, 60, 28, g_rs_cam == 2) ? g_rs_cam = 2;
  g_rs_ride ? (
    sprintf(#hr_tmp, "Riding %s", ru_nm[g_hr_ride]);
    font(11, 'b'); gfx_set(1, 0.9, 0.5, 1); txt_c(#hr_tmp, 440, 82, 232, 28);
  ) : (
    g_rs_camf ? sprintf(#hr_tmp, "Following %s", ru_nm[g_rs_follow]) : g_rs_follow >= 0 ? sprintf(#hr_tmp, "Follow %s", ru_nm[g_rs_follow]) : strcpy(#hr_tmp, "Follow the leader");
    hr_btn(#hr_tmp, 440, 82, 232, 28, g_rs_camf) ? (
      g_rs_camf ? g_rs_camf = 0 : ( g_rs_follow < 0 ? g_rs_follow = ru_ord[0]; g_rs_camf = 1; );
    );
  );
);

function hr_race() local(i, r, a, y0, t, left, k, st)
(
  g_rs_sdt += (min(0.1, g_dt) - g_rs_sdt) * 0.1;
  t = g_rs_sdt * g_rs_rate;
  g_rs_pre > 0 ? (
    g_rs_pre -= g_dt;
    g_rs_pre <= 0 ? (
      db_snd(0, 1500, 0.147, 0, 0); db_snd(0, 1500, 0.147, 0.18, 0);
      !rc_j ? db_snd(14, 26, 0.55, 0, 0);
      db_snd(14, 1.3, 0.18, 0.05, -0.4); db_snd(14, 1.3, 0.18, 0.08, 0.4);
    );
  ) : (
    g_rs_pre2 += g_dt;
    g_rs_ride ? (
      g_rs_push = g_mdown && g_my > 150;
      g_mdown && !g_rs_cl ? g_rs_jclk = ru_s[g_hr_ride];
      g_rs_cl = g_mdown;
      k = 60 + 9.5 * 100 * max(0, min(1, (640 - g_my) / 200));
      ru_lt[g_hr_ride] = max(0, min(9.5, (k - 60) / 100));
      g_rclick && ru_whip[g_hr_ride] <= 0 && ru_fall[g_hr_ride] == 0 ? (
        ru_wn[g_hr_ride] += 1;
        ru_wn[g_hr_ride] <= 7 ? ( ru_whip[g_hr_ride] = 1; db_snd(1, 900, 0.12, 0, 0); ) : (
          g_hr_mode == 0 ? sv3[2] -= 500;
          hr_say("Over the whip limit: the stewards fine you 500 pounds.");
        );
      );
    );
    k = max(1, ceil(t / 0.04));
    loop(k, hr_step(t / k); );
    hr_commentary();
    g_rs_hft += g_dt;
    g_rs_hft > 0.09 ? (
      g_rs_hft = 0;
      db_snd(7, 62 + rand(30), g_rs_t < 3 ? 0.24 : 0.13, rand(0.05), rand(1) - 0.5);
      left = g_rs_d - ru_s[ru_ord[0]];
      db_snd(14, 3.2, 0.012 + 0.07 * max(0, 1 - left / 500), 0, rand(1) - 0.5);
    );
  );
  hr_cam(g_rs_pre > 0 ? g_rs_sdt : t, g_rs_sdt);
  hr_race_scene();
  hr_hud();
  hr_camui();
  g_rs_ride ? (
    r = g_hr_ride;
    gfx_set(0, 0, 0, 0.42); gfx_rect(sx(176), sy(60), 200 * g_s, 56 * g_s);
    font(10, 'b'); gfx_set(1, 1, 0.9, 1); txt_l("Energy", 184, 66);
    gfx_set(0.2, 0.2, 0.2, 1); gfx_rect(sx(240), sy(70), 126 * g_s, 10 * g_s);
    ru_en[r] > 0.3 ? gfx_set(0.4, 0.85, 0.4, 1) : gfx_set(0.95, 0.45, 0.2, 1);
    gfx_rect(sx(240), sy(70), 126 * max(0, ru_en[r]) * g_s, 10 * g_s);
    sprintf(#hr_tmp, "Whip %d of 7   %s", ru_wn[r], g_rs_push ? "PUSHING" : "steady");
    txt_l(#hr_tmp, 184, 90);
  ) : (
    i = 0;
    a = g_rs_rate;
    hr_btn("x1", 440, 14, 40, 30, a == 1) ? g_rs_rate = 1;
    hr_btn("x2", 484, 14, 40, 30, a == 2) ? g_rs_rate = 2;
    hr_btn("x4", 528, 14, 40, 30, a == 4) ? g_rs_rate = 4;
    hr_btn("Result", 572, 14, 80, 30, 0) ? (
      while (g_rs_fin + g_rs_nf < g_hr_rn) ( hr_step(0.05); );
      g_rs_done = 99;
    );
  );
  button("Stop", 660, 14, 60, 30, 0.82, 0.68, 0.3) ? g_hr_v = g_hr_mode == 0 ? 1 : 0;
  hr_sound();
  (g_rs_fin + g_rs_nf >= g_hr_rn) ? g_rs_done += g_dt;
  (ru_ft[ru_ord[0]] > 0 && g_rs_done == 0 && ru_ft[ru_ord[1]] > 0 && g_rs_t - ru_ft[ru_ord[0]] > 7) ? g_rs_done = 2;
  g_rs_done >= 1.6 ? (
    while (g_rs_fin + g_rs_nf < g_hr_rn) ( hr_step(0.05); );
    hr_rankup();
    g_rs_paid = hr_payout();
    g_hr_mode == 0 ? sv3[2] += g_rs_paid : g_hr_bank += g_rs_paid;
    g_rs_marg = (ru_ft[ru_ord[1]] - ru_ft[ru_ord[0]]) * 16 / 2.4;
    g_rs_photo = g_rs_marg < 0.3 && g_rs_fin > 1;
    g_hr_mode == 0 ? hr_apply_result(1);
    g_hr_v = g_rs_photo ? 12 : 13;
    g_rs_pt = 0;
    g_rs_photo ? db_snd(13, 880, 0.15, 0, 0) : db_snd(0, 1200, 0.2, 0, 0);
  );
);

function hr_rp_stash() local(i)
(
  i = 0;
  loop(g_hr_rn,
    ru_ftf[i] = ru_ft[i]; ru_fallf[i] = ru_fall[i]; ru_sf[i] = ru_s[i]; ru_lanef[i] = ru_lane[i]; ru_fprev[i] = 0;
    i += 1;
  );
  g_rp_tf = g_rs_t;
);
function hr_rp_restore() local(i)
(
  i = 0;
  loop(g_hr_rn,
    ru_ft[i] = ru_ftf[i]; ru_fall[i] = ru_fallf[i]; ru_s[i] = ru_sf[i]; ru_lane[i] = ru_lanef[i]; ru_whip[i] = 0;
    i += 1;
  );
  g_rs_t = g_rp_tf;
  hr_rankup();
);
function hr_rp_apply(t) local(k, a, i, p, q, f, d, n)
(
  n = g_rs_rn;
  k = floor(t / RCDT);
  k = k < 0 ? 0 : k > n - 2 ? max(0, n - 2) : k;
  a = t / RCDT - k; a = a < 0 ? 0 : a > 1 ? 1 : a;
  p = hr_rc + k * g_hr_rn * RCF;
  q = n > 1 ? p + g_hr_rn * RCF : p;
  i = 0;
  loop(g_hr_rn,
    ru_s[i] = p[0] + (q[0] - p[0]) * a;
    ru_v[i] = (q[0] - p[0]) / RCDT;
    ru_lane[i] = p[1] + (q[1] - p[1]) * a;
    d = q[2] - p[2]; d < 0 ? d += 1;
    f = p[2] + d * a; ru_ph[i] = f - floor(f);
    ru_whip[i] = p[3];
    f = a < 0.5 ? p[4] : q[4];
    f > 0 ? ( ru_fall[i] = 1; ru_ftt[i] = p[4] > 0 ? p[4] + (q[4] - p[4]) * a : f; ) : f < 0 ? ru_fall[i] = 2 : ru_fall[i] = 0;
    ru_ft[i] = ru_s[i] >= g_rs_d ? ru_ftf[i] : 0;
    rc_nf > 0 ? ( d = 0; while (d < rc_nf && fz[d] <= ru_s[i]) ( d += 1; ); ru_next[i] = d; );
    p += RCF; q += RCF;
    i += 1;
  );
);
function hr_rp_find(left) local(k, i, p, m, r)
(
  r = 0; k = 0;
  while (k < g_rs_rn && !r) (
    p = hr_rc + k * g_hr_rn * RCF;
    m = 0; i = 0;
    loop(g_hr_rn, m = max(m, p[0]); p += RCF; i += 1; );
    m >= g_rs_d - left ? r = k + 1;
    k += 1;
  );
  r ? (r - 1) * RCDT : 0;
);
function hr_rp_start(t0) local(i, l)
(
  hr_rp_stash();
  g_rp_t = t0;
  g_rp_end = (g_rs_rn - 1) * RCDT;
  g_rs_fin > 0 ? g_rp_end = min(g_rp_end, ru_ftf[ru_ord[0]] + 7);
  hr_rp_apply(t0);
  hr_rankup();
  l = ru_ord[0];
  g_hc_x = ru_s[l] * 100; g_hc_vc = ru_v[l] * 100; g_hc_vr = g_hc_vc; g_hc_dx = 0; g_hc_span = 0; g_hc_z = 0.72;
  g_rs_pre = 0; g_rs_sdt = 0.033; g_rp_rate = 1;
  g_rs_fsaid = 0; g_rs_turn = 0; g_rs_ph = t0 > 2; g_rs_2f = 0; g_rs_1f = 0; g_rs_home = 0; g_rs_lead = -1; g_rs_sayt = -10; g_rs_t = t0;
  i = 0; loop(g_hr_rn, ru_fprev[i] = ru_fall[i]; i += 1; );
  i = 0; loop(HNC, hk_l[i] = 0; i += 1; );
  strcpy(#hr_sy, "Replay");
  hr_scene_ready();
  g_hr_v = 15;
);
function hr_replay() local(t, i, a, r)
(
  g_rs_sdt += (min(0.1, g_dt) - g_rs_sdt) * 0.1;
  t = g_rs_sdt * g_rp_rate;
  g_rp_t += t;
  g_rs_t = g_rp_t;
  hr_rp_apply(g_rp_t);
  i = 0;
  loop(g_hr_rn,
    (ru_fall[i] == 1 && ru_fprev[i] == 0) ? ( sprintf(#hr_sy2, "%s comes down!", ru_nm[i]); hr_say(#hr_sy2); db_snd(7, 60, 0.5, 0, 0); );
    ru_fprev[i] = ru_fall[i];
    i += 1;
  );
  hr_commentary();
  g_rs_hft += g_dt;
  g_rs_hft > 0.09 ? (
    g_rs_hft = 0;
    db_snd(7, 62 + rand(30), 0.13, rand(0.05), rand(1) - 0.5);
    a = g_rs_d - ru_s[ru_ord[0]];
    db_snd(14, 3.2, 0.012 + 0.07 * max(0, 1 - a / 500), 0, rand(1) - 0.5);
  );
  hr_cam(t, g_rs_sdt);
  hr_race_scene();
  hr_hud();
  hr_camui();
  font(13, 'b'); pill("REPLAY", 150, 18, 90, 26, 0.95, 0.35, 0.3, 1);
  a = g_rp_rate;
  hr_btn("x1/2", 386, 14, 50, 30, a == 0.5) ? g_rp_rate = 0.5;
  hr_btn("x1", 440, 14, 40, 30, a == 1) ? g_rp_rate = 1;
  hr_btn("x2", 484, 14, 40, 30, a == 2) ? g_rp_rate = 2;
  hr_btn("x4", 528, 14, 40, 30, a == 4) ? g_rp_rate = 4;
  r = 0;
  hr_btn("Result", 572, 14, 80, 30, 0) ? r = 1;
  hr_sound();
  (r || g_rp_t >= g_rp_end) ? ( hr_rp_restore(); g_hr_v = 13; );
);

function hr_photo()
(
  g_rs_pt += g_dt;
  hr_pan(30, 60, 840, 560);
  db_otext(g_rs_photo ? "PHOTOGRAPH" : "FINISH PHOTO", 180, 70, 540, 50, 30, 0.95, 0.85, 0.5, 1);
  hr_photo_draw(60, 130, 780, 360);
  g_rs_pt > 2.2 ? (
    sprintf(#hr_tmp, "First: %d, %s", ru_ord[0] + 1, ru_nm[ru_ord[0]]);
    db_otext(#hr_tmp, 60, 500, 780, 40, 22, 1, 0.95, 0.75, 1);
    sprintf(#hr_tmp, "Won by %s from %s", hr_btw(g_rs_marg), ru_nm[ru_ord[1]]);
    font(14, 0); gfx_set(0.85, 0.9, 0.8, 1); txt_c(#hr_tmp, 60, 540, 780, 26);
    hr_btn("Result", 360, 572, 180, 36, 0) ? g_hr_v = 13;
  ) : (
    font(14, 0); gfx_set(0.85, 0.9, 0.8, 1); txt_c("The judge is calling for the print...", 60, 520, 780, 26);
  );
);

function hr_result() local(i, r, y0, q, prev, m, gg)
(
  hr_pan(18, 14, 864, 650);
  sprintf(#hr_tmp, "Result: %s  %s", hr_tstr(rc_min), hc_n[rc_c]);
  hr_t(#hr_tmp, 34, 22, 16, 'b', 0.95, 0.85, 0.5);
  hr_w(rc_name, 34, 48, 12, 0);
  y0 = 76;
  q = min(30, 460 / g_hr_rn);
  prev = -1;
  i = 0;
  loop(g_hr_rn,
    r = ru_ord[i];
    ru_own[r] ? gfx_set(0.3, 0.27, 0.12, 1) : ru_bet[r] > 0 ? gfx_set(0.2, 0.26, 0.28, 1) : gfx_set(0.1, 0.17, 0.12, 1);
    fill_rr(30, y0, 840, q - 2, 3);
    ru_fall[r] ? strcpy(#hr_tmp, "F") : sprintf(#hr_tmp, "%d", i + 1);
    hr_t(#hr_tmp, 40, y0 + q * 0.5 - 9, 12, 'b', 0.95, 0.85, 0.5);
    hr_swatch(r, 70, y0 + q * 0.5 - 9, 18);
    hr_w(ru_nm[r], 98, y0 + q * 0.5 - 9, 11, 'b');
    hr_m(hj_n[ru_jk[r]], 320, y0 + q * 0.5 - 9, 10);
    i > 0 && !ru_fall[r] && prev >= 0 ? (
      m = (ru_ft[r] - ru_ft[prev]) * 16 / 2.4;
      hr_m(hr_btl(m), 490, y0 + q * 0.5 - 9, 10);
    );
    hr_m(hod_s[ru_odd[r]], 560, y0 + q * 0.5 - 9, 10);
    ru_bet[r] > 0 ? ( sprintf(#hr_tmp, "%s%s", hr_money(ru_bet[r]), ru_ew[r] ? " e/w" : ""); hr_t(#hr_tmp, 620, y0 + q * 0.5 - 9, 10, 'b', 0.6, 0.85, 0.95); );
    hr_prize_of(i) > 0 && !ru_fall[r] ? ( font(10, 0); gfx_set(0.85, 0.87, 0.8, 1); txt_r(hr_money(rc_p * hr_prize_of(i)), 860, y0 + q * 0.5 - 9); );
    !ru_fall[r] ? prev = r;
    y0 += q;
    i += 1;
  );
  gg = 0; i = 0; loop(g_hr_rn, gg += ru_bet[i]; i += 1; );
  gg > 0 ? (
    sprintf(#hr_tmp, g_rs_paid > 0 ? "Your bets paid %s on stakes of %s" : "Your bets lost: %s down", hr_money(g_rs_paid), hr_money(gg));
    g_rs_paid > 0 ? 0 : sprintf(#hr_tmp, "Your bets lost: %s down", hr_money(gg));
    hr_t(#hr_tmp, 34, 556, 14, 'b', g_rs_paid > gg ? 0.5 : 0.95, g_rs_paid > gg ? 0.95 : 0.7, 0.45);
  );
  g_rs_nf > 0 ? ( sprintf(#hr_tmp, "Fallers: %d. All walked away.", g_rs_nf); hr_m(#hr_tmp, 34, 584, 11); );
  sprintf(#hr_tmp, "Money: %s", hr_money(g_hr_mode == 0 ? sv3[2] : g_hr_bank));
  font(13, 'b'); gfx_set(0.95, 0.85, 0.5, 1); txt_r(#hr_tmp, 860, 556);
  g_rs_rn > 1 ? (
    hr_btn("Whole race", 30, 610, 112, 40, 0) ? hr_rp_start(0);
    hr_btn("Last section", 148, 610, 112, 40, 0) ? hr_rp_start(hr_rp_find(rc_j ? 600 : 402));
  );
  g_rs_fin > 0 ? (
    hr_btn("Photo finish", 266, 610, 112, 40, 0) ? ( g_rs_pt = 3; g_hr_v = 12; );
  );
  g_hr_mode == 0 ? (
    hr_btn("Next race", 390, 610, 156, 40, 0) ? ( g_hr_cm = -1; hr_next_race_go(); );
    hr_btn(hr_next_entry_slot() >= 0 ? "My next runner" : "No more entries", 552, 610, 156, 40, 0) ? ( g_hr_cm = -1; hr_next_runner_go(); );
    hr_btn("The card", 714, 610, 156, 40, 0) ? ( g_hr_v = 3; g_hr_cm = -1; );
  ) : g_hr_mode == 1 ? (
    hr_btn(g_hr_ri >= 6 ? "End of the day" : "Next race", 640, 610, 230, 40, 0) ? (
      g_hr_ri >= 6 ? g_hr_v = 14 : ( g_hr_ri += 1; g_hr_v = 10; hr_rload(); );
    );
  ) : (
    hr_btn(g_hr_dm ? "Next race today" : "Another random race", 400, 610, 230, 40, 0) ? (
      g_hr_dm ? hr_nextrace() : (
        g_hr_rd = hr_pickday(); hr_day(g_hr_rd);
        g_hr_rm = g_hr_mn > 0 ? floor(rand(1) * g_hr_mn) : 0;
        g_hr_rc = md_c[g_hr_rm]; g_hr_ri = floor(rand(1) * 7);
      );
      hr_rload(); g_hr_v = 10;
    );
    hr_btn("Racing menu", 640, 610, 230, 40, 0) ? g_hr_v = 0;
  );
);

function hr_dayview() local(i, y0)
(
  hr_top(0);
  hr_pan(100, 70, 700, 590);
  sprintf(#hr_tmp, "A day at %s", hc_n[g_hr_rc]);
  hr_t(#hr_tmp, 120, 80, 18, 'b', 0.95, 0.85, 0.5);
  hr_m(hr_dstr(g_hr_rd), 120, 110, 12);
  hr_mkrace(g_hr_rd, g_hr_rc, 0);
  i = hr_evening(g_hr_rd, g_hr_rc);
  sprintf(#hr_tmp, "%s-handed. %s, %s.%s Your bank: %s", hc_l[g_hr_rc] ? "Left" : "Right", hr_gn_s[rc_going], hr_wxn[hr_wx(g_hr_rd, g_hr_rc)], i == 2 ? " Floodlit meeting." : i == 1 ? " Evening meeting." : "", hr_money(g_hr_bank));
  hr_m(#hr_tmp, 120, 130, 12);
  y0 = 164; i = 0;
  loop(7,
    hr_mkrace(g_hr_rd, g_hr_rc, i);
    hr_t(hr_tstr(rc_min), 124, y0, 14, 'b', i === g_hr_ri ? 0.95 : 0.55, i === g_hr_ri ? 0.85 : 0.6, i === g_hr_ri ? 0.5 : 0.55);
    hr_w(rc_name, 196, y0 + 2, 11, 'b');
    sprintf(#hr_tmp, "%s, %s", hr_clstr(), hr_fstr(rc_f)); font(10, 0); gfx_set(0.62, 0.7, 0.62, 1); txt_r(#hr_tmp, 780, y0 + 3);
    y0 += 34;
    i += 1;
  );
  hr_btn(g_hr_dm ? "Next meeting today" : "Another day", 120, 590, 200, 50, 0) ? (
    g_hr_dm ? hr_nextmeet() : (
      g_hr_rd = hr_pickday(); hr_day(g_hr_rd);
      g_hr_rm = g_hr_mn > 0 ? floor(rand(1) * g_hr_mn) : 0;
      g_hr_rc = md_c[g_hr_rm]; g_hr_ri = 0;
    );
    hr_rload();
  );
  hr_btn("To the first race", 340, 590, 440, 50, 0) ? ( g_hr_v = 10; hr_rload(); );
);

function hr_sum()
(
  hr_top(0);
  hr_pan(180, 150, 540, 300);
  db_otext(g_hr_bank > g_hr_start ? "Up on the day!" : g_hr_bank == g_hr_start ? "All square" : "The bookies win", 180, 170, 540, 60, 28, 0.95, 0.85, 0.5, 1);
  sprintf(#hr_tmp, "You started with %s and leave %s with %s", hr_money(g_hr_start), hc_n[g_hr_rc], hr_money(g_hr_bank));
  font(13, 0); gfx_set(0.9, 0.9, 0.85, 1); txt_c(#hr_tmp, 180, 250, 540, 30);
  hr_btn("Racing menu", 350, 330, 200, 50, 0) ? g_hr_v = 0;
);

function draw_racing()
(
  (g_hr_v == 11 || g_hr_v == 15) ? hr_lit() : hr_hublit();
  g_hr_v == 11 ? hr_race() :
  g_hr_v == 15 ? hr_replay() :
  g_hr_v == 12 ? hr_photo() :
  g_hr_v == 13 ? hr_result() :
  g_hr_v == 10 ? ( hr_paddock(); hr_sound(); ) :
  g_hr_v == 9 ? ( hr_dayview(); hr_sound(); ) :
  g_hr_v == 14 ? hr_sum() :
  (
    hr_top(0); hr_sound();
    g_hr_v == 0 ? hr_menu() : (
      hr_tabs();
      g_hr_v == 1 ? hr_cal() : g_hr_v == 3 ? hr_card() : g_hr_v == 4 ? hr_info() : g_hr_v == 5 ? hr_stable() : g_hr_v == 6 ? hr_horse() : g_hr_v == 7 ? hr_sales() : g_hr_v == 8 ? hr_records();
    );
  );
);

function pv_racing(x, y, w, h) local(i, t, q)
(
  g_hb_pv !== 1 ? ( g_hb_pv = 1; g_hb_key = -1; hb_bake(10, 1, 0, 2); );
  hr_lit();
  pv_begin(x, y, w, h, 1);
  rc_c = 10; rc_going = 2; rc_nf = 0; rc_j = 0; rc_f = 8; g_rs_d = 100000; g_rs_wx = 1; g_hr_rn = 0;
  g_hc_d = 1600; g_hc_hy = 212; g_hc_z = 0.7; g_hc_dir = 1; g_hc_h = 400 / hb_k_u(60); g_hc_dx = 0;
  t = g_t * 12;
  g_hc_x = t * 100;
  gfx_mode = 0; gfx_a = 1;
  gfx_gradrect(sx(0), sy(0), 900 * g_s, 470 * g_s, g_sk_r0, g_sk_g0, g_sk_b0, 1, 0, 0, 0, 0, (g_sk_r1 - g_sk_r0) / (470 * g_s), (g_sk_g1 - g_sk_g0) / (470 * g_s), (g_sk_b1 - g_sk_b0) / (470 * g_s), 0);
  hb_layer(IMG_HRF1, 0.012, g_hc_x, 140, 1);
  hb_layer(IMG_HRF2, 0.03, g_hc_x, 148, 1);
  hb_layer(IMG_HRF3, 0.09, g_hc_x, 158, 1);
  hf_rgb(0.22, 0.38, 0.17); gfx_rect(sx(0), sy(450), 900 * g_s, 60 * g_s);
  hb_draw_ground();
  hb_rail(1150, 105, 300);
  i = 0;
  loop(3,
    hr_coat(i == 0 ? 1 : i == 1 ? 3 : 0, 0); hr_blz = i != 1; hr_silkset(i == 0 ? 1 : i == 1 ? 0 : 2, i == 0 ? 3 : i == 1 ? 5 : 7, i + 1);
    hr_jw = 0; hr_lift = 0; hr_pitch = 0; hr_limp = 0; hr_whip = 0;
    q = 860 - i * 340; hb_shadow(sx(260 + i * 210), sy(hb_gy(q) + 2), hb_k(q) * g_s);
    hr_coat(i == 0 ? 1 : i == 1 ? 3 : 0, 0); gfx_a = 1;
    hr_view(1, 0.2, g_s * hb_k(q), sx(260 + i * 210), sy(hb_gy(q)));
    hr_pose(frac(g_t * 2.3 + i * 0.3), 0, 1);
    i += 1;
  );
  hb_rail(-130, 120, 300);
  pv_end();
);
// ==== end Hold Your Horses ====
