      hb_b(x + 60, 226, 70, 20, 0.92, 0.9, 0.84); hb_tint(0.62, 0.72, 0.8, 1); gfx_circle(x + 76, 224, 8, 1, 1); gfx_circle(x + 96, 222, 10, 1, 1); gfx_circle(x + 116, 224, 8, 1, 1); ) ) :
  c == 5 ? ( w ? hb_hill(x, 300, 66, 0.42, 0.46, 0.5) : hb_castle(x, 0.72, 0.62, 0.34, 0.27) ) :
  c == 6 ? ( w ? ( hb_hill(x, 280, 40, 0.46, 0.52, 0.38); ) : hb_arch(x, 8, 24, 48, 0.54, 0.5, 0.44) ) :
