    xs_bset(0.03, 0.02, 0.02, 1); gfx_circle(x + k * 26 * s, y + 18 * s, 13 * s, 1, 1);
    gfx_mode = 1; xs_bset(1, 0.12, 0.05, 0.9); gfx_circle(x + k * 26 * s, y + 19 * s, 5 * s, 1, 1); xs_bset(1, 0.1, 0.05, 0.3); gfx_circle(x + k * 26 * s, y + 19 * s, 12 * s, 1, 1); gfx_mode = 0;
    k += 2;
