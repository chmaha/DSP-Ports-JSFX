function xs_sell(cx, cy, rx, ry, a0, a1, n) local(k, a, b)
(
  k = 0;
  loop(n,
    a = a0 + (a1 - a0) * k / n; b = a0 + (a1 - a0) * (k + 1) / n;
    gfx_triangle(cx, cy, cx + cos(a) * rx, cy + sin(a) * ry, cx + cos(b) * rx, cy + sin(b) * ry);
    k += 1;
  );
);
function xs_db_prism(t) local(x, y, s, k, j, a, a0, a1, am, ox, oy, rad, l, ax, ay, r, fl, op, f, ang, ca, sa)
(
  x = sx(g_xs_bx); y = sy(g_xs_by); s = g_s; op = xs_core_open();
  f = op ? min(1, (t - g_xs_open_t) * 1.5) : 0;
  !op ? g_xs_open_t = t;
  rad = 74 * s;
  gfx_mode = 1; xs_bset(0.4, 0.9, 1, 0.08 + 0.04 * sin(t * 2)); gfx_circle(x, y, rad * 1.7, 1, 1); xs_bset(0.6, 0.95, 1, 0.1); gfx_circle(x, y, rad * 1.2, 1, 1); gfx_mode = 0;
  a = t * 0.35;
  f < 0.05 ? ( xs_bset(0.03, 0.08, 0.12, 1); j = 0; loop(6, a0 = a + j * $pi / 3; a1 = a0 + $pi / 3; gfx_triangle(x, y, x + cos(a0) * (rad + 5 * s), y + sin(a0) * (rad + 5 * s), x + cos(a1) * (rad + 5 * s), y + sin(a1) * (rad + 5 * s)); j += 1; ); );
  j = 0;
  loop(6,
    a0 = a + j * $pi / 3; a1 = a0 + $pi / 3; am = (a0 + a1) * 0.5;
    ox = cos(am) * f * 34 * s; oy = sin(am) * f * 34 * s;
    l = 0.5 + 0.5 * cos(am + 2.3);
    xs_bset(0.03, 0.08, 0.12, 1); gfx_triangle(x + ox, y + oy, x + ox + cos(a0) * (rad + 4 * s), y + oy + sin(a0) * (rad + 4 * s), x + ox + cos(a1) * (rad + 4 * s), y + oy + sin(a1) * (rad + 4 * s));
    xs_bset(0.18 + 0.5 * l, 0.5 + 0.45 * l, 0.75 + 0.25 * l, 1);
    gfx_triangle(x + ox, y + oy, x + ox + cos(a0) * rad, y + oy + sin(a0) * rad, x + ox + cos(a1) * rad, y + oy + sin(a1) * rad);
    xs_bset(0.5 + 0.5 * l, 0.85 + 0.15 * l, 1, 1);
    gfx_triangle(x + ox + cos(a0) * rad * 0.45, y + oy + sin(a0) * rad * 0.45, x + ox + cos(a0) * rad, y + oy + sin(a0) * rad, x + ox + cos(am) * rad * 0.75, y + oy + sin(am) * rad * 0.75);
    j += 1;
  );
  f < 0.05 ? (
    xs_bset(0.85, 0.98, 1, 1); j = 0; loop(6, a0 = -a * 1.6 + j * $pi / 3; a1 = a0 + $pi / 3; gfx_triangle(x, y, x + cos(a0) * rad * 0.32, y + sin(a0) * rad * 0.32, x + cos(a1) * rad * 0.32, y + sin(a1) * rad * 0.32); j += 1; );
    gfx_mode = 1; a = 0.6 + 0.4 * xs_hbeat(t);
    xs_bset(1, 0.05, 0.05, 0.25 * a); gfx_circle(x, y, rad * 0.55, 1, 1);
    xs_bset(1, 0.15, 0.05, 0.9 * a); xs_sell(x, y, rad * 0.34, rad * 0.16, 0, 2 * $pi, 20);
    xs_bset(1, 0.7, 0.3, 0.8 * a); xs_sell(x, y, rad * 0.2, rad * 0.09, 0, 2 * $pi, 16); gfx_mode = 0;
    xs_bset(0, 0, 0, 1); xs_sell(x + (sx(g_xs_px) - x) * 0.02, y, rad * 0.04, rad * 0.15, 0, 2 * $pi, 12);
  );
  xp_on[3] && op ? (
    ax = sx(xp_x[3]); ay = sy(xp_y[3]); r = xp_r[3] * s;
    gfx_mode = 1; xs_bset(0.3, 0.9, 1, 0.3 + 0.3 * f); gfx_circle(ax, ay, r * 2.2, 1, 1); gfx_mode = 0;
    xs_eye(ax, ay, r, xs_fl(3), xp_hp[3] / xp_hm[3]);
  );
  k = 0;
  loop(3,
    xp_on[k] ? (
      ax = sx(xp_x[k]); ay = sy(xp_y[k]); r = xp_r[k] * s; fl = xs_fl(k);
      ang = atan2(sy(g_xs_py) - ay, sx(g_xs_px) - ax); ca = cos(ang); sa = sin(ang);
      gfx_mode = 1; xs_bset(0.4, 0.9, 1, 0.25); gfx_circle(ax, ay, r * 1.9, 1, 1); gfx_mode = 0;
      xs_bset(0.03, 0.08, 0.12, 1);
      gfx_triangle(ax + ca * r * 2.5, ay + sa * r * 2.5, ax - sa * r, ay + ca * r, ax - ca * r * 1.7, ay - sa * r * 1.7, ax + sa * r, ay - ca * r);
      fl ? xs_bset(1, 1, 1, 1) : xs_bset(0.35, 0.75, 1, 1);
      gfx_triangle(ax + ca * r * 2.2, ay + sa * r * 2.2, ax - sa * r * 0.8, ay + ca * r * 0.8, ax - ca * r * 1.45, ay - sa * r * 1.45, ax + sa * r * 0.8, ay - ca * r * 0.8);
      fl ? xs_bset(1, 1, 1, 1) : xs_bset(0.8, 0.97, 1, 1);
      gfx_triangle(ax + ca * r * 2.2, ay + sa * r * 2.2, ax + sa * r * 0.8, ay - ca * r * 0.8, ax - ca * r * 1.45, ay - sa * r * 1.45);
      gfx_mode = 1; xs_bset(1, 0.15, 0.08, 0.7 + 0.3 * sin(t * 7 + k)); gfx_circle(ax + ca * r * 0.4, ay + sa * r * 0.4, r * 0.32, 1, 1); xs_bset(1, 0.1, 0.05, 0.25); gfx_circle(ax, ay, r * 1.4, 1, 1); gfx_mode = 0;
    );
    k += 1;
  );
