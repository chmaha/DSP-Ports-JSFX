function xs_db_crusher(t) local(x, y, s, k, j, a, ax, ay, r, fl, op, f, w, h, px, ph)
(
  x = sx(g_xs_bx); y = sy(g_xs_by); s = g_s; op = xs_core_open();
  f = op ? min(1, (t - g_xs_open_t) * 1.5) : 0;
  !op ? g_xs_open_t = t;
  k = -1;
  loop(2,
    px = x + k * 68 * s;
    xs_bset(0.05, 0.05, 0.05, 1); gfx_rect(px - 13 * s, y - 112 * s, 26 * s, 60 * s);
    xs_bset(0.3, 0.28, 0.27, 1); gfx_rect(px - 10 * s, y - 110 * s, 20 * s, 58 * s);
    xs_bset(0.6, 0.15, 0.1, 1); gfx_rect(px - 10 * s, y - 104 * s, 20 * s, 5 * s);
    j = 0;
    loop(4,
      ph = frac(t * 0.5 + j * 0.25 + (k > 0) * 0.12);
      xs_bset(0.35, 0.33, 0.32, 0.5 * (1 - ph)); gfx_circle(px + 10 * s * sin(ph * 4 + j), y - (114 + ph * 120) * s, (6 + 16 * ph) * s, 1, 1);
      j += 1;
    );
    k += 2;
  );
  k = 0;
  loop(2,
    xp_on[k] ? (
      ax = sx(xp_x[k]); ay = sy(xp_y[k]);
      xs_bset(0.05, 0.05, 0.05, 1); tline(x + (k ? 1 : -1) * 86 * s, y - 20 * s, ax, ay - 24 * s, 16 * s);
      xs_bset(0.62, 0.64, 0.68, 1); tline(x + (k ? 1 : -1) * 86 * s, y - 20 * s, ax, ay - 24 * s, 10 * s);
      xs_bset(0.85, 0.87, 0.9, 1); tline(x + (k ? 1 : -1) * 86 * s, y - 22 * s, ax, ay - 26 * s, 3 * s);
    );
    k += 1;
  );
  w = 96 * s; h = 54 * s;
  xs_bset(0.05, 0.04, 0.03, 1); gfx_rect(x - w - 4 * s, y - h - 4 * s, 2 * w + 8 * s, 2 * h + 8 * s);
  xs_bset(0.85, 0.62, 0.1, 1); gfx_rect(x - w, y - h, 2 * w, 2 * h);
  xs_bset(1, 0.78, 0.25, 1); gfx_rect(x - w, y - h, 2 * w, 8 * s);
  xs_bset(0.62, 0.42, 0.05, 1); gfx_rect(x - w, y + h - 8 * s, 2 * w, 8 * s);
  xs_bset(0.08, 0.07, 0.06, 1); gfx_rect(x - w, y + 18 * s, 2 * w, 22 * s);
  xs_bset(0.95, 0.75, 0.1, 1);
  k = 0; loop(10, a = x - w + k * 20 * s; gfx_triangle(a, y + 18 * s, a + 10 * s, y + 18 * s, min(x + w, a + 20 * s), y + 40 * s, min(x + w, a + 10 * s), y + 40 * s); k += 1; );
  xs_bset(0.45, 0.32, 0.05, 1); k = 0; loop(9, gfx_circle(x - w + 12 * s + k * 21 * s, y - h + 16 * s, 2.4 * s, 1, 1); gfx_circle(x - w + 12 * s + k * 21 * s, y + h - 4 * s, 2.4 * s, 1, 1); k += 1; );
  xs_bset(0.05, 0.04, 0.03, 1); gfx_rect(x - 70 * s, y - 40 * s, 140 * s, 22 * s);
  gfx_mode = 1; a = 0.6 + 0.4 * xs_hbeat(t);
  xs_bset(1, 0.08, 0.03, 0.25 * a); gfx_rect(x - 70 * s, y - 44 * s, 140 * s, 30 * s);
  xs_bset(1, 0.12, 0.04, a); gfx_triangle(x - 58 * s, y - 36 * s, x - 12 * s, y - 28 * s, x - 14 * s, y - 22 * s, x - 54 * s, y - 28 * s); gfx_triangle(x + 58 * s, y - 36 * s, x + 12 * s, y - 28 * s, x + 14 * s, y - 22 * s, x + 54 * s, y - 28 * s);
  xs_bset(1, 0.7, 0.4, a); gfx_rect(x - 40 * s, y - 30 * s, 16 * s, 3 * s); gfx_rect(x + 24 * s, y - 30 * s, 16 * s, 3 * s); gfx_mode = 0;
  xs_bset(0.75, 0.7, 0.6, 1); k = 0; loop(12, a = x - w + 6 * s + k * (2 * w - 12 * s) / 11; gfx_triangle(a - 7 * s, y + h, a + 7 * s, y + h, a + (k % 2 ? 2 : -2) * s, y + h + (14 + 8 * (k % 3 == 1)) * s); k += 1; );
  xs_bset(0.35, 0.02, 0.02, 1); k = 0; loop(5, a = x - w + 20 * s + k * 41 * s; gfx_rect(a, y + h + 4 * s, 2 * s, (10 + 12 * frac(k * 0.37 + t * 0.2)) * s); k += 1; );
  ax = sx(xp_x[2]); ay = sy(xp_y[2]);
  xs_bset(0.05, 0.04, 0.03, 1); gfx_rect(ax - 40 * s, ay - 24 * s, 80 * s, 40 * s);
  gfx_mode = 1; xs_bset(1, 0.45, 0.05, 0.55 + 0.25 * sin(t * 6)); gfx_rect(ax - 36 * s, ay - 20 * s, 72 * s, 32 * s); gfx_mode = 0;
  xp_on[2] && op ? xs_eye(ax, ay - 4 * s, xp_r[2] * s * 0.8, xs_fl(2), xp_hp[2] / xp_hm[2]);
  xs_bset(0.22, 0.2, 0.19, 1);
  k = 0; loop(5, a = (k - 2) * 14 * s; a += (a < 0 ? -1 : a > 0 ? 1 : 0) * f * 30 * s; abs(a) < 40 * s ? gfx_rect(ax + a - 3 * s, ay - 22 * s, 6 * s, 36 * s); k += 1; );
  k = 0;
  loop(2,
    xp_on[k] ? (
