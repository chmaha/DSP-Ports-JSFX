  xs_bset(0.42, 0.38, 0.32, 1); fan(x, y + 30 * s, 44 * s, 0.25, $pi - 0.25, 16);
  xs_bset(0.05, 0.03, 0.03, 1); gfx_rect(x - 50 * s, y + 30 * s, 100 * s, 8 * s);
  k = 0; loop(10, xs_bset(0.85, 0.82, 0.72, 1); gfx_triangle(x - 48 * s + k * 10 * s, y + 30 * s, x - 40 * s + k * 10 * s, y + 30 * s, x - 44 * s + k * 10 * s, y + (44 + 6 * (k & 1)) * s); k += 1; );
  k = -1;
