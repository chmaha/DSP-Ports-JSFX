@init
function xs_text(s, x, y, w, h, sz, cr, cg, cb, a) local(tw, th, px, py, o, k)
(
  gfx_setfont(3, "Arial Black", sz * g_s, 'b');
  gfx_measurestr(s, tw, th);
  px = sx(x) + (w * g_s - tw) * 0.5; py = sy(y) + (h * g_s - th) * 0.5;
  o = max(1, sz * 0.08 * g_s);
  gfx_mode = 1; gfx_set(cr, cg * 0.4, cb * 0.3, 0.25 * a);
  k = 0; loop(8, gfx_x = px + 2.4 * o * cos(k * $pi / 4); gfx_y = py + 2.4 * o * sin(k * $pi / 4); gfx_drawstr(s); k += 1; );
  gfx_mode = 0;
  gfx_set(0.01, 0.01, 0.015, a);
  k = 0; loop(8, gfx_x = px + o * cos(k * $pi / 4); gfx_y = py + o * sin(k * $pi / 4); gfx_drawstr(s); k += 1; );
  gfx_x = px + o; gfx_y = py + o * 1.8; gfx_drawstr(s);
  gfx_set(cr, cg, cb, a); gfx_x = px; gfx_y = py; gfx_drawstr(s);
);

function xs_plate(s, x, y, w, h, cr, cg, cb)
(
  gfx_set(0.02, 0.02, 0.02, 1);
  gfx_triangle(sx(x + 6), sy(y), sx(x + w), sy(y), sx(x + w), sy(y + h - 6), sx(x + w - 6), sy(y + h), sx(x), sy(y + h), sx(x), sy(y + 6));
  gfx_set(cr * 0.35, cg * 0.35, cb * 0.35, 1);
  gfx_triangle(sx(x + 7), sy(y + 1.5), sx(x + w - 1.5), sy(y + 1.5), sx(x + w - 1.5), sy(y + h - 7), sx(x + w - 7), sy(y + h - 1.5), sx(x + 1.5), sy(y + h - 1.5), sx(x + 1.5), sy(y + 7));
  gfx_set(cr, cg, cb, 1); gfx_rect(sx(x + 7), sy(y + 1.5), (w - 9) * g_s, max(1, 2 * g_s));
  font(12, 'b'); gfx_set(1, 0.95, 0.85, 1); txt_c(s, x, y, w, h);
);

function xs_crystal(x, y, r, t, a) local(px, py, c, wd)
(
  px = sx(x); py = sy(y); r *= g_s;
  c = cos(t * 3); wd = r * (0.3 + 0.7 * abs(c));
  gfx_mode = 1; gfx_set(1, 0.55, 0.1, 0.18 * a); gfx_circle(px, py, r * 1.8, 1, 1); gfx_mode = 0;
  gfx_set(0.35, 0.1, 0.02, a); gfx_triangle(px, py - r * 1.3, px + wd, py, px, py + r * 1.3, px - wd, py);
  c > 0 ? gfx_set(1, 0.6, 0.15, a) : gfx_set(0.85, 0.35, 0.05, a);
  gfx_triangle(px, py - r * 1.3, px + wd * (c > 0 ? 1 : 0.2), py, px, py + r * 1.3);
  c > 0 ? gfx_set(0.7, 0.25, 0.03, a) : gfx_set(1, 0.7, 0.25, a);
  gfx_triangle(px, py - r * 1.3, px - wd * (c > 0 ? 0.2 : 1), py, px, py + r * 1.3);
  gfx_mode = 1; gfx_set(1, 0.95, 0.7, 0.8 * a); gfx_triangle(px, py - r * 1.1, px + wd * 0.2, py - r * 0.2, px - wd * 0.15, py - r * 0.3); gfx_mode = 0;
);

function xs_gcrystal(x, y, r, t, a) local(px, py, c, wd)
(
  px = sx(x); py = sy(y); r *= g_s;
  c = cos(t * 3); wd = r * (0.3 + 0.7 * abs(c));
  gfx_mode = 1; gfx_set(0.2, 1, 0.3, 0.25 * a); gfx_circle(px, py, r * 1.8, 1, 1); gfx_mode = 0;
  gfx_set(0.02, 0.2, 0.06, 1); gfx_triangle(px, py - r * 1.4, px + wd + 2 * g_s, py, px, py + r * 1.4, px - wd - 2 * g_s, py);
  c > 0 ? gfx_set(0.35 * a, 1 * a, 0.4 * a, 1) : gfx_set(0.15 * a, 0.75 * a, 0.25 * a, 1);
  gfx_triangle(px, py - r * 1.3, px + wd * (c > 0 ? 1 : 0.2), py, px, py + r * 1.3);
  c > 0 ? gfx_set(0.08 * a, 0.5 * a, 0.15 * a, 1) : gfx_set(0.45 * a, 1 * a, 0.5 * a, 1);
  gfx_triangle(px, py - r * 1.3, px - wd * (c > 0 ? 0.2 : 1), py, px, py + r * 1.3);
  gfx_mode = 1; gfx_set(0.85, 1, 0.85, 0.9 * a); gfx_triangle(px, py - r * 1.1, px + wd * 0.2, py - r * 0.2, px - wd * 0.15, py - r * 0.3); gfx_mode = 0;
);

function xs_smoke(x, y, r, life) local(i)
(
  i = g_xs_ki;
  xk_x[i] = x; xk_y[i] = y; xk_r[i] = r; xk_t[i] = g_xs_t; xk_l[i] = life; xk_vx[i] = (rand(1) - 0.5) * 40; xk_vy[i] = -10 - rand(1) * 30;
  g_xs_ki = (g_xs_ki + 1) % NXK;
);

function xs_power() local(p, g)
(
  g = xs_lv[0];
  p = g == 1 ? 20 : g == 2 ? 32 : g == 3 ? 52 : g == 4 ? 64 : 128;
  p += xs_lv[1] * 6 + xs_lv[2] * 3 + (xs_lv[3] == 1 ? 8 : xs_lv[3] == 2 ? 20 : 0) + (xs_lv[4] == 1 ? 16 : xs_lv[4] == 2 ? 30 : 0) + xs_lv[5] * 5;
  p / 20;
);

function xs_ltrk() local(w) ( w = floor((g_xs_lv - 1) / 2) % 5; w == 0 ? 16 : 23 + w; );

function xs_wall(w, side) local(s, a, b, c, l, f, e)
(
  s = g_xs_sd + side * 17.3;
  a = 0.5 + 0.5 * sin(w * 0.0031 + s);
  b = 0.5 + 0.5 * sin(w * 0.00137 + s * 2.1);
  c = 0.5 + 0.5 * sin(w * 0.011 + s * 3.7);
  l = 16 + 62 * a * a + 96 * b * b * b + 12 * c;
  f = min(1, max(0, (w - 250) / 500));
  e = min(1, max(0, (g_xs_len - 500 - w) / 600));
  l * f * e + 10;
);

function xs_walls(w) local(l, r, t)
(
  l = xs_wall(w, 0); r = xs_wall(w, 1);
  t = l + r;
  t > XS_W - 250 ? ( l *= (XS_W - 250) / t; r *= (XS_W - 250) / t; );
  g_xs_wl = l; g_xs_wr = r;
);

function xs_wy(w) ( XS_Y1 - (w - g_xs_sc); );
function xs_yw(y) ( g_xs_sc + XS_Y1 - y; );

function xs_cell(c, r) ( (c < 0 || c >= XT_NC) ? 1 : (r < 0 || r >= XT_NR) ? 0 : xt_m[r * XT_NC + c]; );
function xs_solid(x, y) ( xs_cell(floor((x - XS_X0) / XT), floor(xs_yw(y) / XT)); );
function xs_set(c, r, v) ( (c >= 0 && c < XT_NC && r >= 0 && r < XT_NR) ? xt_m[r * XT_NC + c] = v; );
function xs_free2(c, r) ( !xs_cell(c, r) && (!xs_cell(c - 1, r) || !xs_cell(c + 1, r)); );

function xs_span(r) local(c)
(
  g_xs_fa = 0; c = 0; while (c < XT_NC && xs_cell(c, r)) ( c += 1; ); g_xs_fa = c;
  g_xs_fb = XT_NC - 1; c = XT_NC - 1; while (c >= 0 && xs_cell(c, r)) ( c -= 1; ); g_xs_fb = c;
);

function xs_map_gen() local(nr, r, c, w, l, rr, tt, k, th, ng, gw, g0, g1, sl, j, x0, wd, ht, cc, side, len, any, best, bc, d)
(
  memset(xt_m, 0, XT_NC * XT_NR);
  nr = min(XT_NR, ceil((g_xs_len + 700) / XT));
  r = 0;
  loop(nr,
    w = r * XT + XT * 0.5;
    l = xs_wall(w, 0); rr = xs_wall(w, 1); tt = l + rr;
    tt > XS_W - 250 ? ( l *= (XS_W - 250) / tt; rr *= (XS_W - 250) / tt; );
    l = floor(l / XT + 0.35); rr = floor(rr / XT + 0.35);
    c = 0; loop(l, xs_set(c, r, 1); c += 1; );
    c = 0; loop(rr, xs_set(XT_NC - 1 - c, r, 1); c += 1; );
    r += 1;
  );
  w = 760;
  while (w < g_xs_len - 800) (
    r = floor(w / XT);
    xs_span(r);
    k = rand(1);
    k < 0.42 ? (
      th = 2 + (rand(1) < 0.45);
      ng = (g_xs_lv <= 2 || rand(1) < 0.55) ? 1 : 2;
      gw = max(4, 7 - floor(g_xs_lv / 3));
      sl = rand(1) < 0.5 ? 0 : rand(1) < 0.5 ? -1 : 1;
      g0 = g_xs_fa + 1 + floor(rand(1) * max(1, g_xs_fb - g_xs_fa - gw - 1));
      g1 = ng == 2 ? (g0 + gw + 3 + floor(rand(1) * 4)) : -100;
      g1 + gw > g_xs_fb ? g1 = -100;
      j = 0;
      loop(th,
        c = 0;
        loop(XT_NC,
          d = c - j * sl;
          ((d >= g0 && d < g0 + gw) || (d >= g1 && d < g1 + gw)) ? xs_set(c, r + j, 0) : xs_set(c, r + j, 1);
          c += 1;
        );
        j += 1;
      );
      w += th * XT;
    ) : k < 0.74 ? (
      loop(1 + (rand(1) < 0.4),
        wd = 3 + floor(rand(1) * 4); ht = 2 + floor(rand(1) * 3);
        cc = g_xs_fa + 2 + floor(rand(1) * max(1, g_xs_fb - g_xs_fa - wd - 3));
        (cc - g_xs_fa >= 4 || g_xs_fb - (cc + wd - 1) >= 4) ? (
          j = 0;
          loop(ht,
            c = 0;
            loop(wd,
              !((wd >= 4 && ht >= 3) && (c == 0 || c == wd - 1) && (j == 0 || j == ht - 1)) ? xs_set(cc + c, r + j + floor(rand(1) * 0.0), 1);
              c += 1;
            );
            j += 1;
          );
        );
        r += ht + 2 + floor(rand(1) * 3);
        xs_span(r);
      );
    ) : (
      side = rand(1) < 0.5;
      len = 4 + floor(rand(1) * 5);
      th = 1 + (rand(1) < 0.5);
      len = min(len, g_xs_fb - g_xs_fa - 5);
      j = 0;
      loop(th,
        c = 0;
        loop(len, side ? xs_set(g_xs_fb - c, r + j, 1) : xs_set(g_xs_fa + c, r + j, 1); c += 1; );
        j += 1;
      );
    );
    w += (330 + rand(1) * 380) * max(0.6, 1 - (g_xs_lv - 1) * 0.04);
  );
  memset(xt_p, 0, XT_NC);
  c = 0; loop(XT_NC, xt_p[c] = xs_free2(c, 0); c += 1; );
  r = 1;
  loop(nr - 1,
    any = 0;
    c = 0; loop(XT_NC, xt_q[c] = xs_free2(c, r) && (xt_p[c] || (c > 0 && xt_p[c - 1]) || (c < XT_NC - 1 && xt_p[c + 1])); xt_q[c] ? any = 1; c += 1; );
    !any ? (
      best = 1000; bc = 10;
      c = 0; loop(XT_NC, (xt_p[c] && abs(c - 9.5) < best) ? ( best = abs(c - 9.5); bc = c; ); c += 1; );
      bc = max(2, min(XT_NC - 3, bc));
      c = bc - 2; loop(5, xs_set(c, r, 0); c += 1; );
      c = 0; loop(XT_NC, xt_q[c] = xs_free2(c, r) && (xt_p[c] || (c > 0 && xt_p[c - 1]) || (c < XT_NC - 1 && xt_p[c + 1])); c += 1; );
    );
    c = 1; loop(XT_NC - 1, (xt_q[c - 1] && xs_free2(c, r)) ? xt_q[c] = 1; c += 1; );
    c = XT_NC - 2; loop(XT_NC - 1, (xt_q[c + 1] && xs_free2(c, r)) ? xt_q[c] = 1; c -= 1; );
    memcpy(xt_p, xt_q, XT_NC);
    r += 1;
  );
);



function xs_rad(t) ( t == 1 ? 16 : t == 2 ? 12 : t == 3 ? 17 : t == 4 ? 25 : t == 5 ? 7 : t == 6 ? 11 : t == 7 ? 14 : t == 8 ? 16 : t == 9 ? 7 : t == 10 ? 15 : t == 11 ? 18 : t == 12 ? 10 : t == 13 ? 13 : t == 14 ? 16 : t == 15 ? 18 : t == 16 ? 14 : 10; );

function xs_snd(k, fr, gn, dl, pan) ( g_xs_sim ? 0 : db_snd(k, fr, gn, dl, pan); );

function xs_qamp() ( g_xs_qk * exp(-(g_t - g_xs_qk_t) * 2.4); );
function xs_quake(a, zp) ( g_xs_qk = max(xs_qamp(), a); g_xs_qk_t = g_t; g_xs_qph = rand(1) * 100; g_xs_zp = max(g_xs_zp * exp(-(g_t - g_xs_zp_t) * 5), zp); g_xs_zp_t = g_t; );
function xs_bigboom(pan, big)
(
  xs_snd(2, 0, 1, 0, pan); xs_snd(4, 42, 1, 0, 0); xs_snd(4, 31, 0.9, 0.04, 0);
  xs_snd(1, 55, 0.8, 0.02, pan - 0.4); xs_snd(1, 48, 0.8, 0.06, pan + 0.4);
  xs_snd(2, 0, 0.55, 0.28, -0.6); xs_snd(4, 36, 0.6, 0.3, 0);
  xs_snd(2, 0, 0.4, 0.55, 0.6); xs_snd(4, 30, 0.45, 0.6, 0);
  big ? ( xs_snd(2, 0, 0.35, 0.85, 0); xs_snd(4, 26, 0.5, 0.9, 0); xs_snd(1, 40, 0.5, 1.1, 0); );
);

function xs_enemy(t, x, y, hp, a, b, c) local(i, k)
(
  k = -1; i = 0;
  while (k < 0 && i < NXN) ( !xn_t[i] ? k = i; i += 1; );
  k >= 0 ? (
    xn_t[k] = t; xn_x[k] = x; xn_y[k] = y; xn_hp[k] = hp * (1 + 0.12 * (g_xs_lv - 1));
    xn_hp[k] *= max(1, g_xs_pwr) ^ 0.55;
    xn_t0[k] = g_xs_t; xn_a[k] = a; xn_b[k] = b; xn_c[k] = c; xn_f[k] = -10;
    xn_s[k] = g_xs_t + 1 + rand(1) * 2; xn_m[k] = hp;
  );
  k;
);

function xs_ebcap() ( 26; );

function xs_ebul(x, y, vx, vy, k) local(i, n)
(
  n = 0;
  !g_xs_boss ? ( i = 0; loop(NXE, n += xe_a[i]; i += 1; ); );
  (g_xs_boss || n < xs_ebcap()) ? (
    i = g_xs_ei;
    xe_x[i] = x; xe_y[i] = y; xe_vx[i] = vx; xe_vy[i] = vy; xe_a[i] = 1; xe_k[i] = k;
    g_xs_ei = (g_xs_ei + 1) % NXE;
  );
);

function xs_aim(x, y, sp, spread, n) local(a, k, a0)
(
  a = atan2(g_xs_py - y, g_xs_px - x);
  a0 = a - spread * (n - 1) * 0.5;
  k = 0;
  loop(n, xs_ebul(x, y, cos(a0 + k * spread) * sp, sin(a0 + k * spread) * sp, 0); k += 1; );
);

function xs_pbul(x, y, vx, vy, d, k) local(i)
(
  i = g_xs_bi;
  xb_x[i] = x; xb_y[i] = y; xb_vx[i] = vx; xb_vy[i] = vy; xb_d[i] = d; xb_k[i] = k; xb_a[i] = 1; xb_t[i] = g_xs_t;
  g_xs_bi = (g_xs_bi + 1) % NXB;
);

function xs_coin(x, y, v) local(i)
(
  i = g_xs_ci;
  xc_x[i] = x; xc_y[i] = y; xc_vx[i] = (rand(1) - 0.5) * 120; xc_vy[i] = -40 - rand(1) * 80; xc_v[i] = v; xc_a[i] = 1;
  g_xs_ci = (g_xs_ci + 1) % NXC;
);

function xs_wave(x, y, r, cr, cg, cb)
(
  xw_x[g_xs_wi] = x; xw_y[g_xs_wi] = y; xw_t[g_xs_wi] = g_xs_t; xw_r[g_xs_wi] = r;
  xw_c[g_xs_wi] = cr * 1000000 + floor(cg * 999) * 1000 + floor(cb * 999);
  g_xs_wi = (g_xs_wi + 1) % NXW;
);

function xs_boom(x, y, sz, cr, cg, cb) local(k, a, s)
(
  k = 0;
  loop(floor(10 + sz * 14),
    a = rand(1) * 2 * $pi; s = (60 + rand(1) * 260) * (0.5 + sz * 0.5);
    spawn(x, y, cos(a) * s, sin(a) * s, 1, 0.35 + 0.5 * rand(1) * (k & 1), 0.05 + 0.3 * (k % 3 == 0), 0.25 + rand(1) * 0.45 * (0.6 + sz));
    k += 1;
  );
  loop(floor(2 + sz * 3), xs_smoke(x + (rand(1) - 0.5) * 20 * sz, y + (rand(1) - 0.5) * 20 * sz, 10 + 12 * sz * rand(1), 0.8 + rand(1) * 0.8 * sz); );
  g_xs_fl_x = x; g_xs_fl_y = y; g_xs_fl_t = g_xs_t; g_xs_fl_r = 30 + sz * 40;
  xs_wave(x, y, 20 + sz * 40, 1, 0.8, 0.5);
  xs_snd(1, 260 + rand(1) * 200 - sz * 60, min(0.6, 0.18 + sz * 0.15), 0, (x - 450) / 300);
  sz >= 1.5 ? ( xs_snd(2, 0, 0.6, 0, (x - 450) / 300); g_xs_shake = max(g_xs_shake, sz * 3); );
);

function xs_cloud(x, y) local(i, j)
(
  j = -1; i = 0; loop(NXCL, (j < 0 && !xcl_on[i]) ? j = i; i += 1; );
  j >= 0 ? ( xcl_on[j] = 1; xcl_x[j] = x; xcl_y[j] = y; xcl_t[j] = g_xs_t; xs_snd(2, 0, 0.18, 0, (x - 450) / 300); );
);

function xs_lava_mark(x, y) local(i, j)
(
  j = -1; i = 0; loop(NXLV, (j < 0 && !xlv_on[i]) ? j = i; i += 1; );
  j >= 0 ? ( xlv_on[j] = 1; xlv_x[j] = x; xlv_y[j] = y; xlv_t[j] = g_xs_t; xs_snd(1, 520, 0.08, 0, (x - 450) / 300); );
);

function xs_kill(i) local(t, x, y, k, a, v, n, pa, pb)
(
  t = xn_t[i]; x = xn_x[i]; y = xn_y[i]; pa = xn_a[i]; pb = xn_b[i];
  xn_t[i] = 0;
  v = t == 1 ? 120 : t == 2 ? 80 : t == 3 ? 300 : t == 4 ? 500 : t == 5 ? 20 : t == 6 ? 100 : t == 8 ? 250 : t == 9 ? 40 : t == 10 ? 300 : t == 11 ? 300 : t == 12 ? 200 : t == 13 ? 60 : t == 14 ? 350 : t == 15 ? 400 : t == 16 ? (pa ? 300 : 100) : 200;
  g_xs_score += v * g_xs_mul;
  g_xs_kills += 1;
  g_xs_kc += 1;
  g_xs_kc >= 12 ? ( g_xs_kc = 0; g_xs_mul = min(8, g_xs_mul + 1); g_xs_mul_t = g_xs_t; );
  hue(0.1 + 0.15 * t);
  xs_boom(x, y, t == 4 ? 1.4 : t == 3 ? 1 : 0.6, g_hr, g_hg, g_hb);
  n = t == 1 ? 1 : t == 2 ? (rand(1) < 0.6) : t == 3 ? 3 : t == 4 ? 4 : t == 6 ? 1 : t == 7 ? 2 : t == 8 ? 2 : t == 10 ? 2 : t == 11 ? 2 : t == 12 ? 2 : t == 14 ? 3 : t == 15 ? 3 : (t == 16 && pa) ? 2 : 0;
  loop(n, xs_coin(x, y, t == 3 ? 3 : t == 4 ? 3 : 2); );
  t == 4 ? (
    k = 0;
    loop(6, a = k * $pi / 3; n = xs_enemy(5, x + cos(a) * 16, y + sin(a) * 16, 1, cos(a) * 120, sin(a) * 120, 0); k += 1; );
  );
  t == 7 ? ( k = 0; loop(8, a = k * $pi / 4; xs_ebul(x, y, cos(a) * 150, sin(a) * 150, 1); k += 1; ); );
  t == 13 ? xs_cloud(x, y);
  (t == 16 && !pa) ? ( k = xs_enemy(16, x, y, 3, 1, pb, x); xs_snd(1, 300, 0.15, 0, (x - 450) / 300); xs_snd(1, 600, 0.12, 0.25, (x - 450) / 300); );
  t == 8 ? ( k = -1; loop(2, xs_enemy(9, x + k * 8, y, 1, k * (110 + rand(1) * 60), 150 + rand(1) * 60, 0); k += 2; ); xs_snd(1, 1800, 0.12, 0, (x - 450) / 300); );
);

function xs_hurt(i, d) local(k, sh)
(
  sh = 0; k = 0; loop(NXN, (xn_t[k] == 12 && xn_c[k] == i) ? sh = 1; k += 1; );
  (xn_t[i] == 16 && xn_a[i] == 1 && g_xs_t - xn_t0[i] < 0.9) ? sh = 1;
  sh ? spawn(xn_x[i], xn_y[i], (rand(1) - 0.5) * 120, -40 - rand(1) * 60, 0.4, 0.9, 1, 0.15) : (
    xn_hp[i] -= d;
    xn_f[i] = g_xs_t;
    xn_hp[i] <= 0 ? xs_kill(i);
  );
);

function xs_damage(d) local(k)
(
  g_xs_t > g_xs_inv && g_xs_state == 1 ? (
    g_xs_en -= d;
    g_xs_hit_t = g_xs_t; g_xs_inv = g_xs_t + 0.35;
    g_xs_mul = 1; g_xs_kc = 0;
    g_xs_shake = max(g_xs_shake, 4);
    xs_snd(4, 110, 0.3, 0, (g_xs_px - 450) / 300);
    loop(10, k = rand(1) * 2 * $pi; spawn(g_xs_px, g_xs_py, cos(k) * 160, sin(k) * 160, 1, 0.5, 0.3, 0.35); );
    g_xs_en <= 0 ? (
      g_xs_en = 0;
      g_xs_state = 5; g_xs_die_t = g_xs_t;
      xs_boom(g_xs_px, g_xs_py, 2, 1, 0.6, 0.3);
      xs_boom(g_xs_px + 10, g_xs_py - 8, 1.2, 0.5, 0.8, 1);
    );
  );
);

function xs_price(i) local(n)
(
  n = i == 0 ? xs_lv[0] - 1 : (i == 6 || i == 7) ? 0 : xs_lv[i];
  i == 7 ? n = max(0, g_xs_lives - 3);
  ceil(xs_ip[i] * 1.75 ^ n / 5) * 5;
);

function xs_max(i) ( i == 0 ? 5 : i <= 5 ? 2 : i == 8 ? 3 : 0; );

function xs_can(i)
(
  i == 6 ? g_xs_en < 100 : i == 7 ? g_xs_lives < 6 : (i == 0 ? xs_lv[0] < 5 : xs_lv[i] < xs_max(i));
);

function xs_refund(i) local(n)
(
  n = i == 0 ? xs_lv[0] - 2 : xs_lv[i] - 1;
  ceil(xs_ip[i] * 1.75 ^ n / 10) * 5;
);

function xs_buy(i) local(p)
(
  p = xs_price(i);
  xs_can(i) && g_xs_cr >= p ? (
    g_xs_cr -= p;
    i == 6 ? g_xs_en = 100 : i == 7 ? g_xs_lives += 1 : xs_lv[i] += 1;
    xs_snd(3, db_note(19 + i), 0.3, 0, 0); xs_snd(0, db_note(26 + i), 0.2, 0.08, 0);
    g_xs_buy_t = g_t; g_xs_buy_i = i;
    1;
  ) : ( xs_snd(4, 150, 0.2, 0, 0); 0; );
);

function xs_sell(i)
(
  ((i == 0 && xs_lv[0] > 1) || (i >= 1 && i <= 5 && xs_lv[i] > 0) || (i == 8 && xs_lv[8] > 0)) ? (
    g_xs_cr += xs_refund(i);
    xs_lv[i] -= 1;
    xs_snd(0, db_note(14), 0.25, 0, 0);
  );
);

function xs_clear() local(i)
(
  memset(xb_a, 0, NXB); memset(xe_a, 0, NXE); memset(xn_t, 0, NXN); memset(xc_a, 0, NXC); memset(xw_t, 0, NXW); memset(xcl_on, 0, NXCL); memset(xlv_on, 0, NXLV); memset(xo_on, 0, NXO);
  i = 0; loop(NQ, ql[i] = 0; i += 1; );
);

function xs_level(lv) local(i)
(
  g_xs_lv = lv;
  g_xs_th = floor((lv - 1) / 2) % 5;
  g_xs_sd = rand(1) * 100;
  g_xs_len = 10400 + 800 * min(lv, 5);
  g_xs_sc = 0; g_xs_next = 420; g_xs_mid = 0;
  memset(xq_on, 0, NXQ); g_xs_cgn = 1100; g_xs_cgs = rand(1) < 0.5; g_xs_cgt = -10;
  g_xs_boss = 0;
  xs_map_gen();
  xs_clear();
  g_xs_px = 450; g_xs_py = XS_Y1 - 90; g_xs_vx = 0; g_xs_vy = 0;
  g_xs_inv = g_xs_t + 2;
  g_xs_state = 8; g_xs_cd_t = g_xs_t; g_xs_cdn = -1;
  g_xs_px = 450; g_xs_py = XS_Y1 + 40;
  g_xs_lv_t = g_xs_t;
  g_xs_bgw = 0;
  i = 0; loop(12, xs_snap[i] = xs_lv[i]; i += 1; );
  xs_snap[12] = g_xs_score; xs_snap[13] = g_xs_cr; xs_snap[14] = g_xs_lives; xs_snap[15] = lv;
  g_xs_trk = xs_ltrk();
);

function xs_new() local(i)
(
  memset(xs_lv, 0, 12);
  xs_lv[0] = 1; xs_lv[8] = 1;
  g_xs_score = 0; g_xs_disp = 0; g_xs_cr = 40; g_xs_lives = 3; g_xs_en = 100; g_xs_mul = 1; g_xs_kc = 0; g_xs_kills = 0;
  g_xs_t = max(g_xs_t, 1);
  g_xs_zoom = 1; g_xs_ts = 1; g_xs_fin_rt = -10; g_xs_flash_t = -10; g_xs_blast_t = -100; g_xs_qk = 0; g_xs_zp = 0; g_xs_pwr = 1;
  sv2[42] += 1;
  xs_level(1);
);

function xs_retry() local(i)
(
  i = 0; loop(12, xs_lv[i] = xs_snap[i]; i += 1; );
  g_xs_score = xs_snap[12]; g_xs_disp = g_xs_score; g_xs_cr = xs_snap[13]; g_xs_lives = max(3, xs_snap[14]);
  g_xs_en = 100; g_xs_mul = 1; g_xs_kc = 0;
  xs_level(g_xs_lv);
);

function xs_resume() local(i)
(
  i = 0; loop(12, xs_lv[i] = xs_snap[i]; i += 1; );
  g_xs_score = xs_snap[12]; g_xs_disp = g_xs_score; g_xs_cr = xs_snap[13]; g_xs_lives = xs_snap[14];
  g_xs_en = 100; g_xs_mul = 1; g_xs_kc = 0; g_xs_kills = 0;
  g_xs_t = max(g_xs_t, 1);
  g_xs_zoom = 1; g_xs_ts = 1; g_xs_fin_rt = -10; g_xs_flash_t = -10; g_xs_blast_t = -100; g_xs_qk = 0; g_xs_zp = 0; g_xs_pwr = 1;
  xs_level(xs_snap[15]);
);

function xs_ckpt() local(i)
(
  i = 0; loop(12, xs_snap[i] = xs_lv[i]; i += 1; );
  xs_snap[12] = g_xs_score; xs_snap[13] = g_xs_cr; xs_snap[14] = g_xs_lives; xs_snap[15] = g_xs_lv + 1;
);

function xs_mount() local(r, c, n, pick, k, rr)
(
  n = 0; pick = -1;
  rr = floor((g_xs_sc + BRD_H + 20) / XT);
  k = 0;
  loop(3,
    r = rr + k;
    c = 0;
    loop(XT_NC,
      xs_cell(c, r) ? (
        (!xs_cell(c, r - 1) && !xs_cell(c, r - 2)) ? ( n += 1; rand(1) * n < 1 ? ( pick = 0; g_xs_mx = XS_X0 + (c + 0.5) * XT; g_xs_mw = r * XT; g_xs_mf = 0; ); );
        (!xs_cell(c + 1, r) && !xs_cell(c + 2, r) && c < 10) ? ( n += 1; rand(1) * n < 1 ? ( pick = 0; g_xs_mx = XS_X0 + (c + 1) * XT; g_xs_mw = (r + 0.5) * XT; g_xs_mf = 1; ); );
        (!xs_cell(c - 1, r) && !xs_cell(c - 2, r) && c >= 10) ? ( n += 1; rand(1) * n < 1 ? ( pick = 0; g_xs_mx = XS_X0 + c * XT; g_xs_mw = (r + 0.5) * XT; g_xs_mf = 2; ); );
      );
      c += 1;
    );
    k += 1;
  );
  pick == 0;
);

function xs_wnew(slot) local(w)
(
  w = floor((g_xs_lv - 1) / 2) % 5;
  w == 0 ? w = 1 + floor(rand(1) * 4);
  (w > 1 && rand(1) < 0.25) ? w -= 1;
  w == 1 ? (slot ? 10 : 8) : w == 2 ? (slot ? 11 : 12) : w == 3 ? (slot ? 13 : 14) : (slot ? 15 : 16);
);

function xs_spawn_new(t) local(n, k, x, j, side)
(
  t == 8 ? ( n = 2 + (rand(1) < 0.5); k = 0; loop(n, xs_enemy(8, XS_X0 + 110 + rand(1) * (XS_W - 220), XS_Y0 - 20 - k * 70, 7, 0, rand(1) * 6, 0); k += 1; ); ) :
  t == 10 ? ( n = 1 + (rand(1) < 0.4); k = 0; loop(n, xs_enemy(10, XS_X0 + 90 + rand(1) * (XS_W - 180), XS_Y0 - 30, 5, g_xs_t + k * 1.1, XS_Y0 + 55 + rand(1) * 50 + k * 30, g_xs_px); k += 1; ); ) :
  t == 12 ? (
    x = XS_X0 + 140 + rand(1) * (XS_W - 280); j = -1; k = 0;
    loop(4, n = xs_enemy(1, x + (k - 1.5) * 40, XS_Y0 - 20 - k * 45, 3, 0, rand(1) * 6, 0); k == 1 ? j = n; k += 1; );
    xs_enemy(12, x, XS_Y0 - 90, 4, 0, 0, j);
  ) :
  t == 11 ? ( n = 1 + (rand(1) < 0.5); k = 0; loop(n, side = rand(1) < 0.5 ? -1 : 1; xs_enemy(11, 450 - side * 230, XS_Y0 - 30, 8, g_xs_t + 1.2 + k * 1.4, XS_Y0 + 140 + rand(1) * 220, side); k += 1; ); ) :
  t == 14 ? ( k = 0; loop(2, xs_enemy(14, XS_X0 + 100 + rand(1) * (XS_W - 200), XS_Y0 - 30 - k * 60, 10, 0, 0, 0); k += 1; ); ) :
  t == 13 ? ( k = 0; loop(3, xs_enemy(13, XS_X0 + 90 + (k + rand(1) * 0.6) * (XS_W - 180) / 3, XS_Y0 - 20 - rand(1) * 80, 3, 0, rand(1) * 6, 0); k += 1; ); ) :
  t == 16 ? ( n = 2 + (rand(1) < 0.5); x = XS_X0 + 120 + rand(1) * (XS_W - 240); k = 0; loop(n, xs_enemy(16, x, XS_Y0 - 20 - k * 55, 5, 0, k * 0.8, 0); k += 1; ); ) :
  ( side = rand(1) < 0.5 ? -1 : 1; xs_enemy(15, 450 - side * 300, XS_Y0 + 40 + rand(1) * 30, 9, g_xs_t + 1, 0, side); );
);

function xs_spawn() local(r, n, k, x, side, w, d, lv)
(
  lv = g_xs_lv;
  r = rand(1);
  d = min(1 / 6, (lv - 1) / 6);
  w = floor((lv - 1) / 2) % 5; w == 0 && lv >= 11 ? w = 4;
  (lv >= 3 && rand(1) < 0.22 + 0.07 * w) ? ( xs_spawn_new(xs_wnew(rand(1) < 0.5)); r = 2; );
  r > 1 ? 0 : r < 0.24 ? (
    n = 4 + floor(rand(1) * 3) + floor(d * 3);
    k = 0;
    loop(n, xs_enemy(1, XS_X0 + 90 + rand(1) * (XS_W - 180), XS_Y0 - 20 - k * 50, 3, 0, rand(1) * 6, 0); k += 1; );
  ) : r < 0.5 ? (
    n = 7 + floor(d * 3); side = rand(1) < 0.5 ? -1 : 1;
    x = 450 + side * (60 + rand(1) * 90);
    k = 0;
    loop(n, xs_enemy(2, x, XS_Y0 - 20, 1, x, k * 0.22, -side); k += 1; );
  ) : r < 0.68 ? (
    xs_mount() ? (
      k = xs_enemy(3, g_xs_mx, 0, 6, g_xs_mx, 0, g_xs_mf);
      k >= 0 ? xn_w[k] = g_xs_mw;
    ) : xs_enemy(4, 450 + (rand(1) - 0.5) * 200, XS_Y0 - 30, 14, 0, rand(1) * 6, 0);
  ) : r < 0.8 ? (
    lv >= 3 ? xs_spawn_new(xs_wnew(0)) : xs_enemy(4, 450 + (rand(1) - 0.5) * 220, XS_Y0 - 30, 14, 0, rand(1) * 6, 0);
  ) : (lv >= 3 && r < 0.87) ? (
    xs_spawn_new(xs_wnew(1));
  ) : r < 0.92 || lv < 3 ? (
    n = 7 + floor(d * 4);
    x = 450 + (rand(1) - 0.5) * 140;
    k = rand(1) * 6;
    side = 0;
    loop(n, xs_enemy(6, x, XS_Y0 - 20, 3, k, side * 0.17, 0); side += 1; );
  ) : (
    n = 2 + floor(d * 2);
    loop(n, xs_enemy(7, XS_X0 + 100 + rand(1) * (XS_W - 200), XS_Y0 - 20 - rand(1) * 80, 5, 0, rand(1) * 6, 0); );
  );
  g_xs_next = g_xs_sc + (150 - 45 * d) * (0.7 + 0.5 * rand(1)) / g_xs_pwr ^ 0.25;
);


function xs_part(k, ox, oy, r, hp, role, kind)
(
  xp_on[k] = 1; xp_ox[k] = ox; xp_oy[k] = oy; xp_r[k] = r; xp_hp[k] = hp; xp_hm[k] = hp;
  xp_role[k] = role; xp_k[k] = kind; xp_f[k] = -10; xp_s[k] = g_xs_t + 1.5 + k * 0.3;
);

function xs_cg_face(w, side) ( xs_span(floor(w / XT)); side ? XS_X0 + (g_xs_fb + 1) * XT : XS_X0 + g_xs_fa * XT; );

function xs_cg_add(w, side) local(i, j)
(
  j = -1; i = 0; loop(NXQ, (j < 0 && !xq_on[i]) ? j = i; i += 1; );
  j >= 0 ? ( xq_on[j] = 1; xq_w[j] = w; xq_s[j] = side; xq_e[j] = XQ_MAX; );
);

function xs_cg_update(dt) local(i, y, xf, d, a)
(
  (g_xs_boss == 0 && g_xs_sc >= g_xs_cgn) ? (
    a = g_xs_sc + (XS_Y1 - XS_Y0) + 90;
    (a < g_xs_len - 700 && abs(a - g_xs_len * 0.5) > 320) ? ( xs_cg_add(a, g_xs_cgs); g_xs_cgs = 1 - g_xs_cgs; );
    g_xs_cgn += 1250 + rand(1) * 450;
  );
  i = 0;
  loop(NXQ,
    xq_on[i] ? (
      y = xs_wy(xq_w[i]);
      y > XS_Y1 + 120 ? xq_on[i] = 0 : (
        xf = xs_cg_face(xq_w[i], xq_s[i]);
        d = xq_s[i] ? xf - g_xs_px : g_xs_px - xf;
        (g_xs_state == 1 && abs(g_xs_py - y) < 62 && d < 80 && xq_e[i] > 0 && g_xs_en < 100) ? (
          a = min(min(42 * dt, xq_e[i]), 100 - g_xs_en);
          g_xs_en += a; xq_e[i] -= a;
          g_xs_cgt = g_xs_t; g_xs_cgi = i;
          g_xs_t > g_xs_cgsnd ? ( xs_snd(1, 500 + g_xs_en * 9, 0.05, 0, (g_xs_px - 450) / 300); g_xs_cgsnd = g_xs_t + 0.11; );
          rand(1) < dt * 30 ? spawn(g_xs_px + (rand(1) - 0.5) * 20, g_xs_py + (rand(1) - 0.5) * 20, (rand(1) - 0.5) * 80, -40 - rand(1) * 60, 0.4, 1, 0.7, 0.4);
        );
      );
    );
    i += 1;
  );
);

function xs_cg_draw() local(i, y, xf, f, k, a, sg, px, py, x0, w, jx, jy, h)
(
  i = 0;
  loop(NXQ,
    xq_on[i] ? (
      y = xs_wy(xq_w[i]);
      (y > XS_Y0 - 80 && y < XS_Y1 + 80) ? (
        xf = xs_cg_face(xq_w[i], xq_s[i]); sg = xq_s[i] ? -1 : 1;
        f = xq_e[i] / XQ_MAX;
        a = 0.6 + 0.4 * sin(g_xs_t * 5 + i);
        w = 84 * g_s; h = 124 * g_s;
        gfx_mode = 1;
        xq_s[i] ? gfx_gradrect(sx(xf) - w, sy(y - 62), w, h, 0.3, 1, 0.6, 0, 0, 0, 0, 0.16 * f * a / w, 0, 0, 0, 0)
                : gfx_gradrect(sx(xf), sy(y - 62), w, h, 0.3, 1, 0.6, 0.16 * f * a, 0, 0, 0, -0.16 * f * a / w, 0, 0, 0, 0);
        k = 0;
        loop(7,
          py = y - 54 + k * 18; x0 = xf + sg * 80;
          f > 0.02 ? gfx_set(0.4, 1, 0.7, 0.5 * f) : gfx_set(1, 0.3, 0.2, 0.25);
          gfx_rect(sx(x0) - g_s, sy(py), 2 * g_s, 9 * g_s);
          k += 1;
        );
        k = 0;
        loop(4,
          px = xf + sg * (12 + ((k * 18 + g_xs_t * 40) % 72));
          f > 0.02 ? gfx_set(0.5, 1, 0.75, 0.55 * f * (1 - ((k * 18 + g_xs_t * 40) % 72) / 72)) : gfx_set(0, 0, 0, 0);
          gfx_triangle(sx(px), sy(y - 12), sx(px + sg * 9), sy(y), sx(px), sy(y + 12));
          gfx_triangle(sx(px - sg * 5), sy(y - 12), sx(px + sg * 4), sy(y), sx(px - sg * 5), sy(y + 12));
          k += 1;
        );
        gfx_mode = 0;
        x0 = xq_s[i] ? xf : xf - 14;
        gfx_set(0.04, 0.05, 0.05, 1); gfx_rect(sx(x0 - 2), sy(y - 66), 18 * g_s, 132 * g_s);
        gfx_set(0.2, 0.22, 0.24, 1); gfx_rect(sx(x0), sy(y - 64), 14 * g_s, 128 * g_s);
        k = 0;
        loop(10,
          py = y - 60 + k * 12;
          (k + 0.5) / 10 >= 1 - f ? gfx_set(0.3 + 0.3 * a, 1, 0.55 + 0.2 * a, 1) : gfx_set(0.12, 0.16, 0.14, 1);
          f <= 0.02 ? gfx_set(0.35, 0.1, 0.08, 1);
          gfx_rect(sx(x0 + 3), sy(py), 8 * g_s, 8 * g_s);
          k += 1;
        );
        gfx_set(0.95, 0.75, 0.1, 1); gfx_rect(sx(x0), sy(y - 64), 14 * g_s, 3 * g_s); gfx_rect(sx(x0), sy(y + 61), 14 * g_s, 3 * g_s);
        (g_xs_cgi == i && g_xs_t - g_xs_cgt < 0.08) ? (
          gfx_mode = 1;
          k = 0;
          loop(3,
            jx = xf; jy = y + (k - 1) * 30;
            gfx_set(0.6, 1, 0.8, 0.7);
            loop(5,
              px = jx + (g_xs_px - xf) / 5 + (rand(1) - 0.5) * 6; py = jy + (g_xs_py - jy) / 5 * 1 + (rand(1) - 0.5) * 16;
              tline(sx(jx), sy(jy), sx(px), sy(py), 1.6 * g_s);
              jx = px; jy = py;
            );
            k += 1;
          );
          gfx_set(0.4, 1, 0.6, 0.3); gfx_circle(sx(g_xs_px), sy(g_xs_py), 30 * g_s, 1, 1);
          gfx_mode = 0;
        );
      );
    );
    i += 1;
  );
);

function xs_boss_type(lv) local(m) ( m = (lv - 1) % 10; m == 0 ? 6 : m == 2 ? 11 : m == 4 ? 12 : m == 6 ? 13 : m == 8 ? 14 : m == 9 ? 4 : (m - 1) / 2; );


function xs_boss_start() local(h, k, a)
(
  g_xs_boss = 1; g_xs_bt0 = g_xs_t;
  g_xs_bt = xs_boss_type(g_xs_lv);
  h = (1 + 0.3 * (g_xs_lv - 1)) * xs_power() ^ 0.7;
  g_xs_bx = 450; g_xs_by = XS_Y0 - 170; g_xs_bsa = 0; g_xs_bph = 1; g_xs_bsp = g_xs_t + 4;
  memset(xp_on, 0, NXP); memset(xp_bt, 0, NXP); memset(xp_d, 0, NXP);
  g_xs_bt == 0 ? (
    xs_part(0, -66, -2, 15, 30 * h, 1, 1);
    xs_part(1, 66, -2, 15, 30 * h, 1, 1);
    xs_part(2, 0, 34, 22, 80 * h, 2, 2);
    xs_part(3, -92, 70, 9, 1, 0, 3);
    xs_part(4, -36, 96, 9, 1, 0, 3);
    xs_part(5, 36, 96, 9, 1, 0, 3);
    xs_part(6, 92, 70, 9, 1, 0, 3);
    xs_part(7, 0, -26, 62, 1, 0, 0);
  ) : g_xs_bt == 1 ? (
    xs_part(0, -112, 40, 24, 36 * h, 1, 6);
    xs_part(1, 112, 40, 24, 36 * h, 1, 6);
    xs_part(2, 0, -26, 14, 26 * h, 1, 1);
    xs_part(3, 0, 34, 20, 95 * h, 2, 7);
    xs_part(4, 0, -6, 66, 1, 0, 0);
    xs_part(5, 0, -118, 12, 1, 0, 10);
  ) : g_xs_bt == 2 ? (
    xs_part(0, 0, 0, 26, 60 * h, 2, 8);
    k = 1;
    loop(9,
      (k & 1) ? xs_part(k, 0, 0, 16, 8 * h, 1, 11) : xs_part(k, 0, 0, 17, 1, 0, 0);
      xp_d[k] = k * 0.2;
      k += 1;
    );
  ) : g_xs_bt == 3 ? (
    k = 0;
    loop(4, a = $pi * (0.15 + 0.7 * k / 3); xs_part(k, cos(a) * 86, sin(a) * 50 + 30, 16, 28 * h, 1, 9); k += 1; );
    xs_part(4, 0, 46, 24, 110 * h, 2, 10);
    k = 0; loop(4, xs_part(5 + k, 0, 0, 26, 1, 0, 0); k += 1; );
    xs_part(9, 0, -16, 64, 1, 0, 0);
  ) : g_xs_bt == 4 ? (
    xs_part(0, -126, 0, 20, 44 * h, 1, 6);
    xs_part(1, 126, 0, 20, 44 * h, 1, 6);
    xs_part(2, -62, 58, 15, 36 * h, 1, 7);
    xs_part(3, 62, 58, 15, 36 * h, 1, 7);
    xs_part(4, 0, 26, 32, 240 * h, 2, 2);
    xs_part(5, 0, -42, 116, 1, 0, 0);
    xs_part(6, 0, 112, 12, 1, 0, 3);
  ) : g_xs_bt == 11 ? (
    k = 0; loop(3, xs_part(k, 0, 0, 15, 24 * h, 1, 1); k += 1; );
    xs_part(3, 0, 0, 24, 80 * h, 2, 10);
    xs_part(4, 0, 0, 66, 1, 0, 0);
  ) : g_xs_bt == 12 ? (
    xs_part(0, -128, 30, 26, 32 * h, 1, 4);
    xs_part(1, 128, 30, 26, 32 * h, 1, 4);
    xs_part(2, 0, 2, 22, 90 * h, 2, 8);
    xs_part(3, 0, -4, 70, 1, 0, 0);
  ) : g_xs_bt == 13 ? (
    xs_part(0, -122, 34, 13, 20 * h, 1, 9);
    xs_part(1, 122, 34, 13, 20 * h, 1, 9);
    xs_part(2, -86, 104, 13, 20 * h, 1, 3);
    xs_part(3, 86, 104, 13, 20 * h, 1, 3);
    xs_part(4, 0, 14, 26, 100 * h, 2, 7);
    xs_part(5, 0, -10, 66, 1, 0, 0);
  ) : g_xs_bt == 14 ? (
    k = 0; loop(4, xs_part(k, 0, 0, 14, 28 * h, 1, 5); k += 1; );
    xs_part(4, 0, 0, 30, 120 * h, 2, 2);
    xs_part(5, 0, 0, 72, 1, 0, 0);
  ) : (
    xs_part(0, -66, 22, 16, 18 * h, 1, 4);
    xs_part(1, 66, 22, 16, 18 * h, 1, 4);
    xs_part(2, 0, 44, 16, 44 * h, 2, 7);
    xs_part(3, 0, -8, 56, 1, 0, 0);
  );
  memset(xq_on, 0, NXQ);
  g_xs_trk = 17;
  xs_snd(2, 0, 0.7, 0, 0); xs_snd(4, 60, 0.6, 0.2, 0); xs_snd(1, 80, 0.5, 0.4, 0);
);

function xs_orb(x, y) local(i, j)
(
  j = -1; i = 0; loop(NXO, (j < 0 && !xo_on[i]) ? j = i; i += 1; );
  j >= 0 ? ( xo_on[j] = 1; xo_x[j] = x; xo_y[j] = y; xo_t[j] = g_xs_t; xo_vx[j] = (rand(1) - 0.5) * 120; xo_vy[j] = -50 - rand(1) * 40; );
);

function xs_part_kill(k) local(j)
(
  xp_on[k] = 0;
  xs_boom(xp_x[k], xp_y[k], 1.6, 1, 0.7, 0.3);
  g_xs_score += 2000 * g_xs_mul;
  loop(4, xs_coin(xp_x[k], xp_y[k], 3); );
  j = 0; loop(NXP, (xp_on[j] && xp_role[j] >= 1) ? j = 100; j += 1; );
  j >= 100 ? xs_orb(xp_x[k], xp_y[k]);
  j < 100 ? (
    g_xs_boss = 3; g_xs_bdie_t = g_xs_t; g_xs_fin_rt = g_t; g_xs_fx = g_xs_bx; g_xs_fy = g_xs_by;
    g_xs_trk = 19;
    memset(xe_a, 0, NXE);
    g_xs_score += 20000 * (1 + floor(g_xs_lv / 2)) * (g_xs_bt == 4 ? 5 : 1);
  );
);

function xs_core_open() local(j, o)
(
  o = 1; j = 0; loop(NXP, (xp_on[j] && xp_role[j] == 1) ? o = 0; j += 1; );
  o;
);

function xs_part_hit(k, d)
(
  (xp_role[k] == 1 || (xp_role[k] == 2 && xs_core_open())) && g_xs_boss == 2 ? (
    xp_hp[k] -= d; xp_f[k] = g_xs_t;
    xp_hp[k] <= 0 ? xs_part_kill(k);
    1;
  ) : 0;
);

function xs_spath(t) ( g_xs_qx = 450 + 185 * sin(t * 0.62) + 40 * sin(t * 1.7); g_xs_qy = XS_Y0 + 150 + 80 * sin(t * 1.15 + 1) + 30 * sin(t * 0.4); );

function xs_boss_update(dt) local(k, t, bs, x, y, a, open, ph, f, lt)
(
  t = g_xs_t - g_xs_bt0;
  bs = (1 + 0.06 * (g_xs_lv - 1)) * xs_power() ^ 0.2;
  open = xs_core_open();
  ph = 1;
  g_xs_bt == 4 ? (
    ph = !open ? 1 : (xp_on[4] && xp_hp[4] < xp_hm[4] * 0.5) ? 3 : 2;
    (ph != g_xs_bph) ? ( g_xs_bph = ph; g_xs_shake = 10; xs_snd(2, 0, 0.9, 0, 0); xs_snd(4, 50, 0.6, 0, 0); g_xs_phase_t = g_xs_t; );
  );
  g_xs_boss == 1 ? (
    g_xs_bt == 2 ? ( xs_spath(t - 3); g_xs_bx = g_xs_qx; g_xs_by = g_xs_qy - (1 - min(1, t / 3)) * 300; ) :
    g_xs_by += (XS_Y0 + 140 - g_xs_by) * min(1, dt * 1.4);
    t > 3 ? g_xs_boss = 2;
  ) : g_xs_boss == 2 ? (
    g_xs_bt == 4 ? (
      f = ph == 3 ? 1.8 : 1;
      g_xs_bx = 450 + 80 * sin(t * 0.33 * f) + 30 * sin(t * 0.9 * f);
      g_xs_by = XS_Y0 + 165 + 22 * sin(t * 0.6 * f);
    ) : g_xs_bt == 1 ? (
      g_xs_bx = 450 + 150 * sin(t * 0.8) + 30 * sin(t * 2.3);
      f = frac(t / 7);
      g_xs_by = XS_Y0 + 140 + (f > 0.8 ? sin((f - 0.8) / 0.2 * $pi) * 170 : 0);
    ) : g_xs_bt == 2 ? (
      xs_spath(t - 3); g_xs_bx = g_xs_qx; g_xs_by = g_xs_qy;
    ) : g_xs_bt == 3 ? (
      g_xs_bx = 450 + 70 * sin(t * 0.35); g_xs_by = XS_Y0 + 150 + 14 * sin(t * 0.9);
    ) : (
      g_xs_bx = 450 + (g_xs_bt == 0 ? 120 : g_xs_bt == 11 ? 90 : g_xs_bt == 12 ? 60 : g_xs_bt == 13 ? 80 : g_xs_bt == 14 ? 80 : 150) * sin(t * (g_xs_bt == 0 ? 0.45 : 0.6));
      g_xs_by = XS_Y0 + 140 + 16 * sin(t * 1.1);
    );
  );
  k = 0;
  loop(NXP,
    xp_on[k] ? (
      x = xp_ox[k]; y = xp_oy[k];
      xp_k[k] == 3 ? ( x += 14 * sin(t * 1.4 + k); y += 10 * sin(t * 1.9 + k * 1.7); );
      (g_xs_bt == 1 && k <= 1) ? ( y += 14 * sin(t * 2.2 + k * 3); x += (k ? 1 : -1) * 10 * sin(t * 1.3); );
      (g_xs_bt == 3 && k >= 5 && k <= 8) ? ( a = t * 0.8 + (k - 5) * $pi * 0.5; x = cos(a) * 100; y = sin(a) * 70 + 10; );
      (g_xs_bt == 11 && k <= 2) ? ( a = t * 0.7 + k * 2 * $pi / 3; x = cos(a) * 104; y = sin(a) * 70; );
      (g_xs_bt == 12 && k <= 1) ? ( y += 34 * max(0, sin(t * 1.7 + k * $pi)) ^ 3 - 10; );
      (g_xs_bt == 13 && k <= 1) ? ( x += (k ? 1 : -1) * 10 * sin(t * 1.2 + k); y += 16 * sin(t * 1.5 + k * 2); );
      (g_xs_bt == 14 && k <= 3) ? ( a = -t * 0.32 + k * $pi * 0.5 + 0.4; x = cos(a) * 112; y = sin(a) * 74 + 6; );
      xp_x[k] = g_xs_bx + x; xp_y[k] = g_xs_by + y;
      g_xs_bt == 2 ? ( xs_spath(t - 3 - xp_d[k]); xp_x[k] = g_xs_qx; xp_y[k] = g_xs_qy - (g_xs_boss == 1 ? (1 - min(1, t / 3)) * 300 : 0); );
      (xp_k[k] == 7 && xp_bt[k] > 0) ? (
        lt = g_xs_t - xp_bt[k];
        lt > 0.8 && lt < 1.45 ? (
          x = g_xs_px - xp_x[k]; y = g_xs_py - xp_y[k];
          f = x * cos(xp_bx[k]) + y * sin(xp_bx[k]);
          (f > 0 && abs(-x * sin(xp_bx[k]) + y * cos(xp_bx[k])) < 20) ? xs_damage(14);
          rand(1) < 0.5 ? ( f = 100 + rand(1) * 400; spawn(xp_x[k] + cos(xp_bx[k]) * f + (rand(1) - 0.5) * 20, xp_y[k] + sin(xp_bx[k]) * f, (rand(1) - 0.5) * 200, -rand(1) * 200, 1, 0.5, 0.6, 0.3); );
        );
        lt > 1.45 ? xp_bt[k] = 0;
      );
      (g_xs_boss == 2 && g_xs_t > xp_s[k] && g_xs_state == 1 && (xp_role[k] != 2 || open)) ? (
        x = xp_x[k]; y = xp_y[k];
        xp_k[k] == 1 ? ( xs_aim(x, y, 185 * bs, 0.2, 3); xp_s[k] = g_xs_t + 1.4 / bs; xs_snd(4, 300, 0.08, 0, 0); ) :
        xp_k[k] == 2 ? (
          a = g_xs_bsa; g_xs_bsa += ph == 3 ? 0.29 : 0.37;
          f = 0;
          loop(ph == 3 ? 3 : 2, xs_ebul(x, y, cos(a + f * 2 * $pi / (ph == 3 ? 3 : 2)) * 150 * bs, sin(a + f * 2 * $pi / (ph == 3 ? 3 : 2)) * 150 * bs, 2); f += 1; );
          xp_s[k] = g_xs_t + (ph == 3 ? 0.06 : 0.1);
          g_xs_t > g_xs_bst ? ( a = 0; loop(18, xs_ebul(x, y, cos(a) * 120 * bs, sin(a) * 120 * bs, 1); a += $pi / 9; ); g_xs_bst = g_xs_t + (ph == 3 ? 2 : 3.2) / bs; );
        ) :
        xp_k[k] == 3 ? ( xs_aim(x, y, 125 * bs, 0, 1); xp_s[k] = g_xs_t + 2.4 + rand(1); ) :
        xp_k[k] == 4 ? ( a = -2; loop(5, xs_ebul(x, y, sin(a * 0.22) * 175 * bs, cos(a * 0.22) * 175 * bs, 0); a += 1; ); xp_s[k] = g_xs_t + 1.7 / bs; ) :
        xp_k[k] == 5 ? ( xs_aim(x, y, 200 * bs, 0.16, 3); xp_s[k] = g_xs_t + 0.9 / bs; ) :
        xp_k[k] == 6 ? ( xs_aim(x, y, 210 * bs, 0.13, 9); xp_s[k] = g_xs_t + 1.7 / bs; xs_snd(1, 1500, 0.12, 0, (x - 450) / 300); ) :
        xp_k[k] == 7 ? (
          xp_bt[k] == 0 ? ( xp_bt[k] = g_xs_t; xp_bx[k] = atan2(g_xs_py - y, g_xs_px - x); xs_snd(4, 90, 0.3, 0, 0); xs_snd(4, 95, 0.25, 0.8, 0); xs_snd(1, 300, 0.4, 0.8, 0); );
          xp_s[k] = g_xs_t + (ph == 3 ? 2.6 : 3.6) / bs;
        ) :
        xp_k[k] == 8 ? (
          frac(t / 3.2) < 0.4 ? (
            a = atan2(g_xs_py - y, g_xs_px - x) + (rand(1) - 0.5) * 0.6;
            xs_ebul(x, y + 10, cos(a) * 250 * bs, sin(a) * 250 * bs, 4);
            xp_s[k] = g_xs_t + 0.05;
            rand(1) < 0.3 ? xs_snd(1, 200 + rand(1) * 100, 0.06, 0, (x - 450) / 300);
          ) : ( xs_aim(x, y, 190 * bs, 0.25, 3); xp_s[k] = g_xs_t + 0.6; );
        ) :
        xp_k[k] == 9 ? ( loop(2, f = xs_enemy(5, x, y + 10, 1, (rand(1) - 0.5) * 160, 80 + rand(1) * 60, 0); ); xp_s[k] = g_xs_t + 2.8 / bs; xs_snd(1, 400, 0.15, 0, (x - 450) / 300); ) :
        xp_k[k] == 10 ? ( a = rand(1); loop(20, xs_ebul(x, y, cos(a) * 140 * bs, sin(a) * 140 * bs, 1); a += $pi / 10; ); xs_aim(x, y, 220 * bs, 0.1, 2); xp_s[k] = g_xs_t + 2.5 / bs; ) :
        ( xs_aim(x, y, 235 * bs, 0, 1); xp_s[k] = g_xs_t + 1.4 / bs; );
      );
    );
    k += 1;
  );
  (g_xs_bt == 4 && ph >= 2 && g_xs_boss == 2 && g_xs_t > g_xs_bsp) ? (
    k = 0; loop(ph == 3 ? 6 : 4, xs_enemy(k & 1 ? 5 : 2, g_xs_bx + (rand(1) - 0.5) * 200, g_xs_by + 60, 1, g_xs_bx + (rand(1) - 0.5) * 200, k * 0.15, rand(1) < 0.5 ? -1 : 1); k += 1; );
    g_xs_bsp = g_xs_t + (ph == 3 ? 3 : 4.5);
  );
  g_xs_boss == 3 ? (
    t = g_xs_t - g_xs_bdie_t;
    rand(1) < dt * (10 + t * 8) ? ( xs_boom(g_xs_bx + (rand(1) - 0.5) * 200, g_xs_by + (rand(1) - 0.5) * 140, 0.8 + rand(1), 1, 0.6 + rand(1) * 0.3, 0.3); xs_quake(0.18 + 0.12 * t, 0); );
    g_xs_bt == 2 ? ( k = floor(rand(1) * NXP); xp_x[k] ? xs_boom(xp_x[k], xp_y[k], 0.7, 1, 0.6, 0.3); );
    t > 2.4 ? (
      xs_boom(g_xs_bx, g_xs_by, 3, 1, 0.9, 0.6);
      xs_boom(g_xs_bx - 70, g_xs_by + 20, 2.2, 1, 0.5, 0.15); xs_boom(g_xs_bx + 70, g_xs_by - 10, 2.2, 1, 0.6, 0.2);
      xs_wave(g_xs_bx, g_xs_by, 260, 1, 1, 1); xs_wave(g_xs_bx, g_xs_by, 420, 1, 0.6, 0.2); xs_wave(g_xs_bx, g_xs_by, 600, 1, 0.25, 0.1);
      k = 0; loop(90, a = rand(1) * 2 * $pi; f = 200 + rand(1) * 700; spawn(g_xs_bx, g_xs_by, cos(a) * f, sin(a) * f, 1, 0.4 + rand(1) * 0.5, 0.1 + rand(1) * 0.2, 0.6 + rand(1) * 0.9); k += 1; );
      g_xs_shake = 12;
      xs_quake(1.3, 0.16);
      g_xs_hs = g_t + 0.32;
      g_xs_blast_t = g_t;
      xs_bigboom((g_xs_bx - 450) / 300, 1);
      loop(g_xs_bt == 4 ? 40 : 22, xs_coin(g_xs_bx + (rand(1) - 0.5) * 160, g_xs_by + (rand(1) - 0.5) * 80, 5); );
      g_xs_boss = 4; g_xs_state = 4; g_xs_clr_t = g_xs_t;
    );
  );
);

function xs_nearest(x, y) local(i, d, best, bx, by)
(
  best = 1000000000; g_xs_tx = -1000; g_xs_ty = -1000;
  i = 0;
  loop(NXN,
    (xn_t[i] && xn_y[i] > XS_Y0 && xn_y[i] < y) ? (
      d = (xn_x[i] - x) ^ 2 + (xn_y[i] - y) ^ 2;
      d < best ? ( best = d; g_xs_tx = xn_x[i]; g_xs_ty = xn_y[i]; );
    );
    i += 1;
  );
  g_xs_boss == 2 ? (
    i = 0;
    loop(NXP,
      (xp_on[i] && (xp_role[i] == 1 || (xp_role[i] == 2 && xs_core_open()))) ? (
        d = (xp_x[i] - x) ^ 2 + (xp_y[i] - y) ^ 2;
        d < best ? ( best = d; g_xs_tx = xp_x[i]; g_xs_ty = xp_y[i]; );
      );
      i += 1;
    );
  );
  best < 1000000000;
);

function xs_fire(dt) local(x, y, g, k, a, d)
(
  x = g_xs_px; y = g_xs_py - 18;
  g = xs_lv[0];
  (g_xs_fire && g_xs_t > g_xs_ft) ? (
    g_xs_ft = g_xs_t + 0.1;
    d = g >= 5 ? 2 : 1;
    xs_pbul(x - 7, y, 0, -780, d, 0); xs_pbul(x + 7, y, 0, -780, d, 0);
    g >= 2 ? ( xs_pbul(x - 10, y + 4, -90, -760, d, 0); xs_pbul(x + 10, y + 4, 90, -760, d, 0); );
    g >= 3 ? xs_pbul(x, y - 4, 0, -820, d + 1, 3);
    g >= 4 ? ( xs_pbul(x - 12, y + 6, -220, -720, d, 0); xs_pbul(x + 12, y + 6, 220, -720, d, 0); );
    g_xs_sndf += 1;
    (g_xs_sndf % 2) == 0 ? xs_snd(1, 2400 + rand(1) * 400, 0.035, 0, (x - 450) / 400);
  );
  (g_xs_fire && (xs_lv[1] || xs_lv[2]) && g_xs_t > g_xs_fs) ? (
    g_xs_fs = g_xs_t + 0.24;
    xs_lv[1] ? ( xs_pbul(x - 14, y + 18, -700, 0, 1, 2); xs_pbul(x + 14, y + 18, 700, 0, 1, 2); );
    xs_lv[1] >= 2 ? ( xs_pbul(x - 14, y + 10, -500, -500, 1, 2); xs_pbul(x + 14, y + 10, 500, -500, 1, 2); );
    xs_lv[2] ? xs_pbul(x, y + 36, 0, 700, 1, 2);
    xs_lv[2] >= 2 ? ( xs_pbul(x - 6, y + 36, -300, 640, 1, 2); xs_pbul(x + 6, y + 36, 300, 640, 1, 2); );
  );
  (g_xs_fire && xs_lv[3] && g_xs_t > g_xs_fh) ? (
    g_xs_fh = g_xs_t + (xs_lv[3] >= 2 ? 0.42 : 0.7);
    xs_pbul(x - 16, y + 14, -160, -80, 3, 1);
    xs_lv[3] >= 2 ? xs_pbul(x + 16, y + 14, 160, -80, 3, 1);
  );
  (g_xs_fire && xs_lv[5] && g_xs_t > g_xs_fd) ? (
    g_xs_fd = g_xs_t + 0.2;
    k = 0;
    loop(xs_lv[5],
      a = g_xs_t * 3 + k * $pi;
      xs_pbul(x + cos(a) * 36, y + 18 + sin(a) * 22, 0, -760, 1, 4);
      k += 1;
    );
  );
);

function xs_laser(dt) local(w, i, best, by, bi, bp, d)
(
  g_xs_lz = 0;
  (xs_lv[4] && g_xs_fire) ? (
    w = xs_lv[4] >= 2 ? 10 : 6;
    best = XS_Y0 - 20; bi = -1; bp = -1;
    i = 0;
    loop(NXN,
      (xn_t[i] && xn_y[i] < g_xs_py && abs(xn_x[i] - g_xs_px) < xs_rad(xn_t[i]) + w && xn_y[i] > best) ? ( best = xn_y[i]; bi = i; );
      i += 1;
    );
    g_xs_boss == 2 ? (
      i = 0;
      loop(NXP,
        (xp_on[i] && xp_y[i] < g_xs_py && abs(xp_x[i] - g_xs_px) < xp_r[i] + w && xp_y[i] + xp_r[i] * 0.5 > best) ? ( best = xp_y[i] + xp_r[i] * 0.5; bp = i; bi = -1; );
        i += 1;
      );
    );
    g_xs_lz = best;
    d = (xs_lv[4] >= 2 ? 30 : 16) * dt;
    bi >= 0 ? xs_hurt(bi, d) : bp >= 0 ? xs_part_hit(bp, d);
    (bi >= 0 || bp >= 0) && rand(1) < dt * 30 ? spawn(g_xs_px + (rand(1) - 0.5) * 10, best, (rand(1) - 0.5) * 200, rand(1) * 100, 0.6, 0.9, 1, 0.25);
  );
);

function xs_bomb() local(i, a)
(
  xs_lv[8] > 0 && g_xs_state == 1 ? (
    xs_lv[8] -= 1;
    g_xs_flash_t = g_xs_t; g_xs_bomb_t = g_xs_t; g_xs_bomb_x = g_xs_px; g_xs_bomb_y = g_xs_py;
    g_xs_hs = g_t + 0.2;
    g_xs_shake = 16;
    xs_quake(0.85, 0.1);
    g_t - g_xs_fin_rt > 1.6 ? ( g_xs_fx = g_xs_px; g_xs_fy = g_xs_py; );
    xs_wave(g_xs_px, g_xs_py, 300, 1, 1, 1); xs_wave(g_xs_px, g_xs_py, 200, 0.5, 0.8, 1);
    i = 0; loop(NXP, xp_on[i] ? xs_part_hit(i, 22); i += 1; );
    memset(xcl_on, 0, NXCL); memset(xlv_on, 0, NXLV);
    i = 0;
    loop(60, a = rand(1) * 2 * $pi; spawn(g_xs_px, g_xs_py, cos(a) * (300 + rand(1) * 500), sin(a) * (300 + rand(1) * 500), 0.6 + rand(1) * 0.4, 0.8 + rand(1) * 0.2, 1, 0.5 + rand(1) * 0.5); );
    xs_bigboom(0, 0); xs_snd(1, 90, 0.7, 0.02, 0);
  );
);

function xs_bomb_tick() local(t, r, i, d)
(
  t = g_xs_t - g_xs_bomb_t;
  t < 0.8 ? (
    r = 60 + t * 1100;
    i = 0;
    loop(NXN,
      (xn_t[i] && xn_y[i] > XS_Y0 - 10) ? (
        d = sqrt((xn_x[i] - g_xs_bomb_x) ^ 2 + (xn_y[i] - g_xs_bomb_y) ^ 2);
        d < r ? xs_kill(i);
      );
      i += 1;
    );
    i = 0;
    loop(NXE, (xe_a[i] && (xe_x[i] - g_xs_bomb_x) ^ 2 + (xe_y[i] - g_xs_bomb_y) ^ 2 < r * r) ? ( xe_a[i] = 0; rand(1) < 0.3 ? spawn(xe_x[i], xe_y[i], 0, 0, 0.7, 0.9, 1, 0.3); ); i += 1; );
    g_xs_shake = max(g_xs_shake, 14 * (1 - t / 0.8));
  );
);

function xs_overlap(px, py, rad) local(c0, r0, c, r, x0, x1, yt, yb, qx, qy, dx, dy, d, o)
(
  o = 0;
  c0 = floor((px - XS_X0) / XT); r0 = floor(xs_yw(py) / XT);
  r = r0 - 1;
  loop(3,
    c = c0 - 1;
    loop(3,
      xs_cell(c, r) ? (
        x0 = XS_X0 + c * XT; x1 = x0 + XT; yt = xs_wy((r + 1) * XT); yb = xs_wy(r * XT);
        qx = max(x0, min(x1, px)); qy = max(yt, min(yb, py));
        dx = px - qx; dy = py - qy; d = dx * dx + dy * dy;
        d < rad * rad ? (
          o = 1;
          d > 0.0001 ? ( d = sqrt(d); g_xs_ox += dx / d * (rad - d); g_xs_oy += dy / d * (rad - d); ) : g_xs_in = 1;
        );
      );
      c += 1;
    );
    r += 1;
  );
  o;
);

function xs_resolve(lx, ly) local(k, o)
(
  k = 0; o = 0;
  loop(3,
    g_xs_ox = 0; g_xs_oy = 0; g_xs_in = 0;
    xs_overlap(g_xs_px, g_xs_py, XS_SR) ? (
      o = 1;
      g_xs_in ? ( g_xs_px = lx; g_xs_py = ly; ) : ( g_xs_px += g_xs_ox; g_xs_py += g_xs_oy; );
    );
    k += 1;
  );
  o;
);

function xs_safe_zone() local(r, n, c, w, l, rr, tt)
(
  r = max(0, floor(g_xs_sc / XT) - 2);
  n = ceil((BRD_H + 360) / XT) + 4;
  loop(n,
    r < XT_NR ? (
      w = r * XT + XT * 0.5;
      l = xs_wall(w, 0); rr = xs_wall(w, 1); tt = l + rr;
      tt > XS_W - 250 ? ( l *= (XS_W - 250) / tt; rr *= (XS_W - 250) / tt; );
      l = floor(l / XT + 0.35); rr = floor(rr / XT + 0.35);
      c = 0; loop(XT_NC, xs_set(c, r, (c < l || c >= XT_NC - rr) ? 1 : 0); c += 1; );
    );
    r += 1;
  );
  c = 0; loop(NXN, (xn_t[c] == 3 && xn_w[c] < g_xs_sc + BRD_H + 400) ? xn_t[c] = 0; c += 1; );
);

function xs_ship_terrain(dt) local(n, k, dx, dy, lx, ly, hit)
(
  hit = xs_resolve(g_xs_px, g_xs_py + XS_V * dt);
  dx = g_xs_vx * dt; dy = g_xs_vy * dt;
  n = max(1, ceil(max(abs(dx), abs(dy)) / 4));
  k = 0;
  loop(n,
    lx = g_xs_px; ly = g_xs_py;
    g_xs_px = max(XS_X0 + 14, min(XS_X1 - 14, g_xs_px + dx / n));
    g_xs_py = max(XS_Y0 + 30, min(XS_Y1 - 22, g_xs_py + dy / n));
    xs_resolve(lx, ly) ? hit = 1;
    k += 1;
  );
  g_xs_py > XS_Y1 - 22 ? g_xs_py = XS_Y1 - 22;
  g_xs_ox = 0; g_xs_oy = 0; g_xs_in = 0;
  (g_xs_py >= XS_Y1 - 22.5 && xs_overlap(g_xs_px, g_xs_py, XS_SR - 2) && g_xs_oy > 0.5) ? (
    xs_damage(6);
    n = 0; k = 4; dx = 0;
    while (!n && k < 200) (
      g_xs_ox = 0; g_xs_oy = 0; g_xs_in = 0;
      !xs_overlap(g_xs_px - k, g_xs_py, XS_SR) ? ( n = 1; dx = -k; ) : (
        g_xs_ox = 0; g_xs_oy = 0; g_xs_in = 0;
        !xs_overlap(g_xs_px + k, g_xs_py, XS_SR) ? ( n = 1; dx = k; );
      );
      k += 4;
    );
    g_xs_px += max(-6, min(6, dx));
    rand(1) < 0.6 ? spawn(g_xs_px + (rand(1) - 0.5) * 20, g_xs_py - 12, (rand(1) - 0.5) * 200, -rand(1) * 150, 1, 0.7, 0.3, 0.3);
    g_xs_shake = max(g_xs_shake, 2);
    g_xs_crush_t = g_xs_t;
  );
  (hit && rand(1) < dt * 20) ? spawn(g_xs_px, g_xs_py, (rand(1) - 0.5) * 80, (rand(1) - 0.5) * 80, 0.9, 0.9, 1, 0.15);
);

function xs_countdown(dt) local(t, n, ty)
(
  t = g_xs_t - g_xs_cd_t;
  ty = XS_Y1 - 90;
  g_xs_px += (450 - g_xs_px) * min(1, dt * 4);
  g_xs_py += (ty - g_xs_py) * min(1, dt * 3);
  g_xs_bank *= 1 - min(1, dt * 6);
  n = floor(t);
  (!g_pz && n !== g_xs_cdn && n <= 3) ? (
    g_xs_cdn = n;
    xs_snd(0, n < 3 ? db_note(19) : db_note(31), n < 3 ? 0.3 : 0.4, 0, 0);
    n == 3 ? ( xs_snd(0, db_note(26), 0.3, 0, 0); xs_snd(0, db_note(35), 0.25, 0.06, 0); );
  );
  t >= 3 ? (
    g_xs_state = 1; g_xs_mon = 0; g_xs_lmx = g_mx; g_xs_lmy = g_my; g_xs_go_t = g_xs_t;
    g_xs_inv = max(g_xs_inv, g_xs_t + 1);
  );
);

function xs_hz_update(dt) local(i, a, r, d)
(
  i = 0;
  loop(NXCL,
    xcl_on[i] ? (
      a = g_xs_t - xcl_t[i];
      g_xs_boss == 0 ? xcl_y[i] += XS_V * dt;
      (a > 6 || xcl_y[i] > XS_Y1 + 80) ? xcl_on[i] = 0 : (
        r = (30 + 36 * min(1, a / 0.8)) * 0.85;
        (g_xs_state == 1 && (g_xs_px - xcl_x[i]) ^ 2 + (g_xs_py - xcl_y[i]) ^ 2 < r * r && a < 5.5) ? (
          g_xs_en -= 10 * dt; g_xs_tox_t = g_xs_t;
          g_xs_en <= 0 ? ( g_xs_en = 0.5; xs_damage(5); );
        );
      );
    );
    i += 1;
  );
  i = 0;
  loop(NXLV,
    xlv_on[i] ? (
      a = g_xs_t - xlv_t[i];
      g_xs_boss == 0 ? xlv_y[i] += XS_V * dt;
      (xlv_on[i] == 1 && a >= 1.2) ? (
        xlv_on[i] = 2;
        xs_boom(xlv_x[i], xlv_y[i], 1.2, 1, 0.5, 0.1); xs_snd(2, 0, 0.35, 0, (xlv_x[i] - 450) / 300); xs_snd(4, 70, 0.3, 0, 0);
        d = (g_xs_px - xlv_x[i]) ^ 2 + (g_xs_py - xlv_y[i]) ^ 2;
        d < 46 * 46 ? xs_damage(18);
        xs_quake(0.12, 0);
      );
      a > 1.9 ? xlv_on[i] = 0;
    );
    i += 1;
  );
  i = 0;
  loop(NXO,
    xo_on[i] ? (
      a = g_xs_t - xo_t[i];
      xo_vy[i] += (85 - xo_vy[i]) * min(1, dt * 1.5); xo_vx[i] *= 1 - min(1, dt * 0.8);
      xo_x[i] += (xo_vx[i] + 25 * sin(a * 2.3 + i)) * dt; xo_y[i] += xo_vy[i] * dt;
      ((xo_x[i] < XS_X0 + 20 && xo_vx[i] < 0) || (xo_x[i] > XS_X1 - 20 && xo_vx[i] > 0)) ? xo_vx[i] = -xo_vx[i];
      (a > 9 || xo_y[i] > XS_Y1 + 30) ? xo_on[i] = 0 : (
        (g_xs_state == 1 && (g_xs_px - xo_x[i]) ^ 2 + (g_xs_py - xo_y[i]) ^ 2 < 30 * 30) ? (
          xo_on[i] = 0; g_xs_en = min(100, g_xs_en + 30);
          xs_snd(0, db_note(31), 0.2, 0, 0); xs_snd(0, db_note(35), 0.18, 0.07, 0); xs_snd(0, db_note(38), 0.16, 0.14, 0);
          r = 0; loop(16, d = r * $pi / 8; spawn(xo_x[i], xo_y[i], cos(d) * 160, sin(d) * 160, 0.4, 1, 0.5, 0.4); r += 1; );
        );
      );
    );
    i += 1;
  );
);

function xs_hz_draw() local(i, a, r, x, y, k, f)
(
  i = 0;
  loop(NXO,
    xo_on[i] ? (
      a = g_xs_t - xo_t[i];
      f = a > 7 ? (frac(a * 8) < 0.5) : 0.6 + 0.4 * (frac(a * 2.5) < 0.5);
      gfx_mode = 1; gfx_set(0.2, 1, 0.3, 0.22 * f); gfx_circle(sx(xo_x[i]), sy(xo_y[i]), 34 * g_s, 1, 1); gfx_mode = 0;
      xs_gcrystal(xo_x[i], xo_y[i], 12, g_xs_t * 0.8 + i, 0.55 + 0.45 * f);
    );
    i += 1;
  );

  i = 0;
  loop(NXCL,
    xcl_on[i] ? (
      a = g_xs_t - xcl_t[i]; f = min(1, a / 0.3) * min(1, (6 - a) / 1);
      r = 30 + 36 * min(1, a / 0.8);
      x = xcl_x[i]; y = xcl_y[i];
      k = 0;
      loop(7,
        gfx_set(0.45, 0.65, 0.12, 0.13 * f);
        gfx_circle(sx(x + cos(k * 0.9 + a * 0.5) * r * 0.45), sy(y + sin(k * 1.3 + a * 0.4) * r * 0.35), (r * (0.5 + 0.08 * k)) * g_s, 1, 1);
        k += 1;
      );
      gfx_mode = 1; gfx_set(0.6, 1, 0.2, 0.08 * f); gfx_circle(sx(x), sy(y), r * g_s, 1, 1);
      k = 0; loop(6, gfx_set(0.8, 1, 0.3, 0.5 * f * (0.5 + 0.5 * sin(a * 3 + k))); gfx_circle(sx(x + cos(k * 1.7 + a) * r * 0.6), sy(y + sin(k * 2.3 + a * 0.8) * r * 0.5), 1.6 * g_s, 1, 1); k += 1; );
      gfx_mode = 0;
    );
    i += 1;
  );
  i = 0;
  loop(NXLV,
    xlv_on[i] ? (
      a = g_xs_t - xlv_t[i]; x = sx(xlv_x[i]); y = sy(xlv_y[i]);
      gfx_mode = 1;
      xlv_on[i] == 1 ? (
        f = frac(a * 4) < 0.5;
        gfx_set(1, 0.25, 0.05, f ? 0.9 : 0.5);
        gfx_circle(x, y, (46 - 20 * a / 1.2) * g_s, 0, 1); gfx_circle(x, y, (47 - 20 * a / 1.2) * g_s, 0, 1);
        gfx_line(x - 10 * g_s, y, x + 10 * g_s, y, 1); gfx_line(x, y - 10 * g_s, x, y + 10 * g_s, 1);
        gfx_set(1, 0.3, 0.05, 0.08 + 0.12 * a); gfx_circle(x, y, 46 * g_s, 1, 1);
      ) : (
        f = 1 - (a - 1.2) / 0.7;
        gfx_set(1, 0.45, 0.08, 0.6 * f); gfx_circle(x, y, (30 + 40 * (1 - f)) * g_s, 1, 1);
        gfx_set(1, 0.85, 0.4, 0.8 * f); gfx_circle(x, y, 18 * f * g_s, 1, 1);
      );
      gfx_mode = 0;
    );
    i += 1;
  );
);

function xs_update(dt) local(i, t, x, y, d, dx, dy, r, a, sp, k, w, n, best, j, hit)
(
  g_xs_pwr = xs_power();
  sp = 1 + min(0.6, 0.06 * (g_xs_lv - 1));
  g_xs_state == 1 || g_xs_state == 5 ? (
    g_xs_boss == 0 ? (
      g_xs_sc += XS_V * dt;
      (!g_xs_mid && g_xs_sc >= g_xs_len * 0.5) ? ( g_xs_mid = 1; g_xs_midt = g_xs_t; );
      (g_xs_mid == 1 && g_xs_t - g_xs_midt > 3) ? (
        n = 0; i = 0; loop(NXN, xn_t[i] && xn_y[i] > XS_Y0 ? n += 1; i += 1; );
        (n == 0 || g_xs_t - g_xs_midt > 9) && g_xs_state == 1 ? ( g_xs_mid = 2; g_xs_state = 6; g_xs_shop_t = g_xs_t; g_xs_shopnext = 0; );
      );
      (g_xs_sc >= g_xs_next && g_xs_sc < g_xs_len - 450 && (g_xs_sc < g_xs_len * 0.5 - 250 || g_xs_sc > g_xs_len * 0.5 + 60)) ? xs_spawn();
      g_xs_sc >= g_xs_len ? xs_boss_start();
    ) : xs_boss_update(dt);
    xs_cg_update(dt);
    xs_hz_update(dt);
  );
  g_xs_state == 1 ? (
    (g_xs_kx || g_xs_ky) ? (
      g_xs_vx += (g_xs_kx * 440 - g_xs_vx) * min(1, dt * 14);
      g_xs_vy += (g_xs_ky * 440 - g_xs_vy) * min(1, dt * 14);
    ) : g_xs_mon ? (
      dx = max(XS_X0 + 16, min(XS_X1 - 16, g_mx)) - g_xs_px; dy = max(XS_Y0 + 30, min(XS_Y1 - 26, g_my + 10)) - g_xs_py;
      g_xs_vx = dx * 11; g_xs_vy = dy * 11;
      d = sqrt(g_xs_vx ^ 2 + g_xs_vy ^ 2);
      d > 600 ? ( g_xs_vx *= 600 / d; g_xs_vy *= 600 / d; );
    ) : ( g_xs_vx *= 1 - min(1, dt * 10); g_xs_vy *= 1 - min(1, dt * 10); );
    g_xs_bank += (max(-1, min(1, g_xs_vx / 380)) - g_xs_bank) * min(1, dt * 8);
    xs_ship_terrain(dt);
    xs_fire(dt);
    xs_laser(dt);
  ) : ( g_xs_lz = 0; );
  i = 0;
  loop(NXB,
    xb_a[i] ? (
      xb_k[i] == 1 ? (
        t = g_xs_t - xb_t[i];
        xs_nearest(xb_x[i], xb_y[i] + 200) ? (
          a = atan2(g_xs_ty - xb_y[i], g_xs_tx - xb_x[i]);
          r = min(640, 160 + t * 900);
          xb_vx[i] += (cos(a) * r - xb_vx[i]) * min(1, dt * 5);
          xb_vy[i] += (sin(a) * r - xb_vy[i]) * min(1, dt * 5);
        ) : ( xb_vy[i] -= 900 * dt; );
        t > 2.6 ? xb_a[i] = 0;
        rand(1) < 0.5 ? spawn(xb_x[i], xb_y[i], (rand(1) - 0.5) * 30, 40, 1, 0.6, 0.3, 0.25);
      );
      xb_x[i] += xb_vx[i] * dt; xb_y[i] += xb_vy[i] * dt;
      (xb_y[i] < XS_Y0 - 20 || xb_y[i] > XS_Y1 + 20 || xb_x[i] < XS_X0 - 10 || xb_x[i] > XS_X1 + 10) ? xb_a[i] = 0;
      (xb_a[i] && xs_solid(xb_x[i], xb_y[i])) ? (
        xb_a[i] = 0;
        loop(2, spawn(xb_x[i], xb_y[i], (rand(1) - 0.5) * 160, 40 + rand(1) * 80, 1, 0.75, 0.4, 0.18); );
      );
      xb_a[i] ? (
        hit = 0;
        j = 0;
        while (!hit && j < NXN) (
          xn_t[j] ? (
            r = xs_rad(xn_t[j]) + 4;
            (abs(xb_x[i] - xn_x[j]) < r && abs(xb_y[i] - xn_y[j]) < r) ? (
              hit = 1; xs_hurt(j, xb_d[i]);
              spawn(xb_x[i], xb_y[i], (rand(1) - 0.5) * 120, 60 + rand(1) * 60, 1, 0.9, 0.6, 0.15);
            );
          );
          j += 1;
        );
        (!hit && g_xs_boss >= 1 && g_xs_boss <= 2) ? (
          j = 0;
          while (!hit && j < NXP) (
            xp_on[j] ? (
              r = xp_r[j];
              (xb_x[i] - xp_x[j]) ^ 2 + (xb_y[i] - xp_y[j]) ^ 2 < r * r ? (
                hit = 1;
                xs_part_hit(j, xb_d[i]) ? spawn(xb_x[i], xb_y[i], (rand(1) - 0.5) * 150, 60, 1, 0.8, 0.4, 0.2) :
                spawn(xb_x[i], xb_y[i], (rand(1) - 0.5) * 100, 40, 0.6, 0.7, 0.8, 0.12);
              );
            );
            j += 1;
          );
        );
        hit ? xb_a[i] = 0;
      );
    );
    i += 1;
  );
  i = 0;
  loop(NXN,
    (t = xn_t[i]) ? (
      a = g_xs_t - xn_t0[i];
      t == 1 ? (
        !xn_c[i] ? xn_c[i] = xn_x[i];
        xn_y[i] += 44 * sp * dt; xn_x[i] = xn_c[i] + 40 * sin(a * 1.3 + xn_b[i]);
        (g_xs_t > xn_s[i] && xn_y[i] > XS_Y0 + 20 && xn_y[i] < g_xs_py - 80) ? ( xs_aim(xn_x[i], xn_y[i], 150 * sp, 0.16, 1); xn_s[i] = g_xs_t + (1.8 + rand(1) * 1.5) / g_xs_pwr ^ 0.2; );
      ) : t == 2 ? (
        a -= xn_b[i];
        a < 0 ? xn_y[i] = XS_Y0 - 30 : (
          xn_y[i] = XS_Y0 - 20 + 210 * sp * a; xn_x[i] = xn_a[i] + xn_c[i] * 150 * sin(a * 1.7);
        );
      ) : t == 3 ? (
        xn_y[i] = xs_wy(xn_w[i]);
        xn_x[i] = xn_a[i];
        (g_xs_t > xn_s[i] && xn_y[i] > XS_Y0 + 30 && xn_y[i] < XS_Y1 - 120) ? (
          xs_aim(xn_x[i], xn_y[i], 175 * sp, 0.18, 2); xn_s[i] = g_xs_t + 1.7 / sp / g_xs_pwr ^ 0.2;
        );
      ) : t == 4 ? (
        !xn_c[i] ? xn_c[i] = xn_x[i];
        xn_y[i] += 32 * sp * dt; xn_x[i] = xn_c[i] + 30 * sin(a * 0.8 + xn_b[i]);
      ) : t == 5 ? (
        dx = g_xs_px - xn_x[i]; dy = g_xs_py - xn_y[i]; d = max(1, sqrt(dx * dx + dy * dy));
        xn_a[i] += (dx / d * 115 * sp - xn_a[i]) * min(1, dt * 1.1);
        xn_b[i] += (dy / d * 115 * sp - xn_b[i]) * min(1, dt * 1.1);
        xn_x[i] += xn_a[i] * dt; xn_y[i] += xn_b[i] * dt;
        a > 6 ? xn_t[i] = 0;
      ) : t == 6 ? (
        !xn_c[i] ? xn_c[i] = xn_x[i];
        a -= xn_b[i];
        a < 0 ? xn_y[i] = XS_Y0 - 30 : (
          xn_y[i] = XS_Y0 - 20 + 92 * sp * a; xn_x[i] = xn_c[i] + 130 * sin(a * 1.25 + xn_a[i]);
        );
      ) : t == 8 ? (
        !xn_c[i] ? xn_c[i] = xn_x[i];
        xn_y[i] += 38 * sp * dt; xn_x[i] = xn_c[i] + 55 * sin(a * 0.9 + xn_b[i]);
        (g_xs_t > xn_s[i] && xn_y[i] > XS_Y0 + 20 && xn_y[i] < g_xs_py - 80) ? ( xs_aim(xn_x[i], xn_y[i], 165 * sp, 0, 1); xn_s[i] = g_xs_t + (2.4 + rand(1) * 1.2) / g_xs_pwr ^ 0.2; );
      ) : t == 9 ? (
        xn_x[i] += xn_a[i] * sp * dt; xn_y[i] += xn_b[i] * sp * dt;
        (xn_x[i] < XS_X0 + 12 && xn_a[i] < 0) || (xn_x[i] > XS_X1 - 12 && xn_a[i] > 0) ? xn_a[i] = -xn_a[i];
      ) : t == 10 ? (
        d = g_xs_t - xn_a[i];
        a > 11 ? ( xn_y[i] -= 90 * dt; xn_y[i] < XS_Y0 - 40 ? xn_t[i] = 0; ) : (
          xn_y[i] += (xn_b[i] - xn_y[i]) * min(1, dt * 2);
          d < 1.3 ? xn_x[i] += (xn_c[i] - xn_x[i]) * min(1, dt * 2.8) :
          d < 2.3 ? ( (d - dt < 1.3) ? xs_snd(1, 1400, 0.06, 0, (xn_x[i] - 450) / 300); ) :
          d < 2.75 ? (
            (d - dt < 2.3) ? ( xs_snd(4, 140, 0.25, 0, (xn_x[i] - 450) / 300); xs_snd(1, 700, 0.1, 0, (xn_x[i] - 450) / 300); );
            (g_xs_state == 1 && abs(g_xs_px - xn_x[i]) < 15 && g_xs_py > xn_y[i]) ? xs_damage(16);
          ) : ( xn_a[i] = g_xs_t; xn_c[i] = max(XS_X0 + 40, min(XS_X1 - 40, g_xs_px)); );
        );
      ) : t == 11 ? (
        d = g_xs_t - xn_a[i];
        d < 0 ? xn_y[i] += (xn_b[i] - xn_y[i]) * min(1, dt * 2.5) :
        d < 0.9 ? ( (d - dt < 0) ? xs_snd(1, 260, 0.12, 0, (xn_x[i] - 450) / 300); ) :
        ( (d - dt < 0.9) ? xs_snd(4, 90, 0.3, 0, (xn_x[i] - 450) / 300); xn_x[i] += xn_c[i] * 430 * sp * dt; );
      ) : t == 12 ? (
        j = xn_c[i];
        (j < 0 || !xn_t[j] || xn_t[j] == 12) ? (
          j = -1; best = 1000000000; k = 0;
          loop(NXN, (xn_t[k] && xn_t[k] != 12 && xn_t[k] != 9 && xn_y[k] > XS_Y0 - 40) ? ( d = (xn_x[k] - xn_x[i]) ^ 2 + (xn_y[k] - xn_y[i]) ^ 2; d < best ? ( best = d; j = k; ); ); k += 1; );
          xn_c[i] = j;
        );
        j >= 0 ? ( xn_x[i] += (xn_x[j] - xn_x[i]) * min(1, dt * 3); xn_y[i] += (xn_y[j] - 50 - xn_y[i]) * min(1, dt * 3); ) : xn_y[i] += 60 * dt;
      ) : t == 13 ? (
        !xn_c[i] ? xn_c[i] = xn_x[i];
        xn_y[i] += 30 * sp * dt; xn_x[i] = xn_c[i] + 25 * sin(a * 0.7 + xn_b[i]);
      ) : t == 14 ? (
        a > 14 ? xn_y[i] += 140 * dt : (
          dx = g_xs_px - xn_x[i]; dy = g_xs_py - xn_y[i]; d = max(1, sqrt(dx * dx + dy * dy));
          xn_x[i] += dx / d * 62 * sp * dt; xn_y[i] += (dy / d * 62 * sp + 6) * dt;
        );
      ) : t == 15 ? (
        xn_x[i] += xn_c[i] * 95 * dt;
        (g_xs_t > xn_a[i] && xn_x[i] > XS_X0 + 30 && xn_x[i] < XS_X1 - 30 && g_xs_state == 1) ? ( xs_lava_mark(g_xs_px, g_xs_py); xn_a[i] = g_xs_t + 1.5; );
      ) : t == 16 ? (
        !xn_c[i] ? xn_c[i] = xn_x[i];
        xn_y[i] += 58 * sp * dt; xn_x[i] = xn_c[i] + 70 * sin(a * 1.6 + xn_b[i]);
        (g_xs_t > xn_s[i] && xn_y[i] > XS_Y0 + 20 && xn_y[i] < g_xs_py - 80) ? ( xs_aim(xn_x[i], xn_y[i], 170 * sp, 0, 1); xn_s[i] = g_xs_t + (2.2 + rand(1) * 1.4) / g_xs_pwr ^ 0.2; );
      ) : (
        !xn_c[i] ? xn_c[i] = xn_x[i];
        xn_y[i] += 55 * sp * dt; xn_x[i] = xn_c[i] + 22 * sin(a + xn_b[i]);
      );
      (xn_t[i] && (xn_y[i] > XS_Y1 + 40 || xn_x[i] < XS_X0 - 60 || xn_x[i] > XS_X1 + 60)) ? xn_t[i] = 0;
      (xn_t[i] && g_xs_state == 1) ? (
        r = xs_rad(xn_t[i]) + 9;
        ((xn_x[i] - g_xs_px) ^ 2 + (xn_y[i] - g_xs_py) ^ 2 < r * r) ? ( xs_damage(18); xs_hurt(i, 5); );
      );
    );
    i += 1;
  );
  i = 0;
  loop(NXE,
    xe_a[i] ? (
      xe_x[i] += xe_vx[i] * dt; xe_y[i] += xe_vy[i] * dt;
      (xe_y[i] < XS_Y0 - 30 || xe_y[i] > XS_Y1 + 20 || xe_x[i] < XS_X0 - 20 || xe_x[i] > XS_X1 + 20) ? xe_a[i] = 0;
      (xe_a[i] && xe_y[i] > XS_Y0 && xs_solid(xe_x[i], xe_y[i])) ? xe_a[i] = 0;
      xe_a[i] && g_xs_state == 1 ? (
        (xe_x[i] - g_xs_px) ^ 2 + (xe_y[i] - g_xs_py) ^ 2 < 7.5 * 7.5 ? ( xe_a[i] = 0; xs_damage(11); );
        k = 0;
        loop(xs_lv[5],
          a = g_xs_t * 3 + k * $pi;
          (xe_x[i] - g_xs_px - cos(a) * 36) ^ 2 + (xe_y[i] - g_xs_py - sin(a) * 22) ^ 2 < 12 * 12 ? xe_a[i] = 0;
          k += 1;
        );
      );
    );
    i += 1;
  );
  i = 0;
  loop(NXC,
    xc_a[i] ? (
      dx = g_xs_px - xc_x[i]; dy = g_xs_py - xc_y[i]; d = sqrt(dx * dx + dy * dy);
      (d < 120 && g_xs_state == 1) || g_xs_state == 4 ? (
        xc_vx[i] += dx / max(1, d) * 1400 * dt; xc_vy[i] += dy / max(1, d) * 1400 * dt;
        xc_vx[i] *= 1 - min(1, dt * 3); xc_vy[i] *= 1 - min(1, dt * 3);
      ) : (
        xc_vx[i] *= 1 - min(1, dt * 2);
        xc_vy[i] += (60 - xc_vy[i]) * min(1, dt * 1.5);
      );
      xc_x[i] += xc_vx[i] * dt; xc_y[i] += xc_vy[i] * dt;
      d < 22 && (g_xs_state == 1 || g_xs_state == 4) ? (
        xc_a[i] = 0; g_xs_cr += xc_v[i]; g_xs_score += 50 * xc_v[i];
        g_xs_t - g_xs_cpt > 0.8 ? g_xs_cp = 0;
        g_xs_cpt = g_xs_t; g_xs_cp = min(14, g_xs_cp + 1);
        xs_snd(1, 1800 + g_xs_cp * 120, 0.08, 0, (xc_x[i] - 450) / 400);
        g_xs_crt = g_t;
      );
      xc_y[i] > XS_Y1 + 20 ? xc_a[i] = 0;
    );
    i += 1;
  );
  g_xs_state == 5 && g_xs_t - g_xs_die_t > 1.8 ? (
    g_xs_lives -= 1;
    g_xs_lives > 0 ? (
      g_xs_lost = 0;
      xs_lv[0] > 1 ? ( xs_lv[0] -= 1; g_xs_lost = 1; );
      n = 0; k = 1; loop(5, xs_lv[k] > 0 ? n += 1; k += 1; );
      n > 0 ? (
        j = floor(rand(1) * n); k = 1;
        loop(5, xs_lv[k] > 0 ? ( j == 0 ? ( xs_lv[k] -= 1; g_xs_lost += 1; ); j -= 1; ); k += 1; );
      );
      g_xs_lost_t = g_xs_t;
      xs_safe_zone();
      g_xs_state = 8; g_xs_cd_t = g_xs_t; g_xs_cdn = -1; g_xs_en = 100; g_xs_inv = g_xs_t + 4;
      g_xs_px = 450; g_xs_py = XS_Y1 + 40; g_xs_vx = 0; g_xs_vy = 0;
      memset(xe_a, 0, NXE);
      xs_lv[8] = max(xs_lv[8], 1);
    ) : (
      g_xs_state = 3; g_xs_over_t = g_t;
      sv2[40] = max(sv2[40], g_xs_score); sv2[41] = max(sv2[41], g_xs_lv);
    );
  );
  g_xs_state == 4 ? (
    g_xs_py -= (80 + (g_xs_t - g_xs_clr_t) * 300) * dt;
    g_xs_t - g_xs_clr_t > 3 ? (
      sv2[41] = max(sv2[41], g_xs_lv + 1); sv2[40] = max(sv2[40], g_xs_score);
      (g_xs_lv % 10) == 0 ? ( g_xs_state = 7; g_xs_end_t = g_t; ) : ( g_xs_state = 6; g_xs_shop_t = g_xs_t; g_xs_shopnext = 1; );
    );
  );
  g_xs_state == 6 && g_xs_t - g_xs_shop_t > 1.6 ? ( g_xs_state = 2; g_xs_shop_t = g_t; g_xs_trk = 18; xs_clear(); g_xs_say = floor(rand(1) * 6); g_xs_buy_t = -10; );
  xs_bomb_tick();
  g_xs_shake = max(0, g_xs_shake - dt * 18);
);

function xs_th_set(k) ( g_cr = xs_rr[g_xs_th] * k; g_cg = xs_rg[g_xs_th] * k; g_cb = xs_rb[g_xs_th] * k; );

function xs_world_name(lv) local(w)
(
  w = floor((lv - 1) / 2) % 5;
  w == 0 ? "Primordial Sea" : w == 1 ? "Crystal Caves" : w == 2 ? "The Foundry" : w == 3 ? "Spore Jungle" : "Magma Core";
);

function xs_panels(w, h) local(dst, s0, ox0, oy0, k, x0, x1, y, j, a, th)
(
  dst = gfx_dest; s0 = g_s; ox0 = g_ox; oy0 = g_oy;
  gfx_setimgdim(IMG_XSP, w, h);
  gfx_dest = IMG_XSP;
  g_s = w / BRD_W; g_ox = -BRD_X * g_s; g_oy = -BRD_Y * g_s;
  th = g_xs_th;
  gfx_set(0.05, 0.055, 0.07, 1); gfx_rect(0, 0, w, h);
  k = 0;
  loop(2,
    x0 = k ? XS_X1 : BRD_X; x1 = k ? BRD_X + BRD_W : XS_X0;
    gfx_gradrect(sx(x0), sy(BRD_Y), (x1 - x0) * g_s, BRD_H * g_s, 0.09, 0.1, 0.13, 1, 0, 0, 0, 0, -0.04 / (BRD_H * g_s), -0.04 / (BRD_H * g_s), -0.04 / (BRD_H * g_s), 0);
    gfx_set(0.13, 0.14, 0.18, 1);
    y = BRD_Y + 10;
    while (y < BRD_Y + BRD_H - 10) (
      j = 0;
      loop(floor((x1 - x0 - 20) / 16),
        a = x0 + 12 + j * 16 + ((floor((y - BRD_Y) / 14) & 1) ? 8 : 0);
        gfx_circle(sx(a), sy(y), 5 * g_s, 0, 1);
        j += 1;
      );
      y += 14;
    );
    gfx_set(0.02, 0.02, 0.03, 0.55);
    gfx_rect(sx(x0 + 8), sy(BRD_Y + 8), (x1 - x0 - 16) * g_s, (BRD_H - 16) * g_s);
    gfx_set(0.22, 0.24, 0.3, 1);
    gfx_rect(sx(x0 + 8), sy(BRD_Y + 8), (x1 - x0 - 16) * g_s, (BRD_H - 16) * g_s, 0);
    j = 0;
    loop(4,
      gfx_set(0.35, 0.37, 0.42, 1);
      gfx_circle(sx(j & 1 ? x1 - 14 : x0 + 14), sy(j & 2 ? BRD_Y + BRD_H - 14 : BRD_Y + 14), 3 * g_s, 1, 1);
      gfx_set(0.6, 0.62, 0.68, 1);
      gfx_circle(sx((j & 1 ? x1 - 14 : x0 + 14) - 1), sy((j & 2 ? BRD_Y + BRD_H - 14 : BRD_Y + 14) - 1), 1 * g_s, 1, 1);
      j += 1;
    );
    a = k ? XS_X1 + 4 : XS_X0 - 8;
    gfx_set(0.12, 0.13, 0.16, 1); gfx_rect(sx(a), sy(BRD_Y), 4 * g_s, BRD_H * g_s);
    gfx_set(xs_rr[th] * 0.6, xs_rg[th] * 0.6, xs_rb[th] * 0.6, 1); gfx_rect(sx(a + 1), sy(BRD_Y), 2 * g_s, BRD_H * g_s);
    k += 1;
  );
  g_s = s0; g_ox = ox0; g_oy = oy0;
  gfx_dest = dst;
);

function xs_tile(w, h) local(dst, k, x, y, r, j, th, a, c)
(
  dst = gfx_dest;
  gfx_setimgdim(IMG_XST, w, h);
  gfx_dest = IMG_XST;
  th = g_xs_th;
  gfx_gradrect(0, 0, w, h, xs_br[th] * 0.9, xs_bg[th] * 0.9, xs_bb[th] * 0.9, 1, 0, 0, 0, 0, 0, 0, 0, 0);
  k = 0;
  loop(420,
    x = hash(k * 3.7 + g_xs_sd) * w; y = hash(k * 5.3 + g_xs_sd) * h; r = (0.015 + 0.07 * hash(k * 1.9) * hash(k * 2.7)) * w;
    a = hash(k * 7.1);
    c = a < 0.5 ? 0.4 : 2.2;
    j = -1;
    loop(3,
      gfx_set(min(1, xs_br[th] * c + 0.01), min(1, xs_bg[th] * c + 0.01), min(1, xs_bb[th] * c + 0.01), 0.18);
      gfx_circle(x, y + j * h, r, 1, 1);
      j += 1;
    );
    k += 1;
  );
  loop(3, gfx_x = 0; gfx_y = 0; gfx_blurto(w, h); );
  gfx_mode = 1;
  k = 0;
  loop(7,
    x = hash(k * 9.7 + g_xs_sd) * w; y = hash(k * 4.4 + g_xs_sd) * h;
    j = -1;
    loop(3, gfx_set(xs_rr[th], xs_rg[th] * 0.6, xs_rb[th] * 0.5, 0.025); gfx_circle(x, y + j * h, w * 0.18, 1, 1); j += 1; );
    k += 1;
  );
  gfx_mode = 0;
  k = 0;
  loop(110,
    x = hash(k * 1.31 + g_xs_sd * 2) * w; y = hash(k * 2.17 + 4) * h;
    a = 0.2 + 0.8 * hash(k * 9.1) * hash(k * 3.3);
    gfx_set(0.8, 0.82, 0.9, a * 0.6);
    gfx_rect(x, y, a > 0.8 ? 2 : 1, a > 0.8 ? 2 : 1);
    k += 1;
  );
  gfx_dest = dst;
);

function xs_cellshape(x0, y0, s, rc, u, d, l, r)
(
  gfx_rect(x0 + rc, y0, s - 2 * rc, s);
  gfx_rect(x0, y0 + rc, rc, s - 2 * rc);
  gfx_rect(x0 + s - rc, y0 + rc, rc, s - 2 * rc);
  (u || l) ? gfx_rect(x0, y0, rc, rc) : gfx_circle(x0 + rc, y0 + rc, rc, 1, 1);
  (u || r) ? gfx_rect(x0 + s - rc, y0, rc, rc) : gfx_circle(x0 + s - rc - 1, y0 + rc, rc, 1, 1);
  (d || l) ? gfx_rect(x0, y0 + s - rc, rc, rc) : gfx_circle(x0 + rc, y0 + s - rc - 1, rc, 1, 1);
  (d || r) ? gfx_rect(x0 + s - rc, y0 + s - rc, rc, rc) : gfx_circle(x0 + s - rc - 1, y0 + s - rc - 1, rc, 1, 1);
);

function xs_terrain() local(r0, r1, r, c, x0, y0, s, u, d, l, rt, th, h, k, pass, rc, cr, cg, cb, a, px, py)
(
  th = g_xs_th;
  s = XT * g_s; rc = 8 * g_s;
  r0 = floor(xs_yw(XS_Y1 + 30) / XT); r1 = floor(xs_yw(XS_Y0 - 30) / XT);
  pass = 0;
  loop(4,
    r = r0;
    loop(r1 - r0 + 1,
      c = 0;
      loop(XT_NC,
        xt_m[r * XT_NC + c] && r >= 0 && r < XT_NR ? (
          x0 = sx(XS_X0 + c * XT); y0 = sy(xs_wy((r + 1) * XT));
          u = xs_cell(c, r + 1); d = xs_cell(c, r - 1); l = xs_cell(c - 1, r); rt = xs_cell(c + 1, r);
          h = hash(r * 31.7 + c * 7.3 + g_xs_sd);
          pass == 0 ? (
            gfx_set(0, 0, 0, 0.45); xs_cellshape(x0 + 7 * g_s, y0 + 10 * g_s, s, rc, u, d, l, rt);
          ) : pass == 1 ? (
            gfx_set(xs_wr[th] * 0.5, xs_wg[th] * 0.5, xs_wb[th] * 0.5, 1); xs_cellshape(x0, y0, s, rc, u, d, l, rt);
          ) : pass == 2 ? (
            k = 3 * g_s;
            gfx_set(xs_wr[th] * (0.85 + 0.25 * h), xs_wg[th] * (0.85 + 0.25 * h), xs_wb[th] * (0.85 + 0.25 * h), 1);
            gfx_rect(x0 + (l ? 0 : k), y0 + (u ? 0 : k), s - (l ? 0 : k) - (rt ? 0 : 2 * k), s - (u ? 0 : k) - (d ? 0 : 2 * k));
            !u ? ( gfx_set(min(1, xs_wr[th] * 2.2 + 0.08), min(1, xs_wg[th] * 2.2 + 0.08), min(1, xs_wb[th] * 2.2 + 0.08), 1); gfx_rect(x0 + (l ? 0 : rc), y0 + k, s - (l ? 0 : rc) - (rt ? 0 : rc), 2 * g_s); );
            !l ? ( gfx_set(xs_wr[th] * 1.6, xs_wg[th] * 1.6, xs_wb[th] * 1.6, 1); gfx_rect(x0 + k, y0 + (u ? 0 : rc), 2 * g_s, s - (u ? 0 : rc) - (d ? 0 : rc)); );
            !d ? ( gfx_set(xs_wr[th] * 0.3, xs_wg[th] * 0.3, xs_wb[th] * 0.3, 1); gfx_rect(x0 + (l ? 0 : rc), y0 + s - 2 * k, s - (l ? 0 : rc) - (rt ? 0 : rc), k); );
            th == 0 ? (
              h > 0.88 ? (
                a = 0.5 + 0.5 * sin(g_xs_t * 2.3 + h * 20);
                gfx_set(0.02, 0.03, 0.03, 1); gfx_triangle(x0 + s * 0.5, y0 + s * 0.2, x0 + s * 0.58, y0 + s * 0.5, x0 + s * 0.5, y0 + s * 0.8, x0 + s * 0.42, y0 + s * 0.5);
                gfx_mode = 1; gfx_set(0.9, 0.6, 0.1, 0.25 + 0.35 * a); gfx_triangle(x0 + s * 0.5, y0 + s * 0.3, x0 + s * 0.53, y0 + s * 0.5, x0 + s * 0.5, y0 + s * 0.7, x0 + s * 0.47, y0 + s * 0.5); gfx_mode = 0;
              ) : h > 0.4 ? (
                gfx_set(xs_wr[th] * 0.35, xs_wg[th] * 0.35, xs_wb[th] * 0.35, 1);
                tline(x0 + s * 0.1, y0 + s * h, x0 + s * 0.5, y0 + s * 0.55, 2 * g_s); tline(x0 + s * 0.5, y0 + s * 0.55, x0 + s * 0.9, y0 + s * (1.2 - h), 2 * g_s);
                gfx_set(xs_wr[th] * 1.5, xs_wg[th] * 1.5, xs_wb[th] * 1.5, 1); gfx_line(x0 + s * 0.1, y0 + s * h - 1, x0 + s * 0.5, y0 + s * 0.55 - 1, 1);
              );
            ) : th == 1 ? (
              h > 0.6 && !u ? (
                gfx_set(0.6, 0.45, 0.95, 1); gfx_triangle(x0 + s * 0.3, y0 + k, x0 + s * 0.5, y0 - s * (0.3 + 0.5 * h), x0 + s * 0.7, y0 + k);
                gfx_set(0.9, 0.8, 1, 1); gfx_triangle(x0 + s * 0.45, y0 + k, x0 + s * 0.5, y0 - s * (0.3 + 0.5 * h), x0 + s * 0.55, y0 + k);
              );
              h < 0.3 ? ( gfx_set(0.35, 0.25, 0.55, 1); gfx_triangle(x0 + s * 0.2, y0 + s * 0.7, x0 + s * 0.5, y0 + s * 0.25, x0 + s * 0.75, y0 + s * 0.65); );
            ) : th == 2 ? (
              gfx_set(xs_wr[th] * 0.6, xs_wg[th] * 0.6, xs_wb[th] * 0.6, 1); gfx_rect(x0 + 4 * g_s, y0 + 4 * g_s, s - 8 * g_s, s - 8 * g_s, 0);
              gfx_set(0.65, 0.6, 0.55, 1);
              gfx_circle(x0 + 7 * g_s, y0 + 7 * g_s, 1.3 * g_s, 1, 1); gfx_circle(x0 + s - 7 * g_s, y0 + 7 * g_s, 1.3 * g_s, 1, 1);
              gfx_circle(x0 + 7 * g_s, y0 + s - 7 * g_s, 1.3 * g_s, 1, 1); gfx_circle(x0 + s - 7 * g_s, y0 + s - 7 * g_s, 1.3 * g_s, 1, 1);
              (!d && h > 0.5) ? (
                k = 0; loop(4, gfx_set((k & 1) ? 0.12 : 0.9, (k & 1) ? 0.1 : 0.7, 0.05, 1); gfx_triangle(x0 + k * s / 4, y0 + s - 5 * g_s, x0 + (k + 1) * s / 4, y0 + s - 5 * g_s, x0 + (k + 0.5) * s / 4, y0 + s); k += 1; );
              );
            ) : th == 3 ? (
              (!d && h > 0.4) ? (
                gfx_set(0.3, 0.5, 0.15, 1);
                px = x0 + s * h; py = y0 + s;
                k = 0; loop(4, gfx_line(px + sin(g_xs_t + k + h * 9) * 3 * g_s, py + k * 6 * g_s, px + sin(g_xs_t + k + 1 + h * 9) * 3 * g_s, py + (k + 1) * 6 * g_s, 1); k += 1; );
                gfx_set(0.45, 0.75, 0.2, 1); gfx_circle(px, py + 14 * g_s, 2.5 * g_s, 1, 1);
              );
              (h > 0.7 && !u) ? ( gfx_set(0.6, 0.58, 0.45, 1); gfx_triangle(x0 + s * 0.35, y0 + k, x0 + s * 0.45, y0 - s * 0.45, x0 + s * 0.55, y0 + k); gfx_triangle(x0 + s * 0.65, y0 + k, x0 + s * 0.72, y0 - s * 0.3, x0 + s * 0.8, y0 + k); );
            ) : (
              gfx_mode = 1;
              a = 0.6 + 0.4 * sin(g_xs_t * 3 + h * 30);
              gfx_set(1, 0.4, 0.1, 0.55 * a);
              h > 0.35 ? ( gfx_line(x0 + s * 0.1, y0 + s * h, x0 + s * 0.5, y0 + s * 0.5, 1); gfx_line(x0 + s * 0.5, y0 + s * 0.5, x0 + s * 0.9, y0 + s * (1 - h * 0.6), 1); );
              !u ? ( gfx_set(1, 0.5, 0.15, 0.25 * a); gfx_rect(x0, y0 - 3 * g_s, s, 4 * g_s); );
              gfx_mode = 0;
            );
          ) : (
            gfx_mode = 1;
            gfx_set(xs_rr[th], xs_rg[th], xs_rb[th], 0.55);
            !u ? gfx_rect(x0 + (l ? 0 : rc), y0, s - (l ? 0 : rc) - (rt ? 0 : rc), max(1, g_s));
            !d ? gfx_rect(x0 + (l ? 0 : rc), y0 + s - max(1, g_s), s - (l ? 0 : rc) - (rt ? 0 : rc), max(1, g_s));
            !l ? gfx_rect(x0, y0 + (u ? 0 : rc), max(1, g_s), s - (u ? 0 : rc) - (d ? 0 : rc));
            !rt ? gfx_rect(x0 + s - max(1, g_s), y0 + (u ? 0 : rc), max(1, g_s), s - (u ? 0 : rc) - (d ? 0 : rc));
            gfx_set(xs_rr[th], xs_rg[th], xs_rb[th], 0.07);
            !d ? gfx_rect(x0, y0 + s, s, 8 * g_s);
            !u ? gfx_rect(x0, y0 - 8 * g_s, s, 8 * g_s);
            gfx_mode = 0;
          );
        );
        c += 1;
      );
      r += 1;
    );
    pass += 1;
  );
);

function xs_px(x) ( g_xsp_x + x * g_xsp_k * (x < 0 ? g_xsp_l : g_xsp_r); );
function xs_py(y) ( g_xsp_y + y * g_xsp_k; );
function xs_tri(ax, ay, bx, by, cx, cy) ( gfx_triangle(xs_px(ax), xs_py(ay), xs_px(bx), xs_py(by), xs_px(cx), xs_py(cy)); );
function xs_quad(ax, ay, bx, by, cx, cy, dx, dy) ( gfx_triangle(xs_px(ax), xs_py(ay), xs_px(bx), xs_py(by), xs_px(cx), xs_py(cy), xs_px(dx), xs_py(dy)); );

function xs_ship(x, y, bank, a) local(f, k, m, sh, sl, l, d)
(
  g_xsp_x = sx(x); g_xsp_y = sy(y); g_xsp_k = g_s * 0.95 * (g_xs_ssc > 0 ? g_xs_ssc : 1);
  g_xsp_l = 1 - 0.28 * max(0, bank); g_xsp_r = 1 - 0.28 * max(0, -bank);
  sl = 0.5 + 0.25 * bank; sh = 0.5 - 0.25 * bank;
  f = 0.75 + 0.25 * hash(floor(g_t * 50));
  gfx_mode = 1;
  m = -1;
  loop(2,
    gfx_set(0.2, 0.45, 1, 0.22 * a); xs_tri(m * 8, 24, m * 2, 24, m * 5, 24 + (28 + 18 * f));
    gfx_set(0.55, 0.8, 1, 0.55 * a); xs_tri(m * 7, 24, m * 3, 24, m * 5, 24 + (16 + 10 * f));
    gfx_set(0.95, 0.98, 1, 0.9 * a); xs_tri(m * 6, 24, m * 4, 24, m * 5, 24 + (7 + 4 * f));
    gfx_set(0.3, 0.6, 1, 0.14 * a); gfx_circle(xs_px(m * 5), xs_py(30), 11 * g_xsp_k, 1, 1);
    m += 2;
  );
  gfx_mode = 0;
  m = -1;
  loop(2,
    l = m < 0 ? sl : sh;
    gfx_set(0.05, 0.06, 0.08, a); xs_quad(m * 5, -6, m * 33, 14, m * 31, 22, m * 5, 18);
    gfx_set(0.16 + 0.3 * l, 0.18 + 0.32 * l, 0.23 + 0.36 * l, a); xs_quad(m * 6, -4, m * 31, 14, m * 29, 19, m * 6, 16);
    gfx_set(0.3 + 0.4 * l, 0.33 + 0.42 * l, 0.4 + 0.45 * l, a); xs_tri(m * 6, -4, m * 31, 14, m * 9, 8);
