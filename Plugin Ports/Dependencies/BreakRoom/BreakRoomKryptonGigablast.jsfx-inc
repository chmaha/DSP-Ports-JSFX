    gfx_set(0.5, 0.44, 0.42, 1); gfx_triangle(x + k * r * 1.5, y, x - k * r, y - r * 0.85, x - k * r * 0.3, y);
    gfx_set(0.7, 0.66, 0.6, 1); gfx_triangle(x + k * r * 1.5, y, x + k * r * 1.95, y - r * 0.18, x + k * r * 1.95, y + r * 0.18);
    gfx_mode = 1; gfx_set(1, 0.1, 0.05, 0.9); gfx_rect(x + k * r * 0.2 - 4 * g_s, y - r * 0.25, 8 * g_s, 3 * g_s); gfx_mode = 0;
  ) : t == 12 ? (
