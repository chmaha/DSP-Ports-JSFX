    k += 1;
  );
);

function xs_db_hive(t) local(x, y, s, k, a, f, ax, ay, r, ph, fl)
(
  x = sx(g_xs_bx); y = sy(g_xs_by); s = g_s; ph = g_xs_bph;
  k = 0;
  loop(8,
    a = $pi * (0.15 + k * 0.1) + sin(t * 1.3 + k) * 0.12;
    f = 0;
    loop(8,
      ax = x + cos(a + f * 0.06 * sin(t + k)) * (90 + f * 22) * s * (k < 4 ? -1 : 1) * (k < 4 ? 1 : 1);
      ay = y + 40 * s + sin(a) * (40 + f * 16) * s;
      xs_bset(0.15 + 0.05 * f, 0.06, 0.1, 1); gfx_circle(ax, ay, (12 - f) * s, 1, 1);
      f += 1;
    );
    xs_bset(0.8, 0.75, 0.65, 1); gfx_triangle(ax - 4 * s, ay, ax + 4 * s, ay, ax, ay + 16 * s);
    k += 1;
  );
  gfx_mode = 1; xs_bset(ph == 3 ? 1 : 0.5, ph == 3 ? 0.15 : 0.1, ph == 3 ? 0.1 : 0.4, 0.1 + 0.05 * sin(t * 4)); gfx_circle(x, y, 200 * s, 1, 1); gfx_mode = 0;
  k = 0;
  loop(30,
    a = k * 0.71; f = 0.35 + 0.65 * hash(k * 1.3);
    ax = x + cos(a) * 125 * f * s; ay = y - 30 * s + sin(a) * 72 * f * s;
    xs_bset(0.18 + 0.06 * hash(k), 0.08, 0.14, 1); gfx_circle(ax, ay, (42 - 18 * f) * s, 1, 1);
    xs_bset(0.36 + 0.08 * hash(k * 3), 0.16, 0.26, 1); gfx_circle(ax - 5 * s, ay - 6 * s, (32 - 15 * f) * s, 1, 1);
    xs_bset(0.1, 0.03, 0.06, 1); gfx_arc(ax - 5 * s, ay - 6 * s, (24 - 11 * f) * s, a, a + 2.2, 1);
    k += 1;
  );
  gfx_mode = 1;
  k = 0; loop(14, a = k * 0.45 + t * 0.2; xs_bset(ph == 3 ? 1 : 0.5, ph == 3 ? 0.2 : 0.9, ph == 3 ? 0.1 : 0.7, 0.18 + 0.12 * sin(t * 5 + k)); gfx_line(x + cos(a) * 30 * s, y - 30 * s + sin(a) * 20 * s, x + cos(a + 0.4) * 120 * s, y - 30 * s + sin(a + 0.4) * 70 * s, 1); k += 1; );
  gfx_mode = 0;
  k = 0;
  loop(7,
    a = $pi * (1.1 + k * 0.13);
    xs_bset(0.07, 0.06, 0.07, 1); gfx_triangle(x + cos(a - 0.1) * 120 * s, y - 30 * s + sin(a - 0.1) * 80 * s, x + cos(a + 0.1) * 120 * s, y - 30 * s + sin(a + 0.1) * 80 * s, x + cos(a) * 160 * s, y - 30 * s + sin(a) * 112 * s);
    xs_bset(0.4, 0.38, 0.38, 1); gfx_line(x + cos(a) * 124 * s, y - 30 * s + sin(a) * 84 * s, x + cos(a) * 160 * s, y - 30 * s + sin(a) * 112 * s, 1);
    k += 1;
  );
  k = 0;
  loop(4,
    ax = sx(xp_x[k]); ay = sy(xp_y[k]); r = xp_r[k] * s;
    xs_bset(0.05, 0.04, 0.05, 1); gfx_circle(ax, ay, r * 1.45, 1, 1);
    xs_bset(0.28, 0.26, 0.28, 1); gfx_circle(ax, ay, r * 1.25, 0, 1);
    xp_on[k] ? xs_eye(ax, ay, r, xs_fl(k), xp_hp[k] / xp_hm[k]) : (
      xs_bset(0.08, 0.02, 0.03, 1); gfx_circle(ax, ay, r, 1, 1);
      rand(1) < 0.3 ? xs_smoke(xp_x[k], xp_y[k], 8, 1);
    );
    k += 1;
  );
  xp_on[6] ? ( xs_bset(0.3, 0.12, 0.2, 1); tline(x, y + 60 * s, sx(xp_x[6]), sy(xp_y[6]), 7 * s); xs_eye(sx(xp_x[6]), sy(xp_y[6]), 10 * s, 0, 1); );
  ax = sx(xp_x[4]); ay = sy(xp_y[4]); r = xp_r[4] * s;
  ph == 1 ? (
    xs_bset(0.12, 0.12, 0.13, 1); gfx_circle(ax, ay, r * 1.2, 1, 1);
    k = 0; loop(6, a = k * $pi / 3 + t * 0.4; xs_bset(0.35, 0.35, 0.38, 1); gfx_triangle(ax, ay, ax + cos(a) * r * 1.15, ay + sin(a) * r * 1.15, ax + cos(a + 0.9) * r * 1.15, ay + sin(a + 0.9) * r * 1.15); xs_bset(0.06, 0.06, 0.07, 1); gfx_line(ax, ay, ax + cos(a) * r * 1.15, ay + sin(a) * r * 1.15, 1); k += 1; );
  ) : xp_on[4] ? (
    gfx_mode = 1; xs_bset(ph == 3 ? 1 : 0.4, ph == 3 ? 0.15 : 1, ph == 3 ? 0.1 : 0.6, 0.35); gfx_circle(ax, ay, r * 2.2, 1, 1); gfx_mode = 0;
    xs_eye(ax, ay, r, xs_fl(4), xp_hp[4] / xp_hm[4]);
    ph == 3 ? ( gfx_mode = 1; xs_bset(1, 0.1, 0.05, 0.3 + 0.3 * sin(t * 12)); gfx_circle(ax, ay, r * 1.3, 0, 1); gfx_circle(ax, ay, r * 1.4, 0, 1); gfx_mode = 0; );
  );
);

function xs_db_warden(t) local(x, y, s, k, a, ax, ay, r, f, op, fl)
(
  x = sx(g_xs_bx); y = sy(g_xs_by); s = g_s; op = xs_core_open();
  f = op ? min(1, (t - g_xs_open_t) * 2) : 0;
  !op ? g_xs_open_t = t;
  xs_bset(0.05, 0.04, 0.04, 1); fan(x, y + 34 * s, 70 * s, 0, $pi, 20);
