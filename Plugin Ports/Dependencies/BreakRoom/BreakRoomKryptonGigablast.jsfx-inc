      k += 1;
    );
    fl ? gfx_set(1, 1, 1, 1) : gfx_set(0.07, 0.08, 0.06, 1); gfx_circle(x, y, r, 1, 1);
    k = 0;
    loop(5,
      ang = k * $pi * 2 / 5 + a * 0.2;
      gfx_set(0.2, 0.23, 0.16, 1);
      gfx_triangle(x + cos(ang) * r * 0.25, y + sin(ang) * r * 0.25, x + cos(ang - 0.55) * r * 0.9, y + sin(ang - 0.55) * r * 0.9, x + cos(ang + 0.55) * r * 0.9, y + sin(ang + 0.55) * r * 0.9);
      k += 1;
    );
