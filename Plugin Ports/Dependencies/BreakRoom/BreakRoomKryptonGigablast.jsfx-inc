    gfx_mode = 1; gfx_set(0.85, 0.4, 1, 0.5 + 0.3 * sin(a * 5 + i)); gfx_circle(x, y, r * 0.35, 1, 1); gfx_set(0.7, 0.3, 1, 0.15); gfx_circle(x, y, r * 1.6, 1, 1); gfx_mode = 0;
  ) : t == 9 ? (
