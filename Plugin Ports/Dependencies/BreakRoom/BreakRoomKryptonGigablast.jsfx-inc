    fl ? gfx_set(1, 1, 1, 1) : gfx_set(0.75, 0.6, 1, 1); gfx_triangle(x + cos(ang) * r * 1.3, y + sin(ang) * r * 1.3, x + cos(ang + 2.4) * r * 0.8, y + sin(ang + 2.4) * r * 0.8, x + cos(ang + 3.9) * r * 0.8, y + sin(ang + 3.9) * r * 0.8);
    gfx_mode = 1; gfx_set(0.8, 0.5, 1, 0.3); gfx_circle(x, y, r * 1.5, 1, 1); gfx_mode = 0;
