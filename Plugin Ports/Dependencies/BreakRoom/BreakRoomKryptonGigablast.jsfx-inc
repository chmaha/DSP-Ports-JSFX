      gfx_set(0.3, 0.8, 1, 0.5 * f); tline(x, y, sx(xn_x[j]), sy(xn_y[j]), 2 * g_s);
      gfx_set(0.3, 0.8, 1, 0.12 * f); gfx_circle(sx(xn_x[j]), sy(xn_y[j]), (xs_rad(xn_t[j]) + 10) * g_s, 1, 1);
      gfx_set(0.5, 0.9, 1, 0.7 * f); gfx_circle(sx(xn_x[j]), sy(xn_y[j]), (xs_rad(xn_t[j]) + 10) * g_s, 0, 1);
      gfx_mode = 0;
    );
    gfx_set(0.04, 0.05, 0.06, 1); k = 0; loop(6, ang = k * $pi / 3 + a; gfx_triangle(x, y, x + cos(ang) * r * 1.3, y + sin(ang) * r * 1.3, x + cos(ang + $pi / 3) * r * 1.3, y + sin(ang + $pi / 3) * r * 1.3); k += 1; );
    fl ? gfx_set(1, 1, 1, 1) : gfx_set(0.22, 0.26, 0.3, 1); k = 0; loop(6, ang = k * $pi / 3 + a; gfx_triangle(x, y, x + cos(ang) * r * 1.05, y + sin(ang) * r * 1.05, x + cos(ang + $pi / 3) * r * 1.05, y + sin(ang + $pi / 3) * r * 1.05); k += 1; );
    gfx_mode = 1; gfx_set(0.3, 0.85, 1, 1); gfx_circle(x, y, r * 0.4, 1, 1); gfx_set(0.3, 0.85, 1, 0.25); gfx_circle(x, y, r * 1.2, 1, 1); gfx_mode = 0;
  ) : t == 13 ? (
    f = 1 + 0.08 * sin(a * 4 + i);
    k = 0; loop(4, gfx_set(0.25, 0.3, 0.08, 1); tline(x + (k - 1.5) * r * 0.4, y + r * 0.7, x + (k - 1.5) * r * 0.5 + sin(a * 3 + k) * 4 * g_s, y + r * 1.6, 1.5 * g_s); k += 1; );
    gfx_set(0.08, 0.1, 0.03, 1); gfx_circle(x, y, r * 1.12 * f, 1, 1);
    fl ? gfx_set(1, 1, 1, 1) : gfx_set(0.48, 0.55, 0.16, 1); gfx_circle(x, y, r * f, 1, 1);
    gfx_set(0.62, 0.7, 0.24, 1); gfx_circle(x - r * 0.3, y - r * 0.3, r * 0.35, 1, 1);
    gfx_set(0.3, 0.34, 0.08, 1); gfx_circle(x + r * 0.35, y + r * 0.1, r * 0.18, 1, 1); gfx_circle(x - r * 0.1, y + r * 0.45, r * 0.13, 1, 1);
    gfx_mode = 1; gfx_set(0.7, 1, 0.2, 0.15 + 0.1 * sin(a * 4 + i)); gfx_circle(x, y, r * 1.8, 1, 1); gfx_mode = 0;
  ) : t == 14 ? (
    k = 0;
    loop(7,
      ang = $pi * (0.15 + 0.7 * k / 6) + 0.25 * sin(a * 3 + k);
      gfx_set(0.1, 0.04, 0.12, 1); tline(x, y, x + cos(ang) * r * 1.9, y + sin(ang) * r * 1.9, 4 * g_s);
      gfx_set(0.3, 0.12, 0.32, 1); tline(x, y, x + cos(ang) * r * 1.8, y + sin(ang) * r * 1.8, 2 * g_s);
      k += 1;
    );
    gfx_set(0.04, 0.02, 0.05, 1); gfx_circle(x, y, r * 1.1, 1, 1);
    fl ? gfx_set(1, 1, 1, 1) : gfx_set(0.22, 0.1, 0.25, 1); gfx_circle(x, y, r, 1, 1);
    gfx_set(0.32, 0.16, 0.35, 1); gfx_circle(x - r * 0.25, y - r * 0.3, r * 0.45, 1, 1);
    gfx_set(0.05, 0.01, 0.02, 1); gfx_circle(x, y + r * 0.35, r * 0.32, 1, 1);
    gfx_mode = 1; gfx_set(1, 0.15, 0.1, 1); gfx_circle(x - r * 0.35, y - r * 0.15, r * 0.14, 1, 1); gfx_circle(x + r * 0.35, y - r * 0.15, r * 0.14, 1, 1); gfx_circle(x, y - r * 0.4, r * 0.1, 1, 1);
    gfx_set(1, 0.1, 0.1, 0.2); gfx_circle(x, y, r * 1.6, 1, 1); gfx_mode = 0;
  ) : t == 15 ? (
    k = xn_c[i];
    gfx_set(0.05, 0.03, 0.03, 1); gfx_triangle(x + k * r * 1.6, y, x - k * r * 1.2, y - r * 0.7, x - k * r * 1.2, y + r * 0.7);
    gfx_triangle(x, y, x - k * r * 0.6, y - r * 1.5, x - k * r * 1.3, y - r * 1.3); gfx_triangle(x, y, x - k * r * 0.6, y + r * 1.5, x - k * r * 1.3, y + r * 1.3);
    fl ? gfx_set(1, 1, 1, 1) : gfx_set(0.3, 0.16, 0.12, 1); gfx_triangle(x + k * r * 1.35, y, x - k * r, y - r * 0.55, x - k * r, y + r * 0.55);
    gfx_mode = 1; f = 0.6 + 0.4 * sin(a * 5);
    gfx_set(1, 0.4, 0.05, 0.9 * f); gfx_circle(x, y + r * 0.2, r * 0.45, 1, 1); gfx_set(1, 0.3, 0.05, 0.25); gfx_circle(x, y + r * 0.3, r * 1.4, 1, 1);
    gfx_set(1, 0.85, 0.3, 1); gfx_circle(x + k * r * 0.8, y - r * 0.1, r * 0.12, 1, 1); gfx_mode = 0;
  ) : t == 16 ? (
    f = sin(a * 11 + i); k = xn_a[i];
    gfx_mode = 1;
    j = g_xs_t - xn_t0[i];
    (k && j < 0.9) ? ( gfx_set(0.6, 0.8, 1, 0.6 * (1 - j / 0.9)); gfx_circle(x, y, r * (1 + 3 * j), 1, 1); );
    k ? gfx_set(0.4, 0.7, 1, 0.8) : gfx_set(1, 0.45, 0.05, 0.8);
    gfx_triangle(x - r * 0.3, y, x - r * 2, y - r * (0.2 + 0.9 * f), x - r * 0.8, y + r * 0.4);
    gfx_triangle(x + r * 0.3, y, x + r * 2, y - r * (0.2 + 0.9 * f), x + r * 0.8, y + r * 0.4);
    k ? gfx_set(0.7, 0.9, 1, 0.9) : gfx_set(1, 0.8, 0.2, 0.9);
    gfx_triangle(x - r * 0.3, y + r * 0.2, x + r * 0.3, y + r * 0.2, x + 4 * sin(a * 9) * g_s, y - r * 1.8);
    gfx_triangle(x - r * 0.25, y, x + r * 0.25, y, x, y + r * 1.4);
    gfx_set(k ? 0.4 : 1, k ? 0.6 : 0.3, k ? 1 : 0.05, 0.3); gfx_circle(x, y, r * 1.6, 1, 1);
    gfx_mode = 0;
    fl ? gfx_set(1, 1, 1, 1) : gfx_set(0.12, 0.05, 0.03, 1); gfx_circle(x, y, r * 0.42, 1, 1);
    gfx_mode = 1; gfx_set(1, 1, 0.6, 1); gfx_circle(x - r * 0.15, y - r * 0.1, r * 0.1, 1, 1); gfx_circle(x + r * 0.15, y - r * 0.1, r * 0.1, 1, 1); gfx_mode = 0;
  ) : (
    k = 0;
    loop(10,
      ang = k * $pi / 5 + a * 1.6;
      gfx_set(0.5, 0.52, 0.56, 1);
      gfx_triangle(x + cos(ang - 0.2) * r * 0.8, y + sin(ang - 0.2) * r * 0.8, x + cos(ang) * r * 1.55, y + sin(ang) * r * 1.55, x + cos(ang + 0.2) * r * 0.8, y + sin(ang + 0.2) * r * 0.8);
      k += 1;
    );
    fl ? gfx_set(1, 1, 1, 1) : gfx_set(0.1, 0.1, 0.12, 1); gfx_circle(x, y, r, 1, 1);
    gfx_set(0.3, 0.3, 0.34, 1); gfx_circle(x - r * 0.15, y - r * 0.15, r * 0.7, 1, 1);
    gfx_set(0.5, 0.5, 0.55, 1); gfx_circle(x - r * 0.35, y - r * 0.35, r * 0.2, 1, 1);
    f = frac(a * 2 + i * 0.3) < 0.5;
    gfx_mode = 1; gfx_set(1, 0.15, 0.1, f ? 1 : 0.3); gfx_circle(x + r * 0.2, y + r * 0.2, r * 0.22, 1, 1); f ? gfx_circle(x + r * 0.2, y + r * 0.2, r * 0.6, 0, 1); gfx_mode = 0;
  );
);

function xs_hbeat(t) local(p) ( p = frac(t * 0.85); max(max(0, 1 - abs(p - 0.04) * 11), 0.7 * max(0, 1 - abs(p - 0.2) * 11)); );

function xs_bset(r, g, b, a) local(l)
(
  (gfx_mode & 1) ? gfx_set(r, g, b, a) : (
    l = 0.3 * r + 0.59 * g + 0.11 * b;
    gfx_set(min(1, (l + (r - l) * 0.5) * 0.62 + 0.03), (l + (g - l) * 0.5) * 0.5, (l + (b - l) * 0.5) * 0.52, a);
  );
);

function xs_eye(x, y, r, fl, hp) local(ang, ex, ey, k, a)
(
  ang = atan2(sy(g_xs_py) - y, sx(g_xs_px) - x);
  gfx_set(0.12, 0.02, 0.03, 1); gfx_circle(x, y, r * 1.15, 1, 1);
  fl ? gfx_set(1, 0.6, 0.6, 1) : gfx_set(0.72, 0.62 - 0.2 * (1 - hp), 0.38 - 0.2 * (1 - hp), 1);
  gfx_circle(x, y, r, 1, 1);
  gfx_set(0.55, 0.38, 0.2, 1); gfx_circle(x + r * 0.15, y + r * 0.2, r * 0.8, 1, 1);
  gfx_set(0.72, 0.62 - 0.2 * (1 - hp), 0.38 - 0.2 * (1 - hp), 1); gfx_circle(x - r * 0.1, y - r * 0.1, r * 0.75, 1, 1);
  gfx_set(0.7, 0.08, 0.06, 0.9);
  k = 0; loop(7, a = k * 0.9 + 0.3; gfx_line(x + cos(a) * r * 0.95, y + sin(a) * r * 0.95, x + cos(a + 0.25) * r * 0.5, y + sin(a + 0.25) * r * 0.5, 1); k += 1; );
  ex = x + cos(ang) * r * 0.35; ey = y + sin(ang) * r * 0.35;
  gfx_mode = 1; gfx_set(1, 0.2, 0.05, 0.4); gfx_circle(ex, ey, r * 0.75, 1, 1); gfx_mode = 0;
  gfx_set(0.85, 0.15 + 0.35 * hp, 0.02, 1); gfx_circle(ex, ey, r * 0.52, 1, 1);
  gfx_set(1, 0.6, 0.1, 1); gfx_circle(ex - r * 0.08, ey - r * 0.08, r * 0.3, 1, 1);
  gfx_set(0.02, 0, 0, 1); gfx_triangle(ex, ey - r * 0.48, ex + r * 0.1, ey, ex, ey + r * 0.48, ex - r * 0.1, ey);
  gfx_set(1, 1, 1, 0.7); gfx_circle(ex - r * 0.2, ey - r * 0.22, max(1, r * 0.08), 1, 1);
);

function xs_draw_boss0() local(t, x, y, k, j, ax, ay, tx, ty, f, r, a, cr, cg, cb, fl, open, hp, n)
(
  t = g_xs_t - g_xs_bt0;
  x = sx(g_xs_bx); y = sy(g_xs_by);
  open = xs_core_open();
  g_xs_boss == 3 ? ( x += (rand(1) - 0.5) * 6 * g_s; y += (rand(1) - 0.5) * 6 * g_s; );
  g_xs_bt == 0 ? (
    k = 3;
    loop(4,
      ax = x + xp_ox[k] * 0.45 * g_s; ay = y + 40 * g_s;
      tx = sx(xp_x[k]); ty = sy(xp_y[k]);
      j = 0;
      loop(10,
        f = j / 9;
        r = (12 - 7 * f) * g_s;
        a = sin(t * 2 + k + f * 4) * 12 * g_s * f;
        xs_bset(0.16 + 0.08 * f, 0.1, 0.09, 1); gfx_circle(ax + (tx - ax) * f + a, ay + (ty - ay) * f, r, 1, 1);
        xs_bset(0.55, 0.5, 0.42, 1);
        gfx_triangle(ax + (tx - ax) * f + a - r * 0.5, ay + (ty - ay) * f, ax + (tx - ax) * f + a + r * 0.5, ay + (ty - ay) * f, ax + (tx - ax) * f + a + (k < 5 ? -1 : 1) * r * 1.4, ay + (ty - ay) * f - r * 0.4);
        j += 1;
      );
      xs_bset(0.7, 0.66, 0.56, 1);
      gfx_triangle(tx - 6 * g_s, ty, tx - 2 * g_s, ty + 16 * g_s, tx + 1 * g_s, ty);
      gfx_triangle(tx + 6 * g_s, ty, tx + 2 * g_s, ty + 16 * g_s, tx - 1 * g_s, ty);
      gfx_mode = 1; xs_bset(1, 0.25, 0.1, 0.5 + 0.3 * sin(t * 4 + k)); gfx_circle(tx, ty, 5 * g_s, 1, 1); gfx_mode = 0;
      k += 1;
    );
    gfx_mode = 1; xs_bset(0.8, 0.1, 0.05, 0.08); gfx_circle(x, y, 160 * g_s, 1, 1); gfx_mode = 0;
    f = 1 + 0.025 * sin(t * 2.2);
    xs_bset(0.08, 0.05, 0.05, 1); fan(x, y + 40 * g_s, 122 * g_s * f, $pi, 2 * $pi, 30);
    xs_bset(0.22, 0.14, 0.12, 1); fan(x, y + 40 * g_s, 114 * g_s * f, $pi, 2 * $pi, 30);
    k = 0;
    loop(7,
      a = $pi * (1.08 + k * 0.14);
      xs_bset(0.5, 0.46, 0.38, 1);
      gfx_triangle(x + cos(a - 0.06) * 60 * g_s, y + 40 * g_s + sin(a - 0.06) * 60 * g_s, x + cos(a) * 124 * g_s * f, y + 40 * g_s + sin(a) * 124 * g_s * f, x + cos(a + 0.06) * 60 * g_s, y + 40 * g_s + sin(a + 0.06) * 60 * g_s);
      xs_bset(0.72, 0.68, 0.58, 1);
      gfx_triangle(x + cos(a + 0.02) * 120 * g_s * f, y + 40 * g_s + sin(a + 0.02) * 120 * g_s * f, x + cos(a) * 150 * g_s * f, y + 40 * g_s + sin(a) * 150 * g_s * f, x + cos(a + 0.06) * 118 * g_s * f, y + 40 * g_s + sin(a + 0.06) * 118 * g_s * f);
      k += 1;
    );
    xs_bset(0.6, 0.56, 0.46, 1); fan(x, y + 34 * g_s, 78 * g_s * f, $pi * 1.05, $pi * 1.95, 18);
    xs_bset(0.42, 0.38, 0.3, 1); fan(x, y + 34 * g_s, 60 * g_s * f, $pi * 1.05, $pi * 1.95, 18);
    xs_bset(0.3, 0.26, 0.2, 1); gfx_line(x - 20 * g_s, y - 30 * g_s, x - 5 * g_s, y, 1); gfx_line(x + 30 * g_s, y - 20 * g_s, x + 12 * g_s, y + 8 * g_s, 1);
    xs_bset(0.08, 0.05, 0.05, 1); gfx_rect(x - 112 * g_s, y + 34 * g_s, 224 * g_s, 14 * g_s);
    k = 0; loop(14, xs_bset(0.72, 0.68, 0.58, 1); gfx_triangle(x - 108 * g_s + k * 16 * g_s, y + 40 * g_s, x - 100 * g_s + k * 16 * g_s, y + 40 * g_s, x - 104 * g_s + k * 16 * g_s, y + 54 * g_s); k += 1; );
    k = 0;
    loop(2,
      ax = sx(xp_x[k]); ay = sy(xp_y[k]); r = xp_r[k] * g_s;
      xs_bset(0.03, 0.02, 0.02, 1); gfx_circle(ax, ay, r * 1.35, 1, 1);
      xp_on[k] ? (
        fl = g_xs_t - xp_f[k] < 0.05;
        a = atan2(sy(g_xs_py) - ay, sx(g_xs_px) - ax);
        gfx_mode = 1;
        xs_bset(1, 0.25, 0.05, 0.3); gfx_circle(ax, ay, r * 1.6, 1, 1);
        fl ? xs_bset(1, 1, 1, 1) : xs_bset(1, 0.35 + 0.3 * xp_hp[k] / xp_hm[k], 0.05, 1); gfx_circle(ax + cos(a) * r * 0.25, ay + sin(a) * r * 0.25, r * 0.6, 1, 1);
        xs_bset(1, 0.95, 0.7, 1); gfx_circle(ax + cos(a) * r * 0.35, ay + sin(a) * r * 0.35, r * 0.22, 1, 1);
        gfx_mode = 0;
      ) : (
        gfx_mode = 1; xs_bset(1, 0.3, 0.1, 0.2 + 0.2 * sin(t * 9 + k)); gfx_circle(ax, ay, r * 0.5, 1, 1); gfx_mode = 0;
        rand(1) < 0.3 ? spawn(xp_x[k], xp_y[k], (rand(1) - 0.5) * 40, -30 - rand(1) * 40, 0.5, 0.3, 0.2, 0.6);
      );
      k += 1;
    );
    xp_on[2] ? (
      ax = sx(xp_x[2]); ay = sy(xp_y[2]); r = xp_r[2] * g_s;
      fl = g_xs_t - xp_f[2] < 0.05;
      f = open ? min(1, 0.6 + 0.4 * sin(t * 6)) : 0.15;
      xs_bset(0.05, 0.02, 0.02, 1); gfx_circle(ax, ay, r * 1.3, 1, 1);
      open ? (
        gfx_mode = 1; xs_bset(1, 0.2, 0.05, 0.35 * f); gfx_circle(ax, ay, r * 2.2, 1, 1); gfx_mode = 0;
        fl ? xs_bset(1, 1, 1, 1) : xs_bset(0.95, 0.25 + 0.2 * f, 0.08, 1); gfx_circle(ax, ay, r * 0.85 * f + r * 0.1, 1, 1);
        xs_bset(1, 0.85, 0.5, 1); gfx_circle(ax, ay, r * 0.3 * f, 1, 1);
      );
      k = 0;
      loop(8,
        a = k * $pi / 4 + t * 0.3;
        xs_bset(0.72, 0.68, 0.58, 1);
        gfx_triangle(ax + cos(a - 0.2) * r * 1.3, ay + sin(a - 0.2) * r * 1.3, ax + cos(a + 0.2) * r * 1.3, ay + sin(a + 0.2) * r * 1.3, ax + cos(a) * r * (1.3 - 0.9 * (1 - f)), ay + sin(a) * r * (1.3 - 0.9 * (1 - f)));
        k += 1;
      );
    );
  ) : g_xs_bt == 4 ? (
    k = 0;
    loop(26,
      a = k * 0.71; f = 0.4 + 0.6 * hash(k * 1.3);
      ax = x + cos(a) * 110 * f * g_s; ay = y - 20 * g_s + sin(a) * 62 * f * g_s;
      xs_bset(0.42 + 0.1 * hash(k), 0.2, 0.36, 1); gfx_circle(ax, ay, (34 - 14 * f) * g_s, 1, 1);
      xs_bset(0.62, 0.32, 0.5, 1); gfx_circle(ax - 4 * g_s, ay - 5 * g_s, (26 - 12 * f) * g_s, 1, 1);
      k += 1;
    );
    k = 0;
    loop(12,
      a = k * 0.53 + t * 0.3;
      xs_bset(0.3, 0.12, 0.25, 1);
      gfx_arc(x + cos(a) * 50 * g_s, y - 20 * g_s + sin(a * 1.3) * 30 * g_s, 20 * g_s, a, a + 2, 1);
      k += 1;
    );
    gfx_mode = 1;
    k = 0; loop(8, xs_bset(0.6, 1, 0.8, 0.08 + 0.06 * sin(t * 3 + k)); gfx_circle(x + (k - 3.5) * 28 * g_s, y - 30 * g_s + 18 * sin(k) * g_s, 12 * g_s, 1, 1); k += 1; );
    gfx_mode = 0;
    k = 0;
    loop(4,
      xp_on[k] ? xs_eye(sx(xp_x[k]), sy(xp_y[k]), xp_r[k] * g_s, g_xs_t - xp_f[k] < 0.06, xp_hp[k] / xp_hm[k]) : (
        xs_bset(0.1, 0.03, 0.06, 1); gfx_circle(sx(xp_x[k]), sy(xp_y[k]), xp_r[k] * g_s, 1, 1);
      );
      k += 1;
    );
    xp_on[6] ? (
      xs_bset(0.5, 0.25, 0.4, 1); tline(x, y + 50 * g_s, sx(xp_x[6]), sy(xp_y[6]), 6 * g_s);
      xs_eye(sx(xp_x[6]), sy(xp_y[6]), 10 * g_s, 0, 1);
    );
    xp_on[4] ? (
      ax = sx(xp_x[4]); ay = sy(xp_y[4]); r = xp_r[4] * g_s; fl = g_xs_t - xp_f[4] < 0.06;
      open ? (
        gfx_mode = 1; xs_bset(0.4, 1, 0.7, 0.3); gfx_circle(ax, ay, r * 2.2, 1, 1); gfx_mode = 0;
        xs_eye(ax, ay, r, fl, xp_hp[4] / xp_hm[4]);
      ) : (
        xs_bset(0.3, 0.12, 0.25, 1); gfx_circle(ax, ay, r, 1, 1);
        xs_bset(0.55, 0.25, 0.45, 1); gfx_line(ax - r, ay, ax + r, ay, 1); gfx_line(ax - r * 0.8, ay - 2 * g_s, ax + r * 0.8, ay - 2 * g_s, 1);
      );
    );
  ) : (
    xs_th_set(1); cr = g_cr; cg = g_cg; cb = g_cb;
    f = open ? min(1, (t - g_xs_open_t) * 2) : 0;
    !open ? g_xs_open_t = t;
    k = 0;
    loop(2,
      xp_on[k] ? (
        ax = sx(xp_x[k]); ay = sy(xp_y[k]); r = xp_r[k] * g_s; fl = g_xs_t - xp_f[k] < 0.06;
        xs_bset(0.08, 0.08, 0.09, 1); gfx_circle(ax, ay, r * 1.35, 1, 1);
        xs_bset(0.3, 0.3, 0.32, 1); gfx_circle(ax, ay, r * 1.15, 1, 1);
        xs_bset(0.06, 0.05, 0.05, 1); gfx_circle(ax, ay + r * 0.2, r * 0.8, 1, 1);
        gfx_mode = 1; xs_bset(1, 0.35, 0.05, 0.35); gfx_circle(ax, ay + r * 0.5, r * 1.3, 1, 1); gfx_mode = 0;
        fl ? xs_bset(1, 1, 1, 1) : xs_bset(1, 0.4 + 0.2 * sin(t * 9 + k), 0.05, 1); gfx_circle(ax, ay + r * 0.3, r * 0.55, 1, 1);
        xs_bset(1, 0.9, 0.6, 1); gfx_circle(ax, ay + r * 0.3, r * 0.22, 1, 1);
      );
      k += 1;
    );
    xp_on[2] ? (
      ax = sx(xp_x[2]); ay = sy(xp_y[2]); r = xp_r[2] * g_s; fl = g_xs_t - xp_f[2] < 0.06;
      gfx_mode = 1; xs_bset(1, 0.15, 0.05, 0.2 + 0.4 * f); gfx_circle(ax, ay, r * 2.2, 1, 1); gfx_mode = 0;
      xs_eye(ax, ay, r, fl, xp_hp[2] / xp_hm[2]);
    );
    ay = y - 8 * g_s - f * 26 * g_s;
    k = 0;
    loop(11,
      a = $pi + (k + 0.5) * $pi / 11;
      xs_bset(0.42, 0.4, 0.38, 1);
      gfx_triangle(x + cos(a - 0.08) * 86 * g_s, ay + 18 * g_s + sin(a - 0.08) * 86 * g_s, x + cos(a) * 118 * g_s, ay + 18 * g_s + sin(a) * 118 * g_s, x + cos(a + 0.08) * 86 * g_s, ay + 18 * g_s + sin(a + 0.08) * 86 * g_s);
      k += 1;
    );
    xs_bset(0.04, 0.04, 0.045, 1); fan(x, ay + 20 * g_s, 94 * g_s, $pi, 2 * $pi, 26);
    xs_bset(0.17, 0.17, 0.19, 1); fan(x, ay + 18 * g_s, 86 * g_s, $pi, 2 * $pi, 26);
    xs_bset(0.26, 0.26, 0.28, 1); fan(x - 8 * g_s, ay + 14 * g_s, 58 * g_s, $pi * 1.05, $pi * 1.6, 12);
    k = 0;
    loop(9,
      a = $pi + (k + 0.5) * $pi / 9;
      xs_bset(0.06, 0.06, 0.07, 1);
      tline(x + cos(a) * 20 * g_s, ay + 18 * g_s + sin(a) * 20 * g_s, x + cos(a) * 84 * g_s, ay + 18 * g_s + sin(a) * 84 * g_s, 3 * g_s);
      xs_bset(0.5, 0.5, 0.52, 1); gfx_circle(x + cos(a) * 70 * g_s, ay + 18 * g_s + sin(a) * 70 * g_s, 2 * g_s, 1, 1);
      k += 1;
    );
    gfx_mode = 1; xs_bset(1, 0.3, 0.05, 0.5 + 0.3 * sin(t * 5)); gfx_rect(x - 80 * g_s, ay + 14 * g_s, 160 * g_s, 3 * g_s); gfx_mode = 0;
  );
);

function xs_wk(k) ( xp_role[k] == 1 || (xp_role[k] == 2 && xs_core_open()); );
function xs_fl(k) ( g_xs_t - xp_f[k] < 0.05; );

function xs_beams() local(k, lt, a, x, y, w, ex, ey, ca, sa)
(
  k = 0;
  loop(NXP,
    (xp_on[k] && xp_k[k] == 7 && xp_bt[k] > 0) ? (
      lt = g_xs_t - xp_bt[k]; x = sx(xp_x[k]); y = sy(xp_y[k]);
      ca = cos(xp_bx[k]); sa = sin(xp_bx[k]);
      ex = x + ca * 900 * g_s; ey = y + sa * 900 * g_s;
      lt < 0.8 ? (
        a = 0.3 + 0.5 * (frac(lt * 8) < 0.5);
        gfx_set(1, 0.15, 0.1, a); tline(x, y, ex, ey, 2 * g_s);
        gfx_set(1, 0.15, 0.1, a * 0.3);
        gfx_line(x - sa * 18 * g_s, y + ca * 18 * g_s, ex - sa * 18 * g_s, ey + ca * 18 * g_s, 1);
        gfx_line(x + sa * 18 * g_s, y - ca * 18 * g_s, ex + sa * 18 * g_s, ey - ca * 18 * g_s, 1);
        gfx_mode = 1; gfx_set(1, 0.3, 0.2, 0.5 * lt); gfx_circle(x, y, (8 + 20 * lt) * g_s, 1, 1); gfx_mode = 0;
      ) : lt < 1.45 ? (
        a = min(1, (1.45 - lt) * 5); w = (20 + 4 * sin(g_t * 60)) * g_s;
        gfx_mode = 1;
        gfx_set(1, 0.2, 0.35, 0.35 * a); tline(x, y, ex, ey, w * 3.2);
        gfx_set(1, 0.5, 0.6, 0.6 * a); tline(x, y, ex, ey, w * 1.6);
        gfx_set(1, 0.95, 0.95, 0.9 * a); tline(x, y, ex, ey, w * 0.6);
        gfx_set(1, 0.6, 0.7, 0.8 * a); gfx_circle(x, y, 30 * g_s, 1, 1);
        gfx_mode = 0;
        g_xs_shake = max(g_xs_shake, 3);
      );
    );
    k += 1;
  );
);

function xs_db_reaper(t) local(x, y, k, j, a, f, ax, ay, bx, by, r, s, op, fl, side)
(
  x = sx(g_xs_bx); y = sy(g_xs_by); s = g_s;
  side = -1;
  loop(2,
    k = 0;
    loop(4,
      a = (k - 1.5) * 0.45 + sin(t * 6 + k * 1.3 + side) * 0.15;
      ax = x + side * (40 + k * 12) * s; ay = y + (k * 10 - 10) * s;
      bx = ax + side * 70 * s * cos(a); by = ay - 30 * s + sin(a) * 40 * s;
      xs_bset(0.08, 0.06, 0.12, 1); tline(ax, ay, bx, by, 5 * s); tline(bx, by, bx + side * 22 * s, by + 60 * s, 4 * s);
      xs_bset(0.45, 0.35, 0.7, 1); tline(ax, ay, bx, by, 1.6 * s); tline(bx, by, bx + side * 22 * s, by + 60 * s, 1.4 * s);
      xs_bset(0.7, 0.9, 1, 1); gfx_triangle(bx + side * 22 * s, by + 60 * s, bx + side * 18 * s, by + 52 * s, bx + side * 25 * s, by + 70 * s);
      k += 1;
    );
    side += 2;
  );
  k = 0;
  loop(12,
    f = k / 11;
    ax = x + sin(t * 1.5 + f * 3) * 20 * s * f; ay = y - (20 + f * 100) * s;
    xs_bset(0.1 + 0.15 * f, 0.07, 0.16 + 0.15 * f, 1); gfx_circle(ax, ay, (16 - 8 * f) * s, 1, 1);
    xs_bset(0.55, 0.4, 0.85, 1); gfx_arc(ax, ay, (16 - 8 * f) * s, -2.4, -0.7, 1);
    k += 1;
  );
  ax = sx(xp_x[5]); ay = sy(xp_y[5]);
  xs_bset(0.75, 0.9, 1, 1); gfx_triangle(ax - 8 * s, ay + 4 * s, ax + 8 * s, ay + 4 * s, ax, ay + 34 * s);
  gfx_mode = 1; xs_bset(0.6, 0.3, 1, 0.5 + 0.3 * sin(t * 7)); gfx_circle(ax, ay, 11 * s, 1, 1); gfx_mode = 0;
  k = 0;
  loop(2,
    side = k ? 1 : -1;
    ax = sx(xp_x[k]); ay = sy(xp_y[k]);
    xs_bset(0.06, 0.04, 0.1, 1); tline(x + side * 46 * s, y + 10 * s, ax, ay, 18 * s);
    xs_bset(0.3, 0.2, 0.5, 1); tline(x + side * 46 * s, y + 6 * s, ax, ay - 4 * s, 6 * s);
    op = 0.25 + 0.2 * sin(t * 3 + k * 2);
    xp_on[k] ? (
      fl = xs_fl(k);
      xs_bset(0.07, 0.05, 0.12, 1); gfx_circle(ax, ay, 26 * s, 1, 1);
      fl ? xs_bset(1, 1, 1, 1) : xs_bset(0.35, 0.25, 0.6, 1); gfx_circle(ax - 4 * s, ay - 4 * s, 20 * s, 1, 1);
      j = -1;
      loop(2,
        a = $pi * 0.5 + j * op - side * 0.15;
        xs_bset(0.1, 0.07, 0.16, 1);
        gfx_triangle(ax + side * 6 * s, ay + 10 * s, ax + side * 22 * s, ay + 4 * s, ax + cos(a) * 62 * s + side * 10 * s, ay + sin(a) * 62 * s + 10 * s);
        xs_bset(0.7, 0.9, 1, 1);
        gfx_triangle(ax + cos(a) * 62 * s + side * 10 * s, ay + sin(a) * 62 * s + 10 * s, ax + cos(a) * 44 * s + side * 10 * s, ay + sin(a) * 44 * s + 6 * s, ax + cos(a) * 46 * s + side * 16 * s, ay + sin(a) * 46 * s + 14 * s);
        j += 2;
      );
      gfx_mode = 1; xs_bset(0.6, 0.4, 1, 0.5 + 0.3 * sin(t * 6 + k)); gfx_circle(ax, ay, 9 * s, 1, 1); gfx_mode = 0;
    ) : (
      xs_bset(0.04, 0.03, 0.06, 1); gfx_circle(ax, ay, 18 * s, 1, 1);
      rand(1) < 0.4 ? spawn(xp_x[k], xp_y[k], (rand(1) - 0.5) * 60, -rand(1) * 80, 0.6, 0.4, 1, 0.5);
    );
    k += 1;
  );
  xs_bset(0.03, 0.02, 0.05, 1); fan(x, y + 26 * s, 92 * s, $pi, 2 * $pi, 28);
  xs_bset(0.13, 0.09, 0.2, 1); fan(x, y + 24 * s, 84 * s, $pi, 2 * $pi, 28);
  xs_bset(0.22, 0.16, 0.34, 1); fan(x - 10 * s, y + 18 * s, 54 * s, $pi * 1.08, $pi * 1.62, 12);
  k = 0;
  loop(9,
    a = $pi * (1.06 + k * 0.11);
    f = 26 + 18 * hash(k * 3.1);
    xs_bset(0.45, 0.6, 0.95, 1);
    gfx_triangle(x + cos(a - 0.05) * 78 * s, y + 24 * s + sin(a - 0.05) * 78 * s, x + cos(a) * (84 + f) * s, y + 24 * s + sin(a) * (84 + f) * s, x + cos(a + 0.05) * 78 * s, y + 24 * s + sin(a + 0.05) * 78 * s);
    xs_bset(0.85, 0.95, 1, 1);
    gfx_triangle(x + cos(a) * 80 * s, y + 24 * s + sin(a) * 80 * s, x + cos(a) * (84 + f) * s, y + 24 * s + sin(a) * (84 + f) * s, x + cos(a + 0.04) * 79 * s, y + 24 * s + sin(a + 0.04) * 79 * s);
    k += 1;
  );
  xs_bset(0.05, 0.03, 0.07, 1); gfx_rect(x - 70 * s, y + 18 * s, 140 * s, 22 * s);
  k = 0;
  loop(6,
    f = (k - 2.5) * 13 * s;
    gfx_mode = 1; xs_bset(1, 0.1, 0.1, 0.9); gfx_circle(x + f, y - 14 * s + abs(k - 2.5) * 3 * s, (k == 2 || k == 3 ? 5 : 3) * s, 1, 1);
    xs_bset(1, 0.1, 0.05, 0.25); gfx_circle(x + f, y - 14 * s + abs(k - 2.5) * 3 * s, 9 * s, 1, 1); gfx_mode = 0;
    k += 1;
  );
  xp_on[2] ? ( fl = xs_fl(2); fl ? ( xs_bset(1, 1, 1, 1); gfx_circle(sx(xp_x[2]), sy(xp_y[2]), 12 * s, 1, 1); ); );
  ax = sx(xp_x[3]); ay = sy(xp_y[3]); op = xs_core_open();
  k = -1;
  loop(2,
    f = op ? 0.5 + 0.3 * sin(t * 5) : 0.15;
    xs_bset(0.55, 0.7, 0.95, 1);
    gfx_triangle(ax + k * 8 * s, ay - 6 * s, ax + k * 34 * s, ay - 2 * s, ax + k * (12 + 20 * f) * s, ay + 40 * s);
    k += 2;
  );
  op && xp_on[3] ? (
    gfx_mode = 1; xs_bset(1, 0.2, 0.4, 0.4); gfx_circle(ax, ay + 8 * s, 30 * s, 1, 1); gfx_mode = 0;
    xs_fl(3) ? xs_bset(1, 1, 1, 1) : xs_bset(1, 0.3, 0.5, 1); gfx_circle(ax, ay + 8 * s, 13 * s, 1, 1);
    xs_bset(1, 0.85, 0.9, 1); gfx_circle(ax, ay + 8 * s, 5 * s, 1, 1);
  );
);

function xs_db_serpent(t) local(k, x, y, r, s, a, fl, nx, ny, d)
(
  s = g_s;
  k = NXP - 1;
  loop(NXP,
    k <= 9 && k >= 0 ? (
      x = sx(xp_x[k]); y = sy(xp_y[k]);
      r = (k == 0 ? 30 : 22 - k * 0.6) * s;
      fl = xp_on[k] && xs_fl(k);
      k < 9 ? (
        xs_bset(0.08, 0.07, 0.06, 1); tline(x, y, sx(xp_x[k + 1]), sy(xp_y[k + 1]), r * 0.9);
        xs_bset(0.3, 0.26, 0.2, 1); tline(x, y - r * 0.2, sx(xp_x[k + 1]), sy(xp_y[k + 1]) - r * 0.2, r * 0.25);
      );
      k > 0 ? (
        a = atan2(sy(xp_y[k - 1]) - y, sx(xp_x[k - 1]) - x) + $pi * 0.5;
        d = 0;
        loop(2,
          nx = x + cos(a) * r * (d ? 1.25 : -1.25); ny = y + sin(a) * r * (d ? 1.25 : -1.25);
          xs_bset(0.25, 0.2, 0.15, 1); tline(x, y, nx + sin(t * 9 + k) * 4 * s, ny + 10 * s, 3 * s);
          d += 1;
        );
        xs_bset(0.05, 0.05, 0.05, 1); gfx_circle(x, y, r, 1, 1);
        fl ? xs_bset(1, 1, 1, 1) : xs_bset(0.3, 0.27, 0.24, 1); gfx_circle(x, y - r * 0.08, r * 0.86, 1, 1);
        xs_bset(0.48, 0.44, 0.38, 1); gfx_circle(x - r * 0.25, y - r * 0.35, r * 0.4, 1, 1);
        xs_bset(0.1, 0.09, 0.08, 1); gfx_line(x - r * 0.8, y + r * 0.2, x + r * 0.8, y + r * 0.2, 1);
        d = 0; loop(4, xs_bset(0.62, 0.6, 0.55, 1); gfx_circle(x + cos(d * $pi * 0.5 + 0.8) * r * 0.65, y + sin(d * $pi * 0.5 + 0.8) * r * 0.65, 1.6 * s, 1, 1); d += 1; );
        (k & 1) ? (
          xp_on[k] ? (
            a = atan2(sy(g_xs_py) - y, sx(g_xs_px) - x);
            xs_bset(0.1, 0.1, 0.1, 1); tline(x, y, x + cos(a) * r * 1.3, y + sin(a) * r * 1.3, 6 * s);
            gfx_mode = 1; xs_bset(1, 0.5, 0.1, 0.8); gfx_circle(x, y, r * 0.32, 1, 1); gfx_mode = 0;
          ) : (
            xs_bset(0.02, 0.02, 0.02, 1); gfx_circle(x, y, r * 0.5, 1, 1);
            rand(1) < 0.25 ? xs_smoke(xp_x[k], xp_y[k], 6, 0.8);
          );
        ) : (
          xs_bset(0.85, 0.6, 0.05, 1); gfx_rect(x - r * 0.5, y + r * 0.35, r, r * 0.15);
        );
      ) : (
        a = atan2(sy(g_xs_py) - y, sx(g_xs_px) - x);
        nx = cos(a); ny = sin(a);
        xs_bset(0.04, 0.04, 0.04, 1); gfx_circle(x, y, r * 1.1, 1, 1);
        fl ? xs_bset(1, 1, 1, 1) : xs_bset(0.32, 0.29, 0.26, 1); gfx_circle(x - nx * r * 0.1, y - ny * r * 0.1, r * 0.95, 1, 1);
        xs_bset(0.55, 0.5, 0.44, 1); gfx_circle(x - nx * r * 0.3 - r * 0.2, y - ny * r * 0.3 - r * 0.3, r * 0.4, 1, 1);
        d = frac(t / 3.2) < 0.4 ? 0.6 : 0.25 + 0.1 * sin(t * 4);
        xs_bset(0.08, 0.07, 0.06, 1);
        gfx_triangle(x + nx * r * 0.3 - ny * r * 0.5, y + ny * r * 0.3 + nx * r * 0.5, x + nx * r * 1.7 - ny * r * (0.3 + d), y + ny * r * 1.7 + nx * r * (0.3 + d), x + nx * r * 1.1, y + ny * r * 1.1);
        gfx_triangle(x + nx * r * 0.3 + ny * r * 0.5, y + ny * r * 0.3 - nx * r * 0.5, x + nx * r * 1.7 + ny * r * (0.3 + d), y + ny * r * 1.7 - nx * r * (0.3 + d), x + nx * r * 1.1, y + ny * r * 1.1);
        xs_bset(0.85, 0.82, 0.75, 1);
        d = 0; loop(4, gfx_triangle(x + nx * r * (0.8 + d * 0.22) - ny * r * 0.35, y + ny * r * (0.8 + d * 0.22) + nx * r * 0.35, x + nx * r * (0.9 + d * 0.22) - ny * r * 0.1, y + ny * r * (0.9 + d * 0.22) + nx * r * 0.1, x + nx * r * (1 + d * 0.22) - ny * r * 0.35, y + ny * r * (1 + d * 0.22) + nx * r * 0.35); d += 1; );
        gfx_mode = 1;
        xs_bset(1, 0.1, 0.05, 1);
        gfx_circle(x + nx * r * 0.2 - ny * r * 0.45, y + ny * r * 0.2 + nx * r * 0.45, r * 0.16, 1, 1);
        gfx_circle(x + nx * r * 0.2 + ny * r * 0.45, y + ny * r * 0.2 - nx * r * 0.45, r * 0.16, 1, 1);
        frac(t / 3.2) < 0.4 ? ( xs_bset(1, 0.5, 0.1, 0.6); gfx_circle(x + nx * r * 1.4, y + ny * r * 1.4, r * 0.5, 1, 1); );
        gfx_mode = 0;
      );
    );
    k -= 1;
  );
);

function xs_db_spore(t) local(x, y, s, k, a, ax, ay, r, f, fl, op)
(
  x = sx(g_xs_bx); y = sy(g_xs_by); s = g_s; op = xs_core_open();
  k = 0;
  loop(7,
    ax = x + (k - 3) * 34 * s;
    xs_bset(0.12, 0.2, 0.06, 1); tline(ax, sy(XS_Y0), ax + sin(t + k) * 20 * s, y - 40 * s, 5 * s);
    xs_bset(0.6, 0.6, 0.45, 1); f = 0; loop(4, gfx_triangle(ax + sin(t + k) * 20 * s * f * 0.25 - 4 * s, sy(XS_Y0) + (y - 40 * s - sy(XS_Y0)) * f * 0.25, ax + sin(t + k) * 20 * s * f * 0.25 - 12 * s, sy(XS_Y0) + (y - 40 * s - sy(XS_Y0)) * f * 0.25 + 4 * s, ax + sin(t + k) * 20 * s * f * 0.25 - 4 * s, sy(XS_Y0) + (y - 40 * s - sy(XS_Y0)) * f * 0.25 + 8 * s); f += 1; );
    k += 1;
  );
  gfx_mode = 1; xs_bset(0.6, 1, 0.2, 0.06); gfx_circle(x, y, 150 * s, 1, 1); gfx_mode = 0;
  f = 1 + 0.04 * sin(t * 1.8);
  xs_bset(0.05, 0.07, 0.03, 1); gfx_circle(x, y - 10 * s, 76 * s * f, 1, 1);
  xs_bset(0.22, 0.28, 0.1, 1); gfx_circle(x, y - 14 * s, 70 * s * f, 1, 1);
  xs_bset(0.35, 0.18, 0.22, 1); gfx_circle(x - 10 * s, y - 24 * s, 46 * s * f, 1, 1);
  xs_bset(0.5, 0.28, 0.3, 1); gfx_circle(x - 24 * s, y - 38 * s, 20 * s * f, 1, 1);
  k = 0;
  loop(10, a = k * 0.63 + 0.3; xs_bset(0.1, 0.05, 0.06, 1); tline(x + cos(a) * 20 * s, y - 14 * s + sin(a) * 20 * s, x + cos(a + 0.3) * 66 * s, y - 14 * s + sin(a + 0.3) * 60 * s, 2 * s); k += 1; );
  k = 5;
  loop(4,
    ax = sx(xp_x[k]); ay = sy(xp_y[k]);
    a = atan2(ay - y, ax - x);
    xs_bset(0.08, 0.1, 0.04, 1); gfx_triangle(ax + cos(a + 1.6) * 24 * s, ay + sin(a + 1.6) * 24 * s, ax + cos(a) * 46 * s, ay + sin(a) * 46 * s, ax + cos(a - 1.6) * 24 * s, ay + sin(a - 1.6) * 24 * s, ax - cos(a) * 30 * s, ay - sin(a) * 30 * s);
    xs_bset(0.3, 0.36, 0.14, 1); gfx_triangle(ax + cos(a + 1.6) * 18 * s, ay + sin(a + 1.6) * 18 * s, ax + cos(a) * 38 * s, ay + sin(a) * 38 * s, ax + cos(a - 1.6) * 18 * s, ay + sin(a - 1.6) * 18 * s, ax - cos(a) * 22 * s, ay - sin(a) * 22 * s);
    f = -1; loop(3, xs_bset(0.75, 0.72, 0.6, 1); gfx_triangle(ax + cos(a + f * 0.9) * 20 * s, ay + sin(a + f * 0.9) * 20 * s, ax + cos(a + f * 0.9) * 34 * s, ay + sin(a + f * 0.9) * 34 * s, ax + cos(a + f * 0.9 + 0.2) * 20 * s, ay + sin(a + f * 0.9 + 0.2) * 20 * s); f += 1; );
    k += 1;
  );
  k = 0;
  loop(4,
    ax = sx(xp_x[k]); ay = sy(xp_y[k]); r = 16 * s;
    xp_on[k] ? (
      f = 0.5 + 0.5 * sin(t * 4 + k * 1.7); fl = xs_fl(k);
      xs_bset(0.2, 0.1, 0.05, 1); gfx_circle(ax, ay, r * (1.15 + 0.1 * f), 1, 1);
      fl ? xs_bset(1, 1, 1, 1) : xs_bset(0.75, 0.55 + 0.2 * f, 0.1, 1); gfx_circle(ax, ay, r * (0.95 + 0.1 * f), 1, 1);
      xs_bset(0.95, 0.85, 0.3, 1); gfx_circle(ax - r * 0.3, ay - r * 0.3, r * 0.3, 1, 1);
      xs_bset(0.3, 0.15, 0.05, 1); gfx_line(ax - r * 0.7, ay + r * 0.2, ax + r * 0.5, ay - r * 0.4, 1);
    ) : (
      xs_bset(0.08, 0.04, 0.02, 1); gfx_circle(ax, ay, r * 0.7, 1, 1);
      rand(1) < 0.3 ? spawn(xp_x[k], xp_y[k], (rand(1) - 0.5) * 50, 30 + rand(1) * 40, 0.8, 0.9, 0.2, 0.5);
    );
    k += 1;
  );
  ax = sx(xp_x[4]); ay = sy(xp_y[4]); r = 24 * s; fl = xs_fl(4);
  xs_bset(0.03, 0.01, 0.01, 1); gfx_circle(ax, ay, r * 1.4, 1, 1);
  op && xp_on[4] ? (
    gfx_mode = 1; xs_bset(1, 0.2, 0.1, 0.35); gfx_circle(ax, ay, r * 1.8, 1, 1); gfx_mode = 0;
    fl ? xs_bset(1, 1, 1, 1) : xs_bset(0.7, 0.08, 0.1, 1); gfx_circle(ax, ay, r * 0.9, 1, 1);
    xs_bset(1, 0.5, 0.3, 1); gfx_circle(ax, ay + r * 0.2, r * 0.35, 1, 1);
  );
  k = 0;
  loop(12,
    a = k * $pi / 6;
    f = op ? 1 : 0.55;
