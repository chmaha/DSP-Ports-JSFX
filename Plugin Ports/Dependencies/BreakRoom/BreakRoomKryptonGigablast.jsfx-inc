      xs_bset(0.05, 0.05, 0.05, 1); gfx_rect(ax - 34 * s, ay - 30 * s, 68 * s, 56 * s);
      fl ? xs_bset(1, 1, 1, 1) : xs_bset(0.42, 0.43, 0.46, 1); gfx_rect(ax - 30 * s, ay - 26 * s, 60 * s, 48 * s);
      xs_bset(0.58, 0.6, 0.64, 1); gfx_rect(ax - 30 * s, ay - 26 * s, 60 * s, 8 * s);
      xs_bset(0.28, 0.29, 0.31, 1); gfx_rect(ax - 30 * s, ay + 14 * s, 60 * s, 8 * s);
      xs_bset(0.95, 0.75, 0.1, 1); j = 0; loop(4, gfx_triangle(ax - 30 * s + j * 15 * s, ay - 2 * s, ax - 22 * s + j * 15 * s, ay - 2 * s, ax - 15 * s + j * 15 * s, ay + 8 * s, ax - 23 * s + j * 15 * s, ay + 8 * s); j += 1; );
      gfx_mode = 1; xs_bset(1, 0.25, 0.1, 0.8 + 0.2 * sin(t * 9 + k)); gfx_circle(ax, ay - 12 * s, 4 * s, 1, 1); xs_bset(1, 0.2, 0.1, 0.25); gfx_circle(ax, ay - 12 * s, 10 * s, 1, 1); gfx_mode = 0;
    );
    k += 1;
