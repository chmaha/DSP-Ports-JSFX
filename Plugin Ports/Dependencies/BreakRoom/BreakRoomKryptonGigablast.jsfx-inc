    j = 0; loop(6, f = j * $pi / 3 + 0.3; gfx_set(0.65, 0.65, 0.7, 1); gfx_circle(x + cos(f) * r * 1.03, y + sin(f) * r * 1.03, max(1, r * 0.08), 1, 1); j += 1; );
