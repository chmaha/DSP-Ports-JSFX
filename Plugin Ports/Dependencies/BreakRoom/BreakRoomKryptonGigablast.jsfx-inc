);

function xs_draw_enemy(i) local(t, x, y, r, fl, a, k, ex, ey, ang, cr, cg, cb, w, j, f)
(
  t = xn_t[i]; x = sx(xn_x[i]); y = sy(xn_y[i]); r = xs_rad(t) * g_s;
  fl = g_xs_t - xn_f[i] < 0.05;
  a = g_xs_t - xn_t0[i];
  gfx_set(0, 0, 0, 0.35); t != 3 ? gfx_circle(x + 8 * g_s, y + 12 * g_s, r * 0.9, 1, 1);
  t == 1 ? (
    k = 0;
