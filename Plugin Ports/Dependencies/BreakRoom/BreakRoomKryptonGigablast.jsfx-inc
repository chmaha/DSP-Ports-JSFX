      j = 0;
      loop(6,
        f = j / 6;
        gfx_set(0.45 - 0.2 * f, 0.4 - 0.18 * f, 0.33 - 0.15 * f, 1);
        gfx_circle(ex + sin(a * 2.5 + k * 2.1 + j * 0.7) * 5 * g_s * f, ey + j * r * 0.3, r * (0.15 - 0.015 * j), 1, 1);
        gfx_set(0.15, 0.12, 0.1, 1);
