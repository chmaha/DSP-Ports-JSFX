      xs_bset(0.3, 0.3, 0.32, 1); gfx_circle(ax, ay, r * 1.15, 1, 1);
      xs_bset(0.06, 0.05, 0.05, 1); gfx_circle(ax, ay + r * 0.2, r * 0.8, 1, 1);
      gfx_mode = 1; xs_bset(1, 0.35, 0.05, 0.35); gfx_circle(ax, ay + r * 0.5, r * 1.3, 1, 1); gfx_mode = 0;
      fl ? xs_bset(1, 1, 1, 1) : xs_bset(1, 0.4 + 0.2 * sin(t * 9 + k), 0.05, 1); gfx_circle(ax, ay + r * 0.3, r * 0.55, 1, 1);
    );
    k += 1;
  );
  xp_on[2] && op ? (
    ax = sx(xp_x[2]); ay = sy(xp_y[2]); r = xp_r[2] * s;
    gfx_mode = 1; xs_bset(1, 0.15, 0.05, 0.2 + 0.4 * f); gfx_circle(ax, ay, r * 2.2, 1, 1); gfx_mode = 0;
    xs_eye(ax, ay, r, xs_fl(2), xp_hp[2] / xp_hm[2]);
  );
  ay = y - 8 * s - f * 30 * s;
  k = 0;
  loop(11,
    a = $pi + (k + 0.5) * $pi / 11;
    xs_bset(0.42, 0.4, 0.38, 1);
    gfx_triangle(x + cos(a - 0.08) * 86 * s, ay + 18 * s + sin(a - 0.08) * 86 * s, x + cos(a) * 124 * s, ay + 18 * s + sin(a) * 124 * s, x + cos(a + 0.08) * 86 * s, ay + 18 * s + sin(a + 0.08) * 86 * s);
    k += 1;
  );
  xs_bset(0.04, 0.04, 0.045, 1); fan(x, ay + 20 * s, 94 * s, $pi, 2 * $pi, 26);
  xs_bset(0.17, 0.17, 0.19, 1); fan(x, ay + 18 * s, 86 * s, $pi, 2 * $pi, 26);
  xs_bset(0.26, 0.26, 0.28, 1); fan(x - 8 * s, ay + 14 * s, 58 * s, $pi * 1.05, $pi * 1.6, 12);
  xs_bset(0.03, 0.03, 0.03, 1); gfx_rect(x - 60 * s, ay - 10 * s, 120 * s, 12 * s);
  gfx_mode = 1; xs_bset(1, 0.15, 0.05, 0.85 + 0.15 * sin(t * 8)); gfx_rect(x - 52 * s, ay - 6 * s, 104 * s, 4 * s); xs_bset(1, 0.1, 0.05, 0.2); gfx_rect(x - 60 * s, ay - 14 * s, 120 * s, 20 * s); gfx_mode = 0;
  k = 0; loop(9, a = $pi + (k + 0.5) * $pi / 9; xs_bset(0.5, 0.5, 0.52, 1); gfx_circle(x + cos(a) * 74 * s, ay + 18 * s + sin(a) * 74 * s, 2 * s, 1, 1); k += 1; );
