function xs_kdraw(x, y, look)
(
  g_xs_kalt = g_xs_shopnext ? 1 : 0;
  g_xs_kalt ? ( g_xs_kt1 = 1.06; g_xs_kt2 = 0.98; g_xs_kt3 = 0.88; ) : ( g_xs_kt1 = 0.8; g_xs_kt2 = 0.88; g_xs_kt3 = 1.06; );
  g_xs_th == 0 ? xs_kp0(x, y, look) : g_xs_th == 1 ? xs_kp1(x, y, look) : g_xs_th == 3 ? xs_kp3(x, y, look) : g_xs_th == 4 ? xs_kp4(x, y, look) : xs_kp2(x, y, look);
);
function xs_kname() ( g_xs_th == 0 ? "THE BILGE LOCKER" : g_xs_th == 1 ? "SHARD EXCHANGE" : g_xs_th == 3 ? "THE ROT BAZAAR" : g_xs_th == 4 ? "HELLFIRE SURPLUS" : "BITS & BLASTERS"; );
function xs_kwho() ( g_xs_th == 0 ? "Old Gill" : g_xs_th == 1 ? "Glint" : g_xs_th == 3 ? "Madame Mycel" : g_xs_th == 4 ? "Cinder Jack" : "Rivet"; );
function xs_kbuy(ok)
(
  ok ? (
    g_xs_th == 0 ? "Done. Try to come back." : g_xs_th == 1 ? "A fair trade. For me." : g_xs_th == 3 ? "It's yours. Until it rots." : g_xs_th == 4 ? "Sold. Don't waste it." : "Good choice. Try not to die.";
  ) : (
    g_xs_th == 0 ? "No credits. No deal." : g_xs_th == 1 ? "Empty pockets. Leave." : g_xs_th == 3 ? "Nothing to trade? Then go." : g_xs_th == 4 ? "Short again. Get out." : "Come back with credits.";
  );
);

function xs_say(i)
(
  g_xs_th == 0 ? (
    i == 0 ? "Salvage from the deep. Don't ask whose." : i == 1 ? "The sea keeps what it takes. I sell the rest." : i == 2 ? "Selling? Half. The deep takes its share." :
    i == 3 ? "Your kind sinks fast out there." : i == 4 ? "No refunds. The last pilot asked." : "Buy something. Or feed the trench.";
  ) : g_xs_th == 1 ? (
    i == 0 ? "Everything here was pried from someone." : i == 1 ? "The caves remember every thief. So do I." : i == 2 ? "Half price back. The rest is my fee." :
    i == 3 ? "Count your credits. I already have." : i == 4 ? "Touch the stones and lose the hand." : "Every pilot comes once. Few come twice.";
  ) : g_xs_th == 3 ? (
    i == 0 ? "Breathe deep. The spores are patient." : i == 1 ? "Grown from the last ones who wandered in." : i == 2 ? "I'll take it back. Half price. And a lungful." :
    i == 3 ? "The jungle is hungry. Arm yourself." : i == 4 ? "Everything rots. You first, perhaps." : "Don't linger. The air gets inside you.";
  ) : g_xs_th == 4 ? (
    i == 0 ? "Everything burns eventually. Buy first." : i == 1 ? "Prices rise with the heat. It's rising." : i == 2 ? "Sell it back? Half. Be grateful." :
    i == 3 ? "No credit. No mercy." : i == 4 ? "Come closer. Let me watch you burn." : "Last stop before the core. Choose well.";
  ) : (
    i == 0 ? "Credits first. Questions never." : i == 1 ? "That one's seen action. Still fires." :
    i == 2 ? "Selling? Half price. Take it or leave it." : i == 3 ? "You'll want a bigger gun out there." :
    i == 4 ? "Don't get attached. Nobody comes back twice." : "Pay up, pilot. The hive won't wait.";
  );
);

function xs_shop_flick() local(p, q)
(
  p = frac(g_t * 0.17); q = frac(g_t * 0.41 + 0.3);
  g_xs_fll = 0.86 + 0.08 * sin(g_t * 17) + 0.06 * sin(g_t * 5.3);
  (p < 0.07 || q < 0.025) ? ( g_xs_fll = rand(1) < 0.55 ? 0.08 + rand(1) * 0.2 : 0.7 + rand(1) * 0.3; );
  (p > 0.07 && p < 0.075) ? g_xs_fll = 0.04;
  g_xs_fll;
);

function xs_keyes(x, y) local(b, vx)
(
  g_xs_th == 0 ? (
    b = sin(g_t * 1.1) * 2;
    xs_kglow(x - 16, y - 130 + b, 3.2, 0.75, 1, 0.9, 0.9); xs_kglow(x + 16, y - 130 + b, 3.2, 0.75, 1, 0.9, 0.9);
    xs_kglow(x + 44 + 4 * sin(g_t * 1.3), y - 152 + b + 6 * sin(g_t * 0.9), 5, 0.4, 1, 0.85, 0.8);
  ) : g_xs_th == 1 ? (
    b = sin(g_t * 1.4) * 2;
    xs_kglow(x - 16, y - 120 + b, 2.6, 1, 0.2, 0.1, 0.9); xs_kglow(x + 17, y - 121 + b, 4, 1, 0.25, 0.15, 1);
  ) : g_xs_th == 2 ? (
    b = sin(g_t * 1.4) * 2; vx = x - 30 + 60 * (0.5 + 0.5 * sin(g_t * 1.2));
    gfx_mode = 1; gfx_set(1, 0.12, 0.05, 0.9); gfx_rect(sx(x - 34), sy(y - 123 + b), 68 * g_s, 4 * g_s); gfx_set(1, 0.5, 0.35, 1); gfx_rect(sx(vx - 4), sy(y - 124 + b), 8 * g_s, 6 * g_s); gfx_mode = 0;
  ) : g_xs_th == 3 ? (
    b = sin(g_t * 0.9) * 2.5;
    xs_kglow(x + 14, y - 113 + b, 2.6, 0.9, 1, 0.2, 1);
  ) : (
    b = sin(g_t * 1.2) * 2;
    xs_kglow(x - 22, y - 118 + b, 3.4, 1, 0.75, 0.1, 1); xs_kglow(x + 22, y - 118 + b, 3.4, 1, 0.75, 0.1, 1);
  );
);

function xs_shop_light(x) local(l, lx, ly, cr, cg, cb, w, k)
(
  l = g_xs_fll;
  g_xs_shopnext ? ( cr = 1; cg = 0.42; cb = 0.18; ) : ( cr = 0.45; cg = 0.95; cb = 0.7; );
  gfx_set(0, 0, 0, 0.22 + 0.62 * (1 - l)); gfx_rect(sx(BRD_X), sy(BRD_Y), 350 * g_s, BRD_H * g_s);
  lx = x + 22 * sin(g_t * 0.6); ly = BRD_Y + 196;
  xs_kc(0.05, 0.05, 0.05); xs_kline(x, BRD_Y, lx, ly - 10, 1.5);
  xs_kc(0.12, 0.12, 0.12); xs_kquad(lx - 8, ly - 12, lx + 8, ly - 12, lx + 16, ly + 2, lx - 16, ly + 2);
  gfx_mode = 1;
  k = 0;
  loop(6,
    w = 60 + k * 22;
    gfx_set(cr, cg, cb, 0.026 * l);
    gfx_triangle(sx(lx - 12), sy(ly), sx(lx + 12), sy(ly), sx(x + w), sy(BRD_Y + 480), sx(x - w), sy(BRD_Y + 480));
    k += 1;
  );
  gfx_set(cr, cg, cb, 0.25 * l); xs_kci(lx, ly + 2, 22);
  gfx_set(min(1, cr + 0.3), min(1, cg + 0.3), min(1, cb + 0.3), 0.9 * l); xs_kell(lx, ly + 2, 12, 3, 0, 2 * $pi);
  gfx_mode = 0;
  l < 0.5 ? xs_keyes(x, BRD_Y + 400);
);

function xs_shop() local(i, x, y, w, h, hov, p, can, aff, look, k, a, r)
(
  gfx_set(0.03, 0.035, 0.04, 1); gfx_rect(sx(BRD_X), sy(BRD_Y), BRD_W * g_s, BRD_H * g_s);
  gfx_gradrect(sx(BRD_X), sy(BRD_Y), 350 * g_s, BRD_H * g_s, 0.08, 0.085, 0.09, 1, 0, 0, 0, 0, -0.05 / (BRD_H * g_s), -0.05 / (BRD_H * g_s), -0.05 / (BRD_H * g_s), 0);
  k = 0;
  loop(6,
    x = BRD_X + 10 + k * 58;
    gfx_set(0.11, 0.12, 0.13, 1); gfx_rect(sx(x), sy(BRD_Y), 50 * g_s, 360 * g_s);
    gfx_set(0.16, 0.17, 0.18, 1); gfx_rect(sx(x), sy(BRD_Y), 3 * g_s, 360 * g_s);
    gfx_set(0.3, 0.3, 0.32, 1); i = 0; loop(8, gfx_circle(sx(x + 6), sy(BRD_Y + 20 + i * 44), 1.5 * g_s, 1, 1); i += 1; );
    k += 1;
  );
  gfx_mode = 1;
  xs_shop_flick();
  k = 0; loop(3, a = (0.7 + 0.3 * (frac(g_t * 0.3 + k * 0.37) > 0.04)) * g_xs_fll; g_xs_shopnext ? gfx_set(1, 0.85, 0.6, 0.07 * a) : gfx_set(0.5, 0.75, 1, 0.07 * a); gfx_circle(sx(BRD_X + 60 + k * 120), sy(BRD_Y + 70), 50 * g_s, 1, 1); g_xs_shopnext ? gfx_set(1, 0.9, 0.7, 0.9 * a) : gfx_set(0.7, 0.88, 1, 0.9 * a); gfx_rect(sx(BRD_X + 44 + k * 120), sy(BRD_Y + 64), 32 * g_s, 4 * g_s); k += 1; );
  gfx_mode = 0;
  k = 0;
  loop(5,
    x = BRD_X + 34 + k * 58;
    gfx_set(0.07, 0.07, 0.08, 1); gfx_rect(sx(x - 4), sy(BRD_Y + 70), 8 * g_s, 120 * g_s);
    gfx_set(0.22, 0.23, 0.24, 1); gfx_rect(sx(x - 3), sy(BRD_Y + 72), 6 * g_s, 110 * g_s);
    gfx_set(0.35, 0.36, 0.38, 1); gfx_rect(sx(x - 8), sy(BRD_Y + 120), 16 * g_s, 22 * g_s);
    gfx_set(0.15, 0.15, 0.16, 1); gfx_rect(sx(x - 2), sy(BRD_Y + 142), 4 * g_s, 18 * g_s);
    k += 1;
  );
  gfx_set(0.16, 0.17, 0.12, 1); fill_rr(BRD_X + 236, BRD_Y + 380, 90, 56, 4); fill_rr(BRD_X + 250, BRD_Y + 336, 64, 44, 4);
  gfx_set(0.85, 0.65, 0.1, 1); k = 0; loop(4, gfx_triangle(sx(BRD_X + 240 + k * 22), sy(BRD_Y + 430), sx(BRD_X + 252 + k * 22), sy(BRD_Y + 430), sx(BRD_X + 246 + k * 22), sy(BRD_Y + 420)); k += 1; );
  gfx_set(0.2, 0.21, 0.22, 1); gfx_rect(sx(BRD_X), sy(BRD_Y + 470), 350 * g_s, 114 * g_s);
  gfx_set(0.34, 0.35, 0.36, 1); gfx_rect(sx(BRD_X), sy(BRD_Y + 470), 350 * g_s, 8 * g_s);
  gfx_set(0.12, 0.12, 0.13, 1); k = 0; loop(7, gfx_rect(sx(BRD_X + 20 + k * 48), sy(BRD_Y + 490), 30 * g_s, 4 * g_s); k += 1; );
  look = 0;
  g_xs_hov >= 0 ? look = 1;
  xs_kdraw(190, BRD_Y + 400, look);
  xs_shop_light(190);
  xs_text(xs_kname(), BRD_X + 20, BRD_Y + 8, 320, 40, 26, 1, 0.55, 0.25, 1);
  gfx_set(0.06, 0.07, 0.07, 0.92); fill_rr(BRD_X + 30, BRD_Y + 118, 300, 54, 6);
  gfx_set(1, 0.3, 0.15, 0.8); outline_rr(BRD_X + 30, BRD_Y + 118, 300, 54, 6);
  font(12, 'b'); gfx_set(1, 0.6, 0.45, 1);
  g_t - g_xs_buy_t < 1.6 ? txt_c(xs_kbuy(g_xs_buy_i >= 0), BRD_X + 30, BRD_Y + 118, 300, 54) :
  txt_c(xs_say(g_xs_say), BRD_X + 30, BRD_Y + 118, 300, 54);
  font(12, 'b'); gfx_set(0.7, 0.72, 0.8, 1); txt_l("Your credits", 650, BRD_Y + 14);
  sprintf(#g_tt, "%d", g_xs_cr);
  xs_text(#g_tt, 740, BRD_Y + 6, 140, 30, 22, 1, 0.85, 0.4, 1);
  g_xs_hov = -1;
  i = 0;
  loop(9,
    w = 166; h = 138;
    x = 360 + (i % 3) * (w + 10); y = BRD_Y + 48 + floor(i / 3) * (h + 10);
    hov = hit(x, y, w, h);
    hov ? g_xs_hov = i;
    can = xs_can(i); p = xs_price(i); aff = g_xs_cr >= p;
    gfx_set(hov ? 0.13 : 0.09, hov ? 0.13 : 0.095, hov ? 0.14 : 0.1, 1); fill_rr(x, y, w, h, 4);
    gfx_set(hov ? 1 : 0.28, hov ? 0.45 : 0.29, hov ? 0.2 : 0.3, 1); outline_rr(x, y, w, h, 4);
    g_t - g_xs_buy_t < 0.4 && g_xs_buy_i == i ? ( gfx_mode = 1; gfx_set(1, 0.9, 0.5, 0.3 * (1 - (g_t - g_xs_buy_t) / 0.4)); fill_rr(x, y, w, h, 10); gfx_mode = 0; );
    xs_icon(i, x + 40, y + 48, 1);
    font(13, 'b'); gfx_set(0.95, 0.96, 0.98, 1); txt_l(xs_iname(i), x + 78, y + 14);
    i <= 5 || i == 8 ? (
      r = i == 0 ? 5 : xs_max(i); a = i == 0 ? xs_lv[0] : xs_lv[i];
      k = 0; loop(r, k < a ? gfx_set(0.4, 0.9, 1, 1) : gfx_set(0.22, 0.22, 0.3, 1); gfx_rect(sx(x + 78 + k * 14), sy(y + 36), 11 * g_s, 6 * g_s); k += 1; );
    ) : i == 6 ? (
      font(11, 0); gfx_set(0.7, 0.72, 0.8, 1); sprintf(#g_tt, "Energy %d%%", g_xs_en); txt_l(#g_tt, x + 78, y + 34);
    ) : (
      font(11, 0); gfx_set(0.7, 0.72, 0.8, 1); sprintf(#g_tt, "Ships %d", g_xs_lives); txt_l(#g_tt, x + 78, y + 34);
    );
    can ? (
      sprintf(#g_tt, "Buy %d", p);
      aff ? (
        button(#g_tt, x + 10, y + h - 44, 84, 32, 1, 0.8, 0.4) ? ( g_xs_buy_i = xs_buy(i) ? i : -1; g_xs_buy_t = g_t; );
      ) : (
        gfx_set(0.1, 0.1, 0.12, 1); fill_rr(x + 10, y + h - 44, 84, 32, 6);
        font(13, 'b'); gfx_set(0.45, 0.42, 0.5, 1); txt_c(#g_tt, x + 10, y + h - 44, 84, 32);
        hov && g_click && hit(x + 10, y + h - 44, 92, 32) ? ( g_click = 0; g_xs_buy_t = g_t; g_xs_buy_i = -1; xs_snd(4, 150, 0.2, 0, 0); );
      );
    ) : (
      font(12, 'b'); gfx_set(0.5, 0.9, 0.6, 1); txt_c(i == 6 ? "Full" : "Maxed", x + 10, y + h - 44, 92, 32);
    );
    ((i <= 5 && (i == 0 ? xs_lv[0] > 1 : xs_lv[i] > 0)) || (i == 8 && xs_lv[8] > 0)) ? (
      sprintf(#g_tt, "Sell %d", xs_refund(i));
      button(#g_tt, x + 98, y + h - 44, 60, 32, 0.6, 0.9, 1) ? xs_sell(i);
    );
    i += 1;
  );
  font(11, 0); gfx_set(0.6, 0.62, 0.7, 1);
  txt_c("Selling refunds half the price.", 360, BRD_Y + 498, 520, 18);
  button(g_xs_shopnext ? "Next level" : "Back to the fight", 690, BRD_Y + 520, 180, 44, 0.5, 1, 0.7) || g_xs_kf ? (
    g_xs_kf = 0;
    g_xs_shopnext ? xs_level(g_xs_lv + 1) : ( xs_safe_zone(); g_xs_state = 8; g_xs_cd_t = g_xs_t; g_xs_cdn = -1; g_xs_inv = g_xs_t + 4; g_xs_trk = xs_ltrk(); g_xs_px = 450; g_xs_py = XS_Y1 + 40; );
  );
);

function draw_shooter() local(dst, bw, bh, fw, ts, z, dt0, s0, ox0, oy0, t, i, k, a, d, sh, kl, kr, ku, kd)
(
  g_pgrav = 0;
  g_xs_lv < 1 ? ( xs_snap[15] >= 1 ? xs_resume() : xs_new(); );
  (g_xs_state == 7 || (g_xs_shopnext && (g_xs_state == 2 || g_xs_state == 6))) ? xs_ckpt();
  bw = ceil(BRD_W * g_s); bh = ceil(BRD_H * g_s); fw = ceil(XS_W * g_s);
  (g_xs_bgw !== bw || g_xs_bgh !== bh || g_xs_bth !== g_xs_th) ? (
    xs_panels(bw, bh); xs_tile(fw, bh); g_xs_bgw = bw; g_xs_bgh = bh; g_xs_bth = g_xs_th; g_xs_tw = fw;
  );
  g_xs_kf = 0; g_xs_kb = 0;
  k = 0;
  while (k < 32 && (i = gfx_getchar()) > 0) (
    (i == 'p' || i == 'P') ? g_pz_req = 1 : i == 'left' ? g_xs_klt = g_t : i == 'rght' ? g_xs_krt = g_t : i == 'up' ? g_xs_kut = g_t : i == 'down' ? g_xs_kdt = g_t :
    (i == 's' || i == 'S') ? g_xs_kst = g_t : (i == 'd' || i == 'D') ? g_xs_kb = 1 : i == 13 ? g_xs_kf = 1;
    k += 1;
  );
  kl = gfx_getchar('left') > 0 || g_t - g_xs_klt < 0.09;
  kr = gfx_getchar('rght') > 0 || g_t - g_xs_krt < 0.09;
  ku = gfx_getchar('up') > 0 || g_t - g_xs_kut < 0.09;
  kd = gfx_getchar('down') > 0 || g_t - g_xs_kdt < 0.09;
  g_xs_kx = kr - kl; g_xs_ky = kd - ku;
  (abs(g_mx - g_xs_lmx) > 1 || abs(g_my - g_xs_lmy) > 1) && hit(BRD_X, BRD_Y, BRD_W, BRD_H) ? g_xs_mon = 1;
  (g_xs_kx || g_xs_ky) ? g_xs_mon = 0;
  g_xs_state == 8 ? g_xs_mon = 0;
  g_xs_lmx = g_mx; g_xs_lmy = g_my;
  g_xs_fire = ((mouse_cap & 1) && hit(BRD_X, BRD_Y, BRD_W, BRD_H)) || gfx_getchar('s') > 0 || gfx_getchar('S') > 0 || g_t - g_xs_kst < 0.12;
  (g_rclick && hit(BRD_X, BRD_Y, BRD_W, BRD_H)) || g_xs_kb ? ( g_rclick = 0; xs_bomb(); );

  ts = 1; z = 1;
  g_t - g_xs_fin_rt < 1.6 ? ( ts = 0.3; z = 1.25; );
  g_xs_ts += (ts - g_xs_ts) * min(1, g_dt * 8);
  g_xs_zoom += (z - g_xs_zoom) * min(1, g_dt * 5);
  dt0 = g_dt * g_xs_ts;
  (g_xs_state == 1 || g_xs_state == 4 || g_xs_state == 5 || g_xs_state == 6 || g_xs_state == 8) ? (
    g_t < g_xs_hs ? dt0 *= 0.06;
    g_xs_t += dt0;
    g_xs_state == 8 ? ( xs_countdown(dt0); g_xs_shake = max(0, g_xs_shake - dt0 * 18); ) : xs_update(dt0);
  );

  s0 = g_s; ox0 = g_ox; oy0 = g_oy; dst = gfx_dest;
  gfx_mode = 0; gfx_a = 1;
  gfx_blit(IMG_XSP, 1, 0, 0, 0, g_xs_bgw, g_xs_bgh, floor(sx(BRD_X)), floor(sy(BRD_Y)), bw, bh);
  g_xs_state == 2 ? xs_shop() : (
    gfx_setimgdim(IMG_XSS, fw, bh);
    gfx_dest = IMG_XSS;
    gfx_set(0, 0, 0, 1); gfx_rect(0, 0, fw, bh);
    a = xs_qamp(); d = g_xs_zp * exp(-(g_t - g_xs_zp_t) * 5);
    a < 0.02 ? ( a = 0; g_xs_qk = 0; ); d < 0.004 ? ( d = 0; g_xs_zp = 0; );
    abs(g_xs_zoom - 1) < 0.002 ? g_xs_zoom = 1;
    z = g_xs_zoom * (1 + d + 0.05 * a);
    sh = g_xs_shake;
    g_xs_s0 = s0;
    g_s = s0 * z;
    k = g_t + g_xs_qph;
    g_ox = -XS_X0 * s0 * z + (g_xs_fx - XS_X0) * s0 * (1 - z) + (rand(1) - 0.5) * sh * s0 + a * (22 * sin(k * 41) + 9 * sin(k * 73 + 1)) * s0;
    g_oy = -XS_Y0 * s0 * z + (g_xs_fy - XS_Y0) * s0 * (1 - z) + (rand(1) - 0.5) * sh * s0 + a * (18 * sin(k * 37 + 2) + 8 * sin(k * 67)) * s0;
    t = g_dt; g_dt = dt0;
    xs_scene();
    g_dt = t;
    g_s = s0; g_ox = ox0; g_oy = oy0;
    gfx_dest = dst;
    gfx_mode = 0; gfx_a = 1;
    gfx_blit(IMG_XSS, 1, 0, 0, 0, fw, bh, floor(sx(XS_X0)), floor(sy(XS_Y0)), fw, bh);
    xs_hud();
    (g_xs_lost && g_xs_t - g_xs_lost_t < 3.5) ? (
      a = 0.6 + 0.4 * sin(g_t * 10);
      xs_text("WEAPONS LOST", XS_X0, BRD_Y + 140, XS_W, 40, 26, 1, 0.2, 0.1, a);
    );
    g_xs_state == 8 ? (
      t = g_xs_t - g_xs_cd_t;
      a = frac(t);
      sprintf(#g_tt, "%d", 3 - floor(t));
      xs_text(t < 3 ? #g_tt : "GO!", XS_X0, BRD_Y + 360 - a * 10, XS_W, 90, 70 * (1.25 - 0.25 * a), 1, 0.85 - 0.3 * (t >= 2), 0.4, 1 - a * 0.6);
    );
    (g_xs_state == 1 && g_xs_t - g_xs_go_t < 0.6) ? (
      a = (g_xs_t - g_xs_go_t) / 0.6;
      xs_text("GO!", XS_X0, BRD_Y + 360, XS_W, 90, 70 + 40 * a, 0.5, 1, 0.6, 1 - a);
    );
    t = g_xs_t - g_xs_lv_t;
    (t < 3.2 && g_xs_state == 8) ? (
      a = min(1, min(t * 3, (3.2 - t) * 2));
      sprintf(#g_tt, "WORLD %d-%d", floor((g_xs_lv - 1) / 2) % 5 + 1, ((g_xs_lv - 1) % 2) + 1);
      xs_text(#g_tt, XS_X0, BRD_Y + 200, XS_W, 50, 34, 1, 0.9, 0.6, a);
      xs_th_set(1);
      xs_text(xs_world_name(g_xs_lv), XS_X0, BRD_Y + 248, XS_W, 34, 22, g_cr, g_cg, g_cb, a);
      g_xs_lv == 1 ? (
        font(12, 'b'); gfx_set(0.9, 0.92, 0.96, a);
        txt_c("Mouse: steer, hold left button to fire, right-click for a bomb.", XS_X0, BRD_Y + 300, XS_W, 20);
        txt_c("Keys: arrows steer, hold S to fire, D to detonate a bomb.", XS_X0, BRD_Y + 320, XS_W, 20);
        txt_c("Collect credits and spend them in the shop.", XS_X0, BRD_Y + 340, XS_W, 20);
      );
    );
    (g_xs_mid == 1 && g_xs_t - g_xs_midt < 3) || g_xs_state == 6 ? (
      a = 0.6 + 0.4 * sin(g_t * 8);
      xs_text(g_xs_shopnext && g_xs_state == 6 ? "STAGE CLEAR" : "SHOP AHEAD", XS_X0, BRD_Y + 230, XS_W, 50, 30, 1, 0.85, 0.4, a);
    );
    g_xs_state == 4 ? xs_text(g_xs_bt == 4 ? "HIVE MIND DESTROYED!" : "BOSS DESTROYED!", XS_X0, BRD_Y + 230, XS_W, 50, 30, 1, 0.85, 0.4, 1);
  );
  gfx_set(0.2, 0.21, 0.24, 1);
  outline_rr(BRD_X, BRD_Y, BRD_W, BRD_H, 8);

  button("< Games", 18, 14, 96, 36, 0.4, 0.95, 0.78) ? (
    (g_xs_state == 1 || g_xs_state == 5 || g_xs_state == 8) ? ( g_pz = 1; g_pz_snap = 1; g_pz_go = 1; ) : g_screen = 0;
  );
  g_t - g_xs_rst_t > 3 ? g_xs_rst_t = -1000;
  g_xs_rst_t > 0 ? (
    button("Sure?", 122, 14, 100, 36, 1, 0.4, 0.35) ? ( g_xs_rst_t = -1000; xs_new(); );
  ) : (
    button("New run", 122, 14, 100, 36, 1, 0.4, 0.35) ? g_xs_rst_t = g_t;
  );
  font(15, 'b'); gfx_set(0.95, 0.96, 0.98, 1);
  txt_c("Krypton Gigablast", 300, 9, 300, 22);
  sprintf(#g_tt, "Best %d   Furthest world %d-%d", sv2[40], floor((max(1, sv2[41]) - 1) / 2) % 5 + 1, ((max(1, sv2[41]) - 1) % 2) + 1);
  font(12, 'b'); gfx_set(0.6, 0.82, 1, 1); txt_c(#g_tt, 300, 31, 300, 20);
  hint("Mouse: steer + hold to fire, right-click bomb.   Keys: arrows, hold S to fire, D to detonate.", HINT_Y - 0);
  button(snd_lbl(), 774, HINT_Y - 4, 108, 28, 0.6, 1, 0.75) ? sv2[13] = snd_next();

  g_xs_state == 3 ? (
    sprintf(#g_l1, "Score %d   reached World %d-%d", g_xs_score, floor((g_xs_lv - 1) / 2) % 5 + 1, ((g_xs_lv - 1) % 2) + 1);
    sprintf(#g_l2, "Best %d     Try again restarts this level with your gear", sv2[40]);
    g_wcl = 3;
    i = win_card("Game over", g_xs_over_t, 1, 0.5, 0.45);
    g_wcl = 0;
    g_xs_kf && g_t - g_xs_over_t > 1.2 ? i = 1;
    i == 1 ? xs_retry() : i == 2 ? g_screen = 0;
  );
  g_xs_state == 7 ? (
    sprintf(#g_l1, "You destroyed the Hive Mind! Score %d", g_xs_score);
    strcpy(#g_l2, "The worlds are safe... for now. The next loop is tougher.");
    i = win_card("Victory!", g_xs_end_t, 1, 0.85, 0.4);
    g_xs_kf && g_t - g_xs_end_t > 1.2 ? i = 1;
    i == 1 ? ( g_xs_state = 2; g_xs_shopnext = 1; g_xs_shop_t = g_t; g_xs_trk = 18; xs_clear(); g_xs_buy_t = -10; ) : i == 2 ? g_screen = 0;
  );
);

function pv_shooter(x, y, w, h) local(i, sc0)
(
  g_xs_lv < 1 ? ( xs_snap[15] >= 1 ? xs_resume() : ( xs_new(); sv2[42] -= 1; ); );
  g_xs_bgw < 1 ? ( xs_panels(ceil(BRD_W * g_s), ceil(BRD_H * g_s)); xs_tile(ceil(XS_W * g_s), ceil(BRD_H * g_s)); g_xs_bgw = ceil(BRD_W * g_s); g_xs_bgh = ceil(BRD_H * g_s); g_xs_bth = g_xs_th; g_xs_tw = ceil(XS_W * g_s); );
  pv_begin(x, y, w, h, 1.5);
  sc0 = g_xs_sc;
  g_xs_sc = sc0 + 400 + g_t * 60;
  gfx_mode = 0; gfx_a = 1;
  gfx_blit(IMG_XST, 1, 0, 0, 0, g_xs_tw, g_xs_bgh, sx(XS_X0), sy(XS_Y0), XS_W * g_s, BRD_H * g_s);
  xs_terrain();
  xs_ship(450 + 60 * sin(g_t * 0.8), XS_Y1 - 120, -cos(g_t * 0.8) * 0.6, 1);
  gfx_mode = 1;
  i = 0;
  loop(6,
    gfx_set(0.3, 0.8, 1, 0.8);
    tline(sx(450 + 60 * sin(g_t * 0.8) - 7), sy(XS_Y1 - 150 - frac(g_t * 3 + i / 6) * 300), sx(450 + 60 * sin(g_t * 0.8) - 7), sy(XS_Y1 - 165 - frac(g_t * 3 + i / 6) * 300), 3 * g_s);
    tline(sx(450 + 60 * sin(g_t * 0.8) + 7), sy(XS_Y1 - 150 - frac(g_t * 3 + i / 6) * 300), sx(450 + 60 * sin(g_t * 0.8) + 7), sy(XS_Y1 - 165 - frac(g_t * 3 + i / 6) * 300), 3 * g_s);
    i += 1;
  );
  gfx_mode = 0;
  g_xs_sc = sc0;
  pv_end();
);
