    fl ? gfx_set(1, 1, 1, 1) : gfx_set(0.28, 0.25, 0.2, 1); gfx_circle(x, y - r * 0.1, r * 1.0, 1, 1);
    fl ? gfx_set(1, 1, 1, 1) : gfx_set(0.62, 0.58, 0.5, 1); gfx_circle(x - r * 0.05, y - r * 0.16, r * 0.9, 1, 1);
    gfx_set(0.78, 0.75, 0.66, 1); gfx_circle(x - r * 0.3, y - r * 0.45, r * 0.38, 1, 1);
    gfx_set(0.28, 0.25, 0.2, 1); gfx_rect(x - r * 0.55, y + r * 0.35, r * 1.1, r * 0.35);
    gfx_set(0.62, 0.58, 0.5, 1); gfx_rect(x - r * 0.5, y + r * 0.35, r * 1.0, r * 0.28);
    gfx_set(0.08, 0.05, 0.04, 1);
    k = 0; loop(5, gfx_rect(x - r * 0.45 + k * r * 0.2, y + r * 0.42, max(1, r * 0.06), r * 0.2); k += 1; );
    gfx_set(0.05, 0.03, 0.03, 1);
    gfx_circle(x - r * 0.36, y - r * 0.08, r * 0.26, 1, 1); gfx_circle(x + r * 0.36, y - r * 0.08, r * 0.26, 1, 1);
    gfx_triangle(x, y + r * 0.08, x - r * 0.1, y + r * 0.28, x + r * 0.1, y + r * 0.28);
    gfx_set(0.3, 0.27, 0.22, 1); gfx_line(x + r * 0.1, y - r * 0.9, x + r * 0.25, y - r * 0.5, 1); gfx_line(x + r * 0.25, y - r * 0.5, x + r * 0.15, y - r * 0.3, 1);
    gfx_mode = 1;
    f = 0.7 + 0.3 * sin(a * 7 + i);
    gfx_set(1, 0.15, 0.05, 0.9 * f); gfx_circle(x - r * 0.36, y - r * 0.06, r * 0.11, 1, 1); gfx_circle(x + r * 0.36, y - r * 0.06, r * 0.11, 1, 1);
    gfx_set(1, 0.2, 0.05, 0.25 * f); gfx_circle(x - r * 0.36, y - r * 0.06, r * 0.28, 1, 1); gfx_circle(x + r * 0.36, y - r * 0.06, r * 0.28, 1, 1);
    gfx_mode = 0;
  ) : t == 2 ? (
    w = 0.55 + 0.45 * sin(g_xs_t * 40 + i);
    gfx_mode = 1; gfx_set(0.7, 0.8, 0.9, 0.22);
    gfx_triangle(x, y - r * 0.1, x - r * 1.7 * w, y - r * 1.1, x - r * 0.5, y + r * 0.2);
    gfx_triangle(x, y - r * 0.1, x + r * 1.7 * w, y - r * 1.1, x + r * 0.5, y + r * 0.2);
