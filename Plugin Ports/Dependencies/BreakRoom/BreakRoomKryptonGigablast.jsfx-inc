function xs_boss_mood(t) local(r, hb, w, x0, y0, h)
(
  r = min(1, t / 3) * (g_xs_boss == 3 ? max(0, 1 - (g_xs_t - g_xs_bdie_t) / 2.4) : 1);
  hb = xs_hbeat(t);
  x0 = sx(XS_X0); y0 = sy(XS_Y0); w = XS_W * g_s; h = BRD_H * g_s;
  gfx_mode = 1;
  gfx_set(0.75, 1, 1, -0.2 * r); gfx_rect(x0, y0, w, h);
  gfx_set(1, 0.05, 0.05, 1);
  gfx_gradrect(x0, y0, 90 * g_s, h, 0.7, 0.02, 0.02, 0.22 * r * (0.5 + hb), 0, 0, 0, -0.22 * r * (0.5 + hb) / (90 * g_s), 0, 0, 0, 0);
  gfx_gradrect(x0 + w - 90 * g_s, y0, 90 * g_s, h, 0.7, 0.02, 0.02, 0, 0, 0, 0, 0.22 * r * (0.5 + hb) / (90 * g_s), 0, 0, 0, 0);
  gfx_mode = 0;
);

function xs_boss_dark(t) local(x, y, r, hb, k, a, ax, ay, rr)
(
  r = min(1, t / 3);
  hb = xs_hbeat(t);
  x = sx(g_xs_bx); y = sy(g_xs_by);
  gfx_mode = 1;
  k = 0;
  loop(5,
    gfx_set(0.6, 1, 0.9, -(k < 2 ? 0.05 : 0.11) * r); gfx_circle(x, y - 10 * g_s, (230 - k * 30) * g_s, 1, 1);
    k += 1;
  );
  k = 0;
  loop(NXP,
    (xp_on[k] && xp_role[k] >= 1 && (xp_role[k] == 1 || xs_core_open())) ? (
      ax = sx(xp_x[k]); ay = sy(xp_y[k]); rr = xp_r[k] * g_s;
      a = (0.35 + 0.45 * hb) * r;
      gfx_set(1, 0.08, 0.04, 0.12 * a); gfx_circle(ax, ay, rr * 2.6, 1, 1);
      gfx_set(1, 0.15, 0.05, 0.22 * a); gfx_circle(ax, ay, rr * 1.5, 1, 1);
    );
    k += 1;
  );
  gfx_mode = 0;
);

function xs_draw_boss() local(t, hp, n, k, a)
(
  t = g_xs_t - g_xs_bt0;
  xs_boss_mood(t);
  g_xs_bt == 0 ? xs_draw_boss0() : g_xs_bt == 1 ? xs_db_reaper(t) : g_xs_bt == 2 ? xs_db_serpent(t) : g_xs_bt == 3 ? xs_db_spore(t) : g_xs_bt == 4 ? xs_db_hive(t) : g_xs_bt == 11 ? xs_db_prism(t) : g_xs_bt == 12 ? xs_db_crusher(t) : g_xs_bt == 13 ? xs_db_maw(t) : g_xs_bt == 14 ? xs_db_molten(t) : xs_db_warden(t);
  xs_boss_dark(t);
  xs_beams();
  (g_xs_boss >= 1 && g_xs_boss <= 2) ? (
    hp = 0; n = 0; k = 0;
    loop(NXP, xp_role[k] >= 1 ? ( n += xp_hm[k]; xp_on[k] ? hp += xp_hp[k]; ); k += 1; );
    a = n > 0 ? hp / n : 0;
    gfx_set(0, 0, 0, 0.7); gfx_rect(sx(XS_X0 + 60), sy(XS_Y0 + 8), (XS_W - 120) * g_s, 8 * g_s);
    gfx_set(0.9, 0.12 + 0.3 * a, 0.08, 1); gfx_rect(sx(XS_X0 + 61), sy(XS_Y0 + 9), (XS_W - 122) * a * g_s, 6 * g_s);
    xs_text(g_xs_bt == 0 ? "BROOD MOTHER" : g_xs_bt == 1 ? "CRYSTAL REAPER" : g_xs_bt == 2 ? "FOUNDRY SERPENT" : g_xs_bt == 3 ? "SPORE MOTHER" : g_xs_bt == 4 ? (g_xs_bph == 3 ? "THE HIVE MIND - ENRAGED" : "THE HIVE MIND") : g_xs_bt == 11 ? "PRISM COLOSSUS" : g_xs_bt == 12 ? "THE CRUSHER" : g_xs_bt == 13 ? "VENUS MAW" : g_xs_bt == 14 ? "MOLTEN EYE" : "IRON WARDEN",
      XS_X0, XS_Y0 + 16, XS_W, 20, 13, 1, 0.3, 0.2, 1);
  );
);

function xs_coin_draw(i)
(
  xs_crystal(xc_x[i], xc_y[i], 4 + xc_v[i], g_xs_t + i * 0.7, 1);
);

function xs_scene() local(i, o, h, w, k, x, y, a, t, r, th, f)
(
  th = g_xs_th;
  w = XS_W * g_s; h = g_xs_bgh;
  f = g_s / max(0.01, g_xs_s0);
  o = (g_xs_sc * 0.35 * g_xs_s0) % h;
  gfx_mode = 0; gfx_a = 1;
  gfx_set(xs_br[th], xs_bg[th], xs_bb[th], 1); gfx_rect(sx(XS_X0 - 40), sy(XS_Y0 - 40), (XS_W + 80) * g_s, (BRD_H + 80) * g_s);
  gfx_blit(IMG_XST, 1, 0, 0, 0, g_xs_tw, h - o, sx(XS_X0), sy(XS_Y0) + o * f, w, (h - o) * f);
  gfx_blit(IMG_XST, 1, 0, 0, h - o, g_xs_tw, o, sx(XS_X0), sy(XS_Y0), w, o * f);
  k = 0;
  loop(22,
    x = XS_X0 + XS_W * hash(k * 2.3 + g_xs_sd);
    y = XS_Y0 - 20 + ((hash(k * 4.1) * (BRD_H + 40) + g_xs_sc * (0.55 + 0.3 * hash(k))) % (BRD_H + 40));
    r = 2 + 5 * hash(k * 1.7); a = g_xs_t * (hash(k * 3) - 0.5) * 3 + k;
    gfx_set(0.1, 0.1, 0.11, 0.9);
    gfx_triangle(sx(x + cos(a) * r), sy(y + sin(a) * r), sx(x + cos(a + 2.2) * r * 0.7), sy(y + sin(a + 2.2) * r * 0.7), sx(x + cos(a + 4) * r * 0.9), sy(y + sin(a + 4) * r * 0.9));
    gfx_set(0.35, 0.33, 0.32, 0.8); gfx_line(sx(x + cos(a) * r), sy(y + sin(a) * r), sx(x + cos(a + 2.2) * r * 0.7), sy(y + sin(a + 2.2) * r * 0.7), 1);
    k += 1;
  );
  gfx_mode = 1;
  k = 0;
  loop(16,
    x = XS_X0 + XS_W * frac(hash(k * 5.9) + 0.03 * sin(g_xs_t * 0.7 + k));
    y = XS_Y1 + 10 - ((hash(k * 1.3) * (BRD_H + 40) + g_xs_t * (25 + 20 * hash(k))) % (BRD_H + 40));
    gfx_set(1, 0.4 + 0.3 * hash(k * 2), 0.1, 0.5 + 0.4 * sin(g_xs_t * 6 + k)); gfx_circle(sx(x), sy(y), 1.2 * g_s, 1, 1);
    k += 1;
  );
  gfx_mode = 0;
  xs_terrain();
  xs_cg_draw();
  xs_hz_draw();
  i = 0; loop(NXC, xc_a[i] ? xs_coin_draw(i); i += 1; );
  (g_xs_boss >= 1 && g_xs_boss <= 3) ? (
    xs_draw_boss();
    g_xs_boss == 3 ? (
      a = min(1, (g_xs_t - g_xs_bdie_t) / 2.4);
      gfx_mode = 1; gfx_set(1, 0.9, 0.7, (0.15 + 0.5 * a * a) * (0.6 + 0.4 * sin(g_t * 40)));
      gfx_circle(sx(g_xs_bx), sy(g_xs_by), (60 + 90 * a) * g_s, 1, 1); gfx_mode = 0;
    );
  );
  i = 0; loop(NXN, (xn_t[i] && xn_y[i] > XS_Y0 - 40) ? xs_draw_enemy(i); i += 1; );
  gfx_mode = 1;
  i = 0;
  loop(NXB,
    xb_a[i] ? (
      x = sx(xb_x[i]); y = sy(xb_y[i]);
      xb_k[i] == 1 ? (
        gfx_set(1, 0.6, 0.3, 0.5); gfx_circle(x, y, 5 * g_s, 1, 1);
        gfx_set(1, 0.95, 0.8, 1); gfx_circle(x, y, 2.5 * g_s, 1, 1);
      ) : xb_k[i] == 2 ? (
        gfx_set(0.5, 1, 0.5, 0.4); gfx_circle(x, y, 5 * g_s, 1, 1);
        gfx_set(0.85, 1, 0.85, 1); gfx_circle(x, y, 2.2 * g_s, 1, 1);
      ) : (
        a = xb_k[i] == 3 ? 1.6 : 1;
        gfx_set(xb_k[i] == 4 ? 1 : 0.3, xb_k[i] == 4 ? 0.7 : 0.8, 1, 0.35);
        tline(x - xb_vx[i] * 0.018 * g_s, y - xb_vy[i] * 0.018 * g_s, x, y, 6 * a * g_s);
        gfx_set(0.85, 0.95, 1, 1);
        tline(x - xb_vx[i] * 0.012 * g_s, y - xb_vy[i] * 0.012 * g_s, x, y, 2.2 * a * g_s);
      );
    );
    i += 1;
  );
  g_xs_lz ? (
    a = xs_lv[4] >= 2 ? 10 : 6;
    f = 0.8 + 0.2 * sin(g_t * 50);
    gfx_set(0.4, 0.8, 1, 0.25 * f); gfx_rect(sx(g_xs_px - a), sy(g_xs_lz), 2 * a * g_s, (g_xs_py - 20 - g_xs_lz) * g_s);
    gfx_set(0.8, 0.95, 1, 0.8); gfx_rect(sx(g_xs_px - a * 0.3), sy(g_xs_lz), 0.6 * a * g_s, (g_xs_py - 20 - g_xs_lz) * g_s);
    gfx_set(1, 1, 1, 0.6); gfx_circle(sx(g_xs_px), sy(g_xs_lz), a * 1.4 * g_s, 1, 1);
  );
  i = 0;
  loop(NXE,
    xe_a[i] ? (
      x = sx(xe_x[i]); y = sy(xe_y[i]);
      a = sqrt(xe_vx[i] ^ 2 + xe_vy[i] ^ 2); a = a > 1 ? 9 / a : 0;
      xe_k[i] == 4 ? gfx_set(1, 0.45, 0.05, 0.4) : xe_k[i] == 3 ? gfx_set(0.3, 0.7, 1, 0.35) : xe_k[i] == 2 ? gfx_set(0.8, 0.2, 1, 0.35) : xe_k[i] == 1 ? gfx_set(1, 0.15, 0.3, 0.35) : gfx_set(1, 0.3, 0.05, 0.35);
      gfx_circle(x, y, 7 * g_s, 1, 1);
      tline(x - xe_vx[i] * a * g_s, y - xe_vy[i] * a * g_s, x, y, 6 * g_s);
      xe_k[i] == 4 ? gfx_set(1, 0.85, 0.3, 1) : xe_k[i] == 3 ? gfx_set(0.85, 0.95, 1, 1) : xe_k[i] == 2 ? gfx_set(1, 0.85, 1, 1) : xe_k[i] == 1 ? gfx_set(1, 0.8, 0.85, 1) : gfx_set(1, 0.9, 0.55, 1);
      tline(x - xe_vx[i] * a * 0.6 * g_s, y - xe_vy[i] * a * 0.6 * g_s, x, y, 2.4 * g_s);
      gfx_circle(x, y, 2.6 * g_s, 1, 1);
    );
    i += 1;
  );
  gfx_mode = 0;
  (g_xs_state == 1 || g_xs_state == 4 || g_xs_state == 6 || g_xs_state == 8) && (g_xs_t > g_xs_inv || frac(g_xs_t * 10) < 0.5 || g_xs_state != 1) ? (
    k = 0;
    loop(xs_lv[5],
      a = g_xs_t * 3 + k * $pi;
      x = sx(g_xs_px + cos(a) * 36); y = sy(g_xs_py + sin(a) * 22);
      gfx_mode = 1; gfx_set(0.4, 0.9, 1, 0.25); gfx_circle(x, y, 10 * g_s, 1, 1); gfx_mode = 0;
      gfx_set(0.35, 0.4, 0.5, 1); gfx_circle(x, y, 7 * g_s, 1, 1);
      gfx_set(0.5, 0.95, 1, 1); gfx_circle(x, y, 3.5 * g_s, 1, 1);
      k += 1;
    );
    xs_ship(g_xs_px, g_xs_py, g_xs_bank, 1);
    g_xs_t - g_xs_hit_t < 0.12 ? ( gfx_mode = 1; gfx_set(1, 0.4, 0.3, 0.5); gfx_circle(sx(g_xs_px), sy(g_xs_py), 22 * g_s, 1, 1); gfx_mode = 0; );
  );
  i = 0;
  loop(NXK,
    t = g_xs_t - xk_t[i];
    xk_t[i] > 0 && t < xk_l[i] ? (
      f = t / xk_l[i];
      x = xk_x[i] + xk_vx[i] * t; y = xk_y[i] + xk_vy[i] * t + g_xs_sc * 0;
      r = xk_r[i] * (1 + 1.6 * f);
      gfx_set(0.05, 0.045, 0.045, 0.5 * (1 - f)); gfx_circle(sx(x), sy(y), r * g_s, 1, 1);
      gfx_set(0.14, 0.12, 0.11, 0.35 * (1 - f)); gfx_circle(sx(x - r * 0.2), sy(y - r * 0.25), r * 0.6 * g_s, 1, 1);
    );
    i += 1;
  );
  t = g_xs_t - g_xs_fl_t;
  t < 0.09 ? (
    a = 1 - t / 0.09;
    gfx_mode = 1;
    gfx_set(1, 0.5, 0.1, 0.12 * a); gfx_circle(sx(g_xs_fl_x), sy(g_xs_fl_y), g_xs_fl_r * g_s, 1, 1);
    gfx_set(1, 0.7, 0.3, 0.25 * a); gfx_circle(sx(g_xs_fl_x), sy(g_xs_fl_y), g_xs_fl_r * 0.55 * g_s, 1, 1);
    gfx_set(1, 0.95, 0.8, 0.7 * a); gfx_circle(sx(g_xs_fl_x), sy(g_xs_fl_y), g_xs_fl_r * 0.22 * g_s, 1, 1);
    gfx_mode = 0;
  );
  particles();
  i = 0;
  loop(NXW,
    t = g_xs_t - xw_t[i];
    xw_t[i] > 0 && t < 0.5 ? (
      a = 1 - t / 0.5;
      gfx_set(1, 0.9, 0.7, 0.6 * a);
      gfx_circle(sx(xw_x[i]), sy(xw_y[i]), (xw_r[i] * (0.3 + t * 2)) * g_s, 0, 1);
      gfx_circle(sx(xw_x[i]), sy(xw_y[i]), (xw_r[i] * (0.3 + t * 2) + 1.5) * g_s, 0, 1);
    );
    i += 1;
  );
  t = g_xs_t - g_xs_bomb_t;
  t < 0.9 ? (
    a = 1 - t / 0.9;
    r = 60 + t * 1100;
    gfx_mode = 1;
    gfx_set(0.3, 0.6, 1, 0.22 * a); gfx_circle(sx(g_xs_bomb_x), sy(g_xs_bomb_y), r * g_s, 1, 1);
    k = 0;
    loop(7,
      gfx_set(0.5 + 0.07 * k, 0.8, 1, (0.9 - k * 0.11) * a);
      gfx_circle(sx(g_xs_bomb_x), sy(g_xs_bomb_y), (r - k * 5) * g_s, 0, 1);
      k += 1;
    );
    gfx_set(1, 1, 1, 0.9 * a);
    gfx_circle(sx(g_xs_bomb_x), sy(g_xs_bomb_y), (r + 2) * g_s, 0, 1);
    gfx_circle(sx(g_xs_bomb_x), sy(g_xs_bomb_y), (r + 3) * g_s, 0, 1);
    k = 0;
    loop(8,
      i = k * $pi / 4 + hash(floor(g_t * 30) + k) * 0.6;
      gfx_set(0.75, 0.9, 1, 0.9 * a);
      bz_bolt(sx(g_xs_bomb_x), sy(g_xs_bomb_y), sx(g_xs_bomb_x + cos(i) * r), sy(g_xs_bomb_y + sin(i) * r), 7, max(1, 1.6 * g_s), floor(g_t * 25) + k * 13);
      k += 1;
    );
    gfx_set(0.8, 0.9, 1, 0.5 * a * a); gfx_circle(sx(g_xs_bomb_x), sy(g_xs_bomb_y), (40 + 200 * t) * g_s, 1, 1);
    gfx_mode = 0;
  );
  t = g_xs_t - g_xs_flash_t;
  t < 0.5 ? ( gfx_mode = 1; gfx_set(0.85, 0.92, 1, (1 - t / 0.5) ^ 1.5); gfx_rect(sx(XS_X0 - 60), sy(XS_Y0 - 60), (XS_W + 120) * g_s, (BRD_H + 120) * g_s); gfx_mode = 0; );
  t = g_t - g_xs_blast_t;
  t < 1.3 ? (
    gfx_mode = 1;
    a = t < 0.1 ? 1 : max(0, 1 - (t - 0.1) / 1.2);
    gfx_set(1, 1, 0.95, t < 0.1 ? 1 - t * 4 : 0); gfx_rect(sx(XS_X0 - 60), sy(XS_Y0 - 60), (XS_W + 120) * g_s, (BRD_H + 120) * g_s);
    gfx_set(1, 0.45, 0.1, 0.55 * a * a); gfx_rect(sx(XS_X0 - 60), sy(XS_Y0 - 60), (XS_W + 120) * g_s, (BRD_H + 120) * g_s);
    k = 0;
    loop(6,
      gfx_set(1, 0.6 - k * 0.08, 0.2, 0.18 * a); gfx_circle(sx(g_xs_fx), sy(g_xs_fy), (60 + t * (500 + k * 120)) * g_s, 1, 1);
      k += 1;
    );
    t < 0.9 ? ( k = 0; loop(5, gfx_set(1, 0.9 - k * 0.12, 0.6 - k * 0.12, (0.45 - k * 0.07) * (1 - t / 0.9)); gfx_circle(sx(g_xs_fx), sy(g_xs_fy), (25 + k * 28) * (0.5 + 2.5 * t) * g_s, 1, 1); k += 1; ); );
    gfx_mode = 0;
  );
);

function xs_icon(i, x, y, s) local(px, py, k, a)
(
  px = sx(x); py = sy(y);
  i == 0 ? (
    gfx_set(0.55, 0.6, 0.72, 1); gfx_triangle(px, py - 14 * s, px - 7 * s, py + 10 * s, px + 7 * s, py + 10 * s);
    gfx_set(0.5, 0.85, 1, 1); k = -1; loop(3, tline(px + k * 9 * s, py - 16 * s, px + k * 11 * s, py - 26 * s, 3 * s); k += 1; );
  ) : i == 1 ? (
    gfx_set(0.55, 0.6, 0.72, 1); gfx_circle(px, py, 6 * s, 1, 1);
    gfx_set(0.5, 1, 0.5, 1); tline(px - 8 * s, py, px - 22 * s, py, 3 * s); tline(px + 8 * s, py, px + 22 * s, py, 3 * s);
    gfx_triangle(px - 26 * s, py, px - 20 * s, py - 5 * s, px - 20 * s, py + 5 * s); gfx_triangle(px + 26 * s, py, px + 20 * s, py - 5 * s, px + 20 * s, py + 5 * s);
  ) : i == 2 ? (
    gfx_set(0.55, 0.6, 0.72, 1); gfx_circle(px, py - 8 * s, 6 * s, 1, 1);
    gfx_set(0.5, 1, 0.5, 1); tline(px, py, px, py + 16 * s, 3 * s); gfx_triangle(px, py + 22 * s, px - 6 * s, py + 14 * s, px + 6 * s, py + 14 * s);
  ) : i == 3 ? (
    gfx_set(0.8, 0.82, 0.9, 1); tline(px - 10 * s, py + 12 * s, px + 6 * s, py - 10 * s, 5 * s);
    gfx_set(1, 0.3, 0.25, 1); gfx_triangle(px + 9 * s, py - 14 * s, px + 2 * s, py - 10 * s, px + 7 * s, py - 6 * s);
    gfx_mode = 1; gfx_set(1, 0.6, 0.2, 0.8); gfx_circle(px - 12 * s, py + 15 * s, 5 * s, 1, 1); gfx_mode = 0;
    gfx_set(1, 0.8, 0.4, 0.6); gfx_arc(px + 6 * s, py - 10 * s, 16 * s, 3.5, 5.2, 1);
  ) : i == 4 ? (
    gfx_mode = 1; gfx_set(0.4, 0.8, 1, 0.35); gfx_rect(px - 6 * s, py - 24 * s, 12 * s, 38 * s); gfx_mode = 0;
    gfx_set(0.9, 0.97, 1, 1); gfx_rect(px - 2 * s, py - 24 * s, 4 * s, 38 * s);
    gfx_set(0.55, 0.6, 0.72, 1); gfx_triangle(px, py + 6 * s, px - 8 * s, py + 22 * s, px + 8 * s, py + 22 * s);
  ) : i == 5 ? (
    gfx_set(0.55, 0.6, 0.72, 1); gfx_triangle(px, py - 10 * s, px - 6 * s, py + 10 * s, px + 6 * s, py + 10 * s);
    k = -1; loop(2, gfx_set(0.35, 0.4, 0.5, 1); gfx_circle(px + k * 18 * s, py + 2 * s, 7 * s, 1, 1); gfx_set(0.5, 0.95, 1, 1); gfx_circle(px + k * 18 * s, py + 2 * s, 3.5 * s, 1, 1); k += 2; );
  ) : i == 6 ? (
    gfx_set(0.3, 0.32, 0.38, 1); fill_rr(x - 12 * s, y - 18 * s, 24 * s, 34 * s, 4 * s);
    gfx_set(0.4, 1, 0.5, 1); fill_rr(x - 9 * s, y - 6 * s, 18 * s, 19 * s, 2 * s);
    gfx_set(0.3, 0.32, 0.38, 1); gfx_rect(px - 5 * s, py - 22 * s, 10 * s, 5 * s);
  ) : i == 7 ? (
    g_xs_ssc = 0.7; xs_ship(x, y + 2 * s, 0, 1); g_xs_ssc = 1;
  ) : (
    gfx_set(0.12, 0.12, 0.15, 1); gfx_circle(px, py + 3 * s, 12 * s, 1, 1);
    gfx_set(0.3, 0.3, 0.36, 1); gfx_circle(px - 4 * s, py - 1 * s, 5 * s, 1, 1);
    gfx_set(0.85, 0.7, 0.45, 1); tline(px + 7 * s, py - 7 * s, px + 13 * s, py - 15 * s, 2.5 * s);
    glow(px + 14 * s, py - 16 * s, 3 * s, 1, 0.7, 0.2, 1);
  );
);

function xs_iname(i)
(
  i == 0 ? "Main gun" : i == 1 ? "Side shot" : i == 2 ? "Rear shot" : i == 3 ? "Missiles" : i == 4 ? "Laser" :
  i == 5 ? "Drones" : i == 6 ? "Energy refill" : i == 7 ? "Extra life" : "Smart bomb";
);

function xs_hud() local(x, y, k, a, f, n, c, w, d)
(
  x = BRD_X + 20;
  font(11, 'b'); gfx_set(0.6, 0.64, 0.72, 1); txt_l("SCORE", x, BRD_Y + 22);
  d = g_xs_score - g_xs_disp; d > 0 ? g_xs_disp = min(g_xs_score, g_xs_disp + max(1, ceil(d * min(1, g_dt * 8)))) : g_xs_disp = g_xs_score;
  sprintf(#g_tt, "%d", g_xs_disp);
  xs_text(#g_tt, x - 4, BRD_Y + 36, 140, 28, 20, 1, 0.95, 0.85, 1);
  g_xs_mul > 1 ? (
    sprintf(#g_tt, "x%d", g_xs_mul);
    a = max(0, 1 - (g_xs_t - g_xs_mul_t) * 2);
    xs_plate(#g_tt, x, BRD_Y + 70, 48 + 10 * a, 24, 1, 0.35 + 0.3 * a, 0.1);
  );
  font(11, 'b'); gfx_set(0.6, 0.64, 0.72, 1); txt_l("CREDITS", x, BRD_Y + 108);
  a = max(0, 1 - (g_t - g_xs_crt) * 4);
  xs_crystal(x + 9, BRD_Y + 136, 6 + 2 * a, g_t, 1);
  sprintf(#g_tt, "%d", g_xs_cr);
  xs_text(#g_tt, x + 20, BRD_Y + 124, 100, 24, 17 + 3 * a, 1, 0.85, 0.4, 1);
  font(11, 'b'); gfx_set(0.6, 0.64, 0.72, 1);
  sprintf(#g_tt, "WORLD %d-%d", floor((g_xs_lv - 1) / 2) % 5 + 1, ((g_xs_lv - 1) % 2) + 1);
  txt_l(#g_tt, x, BRD_Y + 166);
  g_xs_lv > 10 ? ( sprintf(#g_tt, "LOOP %d", floor((g_xs_lv - 1) / 10) + 1); txt_l(#g_tt, x + 90, BRD_Y + 166); );
  font(13, 'b'); xs_th_set(1); gfx_set(g_cr, g_cg, g_cb, 1);
  txt_l(xs_world_name(g_xs_lv), x, BRD_Y + 182);
  y = BRD_Y + 214; f = BRD_H - 300;
  gfx_set(0.1, 0.11, 0.14, 1); fill_rr(x + 50, y, 12, f, 6);
  a = min(1, g_xs_sc / g_xs_len);
  xs_th_set(0.7); gfx_set(g_cr, g_cg, g_cb, 1); fill_rr(x + 51, y + f * (1 - a), 10, f * a, 5);
  font(10, 'b'); gfx_set(1, 0.85, 0.4, 1);
  txt_l("SHOP", x + 70, y + f * 0.5 - 6); gfx_rect(sx(x + 46), sy(y + f * 0.5), 20 * g_s, max(1, g_s));
  gfx_set(1, 0.4, 0.35, 1); txt_l((g_xs_lv % 2) ? "GUARDIAN" : (g_xs_lv % 10) ? "BOSS" : "HIVE MIND", x + 70, y - 4);
  g_xs_ssc = 0.5; xs_ship(x + 56, y + f * (1 - a), 0, 1); g_xs_ssc = 1;
  font(10, 0); gfx_set(0.5, 0.53, 0.6, 1);
  sprintf(#g_tt, "Best %d", sv2[40]); txt_l(#g_tt, x, BRD_Y + BRD_H - 40);
  x = XS_X1 + 22;
  font(11, 'b'); gfx_set(0.6, 0.64, 0.72, 1); txt_l("ENERGY", x, BRD_Y + 22);
  n = 16; k = 0;
  loop(n,
    a = (k + 0.5) / n;
    c = g_xs_en / 100 >= a;
    f = a < 0.3 ? 0 : a < 0.6 ? 1 : 2;
    c ? gfx_set(f == 0 ? 1 : f == 1 ? 1 : 0.35, f == 0 ? 0.3 : f == 1 ? 0.8 : 1, f == 0 ? 0.25 : 0.3, 1) : gfx_set(0.13, 0.14, 0.17, 1);
    (c && g_xs_en < 30 && frac(g_t * 3) < 0.5) ? gfx_set(1, 0.6, 0.5, 1);
    gfx_rect(sx(x + k * 8.2), sy(BRD_Y + 40), 6.5 * g_s, 16 * g_s);
    k += 1;
  );
  font(11, 'b'); gfx_set(0.6, 0.64, 0.72, 1); txt_l("SHIPS", x, BRD_Y + 74);
  g_xs_ssc = 0.5; k = 0; loop(min(6, g_xs_lives), xs_ship(x + 12 + k * 26, BRD_Y + 108, 0, 1); k += 1; ); g_xs_ssc = 1;
  font(11, 'b'); gfx_set(0.6, 0.64, 0.72, 1); txt_l("BOMBS", x, BRD_Y + 150);
  k = 0; loop(xs_lv[8], xs_icon(8, x + 14 + k * 30, BRD_Y + 180, 0.8); k += 1; );
  font(9, 0); gfx_set(0.5, 0.53, 0.6, 1); txt_l("D or right-click", x, BRD_Y + 198);
  font(11, 'b'); gfx_set(0.6, 0.64, 0.72, 1); txt_l("WEAPONS", x, BRD_Y + 234);
  k = 0;
  loop(6,
    y = BRD_Y + 256 + k * 32;
    a = k == 0 ? xs_lv[0] : xs_lv[k];
    font(11, 'b'); a > 0 ? gfx_set(0.9, 0.92, 0.96, 1) : gfx_set(0.38, 0.4, 0.46, 1);
    txt_l(xs_iname(k), x, y);
    w = k == 0 ? 5 : 2; c = 0;
    loop(w, c < a ? gfx_set(0.4, 0.9, 1, 1) : gfx_set(0.18, 0.2, 0.25, 1); gfx_rect(sx(x + c * 14), sy(y + 15), 11 * g_s, 5 * g_s); c += 1; );
    k += 1;
  );
);

function xs_kc(r, g, b) ( gfx_set(min(1, r * g_xs_kt1), min(1, g * g_xs_kt2), min(1, b * g_xs_kt3), 1); );
function xs_kci(x, y, r) ( gfx_circle(sx(x), sy(y), r * g_s, 1, 1); );
function xs_ktri(x1, y1, x2, y2, x3, y3) ( gfx_triangle(sx(x1), sy(y1), sx(x2), sy(y2), sx(x3), sy(y3)); );
function xs_kquad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(sx(x1), sy(y1), sx(x2), sy(y2), sx(x3), sy(y3), sx(x4), sy(y4)); );
function xs_kell(cx, cy, rx, ry, a0, a1) local(k, a, b, n)
(
  n = 24; k = 0;
  loop(n,
    a = a0 + (a1 - a0) * k / n; b = a0 + (a1 - a0) * (k + 1) / n;
    gfx_triangle(sx(cx), sy(cy), sx(cx + cos(a) * rx), sy(cy + sin(a) * ry), sx(cx + cos(b) * rx), sy(cy + sin(b) * ry));
    k += 1;
  );
);
function xs_kline(x1, y1, x2, y2, w) ( aa_tline(sx(x1), sy(y1), sx(x2), sy(y2), w * g_s); );
function xs_keye(x, y, r, look, cr, cg, cb) local(p)
(
  xs_kc(0.05, 0.04, 0.05); xs_kci(x, y, r + 2);
  xs_kc(cr, cg, cb); xs_kci(x, y, r);
  p = r * 0.45;
  xs_kc(0.04, 0.03, 0.04); xs_kci(x + look * r * 0.4 - r * 0.1, y + r * 0.1, p);
  gfx_set(1, 1, 1, 0.9); xs_kci(x - r * 0.35, y - r * 0.35, max(1.2, r * 0.18));
);
function xs_kacc(i) ( g_xs_ka1 = xs_ka[i * 6 + g_xs_kalt * 3]; g_xs_ka2 = xs_ka[i * 6 + g_xs_kalt * 3 + 1]; g_xs_ka3 = xs_ka[i * 6 + g_xs_kalt * 3 + 2]; );
function xs_kshade(x, y) local(h)
(
  h = 150 * g_s;
  gfx_gradrect(sx(x - 140), sy(y - 215), 280 * g_s, h, 0, 0, 0, 0.62, 0, 0, 0, 0, 0, 0, 0, -0.62 / h);
  h = 70 * g_s;
  gfx_gradrect(sx(x - 172), sy(y - 280), h, 350 * g_s, 0, 0, 0, 0.6, 0, 0, 0, -0.6 / h, 0, 0, 0, 0);
  gfx_gradrect(sx(x + 160) - h, sy(y - 280), h, 350 * g_s, 0, 0, 0, 0, 0, 0, 0, 0.6 / h, 0, 0, 0, 0);
);
function xs_kglow(x, y, r, cr, cg, cb, a)
(
  gfx_mode = 1;
  gfx_set(cr, cg, cb, 0.18 * a); xs_kci(x, y, r * 3.2);
  gfx_set(cr, cg, cb, 0.9 * a); xs_kci(x, y, r);
  gfx_set(1, 1, 1, 0.5 * a); xs_kci(x, y, r * 0.4);
  gfx_mode = 0;
);
function xs_khand(hx, hy, d, r, g, b) local(i, fx, ex, ey)
(
  xs_kc(0.03, 0.03, 0.03); xs_kquad(hx - 26, hy - 16, hx + 26, hy - 18, hx + 22, hy + 2, hx - 22, hy + 4);
  xs_kc(r * 0.6, g * 0.6, b * 0.6); xs_kquad(hx - 22, hy - 6, hx + 22, hy - 8, hx + 24, hy + 10, hx - 24, hy + 12);
  xs_kc(r, g, b); xs_kquad(hx - 20, hy - 6, hx + 20, hy - 8, hx + 20, hy + 6, hx - 20, hy + 8);
  i = 0;
  loop(4,
    fx = hx - 16 + i * 10.5; ex = fx + d * 3; ey = hy + 24 + (i == 1 || i == 2) * 4;
    xs_kc(r * 0.45, g * 0.45, b * 0.45); xs_kline(fx, hy + 4, ex, ey, 6.5);
    xs_kc(r, g, b); xs_kline(fx, hy + 4, ex, ey, 4.5);
    xs_kc(r * 0.55, g * 0.55, b * 0.55); xs_kci(fx + d * 1.5, hy + 13, 2.6);
    xs_kc(0.5, 0.46, 0.36); xs_ktri(ex - 2.4, ey, ex + 2.4, ey, ex + d * 1.5, ey + 9);
    i += 1;
  );
  xs_kc(r * 0.45, g * 0.45, b * 0.45); xs_kline(hx - d * 20, hy, hx - d * 26, hy + 14, 6.5);
