    k = -1; loop(2, gfx_set(0.2, 0.12, 0.3, 1); gfx_triangle(x + k * r * 0.9, y - r * 0.7, x + k * r * 1.7, y - r * 1.3, x + k * r * 1.4, y - r * 0.4); k += 2; );
