    w ? ( gfx_mode = 1; gfx_set(1, 0.4, 0.1, 0.4); gfx_circle(ex, ey, r * 0.9, 1, 1); gfx_mode = 0; );
    gfx_set(1, 1, 1, 0.5); gfx_circle(ex - r * 0.18, ey - r * 0.2, max(1, r * 0.09), 1, 1);
  ) : t == 4 ? (
