    f = 0.5 + 0.5 * sin(a * 4 + i);
    k = 0; loop(5, ang = k * $pi * 2 / 5 + a * 0.2 + $pi / 5; gfx_set(1, 0.45, 0.1, 0.6 + 0.4 * f); gfx_line(x, y, x + cos(ang) * r * 0.9, y + sin(ang) * r * 0.9, 1); k += 1; );
    gfx_set(1, 0.5, 0.15, 0.3 + 0.3 * f); gfx_circle(x, y, r * 0.3, 1, 1);
