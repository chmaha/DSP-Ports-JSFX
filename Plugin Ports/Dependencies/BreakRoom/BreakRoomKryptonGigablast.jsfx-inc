function xs_db_maw(t) local(x, y, s, k, j, a, ax, ay, r, fl, op, f, o, gy, mx, my, rx)
(
  x = sx(g_xs_bx); y = sy(g_xs_by); s = g_s; op = xs_core_open();
  f = op ? min(1, (t - g_xs_open_t) * 1.5) : 0;
  !op ? g_xs_open_t = t;
  xs_bset(0.08, 0.2, 0.06, 1); tline(x, y - 30 * s, x + 30 * s, y - 300 * s, 26 * s);
  xs_bset(0.22, 0.48, 0.14, 1); tline(x, y - 30 * s, x + 30 * s, y - 300 * s, 18 * s);
  k = -1;
  loop(2,
    xs_bset(0.06, 0.18, 0.05, 1); xs_sell(x + k * 96 * s, y - 50 * s, 74 * s, 26 * s, 0, 2 * $pi, 20);
    xs_bset(0.2, 0.55, 0.15, 1); xs_sell(x + k * 96 * s, y - 50 * s, 70 * s, 22 * s, 0, 2 * $pi, 20);
    xs_bset(0.12, 0.38, 0.1, 1); tline(x + k * 30 * s, y - 50 * s, x + k * 160 * s, y - 52 * s, 2 * s);
    k += 2;
  );
  k = 0;
  loop(4,
    xp_on[k] ? (
      ax = sx(xp_x[k]); ay = sy(xp_y[k]);
      mx = (x + ax) * 0.5 + 20 * s * sin(t * 1.5 + k); my = (y + ay) * 0.5 + 18 * s;
      xs_bset(0.1, 0.3, 0.08, 1); tline(x + (ax > x ? 40 : -40) * s, y + 10 * s, mx, my, 7 * s); tline(mx, my, ax, ay, 6 * s);
    );
    k += 1;
  );
  o = 0.3 + 0.12 * sin(t * 1.6) + 0.6 * f;
  gy = y + 14 * s; rx = 92 * s;
  xs_bset(0.12, 0.02, 0.05, 1); xs_sell(x, gy, rx * 0.8, (10 + 34 * o) * s, 0, 2 * $pi, 20);
  gfx_mode = 1; xs_bset(1, 0.3, 0.5, 0.25 + 0.2 * o); xs_sell(x, gy, rx * 0.7, (8 + 30 * o) * s, 0, 2 * $pi, 20); gfx_mode = 0;
  xp_on[4] && op ? xs_eye(sx(xp_x[4]), sy(xp_y[4]), xp_r[4] * s * min(1, 0.4 + o * 0.7), xs_fl(4), xp_hp[4] / xp_hm[4]);
  j = -1;
  loop(2,
    ay = gy + j * o * 34 * s;
    xs_bset(0.05, 0.14, 0.04, 1); xs_sell(x, ay, rx + 5 * s, 62 * s, j < 0 ? $pi : 0, j < 0 ? 2 * $pi : $pi, 26);
    xs_bset(0.3, 0.62, 0.18, 1); xs_sell(x, ay, rx, 58 * s, j < 0 ? $pi : 0, j < 0 ? 2 * $pi : $pi, 26);
    xs_bset(0.42, 0.74, 0.25, 1); xs_sell(x - 18 * s, ay + j * 18 * s, rx * 0.5, 22 * s, j < 0 ? $pi : 0, j < 0 ? 2 * $pi : $pi, 14);
    xs_bset(0.9, 0.32, 0.42, 1); xs_sell(x, ay, rx * 0.86, 14 * s, j < 0 ? $pi : 0, j < 0 ? 2 * $pi : $pi, 20);
    xs_bset(0.95, 0.97, 0.8, 1);
    k = 0; loop(11, a = x - rx * 0.88 + k * rx * 0.176; gfx_triangle(a - 5 * s, ay, a + 5 * s, ay, a, ay - j * (16 + 6 * (k & 1)) * s); k += 1; );
    j < 0 ? (
      k = 0;
      loop(5,
        mx = x + (k - 2) * 30 * s; my = ay - (26 + 12 * (k == 2) - 6 * abs(k - 2)) * s;
        xs_bset(0.05, 0.02, 0.02, 1); gfx_circle(mx, my, 7 * s, 1, 1);
        gfx_mode = 1; a = 0.7 + 0.3 * sin(t * 3 + k * 1.7); xs_bset(1, 0.85, 0.1, a); gfx_circle(mx, my, 5 * s, 1, 1); xs_bset(1, 0.6, 0.05, 0.2 * a); gfx_circle(mx, my, 12 * s, 1, 1); gfx_mode = 0;
        xs_bset(0, 0, 0, 1); gfx_rect(mx - 1 * s + (sx(g_xs_px) - mx) * 0.01, my - 4 * s, 2 * s, 8 * s);
        k += 1;
      );
    ) : (
      xs_bset(0.75, 0.55, 0.6, 0.7); k = 0; loop(4, a = x - rx * 0.6 + k * rx * 0.4; gfx_rect(a, ay, 2 * s, (14 + 16 * frac(t * 0.3 + k * 0.29)) * s); k += 1; );
    );
    j += 2;
  );
  k = 0;
  loop(4,
    xp_on[k] ? (
      ax = sx(xp_x[k]); ay = sy(xp_y[k]); r = xp_r[k] * s; fl = xs_fl(k);
      xs_bset(0.1, 0.03, 0.12, 1); gfx_circle(ax, ay, r * 1.25, 1, 1);
      fl ? xs_bset(1, 1, 1, 1) : xs_bset(0.62, 0.22, 0.75, 1); gfx_circle(ax, ay, r, 1, 1);
      xs_bset(0.8, 0.45, 0.9, 1); gfx_circle(ax - r * 0.3, ay - r * 0.3, r * 0.35, 1, 1);
      gfx_mode = 1; xs_bset(0.9, 1, 0.3, 0.6 + 0.3 * sin(t * 5 + k)); gfx_circle(ax + r * 0.2, ay + r * 0.25, r * 0.28, 1, 1); gfx_mode = 0;
      xs_bset(0.1, 0.3, 0.08, 1); gfx_triangle(ax - r * 0.6, ay - r * 0.8, ax + r * 0.6, ay - r * 0.8, ax, ay - r * 1.5);
    );
    k += 1;
  );
);
function xs_db_molten(t) local(x, y, s, k, j, a, ax, ay, r, fl, op, f, rad, cx, cy, op2)
(
  x = sx(g_xs_bx); y = sy(g_xs_by); s = g_s; op = xs_core_open();
  f = op ? min(1, (t - g_xs_open_t) * 1.2) : 0;
  !op ? g_xs_open_t = t;
  rad = 84 * s;
  gfx_mode = 1; xs_bset(1, 0.35, 0.05, 0.12 + 0.05 * sin(t * 2)); gfx_circle(x, y, rad * 1.6, 1, 1); gfx_mode = 0;
  k = 0;
  loop(8,
    a = t * 0.28 + k * $pi / 4; cx = x + cos(a) * 138 * s; cy = y + sin(a) * 88 * s; r = (12 + 5 * (k % 3)) * s;
    xs_bset(0.08, 0.05, 0.04, 1); gfx_triangle(cx - r, cy - r * 0.4, cx - r * 0.2, cy - r, cx + r, cy - r * 0.3, cx + r * 0.6, cy + r * 0.8, cx - r * 0.6, cy + r * 0.7);
    xs_bset(0.3, 0.2, 0.16, 1); gfx_triangle(cx - r * 0.8, cy - r * 0.3, cx - r * 0.2, cy - r * 0.8, cx + r * 0.8, cy - r * 0.25, cx + r * 0.5, cy + r * 0.6, cx - r * 0.5, cy + r * 0.55);
    gfx_mode = 1; xs_bset(1, 0.45, 0.05, 0.5); gfx_circle(cx + r * 0.1, cy + r * 0.3, r * 0.3, 1, 1); gfx_mode = 0;
    k += 1;
  );
  xs_bset(0.06, 0.03, 0.02, 1); gfx_circle(x, y, rad + 6 * s, 1, 1);
  xs_bset(0.26, 0.17, 0.13, 1); gfx_circle(x, y, rad, 1, 1);
  xs_bset(0.36, 0.25, 0.19, 1); gfx_circle(x - 18 * s, y - 22 * s, rad * 0.6, 1, 1);
  xs_bset(0.26, 0.17, 0.13, 1); gfx_circle(x, y + 4 * s, rad * 0.62, 1, 1);
  gfx_mode = 1; a = 0.6 + 0.4 * sin(t * 2.5); xs_bset(1, 0.5, 0.08, 0.85 * a);
  k = 0; loop(9, j = k * 0.7 + 0.4; tline(x + cos(j) * rad * 0.98, y + sin(j) * rad * 0.98, x + cos(j + 0.12) * rad * 0.72, y + sin(j + 0.12) * rad * 0.72, 2.5 * s); tline(x + cos(j + 0.12) * rad * 0.72, y + sin(j + 0.12) * rad * 0.72, x + cos(j - 0.05) * rad * 0.55, y + sin(j - 0.05) * rad * 0.55, 2 * s); k += 1; );
  gfx_mode = 0;
  op2 = 6 + 46 * f;
  xs_bset(0.04, 0.02, 0.02, 1); xs_sell(x, y, 60 * s, (op2 + 6) * s, 0, 2 * $pi, 24);
  gfx_mode = 1; a = 0.5 + 0.5 * xs_hbeat(t); xs_bset(1, 0.6, 0.1, 0.9); xs_sell(x, y, 52 * s, max(2, op2 * 0.5) * s, 0, 2 * $pi, 24);
  xs_bset(1, 0.15, 0.03, 0.8 * a); k = 0; loop(8, j = (k < 4 ? $pi : 0) + (k % 4 - 1.5) * 0.35; tline(x + cos(j) * 50 * s, y + sin(j) * 8 * s, x + cos(j) * 80 * s, y + sin(j) * 40 * s, 2 * s); k += 1; );
  xs_bset(1, 0.1, 0.02, 0.2 * a); xs_sell(x, y, 70 * s, 26 * s, 0, 2 * $pi, 24); gfx_mode = 0;
  xp_on[4] && op && f > 0.4 ? xs_eye(sx(xp_x[4]), sy(xp_y[4]), xp_r[4] * s * min(1, f), xs_fl(4), xp_hp[4] / xp_hm[4]);
  k = 0;
  loop(4,
    xp_on[k] ? (
      ax = sx(xp_x[k]); ay = sy(xp_y[k]); r = xp_r[k] * s; fl = xs_fl(k);
      xs_bset(0.06, 0.03, 0.02, 1); gfx_triangle(ax - r * 1.6, ay + r * 1.1, ax - r * 0.55, ay - r * 0.9, ax + r * 0.55, ay - r * 0.9, ax + r * 1.6, ay + r * 1.1);
      fl ? xs_bset(1, 1, 1, 1) : xs_bset(0.34, 0.22, 0.17, 1); gfx_triangle(ax - r * 1.4, ay + r, ax - r * 0.45, ay - r * 0.75, ax + r * 0.45, ay - r * 0.75, ax + r * 1.4, ay + r);
      gfx_mode = 1; xs_bset(1, 0.5, 0.05, 0.9); gfx_circle(ax, ay - r * 0.75, r * 0.45, 1, 1); xs_bset(1, 0.3, 0.05, 0.3 + 0.2 * sin(t * 8 + k)); gfx_circle(ax, ay - r * 0.8, r * 1.1, 1, 1);
      xs_bset(1, 0.6, 0.1, 0.8); tline(ax - r * 0.2, ay - r * 0.7, ax - r * 0.5, ay + r * 0.6, 2 * s); gfx_mode = 0;
