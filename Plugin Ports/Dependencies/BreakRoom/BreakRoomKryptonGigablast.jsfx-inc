  gfx_mode = 1; gfx_set(1, 0.4, 0.05, 0.8 + 0.2 * sin(g_t * 9)); xs_kci(x + 64, y - 95 + b, 3.6); gfx_set(1, 0.3, 0.05, 0.18); xs_kci(x + 64, y - 95 + b, 12); gfx_mode = 0;
  k = 0;
