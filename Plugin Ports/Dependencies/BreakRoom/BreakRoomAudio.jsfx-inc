@init
g_sfxd = 2.5; g_sfxg = g_sfxd; au_gs = 1; g_sfxl = 0;
function db_snd(k, fr, gn, dl, pan)
(
  (sv2[13] && !g_snd_mute && !(play_state & 1)) ? (
    evk[g_evw] = k; evf[g_evw] = fr; evg[g_evw] = gn * g_sfxg * ((g_screen == 9 || g_screen == 12) ? 0.5012 : 1); evd[g_evw] = dl; evp[g_evw] = max(-1, min(1, pan)); evl[g_evw] = g_sfxl;
    g_evw = (g_evw + 1) % NEV;
  );
);

function db_snl(k, fr, gn, dl, pan, ln)
(
  g_sfxl = ln; db_snd(k, fr, gn, dl, pan); g_sfxl = 0;
);

function db_note(n) ( 261.63 * 2 ^ (min(36, n) / 12); );

function au_new(k, fr, gn, dl, pan, ln) local(v, j, best)
(
  v = -1; best = -1; j = 0;
  loop(NAV,
    v < 0 && !avk[j] ? v = j;
    avt[j] > best ? ( best = avt[j]; au_old = j; );
    j += 1;
  );
  v < 0 ? v = au_old;
  avk[v] = k; avf[v] = fr; avg[v] = gn * au_gs; avp[v] = pan;
  avd[v] = floor((dl + au_dly) * srate); avt[v] = 0; avph[v] = 0; avph2[v] = 0; avlp[v] = 0;
  avl[v] = floor(ln * srate);
  avm[v] = au_mus;
  ave[v] = (k == 6 || (k >= 9 && k <= 13)) ? 0 : 1;
  ava[v] = k == 9 ? 0.005 : k == 12 ? 0.07 : k == 13 ? au_pa : 0.02;
  avs[v] = k == 9 ? 0.7 : k == 12 ? 0.85 : 1;
  avph3[v] = 0; avlp2[v] = 0;
  aved[v] = exp(-(k == 16 ? au_pd : k == 17 ? 5 : (k == 8 && au_kd > 0) ? au_kd : k == 1 ? 14 : k == 2 ? 60 : k == 3 ? 22 : k == 4 ? 4.5 : k == 5 ? 9 : k == 7 ? au_pd : k == 8 ? 9 :
    k == 9 ? 30 : k == 12 ? 14 : k == 13 ? 3 : k == 14 ? 2.2 : k == 15 ? fr : k == 18 ? 9 : 5) / srate);
  k == 15 ? avf[v] = 0;
  au_any = 1;
);

function cel_start()
(
  cel.fh >= 0 ? file_close(cel.fh);
  cel.fh = -1; cel.st = 0; cel.gn = 1; cel.pi = 0; cel.fail = 0;
);

function cel_stop()
(
  cel.fh >= 0 ? file_close(cel.fh);
  cel.fh = -1; cel.st = 4; cel.gn = 0; wt_play = 0;
);

function au_start(e)
(
  evk[e] == 6 ? (
    sv2[13] == 1 ? ( wt_play = 1; wt_out = 0; au_wgen = g_db_nst; au_song = 0; cel_start(); );
  ) :
  au_new(evk[e] + 1, evf[e], evg[e], evd[e], evp[e], evl[e]);
);

function au_mf(n) ( 440 * 2 ^ ((n - 69) / 12); );

function au_mel(tr, st, k, g, pan) local(i, o)
(
  o = tr * 48; i = 0;
  loop(MLC[tr],
    MLS[o + i] == st ? au_new(k, au_mf(MLN[o + i] + au_tp - ((au_tp && MLN[o + i] + au_tp > 86) ? 12 : 0) + (k == 14 ? 12 : 0)), g, 0, pan, MLL[o + i] * SDU[tr] * 0.92);
    i += 1;
  );
);

function au_hop(tr, st, b, p) local(w, root, mn, d, th, fi, nt, rl, k3, ln, q, g, sl)
(
  w = tr - 40;
  au_gs = hb_gn[w];
  mn = 0;
  sl = w;
  q = au_part % 11; fi = (q == 1 || q == 9) ? 1 : (q == 3 || q == 7) ? 2 : q == 5 ? 3 : 0; sl = w * 4 + fi;
  fi = w % 5;
  root = fi == 0 ? 55 : fi == 1 ? 62 : fi == 2 ? 57 : fi == 3 ? 60 : 52;
  d = hb_pg[((w + (sl & 3)) & 3) * 8 + b];
  th = 4;
  nt = hb_tm[sl * 64 + st];
  ln = hb_tl[sl * 64 + st] * SDU[tr] * 0.92;
  q = p & 3;

  w == 0 ? (
    au_pd = 8;
    p == 0 ? au_new(7, au_mf(root + d - 12), 0.3, 0, -0.1, 0);
    p == 4 ? au_new(7, au_mf(root + d - 5), 0.26, 0, -0.1, 0);
    (p == 2 || p == 6) ? (
      au_pd = 16;
      au_new(7, au_mf(root + d + th), 0.055, 0, 0.3, 0);
      au_new(7, au_mf(root + d + 7), 0.05, 0.004, 0.35, 0);
      au_new(7, au_mf(root + d + 12), 0.045, 0.008, 0.25, 0);
      au_new(15, 70, 0.016, 0, 0.3, 0);
    );
    rl = p == 0 ? 2 : p == 1 ? 1 : p == 2 ? 0 : p == 3 ? 2 : p == 4 ? 1 : p == 5 ? 0 : p == 6 ? 1 : 2;
    k3 = rl == 0 ? 0 : rl == 1 ? th : 7;
    au_pd = 20;
    au_new(7, au_mf(root + d + 12 + k3), (p & 1) ? 0.05 : 0.075, 0, -0.3, 0);
    (w == 0 && (sl & 3) == 2) ? ( au_pd = 9; nt >= 0 ? au_new(7, au_mf(root + nt + 12), 0.16, 0, 0.1, 0); ) :
    nt >= 0 ? au_new(12, au_mf(root + nt + (sl == 1 ? 12 : 0)), 0.09, 0, 0.1, ln);
  ) : w == 1 ? (
    au_pd = 6;
    (p == 0 || p == 4) ? au_new(7, au_mf(root + d - 12 + (p == 4 ? 7 : 0)), 0.3, 0, -0.1, 0);
    au_pd = 11;
    (p & 1) == 0 ? au_new(7, au_mf(root + d + 12 + (q == 0 ? 0 : q == 2 ? th : 7)), 0.07, 0, 0.3, 0);
    p == 0 ? au_new(8, 62, 0.12, 0, 0, 0);
    p == 4 ? au_new(15, 25, 0.025, 0, 0.2, 0);
    nt >= 0 ? au_new(12, au_mf(root + nt + 12), 0.075, 0, 0.1, ln * 1.3);
  ) : w == 2 ? (
    au_pd = 5;
    p == 0 ? au_new(7, au_mf(root + d - 12), 0.26, 0, -0.1, 0);
    au_pd = 14;
    (p == 2 || p == 4) ? ( au_new(7, au_mf(root + d + th), 0.05, 0, 0.3, 0); au_new(7, au_mf(root + d + 7), 0.045, 0.004, 0.35, 0); );
    p == 0 ? ( au_pa = 0.6; au_new(13, au_mf(root + d), 0.04, 0, 0, SDU[tr] * 6); );
    nt >= 0 ? au_new(14, au_mf(root + nt), 0.12, 0, 0.1, 0);
  ) : w == 3 ? (
    (p & 3) == 0 ? au_new(8, 52, 0.26, 0, 0, 0);
    (p & 1) ? ( au_pd = 5; au_new(7, au_mf(root + d - 12), 0.26, 0, -0.1, 0); au_new(15, 90, 0.014, 0, 0.3, 0); );
    au_new(9, au_mf(root + d + 12 + (q == 0 ? 0 : q == 1 ? th : q == 2 ? 7 : th)), 0.045, 0, (p & 1) ? 0.4 : -0.4, SDU[tr] * 0.5);
    p == 2 ? au_new(15, 20, 0.03, 0, 0.2, 0);
    nt >= 0 ? au_new(9, au_mf(root + nt + 12), 0.075, 0, 0.1, ln);
  ) : w == 4 ? (
    (p == 0 || p == 3 || p == 5) ? au_new(8, 150, 0.2, 0, -0.3, 0);
    (p == 2 || p == 6 || p == 7) ? au_new(8, 105, 0.16, 0, 0.3, 0);
    au_new(15, 60, 0.012, 0, 0.3, 0);
    au_pd = 14;
    au_new(7, au_mf(root + d + (p == 0 || p == 4 ? 0 : p == 1 || p == 5 ? 7 : p == 2 || p == 6 ? 12 : 7) + (p & 1 ? 12 : 0)), 0.1, 0, p & 1 ? 0.3 : -0.3, 0);
    p == 0 ? ( au_pd = 6; au_new(7, au_mf(root + d - 12), 0.28, 0, 0, 0); );
    nt >= 0 ? au_new(12, au_mf(root + nt + 12), 0.07, 0, 0.1, ln);
  ) : w == 5 ? (
    au_pd = 7;
    p == 0 ? au_new(7, au_mf(root + d - 12), 0.3, 0, -0.1, 0);
    p == 4 ? au_new(7, au_mf(root + d - 5), 0.26, 0, -0.1, 0);
    (p == 2 || p == 6) ? (
      au_new(9, au_mf(root + d + th), 0.05, 0, 0.3, SDU[tr] * 0.5);
      au_new(9, au_mf(root + d + 7), 0.04, 0, 0.35, SDU[tr] * 0.5);
      au_new(9, au_mf(root + d + 12), 0.04, 0, 0.25, SDU[tr] * 0.5);
    );
    p & 1 ? au_new(15, 100, 0.01, 0, 0.3, 0);
    nt >= 0 ? au_new(9, au_mf(root + nt + 12), 0.075, 0, 0.1, ln);
    (p == 0 && (b & 1)) ? au_new(14, au_mf(root + d + 24), 0.05, 0, 0.2, 0);
  ) : w == 6 ? (
    (p == 0 || p == 4 || p == 6) ? au_new(8, 48, 0.3, 0, 0, 0);
    (p == 2 || p == 6) ? au_new(15, 22, 0.035, 0, 0.2, 0);
    (p == 0 || p == 3 || p == 4) ? au_new(6, au_mf(root + d - 24), 0.2, 0, -0.1, SDU[tr] * 1.7);
    au_pd = 5;
    p == 0 ? ( au_new(17, au_mf(root + d), 0.06, 0, 0.25, 0); au_new(17, au_mf(root + d + 7), 0.05, 0, -0.25, 0); );
    p == 4 ? ( au_new(17, au_mf(root + d + 7), 0.05, 0, 0.25, 0); au_new(17, au_mf(root + d + 12), 0.045, 0, -0.25, 0); );
    nt >= 0 ? au_new(12, au_mf(root + nt), 0.085, 0, 0.1, ln);
  ) : w == 7 ? (
    (p == 0 || p == 4) ? au_new(8, 60, 0.22, 0, 0, 0);
    p & 1 ? au_new(15, 80, 0.014, 0, 0.3, 0);
    au_pd = 8;
    (p == 0 || p == 4) ? au_new(7, au_mf(root + d - 12 + (p == 4 ? 7 : 0)), 0.24, 0, -0.1, 0);
    au_new(14, au_mf(root + d + 12 + (q == 0 ? 0 : q == 1 ? th : q == 2 ? 7 : 12) + ((b & 1) ? 12 : 0)), 0.06, 0, (q - 1.5) * 0.25, 0);
    p == 0 ? ( au_pa = 0.3; au_new(13, au_mf(root + d), 0.03, 0, 0, SDU[tr] * 8); );
    nt >= 0 ? au_new(12, au_mf(root + nt + 12), 0.08, 0, 0.1, ln);
  ) : w == 8 ? (
    au_pd = 7;
    p == 0 ? au_new(7, au_mf(root + d - 12), 0.28, 0, -0.1, 0);
    au_pd = 14;
    (p == 2 || p == 4) ? ( au_new(7, au_mf(root + d + th), 0.06, 0, 0.3, 0); au_new(7, au_mf(root + d + 7), 0.05, 0.004, 0.35, 0); );
    (p == 0 && (b & 3) == 0) ? au_new(14, au_mf(root + d + 24), 0.05, 0, 0.2, 0);
    au_pd = 11;
    nt >= 0 ? au_new(7, au_mf(root + nt + 12), 0.12, 0, 0.1, 0);
  ) : (
    (p & 1) == 0 ? au_new(8, 55, 0.26, 0, 0, 0);
    p & 1 ? au_new(15, 38, 0.02, 0, 0.3, 0);
    au_pd = 6;
    au_new(7, au_mf(root + d - 12 + ((p & 1) ? 12 : 0)), 0.2, 0, -0.1, 0);
    au_pd = 12;
    (p == 3 || p == 7) ? ( au_new(7, au_mf(root + d + th), 0.07, 0, 0.3, 0); au_new(7, au_mf(root + d + 7), 0.06, 0, 0.35, 0); au_new(7, au_mf(root + d + 12), 0.055, 0, 0.25, 0); );
    nt >= 0 ? au_new(9, au_mf(root + nt + 12), 0.08, 0, 0.1, ln);
  );
  au_gs = 1;
);

function au_step(tr, st) local(b, p, c, i, sn, mk, sec, fi, ty, hf)
(
  au_mus = 1;
  b = floor(st / SPB[tr]); p = st % SPB[tr]; c = tr * 32 + b * 4;
  sn = g_screen == 9 && g_db_wx == 4;
  au_pd = 7; au_pa = 0.3;
  tr >= 40 ? ( au_hop(tr, st, b, p); ) : tr >= 32 ? (
    ty = tr == 33 ? 0 : tr == 34 ? 0 : 0.3;
    sec = (p & 1) * SDU[tr] * ty;
    au_dly += sec;
    i = tr * 32 + ((b + 1) % 8) * 4;
    mk = CH[c];
    hf = au_part & 1;
    tr == 33 ? (
      au_pd = 8;
      (p == 0 || p == 4) ? au_new(7, au_mf(p == 4 ? mk + 7 : mk), 0.34, 0, -0.08, 0);
      (p == 2 || p == 6) ? ( au_pd = 11; fi = 1; loop(3, au_new(7, au_mf(CH[c + fi] - 12), 0.09, 0, (fi - 2) * 0.35, 0); fi += 1; ); );
      (p & 1) ? au_new(15, 90, 0.012, 0, 0.3, 0);
    ) : tr == 34 ? (
      au_pd = 5;
      (p == 0 || p == 7) ? au_new(7, au_mf(mk), 0.32, 0, -0.05, 0);
      (p == 3 || p == 4) ? au_new(7, au_mf(mk + 7), 0.24, 0, -0.05, 0);
      (st % 16 == 0 || st % 16 == 3 || st % 16 == 6 || st % 16 == 10 || st % 16 == 13) ? ( au_new(8, 900, 0.035, 0, 0.3, 0); au_pd = 2.6; fi = 1; loop(3, au_new(1, au_mf(CH[c + fi]), 0.05, 0.012 * fi, (fi - 2) * 0.3, 0); fi += 1; ); );
      au_new(15, 110, (p & 1) ? 0.008 : 0.016, 0, -0.3, 0);
    ) : tr == 35 ? (
      p == 0 ? ( au_pa = 0.6; au_new(13, au_mf(mk), 0.16, 0, 0, SPB[35] * SDU[35]); );
      au_new(1, au_mf(CH[c + 1 + (p % 3)] + ((p >> 1) & 1) * 12), 0.05, 0, (p - 3.5) * 0.14, 0);
      (p == 2 || p == 6) ? au_new(15, 16, 0.012, 0, 0.2, 0);
      au_new(15, 70, 0.006, 0, -0.25, 0);
    ) : (
      au_pd = 4;
      (p & 1) == 0 ? au_new(7, au_mf(p == 0 ? mk : p == 2 ? mk + 3 : p == 4 ? mk + 7 : CH[i] - 1), 0.26, 0, -0.05, 0);
      tr == 36 ? (
        (p == 0 && (b & 1) == 0) ? au_new(8, 50, 0.14, 0, 0, 0);
        (p == 3 && (b & 1)) ? ( au_pa = 0.08; fi = 1; loop(3, au_new(13, au_mf(CH[c + fi]), 0.035, 0, (fi - 2) * 0.4, SDU[36] * 3); fi += 1; ); );
        (p == 2 || p == 6) ? au_new(15, 18, 0.012, 0, 0.25, 0);
        (p != 1 && p != 5) ? au_new(15, 80, 0.006, 0, -0.3, 0);
      ) : (
        (p == 0 || p == 2 || p == 3 || p == 4 || p == 6 || p == 7) ? au_new(15, 42, (p == 3 || p == 7) ? 0.011 : 0.018, 0, -0.3, 0);
        (p == 2 || p == 6) ? au_new(15, 14, 0.014, 0, 0.25, 0);
        ((b & 1) ? (p == 3 || p == 6) : (p == 1 || p == 4)) ? ( au_pd = 3.2; fi = 1; loop(3, au_new(1, au_mf(CH[c + fi]), 0.052, 0.008 * fi, (fi - 2) * 0.35, 0); fi += 1; ); );
      );
    );
    !hf ? (
      au_mel(tr, st, tr == 33 ? 12 : tr == 34 ? 14 : tr == 35 ? 14 : tr == 36 ? 6 : 12, tr == 33 ? 0.09 : tr == 34 ? 0.14 : tr == 35 ? 0.16 : tr == 36 ? 0.05 : 0.09, 0.12);
    ) : (
      rand(1) < (tr == 35 || tr == 36 ? 0.3 : 0.55) ? (
        fi = 1 + floor(rand(1) * 3) % 3;
        ty = CH[c + fi] + 12 + (rand(1) < 0.25 ? 12 : 0) + (rand(1) < 0.2 ? 2 : 0);
        au_new(tr == 33 ? 12 : 14, au_mf(ty), tr == 33 ? 0.08 : 0.12, 0, 0.12 + rand(1) * 0.2 - 0.1, SDU[tr] * (1 + floor(rand(1) * 2)) * 0.92);
      );
    );
    au_dly -= sec;
  ) : tr == 0 ? (
    au_pd = 12;
    au_new(7, au_mf(CH[c] - 12 + (p & 1) * 12), 0.26, 0, 0, 0);
    p & 1 ? au_new(15, 55, 0.05, 0, 0.3, 0);
    (p == 2 || p == 6) ? ( i = 1; loop(3, au_new(7, au_mf(CH[c + i]), 0.06, 0, (i - 2) * 0.4, 0); i += 1; ); );
    au_mel(0, st, sn ? 14 : 9, sn ? 0.16 : 0.11, 0);
  ) : tr == 1 ? (
    au_pd = 6;
    i = st % 16;
    (i == 0 || i == 3 || i == 6 || i == 10 || i == 12) ? (
      i = 1; loop(3, au_new(7, au_mf(CH[c + i]), 0.075, 0.016 * i, (i - 2) * 0.3, 0); i += 1; );
    );
    au_pd = 4;
    p == 0 ? au_new(7, au_mf(CH[c] - 12), 0.3, 0, 0, 0);
    p == 4 ? au_new(7, au_mf(CH[c] - 5), 0.22, 0, 0, 0);
    p == 7 ? au_new(7, au_mf(CH[c] - 12), 0.14, 0, 0, 0);
    au_new(15, 30, p & 1 ? 0.035 : 0.02, 0, -0.3, 0);
    au_mel(1, st, sn ? 14 : 12, sn ? 0.16 : 0.13, 0.15);
  ) : tr == 2 ? (
    p == 0 ? ( au_pa = 0.25; au_new(13, au_mf(CH[c] - 12), 0.2, 0, 0, SPB[2] * SDU[2] * 0.95); );
    au_new(1, au_mf(CH[c + 1 + p % 3] + 12 * floor(p / 3)), 0.07, 0, (p - 2.5) * 0.25, 0);
    au_mel(2, st, sn ? 14 : 12, sn ? 0.15 : 0.12, -0.1);
  ) : tr == 3 ? (
    p == 0 ? (
      au_pa = 1.2;
      au_new(13, au_mf(CH[c] - 12), 0.2, 0, 0, SPB[3] * SDU[3]);
      i = 1; loop(3, au_new(13, au_mf(CH[c + i]), 0.08, 0, (i - 2) * 0.5, SPB[3] * SDU[3]); i += 1; );
    );
    au_mel(3, st, 14, 0.19, 0.2);
    rand(1) < 0.18 ? au_new(14, au_mf(CH[c + 1 + floor(rand(3)) % 3] + 24), 0.035, rand(1) * 0.5, rand(2) - 1, 0);
  ) : tr == 4 ? (
    au_pd = 10;
    p == 0 ? au_new(7, au_mf(CH[c] - 12), 0.3, 0, 0, 0);
    p == 4 ? au_new(7, au_mf(CH[c] - 5), 0.24, 0, 0, 0);
    (p == 2 || p == 6) ? (
      au_pd = 16;
      i = 1; loop(3, au_new(7, au_mf(CH[c + i] - 12), 0.06, 0, (i - 2) * 0.4, 0); i += 1; );
      au_new(15, 45, 0.03, 0, 0.2, 0);
    );
    au_mel(4, st, sn ? 14 : 1, sn ? 0.16 : 0.21, 0);
  ) : tr == 5 ? (
    au_dly += (p & 1) * SDU[5] * 0.32;
    au_pd = 2.5;
    (p == 0 || p == 5) ? ( i = 1; loop(3, au_new(7, au_mf(CH[c + i]), 0.05, 0.012 * i, (i - 2) * 0.35, 0); i += 1; ); );
    au_pd = 5;
    p == 0 ? au_new(7, au_mf(CH[c] - 12), 0.3, 0, 0, 0);
    p == 3 ? au_new(7, au_mf(CH[c] - 5), 0.2, 0, 0, 0);
    p == 6 ? au_new(7, au_mf(CH[c]), 0.16, 0, 0, 0);
    au_new(15, 70, (p == 2 || p == 6) ? 0.03 : 0.012, 0, 0.25, 0);
    au_mel(5, st, 14, 0.15, -0.15);
    au_dly -= (p & 1) * SDU[5] * 0.32;
  ) : tr == 6 ? (
    au_pd = 7;
    (p & 3) == 0 ? au_new(7, au_mf(CH[c] - 12), 0.3, 0, 0, 0);
    (p & 3) == 1 ? au_new(7, au_mf(CH[c] - 12), 0.18, SDU[6] * 0.5, 0, 0);
    (p & 3) == 2 ? au_new(7, au_mf(CH[c] - 5), 0.22, 0, 0, 0);
    (p & 3) == 3 ? au_new(7, au_mf(CH[c] - 12), 0.2, 0, 0, 0);
    (p == 2 || p == 6) ? ( au_pd = 18; i = 1; loop(3, au_new(7, au_mf(CH[c + i]), 0.07, 0, (i - 2) * 0.4, 0); i += 1; ); );
    ((p & 3) == 0 || (p & 3) == 2) ? au_new(15, 90, 0.025, 0, -0.3, 0);
    (p & 3) == 1 ? au_new(15, 90, 0.02, SDU[6] * 0.5, -0.3, 0);
    au_mel(6, st, sn ? 14 : 9, sn ? 0.15 : 0.08, 0.1);
  ) : tr == 8 ? (
    au_pd = 16;
    (p == 0 || p == 4) ? au_new(7, au_mf(CH[c] + (p == 4 ? 7 : 0)), 0.26, 0, 0, 0);
    (p == 2 || p == 6) ? ( au_pd = 22; i = 1; loop(3, au_new(7, au_mf(CH[c + i]), 0.06, 0.01 * i, (i - 2) * 0.4, 0); i += 1; ); );
    (p & 1) ? au_new(15, 120, 0.014, 0, 0.3, 0);
    au_mel(8, st, 14, 0.15, 0.1);
  ) : tr == 9 ? (
    au_pd = 9;
    p == 0 ? ( au_new(7, au_mf(CH[c]), 0.28, 0, 0, 0); au_new(8, 65, 0.1, 0, -0.1, 0); );
    p == 3 ? ( au_new(7, au_mf(CH[c] + 7), 0.2, 0, 0, 0); au_new(8, 72, 0.06, 0, -0.1, 0); );
    (p == 2 || p == 5) ? ( au_pd = 20; i = 1; loop(3, au_new(7, au_mf(CH[c + i]), 0.055, 0.008 * i, (i - 2) * 0.4, 0); i += 1; ); );
    au_mel(9, st, 12, 0.11, 0.15);
  ) : tr == 10 ? (
    p == 0 ? ( au_pa = 0.4; au_new(13, au_mf(CH[c]), 0.14, 0, 0, SPB[10] * SDU[10] * 0.95); );
    (p == 2 || p == 4) ? ( i = 1; loop(3, au_new(1, au_mf(CH[c + i] + 12), 0.035, 0, (i - 2) * 0.4, 0); i += 1; ); );
    au_mel(10, st, 14, 0.14, -0.1);
