    au_mel(7, st, 14, 0.17, 0.15);
  );
  au_mus = 0; au_kd = 0;
);


function au_render(v, n) local(k, ts, t, ph, ph2, e, ed, lp, f, w, w2, l, at, su, o, a, sw, gl, gr, bl, br, j, isr, nm, dn, ph3, lp2, c, dr)
(
  j = avd[v];
  j >= n ? ( avd[v] = j - n; ) : (
    avd[v] = 0;
    k = avk[v]; ts = avt[v]; ph = avph[v]; ph2 = avph2[v]; e = ave[v]; ed = aved[v]; lp = avlp[v];
    f = avf[v]; l = avl[v]; at = ava[v]; su = avs[v];
    isr = 1 / srate;
    a = avp[v];
    gl = avg[v] * (1 - max(0, a) * 0.6); gr = avg[v] * (1 + min(0, a) * 0.6);
    avm[v] ? ( bl = ABML; br = ABMR; ) : ( bl = ABSL; br = ABSR; );
    dn = 0;
    k == 16 || k == 17 ? (
      ph3 = avph3[v]; lp2 = avlp2[v];
      w = f * isr;
      k == 16 ? ( c = (l > 0 ? 0.34 : 0.17) * min(1, 48000 * isr); dr = l > 0 ? 3.2 : 4.5; ) : ( c = 0.4 * min(1, 48000 * isr); dr = 7; );
      while (j < n && !dn) (
        t = ts * isr;
        k == 16 ? (
          ph += w * 1.0035; ph -= floor(ph);
          ph2 += w * 1.4983; ph2 -= floor(ph2);
          ph3 += w * 0.9965; ph3 -= floor(ph3);
          o = (2 * ph - 1) + 0.75 * (2 * ph2 - 1) + 0.9 * (2 * ph3 - 1);
        ) : (
          ph += w * (1 + (t > 0.14 ? 0.011 * sin(t * 2 * $pi * 5.6) : 0)); ph -= floor(ph);
          ph2 += w * 2.003; ph2 -= floor(ph2);
          o = (2 * ph - 1) + 0.35 * (2 * ph2 - 1);
        );
        o *= dr; o = o / (1 + abs(o));
        lp += (o - lp) * c; lp2 += (lp - lp2) * c;
        a = min(1, t * 500) * e;
        (l <= 0 || ts >= l) ? e *= ed;
        o = lp2 * a;
        ts += 1;
        bl[j] += o * gl; br[j] += o * gr; j += 1;
        e < 0.0005 ? dn = 1;
      );
      avph3[v] = ph3; avlp2[v] = lp2;
    ) : k == 1 ? (
      w = 2 * $pi * f * isr; w2 = w * 2.76;
      while (j < n && !dn) (
        t = ts * isr;
        ph += w; ph2 += w2;
        o = (sin(ph) + 0.22 * sin(ph2) * e) * e * min(1, t * 400);
        e *= ed; ts += 1;
        bl[j] += o * gl; br[j] += o * gr; j += 1;
        e < 0.0005 ? dn = 1;
      );
    ) : k == 2 ? (
      while (j < n && !dn) (
        t = ts * isr;
        ph += 2 * $pi * f * (1 - min(0.6, t * 9)) * isr;
        lp += ((rand(2) - 1) - lp) * 0.25;
        o = (0.6 * sin(ph) + 0.5 * lp) * e;
        e *= ed; ts += 1;
        bl[j] += o * gl; br[j] += o * gr; j += 1;
        e < 0.0005 ? dn = 1;
      );
    ) : k == 3 ? (
      while (j < n && !dn) (
        t = ts * isr;
        ph += 2 * $pi * 210 * (1 - min(0.55, t * 5)) * isr;
        lp += ((rand(2) - 1) - lp) * 0.08;
        o = (sin(ph) + 0.4 * lp * max(0, 1 - t * 40)) * e;
        e *= ed; ts += 1;
        bl[j] += o * gl; br[j] += o * gr; j += 1;
        e < 0.0005 ? dn = 1;
      );
    ) : k == 6 ? (
      w2 = f * 1.004 * isr;
      while (j < n && !dn) (
        t = ts * isr;
        ph += f * (1 + 0.003 * sin(t * 33 + v)) * isr; ph -= floor(ph);
        ph2 += w2; ph2 -= floor(ph2);
        sw = (2 * ph - 1) + (2 * ph2 - 1);
        a = ts < l ? min(1, t * 30) * (1 - 0.18 * min(1, t * 3)) : e * ed;
        e = a;
        lp += (sw - lp) * min(0.5, (0.06 + 0.2 * min(1, t * 12)) * f / 400);
        o = lp * a * 0.45;
        ts += 1;
        bl[j] += o * gl; br[j] += o * gr; j += 1;
        ts >= l && a < 0.001 ? dn = 1;
      );
    ) : (k == 9 || k == 12 || k == 13) ? (
      w = f * isr; w2 = f * 1.007 * isr;
      nm = k == 13 ? min(0.3, 0.02 * f / 110) : 0;
      while (j < n && !dn) (
        t = ts * isr;
        a = ts < l ? min(1, t / at) * su : e * ed;
        ts < l && t < at ? a = t / at;
        e = a;
        k == 9 ? (
          ph += w; ph -= floor(ph);
          lp += ((ph < 0.3 ? 1 : -1) - lp) * 0.3;
          o = lp * a * 0.5;
        ) : k == 12 ? (
          ph += 2 * $pi * f * (1 + 0.006 * min(1, max(0, t - 0.2) * 3) * sin(t * 2 * $pi * 5)) * isr;
          lp += ((rand(2) - 1) - lp) * 0.2;
          o = (sin(ph) + 0.15 * sin(2 * ph) + 0.06 * lp) * a;
        ) : (
          ph += w; ph -= floor(ph);
          ph2 += w2; ph2 -= floor(ph2);
          sw = (2 * ph - 1) + (2 * ph2 - 1) + 0.6 * sin(ph * 2 * $pi);
          lp += (sw - lp) * nm;
          o = lp * a * 0.5;
        );
        ts += 1;
        bl[j] += o * gl; br[j] += o * gr; j += 1;
        ts >= l && a < 0.001 ? dn = 1;
      );
    ) : k == 14 ? (
      w = 2 * $pi * f * isr;
      while (j < n && !dn) (
        t = ts * isr;
        ph += w;
        o = sin(ph + 1.6 * e * sin(3.5 * ph)) * e * min(1, t * 500);
        e *= ed; ts += 1;
        bl[j] += o * gl; br[j] += o * gr; j += 1;
        e < 0.0005 ? dn = 1;
      );
    ) : k == 15 ? (
      while (j < n && !dn) (
        a = rand(2) - 1;
        lp += (a - lp) * 0.5;
        o = (a - lp) * e;
        e *= ed; ts += 1;
        bl[j] += o * gl; br[j] += o * gr; j += 1;
        e < 0.002 ? dn = 1;
      );
    ) : k == 7 ? (
      w = 2 * $pi * f * isr;
      while (j < n && !dn) (
        t = ts * isr;
        ph += w;
        o = (sin(ph) + 0.3 * sin(2 * ph) * e) * e * min(1, t * 200);
        e *= ed; ts += 1;
        bl[j] += o * gl; br[j] += o * gr; j += 1;
        e < 0.0005 ? dn = 1;
      );
    ) : k == 8 ? (
      while (j < n && !dn) (
        t = ts * isr;
        ph += 2 * $pi * f * (1 + 0.5 * exp(-t * 30)) * isr;
        lp += ((rand(2) - 1) - lp) * 0.1;
        o = (sin(ph) + 0.5 * lp * exp(-t * 40)) * e;
        e *= ed; ts += 1;
        bl[j] += o * gl; br[j] += o * gr; j += 1;
        e < 0.002 ? dn = 1;
      );
    ) : k == 18 ? (
      while (j < n && !dn) (
        t = ts * isr;
        ph += 2 * $pi * f * exp(t * 3.7) * isr;
        o = (sin(ph) + 0.25 * sin(3 * ph)) * exp(-t * 11) * min(1, t * 400);
        ts += 1;
        bl[j] += o * gl; br[j] += o * gr; j += 1;
        t > 0.3 ? dn = 1;
      );
    ) : (
      w2 = 2 * $pi * f * 1.5 * isr;
      while (j < n && !dn) (
        t = ts * isr;
        ph += 2 * $pi * f * (1 + 0.004 * sin(t * 31)) * isr;
        ph2 += w2;
        o = (sin(ph) + 0.45 * sin(ph2)) * e * min(1, t * 300) * 0.75;
        e *= ed; ts += 1;
        bl[j] += o * gl; br[j] += o * gr; j += 1;
        e < 0.0005 ? dn = 1;
      );
    );
    dn ? avk[v] = 0 : (
      avt[v] = ts; avph[v] = ph; avph2[v] = ph2; ave[v] = e; avlp[v] = lp;
    );
  );
);

// ==== Music playlists ====
function mp_init(name, buf, gs) instance(pfx, rb, fh, st, gn, pi, gsec, ntr, once, vol, rz, fin, fout, ep) local(k)
(
  pfx = name; rb = buf; fh = -1; st = 0; gn = 0; gsec = gs; ntr = 5; once = 0; vol = 1; rz = ZMF; fin = 2; fout = 1; ep = 0;
  k = floor(rand(5)) + floor(time_precise() * (buf === ZMR ? 1000 : 977));
  pi = k - 5 * floor(k / 5);
);

function mp_open() instance(pfx, rb, fh, st, pi, ntr, sr, wp, rp, fr, av, eof, fail) local(nch, srr, k)
(
  k = pi % ntr; pi = k + 1;
  sprintf(#mp_fn, "BreakRoom/BreakRoom-%s%d.opus", pfx, k + 1);
  fh = file_open(#mp_fn);
  fh < 0 ? ( sprintf(#mp_fn, "Dependencies/BreakRoom/BreakRoom-%s%d.opus", pfx, k + 1); fh = file_open(#mp_fn); );
  nch = 0; srr = 0;
  fh >= 0 ? file_riff(fh, nch, srr);
  (fh >= 0 && nch == 2 && srr > 0) ? (
    sr = srr; wp = 0; rp = 0; fr = 0; av = 0; eof = 0; fail = 0; st = 1;
  ) : (
    fh >= 0 ? file_close(fh);
    fh = -1; fail += 1; st = fail >= 5 ? 3 : 0;
  );
);

function mp_fill() instance(rb, fh, wp, av, eof, rz) local(want, n, got)
(
  want = rz - 4 - av;
  while (want > 0 && !eof) (
    n = min(want, rz - wp);
    got = floor(file_mem(fh, rb + wp * 2, n * 2) / 2);
    wp = (wp + got) % rz; av += got; want -= got;
    got < n ? ( eof = 1; file_close(fh); fh = -1; );
  );
);

function mp_render(n, on) instance(rb, gn, sr, rp, fr, av, vol, rz, fin, fout, ep) local(i, a, b, inc, dn, up, g)
(
  inc = sr / srate; dn = 1 / (fout * srate); up = 1 / (fin * srate);
  i = 0;
  while (i < n) (
    gn = max(0, min(1, gn + (on ? up : -dn)));
    av >= 2 && gn > 0 ? (
      a = rb + rp * 2; b = rb + ((rp + 1) % rz) * 2;
      g = (ep ? sin(gn * $pi * 0.5) : gn * gn) * zm_lv * vol;
      ABSL[i] += (a[0] + (b[0] - a[0]) * fr) * g;
      ABSR[i] += (a[1] + (b[1] - a[1]) * fr) * g;
      fr += inc;
      while (fr >= 1) ( fr -= 1; rp = (rp + 1) % rz; av -= 1; );
    );
    i += 1;
  );
);

function mp_block(on) instance(st, gn, gap, gsec, av, eof, once, rz)
(
  on = on && st != 3;
  (on || gn > 0) ? (
    st == 0 ? this.mp_open();
    st == 2 ? (
      gn = on;
      on ? gap -= au_n;
      gap <= 0 ? this.mp_open();
    );
    st == 1 ? (
      (av < rz / 2 && !eof) ? this.mp_fill();
      !au_out ? ( memset(ABSL, 0, au_n); memset(ABSR, 0, au_n); );
      this.mp_render(au_n, on);
      au_out = 1;
      (eof && av < 2) ? ( once ? st = 4 : ( st = 2; gap = gsec * srate; ); );
    );
  );
);

function kx_start(t) instance(fh, st, gn, pi, fail, kt) ( fh >= 0 ? file_close(fh); fh = -1; st = 0; gn = 0; pi = t; fail = 0; kt = t; );
function kx_stop() instance(fh, st, gn) ( fh >= 0 ? file_close(fh); fh = -1; st = 4; gn = 0; );
function kx_left() instance(st, av, eof, sr) ( (st == 1 && eof) ? av / sr : (st == 3 || st == 4) ? 0 : 1000; );

function kr_block() local(bg, l, xf, og, cur, shm, sh, wd)
(
  wd = floor((max(1, g_xs_lv) - 1) / 2) % 5;
  shm = g_xs_trk == 18;
  (shm && !g_kr_shl && !g_ksh_bad && ksh.st == 4) ? ksh.kx_start(0);
  ksh.st == 3 ? g_ksh_bad = 1;
  (ka.st == 3 || kbk.st == 3) ? g_kr_bad = 1;
  g_kr_shl = shm;
  sh = shm && !g_ksh_bad && ksh.st != 3;
  bg = g_kr_on && !g_kr_b && !sh && !g_kr_bad;
  (bg && ka.st == 4 && kbk.st == 4) ? ( ka.kx_start(wd); g_kd = 0; g_kr_xin = 0; g_kr_rs = 0; );
  cur = g_kd ? kbk.kt : ka.kt;
  l = g_kd ? kbk.kx_left() : ka.kx_left();
  og = g_kd ? kbk.gn : ka.gn;
  (bg && (g_kr_rs || cur != wd || l <= KXF || (og <= 0.01 && l < 100))) ? (
    xf = (og > 0.01 && !g_kr_rs && cur == wd) ? max(0.05, l) : 2;
    g_kd ? ( kbk.fout = xf / max(og, 0.01); ka.kx_start(wd); ka.fin = xf; ) : ( ka.fout = xf / max(og, 0.01); kbk.kx_start(wd); kbk.fin = xf; );
    g_kd = !g_kd; g_kr_xin = 1; g_kr_rs = 0;
  );
  (g_kr_xin && ((g_kd ? kbk.gn : ka.gn) >= 1 || !bg)) ? g_kr_xin = 0;
  !g_kr_xin ? ( g_kd ? ( kbk.fin = 2; kbk.fout = g_kr_on ? 2 : 1; ) : ( ka.fin = 2; ka.fout = g_kr_on ? 2 : 1; ); );
  kb.fin = 2; kb.fout = g_kr_on ? 2 : 1;
  ksh.fin = 2; ksh.fout = g_kr_on ? 2 : 1;
  ka.mp_block(bg && g_kd == 0);
  kbk.mp_block(bg && g_kd == 1);
  kb.mp_block(g_kr_on && g_kr_b);
  ksh.mp_block(g_kr_on && sh && !g_kr_b);
  (g_kd == 1 && ka.st == 1 && ka.gn <= 0) ? ka.kx_stop();
  (g_kd == 0 && kbk.st == 1 && kbk.gn <= 0) ? kbk.kx_stop();
);

function mp_scr() ( g_screen == 1 || g_screen == 2 || g_screen == 8 || g_screen == 9 || g_screen == 10 || g_screen == 11 || g_screen == 13 || g_screen == 15; );

function kb_restart()
(
  kb.fh >= 0 ? file_close(kb.fh);
  kb.fh = -1; kb.st = 0; kb.gn = 0; kb.pi = 0; kb.fail = 0;
);

function zm_block()
(
  zen.mp_block(sv2[13] == 1 && g_screen >= 3 && g_screen <= 7 && (!g_pz || (g_hl && !g_hl_pz)) && au_hbc < srate * 0.5);
  gm.mp_block(sv2[13] == 1 && mp_scr() && (au_mt || (g_pz && g_hl && !g_hl_pz)) && au_hbc < srate * 0.5 && !(g_screen == 9 && wt_play && !wt_out));
  g_kr_b = g_xs_trk == 17;
  (g_kr_b && !g_kr_bl) ? kb_restart();
  g_kr_bl = g_kr_b;
  g_kr_on = sv2[13] == 1 && g_screen == 12 && (au_mt || (g_pz && g_hl && !g_hl_pz)) && au_hbc < srate * 0.5;
  kr_block();
);

zen.mp_init("Zen", ZMR, 3);
gm.mp_init("Game", ZMG, 0);
ka.mp_init("Krypton", ZMK, 0); ka.ntr = 5; ka.once = 1; ka.rz = KRZ; ka.ep = 1; ka.st = 4;
kbk.mp_init("Krypton", ZMK2, 0); kbk.ntr = 5; kbk.once = 1; kbk.rz = KRZ; kbk.ep = 1; kbk.st = 4;
kb.mp_init("KryptonBoss", ZMB, 0); kb.ntr = 1; kb.pi = 0; kb.ep = 1; kb.fout = 2;
ksh.mp_init("KryptonShop", ZMS, 0); ksh.ntr = 1; ksh.pi = 0; ksh.ep = 1; ksh.st = 4;
g_kd = 0; KXF = 3;
cel.mp_init("Celebration", ZMC, 0); cel.ntr = 1; cel.once = 1; cel.vol = 1.778; cel.st = 4;
