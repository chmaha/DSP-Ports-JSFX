CH[1180] = 43; CH[1181] = 62; CH[1182] = 65; CH[1183] = 71;
MLS[1728] = 4; MLN[1728] = 72; MLL[1728] = 1;
MLS[1729] = 5; MLN[1729] = 75; MLL[1729] = 1;
MLS[1730] = 6; MLN[1730] = 79; MLL[1730] = 2;
