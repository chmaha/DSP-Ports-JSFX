SL_DT = 1 / 120;
SL_VMAX = 520;
SL_G = 1800;
SL_PMAX = 140;
SL_TR = 20;
SL_MAXN = 1300;
SL_PK = 2600;
SL_PD = 4;
NPL = 6;
plx = alloc(NPL);
ply = alloc(NPL);
plr = alloc(NPL);
plm = alloc(NPL);
plc = alloc(NPL);
plring = alloc(NPL);
NRP = 800;
rpx = alloc(NRP);
rpy = alloc(NRP);
NGH = 500;
gh1x = alloc(NGH);
gh1y = alloc(NGH);
gh2x = alloc(NGH);
gh2y = alloc(NGH);
NTR = 48;
tlx = alloc(NTR);
tly = alloc(NTR);
stx = alloc(3);
sty = alloc(3);
stgot = alloc(3);
pcr = alloc(8);
pcg = alloc(8);
pcb = alloc(8);
pcr[0] = 0.86; pcg[0] = 0.55; pcb[0] = 0.36;
pcr[1] = 0.38; pcg[1] = 0.6; pcb[1] = 0.96;
pcr[2] = 0.5; pcg[2] = 0.85; pcb[2] = 0.62;
pcr[3] = 0.88; pcg[3] = 0.45; pcb[3] = 0.74;
pcr[4] = 0.95; pcg[4] = 0.8; pcb[4] = 0.46;
pcr[5] = 0.62; pcg[5] = 0.55; pcb[5] = 0.96;
NGS = 650;
gsr = alloc(NGS);
gsa = alloc(NGS);
gsb = alloc(NGS);
NGC = 48;
gcr = alloc(NGC);
gca = alloc(NGC);
gcs = alloc(NGC);
gck = alloc(NGC);
g_i = 0;
loop(NGS,
  gsr[g_i] = 0.06 + 0.94 * sqrt(rand(1));
  gsa[g_i] = floor(rand(1) * 2) * $pi + 2.6 * log(gsr[g_i]) + (rand(1) - 0.5) * (0.3 + 0.9 * (1 - gsr[g_i]));
  gsb[g_i] = 0.25 + 0.75 * rand(1) * rand(1);
  rand(1) < 0.2 ? gsa[g_i] = rand(1) * 2 * $pi;
  g_i += 1;
);
g_i = 0;
loop(NGC,
  gcr[g_i] = 0.12 + 0.8 * rand(1);
  gca[g_i] = floor(rand(1) * 2) * $pi + 2.6 * log(gcr[g_i]) + (rand(1) - 0.5) * 0.25;
  gcs[g_i] = 0.08 + 0.1 * rand(1);
  gck[g_i] = floor(rand(1) * 3);
  g_i += 1;
);

function sx(v) ( g_ox + v * g_s; );
function sy(v) ( g_oy + v * g_s; );
function font(sz, fl) ( gfx_setfont(1, "Arial", (sz + 2) * g_s, fl); );
function hit(x, y, w, h) ( g_mx >= x && g_mx < x + w && g_my >= y && g_my < y + h; );
function frac(v) ( v - floor(v); );
function hash(k) ( frac(sin(k * 12.9898) * 43758.5453); );

function txt_c(s, x, y, w, h) local(tw, th)
(
  gfx_measurestr(s, tw, th);
  gfx_x = sx(x) + (w * g_s - tw) * 0.5;
  gfx_y = sy(y) + (h * g_s - th) * 0.5;
  gfx_drawstr(s);
);

function txt_l(s, x, y) ( gfx_x = sx(x); gfx_y = sy(y); gfx_drawstr(s); );

function txt_r(s, x, y) local(tw, th)
(
  gfx_measurestr(s, tw, th);
  gfx_x = sx(x) - tw;
  gfx_y = sy(y);
  gfx_drawstr(s);
);

function fill_rr(x, y, w, h, r) local(px, py, pw, ph, pr)
(
  px = floor(sx(x) + 0.5); py = floor(sy(y) + 0.5); pw = floor(w * g_s + 0.5); ph = floor(h * g_s + 0.5);
  pr = floor(min(r * g_s, min(pw, ph) * 0.5) + 0.5);
  gfx_rect(px + pr, py, pw - 2 * pr, ph);
  gfx_rect(px, py + pr, pr, ph - 2 * pr);
  gfx_rect(px + pw - pr, py + pr, pr, ph - 2 * pr);
  gfx_circle(px + pr, py + pr, pr, 1, 1);
  gfx_circle(px + pw - pr - 1, py + pr, pr, 1, 1);
  gfx_circle(px + pr, py + ph - pr - 1, pr, 1, 1);
  gfx_circle(px + pw - pr - 1, py + ph - pr - 1, pr, 1, 1);
);

function outline_rr(x, y, w, h, r) ( gfx_roundrect(sx(x), sy(y), w * g_s, h * g_s, r * g_s, 1); );

function tline(x1, y1, x2, y2, w) local(ddx, ddy, dl, nxo, nyo)
(
  ddx = x2 - x1; ddy = y2 - y1;
  dl = sqrt(ddx * ddx + ddy * ddy);
  dl > 0.001 ? (
    nxo = -ddy / dl * w * 0.5;
    nyo = ddx / dl * w * 0.5;
    gfx_triangle(x1 + nxo, y1 + nyo, x2 + nxo, y2 + nyo, x2 - nxo, y2 - nyo, x1 - nxo, y1 - nyo);
  );
);

function aa_tline(x1, y1, x2, y2, w) local(ddx, ddy, dl, nxo, nyo)
(
  tline(x1, y1, x2, y2, w);
  ddx = x2 - x1; ddy = y2 - y1;
  dl = sqrt(ddx * ddx + ddy * ddy);
  dl > 0.001 ? (
    nxo = -ddy / dl * w * 0.5;
    nyo = ddx / dl * w * 0.5;
    gfx_line(x1 + nxo, y1 + nyo, x2 + nxo, y2 + nyo, 1);
    gfx_line(x1 - nxo, y1 - nyo, x2 - nxo, y2 - nyo, 1);
  );
);

function glow(px, py, r, cr, cg, cb, a)
(
  gfx_mode = 1;
  gfx_set(cr, cg, cb, a * 0.07); gfx_circle(px, py, r * 3.2, 1, 1);
  gfx_set(cr, cg, cb, a * 0.16); gfx_circle(px, py, r * 1.8, 1, 1);
  gfx_set(cr, cg, cb, a * 0.7); gfx_circle(px, py, r, 1, 1);
  gfx_set(1, 1, 1, a * 0.5); gfx_circle(px, py, r * 0.45, 1, 1);
  gfx_mode = 0;
);

function snd_lbl() ( sv2[13] == 1 ? "Sound: All" : sv2[13] == 2 ? "Sound: FX" : "Sound: Off"; );
function snd_next() ( sv2[13] == 1 ? 2 : sv2[13] == 2 ? 0 : 1; );

function button(s, x, y, w, h, cr, cg, cb) local(hov)
(
  hov = hit(x, y, w, h);
  gfx_set(hov ? 0.19 : 0.135, hov ? 0.2 : 0.14, hov ? 0.23 : 0.16, 1);
  fill_rr(x, y, w, h, 6);
  gfx_set(hov ? cr : 0.3, hov ? cg : 0.31, hov ? cb : 0.35, 1);
  outline_rr(x, y, w, h, 6);
  font(13, 'b');
  gfx_set(hov ? 1 : 0.86, hov ? 1 : 0.87, hov ? 1 : 0.9, 1);
  txt_c(s, x, y, w, h);
  hov && g_click ? ( g_click = 0; 1; ) : 0;
);

function pill(s, x, y, w, h, cr, cg, cb, a)
(
  gfx_set(cr * 0.22, cg * 0.22, cb * 0.22, 1);
  fill_rr(x, y, w, h, h * 0.5);
  gfx_set(cr, cg, cb, a);
  outline_rr(x, y, w, h, h * 0.5);
  txt_c(s, x, y, w, h);
);

function background() local(r1, r2, dst)
(
  (gfx_w !== g_bgw || gfx_h !== g_bgh) ? (
    g_bgw = gfx_w; g_bgh = gfx_h;
    dst = gfx_dest;
    gfx_setimgdim(IMG_BG, gfx_w, gfx_h);
    gfx_dest = IMG_BG;
    r1 = 0.078; r2 = 0.045;
    gfx_gradrect(0, 0, gfx_w, gfx_h, r1, r1 * 1.03, r1 * 1.15, 1, 0, 0, 0, 0, (r2 - r1) / gfx_h, (r2 - r1) * 1.03 / gfx_h, (r2 - r1) * 1.15 / gfx_h, 0);
    gfx_dest = dst;
  );
  gfx_mode = 0; gfx_a = 1;
  gfx_blit(IMG_BG, 1, 0, 0, 0, gfx_w, gfx_h, 0, 0, gfx_w, gfx_h);
);

function hint(s, y)
(
  font(12, 0);
  gfx_set(0.62, 0.64, 0.68, 1);
  (g_screen >= 1 && g_screen <= 8) ? txt_c(s, 56, y, 712, 22) : g_screen == 10 ? txt_c(s, 0, y, 768, 22) : txt_c(s, 0, y, 900, 22);
);

function spawn(x, y, vx, vy, cr, cg, cb, life)
(
  qx[g_qi] = x; qy[g_qi] = y; qvx[g_qi] = vx; qvy[g_qi] = vy;
  qr[g_qi] = cr; qg[g_qi] = cg; qb[g_qi] = cb;
  ql[g_qi] = life; qm[g_qi] = life;
  g_qi = (g_qi + 1) % NQ;
);

function particles() local(i, a)
(
  gfx_mode = 1;
  i = 0;
  loop(NQ,
    ql[i] > 0 ? (
      ql[i] -= g_dt;
      qvy[i] += g_pgrav * g_dt;
      qvx[i] *= 1 - 0.8 * g_dt;
      qvy[i] *= 1 - 0.8 * g_dt;
      qx[i] += qvx[i] * g_dt;
      qy[i] += qvy[i] * g_dt;
      a = max(0, ql[i] / qm[i]);
      gfx_set(qr[i], qg[i], qb[i], a * 0.18);
      gfx_circle(sx(qx[i]), sy(qy[i]), 6 * g_s, 1, 1);
      gfx_set(qr[i], qg[i], qb[i], a * 0.9);
      gfx_circle(sx(qx[i]), sy(qy[i]), 2.2 * g_s, 1, 1);
    );
    i += 1;
  );
  gfx_mode = 0;
);

function win_card(title, t0, cr, cg, cb) local(pa, cw, chh, cx0, cy0, r)
(
  r = 0;
  g_t - t0 > 0.8 ? (
    pa = min(1, (g_t - t0 - 0.8) * 3);
    gfx_set(0, 0, 0, (g_wcx > 0 ? 0.2 : 0.45) * pa);
    gfx_rect(sx(BRD_X), sy(BRD_Y), BRD_W * g_s, BRD_H * g_s);
    cw = 400; chh = 200;
    cx0 = (g_wcx > 0 ? g_wcx : 450) - cw * 0.5;
    cy0 = (g_wcy > 0 ? g_wcy : BRD_CY) - chh * 0.5 + (1 - pa) * 24;
    gfx_set(0.11, 0.115, 0.13, 1);
    fill_rr(cx0, cy0, cw, chh, 8);
    gfx_set(cr, cg, cb, 0.8);
    outline_rr(cx0, cy0, cw, chh, 8);
    font(26, 'b');
    gfx_set(cr, cg, cb, 1);
    txt_c(title, cx0, cy0 + 22, cw, 40);
    font(14, 0);
    gfx_set(0.82, 0.84, 0.88, 1);
    txt_c(#g_l1, cx0, cy0 + 72, cw, 24);
    font(12, 0);
    gfx_set(0.62, 0.64, 0.68, 1);
    txt_c(#g_l2, cx0, cy0 + 98, cw, 20);
    button(g_wcl == 1 ? "Next piece" : g_wcl == 2 ? "Next night" : g_wcl == 3 ? "Try again" : g_wcl == 4 ? "Run again" : "Next level", cx0 + 50, cy0 + 136, 160, 40, cr, cg, cb) ? r = 1;
    button("Games", cx0 + 226, cy0 + 136, 124, 40, cr, cg, cb) ? r = 2;
  );
  r;
);

function star_shape(px, py, r, rot) local(k, a0, a1, r0, r1)
(
  k = 0;
  loop(10,
    a0 = rot + k * $pi / 5;
    a1 = rot + (k + 1) * $pi / 5;
    r0 = k & 1 ? r * 0.45 : r;
    r1 = k & 1 ? r : r * 0.45;
    gfx_triangle(px, py, px + sin(a0) * r0, py - cos(a0) * r0, px + sin(a1) * r1, py - cos(a1) * r1);
    k += 1;
  );
);
