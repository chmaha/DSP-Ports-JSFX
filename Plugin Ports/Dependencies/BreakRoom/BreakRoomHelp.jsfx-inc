@init
// ==== How to play cards ====
function hl_g1(k)
(
  k == 0 ? "How to play Patch Bay" : k == 1 ? "Untangle the patch cables so that no two of them cross." :
  k == 2 ? "Stuck? Shuffle scrambles the jacks, New deals a fresh tangle of the same size." : k == 3 ? "Start over takes you back to level 1." :
  k == 10 ? "Drag the jacks" : k == 11 ? "Grab any jack and move it." : k == 12 ? "Its cables follow it around" : k == 13 ? "the bay." :
  k == 20 ? "Red rings cross" : k == 21 ? "A jack with a red ring has a" : k == 22 ? "cable crossing another one." : k == 23 ? "Start with those." :
  k == 30 ? "Clear every crossing" : k == 31 ? "When no cables cross, the level" : k == 32 ? "is solved. Each new level starts" : k == 33 ? "with one more crossing." :
  k == 50 ? 3 : k == 51 ? 22 : k == 52 ? 21 : k >= 50 ? 0 : "";
);

function hl_g2(k)
(
  k == 0 ? "How to play Slingshot" : k == 1 ? "Fling your probe round the planets and into the portal." :
  k == 2 ? "A faint ghost shows your last shot, so you can adjust a little each time." : k == 3 ? "New gives a fresh level, Start over goes back to level 1." :
  k == 10 ? "Pull back and let go" : k == 11 ? "Press anywhere and drag back to" : k == 12 ? "aim and set the power. Let go" : k == 13 ? "to launch." :
  k == 20 ? "Gravity bends the path" : k == 21 ? "Planets pull the probe towards" : k == 22 ? "them. From level 8, pulsars push" : k == 23 ? "it away. Curve round them." :
  k == 30 ? "Reach the portal" : k == 31 ? "Touch the portal's ring and it" : k == 32 ? "pulls you in. Stars on the way" : k == 33 ? "are a bonus." :
  k == 50 ? 3 : k == 51 ? 28 : k == 52 ? 20 : k >= 50 ? 0 : "";
);

function hl_g3(k)
(
  k == 0 ? "Koi Pond" : k == 1 ? "Feed the koi and watch them glide. There is nothing to win." :
  k == 2 ? "Your pond is remembered for next time." : k == 3 ? "" :
  k == 10 ? "Feed them" : k == 11 ? "Left-click the water to drop" : k == 12 ? "a pellet. The nearest koi" : k == 13 ? "come to eat it." :
  k == 20 ? "Make ripples" : k == 21 ? "Right-click, or right-drag" : k == 22 ? "through the water, to send" : k == 23 ? "ripples across the pond." :
  k == 30 ? "Day or night" : k == 31 ? "Add or take away koi with" : k == 32 ? "- and +, and switch between" : k == 33 ? "day and night." :
  k == 50 ? 1 : k == 51 ? 2 : k == 52 ? 28 : k >= 50 ? 0 : "";
);

function hl_g4(k)
(
  k == 0 ? "Pixel Garden" : k == 1 ? "Grow a little island garden that keeps growing in real time." :
  k == 2 ? "Hover over anything to see what it is and how long it has left to grow." : k == 3 ? "Day switches the sky. New garden clears the island so you can start again." :
  k == 10 ? "Plant and place" : k == 11 ? "Pick Flower, Tree, Mushroom or" : k == 12 ? "Decor at the top, then click a" : k == 13 ? "tile. Shovel clears a tile." :
  k == 20 ? "Water and wait" : k == 21 ? "Plants grow even while the" : k == 22 ? "window is closed. Watering" : k == 23 ? "doubles the speed for 3 minutes." :
  k == 30 ? "Visitors" : k == 31 ? "Bird feeders and birdbaths" : k == 32 ? "bring birds. Rain showers" : k == 33 ? "water everything for you." :
  k == 50 ? 1 : k == 51 ? 27 : k == 52 ? 32 : k >= 50 ? 0 : "";
);

function hl_g5(k)
(
  k == 0 ? "Rain Window" : k == 1 ? "Watch the rain run down the glass. There is nothing to win." :
  k == 2 ? "Sit back and listen. Keep an eye on the forest for visitors." : k == 3 ? "" :
  k == 10 ? "Wipe the mist" : k == 11 ? "Drag across the glass to wipe" : k == 12 ? "the mist away, or draw in it." : k == 13 ? "It slowly mists over again." :
  k == 20 ? "Change the view" : k == 21 ? "The first button at the top" : k == 22 ? "picks city at night, dusk" : k == 23 ? "or the forest." :
  k == 30 ? "Set the rain" : k == 31 ? "The second button sets light," : k == 32 ? "steady or heavy rain." : k == 33 ? "" :
  k == 50 ? 3 : k == 51 ? 28 : k == 52 ? 32 : k >= 50 ? 0 : "";
);

function hl_g6(k)
(
  k == 0 ? "Kintsugi" : k == 1 ? "Mend broken pottery with gold, one piece at a time." :
  k == 2 ? "There is no clock and no score. Take your time." : k == 3 ? "" :
  k == 10 ? "Drag the shards" : k == 11 ? "Pick up a shard and carry it" : k == 12 ? "to where it belongs on the" : k == 13 ? "vessel." :
  k == 20 ? "Close is close enough" : k == 21 ? "Drop it near its place and it" : k == 22 ? "settles in by itself, turning" : k == 23 ? "to fit." :
  k == 30 ? "Filled with gold" : k == 31 ? "Each crack fills with gold as" : k == 32 ? "it joins. Every new piece" : k == 33 ? "breaks into more shards." :
  k == 50 ? 3 : k == 51 ? 22 : k == 52 ? 20 : k >= 50 ? 0 : "";
);

function hl_g7(k)
(
  k == 0 ? "Firefly Shepherd" : k == 1 ? "Lead the fireflies home and light every lantern." :
  k == 2 ? "Each night has its own sky. Stay and watch the lanterns drift away." : k == 3 ? "" :
  k == 10 ? "Move your light" : k == 11 ? "The fireflies follow your" : k == 12 ? "light, lazily, around the" : k == 13 ? "meadow." :
  k == 20 ? "Call them closer" : k == 21 ? "Hold the mouse button to call" : k == 22 ? "them in tight. Let go and" : k == 23 ? "they spread out again." :
  k == 30 ? "Fill the lanterns" : k == 31 ? "Hover your light over a lantern" : k == 32 ? "to let them in. When it is full" : k == 33 ? "it lights up and floats away." :
  k == 50 ? 5 : k == 51 ? 4 : k == 52 ? 30 : k >= 50 ? 0 : "";
);

function hl_g8(k)
(
  k == 0 ? "How to play Signal Path" : k == 1 ? "Turn the tiles to send the signal to every speaker." :
  k == 2 ? "New deals a fresh board, Start over goes back to level 1." : k == 3 ? "" :
  k == 10 ? "Turn the tiles" : k == 11 ? "Click a tile to turn it" : k == 12 ? "clockwise. Right-click turns" : k == 13 ? "it back." :
  k == 20 ? "Feed every speaker" : k == 21 ? "The signal starts at the input" : k == 22 ? "box. Join the cables so it" : k == 23 ? "reaches every speaker." :
  k == 30 ? "Beat the par" : k == 31 ? "Solve it within the par" : k == 32 ? "number of turns for a" : k == 33 ? "perfect routing." :
  k == 50 ? 1 : k == 60 ? 2 : k == 51 ? 22 : k == 52 ? 21 : k >= 50 ? 0 : "";
);

function hl_g9(k)
(
  k == 0 ? "How to play Peggy" : k == 1 ? "Bounce balls through the pegs and clear every red one." :
  k == 2 ? "Every red you clear heats the gauge on the right: points go x2, x3, x5, then x10. Gold pegs score big." : k == 3 ? "Shift with the arrows aims finely. Enter goes on to the next level." :
  k == 10 ? "Aim and drop" : k == 11 ? "Click to drop a ball, or aim" : k == 12 ? "with the left and right arrows" : k == 13 ? "and press Down or Enter." :
  k == 20 ? "Clear the reds" : k == 21 ? "Hit every red peg before your" : k == 22 ? "balls run out. Pegs you hit" : k == 23 ? "vanish once the ball is gone." :
  k == 30 ? "Catch a free ball" : k == 31 ? "Land the ball in the catcher" : k == 32 ? "sliding along the bottom to" : k == 33 ? "get the ball back." :
  k == 50 ? 1 : k == 60 ? 10 : k == 51 ? 22 : k == 52 ? 20 : k >= 50 ? 0 : "";
);

function hl_g11(k)
(
  k == 0 ? "How to play Bubble and Squeak" : k == 1 ? "Pop the bubbles and free every trapped mouse." :
  k == 2 ? "The power jar fills as you pop. When it is full, your next shot is special." : k == 3 ? "Swap shots with right-click, Down or the acorn. Enter goes on to the next level." :
  k == 10 ? "Aim and shoot" : k == 11 ? "Aim with the mouse or the left" : k == 12 ? "and right arrows. Click, Up or" : k == 13 ? "Enter shoots." :
  k == 20 ? "Three in a row" : k == 21 ? "Three or more of one colour" : k == 22 ? "pop, and anything left hanging" : k == 23 ? "falls. Bombs clear even more." :
  k == 30 ? "Free the mice" : k == 31 ? "Pop or drop every bubble with" : k == 32 ? "a mouse inside before your" : k == 33 ? "shots run out." :
  k == 50 ? 1 : k == 60 ? 10 : k == 51 ? 22 : k == 52 ? 26 : k >= 50 ? 0 : "";
);

function hl_g12(k)
(
  k == 0 ? "How to play Krypton Gigablast" : k == 1 ? "Blast through five alien worlds and the bosses that guard them." :
  k == 2 ? "Walls can crush you against the bottom of the screen. Hover beside a green wall charger to refill energy." : k == 3 ? "Enter leaves the shop and goes on from the cards." :
  k == 10 ? "Fly and fire" : k == 11 ? "Steer with the mouse and hold" : k == 12 ? "the button to fire, or steer" : k == 13 ? "with the arrows and hold S." :
  k == 20 ? "Smart bomb" : k == 21 ? "Right-click or press D to" : k == 22 ? "wipe out everything on" : k == 23 ? "screen. Bombs are limited." :
  k == 30 ? "Spend your credits" : k == 31 ? "Collect credits and spend them" : k == 32 ? "on weapons in the shop halfway" : k == 33 ? "through, and after each boss." :
  k == 50 ? 4 : k == 60 ? 10 : k == 51 ? 2 : k == 61 ? 12 : k == 81 ? "D" : k == 52 ? 24 : k >= 50 ? 0 : "";
);

function hl_g13(k)
(
  k == 0 ? "How to play Flop House" : k == 1 ? "No-limit Texas Hold'em against a table of rogues." :
  k == 2 ? "Coach gives advice on each decision. Read tokens show how strong a hand really is." : k == 3 ? "Hands shows the poker hands from best to worst. Rogues shows who you have met." :
  k == 10 ? "Play your hand" : k == 11 ? "Fold, call or raise with the" : k == 12 ? "buttons. The mouse wheel" : k == 13 ? "changes your raise." :
  k == 20 ? "Read the table" : k == 21 ? "Click a face to see that" : k == 22 ? "player's file. Watch for tells:" : k == 23 ? "some give their hand away." :
  k == 30 ? "Climb the ladder" : k == 31 ? "Take every chip to win the" : k == 32 ? "table and move on to tougher" : k == 33 ? "players and venues." :
  k == 50 ? 1 : k == 60 ? 6 : k == 51 ? 29 : k == 52 ? 25 : k >= 50 ? 0 : "";
);

function hl_g14(k)
(
  k == 0 ? "How to play Hold Your Horses" : k == 1 ? "Run a racing stable, or just have a bet, at every real British course." :
  k == 2 ? "Racing dates follow today's real fixtures, or pick a random racing day. Records keeps your wins." : k == 3 ? "Mouse only. The line at the bottom of each screen says what it does." :
  k == 10 ? "Career" : k == 11 ? "Run a yard through the real" : k == 12 ? "racing year: buy at the Sales," : k == 13 ? "train, enter on the Calendar." :
  k == 20 ? "A Day at the Races" : k == 21 ? "Bet every race with a fresh" : k == 22 ? "500 pounds, on a whole day" : k == 23 ? "or a single one-off race." :
  k == 30 ? "Watch them run" : k == 31 ? "Follow your horse, bet win or" : k == 32 ? "each way, and in your career," : k == 33 ? "ride your own horse yourself." :
  k == 50 ? 21 : k == 51 ? 24 : k == 52 ? 33 : k >= 50 ? 0 : "";
);

function hl_g15(k)
(
  k == 0 ? "How to play Hop to It" : k == 1 ? "Hop as far as you can without getting squashed." :
  k == 2 ? "Two players: Player 1 hops with W A S D, Player 2 with the arrows." : k == 3 ? "Pick any world and hopper before you start. Enter hops again after a crash." :
  k == 10 ? "Hop" : k == 11 ? "Arrow keys or W A S D hop one" : k == 12 ? "tile. You can also click the" : k == 13 ? "way you want to go." :
  k == 20 ? "Watch out" : k == 21 ? "Dodge cars and trains and ride" : k == 22 ? "the logs over rivers. Every" : k == 23 ? "world has its own hazard." :
  k == 30 ? "Keep moving" : k == 31 ? "Stand still too long, or fall" : k == 32 ? "too far behind, and the eagle" : k == 33 ? "swoops down." :
  k == 50 ? 10 : k == 60 ? 1 : k == 51 ? 22 : k == 52 ? 23 : k >= 50 ? 0 : "";
);

function hl_get(s, k)
(
  s == 1 ? hl_g1(k) : s == 2 ? hl_g2(k) : s == 3 ? hl_g3(k) : s == 4 ? hl_g4(k) : s == 5 ? hl_g5(k) : s == 6 ? hl_g6(k) :
  s == 7 ? hl_g7(k) : s == 8 ? hl_g8(k) : s == 9 ? hl_g9(k) : s == 11 ? hl_g11(k) : s == 12 ? hl_g12(k) : s == 13 ? hl_g13(k) :
  s == 14 ? hl_g14(k) : s == 15 ? hl_g15(k) : k >= 50 ? 0 : "";
);

// ==== Icons ====
function hl_mouse(cx, cy, b, pr) local(x, y)
(
  x = cx - 22; y = cy - 34;
  gfx_set(0.09, 0.095, 0.11, 1); fill_rr(x + 3, y + 5, 44, 68, 20);
  gfx_set(0.78, 0.8, 0.85, 1); fill_rr(x, y, 44, 68, 20);
  gfx_set(0.9, 0.92, 0.95, 1); fill_rr(x + 3, y + 3, 38, 30, 16);
  b == 1 || b == 2 ? (
    gfx_set(0.97 + 0.03 * pr, 0.86 - 0.02 * pr, 0.55 - 0.25 * pr, 1);
    b == 1 ? ( fill_rr(x + 3, y + 3, 19, 26, 14); gfx_rect(sx(x + 12), sy(y + 14), 10 * g_s, 15 * g_s); gfx_rect(sx(x + 3), sy(y + 18), 10 * g_s, 11 * g_s); )
           : ( fill_rr(x + 22, y + 3, 19, 26, 14); gfx_rect(sx(x + 22), sy(y + 14), 10 * g_s, 15 * g_s); gfx_rect(sx(x + 31), sy(y + 18), 10 * g_s, 11 * g_s); );
  );
  gfx_set(0.45, 0.47, 0.52, 1);
  gfx_rect(sx(x + 21.5), sy(y + 2), max(1, 1.2 * g_s), 28 * g_s);
  gfx_rect(sx(x + 3), sy(y + 29), 38 * g_s, max(1, 1.2 * g_s));
  gfx_set(b == 3 ? 1 : 0.4, b == 3 ? 0.84 : 0.42, b == 3 ? 0.3 : 0.47, 1); fill_rr(x + 18.5, y + 9, 7, 13, 3.5);
  gfx_set(0.55, 0.57, 0.62, 1); outline_rr(x, y, 44, 68, 20);
);

function hl_arrowhead(x, y, a, r)
(
  gfx_triangle(sx(x + cos(a) * r), sy(y + sin(a) * r), sx(x + cos(a + 2.5) * r), sy(y + sin(a + 2.5) * r), sx(x + cos(a - 2.5) * r), sy(y + sin(a - 2.5) * r));
);

function hl_cap(x, y, w, lbl, lit) local(h)
(
  h = 26;
  gfx_set(0.07, 0.075, 0.09, 1); fill_rr(x, y + 3, w, h, 5);
  lit ? gfx_set(1, 0.84, 0.3, 1) : gfx_set(0.34, 0.35, 0.39, 1);
  fill_rr(x, y, w, h, 5);
  lit ? gfx_set(0.15, 0.12, 0.05, 1) : gfx_set(0.95, 0.96, 0.98, 1);
  font(13, 'b');
  lbl ? txt_c(lbl, x, y, w, h);
);

function hl_keyarrow(x, y, a, lit)
(
  lit ? gfx_set(0.15, 0.12, 0.05, 1) : gfx_set(0.95, 0.96, 0.98, 1);
  x += 13; y += 13;
  gfx_triangle(sx(x + cos(a) * 7), sy(y + sin(a) * 7), sx(x + cos(a + 2.0944) * 6), sy(y + sin(a + 2.0944) * 6), sx(x + cos(a - 2.0944) * 6), sy(y + sin(a - 2.0944) * 6));
);

function hl_icon(c, cx, cy, lbl) local(k, a, r, x, y, t, p)
(
  t = g_t; p = 0.5 + 0.5 * sin(t * 5);
  c == 1 || c == 2 ? (
    hl_mouse(cx, cy + 4, c, (t * 1.2 - floor(t * 1.2)) < 0.35);
    k = (t * 1.2 - floor(t * 1.2)) * 2.4;
    k < 1 ? ( gfx_set(1, 0.84, 0.3, (1 - k) * 0.8); gfx_circle(sx(cx + (c == 1 ? -10 : 10)), sy(cy - 22), (6 + k * 18) * g_s, 0, 1); );
  ) : c == 3 ? (
    k = t * 0.6 - floor(t * 0.6);
    x = cx - 30 + 46 * min(1, k * 1.6);
    gfx_set(1, 0.84, 0.3, 0.7); aa_tline(sx(cx - 54), sy(cy + 30), sx(x - 6), sy(cy + 30), 2.4 * g_s);
    hl_arrowhead(x, cy + 30, 0, 7);
    hl_mouse(x - 4, cy - 2, 1, 1);
  ) : c == 4 ? (
    hl_mouse(cx, cy + 4, 1, 1);
    k = 0; loop(3, r = (t * 0.8 + k / 3) - floor(t * 0.8 + k / 3); gfx_set(1, 0.84, 0.3, (1 - r) * 0.7); gfx_circle(sx(cx - 10), sy(cy - 22), (8 + r * 30) * g_s, 0, 1); k += 1; );
  ) : c == 5 ? (
    a = t * 0.9; x = cx + cos(a) * 10; y = cy + sin(a * 2) * 5;
    gfx_set(1, 0.84, 0.3, 0.8);
    k = 0; loop(4, hl_arrowhead(x + cos(k * $pi * 0.5) * 44, y + 4 + sin(k * $pi * 0.5) * 48, k * $pi * 0.5, 7); k += 1; );
    hl_mouse(x, y + 4, 0, 0);
  ) : c == 6 ? (
    hl_mouse(cx, cy + 4, 3, 1);
    gfx_set(1, 0.84, 0.3, 0.6 + 0.4 * p);
    hl_arrowhead(cx + 34, cy - 30, -$pi * 0.5, 8); hl_arrowhead(cx + 34, cy - 4, $pi * 0.5, 8);
  ) : c == 10 ? (
    k = floor(t * 1.5) % 4;
    x = cx - 41; y = cy - 28;
    hl_cap(x + 29, y, 26, 0, k == 0); hl_cap(x, y + 30, 26, 0, k == 1); hl_cap(x + 29, y + 30, 26, 0, k == 3); hl_cap(x + 58, y + 30, 26, 0, k == 2);
    hl_keyarrow(x + 29, y, -$pi * 0.5, k == 0); hl_keyarrow(x, y + 30, $pi, k == 1); hl_keyarrow(x + 58, y + 30, 0, k == 2); hl_keyarrow(x + 29, y + 30, $pi * 0.5, k == 3);
  ) : c == 11 ? (
    x = cx - 41; y = cy - 28;
    k = floor(t * 1.5) % 4;
    hl_cap(x + 29, y, 26, "W", k == 0); hl_cap(x, y + 30, 26, "A", k == 1); hl_cap(x + 29, y + 30, 26, "S", k == 3); hl_cap(x + 58, y + 30, 26, "D", k == 2);
  ) : c == 12 ? (
    hl_cap(cx - 20, cy - 13, 40, lbl, (t * 1.2 - floor(t * 1.2)) < 0.35);
  ) : c == 20 ? (
    gfx_set(1, 0.84, 0.3, 0.18 + 0.12 * p); gfx_circle(sx(cx), sy(cy), 42 * g_s, 1, 1);
    gfx_set(0.85, 0.6, 0.1, 1); star_shape(sx(cx), sy(cy + 2), 36 * g_s, 0);
    gfx_set(1, 0.84, 0.3, 1); star_shape(sx(cx), sy(cy), 34 * g_s, 0);
    gfx_set(1, 0.95, 0.7, 1); star_shape(sx(cx - 3), sy(cy - 4), 12 * g_s, 0);
  ) : c == 21 ? (
    gfx_set(0.85, 0.6, 0.1, 1); fill_rr(cx - 24, cy + 30, 48, 10, 3); fill_rr(cx - 6, cy + 10, 12, 22, 2);
    gfx_set(0.85, 0.6, 0.1, 1); gfx_circle(sx(cx - 29), sy(cy - 22), 11 * g_s, 1, 1); gfx_circle(sx(cx + 29), sy(cy - 22), 11 * g_s, 1, 1);
    gfx_set(0.145, 0.15, 0.17, 1); gfx_circle(sx(cx - 29), sy(cy - 22), 6 * g_s, 1, 1); gfx_circle(sx(cx + 29), sy(cy - 22), 6 * g_s, 1, 1);
    gfx_set(1, 0.8, 0.25, 1);
    gfx_circle(sx(cx), sy(cy - 14), 26 * g_s, 1, 1);
    gfx_set(0.145, 0.15, 0.17, 1); gfx_rect(sx(cx - 27), sy(cy - 44), 54 * g_s, 20 * g_s);
    gfx_set(1, 0.8, 0.25, 1); fill_rr(cx - 27, cy - 32, 54, 9, 3);
    gfx_set(1, 0.95, 0.7, 0.8); gfx_circle(sx(cx - 9), sy(cy - 22), 5 * g_s, 1, 1);
  ) : c == 22 ? (
    k = 0; loop(4, gfx_set(k & 1 ? 0.95 : 1, k & 1 ? 0.95 : 0.35, k & 1 ? 0.95 : 0.3, 1); gfx_circle(sx(cx), sy(cy), (40 - k * 10) * g_s, 1, 1); k += 1; );
    gfx_set(1, 0.84, 0.3, 0.5 * p); gfx_circle(sx(cx), sy(cy), (42 + 4 * p) * g_s, 0, 1);
  ) : c == 23 ? (
    gfx_set(0.95, 0.96, 0.98, 1); gfx_circle(sx(cx), sy(cy), 38 * g_s, 1, 1);
    gfx_set(0.3, 0.31, 0.35, 1); gfx_circle(sx(cx), sy(cy), 38 * g_s, 0, 1);
    k = 0; loop(12, a = k * $pi / 6; gfx_set(0.3, 0.31, 0.35, 1); gfx_circle(sx(cx + cos(a) * 31), sy(cy + sin(a) * 31), 2 * g_s, 1, 1); k += 1; );
    a = t * 0.5; aa_tline(sx(cx), sy(cy), sx(cx + sin(a) * 26), sy(cy - cos(a) * 26), 2.4 * g_s);
    a = t * 0.04; aa_tline(sx(cx), sy(cy), sx(cx + sin(a) * 17), sy(cy - cos(a) * 17), 3.6 * g_s);
    gfx_set(1, 0.4, 0.35, 1); gfx_circle(sx(cx), sy(cy), 4 * g_s, 1, 1);
  ) : c == 24 ? (
    k = 0; loop(5, gfx_set(0.75, 0.52, 0.1, 1); gfx_circle(sx(cx - 14), sy(cy + 26 - k * 9), 20 * g_s, 1, 1); gfx_set(1, 0.8, 0.25, 1); gfx_circle(sx(cx - 14), sy(cy + 23 - k * 9), 20 * g_s, 1, 1); k += 1; );
    k = 0; loop(3, gfx_set(0.75, 0.52, 0.1, 1); gfx_circle(sx(cx + 22), sy(cy + 26 - k * 9), 20 * g_s, 1, 1); gfx_set(1, 0.8, 0.25, 1); gfx_circle(sx(cx + 22), sy(cy + 23 - k * 9), 20 * g_s, 1, 1); k += 1; );
    gfx_set(0.85, 0.6, 0.12, 1); gfx_circle(sx(cx + 22), sy(cy + 5), 13 * g_s, 0, 1); gfx_circle(sx(cx - 14), sy(cy - 13), 13 * g_s, 0, 1);
  ) : c == 25 ? (
    k = 0; loop(2,
      x = cx - 30 + k * 26; y = cy - 36 + k * 6;
      gfx_set(0.09, 0.095, 0.11, 1); fill_rr(x + 3, y + 4, 44, 64, 5);
      gfx_set(0.97, 0.97, 0.95, 1); fill_rr(x, y, 44, 64, 5);
      gfx_set(0.6, 0.6, 0.62, 1); outline_rr(x, y, 44, 64, 5);
      gfx_set(k ? 0.85 : 0.12, k ? 0.15 : 0.12, k ? 0.15 : 0.14, 1);
      font(16, 'b'); txt_c("A", x + 2, y + 2, 16, 18);
      k ? ( gfx_circle(sx(x + 18), sy(y + 34), 7 * g_s, 1, 1); gfx_circle(sx(x + 28), sy(y + 34), 7 * g_s, 1, 1); gfx_triangle(sx(x + 11), sy(y + 37), sx(x + 35), sy(y + 37), sx(x + 23), sy(y + 50)); )
        : ( gfx_circle(sx(x + 22), sy(y + 30), 7 * g_s, 1, 1); gfx_circle(sx(x + 16), sy(y + 38), 7 * g_s, 1, 1); gfx_circle(sx(x + 28), sy(y + 38), 7 * g_s, 1, 1); gfx_rect(sx(x + 20), sy(y + 38), 4 * g_s, 12 * g_s); );
      k += 1;
    );
  ) : c == 26 ? (
    r = 1 + 0.06 * p;
    gfx_set(1, 0.4, 0.45, 1);
    gfx_circle(sx(cx - 15 * r), sy(cy - 10), 19 * r * g_s, 1, 1); gfx_circle(sx(cx + 15 * r), sy(cy - 10), 19 * r * g_s, 1, 1);
    gfx_triangle(sx(cx - 33 * r), sy(cy - 3), sx(cx + 33 * r), sy(cy - 3), sx(cx), sy(cy + 34 * r));
    gfx_set(1, 0.8, 0.82, 0.8); gfx_circle(sx(cx - 20), sy(cy - 16), 6 * g_s, 1, 1);
  ) : c == 27 ? (
    gfx_set(0.45, 0.3, 0.2, 1); fill_rr(cx - 34, cy + 22, 68, 18, 6);
    gfx_set(0.35, 0.75, 0.35, 1); aa_tline(sx(cx), sy(cy + 24), sx(cx), sy(cy - 14), 4 * g_s);
    k = 0; loop(2,
      a = k ? 1 : -1;
      x = cx + a * 20; y = cy - 18 - 4 * p;
      gfx_set(0.45, 0.85, 0.4, 1);
      gfx_circle(sx(x), sy(y), 13 * g_s, 1, 1);
      gfx_triangle(sx(cx), sy(cy - 8), sx(x - a * 2), sy(y - 12), sx(x - a * 2), sy(y + 12));
      k += 1;
    );
    gfx_set(0.4, 0.75, 1, 0.8); k = 0; loop(3, r = (t * 1.3 + k / 3) - floor(t * 1.3 + k / 3); gfx_circle(sx(cx + 30 - k * 8), sy(cy - 40 + r * 56), 3 * g_s, 1, 1); k += 1; );
  ) : c == 28 ? (
    gfx_set(0.95, 0.9, 0.7, 0.15 + 0.1 * p); gfx_circle(sx(cx), sy(cy), 44 * g_s, 1, 1);
    gfx_set(0.97, 0.94, 0.8, 1); gfx_circle(sx(cx), sy(cy), 34 * g_s, 1, 1);
    gfx_set(0.145, 0.15, 0.17, 1); gfx_circle(sx(cx + 16), sy(cy - 10), 30 * g_s, 1, 1);
    gfx_set(1, 1, 0.9, 0.8); gfx_circle(sx(cx + 30), sy(cy + 26), 2 * g_s, 1, 1); gfx_circle(sx(cx + 38), sy(cy - 30), 1.5 * g_s, 1, 1);
  ) : c == 29 ? (
    r = 0.6 + 0.4 * min(1, abs(sin(t * 0.7)) * 8);
    gfx_set(0.95, 0.96, 0.98, 1);
    k = 0; loop(24,
      a = k * $pi / 12;
      gfx_triangle(sx(cx), sy(cy), sx(cx + cos(a) * 46), sy(cy + sin(a) * 24 * abs(sin(a)) ^ 0.6 * r), sx(cx + cos(a + $pi / 12) * 46), sy(cy + sin(a + $pi / 12) * 24 * abs(sin(a + $pi / 12)) ^ 0.6 * r));
      k += 1;
    );
    x = cx + 6 * sin(t * 0.9);
    gfx_set(0.3, 0.6, 0.85, 1); gfx_circle(sx(x), sy(cy), 15 * g_s, 1, 1);
    gfx_set(0.05, 0.05, 0.07, 1); gfx_circle(sx(x), sy(cy), 7 * g_s, 1, 1);
    gfx_set(1, 1, 1, 1); gfx_circle(sx(x - 5), sy(cy - 5), 3 * g_s, 1, 1);
  ) : c == 30 ? (
    gfx_set(1, 0.75, 0.3, 0.12 + 0.12 * p); gfx_circle(sx(cx), sy(cy), 40 * g_s, 1, 1);
    gfx_set(0.3, 0.2, 0.15, 1); aa_tline(sx(cx), sy(cy - 46), sx(cx), sy(cy - 32), 2 * g_s);
    gfx_set(0.9, 0.3, 0.2, 1); fill_rr(cx - 26, cy - 32, 52, 64, 18);
    a = 0.55 + 0.35 * p; gfx_set(0.9 + 0.1 * a, 0.3 + 0.4 * a, 0.2 + 0.1 * a, 1); fill_rr(cx - 18, cy - 26, 36, 52, 14);
    gfx_set(0.55, 0.15, 0.1, 1); k = -1; loop(3, aa_tline(sx(cx + k * 12), sy(cy - 30), sx(cx + k * 12), sy(cy + 30), 1.4 * g_s); k += 1; );
    gfx_set(0.25, 0.2, 0.18, 1); fill_rr(cx - 14, cy - 36, 28, 7, 2); fill_rr(cx - 14, cy + 30, 28, 7, 2);
  ) : c == 31 ? (
    gfx_set(0.12, 0.12, 0.14, 1); gfx_circle(sx(cx - 4), sy(cy + 6), 30 * g_s, 1, 1);
    gfx_set(0.35, 0.36, 0.4, 1); gfx_circle(sx(cx - 14), sy(cy - 4), 8 * g_s, 1, 1);
    gfx_set(0.6, 0.62, 0.66, 1); fill_rr(cx + 12, cy - 30, 14, 12, 3);
    gfx_set(1, 0.84, 0.3, 0.6 + 0.4 * p); gfx_circle(sx(cx + 26), sy(cy - 36), (5 + 3 * p) * g_s, 1, 1);
  ) : c == 32 ? (
    k = 0; loop(3,
      x = cx - 26 + k * 26; r = (t * 0.8 + k * 0.37) - floor(t * 0.8 + k * 0.37); y = cy - 30 + r * 40 + (k == 1 ? -8 : 0);
      gfx_set(0.45, 0.75, 1, 1 - r * 0.6);
      gfx_circle(sx(x), sy(y + 8), 10 * g_s, 1, 1);
      gfx_triangle(sx(x - 9.5), sy(y + 5), sx(x + 9.5), sy(y + 5), sx(x), sy(y - 14));
      k += 1;
    );
  ) : c == 33 ? (
    gfx_set(0.95, 0.96, 0.98, 1); fill_rr(cx - 36, cy - 30, 72, 66, 6);
    gfx_set(0.9, 0.3, 0.25, 1); fill_rr(cx - 36, cy - 30, 72, 18, 6); gfx_rect(sx(cx - 36), sy(cy - 18), 72 * g_s, 6 * g_s);
    gfx_set(0.3, 0.31, 0.35, 1); fill_rr(cx - 22, cy - 38, 6, 14, 3); fill_rr(cx + 16, cy - 38, 6, 14, 3);
    k = 0; loop(12, x = cx - 28 + (k % 4) * 16; y = cy - 4 + floor(k / 4) * 13; gfx_set(k == 6 ? 1 : 0.7, k == 6 ? 0.84 : 0.72, k == 6 ? 0.3 : 0.76, 1); fill_rr(x, y, 10, 8, 2); k += 1; );
  );
);

// ==== Card ====
function hl_panel(s, i, px, py) local(ia, ib, cx, cy)
(
  gfx_set(0.145, 0.15, 0.17, 1);
  fill_rr(px, py, 236, 270, 8);
  gfx_set(0.26, 0.27, 0.3, 1);
  outline_rr(px, py, 236, 270, 8);
  gfx_set(1, 0.84, 0.3, 1);
  gfx_circle(sx(px + 24), sy(py + 24), 12 * g_s, 1, 1);
  font(13, 'b');
  gfx_set(0.12, 0.1, 0.05, 1);
  txt_c(i == 0 ? "1" : i == 1 ? "2" : "3", px + 12, py + 12, 24, 24);
  font(14, 'b');
  gfx_set(0.95, 0.96, 0.98, 1);
  txt_l(hl_get(s, 10 + i * 10), px + 44, py + 14);
  ia = hl_get(s, 50 + i); ib = hl_get(s, 60 + i);
  cy = py + 108;
  ib ? (
    hl_icon(ia, px + 60, cy, hl_get(s, 70 + i));
    font(12, 'b'); gfx_set(0.62, 0.64, 0.68, 1); txt_c("or", px + 106, cy - 10, 24, 20);
    hl_icon(ib, px + 176, cy, hl_get(s, 80 + i));
  ) : hl_icon(ia, px + 118, cy, hl_get(s, 70 + i));
  font(12, 0);
  gfx_set(0.78, 0.8, 0.84, 1);
  txt_c(hl_get(s, 11 + i * 10), px, py + 176, 236, 18);
  txt_c(hl_get(s, 12 + i * 10), px, py + 194, 236, 18);
  txt_c(hl_get(s, 13 + i * 10), px, py + 212, 236, 18);
);

function hl_card(s) local(x0, y0, i, r)
(
  r = 0;
  x0 = 60; y0 = 120;
  gfx_set(0.11, 0.115, 0.13, 1);
  fill_rr(x0, y0, 780, 476, 10);
  gfx_set(0.4, 0.95, 0.78, 0.8);
  outline_rr(x0, y0, 780, 476, 10);
  font(24, 'b');
  gfx_set(0.4, 0.95, 0.78, 1);
  txt_c(hl_get(s, 0), x0, y0 + 16, 780, 36);
  font(13, 0);
  gfx_set(0.82, 0.84, 0.88, 1);
  txt_c(hl_get(s, 1), x0, y0 + 54, 780, 22);
  i = 0;
  loop(3, hl_panel(s, i, x0 + 22 + i * 250, y0 + 92); i += 1; );
  font(12, 0);
  gfx_set(0.62, 0.64, 0.68, 1);
  txt_c(hl_get(s, 2), x0, y0 + 372, 780, 18);
  txt_c(hl_get(s, 3), x0, y0 + 390, 780, 18);
  button("Got it", 450 - 80, y0 + 422, 160, 40, 0.4, 0.95, 0.78) ? r = 1;
  font(11, 0); gfx_set(0.5, 0.52, 0.56, 1);
  txt_c("The ? button brings this back.", x0 + 560, y0 + 432, 200, 20);
  r;
);
