  tmp = (x * (-a1)) + gw_za0; gw_za0 = (tmp * a1) + x; gw_o0 = tmp;
  x = gw_bb0[rd]; x = (gw_lb0 * gw_fpi) + (gw_fci * x); gw_lb0 = x; x *= gw_gi;
