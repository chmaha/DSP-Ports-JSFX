@init

SWH_FIX = 1;

function swh_alloc(n) local(r) global(swh_mp) (
  r = swh_mp; swh_mp += n; memset(r, 0, n); r;
);

function swh_db_co(g) ( g > -90 ? 10 ^ (g * 0.05) : 0; );

function gw_init() (
  swh_mp = GW_MEM;
  swh_sr = srate;
  gw_msi = (swh_sr * 0.03643242) | 0;
  gw_mso = (swh_sr * 0.05722782) | 0;
  gw_s0 = gw_msi; gw_d0 = gw_msi; gw_ba0 = swh_alloc(gw_msi); gw_bb0 = swh_alloc(gw_msi); gw_p0 = 0;
  gw_la0 = 0; gw_lb0 = 0; gw_za0 = 0; gw_zb0 = 0; gw_aa0 = 1; gw_ab0 = 1;
  gw_s1 = gw_msi; gw_d1 = gw_msi; gw_ba1 = swh_alloc(gw_msi); gw_bb1 = swh_alloc(gw_msi); gw_p1 = 0;
  gw_la1 = 0; gw_lb1 = 0; gw_za1 = 0; gw_zb1 = 0; gw_aa1 = 1; gw_ab1 = 1;
  gw_s2 = gw_msi; gw_d2 = gw_msi; gw_ba2 = swh_alloc(gw_msi); gw_bb2 = swh_alloc(gw_msi); gw_p2 = 0;
  gw_la2 = 0; gw_lb2 = 0; gw_za2 = 0; gw_zb2 = 0; gw_aa2 = 1; gw_ab2 = 1;
  gw_s3 = gw_msi; gw_d3 = gw_msi; gw_ba3 = swh_alloc(gw_msi); gw_bb3 = swh_alloc(gw_msi); gw_p3 = 0;
  gw_la3 = 0; gw_lb3 = 0; gw_za3 = 0; gw_zb3 = 0; gw_aa3 = 1; gw_ab3 = 1;
  gw_s4 = gw_mso; gw_d4 = gw_mso; gw_ba4 = swh_alloc(gw_mso); gw_bb4 = swh_alloc(gw_mso); gw_p4 = 0;
  gw_la4 = 0; gw_lb4 = 0; gw_za4 = 0; gw_zb4 = 0; gw_aa4 = 1; gw_ab4 = 1;
  gw_s5 = gw_mso; gw_d5 = gw_mso; gw_ba5 = swh_alloc(gw_mso); gw_bb5 = swh_alloc(gw_mso); gw_p5 = 0;
  gw_la5 = 0; gw_lb5 = 0; gw_za5 = 0; gw_zb5 = 0; gw_aa5 = 1; gw_ab5 = 1;
  gw_s6 = gw_mso; gw_d6 = gw_mso; gw_ba6 = swh_alloc(gw_mso); gw_bb6 = swh_alloc(gw_mso); gw_p6 = 0;
  gw_la6 = 0; gw_lb6 = 0; gw_za6 = 0; gw_zb6 = 0; gw_aa6 = 1; gw_ab6 = 1;
  gw_s7 = gw_mso; gw_d7 = gw_mso; gw_ba7 = swh_alloc(gw_mso); gw_bb7 = swh_alloc(gw_mso); gw_p7 = 0;
  gw_la7 = 0; gw_lb7 = 0; gw_za7 = 0; gw_zb7 = 0; gw_aa7 = 1; gw_ab7 = 1;
  gw_o0 = 0; gw_o1 = 0; gw_o2 = 0; gw_o3 = 0; gw_o4 = 0; gw_o5 = 0; gw_o6 = 0; gw_o7 = 0; gw_o8 = 0; gw_o9 = 0; gw_o10 = 0; gw_o11 = 0; gw_o12 = 0; gw_o13 = 0; gw_o14 = 0; gw_o15 = 0;
  gw_bx = 0.5; gw_by = 0; gw_bxm = 0.5; gw_bym = 0; gw_brun = 0; gw_blvl = 0; gw_fs = swh_sr;
  gw_sleep = 0; gw_qn = 0;
  gw_used = swh_mp - GW_MEM;
);

function gw_block() local(d) (
  gw_lpi = 1 - (inner_damp * 0.1423);
  gw_lpo = 1 - (outer_damp * 0.19543);
  d = (gw_msi * size1) | 0; gw_d0 = d > gw_s0 ? gw_s0 : d < 1 ? 1 : d;
  gw_aa0 = (1 - stiff_p1) / (1 + stiff_p1); gw_ab0 = (1 - stiff_m1) / (1 + stiff_m1);
  d = (gw_msi * size2) | 0; gw_d1 = d > gw_s1 ? gw_s1 : d < 1 ? 1 : d;
  gw_aa1 = (1 - stiff_p2) / (1 + stiff_p2); gw_ab1 = (1 - stiff_m2) / (1 + stiff_m2);
  d = (gw_msi * size3) | 0; gw_d2 = d > gw_s2 ? gw_s2 : d < 1 ? 1 : d;
