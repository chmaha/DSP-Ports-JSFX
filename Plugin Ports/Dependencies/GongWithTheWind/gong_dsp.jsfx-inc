  memset(gw_ba5, 0, gw_s5); memset(gw_bb5, 0, gw_s5);
  gw_la5 = 0; gw_lb5 = 0; gw_za5 = 0; gw_zb5 = 0;
  memset(gw_ba6, 0, gw_s6); memset(gw_bb6, 0, gw_s6);
  gw_la6 = 0; gw_lb6 = 0; gw_za6 = 0; gw_zb6 = 0;
  memset(gw_ba7, 0, gw_s7); memset(gw_bb7, 0, gw_s7);
  gw_la7 = 0; gw_lb7 = 0; gw_za7 = 0; gw_zb7 = 0;
  gw_o0 = 0; gw_o1 = 0; gw_o2 = 0; gw_o3 = 0; gw_o4 = 0; gw_o5 = 0; gw_o6 = 0; gw_o7 = 0; gw_o8 = 0; gw_o9 = 0; gw_o10 = 0; gw_o11 = 0; gw_o12 = 0; gw_o13 = 0; gw_o14 = 0; gw_o15 = 0;
  gw_sleep = 1; gw_qn = 0;
);

function gw_tick(xin) local(a, b, bo, rd, x, a1, tmp, i0, i1) (
  gw_brun === 0 ? (
    a = abs(xin);
    a > 0.05 ? ( gw_brun = gw_rlen; gw_blvl = a; gw_bx = 0.5; gw_by = 0; gw_bxm = 0.5; gw_bym = 0; gw_hits += 1; gw_hitlvl = a; );
    bo = xin * gw_iamp;
  ) : (
    a = abs(xin); a > gw_blvl ? gw_blvl = a;
    gw_bx -= gw_om * gw_by; gw_by += gw_om * gw_bx;
    gw_bxm -= gw_om2 * gw_bym; gw_bym += gw_om2 * gw_bxm;
    bo = (xin * gw_iamp) + ((((gw_by * gw_samp) * gw_blvl) * 4) * gw_bym);
    gw_brun -= 1;
  );
  gw_al = ((((gw_o0 + gw_o2) + gw_o4) + gw_o6) * 0.5) + bo;
  gw_be = ((gw_o1 + gw_o9) + gw_o14) * 0.666666666666;
  gw_ga = ((gw_o3 + gw_o8) + gw_o11) * 0.666666666666;
  gw_de = ((gw_o5 + gw_o10) + gw_o13) * 0.666666666666;
