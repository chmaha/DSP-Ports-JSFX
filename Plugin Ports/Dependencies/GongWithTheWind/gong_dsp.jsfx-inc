  d = (gw_msi * size4) | 0; gw_d3 = d > gw_s3 ? gw_s3 : d < 1 ? 1 : d;
  gw_aa3 = (1 - stiff_p4) / (1 + stiff_p4); gw_ab3 = (1 - stiff_m4) / (1 + stiff_m4);
  d = (gw_mso * size5) | 0; gw_d4 = d > gw_s4 ? gw_s4 : d < 1 ? 1 : d;
  gw_aa4 = (1 - stiff_p5) / (1 + stiff_p5); gw_ab4 = (1 - stiff_m5) / (1 + stiff_m5);
  d = (gw_mso * size6) | 0; gw_d5 = d > gw_s5 ? gw_s5 : d < 1 ? 1 : d;
  gw_aa5 = (1 - stiff_p6) / (1 + stiff_p6); gw_ab5 = (1 - stiff_m6) / (1 + stiff_m6);
  d = (gw_mso * size7) | 0; gw_d6 = d > gw_s6 ? gw_s6 : d < 1 ? 1 : d;
  gw_aa6 = (1 - stiff_p7) / (1 + stiff_p7); gw_ab6 = (1 - stiff_m7) / (1 + stiff_m7);
  d = (gw_mso * size8) | 0; gw_d7 = d > gw_s7 ? gw_s7 : d < 1 ? 1 : d;
  gw_aa7 = (1 - stiff_p8) / (1 + stiff_p8); gw_ab7 = (1 - stiff_m8) / (1 + stiff_m8);
  gw_fci = gw_lpi; gw_fpi = 1 - gw_lpi; gw_gi = gw_lpi / (2 - gw_lpi);
  gw_fco = gw_lpo; gw_fpo = 1 - gw_lpo; gw_go = gw_lpo / (2 - gw_lpo);
  gw_mic = mic_pos; gw_mic1 = 1 - mic_pos;
  gw_iamp = swh_db_co(impulse_db); gw_samp = swh_db_co(strike_db);
  gw_om = 6.2831852 / (strike_s * gw_fs); gw_om2 = gw_om * 0.5; gw_rlen = (strike_s * gw_fs) | 0;
);

function gw_zero() (
  memset(gw_ba0, 0, gw_s0); memset(gw_bb0, 0, gw_s0);
  gw_la0 = 0; gw_lb0 = 0; gw_za0 = 0; gw_zb0 = 0;
