  x = gw_ba3[rd]; x = (gw_la3 * gw_fpi) + (gw_fci * x); gw_la3 = x; x *= gw_gi;
  b = (x + 1) * 6;
  a1 = b >= 1 ? gw_aa3 : b <= 0 ? gw_ab3 : (b * gw_aa3) + ((1 - b) * gw_ab3);
  tmp = (x * (-a1)) + gw_za3; gw_za3 = (tmp * a1) + x; gw_o6 = tmp;
  x = gw_bb3[rd]; x = (gw_lb3 * gw_fpi) + (gw_fci * x); gw_lb3 = x; x *= gw_gi;
  b = (x + 1) * 6;
  a1 = b >= 1 ? gw_aa3 : b <= 0 ? gw_ab3 : (b * gw_aa3) + ((1 - b) * gw_ab3);
  tmp = (x * (-a1)) + gw_zb3; gw_zb3 = (tmp * a1) + x; gw_o7 = tmp;
  gw_ba3[gw_p3] = i0; gw_bb3[gw_p3] = i1; gw_p3 -= 1; gw_p3 < 0 ? gw_p3 += gw_s3;
  rd = gw_p4 + gw_d4; rd >= gw_s4 ? rd -= gw_s4;
  i0 = gw_be - gw_o9; i1 = gw_ga - gw_o8;
  x = gw_ba4[rd]; x = (gw_la4 * gw_fpo) + (gw_fco * x); gw_la4 = x; x *= gw_go;
  b = (x + 1) * 6;
