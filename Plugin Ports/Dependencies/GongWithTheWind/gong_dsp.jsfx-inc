  rd = gw_p5 + gw_d5; rd >= gw_s5 ? rd -= gw_s5;
  i0 = gw_ga - gw_o11; i1 = gw_de - gw_o10;
  x = gw_ba5[rd]; x = (gw_la5 * gw_fpo) + (gw_fco * x); gw_la5 = x; x *= gw_go;
  b = (x + 1) * 6;
