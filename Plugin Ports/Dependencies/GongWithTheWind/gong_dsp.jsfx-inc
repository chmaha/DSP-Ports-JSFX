  gw_ba1[gw_p1] = i0; gw_bb1[gw_p1] = i1; gw_p1 -= 1; gw_p1 < 0 ? gw_p1 += gw_s1;
  rd = gw_p2 + gw_d2; rd >= gw_s2 ? rd -= gw_s2;
  i0 = gw_de - gw_o5; i1 = gw_al - gw_o4;
  x = gw_ba2[rd]; x = (gw_la2 * gw_fpi) + (gw_fci * x); gw_la2 = x; x *= gw_gi;
  b = (x + 1) * 6;
  a1 = b >= 1 ? gw_aa2 : b <= 0 ? gw_ab2 : (b * gw_aa2) + ((1 - b) * gw_ab2);
  tmp = (x * (-a1)) + gw_za2; gw_za2 = (tmp * a1) + x; gw_o4 = tmp;
  x = gw_bb2[rd]; x = (gw_lb2 * gw_fpi) + (gw_fci * x); gw_lb2 = x; x *= gw_gi;
