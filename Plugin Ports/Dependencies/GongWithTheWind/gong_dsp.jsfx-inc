  a1 = b >= 1 ? gw_aa2 : b <= 0 ? gw_ab2 : (b * gw_aa2) + ((1 - b) * gw_ab2);
  tmp = (x * (-a1)) + gw_zb2; gw_zb2 = (tmp * a1) + x; gw_o5 = tmp;
  gw_ba2[gw_p2] = i0; gw_bb2[gw_p2] = i1; gw_p2 -= 1; gw_p2 < 0 ? gw_p2 += gw_s2;
  rd = gw_p3 + gw_d3; rd >= gw_s3 ? rd -= gw_s3;
