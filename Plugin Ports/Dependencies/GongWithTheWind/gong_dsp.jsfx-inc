  tmp = (x * (-a1)) + gw_za5; gw_za5 = (tmp * a1) + x; gw_o10 = tmp;
  x = gw_bb5[rd]; x = (gw_lb5 * gw_fpo) + (gw_fco * x); gw_lb5 = x; x *= gw_go;
  b = (x + 1) * 6;
  a1 = b >= 1 ? gw_aa5 : b <= 0 ? gw_ab5 : (b * gw_aa5) + ((1 - b) * gw_ab5);
  tmp = (x * (-a1)) + gw_zb5; gw_zb5 = (tmp * a1) + x; gw_o11 = tmp;
  gw_ba5[gw_p5] = i0; gw_bb5[gw_p5] = i1; gw_p5 -= 1; gw_p5 < 0 ? gw_p5 += gw_s5;
  rd = gw_p6 + gw_d6; rd >= gw_s6 ? rd -= gw_s6;
  i0 = gw_de - gw_o13; i1 = gw_ep - gw_o12;
  x = gw_ba6[rd]; x = (gw_la6 * gw_fpo) + (gw_fco * x); gw_la6 = x; x *= gw_go;
  b = (x + 1) * 6;
