@init

function pz_wipe_game()
(
  g_screen == 1 ? ( sv[1] = 0; sv[2] = 0; g_pb_lv = 0; ) :
  g_screen == 2 ? ( sv[10] = 0; sv[11] = 0; sv[12] = 0; g_sl_lv = 0; ) :
  g_screen == 3 ? ( sv[20] = 0; sv[21] = 0; g_kp_init = 0; ) :
  g_screen == 4 ? (
    memset(sv + 30, 0, 5); memset(GD, 0, NT * 4); memset(gmt, 0, NT);
    memset(bds, 0, NBD); memset(pgbs, 0, NBE);
    g_gd_magic = 0; g_gd_rain = 0; g_gd_rend = 0; g_gd_rnext = 0; g_gd_init = 0;
  ) :
  g_screen == 5 ? ( sv[40] = 0; sv[41] = 0; g_rw_init = 0; ) :
  g_screen == 6 ? ( sv[50] = 0; sv[51] = 0; g_kg_lv = 0; ) :
  g_screen == 7 ? ( sv[60] = 0; sv[61] = 0; g_ff_lv = 0; ) :
  g_screen == 8 ? ( memset(sv2, 0, 3); g_sp_lv = 0; ) :
  g_screen == 9 ? ( sv2[10] = 0; sv2[11] = 0; sv2[12] = 0; sv2[14] = 0; g_db_lv = 0; ) :
  g_screen == 10 ? ( sv2[20] = 0; sv2[21] = 0; sv2[22] = 0; g_mu_lv = 0; ) :
  g_screen == 11 ? ( memset(sv2 + 30, 0, 5); g_bz_lv = 0; ) :
  g_screen == 12 ? ( memset(sv2 + 40, 0, 3); memset(xs_snap, 0, 16); g_xs_lv = 0; ) :
  g_screen == 13 ? ( memset(sv2 + 44, 0, 4); memset(sv2 + 49, 0, 6); g_pk_lv = 0; ) :
  g_screen == 14 ? (
    memset(sv3, 0, NS3); memset(sv4, 0, 2000); memset(sv5, 0, HRNJ); sv2[62] = 0;
    g_hp_y = 0; g_hr_cm = -1; g_hr_cf = 0; g_hr_vm = 0; g_hr_nrm = 0; g_hr_mode = 0; g_hr_v = 0;
  ) :
  g_screen == 15 ? ( memset(sv7, 0, 128); g_hp_go = 0; g_hp_ready = 0; );
);

function card_name(id)
(
  id == 0 ? "Patch Bay" : id == 1 ? "Slingshot" : id == 2 ? "Firefly Shepherd" : id == 5 ? "Koi Pond" :
  id == 6 ? "Pixel Garden" : id == 7 ? "Rain Window" : id == 8 ? "Kintsugi" : id == 9 ? "Signal Path" :
  id == 10 ? "Peggy" : id == 11 ? "Mute Point" : id == 12 ? "Bubble and Squeak" : id == 13 ? "Krypton Gigablast" : id == 14 ? "Flop House" : id == 15 ? "Hold Your Horses" : id == 16 ? "Hop to It" : "Coming soon";
);

function card_scr(id)
(
  id == 0 ? 1 : id == 1 ? 2 : id == 2 ? 7 : id == 5 ? 3 : id == 6 ? 4 : id == 7 ? 5 : id == 8 ? 6 :
  id == 9 ? 8 : id == 10 ? 9 : id == 11 ? 10 : id == 12 ? 11 : id == 13 ? 12 : id == 14 ? 13 : id == 15 ? 14 : id == 16 ? 15 : -1;
);

function pz_preview(px, py, pw, ph) local(sw, sh, sx0, sy0, k, dw, dh)
(
  sx0 = g_pz_ox + BRD_X * g_pz_s; sy0 = g_pz_oy + BRD_Y * g_pz_s;
  sw = BRD_W * g_pz_s; sh = BRD_H * g_pz_s;
  k = max(pw / sw, ph / sh);
  dw = pw / k; dh = ph / k;
  gfx_mode = 0; gfx_a = 1;
  gfx_blit(IMG_PZ, 1, 0, sx0 + (sw - dw) * 0.5, sy0 + (sh - dh) * 0.5, dw, dh, sx(px), sy(py), pw * g_s, ph * g_s);
  !g_pz_auto ? (
    gfx_set(0, 0, 0, 0.35); gfx_rect(sx(px), sy(py), pw * g_s, ph * g_s);
    font(11, 'b');
    pill("PAUSED", px + pw * 0.5 - 30, py + ph * 0.5 - 10, 60, 20, 0.4, 0.95, 0.78, 1);
  );
);

function card(id, x, y, w, h, avail, cr, cg, cb) local(hov, px, py, pw, ph)
(
  hov = hit(x, y, w, h);
  hov ? g_hov_card = id;
  gfx_set(0, 0, 0, 0.35);
  gfx_rect(sx(x + 3), sy(y + 5), w * g_s, h * g_s);
  gfx_set(hov ? 0.135 : 0.11, hov ? 0.14 : 0.115, hov ? 0.16 : 0.13, 1);
  fill_rr(x, y, w, h, 8);
  hov ? gfx_set(cr, cg, cb, 0.9) : gfx_set(0.24, 0.25, 0.28, 1);
  outline_rr(x, y, w, h, 8);
  px = x + 8; py = y + 8; pw = w - 16; ph = h - 44;
  gfx_set(0.032, 0.034, 0.042, 1);
  fill_rr(px, py, pw, ph, 6);
  (g_pz_hold && card_scr(id) == g_pz_hold) ? pz_preview(px, py, pw, ph) :
  id == 0 ? pv_patch(px, py, pw, ph) :
  id == 1 ? pv_sling(px, py, pw, ph) :
  id == 2 ? pv_firefly(px, py, pw, ph) :
  id == 5 ? pv_koi(px, py, pw, ph) :
  id == 6 ? pv_garden(px, py, pw, ph) :
  id == 7 ? pv_rain(px, py, pw, ph) :
  id == 8 ? pv_kintsugi(px, py, pw, ph) :
  id == 9 ? pv_signal(px, py, pw, ph) :
  id == 10 ? pv_drop(px, py, pw, ph) :
  id == 11 ? pv_mute(px, py, pw, ph) :
  id == 12 ? pv_bubble(px, py, pw, ph) :
  id == 13 ? pv_shooter(px, py, pw, ph) :
  id == 14 ? pv_poker(px, py, pw, ph) :
  id == 15 ? pv_racing(px, py, pw, ph) :
  id == 16 ? pv_hop(px, py, pw, ph) :
  prev_soon(px, py, pw, ph);
  !avail ? (
    gfx_set(0.02, 0.02, 0.03, 0.3);
    gfx_rect(sx(px), sy(py), pw * g_s, ph * g_s);
  );
  gfx_set(0.2, 0.21, 0.24, 1);
  outline_rr(px, py, pw, ph, 6);
  font(11, 'b');
  !avail ? pill("SOON", px + pw - 48, py + 6, 42, 18, 0.62, 0.64, 0.68, 0.7);
  font(14, 'b');
  avail ? gfx_set(0.95, 0.96, 0.98, 1) : gfx_set(0.8, 0.81, 0.84, 1);
  txt_c(card_name(id), x, y + h - 33, w, 26);
  hov && g_click && avail ? ( g_click = 0; 1; ) : 0;
);

function section_head(s, y, cr, cg, cb) local(tw, th)
(
  font(13, 'b');
  gfx_set(cr, cg, cb, 1);
  gfx_circle(sx(30), sy(y + 9), 3.5 * g_s, 1, 1);
  gfx_set(0.86, 0.87, 0.9, 1);
  txt_l(s, 40, y);
  gfx_measurestr(s, tw, th);
  gfx_set(0.22, 0.23, 0.26, 1);
  gfx_line(sx(40) + tw + 12 * g_s, sy(y + 10), sx(876), sy(y + 10), 1);
);

function card_hint(id)
(
  id == 0 ? "Patch Bay: drag the jacks until no two cables cross. Level N starts with N crossings." :
  id == 1 ? "Slingshot: launch a comet past the planets into the portal. Grab the stars on the way." :
  id == 2 ? "Firefly Shepherd: lead a glowing swarm across a night meadow and light every lantern." :
  id == 5 ? "Koi Pond: feed the koi and stir the water. Nothing to win, nothing to lose." :
  id == 6 ? "Pixel Garden: plant flowers, trees and mushrooms that grow in real time while you work." :
  id == 7 ? "Rain Window: rain running down a misted window. Wipe the glass and watch the city or the forest." :
  id == 8 ? "Kintsugi: piece broken pottery back together and watch the cracks fill with gold." :
  id == 9 ? "Signal Path: turn the tiles to route the signal from the input to every speaker." :
  id == 10 ? "Peggy: aim, drop the ball and clear every red peg before the balls run out." :
  id == 11 ? "Mute Point: every mute button flips its neighbours too. Unmute them all to get every channel live." :
  id == 12 ? "Bubble and Squeak: pop bubbles in threes to free the mice trapped inside before your shots run out." :
  id == 13 ? "Krypton Gigablast: blast through ten alien levels, collect credits, upgrade your ship in the shop, beat the bosses." :
  id == 14 ? "Flop House: Texas Hold'em against twelve rogues with tells to learn. Clean out every table to climb to the Vault." :
  id == 15 ? "Hold Your Horses: the British racing year, Flat and jumps. Train a yard, ride your runners, or bet on a random day at the races." :
  id == 16 ? "Hop to It: hop across busy roads, rivers and railway lines as far as you can. Collect coins and try not to get squashed." :
  "A new game is on the way.";
);

function draw_home() local(tw, th, i, cw, gap, x0)
(
  g_hov_card = -1;
  font(28, 'b');
  gfx_set(0.96, 0.97, 0.99, 1);
  txt_l("Break Room", 26, 16);
  gfx_measurestr("Break Room", tw, th);
  font(13, 0);
  gfx_set(0.62, 0.64, 0.68, 1);
  gfx_x = sx(26) + tw + 12 * g_s; gfx_y = sy(16) + th - 19 * g_s;
  gfx_drawstr("by chmaha");
  font(13, 0);
  gfx_set(0.7, 0.72, 0.76, 1);
  txt_l("Little games for a breather. Your audio passes through untouched while you play.", 27, 54);
  button(snd_lbl(), 774, 16, 108, 28, 0.6, 1, 0.75) ? sv2[13] = snd_next();
  cw = 160; gap = 13;
  section_head("Zen", 84, 0.5, 0.88, 0.95);
  section_head("Games", 278, 0.4, 0.95, 0.78);
  card(5, 24, 106, cw, 160, 1, 0.5, 0.88, 0.95) ? g_screen = 3;
  card(6, 24 + (cw + gap), 106, cw, 160, 1, 0.5, 0.88, 0.95) ? g_screen = 4;
  card(2, 24 + 2 * (cw + gap), 106, cw, 160, 1, 0.5, 0.88, 0.95) ? g_screen = 7;
  card(7, 24 + 3 * (cw + gap), 106, cw, 160, 1, 0.5, 0.88, 0.95) ? g_screen = 5;
  card(8, 24 + 4 * (cw + gap), 106, cw, 160, 1, 0.5, 0.88, 0.95) ? g_screen = 6;
  card(10, 24, 300, cw, 160, 1, 0.4, 0.95, 0.78) ? g_screen = 9;
  card(12, 24 + (cw + gap), 300, cw, 160, 1, 0.55, 0.78, 1) ? g_screen = 11;
  card(13, 24 + 2 * (cw + gap), 300, cw, 160, 1, 1, 0.55, 0.35) ? g_screen = 12;
  card(15, 24 + 3 * (cw + gap), 300, cw, 160, 1, 0.82, 0.68, 0.3) ? g_screen = 14;
  card(16, 24 + 4 * (cw + gap), 300, cw, 160, 1, 0.62, 0.86, 0.3) ? g_screen = 15;
  card(14, 24, 476, cw, 160, 1, 0.95, 0.78, 0.4) ? g_screen = 13;
  card(1, 24 + (cw + gap), 476, cw, 160, 1, 1, 0.72, 0.35) ? g_screen = 2;
  card(0, 24 + 2 * (cw + gap), 476, cw, 160, 1, 0.4, 0.95, 0.78) ? g_screen = 1;
  card(9, 24 + 3 * (cw + gap), 476, cw, 160, 1, 0.4, 0.95, 0.78) ? g_screen = 8;
  card(11, 24 + 4 * (cw + gap), 476, cw, 160, 1, 0.4, 0.95, 0.78) ? g_screen = 10;
  g_hov_card >= 0 ? hint(card_hint(g_hov_card), 668) : hint("Pick a game. The Games button in each game brings you back here, and P pauses any game.", 668);
);

@block
au_on = sv2[13] && !(play_state & 1);
au_n = min(samplesblock, AUB);
au_si = 0;
au_out = 0;
g_heart !== au_hbl ? ( au_hbl = g_heart; au_hbc = 0; ) : au_hbc += samplesblock;
au_on ? (
  au_dly = 0;
  while (au_r != g_evw) ( au_start(au_r); au_r = (au_r + 1) % NEV; );
  au_bs = au_n / srate;
  au_play = 0;
  (au_song || (wt_play && !wt_out)) ? (
    au_song ? (
      au_spb = 0.52;
      while (au_sp < NSG && sgt[au_sp] * au_spb < au_st + au_bs) (
        au_dly = max(0, sgt[au_sp] * au_spb - au_st);
        au_k = sgp[au_sp];
        au_k == 5 ? au_new(8, au_mf(sgn[au_sp]), 0.9, 0, 0, 0) :
        au_k == 4 ? au_new(6, au_mf(sgn[au_sp]), 0.5, 0, 0, sgl[au_sp] * au_spb * 0.92) :
        au_new(6, au_mf(sgn[au_sp]), au_k == 0 ? 0.42 : 0.3, 0, au_k == 0 ? 0.15 : au_k == 1 ? -0.35 : au_k == 2 ? 0.35 : -0.15, sgl[au_sp] * au_spb * 0.92);
        au_sp += 1;
      );
      au_st += au_bs;
      au_sp >= NSG && au_st > 18 * au_spb ? au_song = 0;
