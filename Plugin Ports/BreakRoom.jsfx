  while (g_pz_n < 32 && (g_pz_c = gfx_getchar()) > 0) ( (g_pz_c == 'p' || g_pz_c == 'P') ? g_pz_req = 1 : (g_pz_c == 13 || g_pz_c == 10) ? g_hl_ent = 1; g_pz_n += 1; );
);
g_pz_kd = gfx_getchar('p') > 0 || gfx_getchar('P') > 0;
(g_pz_kd && !g_pz_kl) ? g_pz_req = 1;
g_pz_kl = g_pz_kd;
(g_pz_req && g_screen != 0 && !g_hl && g_now - g_pz_tt > 0.25) ? (
  g_pz = !g_pz; g_pz_tt = g_now; g_pz_wt = 0; g_pz ? g_pz_snap = 1;
);
g_pz_req = 0;
g_screen == 0 ? ( g_pz = 0; g_hl = 0; g_hl_pz = 0; );
(g_screen != 0 && g_screen != 10 && !g_pz && !(sv2[48] & (2 ^ g_screen))) ? ( g_hl = g_screen; g_pz = 1; g_pz_snap = 1; g_pz_tt = g_now; );
(g_screen != 0 && g_pz_hold == g_screen) ? ( g_pz = 1; g_pz_snap = 0; g_pz_hold = 0; g_pz_tt = g_now; ) : (g_screen != 0 && g_pz_hold) ? g_pz_hold = 0;
g_pz && g_pz_snap ? g_dt = 0.0001;
!g_pz || g_pz_snap ? g_t += g_dt;

g_s = min(gfx_w / 900, gfx_h / 700);
g_ox = floor((gfx_w - 900 * g_s) * 0.5);
g_oy = 0;
g_mx = (mouse_x - g_ox) / g_s;
g_my = (mouse_y - g_oy) / g_s;
g_mdown = mouse_cap & 1;
g_click = g_mdown && !g_mlast;
g_mlast = g_mdown;
g_rdn = mouse_cap & 2;
g_rclick = g_rdn && !g_rlast;
g_rlast = g_rdn;

background();
(g_pz && !g_pz_snap) ? (
