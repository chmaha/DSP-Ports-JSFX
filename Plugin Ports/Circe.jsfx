    u_fine = mouse_cap & 4;
    u_fine != u_dfine ? ( u_dy0 = mouse_y; u_dv0 = ui_norm(u_drag); u_dfine = u_fine; );
    ui_setn(u_drag, u_dv0 + (u_dy0 - mouse_y) / u_dsc * (u_fine ? 0.1 : 1));
  ) : (
    automate(u_drag, 1);
    u_drag = 0;
  );
);

gfx_set(0.82, 0.83, 0.85, 1);
ui_hint(u_drag > 0 ? u_drag : u_hov);
ui_font(8 * UQ, 0);
gfx_measurestr(#u_hint, u_tw, u_th);
gfx_x = floor(gfx_w * 0.5 - u_tw * 0.5); gfx_y = floor(ui_py(353) - u_th * 0.5);
gfx_drawstr(#u_hint);

u_pd = u_down;
