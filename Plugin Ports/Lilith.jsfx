function trunc(x) ( x < 0 ? ceil(x) : floor(x); );
function smax(a, b) ( a > b ? a : b; );
function smin(a, b) ( a < b ? a : b; );
function sclamp(a, lo, hi) ( smin(smax(a, lo), hi); );
function cvtt(x) local(t) ( t = trunc(x); (t >= 2147483648 || t < -2147483648 || x !== x) ? -2147483648 : t; );

function i2f(n) local(a, e, ulp, q, r, fr, s)
(
  a = abs(n);
  a < 16777216 ? n : (
    s = n < 0 ? -1 : 1;
    e = floor(log(a) / log(2));
    (2 ^ e) > a ? e -= 1;
    (2 ^ (e + 1)) <= a ? e += 1;
    ulp = 2 ^ (e - 23);
    q = a / ulp; r = floor(q); fr = q - r;
    fr > 0.5 ? r += 1 : fr === 0.5 ? ( (r - 2 * floor(r / 2)) == 1 ? r += 1; );
    s * r * ulp;
  );
);

function u2s(u) ( u >= 2147483648 ? u - 4294967296 : u; );
function s2u(n) ( n < 0 ? n + 4294967296 : n; );
function band32(x, y) local(xh, xl, yh, yl)
(
  xh = floor(x / 65536); xl = x - xh * 65536;
  yh = floor(y / 65536); yl = y - yh * 65536;
  (xh & yh) * 65536 + (xl & yl);
