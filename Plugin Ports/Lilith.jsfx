function ui_col(c) local(r, g, b)
(
  c == 0 ? ( r = 0.188; g = 0.490; b = 0.933; ) : c == 1 ? ( r = 0.529; g = 0.349; b = 0.643; ) :
  c == 2 ? ( r = 0.855; g = 0.251; b = 0.380; ) : c == 3 ? ( r = 0; g = 0.631; b = 0.655; ) : ( r = 1; g = 0.698; b = 0.290; );
  gfx_set(r, g, b, 1);
);

function ui_tline(x0, y0, x1, y1, w) local(dx, dy, l, nx, ny, k, n, o)
(
  dx = x1 - x0; dy = y1 - y0; l = sqrt(dx * dx + dy * dy);
  l > 0 ? (
    nx = -dy / l; ny = dx / l;
    n = max(1, ceil(w * 1.5)); k = 0;
    loop(n + 1,
      o = (k / n - 0.5) * max(0, w - 1);
      gfx_line(x0 + nx * o, y0 + ny * o, x1 + nx * o, y1 + ny * o, 1);
      k += 1;
    );
  );
);

function ui_curves() local(n, i, j, np, p, w, x0, y0, x1, y1)
(
  n = CRV[0]; p = CRV + 1; w = 2 * UQ * 0.95;
  loop(n,
    ui_col(p[0]); np = p[1];
    x0 = ui_px(p[2]); y0 = ui_py(p[3]);
    gfx_circle(x0, y0, w * 0.5 - 0.25, 1, 1);
    j = 1;
    loop(np - 1,
      x1 = ui_px(p[2 + j * 2]); y1 = ui_py(p[3 + j * 2]);
      ui_tline(x0, y0, x1, y1, w);
      gfx_circle(x1, y1, w * 0.5 - 0.25, 1, 1);
      x0 = x1; y0 = y1;
      j += 1;
    );
    p += 2 + np * 2;
  );
);

function ui_font(fs, b) ( gfx_setfont(1, "Arial", max(11, floor(fs + 0.5)), b ? 'b' : 0); );

function plabel(str, cx, cy, fs, rot) local(tw, th, w, h, i, j, gr, gg, gb, ccx, ccy, rad, cs, sn, dx, dy, uu, vv, iu, iv, fu, fv, al, x0, y0)
(
  ui_font(fs * UQ * 0.97, 0);
  gfx_measurestr(str, tw, th);
  rot === 0 ? (
    gfx_set(1, 1, 1, 1);
    gfx_x = floor(ui_px(cx) - tw * 0.5 + 0.5); gfx_y = floor(ui_py(cy) - th * 0.5 + 0.5);
    gfx_drawstr(str);
  ) : (
    w = ceil(tw) + 4; h = ceil(th) + 4;
    gfx_dest = 11; gfx_setimgdim(11, w, h);
    gfx_set(0, 0, 0, 1); gfx_rect(0, 0, w, h);
    gfx_set(1, 1, 1, 1); gfx_x = 2; gfx_y = 2; gfx_drawstr(str);
    j = 0;
    loop(h, i = 0; loop(w, gfx_x = i; gfx_y = j; gfx_getpixel(gr, gg, gb); LBUF[j * w + i] = gr; i += 1; ); j += 1; );
    gfx_dest = 10;
    ccx = ui_px(cx); ccy = ui_py(cy);
    rad = ceil(sqrt(w * w + h * h) * 0.5) + 1;
    cs = cos(rot); sn = sin(rot);
    gfx_set(1, 1, 1, 1);
    y0 = floor(ccy - rad);
    loop(2 * rad + 1,
      x0 = floor(ccx - rad);
      loop(2 * rad + 1,
        dx = x0 + 0.5 - ccx; dy = y0 + 0.5 - ccy;
        uu = cs * dx + sn * dy + w * 0.5 - 0.5; vv = -sn * dx + cs * dy + h * 0.5 - 0.5;
        (uu >= 0 && vv >= 0 && uu < w - 1 && vv < h - 1) ? (
          iu = floor(uu); iv = floor(vv); fu = uu - iu; fv = vv - iv;
          al = (LBUF[iv * w + iu] * (1 - fu) + LBUF[iv * w + iu + 1] * fu) * (1 - fv) + (LBUF[(iv + 1) * w + iu] * (1 - fu) + LBUF[(iv + 1) * w + iu + 1] * fu) * fv;
          al > 0.01 ? ( gfx_a = al; gfx_rect(x0, y0, 1, 1); );
        );
        x0 += 1;
      );
      y0 += 1;
    );
    gfx_a = 1;
  );
);

function ui_ctext(str, cx, cy, fs, b) local(tw, th)
(
  ui_font(fs, b);
  gfx_measurestr(str, tw, th);
  gfx_x = floor(cx - tw * 0.5 + 0.5); gfx_y = floor(cy - th * 0.5 + 0.5);
  gfx_drawstr(str);
);
function ui_ltext(str, x, cy, fs, b) local(tw, th)
(
  ui_font(fs, b);
  gfx_measurestr(str, tw, th);
  gfx_x = floor(x + 0.5); gfx_y = floor(cy - th * 0.5 + 0.5);
  gfx_drawstr(str);
);
function ui_rtext(str, x, cy, fs, b) local(tw, th)
(
  ui_font(fs, b);
  gfx_measurestr(str, tw, th);
  gfx_x = floor(x - tw + 0.5); gfx_y = floor(cy - th * 0.5 + 0.5);
  gfx_drawstr(str);
);

function ui_bezel(cx, cy, rr) local(yy, xx, dx, dy, d, cv, th, f, q, rc, ac, c, band)
(
  yy = floor(cy - rr - 1);
  loop(ceil(2 * rr + 3),
    dy = yy + 0.5 - cy;
    xx = floor(cx - rr - 1);
    loop(ceil(2 * rr + 3),
      dx = xx + 0.5 - cx; d = sqrt(dx * dx + dy * dy);
      cv = min(1, rr - d + 0.5);
      cv > 0 ? (
        c = 0.2;
        th = atan2(dx, -dy) * 180 / $pi;
        f = d / rr;
        band = 0;
        (f > 0.84 && f < 0.97) ? ( band = 1; q = th + 360; q = q - 90 * floor(q / 90); );
        (f > 0.66 && f < 0.80) ? ( band = 2; q = th + 405; q = q - 90 * floor(q / 90); );
        band ? (
          rc = band == 1 ? min(1, min((f - 0.84) * rr + 0.5, (0.97 - f) * rr + 0.5)) : min(1, min((f - 0.66) * rr + 0.5, (0.80 - f) * rr + 0.5));
          ac = min(1, min((q - 12) * $pi / 180 * d + 0.5, (78 - q) * $pi / 180 * d + 0.5));
          rc > 0 && ac > 0 ? c = 0.2 + 0.059 * rc * ac;
        );
        f > 0.97 ? c = 0.2 - 0.05 * min(1, (f - 0.97) * rr);
        gfx_set(c, c, c, cv);
        gfx_rect(xx, yy, 1, 1);
      );
      xx += 1;
    );
    yy += 1;
  );
  gfx_a = 1;
);

function ui_ledbase(u, v) local(cx, cy, r)
(
  cx = ui_px(u); cy = ui_py(v); r = 7.13 * UQ;
  gfx_set(0, 0, 0, 1); gfx_circle(cx, cy, r, 1, 1);
  gfx_set(0.235, 0.235, 0.235, 1); gfx_circle(cx, cy, r - max(1, 0.5 * UQ), 1, 1);
);

function ui_lcdbox(u, v, w, h)
(
  gfx_set(0.255, 0.251, 0.259, 1);
  gfx_rect(floor(ui_px(u)), floor(ui_py(v)), floor(w * UQ + 0.5), floor(h * UQ + 0.5));
  gfx_set(0.067, 0.067, 0.067, 1);
  gfx_rect(floor(ui_px(u)) + 1, floor(ui_py(v)) + 1, floor(w * UQ + 0.5) - 2, floor(h * UQ + 0.5) - 2);
);

function ui_panelimg() local(src, base)
(
  src = (g_pnl2 && UQ > 1.9 * 1.25) ? 21 : 20;
  base = src == 21 ? 3.8 : 1.9;
  gfx_set(1, 1, 1, 1);
  gfx_x = ui_px(0); gfx_y = ui_py(0);
  gfx_blit(src, UQ / base, 0);
);

