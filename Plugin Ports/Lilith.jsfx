function vcos(x) local(x2, x4, x6, x8, o)
(
  x2 = (x * x); x4 = (x2 * x2); x6 = (x4 * x2); x8 = (x6 * x2);
  o = (1 - (x2 * CC2));
  o = (o + (x4 * CC4));
  o = (o - (x6 * CC6));
