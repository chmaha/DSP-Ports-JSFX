desc: Lilith Wavetable Synth (Valley Terrorform port) by chmaha
tags: instrument synthesizer wavetable oscillator
author: chmaha
version: 1.0
changelog:
  Initial release.
about:
  Wavetable voice with phase shaping, enhancers, a sub oscillator and a lowpass gate, played from MIDI.
  Ported from Valley Terrorform by Dale Johnson (ValleyRackFree, https://github.com/ValleyAudio/ValleyRackFree,
  GPLv3+). Wavetables from Terrorform's ROM (Dependencies/Lilith).
  Title lettering: Zarathustra by Lorene Ceccon (SIL Open Font License 1.1), rendered into the panel image.
  Sidebar image: Lilith (1887) by John Collier, public domain (Wikimedia Commons).
  JSFX version released under GPLv3+ license
  Claude generated some of this code
provides:
  Dependencies/Lilith/Lilith.flac
  Dependencies/Lilith/LilithPanel.png
  Dependencies/Lilith/LilithPanel2x.png
  Dependencies/Lilith/LilithImage.png
  Dependencies/Lilith/LilithImage2x.png
  Dependencies/Lilith/LilithShimmer.png
  Dependencies/Lilith/LilithShimmer2x.png
  Dependencies/Lilith/LilithHair.png
  Dependencies/Lilith/LilithHair2x.png
  Dependencies/Lilith/LilithTorso.png
  Dependencies/Lilith/LilithTorso2x.png
  Dependencies/Lilith/LilithFern.png
  Dependencies/Lilith/LilithFern2x.png
  Dependencies/Lilith/LilithHairSheen.png
  Dependencies/Lilith/LilithHairSheen2x.png

slider1:tf_oct=0<-3,3,1>-Octave
slider2:tf_coarse=0<-1,1,0.001>-Coarse
slider3:tf_fine=0<-0.041666,0.041666,0.0001>-Fine
slider4:tf_bank=0<0,63,1>-Bank
slider5:tf_wave=0<0,1,0.001>-Wave
slider6:tf_stype=0<0,26,1>-Shape Type
slider7:tf_sdep=0<0,1,0.001>-Shape Depth
slider8:tf_etype=0<0,10,1>-Enhance Type
slider9:tf_edep=0<0,1,0.001>-Enhance Depth
slider10:tf_att=0<0,1,0.001>-LPG Attack
slider11:tf_dec=0.5<0,1,0.001>-LPG Decay
slider12:tf_skew=0<0,1,0.001>-Skew
slider13:tf_sublvl=0<0,1,0.001>-Sub Level
slider14:tf_subwave=0<0,1,0.001>-Sub Wave
slider15:tf_lpgmode=1<0,3,1{Bypass,VCA,Filter,Both}>-LPG Mode
slider16:tf_long=0<0,1,1{Off,On}>-LPG Long Time
slider17:tf_vel=0<0,1,1{Off,On}>-LPG Velocity
slider18:tf_trig=0<0,1,1{Off,On}>-LPG Trigger Mode
slider19:tf_swap=0<0,1,1{Off,On}>-Swap Enhancer and LPG
slider20:tf_postpm=0<0,1,1{Off,On}>-Post-PM Shaping
slider21:tf_lfo=0<0,1,1{Off,On}>-LFO Mode
slider22:tf_zero=0<0,1,1{Off,On}>-Zero Frequency
slider23:tf_syncm=0<0,15,1{Hard,Fifth,Octave,Sub Octave,Rise A,Rise B,Fall A,Fall B,Pull A,Pull B,Push A,Push B,Hold,One Shot,Lock Shot,Reverse}>-Sync Mode
slider24:tf_m12=0<0,1,1{Off,On}>-Output -12 dB
slider25:tf_voices=8<1,16,1>-Voices
slider26:tf_syncnote=0<0,1,1{Off,On}>-Sync on Note
slider27:tf_vol=0<-24,12,0.1>-Volume (dB)
slider28:tf_anim=1<0,1,1{Off,On}>-Animation

in_pin:none
out_pin:Left
out_pin:Right
options:maxmem=8000000 no_meter

