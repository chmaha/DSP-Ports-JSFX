function ui_seg(x, y, w, h, mask, t) local(k, p, ax, ay, bx, by, dx, dy, l, nx, ny, sl)
(
  sl = 0.13 * h;
  k = 0;
  loop(14,
    (mask & (2 ^ k)) ? (
      p = SEGP + k * 4;
      ax = x + p[0] * w + (1 - p[1]) * sl; ay = y + p[1] * h;
      bx = x + p[2] * w + (1 - p[3]) * sl; by = y + p[3] * h;
      dx = bx - ax; dy = by - ay; l = max(0.001, sqrt(dx * dx + dy * dy));
      nx = -dy / l * t * 0.5; ny = dx / l * t * 0.5;
      gfx_triangle(ax + nx, ay + ny, bx + nx, by + ny, bx - nx, by - ny, ax - nx, ay - ny);
    );
    k += 1;
  );
);

function ui_lcd(str, x, y, w, h, pitch, ncell, right) local(n, i, c, m, t, x0, off)
(
  n = min(strlen(str), ncell);
  off = right == 1 ? ncell - n : right == 2 ? floor((ncell - n) / 2) : 0;
  t = max(1.2, w * 0.15);
  gfx_set(0.247, 0, 0, 1);
  i = 0; loop(ncell, ui_seg(x + i * pitch, y, w, h, 16383, t); i += 1; );
  gfx_set(1, 0.37, 0.37, 0.16);
  i = 0; loop(n,
    c = str_getchar(str, i); m = (c >= 32 && c < 128) ? SEGT[c - 32] : 0;
    ui_seg(x + (i + off) * pitch, y, w, h, m, t * 1.8);
    i += 1;
  );
  gfx_set(1, 0, 0, 1);
  i = 0; loop(n,
    c = str_getchar(str, i); m = (c >= 32 && c < 128) ? SEGT[c - 32] : 0;
    ui_seg(x + (i + off) * pitch, y, w, h, m, t);
    i += 1;
  );
  gfx_set(1, 0.47, 0.47, 0.55);
  i = 0; loop(n,
    c = str_getchar(str, i); m = (c >= 32 && c < 128) ? SEGT[c - 32] : 0;
    ui_seg(x + (i + off) * pitch, y, w, h, m, max(1, t * 0.4));
    i += 1;
  );
);

function ui_bar(cx, cy, ca, sa, r0, r1, hw) local(x0, y0, x1, y1, xx, yy, dx, dy, ss, tt, cv)
(
  x0 = floor(min(cx + sa * r0, cx + sa * r1) - hw - 2); x1 = ceil(max(cx + sa * r0, cx + sa * r1) + hw + 2);
  y0 = floor(min(cy - ca * r0, cy - ca * r1) - hw - 2); y1 = ceil(max(cy - ca * r0, cy - ca * r1) + hw + 2);
  yy = y0;
  loop(y1 - y0 + 1,
    xx = x0;
    loop(x1 - x0 + 1,
      dx = xx + 0.5 - cx; dy = yy + 0.5 - cy;
      ss = dx * sa - dy * ca; tt = dx * ca + dy * sa;
      cv = max(0, min(1, min(ss - r0, r1 - ss) + 0.5)) * max(0, min(1, hw - abs(tt) + 0.5));
      cv > 0 ? ( gfx_a = cv; gfx_rect(xx, yy, 1, 1); );
      xx += 1;
    );
    yy += 1;
  );
  gfx_a = 1;
);

function ui_click_at(s)
(
  (u_ctarget == s && time_precise() - u_ctime < 0.3) ? (
    ui_put(s, ui_def(s));
    u_drag = 0;
  ) : (
    u_drag = s; u_dy0 = mouse_y; u_dv0 = ui_norm(s); u_dfine = mouse_cap & 4;
  );
  u_ctarget = s; u_ctime = time_precise();
  u_click = 0;
);

function ui_knob(s, cx, cy, rr, col) local(hov, n, a, ca, sa, cr, cg, cb, hr, hg, hb, rc)
(
  hov = ui_hitc(cx, cy, rr + 2);
  hov ? u_hov = s;
  (u_click && hov) ? ui_click_at(s);
  (hov && u_wheel != 0 && u_drag == 0) ? (
    ui_stp(s) >= 1 ? ui_put(s, slider(s) + (u_wheel > 0 ? 1 : -1) * ui_stp(s))
                   : ( ui_setn(s, ui_norm(s) + (u_wheel / 120) * ((mouse_cap & 4) ? 0.002 : 0.02)); automate(s, 1); );
    u_wheel = 0;
  );
  col == 0 ? ( cr = 0.220; cg = 0.455; cb = 0.812; hr = 0.345; hg = 0.533; hb = 0.820; ) :
  col == 1 ? ( cr = 0.533; cg = 0.329; cb = 0.663; hr = 0.600; hg = 0.302; hb = 0.788; ) :
  col == 2 ? ( cr = 0.890; cg = 0.098; cb = 0.353; hr = 0.922; hg = 0.369; hb = 0.545; ) :
  col == 3 ? ( cr = 0.031; cg = 0.616; cb = 0.706; hr = 0.302; hg = 0.722; hb = 0.788; ) :
  col == 4 ? ( cr = 0.890; cg = 0.545; cb = 0.098; hr = 0.945; hg = 0.682; hb = 0.341; ) :
             ( cr = 0.890; cg = 0.890; cb = 0.890; hr = 0.949; hg = 0.949; hb = 0.949; );
  n = max(0, min(1, ui_norm(s)));
  a = (-0.75 + 1.5 * n) * $pi;
  ca = cos(a); sa = sin(a);
  gfx_set(0, 0, 0, 1); gfx_circle(cx, cy, rr, 1, 1);
  gfx_set(0.22, 0.22, 0.22, 1); gfx_circle(cx, cy, rr * 0.80, 0, 1);
  (hov || u_drag == s) ? gfx_set(hr, hg, hb, 1) : gfx_set(cr, cg, cb, 1);
  gfx_circle(cx, cy, rr * 0.62, 1, 1);
  ui_bar(cx, cy, ca, sa, rr * 0.45, rr * 0.97, max(1, rr * 0.055));
);

function ui_lamp(cx, cy, r, lr, lg, lb, on)
(
  on > 0.01 ? (
    gfx_set(lr, lg, lb, 0.25 * on); gfx_circle(cx, cy, r * 1.6, 1, 1);
    gfx_set(0.235 + (lr - 0.235) * on, 0.235 + (lg - 0.235) * on, 0.235 + (lb - 0.235) * on, 1);
    gfx_circle(cx, cy, r, 1, 1);
    gfx_set(1, 1, 1, 0.35 * on); gfx_circle(cx - r * 0.3, cy - r * 0.3, r * 0.35, 1, 1);
  ) : (
    gfx_set(0.16, 0.16, 0.16, 1); gfx_circle(cx, cy, r, 1, 1);
  );
);

function ui_led(s, u, v) local(cx, cy, hov, on)
(
  cx = ui_px(u); cy = ui_py(v);
  hov = ui_hitc(cx, cy, 9 * UQ);
  hov ? u_hov = s;
  (u_click && hov) ? ( ui_put(s, slider(s) > 0.5 ? 0 : 1); u_click = 0; );
  on = slider(s) > 0.5;
  ui_lamp(cx, cy, 4.7 * UQ, 0.929, 0.173, 0.141, on);
  hov ? ( gfx_set(1, 1, 1, 0.5); gfx_circle(cx, cy, 7.13 * UQ, 0, 1); );
);

function ui_lpgbtn(u, v) local(cx, cy, hov, m, lr, lg, lb)
(
  cx = ui_px(u); cy = ui_py(v);
  hov = ui_hitc(cx, cy, 9 * UQ);
  hov ? u_hov = 15;
  (u_click && hov) ? ( u_lpgdn = 1; u_lpgt = time_precise(); u_lpgheld = 0; u_click = 0; );
  u_lpgdn ? (
    u_down ? (
      (!u_lpgheld && time_precise() - u_lpgt >= 0.5) ? ( u_lpgheld = 1; ui_put(15, tf_lpgmode > 0 ? 0 : 1); );
    ) : (
      !u_lpgheld ? ui_put(15, tf_lpgmode < 0.5 ? 1 : tf_lpgmode > 2.5 ? 1 : tf_lpgmode + 1);
      u_lpgdn = 0;
    );
  );
  (u_rclick && hov) ? ( ui_put(15, tf_lpgmode > 0 ? 0 : 1); u_rclick = 0; );
  m = floor(tf_lpgmode + 0.5);
  m == 1 ? ( lr = 0.929; lg = 0.173; lb = 0.141; ) : m == 2 ? ( lr = 0.2; lg = 0.9; lb = 0.2; ) : ( lr = 0.25; lg = 0.45; lb = 1; );
  ui_lamp(cx, cy, 4.7 * UQ, lr, lg, lb, m > 0);
  hov ? ( gfx_set(1, 1, 1, 0.5); gfx_circle(cx, cy, 7.13 * UQ, 0, 1); );
);

function ui_menu(base, lbase, n, cur, grp) local(i, r)
(
  strcpy(#u_menu, "");
  i = 0;
  loop(n,
    (grp > 0 && i - grp * floor(i / grp) == 0) ? (
      sprintf(#u_mt, ">%d - %d|", i, min(n, i + grp) - 1); strcat(#u_menu, #u_mt);
    );
    (grp > 0 && (i - grp * floor(i / grp) == grp - 1 || i == n - 1)) ? strcat(#u_menu, "<");
    i == cur ? strcat(#u_menu, "!");
    lbase >= 0 ? sprintf(#u_mt, "%d %s", i, lbase + i) : sprintf(#u_mt, "%s", base + i);
    strcat(#u_menu, #u_mt);
    i < n - 1 ? strcat(#u_menu, "|");
    i += 1;
  );
  gfx_x = mouse_x; gfx_y = mouse_y;
  r = gfx_showmenu(#u_menu);
  r - 1;
);

function ui_lcdrow(s, u, v, w, h, n, base, lbase, grp) local(x, y, hov, r)
(
  x = ui_px(u); y = ui_py(v);
  hov = ui_hit(x, y, w * UQ, h * UQ);
  hov ? u_hov = s;
  (u_click && hov) ? (
    u_click = 0;
    r = ui_menu(base, lbase, n, floor(slider(s) + 0.5), grp);
    r >= 0 ? ui_put(s, r);
  );
  (hov && u_wheel != 0 && u_drag == 0) ? ( ui_put(s, slider(s) + (u_wheel > 0 ? 1 : -1)); u_wheel = 0; );
);

function ui_wavecache(b, ww, hh) local(off, nw, ln, ns, k, wi, j, x0, y0, x1, y1, bx, by, amp, sx, sy, step)
(
  gfx_dest = 12; gfx_setimgdim(12, ww, hh);
  gfx_set(0.067, 0.067, 0.067, 1); gfx_rect(0, 0, ww, hh);
  off = BOFF[b]; nw = BNW[b]; ln = BLEN[b];
  ns = min(nw, 24);
  amp = hh * 0.16; sx = ww * 0.24; sy = hh * 0.52;
  k = ns - 1;
  loop(ns,
    wi = ns > 1 ? floor(k * (nw - 1) / (ns - 1) + 0.5) : 0;
    bx = ns > 1 ? k / (ns - 1) * sx : 0; by = hh * 0.72 - (ns > 1 ? k / (ns - 1) * sy : 0);
    gfx_set(0.686, 0.686, 0.686, 0.30 + 0.25 * (1 - k / max(1, ns - 1)));
    step = ln / 96;
    j = 0;
    x0 = bx; y0 = by - WT[off + wi * ln] * amp;
    loop(96,
      j += 1;
      x1 = bx + j / 96 * (ww - sx - 4);
      y1 = by - WT[off + wi * ln + min(ln - 1, floor(j * step))] * amp;
      gfx_line(x0, y0, x1, y1, 1);
      x0 = x1; y0 = y1;
    );
    k -= 1;
  );
  gfx_dest = -1;
);

function ui_wavedisp() local(x, y, ww, hh, b, nw, wp, k, bx, by, amp, sx, sy, j, x0, y0, x1, y1, v, sx0, sy0, sw, sh, ns)
(
  x = floor(ui_dx(590)); y = floor(ui_dy(94)); ww = floor(290 * uscale); hh = floor(130 * uscale);
  b = max(0, min(63, floor(tf_bank + 0.5)));
  (u_wcb != b || u_wcw != ww || u_wch != hh) ? ( ui_wavecache(b, ww, hh); u_wcb = b; u_wcw = ww; u_wch = hh; );
  gfx_x = x; gfx_y = y; gfx_blit(12, 1, 0);
  nw = BNW[b]; ns = min(nw, 24);
  amp = hh * 0.16; sx = ww * 0.24; sy = hh * 0.52;
  wp = nw > 1 ? max(0, min(1, tf_wave)) : 0;
  bx = x + wp * sx; by = y + hh * 0.72 - wp * sy;
  gfx_set(0.875, 0, 0, 0.5);
  sw = floor(ww - sx - 4); j = 0;
  loop(sw + 1,
    v = j / sw * (DN - 1); k = floor(v); v -= k;
    v = k < DN - 1 ? DRAW[k] * (1 - v) + DRAW[k + 1] * v : DRAW[DN - 1];
    gfx_line(bx + j, by, bx + j, by - v * amp, 0);
    j += 1;
  );
  gfx_set(1, 0.1, 0.1, 1);
  x0 = bx; y0 = by - DRAW[0] * amp; j = 1;
  loop(DN - 1,
    x1 = bx + j / (DN - 1) * (ww - sx - 4); y1 = by - DRAW[j] * amp;
    gfx_line(x0, y0, x1, y1, 1); gfx_line(x0, y0 - 1, x1, y1 - 1, 1);
    x0 = x1; y0 = y1; j += 1;
  );
  gfx_set(1, 0.31, 0.31, 1);
  ui_lcd(100 + b, ui_dx(592), ui_dy(66), 12 * uscale, 18 * uscale, 16 * uscale, 10, 0);
  sprintf(#u_t, "%d", floor(max(0, min(1, tf_wave)) * 100));
  ui_lcd(#u_t, ui_dx(828), ui_dy(66), 12 * uscale, 18 * uscale, 16 * uscale, 3, 1);
  !tables_ok ? ( gfx_set(1, 0.31, 0.31, 1); ui_ctext("Lilith.flac not found in Dependencies/Lilith", ui_dx(735), ui_dy(160), 13 * uscale, 0); );
  gfx_set(1, 0.31, 0.31, 1);
  sprintf(#u_t, "%d WAVES", nw);
  ui_rtext(#u_t, ui_dx(878), ui_dy(240), 12 * uscale, 0);
  sx0 = floor(ui_dx(590)); sy0 = floor(ui_dy(250)); sw = floor(140 * uscale); sh = floor(74 * uscale);
  gfx_set(0.247, 0, 0, 1);
  gfx_rect(sx0, sy0, sw, 1); gfx_rect(sx0, sy0 + sh, sw, 1); gfx_rect(sx0, sy0 + floor(sh / 2), sw, 1);
  gfx_line(sx0, sy0 + sh, sx0 + sw, sy0, 1);
  gfx_set(1, 0.1, 0.1, 1);
  x0 = sx0; y0 = sy0 + sh - DPH[0] * sh; j = 1;
  loop(DN - 1,
    x1 = sx0 + j / (DN - 1) * sw; y1 = sy0 + sh - DPH[j] * sh;
    gfx_line(x0, y0, x1, y1, 1);
    x0 = x1; y0 = y1; j += 1;
  );
  gfx_set(1, 0.31, 0.31, 1);
  ui_ltext("PHASE", sx0 + 3, sy0 + 9 * uscale, 11 * uscale, 0);
  sx0 = floor(ui_dx(740));
  gfx_set(0.247, 0, 0, 1);
  gfx_rect(sx0, sy0, sw, 1); gfx_rect(sx0, sy0 + sh, sw, 1); gfx_rect(sx0, sy0 + floor(sh / 2), sw, 1);
  gfx_set(0.686, 0.686, 0.686, 0.45);
  x0 = sx0; y0 = sy0 + sh * 0.5 - max(-1, min(1, DSH[0])) * sh * 0.48; j = 1;
  loop(DN - 1,
    x1 = sx0 + j / (DN - 1) * sw; y1 = sy0 + sh * 0.5 - max(-1, min(1, DSH[j])) * sh * 0.48;
    gfx_line(x0, y0, x1, y1, 1);
    x0 = x1; y0 = y1; j += 1;
  );
  gfx_set(1, 0.1, 0.1, 1);
  x0 = sx0; y0 = sy0 + sh * 0.5 - max(-1, min(1, DENH[0])) * sh * 0.48; j = 1;
  loop(DN - 1,
    x1 = sx0 + j / (DN - 1) * sw; y1 = sy0 + sh * 0.5 - max(-1, min(1, DENH[j])) * sh * 0.48;
    gfx_line(x0, y0, x1, y1, 1);
    x0 = x1; y0 = y1; j += 1;
  );
  gfx_set(1, 0.31, 0.31, 1);
  ui_ltext("OUTPUT", sx0 + 3, sy0 + 9 * uscale, 11 * uscale, 0);
);

function ui_voices() local(x0, y0, cw, ch, k, x, on, p, e, hov)
(
  x0 = ui_dx(584); y0 = floor(ui_dy(364)); cw = 302 * uscale / 16; ch = floor(26 * uscale);
  k = 0;
  loop(16,
    x = floor(x0 + k * cw);
    hov = ui_hit(x, y0, floor(x0 + (k + 1) * cw) - x, ch + floor(8 * uscale));
    hov ? ( u_hov = 25; u_click ? ( ui_put(25, k + 1); u_click = 0; ); );
    on = k < floor(tf_voices + 0.5);
    gfx_set(on ? 0.30 : 0.10, on ? 0.30 : 0.10, on ? 0.31 : 0.105, 1);
    gfx_rect(x + 1, y0, floor(x0 + (k + 1) * cw) - x - 1, ch);
    hov ? ( gfx_set(1, 1, 1, 0.12); gfx_rect(x + 1, y0, floor(x0 + (k + 1) * cw) - x - 1, ch); );
    gfx_set(on ? 1 : 0.58, on ? 1 : 0.58, on ? 1 : 0.6, 1);
    sprintf(#u_t, "%d", k + 1);
    ui_ctext(#u_t, (x + floor(x0 + (k + 1) * cw)) * 0.5, y0 + ch * 0.5, 12 * uscale, 0);
    p = VST + k * VSS;
    e = on ? max(0, min(1, p[25])) : 0;
    gfx_set(0.10, 0.10, 0.105, 1); gfx_rect(x + 1, y0 + ch + floor(3 * uscale), floor(x0 + (k + 1) * cw) - x - 1, floor(5 * uscale));
    e > 0.002 ? ( gfx_set(1, 0.1, 0.1, 0.25 + 0.75 * e); gfx_rect(x + 1, y0 + ch + floor(3 * uscale), floor(x0 + (k + 1) * cw) - x - 1, floor(5 * uscale)); );
    k += 1;
  );
);

function ui_kbsend(st, nt, vel) local(gix)
(
  gix = (gq_w & 63) * 3;
  GQ[gix] = st; GQ[gix + 1] = nt; GQ[gix + 2] = vel;
  gq_w += 1;
);

function ui_iswhite(k) local(m) ( m = k - 12 * floor(k / 12); m == 0 || m == 2 || m == 4 || m == 5 || m == 7 || m == 9 || m == 11; );

function ui_keyboard() local(x0, y0, kw, kh, ww, bw, bh, n0, k, wi, x, nt, hk, lit, hov, vel, p, v, e, bx, oct, b)
(
  x0 = ui_dx(584); y0 = floor(ui_dy(500)); kw = 302 * uscale; kh = floor(108 * uscale);
  ww = kw / 15; bw = ww * 0.62; bh = floor(kh * 0.6);
  n0 = 12 * (u_kbo + 1);
  memset(KLIT, 0, 128);
  v = 0;
  loop(16,
    p = VST + v * VSS;
    (v < floor(tf_voices + 0.5) && p[26] >= 0 && p[26] < 128) ? (
      e = p[27] ? max(0.55, min(1, p[25])) : 0;
      KLIT[p[26]] = max(KLIT[p[26]], e);
    );
    v += 1;
  );
  hk = -1;
  ui_hit(x0, y0, kw, kh) ? (
    wi = floor((mouse_x - x0) / ww); wi = max(0, min(14, wi));
    k = 0; b = -1;
    loop(25,
      !ui_iswhite(k) ? (
        bx = x0 + (floor(k / 12) * 7 + (k - 12 * floor(k / 12) == 1 ? 1 : k - 12 * floor(k / 12) == 3 ? 2 : k - 12 * floor(k / 12) == 6 ? 4 : k - 12 * floor(k / 12) == 8 ? 5 : 6)) * ww - bw * 0.5;
        (mouse_x >= bx && mouse_x < bx + bw && mouse_y < y0 + bh) ? b = k;
      );
      k += 1;
    );
    b >= 0 ? hk = n0 + b : (
      oct = floor(wi / 7); k = wi - oct * 7;
      hk = n0 + oct * 12 + (k == 0 ? 0 : k == 1 ? 2 : k == 2 ? 4 : k == 3 ? 5 : k == 4 ? 7 : k == 5 ? 9 : 11);
    );
    u_hov = 100;
  );
  (u_click && hk >= 0) ? (
    vel = floor(40 + 87 * max(0, min(1, (mouse_y - y0) / kh)));
    ui_kbsend(144, hk, vel); u_kbn = hk; u_kbv = vel; u_click = 0;
  );
  u_kbn >= 0 ? (
    !u_down ? ( ui_kbsend(128, u_kbn, 0); u_kbn = -1; ) :
    (hk >= 0 && hk != u_kbn) ? ( ui_kbsend(128, u_kbn, 0); ui_kbsend(144, hk, u_kbv); u_kbn = hk; );
  );
  wi = 0; k = 0;
  loop(25,
    ui_iswhite(k) ? (
      nt = n0 + k; x = floor(x0 + wi * ww);
      lit = KLIT[nt];
      gfx_set(0.93, 0.93, 0.93, 1);
      gfx_rect(x + 1, y0, floor(x0 + (wi + 1) * ww) - x - 1, kh);
      lit > 0 ? ( gfx_set(1, 0.15, 0.15, 0.25 + 0.6 * lit); gfx_rect(x + 1, y0, floor(x0 + (wi + 1) * ww) - x - 1, kh); );
      nt == u_kbn ? ( gfx_set(0, 0, 0, 0.18); gfx_rect(x + 1, y0, floor(x0 + (wi + 1) * ww) - x - 1, kh); );
      k - 12 * floor(k / 12) == 0 ? (
        gfx_set(0.35, 0.35, 0.37, 1);
        sprintf(#u_t, "C%d", floor(nt / 12) - 1);
        ui_ctext(#u_t, (x + floor(x0 + (wi + 1) * ww)) * 0.5, y0 + kh - 10 * uscale, 11 * uscale, 0);
      );
      wi += 1;
    );
    k += 1;
  );
  k = 0;
  loop(25,
    !ui_iswhite(k) ? (
      nt = n0 + k;
      bx = x0 + (floor(k / 12) * 7 + (k - 12 * floor(k / 12) == 1 ? 1 : k - 12 * floor(k / 12) == 3 ? 2 : k - 12 * floor(k / 12) == 6 ? 4 : k - 12 * floor(k / 12) == 8 ? 5 : 6)) * ww - bw * 0.5;
      gfx_set(0.08, 0.08, 0.085, 1);
      gfx_rect(floor(bx), y0, floor(bw), bh);
      lit = KLIT[nt];
      lit > 0 ? ( gfx_set(1, 0.1, 0.1, 0.35 + 0.6 * lit); gfx_rect(floor(bx), y0, floor(bw), bh); );
      nt == u_kbn ? ( gfx_set(1, 1, 1, 0.2); gfx_rect(floor(bx), y0, floor(bw), bh); );
    );
    k += 1;
  );
);

function ui_obtn(lab, x, y, w, h, id) local(hov)
(
  hov = ui_hit(x, y, w, h);
  gfx_set(hov ? 0.36 : 0.27, hov ? 0.36 : 0.27, hov ? 0.37 : 0.28, 1);
  gfx_rect(floor(x), floor(y), floor(w), floor(h));
  gfx_set(1, 1, 1, 1);
  ui_ctext(lab, x + w * 0.5, y + h * 0.5, 15 * uscale, 1);
  hov ? u_hov = id;
  (hov && u_click) ? ( u_click = 0; 1; ) : 0;
);

function ui_hint(h) local(v, s)
(
  h == 104 ? strcpy(#u_hint, "Click the picture to switch the animation off or on") :
  h == 100 ? strcpy(#u_hint, "Click to play, lower on the key is louder") :
  h == 101 ? strcpy(#u_hint, "Keyboard octave down") :
  h == 102 ? strcpy(#u_hint, "Keyboard octave up") :
  h >= 1 && h <= 27 ? (
    v = slider(h);
    h == 1 ? sprintf(#u_t, "%+d", v) :
    h == 2 ? sprintf(#u_t, "%+.2f semitones", v * 12) :
    h == 3 ? sprintf(#u_t, "%+.1f cents", v * 1200) :
    h == 4 ? sprintf(#u_t, "%d %s", v, 200 + floor(v + 0.5)) :
    h == 6 ? sprintf(#u_t, "%d %s", v, 330 + floor(v + 0.5)) :
    h == 8 ? sprintf(#u_t, "%d %s", v, 380 + floor(v + 0.5)) :
    h == 15 ? sprintf(#u_t, "%s (click cycles, hold or right-click for bypass)", 440 + floor(v + 0.5)) :
    h == 23 ? sprintf(#u_t, "%s", 420 + floor(v + 0.5)) :
    h == 25 ? sprintf(#u_t, "%d", v) :
    h == 27 ? sprintf(#u_t, "%+.1f dB", v) :
    (h >= 16 && h <= 26) ? strcpy(#u_t, v > 0.5 ? "On" : "Off") :
    sprintf(#u_t, "%.1f %%", v * 100);
    sprintf(#u_hint, "%s: %s", 460 + h, #u_t);
  ) : strcpy(#u_hint, "Double-click a knob to reset, Ctrl-drag for fine control");
);

!u_init ? ( ui_inittables(); u_init = 1; u_kbn = -1; u_kbo = 3; u_wcb = -1; );

function lt_dx(y) ( y < 193 ? lt_th * (193 - y) : 0; );
function lt_dy(y) ( y < 193 ? -lt_b * min(1, (193 - y) / 90) : 0; );

function ls_h(n) ( n = sin(n * 12.9898 + 78.233) * 43758.5453; n - floor(n); );
function ls_n(x) local(i, f) ( i = floor(x); f = x - i; f = f * f * (3 - 2 * f); ls_h(i) * (1 - f) + ls_h(i + 1) * f; );

function ls_snd() local(i, p, e)
(
  e = 0; i = 0;
  loop(16, p = VST + i * VSS; i < floor(tf_voices + 0.5) ? e = max(e, p[25]); i += 1; );
  e > 0.002;
);

function ls_bin(bsv, x, y, w, h, ay) local(v, xa, ya, ox, oy)
(
  v = (bsv - ls_p) / 60;
  v = abs(v) < 2.6 ? exp(-v * v) * (0.8 + 0.2 * sin(bsv * 0.21 - ls_t * 3)) : 0;
  v > 0.01 ? (
    gfx_a = 0.9 * v;
    ox = lt_dx(y + h * 0.5); oy = lt_dy(y + h * 0.5);
    xa = floor(ls_ox + (x + ox) * ls_s); ya = floor(ls_oy + (y + oy) * ls_s);
    gfx_blit(ls_img, 1, 0, 0, ay * ls_k, w * ls_k, h * ls_k, xa, ya, floor(ls_ox + (x + ox + w) * ls_s) - xa, floor(ls_oy + (y + oy + h) * ls_s) - ya);
  );
);

function ui_torso(t, on) local(k, img, s, pox, poy, r, y, ya, yb, xa, xb, dt)
(
  lt_amp = on ? lt_amp + (1 - lt_amp) * 0.02 : lt_amp * 0.97;
  lt_amp < 0.002 ? lt_amp = 0;
  dt = min(0.1, max(0, t - lt_t)); lt_t = t;
  lt_ph += dt * (0.85 + 0.3 * ls_n(t * 0.05 + 2)) / 4.6;
  lt_th = lt_amp * (1.8 * sin(2 * $pi * t / 7.3 + 2.5 * ls_n(t * 0.04 + 1)) + 1.0 * (2 * ls_n(t * 0.13 + 5) - 1) + 0.4 * (2 * ls_n(t * 0.45 + 8) - 1)) / 133;
  lt_b = lt_amp * 0.9 * (0.5 - 0.5 * cos(2 * $pi * lt_ph));
  (g_to && lt_amp > 0) ? (
    k = (g_to2 && uscale > 1.25) ? 2 : 1; img = k == 2 ? 29 : 28;
    s = uscale; pox = 0; poy = ui_py(24.5);
    gfx_set(1, 1, 1, 1);
    xa = pox; xb = min(floor(pox + 228 * s), u_sbr - max(1, floor(UQ + 0.5)));
    r = 0;
    loop(193 * k,
      y = r / k;
      ya = floor(poy + y * s); yb = floor(poy + (y + 1 / k) * s);
      yb > ya ? gfx_blit(img, 1, 0, (6 - lt_dx(y)) * k, r - lt_dy(y) * k, (xb - xa) / s * k, 1, xa, ya, xb - xa, yb - ya);
      r += 1;
    );
  );
);

function ui_hair(t, on) local(k, img, s, pox, poy, r, y, wv, dx, ya, yb, g, xa, xb, pos, v, hs)
(
  lh_amp = on ? lh_amp + (1 - lh_amp) * 0.02 : lh_amp * 0.97;
  lh_amp < 0.002 ? lh_amp = 0;
  (g_hr && lh_amp > 0) ? (
    k = (g_hr2 && uscale > 1.25) ? 2 : 1; img = k == 2 ? 27 : 26;
    s = uscale; pox = 0; poy = ui_py(24.5);
    g = lh_amp * 2.2 * (0.6 + 0.4 * ls_n(t * 0.15 + 3));
    pos = t / 9.5; pos = 30 + 400 * (pos - floor(pos));
    hs = (g_hs && (k == 1 || g_hs2)) ? (k == 2 ? 33 : 32) : -1;
    gfx_set(1, 1, 1, 1);
    xa = pox; xb = floor(pox + 80 * s);
    r = 0;
    loop(296 * k,
      y = 56 + r / k;
      wv = min(1, max(0, (y - 75) / 90)); wv *= sqrt(wv);
      dx = g * wv * (0.6 * sin(t * 1.4 - y * 0.025) + 0.4 * sin(t * 2.17 - y * 0.041 + 1.3));
      ya = floor(poy + y * s); yb = floor(poy + (y + 1 / k) * s);
      yb > ya ? (
        gfx_blit(img, 1, 0, (8 - dx - lt_dx(y)) * k, r - lt_dy(y) * k, 80 * k, 1, xa, ya, xb - xa, yb - ya);
        v = (y - pos) / 35;
        (hs >= 0 && abs(v) < 2.6) ? (
          gfx_mode = 1; gfx_a = lh_amp * 0.9 * exp(-v * v) * (0.8 + 0.2 * sin(y * 0.23 - t * 2.2));
          gfx_blit(hs, 1, 0, (8 - dx - lt_dx(y)) * k, r - lt_dy(y) * k, 80 * k, 1, xa, ya, xb - xa, yb - ya);
          gfx_mode = 0; gfx_a = 1;
        );
      );
      r += 1;
    );
  );
);

function ui_fern(t) local(k, img, s, pox, poy, r, y, wf, dx, ya, yb, g, xa, xb, td)
(
  (g_fe && lh_amp > 0) ? (
    k = (g_fe2 && uscale > 1.25) ? 2 : 1; img = k == 2 ? 31 : 30;
    s = uscale; pox = 0; poy = ui_py(24.5);
    td = t - 0.6;
    g = lh_amp * 1.6 * (0.6 + 0.4 * ls_n(td * 0.15 + 3));
    gfx_set(1, 1, 1, 1);
    xa = pox; xb = floor(pox + 80 * s);
    ya = floor(poy + 448 * s); yb = floor(poy + 552 * s);
    gfx_blit(img, 1, 0, 4 * k, 0, (xb - xa) / s * k, 104 * k, xa, ya, xb - xa, yb - ya);
    r = 0;
    loop(104 * k,
      y = 448 + r / k;
      wf = min(1, max(0, (548 - y) / 75)); wf *= sqrt(wf);
      dx = g * wf * (0.6 * sin(td * 1.4 - y * 0.025) + 0.4 * sin(td * 2.17 - y * 0.041 + 1.3));
      ya = floor(poy + y * s); yb = floor(poy + (y + 1 / k) * s);
      yb > ya ? gfx_blit(img, 1, 0, (4 - dx) * k, 104 * k + r, 80 * k, 1, xa, ya, xb - xa, yb - ya);
      r += 1;
    );
  );
);

function ui_light(t, on) local(s, pox, poy, x0, x1, y0, y1, p, ph, c, u, env, cx, cy, lrad, lint, j, rr, aa, yy, w, xa, xb, ya, st, lw)
(
  lf_amp = on ? lf_amp + (1 - lf_amp) * 0.02 : lf_amp * 0.97;
  lf_amp < 0.002 ? lf_amp = 0;
  lf_amp > 0 ? (
    s = uscale; pox = 0; poy = ui_py(24.5);
    lw = max(1, floor(UQ + 0.5));
    x0 = pox; x1 = u_sbr - lw;
    y0 = floor(ui_py(24.5) - UQ * 0.5) + lw; y1 = floor(ui_py(326) - UQ * 0.5);
    st = max(1, floor(s));
    gfx_mode = 1;
    p = 0;
    loop(3,
      ph = t / (8 + 3.7 * p) + 0.37 * p; c = floor(ph); u = ph - c;
      env = sin($pi * u); env *= env;
      cx = 15 + 198 * ls_h(c * 3.1 + p * 7.7) + 18 * (u - 0.5) * (2 * ls_h(c * 1.9 + p) - 1);
      cy = 30 + 500 * ls_h(c * 5.3 + p * 2.9) + 10 * (u - 0.5);
      lrad = (30 + 26 * ls_h(c * 7.1 + p * 4.3)) * s;
      lint = lf_amp * env * 0.14;
      cx = pox + cx * s; cy = poy + cy * s;
      j = 0;
      lint > 0.002 ? loop(4,
        rr = lrad * (1 - j * 0.2); aa = lint * (j == 0 ? 0.12 : j == 1 ? 0.18 : j == 2 ? 0.25 : 0.45);
        yy = -rr;
        while (yy < rr) (
          ya = floor(cy + yy);
          w = sqrt(max(0, rr * rr - (yy + st * 0.5) * (yy + st * 0.5)));
          xa = max(x0, floor(cx - w)); xb = min(x1, floor(cx + w));
          (ya >= y0 && ya + st <= y1 && xb > xa) ? (
            gfx_a = aa; gfx_blit(gfx_dest, 1, 0, xa, ya, xb - xa, st, xa, ya, xb - xa, st);
            gfx_set(1, 0.75, 0.4, aa * 0.12, 1); gfx_rect(xa, ya, xb - xa, st);
          );
          yy += st;
        );
        j += 1;
      );
      p += 1;
    );
    gfx_mode = 0; gfx_a = 1;
  );
);

function ui_snake() local(on, t, s, pox, poy, a, tau, ext, tl, wig, n, m, i, j, q, px, py, qx, qy, ax, ay, fx, fy)
(
  !ls_t0 ? ( ls_t0 = time_precise(); ls_wv = ls_fs = -1000; ls_tot = 1050.58; );
  t = time_precise() - ls_t0;
  on = ((play_state & 1) || ls_snd()) && tf_anim >= 0.5;
  (on && !ls_on) ? ls_next = t + 0.5;
  ls_on = on;
  ui_torso(t, on);
  ui_hair(t, on);
  ui_fern(t);
  (on && t >= ls_next) ? ( ls_fs = t; ls_next = t + 1.4 + 2.4 * ls_h(floor(t * 7.3)); );
  (on && t - ls_wv > 15.5) ? ls_wv = t;
  s = uscale; pox = 0; poy = ui_py(24.5);
  a = t - ls_wv;
  (g_sn && a < (ls_tot + 240) / 90) ? (
    ls_t = t; ls_p = a * 90 - 120; ls_s = s; ls_ox = pox; ls_oy = poy;
    ls_k = (g_sn2 && s > 1.25) ? 2 : 1; ls_img = ls_k == 2 ? 25 : 24;
    gfx_mode = 1;
    ls_bin(0, 188, 559, 19, 13, 0);
    ls_bin(22.35, 164, 555, 41, 17, 13);
    ls_bin(44.71, 135, 550, 41, 12, 30);
    ls_bin(67.06, 111, 547, 47, 18, 42);
    ls_bin(89.41, 89, 545, 45, 19, 60);
    ls_bin(111.76, 66, 536, 45, 25, 79);
    ls_bin(134.12, 50, 533, 38, 25, 104);
    ls_bin(156.47, 42, 520, 43, 31, 129);
    ls_bin(178.82, 66, 505, 39, 31, 160);
    ls_bin(201.18, 74, 503, 48, 33, 191);
    ls_bin(223.53, 101, 488, 37, 43, 224);
    ls_bin(245.88, 106, 472, 32, 42, 267);
    ls_bin(268.23, 89, 471, 49, 23, 309);
    ls_bin(290.59, 68, 470, 38, 24, 332);
    ls_bin(312.94, 67, 470, 17, 38, 356);
    ls_bin(335.29, 74, 507, 1, 1, 394);
    ls_bin(402.35, 98, 407, 9, 13, 395);
    ls_bin(424.7, 79, 407, 39, 28, 408);
    ls_bin(447.06, 77, 411, 25, 43, 436);
    ls_bin(469.41, 85, 446, 12, 13, 479);
    ls_bin(625.88, 68, 261, 15, 28, 492);
    ls_bin(648.23, 68, 257, 47, 32, 520);
    ls_bin(670.59, 70, 255, 66, 30, 552);
    ls_bin(692.94, 89, 254, 53, 22, 582);
    ls_bin(715.29, 113, 256, 32, 16, 604);
    ls_bin(737.64, 139, 263, 6, 4, 620);
    ls_bin(983.53, 48, 93, 31, 27, 624);
    ls_bin(1005.88, 54, 89, 46, 21, 651);
    ls_bin(1028.23, 78, 89, 39, 23, 672);
    ls_bin(1050.58, 91, 91, 30, 24, 695);
    gfx_mode = 0; gfx_a = 1;
  );
  tau = t - ls_fs;
  (tau < 0.55) ? (
    ext = tau < 0.07 ? tau / 0.07 : tau > 0.47 ? (0.55 - tau) / 0.08 : 1;
    tl = 5 * ext;
    wig = 1.1 * ext * sin(tau * 56.5);
    pox += lt_dx(108) * s; poy += lt_dy(108) * s;
    n = max(1, floor(s * 0.8 + 0.5));
    m = 0;
    loop(2,
      gfx_set(0.30, 0.14, 0.09, m ? 0.6 : 0.2);
      px = 115.2; py = 107.9; i = 1;
      loop(6,
        q = i / 6;
        qx = 115.2 + 0.9 * tl * q - 0.43 * wig * q * q;
        qy = 107.9 + 0.43 * tl * q + 0.9 * wig * q * q;
        j = m ? 0 : -1;
        loop(m ? (q < 0.6 ? n : 1) : (q < 0.6 ? n + 2 : 2),
          gfx_line(pox + px * s, poy + py * s + j, pox + qx * s, poy + qy * s + j, 1);
          j += 1;
        );
        px = qx; py = qy; i += 1;
      );
      ext > 0.7 ? (
        ax = 0.9 * 0.93 - 0.43 * 0.37; ay = 0.43 * 0.93 + 0.9 * 0.37;
        fx = 0.9 * 0.93 + 0.43 * 0.37; fy = 0.43 * 0.93 - 0.9 * 0.37;
        gfx_line(pox + px * s, poy + py * s, pox + (px + 1.7 * ax) * s, poy + (py + 1.7 * ay) * s, 1);
        gfx_line(pox + px * s, poy + py * s, pox + (px + 1.7 * fx) * s, poy + (py + 1.7 * fy) * s, 1);
      );
      m += 1;
    );
  );
  ui_light(t, on);
);

