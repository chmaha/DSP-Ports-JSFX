function circ(a) local(p, n, sh)
(
  p = a > 0 ? a : 0;
  n = a < 0 ? a : 0;
  sh = trunc(((p * 0.5) + 0.5));
  sh = (sh * 2);
  p = (p - sh);
  sh = trunc(((abs(n) * 0.5) + 0.5));
  sh = (sh * 2);
  n = (n + sh);
  (p + n);
);
function lerp(a, b, t) ( (a + (t * (b - a))); );
function mwc_next() local(z, w)
(
  w_w = 36969 * (w_w - floor(w_w / 65536) * 65536) + floor(w_w / 65536);
  w_w = w_w - floor(w_w / 4294967296) * 4294967296;
  w_z = 18000 * (w_z - floor(w_z / 65536) * 65536) + floor(w_z / 65536);
  w_z = w_z - floor(w_z / 4294967296) * 4294967296;
  z = (w_w - floor(w_w / 65536) * 65536) * 65536 + w_z;
  z - floor(z / 4294967296) * 4294967296;
);
function u2f(n) local(e, ulp, q, r, fr)
(
  n < 16777216 ? n : (
    e = floor(log(n) / log(2));
    (2 ^ e) > n ? e -= 1;
    (2 ^ (e + 1)) <= n ? e += 1;
    ulp = 2 ^ (e - 23);
    q = n / ulp; r = floor(q); fr = q - r;
    fr > 0.5 ? r += 1 : fr === 0.5 ? ( (r - 2 * floor(r / 2)) == 1 ? r += 1; );
    r * ulp;
  );
);

function shp_a(a, f, md) local(x, y, z, m, c, den, mask, ff, k, x1, x2, mid, hi, ai, s, rnd, b, cc)
(
  md == 0 ? (
    x = ((1 - f) * 0.5);
    mask = a < x;
    den = mask ? x : (1 - x);
    m = (0.5 / den);
    c = (0.5 - (m * x));
    mask ? (m * a) : ((m * a) + c);
  ) : md == 1 ? (
    x = abs((f * 3));
