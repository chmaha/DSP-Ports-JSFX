function vsin(x) local(x2, x3, x5, x7, x9, o)
(
  x2 = (x * x); x3 = (x2 * x); x5 = (x2 * x3); x7 = (x2 * x5); x9 = (x2 * x7);
  o = (x - (x3 * SC3));
