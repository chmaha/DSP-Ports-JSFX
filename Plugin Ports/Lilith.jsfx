function shaper(a, f, md) ( md < 7 ? shp_a(a, f, md) : md < 14 ? shp_b(a, f, md) : md < 18 ? shp_c(a, f, md) : shp_d(a, f, md); );

function mirr(a, f) local(x, y, z)
