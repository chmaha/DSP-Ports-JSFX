function automate(s, e)
(
<?
  max_sliders > 27 ? printf("slider_automate(2^(s-1), e);") : (
    printf("s == 1 ? slider_automate(tf_oct, e) : s == 2 ? slider_automate(tf_coarse, e) : s == 3 ? slider_automate(tf_fine, e) : s == 4 ? slider_automate(tf_bank, e) :\n");
    printf("s == 5 ? slider_automate(tf_wave, e) : s == 6 ? slider_automate(tf_stype, e) : s == 7 ? slider_automate(tf_sdep, e) : s == 8 ? slider_automate(tf_etype, e) :\n");
    printf("s == 9 ? slider_automate(tf_edep, e) : s == 10 ? slider_automate(tf_att, e) : s == 11 ? slider_automate(tf_dec, e) : s == 12 ? slider_automate(tf_skew, e) :\n");
    printf("s == 13 ? slider_automate(tf_sublvl, e) : s == 14 ? slider_automate(tf_subwave, e) : s == 15 ? slider_automate(tf_lpgmode, e) : s == 16 ? slider_automate(tf_long, e) :\n");
    printf("s == 17 ? slider_automate(tf_vel, e) : s == 18 ? slider_automate(tf_trig, e) : s == 19 ? slider_automate(tf_swap, e) : s == 20 ? slider_automate(tf_postpm, e) :\n");
    printf("s == 21 ? slider_automate(tf_lfo, e) : s == 22 ? slider_automate(tf_zero, e) : s == 23 ? slider_automate(tf_syncm, e) : s == 24 ? slider_automate(tf_m12, e) :\n");
    printf("s == 25 ? slider_automate(tf_voices, e) : s == 26 ? slider_automate(tf_syncnote, e) : s == 27 ? slider_automate(tf_vol, e) : s == 28 ? slider_automate(tf_anim, e) : 0;");
  );
?>
  0;
);

function ui_min(s) ( s == 1 ? -3 : s == 2 ? -1 : s == 3 ? -0.041666 : s == 25 ? 1 : s == 27 ? -24 : 0; );
function ui_max(s) ( s == 1 ? 3 : s == 3 ? 0.041666 : s == 4 ? 63 : s == 6 ? 26 : s == 8 ? 10 : s == 15 ? 3 : s == 23 ? 15 : s == 25 ? 16 : s == 27 ? 12 : 1; );
function ui_def(s) ( s == 11 ? 0.5 : s == 15 ? 1 : s == 25 ? 8 : s == 28 ? 1 : 0; );
function ui_stp(s) ( (s == 1 || s == 4 || s == 6 || s == 8 || (s >= 15 && s <= 26) || s == 28) ? 1 : s == 3 ? 0.0001 : s == 27 ? 0.1 : 0.001; );
function ui_norm(s) ( (slider(s) - ui_min(s)) / (ui_max(s) - ui_min(s)); );
function ui_set(s, x) local(lo, hi, st, nv, old)
(
  lo = ui_min(s); hi = ui_max(s); st = ui_stp(s);
  nv = max(lo, min(hi, x));
  nv = lo + floor((nv - lo) / st + 0.5) * st;
  nv = max(lo, min(hi, nv));
  old = slider(s);
  slider(s) = nv;
  nv !== old ? automate(s, 0);
);
function ui_setn(s, n) ( ui_set(s, ui_min(s) + max(0, min(1, n)) * (ui_max(s) - ui_min(s))); );
function ui_put(s, x) ( ui_set(s, x); automate(s, 1); );

function ui_px(u) ( uox + u * UQ; );
function ui_py(v) ( v * UQ; );
function ui_dx(x) ( uox + x * uscale; );
function ui_dy(y) ( y * uscale; );
function ui_hit(x, y, w, h) ( mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + h; );
function ui_hitc(cx, cy, r) ( sqr(mouse_x - cx) + sqr(mouse_y - cy) <= sqr(r); );

function ui_split(src, base) local(n, i, c, st, k)
(
  n = strlen(src); i = 0; st = 0; k = 0;
  loop(n + 1,
    c = i < n ? str_getchar(src, i) : 124;
    c == 124 ? ( strcpy_substr(base + k, src, st, i - st); k += 1; st = i + 1; );
    i += 1;
  );
  k;
);

