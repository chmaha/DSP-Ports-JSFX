function bxor32(x, y) local(xh, xl, yh, yl)
(
  xh = floor(x / 65536); xl = x - xh * 65536;
  yh = floor(y / 65536); yl = y - yh * 65536;
  (xh ~ yh) * 65536 + (xl ~ yl);
);

function fbits(x) local(s, a, e, m)
(
  s = (x < 0 || (x === 0 && (1 / x) < 0)) ? 2147483648 : 0;
  a = abs(x);
  a === 0 ? s : (
    e = floor(log(a) / log(2));
    (2 ^ e) > a ? e -= 1;
    (2 ^ (e + 1)) <= a ? e += 1;
    m = (a / (2 ^ e) - 1) * 8388608;
    s + (e + 127) * 8388608 + m;
  );
);
function bitsf(u) local(s, ex, man)
(
  s = u >= 2147483648 ? -1 : 1;
  u >= 2147483648 ? u -= 2147483648;
  ex = floor(u / 8388608); man = u - ex * 8388608;
  ex === 0 ? 0 : s * (1 + man / 8388608) * (2 ^ (ex - 127));
);

EINV = 46.16624130844683;
ESH = 6755399441055744;
EC0 = 0.0000016938359250920212;
EC1 = 0.00023459809789509004;
EC2 = 0.021660849396613134;
function expf_emu(x) local(z, kd, r, ki, i, k, s, zz, r2, y)
(
  z = EINV * x;
  kd = (z + ESH) - ESH;
  r = z - kd;
  ki = kd;
  i = ki - floor(ki / 32) * 32;
  k = (ki - i) / 32;
  s = ET[i] * (2 ^ k);
  zz = EC0 * r + EC1;
  r2 = r * r;
  y = EC2 * r + 1;
  y = zz * r2 + y;
  y = y * s;
  (y);
);

function sm_log(x) local(e, m, ef, mask, z, y, tmp, xx)
(
  x <= 0 ? -1000000 : (
    x = smax(x, 0.000000000000000000000000000000000000011754943508222875);
    ef = floor(log(x) / log(2));
    (2 ^ ef) > x ? ef -= 1;
    (2 ^ (ef + 1)) <= x ? ef += 1;
    m = x / (2 ^ (ef + 1));
    e = (ef + 1);
    mask = m < 0.7071067690849304;
    xx = (m - 1);
    e = (e - (mask ? 1 : 0));
    xx = mask ? (xx + m) : xx;
    z = (xx * xx);
    y = 0.07037683576345444;
    y = (y * xx); y = (y + -0.11514610052108765);
    y = (y * xx); y = (y + 0.11676998436450958);
    y = (y * xx); y = (y + -0.12420140951871872);
    y = (y * xx); y = (y + 0.14249323308467865);
    y = (y * xx); y = (y + -0.16668057441711426);
    y = (y * xx); y = (y + 0.2000071406364441);
    y = (y * xx); y = (y + -0.24999994039535522);
    y = (y * xx); y = (y + 0.3333333134651184);
    y = (y * xx);
    y = (y * z);
    tmp = (e * -0.00021219444170128554);
    y = (y + tmp);
    tmp = (z * 0.5);
    y = (y - tmp);
    tmp = (e * 0.693359375);
    xx = (xx + y);
    (xx + tmp);
  );
);

function sm_exp(x) local(fx, tmp, mask, z, y, n)
(
  x = smin(x, 88.37625885009766);
  x = smax(x, -88.37625885009766);
  fx = (x * 1.4426950216293335);
  fx = (fx + 0.5);
  tmp = cvtt(fx);
  mask = tmp > fx;
  fx = (tmp - (mask ? 1 : 0));
  tmp = (fx * 0.693359375);
  z = (fx * -0.00021219444170128554);
  x = (x - tmp);
  x = (x - z);
  z = (x * x);
  y = 0.00019875691214110702;
  y = (y * x); y = (y + 0.001398199936375022);
  y = (y * x); y = (y + 0.008333452045917511);
  y = (y * x); y = (y + 0.04166579619050026);
  y = (y * x); y = (y + 0.1666666567325592);
  y = (y * x); y = (y + 0.5);
  y = (y * z);
  y = (y + x);
  y = (y + 1);
  n = cvtt(fx);
  (y * (2 ^ n));
);

SC3 = 0.1666666716337204; SC5 = 0.008333333767950535; SC7 = 0.00019841270113829523; SC9 = 0.0000027557318844628753;
CC2 = 0.5; CC4 = 0.0416666679084301; CC6 = 0.0013888889225199819; CC8 = 0.000024801587642286904;
