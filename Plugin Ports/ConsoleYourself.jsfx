      knob(142 + x * 237, 358, x ? 53 : 44, "RELEASE", x, 0);
      knob(42 + x * 237, 420, x ? 54 : 45, "VIB DEPTH", x, 0);
      knob(92 + x * 237, 420, x ? 55 : 46, "VIB RATE", x, 0);
      knob(142 + x * 237, 420, x ? 57 : 49, "DETUNE", x, 1);
