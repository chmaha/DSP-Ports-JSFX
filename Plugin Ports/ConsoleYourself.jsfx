pce_blk = 1400000; pce_freq = 1400000; pce_ctl = 1400006; pce_bal = 1400012; pce_idx = 1400018; pce_dda = 1400024; pce_nc = 1400030; pce_ncnt = 1400036; pce_seed = 1400042; pce_tick = 1400048; pce_ll = 1400054; pce_lr = 1400060; pce_wave = 1400066; pce_sc = 1401000; pce_vt = 1401020; pce_waves = 1401100; 
sn_blk = 1402000; sn_reg = 1402000; sn_buf = 1402128; sn_bp = 1402320; sn_ip = 1402328; sn_ba = 1402336; sn_bo = 1402344; sn_kd = 1402352; sn_em = 1402360; sn_env = 1402368; sn_he = 1402376; sn_vl = 1402384; sn_vr = 1402392; sn_eh = 1402400; sn_cnt = 1402432; sn_csel = 1403000; sn_cmask = 1403040; sn_shift = 1403080; sn_gauss = 1403200; sn_tms = 1404100; sn_firt = 1404200; snram = 2000000; sn_sil = 3500000; sn_bd = 3500032; sn_txt = 4031000; sn_it = 4065000; sn_dk = 4067000; sn_xa = 4068000; sn_lo = 4069000; sn_view = 4070000; sn_cat = 4097000; sn_bk = 4098000; sn_lch = 4099000;
sn_ln = 4115100; v6 = 4112000; vx = 4110000; v7rom = 4111000; v7ksl = 4111200; v7pms = 4111220; x7b = 4111300; v7w = 4113000;
vx_ph = vx + 64; vx_env = vx + 76; vx_est = vx + 88; vx_kst = vx + 100; vx_kl = vx + 112; vx_wv = vx + 124; vx_ps = vx + 136;
vx_tl = vx + 148; vx_sl = vx + 160; vx_rt = vx + 172; vx_mul = vx + 232; vx_bf = vx + 244; vx_am = vx + 256; vx_pm = vx + 268;
vx_fb0 = vx + 280; vx_fb1 = vx + 286; vx_fbi = vx + 292; vx_ip = vx + 298; vx_act = vx + 304; vx_pq = vx + 310; vxn = 326;
v6k = 95.88 / (8128 / 15 + 100) / 15; v6ks = v6k * 30 / 31;
scope = 206000; kdown = 211000; vact = 211200; gq = 211400; chp = 202900; glast = 202930; dk_ofs = 3349000; dk_len = 3349040; dk_buf = 3350000;

// ---------------------------------------------------------------------- band-limited steps
function bl_init() local(n, m, t, w, s, x, i0, k, p, a) (
  n = BLW * BLP;
  m = 0;
  loop(n + 1,
    t = m / BLP - BLW / 2;
    x = 2 * m / n - 1; x = 7 * sqrt(max(0, 1 - x * x));
    i0 = 1; a = 1; k = 1;
    loop(25, a *= (x / (2 * k)) * (x / (2 * k)); i0 += a; k += 1; );
    s = abs(t) < 0.000001 ? 0.92 : sin(0.92 * $pi * t) / ($pi * t);
    bl_s[m] = s * i0;
    m += 1;
  );
  a = 0; m = 0; w = bl_s[0];
  loop(n + 1, t = bl_s[m]; bl_s[m] = a + (m ? (w + t) * 0.5 : 0); a = bl_s[m]; w = t; m += 1; );
  m = 0; loop(n + 1, bl_s[m] /= a; m += 1; );
  p = 0;
  loop(BLP,
    k = 0; s = 0;
    loop(BLW,
      m = k * BLP - p;
      x = (m >= 0 ? bl_s[m] : 0) - (m - BLP >= 0 ? bl_s[m - BLP] : 0);
      bl_k[p * BLW + k] = x; s += x;
      k += 1;
    );
    bl_k[p * BLW + BLW - 1] += 1 - s;
    p += 1;
  );
);

function blep(b, pos, d) local(n, k) (
  n = floor(pos);
  b += n; k = bl_k + floor((pos - n) * BLP) * BLW;
  loop(BLW / 4, b[0] += d * k[0]; b[1] += d * k[1]; b[2] += d * k[2]; b[3] += d * k[3]; b += 4; k += 4; );
);

function gb_put(pos, d, l, r) (
  l == r ? blep(busc, pos, d * l) : ( l ? blep(busa, pos, d * l); r ? blep(busb, pos, d * r); );
);

function nes_emit(id, t, d) local(k) (
  k = nev[id]; nev[id] = k + 1;
  k += id * 16384; evt[k] = t; evd[k] = d;
);

function nes_flush() local(g, i, j, a, b, c, t, k, o, x) (
  g = 0;
  loop(2,
    a = g ? 2 : 0; b = g ? 5 : 2;
    c = a; loop(b - a, evi[c] = 0; c += 1; );
    o = g ? 159.79 * nz_ / (1 + 100 * nz_) : 95.88 * np_ / (8128 + 100 * np_);
    while (
      k = -1; i = a;
      loop(b - a, evi[i] < nev[i] && (k < 0 || evt[i * 16384 + evi[i]] < t) ? ( k = i; t = evt[i * 16384 + evi[i]]; ); i += 1; );
      k >= 0 ? (
        j = k * 16384 + evi[k]; evi[k] += 1;
        nlv[k] += evd[j];
        g ? ( nz_ = nlv[2] * 0.00012155 + nlv[3] * 0.000081693 + nlv[4] * 0.000044174; x = 159.79 * nz_ / (1 + 100 * nz_); )
          : ( np_ = nlv[0] + nlv[1]; x = 95.88 * np_ / (8128 + 100 * np_); );
        x != o ? ( blep(busa, (t - blk_t0) * spc + 1, x - o); o = x; );
      );
      k >= 0;
    );
    g += 1;
  );
  memset(nev, 0, 5);
);

function sms_emit(ch, t, l) local(a, d) (
  a = l == 15 ? 0 : sms_g * 1.258925412 ^ -l;
  ch += 1; d = a - gba[ch]; gba[ch] = a;
  d ? gb_put((t - sms_t0) * sms_spc + 1, d, gbl[ch], gbr[ch]);
);

function pce_emit(ch, t, l, r) local(pos) (
  pos = (t - blk_t0) * spc + 1;
  l == r ? blep(busc, pos, l / 32768) : ( l ? blep(busa, pos, l / 32768); r ? blep(busb, pos, r / 32768); );
);

function gb_emit(ch, t, on, v, dac) local(a, d, pos) (
  a = dac ? ( on ? 15 - 2 * v : 15 ) : 0;
  d = a - gba[ch]; gba[ch] = a;
  d ? gb_put((t - blk_t0) * spc + 1, d, gbl[ch], gbr[ch]);
);

// ---------------------------------------------------------------------------------------
function nes_setreg(r, d) instance(r0, r1, r2, r3, w0, w1, w2, w3) (
  r == 0 ? ( r0 = d; w0 = 1; ) : r == 1 ? ( r1 = d; w1 = 1; ) : r == 2 ? ( r2 = d; w2 = 1; ) : ( r3 = d; w3 = 1; );
);
function nes_len(hm) instance(lc, r0) ( lc && !(r0 & hm) ? lc -= 1; );
function nes_per() instance(r2, r3) ( (r3 & 7) * 256 + r2; );
function nes_env() instance(r0, w3, env, envd) (
  w3 ? ( w3 = 0; envd = r0 & 15; env = 15; ) :
  (envd -= 1) < 0 ? ( envd = r0 & 15; (env | (r0 & 32)) ? env = (env + 15) & 15; );
);
function nes_vol() instance(lc, r0, env) ( lc == 0 ? 0 : (r0 & 16) ? r0 & 15 : env; );

function sq_sweep(adj) instance(r1, r2, r3, w1, swd) local(p, s, o) (
  (swd -= 1) < 0 ? (
    w1 = 1;
    p = this.nes_per();
    s = r1 & 7;
    (s && (r1 & 128) && p >= 8) ? (
      o = p >> s;
      r1 & 8 ? o = adj - o;
      p + o < 2048 ? ( p += o; r2 = p & 255; r3 = r3 - (r3 & 7) + ((p >> 8) & 7); );
    );
  );
  w1 ? ( w1 = 0; swd = (r1 >> 4) & 7; );
);
function sq_run(t, e) instance(r0, r1, id, delay, amp, phase) local(v, p, o, tp, ds, du, a, dl, ph) (
  v = this.nes_vol();
  p = this.nes_per();
  o = p >> (r1 & 7);
  r1 & 8 ? o = 0;
  tp = (p + 1) * 2;
  (v == 0 || p < 8 || p + o >= 2048) ? (
    amp ? ( nes_emit(id, t, -amp); amp = 0; );
    t += delay;
    t < e ? ( o = floor((e - t + tp - 1) / tp); phase = (phase + o) & 7; t += o * tp; );
  ) : (
    ds = (r0 >> 6) & 3;
    du = 1 << ds;
    a = 0;
    ds == 3 ? ( du = 2; a = v; );
    phase < du ? a = a ~ v;
    dl = a - amp; amp = a;
    dl ? nes_emit(id, t, dl);
    t += delay;
    t < e ? (
      dl = a * 2 - v;
      ph = phase;
      while (
        ph = (ph + 1) & 7;
        (ph == 0 || ph == du) ? ( dl = -dl; nes_emit(id, t, dl); );
        t += tp;
        t < e;
      );
      amp = (dl + v) * 0.5;
      phase = ph;
    );
  );
  delay = t - e;
);

function tri_amp() instance(phase) local(a) ( a = 16 - phase; a < 0 ? a = phase - 17; a; );
function tri_lin() instance(r0, w3, lin) (
  w3 ? lin = r0 & 127 : lin ? lin -= 1;
  !(r0 & 128) ? w3 = 0;
);
function tri_run(t, e) instance(lc, lin, id, delay, amp, phase) local(dl, tp, ph, v) (
  dl = this.tri_amp() - amp; amp += dl;
  dl ? nes_emit(id, t, dl);
  t += delay;
  tp = this.nes_per() + 1;
  (lc == 0 || lin == 0 || tp < 3) ? t = e : t < e ? (
    ph = phase; v = 1;
    ph > 16 ? ( ph -= 16; v = -1; );
    while (
      (ph -= 1) == 0 ? ( ph = 16; v = -v; ) : nes_emit(id, t, v);
      t += tp;
      t < e;
    );
    v < 0 ? ph += 16;
    phase = ph;
    amp = this.tri_amp();
  );
  delay = t - e;
);

function noi_run(t, e) instance(r2, id, delay, amp, sr) local(v, a, dl, p, fb, tap, n) (
  v = this.nes_vol();
  a = (sr & 1) ? v : 0;
  dl = a - amp; amp = a;
  dl ? nes_emit(id, t, dl);
  t += delay;
  t < e ? (
    p = nes_nper[r2 & 15];
    !v ? (
      t += floor((e - t + p - 1) / p) * p;
      !(r2 & 128) ? ( fb = (sr << 13) ~ (sr << 14); sr = (fb & 16384) | (sr >> 1); );
    ) : (
      n = sr; dl = a * 2 - v; tap = (r2 & 128) ? 8 : 13;
      while (
        fb = (n << tap) ~ (n << 14);
        ((n + 1) & 2) ? ( dl = -dl; nes_emit(id, t, dl); );
        t += p;
        n = (fb & 16384) | (n >> 1);
        t < e;
      );
      amp = (dl + v) * 0.5;
      sr = n;
    );
  );
  delay = t - e;
);

function dmc_reload() instance(r2, r3, lc, addr) ( addr = 16384 + r2 * 64; lc = r3 * 16 + 1; );
function dmc_fill() instance(r0, lc, addr, buf, bempty) (
  bempty && lc ? (
    buf = nes_rom[addr];
    addr = (addr + 1) & 32767;
    bempty = 0;
    (lc -= 1) == 0 ? ( (r0 & 64) ? this.dmc_reload() : nes_en -= nes_en & 16; );
  );
);
function dmc_run(t, e) instance(id, delay, amp, dac, per, bits, brem, bempty, silence, buf) local(dl, br, c, s) (
  dl = dac - amp; amp = dac;
  dl ? nes_emit(id, t, dl);
  t += delay;
  t < e ? (
    br = brem;
    silence && bempty ? (
      c = floor((e - t + per - 1) / per);
      br = (br + 7 - (c % 8)) % 8 + 1;
      t += c * per;
    ) : (
      while (
        !silence ? (
          s = (bits & 1) * 4 - 2;
          bits = bits >> 1;
          (dac + s >= 0 && dac + s <= 127) ? ( dac += s; nes_emit(id, t, s); );
        );
        t += per;
        (br -= 1) == 0 ? (
          br = 8;
          bempty ? silence = 1 : ( silence = 0; bits = buf; bempty = 1; this.dmc_fill(); );
        );
        t < e;
      );
      amp = dac;
    );
    brem = br;
  );
  delay = t - e;
);

function nes_run(e) local(t, f) (
  e > nes_last ? while (
    t = nes_last + nes_fd;
    t > e ? t = e;
    nes_fd -= t - nes_last;
    sq1.sq_run(nes_last, t);
    sq2.sq_run(nes_last, t);
    tri.tri_run(nes_last, t);
    noi.noi_run(nes_last, t);
    dmc.dmc_run(nes_last, t);
    nes_flush();
    nes_last = t;
    t < e ? (
      nes_fd = 7458;
      f = nes_fr; nes_fr += 1;
      (f == 0 || f == 2) ? (
        sq1.nes_len(32); sq2.nes_len(32); noi.nes_len(32); tri.nes_len(128);
        sq1.sq_sweep(-1); sq2.sq_sweep(0);
      ) : f == 1 ? nes_fd -= 2 : f == 3 ? ( nes_fr = 0; (nes_fm & 128) ? nes_fd += 7452; );
      tri.tri_lin(); sq1.nes_env(); sq2.nes_env(); noi.nes_env();
    );
    t < e;
  );
);

function nes_write0(t, a, d) local(i, r, l, o) (
  nes_run(t);
  a < 16404 ? (
    i = (a - 16384) >> 2; r = a & 3;
    l = ((nes_en >> i) & 1) ? nes_ltab[(d >> 3) & 31] : -1;
    i == 0 ? ( sq1.nes_setreg(r, d); r == 3 ? ( l >= 0 ? sq1.lc = l; sq1.phase = 7; ); ) :
    i == 1 ? ( sq2.nes_setreg(r, d); r == 3 ? ( l >= 0 ? sq2.lc = l; sq2.phase = 7; ); ) :
    i == 2 ? ( tri.nes_setreg(r, d); r == 3 && l >= 0 ? tri.lc = l; ) :
    i == 3 ? ( noi.nes_setreg(r, d); r == 3 && l >= 0 ? noi.lc = l; ) : (
      dmc.nes_setreg(r, d);
      r == 0 ? dmc.per = nes_dper[d & 15] : r == 1 ? dmc.dac = d & 127;
    );
  ) : a == 16405 ? (
    !(d & 1) ? sq1.lc = 0; !(d & 2) ? sq2.lc = 0; !(d & 4) ? tri.lc = 0;
    !(d & 8) ? noi.lc = 0; !(d & 16) ? dmc.lc = 0;
    o = nes_en; nes_en = d;
    (d & 16) && !(o & 16) ? ( dmc.dmc_reload(); dmc.dmc_fill(); );
  ) : a == 16407 ? (
    nes_fm = d;
    nes_fd &= 1;
    nes_fr = 0;
    !(d & 128) ? ( nes_fr = 1; nes_fd += 7458; );
  );
);

// ---------------------------------------------------------------------- Famicom expansion: VRC6
function v6_emit(t, d) ( blep(busa, (t - blk_t0) * spc + 1, d); );

function v6_sq(o, e) local(b, vol, gate, duty, dl, t, per, ph) (
  b = v6 + o * 3;
  vol = b[0] & 15;
  !(b[2] & 128) ? vol = 0;
  gate = b[0] & 128;
  duty = ((b[0] >> 4) & 7) + 1;
  dl = ((gate || v6[15 + o] < duty) ? vol : 0) - v6[12 + o];
  t = v6[19];
  dl ? ( v6[12 + o] += dl; v6_emit(t, dl * v6k); );
  t += v6[9 + o]; v6[9 + o] = 0;
  per = (b[2] & 15) * 256 + b[1] + 1;
  vol && !gate && per > 4 ? (
    t < e ? (
      ph = v6[15 + o];
      while (
        ph += 1;
        ph == 16 ? ( ph = 0; v6[12 + o] = vol; v6_emit(t, vol * v6k); );
        ph == duty ? ( v6[12 + o] = 0; v6_emit(t, -vol * v6k); );
        t += per;
        t < e;
      );
      v6[15 + o] = ph;
    );
    v6[9 + o] = t - e;
  );
);

function v6_saw(e) local(amp, st, t, la, dl, per, ph) (
  amp = v6[18]; st = v6[6] & 63;
  t = v6[19]; la = v6[14];
  !(v6[8] & 128) || !(st | amp) ? (
    v6[11] = 0;
    dl = (amp >> 3) - la; la = amp >> 3;
    dl ? v6_emit(t, dl * v6ks);
  ) : (
    t += v6[11];
    t < e ? (
      per = ((v6[8] & 15) * 256 + v6[7] + 1) * 2;
      ph = v6[17];
      while (
        (ph -= 1) == 0 ? ( ph = 7; amp = 0; );
        dl = (amp >> 3) - la;
        dl ? ( la = amp >> 3; v6_emit(t, dl * v6ks); );
        t += per;
        amp = (amp + st) & 255;
        t < e;
      );
      v6[17] = ph; v6[18] = amp;
    );
    v6[11] = t - e;
  );
  v6[14] = la;
);

function v6_run(e) (
  e > v6[19] ? ( v6_sq(0, e); v6_sq(1, e); v6_saw(e); v6[19] = e; );
);

function v6_write(t, o, r, d) (
  r < 3 && o >= 0 && o < 3 ? ( v6_run(t); v6[o * 3 + r] = d; );
);

function v6_reset() (
  memset(v6, 0, 24);
  v6[15] = v6[16] = v6[17] = 1;
);

// ---------------------------------------------------------------------- Famicom expansion: VRC7 (ymfm OPLL, DS1001)
function v7_tables() local(i) (
  mem_set_values(v7rom,
    3, 33, 5, 6, 232, 129, 66, 39, 19, 65, 20, 13, 216, 246, 35, 18, 17, 17, 8, 8, 250, 178, 32, 18,
    49, 97, 12, 7, 168, 100, 97, 39, 50, 33, 30, 6, 225, 118, 1, 40, 2, 1, 6, 0, 163, 226, 244, 244,
    33, 97, 29, 7, 130, 129, 17, 7, 35, 33, 34, 23, 162, 114, 1, 23, 53, 17, 37, 0, 64, 115, 114, 1,
    181, 1, 15, 15, 168, 165, 81, 2, 23, 193, 36, 7, 248, 248, 34, 18, 113, 35, 17, 6, 101, 116, 24, 22,
    1, 2, 211, 5, 201, 149, 3, 2, 97, 99, 12, 0, 148, 192, 51, 246, 33, 114, 13, 0, 193, 213, 86, 6);
  mem_set_values(v7ksl, 0, 24, 32, 37, 40, 43, 45, 47, 48, 50, 51, 52, 53, 54, 55, 56);
  mem_set_values(v7pms, 8, 4, 0, -4, -8, -4, 0, 4);
  i = 0;
  loop(1024, v7w[i] = md_wave[i]; v7w[1024 + i] = (i & 512) ? md_wave[0] : md_wave[i]; i += 1; );
  v7k = 2 * 2047 / (3 * 4096) / 0.0967 * 15 * v6k / (255 * 128 / 9);
);

function v7_ib(ch, off) local(p) ( p = vx_ip[ch]; p < 0 ? vx[off] : v7rom[p + off]; );

function v7_step(bf, mul, pm) local(b, fn, bl) (
  b = bf * 2;
  fn = (b & 1023) * 4;
  fn += floor(pm * ((b >> 7) & 7) / 2);
  fn -= floor(fn / 4096) * 4096;
  bl = (b >> 10) & 7;
  floor(floor(fn * 2 ^ bl / 4) * mul / 2);
);

function v7_eff(r, k) ( r == 0 ? 0 : min(r + k, 63); );

function v7_attack(o) (
  vx_est[o] != 1 ? (
    vx_est[o] = 1;
    vx_ph[o] = 0;
    vx_rt[o * 5 + 1] >= 62 ? vx_env[o] = 0;
  );
);

function v7_prepare() local(ch, i, o, ins, bf, kc, b0, m, ksl, sl, ksr, sus, x, ks, any) (
  vx_any = 0;
  ch = 0;
  loop(6,
    ins = vx[48 + ch] >> 4;
    vx_ip[ch] = ins == 0 ? -1 : 8 * (ins - 1);
    bf = (vx[32 + ch] & 15) * 256 + vx[16 + ch];
    kc = (bf >> 8) & 15;
    sus = (vx[32 + ch] >> 5) & 1;
    any = 0;
    i = 0;
    loop(2,
      o = ch * 2 + i;
      b0 = v7_ib(ch, i);
      vx_am[o] = (b0 >> 7) & 1; vx_pm[o] = (b0 >> 6) & 1;
      m = b0 & 15; m = ((m & 14) | ((49834 >> m) & 1)) * 2; !m ? m = 1;
      vx_mul[o] = m; vx_bf[o] = bf;
      vx_wv[o] = ((v7_ib(ch, 3) >> (3 + i)) & 1) * 1024;
      vx_ps[o] = vx_pm[o] ? -1 : v7_step(bf, m, 0);
      x = i ? (vx[48 + ch] & 15) * 4 : v7_ib(ch, 2) & 63;
      x *= 8;
      ksl = (v7_ib(ch, 2 + i) >> 6) & 3;
      ksl ? x += max(0, v7ksl[(bf >> 5) & 15] - 8 * (((bf >> 9) & 7) ~ 7)) * 2 ^ ksl;
      vx_tl[o] = x;
      sl = v7_ib(ch, 6 + i) >> 4; sl = sl | ((sl + 1) & 16); vx_sl[o] = sl * 32;
      ksr = (b0 >> 4) & 1; ks = kc >> (2 * (ksr ~ 1));
      vx_rt[o * 5] = 48;
      vx_rt[o * 5 + 1] = v7_eff((v7_ib(ch, 4 + i) >> 4) * 4, ks);
      vx_rt[o * 5 + 2] = v7_eff((v7_ib(ch, 4 + i) & 15) * 4, ks);
      (b0 >> 5) & 1 ? (
        vx_rt[o * 5 + 3] = 0;
        vx_rt[o * 5 + 4] = sus ? 20 : v7_eff((v7_ib(ch, 6 + i) & 15) * 4, ks);
      ) : (
