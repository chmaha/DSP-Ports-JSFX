);

function nes_tabs() local(i, x, sel, hov)
(
  con == 0 && nexp && pass == 1 ? (
    i = 0;
    loop(2,
      x = 762 + i * 64; sel = g_nv == i; hov = hit(x, 97, 60, 14);
      acc(4);
      sel ? gfx_set(acc_r * 0.35, acc_g * 0.35, acc_b * 0.35, 1) : gfx_set(0.1, 0.105, 0.12, 1);
      gfx_rect(sx(x), sy(97), 60 * z, 14 * z, 1);
      sel ? ( gfx_set(acc_r, acc_g, acc_b, 1); gfx_rect(sx(x), sy(109), 60 * z, 2 * z, 1); );
      hov && !sel ? ( gfx_set(1, 1, 1, 0.06); gfx_rect(sx(x), sy(97), 60 * z, 14 * z, 1); );
      font(1, 9); sel ? gfx_set(1, 1, 1, 1) : grey(1);
      text_c(i ? ( nexp == 1 ? "VRC6" : "VRC7" ) : "2A03", x + 30, 98);
      mouse_click && hov && !sel ? ( g_nv = i; mouse_click = 0; );
      i += 1;
    );
  );
);

// ---------------------------------------------------------------------- layout
function layout() local(x)
(
  logo(); tabs(); lcd(); scope_view(716, 12, 232, 70);

  panel(10, 94, 940, 72, "GLOBAL", 4);
