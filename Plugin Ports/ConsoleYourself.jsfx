    env_view(735, 272, 199, 56, 36, 0, (vb + 192)[4], 3);
    knob(753, 358, 36, "ATTACK", 3, 0);
    knob(803, 358, 37, "DECAY", 3, 0);
    knob(853, 358, 38, "SUSTAIN", 3, 0);
    knob(903, 358, 39, "RELEASE", 3, 0);
    pass == 0 ? (
