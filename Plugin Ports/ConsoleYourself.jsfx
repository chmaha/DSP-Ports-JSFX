// ---------------------------------------------------------------------- frame
mouse_click = (mouse_cap & 1) && !mouse_prev;
g_rclick = (mouse_cap & 2) && !g_rprev;
!(mouse_cap & 1) ? ( drag_k >= 0 ? automate(drag_k, 1); drag_k = -1; g_wk >= 0 ? sliderchange(-1); g_wk = -1; );
!gfx_inited ? ( drag_k = last_k = g_wk = -1; touched_t = -10; gfx_inited = 1; );

!nexp || con ? g_nv = 0;
penum[201] = nexp == 2 ? "Off|FM 1|FM 1 + 2|FM 1 + 2 + 3" : "Off|Saw|Saw + Pulse 1|Saw + Pulse 1 + 2";
g_bk = nexp * 2 + g_nv;
(gfx_w != bg_w || gfx_h != bg_h || con != bg_con || g_bk != bg_k) ? (
  gfx_setimgdim(1, gfx_w, gfx_h);
  gfx_dest = 1;
  gfx_set(0.075, 0.078, 0.088, 1); gfx_rect(0, 0, gfx_w, gfx_h, 1);
  gfx_gradrect(0, 0, gfx_w, gfx_h, 0.11, 0.115, 0.13, 1, 0, 0, 0, 0, -0.05 / gfx_h, -0.05 / gfx_h, -0.05 / gfx_h, 0);
  pass = 0; layout();
  gfx_dest = -1;
  bg_w = gfx_w; bg_h = gfx_h; bg_con = con; bg_k = g_bk;
);
gfx_x = gfx_y = 0; gfx_blit(1, 1, 0);

pass = 1; hov_k = -1;
layout();
hov_k >= 0 ? (
  acc(hov_c); fmt_p(hov_k, #tt);
  font(1, 11); gfx_measurestr(#tt, tw_, th_);
  gfx_set(0.02, 0.02, 0.03, 0.92); gfx_rect(sx(hov_x) - tw_ * 0.5 - 6 * z, sy(hov_y) - th_ - 6 * z, tw_ + 12 * z, th_ + 6 * z, 1);
  gfx_set(acc_r, acc_g, acc_b, 0.8); gfx_rect(sx(hov_x) - tw_ * 0.5 - 6 * z, sy(hov_y) - max(1, z), tw_ + 12 * z, max(1, z), 1);
  gfx_set(1, 1, 1, 1); gfx_x = sx(hov_x) - tw_ * 0.5; gfx_y = sy(hov_y) - th_ - 3 * z; gfx_drawstr(#tt);
);
mouse_wheel = 0;
mouse_prev = mouse_cap & 1;
g_rprev = mouse_cap & 2;
