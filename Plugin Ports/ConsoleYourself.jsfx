    k == 1 ? ( ph += 1 / rate; x = (0.55 * sin(2 * $pi * 185 * ph) + 0.35 * sin(2 * $pi * 330 * ph)) * exp(-t / 0.05); y += 0.55 * (hash(i + 5000) * 2 - 1 - y); x += (hash(i + 5000) * 2 - 1 - y * 0.5) * 0.9 * exp(-t / 0.09); ) :
    k == 2 ? ( ph += (95 + 50 * exp(-t / 0.06)) / rate; x = sin(2 * $pi * ph) * exp(-t / 0.2) + (t < 0.005 ? (hash(i + 7000) * 2 - 1) * 0.3 : 0); ) :
