  keys_drop(766, 128, 80);
  knob(918, 132, 4, "VOLUME", 4, 1);
  pass == 1 ? (
    font(1, 9); sus_on ? ( acc(4); gfx_set(acc_r, acc_g, acc_b, 1); ) : gfx_set(0.3, 0.31, 0.34, 1);
    text_c("SUSTAIN", 872, 118); gfx_circle(sx(872), sy(138), 3 * z, 1, 1);
  );

  con == 0 && g_nv && nexp == 1 ? vrc6_page() : con == 0 && g_nv && nexp == 2 ? vrc7_page() : con == 0 ? (
    x = 0;
    loop(2,
      chan(10 + x * 237, 176, 227, x, x ? "PULSE 2" : "PULSE 1");
      seg(24 + x * 237, 234, 199, 26, x ? 22 : 13, 4, x, 1, "DUTY");
      env_view(24 + x * 237, 272, 199, 56, x ? 23 : 14, 0, (vb + x * 64)[4], x);
      knob(42 + x * 237, 358, x ? 23 : 14, "ATTACK", x, 0);
      knob(92 + x * 237, 358, x ? 24 : 15, "DECAY", x, 0);
      knob(142 + x * 237, 358, x ? 25 : 16, "SUSTAIN", x, 0);
      knob(192 + x * 237, 358, x ? 26 : 17, "RELEASE", x, 0);
      knob(42 + x * 237, 420, x ? 27 : 18, "VIB DEPTH", x, 0);
      knob(92 + x * 237, 420, x ? 28 : 19, "VIB RATE", x, 0);
      knob(142 + x * 237, 420, x ? 30 : 21, "DETUNE", x, 1);
      drop(24 + x * 237, 472, 199, x ? 29 : 20, "SWEEP", x);
      x += 1;
    );
    chan(484, 176, 227, 2, "TRIANGLE");
    pass == 1 ? (
      acc(2); gfx_set(acc_r, acc_g, acc_b, 0.9); x = 0;
      loop(32, gfx_rect(sx(504 + x * 6), sy(322) - z * 3 * (x < 16 ? 15 - x : x - 16), 5 * z, z * 3 * (x < 16 ? 15 - x : x - 16) + z, 1); x += 1; );
    );
    pass == 0 ? ( screen(498, 234, 199, 94); font(1, 9); grey(0.7); text_c("32-STEP TRIANGLE  ·  NO VOLUME CONTROL", 597, 238); );
    knob(522, 358, 33, "RELEASE", 2, 0);
    knob(572, 358, 31, "VIB DEPTH", 2, 0);
    knob(622, 358, 32, "VIB RATE", 2, 0);
    knob(672, 358, 34, "DETUNE", 2, 1);
    chan(721, 176, 227, 3, "NOISE + DPCM");
