    knob(903, 372, 101, "RELEASE", 3, 0);
    seg(735, 472, 199, 22, 102, 3, 3, 0, "PAN (GAME GEAR)");
    pass == 0 ? ( font(1, 9); grey(0.75); label("CLOCK TONE 3: NOTES SET PITCH", 735, 412); label("(PERIODIC = BASS, TONE 3 MUTED)", 735, 426); );
  ) : con == 5 ? snes_page() : con == 4 ? (
    panel(10, 176, 227, 330, "WAVETABLE", 0);
    wave_view(24, 204, 199, 150, 0, 156, pce_waves, 31, ck == 0 && vb[8] ? pce_idx[0] : -1);
    pass == 0 ? ( font(1, 9); grey(0.75); label("32 STEPS, 5 BITS  ·  DRAG TO DRAW", 24, 362); label("RIGHT-CLICK FOR PRESET SHAPES", 24, 376);
      label("LAYER: CHANNELS 1-5 PLAY NOTES", 24, 398); label("CHANNEL 6: NOISE AND DRUMS", 24, 412); label("TRACKER: MIDI CH 1-6", 24, 426); );
    panel(247, 176, 227, 330, "ENVELOPE", 1);
    env_view(261, 204, 199, 110, 157, 0, vb[4], 1);
    knob(279, 358, 157, "ATTACK", 1, 0); knob(329, 358, 158, "DECAY", 1, 0);
    knob(379, 358, 159, "SUSTAIN", 1, 0); knob(429, 358, 160, "RELEASE", 1, 0);
    knob(279, 420, 161, "VIB DEPTH", 1, 0); knob(329, 420, 162, "VIB RATE", 1, 0);
    panel(484, 176, 227, 330, "NOISE", 3);
    env_view(498, 204, 199, 110, 164, 0, (vb + 320)[4], 3);
    knob(516, 358, 164, "ATTACK", 3, 0); knob(566, 358, 165, "DECAY", 3, 0);
    knob(616, 358, 166, "SUSTAIN", 3, 0); knob(666, 358, 167, "RELEASE", 3, 0);
    pass == 0 ? ( font(1, 9); grey(0.75); label("CLICK THE NOISE TITLE TO PLAY IT", 498, 404); label("FROM THE KEYBOARD", 498, 418); );
    pass == 1 ? ( x = hit(484, 176, 227, 24); mouse_click && x ? ( set_done(10, slider10 == 3 ? 0 : 3); mouse_click = 0; );
      acc(3); gfx_set(acc_r, acc_g, acc_b, slider10 == 3 ? 0.9 : 0.25); gfx_circle(sx(698), sy(190), 3.5 * z, slider10 == 3, 1); );
    panel(721, 176, 227, 330, "CHANNELS", 2);
    pass == 1 ? (
