    y = 204 + i * 18.6;
    pass == 0 ? ( font(1, 9); grey(1); sprintf(#sn_h, "%d", i + 1); label(#sn_h, 737, y + 2); );
    sn_cdrop(762, y, 172, i == 9 ? 199 : 183 + i, 2);
    i += 1;
  );
);

function sn_info(x, y) local(k, f, n, nr, ct, tw, th)
(
  pass == 1 ? (
    k = floor(slider168 + 0.5);
    acc(0); lc_r = acc_r; lc_g = acc_g; lc_b = acc_b;
    font(1, 12); gfx_set(0.93, 0.94, 0.96, 1); label(100 + k, x, y);
    sprintf(#sni, "#%d", k + 1); font(2, 10); gfx_measurestr(#sni, tw, th); glow_str(#sni, sx(x + 199) - tw, sy(y + 2));
    font(1, 9); grey(0.85);
    k == 203 ? (
      label("S-DSP NOISE GENERATOR", x, y + 20);
      label("PITCH SETS THE NOISE CLOCK", x, y + 34);
    ) : sn_ok ? (
      f = sn_it[k * 8 + 1]; n = 69 + 12 * log(f / 440) / log(2); nr = floor(n + 0.5); ct = floor((n - nr) * 100 + 0.5);
      note_str(nr, #snn);
      ct ? sprintf(#sni, "%s  ·  AT 32 KHZ: %s %+d CENTS", sn_catname(sn_cat[k]), #snn, ct) : sprintf(#sni, "%s  ·  AT 32 KHZ: %s", sn_catname(sn_cat[k]), #snn);
      f = 0; loop(strlen(#sni), n = str_getchar(#sni, f); n >= 97 && n <= 122 ? str_setchar(#sni, f, n - 32); f += 1; );
      label(#sni, x, y + 20);
      sprintf(#sni, "LENGTH %.2f S  ·  %d SAMPLES", sn_ln[k] / 9 * 16 / 32000, sn_ln[k] / 9 * 16);
      label(#sni, x, y + 34);
    ) : label("SAMPLE DATA NOT FOUND", x, y + 20);
  );
);

