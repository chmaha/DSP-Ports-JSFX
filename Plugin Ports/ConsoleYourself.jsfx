function keys_drop(x, y, w) local(hov, h, tw, th, i, e)
(
  kacc(); h = 22;
  e = con == 0 ? ( nexp == 1 ? "Pulse 1|Pulse 2|Triangle|Noise|Drums|VRC6 Pulse 1|VRC6 Pulse 2|VRC6 Saw" :
                   nexp == 2 ? "Pulse 1|Pulse 2|Triangle|Noise|Drums|VRC7 FM 1|VRC7 FM 2|VRC7 FM 3" : "Pulse 1|Pulse 2|Triangle|Noise|Drums" ) : con == 1 ? "Pulse 1|Pulse 2|Wave|Noise|Drums" : con == 2 ? "Tone 1|Tone 2|Tone 3|Noise|Drums" : "Notes|Noise|Drums";
  i = con < 3 ? slider10 : slider10 == 3 ? 1 : slider10 == 4 ? 2 : 0;
  pass == 0 ? ( box(x, y, w, h); font(1, 9); grey(1); label("KEYS", x, y - 13); ) : (
    hov = hit(x, y, w, h);
    hov ? ( gfx_set(1, 1, 1, 0.05); gfx_rect(sx(x), sy(y), w * z, h * z, 1); );
    font(1, 11); gfx_set(0.9, 0.91, 0.93, 1);
    enum_item(e, i, #kd); gfx_measurestr(#kd, tw, th);
    gfx_x = sx(x + 7); gfx_y = sy(y) + (h * z - th) * 0.5; gfx_drawstr(#kd);
    gfx_set(acc_r, acc_g, acc_b, hov ? 1 : 0.8);
    gfx_triangle(sx(x + w - 13), sy(y + 9), sx(x + w - 5), sy(y + 9), sx(x + w - 9), sy(y + 13.5));
    gfx_rect(sx(x), sy(y + h) - max(1, z), w * z, max(1, z), 1);
    mouse_click && hov ? (
      mouse_click = 0; gfx_x = sx(x); gfx_y = sy(y + h);
      i = gfx_showmenu(enum_menu(e, i, #mn));
      i > 0 ? set_done(10, con < 3 ? i - 1 : i == 1 ? 0 : i == 2 ? 3 : 4);
    );
  );
);


