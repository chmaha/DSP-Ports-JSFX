con = floor(slider1 + 0.5);
md_data(); md_tables(); v7_tables();
make_pce_waves();
cy_winit !== 1 ? (
  memcpy(waves + 256, waves, 32); memcpy(pce_waves + 256, pce_waves, 32);
  cy_winit = 1;
);
sn_sil[0] = 3;
sn_data(); sn_tables(); !sn_ok ? sn_load(); sn_kits(); dk_make();
mem_set_values(sn_tms, 4100, 2600, 1500, 1000, 640, 380, 260, 160, 96, 64, 40, 24, 16, 10, 6, 0, 1200, 740, 440, 290, 180, 110, 74, 37,
  0, 38000, 28000, 24000, 19000, 14000, 12000, 9400, 7100, 5900, 4700, 3500, 2900, 2400, 1800, 1500, 1200, 880, 740, 590, 440, 370, 290, 220,
  180, 150, 110, 92, 74, 55, 37, 18);
mem_set_values(sn_firt, 127, 0, 0, 0, 0, 0, 0, 0, 12, 33, 43, 43, 19, -2, -13, -7, 88, -65, -37, -16, -2, 7, 12, 12, 52, 51, 0, -39, -27, 1, -4, -21);
i = 0; loop(17, chp[i] = glast[i] = -1; i += 1; );
mem_set_values(md_apos, 0,1, 1,1, 2,1, 3,1,  0,0, 0,2, 1,1, 2,1,  1,0, 0,2, 1,2, 2,1,  0,0, 1,0, 1,2, 2,1,
  0,0, 1,0, 0,2, 1,2,  0,1, 1,0, 1,1, 1,2,  0,0, 1,0, 1,1, 1,2,  0,1, 1,1, 2,1, 3,1);
reset();

@slider
con = floor(slider1 + 0.5);
srate != cur_sr ? ( cur_sr = srate; reset(); );

@block
con = floor(slider1 + 0.5);
con != cur_con || slider3 != cur_chips || (con == 3 && slider103 != cur_mdchip) || (con == 0 && slider200 != cur_exp) ? ( cur_sr = srate; reset(); );
con == 3 ? (
  x = slider104 + slider105 * 8 + slider107 * 64 + slider108 * 256 + slider111 * 2048; i = 112;
  loop(44, x = (x * 31 + slider(i) + 4) % 1000003; i += 1; );
  x != md_psum ? ( md_psum = x; md_pver += 1; );
);
con == 5 ? ( scn_i = 0; loop(16, scn_x = slider(183 + scn_i); scn_x !== sn_lch[scn_i] ? ( sn_lch[scn_i] = scn_x; chp[scn_i] = -1; ); scn_i += 1; ); );
slider2 != cur_mode || (slider7 > 0) != cur_arp ? ( cur_mode = slider2; cur_arp = slider7 > 0; all_off(floor(hs * clk / srate)); );

blk_n > 0 ? (
  memcpy(busa, busa + blk_n, BLW + 4); memset(busa + BLW + 4, 0, blk_n);
  memcpy(busb, busb + blk_n, BLW + 4); memset(busb + BLW + 4, 0, blk_n);
  con ? ( memcpy(busc, busc + blk_n, BLW + 4); memset(busc + BLW + 4, 0, blk_n); );
);

cps = clk / srate; spc = srate / clk;
blk_t0 = hs * cps;
tend = (hs + samplesblock) * cps;
fmb0 = floor(blk_t0); sms_t0 = con == 3 ? hs * 1789772.5 / srate : blk_t0; sms_spc = con == 3 ? srate / 1789772.5 : spc;

qn = 0;
while (gq_r != gq_w) (
  q_o[qn] = 0; q_s[qn] = gq[gq_r * 3] & 255; q_a[qn] = gq[gq_r * 3 + 1]; q_b[qn] = floor(gq[gq_r * 3] / 256);
  kq_ = gq[gq_r * 3 + 2];
  q_c[qn] = kq_ == 4 ? 17 : kq_ == 3 ? ( slider2 ? ( con == 3 ? 9 : con == 4 ? 5 : con == 5 ? 16 : 3 ) : 16 ) : slider2 && con < 3 ? kq_ : 0;
  qn += 1; gq_r = (gq_r + 1) & 63;
);
while (midirecv(m_o, m_1, m_2, m_3)) (
  (m_1 & 240) >= 128 && (m_1 & 240) < 240 && qn < 1000 ? (
    q_o[qn] = m_o; q_s[qn] = m_1 & 240; q_c[qn] = m_1 & 15; q_a[qn] = m_2; q_b[qn] = m_3;
    qn += 1;
  );
);

i = 0;
loop(qn,
  te = floor(blk_t0 + q_o[i] * cps);
  while (nft <= te) ( frame(floor(nft)); nft += fper; );
  q_s[i] == 144 && q_b[i] > 0 ? ( kdown[q_a[i]] = 1; midi_flag = 1; ) : q_s[i] <= 144 ? kdown[q_a[i]] = 0;
  midi(te, q_s[i], q_c[i], q_a[i], q_b[i]);
  i += 1;
);
while (nft < tend) ( frame(floor(nft)); nft += fper; );
run_all(floor(tend));
con == 3 || con == 5 ? (
  i = 0; ql = qr = 0;
  loop(floor(tend) - fmb0,
    ql += mddl[i]; qr += mddr[i]; mddl[i] = mddr[i] = 0;
    x = mdl[i] + ql - mdpl; y = mdr[i] + qr - mdpr;
    x == y ? ( x ? blep(busc, (fmb0 + i - blk_t0) * spc + 1, x / 32768); ) : (
      x ? blep(busa, (fmb0 + i - blk_t0) * spc + 1, x / 32768);
      y ? blep(busb, (fmb0 + i - blk_t0) * spc + 1, y / 32768);
    );
    mdpl += x; mdpr += y;
    mdl[i] = mdr[i] = 0;
    i += 1;
  );
  mddl[i] = mddr[i] = 0;
);
dmc_act = dmc_hs > 0 && hs - dmc_hs < srate * 0.3;
hs += samplesblock; blk_n = samplesblock;
spos = 0;

gain = 10 ^ (slider4 / 20);
nf = floor(slider11 + 0.5);
hpa1 = 1 / (1 + 2 * $pi * (nf == 0 ? 37 : nf == 1 ? 90 : 5) / srate);
hpa2 = 1 / (1 + 2 * $pi * 440 / srate);
lpb = 1 - exp(-2 * $pi * 14000 / srate);
gbhp = con == 1 ? 0.999958 ^ (4194304 / srate) : exp(-2 * $pi * 20 / srate);
outg = gain * (con == 1 ? 1 / 800 : con == 2 ? 0.3 : con == 4 ? 2 : con == 5 ? 1.2 : 1.5);

@sample
sum_a += busa[spos]; sum_b += busb[spos];
con == 0 ? (
  x = sum_a;
  f1y = hpa1 * (f1y + x - f1x); f1x = x; x = f1y;
  nf == 1 ? ( f2y = hpa2 * (f2y + x - f2x); f2x = x; x = f2y; );
  nf < 2 ? ( lpy += lpb * (x - lpy); x = lpy; );
  spl0 = spl1 = x * 1.6 * gain;
) : (
  sum_c += busc[spos];
  x = sum_a + sum_c; y = sum_b + sum_c;
  hl = x - hpl; hpl = x - hl * gbhp;
  hr = y - hpr_; hpr_ = y - hr * gbhp;
  spl0 = hl * outg; spl1 = hr * outg;
);
fdl != 0 || fdr != 0 ? ( spl0 += fdl; spl1 += fdr; fdl *= 0.998; fdr *= 0.998; abs(fdl) + abs(fdr) < 0.00001 ? fdl = fdr = 0; );
scope[scope_p] = spl0 + spl1; scope_p = (scope_p + 1) & 4095;
spos += 1;

@serialize
cy_rd = file_avail(0) >= 0;
cy_sv = cy_rd ? 0 : 1;
file_var(0, cy_sv);
cy_sv === 1 ? (
  file_mem(0, waves + 256, 32); file_mem(0, pce_waves + 256, 32);
  cy_rd ? ( cy_wv += 1; cy_pv += 1; );
);

@gfx 960 600

GW0 = 960; GH0 = 600;
z = max(0.5, min(gfx_w / GW0, gfx_h / GH0));
ox = floor((gfx_w - GW0 * z) * 0.5);
oy = floor((gfx_h - GH0 * z) * 0.5);
now = time_precise();

function automate(s, e)
(
<? loop(i = 1; 255,
  printf("  s == %d ? slider_automate(slider%d, e) :\n", i, i);
  i += 1;
); ?>  0;
);

function sx(x) ( ox + x * z; );
function sy(y) ( oy + y * z; );
function hit(x, y, w, h) ( mouse_x >= sx(x) && mouse_x < sx(x + w) && mouse_y >= sy(y) && mouse_y < sy(y + h); );
function font(n, sz) ( n == 1 ? gfx_setfont(1, "Arial", (sz + 2) * z, 'b') : gfx_setfont(2, "Courier New", (sz + 2) * z, 'b'); );
function text_c(str, cx, y) local(tw, th) ( gfx_measurestr(str, tw, th); gfx_x = sx(cx) - tw * 0.5; gfx_y = sy(y); gfx_drawstr(str); );
function label(str, x, y) ( gfx_x = sx(x); gfx_y = sy(y); gfx_drawstr(str); );
function grey(a) ( gfx_set(0.62, 0.64, 0.68, a); );

function glow_str(str, x, y) local(d)
(
  d = max(1, z);
  gfx_set(lc_r, lc_g, lc_b, 0.14);
  gfx_x = x - d; gfx_y = y; gfx_drawstr(str);
  gfx_x = x + d; gfx_y = y; gfx_drawstr(str);
  gfx_set(lc_r, lc_g, lc_b, 1);
  gfx_x = x; gfx_y = y; gfx_drawstr(str);
);

function rrect(x, y, w, h, r) local(QX, QY, QW, QH)
(
  QX = sx(x); QY = sy(y); QW = w * z; QH = h * z; r *= z;
  gfx_rect(QX + r, QY, QW - 2 * r, QH, 1);
  gfx_rect(QX, QY + r, r, QH - 2 * r, 1); gfx_rect(QX + QW - r, QY + r, r, QH - 2 * r, 1);
  gfx_circle(QX + r, QY + r, r, 1, 1); gfx_circle(QX + QW - r - 1, QY + r, r, 1, 1);
  gfx_circle(QX + r, QY + QH - r - 1, r, 1, 1); gfx_circle(QX + QW - r - 1, QY + QH - r - 1, r, 1, 1);
);

function acc(c)
(
  c == 0 ? ( acc_r = 1.00; acc_g = 0.66; acc_b = 0.26; ) :
  c == 1 ? ( acc_r = 0.30; acc_g = 0.82; acc_b = 0.96; ) :
  c == 2 ? ( acc_r = 0.46; acc_g = 0.92; acc_b = 0.56; ) :
  c == 3 ? ( acc_r = 0.74; acc_g = 0.54; acc_b = 1.00; ) :
  c == 4 ? ( acc_r = 0.46; acc_g = 0.64; acc_b = 1.00; ) :
  c == 6 ? ( acc_r = 1.00; acc_g = 0.84; acc_b = 0.30; ) :
  c == 7 ? ( acc_r = 1.00; acc_g = 0.48; acc_b = 0.78; ) :
  c == 8 ? ( acc_r = 0.30; acc_g = 0.90; acc_b = 0.80; ) :
  ( acc_r = 0.95; acc_g = 0.30; acc_b = 0.36; );
);
function kacc() ( acc(slider10 >= 5 ? slider10 + 1 : slider10); );

function box(x, y, w, h) (
  gfx_set(0, 0, 0, 0.5); gfx_rect(sx(x) - z, sy(y) - z, (w + 2) * z, (h + 2) * z, 1);
  gfx_set(0.075, 0.08, 0.09, 1); gfx_rect(sx(x), sy(y), w * z, h * z, 1);
);

function panel(x, y, w, h, title, c) local(tw, th, i)
(
  acc(c);
  pass == 0 ? (
  i = 1;
  loop(5, gfx_set(0, 0, 0, 0.1 * (1 - (i - 1) / 5)); gfx_roundrect(sx(x) - i, sy(y) - i + 2 * z, w * z + 2 * i, h * z + 2 * i, 7 * z + i, 1); i += 1; );
  gfx_set(0.115, 0.122, 0.140, 1);
  rrect(x, y, w, h, 7);
  gfx_set(1, 1, 1, 0.05);
  gfx_line(sx(x + 7), sy(y) + 1, sx(x + w - 7), sy(y) + 1, 1);
  font(1, 11);
  gfx_measurestr(title, tw, th);
  gfx_set(acc_r, acc_g, acc_b, 0.95);
  label(title, x + 12, y + 8);
  gfx_set(acc_r, acc_g, acc_b, 0.35);
  gfx_rect(sx(x + 12) + tw + 8 * z, sy(y + 14), sx(x + w - 12) - (sx(x + 12) + tw + 8 * z), max(1, z), 1);
  );
);

// ---------------------------------------------------------------------- parameter helpers
function enum_item(e, v, s) local(i, n, a, l, c)
(
  i = n = a = 0; l = strlen(e); strcpy(s, "");
  loop(l + 1, c = i < l ? str_getchar(e, i) : 124; c == 124 ? ( n == v ? strcpy_substr(s, e, a, i - a); n += 1; a = i + 1; ); i += 1; );
  s;
);

function enum_menu(e, v, s) local(i, n, a, l, c)
(
  i = n = a = 0; l = strlen(e); strcpy(s, "");
  loop(l + 1, c = i < l ? str_getchar(e, i) : 124;
    c == 124 ? ( n ? strcat(s, "|"); n == v ? strcat(s, "!"); strcat(s, strcpy_substr(#es, e, a, i - a)); n += 1; a = i + 1; );
    i += 1; );
  s;
);

function ms_str(ms, s) ( ms == 0 ? strcpy(s, "Instant") : ms < 1000 ? sprintf(s, "%d ms", ms) : sprintf(s, "%.1f s", ms / 1000); );

function fmt_p(k, s) local(v, f)
(
  v = slider(k); f = pfmt[k];
  f == 21 ? ( v = floor(v + 0.5) - (k != 168); v < 0 ? strcpy(s, "Instrument menu") : strcpy(s, 100 + v); ) :
  f == 1 ? enum_item(penum[k], floor(v - pmin[k] + 0.5), s) :
  f == 2 ? ( v == 0 ? strcpy(s, "Off") : sprintf(s, "%d frames", v); ) :
  f == 3 ? sprintf(s, "%d cents", v) :
  f == 4 ? sprintf(s, "%.1f Hz", v) :
  f == 5 ? sprintf(s, "%+.1f dB", v) :
  f == 6 ? ( v == 0 ? strcpy(s, "Flat") : sprintf(s, v > 0 ? "Rise %d" : "Fall %d", abs(v)); ) :
  f == 7 ? sprintf(s, "%d st", v) :
  f == 8 ? ( v == 0 ? strcpy(s, "Off") : sprintf(s, "Every %d frames", v); ) :
  f == 9 ? ( v == 0 ? strcpy(s, "Cut") : sprintf(s, "%d", v); ) :
  f == 12 ? sprintf(s, "%d ms", v * 16) :
  f == 13 ? ms_str(sn_tms[v], s) :
  f == 14 ? ms_str(sn_tms[16 + v], s) :
  f == 15 ? sprintf(s, "%.1f%%", (v + 1) * 12.5) :
  f == 16 ? ( v == 0 ? strcpy(s, "Hold") : ms_str(sn_tms[24 + v], s); ) :
  f == 17 ? ( v == 0 ? strcpy(s, "Key Off") : ms_str(sn_tms[24 + v], s); ) :
  f == 18 ? sprintf(s, "%d%%", v) :
  f == 19 ? ( v == 0 ? strcpy(s, "Centre") : sprintf(s, v < 0 ? "L %d" : "R %d", abs(v)); ) :
  sprintf(s, "%d", v);
);

function set_p(k, v) local(st)
(
  v = max(pmin[k], min(pmax[k], v));
  st = pstep[k]; v = pmin[k] + floor((v - pmin[k]) / st + 0.5) * st;
  slider(k) !== v ? ( slider(k) = v; automate(k, 0); );
  touched_k = k; touched_t = now;
);
function set_done(k, v) ( set_p(k, v); automate(k, 1); );

// ---------------------------------------------------------------------- widgets
function knob(x, y, k, lab, c, bip) local(QX, QY, QR, hov, d, rng, a, as, ae, i, px, py, t, br)
(
  acc(c);
  QX = sx(x); QY = sy(y); QR = 15 * z;
  pass == 0 ? (
    gfx_set(0, 0, 0, 0.45); gfx_circle(QX, QY + 2 * z, QR + 2 * z, 1, 1);
    gfx_set(0.035, 0.037, 0.045, 1);
    i = 0; loop(ceil(6 * z) + 1, gfx_arc(QX, QY, QR + 2 * z + i * 0.5, -2.35619, 2.35619, 1); i += 1; );
    i = 0;
    loop(ceil(QR), t = i / ceil(QR); a = 0.14 + 0.16 * t; gfx_set(a, a * 1.01, a * 1.06, 1);
      gfx_circle(QX - QR * 0.18 * t, QY - QR * 0.22 * t, (QR - 1.5 * z) * (1 - t * 0.92), 1, 1); i += 1; );
    gfx_set(1, 1, 1, 0.10); gfx_arc(QX, QY, QR - 1.5 * z, -1.9, 0.2, 1);
    font(1, 9); grey(1); text_c(lab, x, y + 21);
  ) : (
    hov = hit(x - 20, y - 20, 40, 40);
    mouse_click && hov ? (
      last_k == k && now - last_t < 0.3 ? ( set_done(k, pdef[k]); drag_k = -1; ) : ( drag_k = k; drag_y0 = mouse_y; drag_v0 = slider(k); );
      last_k = k; last_t = now; mouse_click = 0;
    );
    rng = pmax[k] - pmin[k];
    drag_k == k && (mouse_cap & 1) ? ( mouse_cap |= 65536; d = (drag_y0 - mouse_y) / (200 * z) * ((mouse_cap & 12) ? 0.15 : 1); set_p(k, drag_v0 + d * rng); );
    hov && mouse_wheel && drag_k < 0 ? ( set_done(k, slider(k) + sign(mouse_wheel) * max(pstep[k], rng / 60)); mouse_wheel = 0; );
    a = -2.35619 + 4.71239 * (slider(k) - pmin[k]) / rng;
    bip ? ( as = min(0, a); ae = max(0, a); ) : ( as = -2.35619; ae = a; );
    br = hov || drag_k == k ? 1 : 0.85;
    ae > as + 0.001 ? (
      gfx_set(acc_r, acc_g, acc_b, 0.10 * br);
      i = 0; loop(3, gfx_arc(QX, QY, QR + (5.5 + i * 0.7) * z, as, ae, 1); i += 1; );
      gfx_set(acc_r * br, acc_g * br, acc_b * br, 1);
      i = 0; loop(ceil(6 * z) + 1, gfx_arc(QX, QY, QR + 2 * z + i * 0.5, as, ae, 1); i += 1; );
    );
    px = sin(a); py = -cos(a);
    gfx_set(0.95, 0.95, 0.97, 1);
    gfx_circle(QX + px * QR * 0.72, QY + py * QR * 0.72, max(1.5, 2.2 * z), 1, 1);
    hov || drag_k == k ? ( hov_k = k; hov_x = x; hov_y = y - 22; hov_c = c; );
  );
);

function duty_icon(x, y, w, h, d) local(a, b, m)
(
  a = sx(x + 5); b = sx(x + w - 5); m = a + (b - a) * (d == 0 ? 0.125 : d == 1 ? 0.25 : d == 2 ? 0.5 : 0.75);
  gfx_line(a, sy(y + h - 6), a, sy(y + 6), 1); gfx_line(a, sy(y + 6), m, sy(y + 6), 1);
  gfx_line(m, sy(y + 6), m, sy(y + h - 6), 1); gfx_line(m, sy(y + h - 6), b, sy(y + h - 6), 1);
);

function duty16(x, y, w, h, f) local(a, b, m)
(
  a = sx(x + 4); b = sx(x + w - 4); m = a + (b - a) * f;
  gfx_line(a, sy(y + h - 6), a, sy(y + 6), 1); gfx_line(a, sy(y + 6), m, sy(y + 6), 1);
  gfx_line(m, sy(y + 6), m, sy(y + h - 6), 1); gfx_line(m, sy(y + h - 6), b, sy(y + h - 6), 1);
);

function seg(x, y, w, h, k, n, c, icon, lab) local(i, sw, sel, hov)
(
  acc(c);
  sw = w / n;
  pass == 0 ? (
    box(x, y, w, h);
    lab ? ( font(1, 9); grey(1); label(lab, x, y - 13); );
  ) : (
    i = 0;
    loop(n,
      sel = floor(slider(k) - pmin[k] + 0.5) == i;
      hov = hit(x + i * sw, y, sw, h);
      sel ? ( gfx_set(acc_r * 0.3, acc_g * 0.3, acc_b * 0.3, 1); gfx_rect(sx(x + i * sw), sy(y), sw * z, h * z, 1);
              gfx_set(acc_r, acc_g, acc_b, 1); gfx_rect(sx(x + i * sw), sy(y + h) - max(1, z), sw * z, max(1, z), 1); );
      hov ? ( gfx_set(1, 1, 1, 0.06); gfx_rect(sx(x + i * sw), sy(y), sw * z, h * z, 1); hov_k = k; hov_x = x + (i + 0.5) * sw; hov_y = y - 2; hov_c = c; );
      sel ? gfx_set(1, 1, 1, 1) : grey(1);
      icon == 2 ? duty16(x + i * sw, y, sw, h, (i + 1) / 16) : icon ? duty_icon(x + i * sw, y, sw, h, i) : ( font(1, 10); text_c(enum_item(penum[k], i, #si), x + (i + 0.5) * sw, y + h * 0.5 - 6); );
      mouse_click && hov ? ( set_done(k, pmin[k] + i); mouse_click = 0; );
      i += 1;
    );
  );
);

function sn_catname(c) ( c == 0 ? "Piano" : c == 1 ? "Keys" : c == 2 ? "Strings" : c == 3 ? "Brass" : c == 4 ? "Winds" : c == 5 ? "Guitar" : c == 6 ? "Bass" : c == 7 ? "Synth" : c == 8 ? "Waves" : c == 9 ? "Misc" : "Drums"; );

function sn_menu(k, s) local(v, i, c, last)
(
  v = floor(slider(k) + 0.5) - (k != 168);
  k != 168 ? strcpy(s, v < 0 ? "!Instrument menu|" : "Instrument menu|") : strcpy(s, "");
  i = 0;
  loop(203,
    c = sn_cat[i];
    (i == 0 || sn_cat[i - 1] != c) ? ( sprintf(#sn_h, ">%s|", sn_catname(c)); strcat(s, #sn_h); );
    last = i == 202 || sn_cat[i + 1] != c;
    sprintf(#sn_h, "%s%s%s|", last ? "<" : "", v == i ? "!" : "", 100 + i);
    strcat(s, #sn_h);
    i += 1;
  );
  strcat(s, v == 203 ? "!Noise" : "Noise");
);

function drop(x, y, w, k, lab, c) local(hov, h, tw, th)
(
  acc(c); h = 22;
  pass == 0 ? ( box(x, y, w, h); font(1, 9); grey(1); label(lab, x, y - 13); ) : (
    hov = hit(x, y, w, h);
    hov ? ( gfx_set(1, 1, 1, 0.05); gfx_rect(sx(x), sy(y), w * z, h * z, 1); hov_k = k; hov_x = x + w * 0.5; hov_y = y - 2; hov_c = c; );
    font(1, 11); gfx_set(0.9, 0.91, 0.93, 1);
    fmt_p(k, #dd); gfx_measurestr(#dd, tw, th);
    gfx_x = sx(x + 7); gfx_y = sy(y) + (h * z - th) * 0.5; gfx_drawstr(#dd);
    gfx_set(acc_r, acc_g, acc_b, hov ? 1 : 0.8);
    gfx_triangle(sx(x + w - 13), sy(y + 9), sx(x + w - 5), sy(y + 9), sx(x + w - 9), sy(y + 13.5));
    gfx_rect(sx(x), sy(y + h) - max(1, z), w * z, max(1, z), 1);
    mouse_click && hov ? (
      mouse_click = 0; gfx_x = sx(x); gfx_y = sy(y + h);
      pfmt[k] == 21 ? sn_menu(k, #mn) : pfmt[k] == 1 ? enum_menu(penum[k], floor(slider(k) - pmin[k] + 0.5), #mn) : (
        strcpy(#mn, ""); th = pmin[k];
        loop(pmax[k] - pmin[k] + 1, strcat(#mn, sprintf(#si, "%s%s%d", th > pmin[k] ? "|" : "", th == slider(k) ? "!" : "", th)); th += 1; );
      );
      th = gfx_showmenu(#mn);
      th > 0 ? set_done(k, pmin[k] + th - 1);
    );
  );
);

function screen(x, y, w, h) (
  gfx_set(0, 0, 0, 0.55); gfx_rect(sx(x) - z, sy(y) - z, (w + 2) * z, (h + 2) * z, 1);
  gfx_set(0.035, 0.038, 0.045, 1); gfx_rect(sx(x), sy(y), w * z, h * z, 1);
);

function env_view(x, y, w, h, k, gb, lv, c) local(a, d, s, r, tot, x1, x2, x3, yb, yt, i, v, px, py, st)
(
  acc(c);
  pass == 0 ? screen(x, y, w, h) : (
    yb = sy(y + h - 5); yt = sy(y + 5);
    gfx_set(acc_r, acc_g, acc_b, 0.9);
    gb ? (
      v = slider(k); s = slider(k + 1);
      px = sx(x + 4); py = yb - (yb - yt) * v / 15;
      st = s ? (w - 8) * z * abs(s) / 109 : (w - 8) * z;
      while (
        gfx_line(px, py, min(px + st, sx(x + w - 4)), py, 1);
        px += st;
        (s < 0 && v > 0) || (s > 0 && v < 15) ? (
          v += sign(s);
          px < sx(x + w - 4) ? gfx_line(px, py, px, yb - (yb - yt) * v / 15, 1);
          py = yb - (yb - yt) * v / 15;
        );
        px < sx(x + w - 4) && s;
      );
    ) : (
      a = slider(k); d = slider(k + 1); s = slider(k + 2) / 15; r = slider(k + 3);
      tot = max(1, a + d + 20 + r);
      x1 = sx(x + 4) + (w - 8) * z * a / tot; x2 = x1 + (w - 8) * z * d / tot; x3 = x2 + (w - 8) * z * 20 / tot;
      gfx_line(sx(x + 4), yb, x1, yt, 1); gfx_line(x1, yt, x2, yb - (yb - yt) * s, 1);
      gfx_line(x2, yb - (yb - yt) * s, x3, yb - (yb - yt) * s, 1); gfx_line(x3, yb - (yb - yt) * s, sx(x + w - 4), yb, 1);
    );
    lv > 0 ? ( gfx_set(acc_r, acc_g, acc_b, 0.25); gfx_rect(sx(x), yb - (yb - yt) * lv / 15, w * z, max(1, z), 1); );
  );
);

function wave_view(x, y, w, h, c, k, tab, mx, pos) local(i, bw, v, w_, hov, j, a, b, n)
(
  acc(c);
  pass == 0 ? screen(x, y, w, h) : (
    w_ = floor(slider(k) + 0.5); bw = (w - 8) / 32;
    i = 0;
    loop(32,
      v = tab[w_ * 32 + i];
      gfx_set(acc_r, acc_g, acc_b, i == pos ? 1 : 0.55);
      gfx_rect(sx(x + 4 + i * bw), sy(y + h - 4) - (h - 8) * z * (v + 1) / (mx + 1), max(1, bw * z - z), (h - 8) * z * (v + 1) / (mx + 1), 1);
      i += 1;
    );
    hov = hit(x, y, w, h);
    hov ? ( hov_k = k; hov_x = x + w * 0.5; hov_y = y - 2; hov_c = c; );
    mouse_click && hov ? (
      mouse_click = 0; g_wk = k; g_wl = -1;
      w_ != 8 ? ( memcpy(tab + 256, tab + w_ * 32, 32); set_done(k, 8); );
    );
    g_wk == k && (mouse_cap & 1) ? (
      i = max(0, min(31, floor((mouse_x - sx(x + 4)) / (bw * z))));
      v = max(0, min(mx, floor((sy(y + h - 4) - mouse_y) / ((h - 8) * z) * (mx + 1))));
      g_wl < 0 ? ( g_wl = i; g_wlv = v; );
      a = min(g_wl, i); b = max(g_wl, i); j = a;
      loop(b - a + 1,
        n = b == a ? v : floor(g_wlv + (v - g_wlv) * (j - g_wl) / (i - g_wl) + 0.5);
        tab[256 + j] !== n ? ( tab[256 + j] = n; k == 58 ? cy_wv += 1 : cy_pv += 1; );
        j += 1;
      );
      g_wl = i; g_wlv = v;
    );
    g_rclick && hov ? (
      g_rclick = 0; gfx_x = mouse_x; gfx_y = mouse_y;
      i = gfx_showmenu(enum_menu(penum[k], w_, #mn));
      i > 0 ? set_done(k, i - 1);
    );
  );
);

function note_str(n, s) local(p) (
  p = n % 12;
  sprintf(s, "%s%d", p == 0 ? "C-" : p == 1 ? "C#" : p == 2 ? "D-" : p == 3 ? "D#" : p == 4 ? "E-" : p == 5 ? "F-" :
    p == 6 ? "F#" : p == 7 ? "G-" : p == 8 ? "G#" : p == 9 ? "A-" : p == 10 ? "A#" : "B-", floor(n / 12) - 1);
);

function ch_level(c) local(k, m) (
  m = 0; k = 0; loop(nchips, m = max(m, vb[(k * 16 + c) * 64 + 46]); k += 1; );
  c == 4 && con == 0 ? m = dmc_act ? 15 : 0;
  m;
);

function pick_v(c) local(k, v, b, ba)
(
  b = vb + c * 64; ba = -1; k = 0;
  loop(nchips, v = vb + (k * 16 + c) * 64; (v[8] || v[46]) && v[9] > ba ? ( b = v; ba = v[9]; ); k += 1; );
  b;
);

function chan(x, y, w, c, title) local(v, lv, hov)
(
  panel(x, y, 227, 330, title, c >= 5 ? c + 1 : c);
  pass == 1 ? (
    acc(c >= 5 ? c + 1 : c);
    hov = hit(x, y, 227, 24);
    slider10 == c ? ( gfx_set(acc_r, acc_g, acc_b, 0.9); gfx_circle(sx(x + 214), sy(y + 14), 3.5 * z, 1, 1); ) :
      ( gfx_set(acc_r, acc_g, acc_b, hov ? 0.6 : 0.2); gfx_circle(sx(x + 214), sy(y + 14), 3.5 * z, 0, 1); );
    mouse_click && hov ? ( set_done(10, c); mouse_click = 0; );
    v = pick_v(c); lv = ch_level(c);
    font(2, 12);
    lc_r = acc_r; lc_g = acc_g; lc_b = acc_b;
    v[8] || lv ? note_str(floor(v[1] + 0.5), #cn) : strcpy(#cn, "---");
    glow_str(#cn, sx(x + 12), sy(y + 28));
    font(2, 10); grey(0.8);
    sprintf(#cp, c == 3 && con != 1 ? "$%X" : "$%03X", v[47]); label(#cp, x + 58, y + 30);
    gfx_set(0, 0, 0, 0.5); gfx_rect(sx(x + 110), sy(y + 31), 104 * z, 7 * z, 1);
    gfx_set(acc_r, acc_g, acc_b, 0.9); gfx_rect(sx(x + 110), sy(y + 31), 104 * z * lv / 15, 7 * z, 1);
  );
);

// ---------------------------------------------------------------------- header
function logo() local(tw, th)
(
  pass == 0 ? (
    font(1, 21);
    gfx_measurestr("CONSOLE", tw, th);
    acc(5); gfx_set(acc_r, acc_g, acc_b, 1); label("CONSOLE", 18, 12);
    gfx_set(0.92, 0.93, 0.95, 1); gfx_x = sx(18) + tw; gfx_y = sy(12); gfx_drawstr("YOURSELF");
    gfx_setfont(1, "Arial", 12 * z); gfx_set(0.5, 0.52, 0.56, 1);
    label(con == 0 ? ( nexp == 2 ? "by chmaha  ·  Nes_Snd_Emu (Shay Green) + ymfm (Aaron Giles)" : "by chmaha  ·  Nes_Snd_Emu (Shay Green)" ) : con == 1 ? "by chmaha  ·  MAME Game Boy core" : con == 2 ? "by chmaha  ·  MAME SN76496 core" : con == 3 ? "by chmaha  ·  ymfm (Aaron Giles) + MAME" : con == 5 ? "by chmaha  ·  snes_spc (Shay Green)" : "by chmaha  ·  MAME HuC6280 core", 20, 36);
  );
);

function tabs() local(i, hov, sel, x, y, c)
(
  i = 0;
  loop(6,
    pass == 1 ? (
      c = i == 2 ? 5 : i > 2 ? i - 1 : i;
      x = 18 + (i % 3) * 78; y = 52 + floor(i / 3) * 21; sel = con == c; hov = hit(x, y, 74, 19);
      acc(5);
      sel ? ( gfx_set(acc_r * 0.35, acc_g * 0.35, acc_b * 0.35, 1); gfx_rect(sx(x), sy(y), 74 * z, 19 * z, 1);
              gfx_set(acc_r, acc_g, acc_b, 1); gfx_rect(sx(x), sy(y + 17), 74 * z, 2 * z, 1); ) :
            ( gfx_set(0.1, 0.105, 0.12, 1); gfx_rect(sx(x), sy(y), 74 * z, 19 * z, 1); );
      hov && !sel ? ( gfx_set(1, 1, 1, 0.06); gfx_rect(sx(x), sy(y), 74 * z, 19 * z, 1); );
      font(1, 9); sel ? gfx_set(1, 1, 1, 1) : grey(1);
      text_c(c == 0 ? "NES" : c == 1 ? "GAME BOY" : c == 2 ? "MASTER SYS" : c == 3 ? "MEGA DRIVE" : c == 4 ? "PC ENGINE" : "SNES", x + 37, y + 4);
      mouse_click && hov && !sel ? ( set_done(1, c); mouse_click = 0; );
    );
    i += 1;
  );
);

function lcd() local(x, y, w, h, tw, th, c, v, i, k, e6, e7, c0, ws)
(
  x = 262; y = 10; w = 436; h = 72;
  con == 1 ? ( lc_r = 0.61; lc_g = 0.74; lc_b = 0.06; ) : con == 2 ? ( lc_r = 0.35; lc_g = 0.75; lc_b = 1; ) : con == 3 ? ( lc_r = 1; lc_g = 0.35; lc_b = 0.3; ) : con == 4 ? ( lc_r = 1; lc_g = 0.85; lc_b = 0.4; ) : con == 5 ? ( lc_r = 0.78; lc_g = 0.62; lc_b = 1; ) : ( lc_r = 1; lc_g = 0.62; lc_b = 0.28; );
  pass == 0 ? (
    gfx_set(0, 0, 0, 0.6); gfx_rect(sx(x) - 2 * z, sy(y) - 2 * z, (w + 4) * z, (h + 4) * z, 1);
    con == 1 ? gfx_set(0.05, 0.08, 0.03, 1) : con == 2 ? gfx_set(0.02, 0.05, 0.08, 1) : con == 3 ? gfx_set(0.08, 0.025, 0.025, 1) : con == 4 ? gfx_set(0.08, 0.065, 0.02, 1) : con == 5 ? gfx_set(0.05, 0.035, 0.08, 1) : gfx_set(0.07, 0.045, 0.028, 1);
    gfx_rect(sx(x), sy(y), w * z, h * z, 1);
  ) : (
    font(2, 11);
    e6 = con == 0 && g_nv && nexp == 1; e7 = con == 0 && g_nv && nexp == 2; c0 = e6 || e7 ? 5 : 0; ws = con >= 3 || e7;
    glow_str(con == 0 && nexp ? ( nexp == 1 ? "FAMICOM  2A03 + VRC6" : "FAMICOM  2A03 + VRC7" ) : con == 1 ? "GAME BOY  DMG APU" : con == 2 ? "MASTER SYSTEM  SN76489" : con == 3 ? ( slider103 ? "MEGA DRIVE  YM3438" : "MEGA DRIVE  YM2612" ) : con == 4 ? "PC ENGINE  HuC6280" : con == 5 ? "SUPER NES  S-DSP" : "NES  2A03 APU", sx(x + 10), sy(y + 6));
    slider2 ? strcpy(#lt, "TRACKER") : sprintf(#lt, "LAYER  %d CHIP%s", nchips, nchips > 1 ? "S" : "");
    gfx_measurestr(#lt, tw, th); glow_str(#lt, sx(x + w - 10) - tw, sy(y + 6));
    midi_led = midi_flag ? now : midi_led; midi_flag = 0;
    gfx_set(lc_r, lc_g, lc_b, now - midi_led < 0.12 ? 1 : 0.16);
    gfx_circle(sx(x + w - 18) - tw, sy(y + 6) + th * 0.5, 2.8 * z, 1, 1);
    hov_k >= 0 || now - touched_t < 1.6 ? (
      k = hov_k >= 0 ? hov_k : touched_k;
      font(2, 12); glow_str(pname[k], sx(x + 10), sy(y + 30));
      font(2, 17); fmt_p(k, #lv); gfx_measurestr(#lv, tw, th); glow_str(#lv, sx(x + w - 10) - tw, sy(y + 27));
    ) : (
      font(2, ws ? 13 : 15); i = 0;
      loop(con == 5 ? 8 : ws ? 6 : e6 ? 3 : 4,
        v = pick_v(c0 + i);
        v[8] || v[46] ? note_str(floor(v[1] + 0.5), #lt) : strcpy(#lt, "---");
        glow_str(#lt, sx(x + 16 + i * (con == 5 ? 53 : ws ? 70 : 106)), sy(y + 28));
        i += 1;
      );
    );
    font(2, 9); i = 0;
    loop(e7 ? 6 : e6 ? 3 : con == 0 ? 5 : con == 5 ? 8 : con >= 3 ? 6 : 4,
      c = ch_level(c0 + i);
      con == 5 ? (
        sprintf(#lb, "V%d", i + 1); glow_str(#lb, sx(x + 10 + i * 53), sy(y + 54));
        k = 0; loop(4, gfx_set(lc_r, lc_g, lc_b, k < c / 3.75 ? 0.9 : 0.14); gfx_rect(sx(x + 28 + i * 53 + k * 5), sy(y + 56), 3.5 * z, 6 * z, 1); k += 1; );
      ) : (
      ws ? sprintf(#lb, con == 3 || e7 ? "F%d" : "C%d", i + 1) : e6 ? strcpy(#lb, i == 0 ? "P1" : i == 1 ? "P2" : "SW") :
      strcpy(#lb, i == 3 ? "NO" : i == 4 ? "DM" : con == 2 ? ( i == 0 ? "T1" : i == 1 ? "T2" : "T3" ) : i == 0 ? "P1" : i == 1 ? "P2" : con ? "WV" : "TR");
      glow_str(#lb, sx(x + 10 + i * (ws ? 70 : 85)), sy(y + 54));
      k = 0; loop(ws ? 6 : 8, gfx_set(lc_r, lc_g, lc_b, k < c / (ws ? 2.5 : 2) ? 0.9 : 0.14); gfx_rect(sx(x + 30 + i * (ws ? 70 : 85) + k * 6), sy(y + 56), 4 * z, 6 * z, 1); k += 1; );
      );
      i += 1;
    );
    gfx_set(0, 0, 0, 0.2);
    i = sy(y); while (i < sy(y + h)) ( gfx_rect(sx(x), i, w * z, max(1, floor(z)), 1); i += 3 * z; );
  );
);

function scope_view(x, y, w, h) local(QX, QY, QW, QH, i, n, st, tr, p, v, px, py, yy)
(
  acc(con ? 2 : 5);
  pass == 0 ? screen(x, y, w, h) : (
    QX = sx(x + 2); QY = sy(y + 2); QW = (w - 4) * z; QH = (h - 4) * z;
    n = floor(QW / max(1, z));
    st = (scope_p - n * 2 - 800) & 4095; tr = st;
    i = 0; v = scope[st];
    while (i < 800) ( p = (st + i) & 4095; v < 0 && scope[p] >= 0 ? ( tr = p; i = 800; ); v = scope[p]; i += 1; );
    i = 0;
    loop(n,
      yy = QY + QH * 0.5 - max(-1, min(1, scope[(tr + i * 2) & 4095] * 1.6)) * QH * 0.46;
      i ? ( gfx_set(acc_r, acc_g, acc_b, 0.95); gfx_line(px, py, QX + i / n * QW, yy, 1); );
      px = QX + i / n * QW; py = yy;
      i += 1;
    );
  );
);

function keyboard(x, y, w, h) local(ww, bw, bh, i, n, pc, isb, wi, hovn, QX, QY, QH, kx, kw, lit, snd, c, v)
(
  ww = w / 36; bw = ww * 0.62; bh = h * 0.62;
  QX = sx(x); QY = sy(y); QH = h * z;
  pass == 1 ? (
    memset(vact, 0, 128);
    c = 0; loop(nchips * 16, v = vb + c * 64; v[8] ? vact[floor(v[1] + 0.5) & 127] = 1; c += 1; );
    hovn = -1;
    hit(x, y, w, h) ? (
      n = 36; wi = 0;
      loop(61, pc = n % 12; isb = pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10;
        isb && mouse_y < QY + bh * z && mouse_x >= sx(x + wi * ww - bw * 0.5) && mouse_x < sx(x + wi * ww + bw * 0.5) ? hovn = n;
        !isb ? wi += 1; n += 1; );
      hovn < 0 ? ( wi = floor((mouse_x - QX) / (ww * z)); pc = wi % 7;
        hovn = 36 + floor(wi / 7) * 12 + (pc == 0 ? 0 : pc == 1 ? 2 : pc == 2 ? 4 : pc == 3 ? 5 : pc == 4 ? 7 : pc == 5 ? 9 : 11); );
    );
    mouse_click && hovn >= 0 ? ( kb_note = -1; kb_on = 1; mouse_click = 0; );
    kb_on && (!(mouse_cap & 1) || hovn != kb_note) ? (
      kb_note >= 0 ? ( gq[gq_w * 3] = 128; gq[gq_w * 3 + 1] = kb_note; gq[gq_w * 3 + 2] = slider10; gq_w = (gq_w + 1) & 63; );
      kb_note = -1;
      !(mouse_cap & 1) ? kb_on = 0 : hovn >= 0 ? (
        gq[gq_w * 3] = 144 + floor(40 + 87 * max(0, min(1, (mouse_y - QY) / QH))) * 256; gq[gq_w * 3 + 1] = hovn; gq[gq_w * 3 + 2] = slider10;
        gq_w = (gq_w + 1) & 63; kb_note = hovn;
      );
    );
    i = 0;
    loop(2,
      n = 36; wi = 0;
      loop(61,
        pc = n % 12; isb = pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10;
        lit = kdown[n] || kb_note == n; snd = vact[n];
        i == 0 && !isb ? (
          kx = floor(sx(x + wi * ww)) + max(1, floor(z)); kw = floor(sx(x + (wi + 1) * ww)) - kx;
          lit ? ( kacc(); gfx_set(acc_r, acc_g, acc_b, 1); ) : gfx_set(0.86, 0.87, 0.9, 1);
          gfx_rect(kx, QY, kw, QH, 1);
          snd && !lit ? ( kacc(); gfx_set(acc_r, acc_g, acc_b, 0.5); gfx_rect(kx, QY + QH - 6 * z, kw, 6 * z, 1); );
          pc == 0 ? ( font(1, 8); gfx_set(0.35, 0.36, 0.4, 1); sprintf(#kl, "C%d", floor(n / 12) - 1); text_c(#kl, x + (wi + 0.5) * ww, y + h - 12); );
        );
        i == 1 && isb ? (
          kx = floor(sx(x + wi * ww - bw * 0.5));
          lit ? ( kacc(); gfx_set(acc_r * 0.8, acc_g * 0.8, acc_b * 0.8, 1); ) : gfx_set(0.08, 0.085, 0.095, 1);
          gfx_rect(kx, QY, bw * z, bh * z, 1);
          snd && !lit ? ( kacc(); gfx_set(acc_r, acc_g, acc_b, 0.6); gfx_rect(kx + 2 * z, QY + bh * z - 7 * z, bw * z - 4 * z, 5 * z, 1); );
        );
        !isb ? wi += 1; n += 1;
      );
      i += 1;
    );
  );
);

// ---------------------------------------------------------------------- Mega Drive FM editor
function md_is_car(i) local(a) ( a = slider104; i == 3 || a == 7 || (i == 1 && a >= 4) || (i == 2 && a >= 5); );

function alg_view(x, y, w, h) local(a, i, j, px, py, qx, qy, bx, by, ox, bw)
(
  acc(5);
  pass == 0 ? screen(x, y, w, h) : (
    a = floor(slider104 + 0.5); bw = 20;
    ox = x + w - 16;
    gfx_set(acc_r, acc_g, acc_b, 0.5); gfx_line(sx(ox), sy(y + 10), sx(ox), sy(y + h - 10), 1);
    i = 0;
    loop(4,
      px = x + 14 + md_apos[a * 8 + i * 2] * 42; py = y + 22 + md_apos[a * 8 + i * 2 + 1] * 26;
      j = 0;
      loop(4,
        md_alg[a * 8 + (i == 0 ? (j == 1 ? 0 : j == 2 ? 1 : j == 3 ? 3 : -1) : i == 1 ? (j == 2 ? 2 : j == 3 ? 4 : -1) : i == 2 ? (j == 3 ? 5 : -1) : -1)] &&
        j > i && (i == 0 ? j >= 1 : i == 1 ? j >= 2 : j == 3) ? (
          qx = x + 14 + md_apos[a * 8 + j * 2] * 42; qy = y + 22 + md_apos[a * 8 + j * 2 + 1] * 26;
          gfx_set(0.7, 0.72, 0.76, 0.8); gfx_line(sx(px + bw), sy(py + bw * 0.5), sx(qx), sy(qy + bw * 0.5), 1);
        );
        j += 1;
      );
      md_is_car(i) ? ( gfx_set(acc_r, acc_g, acc_b, 0.8); gfx_line(sx(px + bw), sy(py + bw * 0.5), sx(ox), sy(py + bw * 0.5), 1); );
      i += 1;
    );
    i = 0;
    loop(4,
      bx = x + 14 + md_apos[a * 8 + i * 2] * 42; by = y + 22 + md_apos[a * 8 + i * 2 + 1] * 26;
      md_is_car(i) ? gfx_set(acc_r * 0.45, acc_g * 0.45, acc_b * 0.45, 1) : gfx_set(0.16, 0.17, 0.2, 1);
      gfx_rect(sx(bx), sy(by), bw * z, bw * z, 1);
      md_is_car(i) ? gfx_set(acc_r, acc_g, acc_b, 1) : gfx_set(0.5, 0.52, 0.56, 1);
      gfx_rect(sx(bx), sy(by), bw * z, bw * z, 0);
      font(1, 10); gfx_set(1, 1, 1, 1); sprintf(#an, "%d", i + 1); text_c(#an, bx + bw * 0.5, by + 4);
      i == 0 && slider105 > 0 ? ( gfx_set(acc_r, acc_g, acc_b, 0.7); gfx_arc(sx(bx + bw * 0.5), sy(by), 7 * z, -1.4, 1.4, 1); );
      i += 1;
    );
    font(1, 9); grey(0.8); sprintf(#an, "ALGORITHM %d", a); label(#an, x + 6, y + 4);
  );
);

function fm_env(x, y, w, h, p, c) local(ar, dr, sl, sr, rr, x1, x2, x3, yb, yt, ys, ye)
(
  acc(c);
  pass == 0 ? screen(x, y, w, h) : (
    ar = slider(p); dr = slider(p + 1); sl = slider(p + 2); sr = slider(p + 3); rr = slider(p + 4);
    yb = sy(y + h - 5); yt = sy(y + 5) + (h - 10) * z * slider(p + 5) / 127;
    ys = yt + (yb - yt) * sl / 15;
    x1 = sx(x + 4) + (w - 8) * z * (ar ? 0.3 * (31 - ar) / 31 : 0);
    x2 = x1 + (w - 8) * z * (dr ? 0.05 + 0.25 * (31 - dr) / 31 : 0.3);
    x3 = sx(x + 4) + (w - 8) * z * 0.75;
    ye = sr ? min(yb, ys + (yb - ys) * sr / 31 * 1.5) : ys;
    gfx_set(acc_r, acc_g, acc_b, ar ? 0.9 : 0.3);
    gfx_line(sx(x + 4), yb, x1, yt, 1); gfx_line(x1, yt, x2, dr ? ys : yt, 1);
    gfx_line(x2, dr ? ys : yt, x3, dr ? ye : yt, 1);
    gfx_line(x3, dr ? ye : yt, x3 + (sx(x + w - 4) - x3) * (0.2 + 0.8 * (15 - rr) / 15), yb, 1);
  );
);

function op_panel(x, i) local(p, c)
(
  p = 112 + i * 11; c = md_is_car(i) ? 5 : 4;
  pass == 0 ? panel(x, 176, 176, 330, i == 0 ? "OPERATOR 1" : i == 1 ? "OPERATOR 2" : i == 2 ? "OPERATOR 3" : "OPERATOR 4", c) : (
    acc(c); font(1, 9); gfx_set(acc_r, acc_g, acc_b, 0.9);
    label(md_is_car(i) ? "CARRIER" : "MODULATOR", x + 12, 198);
  );
  fm_env(x + 12, 214, 152, 66, p, c);
  knob(x + 36, 308, p, "ATTACK", c, 0);
  knob(x + 88, 308, p + 1, "DECAY", c, 0);
  knob(x + 140, 308, p + 2, "SUSTAIN", c, 0);
  knob(x + 36, 364, p + 3, "SUS RATE", c, 0);
  knob(x + 88, 364, p + 4, "RELEASE", c, 0);
  knob(x + 140, 364, p + 5, "LEVEL", c, 0);
  knob(x + 36, 420, p + 6, "MULTIPLE", c, 0);
  knob(x + 88, 420, p + 7, "DETUNE", c, 1);
  knob(x + 140, 420, p + 8, "KEY SCALE", c, 0);
  seg(x + 12, 472, 60, 22, p + 9, 2, c, 0, "AM");
  drop(x + 80, 472, 84, p + 10, "SSG-EG", c);
);

// ---------------------------------------------------------------------- SNES page
function sn_sample_view(x, y, w, h) local(i, k, m, bw, cy, lp)
(
  acc(0);
  pass == 0 ? screen(x, y, w, h) : (
    k = floor(slider168 + 0.5); bw = (w - 8) / 128; cy = y + h * 0.5;
    i = 0;
    loop(128,
      m = sn_view[k * 128 + i] * (h * 0.5 - 5);
      gfx_set(acc_r, acc_g, acc_b, 0.75);
      gfx_rect(sx(x + 4 + i * bw), sy(cy - m), max(1, bw * z), max(1, 2 * m * z), 1);
      i += 1;
    );
    lp = sn_lo[k];
    font(1, 9); grey(0.8);
    lp < 0 ? label("ONE SHOT", x, y + h + 8) : k == 203 ? label("HARDWARE NOISE", x, y + h + 8) : (
      label(lp ? "ATTACK + LOOP" : "LOOP", x, y + h + 8);
      gfx_set(1, 1, 1, 0.35); gfx_rect(sx(x + 4 + lp * (w - 8)), sy(y + 2), max(1, z), (h - 4) * z, 1);
    );
  );
);

function sn_adsr_view(x, y, w, h, ar, dr, sl, sr, rel) local(ta, td, ts, tr, sc, x0, x1, x2, x3, x4, yb, yt, ys, i, e, px, py, qx, qy, lv)
(
  acc(1);
  pass == 0 ? screen(x, y, w, h) : (
    ta = sn_tms[ar]; td = dr < 7 || sl < 7 ? sn_tms[16 + dr] * (1 - (sl + 1) / 8) : 0; ts = 600; tr = rel ? sn_tms[24 + rel] : 8;
    sc = max(1, ta + td + ts + tr);
    yb = sy(y + h - 6); yt = sy(y + 6); lv = (sl + 1) / 8;
    x0 = sx(x + 4); x1 = x0 + (w - 8) * z * ta / sc; x2 = x1 + (w - 8) * z * td / sc; x3 = x2 + (w - 8) * z * ts / sc; x4 = sx(x + w - 4);
    gfx_set(acc_r, acc_g, acc_b, 0.9);
    gfx_line(x0, yb, x1, yt, 1);
    px = x1; py = yt; i = 1;
    loop(16, qx = x1 + (x2 - x1) * i / 16; e = lv + (1 - lv) * exp(-4 * i / 16) - (1 - lv) * exp(-4) * i / 16; qy = yb - (yb - yt) * e;
      gfx_line(px, py, qx, qy, 1); px = qx; py = qy; i += 1; );
    i = 1; e = lv;
    loop(16, qx = x2 + (x3 - x2) * i / 16; qy = yb - (yb - yt) * (sr ? lv * exp(-2.3 * ts / sn_tms[24 + sr] * i / 16) : lv);
      gfx_line(px, py, qx, qy, 1); px = qx; py = qy; i += 1; );
    e = (yb - py) / max(1, yb - yt); i = 1;
    loop(16, qx = x3 + (x4 - x3) * i / 16; qy = yb - (yb - yt) * e * (rel ? exp(-5 * i / 16) * (1 - i / 16) : 1 - i / 16);
      gfx_line(px, py, qx, qy, 1); px = qx; py = qy; i += 1; );
    gfx_set(1, 1, 1, 0.15); gfx_rect(x3, sy(y + 2), max(1, z), (h - 4) * z, 1);
    font(1, 8); grey(0.6); label("KEY OFF", x + 4 + (x3 - x0) / z + 3, y + 4);
  );
);

function sn_echo_view(x, y, w, h) local(i, d, a, fb, px, ev)
(
  acc(3);
  pass == 0 ? screen(x, y, w, h) : (
    d = slider179 * 16; fb = slider180 / 100; ev = slider178 ? slider181 / 100 : 0;
    gfx_set(0.9, 0.9, 0.92, 0.9); gfx_rect(sx(x + 6), sy(y + 8), 2 * z, (h - 16) * z, 1);
    i = 1; a = ev;
    loop(24,
      px = x + 6 + (w - 14) * i * d / 1500;
      px < x + w - 6 && abs(a) > 0.01 ? (
        gfx_set(acc_r, acc_g, acc_b, 0.9);
        a > 0 ? gfx_rect(sx(px), sy(y + h * 0.5) - (h * 0.5 - 8) * z * a, 2 * z, (h * 0.5 - 8) * z * a, 1) :
                gfx_rect(sx(px), sy(y + h * 0.5), 2 * z, -(h * 0.5 - 8) * z * a, 1);
      );
      a *= fb; i += 1;
    );
    gfx_set(1, 1, 1, 0.12); gfx_rect(sx(x + 4), sy(y + h * 0.5), (w - 8) * z, max(1, z), 1);
    font(1, 8); grey(0.6); label("1.5 S", x + w - 30, y + h - 14);
  );
);

function sn_cdrop(x, y, w, k, c) local(hov, h, tw, th)
(
  acc(c); h = 16;
  pass == 0 ? box(x, y, w, h) : (
    hov = hit(x, y, w, h);
    hov ? ( gfx_set(1, 1, 1, 0.05); gfx_rect(sx(x), sy(y), w * z, h * z, 1); hov_k = k; hov_x = x + w * 0.5; hov_y = y - 2; hov_c = c; );
    font(1, 8); gfx_set(0.9, 0.91, 0.93, 1);
    fmt_p(k, #dd); gfx_measurestr(#dd, tw, th);
    gfx_x = sx(x + 6); gfx_y = sy(y) + (h * z - th) * 0.5; gfx_drawstr(#dd);
    gfx_set(acc_r, acc_g, acc_b, hov ? 1 : 0.8);
    gfx_triangle(sx(x + w - 12), sy(y + 6), sx(x + w - 5), sy(y + 6), sx(x + w - 8.5), sy(y + 10));
    mouse_click && hov ? (
      mouse_click = 0; gfx_x = sx(x); gfx_y = sy(y + h);
      pfmt[k] == 21 ? sn_menu(k, #mn) : enum_menu(penum[k], floor(slider(k) - pmin[k] + 0.5), #mn);
      th = gfx_showmenu(#mn);
      th > 0 ? set_done(k, pmin[k] + th - 1);
    );
  );
);

function sn_channels() local(i, y)
(
  panel(721, 176, 227, 330, "CHANNELS", 2);
  i = 0;
