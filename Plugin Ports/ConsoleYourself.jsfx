function gb_pan(t) local(i, nl, nr, pos) (
  pos = (t - blk_t0) * spc + 1;
  i = 1;
  loop(4,
    nl = ((gb_regs[21] >> (3 + i)) & 1) ? ((gb_regs[20] >> 4) & 7) + 1 : 0;
    nr = ((gb_regs[21] >> (i - 1)) & 1) ? (gb_regs[20] & 7) + 1 : 0;
    gba[i] && (nl != gbl[i] || nr != gbr[i]) ? ( gb_put(pos, -gba[i], gbl[i], gbr[i]); gb_put(pos, gba[i], nl, nr); );
    gbl[i] = nl; gbr[i] = nr;
    i += 1;
  );
);

// ---------------------------------------------------------------------- tables
function hash(i) ( i = sin(i * 12.9898) * 43758.5453; i - floor(i); );

function make_dpcm() local(s, n, i, x, y, ph, f, dac, b, bits, a, len, ln, addr) (
  addr = 16384;
  s = 0;
  loop(4,
    n = s == 0 ? 4000 : s == 1 ? 3300 : s == 2 ? 6600 : 4400;
    dac = 64; i = 0; ph = 0; b = 0; bits = 0; a = addr;
    loop(n,
      x = i / 33144;
      s == 0 ? ( f = 45 + 115 * exp(-x * 40); ph += f / 33144; y = sin(2 * $pi * ph) * exp(-x * 18); ) :
      s == 1 ? ( ph += 185 / 33144; y = (0.6 * (hash(i) * 2 - 1) + 0.5 * sin(2 * $pi * ph) * exp(-x * 30)) * exp(-x * 22); ) :
      s == 2 ? ( f = 95 + 60 * exp(-x * 12); ph += f / 33144; y = sin(2 * $pi * ph) * exp(-x * 9); ) :
      ( y = (hash(i + 7) * 2 - 1) * (x < 0.036 ? exp(-(x - floor(x / 0.012) * 0.012) * 250) : exp(-(x - 0.036) * 20)); );
      y = 64 + 58 * y;
      y > dac && dac < 126 ? ( dac += 2; bits += 2 ^ b; ) : dac > 1 ? dac -= 2;
      (b += 1) == 8 ? ( nes_rom[a] = bits; a += 1; b = 0; bits = 0; );
      i += 1;
    );
    b ? ( nes_rom[a] = bits; a += 1; );
    len = a - addr; ln = ceil((len - 1) / 16);
    loop(ln * 16 + 1 - len, nes_rom[a] = 85; a += 1; );
    dpa[s * 2] = (addr - 16384) / 64; dpa[s * 2 + 1] = ln;
    addr = ceil(a / 64) * 64;
    s += 1;
  );
);

function make_waves() local(w, i, x, y) (
  w = 0;
  loop(8,
    i = 0;
    loop(32,
      x = i / 32;
      y = w == 0 ? 0.5 + 0.5 * sin(2 * $pi * x) :
          w == 1 ? 1 - abs(2 * x - 1) :
          w == 2 ? i / 31 :
          w == 3 ? x < 0.5 :
          w == 4 ? x < 0.25 :
          w == 5 ? x < 0.125 :
          w == 6 ? 0.5 + 0.28 * (sin(2 * $pi * x) + 0.5 * sin(4 * $pi * x) + 0.33 * sin(6 * $pi * x)) :
          0.5 + 0.5 * max(-1, min(1, 2.2 * sin(2 * $pi * x)));
      waves[w * 32 + i] = max(0, min(15, floor(y * 15 + 0.5)));
      i += 1;
    );
    w += 1;
  );
);

function make_pce_waves() local(w, i) (
  w = 0;
  loop(8, i = 0; loop(32, pce_waves[w * 32 + i] = floor(waves[w * 32 + i] * 31 / 15 + 0.5); i += 1; ); w += 1; );
);

function make_ntab() local(s, d, p, n, i, j, x, y) (
  n = 0; s = 0;
  loop(14,
    d = 0;
    loop(8,
      p = gb_ndiv[d] * 2 ^ s;
      i = 0; x = 0; while (i < n && !x) ( gb_ntab[i * 2] == p ? x = 1; i += 1; );
      !x ? ( gb_ntab[n * 2] = p; gb_ntab[n * 2 + 1] = s * 16 + d; n += 1; );
      d += 1;
    );
    s += 1;
  );
  i = 1;
  while (i < n) (
    j = i;
    while (j > 0 && gb_ntab[j * 2 - 2] > gb_ntab[j * 2]) (
      x = gb_ntab[j * 2]; y = gb_ntab[j * 2 + 1];
      gb_ntab[j * 2] = gb_ntab[j * 2 - 2]; gb_ntab[j * 2 + 1] = gb_ntab[j * 2 - 1];
