    drop(404, 128, 58, 200, "EXPANSION", 4);
    drop(478, 128, 48, 5, "BEND", 4);
  ) : (
    con == 5 ? drop(118, 128, 150, 168, "INSTRUMENT", 4) : con == 3 ? drop(118, 128, 150, 103, "CHIP", 4) : con == 4 ? drop(118, 128, 150, 156, "WAVE", 4) : drop(118, 128, 150, con == 1 ? 40 : 71, "LAYER", 4);
    drop(278, 128, 56, 3, "CHIPS", 4);
    con == 2 ? drop(344, 128, 110, 70, "MODEL", 4) : con == 3 ? drop(344, 128, 96, 111, "PAN", 4) : con == 4 ? drop(344, 128, 96, 163, "PAN", 4);
