// ---------------------------------------------------------------------- reset
function reset() local(c, k, v) (
  memset(busa, 0, 140000); memset(busc, 0, 70000);
  memset(vb, 0, 16384); memset(pend, 0, 2176); memset(chb, 0, 60);
  k = 0; loop(256, v = vb + k * 64; v[11] = v[12] = v[13] = v[42] = v[43] = v[44] = v[48] = -1; k += 1; );
  agec = 0; sus_on = 0; dk_n = dk_dace = 0;
  nchips = floor(slider3 + 0.5);
  md_clk = 53693175 / 7;
  clk = con == 0 ? nes_clk : con == 1 ? 4194304 : con == 2 ? 1789772.5 : con == 4 ? 3579545 : con == 5 ? 32000 : md_clk / 144;
  hs = 0; blk_n = 0; blk_t0 = 0; spc = srate / clk;
  nchan = con == 0 ? 5 : con == 3 ? 10 : con == 4 ? 6 : con == 5 ? 8 : 4; nvc = con == 3 ? 10 : con == 4 ? 6 : con == 5 ? 8 : 4;
  nexp = con == 0 ? floor(slider200 + 0.5) : 0; cur_exp = slider200;
  nexp ? ( nchan = nexp == 1 ? 8 : 11; nvc = nchan; );
  sms_fast = gb_fast = 1;
  psg_c0 = con == 3 ? 6 : 0; psg_a = con == 3 ? 1024 : 0; psgpf = 1789772.5 / clk;
  sms_g = con == 3 ? 0.3 : 1; sms_spc = srate / 1789772.5; sms_t0 = 0;
  md_3438 = slider103; cur_mdchip = slider103; mdpl = mdpr = 0;
  fper = con == 0 ? 29780.5 : con == 1 ? 70224 : con == 2 ? 29868 : con == 4 ? 3579545 / 60 : con == 5 ? 32000 / 60 : 3420 * 262 / 1008; fps = clk / fper;
  k = 0;
  loop(nchips,
    ck = k;
    memset(gba, 0, 60); np_ = nz_ = 0;
    con == 0 ? (
      nes_reset();
      hw(0, 16407, 64); hw(0, 16405, 15);
      hw(0, 16384, 48); hw(0, 16385, 8); hw(0, 16388, 48); hw(0, 16389, 8);
      hw(0, 16392, 128); hw(0, 16396, 48); hw(0, 16401, 64);
      nes_run(1);
      nexp == 2 ? x7_patch(1);
    ) : con == 1 ? (
      gb_reset();
      hw(0, 22, 128); hw(0, 20, 119); hw(0, 21, 255);
      hw(0, 2, 8); hw(0, 7, 8); hw(0, 17, 8); hw(0, 10, 128);
      chip_pan(0);
    ) : con == 2 ? (
      sms_reset();
      c = 0; loop(4, gbl[c + 1] = gbr[c + 1] = 1; c += 1; );
      chip_pan(0);
    ) : con == 4 ? (
      pce_reset();
      hw(0, 1, 255);
    ) : con == 5 ? (
      sn_ram = snram + k * 65536; memset(sn_ram, 0, 65536);
      sn_reset(); sn_now = sn_qt = sn_qc = sn_qk = 0;
      c = 0; loop(128, sn_write(c, 0); c += 1; );
      sn_write(93, 1); sn_write(109, 136); sn_write(12, 127); sn_write(28, 127); sn_write(108, 32);
      chip_pan(0);
    ) : (
      sms_reset(); md_reset(); md_now = 0;
      c = 0; loop(4, gbl[c + 1] = gbr[c + 1] = 1; c += 1; );
      md_mix(); mdpl += md_l; mdpr += md_r;
      chip_pan(0);
    );
    chip_save(slots + k * 1536);
    k += 1;
  );
  nft = fper;
  sum_a = sum_b = sum_c = 0; c = 0;
  loop(BLW + 4, sum_a += busa[c]; sum_b += busb[c]; sum_c += busc[c]; c += 1; );
  memset(busa, 0, 140000); memset(busc, 0, 70000);
  hpl = sum_a + sum_c; hpr_ = sum_b + sum_c;
  f1y = f2x = f2y = lpy = 0; f1x = sum_a;
  cur_con = con; cur_chips = slider3;
  fdl = spl0; fdr = spl1;
);

nes_clk = 39375000 / 22;
meta();
bl_init();
make_dpcm();
make_waves();
mem_set_values(gb_ndiv, 8, 16, 32, 48, 64, 80, 96, 112);
