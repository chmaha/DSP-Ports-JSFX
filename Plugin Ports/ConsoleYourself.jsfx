    k == 4 ? ( ph += 1 / rate; x = (sin(2 * $pi * 1700 * ph) + 0.6 * sin(2 * $pi * 450 * ph)) * exp(-t / 0.008) + (hash(i + 11000) * 2 - 1) * 0.4 * exp(-t / 0.004); ) :
    ( z = hash(i + 13000 + k * 997) * 2 - 1; x = (z - a) * (k == 5 ? exp(-t / 0.02) : k == 6 ? exp(-t / 0.12) : k == 7 ? exp(-t / 0.35) : exp(-t / 0.3) * 0.5 + 0.4 * sin(2 * $pi * 540 * t) * exp(-t / 0.4)); a = z; );
