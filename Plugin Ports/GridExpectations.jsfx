desc: Grid Expectations Drum Sequencer (Mutable Instruments Grids port) by chmaha
tags: midi generator sequencer drum pattern euclidean
author: chmaha
version: 1.0
changelog:
  Initial release.
about:
  A port of Mutable Instruments Grids, the topographic drum sequencer. Map X and Map Y move around a 5 x 5 map
  of drum patterns, blending between the nearest four. The three Fill knobs set how busy each part is, and Chaos
  shakes the pattern a little more each time round. Euclidean mode swaps the map for three euclidean rhythms:
  the X, Y and Chaos knobs set each part's length, the Fill knobs its number of hits.
  Grids makes MIDI only, so put a drum instrument after it on the same track (Dr Nine, Captain's Kit, or any
  drum sampler). It follows REAPER's transport, or runs free at its own tempo, and locks to the bar.
  Accented hits play at the Accent velocity. The module's three extra outputs (accents, or clock and bar) can
  go out as extra notes through the Aux selector.
  Ported from Grids by Emilie Gillet (Mutable Instruments)
  https://github.com/pichenettes/eurorack (GPLv3+)
  JSFX version released under GPLv3+ license
  Claude generated some of this code

slider1:k_x=128<0,255,1>-Map X
slider2:k_y=128<0,255,1>-Map Y
slider3:k_chaos=0<0,255,1>-Chaos
slider4:k_f1=128<0,255,1>-Fill 1
slider5:k_f2=128<0,255,1>-Fill 2
slider6:k_f3=128<0,255,1>-Fill 3
slider7:k_bpm=120<20,239,1>-Free Tempo
slider8:k_mode=0<0,1,1{Drums,Euclidean}>-Mode
slider9:k_swing=0<0,1,1{Off,On}>-Swing
slider10:k_gate=0<0,1,1{Trigger,Gate}>-Note Output
slider11:k_res=2<0,2,1{4 PPQN,8 PPQN,24 PPQN}>-Resolution
slider12:k_aux=0<0,2,1{Off,Accents,Clock}>-Aux Outputs
slider13:k_clock=0<0,1,1{Follow Transport,Free}>-Clock
slider14:k_run=0<0,1,1{Stopped,Running}>-Free Run
slider15:k_n1=36<0,127,1>-Note 1
slider16:k_n2=38<0,127,1>-Note 2
slider17:k_n3=42<0,127,1>-Note 3
slider18:k_a1=35<0,127,1>-Aux Note 1
slider19:k_a2=40<0,127,1>-Aux Note 2
slider20:k_a3=46<0,127,1>-Aux Note 3
slider21:k_chan=10<1,16,1>-MIDI Channel
slider22:k_vel=100<1,127,1>-Velocity
slider23:k_acc=127<1,127,1>-Accent Velocity
slider24:k_len=10<1,100,1>-Trigger Length (ms)
slider25:k_thru=1<0,1,1{Off,On}>-MIDI Thru

in_pin:none
out_pin:none

options:no_meter

@init
ext_noinit = gfx_ext_retina = 1;

NODES = 0;
EUCL = 2400;
DMAP = 3424;
PERT = 3456;
ECNT = 3460;
NACT = 3464;
OFFT = 3472;
ONOTE = 3480;
LEDV = 3488;
OQ = 3600;
OQ_MAX = 1024;

function hex_nib(c) ( c >= 97 ? c - 87 : c >= 65 ? c - 55 : c - 48; );
function hex8(str, dst, n) local(i) (
  i = 0;
  loop(n, dst[i] = hex_nib(str_getchar(str, 2 * i)) * 16 + hex_nib(str_getchar(str, 2 * i + 1)); i += 1;);
);
function hex32(str, dst, n) local(i, j, v) (
  i = 0;
  loop(n,
    v = 0; j = 0;
    loop(8, v = v * 16 + hex_nib(str_getchar(str, 8 * i + j)); j += 1;);
    dst[i] = v;
    i += 1;
  );
);
