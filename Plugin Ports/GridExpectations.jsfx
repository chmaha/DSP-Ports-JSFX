function dmap_set(i, a, b, c, d, e) ( DMAP[i * 5] = a; DMAP[i * 5 + 1] = b; DMAP[i * 5 + 2] = c; DMAP[i * 5 + 3] = d; DMAP[i * 5 + 4] = e; );
dmap_set(0, 10, 8, 0, 9, 11);
dmap_set(1, 15, 7, 13, 12, 6);
dmap_set(2, 18, 14, 4, 5, 3);
dmap_set(3, 23, 16, 21, 1, 2);
dmap_set(4, 24, 19, 17, 20, 22);

rng = 33;
pulse = 0;
stp = 0;
state = 0;
n_next = 0;
was_run = 0;
g_step = -1;

function q_out(o, a, b, c) local(p) (
  oq_n < OQ_MAX ? (
    p = OQ + oq_n * 4;
    p[0] = o; p[1] = a; p[2] = b; p[3] = c;
    oq_n += 1;
  );
);

function q_flush() local(i, j, p, o, a, b, c) (
  i = 1;
  while (i < oq_n) (
    p = OQ + i * 4;
    o = p[0]; a = p[1]; b = p[2]; c = p[3];
    j = i - 1;
    while (j >= 0 && OQ[j * 4] > o) (
      memcpy(OQ + (j + 1) * 4, OQ + j * 4, 4);
      j -= 1;
    );
    p = OQ + (j + 1) * 4;
    p[0] = o; p[1] = a; p[2] = b; p[3] = c;
    i += 1;
  );
  i = 0;
  loop(oq_n,
    p = OQ + i * 4;
    midisend(p[0], p[1], p[2], p[3]);
    i += 1;
  );
  oq_n = 0;
);

function rng_step() ( rng = (rng >> 1) ~ ((rng & 1) ? 46080 : 0); );

function ge_mix(a, b, bal) ( (a * (255 - bal) + b * bal) >> 8; );

function ge_read(st, ins, x, y) local(i, j, o, a, b, c, d, m) (
  i = x >> 6; j = y >> 6;
  o = ins * 32 + st;
  a = NODES[DMAP[i * 5 + j] * 96 + o];
  b = NODES[DMAP[(i + 1) * 5 + j] * 96 + o];
  c = NODES[DMAP[i * 5 + j + 1] * 96 + o];
  d = NODES[DMAP[(i + 1) * 5 + j + 1] * 96 + o];
  m = (x << 2) & 255;
  ge_mix(ge_mix(a, b, m), ge_mix(c, d, m), (y << 2) & 255);
);

function ge_drums() local(i, m, lvl, acc) (
  stp === 0 ? (
    i = 0;
    loop(3,
      rng_step();
      PERT[i] = ((rng >> 8) * (a_swing ? 0 : (a_chaos >> 2))) >> 8;
      i += 1;
    );
  );
  m = 1; acc = 0; i = 0;
  loop(3,
    lvl = ge_read(stp, i, a_x, a_y);
    lvl < 255 - PERT[i] ? lvl += PERT[i] : lvl = 255;
    lvl > 255 - a_fill[i] ? (
      lvl > 192 ? acc |= m;
      state |= m;
    );
    m *= 2;
    i += 1;
  );
  a_clko ? (
    state |= acc ? 8 : 0;
    state |= stp === 0 ? 32 : 0;
  ) : (
    state |= acc << 3;
  );
);

function ge_euclid() local(i, m, len, dens, rst, bits) (
  !(stp & 1) ? (
    m = 1; rst = 0; i = 0;
    loop(3,
      len = (a_elen[i] >> 3) + 1;
      dens = a_fill[i] >> 3;
      while (ECNT[i] >= len) ( ECNT[i] -= len; );
      bits = EUCL[(len - 1) * 32 + dens];
      ((bits >> ECNT[i]) & 1) ? state |= m;
      ECNT[i] === 0 ? rst |= m;
      m *= 2;
      i += 1;
    );
    a_clko ? (
      state |= rst ? 8 : 0;
      state |= rst === 7 ? 32 : 0;
    ) : (
      state |= rst << 3;
    );
  );
);

function ge_eval() (
  state = 0;
  rng_step();
  state |= 64;
  state |= rng & 128;
  a_clko ? state |= 16;
  pulse === 0 ? (
    g_step = stp;
    a_mode ? ge_euclid() : ge_drums();
  );
);

function ge_tick(num) local(i) (
  ge_eval();
  pulse += num;
  while (pulse >= 3) (
    pulse -= 3;
    !(stp & 1) ? (
      i = 0;
      loop(3, ECNT[i] += 1; i += 1;);
    );
    stp += 1;
  );
  stp >= 32 ? stp -= 32;
);

function sw_t(n) local(cell, r) (
  cell = floor(n / 12);
  r = n - 12 * cell;
  12 * cell + (r <= 6 ? r * (1 + a_sw) : 6 * (1 + a_sw) + (r - 6) * (1 - a_sw));
);

function ge_resync(p) local(n, sa, i, len) (
  n = a_inc * floor((p - 12) / a_inc);
  while (sw_t(n) < p - 0.00001) ( n += a_inc; );
  n_next = n;
  sa = floor(n / 3);
  pulse = n - 3 * sa;
  stp = sa - 32 * floor(sa / 32);
  i = 0;
  loop(3,
    len = (a_elen[i] >> 3) + 1;
    ECNT[i] = sa > 0 ? ceil(sa / 2) % len : 0;
    i += 1;
  );
);

function ge_note(i) ( i === 0 ? k_n1 : i === 1 ? k_n2 : i === 2 ? k_n3 : i === 3 ? k_a1 : i === 4 ? k_a2 : k_a3; );

function ge_emit(ofs, gdur) local(i, b, acc, n) (
  i = 0;
  loop(6,
    b = (state >> i) & 1;
    (b && (i < 3 || a_aux)) ? (
      NACT[i] ? q_out(ofs, 128 | a_chan, ONOTE[i], 0);
      acc = i >= 3 ? 0 : a_mode ? 0 : a_clko ? (state & 8) : (state & (8 << i));
      n = ge_note(i) | 0;
      q_out(ofs, 144 | a_chan, n, (acc ? k_acc : k_vel) | 0);
      ONOTE[i] = n;
      NACT[i] = 1;
      OFFT[i] = ofs + (a_gate ? gdur : a_lensmp);
      i < 3 ? LEDV[i] = 1;
    );
    i += 1;
  );
);

function all_off() local(i) (
  i = 0;
  loop(6,
    NACT[i] ? ( q_out(0, 128 | a_chan, ONOTE[i], 0); NACT[i] = 0; );
    i += 1;
  );
);

@block
oq_n = 0;
while (midirecv(mofs, mm1, mm2, mm3)) ( k_thru >= 0.5 ? q_out(mofs, mm1, mm2, mm3); );

a_x = k_x | 0;
a_y = k_y | 0;
a_chaos = k_chaos | 0;
a_fill = 3560;
a_fill[0] = k_f1 | 0; a_fill[1] = k_f2 | 0; a_fill[2] = k_f3 | 0;
a_elen = 3564;
a_elen[0] = a_x; a_elen[1] = a_y; a_elen[2] = a_chaos;
a_mode = k_mode >= 0.5;
a_swing = k_swing >= 0.5;
a_gate = k_gate >= 0.5;
a_aux = k_aux >= 0.5;
a_clko = k_aux >= 1.5;
a_free = k_clock >= 0.5;
a_chan = (k_chan - 1) | 0;
a_inc = k_res < 0.5 ? 6 : k_res < 1.5 ? 3 : 1;
a_lensmp = k_len * 0.001 * srate;
a_sw = (a_swing && !a_mode) ? ((a_chaos * 43) >> 8) / 128 : 0;

a_run = a_free ? k_run >= 0.5 : (play_state & 1);
a_run ? (
  a_tps = (a_free ? k_bpm : tempo) / 60 * 24 / srate;
  a_p0 = a_free ? fpos : beat_position * 24;
  a_jump = (!was_run || abs(a_p0 - a_pexp) > 0.1 || a_inc !== a_pinc);
  (a_free && (!was_run || ui_reset)) ? ( fpos = 0; a_p0 = 0; a_jump = 1; );
  ui_reset = 0;
  a_jump ? ge_resync(a_p0);
  a_p1 = a_p0 + samplesblock * a_tps;
  a_done = 0;
  while (!a_done) (
    a_tn = sw_t(n_next);
    a_tick = a_tn < a_p1 ? max(0, floor((a_tn - a_p0) / a_tps + 0.001)) : samplesblock * 2;
    a_oi = -1;
    a_om = a_tick;
    a_i = 0;
    loop(6,
      (NACT[a_i] && OFFT[a_i] < samplesblock && OFFT[a_i] <= a_om) ? ( a_om = OFFT[a_i]; a_oi = a_i; );
      a_i += 1;
    );
    a_oi >= 0 ? (
      q_out(floor(a_om), 128 | a_chan, ONOTE[a_oi], 0);
      NACT[a_oi] = 0;
    ) : a_tick < samplesblock ? (
      a_gd = (sw_t(n_next + a_inc) - a_tn) * 0.5 / a_tps;
      ge_tick(a_inc);
      ge_emit(a_tick, a_gd);
      n_next += a_inc;
    ) : (
      a_done = 1;
    );
  );
  a_i = 0;
  loop(6, NACT[a_i] ? OFFT[a_i] -= samplesblock; a_i += 1;);
  a_pexp = a_p1;
  a_pinc = a_inc;
  a_free ? fpos = a_p1;
  was_run = 1;
) : (
  was_run ? all_off();
  ui_reset = 0;
  was_run = 0;
  g_step = -1;
);
q_flush();

@gfx 920 476

UDW = 920;
UDH = 476;
uscale = max(0.5, min(gfx_w / UDW, gfx_h / UDH));
uox = floor((gfx_w - UDW * uscale) * 0.5);
uoy = 0;

function s_min(s) ( s == 7 ? 20 : (s >= 21 && s <= 24) ? 1 : 0; );
function s_max(s) ( s <= 6 ? 255 : s == 7 ? 239 : s == 21 ? 16 : s == 24 ? 100 : 127; );
function s_step(s) ( 1; );
function def_val(s) (
  s <= 2 || s == 4 || s == 5 || s == 6 ? 128 : s == 3 ? 0 : s == 7 ? 120 :
  s == 15 ? 36 : s == 16 ? 38 : s == 17 ? 42 : s == 18 ? 35 : s == 19 ? 40 : s == 20 ? 46 :
  s == 21 ? 10 : s == 22 ? 100 : s == 23 ? 127 : s == 24 ? 10 : 0;
);
function knob_name(s) (
  s == 1 ? (k_mode >= 0.5 ? "LENGTH 1" : "MAP X") :
  s == 2 ? (k_mode >= 0.5 ? "LENGTH 2" : "MAP Y") :
  s == 3 ? (k_mode >= 0.5 ? "LENGTH 3" : k_swing >= 0.5 ? "SWING" : "CHAOS") :
  s == 4 ? "FILL 1" : s == 5 ? "FILL 2" : s == 6 ? "FILL 3" : "CLOCK";
);
function ptext(s) (
  s == 7 ? sprintf(#upt, "%d BPM", slider(s)) :
  s == 24 ? sprintf(#upt, "%d ms", slider(s)) :
  (s <= 3 && k_mode >= 0.5) ? sprintf(#upt, "%d steps", (slider(s) >> 3) + 1) :
  (s >= 4 && s <= 6 && k_mode >= 0.5) ? sprintf(#upt, "%d", (slider(s) >> 3)) :
  s <= 6 ? sprintf(#upt, "%d%%", floor(slider(s) / 255 * 100 + 0.5)) :
  sprintf(#upt, "%d", slider(s));
  #upt;
);
function seg_label(s, i) (
  s == 8 ? (i ? "EUCLID" : "DRUMS") :
  s == 9 ? (i ? "ON" : "OFF") :
  s == 10 ? (i ? "GATE" : "TRIG") :
  s == 11 ? (i == 0 ? "4" : i == 1 ? "8" : "24") :
  s == 12 ? (i == 0 ? "OFF" : i == 1 ? "ACCENT" : "CLOCK") :
  (i ? "FREE" : "FOLLOW");
);
function hint_text(s) (
  s == 1 ? (k_mode >= 0.5 ? "Length of part 1, in sixteenth notes." : "Map X: moves left and right across the 5 x 5 map of drum patterns.") :
  s == 2 ? (k_mode >= 0.5 ? "Length of part 2, in sixteenth notes." : "Map Y: moves up and down the map of drum patterns.") :
  s == 3 ? (k_mode >= 0.5 ? "Length of part 3, in sixteenth notes." : k_swing >= 0.5 ? "Swing amount (Chaos becomes swing when Swing is on), up to triplet feel." : "Chaos: adds random hits. It rolls the dice once per bar for each part.") :
  s == 4 ? "Fill 1: how busy part 1 is (bass drum). In Euclidean mode, its number of hits." :
  s == 5 ? "Fill 2: how busy part 2 is (snare). In Euclidean mode, its number of hits." :
  s == 6 ? "Fill 3: how busy part 3 is (hi-hat). In Euclidean mode, its number of hits." :
  s == 7 ? (k_clock >= 0.5 ? "Clock: the tempo when running free." : "Clock: only used when Clock is set to Free. Otherwise Grids follows REAPER's tempo.") :
  s == 8 ? "Drums reads the topographic map. Euclidean plays three euclidean rhythms." :
  s == 9 ? "Swing: Chaos sets the swing amount instead of adding random hits (Drums mode only)." :
  s == 10 ? "Trig plays short notes (see Length). Gate holds each note for half a clock pulse, which depends on Resolution." :
  s == 11 ? "Resolution: at 4 PPQN Grids only reads every second step. 8 and 24 PPQN read all 32 steps; they differ in Gate length." :
  s == 12 ? "Aux: Off. Accent: three extra notes on accented hits (or part resets in Euclidean mode). Clock: extra notes for accent, clock and bar." :
  s == 13 ? "Follow locks to REAPER's transport, including looping. Free runs on its own tempo." :
  s == 14 ? "Start or stop the free-running clock." :
  (s >= 15 && s <= 17) ? "MIDI note for each part. Scroll or drag to change." :
  (s >= 18 && s <= 20) ? "MIDI note for each Aux output. Scroll or drag to change." :
  s == 21 ? "MIDI channel for the generated notes." :
  s == 22 ? "Velocity of normal hits." :
  s == 23 ? "Velocity of accented hits (map value above 75 %)." :
  s == 24 ? "Note length in Trig mode. The module's trigger is 1 ms; a longer note suits MIDI instruments better." :
  s == 25 ? "MIDI Thru: pass incoming MIDI to the next plug-in." :
  s == 26 ? "Reset: back to step 1 (Free clock only). Under Follow the bar comes from REAPER." :
  s == 27 ? "Click or drag on the map to set Map X and Map Y." :
  "Drag or scroll a knob to adjust  ·  Ctrl for fine control  ·  double-click to reset";
);

function automate(s, e)
(
<?
  max_sliders > 25 ? printf("slider_automate(2^(s-1), e);") :
    loop(i = 1; 25,
      printf("  s == %d ? slider_automate(slider%d, e) :\n", i, i);
      i += 1;
    );
?> 0;
);

function set_slider(s, x) ( slider(s) = x; automate(s, 0); automate(s, 1); );
function hit_circle(mx, my, cx, cy, rad) ( sqr(mx - cx) + sqr(my - cy) <= sqr(rad); );
function hit_rect(mx, my, x, y, w, h) ( mx >= x && mx <= x + w && my >= y && my <= y + h; );
function px(x) ( uox + x * uscale; );
function py(y) ( uoy + y * uscale; );

function norm_of(s) ( (slider(s) - s_min(s)) / (s_max(s) - s_min(s)); );
function set_norm(s, x) local(old, st) (
  old = slider(s);
  st = s_step(s);
  slider(s) = st > 0 ? s_min(s) + floor(x * (s_max(s) - s_min(s)) / st + 0.5) * st : s_min(s) + x * (s_max(s) - s_min(s));
  slider(s) !== old ? ( automate(s, 0); );
);

function ctext(str, cx, y, fs, fl) local(tw, th)
(
  gfx_setfont(1, "Arial", fs * uscale, fl);
  gfx_measurestr(str, tw, th);
  gfx_x = cx - tw * 0.5; gfx_y = y;
  gfx_drawstr(str);
);

function ltext(str, x, y, fs, fl)
(
  gfx_setfont(1, "Arial", fs * uscale, fl);
  gfx_x = x; gfx_y = y;
  gfx_drawstr(str);
);

function rk_draw(cx, cy, rad, pos, cr, cg, cb) local(ang0, ang1, ang, i, a, rr, ca, sa, n)
(
  ang0 = -2.35619;
  ang1 = 2.35619;
  gfx_set(0, 0, 0, 0.18);
  gfx_circle(cx + rad * 0.06, cy + rad * 0.10, rad * 1.02, 1, 1);
  gfx_set(0.07, 0.07, 0.08, 1);
  gfx_circle(cx, cy, rad, 1, 1);
  i = 0;
  loop(36,
    a = i * 2 * $pi / 36;
    gfx_set(0.20, 0.20, 0.22, 1);
    gfx_line(cx + sin(a) * rad * 0.80, cy - cos(a) * rad * 0.80, cx + sin(a) * rad * 0.97, cy - cos(a) * rad * 0.97, 1);
    i += 1;
  );
  gfx_set(0.13, 0.13, 0.14, 1);
  gfx_circle(cx, cy, rad * 0.76, 1, 1);
  ang = ang0 + (ang1 - ang0) * pos;
  sa = sin(ang); ca = cos(ang);
  rr = rad * 0.08;
  n = max(7, 2 * floor(rad * 0.16) + 1);
  i = 0;
  loop(n,
    a = (i - (n - 1) / 2) / ((n - 1) / 2) * rr;
    gfx_set(cr, cg, cb, 1);
    gfx_line(cx + sa * rad * 0.50 + ca * a, cy - ca * rad * 0.50 + sa * a, cx + sa * rad * 0.96 + ca * a, cy - ca * rad * 0.96 + sa * a, 1);
    i += 1;
  );
  gfx_set(cr * 0.64, cg * 0.64, cb * 0.64, 1);
  gfx_circle(cx, cy, rad * 0.56, 1, 1);
  gfx_set(cr, cg, cb, 1);
  gfx_circle(cx, cy, rad * 0.53, 1, 1);
  gfx_set(1, 1, 1, 0.45);
  gfx_circle(cx - rad * 0.10, cy - rad * 0.12, rad * 0.30, 1, 1);
  gfx_set(cr * 0.78, cg * 0.78, cb * 0.78, 1);
  gfx_line(cx + sa * rad * 0.20, cy - ca * rad * 0.20, cx + sa * rad * 0.50, cy - ca * rad * 0.50, 1);
);

function pill_col(kind)
(
  kind == 1 ? gfx_set(0.91, 0.18, 0.42, 1) :
  kind == 2 ? gfx_set(0.10, 0.72, 0.78, 1) :
  kind == 3 ? gfx_set(0.70, 0.08, 0.42, 1) :
  gfx_set(0.95, 0.55, 0.15, 1);
);

function label_pill(str, cx, y, kind, big) local(tw, th, fs)
(
  fs = big ? 15 : 14;
  gfx_setfont(1, "Arial", fs * uscale, 'b');
  gfx_measurestr(str, tw, th);
  kind > 0 ? (
    pill_col(kind);
    gfx_rect(cx - tw * 0.5 - 5 * uscale, y - 1 * uscale, tw + 10 * uscale, th + 2 * uscale, 1);
    gfx_set(1, 1, 1, 1);
  ) : gfx_set(0.12, 0.12, 0.13, 1);
  gfx_x = cx - tw * 0.5; gfx_y = y;
  gfx_drawstr(str);
);

function rosette(cx, cy, r0) local(i, a, r1)
(
  i = 0;
  loop(60,
    a = i * 2 * $pi / 60;
    r1 = r0 * ((i & 1) ? 1.20 : 1.12);
    gfx_set(0.45, 0.46, 0.48, (i & 1) ? 0.30 : 0.18);
    gfx_line(cx + sin(a) * r0 * 1.04, cy - cos(a) * r0 * 1.04, cx + sin(a) * r1, cy - cos(a) * r1, 1);
    gfx_circle(cx + sin(a + 0.05) * r0 * 1.26, cy - cos(a + 0.05) * r0 * 1.26, max(1, 1.2 * uscale), 0, 1);
    i += 1;
  );
);

function knob_core(s, cx, cy, rad, kind) local(hov, x, cr, cg, cb)
(
  hov = hit_circle(mouse_x, mouse_y, cx, cy, rad + 4 * uscale);
  hov ? u_hov = s;
  (u_click && hov) ? (
    (u_ctarget == s && time_precise() - u_ctime < 0.3) ? (
      set_slider(s, def_val(s));
      u_drag = 0;
    ) : (
      u_drag = s; u_dy0 = mouse_y; u_dv0 = norm_of(s); u_dfine = mouse_cap & 4;
      automate(s, 0);
    );
    u_ctarget = s; u_ctime = time_precise();
    u_click = 0;
  );
  (hov && u_wheel != 0 && u_drag == 0) ? (
    x = norm_of(s) + (u_wheel / 120) * ((mouse_cap & 4) ? 0.002 : 0.02);
    set_norm(s, max(0, min(1, x)));
    automate(s, 1);
    u_wheel = 0;
  );
  kind == 1 ? ( cr = 0.93; cg = 0.27; cb = 0.47; ) :
  kind == 2 ? ( cr = 0.20; cg = 0.78; cb = 0.84; ) :
  kind == 3 ? ( cr = 0.72; cg = 0.10; cb = 0.45; ) :
  ( cr = 0.97; cg = 0.97; cb = 0.96; );
  rk_draw(cx, cy, rad, norm_of(s), cr, cg, cb);
  hov;
);

function knob_at(s, cx, cy, rad, big, kind) local(hov, ly)
(
  big ? rosette(cx, cy, rad);
  hov = knob_core(s, cx, cy, rad, kind);
  ly = cy + rad * (big ? 1.30 : 1.12) + 4 * uscale;
  label_pill(knob_name(s), cx, ly, kind, big);
  gfx_set((hov || u_drag == s) ? 0.78 : 0.36, (hov || u_drag == s) ? 0.42 : 0.37, (hov || u_drag == s) ? 0.10 : 0.40, 1);
  ctext(ptext(s), cx, ly + 18 * uscale, 12, 0);
);

function led(cx, cy, r, g, b, lv)
(
  gfx_set(0.55, 0.55, 0.56, 1);
  gfx_circle(cx, cy, 8 * uscale, 1, 1);
  gfx_set(0.93, 0.93, 0.92, 1);
  gfx_circle(cx, cy, 6.5 * uscale, 1, 1);
  lv > 0.01 ? (
    gfx_set(r, g, b, 0.35 * lv); gfx_circle(cx, cy, 11 * uscale, 1, 1);
    gfx_set(r, g, b, 0.25 + 0.75 * lv); gfx_circle(cx, cy, 6.5 * uscale, 1, 1);
  );
  gfx_set(1, 1, 1, 0.6);
  gfx_circle(cx - 2 * uscale, cy - 2 * uscale, 2 * uscale, 1, 1);
);

function dark_btn(s, x, y, w, h, label, act, fs) local(tw, th, hov)
(
  hov = hit_rect(mouse_x, mouse_y, x, y, w, h);
  hov ? u_hov = s;
  gfx_set(0.10, 0.10, 0.11, 1);
  gfx_rect(x - uscale, y - uscale, w + 2 * uscale, h + 2 * uscale, 1);
  act ? gfx_set(0.93, 0.50, 0.16, 1) : gfx_set(hov ? 0.30 : 0.24, hov ? 0.30 : 0.24, hov ? 0.32 : 0.26, 1);
  gfx_rect(x, y, w, h, 1);
  gfx_set(1, 1, 1, act ? 0.20 : 0.07);
  gfx_rect(x, y, w, h * 0.45, 1);
  gfx_setfont(1, "Arial", fs * uscale, 'b');
  act ? gfx_set(0.10, 0.07, 0.04, 1) : gfx_set(0.90, 0.90, 0.91, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + (w - tw) * 0.5; gfx_y = y + (h - th) * 0.5;
  gfx_drawstr(label);
  u_click && hov;
);

function seg(s, x, y, w, h, n, base) local(i, sw)
(
  sw = w / n;
  i = 0;
  loop(n,
    dark_btn(s, x + i * sw, y, sw - 2 * uscale, h, seg_label(s, i), (slider(s) | 0) == i + base, 12) ? ( set_slider(s, i + base); u_click = 0; );
    i += 1;
  );
);

function cap(str, x, y)
(
  gfx_set(0.12, 0.12, 0.13, 1);
  ltext(str, x, y, 12, 'b');
);

function field(s, x, y, w, h) local(hov, v)
(
  hov = hit_rect(mouse_x, mouse_y, x, y, w, h);
  hov ? u_hov = s;
  gfx_set(0.10, 0.10, 0.11, 1);
  gfx_rect(x - uscale, y - uscale, w + 2 * uscale, h + 2 * uscale, 1);
  gfx_set(hov || u_drag == s ? 0.30 : 0.24, hov || u_drag == s ? 0.30 : 0.24, hov || u_drag == s ? 0.32 : 0.26, 1);
  gfx_rect(x, y, w, h, 1);
  gfx_set(0.90, 0.90, 0.91, 1);
  ctext(ptext(s), x + w * 0.5, y + (h - 14 * uscale) * 0.5, 12, 'b');
  (u_click && hov) ? (
    (u_ctarget == s && time_precise() - u_ctime < 0.3) ? ( set_slider(s, def_val(s)); u_drag = 0; ) :
    ( u_drag = s; u_dy0 = mouse_y; u_dv0 = norm_of(s); u_dfine = mouse_cap & 4; automate(s, 0); );
    u_ctarget = s; u_ctime = time_precise();
    u_click = 0;
  );
  (hov && u_wheel != 0 && u_drag == 0) ? (
    v = slider(s) + (u_wheel > 0 ? 1 : -1) * s_step(s);
    slider(s) = max(s_min(s), min(s_max(s), v));
    automate(s, 0); automate(s, 1);
    u_wheel = 0;
  );
);

function dots_h(x0, x1, y) local(x)
(
  gfx_set(0.16, 0.16, 0.18, 0.75);
  x = x0;
  while (x < x1) ( gfx_rect(x, y - uscale, max(1, 2 * uscale), max(1, 2 * uscale), 1); x += 6 * uscale; );
);
function dots_v(x, y0, y1) local(y)
(
  gfx_set(0.16, 0.16, 0.18, 0.75);
  y = y0;
  while (y < y1) ( gfx_rect(x - uscale, y, max(1, 2 * uscale), max(1, 2 * uscale), 1); y += 6 * uscale; );
);

function screw(cx, cy)
(
  gfx_set(0.62, 0.62, 0.63, 1); gfx_circle(cx, cy, 6 * uscale, 1, 1);
  gfx_set(0.93, 0.93, 0.93, 1); gfx_circle(cx, cy, 4.5 * uscale, 1, 1);
  gfx_set(0.55, 0.55, 0.57, 1);
  gfx_line(cx - 3 * uscale, cy - 3 * uscale, cx + 3 * uscale, cy + 3 * uscale, 1);
);

function panel_bg() local(useed)
(
  gfx_set(0.86, 0.865, 0.875, 1);
  gfx_rect(0, 0, gfx_w, gfx_h, 1);
  useed = 7;
  loop(140,
    useed = (useed * 1103 + 12345) % 65536;
    gfx_set(useed & 1 ? 1 : 0, useed & 1 ? 1 : 0, useed & 1 ? 1 : 0, 0.028);
    gfx_rect(px(0), py(useed / 65536 * UDH), UDW * uscale, max(1, uscale), 1);
  );
  screw(px(14), py(12)); screw(px(UDW - 14), py(12));
);

function panel_band(y) local(uby, i)
(
  uby = py(y);
  gfx_set(0.70, 0.71, 0.73, 1);
  gfx_rect(px(0), uby, UDW * uscale, 9 * uscale, 1);
  i = 0;
  loop(UDW / 4,
    gfx_set(0.52, 0.53, 0.56, 1);
    gfx_line(px(i * 4), uby + 8 * uscale, px(i * 4 + 6), uby + uscale, 1);
    i += 1;
  );
  gfx_set(0.97, 0.97, 0.97, 1);
  gfx_rect(px(0), uby + 9 * uscale, UDW * uscale, max(1, uscale), 1);
);

function panel_title(tt, sub, origin) local(tw, th)
(
  gfx_set(0.14, 0.14, 0.15, 1);
  gfx_setfont(1, "Arial", 30 * uscale);
  gfx_x = px(70); gfx_y = py(8);
  gfx_drawstr(tt);
  gfx_measurestr(tt, tw, th);
  gfx_setfont(1, "Arial", 17 * uscale);
  gfx_x = px(70) + tw + 16 * uscale; gfx_y = py(17);
  gfx_drawstr(sub);
  gfx_setfont(1, "Arial", 12 * uscale);
  gfx_set(0.36, 0.37, 0.40, 1);
  gfx_x = px(71); gfx_y = py(41);
  gfx_drawstr(origin);
);

function hint_bar(y) local(uhs, tw, th)
(
  gfx_set(0.20, 0.20, 0.21, 1);
  gfx_rect(px(0), py(y), UDW * uscale, 36 * uscale, 1);
  uhs = u_drag > 0 ? u_drag : u_hov;
  gfx_setfont(1, "Arial", 13 * uscale);
  gfx_set(0.80, 0.80, 0.82, 1);
  strcpy(#uhint, hint_text(uhs));
  gfx_measurestr(#uhint, tw, th);
  tw > (UDW - 20) * uscale ? ( gfx_setfont(1, "Arial", 13 * uscale * (UDW - 20) * uscale / tw); gfx_measurestr(#uhint, tw, th); );
  gfx_x = uox + (UDW * uscale - tw) * 0.5; gfx_y = py(y) + (36 * uscale - th) * 0.5;
  gfx_drawstr(#uhint);
);

function frame_begin()
(
  u_down = mouse_cap & 1;
  u_click = u_down && !u_pstate;
  u_wheel = mouse_wheel;
  mouse_wheel = 0;
  u_hov = 0;
);

function frame_end() local(ufine)
(
  u_drag > 0 ? (
    u_down ? (
      mouse_cap |= 65536;
      ufine = mouse_cap & 4;
      ufine != u_dfine ? ( u_dy0 = mouse_y; u_dv0 = norm_of(u_drag); u_dfine = ufine; );
      set_norm(u_drag, max(0, min(1, u_dv0 + (u_dy0 - mouse_y) / (150 * uscale) * (ufine ? 0.1 : 1))));
    ) : ( automate(u_drag, 1); u_drag = 0; );
  );
  u_pstate = u_down;
);

function gmix(a, b, bal) ( (a * (255 - bal) + b * bal) >> 8; );
function gread(st, ins, x, y) local(i, j, o, a, b, c, d, m) (
  i = x >> 6; j = y >> 6;
  o = ins * 32 + st;
  a = NODES[DMAP[i * 5 + j] * 96 + o];
  b = NODES[DMAP[(i + 1) * 5 + j] * 96 + o];
  c = NODES[DMAP[i * 5 + j + 1] * 96 + o];
  d = NODES[DMAP[(i + 1) * 5 + j + 1] * 96 + o];
  m = (x << 2) & 255;
  gmix(gmix(a, b, m), gmix(c, d, m), (y << 2) & 255);
);

function draw_lanes(x, y, w, h) local(i, s, lh, sw, lvl, thr, cx, cy, on, ac, len, dens, bits, inlen)
(
  gfx_set(0.37, 0.40, 0.46, 1);
  gfx_rect(x, y, w, h, 1);
  gfx_set(1, 1, 1, 1);
  ltext("TRIG", x + 8 * uscale, y + 6 * uscale, 13, 'b');
  ltext(k_mode >= 0.5 ? "EUCLIDEAN" : "ACC", x + 54 * uscale, y + 6 * uscale, 13, 'b');
  sw = (w - 16 * uscale) / 32;
  lh = (h - 32 * uscale) / 3;
  i = 0;
  loop(3,
    cy = y + 26 * uscale + i * lh;
    len = ((k_mode >= 0.5 ? (i == 0 ? k_x : i == 1 ? k_y : k_chaos) : 0) >> 3) + 1;
    dens = (i == 0 ? k_f1 : i == 1 ? k_f2 : k_f3) >> 3;
    bits = k_mode >= 0.5 ? EUCL[(len - 1) * 32 + dens] : 0;
    thr = 255 - (i == 0 ? k_f1 : i == 1 ? k_f2 : k_f3);
    s = 0;
    loop(32,
      cx = x + 8 * uscale + s * sw;
      k_mode >= 0.5 ? (
        inlen = s < len;
        on = inlen && ((bits >> s) & 1);
        ac = 0;
        lvl = 0;
      ) : (
        inlen = 1;
        lvl = gread(s, i, k_x | 0, k_y | 0);
        on = lvl > thr;
        ac = on && lvl > 192;
      );
      on ? (
        ac ? gfx_set(0.97, 0.86, 0.34, 1) : gfx_set(0.20, 0.78, 0.84, 1);
      ) : inlen ? (
        gfx_set(1, 1, 1, 0.14);
      ) : (
        gfx_set(1, 1, 1, 0.05);
      );
      gfx_rect(cx + uscale, cy + uscale, sw - 2 * uscale, lh - 3 * uscale, 1);
      (k_mode < 0.5 ? g_step == s : (g_step >= 0 && ECNT[i] == s)) ? (
        gfx_set(1, 0.42, 0.55, 0.75);
        gfx_rect(cx + uscale, cy + uscale, sw - 2 * uscale, lh - 3 * uscale, 0);
        gfx_rect(cx, cy, sw, lh - uscale, 0);
      );
      s += 1;
    );
    i += 1;
  );
);

function draw_pad(x, y, w, h) local(hov, i, j, a, c, dx, dy)
(
  hov = hit_rect(mouse_x, mouse_y, x, y, w, h);
  hov ? u_hov = 27;
  gfx_set(0.37, 0.40, 0.46, 1);
  gfx_rect(x, y, w, h, 1);
  i = 0;
  loop(5,
    j = 0;
    loop(5,
      a = 0; c = 0;
      loop(32, a += NODES[DMAP[i * 5 + j] * 96 + c] + NODES[DMAP[i * 5 + j] * 96 + 32 + c] + NODES[DMAP[i * 5 + j] * 96 + 64 + c]; c += 1;);
      gfx_set(1, 1, 1, 0.08 + 0.5 * (a / (96 * 255)));
      gfx_rect(x + 6 * uscale + i * (w - 12 * uscale) / 5 + uscale, y + 6 * uscale + j * (h - 12 * uscale) / 5 + uscale, (w - 12 * uscale) / 5 - 2 * uscale, (h - 12 * uscale) / 5 - 2 * uscale, 1);
      j += 1;
    );
    i += 1;
  );
  dx = x + 6 * uscale + ((k_x + 32) / 256 * 4 + 0) * (w - 12 * uscale) / 5;
  dy = y + 6 * uscale + ((k_y + 32) / 256 * 4 + 0) * (h - 12 * uscale) / 5;
  k_mode < 0.5 ? (
    gfx_set(0.93, 0.27, 0.47, 1);
    gfx_circle(dx, dy, 6 * uscale, 1, 1);
    gfx_set(1, 1, 1, 1);
    gfx_circle(dx, dy, 6 * uscale, 0, 1);
    (u_click && hov) ? ( u_paddrag = 1; u_click = 0; automate(1, 0); automate(2, 0); );
  ) : (
    gfx_set(0.37, 0.40, 0.46, 0.72);
    gfx_rect(x, y, w, h, 1);
    gfx_set(1, 1, 1, 0.9);
    ctext("map off in Euclidean", x + w * 0.5, y + h * 0.5 - 8 * uscale, 12, 0);
  );
  u_paddrag ? (
    u_down ? (
      k_x = max(0, min(255, floor(((mouse_x - x - 6 * uscale) * 5 / (w - 12 * uscale)) / 4 * 256 - 32)));
      k_y = max(0, min(255, floor(((mouse_y - y - 6 * uscale) * 5 / (h - 12 * uscale)) / 4 * 256 - 32)));
      automate(1, 0); automate(2, 0);
    ) : ( u_paddrag = 0; automate(1, 1); automate(2, 1); );
  );
);

frame_begin();
panel_bg();

gi = 0;
loop(3,
  gj = 0;
  loop(3,
    gfx_set(0.14, 0.14, 0.15, 1);
    gfx_rect(px(32 + gi * 9) + (gi == 2 && gj == 1 ? 2 * uscale : 0), py(11 + gj * 9), 7 * uscale, 7 * uscale, (gi + gj) & 1 ? 0 : 1);
    gj += 1;
  );
  gi += 1;
);
panel_title("Grid Expectations", "topographic drum sequencer", "by chmaha  ·  based on Mutable Instruments Grids");
panel_band(60);

knob_at(7, px(70), py(134), 32 * uscale, 0, 1);

g_thov = hit_circle(mouse_x, mouse_y, px(162), py(128), 18 * uscale);
g_thov ? u_hov = 26;
(u_click && g_thov) ? ( ui_reset = 1; u_click = 0; g_tfl = 1; );
gfx_set(0.62, 0.62, 0.64, 1); gfx_circle(px(162), py(128), 18 * uscale, 1, 1);
g_tfl > 0.02 ? ( gfx_set(0.93, 0.27, 0.47, 0.45 * g_tfl); gfx_circle(px(162), py(128), 26 * uscale, 1, 1); );
gfx_set(0.88 + 0.05 * g_tfl, 0.88 - 0.61 * g_tfl, 0.89 - 0.42 * g_tfl, 1); gfx_circle(px(162), py(128), 15 * uscale, 1, 1);
gfx_set(1, 1, 1, 0.8); gfx_circle(px(158), py(124), 6 * uscale, 1, 1);
g_tfl *= 0.86;
gfx_set(0.12, 0.12, 0.13, 1);
ctext("RESET", px(162), py(153), 13, 'b');
k_clock >= 0.5 ? (
  dark_btn(14, px(132), py(176), 60 * uscale, 22 * uscale, k_run >= 0.5 ? "STOP" : "RUN", k_run >= 0.5, 12) ? ( set_slider(14, k_run >= 0.5 ? 0 : 1); u_click = 0; );
);

knob_at(1, px(266), py(134), 34 * uscale, 0, 0);
knob_at(2, px(374), py(134), 34 * uscale, 0, 0);
knob_at(3, px(482), py(134), 34 * uscale, 0, 0);

dots_v(px(110), py(332), py(361));
dots_v(px(266), py(346), py(361));
dots_v(px(422), py(332), py(361));
knob_at(4, px(110), py(250), 34 * uscale, 1, 2);
knob_at(5, px(266), py(264), 34 * uscale, 1, 2);
knob_at(6, px(422), py(250), 34 * uscale, 1, 2);
gi = 0;
loop(3,
  LEDV[gi] *= 0.82;
  led(px(gi == 0 ? 110 : gi == 1 ? 266 : 422), py(370), 0.30, 0.86, 0.45, LEDV[gi]);
  gfx_set(0.12, 0.12, 0.13, 1);
  ctext(gi == 0 ? "1" : gi == 1 ? "2" : "3", px((gi == 0 ? 110 : gi == 1 ? 266 : 422) - 24), py(362), 15, 'b');
  gi += 1;
);
label_pill("FILL", px(38), py(362), 2, 1);

dots_v(px(545), py(78), py(390));
draw_lanes(px(560), py(78), 340 * uscale, 112 * uscale);
draw_pad(px(560), py(204), 124 * uscale, 124 * uscale);

gy = 200;
gi = 8;
loop(6,
  (gi == 12 || gi == 13) ? gw = 3 : gw = 2;
  gsr = gi == 8 ? 8 : gi == 9 ? 9 : gi == 10 ? 10 : gi == 11 ? 11 : gi == 12 ? 12 : 13;
  gfx_set(0.12, 0.12, 0.13, 1);
  ltext(gi == 8 ? "MODE" : gi == 9 ? "SWING" : gi == 10 ? "OUTPUT" : gi == 11 ? "PPQN" : gi == 12 ? "AUX" : "CLOCK", px(696), py(gy + 4), 12, 'b');
  seg(gsr, px(756), py(gy), 144 * uscale, 22 * uscale, gsr == 11 || gsr == 12 ? 3 : 2, 0);
  gy += 26;
  gi += 1;
);

gfx_set(0.62, 0.63, 0.65, 1);
gfx_rect(px(20), py(396), (UDW - 40) * uscale, max(1, uscale), 1);
gfx_set(0.97, 0.97, 0.97, 1);
gfx_rect(px(20), py(397), (UDW - 40) * uscale, max(1, uscale), 1);

cap("NOTES", px(20), py(410));
field(15, px(72), py(406), 40 * uscale, 22 * uscale);
field(16, px(116), py(406), 40 * uscale, 22 * uscale);
field(17, px(160), py(406), 40 * uscale, 22 * uscale);
cap("AUX", px(216), py(410));
field(18, px(250), py(406), 40 * uscale, 22 * uscale);
field(19, px(294), py(406), 40 * uscale, 22 * uscale);
field(20, px(338), py(406), 40 * uscale, 22 * uscale);
cap("CH", px(396), py(410));
field(21, px(422), py(406), 36 * uscale, 22 * uscale);
cap("VEL", px(474), py(410));
field(22, px(506), py(406), 40 * uscale, 22 * uscale);
cap("ACC", px(556), py(410));
field(23, px(590), py(406), 40 * uscale, 22 * uscale);
cap("LEN", px(646), py(410));
field(24, px(678), py(406), 60 * uscale, 22 * uscale);
dark_btn(25, px(760), py(406), 60 * uscale, 22 * uscale, "THRU", k_thru >= 0.5, 12) ? ( set_slider(25, k_thru >= 0.5 ? 0 : 1); u_click = 0; );

hint_bar(440);
frame_end();
