// ---------------------------------------------------------------- tables

GT = 20000; GTS = 10; GPAL = 20600;

function g_tables() local(q) (
  q = GT + 1 * GTS; q[0] = 0; q[1] = 1000; q[2] = 250; q[3] = 2; q[4] = 1; q[5] = "LFO 1 Frequency";
  q = GT + 2 * GTS; q[0] = 0; q[1] = 4; q[2] = 0; q[3] = 0; q[4] = 6; q[5] = "LFO 1 Waveform"; q[6] = "Sin|Tri|Saw|Sqr|S&H";
  q = GT + 3 * GTS; q[0] = 0; q[1] = 1000; q[2] = 250; q[3] = 2; q[4] = 1; q[5] = "LFO 2 Frequency";
  q = GT + 4 * GTS; q[0] = 0; q[1] = 4; q[2] = 0; q[3] = 0; q[4] = 6; q[5] = "LFO 2 Waveform"; q[6] = "Sin|Tri|Saw|Sqr|S&H";
  q = GT + 5 * GTS; q[0] = 0; q[1] = 4000; q[2] = 440; q[3] = 2; q[4] = 1; q[5] = "Osc 1 Frequency";
  q = GT + 6 * GTS; q[0] = 0; q[1] = 4; q[2] = 0; q[3] = 0; q[4] = 6; q[5] = "Osc 1 Waveform"; q[6] = "Sin|Tri|Saw|Sqr|Noise";
  q = GT + 7 * GTS; q[0] = 0; q[1] = 4000; q[2] = 440; q[3] = 2; q[4] = 1; q[5] = "Osc 2 Frequency";
  q = GT + 8 * GTS; q[0] = 0; q[1] = 4; q[2] = 0; q[3] = 0; q[4] = 6; q[5] = "Osc 2 Waveform"; q[6] = "Sin|Tri|Saw|Sqr|Noise";
  q = GT + 9 * GTS; q[0] = 0; q[1] = 2; q[2] = 0; q[3] = 0; q[4] = 4; q[5] = "Ring Mod 1 Depth";
  q = GT + 10 * GTS; q[0] = 0; q[1] = 2; q[2] = 0; q[3] = 0; q[4] = 4; q[5] = "Ring Mod 2 Depth";
  q = GT + 11 * GTS; q[0] = 0; q[1] = 2; q[2] = 0; q[3] = 0; q[4] = 4; q[5] = "Ring Mod 3 Depth";
  q = GT + 12 * GTS; q[0] = -70; q[1] = 20; q[2] = -70; q[3] = 0; q[4] = 2; q[5] = "Osc 1 Gain";
  q = GT + 13 * GTS; q[0] = -70; q[1] = 20; q[2] = -70; q[3] = 0; q[4] = 2; q[5] = "Ring Mod 1 Gain";
  q = GT + 14 * GTS; q[0] = -70; q[1] = 20; q[2] = -70; q[3] = 0; q[4] = 2; q[5] = "Osc 2 Gain";
  q = GT + 15 * GTS; q[0] = -70; q[1] = 20; q[2] = -70; q[3] = 0; q[4] = 2; q[5] = "Ring Mod 2 Gain";
  q = GT + 16 * GTS; q[0] = -70; q[1] = 20; q[2] = 0; q[3] = 0; q[4] = 2; q[5] = "Input Gain";
  q = GT + 17 * GTS; q[0] = -70; q[1] = 20; q[2] = -70; q[3] = 0; q[4] = 2; q[5] = "Ring Mod 3 Gain";
  q = GT + 18 * GTS; q[0] = 50; q[1] = 6000; q[2] = 1537.5; q[3] = 1; q[4] = 1; q[5] = "Crossover Lower Frequency";
  q = GT + 19 * GTS; q[0] = 1000; q[1] = 10000; q[2] = 7750; q[3] = 1; q[4] = 1; q[5] = "Crossover Upper Frequency";
  q = GT + 20 * GTS; q[0] = 0; q[1] = 3; q[2] = 1; q[3] = 0; q[4] = 4; q[5] = "Band 1 Drive";
  q = GT + 21 * GTS; q[0] = 0; q[1] = 3; q[2] = 1; q[3] = 0; q[4] = 4; q[5] = "Band 2 Drive";
  q = GT + 22 * GTS; q[0] = 0; q[1] = 3; q[2] = 1; q[3] = 0; q[4] = 4; q[5] = "Band 3 Drive";
  q = GT + 23 * GTS; q[0] = 0; q[1] = 5; q[2] = 0; q[3] = 0; q[4] = 6; q[5] = "Band 1 Filter Type"; q[6] = "Off|LP|HP|BP|BR|AP";
  q = GT + 24 * GTS; q[0] = 0; q[1] = 8000; q[2] = 440; q[3] = 2; q[4] = 1; q[5] = "Band 1 Filter Frequency";
