  q = GT + 29 * GTS; q[0] = 0; q[1] = 5; q[2] = 0; q[3] = 0; q[4] = 6; q[5] = "Band 2 Filter Type"; q[6] = "Off|LP|HP|BP|BR|AP";
  q = GT + 30 * GTS; q[0] = 0; q[1] = 8000; q[2] = 440; q[3] = 2; q[4] = 1; q[5] = "Band 2 Filter Frequency";
  q = GT + 31 * GTS; q[0] = 0; q[1] = 1; q[2] = 0; q[3] = 0; q[4] = 4; q[5] = "Band 2 Filter Q";
  q = GT + 32 * GTS; q[0] = 0; q[1] = 1; q[2] = 0; q[3] = 0; q[4] = 5; q[5] = "Band 2 Filter Resonance";
  q = GT + 33 * GTS; q[0] = -500; q[1] = 500; q[2] = 0; q[3] = 0; q[4] = 7; q[5] = "Band 2 Filter LFO 1 Amount";
  q = GT + 34 * GTS; q[0] = -500; q[1] = 500; q[2] = 0; q[3] = 0; q[4] = 7; q[5] = "Band 2 Filter LFO 2 Amount";
  q = GT + 35 * GTS; q[0] = 0; q[1] = 5; q[2] = 0; q[3] = 0; q[4] = 6; q[5] = "Band 3 Filter Type"; q[6] = "Off|LP|HP|BP|BR|AP";
  q = GT + 36 * GTS; q[0] = 0; q[1] = 8000; q[2] = 440; q[3] = 2; q[4] = 1; q[5] = "Band 3 Filter Frequency";
  q = GT + 37 * GTS; q[0] = 0; q[1] = 1; q[2] = 0; q[3] = 0; q[4] = 4; q[5] = "Band 3 Filter Q";
  q = GT + 38 * GTS; q[0] = 0; q[1] = 1; q[2] = 0; q[3] = 0; q[4] = 5; q[5] = "Band 3 Filter Resonance";
  q = GT + 39 * GTS; q[0] = -500; q[1] = 500; q[2] = 0; q[3] = 0; q[4] = 7; q[5] = "Band 3 Filter LFO 1 Amount";
  q = GT + 40 * GTS; q[0] = -500; q[1] = 500; q[2] = 0; q[3] = 0; q[4] = 7; q[5] = "Band 3 Filter LFO 2 Amount";
  q = GT + 41 * GTS; q[0] = 0; q[1] = 2; q[2] = 0; q[3] = 3; q[4] = 3; q[5] = "Band 1 Delay Time";
  q = GT + 42 * GTS; q[0] = 0; q[1] = 1; q[2] = 0; q[3] = 0; q[4] = 5; q[5] = "Band 1 Delay Feedback";
  q = GT + 43 * GTS; q[0] = 0; q[1] = 1; q[2] = 0; q[3] = 0; q[4] = 5; q[5] = "Band 1 Delay Wet";
  q = GT + 44 * GTS; q[0] = 0; q[1] = 2; q[2] = 0; q[3] = 3; q[4] = 3; q[5] = "Band 2 Delay Time";
  q = GT + 45 * GTS; q[0] = 0; q[1] = 1; q[2] = 0; q[3] = 0; q[4] = 5; q[5] = "Band 2 Delay Feedback";
  q = GT + 46 * GTS; q[0] = 0; q[1] = 1; q[2] = 0; q[3] = 0; q[4] = 5; q[5] = "Band 2 Delay Wet";
  q = GT + 47 * GTS; q[0] = 0; q[1] = 2; q[2] = 0; q[3] = 3; q[4] = 3; q[5] = "Band 3 Delay Time";
  q = GT + 48 * GTS; q[0] = 0; q[1] = 1; q[2] = 0; q[3] = 0; q[4] = 5; q[5] = "Band 3 Delay Feedback";
  q = GT + 49 * GTS; q[0] = 0; q[1] = 1; q[2] = 0; q[3] = 0; q[4] = 5; q[5] = "Band 3 Delay Wet";
  q = GT + 50 * GTS; q[0] = -70; q[1] = 20; q[2] = 0; q[3] = 0; q[4] = 2; q[5] = "Band 1 Gain";
  q = GT + 51 * GTS; q[0] = -70; q[1] = 20; q[2] = 0; q[3] = 0; q[4] = 2; q[5] = "Band 2 Gain";
  q = GT + 52 * GTS; q[0] = -70; q[1] = 20; q[2] = 0; q[3] = 0; q[4] = 2; q[5] = "Band 3 Gain";
