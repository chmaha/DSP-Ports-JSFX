function g_get(s) ( s <= 26 ? (s <= 13 ? (s <= 7 ? (s <= 4 ? (s <= 2 ? (s <= 1 ? (h_lfo1_freq) : (h_lfo1_wave)) : (s <= 3 ? (h_lfo2_freq) : (h_lfo2_wave))) : (s <= 6 ? (s <= 5 ? (h_osc1_freq) : (h_osc1_wave)) : (h_osc2_freq))) : (s <= 10 ? (s <= 9 ? (s <= 8 ? (h_osc2_wave) : (h_rm1_depth)) : (h_rm2_depth)) : (s <= 12 ? (s <= 11 ? (h_rm3_depth) : (h_osc1_gain_db)) : (h_rm1_gain_db)))) : (s <= 20 ? (s <= 17 ? (s <= 15 ? (s <= 14 ? (h_osc2_gain_db) : (h_rm2_gain_db)) : (s <= 16 ? (h_in_gain_db) : (h_rm3_gain_db))) : (s <= 19 ? (s <= 18 ? (h_xover_lfreqp) : (h_xover_ufreqp)) : (h_drive1))) : (s <= 23 ? (s <= 22 ? (s <= 21 ? (h_drive2) : (h_drive3)) : (h_filt1_type)) : (s <= 25 ? (s <= 24 ? (h_filt1_freq) : (h_filt1_q)) : (h_filt1_res))))) : (s <= 39 ? (s <= 33 ? (s <= 30 ? (s <= 28 ? (s <= 27 ? (h_filt1_lfo1) : (h_filt1_lfo2)) : (s <= 29 ? (h_filt2_type) : (h_filt2_freq))) : (s <= 32 ? (s <= 31 ? (h_filt2_q) : (h_filt2_res)) : (h_filt2_lfo1))) : (s <= 36 ? (s <= 35 ? (s <= 34 ? (h_filt2_lfo2) : (h_filt3_type)) : (h_filt3_freq)) : (s <= 38 ? (s <= 37 ? (h_filt3_q) : (h_filt3_res)) : (h_filt3_lfo1)))) : (s <= 46 ? (s <= 43 ? (s <= 41 ? (s <= 40 ? (h_filt3_lfo2) : (h_dela1_length)) : (s <= 42 ? (h_dela1_fb) : (h_dela1_wet))) : (s <= 45 ? (s <= 44 ? (h_dela2_length) : (h_dela2_fb)) : (h_dela2_wet))) : (s <= 49 ? (s <= 48 ? (s <= 47 ? (h_dela3_length) : (h_dela3_fb)) : (h_dela3_wet)) : (s <= 51 ? (s <= 50 ? (h_band1_gain_db) : (h_band2_gain_db)) : (h_band3_gain_db))))); );
function g_set(s, v) ( s <= 26 ? (s <= 13 ? (s <= 7 ? (s <= 4 ? (s <= 2 ? (s <= 1 ? (h_lfo1_freq = v) : (h_lfo1_wave = v)) : (s <= 3 ? (h_lfo2_freq = v) : (h_lfo2_wave = v))) : (s <= 6 ? (s <= 5 ? (h_osc1_freq = v) : (h_osc1_wave = v)) : (h_osc2_freq = v))) : (s <= 10 ? (s <= 9 ? (s <= 8 ? (h_osc2_wave = v) : (h_rm1_depth = v)) : (h_rm2_depth = v)) : (s <= 12 ? (s <= 11 ? (h_rm3_depth = v) : (h_osc1_gain_db = v)) : (h_rm1_gain_db = v)))) : (s <= 20 ? (s <= 17 ? (s <= 15 ? (s <= 14 ? (h_osc2_gain_db = v) : (h_rm2_gain_db = v)) : (s <= 16 ? (h_in_gain_db = v) : (h_rm3_gain_db = v))) : (s <= 19 ? (s <= 18 ? (h_xover_lfreqp = v) : (h_xover_ufreqp = v)) : (h_drive1 = v))) : (s <= 23 ? (s <= 22 ? (s <= 21 ? (h_drive2 = v) : (h_drive3 = v)) : (h_filt1_type = v)) : (s <= 25 ? (s <= 24 ? (h_filt1_freq = v) : (h_filt1_q = v)) : (h_filt1_res = v))))) : (s <= 39 ? (s <= 33 ? (s <= 30 ? (s <= 28 ? (s <= 27 ? (h_filt1_lfo1 = v) : (h_filt1_lfo2 = v)) : (s <= 29 ? (h_filt2_type = v) : (h_filt2_freq = v))) : (s <= 32 ? (s <= 31 ? (h_filt2_q = v) : (h_filt2_res = v)) : (h_filt2_lfo1 = v))) : (s <= 36 ? (s <= 35 ? (s <= 34 ? (h_filt2_lfo2 = v) : (h_filt3_type = v)) : (h_filt3_freq = v)) : (s <= 38 ? (s <= 37 ? (h_filt3_q = v) : (h_filt3_res = v)) : (h_filt3_lfo1 = v)))) : (s <= 46 ? (s <= 43 ? (s <= 41 ? (s <= 40 ? (h_filt3_lfo2 = v) : (h_dela1_length = v)) : (s <= 42 ? (h_dela1_fb = v) : (h_dela1_wet = v))) : (s <= 45 ? (s <= 44 ? (h_dela2_length = v) : (h_dela2_fb = v)) : (h_dela2_wet = v))) : (s <= 49 ? (s <= 48 ? (s <= 47 ? (h_dela3_length = v) : (h_dela3_fb = v)) : (h_dela3_wet = v)) : (s <= 51 ? (s <= 50 ? (h_band1_gain_db = v) : (h_band2_gain_db = v)) : (h_band3_gain_db = v))))); );

function g_pal_init() local(q) (
  q = GPAL;
  q[0] = 0.973; q[1] = 0.478; q[2] = 0.420;
  q[3] = 0.976; q[4] = 0.722; q[5] = 0.329;
  q[6] = 0.365; q[7] = 0.835; q[8] = 0.690;
  q[9] = 0.408; q[10] = 0.667; q[11] = 0.976;
  q[12] = 0.690; q[13] = 0.565; q[14] = 0.980;
  q[15] = 0.910; q[16] = 0.870; q[17] = 0.380;
  q[18] = 0.957; q[19] = 0.478; q[20] = 0.729;
  q[21] = 0.329; q[22] = 0.808; q[23] = 0.890;
  q[24] = 0.386; q[25] = 0.751; q[26] = 0.833;
  q[27] = 0.549; q[28] = 0.616; q[29] = 0.978;
  q[30] = 0.527; q[31] = 0.700; q[32] = 0.835;
);

// ---------------------------------------------------------------- basics

function g_rgb(r, g, b) ( gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = 1; );
function g_col(c) (
  c === 0 ? g_rgb(0.063, 0.067, 0.082) :
  c === 1 ? g_rgb(0.102, 0.110, 0.133) :
  c === 2 ? g_rgb(0.149, 0.159, 0.188) :
  c === 3 ? g_rgb(0.212, 0.224, 0.263) :
  c === 4 ? g_rgb(0.937, 0.941, 0.953) :
  c === 5 ? g_rgb(0.640, 0.660, 0.705) :
  c === 6 ? g_rgb(0.580, 0.600, 0.640) :
  c === 7 ? g_rgb(0.180, 0.192, 0.226) :
  g_rgb(0.047, 0.051, 0.063);
);
function g_acc(a) ( g_rgb(GPAL[a * 3], GPAL[a * 3 + 1], GPAL[a * 3 + 2]); );
function g_accm(a, t) (
  g_rgb(0.102 + (GPAL[a * 3] - 0.102) * t, 0.110 + (GPAL[a * 3 + 1] - 0.110) * t, 0.133 + (GPAL[a * 3 + 2] - 0.133) * t);
);
function g_sx(x) ( gox + x * gz; );
function g_sy(y) ( goy + y * gz; );
function g_font(sz, fl) ( gfx_setfont(1, "Arial", sz * gz, fl); );
function g_tw(str) local(tw, th) ( gfx_measurestr(str, tw, th); tw / gz; );
function g_txt(str, x, y, al) local(tw, th) (
  gfx_measurestr(str, tw, th);
  gfx_x = al === 1 ? g_sx(x) - tw * 0.5 : al === 2 ? g_sx(x) - tw : g_sx(x);
  gfx_y = g_sy(y) - th * 0.5;
  gfx_drawstr(str);
);
function g_in(x, y, w, h) ( gmx >= x && gmx < x + w && gmy >= y && gmy < y + h; );
function g_frect(x, y, w, h) local(rx0, ry0, rx1, ry1) (
  rx0 = floor(g_sx(x) + 0.5); ry0 = floor(g_sy(y) + 0.5); rx1 = floor(g_sx(x + w) + 0.5); ry1 = floor(g_sy(y + h) + 0.5);
  gfx_rect(rx0, ry0, max(1, rx1 - rx0), max(1, ry1 - ry0), 1);
);
function g_line(x1, y1, x2, y2) ( gfx_line(g_sx(x1), g_sy(y1), g_sx(x2), g_sy(y2), 1); );
function g_tline(x1, y1, x2, y2, t) local(i, nx, ny, l) (
  l = sqrt(sqr(x2 - x1) + sqr(y2 - y1)) + 0.0001;
  nx = -(y2 - y1) / l; ny = (x2 - x1) / l;
  i = -t / 2;
  while (i <= t / 2) ( g_line(x1 + nx * i, y1 + ny * i, x2 + nx * i, y2 + ny * i); i += 0.5 / gz; );
);
function g_arc(x, y, r, a0, a1, t) local(i) (
  i = 0; loop(ceil(t * gz / 0.6), gfx_arc(g_sx(x), g_sy(y), r * gz - i * 0.6, a0, a1, 1); i += 1;);
);
function g_disc(x, y, r) ( gfx_circle(g_sx(x), g_sy(y), r * gz, 1, 1); );

function g_rrpx(px0, py0, px1, py1, RR) local(a0, j, jm, yc, dy, cov, ext, xl, xr, lc, rc) (
  a0 = gfx_a;
  RR = max(0, min(RR, min(px1 - px0, py1 - py0) * 0.5));
  j = floor(py0);
  while (j < ceil(py1)) (
    yc = j + 0.5;
    yc > py0 + RR && j + 1 < py1 - RR && floor(px0) === px0 && floor(px1) === px1 ? (
      jm = floor(py1 - RR);
      gfx_a = a0; gfx_rect(px0, j, px1 - px0, jm - j, 1);
      j = jm; yc = j + 0.5;
    );
