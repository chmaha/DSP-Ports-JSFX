// ---------------------------------------------------------------- parameter maps

function g_lo(s) ( GT[s * GTS]; );
function g_hi(s) ( GT[s * GTS + 1]; );
function g_def(s) ( GT[s * GTS + 2]; );
function g_unit(s) ( GT[s * GTS + 4]; );
function g_u2v(s, u) local(lo, hi, tp) (
  lo = g_lo(s); hi = g_hi(s); tp = GT[s * GTS + 3];
  u = max(0, min(1, u));
  tp === 1 ? lo * (hi / lo) ^ u : tp === 2 ? lo + (hi - lo) * u * u * u : tp === 3 ? lo + (hi - lo) * u * u : lo + (hi - lo) * u;
);
function g_v2u(s, v) local(lo, hi, tp) (
  lo = g_lo(s); hi = g_hi(s); tp = GT[s * GTS + 3];
  v = max(lo, min(hi, v));
  tp === 1 ? log(v / lo) / log(hi / lo) : tp === 2 ? ((v - lo) / (hi - lo)) ^ (1 / 3) : tp === 3 ? sqrt((v - lo) / (hi - lo)) : (v - lo) / (hi - lo);
);
function g_put(s, v) (
  g_unit(s) === 6 ? v = floor(v + 0.5);
  v = max(g_lo(s), min(g_hi(s), v));
  g_get(s) !== v ? ( g_set(s, v); g_auto(s, 0); );
);
function g_touch_end(s) ( g_auto(s, 1); );
function g_dbl(id) local(r) (
  r = id === glast_id && gnow - glast_t < 0.32;
  glast_id = id; glast_t = gnow;
  r;
);
function g_item(list, idx) local(i, n, c, p, st) (
  n = strlen(list); i = 0; p = 0; st = 0;
  strcpy(#gitem, "");
  while (i <= n) (
    c = i < n ? str_getchar(list, i) : 124;
    c === 124 ? ( p === idx ? strcpy_substr(#gitem, list, st, i - st); p += 1; st = i + 1; );
    i += 1;
  );
  #gitem;
);
function g_fmt(s, v) local(un) (
  un = g_unit(s);
  un === 1 ? (
    v >= 1000 ? sprintf(#gval, "%.2f kHz", v / 1000) : v >= 100 ? sprintf(#gval, "%.0f Hz", v) :
    v >= 10 ? sprintf(#gval, "%.1f Hz", v) : sprintf(#gval, "%.2f Hz", v);
  ) : un === 2 ? sprintf(#gval, "%.1f dB", v)
  : un === 3 ? (
    floor(v * srate) < 1 ? strcpy(#gval, "Off") : v < 0.01 ? sprintf(#gval, "%.1f ms", v * 1000) :
    v < 1 ? sprintf(#gval, "%.0f ms", v * 1000) : sprintf(#gval, "%.2f s", v);
  ) : un === 5 ? sprintf(#gval, "%.0f %%", v * 100)
  : un === 7 ? (abs(v) < 0.5 ? strcpy(#gval, "0 Hz") : sprintf(#gval, "%+.0f Hz", v))
  : un === 6 ? strcpy(#gval, g_item(GT[s * GTS + 6], floor(v + 0.5)))
  : s >= 9 && s <= 11 ? (
    sprintf(#gval, "%.2f", v);
    abs(v) < 0.005 ? strcat(#gval, " none") : abs(v - 1) < 0.005 ? strcat(#gval, " AM") : abs(v - 2) < 0.005 ? strcat(#gval, " RM");
  ) : sprintf(#gval, "%.2f", v);
  #gval;
);
function g_hover(s) ( ghover = s; );

// ---------------------------------------------------------------- knob

function g_knob(s, cx, cy, r, a, label, dim) local(v, u, hit, hot, ang, t, cap, bip, id, nu)
(
  id = s;
  v = g_get(s); u = g_v2u(s, v);
  hit = sqr(gmx - cx) + sqr(gmy - cy) <= sqr(r + 5) || g_in(cx - r - 8, cy + r, 2 * r + 16, 30);
  gclick && hit && !gact ? (
    g_dbl(id) ? ( g_put(s, g_def(s)); g_touch_end(s); ) : ( gact = s; gkind = 1; gdu = u; gdy = gmy; );
  );
  gact === s && gkind === 1 && gdown ? (
    mouse_cap |= 65536;
    gmy !== gdy ? (
      nu = gdu + (gdy - gmy) / (gshift ? 1200 : 200);
      gdu = max(0, min(1, nu)); gdy = gmy;
      g_put(s, g_u2v(s, gdu));
    );
  );
  hit && gwheel !== 0 && !gdown ? (
    g_put(s, g_u2v(s, u + gwheel / 120 * (gshift ? 0.004 : 0.02)));
    g_touch_end(s);
  );
  hot = hit || gact === s;
  hot ? g_hover(s);
  v = g_get(s); u = g_v2u(s, v);
  ang = -2.4 + 4.8 * u;
  t = max(2.6, r * 0.14);
  g_accm(a, dim ? 0.10 : 0.20);
  g_arc(cx, cy, r, -2.4, 2.4, t);
  dim ? g_accm(a, 0.45) : g_acc(a);
  bip = g_unit(s) === 7;
  bip ? g_arc(cx, cy, r, min(0, ang), max(0, ang), t) : u > 0.002 ? g_arc(cx, cy, r, -2.4, ang, t);
  cap = r - t - 3;
  hot ? g_col(3) : g_col(2);
  g_disc(cx, cy, cap);
  dim ? g_col(6) : g_col(4);
  g_tline(cx + sin(ang) * cap * 0.2, cy - cos(ang) * cap * 0.2, cx + sin(ang) * (cap - 1), cy - cos(ang) * (cap - 1), max(1.6, r * 0.09));
  g_font(12, 'b'); dim ? g_col(6) : g_col(5);
  g_txt(label, cx, cy + r + 11, 1);
  g_font(12, 0); hot ? g_acc(a) : dim ? g_col(6) : g_col(4);
  g_txt(g_fmt(s, v), cx, cy + r + 24, 1);
);

// ---------------------------------------------------------------- segmented selector

function g_seg(s, x, y, w, h, a) local(n, i, sw, v, hit, hv, list)
(
  list = GT[s * GTS + 6];
  n = g_hi(s) - g_lo(s) + 1;
  sw = w / n;
  v = floor(g_get(s) + 0.5);
  hit = g_in(x, y, w, h);
  hv = hit ? floor((gmx - x) / sw) : -1;
  gclick && hit && !gact ? ( gact = -1; g_put(s, hv); g_touch_end(s); v = hv; );
  hit && gwheel !== 0 && !gdown ? ( g_put(s, v + (gwheel > 0 ? 1 : -1)); g_touch_end(s); v = floor(g_get(s) + 0.5); );
  hit ? g_hover(s);
  g_col(8); g_rr(x, y, w, h, h * 0.5);
  i = 0;
  loop(n,
    i === v ? ( g_acc(a); g_rr(x + i * sw + 2, y + 2, sw - 4, h - 4, (h - 4) * 0.5); )
    : i === hv ? ( g_col(7); g_rr(x + i * sw + 2, y + 2, sw - 4, h - 4, (h - 4) * 0.5); );
    g_font(12, 'b');
    g_tw(g_item(list, i)) > sw - 8 ? g_font(11, 'b');
    i === v ? g_col(0) : i === hv ? g_col(4) : g_col(5);
    g_txt(#gitem, x + (i + 0.5) * sw, y + h * 0.5, 1);
    i += 1;
  );
);

// ---------------------------------------------------------------- wave glyph

function g_wave(x, y, w, h, wv, isosc, a) local(i, n, px, py, ph, yv, py0, k)
(
  g_col(8); g_rr(x, y, w, h, 6);
  g_rgb(1, 1, 1); gfx_a = 0.05; g_frect(x + 6, y + h * 0.5, w - 12, 1); gfx_a = 1;
  g_acc(a);
  n = floor(w - 12);
  i = 0; py0 = 0;
  loop(n + 1,
    ph = (i / n) * 2;
    ph -= floor(ph);
    wv === 0 ? yv = sin(ph * 2 * $pi)
    : wv === 1 ? yv = ph < 0.25 ? ph * 4 : ph < 0.75 ? 2 - ph * 4 : ph * 4 - 4
    : wv === 2 ? yv = 1 - 2 * ph
    : wv === 3 ? yv = ph < 0.5 ? 1 : -1
    : isosc ? ( k = (floor(i / 3) * 7919 + 13) % 101; yv = (k / 50 - 1) * 0.85; )
    : ( k = floor(i / n * 6); yv = ((k * 37 + 11) % 13) / 6.5 - 0.95; );
    px = x + 6 + i; py = y + h * 0.5 - yv * (h * 0.5 - 7);
    i > 0 ? g_tline(px - 1, py0, px, py, 1.6);
    py0 = py;
    i += 1;
  );
);

// ---------------------------------------------------------------- filter curve

function g_curve(x, y, w, h, b, a) local(tp, fc, q, rs, sr, qd, qn, i, n, f, wr, dr, di, m, hr, hi, br, bi, nr, ni, ox, oy, px, py, lo, hi2, mg, dd)
(
  g_col(8); g_rr(x, y, w, h, 6);
  tp = floor(g_get(23 + (b - 1) * 6) + 0.5);
  fc = max(1, g_get(24 + (b - 1) * 6)); q = g_get(25 + (b - 1) * 6); rs = g_get(26 + (b - 1) * 6);
  sr = max(8000, srate);
  qd = 2 * cos((q ^ 0.1) * $pi * 0.5);
  qn = sqrt(qd * 0.5 + 0.01);
  lo = log(20); hi2 = log(min(20000, sr * 0.5));
  g_rgb(1, 1, 1); gfx_a = 0.06;
  g_frect(x + 6, y + h * 0.5, w - 12, 1);
  gfx_a = 1;
  tp === 0 ? (
    g_accm(a, 0.5); g_frect(x + 6, y + h * 0.5 - 1, w - 12, 2);
    g_font(11, 0); g_col(6); g_txt("filter off", x + w * 0.5, y + h * 0.5 - 9, 1);
  ) : (
    n = floor(w - 12);
    g_acc(a);
    i = 0;
    loop(n + 1,
      f = exp(lo + (hi2 - lo) * i / n);
      wr = f / fc;
      dr = 1 - wr * wr; di = qd * wr;
      dd = dr * dr + di * di + 0.0000000001;
      br = (wr * di) / dd; bi = (wr * dr) / dd;
      nr = 1 - qn * rs * br; ni = -qn * rs * bi;
      tp === 1 ? ( hr = dr / dd; hi = -di / dd; )
      : tp === 2 ? ( hr = (-wr * wr) * dr / dd; hi = (wr * wr) * di / dd; )
      : tp === 3 ? ( hr = br; hi = bi; )
      : tp === 4 ? ( hr = (1 - wr * wr) * dr / dd; hi = -(1 - wr * wr) * di / dd; )
      : ( hr = (1 + wr * wr) * dr / dd; hi = -(1 + wr * wr) * di / dd; );
      m = sqrt((hr * hr + hi * hi) / (nr * nr + ni * ni));
      m *= qn;
      mg = 20 * log10(max(m, 0.00001));
      mg = max(-30, min(24, mg));
      px = x + 6 + i; py = y + h * 0.5 - mg / 30 * (h * 0.5 - 6);
      i > 0 ? g_tline(ox, oy, px, py, 1.6);
      ox = px; oy = py;
      i += 1;
    );
  );
);

// ---------------------------------------------------------------- crossover strip

function g_fx(f) ( GXB0 + (GXB1 - GXB0) * log(f / 40) / log(300); );
function g_xf(px) ( 40 * 300 ^ ((px - GXB0) / (GXB1 - GXB0)); );
function g_xover(x, y, w, h) local(lf, uf, ul, el, eu, xl, xu, by, bh, hit, near, s, u, nf, cx)
(
  g_card(x, y, w, h, 2, "Crossover");
  lf = g_get(18); uf = g_get(19);
  eu = max(200, min(floor(srate / 6), uf)); el = max(0, min(eu, lf));
  GXB0 = x + 216; GXB1 = x + w - 14;
  by = y + 12; bh = h - 24;
  xl = g_fx(max(40, el)); xu = g_fx(max(40, eu));
  g_accm(7, 0.30); g_frect(GXB0, by, xl - GXB0, bh);
  g_accm(6, 0.30); g_frect(xl, by, xu - xl, bh);
  g_accm(5, 0.30); g_frect(xu, by, GXB1 - xu, bh);
  g_rgb(1, 1, 1); gfx_a = 0.10;
  cx = 100; loop(3, g_frect(g_fx(cx), by + bh - 6, 1, 6); cx < 10000 ? ( g_frect(g_fx(cx * 2), by + bh - 4, 1, 4); g_frect(g_fx(cx * 5), by + bh - 4, 1, 4); ); cx *= 10;);
  gfx_a = 1;
  g_font(11, 0); g_col(6);
  g_txt("100", g_fx(100) + 3, by + bh - 8, 0); g_txt("1k", g_fx(1000) + 3, by + bh - 8, 0); g_txt("10k", g_fx(10000) + 3, by + bh - 8, 0);
  g_font(12, 'b');
  xl - GXB0 > 80 ? ( g_acc(7); g_txt("Band 3", (GXB0 + xl) * 0.5, by + 12, 1); );
  xu - xl > 80 ? ( g_acc(6); g_txt("Band 2", (xl + xu) * 0.5, by + 12, 1); );
  GXB1 - xu > 80 ? ( g_acc(5); g_txt("Band 1", (xu + GXB1) * 0.5, by + 12, 1); );
  g_font(12, 0); g_col(5);
  g_txt("Lower", x + 24, y + 38, 0); g_txt("Upper", x + 24, y + 54, 0);
  g_col(4);
  g_txt(g_fmt(18, lf), x + 124, y + 38, 2); g_txt(g_fmt(19, uf), x + 124, y + 54, 2);
  g_col(6);
  el !== lf ? ( g_fmt(18, el); strcpy(#gxs, "is "); strcat(#gxs, #gval); g_txt(#gxs, x + 132, y + 38, 0); );
  eu !== uf ? ( g_fmt(19, eu); strcpy(#gxs, "max "); strcat(#gxs, #gval); g_txt(#gxs, x + 132, y + 54, 0); );
  hit = g_in(GXB0 - 6, by, GXB1 - GXB0 + 12, bh);
  near = abs(gmx - g_fx(max(40, lf))) < abs(gmx - g_fx(max(40, uf))) ? 18 : 19;
  gclick && hit && !gact ? (
    g_dbl(100 + near) ? ( g_put(near, g_def(near)); g_touch_end(near); ) : (
      gact = near; gkind = 2; gdx = gmx;
      gdu = g_v2u(near, near === 18 ? lf : uf);
      !gshift ? ( gdu = g_v2u(near, g_xf(gmx)); g_put(near, g_u2v(near, gdu)); );
    );
  );
  (gact === 18 || gact === 19) && gkind === 2 && gdown ? (
    s = gact;
    gmx !== gdx ? (
      gshift ? (
        nf = g_xf(g_fx(g_u2v(s, gdu)) + (gmx - gdx) / 8);
      ) : nf = g_xf(gmx);
      gdu = g_v2u(s, nf); gdx = gmx;
      g_put(s, g_u2v(s, gdu));
    );
  );
  hit && gwheel !== 0 && !gdown ? (
    u = g_v2u(near, g_get(near));
    g_put(near, g_u2v(near, u + gwheel / 120 * (gshift ? 0.004 : 0.02))); g_touch_end(near);
  );
  hit || gact === 18 || gact === 19 ? g_hover(gact === 18 || gact === 19 ? gact : near);
  lf = g_get(18); uf = g_get(19);
  s = 18;
  loop(2,
    cx = g_fx(max(40, s === 18 ? lf : uf));
    (ghover === s) ? g_col(4) : g_rgb(0.82, 0.84, 0.88);
    g_frect(cx - 1, by - 3, 2, bh + 6);
    g_snap4(cx - 5, by - 6, 10, 14); g_rrpx(gq0, gq1, gq2, gq3, 5 * gz);
    s += 1;
  );
);

// ---------------------------------------------------------------- sections

function g_logo(x, y) (
  g_acc(0); g_disc(x + 14, y + 15, 12);
  gfx_triangle(g_sx(x + 6), g_sy(y + 22), g_sx(x + 13), g_sy(y + 26), g_sx(x + 3), g_sy(y + 33));
  g_acc(3); g_disc(x + 30, y + 22, 11);
  gfx_triangle(g_sx(x + 36), g_sy(y + 29), g_sx(x + 29), g_sy(y + 32), g_sx(x + 41), g_sy(y + 38));
  g_col(0);
  g_disc(x + 25, y + 22, 1.6); g_disc(x + 30, y + 22, 1.6); g_disc(x + 35, y + 22, 1.6);
  g_rgb(0.15, 0.10, 0.10); g_tline(x + 8, y + 12, x + 18, y + 12, 1.6); g_tline(x + 8, y + 17, x + 15, y + 17, 1.6);
);

function g_title() local(i, n, c, px) (
  g_logo(14, 4);
  g_font(22, 'b');
  strcpy(#gtt, "Mixed Messages");
  n = strlen(#gtt); px = 64; i = 0;
  loop(n,
    c = str_getchar(#gtt, i);
    strcpy_substr(#gch, #gtt, i, 1);
    c !== 32 ? g_acc((i * 3) % 8) : 0;
    g_txt(#gch, px, 23, 0);
    px += g_tw(#gch);
    i += 1;
  );
  g_font(12, 0); g_col(5);
  g_txt("SWH Hermes Filter", px + 12, 25, 0);
  g_txt("Sources  >  Mix  >  Crossover  >  Bands", GW - 14, 25, 2);
);

function g_src(x, y, w, h, a, title, ws, fs, isosc) (
  g_card(x, y, w, h, a, title);
  g_seg(ws, x + 10, y + 32, w - 20, 24, a);
  g_wave(x + 12, y + 66, w - 92, h - 78, floor(g_get(ws) + 0.5), isosc, a);
  g_knob(fs, x + w - 40, y + 86, 20, a, isosc ? "Freq" : "Rate", isosc && floor(g_get(ws) + 0.5) === 4);
);

function g_band(b, x, y, w, h) local(a, o, ft, dl, xc, lf, uf, eu, el) (
  a = 4 + b;
  o = (b - 1) * 6;
  g_card(x, y, w, h, a, b === 1 ? "Band 1" : b === 2 ? "Band 2" : "Band 3");
  lf = g_get(18); uf = g_get(19);
  eu = max(200, min(floor(srate / 6), uf)); el = max(0, min(eu, lf));
  b === 1 ? ( g_fmt(19, eu); strcpy(#gbr, "above "); strcat(#gbr, #gval); )
  : b === 2 ? ( g_fmt(18, el); strcpy(#gbr, #gval); strcat(#gbr, " - "); g_fmt(19, eu); strcat(#gbr, #gval); )
  : ( g_fmt(18, el); strcpy(#gbr, "below "); strcat(#gbr, #gval); );
  g_font(12, 0); g_col(5); g_txt(#gbr, x + w - 14, y + 18, 2);
  g_knob(19 + b, x + 46, y + 72, 21, a, "Drive", 0);
  g_seg(23 + o, x + 96, y + 34, w - 110, 24, a);
  g_curve(x + 96, y + 64, w - 110, 52, b, a);
  ft = floor(g_get(23 + o) + 0.5) === 0;
  xc = (w - 24) / 5;
  g_knob(24 + o, x + 12 + xc * 0.5, y + 154, 17, a, "Freq", ft);
  g_knob(25 + o, x + 12 + xc * 1.5, y + 154, 17, a, "Q", ft);
  g_knob(26 + o, x + 12 + xc * 2.5, y + 154, 17, a, "Res", ft);
  g_knob(27 + o, x + 12 + xc * 3.5, y + 154, 17, 0, "LFO 1", ft);
  g_knob(28 + o, x + 12 + xc * 4.5, y + 154, 17, 1, "LFO 2", ft);
  g_col(3); g_frect(x + 12, y + 206, w - 24, 1); g_frect(x + w - 92, y + 214, 1, 68);
  g_font(11, 'b'); g_col(6);
  g_txt("DELAY", x + 14, y + 216, 0); g_txt("OUT", x + w - 80, y + 216, 0);
  dl = floor(g_get(41 + (b - 1) * 3) * srate) < 1;
  g_knob(41 + (b - 1) * 3, x + 44, y + 242, 17, a, "Time", 0);
  g_knob(42 + (b - 1) * 3, x + 112, y + 242, 17, a, "Feedback", dl);
  g_knob(43 + (b - 1) * 3, x + 180, y + 242, 17, a, "Wet", dl);
  g_knob(49 + b, x + w - 46, y + 242, 17, a, "Gain", 0);
);

function g_rm(k, x, y, w, h) local(a, s1, s2, tw) (
  a = 7 + k;
  g_card(x, y, w, h, a, k === 1 ? "Ring Mod 1" : k === 2 ? "Ring Mod 2" : "Ring Mod 3");
  s1 = k === 1 ? 2 : k === 2 ? 4 : 2; s2 = k === 1 ? 3 : k === 2 ? 3 : 4;
  strcpy(#grm, k === 1 ? "Osc 1 × Osc 2" : k === 2 ? "Input × Osc 2" : "Osc 1 × Input");
  g_font(12, 0); tw = g_tw(#grm);
  g_acc(s2); g_disc(x + w - 18, y + 18, 4);
  g_col(5); g_txt(#grm, x + w - 28, y + 18, 2);
  g_acc(s1); g_disc(x + w - 38 - tw, y + 18, 4);
  g_knob(8 + k, x + w * 0.3, y + 60, 19, a, "Depth", 0);
  g_knob(k === 1 ? 13 : k === 2 ? 15 : 17, x + w * 0.7, y + 60, 19, a, "Gain", 0);
);

function g_sacc(s) local(k) (
  s <= 2 ? 0 : s <= 4 ? 1 : s <= 6 || s === 12 ? 2 : s <= 8 || s === 14 ? 3 : s === 16 ? 4 :
  s === 9 || s === 13 ? 8 : s === 10 || s === 15 ? 9 : s === 11 || s === 17 ? 10 : s <= 19 ? 2 : s <= 22 ? s - 15 :
  s <= 40 ? ( k = (s - 23) % 6; k === 4 ? 0 : k === 5 ? 1 : 5 + floor((s - 23) / 6); ) :
  s <= 49 ? 5 + floor((s - 41) / 3) : s - 45;
);

function g_hintbar(y) (
  g_col(9); g_frect(0, y, GW, GH - y);
  g_font(12, 0);
  ghover > 0 ? (
    g_col(4); g_txt(GT[ghover * GTS + 5], 14, y + 11, 0);
    g_acc(g_sacc(ghover));
    g_txt(g_fmt(ghover, g_get(ghover)), 14 + g_tw(GT[ghover * GTS + 5]) + 12, y + 11, 0);
    g_col(5);
    ghover >= 9 && ghover <= 11 ? g_txt("0 = none (+6 dB)   1 = AM   2 = RM", GW - 14, y + 11, 2)
    : g_unit(ghover) === 6 ? g_txt("click a segment, or use the wheel", GW - 14, y + 11, 2)
    : g_txt("drag   Shift fine   wheel   double-click resets", GW - 14, y + 11, 2);
  ) : (
    g_col(5); g_txt("Hermes Filter by Steve Harris, ported to JSFX. Hover a control for details.", 14, y + 11, 0);
  );
);

// ---------------------------------------------------------------- frame

GW = 1040; GH = 720;
!ginit ? ( g_tables(); g_pal_init(); ginit = 1; );

gz = max(0.4, min(gfx_w / GW, gfx_h / GH));
gox = floor((gfx_w - GW * gz) * 0.5); goy = 0;
gmx = (mouse_x - gox) / gz; gmy = (mouse_y - goy) / gz;
gnow = time_precise();
gdown = mouse_cap & 1;
gclick = gdown && !gpdown;
gshift = (mouse_cap & 8) ? 1 : 0;
gwheel = mouse_wheel; mouse_wheel = 0;
ghover = 0;
!gdown && gact ? ( gact > 0 ? g_touch_end(gact); gact = 0; gkind = 0; );

g_col(0); gfx_rect(0, 0, gfx_w, gfx_h, 1);
g_title();

g_src(12, 52, 214, 140, 0, "LFO 1", 2, 1, 0);
g_src(236, 52, 214, 140, 1, "LFO 2", 4, 3, 0);
g_src(460, 52, 214, 140, 2, "Osc 1", 6, 5, 1);
g_src(684, 52, 214, 140, 3, "Osc 2", 8, 7, 1);
g_card(908, 52, 120, 140, 4, "Input");
g_font(12, 0); g_col(5); g_txt("into the mix", 968, 46 + 52, 1);
g_knob(16, 968, 52 + 86, 22, 4, "Gain", 0);

g_card(12, 200, 196, 112, 2, "Osc Levels");
g_knob(12, 12 + 54, 200 + 60, 19, 2, "Osc 1", 0);
g_knob(14, 12 + 142, 200 + 60, 19, 3, "Osc 2", 0);
g_rm(1, 218, 200, 264, 112);
g_rm(2, 492, 200, 264, 112);
g_rm(3, 766, 200, 262, 112);

g_xover(12, 320, 1016, 68);

g_band(1, 12, 396, 332, 292);
g_band(2, 354, 396, 332, 292);
g_band(3, 696, 396, 332, 292);

g_hintbar(696);

gpdown = gdown;
