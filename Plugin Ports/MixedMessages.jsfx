import Dependencies/MixedMessages/hermes_dsp.jsfx-inc

in_pin:L
in_pin:R
out_pin:L
out_pin:R

options:no_meter
@init
ext_noinit = gfx_ext_retina = 1;
last_srate = srate;
mm_reset();

@slider
last_srate !== srate ? (
  last_srate = srate;
  mm_reset();
);

@block
mm_block();

@sample
spl0 = mmL.mm_step(spl0);
spl1 = mmR.mm_step(spl1);

@gfx 1040 720

function g_auto(s, e)
(
<?
  max_sliders > 52 ? printf("slider_automate(2^(s-1), e);") : (
    printf("  s == 1 ? slider_automate(h_lfo1_freq, e) :\n");
    printf("  s == 2 ? slider_automate(h_lfo1_wave, e) :\n");
    printf("  s == 3 ? slider_automate(h_lfo2_freq, e) :\n");
    printf("  s == 4 ? slider_automate(h_lfo2_wave, e) :\n");
    printf("  s == 5 ? slider_automate(h_osc1_freq, e) :\n");
    printf("  s == 6 ? slider_automate(h_osc1_wave, e) :\n");
    printf("  s == 7 ? slider_automate(h_osc2_freq, e) :\n");
    printf("  s == 8 ? slider_automate(h_osc2_wave, e) :\n");
    printf("  s == 9 ? slider_automate(h_rm1_depth, e) :\n");
    printf("  s == 10 ? slider_automate(h_rm2_depth, e) :\n");
    printf("  s == 11 ? slider_automate(h_rm3_depth, e) :\n");
    printf("  s == 12 ? slider_automate(h_osc1_gain_db, e) :\n");
