      xr - rc > 0 ? ( gfx_a = a0 * cov * (xr - rc); gfx_rect(rc, j, 1, 1, 1); );
    );
    j += 1;
  );
  gfx_a = a0;
);
function g_snap4(x, y, w, h) (
  gq0 = floor(g_sx(x) + 0.5); gq1 = floor(g_sy(y) + 0.5); gq2 = floor(g_sx(x + w) + 0.5); gq3 = floor(g_sy(y + h) + 0.5);
);
function g_rr(x, y, w, h, r) ( g_snap4(x, y, w, h); g_rrpx(gq0, gq1, gq2, gq3, r * gz); );
function g_rrb(x, y, w, h, r, fr, fg, fb, br, bg, bb) local(t) (
  g_snap4(x, y, w, h);
