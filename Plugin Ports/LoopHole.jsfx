slider5:a_df=1<0,1,0.001>-A Delay Feed
slider6:a_mix=0.5<0,1,0.001>-A Mix
slider7:b_time=8<0,16,1>-B Time
slider8:b_mult=1<0,2,1{/8,x1,+16}>-B Time Switch
slider9:b_fb=0.375<0,1,0.001>-B Feedback
slider10:b_df=1<0,1,0.001>-B Delay Feed
slider11:b_mix=0.5<0,1,0.001>-B Mix
slider12:a_sc=0<0,1,1{On,Off}>-A Soft Clip
slider13:b_sc=0<0,1,1{On,Off}>-B Soft Clip
slider14:a_am=0<0,1,1{On,Off}>-A Auto Mute
slider15:b_am=0<0,1,1{On,Off}>-B Auto Mute
