slider17:b_xf=3<0,6,1{1 ms,2 ms,4 ms,8 ms,25 ms,100 ms,250 ms}>-B Crossfade
slider18:a_tap=0<0,1,1{Log,Lin}>-A Delay Feed Taper
slider19:b_tap=0<0,1,1{Log,Lin}>-B Delay Feed Taper
slider20:a_revm=0<0,1,1{Trig,Gate}>-A Reverse MIDI
slider21:a_holdm=0<0,1,1{Trig,Gate}>-A Hold MIDI
slider22:b_revm=0<0,1,1{Trig,Gate}>-B Reverse MIDI
slider23:b_holdm=0<0,1,1{Trig,Gate}>-B Hold MIDI

in_pin:Left input
in_pin:Right input
out_pin:Left output
out_pin:Right output
options:maxmem=8650752 no_meter

@init

function f32k(x) local(c) ( c = x * 536870913; c - (c - x); );
function alloc(n) local(r) instance(mp) global() ( r = mp; mp += n; memset(r, 0, n); r; );

MSZ = 4194304;
fixq = 1;

alloc.mp = 0;
EPP = alloc(4096);
LOGT = alloc(4096);
DET = alloc(20);
DIVV = alloc(20);
XFS = alloc(8);
XFW = alloc(8);
GQ = alloc(256);
BUFA = alloc(MSZ);
BUFB = alloc(MSZ);

function tdec_start(tb, sc) ( td_t = tb; td_s = sc; td_i = 0; td_v = 0; td_d = 0; );
function tdec(s) local(i, n, c, neg, acc, ind)
(
  i = 0; n = strlen(s); acc = 0; neg = 0; ind = 0;
  while (i <= n) (
    c = i < n ? str_getchar(s, i) : 44;
    c == 45 ? neg = 1
    : c == 44 ? (
      ind ? (
        neg ? acc = -acc;
        td_i == 0 ? ( td_v = acc; td_d = 0; )
        : td_i == 1 ? ( td_d = acc; td_v += td_d; )
        : ( td_d += acc; td_v += td_d; );
        td_t[td_i] = f32k(td_v / td_s);
        td_i += 1;
      );
      acc = 0; neg = 0; ind = 0;
    ) : (
      acc = (acc * 10) + (c - 48); ind = 1;
    );
    i += 1;
  );
);
tdec_start(EPP, 10000000000);
