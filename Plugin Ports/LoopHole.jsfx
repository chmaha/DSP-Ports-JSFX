function ch_update(vin, pbin) instance(buf, pbds, pbhi, pbre, pbfe, pbct, rbds, rbhi, rbre, rbfe, rbct, ibds, ibhi, ibre, ibfe, ibct, rjds, rjhi, rjre, rjfe, ijds, ijhi, ijre, ijfe, pjds, pjhi, pjre, pjfe, sw, ledrev, ledinf, ledping, pa0, pa1, pa2, pa3, ca0, ca1, ca2, ca3, tptmr, tptime, tpchg, tpledtmr, tlooptmr, tlooptime, tpledhi, tpcyc, tneedrst, clk, loopled, loopout, time, df, fb, mixd, mixw, divt, pingt, lockpt, csr, inf, rev, tpq, tcq, plock, qmc, ale, s_am, s_sc, s_rj, s_ij, s_ldf, s_auq, s_xs, s_xr, s_wxs, s_wxr, pcu0, ppr0, ptr0, pde0, pmi0, pmr0, pmv0, pcu1, ppr1, ptr1, pde1, pmi1, pmr1, pmv1, pcu2, ppr2, ptr2, pde2, pmi2, pmr2, pmv2, pcu3, ppr3, ptr3, pde3, pmi3, pmr3, pmv3, ccu0, cpr0, cde0, ccu1, cpr1, cde1, ccu2, cpr2, cde2, ccu3, cpr3, cde3, igi, igr, ack, wmode, qcm, f_tc, f_ic, f_rc, f_tqc, f_iqc, f_rqc, f_scroll, f_clr, mboot, brd, bwr, frd, fwr, rfp, qdt, qrfe, wfp, wfs, drf, ls, le, am_s, am_f, am_l, am_ar, am_dr, ax_s, ax_f, ax_l, ax_ar, ax_dr, dcl, fill, ui, srate_i, inprev, outv, k_time, k_fb, k_df, k_mix, k_sw, b_rev, b_inf, j_rev, j_inf, x_sc, x_am, x_ldf, x_rjg, x_ijg, x_xf, cvd, c_dfd, c_dfl, c_dfi, c_df, c_tp, c_tc, c_tpq, c_tcq, c_sw, c_tm, c_mx) local(nrm, o)
