  pcu3 = ppr3 = ptr3 = pde3 = pmi3 = pmr3 = pmv3 = 0;
  ccu0 = cpr0 = cde0 = ccu1 = cpr1 = cde1 = ccu2 = cpr2 = cde2 = ccu3 = cpr3 = cde3 = 0;
  igi = igr = 0; ack = 0; wmode = 0; qcm = 0;
  f_tc = 1; f_ic = f_rc = f_tqc = f_iqc = f_rqc = 0; f_scroll = 0; f_clr = 0; mboot = 375;
  brd = 0; bwr = 12000; frd = 0; fwr = 12000;
  rfp = 0; qdt = 0; qrfe = 0; wfp = 0; wfs = 0; drf = 0; ls = 0; le = 0;
  am_s = 0; am_f = 1; am_l = 8388; am_ar = f32k(1 / 960); am_dr = f32k(1 / 960);
  ax_s = 0; ax_f = 1; ax_l = 8388; ax_ar = f32k(1 / 960); ax_dr = f32k(1 / 960);
  dcl = 0;
  fill = 0; ui = 0; srate_i = 48000; inprev = 0; outv = 0;
  cvd = 1; c_dfd = c_dfl = -1; c_dfi = 1; c_df = 0; c_tp = c_tc = c_tpq = c_tcq = c_sw = -1; c_tm = 1; c_mx = -1;
);

function ch_set_samplerate(sr) instance(buf, pbds, pbhi, pbre, pbfe, pbct, rbds, rbhi, rbre, rbfe, rbct, ibds, ibhi, ibre, ibfe, ibct, rjds, rjhi, rjre, rjfe, ijds, ijhi, ijre, ijfe, pjds, pjhi, pjre, pjfe, sw, ledrev, ledinf, ledping, pa0, pa1, pa2, pa3, ca0, ca1, ca2, ca3, tptmr, tptime, tpchg, tpledtmr, tlooptmr, tlooptime, tpledhi, tpcyc, tneedrst, clk, loopled, loopout, time, df, fb, mixd, mixw, divt, pingt, lockpt, csr, inf, rev, tpq, tcq, plock, qmc, ale, s_am, s_sc, s_rj, s_ij, s_ldf, s_auq, s_xs, s_xr, s_wxs, s_wxr, pcu0, ppr0, ptr0, pde0, pmi0, pmr0, pmv0, pcu1, ppr1, ptr1, pde1, pmi1, pmr1, pmv1, pcu2, ppr2, ptr2, pde2, pmi2, pmr2, pmv2, pcu3, ppr3, ptr3, pde3, pmi3, pmr3, pmv3, ccu0, cpr0, cde0, ccu1, cpr1, cde1, ccu2, cpr2, cde2, ccu3, cpr3, cde3, igi, igr, ack, wmode, qcm, f_tc, f_ic, f_rc, f_tqc, f_iqc, f_rqc, f_scroll, f_clr, mboot, brd, bwr, frd, fwr, rfp, qdt, qrfe, wfp, wfs, drf, ls, le, am_s, am_f, am_l, am_ar, am_dr, ax_s, ax_f, ax_l, ax_ar, ax_dr, dcl, fill, ui, srate_i, inprev, outv, k_time, k_fb, k_df, k_mix, k_sw, b_rev, b_inf, j_rev, j_inf, x_sc, x_am, x_ldf, x_rjg, x_ijg, x_xf, cvd, c_dfd, c_dfl, c_dfi, c_df, c_tp, c_tc, c_tpq, c_tcq, c_sw, c_tm, c_mx) local(nsr, fac)
(
  nsr = floor(sr + 0.5);
  nsr != srate_i ? (
    srate_i = nsr;
    nsr != csr ? (
      am_ar = f32k(1 / max(1, floor(f32k(f32k(0.02) * nsr))));
      am_dr = am_ar;
      ax_ar = am_ar; ax_dr = am_ar;
      memset(buf, 0, MSZ);
      fac = f32k(nsr / csr);
      tptime = floor(f32k(tptime * fac));
      tptmr = floor(f32k(tptmr * fac));
      tpledtmr = floor(f32k(tpledtmr * fac));
      tlooptime = f32k(tlooptime * fac);
      tlooptmr = f32k(tlooptmr * fac);
      tpchg = 1;
      f_tc = 1;
      csr = nsr;
    );
  );
);

function ch_set_ping_time(t) instance(buf, pbds, pbhi, pbre, pbfe, pbct, rbds, rbhi, rbre, rbfe, rbct, ibds, ibhi, ibre, ibfe, ibct, rjds, rjhi, rjre, rjfe, ijds, ijhi, ijre, ijfe, pjds, pjhi, pjre, pjfe, sw, ledrev, ledinf, ledping, pa0, pa1, pa2, pa3, ca0, ca1, ca2, ca3, tptmr, tptime, tpchg, tpledtmr, tlooptmr, tlooptime, tpledhi, tpcyc, tneedrst, clk, loopled, loopout, time, df, fb, mixd, mixw, divt, pingt, lockpt, csr, inf, rev, tpq, tcq, plock, qmc, ale, s_am, s_sc, s_rj, s_ij, s_ldf, s_auq, s_xs, s_xr, s_wxs, s_wxr, pcu0, ppr0, ptr0, pde0, pmi0, pmr0, pmv0, pcu1, ppr1, ptr1, pde1, pmi1, pmr1, pmv1, pcu2, ppr2, ptr2, pde2, pmi2, pmr2, pmv2, pcu3, ppr3, ptr3, pde3, pmi3, pmr3, pmv3, ccu0, cpr0, cde0, ccu1, cpr1, cde1, ccu2, cpr2, cde2, ccu3, cpr3, cde3, igi, igr, ack, wmode, qcm, f_tc, f_ic, f_rc, f_tqc, f_iqc, f_rqc, f_scroll, f_clr, mboot, brd, bwr, frd, fwr, rfp, qdt, qrfe, wfp, wfs, drf, ls, le, am_s, am_f, am_l, am_ar, am_dr, ax_s, ax_f, ax_l, ax_ar, ax_dr, dcl, fill, ui, srate_i, inprev, outv, k_time, k_fb, k_df, k_mix, k_sw, b_rev, b_inf, j_rev, j_inf, x_sc, x_am, x_ldf, x_rjg, x_ijg, x_xf, cvd, c_dfd, c_dfl, c_dfi, c_df, c_tp, c_tc, c_tpq, c_tcq, c_sw, c_tm, c_mx)
(
  tptmr = t;
  tpledtmr = 0;
  tptime = tptmr; tneedrst = 1;
  loopled = 1; loopout = 1; tlooptmr = 0;
  tpchg = 1;
  f_tc = 1;
);

function ch_timer_inc() instance(buf, pbds, pbhi, pbre, pbfe, pbct, rbds, rbhi, rbre, rbfe, rbct, ibds, ibhi, ibre, ibfe, ibct, rjds, rjhi, rjre, rjfe, ijds, ijhi, ijre, ijfe, pjds, pjhi, pjre, pjfe, sw, ledrev, ledinf, ledping, pa0, pa1, pa2, pa3, ca0, ca1, ca2, ca3, tptmr, tptime, tpchg, tpledtmr, tlooptmr, tlooptime, tpledhi, tpcyc, tneedrst, clk, loopled, loopout, time, df, fb, mixd, mixw, divt, pingt, lockpt, csr, inf, rev, tpq, tcq, plock, qmc, ale, s_am, s_sc, s_rj, s_ij, s_ldf, s_auq, s_xs, s_xr, s_wxs, s_wxr, pcu0, ppr0, ptr0, pde0, pmi0, pmr0, pmv0, pcu1, ppr1, ptr1, pde1, pmi1, pmr1, pmv1, pcu2, ppr2, ptr2, pde2, pmi2, pmr2, pmv2, pcu3, ppr3, ptr3, pde3, pmi3, pmr3, pmv3, ccu0, cpr0, cde0, ccu1, cpr1, cde1, ccu2, cpr2, cde2, ccu3, cpr3, cde3, igi, igr, ack, wmode, qcm, f_tc, f_ic, f_rc, f_tqc, f_iqc, f_rqc, f_scroll, f_clr, mboot, brd, bwr, frd, fwr, rfp, qdt, qrfe, wfp, wfs, drf, ls, le, am_s, am_f, am_l, am_ar, am_dr, ax_s, ax_f, ax_l, ax_ar, ax_dr, dcl, fill, ui, srate_i, inprev, outv, k_time, k_fb, k_df, k_mix, k_sw, b_rev, b_inf, j_rev, j_inf, x_sc, x_am, x_ldf, x_rjg, x_ijg, x_xf, cvd, c_dfd, c_dfl, c_dfi, c_df, c_tp, c_tc, c_tpq, c_tcq, c_sw, c_tm, c_mx)
(
  tneedrst ? ( tneedrst = 0; tptmr = 0; clk = 1; ) : tptmr += 1;
  tpledtmr += 1;
  tlooptmr = f32k(tlooptmr + 1);
  tpledtmr >= tptime ? (
    tpledtmr = 0; tpledhi = 1; tpcyc = 1; clk = 1;
  ) : tpledtmr >= floor(tptime / 2) ? (
    tpledhi = 0; clk = 0;
  );
  tlooptmr >= tlooptime ? (
    loopled = 1; loopout = 1; tlooptmr = f32k(tlooptmr - tlooptime);
  ) : tlooptmr >= f32k(tlooptime / 2) ? (
    loopled = 0; loopout = 0;
  );
);

function ch_sideload(pbin) instance(buf, pbds, pbhi, pbre, pbfe, pbct, rbds, rbhi, rbre, rbfe, rbct, ibds, ibhi, ibre, ibfe, ibct, rjds, rjhi, rjre, rjfe, ijds, ijhi, ijre, ijfe, pjds, pjhi, pjre, pjfe, sw, ledrev, ledinf, ledping, pa0, pa1, pa2, pa3, ca0, ca1, ca2, ca3, tptmr, tptime, tpchg, tpledtmr, tlooptmr, tlooptime, tpledhi, tpcyc, tneedrst, clk, loopled, loopout, time, df, fb, mixd, mixw, divt, pingt, lockpt, csr, inf, rev, tpq, tcq, plock, qmc, ale, s_am, s_sc, s_rj, s_ij, s_ldf, s_auq, s_xs, s_xr, s_wxs, s_wxr, pcu0, ppr0, ptr0, pde0, pmi0, pmr0, pmv0, pcu1, ppr1, ptr1, pde1, pmi1, pmr1, pmv1, pcu2, ppr2, ptr2, pde2, pmi2, pmr2, pmv2, pcu3, ppr3, ptr3, pde3, pmi3, pmr3, pmv3, ccu0, cpr0, cde0, ccu1, cpr1, cde1, ccu2, cpr2, cde2, ccu3, cpr3, cde3, igi, igr, ack, wmode, qcm, f_tc, f_ic, f_rc, f_tqc, f_iqc, f_rqc, f_scroll, f_clr, mboot, brd, bwr, frd, fwr, rfp, qdt, qrfe, wfp, wfs, drf, ls, le, am_s, am_f, am_l, am_ar, am_dr, ax_s, ax_f, ax_l, ax_ar, ax_dr, dcl, fill, ui, srate_i, inprev, outv, k_time, k_fb, k_df, k_mix, k_sw, b_rev, b_inf, j_rev, j_inf, x_sc, x_am, x_ldf, x_rjg, x_ijg, x_xf, cvd, c_dfd, c_dfl, c_dfi, c_df, c_tp, c_tc, c_tpq, c_tcq, c_sw, c_tm, c_mx) local(v, d)
(
  pa0 = min(4095, floor(f32k(f32k(k_time) * 4096)));
  pa1 = min(4095, floor(f32k(f32k(k_fb) * 4096)));
  pa2 = min(4095, floor(f32k(f32k(k_df) * 4096)));
  pa3 = min(4095, floor(f32k(f32k(k_mix) * 4096)));
  ca0 = 2048; ca1 = 0; ca2 = 0; ca3 = 0; cvd = 1;
  v = b_rev ? 1 : 0;
  rbds = ((rbds * 2) + v) & 3;
  rbds == 1 ? ( rbhi = 1; rbre = 1; rbfe = 0; rbct = 0; ) : rbds == 2 ? ( rbhi = 0; rbfe = 1; rbre = 0; rbct = 0; ) : ( rbhi = v; rbct += 1; );
  v = b_inf ? 1 : 0;
  ibds = ((ibds * 2) + v) & 3;
  ibds == 1 ? ( ibhi = 1; ibre = 1; ibfe = 0; ibct = 0; ) : ibds == 2 ? ( ibhi = 0; ibfe = 1; ibre = 0; ibct = 0; ) : ( ibhi = v; ibct += 1; );
  v = j_rev ? 1 : 0;
  rjds = ((rjds * 2) + v) & 15;
  rjds == 1 ? ( rjhi = 1; rjre = 1; rjfe = 0; ) : rjds == 14 ? ( rjhi = 0; rjfe = 1; rjre = 0; ) : rjhi = v;
  v = j_inf ? 1 : 0;
  ijds = ((ijds * 2) + v) & 15;
  ijds == 1 ? ( ijhi = 1; ijre = 1; ijfe = 0; ) : ijds == 14 ? ( ijhi = 0; ijfe = 1; ijre = 0; ) : ijhi = v;
  sw = k_sw;
  pjds = (pjds * 2) & 15;
  pjds == 14 ? ( pjhi = 0; pjfe = 1; pjre = 0; ) : pjhi = 0;
  v = pbin ? 1 : 0;
  pbds = ((pbds * 2) + v) & 3;
  pbds == 1 ? ( pbhi = 1; pbre = 1; pbfe = 0; pbct = 0; ) : pbds == 2 ? ( pbhi = 0; pbfe = 1; pbre = 0; pbct = 0; ) : ( pbhi = v; pbct += 1; );
  s_sc = x_sc == 0;
  s_am = x_am == 0;
  s_ldf = x_ldf == 0;
  s_rj = x_rjg == 0;
  s_ij = x_ijg == 0;
  s_auq = 0;
  d = XFS[x_xf];
  s_xs = max(1, floor((d * srate_i) / 48000));
  s_xr = f32k(1 / s_xs);
  d = XFW[x_xf];
  s_wxs = max(1, floor((d * srate_i) / 48000));
  s_wxr = f32k(1 / s_wxs);
);

function ch_hqmc() instance(buf, pbds, pbhi, pbre, pbfe, pbct, rbds, rbhi, rbre, rbfe, rbct, ibds, ibhi, ibre, ibfe, ibct, rjds, rjhi, rjre, rjfe, ijds, ijhi, ijre, ijfe, pjds, pjhi, pjre, pjfe, sw, ledrev, ledinf, ledping, pa0, pa1, pa2, pa3, ca0, ca1, ca2, ca3, tptmr, tptime, tpchg, tpledtmr, tlooptmr, tlooptime, tpledhi, tpcyc, tneedrst, clk, loopled, loopout, time, df, fb, mixd, mixw, divt, pingt, lockpt, csr, inf, rev, tpq, tcq, plock, qmc, ale, s_am, s_sc, s_rj, s_ij, s_ldf, s_auq, s_xs, s_xr, s_wxs, s_wxr, pcu0, ppr0, ptr0, pde0, pmi0, pmr0, pmv0, pcu1, ppr1, ptr1, pde1, pmi1, pmr1, pmv1, pcu2, ppr2, ptr2, pde2, pmi2, pmr2, pmv2, pcu3, ppr3, ptr3, pde3, pmi3, pmr3, pmv3, ccu0, cpr0, cde0, ccu1, cpr1, cde1, ccu2, cpr2, cde2, ccu3, cpr3, cde3, igi, igr, ack, wmode, qcm, f_tc, f_ic, f_rc, f_tqc, f_iqc, f_rqc, f_scroll, f_clr, mboot, brd, bwr, frd, fwr, rfp, qdt, qrfe, wfp, wfs, drf, ls, le, am_s, am_f, am_l, am_ar, am_dr, ax_s, ax_f, ax_l, ax_ar, ax_dr, dcl, fill, ui, srate_i, inprev, outv, k_time, k_fb, k_df, k_mix, k_sw, b_rev, b_inf, j_rev, j_inf, x_sc, x_am, x_ldf, x_rjg, x_ijg, x_xf, cvd, c_dfd, c_dfl, c_dfi, c_df, c_tp, c_tc, c_tpq, c_tcq, c_sw, c_tm, c_mx)
(
  f_tqc ? ( f_tqc = 0; f_tc = 1; );
  f_iqc ? ( f_iqc = 0; f_ic = 1; );
  f_rqc ? ( f_rqc = 0; f_rc = 1; );
);

function ch_pot(i) instance(buf, pbds, pbhi, pbre, pbfe, pbct, rbds, rbhi, rbre, rbfe, rbct, ibds, ibhi, ibre, ibfe, ibct, rjds, rjhi, rjre, rjfe, ijds, ijhi, ijre, ijfe, pjds, pjhi, pjre, pjfe, sw, ledrev, ledinf, ledping, pa0, pa1, pa2, pa3, ca0, ca1, ca2, ca3, tptmr, tptime, tpchg, tpledtmr, tlooptmr, tlooptime, tpledhi, tpcyc, tneedrst, clk, loopled, loopout, time, df, fb, mixd, mixw, divt, pingt, lockpt, csr, inf, rev, tpq, tcq, plock, qmc, ale, s_am, s_sc, s_rj, s_ij, s_ldf, s_auq, s_xs, s_xr, s_wxs, s_wxr, pcu0, ppr0, ptr0, pde0, pmi0, pmr0, pmv0, pcu1, ppr1, ptr1, pde1, pmi1, pmr1, pmv1, pcu2, ppr2, ptr2, pde2, pmi2, pmr2, pmv2, pcu3, ppr3, ptr3, pde3, pmi3, pmr3, pmv3, ccu0, cpr0, cde0, ccu1, cpr1, cde1, ccu2, cpr2, cde2, ccu3, cpr3, cde3, igi, igr, ack, wmode, qcm, f_tc, f_ic, f_rc, f_tqc, f_iqc, f_rqc, f_scroll, f_clr, mboot, brd, bwr, frd, fwr, rfp, qdt, qrfe, wfp, wfs, drf, ls, le, am_s, am_f, am_l, am_ar, am_dr, ax_s, ax_f, ax_l, ax_ar, ax_dr, dcl, fill, ui, srate_i, inprev, outv, k_time, k_fb, k_df, k_mix, k_sw, b_rev, b_inf, j_rev, j_inf, x_sc, x_am, x_ldf, x_rjg, x_ijg, x_xf, cvd, c_dfd, c_dfl, c_dfi, c_df, c_tp, c_tc, c_tpq, c_tcq, c_sw, c_tm, c_mx) local(cur, prev, ctr, diff, de, mi, mr, mv)
(
  cur = i == 0 ? pa0 : i == 1 ? pa1 : i == 2 ? pa2 : pa3;
  prev = i == 0 ? ppr0 : i == 1 ? ppr1 : i == 2 ? ppr2 : ppr3;
  ctr = i == 0 ? ptr0 : i == 1 ? ptr1 : i == 2 ? ptr2 : ptr3;
  de = i == 0 ? pde0 : i == 1 ? pde1 : i == 2 ? pde2 : pde3;
  mi = i == 0 ? pmi0 : i == 1 ? pmi1 : i == 2 ? pmi2 : pmi3;
  mr = i == 0 ? pmr0 : i == 1 ? pmr1 : i == 2 ? pmr2 : pmr3;
  diff = cur - prev;
  abs(diff) > 10 ? ctr = 10;
  ctr ? (
    ctr -= 1; prev = cur; de = diff; mv = 1;
    rbhi ? ( mr = 1; igr = 1; );
    ibhi ? ( mi = 1; igi = 1; );
  ) : ( mv = 0; de = 0; );
  i == 0 ? ( pcu0 = cur; ppr0 = prev; ptr0 = ctr; pde0 = de; pmi0 = mi; pmr0 = mr; pmv0 = mv; )
  : i == 1 ? ( pcu1 = cur; ppr1 = prev; ptr1 = ctr; pde1 = de; pmi1 = mi; pmr1 = mr; pmv1 = mv; )
  : i == 2 ? ( pcu2 = cur; ppr2 = prev; ptr2 = ctr; pde2 = de; pmi2 = mi; pmr2 = mr; pmv2 = mv; )
  : ( pcu3 = cur; ppr3 = prev; ptr3 = ctr; pde3 = de; pmi3 = mi; pmr3 = mr; pmv3 = mv; );
);

function ch_cv(i) instance(buf, pbds, pbhi, pbre, pbfe, pbct, rbds, rbhi, rbre, rbfe, rbct, ibds, ibhi, ibre, ibfe, ibct, rjds, rjhi, rjre, rjfe, ijds, ijhi, ijre, ijfe, pjds, pjhi, pjre, pjfe, sw, ledrev, ledinf, ledping, pa0, pa1, pa2, pa3, ca0, ca1, ca2, ca3, tptmr, tptime, tpchg, tpledtmr, tlooptmr, tlooptime, tpledhi, tpcyc, tneedrst, clk, loopled, loopout, time, df, fb, mixd, mixw, divt, pingt, lockpt, csr, inf, rev, tpq, tcq, plock, qmc, ale, s_am, s_sc, s_rj, s_ij, s_ldf, s_auq, s_xs, s_xr, s_wxs, s_wxr, pcu0, ppr0, ptr0, pde0, pmi0, pmr0, pmv0, pcu1, ppr1, ptr1, pde1, pmi1, pmr1, pmv1, pcu2, ppr2, ptr2, pde2, pmi2, pmr2, pmv2, pcu3, ppr3, ptr3, pde3, pmi3, pmr3, pmv3, ccu0, cpr0, cde0, ccu1, cpr1, cde1, ccu2, cpr2, cde2, ccu3, cpr3, cde3, igi, igr, ack, wmode, qcm, f_tc, f_ic, f_rc, f_tqc, f_iqc, f_rqc, f_scroll, f_clr, mboot, brd, bwr, frd, fwr, rfp, qdt, qrfe, wfp, wfs, drf, ls, le, am_s, am_f, am_l, am_ar, am_dr, ax_s, ax_f, ax_l, ax_ar, ax_dr, dcl, fill, ui, srate_i, inprev, outv, k_time, k_fb, k_df, k_mix, k_sw, b_rev, b_inf, j_rev, j_inf, x_sc, x_am, x_ldf, x_rjg, x_ijg, x_xf, cvd, c_dfd, c_dfl, c_dfi, c_df, c_tp, c_tc, c_tpq, c_tcq, c_sw, c_tm, c_mx) local(cur, prev, de, diff)
(
  cur = i == 0 ? ca0 : i == 1 ? ca1 : i == 2 ? ca2 : ca3;
  prev = i == 0 ? cpr0 : i == 1 ? cpr1 : i == 2 ? cpr2 : cpr3;
  de = i == 0 ? cde0 : i == 1 ? cde1 : i == 2 ? cde2 : cde3;
  diff = cur - prev;
  abs(diff) > 10 ? ( de = diff; prev = cur; );
  i == 0 ? ( ccu0 = cur; cpr0 = prev; cde0 = de; )
  : i == 1 ? ( ccu1 = cur; cpr1 = prev; cde1 = de; )
  : i == 2 ? ( ccu2 = cur; cpr2 = prev; cde2 = de; )
  : ( ccu3 = cur; cpr3 = prev; cde3 = de; );
);

