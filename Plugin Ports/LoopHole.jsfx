function dld_reset()
(
  memset(BUFA, 0, MSZ);
  memset(BUFB, 0, MSZ);
  chA.ch_init(BUFA);
  chB.ch_init(BUFB);
  chA.ch_set_samplerate(srate);
  chB.ch_set_samplerate(srate);
);

ext_noinit = gfx_ext_retina = 1;
EVO = alloc(1024);
EVN = alloc(1024);
EVV = alloc(1024);
g_qr = g_qw = 0;
tap_saved = 0;

@slider

last_srate != srate ? (
  last_srate = srate;
  dld_reset();
  last_pt = -1;
  tap_saved > 0 ? ( chA.ch_set_ping_time(tap_saved); chB.ch_set_ping_time(tap_saved); );
);

@block

chA.k_time = time_pos_val(a_time); chA.k_sw = floor(a_mult + 0.5); chA.k_fb = a_fb; chA.k_df = a_df; chA.k_mix = a_mix;
chB.k_time = time_pos_val(b_time); chB.k_sw = floor(b_mult + 0.5); chB.k_fb = b_fb; chB.k_df = b_df; chB.k_mix = b_mix;
chA.x_sc = a_sc >= 0.5; chA.x_am = a_am >= 0.5; chA.x_xf = max(0, min(6, floor(a_xf + 0.5))); chA.x_ldf = a_tap >= 0.5;
chA.x_rjg = a_revm >= 0.5; chA.x_ijg = a_holdm >= 0.5;
chB.x_sc = b_sc >= 0.5; chB.x_am = b_am >= 0.5; chB.x_xf = max(0, min(6, floor(b_xf + 0.5))); chB.x_ldf = b_tap >= 0.5;
chB.x_rjg = b_revm >= 0.5; chB.x_ijg = b_holdm >= 0.5;
chA.b_rev = g_reva; chA.b_inf = g_holda; chB.b_rev = g_revb; chB.b_inf = g_holdb;
pingb = g_ping;

sync >= 0.5 ? (
  pt = floor(((60 / max(1, tempo)) * srate) + 0.5);
  pt !== last_pt ? (
    chA.ch_set_ping_time(pt); chB.ch_set_ping_time(pt);
    last_pt = pt;
  );
) : last_pt = -1;

nev = 0;
while (midirecv(mofs, m1, m2, m3)) (
  qs = m1 & 0xF0;
  ((qs == 0x90 || qs == 0x80) && (m2 == 36 || m2 == 38 || m2 == 40 || m2 == 41) && nev < 1024) ? (
    EVO[nev] = mofs; EVN[nev] = m2; EVV[nev] = (qs == 0x90 && m3 > 0) ? 1 : 0;
    nev += 1;
  );
  midisend(mofs, m1, m2, m3);
);
evp = 0;
nexto = nev > 0 ? EVO[0] : -1;
sk = 0;

@sample

sk === nexto ? (
  while (evp < nev && EVO[evp] === sk) (
    EVN[evp] == 36 ? chA.j_rev = EVV[evp] : EVN[evp] == 38 ? chA.j_inf = EVV[evp] : EVN[evp] == 40 ? chB.j_rev = EVV[evp] : chB.j_inf = EVV[evp];
    evp += 1;
  );
  nexto = evp < nev ? EVO[evp] : -1;
);
va = spl0 * 10; vb = spl1 * 10;
oa = chA.ch_update(va, pingb);
ob = chB.ch_update(vb, pingb);
spl0 = oa / 8388607; spl1 = ob / 8388607;
sk += 1;

@serialize

file_avail(0) >= 0 ? (
  file_var(0, tap_saved);
  tap_saved > 0 ? ( chA.ch_set_ping_time(tap_saved); chB.ch_set_ping_time(tap_saved); );
) : (
  tap_saved = chA.tptime;
  file_var(0, tap_saved);
);

@gfx 760 494

UDW = 760;
UDH = 494;
uscale = max(0.5, min(gfx_w / UDW, gfx_h / UDH));
uox = floor((gfx_w - UDW * uscale) * 0.5);
uoy = 0;

function automate(s, e)
(
<?
  max_sliders > 23 ? printf("slider_automate(2^(s-1), e);") :
    printf("s == 1 ? slider_automate(sync, e) : s == 2 ? slider_automate(a_time, e) : s == 3 ? slider_automate(a_mult, e) : s == 4 ? slider_automate(a_fb, e) : s == 5 ? slider_automate(a_df, e) : s == 6 ? slider_automate(a_mix, e) : s == 7 ? slider_automate(b_time, e) : s == 8 ? slider_automate(b_mult, e) : s == 9 ? slider_automate(b_fb, e) : s == 10 ? slider_automate(b_df, e) : s == 11 ? slider_automate(b_mix, e) : s == 12 ? slider_automate(a_sc, e) : s == 13 ? slider_automate(b_sc, e) : s == 14 ? slider_automate(a_am, e) : s == 15 ? slider_automate(b_am, e) : s == 16 ? slider_automate(a_xf, e) : s == 17 ? slider_automate(b_xf, e) : s == 18 ? slider_automate(a_tap, e) : s == 19 ? slider_automate(b_tap, e) : s == 20 ? slider_automate(a_revm, e) : s == 21 ? slider_automate(a_holdm, e) : s == 22 ? slider_automate(b_revm, e) : s == 23 ? slider_automate(b_holdm, e) :");
?> 0;
);

function smax(s) ( (s == 2 || s == 7) ? 16 : (s == 3 || s == 8) ? 2 : (s == 16 || s == 17) ? 6 : 1; );
function sdef(s) ( (s == 2 || s == 7) ? 8 : (s == 3 || s == 8) ? 1 : (s == 4 || s == 9) ? 0.375 : (s == 5 || s == 10) ? 1 : (s == 6 || s == 11) ? 0.5 : (s == 16 || s == 17) ? 3 : s == 1 ? 1 : 0; );
function set_slider(s, x) ( slider(s) = x; automate(s, 0); automate(s, 1); );
function hit_circle(mx, my, cx, cy, rad) ( sqr(mx - cx) + sqr(my - cy) <= sqr(rad); );
function hit_rect(mx, my, x, y, w, h) ( mx >= x && mx <= x + w && my >= y && my <= y + h; );
function px(x) ( floor(uox + x * uscale + 0.5); );
function py(y) ( floor(uoy + y * uscale + 0.5); );
function pl(v) ( floor(v * uscale + 0.5); );
function set_norm(s, x) local(old, nv, mx)
(
  old = slider(s);
  mx = smax(s);
  nv = max(0, min(1, x));
  nv = mx > 1 ? floor(nv * mx + 0.5) : floor(nv * 1000 + 0.5) / 1000;
  slider(s) = nv;
  slider(s) !== old ? automate(s, 0);
);
function ctextm(str, cx, cy, fz, fl) local(tw, th)
(
  gfx_setfont(1, "Arial", floor(fz * uscale + 0.5), fl);
  gfx_measurestr(str, tw, th);
  gfx_x = floor(cx - tw * 0.5 + 0.5); gfx_y = floor(cy - th * 0.5 + 0.5);
  gfx_drawstr(str);
);
function ltext(str, x, y, fz, fl)
(
  gfx_setfont(1, "Arial", floor(fz * uscale + 0.5), fl);
  gfx_x = px(x); gfx_y = py(y);
  gfx_drawstr(str);
);

function pos_name(k)
(
  k = floor(k + 0.5);
  k == 1 ? "x1.5" : ( sprintf(#upn, "x%d", k == 0 ? 1 : k); #upn; );
);
function knob_name(s)
(
  (s == 2 || s == 7) ? "TIME" : (s == 4 || s == 9) ? "FEEDBACK" : (s == 5 || s == 10) ? "DELAY FEED" : "MIX";
);
function knob_value(s) local(x, dv, d)
(
  x = slider(s);
  (s == 2 || s == 7) ? (
    dv = s == 2 ? chA.divt : chB.divt;
    d = floor((s == 2 ? a_mult : b_mult) + 0.5);
    sprintf(#uval, "%s%s  %.2f s", pos_name(x), d == 2 ? " +16" : d == 0 ? " /8" : "", dv / srate);
  ) : (s == 4 || s == 9) ? sprintf(#uval, "%.0f%%", x * 110)
  : (s == 6 || s == 11) ? sprintf(#uval, "%.0f%% wet", x * 100)
  : sprintf(#uval, "%.0f%%", x * 100);
  #uval;
);
function hint_text(h)
(
  (h == 2 || h == 7) ? (
    strcpy(#uhint, h == 2 ? "A Time: " : "B Time: "); strcat(#uhint, knob_value(h));
    strcat(#uhint, "   (multiple of Ping; Shift-drag = unquantised, Alt-drag while held = loop end)");
  ) : (h >= 4 && h <= 6) || (h >= 9 && h <= 11) ? (
    strcpy(#uhint, h < 7 ? "A " : "B "); strcat(#uhint, knob_name(h)); strcat(#uhint, ":  "); strcat(#uhint, knob_value(h));
    (h == 4 || h == 9) ? strcat(#uhint, "   (Shift-drag while held = scroll the loop)") : strcat(#uhint, "   (drag or scroll, Ctrl = fine, double-click = default)");
  ) : (h == 3 || h == 8) ? strcpy(#uhint, "Time switch: +16 adds 16 to the multiple, /8 divides it by eight")
  : h == 1 ? strcpy(#uhint, "Sync: Ping = one quarter note at the project tempo. Off: tap the Ping button")
  : h == 30 ? strcpy(#uhint, sync >= 0.5 ? "Ping: following the project tempo (turn Sync off to tap)" : "Ping: tap twice or more to set the tempo")
  : h == 31 ? strcpy(#uhint, "Reverse: play the delay or loop backwards (MIDI: C2 for A, E2 for B)")
  : h == 32 ? strcpy(#uhint, "Hold: freeze the current loop, press again to release (MIDI: D2 for A, F2 for B)")
  : (h == 12 || h == 13) ? strcpy(#uhint, "Soft Clip: gentle limiting at the top of the range (Off = hard clip)")
  : (h == 14 || h == 15) ? strcpy(#uhint, "Auto Mute: silence the input below a low noise threshold")
  : (h == 16 || h == 17) ? strcpy(#uhint, "Crossfade: fade time when the read head jumps (time change, reverse, loop)")
  : (h == 18 || h == 19) ? strcpy(#uhint, "Delay Feed taper: Log or Lin response of the Delay Feed knob")
  : h >= 20 ? strcpy(#uhint, "MIDI Reverse/Hold notes: Trig toggles on each note, Gate toggles on note on and off")
  : strcpy(#uhint, "Two looping delays: A on the left, B on the right  ·  Hold to loop, Reverse to flip");
  #uhint;
);

function stripe(cx, y) local(w, h, g, x0)
(
  w = pl(13); h = max(2, pl(3)); g = pl(4);
  x0 = floor(px(cx) - (3 * w + 2 * g) * 0.5);
  gfx_set(0.91, 0.12, 0.15, 1); gfx_rect(x0, py(y), w, h, 1);
  gfx_set(0.15, 0.64, 0.88, 1); gfx_rect(x0 + w + g, py(y), w, h, 1);
  gfx_set(0.0, 0.62, 0.32, 1); gfx_rect(x0 + 2 * (w + g), py(y), w, h, 1);
);

function arcw(cx, cy, r, a0, a1, th) local(k, n)
(
  n = max(1, ceil(th * 2));
  k = 0;
  loop(n, gfx_arc(cx, cy, r - th * 0.5 + k * th / n, a0, a1, 1); k += 1; );
);

function lamp(x, y, on, cr, cg, cb)
(
  gfx_set(0.58, 0.58, 0.60, 1); gfx_circle(px(x), py(y), 4.6 * uscale, 1, 1);
  on ? gfx_set(cr, cg, cb, 1) : gfx_set(0.30, 0.31, 0.33, 1);
  gfx_circle(px(x), py(y), 3.4 * uscale, 1, 1);
);

function knob(s, x, y, rb0, cr, cg, cb) local(cx, cy, hov, kn, a, ca, sa, rb, ra, k, d, mx)
(
  cx = px(x); cy = py(y);
  mx = smax(s);
  hov = hit_circle(mouse_x, mouse_y, cx, cy, (rb0 + 9) * uscale);
  hov ? u_hov = s;
  (u_click && hov) ? (
    (u_ctarget == s && time_precise() - u_ctime < 0.3) ? (
      set_slider(s, sdef(s));
      u_drag = 0;
    ) : (
      u_drag = s; u_dy0 = mouse_y; u_dv0 = slider(s) / mx; u_dfine = mouse_cap & 4; u_dmod = mouse_cap & (8 | 16); u_dmoved = 0;
      automate(s, 0);
    );
    u_ctarget = s; u_ctime = time_precise();
    u_click = 0;
  );
  (hov && u_wheel != 0 && u_drag == 0) ? (
    mx > 1 ? set_norm(s, (slider(s) + (u_wheel > 0 ? 1 : -1)) / mx) : set_norm(s, slider(s) + (u_wheel / 120) * ((mouse_cap & 4) ? 0.004 : 0.02));
    automate(s, 1);
    u_wheel = 0;
  );
  kn = max(0, min(1, slider(s) / mx));
  ra = (rb0 + 6.5) * uscale; rb = rb0 * uscale;
  a = (-150 + 300 * kn) * $pi / 180;
  gfx_set(0.78, 0.78, 0.79, 1);
  arcw(cx, cy, ra, -150 * $pi / 180, 150 * $pi / 180, 3 * uscale);
  gfx_set(cr, cg, cb, 1);
  kn > 0.002 ? arcw(cx, cy, ra, -150 * $pi / 180, a, 3 * uscale);
  mx > 2 ? (
    gfx_set(0.55, 0.55, 0.57, 1);
    k = 0;
    loop(mx + 1,
      d = (-150 + 300 * k / mx) * $pi / 180;
      gfx_circle(cx + sin(d) * (ra + 5.5 * uscale), cy - cos(d) * (ra + 5.5 * uscale), 1.1 * uscale, 1, 1);
      k += 1;
    );
  );
  gfx_set(0.05, 0.05, 0.055, 1);
  gfx_circle(cx, cy, rb, 1, 1);
  gfx_set((hov || u_drag == s) ? 0.42 : 0.26, (hov || u_drag == s) ? 0.42 : 0.26, (hov || u_drag == s) ? 0.44 : 0.27, 1);
  gfx_circle(cx, cy, rb, 0, 1);
  ca = cos(a); sa = sin(a);
  gfx_set(0.98, 0.98, 0.98, 1);
  d = -1.2;
  loop(9,
    k = d * uscale;
    gfx_line(cx + sa * 6 * uscale + ca * k, cy - ca * 6 * uscale + sa * k, cx + sa * (rb - 3.5 * uscale) + ca * k, cy - ca * (rb - 3.5 * uscale) + sa * k, 1);
    d += 0.3;
  );
  gfx_set(0.09, 0.09, 0.10, 1);
  ctextm(knob_name(s), cx, py(y + rb0 + 19), 12, 'b');
  gfx_set(0.38, 0.39, 0.41, 1);
  ctextm(knob_value(s), cx, py(y + rb0 + 34), 11, 0);
);

function tswitch(s, x, y) local(i, on, hov, yy, lab)
(
  i = 0;
  loop(3,
    yy = y + (2 - i) * 22;
    on = floor(slider(s) + 0.5) == i;
    hov = hit_rect(mouse_x, mouse_y, px(x), py(yy), pl(40), pl(20));
    hov ? u_hov = s;
    (u_click && hov) ? ( !on ? set_slider(s, i); u_click = 0; );
    on ? gfx_set(0.15, 0.15, 0.16, 1) : gfx_set(hov ? 0.86 : 0.82, hov ? 0.86 : 0.82, hov ? 0.87 : 0.83, 1);
    gfx_roundrect(px(x), py(yy), pl(40), pl(20), pl(4), 1);
    gfx_rect(px(x) + 1, py(yy) + 1, pl(40) - 1, pl(20) - 1, 1);
    on ? gfx_set(0.97, 0.97, 0.98, 1) : gfx_set(0.30, 0.31, 0.33, 1);
    lab = i == 0 ? "/8" : i == 1 ? "x1" : "+16";
    ctextm(lab, px(x + 20), py(yy + 10), 11, 'b');
    i += 1;
  );
);

function button(id, x, y, lab, led, cr, cg, cb) local(cx, cy, r, hov, dn)
(
  cx = px(x); cy = py(y); r = 15 * uscale;
  hov = hit_circle(mouse_x, mouse_y, cx, cy, r + 3 * uscale);
  (hov && u_hov == 0) ? u_hov = (id == 0 ? 30 : (id == 1 || id == 4) ? 31 : 32);
  (u_click && hov) ? ( u_btn = id + 1; u_click = 0; );
  dn = u_btn == id + 1 && u_down;
  gfx_set(0.58, 0.58, 0.60, 1); gfx_circle(cx, cy, r + 2.5 * uscale, 1, 1);
  led ? gfx_set(cr, cg, cb, 1) : gfx_set(0.80, 0.80, 0.81, 1);
  gfx_circle(cx, cy, r + 1.2 * uscale, 1, 1);
  dn ? gfx_set(0.80, 0.81, 0.83, 1) : gfx_set(hov ? 1 : 0.975, hov ? 1 : 0.975, hov ? 1 : 0.98, 1);
  gfx_circle(cx, cy, r - 1.2 * uscale, 1, 1);
  gfx_set(0.09, 0.09, 0.10, 1);
  ctextm(lab, cx, py(y + 29), 12, 'b');
);

function chip(s, x, y, w, l0, l1) local(on, hov, X0, Y0, W0, H0, lab)
(
  X0 = px(x); Y0 = py(y); W0 = pl(w); H0 = pl(22);
  hov = hit_rect(mouse_x, mouse_y, X0, Y0, W0, H0);
  hov ? u_hov = s;
  (u_click && hov) ? (
    (s == 16 || s == 17) ? set_slider(s, (floor(slider(s) + 0.5) + ((mouse_cap & 2) ? 6 : 1)) % 7)
    : set_slider(s, slider(s) >= 0.5 ? 0 : 1);
    u_click = 0;
  );
  (u_rclick && hov) ? ( (s == 16 || s == 17) ? set_slider(s, (floor(slider(s) + 0.5) + 6) % 7); u_rclick = 0; );
  on = (s == 16 || s == 17) ? 1 : slider(s) < 0.5;
  gfx_set(0.06, 0.06, 0.07, 1);
  gfx_roundrect(X0 - 1, Y0 - 1, W0 + 2, H0 + 2, pl(4), 1);
  on ? gfx_set(hov ? 0.30 : 0.25, hov ? 0.30 : 0.25, hov ? 0.32 : 0.27, 1) : gfx_set(hov ? 0.24 : 0.19, hov ? 0.24 : 0.19, hov ? 0.26 : 0.21, 1);
  gfx_rect(X0 + 1, Y0 + 1, W0 - 2, H0 - 2, 1);
  (s == 16 || s == 17) ? (
    lab = floor(slider(s) + 0.5);
    lab = lab == 0 ? "1 ms" : lab == 1 ? "2 ms" : lab == 2 ? "4 ms" : lab == 3 ? "8 ms" : lab == 4 ? "25 ms" : lab == 5 ? "100 ms" : "250 ms";
    gfx_set(0.90, 0.91, 0.93, 1);
  ) : (
    lab = slider(s) < 0.5 ? l0 : l1;
    slider(s) < 0.5 ? gfx_set(0.15, 0.64, 0.88, 1) : gfx_set(0.70, 0.71, 0.74, 1);
  );
  ctextm(lab, X0 + W0 * 0.5, Y0 + H0 * 0.5, 11, 'b');
);

function seg(s, x, y, w, h, l0, l1) local(X0, Y0, W0, H0, i, on, hov, bx, bw)
(
  X0 = px(x); Y0 = py(y); W0 = pl(w); H0 = pl(h);
  gfx_set(0.06, 0.06, 0.07, 1);
  gfx_roundrect(X0 - 1, Y0 - 1, W0 + 2, H0 + 2, pl(5), 1);
  i = 0;
  loop(2,
    bx = X0 + floor(i * W0 * 0.5);
    bw = i == 0 ? floor(W0 * 0.5) : W0 - floor(W0 * 0.5);
    on = floor(slider(s) + 0.5) == i;
    hov = hit_rect(mouse_x, mouse_y, bx, Y0, bw, H0);
    hov ? u_hov = s;
    (u_click && hov) ? ( !on ? set_slider(s, i); u_click = 0; );
    on ? gfx_set(0.15, 0.64, 0.88, 1) : gfx_set(hov ? 0.27 : 0.21, hov ? 0.27 : 0.21, hov ? 0.29 : 0.23, 1);
    gfx_rect(bx + 1, Y0 + 1, bw - 2, H0 - 2, 1);
    on ? gfx_set(0.03, 0.06, 0.09, 1) : gfx_set(0.86, 0.87, 0.89, 1);
    ctextm(i == 0 ? l0 : l1, bx + bw * 0.5, Y0 + H0 * 0.5, 12, 'b');
    i += 1;
  );
);

function glabel(str, x, y)
(
  gfx_set(0.62, 0.64, 0.68, 1);
  ltext(str, x, y, 12, 'b');
);

u_down = mouse_cap & 1;
u_click = u_down && !u_pstate;
u_rclick = (mouse_cap & 2) && !u_prstate;
u_wheel = mouse_wheel;
mouse_wheel = 0;
u_hov = 0;

gfx_set(0.10, 0.10, 0.105, 1);
gfx_rect(0, 0, gfx_w, gfx_h, 1);

gfx_set(0.70, 0.70, 0.71, 1);
gfx_roundrect(px(12), py(12), pl(520), pl(442), pl(6), 1);
gfx_set(0.925, 0.925, 0.93, 1);
gfx_rect(px(12) + 1, py(12) + 1, pl(520) - 1, pl(442) - 1, 1);
stripe(272, 26);
gfx_set(0.09, 0.09, 0.10, 1);
ctextm("DUAL LOOPING DELAY", px(272), py(46), 16, 'b');
gfx_set(0.15, 0.64, 0.88, 1);
ctextm("A", px(34), py(36), 22, 'b');
gfx_set(0.0, 0.62, 0.32, 1);
ctextm("B", px(510), py(36), 22, 'b');

lamp(40, 76, chA.loopled, 0.91, 0.12, 0.15);
lamp(504, 76, chB.loopled, 0.91, 0.12, 0.15);
knob(2, 76, 118, 26, 0.15, 0.64, 0.88);
tswitch(3, 132, 86);
knob(7, 468, 118, 26, 0.0, 0.62, 0.32);
tswitch(8, 372, 86);

button(0, 272, 104, "PING", chB.ledping, 0.98, 0.62, 0.10);
gfx_set(0.38, 0.39, 0.41, 1);
sync >= 0.5 ? sprintf(#ups, "SYNC  %.1f BPM", tempo) : sprintf(#ups, "TAP  %.1f BPM", 60 * srate / max(1, chA.tptime));
ctextm(#ups, px(272), py(152), 11, 'b');

knob(4, 76, 252, 21, 0.15, 0.64, 0.88);
button(1, 160, 246, "REVERSE", chA.ledrev, 0.98, 0.62, 0.10);
button(2, 226, 268, "HOLD", chA.ledinf, 0.15, 0.64, 0.88);
button(3, 318, 268, "HOLD", chB.ledinf, 0.0, 0.62, 0.32);
button(4, 384, 246, "REVERSE", chB.ledrev, 0.98, 0.62, 0.10);
knob(9, 468, 252, 21, 0.0, 0.62, 0.32);

gfx_set(0.80, 0.80, 0.81, 1);
gfx_rect(px(30), py(326), pl(484), max(1, pl(1)), 1);
knob(5, 76, 376, 21, 0.15, 0.64, 0.88);
knob(6, 190, 376, 21, 0.15, 0.64, 0.88);
knob(11, 354, 376, 21, 0.0, 0.62, 0.32);
knob(10, 468, 376, 21, 0.0, 0.62, 0.32);

gfx_set(0.15, 0.155, 0.165, 1);
gfx_roundrect(px(542), py(12), pl(206), pl(442), pl(7), 1);
gfx_set(0.95, 0.95, 0.96, 1);
ltext("Loop Hole", 558, 28, 24, 'b');
gfx_set(0.15, 0.64, 0.88, 1);
ltext("4ms Dual Looping Delay", 559, 62, 12, 0);
gfx_set(0.62, 0.64, 0.68, 1);
ltext("by chmaha", 559, 79, 12, 0);
glabel("SYNC", 559, 110);
seg(1, 559, 128, 174, 28, "OFF", "ON");
gfx_set(0.62, 0.64, 0.68, 1);
ctextm("A", px(669), py(186), 12, 'b');
ctextm("B", px(721), py(186), 12, 'b');
glabel("SOFT CLIP", 559, 202);   chip(12, 646, 199, 46, "ON", "OFF"); chip(13, 698, 199, 46, "ON", "OFF");
glabel("AUTO MUTE", 559, 234);   chip(14, 646, 231, 46, "ON", "OFF"); chip(15, 698, 231, 46, "ON", "OFF");
glabel("CROSSFADE", 559, 266);   chip(16, 646, 263, 46, "", ""); chip(17, 698, 263, 46, "", "");
glabel("FEED TAPER", 559, 298);  chip(18, 646, 295, 46, "LOG", "LIN"); chip(19, 698, 295, 46, "LOG", "LIN");
glabel("MIDI REV", 559, 330);    chip(20, 646, 327, 46, "TRIG", "GATE"); chip(22, 698, 327, 46, "TRIG", "GATE");
glabel("MIDI HOLD", 559, 362);   chip(21, 646, 359, 46, "TRIG", "GATE"); chip(23, 698, 359, 46, "TRIG", "GATE");
gfx_set(0.56, 0.58, 0.62, 1);
ltext("MIDI   C2 Rev A  ·  D2 Hold A", 559, 396, 11, 0);
ltext("           E2 Rev B  ·  F2 Hold B", 559, 411, 11, 0);
ltext("4ms CoreModules  ·  GPLv3", 559, 432, 11, 0);

u_btn > 0 ? (
  u_down ? (
    u_btn == 1 ? ( sync < 0.5 ? g_ping = 1; )
    : u_btn == 2 ? g_reva = 1 : u_btn == 3 ? g_holda = 1 : u_btn == 4 ? g_holdb = 1 : g_revb = 1;
  ) : (
    g_ping = 0; g_reva = 0; g_holda = 0; g_holdb = 0; g_revb = 0;
    u_btn = 0;
  );
);

u_drag > 0 ? (
  u_down ? (
    mouse_cap |= 65536;
    u_fine = mouse_cap & 4;
    u_fine != u_dfine ? ( u_dy0 = mouse_y; u_dv0 = slider(u_drag) / smax(u_drag); u_dfine = u_fine; );
    abs(mouse_y - u_dy0) > 2 ? (
      !u_dmoved ? (
        u_dmoved = 1;
        (u_dmod & 8) && (u_drag == 2 || u_drag == 4) ? g_holda = 1;
        (u_dmod & 8) && (u_drag == 7 || u_drag == 9) ? g_holdb = 1;
        (u_dmod & 16) && u_drag == 2 && !g_holda ? g_reva = 1;
        (u_dmod & 16) && u_drag == 7 && !g_holdb ? g_revb = 1;
      );
      set_norm(u_drag, u_dv0 + (u_dy0 - mouse_y) / (150 * uscale) * (u_fine ? 0.1 : 1));
    );
  ) : (
    automate(u_drag, 1);
    u_dmod ? ( g_holda = 0; g_holdb = 0; g_reva = 0; g_revb = 0; );
    u_drag = 0;
  );
);

gfx_set(0.17, 0.17, 0.18, 1);
gfx_rect(px(0), py(464), pl(UDW), pl(30), 1);
gfx_setfont(1, "Arial", floor(13 * uscale + 0.5));
gfx_set(0.82, 0.83, 0.85, 1);
hint_text(u_drag > 0 ? u_drag : u_hov);
gfx_measurestr(#uhint, u_tw, u_th);
u_tw > (UDW - 20) * uscale ? ( gfx_setfont(1, "Arial", 13 * uscale * (UDW - 20) * uscale / u_tw); gfx_measurestr(#uhint, u_tw, u_th); );
gfx_x = floor(uox + (UDW * uscale - u_tw) * 0.5); gfx_y = floor(py(464) + (30 * uscale - u_th) * 0.5);
gfx_drawstr(#uhint);

u_pstate = u_down;
u_prstate = mouse_cap & 2;
