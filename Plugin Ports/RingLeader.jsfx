REVP = alloc(16);
REVS = alloc(16);
CHOR = alloc(8);
ENSR = alloc(8);
ONS = alloc(32);
MQ = alloc(2 * 64);
MBUF = alloc(4);
SCO = alloc(1024);
KEYF = alloc(128);

S_FREQ = 0; S_DISP = 1; S_BRIGHT = 2; S_DAMP = 3; S_POS = 4; S_DELAY = 5; S_CPOS = 6; S_PDISP = 7;
S_PDC = 8; S_ENDISP = 9; S_DNOISE = 10; S_SRC = 11; S_O0 = 12; S_O1 = 13; S_A0 = 14; S_A1 = 15;
S_CB = 16; S_WP = 17; S_WP2 = 18; S_FX1 = 19; S_FX2 = 20; S_FB = 21; S_FBI = 22; S_FD = 23; S_FDI = 24;
S_G = 25; S_DCX = 30; S_DCY = 31; S_DCP = 32;

R_WP = 0; R_LP1 = 1; R_LP2 = 2; R_LFO1 = 3; R_LFO2 = 7; R_AMT = 11; R_GAIN = 12; R_TIME = 13; R_DIFF = 14; R_LP = 15;

// ---------------------------------------------------------------------- tables

i = 0;
loop(5121, LSINE[i] = sin(2 * $pi * i / 4096); i += 1; );
i = 0;
loop(257,
  L4D[i] = 10 ^ (4 * i / 256);
  LSVF[i] = 2 * atan(1 / (2 ^ (i / 12))) / (2 * $pi);
  g = i / 256;
  g < 0.25 ? st = -(0.25 - g) * 0.25 :
  g < 0.3 ? st = 0 :
  g < 0.9 ? st = 0.01 * 10 ^ ((g - 0.3) / 0.6 * 2.005) - 0.01 : (
    g = (g - 0.9) / 0.1;
    g *= g;
    st = 1.5 - cos(g * $pi) / 2;
  );
  LSTIFF[i] = st;
  PRH[i] = 2 ^ ((i - 128) / 12);
  PRL[i] = 2 ^ (i / 256 / 12);
  i += 1;
);
LSTIFF[255] = 2;
LSTIFF[256] = 2;

function tset(a, b, c, d, e, f, g, h) ( TP[0] = a; TP[1] = b; TP[2] = c; TP[3] = d; TP[4] = e; TP[5] = f; TP[6] = g; TP[7] = h; TP += 8; );

TP = LFMQ;
tset(-12, -12, -12, -11.84, -11.84, -11.84, -11.11, -10.38);
