  );
);
function ev_fill(v, o) local(b, lo)
(
  b = GB + (v * MAXB);
  memset(b + o, AG[v], samplesblock - o);
  lo = ALOW[v] - gsamp;
  (lo >= o && lo < samplesblock) ? b[lo] = 0;
);
function ev_mark(v, o, cv, vel) local(n)
(
  n = VEN[v];
  n < 255 ? (
    VEO[(v * 256) + n] = o; VECV[(v * 256) + n] = cv; VEVL[(v * 256) + n] = vel;
    VEN[v] = n + 1;
  );
);
function ev_on(nt, vel, o) local(v, i, best, t)
(
  t = gsamp + o;
  v = -1;
  i = 0;
  loop(NV, (v < 0 && AN[i] == nt) ? v = i; i += 1; );
  v < 0 ? (
    i = 0;
    loop(NV, (!AG[i] && (v < 0 || AOFF[i] < best)) ? ( v = i; best = AOFF[i]; ); i += 1; );
  );
  v < 0 ? (
    i = 0;
    loop(NV, (v < 0 || AON[i] < best) ? ( v = i; best = AON[i]; ); i += 1; );
  );
  ev_prep(v);
  ev_touch(v, t, o);
  AGP[v] ? ALOW[v] = t;
  AG[v] = 1; AN[v] = nt; AVEL[v] = vel;
  astamp += 1; AON[v] = astamp;
  ev_fill(v, o);
  ev_mark(v, o, (nt - 60) / 12, vel);
);
function ev_off(nt, o) local(v, t)
(
  t = gsamp + o;
  v = 0;
  loop(NV,
    (AN[v] == nt && AG[v]) ? (
      ev_prep(v);
      ev_touch(v, t, o);
      AG[v] = 0;
      astamp += 1; AOFF[v] = astamp;
      ev_fill(v, o);
      ev_mark(v, o, -1000, -1);
    );
    v += 1;
  );
);
function ev_alloff(o) local(v, t)
(
  t = gsamp + o;
  v = 0;
  loop(NV,
    AG[v] ? (
      ev_prep(v);
      ev_touch(v, t, o);
      AG[v] = 0;
      astamp += 1; AOFF[v] = astamp;
      ev_fill(v, o);
      ev_mark(v, o, -1000, -1);
    );
    v += 1;
  );
);

function note_on(nt, vel, o)
(
  dkt ? ev_on(nt, vel, o) : (
    !MKEY[nt] ? ( MKEY[nt] = 1; mono_n += 1; );
    ev_on(60, vel, o);
  );
);
function note_off(nt, o)
(
  dkt ? ev_off(nt, o) : (
    MKEY[nt] ? (
      MKEY[nt] = 0; mono_n -= 1;
      mono_n <= 0 ? ( mono_n = 0; ev_off(60, o); );
    );
  );
);

function engine_reset()
(
  alloc_reset();
  drum_reset();
  dj_reset();
  dj_init_coef();
  mono_n = 0;
  memset(MKEY, 0, 128);
  gsamp = 0;
);

g_qr = g_qw = 0;

@slider

last_srate != srate ? (
  last_srate = srate;
  engine_reset();
  c_eng = engine >= 0.5;
);

@block

eng = engine >= 0.5;
eng !== c_eng ? (
  c_eng = eng;
  alloc_reset();
  drum_reset();
  dj_reset();
  mono_n = 0;
  memset(MKEY, 0, 128);
);
dkt = keytrack >= 0.5;
dkt !== c_dkt ? (
  c_dkt = dkt;
  ev_alloff(0);
  mono_n = 0;
  memset(MKEY, 0, 128);
);
memset(HASEV, 0, NV);
memset(VEN, 0, NV);
memset(OB, 0, samplesblock);
while (g_qr != g_qw) (
  qs = GQ[g_qr * 4];
  qs == 144 ? note_on(GQ[g_qr * 4 + 1], GQ[g_qr * 4 + 2], 0) : note_off(GQ[g_qr * 4 + 1], 0);
  g_qr = (g_qr + 1) % 64;
);
while (midirecv(mofs, m1, m2, m3)) (
  qs = m1 & 0xF0;
  (qs == 0x90 && m3 > 0) ? note_on(m2, m3, mofs)
  : (qs == 0x80 || qs == 0x90) ? note_off(m2, mofs)
  : (qs == 0xB0 && (m2 == 120 || m2 == 123)) ? ( ev_alloff(mofs); mono_n = 0; memset(MKEY, 0, 128); );
  midisend(mofs, m1, m2, m3);
);
c_eng == 0 ? (
  drum_params();
  v = 0;
  loop(NV, drum_voice(v); v += 1; );
) : (
  dj_params();
  dj_strike(samplesblock);
  v = 0;
  loop(NV, dj_voice(v); v += 1; );
);
v = 0;
loop(NV,
  LASTG[v] = HASEV[v] ? GB[(v * MAXB) + samplesblock - 1] : AG[v];
  v += 1;
);
gsamp += samplesblock;
sk = 0;

@sample

spl0 = spl1 = OB[sk];
sk += 1;

@gfx 696 554

UDW = 696;
UDH = 554;
uscale = max(0.5, min(gfx_w / UDW, gfx_h / UDH));
uox = floor((gfx_w - UDW * uscale) * 0.5);
uoy = 0;

function automate(s, e)
(
<?
  max_sliders > 16 ? printf("slider_automate(2^(s-1), e);") :
    printf("s == 1 ? slider_automate(engine, e) : s == 2 ? slider_automate(d_pitch, e) : s == 3 ? slider_automate(d_penv, e) : s == 4 ? slider_automate(d_pamt, e) : s == 5 ? slider_automate(d_ratio, e) : s == 6 ? slider_automate(d_fmenv, e) : s == 7 ? slider_automate(d_fmamt, e) : s == 8 ? slider_automate(d_tenv, e) : s == 9 ? slider_automate(d_nenv, e) : s == 10 ? slider_automate(d_nblend, e) : s == 11 ? slider_automate(j_pitch, e) : s == 12 ? slider_automate(j_sharp, e) : s == 13 ? slider_automate(j_hit, e) : s == 14 ? slider_automate(j_strike, e) : s == 15 ? slider_automate(keytrack, e) : s == 16 ? slider_automate(velo, e) :");
?> 0;
);

function sdef(s) ( (s == 2 || s == 3 || s == 6 || s == 8 || s == 11) ? 0.25 : s == 5 ? 0.5 : s >= 12 ? 0.5 : 0; );
function set_slider(s, x) ( slider(s) = x; automate(s, 0); automate(s, 1); );
function hit_circle(mx, my, cx, cy, rad) ( sqr(mx - cx) + sqr(my - cy) <= sqr(rad); );
function hit_rect(mx, my, x, y, w, h) ( mx >= x && mx <= x + w && my >= y && my <= y + h; );
function px(x) ( floor(uox + x * uscale + 0.5); );
function py(y) ( floor(uoy + y * uscale + 0.5); );
function pl(v) ( floor(v * uscale + 0.5); );
function set_norm(s, x) local(old, kn)
(
  old = slider(s);
  kn = floor(max(0, min(1, x)) * 1000 + 0.5) / 1000;
  slider(s) = kn;
  slider(s) !== old ? automate(s, 0);
);
function ctextm(str, cx, cy, fz, fl) local(tw, th)
(
  gfx_setfont(1, "Arial", floor(fz * uscale + 0.5), fl);
  gfx_measurestr(str, tw, th);
  gfx_x = floor(cx - tw * 0.5 + 0.5); gfx_y = floor(cy - th * 0.5 + 0.5);
  gfx_drawstr(str);
);
function ltext(str, x, y, fz, fl)
(
  gfx_setfont(1, "Arial", floor(fz * uscale + 0.5), fl);
  gfx_x = px(x); gfx_y = py(y);
  gfx_drawstr(str);
);

function knob_name(s)
(
  s == 2 ? "PITCH" : s == 3 ? "PITCH ENV" : s == 4 ? "PITCH AMT" : s == 5 ? "RATIO" : s == 6 ? "FM ENV" : s == 7 ? "FM AMT" :
  s == 8 ? "TONE ENV" : s == 9 ? "NOISE ENV" : s == 10 ? "NOISE BLEND" : s == 11 ? "PITCH" : s == 12 ? "SHARPNESS" :
  s == 13 ? "HIT" : "STRIKE AMT";
);
function knob_long(s)
(
  s == 2 ? "Drum Pitch" : s == 3 ? "Drum Pitch Env" : s == 4 ? "Drum Pitch Amount" : s == 5 ? "Drum FM Ratio" :
  s == 6 ? "Drum FM Env" : s == 7 ? "Drum FM Amount" : s == 8 ? "Drum Tone Env" : s == 9 ? "Drum Noise Env" :
  s == 10 ? "Drum Noise Blend" : s == 11 ? "Djembe Pitch" : s == 12 ? "Djembe Sharpness" : s == 13 ? "Djembe Hit" : "Djembe Strike Amount";
);
function knob_value(s) local(x)
(
  x = slider(s);
  s == 2 ? sprintf(#uval, "%.1f Hz", 10 + x * 990)
  : s == 3 ? sprintf(#uval, "%.0f ms", 10 + x * 490)
  : s == 5 ? sprintf(#uval, "%.2f", 1 + x * 15)
  : s == 6 ? sprintf(#uval, "%.0f ms", 10 + x * 7990)
  : s == 8 ? sprintf(#uval, "%.0f ms", 10 + x * 590)
  : s == 9 ? sprintf(#uval, "%.0f ms", 100 + x * 2900)
  : s == 11 ? sprintf(#uval, "%.1f Hz", 20 + x * 480)
  : sprintf(#uval, "%.0f%%", x * 100);
  #uval;
);
function hint_text(h)
(
  h >= 2 && h <= 14 ? (
    strcpy(#uhint, knob_long(h)); strcat(#uhint, ":  "); strcat(#uhint, knob_value(h));
    strcat(#uhint, "     (drag or scroll, Ctrl = fine, double-click = default)");
  ) : h == 1 ? strcpy(#uhint, "Engine: the 4ms Drum (FM drum voice) or the 4ms Djembe (modal hand drum)")
  : h == 15 ? strcpy(#uhint, "Key Track: notes set the pitch (middle C = Pitch knob, Djembe only goes up) with 4 voices. Off: one voice, every note re-strikes it")
  : h == 16 ? strcpy(#uhint, "Velocity: scale each hit's level by velocity. Off = every hit at the module's own level")
  : h == 20 ? strcpy(#uhint, "Trigger: hit the drum at the Pitch knob (middle C). Hold to hold the gate. MIDI notes do the same")
  : h == 21 ? strcpy(#uhint, "Click the panel to switch to this engine")
  : strcpy(#uhint, "Play MIDI notes or click Trigger  ·  holding a note holds the gate  ·  Key Track on = four voices");
  #uhint;
);

function stripe(cx, y) local(w, h, g, x0)
(
  w = pl(13); h = max(2, pl(3)); g = pl(4);
  x0 = floor(px(cx) - (3 * w + 2 * g) * 0.5);
  gfx_set(0.91, 0.12, 0.15, 1); gfx_rect(x0, py(y), w, h, 1);
  gfx_set(0.15, 0.64, 0.88, 1); gfx_rect(x0 + w + g, py(y), w, h, 1);
  gfx_set(0.0, 0.62, 0.32, 1); gfx_rect(x0 + 2 * (w + g), py(y), w, h, 1);
);

function panel(x, y, w, h, title)
(
  gfx_set(0.70, 0.70, 0.71, 1);
  gfx_roundrect(px(x), py(y), pl(w), pl(h), pl(6), 1);
  gfx_set(0.925, 0.925, 0.93, 1);
  gfx_rect(px(x) + 1, py(y) + 1, pl(w) - 1, pl(h) - 1, 1);
  stripe(x + w * 0.5, y + 16);
  gfx_set(0.09, 0.09, 0.10, 1);
  ctextm(title, px(x + w * 0.5), py(y + 36), 17, 'b');
);

function arcw(cx, cy, r, a0, a1, th) local(k, n)
(
  n = max(1, ceil(th * 2));
  k = 0;
  loop(n, gfx_arc(cx, cy, r - th * 0.5 + k * th / n, a0, a1, 1); k += 1; );
);

function knob(s, x, y, cr, cg, cb) local(cx, cy, hov, kn, a, ca, sa, rb, ra, k, d)
(
  cx = px(x); cy = py(y);
  hov = hit_circle(mouse_x, mouse_y, cx, cy, pl(30));
  hov ? u_hov = s;
  (u_click && hov) ? (
    (u_ctarget == s && time_precise() - u_ctime < 0.3) ? (
      set_slider(s, sdef(s));
      u_drag = 0;
    ) : (
      u_drag = s; u_dy0 = mouse_y; u_dv0 = slider(s); u_dfine = mouse_cap & 4;
      automate(s, 0);
    );
    u_ctarget = s; u_ctime = time_precise();
    u_click = 0;
  );
  (hov && u_wheel != 0 && u_drag == 0) ? (
    set_norm(s, slider(s) + (u_wheel / 120) * ((mouse_cap & 4) ? 0.004 : 0.02));
    automate(s, 1);
    u_wheel = 0;
  );
  kn = max(0, min(1, slider(s)));
  ra = 27.5 * uscale; rb = 21 * uscale;
  a = (-150 + 300 * kn) * $pi / 180;
  gfx_set(0.78, 0.78, 0.79, 1);
  arcw(cx, cy, ra, -150 * $pi / 180, 150 * $pi / 180, 3 * uscale);
  gfx_set(cr, cg, cb, 1);
  kn > 0.002 ? arcw(cx, cy, ra, -150 * $pi / 180, a, 3 * uscale);
  gfx_set(0.05, 0.05, 0.055, 1);
  gfx_circle(cx, cy, rb, 1, 1);
  gfx_set((hov || u_drag == s) ? 0.42 : 0.26, (hov || u_drag == s) ? 0.42 : 0.26, (hov || u_drag == s) ? 0.44 : 0.27, 1);
  gfx_circle(cx, cy, rb, 0, 1);
  ca = cos(a); sa = sin(a);
  gfx_set(0.98, 0.98, 0.98, 1);
  d = -1.2;
  loop(9,
    k = d * uscale;
    gfx_line(cx + sa * 6 * uscale + ca * k, cy - ca * 6 * uscale + sa * k, cx + sa * (rb - 3.5 * uscale) + ca * k, cy - ca * (rb - 3.5 * uscale) + sa * k, 1);
    d += 0.3;
  );
  gfx_set(0.09, 0.09, 0.10, 1);
  ctextm(knob_name(s), cx, py(y + 40), 12, 'b');
  gfx_set(0.38, 0.39, 0.41, 1);
  ctextm(knob_value(s), cx, py(y + 55), 11, 0);
);

function pad(eng, x, y, cr, cg, cb) local(cx, cy, hov, r, on)
(
  cx = px(x); cy = py(y); r = 26 * uscale;
  hov = hit_circle(mouse_x, mouse_y, cx, cy, r + 2 * uscale);
  hov ? u_hov = 20;
  (u_click && hov) ? (
    floor(engine + 0.5) != eng ? set_slider(1, eng);
    GQ[g_qw * 4] = 144; GQ[g_qw * 4 + 1] = 60; GQ[g_qw * 4 + 2] = 100; GQ[g_qw * 4 + 3] = 0;
    g_qw = (g_qw + 1) % 64;
    u_pad = eng + 1;
    u_click = 0;
  );
  on = u_pad == eng + 1;
  gfx_set(0.60, 0.60, 0.62, 1); gfx_circle(cx, cy, r, 1, 1);
  on ? gfx_set(0.80, 0.81, 0.83, 1) : gfx_set(hov ? 1 : 0.975, hov ? 1 : 0.975, hov ? 1 : 0.98, 1);
  gfx_circle(cx, cy, r - 1.5 * uscale, 1, 1);
  gfx_set(cr, cg, cb, on ? 1 : 0.22);
  gfx_circle(cx, cy, 5 * uscale, 1, 1);
  gfx_set(0.09, 0.09, 0.10, 1);
  ctextm("TRIGGER", cx, py(y + 39), 12, 'b');
);

function seg(s, x, y, w, h, l0, l1) local(X0, Y0, W0, H0, i, on, hov, bx, bw)
(
  X0 = px(x); Y0 = py(y); W0 = pl(w); H0 = pl(h);
  gfx_set(0.06, 0.06, 0.07, 1);
  gfx_roundrect(X0 - 1, Y0 - 1, W0 + 2, H0 + 2, pl(5), 1);
  i = 0;
  loop(2,
    bx = X0 + floor(i * W0 * 0.5);
    bw = i == 0 ? floor(W0 * 0.5) : W0 - floor(W0 * 0.5);
    on = floor(slider(s) + 0.5) == i;
    hov = hit_rect(mouse_x, mouse_y, bx, Y0, bw, H0);
    hov ? u_hov = s;
    (u_click && hov) ? ( !on ? set_slider(s, i); u_click = 0; );
    on ? gfx_set(0.15, 0.64, 0.88, 1) : gfx_set(hov ? 0.27 : 0.21, hov ? 0.27 : 0.21, hov ? 0.29 : 0.23, 1);
    gfx_rect(bx + 1, Y0 + 1, bw - 2, H0 - 2, 1);
    on ? gfx_set(0.03, 0.06, 0.09, 1) : gfx_set(0.86, 0.87, 0.89, 1);
    ctextm(i == 0 ? l0 : l1, bx + bw * 0.5, Y0 + H0 * 0.5, 12, 'b');
    i += 1;
  );
);

function glabel(str, x, y)
(
  gfx_set(0.62, 0.64, 0.68, 1);
  ltext(str, x, y, 12, 'b');
);

function dim(x, y, w, h, tgt)
(
  gfx_set(0.10, 0.10, 0.105, 0.55);
  gfx_rect(px(x), py(y), pl(w), pl(h), 1);
  (u_click && hit_rect(mouse_x, mouse_y, px(x), py(y), pl(w), pl(h))) ? ( set_slider(1, tgt); u_click = 0; );
  (hit_rect(mouse_x, mouse_y, px(x), py(y), pl(w), pl(h)) && u_hov == 0) ? u_hov = 21;
);

u_down = mouse_cap & 1;
u_click = u_down && !u_pstate;
u_wheel = mouse_wheel;
mouse_wheel = 0;
u_hov = 0;
u_eng = floor(engine + 0.5);

gfx_set(0.10, 0.10, 0.105, 1);
gfx_rect(0, 0, gfx_w, gfx_h, 1);

panel(12, 12, 306, 500, "DRUM");
knob(2, 65, 100, 0.15, 0.64, 0.88); knob(3, 165, 100, 0.15, 0.64, 0.88); knob(4, 265, 100, 0.15, 0.64, 0.88);
knob(5, 65, 214, 0.15, 0.64, 0.88); knob(6, 165, 214, 0.15, 0.64, 0.88); knob(7, 265, 214, 0.15, 0.64, 0.88);
knob(8, 65, 328, 0.15, 0.64, 0.88); knob(9, 165, 328, 0.15, 0.64, 0.88); knob(10, 265, 328, 0.15, 0.64, 0.88);
gfx_set(0.80, 0.80, 0.81, 1);
gfx_rect(px(30), py(406), pl(270), max(1, pl(1)), 1);
pad(0, 165, 448, 0.15, 0.64, 0.88);

panel(328, 12, 176, 500, "DJEMBE");
knob(11, 372, 100, 0.0, 0.62, 0.32); knob(12, 460, 100, 0.0, 0.62, 0.32);
knob(13, 372, 214, 0.0, 0.62, 0.32); knob(14, 460, 214, 0.0, 0.62, 0.32);
gfx_set(0.80, 0.80, 0.81, 1);
gfx_rect(px(346), py(406), pl(140), max(1, pl(1)), 1);
pad(1, 416, 448, 0.0, 0.62, 0.32);

u_eng == 0 ? dim(328, 12, 176, 500, 1) : dim(12, 12, 306, 500, 0);

gfx_set(0.15, 0.155, 0.165, 1);
gfx_roundrect(px(514), py(12), pl(170), pl(500), pl(7), 1);
gfx_set(0.95, 0.95, 0.96, 1);
ltext("Skin in", 530, 28, 24, 'b');
ltext("the Game", 530, 56, 24, 'b');
gfx_set(0.15, 0.64, 0.88, 1);
ltext("4ms Drum + Djembe", 531, 92, 12, 0);
gfx_set(0.62, 0.64, 0.68, 1);
ltext("by chmaha", 531, 109, 12, 0);

glabel("ENGINE", 531, 150);
seg(1, 531, 168, 137, 28, "DRUM", "DJEMBE");
glabel("KEY TRACK", 531, 222);
seg(15, 531, 240, 137, 28, "OFF", "ON");
glabel("VELOCITY", 531, 294);
seg(16, 531, 312, 137, 28, "OFF", "ON");
gfx_set(0.56, 0.58, 0.62, 1);
ltext("Ported from 4ms", 531, 466, 11, 0);
ltext("CoreModules (GPLv3)", 531, 481, 11, 0);

(u_pad && !u_down) ? (
  GQ[g_qw * 4] = 128; GQ[g_qw * 4 + 1] = 60; GQ[g_qw * 4 + 2] = 0; GQ[g_qw * 4 + 3] = 0;
  g_qw = (g_qw + 1) % 64;
  u_pad = 0;
);

u_drag > 0 ? (
  u_down ? (
    mouse_cap |= 65536;
    u_fine = mouse_cap & 4;
    u_fine != u_dfine ? ( u_dy0 = mouse_y; u_dv0 = slider(u_drag); u_dfine = u_fine; );
    set_norm(u_drag, u_dv0 + (u_dy0 - mouse_y) / (150 * uscale) * (u_fine ? 0.1 : 1));
  ) : ( automate(u_drag, 1); u_drag = 0; );
);

gfx_set(0.17, 0.17, 0.18, 1);
gfx_rect(px(0), py(524), pl(UDW), pl(30), 1);
gfx_setfont(1, "Arial", floor(13 * uscale + 0.5));
gfx_set(0.82, 0.83, 0.85, 1);
hint_text(u_drag > 0 ? u_drag : u_hov);
gfx_measurestr(#uhint, u_tw, u_th);
u_tw > (UDW - 20) * uscale ? ( gfx_setfont(1, "Arial", 13 * uscale * (UDW - 20) * uscale / u_tw); gfx_measurestr(#uhint, u_tw, u_th); );
gfx_x = floor(uox + (UDW * uscale - u_tw) * 0.5); gfx_y = floor(py(524) + (30 * uscale - u_th) * 0.5);
gfx_drawstr(#uhint);

u_pstate = u_down;
