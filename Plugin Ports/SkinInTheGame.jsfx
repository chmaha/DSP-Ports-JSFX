desc: Skin in the Game (4ms Drum + Djembe port) by chmaha
tags: instrument drum percussion synthesizer
author: chmaha
version: 1.0
changelog:
  Initial preview.
about:
  Two 4ms drum voices in one plugin. Drum is a two-operator FM drum with pitch, FM, tone and noise envelopes;
  Djembe is a 20-mode resonant hand drum struck by filtered noise. Up to four voices.
  Any MIDI note strikes the drum and holding the note holds the gate (the Drum's envelopes sustain while held).
  Key Track lets the note set the pitch, with middle C (note 60) playing the Pitch knob, as 0 V on a 1 V/oct input.
  Velocity scales each hit's level; with it off every hit plays at the module's own level.
  Ported from the 4ms Drum and Djembe modules of 4ms CoreModules (MetaModule / VCV Rack, 4ms Company,
  https://github.com/4ms/metamodule-core-modules, GPLv3+). The Djembe engine was generated by 4ms from
  Faust's pm.djembe (Romain Michon, physmodels.lib).
  JSFX version released under GPLv3+ license
  Claude generated some of this code

slider1:engine=0<0,1,1{Drum,Djembe}>-Engine
slider2:d_pitch=0.25<0,1,0.001>-Drum Pitch
slider3:d_penv=0.25<0,1,0.001>-Drum Pitch Env
slider4:d_pamt=0<0,1,0.001>-Drum Pitch Amount
slider5:d_ratio=0.5<0,1,0.001>-Drum FM Ratio
slider6:d_fmenv=0.25<0,1,0.001>-Drum FM Env
slider7:d_fmamt=0<0,1,0.001>-Drum FM Amount
slider8:d_tenv=0.25<0,1,0.001>-Drum Tone Env
slider9:d_nenv=0<0,1,0.001>-Drum Noise Env
slider10:d_nblend=0<0,1,0.001>-Drum Noise Blend
slider11:j_pitch=0.25<0,1,0.001>-Djembe Pitch
slider12:j_sharp=0.5<0,1,0.001>-Djembe Sharpness
slider13:j_hit=0.5<0,1,0.001>-Djembe Hit
slider14:j_strike=0.5<0,1,0.001>-Djembe Strike Amount
slider15:keytrack=0<0,1,1{Off,On}>-Key Track
slider16:velo=0<0,1,1{Off,On}>-Velocity

in_pin:none
out_pin:Left output
out_pin:Right output
options:no_meter

@init

function f32k(x) local(c) ( c = x * 536870913; c - (c - x); );
function alloc(n) local(r) instance(mp) global() ( r = mp; mp += n; memset(r, 0, n); r; );

TWO32 = 4294967296;
NV = 4;
MAXB = 65536;
fixq = 1;

alloc.mp = 0;
SIN = alloc(2048);
TAN = alloc(2048);
EXP5 = alloc(2048);
POW9 = alloc(2048);
GQ = alloc(256);
OB = alloc(MAXB);
NB = alloc(MAXB);
GB = alloc(NV * MAXB);
VEO = alloc(NV * 256);
VECV = alloc(NV * 256);
VEVL = alloc(NV * 256);
VEN = alloc(NV);
HASEV = alloc(NV);
AN = alloc(NV);
AG = alloc(NV);
AVEL = alloc(NV);
ALOW = alloc(NV);
ALT = alloc(NV);
AON = alloc(NV);
AOFF = alloc(NV);
AGP = alloc(NV);
LASTG = alloc(NV);
VCV = alloc(NV);
VGN = alloc(NV);
JA = alloc(32);
JC = alloc(32);
DV = alloc(NV * 64);
JV = alloc(NV * 128);
JSL = alloc(NV * 20);
ISC = alloc(20);
ICN = alloc(20);
MKEY = alloc(128);

function tdec_start(tb) ( td_t = tb; td_i = 0; td_v = 0; td_d = 0; );
function tdec(s) local(i, n, c, neg, acc, ind)
(
  i = 0; n = strlen(s); acc = 0; neg = 0; ind = 0;
  while (i <= n) (
    c = i < n ? str_getchar(s, i) : 44;
    c == 45 ? neg = 1
    : c == 44 ? (
      ind ? (
        neg ? acc = -acc;
        td_i == 0 ? ( td_v = acc; td_d = 0; )
        : td_i == 1 ? ( td_d = acc; td_v += td_d; )
        : ( td_d += acc; td_v += td_d; );
        td_t[td_i] = f32k(td_v / 1000000);
        td_i += 1;
      );
      acc = 0; neg = 0; ind = 0;
    ) : (
      acc = (acc * 10) + (c - 48); ind = 1;
    );
    i += 1;
  );
);
tdec_start(SIN);
