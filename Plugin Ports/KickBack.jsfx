function km_voice(id, v) local(t, tu, dc, y, f, tq, s, tail, env, n, jingle, rate, len, click, tick, guiro, pulse) (
  t = v[6];
  tu = v[2];
  dc = v[3];
  y = 0;
  km_life = 1;
  id == 0 ? (
    f = (62.5 * tu) * (1 + 0.6 * exp((-t) / 0.002));
