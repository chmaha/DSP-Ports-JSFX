  sum;
);

function kc_valid(p) ( p >= 0 && (p < KC_NF || (p < KC_NF + 8 && UPRES[p - KC_NF])); );
function kc_skip(p) ( PN[p] == 12 ? (PS[p] == 3 ? 34952 : 816) : 0; );

function kc_fire(si, step) local(cyc, c, k, p, own, rank, q, ow, idx, j, slot, vel, vc, ki) (
  cyc = floor(step / kc_np);
  c = PLAY[step - cyc * kc_np];
  ki = 2 - kit;
  k = 0;
  loop(2,
    p = k ? kc_p2 : kc_p1;
    (k ? kc_a2 : kc_a1) ? (
      own = k ? kc_o2 : kc_o1;
      rank = 0;
      q = 0;
      loop(c, rank += ((own >> q) & 1) ? 0 : 1; q += 1;);
      ow = own == 0 ? 16 : 12;
      idx = (cyc * ow + rank) % PN[p];
      j = 0;
      loop(PC[p],
        slot = PL[p * 16 + j];
        vel = PV[(p * 15 + slot) * 32 + idx];
        vel > 0 ? (
          vc = ki == 0 ? MZSLOT[slot] : (ki == 1 ? K78SLOT[slot] : KMPSLOT[slot]);
          vc >= 0 && mout ? (
            midisend(si, 0x99, LNOTE[slot], vel >= 1 ? 127 : (vel > 0.6 ? 95 : 57));
            kc_non < 256 ? ( NOQ[kc_non * 2] = LNOTE[slot]; NOQ[kc_non * 2 + 1] = si + floor(kc_half); kc_non += 1; );
          );
          vc >= 0 && kc_nh < 64 ? (
            HQ[kc_nh * 4] = si;
            HQ[kc_nh * 4 + 1] = vc;
            HQ[kc_nh * 4 + 2] = vel < 1 ? vel : (0.75 + (0.5 * km_acc));
            HQ[kc_nh * 4 + 3] = vel >= 1;
            kc_nh += 1;
          );
        );
        j += 1;
      );
    );
    k += 1;
  );
);

function kc_noteoffs() local(i) (
  i = 0;
  while (i < kc_non) (
    NOQ[i * 2 + 1] < samplesblock ? (
      midisend(max(0, NOQ[i * 2 + 1]), 0x89, NOQ[i * 2], 0);
      kc_non -= 1;
      NOQ[i * 2] = NOQ[kc_non * 2];
      NOQ[i * 2 + 1] = NOQ[kc_non * 2 + 1];
    ) : (
      NOQ[i * 2 + 1] -= samplesblock;
      i += 1;
    );
  );
);

function kc_block() local(kp, kq, spb, c, sps, hp, sw, si, nx, thr, mode, own1) (
  kc_noteoffs();
  play_state !== 0 ? prev_on = 0;
  prev_req ? (
    prev_req = 0;
    play_state === 0 ? prev_on = prev_req_on;
  );
  mode = (play_state & 1) ? (seq_on ? 1 : 0) : (prev_on ? 2 : 0);
  kp = pat - 1;
  kq = pat2 - 1;
  kp != kc_p1 || kq != kc_p2 || (mode == 2 && kc_mode != 2) ? (
    kc_p1 = kp;
    kc_p2 = kq;
    kc_pos = -0.000000001;
    kc_last = -1;
  );
  kc_mode = mode;
  kc_a1 = kc_valid(kp);
  kc_a2 = kc_valid(kq);
  kc_o1 = kc_a1 ? kc_skip(kp) : 0;
  kc_o2 = kc_a2 ? kc_skip(kq) : 0;
  spb = 4;
  kc_a1 && PS[kp] == 3 ? spb = 3;
  kc_a2 && PS[kq] == 3 ? spb = 3;
  kc_np = 0;
  c = 0;
  loop(16,
    !(((kc_o1 | kc_o2) >> c) & 1) ? ( PLAY[kc_np] = c; kc_np += 1; );
    c += 1;
  );
  kc_nh = 0;
  kc_run = 0;
  (kc_a1 || kc_a2) && kc_np > 0 ? (
    mode ? (
      sps = ((tempo / 60) * spb) / srate;
      kc_half = 0.5 / sps;
      mode == 1 ? (
        hp = beat_position * spb;
        abs(hp - kc_pos) > 0.5 ? kc_last = ceil(hp) - 1;
        kc_pos = hp;
      );
      own1 = kc_a1 ? (kc_o1 == 0 ? 16 : 12) : (kc_o2 == 0 ? 16 : 12);
      kc_pass = ceil(PN[kc_a1 ? kp : kq] * kc_np / own1);
      sw = spb == 4 ? (swing / 100) : 0;
      si = 0;
      loop(samplesblock,
        nx = kc_last + 1;
        thr = nx + ((nx & 1) ? sw : 0);
        kc_pos >= thr ? (
          mode == 2 && !prev_loop && nx >= kc_pass ? (
            prev_on = 0;
          ) : (
            nx >= 0 ? kc_fire(si, nx);
            kc_last = nx;
          );
        );
        kc_pos += sps;
        si += 1;
      );
      mode == 2 && !prev_on ? ( kc_pos = -1000000000; kc_last = -1; );
    ) : (
      kc_pos = -1000000000;
      kc_last = -1;
    );
    kc_run = kc_last >= 0;
  ) : (
    mode == 2 ? prev_on = 0;
  );
  kc_led = kc_run ? kc_last % kc_np : -1;
  kc_step = kc_run ? kc_last : -1;
);

function ev_handle(m1, m2, m3) local(st, ch, ki, vc, vel, lvl) (
  st = m1 & 240;
  ch = (m1 & 15) + 1;
  ki = 2 - kit;
  st == 144 && m3 > 0 && (!ch10 || ch == 10) ? (
    ki == 0 ? (
      vc = MZGM[m2];
      vc >= 0 ? mz_trigger(vc, m3 >= 101);
    ) : (
      vc = KGM[(ki - 1) * 128 + m2];
      vc >= 0 ? (
        vel = (m3 * (1 / 127));
        lvl = kvel ? (vel >= (0.99) ? (0.75 + (0.5 * km_acc)) : vel) : (m3 >= 100 ? (0.75 + (0.5 * km_acc)) : 0.75);
        km_trigger(vc, lvl);
      );
    );
    PADHIT[m2] += 1;
  );
  st == 176 && m2 == 120 ? (
    memset(KMV, 0, 30 * 64);
    km_active = 0;
    mz_alloff();
  );
);


