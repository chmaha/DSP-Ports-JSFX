desc: Kick Back (Mz808 + KoniSynth drum machine port) by chmaha
tags: instrument drum machine
author: chmaha
version: 1.0
changelog:
  Initial release.
about:
  Analog drum machine with three kits: Roland TR-808 (1980), Roland CR-78 (1978) and Korg Mini Pops 7 (1966).
  TR-808 kit ported from Mz808 by Simon Moscrop, https://github.com/simozzer/Mz808 (AGPL-3.0):
  bridged-T resonators struck by the trigger pulse, after Werner, Abel and Smith (DAFx-14, ICMC-SMC 2014).
  CR-78 and Mini Pops 7 kits, rhythm patterns, + Pattern and step lights ported from the KoniSynth
  Drum Machine engine by k0n1m4k1, https://github.com/k0n1m4k1/KoniSynth (AGPL-3.0).
  Roland, TR-808, CR-78 and Korg are trademarks of their owners; no affiliation.
  JSFX version released under the GNU Affero General Public License v3.0
  Claude generated some of this code

slider1:kit=2<0,2,1{Mini Pops 7 (1966),CR-78 (1978),TR-808 (1980)}>-Kit
slider2:pat=0<0,37,1{Off,Rock 1,Rock 2,Disco,Funk,Electro,Hip Hop,Synth Pop,Bossa Nova,Samba,Cha-Cha,Mambo,Beguine,Tango,Reggae,March,Foxtrot,Waltz,Shuffle,Slow Rock,Swing,Boogie,Rumba,Merengue,Habanera,Rock 4,Latin Swing,Jazz Waltz,March 6/8,Hardbass,User 1,User 2,User 3,User 4,User 5,User 6,User 7,User 8}>-Pattern
slider3:pat2=0<0,37,1{Off,Rock 1,Rock 2,Disco,Funk,Electro,Hip Hop,Synth Pop,Bossa Nova,Samba,Cha-Cha,Mambo,Beguine,Tango,Reggae,March,Foxtrot,Waltz,Shuffle,Slow Rock,Swing,Boogie,Rumba,Merengue,Habanera,Rock 4,Latin Swing,Jazz Waltz,March 6/8,Hardbass,User 1,User 2,User 3,User 4,User 5,User 6,User 7,User 8}>-+ Pattern
slider4:swing=0<0,50,0.1>-Swing (%)
slider5:accent=5<0,10,0.1>-Accent
slider6:ktune=0<-12,12,0.1>-Tune (st, CR-78/Mini Pops)
slider7:kdecay=0<-1,1,0.01>-Decay (CR-78/Mini Pops)
slider8:ktone=50<0,100,1>-Tone (%, CR-78/Mini Pops)
slider9:ksnappy=50<0,100,1>-Snappy (%, CR-78/Mini Pops)
slider10:kvel=0<0,1,1{Off,On}>-Velocity (CR-78/Mini Pops)
slider11:ch10=0<0,1,1{Off,On}>-Channel 10 only
slider12:bd_level=8<0,10,0.1>-BD Level
slider13:bd_tone=5<0,10,0.1>-BD Tone
slider14:bd_decay=5<0,10,0.1>-BD Decay
slider15:sd_level=7<0,10,0.1>-SD Level
slider16:sd_tone=5<0,10,0.1>-SD Tone
slider17:sd_snappy=5<0,10,0.1>-SD Snappy
slider18:lt_level=7<0,10,0.1>-LT/LC Level
slider19:lt_tuning=5<0,10,0.1>-LT/LC Tuning
slider20:mt_level=7<0,10,0.1>-MT/MC Level
slider21:mt_tuning=5<0,10,0.1>-MT/MC Tuning
slider22:ht_level=7<0,10,0.1>-HT/HC Level
slider23:ht_tuning=5<0,10,0.1>-HT/HC Tuning
slider24:rs_level=6<0,10,0.1>-RS/CL Level
slider25:cp_level=7<0,10,0.1>-CP/MA Level
slider26:cb_level=6<0,10,0.1>-CB Level
slider27:cy_level=6<0,10,0.1>-CY Level
slider28:cy_tone=5<0,10,0.1>-CY Tone
slider29:cy_decay=5<0,10,0.1>-CY Decay
slider30:oh_level=6<0,10,0.1>-OH Level
slider31:oh_decay=4<0,10,0.1>-OH Decay
slider32:ch_level=6<0,10,0.1>-CH Level
slider33:mz_volume=7<0,10,0.1>-Volume (TR-808)
slider34:kgain=50<0,100,0.1>-Gain (%, CR-78/Mini Pops)
slider35:seq_on=1<0,1,1{Off,On}>-Sequencer
slider36:mout=0<0,1,1{Off,On}>-MIDI Out

options:no_meter gmem=KickBack
config: outs "Outputs -preserve-config" 2 2="2 (stereo)" 11="11 (multi-out)"

in_pin:none
<?
  outs == 11 ? (
    printf("out_pin:Bass Drum\n");
    printf("out_pin:Snare\n");
    printf("out_pin:Low Tom / Conga\n");
    printf("out_pin:Mid Tom / Conga\n");
    printf("out_pin:Hi Tom / Conga\n");
    printf("out_pin:Rim Shot / Claves\n");
    printf("out_pin:Clap / Maracas\n");
    printf("out_pin:Cowbell\n");
    printf("out_pin:Cymbal\n");
    printf("out_pin:Hi-Hats\n");
    printf("out_pin:Percussion\n");
  ) : (
    printf("out_pin:Left\n");
    printf("out_pin:Right\n");
  );
?>

