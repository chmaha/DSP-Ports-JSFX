  GPL2[32] = "BASS DRUM"; GPL2[33] = "SNARE 1"; GPL2[34] = "SNARE 2"; GPL2[35] = "RIM SHOT"; GPL2[36] = "HI-HAT"; GPL2[37] = "CYMBAL 1";
  GPL2[38] = "CYMBAL 2"; GPL2[39] = "TAMBOU~RINE"; GPL2[40] = "COW BELL"; GPL2[41] = "QUIJADA"; GPL2[42] = "BONGO 600";
  GPL2[43] = "BONGO 400"; GPL2[44] = "CONGA"; GPL2[45] = "GUIRO"; GPL2[46] = "CLAVES";
  GLANE[0] = "Bass Drum"; GLANE[1] = "Snare"; GLANE[2] = "Rim Shot"; GLANE[3] = "Hand Clap"; GLANE[4] = "Closed Hat";
  GLANE[5] = "Open Hat"; GLANE[6] = "Cymbal"; GLANE[7] = "Cowbell"; GLANE[8] = "Low Tom"; GLANE[9] = "High Tom";
  GLANE[10] = "Low Conga"; GLANE[11] = "Maracas"; GLANE[12] = "Claves"; GLANE[13] = "Tambourine"; GLANE[14] = "Guiro";
  GPNAME[0] = "Rock 1"; GPNAME[1] = "Rock 2"; GPNAME[2] = "Disco"; GPNAME[3] = "Funk"; GPNAME[4] = "Electro"; GPNAME[5] = "Hip Hop"; GPNAME[6] = "Synth Pop"; GPNAME[7] = "Bossa Nova"; GPNAME[8] = "Samba"; GPNAME[9] = "Cha-Cha"; GPNAME[10] = "Mambo"; GPNAME[11] = "Beguine"; GPNAME[12] = "Tango"; GPNAME[13] = "Reggae"; GPNAME[14] = "March"; GPNAME[15] = "Foxtrot"; GPNAME[16] = "Waltz"; GPNAME[17] = "Shuffle"; GPNAME[18] = "Slow Rock"; GPNAME[19] = "Swing"; GPNAME[20] = "Boogie"; GPNAME[21] = "Rumba"; GPNAME[22] = "Merengue"; GPNAME[23] = "Habanera"; GPNAME[24] = "Rock 4"; GPNAME[25] = "Latin Swing"; GPNAME[26] = "Jazz Waltz"; GPNAME[27] = "March 6/8"; GPNAME[28] = "Hardbass";
  GPORD[0] = 11; GPORD[1] = 20; GPORD[2] = 7; GPORD[3] = 9; GPORD[4] = 2; GPORD[5] = 4; GPORD[6] = 15; GPORD[7] = 3; GPORD[8] = 23; GPORD[9] = 28; GPORD[10] = 5; GPORD[11] = 26; GPORD[12] = 25; GPORD[13] = 10; GPORD[14] = 14; GPORD[15] = 27; GPORD[16] = 22; GPORD[17] = 13; GPORD[18] = 0; GPORD[19] = 1; GPORD[20] = 24; GPORD[21] = 21; GPORD[22] = 8; GPORD[23] = 17; GPORD[24] = 18; GPORD[25] = 19; GPORD[26] = 6; GPORD[27] = 12; GPORD[28] = 16;
  g_setup = 1;
