    y = km_tanh(1.3 * km_ring(v, 0, 65 * tu, 0.10 * dc)); km_life = 0.10 * dc;
  ) : id == 16 || id == 17 ? (
    tq = (id == 16 ? 0.12 : 0.25) * dc;
    tick = t < 0.001 ? 1 - t / 0.001 : 0;
    y = ((2 * bq(v + 23, bq(v + 16, km_noise()))) * km_decay(t, tq)) * (0.5 + v[5]) + 0.6 * tick;
    km_life = tq;
  ) : id == 18 ? (
    y = (2.5 * bq(v + 16, km_noise())) * km_decay(t, 0.06 * dc); km_life = 0.06 * dc;
  ) : id == 19 ? (
    y = (1.4 * bq(v + 16, km_noise())) * (km_decay(t, 0.05 * dc) + 0.1 * km_decay(t, 0.46 * dc));
    km_life = 0.5 * dc;
  ) : id == 20 ? (
    tq = 0.9 * dc;
