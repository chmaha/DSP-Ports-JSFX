function kb_names() local(i) (
  kb_nkit != kit ? (
    kb_nkit = kit;
    set_midi_note_name(-1, 0, 0, "");
    i = 0;
    loop(128,
      NMN[(2 - kit) * 128 + i] ? set_midi_note_name(0, i, -1, NMN[(2 - kit) * 128 + i]);
      i += 1;
    );
  );
);

function kc_lane(p, j, slot, s) local(i, ch, b) (
  PL[p * 16 + j] = slot;
  b = (p * 15 + slot) * 32;
  i = 0;
  loop(strlen(s),
    ch = str_getchar(s, i);
    PV[b + i] = ch == 'X' ? 1 : (ch == 'x' ? 0.75 : (ch == 'o' ? KM_SOFT : 0));
    i += 1;
  );
);

