function km_decay(t, dt) ( exp(((-t) * 2.302585) / dt); );

function bq_set(q, type, f, qq) local(w, c, al, a0) (
  w = (KM_2PI * clampf(f, 10, 0.45 * srate)) / srate;
  c = cos(w);
