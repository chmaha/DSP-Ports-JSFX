);

!g_setup ? gfx_setup();
g_wheel = mouse_wheel; mouse_wheel = 0;
mouse_click = (mouse_cap & 1) && !(g_lcap & 1);
mouse_rclick = (mouse_cap & 2) && !(g_lcap & 2);
!(mouse_cap & 1) ? g_drag = -1;
g_lcap = mouse_cap;
strcpy(#ghint, "");
g_tipi = -1;
g_ki = 2 - kit;

gfx_set(0.10, 0.10, 0.105, 1);
gfx_rect(0, 0, gfx_w, gfx_h, 1);
g_ki == 0 ? gfx_set(0.17, 0.17, 0.18, 1) : g_ki == 1 ? gfx_set(0.16, 0.13, 0.11, 1) : gfx_set(0.33, 0.22, 0.14, 1);
box(0, 0, gW0, gH0);
gfx_set(0.05, 0.05, 0.055, 1);
box(0, 0, gW0, 62);
g_ki == 2 ? ( gfx_set(0.24, 0.15, 0.09, 1); box(0, 62, 10, gH0 - 62); box(gW0 - 10, 62, 10, gH0 - 62); );
g_lab = 0.86;

font(22, 'b');
gfx_set(0.97, 0.96, 0.92, 1);
text_l("KICK BACK", 22, 12);
font(8.5, 'b');
gfx_set(0.96, 0.52, 0.18, 1);
text_l("ANALOG RHYTHM MACHINE  -  MZ808 + KONISYNTH", 24, 42);
g_r = seg(500, 18, 420, 28, 3, kit, "MINI POPS 7  1966", "CR-78  1978", "TR-808  1980");
g_r >= 0 ? tap_sl(1, g_r);
hit(500, 18, 420, 28) ? hint("Drum kit, by year. Patterns and the keyboard map follow the kit");
font(8.5, 'b');
gfx_set(0.86, 0.86, 0.83, 1);
text_c("CH 10 ONLY", 1040, 6);
g_r = seg(990, 22, 100, 24, 2, ch10, "OFF", "ON", "");
g_r >= 0 ? tap_sl(11, g_r);
hit(990, 22, 100, 24) ? hint("On: only MIDI channel 10 (General MIDI drums) plays the kit");

g_edit ? editor(g_ki) : (
  g_ki == 0 ? panel808() : panelkm(g_ki);

  gfx_set(0, 0, 0, 0.25);
  box(14, 316, gW0 - 28, 1);
  chip(26, 346, 190, 2, "PATTERN");
  chip(232, 346, 190, 3, "+ PATTERN (COMBINES TWO)");
  knob(466, 358, 15, 4, "SWING", 0.86);
  btn(508, 346, 120, 24, "USER RHYTHMS...", g_edit) ? g_edit = !g_edit;
  hit(508, 346, 120, 24) ? hint("Edit your own rhythms User 1-8. The factory patterns are fixed; COPY FROM... in the editor starts from one");
  font(8.5, 'b');
  gfx_set(g_lab, g_lab, g_lab * 0.96, 1);
  text_l("SEQUENCER", 644, 330);
  btn(644, 346, 80, 24, seq_on ? "ON" : "OFF", seq_on) ? tap_sl(35, !seq_on);
  hit(644, 346, 80, 24) ? hint("On: the selected pattern plays while REAPER plays. Off: the transport does not start it");
  font(8.5, 'b'); gfx_set(g_lab, g_lab, g_lab * 0.96, 1);
  text_l("PREVIEW", 740, 330);
  g_pv = prev_on && play_state == 0;
  btn(740, 346, 66, 24, g_pv ? "STOP" : "PLAY", g_pv) ? ( play_state == 0 ? ( prev_req_on = !g_pv; prev_req = 1; ); );
  btn(810, 346, 50, 24, "LOOP", prev_loop) ? prev_loop = !prev_loop;
  hit(740, 346, 120, 24) ? hint(play_state == 0 ? "Plays the pattern at REAPER's tempo while the transport is stopped. LOOP off: one pass" : "Preview works while REAPER's transport is stopped");
  font(8.5, 'b'); gfx_set(g_lab, g_lab, g_lab * 0.96, 1);
  text_l("MIDI OUT", 876, 330);
  btn(876, 346, 66, 24, mout ? "ON" : "OFF", mout) ? tap_sl(36, !mout);
  hit(876, 346, 66, 24) ? hint("Sends pattern hits as MIDI notes (channel 10). To record them, set the track's record mode to Record: output (MIDI)");
  font(9, 'b');
  gfx_set(0.86, 0.86, 0.83, 1);
  sprintf(#gtmp, "%.1f BPM", tempo);
  text_l(#gtmp, 960, 344);
  font(8.5, 0);
  gfx_set(0.80, 0.80, 0.77, 0.9);
  text_l((play_state & 1) ? "REAPER PLAYING" : g_pv ? "PREVIEW" : "STOPPED", 960, 362);

  g_c = 0;
  loop(16, pad(g_c, g_ki); g_c += 1;);
  leds();
);


gfx_set(0.05, 0.05, 0.055, 1);
box(0, 552, gW0, 30);
font(9, 0);
gfx_set(0.86, 0.86, 0.83, 1);
strlen(#ghint) ? text_l(#ghint, 22, 559) : text_l("Kick Back: TR-808 from Mz808 (Simon Moscrop), CR-78 and Mini Pops 7 from KoniSynth (k0n1m4k1)  -  AGPL-3.0", 22, 559);
g_tipi > 0 && !g_edit ? ( sl_text(g_tipi, #gkv); tooltip(g_tipx, g_tipy, #gkv); );
