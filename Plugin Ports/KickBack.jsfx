KGM[163] = 15; KGM[164] = 15; KGM[165] = 27; KGM[166] = 16; KGM[167] = 17; KGM[168] = 17; KGM[170] = 18; KGM[172] = 18; KGM[174] = 19; KGM[177] = 20; KGM[179] = 20; KGM[180] = 20; KGM[182] = 21; KGM[183] = 20; KGM[184] = 22; KGM[185] = 20; KGM[186] = 29; KGM[187] = 20; KGM[188] = 24; KGM[189] = 25; KGM[190] = 23; KGM[191] = 23; KGM[192] = 23; KGM[201] = 28; KGM[202] = 28; KGM[203] = 26;

u_i = 0;
loop(8,
  PN[KC_NF + u_i] = 16; PS[KC_NF + u_i] = 4; PC[KC_NF + u_i] = 15;
  u_j = 0; loop(15, PL[(KC_NF + u_i) * 16 + u_j] = u_j; u_j += 1;);
  u_i += 1;
);
mzr.st = 625341585;
kmr.seed = 1;
kc_p1 = kc_p2 = -2;
kc_pos = -0.000000001;
kc_last = -1;
kc_led = kc_step = -1;
kb_nkit = -1;
kb_multi = 0 <? outs == 11 ? printf("+ 1"); ?>;
u_i = 0;
loop(30, KOUT[u_i] = KOUTT[u_i]; u_i += 1;);
prev_loop = 1;
LNOTE[0] = 36; LNOTE[1] = 38; LNOTE[2] = 37; LNOTE[3] = 39; LNOTE[4] = 42; LNOTE[5] = 46; LNOTE[6] = 49; LNOTE[7] = 56;
LNOTE[8] = 45; LNOTE[9] = 50; LNOTE[10] = 64; LNOTE[11] = 70; LNOTE[12] = 75; LNOTE[13] = 54; LNOTE[14] = 73;
km_glast = (kgain / 100);
mz_accent = accent;
mz_prep((srate));
last_srate = srate;

@slider
last_srate != srate ? (
  last_srate = srate;
  memset(KMV, 0, 30 * 64);
  km_active = 0;
  km_glast = (kgain / 100);
  mz_prep((srate));
);

@block
kb_names();
mz_accent = accent;
km_tu = 2 ^ ((ktune) / 12);
km_dc = 2 ^ (2 * (kdecay));
km_tone = (ktone / 100);
km_snappy = (ksnappy / 100);
km_acc = (accent / 10);
mz_setset();
eq_n = 0;
while (pad_rd != pad_wr) (
  eq_n < 1024 ? (
    EVQ[eq_n * 4] = 0; EVQ[eq_n * 4 + 1] = 153; EVQ[eq_n * 4 + 2] = PADQ[pad_rd * 2]; EVQ[eq_n * 4 + 3] = PADQ[pad_rd * 2 + 1];
    eq_n += 1;
  );
  pad_rd = (pad_rd + 1) & 63;
);
while (midirecv(mofs, m1, m2, m3)) (
  eq_n < 1024 ? (
    EVQ[eq_n * 4] = mofs; EVQ[eq_n * 4 + 1] = m1; EVQ[eq_n * 4 + 2] = m2; EVQ[eq_n * 4 + 3] = m3;
    eq_n += 1;
  );
  midisend(mofs, m1, m2, m3);
);
kc_block();
km_gcur = km_glast;
km_gend = (kgain / 100);
km_ginc = km_gcur === km_gend ? 0 : ((km_gend - km_gcur) / samplesblock);
km_glast = km_gend;
eq_p = 0;
hq_p = 0;
b_si = 0;
mz_seg = 0;

@sample
(eq_p < eq_n && EVQ[eq_p * 4] <= b_si) || (hq_p < kc_nh && HQ[hq_p * 4] <= b_si) ? mz_seg = 0;
while (eq_p < eq_n && EVQ[eq_p * 4] <= b_si) (
  ev_handle(EVQ[eq_p * 4 + 1], EVQ[eq_p * 4 + 2], EVQ[eq_p * 4 + 3]);
  eq_p += 1;
);
while (hq_p < kc_nh && HQ[hq_p * 4] <= b_si) (
  kit == 2 ? mz_trigger(HQ[hq_p * 4 + 1], HQ[hq_p * 4 + 3]) : km_trigger(HQ[hq_p * 4 + 1], HQ[hq_p * 4 + 2]);
  hq_p += 1;
);
km_gl = km_gcur;
out_km = (km_render() * km_gcur);
km_gcur = (km_gcur + km_ginc);
mz_idle = kit != 2 && !(MZAW[0] || MZAW[1] || MZAW[2] || MZAW[3] || MZAW[4] || MZAW[5] || MZAW[6] || MZAW[7] || MZAW[8] || MZAW[9]) && abs(mz_dy1) < 0.000000000001;
out_mz = mz_idle ? 0 : mz_render1(mz_seg);
mz_idle && kb_multi ? memset(MZO, 0, 10);
mz_seg += 1;
b_si += 1;
kb_multi ? (
  0;
<?
  outs == 11 ? (
    i = 0;
    loop(11,
      i < 10 ? printf("  spl%d = KMO[%d] * km_gl + MZO[%d];\n", i, i, i) : printf("  spl%d = KMO[%d] * km_gl;\n", i, i);
      i += 1;
    );
  );
?>
) : (
  spl0 = spl1 = out_km + out_mz;
);

@serialize
ser_v = 1;
file_var(0, ser_v);
file_mem(0, UPRES, 8);
file_mem(0, PN + KC_NF, 8);
file_mem(0, PS + KC_NF, 8);
file_mem(0, PV + KC_NF * 15 * 32, 8 * 15 * 32);

@gfx 1120 582

gW0 = 1120; gH0 = 582;
z = max(0.4, min(gfx_w / gW0, gfx_h / gH0));
ox = floor((gfx_w - gW0 * z) * 0.5);
oy = 0;
gnow = time_precise();

function automate(s, e)
(
<?
  max_sliders > 36 ? printf("slider_automate(2^(s-1),e);") :
    loop(i = 1; 36,
      printf("  s == %d ? slider_automate(slider%d, e) :\n", i, i);
      i += 1;
    );
?> 0;
);

function sx(x) ( ox + x * z; );
function sy(y) ( oy + y * z; );
function hit(x, y, w, h) ( mouse_x >= sx(x) && mouse_x < sx(x + w) && mouse_y >= sy(y) && mouse_y < sy(y + h); );
function hitc(x, y, r) ( sqr(mouse_x - sx(x)) + sqr(mouse_y - sy(y)) <= sqr(r * z); );
function font(sz, fl) ( gfx_setfont(1, "Arial", (sz + 2) * z, fl); );
function text_c(str, cx, y) local(tw, th) ( gfx_measurestr(str, tw, th); gfx_x = sx(cx) - tw * 0.5; gfx_y = sy(y); gfx_drawstr(str); );
function text_l(str, lx, y) ( gfx_x = sx(lx); gfx_y = sy(y); gfx_drawstr(str); );
function text_r(str, rx, y) local(tw, th) ( gfx_measurestr(str, tw, th); gfx_x = sx(rx) - tw; gfx_y = sy(y); gfx_drawstr(str); );
function box(x, y, w, h) ( gfx_rect(sx(x), sy(y), w * z, h * z, 1); );
function frame(x, y, w, h, a) ( gfx_set(0, 0, 0, a); gfx_rect(sx(x) - z, sy(y) - z, w * z + 2 * z, h * z + 2 * z, 1); );

function set_sl(i, v) (
  v = max(GSMIN[i], min(GSMAX[i], v));
  slider(i) !== v ? ( slider(i) = v; automate(i, 0); );
);
function tap_sl(i, v) ( set_sl(i, v); automate(i, 1); );

function sl_text(i, str) local(v) (
  v = slider(i);
  i == 4 ? sprintf(str, "%.1f %%", v) :
  i == 6 ? sprintf(str, "%+.1f st", v) :
  i == 7 ? sprintf(str, "x%.2f", 2 ^ (2 * v)) :
  i == 8 || i == 9 ? sprintf(str, "%d %%", v) :
  i == 34 ? sprintf(str, "%.1f %%", v) :
  sprintf(str, "%.1f", v);
);

function hint(str) ( strcpy(#ghint, str); );

function knob_body(x, y, r) local(QX, QY, QR, k, t, c) (
  QX = sx(x); QY = sy(y); QR = r * z;
  gfx_set(0, 0, 0, 0.35);
  gfx_circle(QX + 1.5 * z, QY + 2.5 * z, QR + 2 * z, 1, 1);
  gfx_set(0.04, 0.04, 0.045, 1);
  gfx_circle(QX, QY, QR + 1.5 * z, 1, 1);
  k = 0;
  loop(ceil(QR),
    t = k / ceil(QR);
    c = 0.10 + 0.16 * t;
    gfx_set(c, c, c * 1.04, 1);
    gfx_circle(QX - QR * 0.12 * t, QY - QR * 0.18 * t, QR * (1 - t * 0.75), 1, 1);
    k += 1;
  );
  gfx_set(1, 1, 1, 0.10);
  gfx_arc(QX, QY, QR - 1 * z, -1.6, 0.2, 1);
);

function knob(x, y, r, i, label, lc) local(hov, nv, d, fine, QX, QY, a, a0, a1, k, pos, rr, big) (
  hov = hitc(x, y, r + 5);
  (mouse_click && hov) ? (
    (g_lci == i && gnow - g_lct < 0.3) ? ( tap_sl(i, GSDEF[i]); g_drag = -1; ) :
      ( g_drag = i; g_dy0 = mouse_y; g_dv0 = slider(i); );
    g_lci = i; g_lct = gnow; mouse_click = 0;
  );
  g_drag == i && (mouse_cap & 1) ? (
    mouse_cap |= 65536;
    fine = (mouse_cap & 4) || (mouse_cap & 8);
    d = (g_dy0 - mouse_y) / (200 * z) * (fine ? 0.1 : 1);
    nv = g_dv0 + d * (GSMAX[i] - GSMIN[i]);
    set_sl(i, floor(nv / GSSTEP[i] + 0.5) * GSSTEP[i]);
  );
  (hov && g_wheel != 0 && g_drag < 0) ? (
    tap_sl(i, slider(i) + (g_wheel > 0 ? 1 : -1) * GSSTEP[i] * ((mouse_cap & 4) ? 1 : 5));
    g_wheel = 0;
  );
  QX = sx(x); QY = sy(y);
  pos = (slider(i) - GSMIN[i]) / (GSMAX[i] - GSMIN[i]);
  a0 = -2.35619; a1 = 2.35619;
  a = a0 + (a1 - a0) * max(0, min(1, pos));
  k = 0;
  loop(11,
    d = a0 + (a1 - a0) * k / 10;
    big = k == 0 || k == 5 || k == 10;
    gfx_set(lc, lc, lc * 0.96, big ? 0.9 : 0.55);
    rr = r + (big ? 8 : 6.5);
    gfx_line(QX + sin(d) * (r + 4) * z, QY - cos(d) * (r + 4) * z, QX + sin(d) * rr * z, QY - cos(d) * rr * z, 1);
    k += 1;
  );
  knob_body(x, y, r);
  gfx_set(0.96, 0.96, 0.94, 1);
  k = 0;
  loop(max(1, ceil(1.6 * z)),
    gfx_line(QX + sin(a) * r * 0.2 * z + (k - 0.5) * cos(a), QY - cos(a) * r * 0.2 * z + (k - 0.5) * sin(a),
             QX + sin(a) * r * 0.92 * z + (k - 0.5) * cos(a), QY - cos(a) * r * 0.92 * z + (k - 0.5) * sin(a), 1);
    k += 1;
  );
  label != 0 ? (
    font(r >= 20 ? 10 : 8.5, 'b');
    gfx_set(lc, lc, lc * 0.96, 1);
    text_c(label, x, y - r - (r >= 20 ? 24 : 20));
  );
  (hov || g_drag == i) ? (
    sl_text(i, #gkv);
    sprintf(#ghint, "%s: %s   (drag, wheel, Ctrl/Shift fine, double-click resets)", GSNAME[i], #gkv);
    g_tipi = i; g_tipx = x; g_tipy = y + r + 10;
  );
);

function tooltip(x, y, str) local(tw, th, bx, by, bw, bh) (
  font(10, 'b');
  gfx_measurestr(str, tw, th);
  bw = tw + 12 * z; bh = th + 6 * z;
  bx = max(2, min(gfx_w - bw - 2, sx(x) - bw * 0.5)); by = sy(y);
  gfx_set(0.08, 0.08, 0.09, 0.95);
  gfx_rect(bx, by, bw, bh, 1);
  gfx_set(0.93, 0.42, 0.13, 1);
  gfx_rect(bx, by, bw, max(1, z), 1);
  gfx_set(1, 1, 1, 1);
  gfx_x = bx + 6 * z; gfx_y = by + 3 * z;
  gfx_drawstr(str);
);

function btn(x, y, w, h, label, lit) local(QX, QY, QW, QH, hov, r) (
  QX = sx(x); QY = sy(y); QW = w * z; QH = h * z;
  hov = hit(x, y, w, h);
  gfx_set(0.02, 0.02, 0.02, 1);
  gfx_rect(QX - z, QY - z, QW + 2 * z, QH + 2 * z, 1);
  lit ? gfx_gradrect(QX, QY, QW, QH, 0.95, 0.50, 0.16, 1, 0, 0, 0, 0, -0.15 / QH, -0.10 / QH, -0.05 / QH, 0)
      : gfx_gradrect(QX, QY, QW, QH, 0.30, 0.30, 0.31, 1, 0, 0, 0, 0, -0.10 / QH, -0.10 / QH, -0.10 / QH, 0);
  hov ? ( gfx_set(1, 1, 1, 0.10); gfx_rect(QX, QY, QW, QH, 1); );
  font(9.5, 'b');
  lit ? gfx_set(0.10, 0.06, 0.03, 1) : gfx_set(0.92, 0.92, 0.90, 1);
  text_c(label, x + w * 0.5, y + h * 0.5 - 7);
  r = mouse_click && hov;
  r ? mouse_click = 0;
  r;
);

function seg(x, y, w, h, n, cur, s1, s2, s3) local(k, sw, on, hov, QX, r) (
  sw = w / n;
  r = -1;
  k = 0;
  loop(n,
    on = k == cur;
    hov = hit(x + k * sw, y, sw, h);
    QX = sx(x + k * sw);
    gfx_set(0.02, 0.02, 0.02, 1);
    gfx_rect(QX - z, sy(y) - z, sw * z + 2 * z, h * z + 2 * z, 1);
    on ? gfx_gradrect(QX, sy(y), sw * z - z, h * z, 0.95, 0.50, 0.16, 1, 0, 0, 0, 0, -0.15 / (h * z), -0.10 / (h * z), -0.05 / (h * z), 0)
       : gfx_gradrect(QX, sy(y), sw * z - z, h * z, 0.27, 0.27, 0.28, 1, 0, 0, 0, 0, -0.08 / (h * z), -0.08 / (h * z), -0.08 / (h * z), 0);
    hov && !on ? ( gfx_set(1, 1, 1, 0.10); gfx_rect(QX, sy(y), sw * z - z, h * z, 1); );
    font(9.5, 'b');
    on ? gfx_set(0.10, 0.06, 0.03, 1) : gfx_set(0.90, 0.90, 0.88, 1);
    text_c(k == 0 ? s1 : (k == 1 ? s2 : s3), x + k * sw + sw * 0.5, y + h * 0.5 - 7);
    (mouse_click && hov) ? ( r = k; mouse_click = 0; );
    k += 1;
  );
  r;
);

function pat_name(p, str) (
  p <= 0 ? strcpy(str, "OFF") : (p <= KC_NF ? strcpy(str, GPNAME[p - 1]) : sprintf(str, "USER %d", p - KC_NF));
);

function pat_menu(i) local(k, cur, sel, p) (
  cur = slider(i);
  strcpy(#gmn, cur == 0 ? "!Off" : "Off");
  k = 0;
  loop(KC_NF,
    p = GPORD[k] + 1;
    strcat(#gmn, "|");
    p == cur ? strcat(#gmn, "!");
    strcat(#gmn, GPNAME[p - 1]);
    k += 1;
  );
  k = 0;
  loop(8,
    strcat(#gmn, "|");
    cur == KC_NF + 1 + k ? strcat(#gmn, "!");
    sprintf(#gtmp, "User %d%s", k + 1, UPRES[k] ? "" : " (empty)");
    strcat(#gmn, #gtmp);
    k += 1;
  );
  sel = gfx_showmenu(#gmn);
  sel == 1 ? tap_sl(i, 0) : sel >= 2 && sel <= KC_NF + 1 ? tap_sl(i, GPORD[sel - 2] + 1) : sel > KC_NF + 1 ? tap_sl(i, sel - 1);
);

function chip(x, y, w, i, label) local(hov, QX, QY, QW, QH, tw, th) (
  QX = sx(x); QY = sy(y); QW = w * z; QH = 24 * z;
  hov = hit(x, y, w, 24);
  font(8.5, 'b');
  gfx_set(g_lab, g_lab, g_lab * 0.96, 1);
  text_l(label, x, y - 16);
  gfx_set(0.02, 0.02, 0.02, 1);
  gfx_rect(QX - z, QY - z, QW + 2 * z, QH + 2 * z, 1);
  gfx_gradrect(QX, QY, QW, QH, 0.20, 0.09, 0.05, 1, 0, 0, 0, 0, -0.08 / QH, -0.04 / QH, -0.02 / QH, 0);
  hov ? ( gfx_set(1, 1, 1, 0.08); gfx_rect(QX, QY, QW, QH, 1); hint("Click to choose a rhythm (factory patterns A-Z, then your User 1-8)"); );
  pat_name(slider(i), #gcv);
  font(10, 'b');
  gfx_set(1.0, 0.55, 0.22, 1);
  gfx_measurestr(#gcv, tw, th);
  gfx_x = QX + 8 * z; gfx_y = QY + floor((QH - th) * 0.5 + 0.5);
  gfx_drawstr(#gcv);
  gfx_x = QX + QW - 16 * z; gfx_drawstr("v");
  (mouse_click && hov) ? ( gfx_x = QX; gfx_y = QY + QH; pat_menu(i); mouse_click = 0; );
);

function pad_col(c, ki) (
  ki == 0 ? (
    c < 4 ? (g_pr = 0.85; g_pg = 0.29; g_pb = 0.20;) :
    c < 8 ? (g_pr = 0.96; g_pg = 0.51; g_pb = 0.10;) :
    c < 12 ? (g_pr = 0.92; g_pg = 0.83; g_pb = 0.06;) :
    (g_pr = 0.94; g_pg = 0.86; g_pb = 0.69;);
  ) : ki == 1 ? (
    g_pr = 0.92; g_pg = 0.62; g_pb = 0.22;
  ) : (
    g_pr = 0.90; g_pg = 0.87; g_pb = 0.78;
  );
);

function pad_voice(ki, c) ( ki == 0 ? GPV808[c] : (ki == 1 ? GPV78[c] : GPVMP[c]); );
function pad_note(ki, c) ( ki == 0 ? GPN808[c] : (ki == 1 ? GPN78[c] : GPNMP[c]); );

function pad_fit(mw) local(tw, th, tw2) (
  g_pnsz = 11;
  font(g_pnsz, 'b');
  gfx_measurestr(#gpn1, tw, th); gfx_measurestr(#gpn2, tw2, th);
  while (g_pnsz > 6 && max(tw, tw2) > mw * z) (
    g_pnsz -= 0.5;
    font(g_pnsz, 'b');
    gfx_measurestr(#gpn1, tw, th); gfx_measurestr(#gpn2, tw2, th);
  );
  g_pnth = th;
);

function pad_name(str, cx, y, mw) local(n, i, sp, ch, two) (
  n = strlen(str);
  sp = -1;
  i = 0;
  loop(n, ch = str_getchar(str, i); sp < 0 && (ch == 32 || ch == 126) ? ( sp = i; g_pnhy = ch == 126; ); i += 1;);
  two = sp >= 0;
  two && g_pnhy ? (
    strcpy_substr(#gpn1, str, 0, sp); strcpy_substr(#gpn2, str, sp + 1); strcat(#gpn1, #gpn2); strcpy(#gpn2, "");
    pad_fit(mw);
    g_pnsz >= 10.5 ? two = 0;
  );
  two ? (
    strcpy_substr(#gpn1, str, 0, sp); strcpy_substr(#gpn2, str, sp + 1);
    g_pnhy ? strcat(#gpn1, "-");
  ) : (
    sp < 0 ? strcpy(#gpn1, str);
    strcpy(#gpn2, "");
  );
  pad_fit(mw);
  two ? ( text_c(#gpn1, cx, y - g_pnth / z); text_c(#gpn2, cx, y); ) : text_c(#gpn1, cx, y - g_pnth * 0.5 / z);
);

function pad(c, ki) local(x, y, w, h, QX, QY, QW, QH, hov, t, lit, vc, nt, cnt, acc) (
  vc = pad_voice(ki, c);
  vc >= 0 ? (
    x = 20 + c * 68; y = 438; w = 60; h = 99;
    QX = sx(x); QY = sy(y); QW = w * z; QH = h * z;
    pad_col(c, ki);
    hov = hit(x, y, w, h);
    cnt = ki == 0 ? HITS[vc] : KHITS[vc];
    cnt != GPADC[c] ? ( GPADC[c] = cnt; GPADT[c] = gnow; );
    t = gnow - GPADT[c];
    lit = t >= 0 && t < 0.18 ? 1 - t / 0.18 : 0;
    gfx_set(0.02, 0.02, 0.02, 1);
    gfx_rect(QX - 2 * z, QY - 2 * z, QW + 4 * z, QH + 4 * z, 1);
    gfx_gradrect(QX, QY, QW, QH, g_pr, g_pg, g_pb, 1, 0, 0, 0, 0, -0.20 * g_pr / QH, -0.20 * g_pg / QH, -0.20 * g_pb / QH, 0);
    gfx_set(1, 1, 1, 0.28);
    gfx_rect(QX, QY, QW, max(1, 1.5 * z), 1);
    gfx_set(0, 0, 0, 0.22);
    gfx_rect(QX, QY + QH - 6 * z, QW, 6 * z, 1);
    lit > 0 ? ( gfx_set(1, 1, 1, 0.35 * lit); gfx_rect(QX, QY, QW, QH, 1); );
    hov ? ( gfx_set(1, 1, 1, 0.10); gfx_rect(QX, QY, QW, QH, 1); );
    gfx_set(0, 0, 0, 0.10); gfx_rect(QX, QY, QW, 25 * z, 1);
    gfx_set(g_pr + (1 - g_pr) * 0.30, g_pg + (1 - g_pg) * 0.30, g_pb + (1 - g_pb) * 0.30, 1); gfx_rect(QX, QY + 20 * z, QW, max(1, z), 1);
    gfx_rect(QX + 4 * z, QY + 25 * z, QW - 8 * z, max(1, z), 1);
    gfx_set(0.10, 0.06, 0.04, 0.92);
    pad_name(GPL2[ki * 16 + c], x + w * 0.5, y + 54, w - 4);
    nt = pad_note(ki, c);
    sprintf(#gnt, "%s%d", nt % 12 == 0 ? "C" : nt % 12 == 1 ? "C#" : nt % 12 == 2 ? "D" : nt % 12 == 3 ? "D#" : nt % 12 == 4 ? "E" :
            nt % 12 == 5 ? "F" : nt % 12 == 6 ? "F#" : nt % 12 == 7 ? "G" : nt % 12 == 8 ? "G#" : nt % 12 == 9 ? "A" : nt % 12 == 10 ? "A#" : "B",
            floor(nt / 12) - 1);
    font(8.5, 'b');
    gfx_set(0.10, 0.06, 0.04, 0.6);
    text_c(#gnt, x + w * 0.5, y + h - 24);
    hov ? hint("Click to play (accent: Shift-click or right-click). MIDI notes follow the General MIDI drum map");
    acc = (mouse_cap & 8) || (mouse_cap & 2);
    ((mouse_click || mouse_rclick) && hov) ? (
      PADQ[pad_wr * 2] = nt; PADQ[pad_wr * 2 + 1] = acc ? 127 : (ki == 0 ? 100 : 90);
      pad_wr = (pad_wr + 1) & 63;
      mouse_click = mouse_rclick = 0;
    );
  );
);

function leds() local(c, x, y, on) (
  c = 0;
  loop(16,
    x = 20 + c * 68 + 30; y = 449;
    on = kc_led == c;
    gfx_set(0, 0, 0, 0.45); gfx_circle(sx(x), sy(y), 5.5 * z, 1, 1);
    gfx_set(0.24, 0.03, 0.02, 1); gfx_circle(sx(x), sy(y), 4.5 * z, 1, 1);
    gfx_set(1, 0.6, 0.5, 0.18); gfx_circle(sx(x - 1.2), sy(y - 1.4), 1.6 * z, 1, 1);
    on ? (
      gfx_set(1, 0.15, 0.06, 0.35); gfx_circle(sx(x), sy(y), 9 * z, 1, 1);
      gfx_set(1, 0.22, 0.12, 1); gfx_circle(sx(x), sy(y), 4.5 * z, 1, 1);
      gfx_set(1, 0.85, 0.75, 0.9); gfx_circle(sx(x - 1.2), sy(y - 1.4), 1.6 * z, 1, 1);
    );
    font(8, 'b');
    gfx_set(g_lab, g_lab, g_lab * 0.96, 0.8);
    sprintf(#gn, "%d", c + 1);
    text_c(#gn, x, 418);
    c += 1;
  );
);

function panel808() local(c, x, y, i, cw) (
  cw = 82;
  c = 0;
  loop(13,
    x = 26 + c * cw + cw * 0.5;
    c > 0 && c < 12 ? ( gfx_set(1, 1, 1, 0.07); box(26 + c * cw, 84, 1, 220); );
    i = 0;
    loop(3,
      GC8[c * 3 + i] > 0 ? knob(x, 126 + i * 66, c == 12 ? 20 : 15, GC8[c * 3 + i], GC8L[c * 3 + i], 0.86);
      i += 1;
    );
    font(9, 'b');
    gfx_set(0.96, 0.52, 0.18, 1);
    text_c(GC8N1[c], x, 280);
    text_c(GC8N2[c], x, 294);
    c += 1;
  );
);

function panelkm(ki) local(c, x, r) (
  c = 0;
  loop(6,
    x = 120 + c * 132;
    knob(x, 170, 28, GCKM[c], GCKML[c], 0.86);
    c += 1;
  );
  font(9, 'b');
  gfx_set(0.86, 0.86, 0.83, 1);
  text_c("VELOCITY", 975, 128);
  r = seg(920, 150, 110, 28, 2, kvel, "OFF", "ON", "");
  r >= 0 ? tap_sl(10, r);
  hit(920, 150, 110, 28) ? hint("Off: as the machine (normal level, accent from velocity 100). On: velocity sets the level");
  font(9, 'b');
  gfx_set(0.96, 0.52, 0.18, 1);
  text_c(ki == 1 ? "CR-78 KIT  -  15 VOICES" : "MINI POPS 7 KIT  -  15 VOICES", gW0 * 0.5, 262);
);

function ed_lane_voice(ki, l) ( ki == 0 ? MZSLOT[l] : (ki == 1 ? K78SLOT[l] : KMPSLOT[l]); );

function ed_cell_set(u, l, s, v) ( PV[((KC_NF + u) * 15 + l) * 32 + s] = v; UPRES[u] = 1; );

function editor(ki) local(u, p, ns, spb, gx, gy, cw, rh, l, s, x, y, v, on, hov, QX, QY, cur, r, sel, k, q, src, inl, mx, my) (
  u = g_eslot;
  p = KC_NF + u;
  ns = PN[p];
  spb = PS[p];
  gfx_set(0.07, 0.07, 0.075, 1);
  box(14, 70, gW0 - 28, 470);
  gfx_set(0.96, 0.52, 0.18, 1);
  box(14, 70, gW0 - 28, 2);
  font(11, 'b');
  gfx_set(0.95, 0.95, 0.92, 1);
  text_l("USER RHYTHMS", 30, 86);
  k = 0;
  loop(8,
    sprintf(#gn, "%d", k + 1);
    btn(190 + k * 34, 82, 30, 24, #gn, k == u) ? g_eslot = k;
    k += 1;
  );
  btn(476, 82, 150, 24, ns == 32 ? "32 STEPS (2 BARS)" : ns == 16 ? "16 STEPS (4/4)" : spb == 3 ? "12 STEPS (SHUFFLE)" : "12 STEPS (WALTZ)", 0) ? (
    gfx_x = sx(476); gfx_y = sy(106);
    sel = gfx_showmenu("16 steps (4/4)|32 steps (2 bars)|12 steps (waltz 3/4)|12 steps (shuffle: triplet eighths)");
    sel > 0 ? (
      PN[p] = sel == 1 ? 16 : (sel == 2 ? 32 : 12);
      PS[p] = sel == 4 ? 3 : 4;
      l = 0;
      loop(15, s = PN[p]; loop(32 - PN[p], PV[(p * 15 + l) * 32 + s] = 0; s += 1;); l += 1;);
      UPRES[u] = 1;
    );
  );
  btn(636, 82, 110, 24, "COPY FROM...", 0) ? (
    strcpy(#gmn, "");
    k = 0;
    loop(KC_NF, k > 0 ? strcat(#gmn, "|"); strcat(#gmn, GPNAME[GPORD[k]]); k += 1;);
    gfx_x = sx(636); gfx_y = sy(106);
    sel = gfx_showmenu(#gmn);
    sel > 0 ? (
      src = GPORD[sel - 1];
      PN[p] = PN[src]; PS[p] = PS[src];
      memset(PV + p * 15 * 32, 0, 15 * 32);
      k = 0;
      loop(PC[src],
        l = PL[src * 16 + k];
        memcpy(PV + (p * 15 + l) * 32, PV + (src * 15 + l) * 32, PN[src]);
        k += 1;
      );
      UPRES[u] = 1;
    );
  );
  btn(756, 82, 60, 24, "CLEAR", 0) ? ( memset(PV + p * 15 * 32, 0, 15 * 32); UPRES[u] = 1; );
  btn(822, 82, 56, 24, "COPY", gnow - g_copyt < 0.15) ? (
    g_copyt = gnow;
    gmem[0] = 1; gmem[1] = ns; gmem[2] = spb;
    k = 0; loop(480, gmem[10 + k] = PV[p * 480 + k]; k += 1;);
  );
  hit(822, 82, 56, 24) ? hint("Copies this rhythm (any Kick Back instance can paste it). Shift-click a lane name to copy one lane");
  btn(882, 82, 60, 24, "PASTE", gmem[0] > 0) ? (
    gmem[0] == 1 ? (
      PN[p] = gmem[1]; PS[p] = gmem[2];
      k = 0; loop(480, PV[p * 480 + k] = gmem[10 + k]; k += 1;);
      UPRES[u] = 1;
    ) : gmem[0] == 2 ? (
      k = 0; loop(32, PV[p * 480 + gmem[3] * 32 + k] = k < ns ? gmem[500 + k] : 0; k += 1;);
      UPRES[u] = 1;
    );
  );
  hit(882, 82, 60, 24) && gmem[0] > 0 ? hint(gmem[0] == 1 ? "Pastes the copied rhythm into this slot" : "Pastes the copied lane into the same lane of this slot");
  cur = pat == KC_NF + 1 + u;
  g_pv = prev_on && play_state == 0;
  btn(950, 82, 80, 24, cur && (g_pv || (play_state & 1)) ? "STOP" : "PLAY IT", cur && (g_pv || (play_state & 1))) ? (
    cur && (g_pv || (play_state & 1)) ? (
      tap_sl(2, 0); prev_req_on = 0; prev_req = 1;
    ) : (
      tap_sl(2, KC_NF + 1 + u);
      play_state == 0 ? ( prev_req_on = 1; prev_req = 1; );
    );
  );
  hit(950, 82, 80, 24) ? hint("Selects this slot as the pattern and previews it while REAPER is stopped");
  btn(1036, 82, 60, 24, "CLOSE", 0) ? g_edit = 0;
  gx = 150; gy = 124; rh = 25;
  cw = min(56, floor((gW0 - 30 - gx) / ns));
  k = 0;
  loop(ns,
    x = gx + k * cw;
    k % spb == 0 ? ( gfx_set(1, 1, 1, 0.10); box(x, gy - 4, 1, 15 * rh + 4); font(8, 'b'); gfx_set(0.8, 0.8, 0.78, 1); sprintf(#gn, "%d", k + 1); text_l(#gn, x + 3, gy - 18); );
    ns == 32 && k == 16 ? ( gfx_set(0.96, 0.52, 0.18, 0.8); box(x - 1, gy - 6, 2, 15 * rh + 8); );
    k += 1;
  );
  q = cur && pat2 == 0 && kc_step >= 0 ? kc_step % ns : -1;
  q >= 0 ? ( gfx_set(1, 1, 1, 0.08); box(gx + q * cw, gy, cw, 15 * rh); );
  mx = mouse_x; my = mouse_y;
  inl = mx >= sx(gx) && mx < sx(gx + ns * cw) && my >= sy(gy) && my < sy(gy + 15 * rh);
  l = 0;
  loop(15,
    y = gy + l * rh;
    on = ed_lane_voice(ki, l) >= 0;
    font(9.5, 'b');
    gfx_set(0.92, 0.92, 0.89, on ? 1 : 0.35);
    text_l(GLANE[l], 30, y + 6);
    (mouse_click && (mouse_cap & 8) && hit(26, y, 118, rh)) ? (
      gmem[0] = 2; gmem[3] = l;
      k = 0; loop(32, gmem[500 + k] = PV[(p * 15 + l) * 32 + k]; k += 1;);
      g_copyt = gnow; mouse_click = 0;
    );
    s = 0;
    loop(ns,
      x = gx + s * cw;
      v = PV[(p * 15 + l) * 32 + s];
      QX = sx(x + 2); QY = sy(y + 3);
      pad_col(l < 15 ? (l < 4 ? 0 : l < 8 ? 4 : l < 12 ? 8 : 12) : 0, 0);
      v > 0.9 ? gfx_set(g_pr, g_pg, g_pb, on ? 1 : 0.4) :
      v > 0.6 ? gfx_set(g_pr * 0.72, g_pg * 0.72, g_pb * 0.72, on ? 1 : 0.4) :
      v > 0 ? gfx_set(g_pr * 0.45, g_pg * 0.45, g_pb * 0.45, on ? 1 : 0.4) :
      gfx_set(0.19, 0.19, 0.20, on ? 1 : 0.5);
      gfx_rect(QX, QY, (cw - 4) * z, (rh - 6) * z, 1);
      v > 0.9 ? ( font(8, 'b'); gfx_set(0.1, 0.05, 0.03, 1); text_c("A", x + cw * 0.5, y + 6); );
      v > 0 && v < 0.6 ? ( font(8, 'b'); gfx_set(0.85, 0.85, 0.82, 0.9); text_c("s", x + cw * 0.5, y + 5); );
      s += 1;
    );
    l += 1;
  );
  inl ? (
    s = floor((mx - sx(gx)) / (cw * z));
    l = floor((my - sy(gy)) / (rh * z));
    v = PV[(p * 15 + l) * 32 + s];
    mouse_click ? ( g_paint = v == 0 ? 0.75 : (v > 0.9 ? KM_SOFT : (v > 0.6 ? 1 : 0)); g_painting = 1; mouse_click = 0; );
    mouse_rclick ? ( g_paint = 0; g_painting = 2; mouse_rclick = 0; );
    g_painting == 1 && (mouse_cap & 1) ? ed_cell_set(u, l, s, g_paint);
    g_painting == 2 && (mouse_cap & 2) ? ed_cell_set(u, l, s, 0);
    hint("Click: normal > accent > soft > empty.  Right-click empties.  Drag paints the first click's value");
  );
  !(mouse_cap & 3) ? g_painting = 0;
  font(8.5, 0);
  gfx_set(0.75, 0.75, 0.72, 1);
  text_l("Editing User 1-8 only (pick them in the Pattern menus). Factory patterns can't be changed: COPY FROM... starts a User slot from one.", 30, 506);
  text_l("A = accent, s = soft. Dimmed lanes are sounds the selected kit lacks; they stay in the rhythm for the other kits.", 30, 521);
);

function gfx_setup() local(i) (
  GSMIN = 2000000; GSMAX = 2000040; GSDEF = 2000080; GSSTEP = 2000120;
  GC8 = 2000200; GC8L = 2000260; GC8N1 = 2000320; GC8N2 = 2000340; GCKM = 2000360; GCKML = 2000370;
  GPV808 = 2000400; GPV78 = 2000420; GPVMP = 2000440; GPN808 = 2000460; GPN78 = 2000480; GPNMP = 2000500;
  GPL1 = 2000520; GPL2 = 2000580; GPADC = 2000640; GPADT = 2000660; GPORD = 2000700; GPNAME = 2000740; GSNAME = 2000780; GLANE = 2000820;
  i = 1;
  loop(36, GSMIN[i] = 0; GSMAX[i] = 10; GSDEF[i] = 5; GSSTEP[i] = 0.1; i += 1;);
  GSMAX[4] = 50; GSDEF[4] = 0;
  GSMAX[1] = 2; GSDEF[1] = 2; GSSTEP[1] = 1;
  GSMAX[2] = GSMAX[3] = KC_NF + 8; GSDEF[2] = GSDEF[3] = 0; GSSTEP[2] = GSSTEP[3] = 1;
  GSMAX[10] = GSMAX[11] = GSMAX[35] = GSMAX[36] = 1; GSDEF[10] = GSDEF[11] = GSDEF[36] = 0; GSDEF[35] = 1;
  GSSTEP[10] = GSSTEP[11] = GSSTEP[35] = GSSTEP[36] = 1;
  GSDEF[5] = 5;
  GSMIN[6] = -12; GSMAX[6] = 12; GSDEF[6] = 0;
  GSMIN[7] = -1; GSMAX[7] = 1; GSDEF[7] = 0; GSSTEP[7] = 0.01;
  GSMAX[8] = 100; GSDEF[8] = 50; GSSTEP[8] = 1;
  GSMAX[9] = 100; GSDEF[9] = 50; GSSTEP[9] = 1;
  GSDEF[12] = 8; GSDEF[15] = 7; GSDEF[18] = 7; GSDEF[20] = 7; GSDEF[22] = 7; GSDEF[24] = 6; GSDEF[25] = 7; GSDEF[26] = 6;
  GSDEF[27] = 6; GSDEF[30] = 6; GSDEF[31] = 4; GSDEF[32] = 6; GSDEF[33] = 7;
  GSMAX[34] = 100; GSDEF[34] = 50; GSSTEP[34] = 0.5;
  GSNAME[1] = "Kit"; GSNAME[2] = "Pattern"; GSNAME[3] = "+ Pattern"; GSNAME[4] = "Swing (%)"; GSNAME[5] = "Accent"; GSNAME[6] = "Tune (st, CR-78/Mini Pops)"; GSNAME[7] = "Decay (CR-78/Mini Pops)"; GSNAME[8] = "Tone (%, CR-78/Mini Pops)"; GSNAME[9] = "Snappy (%, CR-78/Mini Pops)"; GSNAME[10] = "Velocity (CR-78/Mini Pops)"; GSNAME[11] = "Channel 10 only"; GSNAME[12] = "BD Level"; GSNAME[13] = "BD Tone"; GSNAME[14] = "BD Decay"; GSNAME[15] = "SD Level"; GSNAME[16] = "SD Tone"; GSNAME[17] = "SD Snappy"; GSNAME[18] = "LT/LC Level"; GSNAME[19] = "LT/LC Tuning"; GSNAME[20] = "MT/MC Level"; GSNAME[21] = "MT/MC Tuning"; GSNAME[22] = "HT/HC Level"; GSNAME[23] = "HT/HC Tuning"; GSNAME[24] = "RS/CL Level"; GSNAME[25] = "CP/MA Level"; GSNAME[26] = "CB Level"; GSNAME[27] = "CY Level"; GSNAME[28] = "CY Tone"; GSNAME[29] = "CY Decay"; GSNAME[30] = "OH Level"; GSNAME[31] = "OH Decay"; GSNAME[32] = "CH Level"; GSNAME[33] = "Volume (TR-808)"; GSNAME[34] = "Gain (%, CR-78/Mini Pops)"; GSNAME[35] = "Sequencer"; GSNAME[36] = "MIDI Out";
  memset(GC8, 0, 39);
  GC8[0] = 5; GC8L[0] = "ACCENT";
  GC8[3] = 12; GC8[4] = 13; GC8[5] = 14; GC8L[3] = "LEVEL"; GC8L[4] = "TONE"; GC8L[5] = "DECAY";
  GC8[6] = 15; GC8[7] = 16; GC8[8] = 17; GC8L[6] = "LEVEL"; GC8L[7] = "TONE"; GC8L[8] = "SNAPPY";
  GC8[9] = 18; GC8[10] = 19; GC8L[9] = "LEVEL"; GC8L[10] = "TUNING";
  GC8[12] = 20; GC8[13] = 21; GC8L[12] = "LEVEL"; GC8L[13] = "TUNING";
  GC8[15] = 22; GC8[16] = 23; GC8L[15] = "LEVEL"; GC8L[16] = "TUNING";
  GC8[18] = 24; GC8L[18] = "LEVEL";
  GC8[21] = 25; GC8L[21] = "LEVEL";
  GC8[24] = 26; GC8L[24] = "LEVEL";
  GC8[27] = 27; GC8[28] = 28; GC8[29] = 29; GC8L[27] = "LEVEL"; GC8L[28] = "TONE"; GC8L[29] = "DECAY";
  GC8[30] = 30; GC8[31] = 31; GC8L[30] = "LEVEL"; GC8L[31] = "DECAY";
  GC8[33] = 32; GC8L[33] = "LEVEL";
  GC8[36] = 33; GC8L[36] = "VOLUME";
  GC8N1[0] = "ACCENT"; GC8N2[0] = "";
  GC8N1[1] = "BASS"; GC8N2[1] = "DRUM";
  GC8N1[2] = "SNARE"; GC8N2[2] = "DRUM";
  GC8N1[3] = "LOW TOM"; GC8N2[3] = "LOW CONGA";
  GC8N1[4] = "MID TOM"; GC8N2[4] = "MID CONGA";
  GC8N1[5] = "HI TOM"; GC8N2[5] = "HI CONGA";
  GC8N1[6] = "RIM SHOT"; GC8N2[6] = "CLAVES";
  GC8N1[7] = "HAND CLAP"; GC8N2[7] = "MARACAS";
  GC8N1[8] = "COW"; GC8N2[8] = "BELL";
  GC8N1[9] = "CYMBAL"; GC8N2[9] = "";
  GC8N1[10] = "OPEN"; GC8N2[10] = "HIHAT";
  GC8N1[11] = "CLOSED"; GC8N2[11] = "HIHAT";
  GC8N1[12] = "MASTER"; GC8N2[12] = "";
  GCKM[0] = 6; GCKM[1] = 7; GCKM[2] = 8; GCKM[3] = 9; GCKM[4] = 5; GCKM[5] = 34;
  GCKML[0] = "TUNE"; GCKML[1] = "DECAY"; GCKML[2] = "TONE"; GCKML[3] = "SNAPPY"; GCKML[4] = "ACCENT"; GCKML[5] = "VOLUME";
  i = 0;
  loop(16, GPV808[i] = i; i += 1;);
  GPN808[0] = 36; GPN808[1] = 38; GPN808[2] = 43; GPN808[3] = 64; GPN808[4] = 47; GPN808[5] = 63; GPN808[6] = 50; GPN808[7] = 62;
  GPN808[8] = 37; GPN808[9] = 75; GPN808[10] = 39; GPN808[11] = 70; GPN808[12] = 56; GPN808[13] = 49; GPN808[14] = 46; GPN808[15] = 42;
  GPN78[0] = 36; GPN78[1] = 38; GPN78[2] = 37; GPN78[3] = 42; GPN78[4] = 49; GPN78[5] = 54; GPN78[6] = 56; GPN78[7] = 60;
  GPN78[8] = 61; GPN78[9] = 64; GPN78[10] = 70; GPN78[11] = 73; GPN78[12] = 74; GPN78[13] = 75; GPN78[14] = 81; GPN78[15] = -1;
  GPNMP[0] = 36; GPNMP[1] = 38; GPNMP[2] = 39; GPNMP[3] = 37; GPNMP[4] = 42; GPNMP[5] = 46; GPNMP[6] = 49; GPNMP[7] = 54;
  GPNMP[8] = 56; GPNMP[9] = 58; GPNMP[10] = 60; GPNMP[11] = 61; GPNMP[12] = 62; GPNMP[13] = 73; GPNMP[14] = 75; GPNMP[15] = -1;
  i = 0;
  loop(16,
    GPV78[i] = GPN78[i] >= 0 ? KGM[GPN78[i]] : -1;
    GPVMP[i] = GPNMP[i] >= 0 ? KGM[128 + GPNMP[i]] : -1;
    i += 1;
  );
  GPL1[0] = "BD"; GPL1[1] = "SD"; GPL1[2] = "LT"; GPL1[3] = "LC"; GPL1[4] = "MT"; GPL1[5] = "MC"; GPL1[6] = "HT"; GPL1[7] = "HC";
  GPL1[8] = "RS"; GPL1[9] = "CL"; GPL1[10] = "CP"; GPL1[11] = "MA"; GPL1[12] = "CB"; GPL1[13] = "CY"; GPL1[14] = "OH"; GPL1[15] = "CH";
  GPL2[0] = "BASS DRUM"; GPL2[1] = "SNARE"; GPL2[2] = "LOW TOM"; GPL2[3] = "LOW CONGA"; GPL2[4] = "MID TOM"; GPL2[5] = "MID CONGA";
  GPL2[6] = "HI TOM"; GPL2[7] = "HI CONGA"; GPL2[8] = "RIM SHOT"; GPL2[9] = "CLAVES"; GPL2[10] = "HAND CLAP"; GPL2[11] = "MARA~CAS";
  GPL2[12] = "COW BELL"; GPL2[13] = "CYMBAL"; GPL2[14] = "OPEN HAT"; GPL2[15] = "CLOSED HAT";
  GPL1[16] = "BD"; GPL1[17] = "SD"; GPL1[18] = "RS"; GPL1[19] = "HH"; GPL1[20] = "CY"; GPL1[21] = "TB"; GPL1[22] = "CB"; GPL1[23] = "HB";
  GPL1[24] = "LB"; GPL1[25] = "LC"; GPL1[26] = "MA"; GPL1[27] = "GU"; GPL1[28] = "GU"; GPL1[29] = "CL"; GPL1[30] = "MB";
  GPL2[16] = "BASS DRUM"; GPL2[17] = "SNARE"; GPL2[18] = "RIM SHOT"; GPL2[19] = "HI-HAT"; GPL2[20] = "CYMBAL"; GPL2[21] = "TAMBOU~RINE";
  GPL2[22] = "COW BELL"; GPL2[23] = "HIGH BONGO"; GPL2[24] = "LOW BONGO"; GPL2[25] = "LOW CONGA"; GPL2[26] = "MARA~CAS";
  GPL2[27] = "GUIRO SHORT"; GPL2[28] = "GUIRO LONG"; GPL2[29] = "CLAVES"; GPL2[30] = "METAL BEAT";
  GPL1[32] = "BD"; GPL1[33] = "SN1"; GPL1[34] = "SN2"; GPL1[35] = "RS"; GPL1[36] = "HH"; GPL1[37] = "CY1"; GPL1[38] = "CY2"; GPL1[39] = "TA";
