function km_render() local(id, v, sum, any, kv) (
  sum = 0;
  kb_multi ? memset(KMO, 0, 11);
  any = 0;
  km_active ? (
    id = 0;
    v = KMV;
    loop(30,
      v[0] ? (
        kv = (v[1] * km_voice(id, v));
