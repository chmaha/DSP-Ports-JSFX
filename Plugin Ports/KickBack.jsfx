function km_filters(id, v) (
  id == 1 ? ( bq_set(v + 16, 2, 2000, 0.707); bq_set(v + 23, 1, 12000, 0.707); ) :
  id == 10 ? ( bq_set(v + 16, 0, 800, 3); ) :
  id == 3 || id == 4 || id == 5 ? ( bq_set(v + 16, 0, 9100, 3); bq_set(v + 23, 2, 6000, 0.707); ) :
  id == 11 ? ( bq_set(v + 16, 0, 4300, 4); bq_set(v + 23, 0, 4300, 4); ) :
  id == 12 || id == 13 ? ( bq_set(v + 16, 0, 6130, 8); ) :
