function dmap_set(i, a, b, c, d, e) ( DMAP[i * 5] = a; DMAP[i * 5 + 1] = b; DMAP[i * 5 + 2] = c; DMAP[i * 5 + 3] = d; DMAP[i * 5 + 4] = e; );
dmap_set(0, 10, 8, 0, 9, 11);
dmap_set(1, 15, 7, 13, 12, 6);
dmap_set(2, 18, 14, 4, 5, 3);
dmap_set(3, 23, 16, 21, 1, 2);
dmap_set(4, 24, 19, 17, 20, 22);

function rnd_mod(a, m) ( a - m * floor(a / m); );

function rnd_seed(seed) local(i, w)
(
  RS[0] = seed;
  i = 1;
  loop(30,
    w = rnd_mod(16807 * RS[i - 1], 2147483647);
    RS[i] = w;
    i += 1;
  );
  RS[31] = RS[0]; RS[32] = RS[1]; RS[33] = RS[2];
  rs_i = 34;
  loop(310,
    RS[rs_i % 34] = rnd_mod(RS[(rs_i + 3) % 34] + RS[(rs_i + 31) % 34], 4294967296);
    rs_i += 1;
  );
);

function rnd_byte() local(v)
(
  v = rnd_mod(RS[(rs_i + 3) % 34] + RS[(rs_i + 31) % 34], 4294967296);
  RS[rs_i % 34] = v;
  rs_i = rs_i >= 1000000 ? rs_i - 999974 : rs_i + 1;
  rnd_mod(floor(v / 2), 256);
);

function q_out(o, a, b, c) local(p) (
  oq_n < OQ_MAX ? (
    p = OQ + oq_n * 4;
    p[0] = o; p[1] = a; p[2] = b; p[3] = c;
    oq_n += 1;
  );
);

function q_flush() local(i, j, p, o, a, b, c) (
  i = 1;
  while (i < oq_n) (
    p = OQ + i * 4;
    o = p[0]; a = p[1]; b = p[2]; c = p[3];
    j = i - 1;
    while (j >= 0 && OQ[j * 4] > o) (
      memcpy(OQ + (j + 1) * 4, OQ + j * 4, 4);
      j -= 1;
    );
    p = OQ + (j + 1) * 4;
    p[0] = o; p[1] = a; p[2] = b; p[3] = c;
    i += 1;
  );
  i = 0;
  loop(oq_n,
    p = OQ + i * 4;
    midisend(p[0], p[1], p[2], p[3]);
    i += 1;
  );
  oq_n = 0;
);

function tdiv(a) ( a >= 0 ? floor(a / 127) : -floor(-a / 127); );

function pg_cell(x) ( x >= 170 ? (x >= 255 ? 3 : 2) : x >= 85 ? 1 : 0; );

function pg_read(st, ins, x, y) local(i, j, o, a, b, c, d, r, m)
(
  o = ins * 32 + st;
  pg_mode == 0 ? (
    i = pg_cell(x); j = pg_cell(y);
    a = NODES[DMAP[i * 5 + j] * 96 + o];
    b = NODES[DMAP[(i + 1) * 5 + j] * 96 + o];
    c = NODES[DMAP[i * 5 + j + 1] * 96 + o];
    d = NODES[DMAP[(i + 1) * 5 + j + 1] * 96 + o];
    r = tdiv(tdiv((a * x + b * (127 - x)) * y + (c * x + d * (127 - x)) * (127 - y)));
    r - 256 * floor(r / 256);
  ) : (
    i = x >> 6; j = y >> 6;
    a = NODES[DMAP[i * 5 + j] * 96 + o];
    b = NODES[DMAP[(i + 1) * 5 + j] * 96 + o];
    c = NODES[DMAP[i * 5 + j + 1] * 96 + o];
    d = NODES[DMAP[(i + 1) * 5 + j + 1] * 96 + o];
    m = (x << 2) & 255;
    a = floor((a * (255 - m) + b * m) / 255);
    c = floor((c * (255 - m) + d * m) / 255);
    m = (y << 2) & 255;
    floor((a * (255 - m) + c * m) / 255);
  );
);

function pg_drums() local(i, m, lvl, acc)
(
  pg_step === 0 ? (
    i = 0;
    loop(3,
      PERT[i] = (rnd_byte() * (pg_chaos >> 2)) >> 8;
      i += 1;
    );
  );
  m = 1; acc = 0; i = 0;
  loop(3,
    lvl = pg_read(pg_step, i, pg_x, pg_y);
    lvl < 255 - PERT[i] ? lvl += PERT[i] : lvl = 255;
    lvl > 255 - DENS[i] ? (
      lvl > 192 ? acc |= m;
      pg_state |= m;
    );
    HITS[i * 32 + pg_step] = (pg_state & m) ? 1 + (lvl > 192) : 0;
    m *= 2;
    i += 1;
  );
  pg_alt ? (
    pg_state |= acc ? 8 : 0;
    pg_state |= pg_step === 0 ? 32 : 0;
  ) : (
    pg_state |= acc << 3;
  );
);

function bit_at(v, k) local(q) ( q = floor(v / (2 ^ k)); q - 2 * floor(q / 2); );

function pg_euclid() local(i, m, len, dn, rst, bits)
(
  !(pg_step & 1) ? (
    m = 1; rst = 0; i = 0;
    loop(3,
      len = (ELEN[i] >> 3) + 1;
      dn = DENS[i] >> 3;
      while (ECNT[i] >= len) ( ECNT[i] -= len; );
      bits = EUCL[(len - 1) * 32 + dn];
      bit_at(bits, ECNT[i]) ? pg_state |= m;
      ECNT[i] === 0 ? rst |= m;
      HITS[i * 32 + (ECNT[i] & 31)] = (pg_state & m) ? 1 : 0;
      m *= 2;
      i += 1;
    );
    pg_alt ? (
      pg_state |= rst ? 8 : 0;
      pg_state |= rst === 7 ? 32 : 0;
    ) : (
      pg_state |= rst << 3;
    );
  );
);

function pg_tick(num)
(
  pg_state = 64 | (pg_alt ? 16 : 0);
  pg_pulse === 0 ? (
    g_step = pg_step;
    pg_mode == 2 ? pg_euclid() : pg_drums();
  );
  pg_pulse += num;
  while (pg_pulse >= 3) (
    pg_pulse -= 3;
    !(pg_step & 1) ? (
      ECNT[0] = (ECNT[0] + 1) & 255; ECNT[1] = (ECNT[1] + 1) & 255; ECNT[2] = (ECNT[2] + 1) & 255;
    );
    pg_step += 1;
  );
  pg_step >= 32 ? pg_step -= 32;
);

function pg_reset() ( pg_step = 0; pg_pulse = 0; ECNT[0] = ECNT[1] = ECNT[2] = 0; );

function pg_params()
(
  pg_x = floor(f32k(nu_x) * 255); pg_y = floor(f32k(nu_y) * 255); pg_chaos = floor(f32k(nu_chaos) * 255);
  DENS[0] = floor(f32k(nu_f1) * 255); DENS[1] = floor(f32k(nu_f2) * 255); DENS[2] = floor(f32k(nu_f3) * 255);
  ELEN[0] = pg_x; ELEN[1] = pg_y; ELEN[2] = pg_chaos;
  pg_mode = floor(nu_mode + 0.5);
  pg_alt = nu_acco >= 0.5;
);

function m_tempo(t) local(bi)
(
  bi = (60 / (t * 24));
  (1 / (bi * m_sr));
);

function nu_note(i) ( i === 0 ? nu_n1 : i === 1 ? nu_n2 : i === 2 ? nu_n3 : i === 3 ? nu_a1 : i === 4 ? nu_a2 : nu_a3; );

function nu_off(i, ofs) ( NACT[i] ? ( q_out(ofs, 128 | OCHN[i], ONOTE[i], 0); NACT[i] = 0; GTF[i] = 0; ); );

function nu_emit(ofs, odur, fgate) local(i, b, acc, n)
(
  i = 0;
  loop(6,
    b = (pg_state >> i) & 1;
    (b && (i < 3 || a_aux)) ? (
      nu_off(i, ofs);
      acc = i >= 3 ? 0 : pg_mode == 2 ? 0 : pg_alt ? (pg_state & 8) : (pg_state & (8 << i));
      n = nu_note(i) | 0;
      q_out(ofs, 144 | a_chan, n, (acc ? nu_accv : nu_vel) | 0);
      ONOTE[i] = n; OCHN[i] = a_chan;
      NACT[i] = 1;
      GTF[i] = fgate;
      fgate ? g_any = 1;
      OFFT[i] = fgate ? 1000000000 : ofs + odur;
      LEDV[i] = LEDV[i] >= 1000000 ? 1 : LEDV[i] + 1;
    ) : (b && i < 3) ? (
      LEDV[i] = LEDV[i] >= 1000000 ? 1 : LEDV[i] + 1;
    );
    i += 1;
  );
);

function all_off() local(i) ( i = 0; loop(6, nu_off(i, 0); i += 1;); );

function sw_t(n) local(c, r)
(
  c = floor(n / 12);
  r = n - 12 * c;
  12 * c + (r <= 5 ? r * (1 + a_sw) : 5 * (1 + a_sw) + (r - 5) * (1 - a_sw));
);

function nu_resync(p) local(n, sa, i, len)
(
  n = a_inc * floor((p - 12) / a_inc);
  while (sw_t(n) < p - 0.00001) ( n += a_inc; );
  n_next = n;
  sa = floor(n / 3);
  pg_pulse = n - 3 * sa;
  pg_step = sa - 32 * floor(sa / 32);
  i = 0;
  loop(3,
    len = (ELEN[i] >> 3) + 1;
    ECNT[i] = sa > 0 ? ceil(sa / 2) % len : 0;
    i += 1;
  );
);

function pat_update() local(i, s, len, dn, bits)
(
  i = 0;
  loop(3,
    s = 0;
    pg_mode == 2 ? (
      len = (ELEN[i] >> 3) + 1;
      dn = DENS[i] >> 3;
      bits = EUCL[(len - 1) * 32 + dn];
      loop(32, PATL[i * 32 + s] = s < len ? (bit_at(bits, s) ? 255 : 0) : -1; s += 1;);
    ) : (
      loop(32, PATL[i * 32 + s] = pg_read(s, i, pg_x, pg_y); s += 1;);
    );
    i += 1;
  );
  pat_len = 1;
);

<? !jsfx_has_set_midi_note_name ? printf("function set_midi_note_name(a,b,c,d) ( 0 );\n"); ?>

function nn_update() local(key, i)
(
  key = nu_n1 + 128 * (nu_n2 + 128 * (nu_n3 + 128 * (nu_a1 + 128 * (nu_a2 + 128 * nu_a3))));
  key = key * 64 + nu_chan * 4 + (nu_aux >= 0.5) * 2 + (nu_acco >= 0.5);
  key += 0.5 * (floor(nu_mode + 0.5) == 2);
  key !== nn_key ? (
    nn_key = key;
    set_midi_note_name(-1, 0, 0, "");
    i = 5;
    loop(6,
      (i < 3 || nu_aux >= 0.5) ? (
        floor(nu_mode + 0.5) == 2 ? (
          set_midi_note_name(0, nu_note(i) | 0, (nu_chan - 1) | 0,
            i == 0 ? "Jezebel Euclid 1" : i == 1 ? "Jezebel Euclid 2" : i == 2 ? "Jezebel Euclid 3" :
            nu_acco >= 0.5 ? (i == 3 ? "Jezebel Any Reset" : i == 4 ? "Jezebel Clock" : "Jezebel All Reset") :
            (i == 3 ? "Jezebel Reset 1" : i == 4 ? "Jezebel Reset 2" : "Jezebel Reset 3"));
        ) : (
          set_midi_note_name(0, nu_note(i) | 0, (nu_chan - 1) | 0,
            i == 0 ? "Jezebel 1 (BD)" : i == 1 ? "Jezebel 2 (SD)" : i == 2 ? "Jezebel 3 (HH)" :
            nu_acco >= 0.5 ? (i == 3 ? "Jezebel Accent" : i == 4 ? "Jezebel Clock" : "Jezebel Reset") :
            (i == 3 ? "Jezebel Accent 1" : i == 4 ? "Jezebel Accent 2" : "Jezebel Accent 3"));
        );
      );
      i -= 1;
    );
  );
);

rnd_seed(1);
pg_reset();
m_el = 0; m_ph = 0;
eticks = 0;
was_run = 0;
g_step = -1;
nn_key = -1;

@slider
last_srate != srate ? (
  last_srate = srate;
  m_sr = (srate);
  m_key = -1;
);
nn_update();

@block
oq_n = 0;
while (midirecv(mofs, mm1, mm2, mm3)) ( nu_thru >= 0.5 ? q_out(mofs, mm1, mm2, mm3); );

pg_params();
nn_update();
a_aux = nu_aux >= 0.5;
a_chan = (nu_chan - 1) | 0;
a_gate = nu_gate >= 0.5;
a_free = nu_clock >= 0.5;
a_lensmp = floor(nu_len * 0.001 * srate + 0.5);
a_rst = nu_rst >= 0.5 && !a_prst;
a_prst = nu_rst >= 0.5;
pk = pg_x + 256 * (pg_y + 256 * (DENS[0] + 256 * (DENS[1] + 256 * (DENS[2] + 256 * (pg_mode + 4 * pg_chaos)))));
pk !== pat_key ? ( pat_key = pk; pat_update(); );

(a_free !== a_pfree || a_chan !== a_pchan) ? all_off();
a_pfree = a_free; a_pchan = a_chan;

a_free ? (
  a_mom = nu_rmode >= 0.5;
  a_running = nu_run >= 0.5;
  m_sw = max(0, min((0.9), (nu_swing)));
  m_tp = (nu_bpm);
  mk = m_tp + 1000 * m_sw;
  mk !== m_key ? (
    m_key = mk;
    m_inclo = m_tempo((m_tp / (1 + m_sw)));
    m_inchi = m_tempo((m_tp / (1 - m_sw)));
  );
  !a_running && was_run ? all_off();
  b_s = 0;
  loop(samplesblock,
    (a_mom && !a_running) ? ( m_ph = 0; m_el = 1; );
    (b_s == 0 && a_rst) ? ( pg_reset(); m_ph = 0; m_el = 1; eticks = 0; );
    b_inc = eticks < 6 ? m_inclo : m_inchi;
    b_pv = m_ph;
    m_ph = m_el;
    m_ph >= 1 ? m_ph -= 1;
    m_el = (m_el + b_inc);
    m_el >= 1 ? m_el -= 1;
    (a_running && b_pv > m_ph) ? (
      eticks = (eticks + 1) % 12;
      b_i = 0;
      loop(6, (NACT[b_i] && !GTF[b_i] && OFFT[b_i] <= b_s) ? nu_off(b_i, OFFT[b_i]); b_i += 1;);
      pg_tick(1);
      nu_emit(b_s, a_lensmp, a_gate);
    );
    (g_any && m_el >= 0.5) ? (
      b_i = 0;
      loop(6, (NACT[b_i] && GTF[b_i]) ? nu_off(b_i, b_s); b_i += 1;);
      g_any = 0;
    );
    b_s += 1;
  );
  b_i = 0;
  loop(6,
    (NACT[b_i] && !GTF[b_i]) ? ( OFFT[b_i] < samplesblock ? nu_off(b_i, OFFT[b_i]) : OFFT[b_i] -= samplesblock; );
    b_i += 1;
  );
  was_run = a_running;
  !a_running ? g_step = -1;
) : (
  a_inc = nu_res < 0.5 ? 6 : nu_res < 1.5 ? 3 : 1;
  a_sw = a_inc == 1 ? max(0, min(0.9, nu_swing)) : 0;
  a_run = play_state & 1;
  a_run ? (
    a_tps = tempo / 60 * 24 / srate;
    a_p0 = beat_position * 24;
    a_jump = (!was_run || abs(a_p0 - a_pexp) > 0.1 || a_inc !== a_pinc || a_sw !== a_psw);
    a_jump ? nu_resync(a_p0);
    a_p1 = a_p0 + samplesblock * a_tps;
    a_done = 0;
    while (!a_done) (
      a_tn = sw_t(n_next);
      a_tick = a_tn < a_p1 ? max(0, floor((a_tn - a_p0) / a_tps + 0.001)) : samplesblock * 2;
      a_oi = -1;
      a_om = a_tick;
      a_i = 0;
      loop(6,
        (NACT[a_i] && OFFT[a_i] < samplesblock && OFFT[a_i] <= a_om) ? ( a_om = OFFT[a_i]; a_oi = a_i; );
        a_i += 1;
      );
      a_oi >= 0 ? (
        nu_off(a_oi, floor(a_om));
      ) : a_tick < samplesblock ? (
        a_gd = floor((sw_t(n_next + a_inc) - a_tn) * 0.5 / a_tps + 0.5);
        pg_tick(a_inc);
        nu_emit(a_tick, a_gate ? max(1, a_gd) : a_lensmp, 0);
        n_next += a_inc;
      ) : (
        a_done = 1;
      );
    );
    a_i = 0;
    loop(6, NACT[a_i] ? OFFT[a_i] -= samplesblock; a_i += 1;);
    a_pexp = a_p1;
    a_pinc = a_inc;
    a_psw = a_sw;
    was_run = 1;
  ) : (
    was_run ? all_off();
    was_run = 0;
    g_step = -1;
