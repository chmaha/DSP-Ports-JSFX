slider1:nu_x=0<0,1,0.001>-Map X
slider2:nu_y=0<0,1,0.001>-Map Y
slider3:nu_chaos=0<0,1,0.001>-Chaos
slider4:nu_f1=0.5<0,1,0.001>-Fill 1
slider5:nu_f2=0.5<0,1,0.001>-Fill 2
slider6:nu_f3=0.5<0,1,0.001>-Fill 3
slider7:nu_swing=0<0,0.9,0.001>-Swing
slider8:nu_bpm=120<40,240,0.1>-Free Tempo (BPM)
slider9:nu_mode=0<0,2,1{Henri,Original,Euclidean}>-Sequencer Mode
slider10:nu_clock=0<0,1,1{Follow Transport,Free}>-Clock
slider11:nu_res=2<0,2,1{4 PPQN,8 PPQN,24 PPQN}>-Transport Resolution
slider12:nu_gate=0<0,1,1{Trigger,Gate}>-Note Output
slider13:nu_acco=0<0,1,1{Individual Accents,Accent / Clock / Reset}>-Extra Outputs
slider14:nu_aux=0<0,1,1{Off,On}>-Extra Output Notes
slider15:nu_rmode=0<0,1,1{Toggle,Momentary}>-Run Mode
slider16:nu_run=0<0,1,1{Stopped,Running}>-Free Run
slider17:nu_rst=0<0,1,1{Off,Reset}>-Reset
slider18:nu_n1=36<0,127,1>-Note 1
slider19:nu_n2=38<0,127,1>-Note 2
slider20:nu_n3=42<0,127,1>-Note 3
slider21:nu_a1=35<0,127,1>-Extra Note 1
slider22:nu_a2=40<0,127,1>-Extra Note 2
slider23:nu_a3=46<0,127,1>-Extra Note 3
slider24:nu_chan=10<1,16,1>-MIDI Channel
slider25:nu_vel=100<1,127,1>-Velocity
slider26:nu_accv=127<1,127,1>-Accent Velocity
slider27:nu_len=10<1,100,1>-Trigger Length (ms)
slider28:nu_thru=1<0,1,1{Off,On}>-MIDI Thru
slider29:nu_anim=1<0,1,1{Off,On}>-Animation

