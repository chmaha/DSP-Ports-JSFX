!g_tab ? ( g_tab = 1; ui_inittables(); );

function ui_min(s) ( UMN[s]; );
function ui_max(s) ( UMX[s]; );
function ui_def(s) ( UDF[s]; );
function ui_stp(s) ( UST[s]; );
function ui_norm(s) ( (slider(s) - ui_min(s)) / (ui_max(s) - ui_min(s)); );
function ui_set(s, xv) local(lo, hi, st, nv, old)
(
  lo = ui_min(s); hi = ui_max(s); st = ui_stp(s);
  nv = max(lo, min(hi, xv));
  nv = lo + floor((nv - lo) / st + 0.5) * st;
  nv = max(lo, min(hi, nv));
  old = slider(s);
  slider(s) = nv;
  nv !== old ? automate(s, 0);
);
function ui_setn(s, nn) ( ui_set(s, ui_min(s) + max(0, min(1, nn)) * (ui_max(s) - ui_min(s))); );
function ui_put(s, xv) ( ui_set(s, xv); automate(s, 1); );

function ui_px(u) ( uox + u * UQ; );
function ui_py(v) ( v * UQ; );
function ui_hit(hx, hy, hw, hh) ( mouse_x >= hx && mouse_x < hx + hw && mouse_y >= hy && mouse_y < hy + hh; );
function ui_hitc(cx, cy, rr) ( sqr(mouse_x - cx) + sqr(mouse_y - cy) <= sqr(rr); );
function ui_font(fs, b) ( gfx_setfont(1, "Arial", max(11, floor(fs + 0.5)), b ? 'b' : 0); );
function ui_ctext(str, cx, cy, fs, b) local(tw, th)
(
  ui_font(fs, b);
  gfx_measurestr(str, tw, th);
  gfx_x = floor(cx - tw * 0.5 + 0.5); gfx_y = floor(cy - th * 0.5 + 0.5);
  gfx_drawstr(str);
);
function ui_ltext(str, lx, cy, fs, b) local(tw, th)
(
  ui_font(fs, b);
  gfx_measurestr(str, tw, th);
  gfx_x = floor(lx + 0.5); gfx_y = floor(cy - th * 0.5 + 0.5);
  gfx_drawstr(str);
);
function ui_rtext(str, rx, cy, fs, b) local(tw, th)
(
  ui_font(fs, b);
  gfx_measurestr(str, tw, th);
  gfx_x = floor(rx - tw + 0.5); gfx_y = floor(cy - th * 0.5 + 0.5);
  gfx_drawstr(str);
);
function ui_rect(u, v, w, h) local(x0, y0)
(
  x0 = floor(ui_px(u) + 0.5); y0 = floor(ui_py(v) + 0.5);
  gfx_rect(x0, y0, max(1, floor(ui_px(u + w) + 0.5) - x0), max(1, floor(ui_py(v + h) + 0.5) - y0));
);
function ui_grey(c) ( gfx_set(c / 255, c / 255, c / 255, 1); );
function ui_utext(str, u, v, fs, b) ( ui_ctext(str, ui_px(u), ui_py(v), fs * UQ, b); );

function ui_click_at(s, sc)
(
  (u_ctarget == s && time_precise() - u_ctime < 0.3) ? (
    ui_put(s, ui_def(s));
    u_drag = 0;
  ) : (
    u_drag = s; u_dy0 = mouse_y; u_dv0 = ui_norm(s); u_dfine = mouse_cap & 4; u_dsc = sc;
  );
  u_ctarget = s; u_ctime = time_precise();
  u_click = 0;
);

function ui_wheel(s) local(st)
(
  st = ui_stp(s);
  st >= 1 ? ui_put(s, slider(s) + (u_wheel > 0 ? 1 : -1) * st)
          : ( ui_setn(s, ui_norm(s) + (u_wheel / 120) * ((mouse_cap & 4) ? 0.002 : 0.02)); automate(s, 1); );
  u_wheel = 0;
);

function ui_kcol(col, k)
(
  col == 0 ? gfx_set(0.18 * k, 0.50 * k, 0.93 * k, 1) :
  col == 1 ? gfx_set(0.88 * k, 0.05 * k, 0.05 * k, 1) :
  col == 2 ? gfx_set(0.96 * k, 0.48 * k, 0.05 * k, 1) :
  col == 3 ? gfx_set(0.98 * k, 0.83 * k, 0.10 * k, 1) :
             gfx_set(0.93 * k, 0.93 * k, 0.93 * k, 1);
);

function ui_bar(cx, cy, ca, sa, r0, r1, hw) local(x0, y0, x1, y1, xx, yy, dx, dy, ss, tt, cv)
(
  x0 = floor(min(cx + sa * r0, cx + sa * r1) - hw - 2); x1 = ceil(max(cx + sa * r0, cx + sa * r1) + hw + 2);
  y0 = floor(min(cy - ca * r0, cy - ca * r1) - hw - 2); y1 = ceil(max(cy - ca * r0, cy - ca * r1) + hw + 2);
  yy = y0;
  loop(y1 - y0 + 1,
    xx = x0;
    loop(x1 - x0 + 1,
      dx = xx + 0.5 - cx; dy = yy + 0.5 - cy;
      ss = dx * sa - dy * ca; tt = dx * ca + dy * sa;
      cv = max(0, min(1, min(ss - r0, r1 - ss) + 0.5)) * max(0, min(1, hw - abs(tt) + 0.5));
      cv > 0 ? ( gfx_a = cv; gfx_rect(xx, yy, 1, 1); );
      xx += 1;
    );
    yy += 1;
  );
  gfx_a = 1;
);

function ui_knob(s, cu, cv, ru, col) local(cx, cy, rr, hov, nn, ang, ca, sa, k, ta)
(
  cx = ui_px(cu); cy = ui_py(cv); rr = ru * UQ;
  hov = ui_hitc(cx, cy, rr + 2);
  hov ? u_hov = s;
  (u_click && hov) ? ui_click_at(s, 200 * uscale);
  (hov && u_wheel != 0 && u_drag == 0) ? ui_wheel(s);
  nn = max(0, min(1, ui_norm(s)));
  ang = (-0.75 + 1.5 * nn) * $pi;
  ca = cos(ang); sa = sin(ang);
  gfx_set(0, 0, 0, 1); gfx_circle(cx, cy, rr, 1, 1);
  gfx_set(0.22, 0.22, 0.22, 1); gfx_circle(cx, cy, rr * 0.80, 0, 1);
  ui_kcol(col, hov || u_drag == s ? 1 : 0.94); gfx_circle(cx, cy, rr * 0.62, 1, 1);
  ui_bar(cx, cy, ca, sa, rr * 0.45, rr * 0.97, max(1, rr * 0.055));
);

function ui_lamp(cx, cy, rr, on)
(
  on > 0.01 ? (
    gfx_set(1, 0.1, 0.05, 0.28 * on); gfx_circle(cx, cy, rr * 1.8, 1, 1);
    gfx_set(0.24 + 0.76 * on, 0.06 + 0.04 * on, 0.05, 1); gfx_circle(cx, cy, rr, 1, 1);
    gfx_set(1, 1, 1, 0.35 * on); gfx_circle(cx - rr * 0.3, cy - rr * 0.3, rr * 0.35, 1, 1);
  ) : (
    gfx_set(0.24, 0.06, 0.05, 1); gfx_circle(cx, cy, rr, 1, 1);
  );
);

function ui_button(cu, cv, id, on, act) local(cx, cy, hov)
(
  cx = ui_px(cu); cy = ui_py(cv);
  hov = act && ui_hitc(cx, cy, 8 * UQ);
  hov ? u_hov = id;
  ui_grey(act ? 205 : 150); gfx_circle(cx, cy, 7.1 * UQ, 1, 1);
  ui_grey(act ? 120 : 95); gfx_circle(cx, cy, 7.1 * UQ, 0, 1);
  ui_lamp(cx, cy, 4.2 * UQ, on);
  hov ? ( gfx_set(1, 1, 1, 0.35); gfx_circle(cx, cy, 7.6 * UQ, 0, 1); );
  hov && u_click;
);

function ui_seg(s, u, v, w, h, n, lab0, lab1, lab2) local(k, x0, x1, y0, hov, sel, cw)
(
  cw = w / n;
  k = 0;
  sel = floor(slider(s) + 0.5);
  loop(n,
    x0 = u + k * cw;
    hov = ui_hit(floor(ui_px(x0)), floor(ui_py(v)), floor(ui_px(x0 + cw)) - floor(ui_px(x0)), floor(ui_py(v + h)) - floor(ui_py(v)));
    hov ? u_hov = s;
    (hov && u_click) ? ( ui_put(s, k); u_click = 0; );
    sel == k ? ui_grey(hov ? 238 : 225) : ui_grey(hov ? 92 : 70);
    ui_rect(x0 + 0.4, v, cw - 0.8, h);
    sel == k ? ui_grey(25) : ui_grey(232);
    ui_utext(k == 0 ? lab0 : k == 1 ? lab1 : lab2, x0 + cw * 0.5, v + h * 0.5, 6.4, sel == k);
    k += 1;
  );
  (u_wheel != 0 && u_drag == 0 && ui_hit(floor(ui_px(u)), floor(ui_py(v)), floor(w * UQ), floor(h * UQ))) ? (
    ui_put(s, max(0, min(n - 1, sel + (u_wheel > 0 ? 1 : -1))));
    u_wheel = 0;
  );
);

function ui_row(lab, v) ( ui_grey(232); ui_ltext(lab, ui_px(249), ui_py(v + 6), 6.6 * UQ, 0); );

function ui_numbox(s, u, v, w, h, kind, act) local(x0, y0, hov, val, nn)
(
  x0 = floor(ui_px(u)); y0 = floor(ui_py(v));
  hov = ui_hit(x0, y0, floor(w * UQ), floor(h * UQ));
  hov ? u_hov = s;
  (u_click && hov) ? ui_click_at(s, 220 * uscale);
  (hov && u_wheel != 0 && u_drag == 0) ? ui_wheel(s);
  ui_grey(hov || u_drag == s ? 30 : 22); ui_rect(u, v, w, h);
  ui_grey(act ? 120 : 80);
  gfx_rect(x0, y0, floor(w * UQ), 1); gfx_rect(x0, y0 + floor(h * UQ) - 1, floor(w * UQ), 1);
  gfx_rect(x0, y0, 1, floor(h * UQ)); gfx_rect(x0 + floor(w * UQ) - 1, y0, 1, floor(h * UQ));
  val = floor(slider(s) + 0.5);
  kind == 1 ? (
    nn = val - 12 * floor(val / 12);
    sprintf(#u_t, "%s%d %d", nn == 0 ? "C" : nn == 1 ? "C#" : nn == 2 ? "D" : nn == 3 ? "D#" : nn == 4 ? "E" : nn == 5 ? "F" :
            nn == 6 ? "F#" : nn == 7 ? "G" : nn == 8 ? "G#" : nn == 9 ? "A" : nn == 10 ? "A#" : "B", floor(val / 12) - 1, val);
  ) : kind == 2 ? sprintf(#u_t, "%d ms", val) : sprintf(#u_t, "%d", val);
  act ? ui_grey(235) : ui_grey(150);
  ui_utext(#u_t, u + w * 0.5, v + h * 0.5, 6.2, 0);
);

function ui_outbox(i, s, u, v, act) local(c, f)
(
  c = LEDV[i];
  c !== ULC[i] ? ( ULC[i] = c; ULC[10 + i] = 1; );
  f = ULC[10 + i];
  ui_numbox(s, u, v, 32, 13, 1, act);
  f > 0.02 ? ( gfx_set(1, 0.15, 0.08, 0.45 * f); ui_rect(u, v, 32, 13); ULC[10 + i] = f * u_decay; ) : ULC[10 + i] = 0;
);

function ui_static()
(
  gfx_dest = 10; gfx_setimgdim(10, gfx_w, gfx_h);
  ui_grey(40); gfx_rect(0, 0, gfx_w, gfx_h);
  g_pnl ? (
    gfx_set(1, 1, 1, 1);
    gfx_x = ui_px(0); gfx_y = ui_py(0);
    (g_pnl2 && uscale > 1.25) ? gfx_blit(21, uscale / 2, 0) : gfx_blit(20, uscale, 0);
  ) : (
    gfx_set(1, 1, 1, 1);
    ui_rect(0, 23.6, 240, 0.9); ui_rect(0, 356, 240, 0.9);
    ui_grey(83); ui_rect(96, 264.5, 138, 77.5);
    gfx_set(1, 1, 1, 1);
    ui_utext("Swing", 177, 90, 8, 0); ui_utext("Reset", 26.5, 152, 8, 0); ui_utext("Run", 85, 152, 8, 0);
    ui_utext("Clock", 26.5, 89.5, 8, 1);
    ui_utext("1", 129, 221, 8, 0); ui_utext("2", 165, 221, 8, 0); ui_utext("3", 201, 221, 8, 0);
    ui_utext("Fill", 111, 246.5, 8, 1); ui_utext("Trig", 111, 286, 8, 0); ui_utext("Acc", 111, 320.5, 8, 0);
  );
  g_mk ? (
    gfx_set(1, 1, 1, 1);
    gfx_x = 0; gfx_y = ui_py(24.5);
    (g_mk2 && uscale > 1.25) ? gfx_blit(23, uscale / 2, 0) : gfx_blit(22, uscale, 0);
  ) : (
    ui_grey(140);
    ui_ctext("Etoile polaire", u_sbx - SBU * 0.5 * UQ, ui_py(190), 7 * UQ, 0);
  );
  gfx_set(1, 1, 1, 1);
  ui_rect(240, 23.9, max(200, (gfx_w - uox) / UQ - 240), 1); ui_rect(240, 356, max(200, (gfx_w - uox) / UQ - 240), 0.9);
  ui_rect(240, 23.9, 0.9, 333);
  u_ox0 = uox; uox = u_sbx;
  ui_rect(-SBU, 23.9, SBU + (u_ox0 - u_sbx) / UQ, 1); ui_rect(-SBU, 356, SBU + (u_ox0 - u_sbx) / UQ, 0.9);
  ui_rect(-0.9, 23.9, 0.9, 333);
  uox = u_ox0;
  g_tt ? (
    gfx_y = 0;
    (g_tt2 && uscale > 1.25) ? ( gfx_x = floor((gfx_w - 1022 * uscale) * 0.5); gfx_blit(25, uscale / 2, 0); )
                             : ( gfx_x = floor((gfx_w - 1022 * uscale) * 0.5); gfx_blit(24, uscale, 0); );
  ) : ui_ctext("Jezebel", u_cx, ui_py(12.2), 18 * UQ, 0);
  gfx_set(0.80, 0.80, 0.80, 1);
  ui_rtext("by chmaha", u_sbx + 436 * UQ + u_slk, ui_py(7.6), 12 * uscale, 0);
  ui_rtext("based on Topograph by Dale Johnson (Valley Audio)", u_sbx + 436 * UQ + u_slk, ui_py(16.6), 11 * uscale, 0);
  ui_grey(232);
  ui_ltext("Pattern", ui_px(249), ui_py(33), 6.6 * UQ, 1);
  ui_row("Mode", 128); ui_row("Clock", 145); ui_row("Host Rate", 162); ui_row("Notes", 179);
  ui_row("Extra Outs", 196); ui_row("Extra Notes", 213); ui_row("Run Button", 230); ui_row("MIDI Thru", 247);
  ui_utext("Channel", 272, 270, 6.2, 0); ui_utext("Velocity", 318, 270, 6.2, 0); ui_utext("Accent", 364, 270, 6.2, 0); ui_utext("Trigger", 410, 270, 6.2, 0);
  gfx_dest = -1;
);

function ui_pattern() local(x0, y0, cw, rh, i, s, lv, hit, act, cur, len, thr, by, bh, eu)
(
  x0 = 249; y0 = 41; cw = 182 / 32; rh = 24;
  eu = floor(nu_mode + 0.5) == 2;
  ui_grey(22); ui_rect(x0 - 1, y0 - 1, 184, 3 * rh + 4);
  i = 0;
  loop(3,
    by = y0 + i * (rh + 1);
    len = eu ? (ELEN[i] >> 3) + 1 : 32;
    cur = eu ? (u_run ? ECNT[i] - len * floor(ECNT[i] / len) : -1) : (u_run ? g_step : -1);
    thr = 255 - DENS[i];
    s = 0;
    loop(32,
      lv = PATL[i * 32 + s];
      hit = HITS[i * 32 + s];
      act = s < len;
      act ? (
        ui_grey(s == cur ? 70 : (s & 7) == 0 ? 44 : 34);
        ui_rect(x0 + s * cw + 0.3, by, cw - 0.6, rh);
        eu ? (
          lv > 0 ? ( ui_kcol(i + 1, 0.55); ui_rect(x0 + s * cw + 1, by + rh * 0.3, cw - 2, rh * 0.4); );
        ) : (
          bh = rh * max(0, lv) / 255;
          lv > thr ? ui_kcol(i + 1, 0.55) : ui_grey(78);
          ui_rect(x0 + s * cw + 0.8, by + rh - bh, cw - 1.6, max(0.6, bh));
        );
        (hit > 0 && u_run) ? ( ui_kcol(i + 1, s == cur ? 1.15 : 0.95); ui_rect(x0 + s * cw + 1.2, by + 1, cw - 2.4, hit > 1 ? 3.2 : 2); );
      );
      s += 1;
    );
    !eu ? ( gfx_set(1, 1, 1, 0.35); ui_rect(x0, by + rh - rh * thr / 255, 182, 0.35); );
    i += 1;
  );
  gfx_set(0.70, 0.70, 0.72, 1);
  eu ? sprintf(#u_t, "Euclidean: lengths %d / %d / %d", (ELEN[0] >> 3) + 1, (ELEN[1] >> 3) + 1, (ELEN[2] >> 3) + 1)
     : strcpy(#u_t, "32 steps per bar, line = fill threshold");
  ui_rtext(#u_t, ui_px(431), ui_py(33), 5.6 * UQ, 0);
);

function ui_hint(h) local(v, k)
(
  h == 104 ? strcpy(#u_hint, nu_anim > 0.5 ? "Click the picture to switch the animation off" : "Click the picture to switch the animation on") :
  h == 101 ? strcpy(#u_hint, floor(nu_clock + 0.5) ? "Reset: back to step 1" : "Reset works on the Free clock") :
  h == 102 ? strcpy(#u_hint, floor(nu_clock + 0.5) ? (nu_rmode >= 0.5 ? "Run: hold to play" : "Run: click to start or stop") : "Following REAPER's transport") :
  h >= 1 && h <= 28 ? (
    v = slider(h); k = floor(v + 0.5);
    h == 1 ? (floor(nu_mode + 0.5) == 2 ? sprintf(#u_t, "Length 1: %d steps", (floor(v * 255) >> 3) + 1) : sprintf(#u_t, "Map X: %.1f%%", v * 100)) :
    h == 2 ? (floor(nu_mode + 0.5) == 2 ? sprintf(#u_t, "Length 2: %d steps", (floor(v * 255) >> 3) + 1) : sprintf(#u_t, "Map Y: %.1f%%", v * 100)) :
    h == 3 ? (floor(nu_mode + 0.5) == 2 ? sprintf(#u_t, "Length 3: %d steps", (floor(v * 255) >> 3) + 1) : sprintf(#u_t, "Chaos: %.1f%%", v * 100)) :
    h == 4 ? sprintf(#u_t, "Fill 1: %.1f%%", v * 100) :
    h == 5 ? sprintf(#u_t, "Fill 2: %.1f%%", v * 100) :
    h == 6 ? sprintf(#u_t, "Fill 3: %.1f%%", v * 100) :
    h == 7 ? sprintf(#u_t, "Swing: %.1f%% (Free clock, and Host Rate 24 PPQN)", v * 100) :
    h == 8 ? sprintf(#u_t, "Free tempo: %.1f BPM", v) :
    h == 9 ? strcpy(#u_t, k == 0 ? "Henri: Topograph's own blend of the map" : k == 1 ? "Original: the Grids blend of the map" : "Euclidean: X, Y, Chaos set lengths, Fills set hits") :
    h == 10 ? strcpy(#u_t, k ? "Free: runs on its own tempo knob" : "Transport: follows REAPER's tempo and position") :
    h == 11 ? sprintf(#u_t, "Host clock: %s", k == 0 ? "4 PPQN (no swing)" : k == 1 ? "8 PPQN (no swing)" : "24 PPQN") :
    h == 12 ? strcpy(#u_t, k ? "Gate: notes last half a clock tick" : "Trigger: notes last the Trigger time") :
    h == 13 ? strcpy(#u_t, k ? "Extra outputs: accent, clock, reset" : "Extra outputs: one accent per part") :
    h == 14 ? strcpy(#u_t, k ? "Extra outputs play their notes" : "Extra outputs off") :
    h == 15 ? strcpy(#u_t, k ? "Run button: momentary (hold)" : "Run button: toggle") :
    h == 28 ? strcpy(#u_t, k ? "MIDI thru on" : "MIDI thru off") :
    h >= 18 && h <= 23 ? sprintf(#u_t, "%s note: %d (drag or wheel)", h == 18 ? "Part 1" : h == 19 ? "Part 2" : h == 20 ? "Part 3" : h == 21 ? "Extra 1" : h == 22 ? "Extra 2" : "Extra 3", k) :
    h == 24 ? sprintf(#u_t, "MIDI channel %d", k) :
    h == 25 ? sprintf(#u_t, "Velocity %d", k) :
    h == 26 ? sprintf(#u_t, "Accent velocity %d", k) :
    h == 27 ? sprintf(#u_t, "Trigger length %d ms", k) : strcpy(#u_t, "");
    strcpy(#u_hint, #u_t);
  ) : strcpy(#u_hint, "Drag or wheel the knobs (Ctrl = fine, double-click = default)");
);

function na_h(i) local(x) ( x = sin(i * 127.1 + 311.7) * 43758.5453; x - floor(x); );
function na_n(t, seed) local(i, f, a, b)
(
  i = floor(t); f = t - i;
  a = na_h(i + seed * 101); b = na_h(i + 1 + seed * 101);
  a + (b - a) * f * f * (3 - 2 * f);
);

function na_box(img, k, x0, y0, w, h, sx, sy) local(fx, fy, xa, ya, xb, yb)
(
  fx = x0 * na_s; fy = na_py + y0 * na_s;
  xa = max(ceil(fx), 0); ya = max(ceil(fy), na_ymin);
  xb = min(floor(fx + w * na_s), na_xmax); yb = min(floor(fy + h * na_s), na_ymax);
  (xb > xa && yb > ya) ? gfx_blit(img, 1, 0, (sx + (xa - fx) / na_s) * k, (sy + (ya - fy) / na_s) * k,
                                  (xb - xa) / na_s * k, (yb - ya) / na_s * k, xa, ya, xb - xa, yb - ya);
);

function na_line(img, k, x0, w, yy, sx, sy) local(xa, xb)
(
  xa = max(ceil(x0 * na_s), 0); xb = min(floor((x0 + w) * na_s), na_xmax);
  xb > xa ? gfx_blit(img, 1, 0, (sx + xa / na_s - x0) * k, sy * k, (xb - xa) / na_s * k * 0.99999, k / na_s * 0.99999, xa, yy, xb - xa, 1);
);

function nw_field(t, g) local(n, j, i, p, w, xn, yn, a, d)
(
  a = 3.4 * g * na_amp;
  nw_a = a;
  n = 0; j = 0; p = NWT;
  loop(nw_ny + 1,
    yn = nw_y0 + j * nw_c;
    i = 0;
    loop(nw_nx,
      w = p[0];
      w > 0.002 ? (
        xn = i * nw_c;
        NWX[n] = w * a * (0.8 * sin(2 * $pi * (t / 2.6 - yn / 105 - xn / 220)) + 0.5 * sin(2 * $pi * (t / 1.7 - yn / 77) + 1.3)
                          + 0.35 * sin(2 * $pi * (t / 4.1 - yn / 200) + 2.1));
        NWY[n] = w * a * 0.45 * sin(2 * $pi * (t / 3.3 - yn / 140 + xn / 180) + 0.4);
      ) : ( NWX[n] = 0; NWY[n] = 0; );
      w = p[1];
      w > 0.002 ? (
        xn = i * nw_c; d = p[2];
        w *= 1.6 * a;
        NWX[n] += w * (0.8 * sin(2 * $pi * (t / 2.45 - d / 100 + xn / 260) + 0.9) + 0.5 * sin(2 * $pi * (t / 1.8 - d / 74) + 2.4)
                       + 0.35 * sin(2 * $pi * (t / 3.9 - d / 190) + 0.6));
        NWY[n] += w * 0.45 * sin(2 * $pi * (t / 3.1 - d / 130 + xn / 170) + 1.7);
      );
      n += 1; i += 1; p += 3;
    );
    j += 1;
  );
);

function nb_field(t) local(n, j, i, k, p, w, xn, yn, tt, l, li, m0, m1, ab, ar)
(
  k = 0;
  loop(nb_nl,
    tt = t - k * 0.05;
    NWL[k] = 0.8 * sin(2 * $pi * (tt / 2.6 - nb_ry / 105 - nb_rx / 220)) + 0.5 * sin(2 * $pi * (tt / 1.7 - nb_ry / 77) + 1.3)
             + 0.35 * sin(2 * $pi * (tt / 4.1 - nb_ry / 200) + 2.1);
    NWL[100 + k] = 0.45 * sin(2 * $pi * (tt / 3.3 - nb_ry / 140 + nb_rx / 180) + 0.4);
    k += 1;
  );
  ab = 0.35 * nw_a; ar = 1.1 * na_amp;
  n = 0; j = 0; p = NBT;
  loop(nb_ny + 1,
    yn = nb_y0 + j * nb_c;
    i = 0;
    loop(nb_nx,
      NBX[n] = 0; NBY[n] = 0;
      w = p[0];
      w > 0.002 ? (
        l = p[1] * 20; li = floor(l); l -= li;
        m0 = NWL[li]; m1 = NWL[100 + li];
        w *= ab;
        NBX[n] = w * (m0 + (NWL[li + 1] - m0) * l);
        NBY[n] = w * (m1 + (NWL[101 + li] - m1) * l);
      );
      w = p[2];
      w > 0.002 ? (
        xn = nb_x0 + i * nb_c; w *= ar;
        NBX[n] += w * sin(2 * $pi * (t / 4.4 - yn / 60 + xn / 140));
        NBY[n] += w * 0.35 * sin(2 * $pi * (t / 5.3 - yn / 80 + xn / 90) + 1);
      );
      n += 1; i += 1; p += 3;
    );
    j += 1;
  );
);

function nh_field(t) local(n, j, i, p, ga, gb, gc, cx, cy, pa, pb, ka, kb, xn, yn, wc, wa, wb, fa, fb)
(
  ga = sin(2 * $pi * t / 6.2) * (0.85 + 0.3 * (na_n(t * 0.23, 71) - 0.5)) * na_amp;
  gb = sin(2 * $pi * t / 6.2 - 0.5 + 0.6 * (na_n(t * 0.17, 73) - 0.5)) * (0.85 + 0.3 * (na_n(t * 0.21, 75) - 0.5)) * na_amp;
  gc = 0.45 * (ga + gb);
  cx = -0.2 * gc; cy = -gc;
  pa = 0.035 * ga; pb = -0.035 * gb; ka = 0.045 * ga; kb = -0.045 * gb;
  n = 0; p = NHT; j = 0;
  loop(nh_ny + 1,
    yn = nh_y0 + j * nh_c;
    i = 0;
    loop(nh_nx,
      wc = p[0];
      wc > 0.002 ? (
        xn = nh_x0 + i * nh_c;
        wa = p[1] * pa; wb = p[2] * pb; fa = p[3] * ka; fb = p[4] * kb;
        NHX[n] = wc * cx + wa * (nh_pay - yn) + wb * (nh_pby - yn) + fa * (nh_fay - yn) + fb * (nh_fby - yn);
        NHY[n] = wc * cy + wa * (xn - nh_pax) + wb * (xn - nh_pbx) + fa * (xn - nh_fax) + fb * (xn - nh_fbx);
      ) : ( NHX[n] = 0; NHY[n] = 0; );
      n += 1; i += 1; p += 5;
    );
    j += 1;
  );
);

function nw_draw(img, GX, GY, gx0, gy0, c, nx, ny, s, xb, py, ytop, ybot, ox, oy, sx0, sx1, sy0, sy1)
  local(j, i, n0, n1, xa, xc, ya, yc, cw, chh, s00, t00, s10, t10, s01, t01, s11, t11, mx, sw, sh)
(
  img == 10 ? ( sw = gfx_w; sh = gfx_h; ) : ( sw = sx1 + 1.01; sh = sy1 + 1.01; );
  gfx_set(1, 1, 1, 1, 0);
  j = 0;
  loop(ny,
    ya = max(ytop, floor(py + (gy0 + j * c) * s)); yc = min(ybot, floor(py + (gy0 + (j + 1) * c) * s));
    chh = yc - ya;
    i = 0;
    chh > 0 ? loop(nx - 1,
      n0 = j * nx + i; n1 = n0 + nx;
      mx = max(max(abs(GX[n0]), abs(GX[n0 + 1])), max(abs(GX[n1]), abs(GX[n1 + 1])));
      mx = max(mx, max(max(abs(GY[n0]), abs(GY[n0 + 1])), max(abs(GY[n1]), abs(GY[n1 + 1]))));
      xa = floor((gx0 + i * c) * s); xc = min(xb, floor((gx0 + (i + 1) * c) * s));
      cw = xc - xa;
      (mx > 0.03 && cw > 0) ? (
        s00 = max(sx0, min(sx1, xa - ox - GX[n0] * s)); t00 = max(sy0, min(sy1, ya - oy - GY[n0] * s));
        s10 = max(sx0, min(sx1, xc - ox - GX[n0 + 1] * s)); t10 = max(sy0, min(sy1, ya - oy - GY[n0 + 1] * s));
        s01 = max(sx0, min(sx1, xa - ox - GX[n1] * s)); t01 = max(sy0, min(sy1, yc - oy - GY[n1] * s));
        s11 = max(sx0, min(sx1, xc - ox - GX[n1 + 1] * s)); t11 = max(sy0, min(sy1, yc - oy - GY[n1 + 1] * s));
        gfx_deltablit(img, s00, t00, sw, sh, xa, ya, cw, chh,
          (s10 - s00) / cw, (t10 - t00) / cw, (s01 - s00) / chh, (t01 - t00) / chh,
          (s11 - s10 - s01 + s00) / (cw * chh), (t11 - t10 - t01 + t00) / (cw * chh), 0);
      );
      i += 1;
    );
    j += 1;
  );
);

function nb_draw() local(bx0, by0, bw, bh)
(
  nb_field(na_t);
  bx0 = max(0, floor(nb_x0 * na_s) - 1); by0 = max(na_ymin, floor(na_py + nb_y0 * na_s) - 1);
  bw = min(na_xmax, ceil((nb_x0 + (nb_nx - 1) * nb_c) * na_s) + 1) - bx0;
  bh = min(na_ymax, ceil(na_py + (nb_y0 + nb_ny * nb_c) * na_s) + 1) - by0;
  (bw > 2 && bh > 2) ? (
    (nb_bw != bw || nb_bh != bh) ? ( gfx_setimgdim(41, bw, bh); nb_bw = bw; nb_bh = bh; );
    gfx_set(1, 1, 1, 1, 0);
    gfx_dest = 41;
    gfx_blit(-1, 1, 0, bx0, by0, bw, bh, 0, 0, bw, bh);
    gfx_dest = -1;
    nw_draw(41, NBX, NBY, nb_x0, nb_y0, nb_c, nb_nx, nb_ny, na_s, na_xmax, na_py, na_ymin, na_ymax, bx0, by0, 0, bw - 1.01, 0, bh - 1.01);
  );
);

function ne_draw() local(n, j, i, w, xn, yn, a, t, bx0, by0, bw, bh)
(
  t = na_t; a = nw_a;
  n = 0; j = 0;
  loop(ne_ny + 1,
    yn = ne_y0 + j * ne_c;
    i = 0;
    loop(ne_nx,
      w = NET[n];
      w > 0.002 ? (
        xn = ne_x0 + i * ne_c;
        NEX[n] = w * a * (0.8 * sin(2 * $pi * (t / 2.6 - yn / 105 - xn / 220)) + 0.5 * sin(2 * $pi * (t / 1.7 - yn / 77) + 1.3)
                          + 0.35 * sin(2 * $pi * (t / 4.1 - yn / 200) + 2.1));
        NEY[n] = w * a * 0.45 * sin(2 * $pi * (t / 3.3 - yn / 140 + xn / 180) + 0.4);
      ) : ( NEX[n] = 0; NEY[n] = 0; );
      n += 1; i += 1;
    );
    j += 1;
  );
  bx0 = max(0, floor(ne_x0 * na_s) - 1); by0 = max(na_ymin, floor(na_py + ne_y0 * na_s) - 1);
  bw = min(na_xmax, ceil((ne_x0 + (ne_nx - 1) * ne_c) * na_s) + 1) - bx0;
  bh = min(na_ymax, ceil(na_py + (ne_y0 + ne_ny * ne_c) * na_s) + 1) - by0;
  (bw > 2 && bh > 2) ? (
    (ne_bw != bw || ne_bh != bh) ? ( gfx_setimgdim(42, bw, bh); ne_bw = bw; ne_bh = bh; );
    gfx_set(1, 1, 1, 1, 0);
    gfx_dest = 42;
    gfx_blit(-1, 1, 0, bx0, by0, bw, bh, 0, 0, bw, bh);
    gfx_dest = -1;
    nw_draw(42, NEX, NEY, ne_x0, ne_y0, ne_c, ne_nx, ne_ny, na_s, na_xmax, na_py, na_ymin, na_ymax, bx0, by0, 0, bw - 1.01, 0, bh - 1.01);
  );
);

function nh_draw() local(bx0, by0, bw, bh)
(
  nh_field(na_t);
  bx0 = max(0, floor(nh_x0 * na_s) - 1); by0 = max(na_ymin, floor(na_py + nh_y0 * na_s) - 1);
  bw = min(na_xmax, ceil((nh_x0 + (nh_nx - 1) * nh_c) * na_s) + 1) - bx0;
  bh = min(na_ymax, ceil(na_py + (nh_y0 + nh_ny * nh_c) * na_s) + 1) - by0;
  (bw > 2 && bh > 2) ? (
    (nh_bw != bw || nh_bh != bh) ? ( gfx_setimgdim(40, bw, bh); nh_bw = bw; nh_bh = bh; );
    gfx_set(1, 1, 1, 1, 0);
    gfx_dest = 40;
    gfx_blit(-1, 1, 0, bx0, by0, bw, bh, 0, 0, bw, bh);
    gfx_dest = -1;
    nw_draw(40, NHX, NHY, nh_x0, nh_y0, nh_c, nh_nx, nh_ny, na_s, na_xmax, na_py, na_ymin, na_ymax, bx0, by0, 0, bw - 1.01, 0, bh - 1.01);
  );
);

function na_draw() local(t, on, k, img, r, yu, y2, wf, lean, nod, dx, dy, gust, rp, sw, sg, kk, ph, i, p, n, bl, lv, ta, sph, a0, env, d, a, hp, hi, hj, hf, swl, fl, cx, cy, u, pr, ag, rr, mx, my, ci)
(
  !na_t0 ? na_t0 = time_precise();
  t = time_precise() - na_t0;
  on = (play_state & 1) && nu_anim > 0.5;
  on ? ( na_amp = min(1, na_amp + 0.02); na_fade = min(1, na_fade + 0.05); )
     : ( na_amp *= 0.97; na_amp < 0.002 ? na_amp = 0; na_fade = max(0, na_fade - 0.05); );
  (g_mk && (na_amp > 0 || na_fade > 0)) ? (
    k = (g_mk2 && uscale > 1.25) ? 2 : 1;
    na_s = uscale; na_py = floor(ui_py(24.5));
    na_xmax = floor(u_sbx - 0.9 * UQ + 0.5); na_ymin = floor(ui_py(24.9) + 0.5); na_ymax = floor(ui_py(356) + 0.5);
    gfx_set(1, 1, 1, 1, 0);
    na_amp > 0 ? (
      gust = 1.0 + 0.45 * na_n(t * 0.25, 7);
      nw_field(t, gust);
      nw_draw(10, NWX, NWY, 0, nw_y0, nw_c, nw_nx, nw_ny, na_s, na_xmax, na_py, na_ymin, na_ymax, 0, 0, 0, na_xmax - 1.01, na_ymin, na_ymax - 1.01);
      na_t = t; nb_draw(); ne_draw();
    );
    (na_amp > 0 && NAG[9 + k]) ? (
      img = k == 2 ? 37 : 36;
      lean = (1.4 * sin(2 * $pi * t / 8.3 + 0.7) + 1.2 * (na_n(t * 0.35, 3) - 0.5)) * na_amp;
      nod = 0.6 * sin(2 * $pi * t / 5.9) * na_amp;
      r = max(na_ymin, ceil(na_py));
      loop(min(na_ymax, floor(na_py + 103 * na_s)) - r,
        yu = (r - na_py) / na_s; y2 = 2 * yu;
        wf = max(0, (205 - y2) / 205); wf *= wf;
        dx = lean * wf * 0.5; dy = nod * wf * 0.5;
        (abs(dx) > 0.004 || abs(dy) > 0.004) ? na_line(img, k, 120, 105, r, 3 - dx, 3 + yu - dy);
        r += 1;
      );
    );
    na_fade > 0 ? (
      gfx_set(1, 1, 1, 1, 1);
      NAG[5 + k] ? (
        img = k == 2 ? 33 : 32;
        ta = t - 2; kk = floor(ta / 7.5); sph = (ta - kk * 7.5) / 3;
        sph < 1 ? (
          a0 = -2.6 + 3.6 * sph; env = sin($pi * sph);
          i = 0;
          loop(na_nb,
            p = NAB + i * 6;
            d = p[0] - a0; d -= 2 * $pi * floor((d + $pi) / (2 * $pi));
            a = 0.38 * env * na_fade * exp(-d * d / 0.0968);
            a > 0.002 ? ( gfx_a = a; na_box(img, k, p[1], p[2], p[3], p[4], 0, p[5]); );
            i += 1;
          );
        );
      );
      hp = t / 7 + 1.5 * na_n(t * 0.11, 41);
      hi = floor(hp); hf = hp - hi; hf = hf * hf * (3 - 2 * hf);
      hi -= 4 * floor(hi / 4); hj = hi + 1; hj -= 4 * floor(hj / 4);
      swl = 0.5 + 0.5 * sin(2 * $pi * t / 6.1) * (0.6 + 0.4 * na_n(t * 0.3, 43));
      kk = floor(t / 5.5); ph = t - kk * 5.5 - 0.8 - 3 * na_h(kk + 70);
      fl = ph < 0 ? exp(-(ph / 0.25) * (ph / 0.25)) : exp(-ph / 1.0);
      ph < -1 ? fl = 0;
      cx = 102.5; cy = 64;
      NAG[11 + k] ? (
        gfx_set(1, 1, 1, 1, 0);
        img = k == 2 ? 39 : 38;
        sg = (0.40 + 0.18 * swl + 0.14 * fl) * na_fade;
        gfx_a = sg * (1 - hf); na_box(img, k, 12, 0, 181, 154, 0, 154 * hi);
        gfx_a = sg * hf; na_box(img, k, 12, 0, 181, 154, 0, 154 * hj);
        gfx_set(1, 1, 1, 1, 1);
      );
      NAG[k - 1] ? (
        img = k == 2 ? 27 : 26;
        sg = (0.55 + 0.35 * swl + 0.5 * fl) * na_fade;
        gfx_a = sg * (1 - hf); na_box(img, k, 12, 0, 181, 154, 0, 154 * (hi + 1));
        gfx_a = sg * hf; na_box(img, k, 12, 0, 181, 154, 0, 154 * (hj + 1));
        gfx_a = (0.7 + 0.2 * na_n(t * 3, 45) + 0.6 * fl) * na_fade; na_box(img, k, 12, 0, 181, 154, 0, 0);
      );
      NAG[1 + k] ? (
        img = k == 2 ? 29 : 28;
        a = (0.16 + 0.8 * fl) * na_fade;
        a > 0.002 ? (
          gfx_a = a;
          gfx_blit(img, 1, 0.15 + 0.06 * t + 0.05 * sin(t * 0.7), 0, 0, 120 * k, 120 * k,
                   floor((cx - 60) * na_s + 0.5), floor(na_py + (cy - 60) * na_s + 0.5), floor(120 * na_s + 0.5), floor(120 * na_s + 0.5), 0, 0);
        );
        i = 0;
        loop(10,
          pr = 3.2 + 0.9 * na_h(i + 90);
          ag = t + pr * na_h(i + 95);
          kk = floor(ag / pr); u = (ag - kk * pr) / (pr * 0.85);
          u < 1 ? (
            rr = 3 + 52 * u ^ 0.85;
            a0 = 2 * $pi * na_h(kk * 7 + i) + (na_h(kk * 5 + i + 3) > 0.5 ? 1 : -1) * (1.1 + 0.6 * na_h(i + 99)) * u * pr * 0.85;
