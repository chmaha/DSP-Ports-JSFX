desc: Band Aid Multiband Distortion (mda Bandisto port) by chmaha
tags: distortion multiband saturation
author: chmaha
version: 1.0
changelog:
  Initial release.
about:
  Three-band distortion: split the signal at two crossover points and drive the low, mid and high
  bands into their own saturation, each with its own output level. Distorting the bands separately
  keeps a heavily driven sound clearer than one big distortion. Listen solos a band (in mono) to set it up.
  Bipolar mode saturates both halves of the waveform; Unipolar saturates only the negative half, like a
  single-ended valve stage, for a rougher, more even-harmonic sound.
  Ported from mda Bandisto by Paul Kellett (Maxim Digital Audio), via mda-effects
  https://github.com/pluginguru/mda-effects (MIT or GPLv2+)
  JSFX version released under GPLv3+ license
  Claude generated some of this code

slider1:p_listen=1<0,1,0.001>-Listen
slider2:p_x1=0.4<0,1,0.001>-L <> M
slider3:p_x2=0.5<0,1,0.001>-M <> H
slider4:p_ld=0.5<0,1,0.001>-L Dist
slider5:p_md=0.5<0,1,0.001>-M Dist
slider6:p_hd=0.5<0,1,0.001>-H Dist
slider7:p_lo=0.5<0,1,0.001>-L Out
slider8:p_mo=0.5<0,1,0.001>-M Out
slider9:p_ho=0.5<0,1,0.001>-H Out
slider10:p_mode=0.4<0,1,0.001>-Mode

in_pin:Left input
in_pin:Right input
out_pin:Left output
out_pin:Right output
options:no_meter

@init

ext_noinit = gfx_ext_retina = 1;
ext_nodenorm = 1;

function itrunc(x) ( x < 0 ? ceil(x) : floor(x); );

bd_b1 = bd_b2 = bd_l = 0;

function bd_set() local(m)
(
  bd_d1 = 10 ^ ((6 * p_ld * p_ld) - 1);
  bd_d2 = 10 ^ ((6 * p_md * p_md) - 1);
  bd_d3 = 10 ^ ((6 * p_hd * p_hd) - 1);
  bd_v = itrunc(1.99 * p_mode);
  bd_v ? (
    bd_t1 = 0.5; bd_t2 = 0.5; bd_t3 = 0.5;
  ) : (
    bd_t1 = 0.30000001192092896 * (10 ^ (4 * (p_ld ^ 3)));
    bd_t2 = 0.30000001192092896 * (10 ^ (4 * (p_md ^ 3)));
    bd_t3 = 0.30000001192092896 * (10 ^ (4 * (p_hd ^ 3)));
  );
  bd_t1 = bd_t1 * (10 ^ (2 * p_lo - 1));
  bd_t2 = bd_t2 * (10 ^ (2 * p_mo - 1));
  bd_t3 = bd_t3 * (10 ^ (2 * p_ho - 1));
  m = itrunc(p_listen * 5);
  m == 0 ? ( bd_t2 = 0; bd_t3 = 0; bd_sl = 0; ) :
  m == 1 ? ( bd_t1 = 0; bd_t3 = 0; bd_sl = 0; ) :
  m == 2 ? ( bd_t1 = 0; bd_t2 = 0; bd_sl = 0; ) : bd_sl = 0.5;
  bd_f1i = 10 ^ (p_x1 - 1.7); bd_f1o = 1 - bd_f1i;
  bd_f2i = 10 ^ (p_x2 - 1.05); bd_f2o = 1 - bd_f2i;
);

bd_set();

@slider

last_srate != srate ? (
  last_srate = srate;
  meter_decay = 0.001 ^ (1 / (0.4 * srate));
);
bd_set();

@block

bd_set();

@sample

ina = spl0; inb = spl1;
bd_a = spl0;
bd_b = spl1;
bd_s = (bd_a - bd_b) * bd_sl;
bd_a += (bd_b + 0.00002);
bd_b2 = (bd_f2i * bd_a) + (bd_f2o * bd_b2);
bd_b1 = (bd_f1i * bd_b2) + (bd_f1o * bd_b1);
bd_l = (bd_f1i * bd_b1) + (bd_f1o * bd_l);
bd_m = bd_b2 - bd_l;
bd_h = bd_a - bd_b2;
bd_g1 = 1 / (1 + bd_d1 * abs(bd_l));
bd_g2 = 1 / (1 + bd_d2 * abs(bd_m));
bd_g3 = 1 / (1 + bd_d3 * abs(bd_h));
bd_v ? ( bd_l > 0 ? bd_g1 = 1; bd_m > 0 ? bd_g2 = 1; bd_h > 0 ? bd_g3 = 1; );
bd_ol = bd_l * bd_g1 * bd_t1;
bd_om = bd_m * bd_g2 * bd_t2;
bd_oh = bd_h * bd_g3 * bd_t3;
bd_a = bd_ol + bd_om + bd_oh;
spl0 = bd_a + bd_s;
spl1 = bd_a - bd_s;

m_l = max(abs(ina), abs(inb));
m_l > ipk ? ipk = m_l : ipk *= meter_decay;
m_l = max(abs(spl0), abs(spl1));
m_l > opk ? opk = m_l : opk *= meter_decay;
m_l = abs(bd_ol); m_l > lpk ? lpk = m_l : lpk *= meter_decay;
m_l = abs(bd_om); m_l > mpk ? mpk = m_l : mpk *= meter_decay;
m_l = abs(bd_oh); m_l > hpk ? hpk = m_l : hpk *= meter_decay;

@gfx 860 380

DW = 860;
DH = 380;
scale = max(0.5, min(gfx_w / DW, gfx_h / DH));
ox = floor((gfx_w - DW*scale) * 0.5);
oy = 0;

MARGIN = 14*scale;
CW = 92*scale;
KR = 28*scale;
PANEL_H = 128*scale;

function automate(s, end_touch)
(
<?
  max_sliders > 10 ? printf("slider_automate(2^(s-1), end_touch);") :
    printf("s == 1 ? slider_automate(p_listen, end_touch) : s == 2 ? slider_automate(p_x1, end_touch) : s == 3 ? slider_automate(p_x2, end_touch) : s == 4 ? slider_automate(p_ld, end_touch) : s == 5 ? slider_automate(p_md, end_touch) : s == 6 ? slider_automate(p_hd, end_touch) : s == 7 ? slider_automate(p_lo, end_touch) : s == 8 ? slider_automate(p_mo, end_touch) : s == 9 ? slider_automate(p_ho, end_touch) : s == 10 ? slider_automate(p_mode, end_touch) :");
?> 0;
);

function set_slider(s, v) ( slider(s) = v; automate(s, 0); automate(s, 1); );
function hit_circle(mx, my, cx, cy, rad) ( sqr(mx - cx) + sqr(my - cy) <= sqr(rad); );
function hit_rect(mx, my, x, y, w, h) ( mx >= x && mx <= x+w && my >= y && my <= y+h; );

function def_val(s) ( s == 2 ? 0.4 : 0.5; );

function knob_name(s)
(
  s == 2 ? "L <> M" : s == 3 ? "M <> H" : (s >= 4 && s <= 6) ? "Dist" : "Out";
);

function x1_hz() ( srate * gfi1 * (0.098 + 0.09 * gfi1 + 0.5 * (gfi1 ^ 8.2)); );
function x2_hz() ( srate * gfi2 * (0.015 + 0.15 * gfi2 + 0.9 * (gfi2 ^ 8.2)); );

function hint_text(s)
(
  s == 1 ? "Listen: solo the low, mid or high band (mono) while setting it up, or hear the full output" :
  s == 2 ? "L <> M: crossover between the low and mid bands" :
  s == 3 ? "M <> H: crossover between the mid and high bands" :
  (s >= 4 && s <= 6) ? "Dist: how hard this band is driven into saturation" :
  (s >= 7 && s <= 9) ? "Out: level of this band, plus or minus 20 dB" :
  s == 10 ? "Mode: Bipolar saturates both halves of the wave; Unipolar only the negative half, like a valve" :
  "Drag or scroll a knob to adjust  ·  Ctrl for fine control  ·  double-click to reset";
);

function ptext(s)
(
  s == 2 ? sprintf(#ptxt, "%.0f Hz", x1_hz()) :
  s == 3 ? sprintf(#ptxt, "%.0f Hz", x2_hz()) :
  (s >= 4 && s <= 6) ? sprintf(#ptxt, "%.0f", 60 * slider(s)) :
  sprintf(#ptxt, "%.0f dB", 40 * slider(s) - 20);
  #ptxt;
);

function set_norm(s, v)
local(old)
(
  old = slider(s);
  slider(s) = floor(v*1000 + 0.5) / 1000;
  slider(s) !== old ? automate(s, 0);
);

function upper(str)
local(i, c)
(
  i = 0;
  loop(strlen(str),
    c = str_getchar(str, i);
    (c >= 97 && c <= 122) ? str_setchar(str, i, c - 32);
    i += 1;
  );
  str;
);

function draw_knob(cx, cy, rad, pos, cr, cg, cb, valtext, name)
local(ang0, ang1, ang, i, tx, ty)
(
  ang0 = -2.35619;
  ang1 =  2.35619;
  gfx_set(0.05, 0.05, 0.06, 1);
  gfx_circle(cx, cy, rad + 2*scale, 1, 1);
  gfx_set(cr*0.55, cg*0.55, cb*0.55, 1);
  gfx_circle(cx, cy, rad, 1, 1);
  gfx_set(cr, cg, cb, 1);
  gfx_circle(cx, cy, rad*0.72, 1, 1);
  gfx_set(1, 1, 1, 0.18);
  gfx_circle(cx - rad*0.28, cy - rad*0.28, rad*0.42, 1, 1);
  i = 0;
  loop(9,
    ang = ang0 + (ang1 - ang0) * (i / 8);
    gfx_set(0.85, 0.85, 0.85, 0.7);
    gfx_line(cx + sin(ang)*rad*0.82, cy - cos(ang)*rad*0.82, cx + sin(ang)*rad*0.98, cy - cos(ang)*rad*0.98, 1);
    i += 1;
  );
  ang = ang0 + (ang1 - ang0) * pos;
  gfx_set(0.05, 0.05, 0.05, 1);
  gfx_line(cx, cy, cx + sin(ang)*rad*0.85, cy - cos(ang)*rad*0.85, 1);
  gfx_setfont(1, "Arial", 14*scale);
  gfx_set(0.85, 0.85, 0.85, 1);
  gfx_measurestr(valtext, tx, ty);
  gfx_x = cx - tx*0.5; gfx_y = cy - rad - 18*scale;
  gfx_drawstr(valtext);
  gfx_set(0.8, 0.8, 0.82, 1);
  gfx_measurestr(name, tx, ty);
  gfx_x = cx - tx*0.5; gfx_y = cy + rad + 7*scale;
  gfx_drawstr(name);
);

function lcd_touch(s) ( lcd_sl = s; lcd_t = time_precise(); );

function row_begin(y, nk, ns)
(
  rx = ox + (DW*scale - (nk*CW + ns*8*scale + (ns - 1)*10*scale)) * 0.5;
  ry = oy + y;
);

function sec(nk, title, cr, cg, cb)
local(w, tw, th)
(
  w = nk*CW + 8*scale;
  gfx_set(0.035, 0.035, 0.04, 1);
  gfx_rect(rx - scale, ry - scale, w + 2*scale, PANEL_H + 2*scale, 1);
  gfx_set(0.125, 0.125, 0.14, 1);
  gfx_rect(rx, ry, w, PANEL_H, 1);
  gfx_set(cr, cg, cb, 0.8);
  gfx_rect(rx, ry, w, max(1, 2*scale), 1);
  gfx_setfont(1, "Arial", 12*scale, 'b');
  gfx_set(cr*0.75 + 0.15, cg*0.75 + 0.15, cb*0.75 + 0.15, 1);
  gfx_measurestr(title, tw, th);
  gfx_x = rx + (w - tw)*0.5; gfx_y = ry + 5*scale;
  gfx_drawstr(title);
  k_sx = rx + 4*scale; k_col = 0;
  k_r = cr; k_g = cg; k_b = cb;
  rx += w + 10*scale;
);

function seg_btn(s, x, y, w, h, label, act, fs)
local(tw, th, gap, hov)
(
  hov = hit_rect(mouse_x, mouse_y, x, y, w, h);
  hov ? hov_s = s;
  gap = max(1, scale);
  gfx_set(0.03, 0.03, 0.04, 1);
  gfx_rect(x - gap, y - gap, w + 2*gap, h + 2*gap, 1);
  act ? gfx_set(acc_r*0.62, acc_g*0.62, acc_b*0.62, 1) : gfx_set(hov ? 0.17 : 0.14, hov ? 0.17 : 0.14, hov ? 0.19 : 0.16, 1);
  gfx_rect(x, y, w, h, 1);
  act ? gfx_set(acc_r, acc_g, acc_b, 1) : gfx_set(0.21, 0.21, 0.24, 1);
  gfx_rect(x + gap, y + gap, w - 2*gap, h*0.5, 1);
  gfx_set(1, 1, 1, act ? 0.22 : 0.08);
  gfx_rect(x + gap, y + gap, w - 2*gap, h*0.3, 1);
  gfx_setfont(1, "Arial", fs*scale, 'b');
  act ? gfx_set(0.08, 0.08, 0.10, 1) : gfx_set(0.78, 0.78, 0.80, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + (w - tw)*0.5; gfx_y = y + (h - th)*0.5;
  gfx_drawstr(label);
  mouse_just_down && hov;
);

function knob_at(s, cx, cy, rad, cr, cg, cb)
local(hov, gv)
(
  hov = hit_circle(mouse_x, mouse_y, cx, cy, rad + 4*scale);
  hov ? hov_s = s;
  (mouse_just_down && hov) ? (
    (click_target == s && time_precise() - click_time < 0.3) ? (
      set_slider(s, def_val(s));
      drag_target = 0;
      lcd_touch(s);
    ) : (
      drag_target = s; drag_y0 = mouse_y; drag_v0 = slider(s); drag_fine = mouse_cap & 4;
    );
    click_target = s; click_time = time_precise();
  );
  (hov && mouse_wheel != 0 && drag_target == 0) ? (
    gv = slider(s) + (mouse_wheel / 120) * ((mouse_cap & 4) ? 0.001 : 0.01);
    set_norm(s, max(0, min(1, gv)));
    automate(s, 1);
    lcd_touch(s);
    mouse_wheel = 0;
  );
  draw_knob(cx, cy, rad, slider(s), cr, cg, cb, ptext(s), knob_name(s));
);

function knob(s)
local(cx, cy)
(
  cx = k_sx + CW*(k_col + 0.5);
  cy = ry + 72*scale;
  k_col += 1;
  knob_at(s, cx, cy, KR, k_r, k_g, k_b);
);

function glow_text(str, x, y, r, g, b)
(
  gfx_set(r, g, b, 0.16);
  gfx_x = x - scale; gfx_y = y; gfx_drawstr(str);
  gfx_x = x + scale; gfx_y = y; gfx_drawstr(str);
  gfx_x = x; gfx_y = y - scale; gfx_drawstr(str);
  gfx_x = x; gfx_y = y + scale; gfx_drawstr(str);
  gfx_set(r, g, b, 1);
  gfx_x = x; gfx_y = y; gfx_drawstr(str);
);

function meter(x, y, w, h, pk, label)
local(db, fy, tw, th)
(
  gfx_setfont(1, "Arial", 11*scale, 'b');
  gfx_set(0.62, 0.63, 0.66, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + w*0.5 - tw*0.5; gfx_y = y;
  gfx_drawstr(label);
  y += th + 3*scale;
  h -= th + 3*scale;
  gfx_set(0.04, 0.04, 0.05, 1);
  gfx_rect(x - scale, y - scale, w + 2*scale, h + 2*scale, 1);
  gfx_set(acc_r*0.22, acc_g*0.22, acc_b*0.22, 1);
  gfx_rect(x, y, w, h, 1);
  db = pk > 0.000001 ? 20 * log10(pk) : -100;
  fy = y + h * (1 - max(0, min(1, (db + 60) / 60)));
  db > -1 ? gfx_set(1.0, 0.35, 0.30, 1) : gfx_set(acc_r, acc_g, acc_b, 1);
  gfx_rect(x, fy, w, y + h - fy, 1);
);


mouse_down = mouse_cap & 1;
mouse_just_down = mouse_down && !mouse_state;
hov_s = 0;
gfi1 = 10 ^ (p_x1 - 1.7);
gfi2 = 10 ^ (p_x2 - 1.05);
g_lis = floor(p_listen * 5);
g_uni = floor(1.99 * p_mode) >= 1;
acc_r = 1.00; acc_g = 0.40; acc_b = 0.32;

gfx_set(0.09, 0.08, 0.08, 1);
gfx_rect(0, 0, gfx_w, gfx_h, 1);

gfx_setfont(1, "Arial", 20*scale, 'b');
gfx_set(acc_r, acc_g, acc_b, 1);
gfx_x = ox + MARGIN; gfx_y = oy + 8*scale;
gfx_drawstr("BAND AID");
gfx_setfont(1, "Arial", 13*scale);
gfx_set(0.58, 0.60, 0.64, 1);
gfx_x = ox + MARGIN + 2*scale; gfx_y = oy + 30*scale;
gfx_drawstr("by chmaha  ·  based on mda Bandisto");

TABW = 96*scale; TABH = 26*scale; TABG = 5*scale;
tx0 = ox + DW*scale - MARGIN - 2*TABW - TABG;
seg_btn(10, tx0, oy + 11*scale, TABW, TABH, "BIPOLAR", !g_uni, 14) ? ( set_slider(10, 0.25); mouse_just_down = 0; );
seg_btn(10, tx0 + TABW + TABG, oy + 11*scale, TABW, TABH, "UNIPOLAR", g_uni, 14) ? ( set_slider(10, 0.75); mouse_just_down = 0; );
g_uni = floor(1.99 * p_mode) >= 1;

gfx_set(0.04, 0.04, 0.05, 1);
gfx_rect(0, oy + 46*scale, gfx_w, max(1, scale), 1);

LX = ox + MARGIN; LY = oy + 56*scale; LW = 700*scale; LH = 96*scale;
gfx_set(0.03, 0.03, 0.04, 1);
gfx_rect(LX - 2*scale, LY - 2*scale, LW + 4*scale, LH + 4*scale, 1);
gfx_set(0.17, 0.17, 0.19, 1);
gfx_rect(LX, LY, LW, LH, 1);
GX = LX + 6*scale; GY = LY + 6*scale; GW = LW - 12*scale; GH = LH - 12*scale;
gfx_set(0.02, 0.02, 0.02, 1);
gfx_rect(GX - scale, GY - scale, GW + 2*scale, GH + 2*scale, 1);
gfx_set(0.035 + acc_r*0.05, 0.035 + acc_g*0.05, 0.035 + acc_b*0.05, 1);
gfx_rect(GX, GY, GW, GH, 1);
lc_r = min(1, 0.35 + acc_r*0.75); lc_g = min(1, 0.35 + acc_g*0.75); lc_b = min(1, 0.35 + acc_b*0.75);

TAW = 230*scale;
gfx_setfont(2, "Courier New", 14*scale, 'b');
glow_text("LISTEN", GX + 10*scale, GY + 6*scale, lc_r, lc_g, lc_b);
strcpy(#lt, g_uni ? "UNIPOLAR" : "BIPOLAR");
gfx_measurestr(#lt, ltw, lth);
glow_text(#lt, GX + TAW - ltw, GY + 6*scale, lc_r, lc_g, lc_b);
strcpy(#ln, g_lis == 0 ? "LOW" : g_lis == 1 ? "MID" : g_lis == 2 ? "HIGH" : "OUTPUT");
gfx_setfont(2, "Courier New", 26*scale, 'b');
gfx_measurestr(#ln, ltw, lth);
glow_text(#ln, GX + 10*scale + (TAW - 10*scale - ltw)*0.5, GY + 26*scale + (26*scale - lth)*0.5, lc_r, lc_g, lc_b);
gfx_setfont(2, "Courier New", 14*scale, 'b');
LY3 = GY + GH - 20*scale;
(lcd_sl > 0 && time_precise() - lcd_t < 1.5) ? (
  strcpy(#lt, knob_name(lcd_sl)); upper(#lt);
  glow_text(#lt, GX + 10*scale, LY3, lc_r, lc_g, lc_b);
  strcpy(#lv, ptext(lcd_sl)); upper(#lv);
  gfx_measurestr(#lv, ltw, lth);
  glow_text(#lv, GX + TAW - ltw, LY3, lc_r, lc_g, lc_b);
) : (
  sprintf(#lt, "%.0f / %.0f HZ", x1_hz(), x2_hz());
  gfx_measurestr(#lt, ltw, lth);
  glow_text(#lt, GX + 10*scale + (TAW - 10*scale - ltw)*0.5, LY3, lc_r, lc_g, lc_b);
);

SDX = GX + TAW + 12*scale;
gfx_set(lc_r, lc_g, lc_b, 0.18);
gfx_rect(SDX, GY + 8*scale, max(1, scale), GH - 16*scale, 1);
VX = SDX + 12*scale; VW = GX + GW - 10*scale - VX;
VY = GY + 8*scale; VH = GH - 16*scale;
gbw = (VW - 2*10*scale) / 3;
gbi = 0;
loop(3,
  gpk = gbi == 0 ? lpk : gbi == 1 ? mpk : hpk;
  gdb = gpk > 0.000001 ? 20 * log10(gpk) : -100;
  gfr = max(0, min(1, (gdb + 48) / 48));
  gbx = VX + gbi * (gbw + 10*scale);
  gfx_set(lc_r, lc_g, lc_b, 0.08);
  gfx_rect(gbx, VY, gbw, VH - 14*scale, 1);
  gon = g_lis >= 3 || g_lis == gbi;
  gfx_set(lc_r, lc_g, lc_b, gon ? 0.9 : 0.25);
  gfx_rect(gbx, VY + (VH - 14*scale) * (1 - gfr), gbw, (VH - 14*scale) * gfr, 1);
  gfx_setfont(1, "Arial", 11*scale, 'b');
  strcpy(#lt, gbi == 0 ? "LOW" : gbi == 1 ? "MID" : "HIGH");
  gfx_measurestr(#lt, ltw, lth);
  gfx_set(lc_r, lc_g, lc_b, 0.8);
  gfx_x = gbx + (gbw - ltw) * 0.5; gfx_y = VY + VH - 12*scale; gfx_drawstr(#lt);
  gbi += 1;
);

gfx_set(0, 0, 0, 0.22);
scan_y = GY;
while (scan_y < GY + GH) ( gfx_rect(GX, scan_y, GW, max(1, scale), 1); scan_y += 3*scale; );
gfx_set(1, 1, 1, 0.035);
gfx_rect(GX, GY, GW, GH*0.45, 1);

MW = 16*scale;
MAX0 = LX + LW + 30*scale;
MSP = (ox + DW*scale - MARGIN - MAX0 - MW);
meter(MAX0, LY, MW, LH, ipk, "IN");
meter(MAX0 + MSP, LY, MW, LH, opk, "OUT");

SY = oy + 164*scale; SH = 26*scale;
gfx_setfont(1, "Arial", 12*scale, 'b');
gfx_set(0.62, 0.63, 0.66, 1);
gfx_measurestr("LISTEN", ltw, lth);
gfx_x = ox + MARGIN; gfx_y = SY + (SH - lth)*0.5;
gfx_drawstr("LISTEN");
LBX = ox + MARGIN + ltw + 10*scale; LBW = 96*scale;
gli = 0;
loop(4,
  seg_btn(1, LBX + gli*(LBW + 4*scale), SY, LBW, SH, gli == 0 ? "LOW" : gli == 1 ? "MID" : gli == 2 ? "HIGH" : "OUTPUT", gli < 3 ? g_lis == gli : g_lis >= 3, 12) ? (
    set_slider(1, gli < 3 ? (gli + 0.5) / 5 : 1); mouse_just_down = 0;
  );
  gli += 1;
);

gfx_set(0.04, 0.04, 0.05, 1);
gfx_rect(0, oy + 200*scale, gfx_w, max(1, scale), 1);

row_begin(208*scale, 8, 4);
sec(2, "CROSSOVER", 0.80, 0.80, 0.84); knob(2); knob(3);
sec(2, "LOW", 1.00, 0.50, 0.30); knob(4); knob(7);
sec(2, "MID", 0.98, 0.80, 0.30); knob(5); knob(8);
sec(2, "HIGH", 0.45, 0.80, 0.95); knob(6); knob(9);

gfx_set(0.04, 0.04, 0.05, 1);
gfx_rect(0, oy + 346*scale, gfx_w, max(1, scale), 1);
hs = drag_target > 0 ? drag_target : hov_s;
gfx_setfont(1, "Arial", 13*scale);
gfx_set(0.62, 0.63, 0.66, 1);
strcpy(#ghint, hint_text(hs));
gfx_measurestr(#ghint, htw, hth);
htw > (DW - 20)*scale ? ( gfx_setfont(1, "Arial", 13*scale*(DW - 20)*scale/htw); gfx_measurestr(#ghint, htw, hth); );
gfx_x = ox + (DW*scale - htw)*0.5; gfx_y = oy + 346*scale + (34*scale - hth)*0.5;
gfx_drawstr(#ghint);

drag_target > 0 ? (
  mouse_down ? (
    mouse_cap |= 65536;
    fine_now = mouse_cap & 4;
    fine_now != drag_fine ? ( drag_y0 = mouse_y; drag_v0 = slider(drag_target); drag_fine = fine_now; );
    gv = max(0, min(1, drag_v0 + (drag_y0 - mouse_y) / (150*scale) * (fine_now ? 0.1 : 1)));
    set_norm(drag_target, gv);
    lcd_touch(drag_target);
  ) : ( automate(drag_target, 1); drag_target = 0; );
);

mouse_wheel = 0;
mouse_state = mouse_down;
