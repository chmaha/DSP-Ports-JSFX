DEMO = alloc(470 * 4);
CQ = alloc(512);
GSEP = alloc(20); GBK = alloc(24); GBKN = alloc(12); GWKN = alloc(17); GBX = alloc(8); GKD = alloc(29);
GSEP[0] = 285; GSEP[1] = 327; GSEP[2] = 368; GSEP[3] = 409; GSEP[4] = 451; GSEP[5] = 493; GSEP[6] = 534;
GSEP[7] = 576; GSEP[8] = 618; GSEP[9] = 660; GSEP[10] = 701; GSEP[11] = 742; GSEP[12] = 783; GSEP[13] = 824;
GSEP[14] = 865; GSEP[15] = 906; GSEP[16] = 947; GSEP[17] = 987;
GBK[0] = 315; GBK[1] = 334.5; GBK[2] = 357; GBK[3] = 377.5; GBK[4] = 441; GBK[5] = 460.5; GBK[6] = 483; GBK[7] = 502.5;
GBK[8] = 567; GBK[9] = 586.5; GBK[10] = 609; GBK[11] = 629.5; GBK[12] = 652; GBK[13] = 671.5; GBK[14] = 734; GBK[15] = 754.5;
GBK[16] = 777; GBK[17] = 796.5; GBK[18] = 857; GBK[19] = 878.5; GBK[20] = 897.5; GBK[21] = 919.5; GBK[22] = 938; GBK[23] = 959.5;
GBKN[0] = 56; GBKN[1] = 58; GBKN[2] = 61; GBKN[3] = 63; GBKN[4] = 66; GBKN[5] = 68; GBKN[6] = 70; GBKN[7] = 73;
GBKN[8] = 75; GBKN[9] = 78; GBKN[10] = 80; GBKN[11] = 82;
GWKN[0] = 55; GWKN[1] = 57; GWKN[2] = 59; GWKN[3] = 60; GWKN[4] = 62; GWKN[5] = 64; GWKN[6] = 65; GWKN[7] = 67;
GWKN[8] = 69; GWKN[9] = 71; GWKN[10] = 72; GWKN[11] = 74; GWKN[12] = 76; GWKN[13] = 77; GWKN[14] = 79; GWKN[15] = 81; GWKN[16] = 83;
GBX[0] = 535; GBX[1] = 577; GBX[2] = 619.5; GBX[3] = 661.5; GBX[4] = 703.5; GBX[5] = 745.5; GBX[6] = 787; GBX[7] = 828.5;

vl_tables();

K_RESET = 84; K_DEL = 85; K_SQRT = 86; K_PERC = 87; K_MC = 89; K_MR = 90; K_MMINUS = 91; K_MPLUS = 92;
v_pbend = 0;
v_bs = 0;
v_lastg = vol;
cur_mode = pmode = mode;
last_tempo = vl_tempo;
cq_w = cq_r = 0;
rh_wait = 0;
rh_start = -1;
vl_prepare(srate);
vl_reset();
vs_clear(203);
seq_clear();
p_init();

@slider
last_srate != srate ? (
  last_srate = srate;
  vl_prepare(srate);
  vl_reset();
);

@block
cur_mode !== mode ? (
  cur_mode = pmode = mode;
  vl_reset();
  p_reset();
);
while (cq_r < cq_w) (
  p_cmd(CQ[(cq_r % 256) * 2], CQ[(cq_r % 256) * 2 + 1]);
  cq_r += 1;
);
last_tempo !== vl_tempo ? (
  last_tempo = vl_tempo;
  lcd_settempo();
);
e_src = p_demo && demo_prog >= 0 && demo_prog < 5 ? demo_prog : prog;
e_src < 5 ? (
  e_snd = VL_CODES[e_src * 8]; e_a = VL_CODES[e_src * 8 + 1]; e_d = VL_CODES[e_src * 8 + 2]; e_sl = VL_CODES[e_src * 8 + 3];
  e_st = VL_CODES[e_src * 8 + 4]; e_r = VL_CODES[e_src * 8 + 5]; e_v = VL_CODES[e_src * 8 + 6]; e_t = VL_CODES[e_src * 8 + 7];
) : (
  e_snd = c_snd; e_a = c_a; e_d = c_d; e_sl = c_sl; e_st = c_st; e_r = c_r; e_v = c_v; e_t = c_t;
);
playing = pmode === 0 || pmode === 1;
q_n = 0;
while (midirecv(mofs, m1, m2, m3)) (
  (m1 & 0xF0) === 0xE0 ? (
    v_pbend = f32k(f32k(f32k((m2 + m3 * 128) - 8192) / 8192) * f32k(bendrange));
  ) : q_n < 1024 ? (
    QOF[q_n] = mofs; QB0[q_n] = m1; QB1[q_n] = m2; QB2[q_n] = m3;
    q_n += 1;
  );
);
vl_block(e_snd, octave - 1, e_a, e_d, e_sl, e_st, e_r, e_v, e_t, rhythm, vl_tempo, balance);
rh_start >= 0 ? (
  v_rhythm >= 0 && v_rhythm < 10 ? v_beat = rh_start >= VL_PAT[v_rhythm * 40] ? 0 : rh_start;
  rh_start = -1;
);
q_i = 0;
s_i = 0;
v_g = (vol);
v_ginc = ((v_g - v_lastg) / samplesblock);
v_gg = v_lastg;
v_gsame = v_lastg === v_g;

@sample
playing ? (
  while (q_i < q_n && QOF[q_i] <= s_i) (
    vl_midi(QB0[q_i], QB1[q_i], QB2[q_i], v_pmul);
    (QB0[q_i] & 0xF0) === 0x90 && QB2[q_i] > 0 ? lcd_shownote(QB1[q_i]);
    q_i += 1;
  );
  v_tick + 1 >= v_tper ? p_tick();
  v_o = vl_sample();
  v_o = (v_o * (v_gsame ? v_g : v_gg));
  v_gg = (v_gg + v_ginc);
) : v_o = 0;
spl0 = spl1 = v_o;
s_i += 1;
s_i === samplesblock ? v_lastg = v_g;

@serialize
sv_ver = 1;
file_var(0, sv_ver);
file_var(0, arr_last);
sv_i = 0;
loop(101 * 4, file_var(0, SONG[sv_i]); sv_i += 1;);
file_string(0, 203);
file_avail(0) >= 0 ? (
  SIDX[3] = strlen(203);
  arr_last > 0 ? ( sq_dirty = 1; sq_rec = 0; arr_cur = 0; ) : seq_clear();
  pmode === 2 ? lcd_setmode();
);

@gfx 1600 416

function gx(x) ( g_ox + (x - 7) * g_s; );
function gy(y) ( g_oy + (y - 7) * g_s; );

function gcol(r, g, b) ( gfx_set(r / 255, g / 255, b / 255, 1); );
function gcola(r, g, b, a) ( gfx_set(r / 255, g / 255, b / 255, a); );

function grect(x, y, w, h) ( gfx_rect(gx(x), gy(y), max(1, w * g_s), max(1, h * g_s)); );

function grrect(x, y, w, h, r) ( grect(x, y, w, h); );

function gbody(x, y, w, h, r) local(X, Y, W, H, R) (
  X = gx(x); Y = gy(y); W = w * g_s; H = h * g_s; R = floor(r * g_s);
  gfx_rect(X + R, Y, W - 2 * R, H);
  gfx_rect(X, Y + R, R, H - 2 * R);
  gfx_rect(X + W - R, Y + R, R, H - 2 * R);
  gfx_circle(X + R, Y + R, R, 1, 1);
  gfx_circle(X + W - R - 1, Y + R, R, 1, 1);
  gfx_circle(X + R, Y + H - R - 1, R, 1, 1);
  gfx_circle(X + W - R - 1, Y + H - R - 1, R, 1, 1);
);

function gvgrad(x, y, w, h, r1, g1, b1, r2, g2, b2) local(H) (
  H = max(1, h * g_s);
  gfx_gradrect(gx(x), gy(y), max(1, w * g_s), H, r1 / 255, g1 / 255, b1 / 255, 1, 0, 0, 0, 0,
    (r2 - r1) / 255 / H, (g2 - g1) / 255 / H, (b2 - b1) / 255 / H, 0);
);

function gline(x1, y1, x2, y2) ( gfx_line(gx(x1), gy(y1), gx(x2), gy(y2), 1); );

function ghl(x1, x2, y, t) ( gfx_rect(gx(x1), gy(y - t / 2), max(1, (x2 - x1) * g_s), max(1, t * g_s)); );
function gvl(x, y1, y2, t) ( gfx_rect(gx(x - t / 2), gy(y1), max(1, t * g_s), max(1, (y2 - y1) * g_s)); );

function gfont(cap, bold) local(sz) (
  sz = max(6, floor(cap * g_s / 0.72 + 0.5));
  sz !== g_fsz || bold !== g_fb ? (
    gfx_setfont(1, "Arial", sz, bold ? 'b' : 0);
    g_fsz = sz; g_fb = bold;
  );
);

function gtext(s, x0, x1, yc, cap, bold) local(w, h, room, sz) (
  gfont(cap, bold);
  gfx_measurestr(s, w, h);
  room = (x1 - x0) * g_s * 1.3;
  w > room && room > 0 ? (
    sz = max(6, floor(g_fsz * room / w));
    gfx_setfont(1, "Arial", sz, bold ? 'b' : 0);
    g_fsz = sz;
    gfx_measurestr(s, w, h);
  );
  gfx_x = floor(gx((x0 + x1) / 2) - w / 2 + 0.5);
  gfx_y = floor(gy(yc) - h / 2 + 0.5);
  gfx_drawstr(s);
);

function gtextc(s, xc, yc, cap, bold) local(w, h) (
  gfont(cap, bold);
  gfx_measurestr(s, w, h);
  gfx_x = floor(gx(xc) - w / 2 + 0.5);
  gfx_y = floor(gy(yc) - h / 2 + 0.5);
  gfx_drawstr(s);
);

function gtextr(s, xr, yc, cap, bold) local(w, h) (
  gfont(cap, bold); gfx_measurestr(s, w, h);
  gfx_x = floor(gx(xr) - w + 0.5); gfx_y = floor(gy(yc) - h / 2 + 0.5); gfx_drawstr(s);
  xr - w / g_s;
);

function gtextl(s, xl, yc, cap, bold) local(w, h) (
  gfont(cap, bold); gfx_measurestr(s, w, h);
  gfx_x = floor(gx(xl) + 0.5); gfx_y = floor(gy(yc) - h / 2 + 0.5); gfx_drawstr(s);
  xl + w / g_s;
);

function gtrio(a, b, c, xc, yc, cap) local(wa, wb, wc, h, d, tot, x) (
  gfont(cap, 0);
  gfx_measurestr(a, wa, h); gfx_measurestr(b, wb, h); gfx_measurestr(c, wc, h);
  wa /= g_s; wb /= g_s; wc /= g_s; d = cap * 2.6;
  tot = wa + wb + wc + 2 * d;
  x = xc - tot / 2;
  gtextl(a, x, yc, cap, 0); x += wa;
  ghl(x + cap * 0.4, x + d - cap * 0.4, yc, 0.6); x += d;
  gtextl(b, x, yc, cap, 0); gvl(x + wb / 2, yc + cap * 0.9, 44, 0.6); x += wb;
  ghl(x + cap * 0.4, x + d - cap * 0.4, yc, 0.6); x += d;
  gtextl(c, x, yc, cap, 0);
);

function gpair(a, b, xc, yc, cap, gap) local(wa, wb, h, x) (
  gfont(cap, 1); gfx_measurestr(a, wa, h);
  gfont(cap, 0); gfx_measurestr(b, wb, h);
  wa /= g_s; wb /= g_s;
  x = xc - (wa + gap + wb) / 2;
  gtextl(a, x, yc, cap, 1);
  gtextl(b, x + wa + gap, yc, cap, 0);
);

function glab() ( gcol(88, 95, 108); );

function g_leader_l(xt, yt, xd) ( glab(); ghl(xt, xd, yt, 0.55); gvl(xd, yt, 46, 0.55); );
function g_leader_r(xd, yt, xt) ( glab(); ghl(xd, xt, yt, 0.55); gvl(xd, yt, 46, 0.55); );

function g_speaker() local(k, y) (
  gcol(202, 208, 218); grect(17, 17, 250, 241);
  gvgrad(17, 17, 250, 14, 234, 240, 249, 206, 212, 222);
  gvgrad(17, 243, 250, 15, 198, 204, 214, 88, 93, 102);
  gcol(150, 156, 168); grect(30.5, 28.5, 218.5, 215);
  gcol(236, 240, 247); grect(31.5, 242.5, 217.5, 1.2); grect(248, 29.5, 1.2, 214);
  gvgrad(31.5, 29.5, 216.5, 213, 186, 192, 203, 200, 206, 216);
  gcol(120, 126, 138); grect(31.5, 29.5, 216.5, 1.4); grect(31.5, 29.5, 1.4, 213);
  gvgrad(32.9, 30.9, 215, 3, 150, 156, 168, 190, 196, 207);
  k = 0;
  loop(21,
    y = 37.5 + 9.95 * k;
    gvgrad(34, y - 7.6, 212, 6.2, 236, 240, 247, 206, 212, 222);
