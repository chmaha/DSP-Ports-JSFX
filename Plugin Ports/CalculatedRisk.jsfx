function vs_clear(s) ( strcpy(s, ""); SIDX[s - 200] = 0; );
function vs_zero(s) ( strcpy(s, " 0"); SIDX[s - 200] = 1; );
function vs_copy(d, s) ( strcpy(d, s); SIDX[d - 200] = strlen(d); );
function vs_empty(s) ( strlen(s) === 0; );

