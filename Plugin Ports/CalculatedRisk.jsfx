function g_hit(mx, my) local(r, i) (
  r = 0;
  mx >= 476 && mx <= 585 && my >= 45 && my <= 66 ? r = 1 :
  mx >= 602 && mx <= 711 && my >= 45 && my <= 66 ? r = 2 :
  mx >= 735 && mx <= 795 && my >= 44 && my <= 68 ? r = 3 :
  mx >= 815 && mx <= 901 && my >= 44 && my <= 68 ? r = 4 :
  mx >= 918 && mx <= 986 && my >= 44 && my <= 68 ? r = 5 :
  my >= 94 && my <= 128 ? (
    i = 0;
    loop(8, abs(mx - GBX[i]) <= 7 ? r = 10 + i; i += 1;);
