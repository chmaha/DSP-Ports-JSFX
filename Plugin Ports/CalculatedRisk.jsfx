function g_tip(t) (
  t === 1 ? "Volume" :
  t === 2 ? "Balance between rhythm and melody" :
  t === 3 ? "Octave: Low, Middle, High" :
  t === 4 ? "Sound: Piano, Fantasy, Violin, Flute, Guitar or ADSR (your own sound code)" :
  t === 5 ? "Mode: PLAY, REC (record a melody), CAL (calculator), OFF" :
  t === 10 ? "RESET: stop rhythm and song (CAL: AC)" :
  t === 11 ? "DEL: delete the last recorded note in REC (CAL: C)" :
  t === 12 ? "TEMPO up (CAL: square root)" :
  t === 13 ? "TEMPO down (CAL: percent)" :
  t === 14 ? "RHYTHM: press, then a key from MARCH (0) to BEGUINE (9)" :
  t === 15 ? "ML-C: clear the melody memory in REC (CAL: memory clear)" :
  t === 16 ? "MUSIC: play the demo song (CAL: memory recall)" :
  t === 17 ? "AUTO PLAY: play, pause or continue the recorded melody (CAL: M-)" :
  t === 20 ? "ONE KEY PLAY: step through the recorded melody (CAL: M+; with ADSR selected, M+ stores the 8-digit sound code)" :
  t === 21 ? "ONE KEY PLAY: step through the recorded melody" :
  t >= 100 ? "Keys: notes in PLAY/REC, numbers and operators in CAL" : "";
);

function g_tooltip(t, mx, my) local(s, w, h, x, y) (
  s = g_tip(t);
  strlen(s) ? (
    gfx_setfont(2, "Arial", max(12, floor(4.6 * g_s)));
    gfx_measurestr(s, w, h);
    x = min(gfx_w - w - 12, max(4, gx(mx) + 12));
    y = gy(my) + 18 * g_s / 1.375;
    y + h + 8 > gfx_h ? y = gy(my) - h - 14;
    gcola(16, 18, 22, 0.92); gfx_rect(x - 6, y - 4, w + 12, h + 8);
    gcol(235, 238, 244); gfx_x = x; gfx_y = y; gfx_drawstr(s);
    g_fsz = -1;
  );
);

g_init !== 1 ? (
  g_init = 1;
  g_lw = g_lh = -1;
  g_target = 0; g_key = -1; g_tipt = 0; g_tipc = 0;
);

g_s = min(gfx_w / 1004, gfx_h / 261);
g_ox = (gfx_w - 1004 * g_s) / 2;
g_oy = 0;
g_fsz = -1;

g_lw !== gfx_w || g_lh !== gfx_h ? (
  g_lw = gfx_w; g_lh = gfx_h;
  gfx_setimgdim(1, gfx_w, gfx_h);
  gfx_dest = 1;
  g_static();
  gfx_dest = -1;
  g_fsz = -1;
);
gfx_x = gfx_y = 0;
gfx_blit(1, 1, 0);

g_mx = 7 + (mouse_x - g_ox) / g_s;
g_my = 7 + (mouse_y - g_oy) / g_s;
g_wheel = mouse_wheel; mouse_wheel = 0;
g_down = mouse_cap & 1;

g_down && !g_was ? (
  g_target = g_hit(g_mx, g_my);
  g_now = time_precise();
  g_target >= 1 && g_target <= 5 && g_target === g_lastt && g_now - g_lastc < 0.35 ? (
    g_target === 1 ? ( vol = 0.5; slider_automate(1); ) :
    g_target === 2 ? ( balance = 0.5; slider_automate(2); ) :
    g_target === 3 ? ( octave = 1; slider_automate(4); ) :
    g_target === 4 ? ( prog = 0; slider_automate(8); ) :
    g_target === 5 ? ( mode = 0; slider_automate(16); );
    g_lastt = 0;
    g_target = 0;
  ) : (
    g_lastt = g_target;
    g_lastc = g_now;
  );
  g_target >= 10 && g_target <= 17 ? g_send(g_target - 7, 1) :
