    h = drive > 0.000000000000001 ? max(0, (((0.131033183 * v_cap) * v_cap) + (0.246632173 * v_cap)) - 0.219399434) : 0;

    s = high ? h : 0;
    e = 0;
    loop(v_ne,
      t = v_phase - v_eb[e];
      t < 0 ? t += 1;
      s += (((e & 1) === 0 ? 0.5 : -0.5) * h) * vl_pblep(t, dt);
      e += 1;
    );
