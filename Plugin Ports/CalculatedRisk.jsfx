  v_lp6 = (v_lp6 + (v_lp6c * (sum - v_lp6)));
  (sum - v_lp6);
);

function vl_voicereset() (
  v_nheld = 0;
  v_stage = 0;
  v_level = 0;
  v_relp = 0;
);

function rh_select(r, beat) (
  rhythm = r + 1;
  v_rhythm = -2;
  rh_start = beat;
  sliderchange(64);
);

function rh_stop() (
  rhythm !== 0 ? ( rhythm = 0; sliderchange(64); );
);

function set_tempo(t) (
  t = max(-9, min(9, t));
  vl_tempo !== t ? ( vl_tempo = t; sliderchange(32); );
);

function lcd_clear() (
  memset(L1, 0, 10);
  memset(L2, 0, 9);
  l_cursor = 8;
  l_dot = 0;
  l_neg = 0;
  l_func = 0;
  l_reinit = 0;
);

function lcd_settempo() (
  pmode <= 1 ? (
    lcd_clear();
    L2[3] = '[';
    vl_tempo < 0 ? L2[4] = '-';
    L2[5] = '0' + abs(vl_tempo);
    L2[6] = ']';
    l_reinit = 1;
  );
);

function lcd_scroll() local(i) (
  pmode <= 1 ? (
    L1[1] = L1[5];
    L1[5] = L1[9];
    L1[9] = 0;
    i = 0;
    loop(6, L2[i] = L2[i + 3]; i += 1;);
    loop(3, L2[i] = 0; i += 1;);
    L2[8] = 0;
    1;
