function lcd_shownote(note) ( lcd_input(note, 8, 1); );

function lcd_scrollright(note) local(i) (
  L1[9] = L1[5];
  L1[5] = L1[1];
  L1[1] = 0;
  i = 8;
  while (i > 3) ( L2[i] = L2[i - 3]; i -= 3; );
