  ch === '6' ? 125 : ch === '7' ? 7 : ch === '8' ? 127 : ch === '9' ? 111 : ch === '[' ? 57 : ch === ']' ? 15 :
  ch === '_' ? 8 : ch === '-' ? 64 : ch === '~' ? 1 : 0;
);

