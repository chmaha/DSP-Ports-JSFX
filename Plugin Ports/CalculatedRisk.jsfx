function g_seg(x1, y1, x2, y2, t) local(sl, dx, dy, l, nx, ny, ax, ay, bx, by) (
  dx = x2 - x1; dy = y2 - y1; l = sqrt(dx * dx + dy * dy);
  dx /= l; dy /= l;
  nx = -dy * t / 2; ny = dx * t / 2;
  ax = x1 + dx * t / 2; ay = y1 + dy * t / 2;
  bx = x2 - dx * t / 2; by = y2 - dy * t / 2;
  gfx_triangle(gx(x1), gy(y1), gx(ax + nx), gy(ay + ny), gx(bx + nx), gy(by + ny), gx(x2), gy(y2), gx(bx - nx), gy(by - ny), gx(ax - nx), gy(ay - ny));
);

function g_digit(c, x, segs) local(t, w, h, y0, y1, ym, sl, k, ga, gb) (
