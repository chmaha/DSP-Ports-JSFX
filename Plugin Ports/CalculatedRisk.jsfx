function g_keyat(mx, my) local(j, i, r) (
  r = -1;
  my >= 139 && my <= 258 && mx >= 285 && mx < 987 ? (
    my <= 190 ? (
      j = 0;
      loop(12, mx >= GBK[j * 2] - 0.5 && mx <= GBK[j * 2 + 1] + 0.5 ? r = GBKN[j]; j += 1;);
    );
    r < 0 ? (
      i = 0;
      loop(17, mx >= GSEP[i] && mx < GSEP[i + 1] ? r = GWKN[i]; i += 1;);
    );
  );
  r;
