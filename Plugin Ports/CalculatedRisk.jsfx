slider1:vol=0.5<0,1,0.01>-Volume
slider2:balance=0.5<0,1,0.01>-Balance (rhythm - melody)
slider3:octave=1<0,2,1{Low,Middle,High}>-Octave
slider4:prog=0<0,5,1{Piano,Fantasy,Violin,Flute,Guitar,ADSR}>-Sound
slider5:mode=0<0,3,1{Play,Rec,Cal,Off}>-Mode
slider6:vl_tempo=0<-9,9,1>-Tempo
slider7:rhythm=0<0,10,1{Off,March,Waltz,4 Beat,Swing,Rock 1,Rock 2,Bossanova,Samba,Rhumba,Beguine}>-Rhythm
slider8:c_snd=0<0,9,1{Piano,Fantasy,Violin,Flute,Guitar 1,Guitar 2,English Horn,Electro 1,Electro 2,Electro 3}>-ADSR Sound
slider9:c_a=0<0,9,1>-ADSR Attack
slider10:c_d=4<0,9,1>-ADSR Decay
slider11:c_sl=5<0,9,1>-ADSR Sustain Level
slider12:c_st=3<0,9,1>-ADSR Sustain Time
slider13:c_r=2<0,9,1>-ADSR Release
slider14:c_v=0<0,9,1>-ADSR Vibrato
slider15:c_t=0<0,9,1>-ADSR Tremolo
slider16:bendrange=2<0,24,1>-Pitch Bend Range

in_pin:none
out_pin:Left
out_pin:Right
options:no_meter

@init
function alloc(n) local(r) instance(mp) global() ( r = mp; mp += n; memset(r, 0, n); r; );
function f32(x) local(c) ( c = x * 536870913; c - (c - x); );
function f32k(x) local(c) ( c = x * 536870913; c - (c - x); );

function vl_pblep(t, dt) (
  t < dt ? ( t /= dt; (((t + t) - (t * t)) - 1); ) :
  t > 1 - dt ? ( t = (t - 1) / dt; ((((t * t) + t) + t) + 1); ) : 0;
);

function vl_prepare(sr) (
  v_sr = sr;
  v_unit = 0.012 * sr;
  v_chg = exp(-1 / ((sr * 600) * 0.0000033));
  v_dis = exp(-1 / ((sr * 33000) * 0.0000033));
  v_lp8c = (1 - (exp(((-(2 * $pi)) * 800) / sr)));
  v_lp6c = (1 - (exp(((-(2 * $pi)) * 65) / sr)));
  v_bendc = f32k(1 - f32k(exp(-1 / (0.005 * sr))));
);

function vl_reset() (
  v_nheld = 0;
  v_stage = 0;
  v_level = 0;
  v_phase = 0;
  v_cap = 0;
  v_lp8 = v_lp6 = 0;
  v_tick = 0;
  v_ecount = 8;
  v_ehalf = 0;
  v_rhythm = -1;
  v_dtime = -1;
  v_lfsr = 0;
  v_nph = 0;
  v_shown = 0;
  v_pulse = -1;
);

function vl_startline(st, target, span, units) (
  v_stage = st;
  v_ltarget = target;
  v_ly = v_level;
  v_cd = v_unit;
  v_ldone = 0;
  v_lrate = 0;
  units === 0 ? (
    v_level = target;
    v_ldone = 1;
  ) : units > 0 ? (
    v_lrate = (target > v_level ? span : -span) / (units * v_unit);
  );
);

function vl_sustain() ( vl_startline(3, 0, 15, VL_SUS_U[v_dst]); );

function vl_startnote(note, pmul) (
  v_inc = (((440 * VL_EXP2[note - 69 + 200]) * 1) * pmul) / v_sr;
  v_stage === 0 ? (
    v_phase = 0;
    v_cap = 0;
  );
  v_ntime = 0;
  v_relp = 0;
  v_level = VL_ATK_B[v_da];
  vl_startline(1, 15, 15 - VL_ATK_B[v_da], VL_ATK_U[v_da]);
);

function vl_gateoff() (
  v_stage === 1 ? v_relp = 1 :
  v_stage !== 0 ? vl_startline(4, 0, 14, VL_REL_U[v_dr]);
);

function vl_remove(note) local(j, k) (
  j = 0; k = 0;
  loop(v_nheld,
    VL_HELD[k] !== note ? ( VL_HELD[j] = VL_HELD[k]; j += 1; );
    k += 1;
  );
  v_nheld = j;
);

function vl_midi(b0, b1, b2, pmul) local(t, last) (
  t = b0 & 0xF0;
  t === 0x90 && b2 > 0 ? (
    vl_remove(b1);
    v_nheld < 16 ? ( VL_HELD[v_nheld] = b1; v_nheld += 1; );
    vl_startnote(b1, pmul);
    v_shown = ((v_shown * 256) + (b1 + 1)) & 0xFFFFFF;
  ) : t === 0x80 || (t === 0x90 && b2 === 0) ? (
    last = v_nheld > 0 && VL_HELD[v_nheld - 1] === b1;
    vl_remove(b1);
    last ? (
      v_nheld > 0 ? vl_startnote(VL_HELD[v_nheld - 1], pmul) : vl_gateoff();
    );
  ) : t === 0xB0 && (b1 === 123 || b1 === 120) ? (
    v_nheld = 0;
    vl_gateoff();
  );
);

function vl_env() local(up) (
  v_stage === 0 ? 0 : (
    v_ldone === 0 && v_lrate !== 0 ? (
      v_ly += v_lrate;
      up = v_lrate > 0;
      (up ? v_ly >= v_ltarget : v_ly <= v_ltarget) ? (
        v_level = v_ltarget;
        v_ldone = 1;
      ) : (v_cd -= 1) <= 0 ? (
        v_cd += v_unit;
        up && v_level < v_ly ? v_level = ceil(v_ly);
        !up && v_level > v_ly ? v_level = floor(v_ly);
      );
    );
    v_stage === 1 ? (
      v_ldone ? (
        v_relp ? vl_startline(4, 0, 14, VL_REL_U[v_dr]) :
        v_dd > 0 ? vl_startline(2, 0, 15, VL_DEC_U[v_dd]) :
        ( v_level = VL_SUS_L[v_dsl]; vl_sustain(); );
      );
    ) : v_stage === 2 ? (
      v_level <= VL_SUS_L[v_dsl] ? vl_sustain();
    ) : v_stage >= 3 ? (
      v_level <= 0 ? v_stage = 0;
    );
    v_level;
  );
);

function vl_drum() local(tau, steps, bit, f, dt, per, lvl, t, s, t2, r) (
  v_dtime < 0 ? 0 : (
    tau = v_dtime / v_sr;
    v_dtime += 1;
    v_drum === 2 ? (
      r = -1;
      tau < 0.040 ? steps = floor(tau / 0.005) :
      tau < 0.160 ? steps = 8 + floor((tau - 0.040) / 0.020) :
      ( v_dtime = -1; r = 0; );
      r < 0 ? (
        v_nph += 50000 / v_sr;
        while (v_nph >= 1) (
          v_nph -= 1;
          bit = ((v_lfsr >> 15) ~ (v_lfsr >> 14) ~ (v_lfsr >> 12) ~ (v_lfsr >> 3) ~ 1) & 1;
          v_lfsr = ((v_lfsr << 1) | bit) & 0xFFFF;
        );
        r = ((1 - steps / 15) * ((v_lfsr >> 15) & 1));
      );
      r;
    ) : (
      f = v_drum === 0 ? 780 : 1560;
      dt = f / v_sr;
      per = tau * f;
      per >= 30 ? (
        v_dtime = -1;
        0;
      ) : (
        lvl = 1 - floor(per / 2) / 15;
        t = per - floor(per);
        s = t < 0.5 ? lvl : 0;
        per >= dt ? (
          t2 = t - 0.5;
          t2 < 0 ? t2 += 1;
          s += (0.5 * lvl) * (vl_pblep(t, dt) - vl_pblep(t2, dt));
        );
        (s);
      );
    );
  );
);

function vl_block(sound, oct, a, d, sl, st, r, vib, trem, rhy, vl_tempo, bal) local(nr) (
  v_sound = sound;
  v_w = sound < 7 ? sound : sound - 7;
  v_electro = sound >= 7;
  !v_electro ? v_ehalf = 0;
  v_da = a; v_dd = d; v_dsl = sl; v_dst = st; v_dr = r;
  v_pmul = VL_PSCALE[v_w] * (2 ^ oct);
  v_vibhz = vib > 0 ? 15 / vib : 0;
  v_vibd = vib > 0 ? 0.7056 / ((2 * $pi) * v_vibhz) : 0;
  v_tremhz = trem > 0 ? 35 / trem : 0;
  v_tper = (0.0055 + (9 - vl_tempo) * 0.00098) * v_sr;
  bal = (bal);
  v_bal = (0.5 * (bal - 0.5));
  v_mg = ((2 * (0.5 + v_bal)) * (0.1954));
  v_rg = ((2 * (0.5 - v_bal)) * (0.3571));
  v_ne = VL_NEDGE[v_w];
  v_eb = VL_EDGES + v_w * 10;
  nr = rhy - 1;
  nr !== v_rhythm ? (
    v_rhythm = nr;
    v_beat = 0;
    v_scount = 1;
    v_tick = v_tper;
    v_dtime = -1;
    v_bticks = -1;
  );
);

function vl_sample() local(y, env, tg, dt, below, e, high, drive, vin, h, s, t, sum, pb, pat) (
  v_tick += 1;
  v_tick >= v_tper ? (
    v_tick -= v_tper;
    (v_ecount -= 1) === 0 ? (
      v_ecount = 8;
      v_ehalf = v_electro && !v_ehalf;
    );
    v_bticks = (v_bticks + 1) % 32;
    v_rhythm >= 0 && v_rhythm < 10 ? (
      (v_scount -= 1) === 0 ? (
        pat = VL_PAT + v_rhythm * 40;
        v_drum = pat[2 + v_beat * 2];
        v_scount = pat[3 + v_beat * 2];
        v_beat = (v_beat + 1) % pat[0];
        v_dtime = 0;
      );
    );
  );

  y = 0;
  env = (vl_env() / 15);
  v_stage !== 0 ? (
    v_ntime += 1 / v_sr;
    tg = v_tremhz > 0 ? 0.5 + 0.5 * cos(((2 * $pi) * v_tremhz) * v_ntime) : 1;
    pb = f32k(v_pbend);
    v_bs = f32k(v_bs + f32k(f32k(v_bendc) * f32k(pb - v_bs)));
    dt = (v_inc * (1 + (v_vibd * sin(((2 * $pi) * v_vibhz) * v_ntime)))) * (v_bs === 0 ? 1 : 2 ^ (v_bs / 12));
    v_ehalf ? dt *= 0.5;

