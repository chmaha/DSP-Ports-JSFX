function gmenubox(x, y, w, h, s, lb, items) local(hov, xx, yy, ww, hh, r, lw) (
  hov = ghit(x, y, w, h);
  hov ? G_HINT = s;
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC); lw = max(1, floor(G_SC + 0.5));
  r = floor(5 * G_SC);
