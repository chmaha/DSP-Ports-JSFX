  gchoice(28, 94, 208, 26, 1, 0, "CutProc11");
  gchoice(28, 124, 208, 26, 1, 1, "WarpCut");
  gchoice(28, 154, 208, 26, 1, 2, "SQPusher");
  gtext(28, 196, "SubDiv", 1, 0.90, 0.92, 0.94, 1, 0);
  G_MD = SMO[1];
  abs(G_MD) > 0.0005 ? gtext(236, 196, "modulated", 4, 0.75, 0.77, 0.80, 1, 2);
  gi = 0;
  loop(10,
    gx = 28 + (gi % 5) * 42; gy = 208 + floor(gi / 5) * 26;
    gchoice(gx, gy, 38, 22, 2, gi, gi === 0 ? "2" : gi === 1 ? "4" : gi === 2 ? "6" : gi === 3 ? "8" : gi === 4 ? "12" : gi === 5 ? "16" : gi === 6 ? "18" : gi === 7 ? "24" : gi === 8 ? "32" : "64");
    gi += 1;
  );

  gcard(260, 62, 706, 200, "PATTERN", 0.98, 0.50, 0.40, 1);
  gacc(0.98, 0.50, 0.40);
  gtext(800, 82, "Seed", 1, 0.90, 0.92, 0.94, 1, 2);
