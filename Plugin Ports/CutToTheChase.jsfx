function mod_sources(n, bpm, num, den, ppq, gotpos, playing, mask) local(i, b, sy, re, je, rq, ef, hl, po, pfw, cyc, cy, v, fs, fg, inc, op, sm, p, fsh, shp, rg, dv, qpb, spb, ft, st) (
  i = 0;
