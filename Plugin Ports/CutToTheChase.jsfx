    slider(b + 1) > 0.5 ? (
      dv = clampv(0, 20, rhe(slider(b + 2)));
      dv < 14 ? ft = (max(1.0, bpm) / 60.0) * WCPQ[dv] : (
        qpb = max(0.25, (num * 4.0) / max(1.0, den));
        spb = (60.0 / max(1.0, bpm)) * qpb;
        ft = 1.0 / (WBARS[dv - 14] * spb);
