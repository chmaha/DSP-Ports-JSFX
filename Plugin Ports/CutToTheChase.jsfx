        G_BX0 = G_PX0 + G_U0 * G_UW; G_BX1 = G_PX0 + min(G_TU, G_U0 + max(G_UB, 0)) * G_UW;
        G_UB > 0 ? gfrr(gsx(G_BX0) + 1, gsy(G_PY0), gsx(G_BX1) - 1, gsy(G_PY0 + G_PH), 4 * G_SC,
                        G_RP[4] === 0 ? 0.66 : G_RP[4] === 1 ? 0.40 : 0.62, G_RP[4] === 0 ? 0.55 : G_RP[4] === 1 ? 0.68 : 0.86, G_RP[4] === 0 ? 0.98 : G_RP[4] === 1 ? 1.0 : 0.36, G_K === 0 ? 0.16 : 0.08);
        G_CX = G_BX0; gj = 0;
        loop(G_NC,
          G_CW = G_RP[8 + gj * 3] / G_SPU * G_UW;
          G_FL = G_RP[9 + gj * 3]; G_AM = gclamp(G_RP[10 + gj * 3], 0, 1);
