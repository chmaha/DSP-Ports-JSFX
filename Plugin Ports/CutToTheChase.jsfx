  midisend(mofs, mm1, mm23);
);
env_pn > 0 ? (
  etg = clampv(0, 1, env_pk);
  etau = etg > envv ? 0.010 : 0.180;
  ecf = exp(-env_pn / (srate_cur * etau));
  envv = ecf * envv + (1.0 - ecf) * etg;
);
env_pk = 0;
env_pn = blk_n;

h_tp = tempo;
h_num = ts_num;
h_den = ts_denom;
h_play = (play_state & 1) ? 1 : 0;
h_spos = floor(play_position * srate + 0.5);
h_ppq = h_play ? beat_position : frppq;
!h_play ? frppq += (blk_n / srate_cur) * (h_tp / 60.0) : frppq = h_ppq;
h_tchg = h_play !== was_play;
h_pbd = (blk_n / srate_cur) * (h_tp / 60.0);
h_tol = max(0.002, h_pbd * 0.75);
h_tj = 0;
h_play ? (
  ehs_v ? (h_sd = h_spos - ehs; (h_sd > 8 || h_sd < -8) ? h_tj = 1;);
  ehs = h_spos + blk_n; ehs_v = 1;
  (lhp_v && h_ppq < lhp - h_tol) ? h_tj = 1;
  (emp_v && abs(h_ppq - emp) > h_tol) ? h_tj = 1;
  lhp = h_ppq; lhp_v = 1;
  emp = h_ppq + h_pbd; emp_v = 1;
) : (
  ehs_v = 0; lhp_v = 0; emp_v = 0;
);
h_mask = 0;
((!was_play && h_play) || h_tj) ? (
  mi = 0;
  loop(4,
    slider(41 + mi * 8) > 0.5 ? h_mask |= 2 ^ mi;
    slider(74 + mi * 8) > 0.5 ? h_mask |= 2 ^ (4 + mi);
    mi += 1;
  );
);
was_play = h_play;
push_params(0);
blk_secs = blk_n / srate_cur;
mod_sources(blk_n, h_tp, h_num, h_den, h_ppq, h_play, h_play, h_mask);
apply_mod(blk_n);
LASTP[34] = rawp(34);
!LASTP[34] ? (
  k_block(blk_n, h_tp, h_num, h_den, h_ppq, h_tchg);
  k_ran = 1;
);

@sample
s_il = spl0;
s_ir = spl1;
s_a = abs(s_il); s_a > env_pk ? env_pk = s_a;
s_a = abs(s_ir); s_a > env_pk ? env_pk = s_a;
k_ran ? (
  s_q = floor(kpos / k_subdiv);
  s_r = kpos - s_q * k_subdiv;
  s_r < 0 ? s_r += k_subdiv : s_r >= k_subdiv ? s_r -= k_subdiv;
  kpos < 0 ? s_r = cfmod(kpos, k_subdiv);
  s_p = floor(s_r);
  s_p !== k_lpim ? (bb_setpos(s_q, s_p); k_lpim = s_p;);
  s_ol = 0; s_or = 0;
  currentcut < ncuts ? (
    inputindex < bsz ? (IBL[inputindex] = s_il; IBR[inputindex] = s_ir; inputindex += 1;);
    (readindex < cur_ln && readindex < bsz) ? (
      pl_pitch ? (s_xl = PBL[readindex]; s_xr = PBR[readindex];) : (s_xl = IBL[readindex]; s_xr = IBR[readindex];);
      s_e = (1 - exp((-5 * readindex) / pl_fade)) * (1 - exp((5 * (readindex - cur_ln)) / pl_fade));
      s_ol = s_e * (pl_ll * s_xl + pl_rl * s_xr);
