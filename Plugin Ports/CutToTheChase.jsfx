  );
);

function src_val(s) (
  (s >= 1 && s <= 4) ? L_VAL[s - 1] :
  (s >= 5 && s <= 8) ? W_VAL[s - 5] :
  s === 9 ? mw_val :
  s === 10 ? vel_val :
  s === 11 ? at_val :
