function smooth01(x) ( x = clampv(0, 1, x); x * x * (3 - 2 * x); );

function lfo_reset_rand(i) (
  L_SH[i] = jr_bip(); L_RA[i] = jr_bip(); L_RB[i] = jr_bip(); L_LC[i] = -1;
