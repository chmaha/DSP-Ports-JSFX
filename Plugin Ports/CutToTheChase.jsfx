function gfrom(s, p) (
  p = gclamp(p, 0, 1);
  (GSK[s] !== 1 && p > 0) ? p = p ^ (1 / GSK[s]);
  gsnap(s, GLO[s] + (GHI[s] - GLO[s]) * p);
