  (gi && G_WHL !== 0) ? ( gset(3, gclamp(slider(3) + sign(G_WHL), 1, 16)); gend(3); );
  gfrr(gsx(838), gsy(70), gsx(888), gsy(94), 5 * G_SC, 0.075, 0.08, 0.09, 1);
  gtext(863, 82, sprintf(#g_s, "%d", slider(3)), 5, 0.96, 0.96, 0.97, 1, 1);
  gi = ghit(892, 70, 26, 24); gpill(892, 70, 26, 24, "+", 0, gi, 0.98, 0.5, 0.4);
  gi ? G_HINT = 3;
  (gi && G_CLK) ? ( gset(3, min(16, slider(3) + 1)); gend(3); );

  G_PX0 = 280; G_PW = 666; G_PY0 = 104; G_PH = 116;
  gfrr(gsx(G_PX0 - 6), gsy(G_PY0 - 6), gsx(G_PX0 + G_PW + 6), gsy(G_PY0 + G_PH + 22), 6 * G_SC, 0.06, 0.064, 0.072, 1);
  G_TU = totalunits; G_SDV = bb_subdiv;
  G_REC = GHIST + gh_last * 200;
