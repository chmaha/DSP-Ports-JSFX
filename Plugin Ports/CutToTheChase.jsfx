cs_pos(11, 0, 3); cs_v(0.75); cs_v(0.75); cs_v(1.0);
cs_pos(11, 1, 6); cs_v(0.25); cs_v(0.25); cs_v(0.25); cs_v(0.25); cs_v(0.25); cs_v(0.25);
cs_pos(12, 0, 2); cs_v(0.5); cs_v(1.0);
