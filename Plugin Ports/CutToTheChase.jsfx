    ) : ft = slider(b);
    inc = ft * blk_secs;
    op = W_PH[i];
    W_PH[i] += inc;
    floor(W_PH[i]) !== floor(op) ? (
      W_CU[i] = W_TA[i];
      st = 0.12 + 0.88 * clampv(0, 1, slider(b + 3) / 100);
      W_TA[i] = clampv(-1, 1, W_CU[i] + jr_bip() * st);
    );
    W_PH[i] -= floor(W_PH[i]);
