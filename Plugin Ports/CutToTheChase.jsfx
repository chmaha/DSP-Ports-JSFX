function gchoice(x, y, w, h, s, val, lb) local(hov) (
  hov = ghit(x, y, w, h);
  hov ? G_HINT = s;
  (hov && G_CLK) ? ( gset(s, val); gend(s); );
  gpill(x, y, w, h, lb, abs(slider(s) - val) < 0.5, hov, G_ACR, G_ACG, G_ACB);
