slider1:p_cutproc=0<0,2,1{CutProc11,WarpCut,SQPusher}>-Cut Proc
slider2:p_subdiv=3<0,9,1{2,4,6,8,12,16,18,24,32,64}>-SubDiv
slider3:p_seed=1<1,16,1>-Seed
slider4:p_fade=0<0,100,0.01>-Fade (ms)
slider5:p_minamp=100<0,100,0.1>-Min Amp (%)
slider6:p_maxamp=100<0,100,0.1>-Max Amp (%)
slider7:p_minpan=-20<-100,100,0.1>-Min Pan (%)
slider8:p_maxpan=20<-100,100,0.1>-Max Pan (%)
slider9:p_minpitch=0<-2400,2400,1>-Min Pitch (ct)
slider10:p_maxpitch=0<-2400,2400,1>-Max Pitch (ct)
slider11:p_duty=100<0,100,0.1>-Duty (%)
slider12:p_fillduty=100<0,100,0.1>-Fill Duty (%)
slider13:p_minphrase=1<1,8,1>-Min Phrase (bars)
slider14:p_maxphrase=4<1,8,1>-Max Phrase (bars)
slider15:p_minrepeat=0<0,4,1>-Min Repeat
slider16:p_maxrepeat=1<0,4,1>-Max Repeat
slider17:p_stutter=80<0,100,0.1>-Stutter (%)
slider18:p_area=50<0,100,0.1>-Area (%)
slider19:p_straight=30<0,100,0.1>-Straight (%)
slider20:p_regular=50<0,100,0.1>-Regular (%)
slider21:p_ritard=50<0,100,0.1>-Ritard (%)
slider22:p_speed=0.949<0.5,0.999,0.001>-Speed
slider23:p_activity=50<0,100,0.1>-Activity (%)
slider24:p_crusher=0<0,1,1{Off,On}>-Crusher
slider25:p_minbits=32<1,32,1>-Min Bits
slider26:p_maxbits=32<1,32,1>-Max Bits
slider27:p_minfreq=50<0,100,0.1>-Min Freq (%)
slider28:p_maxfreq=50<0,100,0.1>-Max Freq (%)
slider29:p_comb=0<0,1,1{Off,On}>-Comb
slider30:p_combtype=0<0,1,1{FeedFwd,FeedBack}>-Comb Type
slider31:p_combfb=45<0,90,0.1>-Comb Feedback (%)
slider32:p_combmin=10.8<1,50,0.01>-Comb Min Delay (ms)
slider33:p_combmax=10.8<1,50,0.01>-Comb Max Delay (ms)
slider34:p_bypass=0<0,1,1{Off,On}>-Bypass
<?
li = 0;
loop(4,
  lb = 35 + li * 8;
  printf("slider%d:lfo%d_wave=0<0,6,1{Sine,Triangle,Saw Up,Saw Down,Square,S&H,Smooth Random}>-LFO %d Wave\n", lb, li + 1, li + 1);
  printf("slider%d:lfo%d_rate=0.5<0.01,20,0.001>-LFO %d Rate (Hz)\n", lb + 1, li + 1, li + 1);
  printf("slider%d:lfo%d_sync=0<0,1,1{Off,On}>-LFO %d Sync\n", lb + 2, li + 1, li + 1);
  printf("slider%d:lfo%d_div=4<0,13,1{1/1,1/1T,1/2,1/2T,1/4,1/4T,1/8,1/8T,1/16,1/16T,1/32,1/32T,1/64,1/64T}>-LFO %d Division\n", lb + 3, li + 1, li + 1);
  printf("slider%d:lfo%d_phase=0<0,360,1>-LFO %d Phase (deg)\n", lb + 4, li + 1, li + 1);
  printf("slider%d:lfo%d_uni=0<0,1,1{Off,On}>-LFO %d Unipolar\n", lb + 5, li + 1, li + 1);
  printf("slider%d:lfo%d_retrig=1<0,1,1{Off,On}>-LFO %d Retrigger\n", lb + 6, li + 1, li + 1);
  printf("slider%d:lfo%d_fadein=0<0,10,0.01>-LFO %d Fade In (s)\n", lb + 7, li + 1, li + 1);
  li += 1;
);
li = 0;
loop(4,
  lb = 67 + li * 8;
  printf("slider%d:wnd%d_rate=0.08<0.005,2,0.001>-Wander %d Rate (Hz)\n", lb, li + 1, li + 1);
  printf("slider%d:wnd%d_sync=0<0,1,1{Off,On}>-Wander %d Sync\n", lb + 1, li + 1, li + 1);
  printf("slider%d:wnd%d_div=15<0,20,1{1/64,1/64T,1/32,1/32T,1/16,1/16T,1/8,1/8T,1/4,1/4T,1/2,1/2T,1/1,1/1T,1 bar,2 bars,4 bars,8 bars,16 bars,32 bars,64 bars}>-Wander %d Period\n", lb + 2, li + 1, li + 1);
  printf("slider%d:wnd%d_feel=50<0,100,0.1>-Wander %d Feel (%%)\n", lb + 3, li + 1, li + 1);
  printf("slider%d:wnd%d_smooth=80<0,100,0.1>-Wander %d Smooth (%%)\n", lb + 4, li + 1, li + 1);
  printf("slider%d:wnd%d_range=100<0,100,0.1>-Wander %d Range (%%)\n", lb + 5, li + 1, li + 1);
  printf("slider%d:wnd%d_uni=0<0,1,1{Off,On}>-Wander %d Unipolar\n", lb + 6, li + 1, li + 1);
  printf("slider%d:wnd%d_retrig=1<0,1,1{Off,On}>-Wander %d Retrigger\n", lb + 7, li + 1, li + 1);
  li += 1;
);
li = 0;
loop(16,
  lb = 99 + li * 4;
  printf("slider%d:mod%d_on=0<0,1,1{Off,On}>-Mod %d Enabled\n", lb, li + 1, li + 1);
  printf("slider%d:mod%d_src=0<0,12,1{Off,LFO 1,LFO 2,LFO 3,LFO 4,Wander 1,Wander 2,Wander 3,Wander 4,Mod Wheel,Velocity,Aftertouch,Input Env}>-Mod %d Source\n", lb + 1, li + 1, li + 1);
  printf("slider%d:mod%d_dst=0<0,29,1{Off,SubDiv,Seed,Fade,Min Phrase,Max Phrase,Duty,Fill Duty,Min Amp,Max Amp,Min Pan,Max Pan,Min Pitch,Max Pitch,Min Repeat,Max Repeat,Stutter,Area,Straight,Regular,Ritard,Speed,Activity,Min Bits,Max Bits,Min Freq,Max Freq,Comb Feedback,Comb Min Delay,Comb Max Delay}>-Mod %d Destination\n", lb + 2, li + 1, li + 1);
  printf("slider%d:mod%d_depth=0<-100,100,0.1>-Mod %d Depth (%%)\n", lb + 3, li + 1, li + 1);
  li += 1;
);
?>

