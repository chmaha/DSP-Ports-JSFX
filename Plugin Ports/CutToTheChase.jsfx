      s_f = s_pp - s_i;
      dl2_o = (1.0 - s_f) * DL2[s_i & 65535] + s_f * DL2[(s_i + 1) & 65535];
    );
  );
  spl0 = s_ol;
  spl1 = s_or;
  kpos += kdps;
);

@gfx 980 640
G_SC = max(0.5, min(gfx_w / 980, gfx_h / 640));
G_OX = floor((gfx_w - 980 * G_SC) * 0.5);
G_SC !== G_FSC ? (
  G_FSC = G_SC;
  gfx_setfont(1, "Arial", 13 * G_SC, 'b');
  gfx_setfont(2, "Arial", 12 * G_SC);
  gfx_setfont(3, "Arial", 12 * G_SC, 'b');
  gfx_setfont(4, "Arial", 11 * G_SC);
  gfx_setfont(5, "Arial", 13 * G_SC, 'b');
  gfx_setfont(6, "Arial", 25 * G_SC, 'b');
  gfx_setfont(7, "Arial", 11 * G_SC, 'b');
);
gfx_set(0.072, 0.077, 0.087, 1);
gfx_rect(0, 0, gfx_w, gfx_h);

G_WHL = mouse_wheel; mouse_wheel = 0;
G_MX = (mouse_x - G_OX) / G_SC; G_MY = mouse_y / G_SC;
G_DN = mouse_cap & 1;
G_CLK = G_DN && !G_LDN;
G_REL = !G_DN && G_LDN;
G_FINE = (mouse_cap & 4) ? 0.2 : 1;
G_DBL = 0;
G_CLK ? (
  G_NOW = time_precise();
  (G_NOW - G_LCT < 0.3 && abs(G_MX - G_LCX) < 4 && abs(G_MY - G_LCY) < 4) ? G_DBL = 1;
  G_LCT = G_NOW; G_LCX = G_MX; G_LCY = G_MY;
);
G_HINT = 0;
G_REL && G_DRAG ? ( gend(G_DRAG); G_DRAG = 0; );

gfrr(0, 0, gfx_w, gsy(54), 0, 0.095, 0.10, 0.112, 1);
gfx_set(0.30, 0.32, 0.36, 0.7); gfx_rect(0, gsy(54), gfx_w, max(1, G_SC));
gfx_setfont(6); gfx_measurestr("Cut to the Chase", G_TW, G_TH);
gi = 0;
loop(7,
  gfrr(gsx(22 + gi * 11), gsy(16 + ((gi * 5) % 3) * 3), gsx(22 + gi * 11 + 7), gsy(38), 2 * G_SC,
       gi % 3 === 0 ? 0.98 : gi % 3 === 1 ? 0.97 : 0.30, gi % 3 === 0 ? 0.50 : gi % 3 === 1 ? 0.72 : 0.82, gi % 3 === 0 ? 0.40 : gi % 3 === 1 ? 0.30 : 0.74, 1);
  gi += 1;
);
gtext(106, 25, "Cut to the Chase", 6, 0.96, 0.96, 0.97, 1, 0);
gtext(108 + G_TW / G_SC + 10, 29, "beat slicer  /  LiveCut Enhanced", 4, 0.62, 0.65, 0.70, 1, 0);
gi = ghit(612, 13, 96, 28); gtab(612, 13, 96, 28, "MAIN", G_PAGE === 0, gi); (gi && G_CLK) ? G_PAGE = 0;
gi = ghit(714, 13, 122, 28); gtab(714, 13, 122, 28, "MODULATION", G_PAGE === 1, gi); (gi && G_CLK) ? G_PAGE = 1;
gacc(0.98, 0.50, 0.40);
gtoggle(872, 13, 92, 28, 34, "BYPASS");

G_PAGE === 0 ? (
