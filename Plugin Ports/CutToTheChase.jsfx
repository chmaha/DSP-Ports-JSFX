cs_pos(2, 0, 1); cs_v(0.5);
cs_pos(2, 1, 3); cs_v(1.0); cs_v(1.0); cs_v(1.0);
cs_pos(2, 2, 1); cs_v(0.5);
cs_pos(3, 0, 1); cs_v(0.571429);
cs_pos(3, 1, 2); cs_v(0.571429); cs_v(0.571429);
cs_pos(3, 2, 2); cs_v(0.571429); cs_v(0.571429);
cs_pos(3, 3, 1); cs_v(0.571429);
cs_pos(3, 4, 2); cs_v(0.285714); cs_v(0.285716);
cs_pos(4, 0, 2); cs_v(1.0); cs_v(0.5);
