      s_i = floor(s_pp); s_f = s_pp - s_i;
      s_f > 0.5 ? s_i += 1 : s_f === 0.5 ? ((s_i & 1) ? s_i += 1);
      s_f = s_pp - s_i;
      dl2_o = (1.0 - s_f) * DL2[s_i & 65535] + s_f * DL2[(s_i + 1) & 65535];
      s_or = 0.5 * (s_or + dl2_o);
    ) : (
      dl1_d = lp_out; dl2_d = lp_out;
      lp_out *= lp_lam;
      lp_out += (1.0 - lp_lam) * (cb_delay + LP_NOISE);
      s_ol = (0.99 - cb_fb) * s_ol + cb_fb * dl1_o;
      s_ol = s_ol > 1 ? 1 : s_ol < -1 ? -1 : s_ol;
      DL1[dl1_w] = s_ol;
      s_pp = (dl1_w + 65536) - dl1_d;
      dl1_w = (dl1_w + 1) & 65535;
      s_i = floor(s_pp); s_f = s_pp - s_i;
