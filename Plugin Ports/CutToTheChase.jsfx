);

function gdisc(cx, cy, r, cr, cg, cb, al) local(py, dy, hw, j) (
  py = floor(cy - r - 1);
  loop(ceil(2 * r + 3),
    dy = py + 0.5 - cy;
    hw = sqrt(max(0, (r + 0.5) * (r + 0.5) - dy * dy));
    hw > 0 ? (
      gfx_set(cr, cg, cb, 1);
      gspan(cx - hw, cx + hw, py, al * min(1, r + 0.5 - abs(dy)));
    );
    py += 1;
  );
  gfx_a = 1;
);

function gcard(x, y, w, h, title, ar, ag, ab, act) local(xx, yy, ww, hh, rr, lw) (
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC); rr = max(2, floor(7 * G_SC));
  lw = max(1, floor(G_SC + 0.5));
  gfrr(xx, yy, xx + ww, yy + hh, rr, 0.118, 0.125, 0.14, 1);
  gbord(xx, yy, xx + ww, yy + hh, rr, lw, act ? ar : 0.36, act ? ag : 0.38, act ? ab : 0.42, act ? 0.85 : 0.55);
