function apply_mod(n) local(i, b, s, d, c) (
  memset(DSUM, 0, 32);
  i = 0;
  loop(16,
    b = 99 + i * 4;
    slider(b) > 0.5 ? (
      s = rhe(slider(b + 1));
      d = rhe(slider(b + 2));
      (s <= 0 || d <= 0 || d >= 30) ? 0 : DSUM[d] += src_val(s) * (slider(b + 3) / 100);
    );
    i += 1;
