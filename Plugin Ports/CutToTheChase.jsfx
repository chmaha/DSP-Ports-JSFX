cs_pos(12, 3, 1); cs_v(1.0);
cs_pos(12, 4, 3); cs_v(0.167); cs_v(0.167); cs_v(0.166);

CUTA = alloc(MAXC * 5);
CUTB = alloc(MAXC * 5);
cuts = CUTA;
ncuts = 0;
tcuts = CUTB;

L_PH = alloc(4); L_FA = alloc(4); L_AN = alloc(4); L_LC = alloc(4); L_AV = alloc(4);
L_RW = alloc(4); L_SH = alloc(4); L_RA = alloc(4); L_RB = alloc(4); L_VAL = alloc(4);
W_PH = alloc(4); W_CU = alloc(4); W_TA = alloc(4); W_RW = alloc(4); W_VAL = alloc(4);
SMO = alloc(32);
DSUM = alloc(32);
NOTES = alloc(128);
LASTP = alloc(40);
RETP = alloc(8);

GHIST = alloc(128 * 200);
gh_w = 0;
gh_n = 0;

DL1 = alloc(65536);
DL2 = alloc(65536);
IBL = allocz(CAP); IBR = allocz(CAP); PBL = allocz(CAP); PBR = allocz(CAP);

GUIMEM = alloc(4096);

function itr(x) ( x < 0 ? -floor(-x) : floor(x); );
function rhe(x) local(r, d) ( r = floor(x); d = x - r; d > 0.5 ? r + 1 : d === 0.5 ? ((r - 2 * floor(r * 0.5)) !== 0 ? r + 1 : r) : r; );
function clampv(a, b, v) ( v < a ? a : v > b ? b : v; );
function cmodi(a, b) ( b === 0 ? 0 : a - b * itr(a / b); );
function cfmod(x, y) local(q, r) (
  x >= 0 ? (
    q = floor(x / y); r = x - q * y;
    r < 0 ? r += y : r >= y ? r -= y;
  ) : (
    q = floor(-x / y); r = -x - q * y;
    r < 0 ? r += y : r >= y ? r -= y;
    r = -r;
  );
  r;
);
function f32(x) local(a, q, s, fl, d) (
  x === 0 ? 0 : (
    a = abs(x); q = 1;
    while (a / q >= 16777216) ( q *= 2; );
    while (a / q < 8388608) ( q *= 0.5; );
    s = a / q; fl = floor(s); d = s - fl;
    d > 0.5 ? fl += 1 : d === 0.5 ? ((fl - 2 * floor(fl * 0.5)) !== 0 ? fl += 1);
    x < 0 ? -fl * q : fl * q;
  );
);

function lc_rand() ( ms_s = ms_s * 214013 + 2531011; ms_s -= floor(ms_s / 4294967296) * 4294967296; floor(ms_s / 65536) & 32767; );
function lc_srand(seed) ( ms_s = seed; );
ms_s = 1; LC_RMAX = 32767;
function rfloat(mn, mx) ( mn + ((mx - mn) * lc_rand()) / LC_RMAX; );
function rint_(mn, mx) ( itr(0.5000001 + rfloat(mn, mx)); );

function jr_next() local(lo, m, c) (
  lo = jr_lo * 15525485 + 11;
  m = jr_hi * 15525485 + jr_lo * 1502;
  c = floor(lo / 16777216);
  jr_lo = lo - c * 16777216;
  m += c;
  jr_hi = m - floor(m / 16777216) * 16777216;
  jr_hi * 256 + floor(jr_lo / 65536);
);
function jr_bip() local(u, q, s, fl, d) (
  u = jr_next();
  u >= 16777216 ? (
    q = 1; while (u / q >= 16777216) ( q *= 2; );
    s = u / q; fl = floor(s); d = s - fl;
    d > 0.5 ? fl += 1 : d === 0.5 ? ((fl - 2 * floor(fl * 0.5)) !== 0 ? fl += 1);
    u = fl * q;
  );
  u = min(u / 4294967296, 1 - 1 / 8388608);
  u * 2 - 1;
);
jr_hi = 6911589; jr_lo = 4420980;

function wch6() local(c0, c1, c2, c3, c4, c5, v) (
  c0 = 0.4; c1 = c0 + 0.3; c2 = c1 + 0.1; c3 = c2 + 0.1; c4 = c3 + 0.05; c5 = c4 + 0.05;
  v = rfloat(0.0, c5);
  v < c0 ? 1 : v < c1 ? 2 : v < c2 ? 3 : v < c3 ? 4 : v < c4 ? 6 : 8;
);
function wch3() local(c0, c1, c2, v) (
  c0 = 0.5; c1 = c0 + 0.4; c2 = c1 + 0.1;
  v = rfloat(0.0, c2);
  v < c0 ? 1 : v < c1 ? 2 : 4;
);

bb_tempo = 180; bb_sr = 44100; bb_subdiv = 8; bb_num = 4; bb_den = 4;
unitsdone = 0; totalunits = 0; barsnow = 0; unitsinblock = 0; unitsinsideblock = 0;
strategy = 0;
cp_minamp = 1; cp_maxamp = 1; cp_minpan = 0.5; cp_maxpan = 0.5; cp_mindet = 0; cp_maxdet = 0;
cp_duty = 1; cp_fduty = 1; cp_maxph = 4; cp_minph = 1;
c11_stch = 1; c11_star = 0.5; c11_minrep = 1; c11_maxrep = 2;
wc_str = 0.5; wc_reg = 0.7; wc_rit = 0.6; wc_acc = 0.9;
sq_act = 0.1; sq_fill = 0; sq_fnum = 0; sq_fpos = 0;
currentcut = 0; inputindex = 0; readindex = 0; pl_ll = 0; pl_lr = 0; pl_rl = 0; pl_rr = 0; pl_fade = 1;
pl_pitch = 0; bsz = 0; cur_sz = 0; cur_ln = 0;
cr_minb = 32; cr_maxb = 32; cr_sb = 32; cr_eb = 32; cr_mult = 2^32; cr_div = 2^-32;
cr_minf = 44100; cr_maxf = 44100; cr_sf = 44100; cr_ef = 44100; cr_sr = 44100;
cr_lag = 1; cr_cnt = 0; cr_m1 = 0; cr_m2 = 0; cr_on = 1;
cb_mind = 50; cb_maxd = 50; cb_sd = 50; cb_ed = 50; cb_fb = 0.5; cb_type = 0; cb_sr = 44100; cb_delay = 2205; cb_on = 1;
dl1_w = 0; dl1_d = 2205; dl1_o = 0; dl2_w = 0; dl2_d = 2205; dl2_o = 0;
lp_time = 40; lp_out = 50; lp_sr = 44100;
lp_lam = exp(log(1.0 - 0.66) / ((0.001 * lp_time) * lp_sr));
LP_NOISE = 141 * 2^-74;
pi_4 = atan(1);
VEL_K = f32(1 / 127);
k_sr = 44100; k_subdiv = 8; k_lpim = -1; k_expv = 0; k_exp = 0; kpos = 0; kdps = 0;

function set_cutproc(v) ( v >= 0 && v < 3 ? strategy = v; );
function set_subdiv(v) ( k_subdiv = v; bb_subdiv = v; );
function set_fade(ms) local(v) ( v = (ms * 0.001) * bb_sr; v < 1 ? v = 1; pl_fade = itr(v); );
function set_minfreq(nm) ( cr_minf = nm * (k_sr - k_sr / 100.0) + k_sr / 100.0; );
function set_maxfreq(nm) ( cr_maxf = nm * (k_sr - k_sr / 100.0) + k_sr / 100.0; );
function k_setsr(r) (
  k_sr = r; cr_sr = r; cb_sr = r; lp_sr = r;
  lp_lam = exp(log(1.0 - 0.66) / ((0.001 * lp_time) * lp_sr));
);

function cr_oncut(c, n) local(ph, bits, fr) (
  ph = c / n;
  bits = cr_sb + ph * cr_eb;
  cr_mult = pow(2, bits); cr_div = 1 / cr_mult;
  fr = cr_sf + ph * cr_ef;
  cr_lag = cr_sr / fr;
);
function cb_oncut(c, n) (
  cb_delay = ((cb_sd + (c / n) * cb_ed) * cb_sr) / 1000;
  cb_type === 0 ? (dl1_d = cb_delay; dl2_d = cb_delay;);
);
function pl_rot(amp, pan) local(a) (
  a = (pan * 2) * pi_4;
  pl_ll = amp * (pan < 0 ? 1 : cos(a));
  pl_lr = amp * (pan < 0 ? 0 : sin(a));
  pl_rl = amp * (pan > 0 ? 0 : -sin(a));
  pl_rr = amp * (pan > 0 ? 1 : cos(a));
);
function pl_pitchcut(cents) local(ratio, sz, i, ps, fr) (
  ratio = pow(2, cents / 1200);
  sz = min(bsz, itr(bsz / ratio) - 1);
  i = 0;
  loop(sz,
    ps = floor(i * ratio);
    fr = i * ratio - ps;
    PBL[i] = IBL[ps] * (1 - fr) + IBL[ps + 1] * fr;
    PBR[i] = IBR[ps] * (1 - fr) + IBR[ps + 1] * fr;
    i += 1;
  );
  pl_pitch = 1;
);
function pl_onblock(nc) local(i, mx, t, ob) (
  nc > 0 ? (
    t = cuts; cuts = tcuts; tcuts = t; ncuts = nc;
    pl_rot(cuts[3 * MAXC], cuts[2 * MAXC]);
    inputindex = 0; readindex = 0; currentcut = 0;
    cur_sz = cuts[0]; cur_ln = cuts[MAXC];
    cr_oncut(0, ncuts); cb_oncut(0, ncuts);
    mx = 0; i = 0;
