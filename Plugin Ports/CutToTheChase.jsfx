      gfx_set(0.56, 0.60, 0.66, 0.35); gfx_rect(gsx(gx), gsy(G_PY0 - 2), max(1, G_SC), (G_PH + 4) * G_SC);
      gi < G_TU / G_SDV ? gtext(gx + 5, G_PY0 + G_PH + 10, sprintf(#g_s, "bar %d", gi + 1), 4, 0.62, 0.65, 0.70, 1, 0);
      gi += 1;
