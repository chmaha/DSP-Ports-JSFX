);

function grange(x, y, w, s1, s2, nm, vs) local(lo, hi, t0, t1, xa, xb, xc, hov, h1, h2, yy, ty, mo1, mo2, xm) (
  lo = GLO[s1]; hi = GHI[s1];
  t0 = (slider(s1) - lo) / (hi - lo); t1 = (slider(s2) - lo) / (hi - lo);
  xa = x + t0 * w; xb = x + t1 * w;
  ty = y + 12;
  hov = ghit(x - 8, y - 4, w + 16, 26);
  hov ? G_HINT = s1;
  (hov && G_CLK) ? (
    abs(G_MX - xa) <= abs(G_MX - xb) && !(abs(xa - xb) < 0.5 && G_MX > xa) ? G_RH = s1 : G_RH = s2;
    G_DBL ? ( gset(s1, GDEF[s1]); gset(s2, GDEF[s2]); gend(s1); gend(s2); ) : ( G_DRAG = G_RH; G_DY0 = G_MX; );
  );
  (G_DRAG === s1 || G_DRAG === s2) && G_DN ? (
    gset(G_DRAG, lo + gclamp((G_MX - x) / w, 0, 1) * (hi - lo));
  );
  (hov && G_WHL !== 0 && !G_DRAG) ? (
    xm = abs(G_MX - xa) <= abs(G_MX - xb) ? s1 : s2;
    gset(xm, slider(xm) + (hi - lo) * G_WHL / 120 * 0.01 * G_FINE + (GST[xm] > 0 ? GST[xm] * sign(G_WHL) * 0.51 : 0)); gend(xm);
  );
  t0 = (slider(s1) - lo) / (hi - lo); t1 = (slider(s2) - lo) / (hi - lo);
  xa = x + t0 * w; xb = x + t1 * w;
  gtext(x, y - 6, nm, 1, 0.90, 0.92, 0.94, 1, 0);
  gtext(x + w, y - 6, vs, 2, G_ACR * 0.5 + 0.45, G_ACG * 0.5 + 0.45, G_ACB * 0.5 + 0.45, 1, 2);
  gfrr(gsx(x), gsy(ty - 3), gsx(x + w), gsy(ty + 3), 3 * G_SC, 0.05, 0.055, 0.06, 1);
  gfrr(gsx(min(xa, xb)), gsy(ty - 3), gsx(max(xa, xb)) + 1, gsy(ty + 3), 3 * G_SC, G_ACR, G_ACG, G_ACB, 0.85);
  (lo < 0 && hi > 0) ? ( gfx_set(0.56, 0.60, 0.66, 0.6); gfx_rect(gsx(x + w * (-lo) / (hi - lo)), gsy(ty - 6), max(1, G_SC), 12 * G_SC); );
  mo1 = gmodoff(s1); mo2 = gmodoff(s2);
  abs(mo1) > 0.0005 ? gdisc(gsx(x + gclamp(t0 + mo1, 0, 1) * w), gsy(ty), 3 * G_SC, 0.96, 0.96, 0.98, 0.7);
  abs(mo2) > 0.0005 ? gdisc(gsx(x + gclamp(t1 + mo2, 0, 1) * w), gsy(ty), 3 * G_SC, 0.96, 0.96, 0.98, 0.7);
  h1 = G_DRAG === s1; h2 = G_DRAG === s2;
  gdisc(gsx(xa), gsy(ty), 7 * G_SC, 0.03, 0.035, 0.04, 0.8);
  gdisc(gsx(xa), gsy(ty), 6 * G_SC, 0.93, 0.94, 0.96, 1);
  gdisc(gsx(xa), gsy(ty), 3 * G_SC, G_ACR, G_ACG, G_ACB, h1 ? 1 : 0.8);
  gdisc(gsx(xb), gsy(ty), 7 * G_SC, 0.03, 0.035, 0.04, 0.8);
  gdisc(gsx(xb), gsy(ty), 6 * G_SC, 0.93, 0.94, 0.96, 1);
  gdisc(gsx(xb), gsy(ty), 3 * G_SC, G_ACR, G_ACG, G_ACB, h2 ? 1 : 0.8);
);

function gtoggle(x, y, w, h, s, lb) local(hov, on) (
  hov = ghit(x, y, w, h);
  hov ? G_HINT = s;
  (hov && G_CLK) ? ( gset(s, slider(s) > 0.5 ? 0 : 1); gend(s); );
  on = slider(s) > 0.5;
  gpill(x, y, w, h, lb, on, hov, G_ACR, G_ACG, G_ACB);
