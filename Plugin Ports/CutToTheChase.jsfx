LCPQ = alloc(14);
LCPQ[0] = 0.25; LCPQ[1] = 0.375; LCPQ[2] = 0.5; LCPQ[3] = 0.75; LCPQ[4] = 1.0; LCPQ[5] = 1.5; LCPQ[6] = 2.0;
LCPQ[7] = 3.0; LCPQ[8] = 4.0; LCPQ[9] = 6.0; LCPQ[10] = 8.0; LCPQ[11] = 12.0; LCPQ[12] = 16.0; LCPQ[13] = 24.0;
WCPQ = alloc(14);
WCPQ[0] = 16.0; WCPQ[1] = 24.0; WCPQ[2] = 8.0; WCPQ[3] = 12.0; WCPQ[4] = 4.0; WCPQ[5] = 6.0; WCPQ[6] = 2.0;
WCPQ[7] = 3.0; WCPQ[8] = 1.0; WCPQ[9] = 1.5; WCPQ[10] = 0.5; WCPQ[11] = 0.75; WCPQ[12] = 0.25; WCPQ[13] = 0.375;
WBARS = alloc(7);
WBARS[0] = 1; WBARS[1] = 2; WBARS[2] = 4; WBARS[3] = 8; WBARS[4] = 16; WBARS[5] = 32; WBARS[6] = 64;

CSN = alloc(13);
CSO = alloc(13 * 8);
CSL = alloc(13 * 8);
CSV = alloc(128);
cs_w = 0;
function cs_pos(f, p, n) ( CSO[f * 8 + p] = cs_w; CSL[f * 8 + p] = n; CSN[f] = max(CSN[f], p + 1); );
function cs_v(x) ( CSV[cs_w] = x; cs_w += 1; );
cs_pos(0, 0, 4); cs_v(0.75); cs_v(0.75); cs_v(0.75); cs_v(0.75);
cs_pos(0, 1, 1); cs_v(1.0);
cs_pos(1, 0, 2); cs_v(0.5); cs_v(1.0);
cs_pos(1, 1, 1); cs_v(1.0);
