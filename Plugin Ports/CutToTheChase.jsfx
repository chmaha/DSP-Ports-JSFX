function gtab(x, y, w, h, lb, on, hov) ( gpill(x, y, w, h, lb, on, hov, 0.98, 0.50, 0.40); );


G_PAGE = 0; G_SUB = 0; G_DRAG = 0;
last_srate = 0;

@slider
last_srate !== srate ? (
  last_srate = srate;
  prepare(max(1, srate));
);

@block
blk_n = samplesblock;
srate_cur = max(1, srate);
k_ran ? (k_exp = kpos; k_expv = 1; k_ran = 0;);
while (midirecv(mofs, mm1, mm23)) (
  mst = mm1 & 0xF0;
  md1 = mm23 & 0x7F;
  md2 = (mm23 / 256) & 0x7F;
  (mst === 0xB0 && md1 === 1) ? mw_val = md2 / 127;
  (mst === 0x90 && md2 > 0) ? (
    NOTES[md1] = 1;
    vel_val = f32(md2 * VEL_K);
