  txt_cc(gfx_fx(x, w, 100), y + h - 10, "100Hz");
  txt_cc(gfx_fx(x, w, 1000), y + h - 10, "1kHz");
  txt_cc(gfx_fx(x, w, 10000), y + h - 10, "10kHz");
  txt_r(x + w - 3, y + h - 10, "20kHz");
);

function gcurve(arr, n, x, y, w, h, dbmin, dbmax) local(i, x1, y1, x2, y2, v)
(
  i = 0;
  loop(n,
    v = max(dbmin, min(dbmax, arr[i]));
    x2 = gxp(x + w * (i + 0.5) / n); y2 = gyp(y + h * (dbmax - v) / (dbmax - dbmin));
    i > 0 ? (
      gfx_line(x1, y1, x2, y2, 1);
      gfx_a *= 0.5; gfx_line(x1, y1 + 1, x2, y2 + 1, 1); gfx_a *= 2;
    );
    x1 = x2; y1 = y2;
    i += 1;
  );
);

function gfr_x(f) ( gfr_x0 + gfr_w * log(max(f, 20) / 20) / log(1000); );
function gfr_f(x) ( 20 * (1000 ^ ((x - gfr_x0) / gfr_w)); );
function gfr_y(db) ( gfr_y0 + gfr_h * (6 - db) / 66; );
function gfr_bq(f, fc, hp) local(w0, al, cw, b0, b1, b2, a0, a1, a2, ph, n, d)
(
  w0 = (2 * $pi * fc) / 48000; al = sin(w0) / (2 * 0.707); cw = cos(w0);
  hp ? ( b0 = (1 + cw) / 2; b1 = -(1 + cw); ) : ( b0 = (1 - cw) / 2; b1 = 1 - cw; );
  b2 = b0; a0 = 1 + al; a1 = -2 * cw; a2 = 1 - al;
  ph = sqr(sin($pi * f / 48000));
  n = sqr(b0 + b1 + b2) - 4 * (b0 * b1 + 4 * b0 * b2 + b1 * b2) * ph + 16 * b0 * b2 * ph * ph;
  d = sqr(a0 + a1 + a2) - 4 * (a0 * a1 + 4 * a0 * a2 + a1 * a2) * ph + 16 * a0 * a2 * ph * ph;
  10 * log10(max(10 ^ -30, n / d));
);
function gfr_db(f, hs, ls, hf, lf) local(db)
(
  db = 0;
  hs > 0 ? db += hs * gfr_bq(f, hf, 1);
  ls > 0 ? db += ls * gfr_bq(f, lf, 0);
  db;
);

function gfreqrange(x0, y0, w, h, hs, ls, hf, lf, hpv, lpv, dh, dl) local(i, f, x, y, px, py, db, t, r, hv, ex, xa, xb, fr)
(
  gfr_x0 = x0; gfr_y0 = y0; gfr_w = w; gfr_h = h;
  hexc(0x000000, 1); grect(x0, y0, w, h);
  xa = hs > 0 ? gfr_x(hf) : x0; xb = ls > 0 ? gfr_x(lf) : x0 + w;
  hexc(0xfdfeff, 0.17);
  grect(x0, y0, xa - x0, h);
  grect(xb, y0, x0 + w - xb, h);
  hexc(0xffffff, 0.15);
  i = 0;
  loop(5, ghl(x0, gfr_y(-12 * i), w); i += 1; );
  hexc(0xffffff, 0.35); ghl(x0, gfr_y(0), w);
  f = 20;
  loop(28,
    f < 20000.5 ? ( hexc(0xffffff, (f === 100 || f === 1000 || f === 10000 || f === 20) ? 0.25 : 0.12); gvl(gfr_x(f), y0, h); );
    f += f < 100 ? 10 : f < 1000 ? 100 : f < 10000 ? 1000 : 10000;
  );
  hs > 0 ? ( hexc(0xfdfeff, 0.85); gvl(xa, y0, h); );
  ls > 0 ? ( hexc(0xfdfeff, 0.85); gvl(xb, y0, h); );
  gfont(10, 0); hexc(0x9498a2, 1);
  i = 0;
  loop(5,
    txt_r(x0 + w - 2, gfr_y(-12 * i), i === 0 ? "0dB" : sprintf(#gv, "%ddB", -12 * i));
    i += 1;
  );
  txt_l(x0 + 4, y0 + h - 9, "20Hz"); txt_cc(gfr_x(100), y0 + h - 9, "100Hz"); txt_cc(gfr_x(1000), y0 + h - 9, "1kHz"); txt_cc(gfr_x(10000), y0 + h - 9, "10kHz"); !gfr_no20k ? txt_r(x0 + w - 2, y0 + h - 9, "20kHz");
  px = -1;
  x = x0;
  loop(floor(w / 2) + 1,
    f = gfr_f(x);
    db = min(6, gfr_db(f, hs, ls, hf, lf));
    y = gfr_y(db);
    t = 1 - (y - y0) / h;
    (px >= 0 && py <= y0 + h && y <= y0 + h) ? ( grad_at(t); gthick(gxp(px), gyp(py), gxp(x), gyp(y)); );
    px = x; py = y;
    x += 2;
  );
  i = 0;
  loop(2,
    r = i ? ls : hs;
    f = i ? lf : hf;
    r > 0 ? (
      ex = gfr_x(f);
      hv = abs(gmx - ex) <= 6 && gmy >= y0 && gmy <= y0 + h;
      hv && gclick && gdrag === 0 ? ( gdrag = i ? dl : dh; gclick = 0; );
    );
    i += 1;
  );
  gdrag === dh && gdown ? ( mouse_cap |= 65536; gnv = max(20, min(20000, gfr_f(max(x0, min(x0 + w, gmx))))); gnv !== slider(hpv) ? set_sl(hpv, gnv); );
  gdrag === dl && gdown ? ( mouse_cap |= 65536; gnv = max(20, min(20000, gfr_f(max(x0, min(x0 + w, gmx))))); gnv !== slider(lpv) ? set_sl(lpv, gnv); );
);

function gslopemenu(x, y, w, h, m, sl) local(r)
(
  gselbox(x, y, w, h, m === 0 ? "Off" : sprintf(#gv, "%d dB", m * 12)) ? (
    r = gmenu_at("Off|12 dB|24 dB|36 dB|48 dB");
    r >= 0 ? set_sl_done(sl, r);
  );
);


function th_set() local(d, s, i)
(
  d = g_day >= 0.5; s = floor(max(0, min(4, g_acc)) + 0.5);
  th_key = d * 10 + s;
  th_day = d; th_sch = s;
  i = 0; loop(24, TC[i] = THPAL[d * 24 + i]; i += 1; );
  i = 0; loop(15, TC[24 + i] = THPAL[48 + s * 15 + i]; i += 1; );
  th_ir = TC[12]; th_ig = TC[13]; th_ib = TC[14];
);

function gtheme_ui() local(y, r)
(
  y = gH - 20;
  gfont(11, 0);
  gbtn(10, y, 50, 16, 0, 0x0066ff) ? set_sl_done(25, th_day ? 0 : 1);
  hexc(0xfdfeff, 1); txt_cc(35, y + 8, th_day ? "Light" : "Dark");
  gbtn(68, y, 90, 16, 0, 0x0066ff) ? (
    r = gmenu_at("calfnxt|fire|lime|sea|slick");
    r >= 0 ? set_sl_done(26, r);
  );
  hexc(0xfdfeff, 1);
  txt_l(76, y + 8, th_sch === 0 ? "calfnxt" : th_sch === 1 ? "fire" : th_sch === 2 ? "lime" : th_sch === 3 ? "sea" : "slick");
  gfx_triangle(gxp(144), gyp(y + 6), gxp(152), gyp(y + 6), gxp(148), gyp(y + 11));
);

function gbus_l(m, k) ( m === 2 && k === 0 ? sprintf(#gbl, "M") : m === 2 && k === 1 ? sprintf(#gbl, "S") : k === 0 ? sprintf(#gbl, "L") : sprintf(#gbl, "R"); #gbl; );

function gafter(m, k)
(
  m === 1 ? ( k === 0 ? sprintf(#gal, "M") : sprintf(#gal, "S") ) :
  m === 3 ? sprintf(#gal, "L") :
  m === 4 ? sprintf(#gal, "R") :
  m === 5 ? sprintf(#gal, "M") :
  m === 6 ? ( k === 0 ? sprintf(#gal, "R") : sprintf(#gal, "L") ) :
  ( k === 0 ? sprintf(#gal, "L") : sprintf(#gal, "R") );
  #gal;
);

function gbus(cx, bef) local(k, cy, tw, th, md)
(
  md = floor(g_mode + 0.5);
  k = 0;
  loop(2,
    cy = 225.1 + k * 44.7;
    hexc(0x0a0d10, 1); grect(cx - 10, cy - 14, 20, 28);
    gfont(20, 0); hexc(0x9498a2, 1);
    txt_cc(cx - 3.5, cy, bef ? gbus_l(md, k) : gafter(md, k));
    gfx_triangle(gxp(cx + 4.5), gyp(cy - 3.5), gxp(cx + 4.5), gyp(cy + 3.5), gxp(cx + 10), gyp(cy));
    k += 1;
  );
);

function gheader()
(
  title_logo(10, 3, "Stereo");
  gfont(21, 0); hexc(0xfdfeff, 1); txt_l(109.6, 22, "IN");
