// Modified 2026: translated to JSFX from calfNXT Stereo.
// https://github.com/boomshop/calfnxt

slider1:g_bypass=0<0,1,1{Off,On}>-Bypass
slider2:g_in=0<-60,12,0.01>-In (dB)
slider3:g_out=0<-60,12,0.01>-Out (dB)
slider4:g_lvl_l=0<-36,36,0.01>-In Level Left (dB)
slider5:g_lvl_r=0<-36,36,0.01>-In Level Right (dB)
slider6:g_mode=0<0,6,1{LR>LR,LR>MS,MS>LR,LR>LL,LR>RR,LR>L+R,LR>RL}>-Mode
slider7:g_mlev=0<-36,36,0.01>-M Level (dB)
slider8:g_mpan=0<-1,1,0.001>-M Pan
slider9:g_slev=0<-36,36,0.01>-S Level (dB)
slider10:g_sbal=0<-1,1,0.001>-S Balance
slider11:g_dec=0<0,1,1{Off,On}>-Decorrelate
slider12:g_dec_amt=0.5<0,1,0.001>-Decorrelate Amount
slider13:g_dec_xo=400<80,2000,0.01:log=400>-Decorrelate Crossover (Hz)
slider14:g_dec_slope=24<12,48,12>-Decorrelate Slope (dB)
slider15:g_dec_stages=4<1,8,1>-Decorrelate Stages
slider16:g_dec_spread=0.5<0,1,0.001>-Decorrelate Spread
slider17:g_ml=0<0,1,1{Off,On}>-Mute Left
slider18:g_mr=0<0,1,1{Off,On}>-Mute Right
slider19:g_pl=0<0,1,1{Off,On}>-Phase Left
slider20:g_pr=0<0,1,1{Off,On}>-Phase Right
slider21:g_delay=0<-20,20,0.01>-Delay (ms)
slider22:g_base=0<-1,1,0.001>-Stereo Base
slider23:g_phase=0<0,360,0.1>-Stereo Phase (deg)
slider24:g_balout=0<-1,1,0.001>-Balance Out
slider25:g_day=0<0,1,1{Night,Day}>-Theme Mode
slider26:g_acc=0<0,4,1{NXT,Fire,Lime,Sea,Slick}>-Theme Colors

in_pin:Left input
in_pin:Right input
out_pin:Left output
out_pin:Right output
options:no_meter

@init
ext_noinit = gfx_ext_retina = 1;

function alloc(n) local(r) instance(mp) global() ( r = mp; mp += n; memset(r, 0, n); r; );
alloc.mp = 0;

function f32(x) local(c) ( c = x * 536870913; c - (c - x); );
function dblin(db) ( (10 ^ (db * K005)); );

K005 = (0.05); K001 = (0.001); K04 = (0.4); EPS6 = (0.000001); K045 = (0.45);
KDEG = ($pi / 180);
FMIN64 = 2.2250738585072014 / (10 ^ 308); SM50 = 10 ^ -50;

LPC = alloc(40); HPC = alloc(40); LPS = alloc(32); HPS = alloc(32);
SQ = alloc(8);
AAA = alloc(16); AX = alloc(16); AY = alloc(16);
KAC = alloc(8); KBC = alloc(8);
mem_set_values(KAC, 0.32, -0.48, 0.61, -0.27, 0.73, -0.55, 0.18, -0.67);
mem_set_values(KBC, -0.38, 0.52, -0.58, 0.41, -0.69, 0.29, -0.47, 0.63);

sp_sr = (srate);
ny_ = (sp_sr * K045);
sp_tgt = 200; sp_cur = 200; sp_slope = 1; sp_dirty = 1;
dl_n = max(4, floor(srate * 0.05) * 2);
DLB = alloc(dl_n);
dl_pos = 0;
dl_cur = (g_delay);
dl_coef = (1 - exp(-1 / (0.008 * max(1, srate))));
dl_max = (dl_n / 2) - 2;
last_x = -1; last_sl = -1; last_sp = -1; last_st = -1;
st_n = 4;
corr_c = exp(-1 / (0.4 * srate));
env_rel = (exp(log(0.01) / (2000 * srate * 0.001)));
rg_n = max(64, floor(srate / 30) * 2);
RGB = alloc(rg_n);
rg_pos = 0; fe_env = 0.25; fe_lr = fe_l2 = fe_r2 = 0; fe_corr = 0;
gui_beat = 0; gb_prev = -1; gb_idle = 100;
mt_il = mt_ir = mt_ol = mt_or = 0;

function glide(v, t) local(a, b, la, lb, o)
(
  v === t ? v : (
    a = max(EPS6, v); b = max(EPS6, t);
    (abs((a - b))) <= (K001 * max(a, b)) ? t : (
      la = (log(a)); lb = (log(b));
      o = (exp((la + ((lb - la) * K04))));
      ((t > v && o >= t) || (t < v && o <= t)) ? t : o;
    );
  );
);

function sp_enforce(f) local(g) ( g = max(20, min(f, ny_)); g = max(g, 30); min(g, ny_); );

function sp_stages() ( sp_slope === 0 ? 1 : sp_slope === 1 ? 2 : sp_slope === 2 ? 4 : 8; );

function sp_update() local(st, s, q, om, sn, cs, al, iv, a0, c, p)
(
  st = sp_stages();
  SQ[0] = (0.5); SQ[1] = 0; SQ[2] = 0; SQ[3] = 0;
  sp_slope === 0 ? ( SQ[0] = (0.5); ) :
  sp_slope === 1 ? ( SQ[0] = SQ[1] = (0.7071067811865476); ) :
  ( SQ[0] = SQ[2] = (0.541196100146197); SQ[1] = SQ[3] = (1.306562964876376); );
  s = 0;
  loop(8,
    p = LPC + s * 5; c = HPC + s * 5;
    s < st ? (
      q = SQ[s];
      om = ((2 * $pi * sp_cur) / sp_sr);
      sn = sin(om); cs = cos(om);
      al = sn / (2 * q);
      iv = 1 / (1 + al);
      a0 = ((1 * iv) * (1 - cs)) * 0.5;
      p[0] = a0; p[1] = a0 + a0; p[2] = a0; p[3] = ((-2 * cs) * iv); p[4] = (1 - al) * iv;
      a0 = ((1 * iv) * (1 + cs)) * 0.5;
      c[0] = a0; c[1] = -2 * a0; c[2] = a0; c[3] = ((-2 * cs) * iv); c[4] = (1 - al) * iv;
    ) : (
      p[0] = 1; p[1] = p[2] = p[3] = p[4] = 0;
      c[0] = 1; c[1] = c[2] = c[3] = c[4] = 0;
      memset(LPS + s * 4, 0, 4); memset(HPS + s * 4, 0, 4);
    );
    s += 1;
  );
  sp_dirty = 0;
);

function sp_process(x) local(lo, hi, s, p, c, st, y, n)
(
  lo = hi = x;
  n = sp_stages();
  s = 0;
  loop(n,
    p = LPC + s * 5; st = LPS + s * 4;
    y = ((((lo * p[0]) + (st[0] * p[1])) + (st[1] * p[2])) - (st[2] * p[3])) - (st[3] * p[4]);
    st[1] = st[0]; st[3] = st[2]; st[0] = lo; st[2] = y; lo = y;
    c = HPC + s * 5; st = HPS + s * 4;
    y = ((((hi * c[0]) + (st[0] * c[1])) + (st[1] * c[2])) - (st[2] * c[3])) - (st[3] * c[4]);
    st[1] = st[0]; st[3] = st[2]; st[0] = hi; st[2] = y; hi = y;
    s += 1;
  );
  sp_lo = (lo); sp_hi = (hi);
);

function sp_sanitize() local(i)
(
  i = 0;
  loop(32, abs(LPS[i]) < SM50 ? LPS[i] = 0; abs(HPS[i]) < SM50 ? HPS[i] = 0; i += 1; );
);

function ap_set(ch, spread, inv) local(t, i, tg, c)
(
  t = max(0, min(1, spread));
  i = 0;
  loop(8,
    tg = inv ? KBC[i] : KAC[i];
    c = KAC[i] * (1 - t) + tg * t;
    AAA[ch * 8 + i] = max(-0.999, min(0.999, c));
    i += 1;
  );
);

function ap_run(ch, x) local(i, y, xd, a, o)
(
  i = 0; o = ch * 8;
  loop(st_n,
    a = AAA[o + i];
    xd = x;
    y = a * (xd - AY[o + i]) + AX[o + i];
    AX[o + i] = xd; AY[o + i] = y;
    abs(AX[o + i]) < FMIN64 ? AX[o + i] = 0;
    abs(AY[o + i]) < FMIN64 ? AY[o + i] = 0;
    x = (y);
    i += 1;
  );
  x;
);

