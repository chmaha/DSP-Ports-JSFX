function gtog(x, y, s, ic, ic_on, col) local(on)
(
  on = slider(s) >= 0.5;
  gbtn(x, y, 36.1, 39.4, on, col) ? set_sl_done(s, on ? 0 : 1);
  hexc(0xfdfeff, 1);
  gglyph(on ? ic_on : ic, x + 18.05, y + 19.7, 20);
);

function gmodes() local(i, y, on, md)
(
  md = floor(g_mode + 0.5);
  i = 0;
  loop(7,
    y = 88.4 + i * 45.9;
    on = md === i;
    gbtn(17, y, 94, 43.9, on, 0x0066ff) ? set_sl_done(6, i);
    hexc(0xfdfeff, 1); gfont(14, 0);
    i === 0 ? txt_cc(64, y + 22, "LR → LR") :
    i === 1 ? txt_cc(64, y + 22, "LR → MS") :
    i === 2 ? txt_cc(64, y + 22, "MS → LR") :
    i === 3 ? txt_cc(64, y + 22, "LR → LL") :
    i === 4 ? txt_cc(64, y + 22, "LR → RR") :
    i === 5 ? txt_cc(64, y + 22, "LR → L+R") :
    txt_cc(64, y + 22, "LR → RL");
    i += 1;
  );
);

function gcorr(x, y, w, v) local(x0, xc, xv, bh, by, k, xa, xb, nn, a, u)
(
  bh = max(1, floor(9.2 * gsc + 0.5));
  by = floor(gyp(y) + 0.5);
  xc = gxp(x + w * 0.5);
  hexc(0x000000, 1); gfx_rect(gxp(x), by, w * gsc, bh);
  nn = max(8, floor(w * gsc * 0.5));
  k = 0;
  loop(nn,
    xa = gxp(x) + (xc - gxp(x)) * k / nn;
    xb = gxp(x) + (xc - gxp(x)) * (k + 1) / nn;
    u = (k + 0.5) / nn; gfx_r = TC[33] + (TC[30] - TC[33]) * u; gfx_g = TC[34] + (TC[31] - TC[34]) * u; gfx_b = TC[35] + (TC[32] - TC[35]) * u; gfx_a = 0.2;
    gfx_rect(xa, by, xb - xa + 1, bh);
    k += 1;
  );
  hexc(0x0066ff, 0.2); gfx_rect(xc, by, gxp(x + w) - xc, bh);
  xv = xc + v * (gxp(x + w) - gxp(x)) * 0.5;
  v >= 0 ? ( hexc(0x0066ff, 1); gfx_rect(xc, by, xv - xc, bh); ) : (
    k = 0;
    loop(nn,
      xa = gxp(x) + (xc - gxp(x)) * k / nn;
      xb = gxp(x) + (xc - gxp(x)) * (k + 1) / nn;
      xb > xv ? (
        u = (k + 0.5) / nn; gfx_r = TC[33] + (TC[30] - TC[33]) * u; gfx_g = TC[34] + (TC[31] - TC[34]) * u; gfx_b = TC[35] + (TC[32] - TC[35]) * u; gfx_a = 1;
        gfx_rect(max(xa, xv), by, xb - max(xa, xv) + 1, bh);
      );
      k += 1;
    );
  );
  gfont(10, 0); hexc(0x9498a2, 1);
  txt_cc(826.4, y + 21.2, "-1.0"); txt_cc(865.8, y + 21.2, "-0.5"); txt_cc(906.5, y + 21.2, "0.0"); txt_cc(949.8, y + 21.2, "+0.5"); txt_cc(986.6, y + 21.2, "+1.0");
);

function ggonio(x, y, sz) local(i, n, pairs, outp, step, srcp, idx, l, r, a, R, px, py, t, hw, cx0, cy0, lw)
(
  hexc(0x010203, 1); grect(x, y, sz, sz);
  hw = sz * 0.5; cx0 = x + hw; cy0 = y + hw;
  hexc(0xfdfeff, 0.17);
  gline(x + sz * 0.5, y + sz * 0.12, x + sz * 0.5, y + sz * 0.92);
  gline(x + sz * 0.08, y + sz * 0.5, x + sz * 0.92, y + sz * 0.5);
  gline(x + sz * 0.12, y + sz * 0.12, x + sz * 0.92, y + sz * 0.92);
  gline(x + sz * 0.88, y + sz * 0.12, x + sz * 0.08, y + sz * 0.92);
  gfont(9, 0); hexc(0xfdfeff, 0.28);
  gfx_x = gxp(x + sz * 0.5) - 3; gfx_y = gyp(y + sz * 0.04); gfx_drawstr("M");
  gfx_x = gxp(x + sz * 0.95); gfx_y = gyp(y + sz * 0.5) - 5; gfx_drawstr("S");
  gfx_x = gxp(x + sz * 0.06); gfx_y = gyp(y + sz * 0.04); gfx_drawstr("R");
  gfx_x = gxp(x + sz * 0.94) - 4; gfx_y = gyp(y + sz * 0.04); gfx_drawstr("L");
  pairs = rg_n / 2; outp = min(pairs, 128); step = max(1, floor(pairs / outp));
  i = 0;
  loop(outp,
    srcp = (i * step) % pairs;
    idx = (rg_pos + srcp * 2) % rg_n;
    l = RGB[idx]; r = RGB[idx + 1];
    (l !== 0 || r !== 0) ? (
      a = r === 0 ? (l > 0 ? $pi * 0.5 : $pi * 1.5) : atan2(l, r);
      a += $pi * 0.25;
      R = sqrt(l * l + r * r);
      px = -R * cos(a); py = R * sin(a);
      t = min(1, abs(px));
      grad_at(t);
      gfx_a = 1;
      gfx_circle(gxp(cx0 + px * hw), gyp(cy0 - py * hw), 1.5 * gsc, 1, 1);
    );
    i += 1;
  );
);

function gpanels() local(md, bm, an0, an1, ac)
(
  md = floor(g_mode + 0.5);
  gpanel(8.5, 56.4, 119.5, 359.6, "Mode");
