  an0 = md === 2 ? "M" : "L"; an1 = md === 2 ? "S" : "R";
  gdp = DOTS; gknob(194, 196.3, 35, 4, 0, -36, 36, 0, 0, 2, 1, 12, an0);
  gdp = DOTS; gknob(194, 300, 35, 5, 0, -36, 36, 0, 0, 2, 1, 12, an1);

  gfont(20, 0); hexc(0xfdfeff, 1);
  txt_cc(311.8, 128, "M"); txt_cc(311.8, 199.5, "S");
  gdp = DOTS; gknob(375.1, 126.7, 24, 7, 0, -36, 36, 0, 0, 2, 1, 12, "M Lev");
  gdp = DOTS + 20; gknob(450.6, 126.7, 24, 8, 0, -1, 1, 0, 0, 20, 1, 101, "M Pan");
  gdp = DOTS; gknob(373.2, 204.1, 24, 9, 0, -36, 36, 0, 0, 2, 1, 12, "S Lev");
  gdp = DOTS + 20; gknob(448.7, 204.1, 24, 10, 0, -1, 1, 0, 0, 20, 1, 101, "S Bal");
  gbtn_txt(280.9, 273.4, 70.6, 39.4, g_dec >= 0.5, 0x0066ff, "Decorr", 16) ? set_sl_done(11, g_dec >= 0.5 ? 0 : 1);
  ac = g_dec >= 0.5;
  gdp = DOTS + 40; gknob(394.2, 294.7, 24, 12, 0, 0, 1, 0.5, -10000000, 2, ac, 103, "Amount");
  gdp = DOTS + 60; gknob(472, 294.7, 24, 13, 1, 80, 2000, 400, -10000000, 2, ac, 104, "Xover");
  gdp = DOTS + 100; gsnap = 2; gknob(316.1, 372.2, 24, 14, 12, 12, 48, 24, -10000000, 22, ac, 14, "Slope");
  gdp = DOTS + 80; gsnap = 1; gknob(394.2, 372.2, 24, 15, 0, 1, 8, 4, -10000000, 5, ac, 13, "Stages");
  gdp = DOTS + 40; gknob(472.3, 372.2, 24, 16, 0, 0, 1, 0.5, -10000000, 2, ac, 103, "Spread");

  gtog(554, 204.1, 17, 13, 14, 0xff0066); gtog(598, 204.1, 19, 12, 12, 0x0066ff);
  gtog(554, 252.2, 18, 13, 14, 0xff0066); gtog(598, 252.2, 20, 12, 12, 0x0066ff);

  strcpy(#gdl_l, gafter(md, 0)); strcpy(#gdl_r, gafter(md, 1));
  gdp = DOTS + 140; gknob(726.3, 158.2, 24, 21, 0, -20, 20, 0, 0, 21, 1, 16, "Delay");
  gdp = DOTS + 20; gknob(726, 248.1, 35, 22, 0, -1, 1, 0, 0, 2, 1, 102, "Base");
  gdp = DOTS + 120; gknob(726.3, 340.7, 24, 23, 0, 0, 360, 0, -10000000, 2, 1, 15, "Phase");

  gdp = DOTS + 20; gknob(907.8, 141.1, 35, 24, 0, -1, 1, 0, 0, 20, 1, 101, "Balance");
  ggonio(818.4, 197.6, 180);
  gcorr(818.5, 384.6, 176, gcorr_v);
);

function gbuses()
(
  gbus(131.3, 1); gbus(254.7, 0); gbus(531.7, 0); gbus(653.8, 0); gbus(796.9, 0);
);

!gk_ready ? (
  gk_ready = 1;
  gdrag = 0; gml_i = gmr_i = gml_o = gmr_o = 0; gcorr_v = 0;
  ga_s = 135; ga_a = 270;
);

th_set();
gmx = (mouse_x - gox) / gsc;
gmy = (mouse_y - goy) / gsc;
gdown = mouse_cap & 1;
gclick = gdown && !gprev_down;
gdbl = gclick && gnow - glast_click < 0.3 && abs(gmx - glast_cx) < 4 && abs(gmy - glast_cy) < 4;
gclick ? ( glast_click = gnow; glast_cx = gmx; glast_cy = gmy; );

gml_i = max(mt_il, gml_i * 0.88); gmr_i = max(mt_ir, gmr_i * 0.88);
gml_o = max(mt_ol, gml_o * 0.88); gmr_o = max(mt_or, gmr_o * 0.88);
mt_il = mt_ir = mt_ol = mt_or = 0;
gcorr_v += (fe_corr - gcorr_v) * 0.3;

hexc(0x010203, 1); gfx_rect(0, 0, gfx_w, gfx_h);
gheader();
gpanels();
gbuses();

nxt_credit(); gtheme_ui();

gdrag > 0 && !gdown ? (
  automate(gdrag, 1);
  gdrag = 0;
);

gprev_down = gdown;
