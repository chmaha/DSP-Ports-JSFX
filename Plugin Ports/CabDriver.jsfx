// Modified 2026: translated to JSFX from mda Combo (mda-effects).
// https://github.com/pluginguru/mda-effects

slider1:p_model=0<0,1,0.0001>-Model
slider2:p_drive=0.5<0,1,0.001>-Drive
slider3:p_bias=0.5<0,1,0.001>-Bias
slider4:p_out=0.5<0,1,0.001>-Output
slider5:p_ster=0.4<0,1,0.001>-Process
slider6:p_hpf=0<0,1,0.001>-HPF Freq
slider7:p_reso=0.5<0,1,0.001>-HPF Reso

in_pin:Left input
in_pin:Right input
out_pin:Left output
out_pin:Right output
options:no_meter

@init

ext_noinit = gfx_ext_retina = 1;
ext_nodenorm = 1;

function itrunc(x) ( x < 0 ? ceil(x) : floor(x); );

BUFA = 0;
BUFB = 1024;
memset(BUFA, 0, 2048);
cb_pos = 0;
cb_f1 = cb_f2 = cb_f3 = cb_f4 = cb_f5 = 0;
cb_f6 = cb_f7 = cb_f8 = cb_f9 = cb_f10 = 0;
cb_h0 = cb_h1 = 0;
cb_clip = 0;

function cb_ff(hz) local(j, k, r)
(
  r = 0.9990000128746033;
  j = r * r - 1;
  k = 2 - 2 * r * r * cos((0.6470000147819519 * hz) / srate);
  (sqrt(k * k - 4 * j * j) - k) / (2 * j);
);

function cb_set() local(m)
(
  cb_ster = p_ster > 0.5;
  cb_hpf = cb_ff(25);
  m = itrunc(p_model * 6.900000095367432);
  m == 0 ? ( cb_trim = 0.5; cb_lpf = 0; cb_m1 = 0; cb_m2 = 0; cb_d1 = 0; cb_d2 = 0; ) :
  m == 1 ? ( cb_trim = 0.5299999713897705; cb_lpf = cb_ff(2700); cb_m1 = 0; cb_m2 = 0; cb_d1 = 0; cb_d2 = 0; cb_hpf = cb_ff(382); ) :
  m == 2 ? ( cb_trim = 1.100000023841858; cb_lpf = cb_ff(1685); cb_m1 = -1.7000000476837158; cb_m2 = 0.8199999928474426; cb_d1 = itrunc(srate / 6546); cb_d2 = itrunc(srate / 4315); ) :
  m == 3 ? ( cb_trim = 0.9800000190734863; cb_lpf = cb_ff(1385); cb_m1 = -0.5299999713897705; cb_m2 = 0.20999999344348907; cb_d1 = itrunc(srate / 7345); cb_d2 = itrunc(srate / 1193); ) :
  m == 4 ? ( cb_trim = 0.9599999785423279; cb_lpf = cb_ff(1685); cb_m1 = -0.8500000238418579; cb_m2 = 0.4099999964237213; cb_d1 = itrunc(srate / 6546); cb_d2 = itrunc(srate / 3315); ) :
  m == 5 ? ( cb_trim = 0.5899999737739563; cb_lpf = cb_ff(2795); cb_m1 = -0.28999999165534973; cb_m2 = 0.3799999952316284; cb_d1 = itrunc(srate / 982); cb_d2 = itrunc(srate / 2402); cb_hpf = cb_ff(459); ) :
  m == 6 ? ( cb_trim = 0.30000001192092896; cb_lpf = cb_ff(1744); cb_m1 = -0.9599999785423279; cb_m2 = 1.600000023841858; cb_d1 = itrunc(srate / 356); cb_d2 = itrunc(srate / 1263); cb_hpf = cb_ff(382); );
  cb_mode = p_drive < 0.5;
  cb_mode ? (
    cb_drive = 10 ^ (2 - 6 * p_drive);
    cb_trim *= 0.550000011920929 + 150 * (p_drive ^ 4);
  ) : (
    cb_drive = 1;
    cb_clip = 11.699999809265137 - 16 * p_drive;
    p_drive > 0.7 ? (
      cb_drive = 10 ^ (7 * p_drive - 4.900000095367432);
      cb_clip = 0.5;
    );
  );
  cb_bias = 1.2000000476837158 * p_bias - 0.6000000238418579;
  p_drive > 0.5 ? cb_bias /= (1 + 3 * (p_drive - 0.5)) : cb_bias /= (1 + 3 * (0.5 - p_drive));
  cb_trim *= 10 ^ (2 * p_out - 1);
  cb_ster ? cb_trim *= 2;
  cb_hf = p_hpf;
  cb_hq = 1.100000023841858 - p_reso;
  p_hpf > 0.05000000074505806 ? cb_drive = cb_drive * (1 + 0.10000000149011612 * cb_drive);
);

cb_set();

@slider

last_srate != srate ? (
  last_srate = srate;
  meter_decay = 0.001 ^ (1 / (0.4 * srate));
);
cb_set();

@block

cb_set();
cb_o = cb_lpf;
cb_i = 1 - cb_lpf;
cb_trm = cb_trim * cb_i * cb_i * cb_i * cb_i;
cb_bp = cb_pos;
cb_blk = samplesblock;

@sample

ina = spl0; inb = spl1;
cb_ster ? (
  cb_a = cb_drive * (spl0 + cb_bias); cb_a2 = cb_drive * (spl1 + cb_bias);
  cb_mode ? (
    cb_b = cb_a / (1 + abs(cb_a)); cb_b2 = cb_a2 / (1 + abs(cb_a2));
  ) : (
    cb_b = cb_a > cb_clip ? cb_clip : cb_a; cb_b2 = cb_a2 > cb_clip ? cb_clip : cb_a2;
    cb_b = cb_a < -cb_clip ? -cb_clip : cb_b; cb_b2 = cb_a2 < -cb_clip ? -cb_clip : cb_b2;
  );
  BUFA[cb_bp] = cb_b; BUFB[cb_bp] = cb_b2;
  cb_b += cb_m1 * BUFA[(cb_bp + cb_d1) % 1000] + cb_m2 * BUFA[(cb_bp + cb_d2) % 1000];
  cb_b2 += cb_m1 * BUFB[(cb_bp + cb_d1) % 1000] + cb_m2 * BUFB[(cb_bp + cb_d2) % 1000];
  cb_f1 = cb_o * cb_f1 + cb_trm * cb_b; cb_f6 = cb_o * cb_f6 + cb_trm * cb_b2;
  cb_f2 = cb_o * cb_f2 + cb_f1; cb_f7 = cb_o * cb_f7 + cb_f6;
  cb_f3 = cb_o * cb_f3 + cb_f2; cb_f8 = cb_o * cb_f8 + cb_f7;
  cb_f4 = cb_o * cb_f4 + cb_f3; cb_f9 = cb_o * cb_f9 + cb_f8;
  cb_f5 = cb_hpf * (cb_f5 - cb_f4) + cb_f4; cb_f10 = cb_hpf * (cb_f10 - cb_f9) + cb_f9;
  spl0 = cb_f4 - cb_f5; spl1 = cb_f9 - cb_f10;
) : (
  cb_a = cb_drive * (spl0 + spl1 + cb_bias);
  cb_h0 += cb_hf * (cb_h1 + cb_a);
  cb_h1 -= cb_hf * (cb_h0 + cb_hq * cb_h1);
  cb_a += cb_h1;
  cb_mode ? (
    cb_b = cb_a / (1 + abs(cb_a));
  ) : (
    cb_b = cb_a > cb_clip ? cb_clip : cb_a;
    cb_b = cb_a < -cb_clip ? -cb_clip : cb_b;
  );
  BUFA[cb_bp] = cb_b;
  cb_b += cb_m1 * BUFA[(cb_bp + cb_d1) % 1000] + cb_m2 * BUFA[(cb_bp + cb_d2) % 1000];
  cb_f1 = cb_o * cb_f1 + cb_trm * cb_b;
  cb_f2 = cb_o * cb_f2 + cb_f1;
  cb_f3 = cb_o * cb_f3 + cb_f2;
  cb_f4 = cb_o * cb_f4 + cb_f3;
  cb_f5 = cb_hpf * (cb_f5 - cb_f4) + cb_f4;
  spl0 = spl1 = cb_f4 - cb_f5;
  cb_bp = cb_bp == 0 ? 999 : cb_bp - 1;
);
cb_blk -= 1;
cb_blk <= 0 ? (
  cb_pos = cb_bp;
  abs(cb_f1) < 0.0000000001 ? cb_f1 = cb_f2 = cb_f3 = cb_f4 = cb_f5 = 0;
  abs(cb_f6) < 0.0000000001 ? cb_f6 = cb_f7 = cb_f8 = cb_f9 = cb_f10 = 0;
  abs(cb_h0) < 0.0000000001 ? cb_h0 = cb_h1 = 0;
);

m_l = max(abs(ina), abs(inb));
m_l > ipk ? ipk = m_l : ipk *= meter_decay;
m_l = max(abs(spl0), abs(spl1));
m_l > opk ? opk = m_l : opk *= meter_decay;

@gfx 760 380

DW = 760;
DH = 380;
scale = max(0.5, min(gfx_w / DW, gfx_h / DH));
ox = floor((gfx_w - DW*scale) * 0.5);
oy = 0;

MARGIN = 14*scale;
CW = 112*scale;
KR = 30*scale;
PANEL_H = 128*scale;

function automate(s, end_touch)
(
<?
  max_sliders > 7 ? printf("slider_automate(2^(s-1), end_touch);") :
    printf("s == 1 ? slider_automate(p_model, end_touch) : s == 2 ? slider_automate(p_drive, end_touch) : s == 3 ? slider_automate(p_bias, end_touch) : s == 4 ? slider_automate(p_out, end_touch) : s == 5 ? slider_automate(p_ster, end_touch) : s == 6 ? slider_automate(p_hpf, end_touch) : s == 7 ? slider_automate(p_reso, end_touch) :");
?> 0;
);

function set_slider(s, v) ( slider(s) = v; automate(s, 0); automate(s, 1); );
function hit_circle(mx, my, cx, cy, rad) ( sqr(mx - cx) + sqr(my - cy) <= sqr(rad); );
function hit_rect(mx, my, x, y, w, h) ( mx >= x && mx <= x+w && my >= y && my <= y+h; );
function g_trunc(x) ( x < 0 ? ceil(x) : floor(x); );

function def_val(s) ( s == 6 ? 0 : 0.5; );

function knob_name(s)
(
  s == 2 ? "Drive" : s == 3 ? "Bias" : s == 4 ? "Output" : s == 6 ? "Freq" : "Reso";
);

function model_name(m)
(
  m == 0 ? "D.I." : m == 1 ? "SPEAKER" : m == 2 ? "RADIO" : m == 3 ? "COMBO 1\"" : m == 4 ? "COMBO 8\"" : m == 5 ? "4x12 BRIGHT" : "4x12 SCOOP";
);

function hint_text(s)
(
  s == 1 ? "Model: the speaker and cabinet voicing after the clipper" :
  s == 2 ? "Drive: left of centre soft-clips (warm), right of centre hard-clips (fuzz)" :
  s == 3 ? "Bias: offsets the signal before clipping for uneven, more even-harmonic distortion" :
  s == 4 ? "Output: level after the cabinet, plus or minus 20 dB" :
  s == 5 ? "Process: Mono sums the input (with cabinet comb and resonant high-pass); Stereo clips each side on its own" :
  s == 6 ? "HPF Freq: resonant high-pass before the clipper, 0 = off (Mono only)" :
  s == 7 ? "HPF Reso: resonance of the high-pass (Mono only)" :
  "Drag or scroll a knob to adjust  ·  Ctrl for fine control  ·  double-click to reset";
);

function ptext(s)
(
  s == 2 ? sprintf(#ptxt, "%d S<>H", g_trunc(200 * p_drive - 100)) :
  s == 3 ? sprintf(#ptxt, "%d", g_trunc(200 * p_bias - 100)) :
  s == 4 ? sprintf(#ptxt, "%d dB", g_trunc(40 * p_out - 20)) :
  s == 6 ? sprintf(#ptxt, "%d%%", g_trunc(100 * p_hpf)) :
  sprintf(#ptxt, "%d%%", g_trunc(100 * p_reso));
  #ptxt;
);

function set_norm(s, v)
local(old)
(
  old = slider(s);
  slider(s) = floor(v*1000 + 0.5) / 1000;
  slider(s) !== old ? automate(s, 0);
);


function upper(str)
local(i, c)
(
  i = 0;
  loop(strlen(str),
    c = str_getchar(str, i);
    (c >= 97 && c <= 122) ? str_setchar(str, i, c - 32);
    i += 1;
  );
  str;
);

function draw_knob(cx, cy, rad, pos, cr, cg, cb, valtext, name)
local(ang0, ang1, ang, i, tx, ty)
(
  ang0 = -2.35619;
  ang1 =  2.35619;
  gfx_set(0.05, 0.05, 0.06, 1);
  gfx_circle(cx, cy, rad + 2*scale, 1, 1);
  gfx_set(cr*0.55, cg*0.55, cb*0.55, 1);
  gfx_circle(cx, cy, rad, 1, 1);
  gfx_set(cr, cg, cb, 1);
  gfx_circle(cx, cy, rad*0.72, 1, 1);
  gfx_set(1, 1, 1, 0.18);
  gfx_circle(cx - rad*0.28, cy - rad*0.28, rad*0.42, 1, 1);
  i = 0;
  loop(9,
    ang = ang0 + (ang1 - ang0) * (i / 8);
    gfx_set(0.85, 0.85, 0.85, 0.7);
    gfx_line(cx + sin(ang)*rad*0.82, cy - cos(ang)*rad*0.82, cx + sin(ang)*rad*0.98, cy - cos(ang)*rad*0.98, 1);
    i += 1;
  );
  ang = ang0 + (ang1 - ang0) * pos;
  gfx_set(0.05, 0.05, 0.05, 1);
  gfx_line(cx, cy, cx + sin(ang)*rad*0.85, cy - cos(ang)*rad*0.85, 1);
  gfx_setfont(1, "Arial", 14*scale);
  gfx_set(0.85, 0.85, 0.85, 1);
  gfx_measurestr(valtext, tx, ty);
  gfx_x = cx - tx*0.5; gfx_y = cy - rad - 18*scale;
  gfx_drawstr(valtext);
  gfx_set(0.8, 0.8, 0.82, 1);
  gfx_measurestr(name, tx, ty);
  gfx_x = cx - tx*0.5; gfx_y = cy + rad + 7*scale;
  gfx_drawstr(name);
);

function lcd_touch(s) ( lcd_sl = s; lcd_t = time_precise(); );

function row_begin(y, nk, ns)
(
  rx = ox + (DW*scale - (nk*CW + ns*8*scale + (ns - 1)*10*scale)) * 0.5;
  ry = oy + y;
);

function sec(nk, title, cr, cg, cb)
local(w, tw, th)
(
  w = nk*CW + 8*scale;
  gfx_set(0.035, 0.035, 0.04, 1);
  gfx_rect(rx - scale, ry - scale, w + 2*scale, PANEL_H + 2*scale, 1);
  gfx_set(0.125, 0.125, 0.14, 1);
  gfx_rect(rx, ry, w, PANEL_H, 1);
  gfx_set(cr, cg, cb, 0.8);
  gfx_rect(rx, ry, w, max(1, 2*scale), 1);
  gfx_setfont(1, "Arial", 12*scale, 'b');
  gfx_set(cr*0.75 + 0.15, cg*0.75 + 0.15, cb*0.75 + 0.15, 1);
  gfx_measurestr(title, tw, th);
  gfx_x = rx + (w - tw)*0.5; gfx_y = ry + 5*scale;
  gfx_drawstr(title);
  k_sx = rx + 4*scale; k_col = 0;
  k_r = cr; k_g = cg; k_b = cb;
  rx += w + 10*scale;
);

function seg_btn(s, x, y, w, h, label, act, fs)
local(tw, th, gap, hov)
(
  hov = hit_rect(mouse_x, mouse_y, x, y, w, h);
  hov ? hov_s = s;
  gap = max(1, scale);
  gfx_set(0.03, 0.03, 0.04, 1);
  gfx_rect(x - gap, y - gap, w + 2*gap, h + 2*gap, 1);
  act ? gfx_set(acc_r*0.62, acc_g*0.62, acc_b*0.62, 1) : gfx_set(hov ? 0.17 : 0.14, hov ? 0.17 : 0.14, hov ? 0.19 : 0.16, 1);
  gfx_rect(x, y, w, h, 1);
  act ? gfx_set(acc_r, acc_g, acc_b, 1) : gfx_set(0.21, 0.21, 0.24, 1);
  gfx_rect(x + gap, y + gap, w - 2*gap, h*0.5, 1);
  gfx_set(1, 1, 1, act ? 0.22 : 0.08);
  gfx_rect(x + gap, y + gap, w - 2*gap, h*0.3, 1);
  gfx_setfont(1, "Arial", fs*scale, 'b');
  act ? gfx_set(0.08, 0.08, 0.10, 1) : gfx_set(0.78, 0.78, 0.80, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + (w - tw)*0.5; gfx_y = y + (h - th)*0.5;
  gfx_drawstr(label);
  mouse_just_down && hov;
);

function knob_at(s, cx, cy, rad, cr, cg, cb)
local(hov, gv)
(
  hov = hit_circle(mouse_x, mouse_y, cx, cy, rad + 4*scale);
  hov ? hov_s = s;
  (mouse_just_down && hov) ? (
    (click_target == s && time_precise() - click_time < 0.3) ? (
      set_slider(s, def_val(s));
      drag_target = 0;
      lcd_touch(s);
    ) : (
      drag_target = s; drag_y0 = mouse_y; drag_v0 = slider(s); drag_fine = mouse_cap & 4;
    );
    click_target = s; click_time = time_precise();
  );
  (hov && mouse_wheel != 0 && drag_target == 0) ? (
    gv = slider(s) + (mouse_wheel / 120) * ((mouse_cap & 4) ? 0.001 : 0.01);
    set_norm(s, max(0, min(1, gv)));
    automate(s, 1);
    lcd_touch(s);
    mouse_wheel = 0;
  );
  draw_knob(cx, cy, rad, slider(s), cr, cg, cb, ptext(s), knob_name(s));
);

function knob(s)
local(cx, cy)
(
  cx = k_sx + CW*(k_col + 0.5);
  cy = ry + 72*scale;
  k_col += 1;
  knob_at(s, cx, cy, KR, k_r, k_g, k_b);
);

function glow_text(str, x, y, r, g, b)
(
  gfx_set(r, g, b, 0.16);
  gfx_x = x - scale; gfx_y = y; gfx_drawstr(str);
  gfx_x = x + scale; gfx_y = y; gfx_drawstr(str);
  gfx_x = x; gfx_y = y - scale; gfx_drawstr(str);
  gfx_x = x; gfx_y = y + scale; gfx_drawstr(str);
  gfx_set(r, g, b, 1);
  gfx_x = x; gfx_y = y; gfx_drawstr(str);
);

function meter(x, y, w, h, pk, label)
local(db, fy, tw, th)
(
  gfx_setfont(1, "Arial", 11*scale, 'b');
  gfx_set(0.62, 0.63, 0.66, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + w*0.5 - tw*0.5; gfx_y = y;
  gfx_drawstr(label);
  y += th + 3*scale;
  h -= th + 3*scale;
  gfx_set(0.04, 0.04, 0.05, 1);
  gfx_rect(x - scale, y - scale, w + 2*scale, h + 2*scale, 1);
  gfx_set(acc_r*0.22, acc_g*0.22, acc_b*0.22, 1);
  gfx_rect(x, y, w, h, 1);
  db = pk > 0.000001 ? 20 * log10(pk) : -100;
  fy = y + h * (1 - max(0, min(1, (db + 60) / 60)));
  db > -1 ? gfx_set(1.0, 0.35, 0.30, 1) : gfx_set(acc_r, acc_g, acc_b, 1);
  gfx_rect(x, fy, w, y + h - fy, 1);
);


mouse_down = mouse_cap & 1;
mouse_just_down = mouse_down && !mouse_state;
hov_s = 0;
is_st = p_ster > 0.5;
g_model = g_trunc(p_model * 6.9);
acc_r = 1.00; acc_g = 0.66; acc_b = 0.26;

// ---------------------------------------------------------------------- background + header
gfx_set(0.09, 0.085, 0.08, 1);
gfx_rect(0, 0, gfx_w, gfx_h, 1);

gfx_setfont(1, "Arial", 20*scale, 'b');
gfx_set(acc_r, acc_g, acc_b, 1);
gfx_x = ox + MARGIN; gfx_y = oy + 8*scale;
gfx_drawstr("CAB DRIVER");
gfx_setfont(1, "Arial", 13*scale);
gfx_set(0.58, 0.60, 0.64, 1);
gfx_x = ox + MARGIN + 2*scale; gfx_y = oy + 30*scale;
gfx_drawstr("by chmaha  ·  based on mda Combo");

TABW = 86*scale; TABH = 26*scale; TABG = 5*scale;
tx0 = ox + DW*scale - MARGIN - 2*TABW - TABG;
seg_btn(5, tx0, oy + 11*scale, TABW, TABH, "MONO", !is_st, 14) ? ( set_slider(5, 0.25); mouse_just_down = 0; );
seg_btn(5, tx0 + TABW + TABG, oy + 11*scale, TABW, TABH, "STEREO", is_st, 14) ? ( set_slider(5, 0.75); mouse_just_down = 0; );
is_st = p_ster > 0.5;

gfx_set(0.04, 0.04, 0.05, 1);
gfx_rect(0, oy + 46*scale, gfx_w, max(1, scale), 1);

// ---------------------------------------------------------------------- LCD
LX = ox + MARGIN; LY = oy + 56*scale; LW = 600*scale; LH = 96*scale;
gfx_set(0.03, 0.03, 0.04, 1);
gfx_rect(LX - 2*scale, LY - 2*scale, LW + 4*scale, LH + 4*scale, 1);
gfx_set(0.17, 0.17, 0.19, 1);
gfx_rect(LX, LY, LW, LH, 1);
GX = LX + 6*scale; GY = LY + 6*scale; GW = LW - 12*scale; GH = LH - 12*scale;
gfx_set(0.02, 0.02, 0.02, 1);
gfx_rect(GX - scale, GY - scale, GW + 2*scale, GH + 2*scale, 1);
gfx_set(0.035 + acc_r*0.05, 0.035 + acc_g*0.05, 0.035 + acc_b*0.05, 1);
gfx_rect(GX, GY, GW, GH, 1);
lc_r = min(1, 0.35 + acc_r*0.75); lc_g = min(1, 0.35 + acc_g*0.75); lc_b = min(1, 0.35 + acc_b*0.75);

TAW = 250*scale;
gfx_setfont(2, "Courier New", 14*scale, 'b');
glow_text("CABINET", GX + 10*scale, GY + 6*scale, lc_r, lc_g, lc_b);
strcpy(#lt, p_drive < 0.5 ? "SOFT CLIP" : "HARD CLIP");
gfx_measurestr(#lt, ltw, lth);
glow_text(#lt, GX + TAW - ltw, GY + 6*scale, lc_r, lc_g, lc_b);
strcpy(#ln, model_name(g_model));
gfx_setfont(2, "Courier New", 26*scale, 'b');
gfx_measurestr(#ln, ltw, lth);
glow_text(#ln, GX + 10*scale + (TAW - 10*scale - ltw)*0.5, GY + 26*scale + (26*scale - lth)*0.5, lc_r, lc_g, lc_b);
gfx_setfont(2, "Courier New", 14*scale, 'b');
LY3 = GY + GH - 20*scale;
(lcd_sl > 0 && time_precise() - lcd_t < 1.5) ? (
  strcpy(#lt, knob_name(lcd_sl)); upper(#lt);
  glow_text(#lt, GX + 10*scale, LY3, lc_r, lc_g, lc_b);
  strcpy(#lv, ptext(lcd_sl)); upper(#lv);
  gfx_measurestr(#lv, ltw, lth);
  glow_text(#lv, GX + TAW - ltw, LY3, lc_r, lc_g, lc_b);
) : (
  strcpy(#lt, is_st ? "STEREO" : "MONO SUM");
  gfx_measurestr(#lt, ltw, lth);
  glow_text(#lt, GX + 10*scale + (TAW - 10*scale - ltw)*0.5, LY3, lc_r, lc_g, lc_b);
);

SDX = GX + TAW + 12*scale;
gfx_set(lc_r, lc_g, lc_b, 0.18);
gfx_rect(SDX, GY + 8*scale, max(1, scale), GH - 16*scale, 1);
VX = SDX + 12*scale; VW = GX + GW - 10*scale - VX;
VY = GY + 8*scale; VH = GH - 16*scale;
gfx_set(lc_r, lc_g, lc_b, 0.08);
gfx_rect(VX, VY, VW, VH, 1);
gfx_set(lc_r, lc_g, lc_b, 0.25);
gfx_rect(VX, VY + VH * 0.5, VW, max(1, scale), 1);
gfx_rect(VX + VW * 0.5, VY, max(1, scale), VH, 1);
g_dr = p_drive < 0.5 ? 10 ^ (2 - 6 * p_drive) : (p_drive > 0.7 ? 10 ^ (7 * p_drive - 4.9) : 1);
g_cl = p_drive < 0.5 ? 1 : (p_drive > 0.7 ? 0.5 : 11.7 - 16 * p_drive);
g_bi = (1.2 * p_bias - 0.6) / (1 + 3 * abs(p_drive - 0.5));
gpk = g_dr * (1 + abs(g_bi));
gnorm = max(0.0001, p_drive < 0.5 ? gpk / (1 + gpk) : min(g_cl, gpk));
gi = 0; GN = 96;
loop(GN + 1,
  gxv = 2 * gi / GN - 1;
  ga = g_dr * (gxv + g_bi);
  gb = p_drive < 0.5 ? ga / (1 + abs(ga)) : max(-g_cl, min(g_cl, ga));
  gyv = max(-1, min(1, gb / gnorm));
  gpx = VX + VW * gi / GN; gpy = VY + VH * (0.5 - 0.46 * gyv);
  gfx_set(lc_r, lc_g, lc_b, 0.95);
  gi == 0 ? ( gfx_x = gpx; gfx_y = gpy; ) : gfx_lineto(gpx, gpy, 1);
  gi += 1;
);
gfx_setfont(1, "Arial", 11*scale);
gfx_set(lc_r, lc_g, lc_b, 0.7);
gfx_x = VX + 3*scale; gfx_y = VY + 2*scale; gfx_drawstr("TRANSFER");

gfx_set(0, 0, 0, 0.22);
scan_y = GY;
while (scan_y < GY + GH) ( gfx_rect(GX, scan_y, GW, max(1, scale), 1); scan_y += 3*scale; );
gfx_set(1, 1, 1, 0.035);
gfx_rect(GX, GY, GW, GH*0.45, 1);

MW = 16*scale;
MAX0 = LX + LW + 26*scale;
MSP = (ox + DW*scale - MARGIN - MAX0 - MW);
meter(MAX0, LY, MW, LH, ipk, "IN");
meter(MAX0 + MSP, LY, MW, LH, opk, "OUT");

// ---------------------------------------------------------------------- model strip
SY = oy + 164*scale; SH = 26*scale;
gfx_setfont(1, "Arial", 12*scale, 'b');
gfx_set(0.62, 0.63, 0.66, 1);
gfx_measurestr("MODEL", ltw, lth);
gfx_x = ox + MARGIN; gfx_y = SY + (SH - lth)*0.5;
gfx_drawstr("MODEL");
MBX = ox + MARGIN + ltw + 10*scale;
MBW = (ox + DW*scale - MARGIN - MBX - 6*4*scale) / 7;
gmi = 0;
loop(7,
  seg_btn(1, MBX + gmi*(MBW + 4*scale), SY, MBW, SH, model_name(gmi), g_model == gmi, 11) ? (
    set_slider(1, gmi == 6 ? 1 : (gmi + 0.5) / 6.9); mouse_just_down = 0;
  );
  gmi += 1;
);

gfx_set(0.04, 0.04, 0.05, 1);
gfx_rect(0, oy + 200*scale, gfx_w, max(1, scale), 1);

// ---------------------------------------------------------------------- knob panels
row_begin(208*scale, 5, 3);
sec(2, "AMP", 1.00, 0.66, 0.26); knob(2); knob(3);
sec(2, "HIGH-PASS", 0.45, 0.80, 0.95); knob(6); knob(7);
sec(1, "OUTPUT", 0.80, 0.80, 0.84); knob(4);

// ---------------------------------------------------------------------- hint bar
gfx_set(0.04, 0.04, 0.05, 1);
gfx_rect(0, oy + 346*scale, gfx_w, max(1, scale), 1);
hs = drag_target > 0 ? drag_target : hov_s;
gfx_setfont(1, "Arial", 13*scale);
gfx_set(0.62, 0.63, 0.66, 1);
strcpy(#ghint, hint_text(hs));
gfx_measurestr(#ghint, htw, hth);
htw > (DW - 20)*scale ? ( gfx_setfont(1, "Arial", 13*scale*(DW - 20)*scale/htw); gfx_measurestr(#ghint, htw, hth); );
gfx_x = ox + (DW*scale - htw)*0.5; gfx_y = oy + 346*scale + (34*scale - hth)*0.5;
gfx_drawstr(#ghint);

drag_target > 0 ? (
  mouse_down ? (
    mouse_cap |= 65536;
    fine_now = mouse_cap & 4;
    fine_now != drag_fine ? ( drag_y0 = mouse_y; drag_v0 = slider(drag_target); drag_fine = fine_now; );
    gv = max(0, min(1, drag_v0 + (drag_y0 - mouse_y) / (150*scale) * (fine_now ? 0.1 : 1)));
    set_norm(drag_target, gv);
    lcd_touch(drag_target);
  ) : ( automate(drag_target, 1); drag_target = 0; );
);

mouse_wheel = 0;
mouse_state = mouse_down;
