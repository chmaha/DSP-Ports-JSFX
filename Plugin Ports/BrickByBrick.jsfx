strcpy(20, "Halls"); strcpy(30, "The programs found in the Halls group are reverberation programs designed to emulate real concert halls and larger natural acoustical spaces. They are useful for a variety of tasks, and are especially well suited for orchestral music applications.");
strcpy(21, "Rooms"); strcpy(31, "The programs found in the Rooms group are reverberation programs designed to emulate rooms and smaller natural acoustical spaces. They are useful for a variety of tasks, and are especially well suited for post production applications and adding space to dialog and solo instruments in music mixes.");
strcpy(22, "Chambers"); strcpy(32, "The programs found in the Chambers group are reverberation programs designed to emulate the characteristics of a classic acoustical chamber. They are especially well suited for acoustical instruments, drums, and chamber");
strcpy(23, "Plates"); strcpy(33, "The programs found in the Plates group are reverberation programs designed to emulate the sound of an analog metal plate reverb. They are useful for a variety of tasks, and are especially well suited for popular multi-track recordings and live performance applications.");
strcpy(24, "Spaces"); strcpy(34, "The programs found in the Spaces group are reverberation programs designed to emulate outdoor sounds, non-real sounds, and other very large or small acoustical spaces. They are useful for a variety of tasks, and are especially well suited for post production creating special effects.");
strcpy(25, "Ambiences"); strcpy(35, "The programs found in the Ambience group are reverberation programs designed add space without necessarily adding reverb. They are useful for a variety of tasks, and are especially well suited for post production and dialog applications, as well as adding 'air' to voice and solo instruments.");
function e_init(ebp, ez) instance(ebase, eend, LVT, OBL, OBR, HD, WV, DYN, ready, nlev, lst, act, QB0, L, nin, npath, mode, irlen, ncov, span, ph, ywl, ywr, lh, lopen, lerr, lnch, lfsr, lfr, lg, lim, lzl, lsr, lpos, lnc, lrs, lrn, lc, lk, lp, lnin, lnp, lmd, lpm0, lpm1, lpm2, lpm3, wpk, wver, cin0, gsc, age) (
  ebase = ebp; eend = ebp + ez;
  LVT = ebp; OBL = ebp + 256; OBR = OBL + RSO; HD = OBR + RSO; WV = HD + 512; DYN = WV + 4 * NWB;
  ready = 0; nlev = 0; lst = 0; act = 0;
);

function e_layout(nn, qb, lat, ni, np, md) instance(ebase, eend, LVT, OBL, OBR, HD, WV, DYN, ready, nlev, lst, act, QB0, L, nin, npath, mode, irlen, ncov, span, ph, ywl, ywr, lh, lopen, lerr, lnch, lfsr, lfr, lg, lim, lzl, lsr, lpos, lnc, lrs, lrn, lc, lk, lp, lnin, lnp, lmd, lpm0, lpm1, lpm2, lpm3, wpk, wver, cin0, gsc, age) local(k, bb, oo, pp, pn, ptr, tb, nb) (
  QB0 = qb; L = lat; nin = ni; npath = np; mode = md; irlen = nn; cin0 = md === 2 ? CINM : CINL;
  oo = lat ? 0 : qb;
  bb = qb; k = 0; ptr = DYN;
  while (oo < nn && k < 15) (
    tb = LVT + k * 16;
    nb = min(16384, bb * GROW);
    bb >= 16384 ? pp = ceil((nn - oo) / bb) : (
      pn = max(1, ceil((2 * nb - qb - lat - oo) / bb));
      pp = nn - oo <= (pn + 2) * bb ? ceil((nn - oo) / bb) : pn;
    );
    tb[0] = bb; tb[1] = pp; tb[2] = oo; tb[3] = bb / qb;
    tb[10] = 2 * bb; tb[11] = pp * 2 * bb;
    ptr = ceil(ptr / (2 * bb)) * 2 * bb;
    tb[4] = ptr; ptr += ni * pp * 2 * bb;
    tb[5] = ptr; ptr += pp * bb * 2 * np;
    tb[13] = bb * 2 * np;
    ptr = ceil(ptr / (2 * bb)) * 2 * bb;
    tb[6] = ptr; ptr += 2 * bb;
    tb[7] = ptr; ptr += 2 * bb;
    tb[8] = pp - 1; tb[9] = 0;
    tb[12] = oo + lat + 1 - bb - (bb / qb - 1) * qb;
    oo += pp * bb;
    bb = nb;
    k += 1;
  );
  nlev = k; ncov = oo;
  span = oo + lat + 2 * 16384 + 2 * qb;
  ptr <= eend ? ( memset(DYN, 0, ptr - DYN); memset(OBL, 0, 2 * RSO); memset(HD, 0, 512); ph = 0; 1; ) : 0;
);


function e_reset() instance(ebase, eend, LVT, OBL, OBR, HD, WV, DYN, ready, nlev, lst, act, QB0, L, nin, npath, mode, irlen, ncov, span, ph, ywl, ywr, lh, lopen, lerr, lnch, lfsr, lfr, lg, lim, lzl, lsr, lpos, lnc, lrs, lrn, lc, lk, lp, lnin, lnp, lmd, lpm0, lpm1, lpm2, lpm3, wpk, wver, cin0, gsc, age) local(k, tb) (
  k = 0;
  loop(nlev,
    tb = LVT + k * 16;
    memset(tb[4], 0, nin * tb[1] * tb[10]);
    memset(tb[6], 0, tb[10]); memset(tb[7], 0, tb[10]);
    tb[8] = tb[1] - 1; tb[9] = 0;
    k += 1;
  );
  memset(OBL, 0, RSO); memset(OBR, 0, RSO);
  ph = 0; age = 0;
);

function mac_ts(xx, xc, hq, hb, al, ar, pp, sq, n2, q0, q1) local(b, xp, hp, lr, li, rr, ri, xa, xb, xe, xf, xc1, na) (
  xc1 = xc + 1; na = sq + 1; b = q0;
  b === 0 ? (
      lr = li = rr = ri = 0;
      xp = xx + sq * n2 + 2 * 0; hp = hq + 0 * 8;
      loop(na,
        xa = xp[0]; xb = xp[1]; xe = xp[xc]; xf = xp[xc1];
          lr += xa * hp[0] + xe * hp[4]; li += xb * hp[1] + xf * hp[5];
          rr += xa * hp[2] + xe * hp[6]; ri += xb * hp[3] + xf * hp[7];
          xp -= n2; hp += hb;
      );
      xp = xx + (pp - 1) * n2 + 2 * 0;
      loop(pp - na,
        xa = xp[0]; xb = xp[1]; xe = xp[xc]; xf = xp[xc1];
          lr += xa * hp[0] + xe * hp[4]; li += xb * hp[1] + xf * hp[5];
          rr += xa * hp[2] + xe * hp[6]; ri += xb * hp[3] + xf * hp[7];
          xp -= n2; hp += hb;
      );
      al[2 * 0] = lr; al[2 * 0 + 1] = li; ar[2 * 0] = rr; ar[2 * 0 + 1] = ri;
      b = 1;
  );
  while (b < q1) (
      lr = li = rr = ri = 0;
      xp = xx + sq * n2 + 2 * b; hp = hq + b * 8;
      loop(na,
        xa = xp[0]; xb = xp[1]; xe = xp[xc]; xf = xp[xc1];
          lr += xa * hp[0] - xb * hp[1] + xe * hp[4] - xf * hp[5];
          li += xa * hp[1] + xb * hp[0] + xe * hp[5] + xf * hp[4];
          rr += xa * hp[2] - xb * hp[3] + xe * hp[6] - xf * hp[7];
          ri += xa * hp[3] + xb * hp[2] + xe * hp[7] + xf * hp[6];
          xp -= n2; hp += hb;
      );
      xp = xx + (pp - 1) * n2 + 2 * b;
      loop(pp - na,
        xa = xp[0]; xb = xp[1]; xe = xp[xc]; xf = xp[xc1];
          lr += xa * hp[0] - xb * hp[1] + xe * hp[4] - xf * hp[5];
          li += xa * hp[1] + xb * hp[0] + xe * hp[5] + xf * hp[4];
          rr += xa * hp[2] - xb * hp[3] + xe * hp[6] - xf * hp[7];
          ri += xa * hp[3] + xb * hp[2] + xe * hp[7] + xf * hp[6];
          xp -= n2; hp += hb;
      );
      al[2 * b] = lr; al[2 * b + 1] = li; ar[2 * b] = rr; ar[2 * b + 1] = ri;
      b += 1;
  );
);

function mac_st(xx, xc, hq, hb, al, ar, pp, sq, n2, q0, q1) local(b, xp, hp, lr, li, rr, ri, xa, xb, xe, xf, xc1, na) (
  xc1 = xc + 1; na = sq + 1; b = q0;
  b === 0 ? (
      lr = li = rr = ri = 0;
      xp = xx + sq * n2 + 2 * 0; hp = hq + 0 * 4;
      loop(na,
        xa = xp[0]; xb = xp[1]; xe = xp[xc]; xf = xp[xc1];
          lr += xa * hp[0]; li += xb * hp[1]; rr += xe * hp[2]; ri += xf * hp[3];
          xp -= n2; hp += hb;
      );
      xp = xx + (pp - 1) * n2 + 2 * 0;
      loop(pp - na,
        xa = xp[0]; xb = xp[1]; xe = xp[xc]; xf = xp[xc1];
          lr += xa * hp[0]; li += xb * hp[1]; rr += xe * hp[2]; ri += xf * hp[3];
          xp -= n2; hp += hb;
      );
      al[2 * 0] = lr; al[2 * 0 + 1] = li; ar[2 * 0] = rr; ar[2 * 0 + 1] = ri;
      b = 1;
  );
  while (b < q1) (
      lr = li = rr = ri = 0;
      xp = xx + sq * n2 + 2 * b; hp = hq + b * 4;
      loop(na,
        xa = xp[0]; xb = xp[1]; xe = xp[xc]; xf = xp[xc1];
          lr += xa * hp[0] - xb * hp[1]; li += xa * hp[1] + xb * hp[0];
          rr += xe * hp[2] - xf * hp[3]; ri += xe * hp[3] + xf * hp[2];
          xp -= n2; hp += hb;
      );
      xp = xx + (pp - 1) * n2 + 2 * b;
      loop(pp - na,
        xa = xp[0]; xb = xp[1]; xe = xp[xc]; xf = xp[xc1];
          lr += xa * hp[0] - xb * hp[1]; li += xa * hp[1] + xb * hp[0];
          rr += xe * hp[2] - xf * hp[3]; ri += xe * hp[3] + xf * hp[2];
          xp -= n2; hp += hb;
      );
      al[2 * b] = lr; al[2 * b + 1] = li; ar[2 * b] = rr; ar[2 * b + 1] = ri;
      b += 1;
  );
);

function mac_ms(xx, hq, hb, al, ar, pp, sq, n2, q0, q1) local(b, xp, hp, lr, li, rr, ri, xa, xb, xe, xf, xc1, na) (
  xc1 = 0; na = sq + 1; b = q0;
  b === 0 ? (
      lr = li = rr = ri = 0;
      xp = xx + sq * n2 + 2 * 0; hp = hq + 0 * 4;
      loop(na,
        xa = xp[0]; xb = xp[1];
          lr += xa * hp[0]; li += xb * hp[1]; rr += xa * hp[2]; ri += xb * hp[3];
          xp -= n2; hp += hb;
      );
      xp = xx + (pp - 1) * n2 + 2 * 0;
      loop(pp - na,
        xa = xp[0]; xb = xp[1];
          lr += xa * hp[0]; li += xb * hp[1]; rr += xa * hp[2]; ri += xb * hp[3];
          xp -= n2; hp += hb;
      );
      al[2 * 0] = lr; al[2 * 0 + 1] = li; ar[2 * 0] = rr; ar[2 * 0 + 1] = ri;
      b = 1;
  );
  while (b < q1) (
      lr = li = rr = ri = 0;
      xp = xx + sq * n2 + 2 * b; hp = hq + b * 4;
      loop(na,
        xa = xp[0]; xb = xp[1];
          lr += xa * hp[0] - xb * hp[1]; li += xa * hp[1] + xb * hp[0];
          rr += xa * hp[2] - xb * hp[3]; ri += xa * hp[3] + xb * hp[2];
          xp -= n2; hp += hb;
      );
      xp = xx + (pp - 1) * n2 + 2 * b;
      loop(pp - na,
        xa = xp[0]; xb = xp[1];
          lr += xa * hp[0] - xb * hp[1]; li += xa * hp[1] + xb * hp[0];
          rr += xa * hp[2] - xb * hp[3]; ri += xa * hp[3] + xb * hp[2];
          xp -= n2; hp += hb;
      );
      al[2 * b] = lr; al[2 * b + 1] = li; ar[2 * b] = rr; ar[2 * b + 1] = ri;
      b += 1;
  );
);


function e_tick() instance(ebase, eend, LVT, OBL, OBR, HD, WV, DYN, ready, nlev, lst, act, QB0, L, nin, npath, mode, irlen, ncov, span, ph, ywl, ywr, lh, lopen, lerr, lnch, lfsr, lfr, lg, lim, lzl, lsr, lpos, lnc, lrs, lrn, lc, lk, lp, lnin, lnp, lmd, lpm0, lpm1, lpm2, lpm3, wpk, wver, cin0, gsc, age) local(k, tb, bb, pp, tt, tcn, n2, xx, xc, al, ar, sq, q0, q1, os, n1, src, dst) (
  k = 0;
  loop(nlev,
    tb = LVT + k * 16;
    bb = tb[0]; pp = tb[1]; tt = tb[3]; n2 = tb[10]; tcn = tb[9]; xx = tb[4]; xc = tb[11];
    al = tb[6]; ar = tb[7];
    tcn === 0 ? (
      sq = tb[8] + 1; sq >= pp ? sq = 0; tb[8] = sq;
      memcpy(xx + sq * n2, cin0 + wi + 1 - n2 + RSI, n2);
      age < n2 ? memset(xx + sq * n2, 0, n2 - age);
      fft_real(xx + sq * n2, n2);
      nin > 1 ? (
        memcpy(xx + xc + sq * n2, CINR + wi + 1 - n2 + RSI, n2);
        age < n2 ? memset(xx + xc + sq * n2, 0, n2 - age);
        fft_real(xx + xc + sq * n2, n2);
      );
    ) : sq = tb[8];
    q0 = floor(tcn * bb / tt); q1 = floor((tcn + 1) * bb / tt);
    q1 > q0 ? (
      mode === 0 ? mac_ts(xx, xc, tb[5], tb[13], al, ar, pp, sq, n2, q0, q1) :
      mode === 1 ? mac_st(xx, xc, tb[5], tb[13], al, ar, pp, sq, n2, q0, q1) :
      mac_ms(xx, tb[5], tb[13], al, ar, pp, sq, n2, q0, q1);
    );
    tcn === tt - 1 ? (
      ifft_real(al, n2); ifft_real(ar, n2);
      os = opos + tb[12]; os >= RSO ? os -= RSO;
      n1 = min(bb, RSO - os);
      src = al + bb; dst = OBL + os; loop(n1, dst[] += src[]; dst += 1; src += 1;);
      dst = OBL; loop(bb - n1, dst[] += src[]; dst += 1; src += 1;);
      src = ar + bb; dst = OBR + os; loop(n1, dst[] += src[]; dst += 1; src += 1;);
      dst = OBR; loop(bb - n1, dst[] += src[]; dst += 1; src += 1;);
      tb[9] = 0;
    ) : tb[9] = tcn + 1;
    k += 1;
  );
);

function e_sample() instance(ebase, eend, LVT, OBL, OBR, HD, WV, DYN, ready, nlev, lst, act, QB0, L, nin, npath, mode, irlen, ncov, span, ph, ywl, ywr, lh, lopen, lerr, lnch, lfsr, lfr, lg, lim, lzl, lsr, lpos, lnc, lrs, lrn, lc, lk, lp, lnin, lnp, lmd, lpm0, lpm1, lpm2, lpm3, wpk, wver, cin0, gsc, age) local(xl, xr, hp, a0, a1, v0, v1) (
  quiet > span ? (
    ywl = ywr = 0;
    ph += 1; ph >= QB0 ? ph = 0;
  ) : (
    age < 65536 ? age += 1;
    ph += 1; ph >= QB0 ? ( ph = 0; this.e_tick(); );
    ywl = OBL[opos]; ywr = OBR[opos]; OBL[opos] = 0; OBR[opos] = 0;
    L === 0 ? (
      mode === 0 ? (
      xl = CINL + wi + RSI; xr = CINR + wi + RSI; hp = HD; a0 = a1 = 0;
      loop(min(QB0, age), v0 = xl[]; v1 = xr[]; a0 += v0 * hp[0] + v1 * hp[2]; a1 += v0 * hp[1] + v1 * hp[3]; xl -= 1; xr -= 1; hp += 4;);
      ywl += a0; ywr += a1;
      ) : mode === 1 ? (
      xl = CINL + wi + RSI; xr = CINR + wi + RSI; hp = HD; a0 = a1 = 0;
      loop(min(QB0, age), a0 += xl[] * hp[0]; a1 += xr[] * hp[1]; xl -= 1; xr -= 1; hp += 2;);
      ywl += a0; ywr += a1;
      ) : (
      xl = cin0 + wi + RSI; hp = HD; a0 = a1 = 0;
      loop(min(QB0, age), v0 = xl[]; a0 += v0 * hp[0]; a1 += v0 * hp[1]; xl -= 1; hp += 2;);
      ywl += a0; ywr += a1;
      );
    );
  );
);

function bessel_i0(x) local(s, t, k) (
  s = 1; t = 1; k = 1;
  loop(60, t *= (x * 0.5 / k) * (x * 0.5 / k); s += t; k += 1;);
  s;
);

function rs_kernel(u) local(x, w) (
  x = u / RS_WD;
  abs(x) >= 1 ? 0 : (
    w = bessel_i0(RS_BETA * sqrt(1 - x * x)) / RS_I0B;
    x = RS_FC * u;
    abs(x) < 0.000000000001 ? RS_FC * w : RS_FC * sin($pi * x) / ($pi * x) * w;
  );
);

function rs_setup(fsr, dsr) local(a, b, t, g, rph, tp) (
  a = floor(fsr + 0.5); b = floor(dsr + 0.5);
  while (b > 0) ( t = a - b * floor(a / b); a = b; b = t; );
  g = a;
  RS_L = floor(dsr + 0.5) / g; RS_M = floor(fsr + 0.5) / g;
  RS_FC = 0.975 * min(1, dsr / fsr);
  RS_WD = 40 / RS_FC;
  RS_NT = 2 * ceil(RS_WD);
  RS_BETA = 8.6; RS_I0B = bessel_i0(RS_BETA);
  RS_TAB = RS_L * RS_NT <= RSTMAX && floor(fsr + 0.5) === fsr && floor(dsr + 0.5) === dsr;
  RS_TAB ? (
    rph = 0;
    loop(RS_L,
      tp = 0;
      loop(RS_NT,
        RST[rph * RS_NT + tp] = rs_kernel(tp - (RS_NT / 2 - 1) - rph / RS_L);
        tp += 1;
      );
      rph += 1;
    );
  );
  RS_R = dsr / fsr;
);

function rs_run(dst, src, nch, ch, nfr, m0, m1) local(m, base, rph, n0, sp, cp, acc, t, pos, u) (
  RS_TAB ? (
    base = floor(m0 * RS_M / RS_L); rph = m0 * RS_M - base * RS_L;
    m = m0;
    while (m < m1) (
      n0 = base - (RS_NT / 2 - 1);
      cp = RST + rph * RS_NT;
      acc = 0;
      n0 >= 0 && n0 + RS_NT <= nfr ? (
        sp = src + n0 * nch + ch;
        loop(RS_NT, acc += cp[] * sp[]; cp += 1; sp += nch;);
      ) : (
        t = 0;
        loop(RS_NT,
          (n0 + t >= 0 && n0 + t < nfr) ? acc += cp[t] * src[(n0 + t) * nch + ch];
          t += 1;
        );
      );
      dst[m] = acc;
      rph += RS_M; base += floor(rph / RS_L); rph -= floor(rph / RS_L) * RS_L;
      m += 1;
    );
  ) : (
    m = m0;
    while (m < m1) (
      pos = m / RS_R;
      n0 = floor(pos) - (RS_NT / 2 - 1);
      acc = 0; t = 0;
      loop(RS_NT,
        (n0 + t >= 0 && n0 + t < nfr) ? ( u = n0 + t - pos; acc += rs_kernel(u) * src[(n0 + t) * nch + ch]; );
        t += 1;
      );
      dst[m] = acc;
      m += 1;
    );
  );
  (m1 - m0) * RS_NT * (RS_TAB ? 1 : 40);
);

function e_load_begin(lgain, imode, zl) instance(ebase, eend, LVT, OBL, OBR, HD, WV, DYN, ready, nlev, lst, act, QB0, L, nin, npath, mode, irlen, ncov, span, ph, ywl, ywr, lh, lopen, lerr, lnch, lfsr, lfr, lg, lim, lzl, lsr, lpos, lnc, lrs, lrn, lc, lk, lp, lnin, lnp, lmd, lpm0, lpm1, lpm2, lpm3, wpk, wver, cin0, gsc, age) local(n) (
  ready = 0; lst = 0; lerr = 0;
  lh >= 0 && lopen ? file_close(lh);
  lopen = 0;
  lh = file_open(#ldpath);
  lh < 0 ? ( lerr = 1; lst = -1; ) : (
    lopen = 1;
    lnch = 0; lfsr = 0;
    file_riff(lh, lnch, lfsr);
    (lnch < 1 || lfsr < 1000) ? ( file_close(lh); lopen = 0; lerr = 2; lst = -1; ) : (
      lfr = floor(file_avail(lh) / lnch);
      lfr = min(lfr, MAXF);
      lfr < 1 ? ( file_close(lh); lopen = 0; lerr = 2; lst = -1; ) : (
        lg = lgain; lim = imode; lzl = zl; lsr = srate;
        lpos = 0; lst = 1;
      );
    );
  );
  lst;
);

function e_load_cancel() instance(ebase, eend, LVT, OBL, OBR, HD, WV, DYN, ready, nlev, lst, act, QB0, L, nin, npath, mode, irlen, ncov, span, ph, ywl, ywr, lh, lopen, lerr, lnch, lfsr, lfr, lg, lim, lzl, lsr, lpos, lnc, lrs, lrn, lc, lk, lp, lnin, lnp, lmd, lpm0, lpm1, lpm2, lpm3, wpk, wver, cin0, gsc, age) (
  lopen ? file_close(lh); lopen = 0; lst = 0; ready = 0;
);

function e_load_step(budget) instance(ebase, eend, LVT, OBL, OBR, HD, WV, DYN, ready, nlev, lst, act, QB0, L, nin, npath, mode, irlen, ncov, span, ph, ywl, ywr, lh, lopen, lerr, lnch, lfsr, lfr, lg, lim, lzl, lsr, lpos, lnc, lrs, lrn, lc, lk, lp, lnin, lnp, lmd, lpm0, lpm1, lpm2, lpm3, wpk, wver, cin0, gsc, age) local(work, n, got, c, m1, tb, bb, n2, oo, cnt, sp, dp, sc, hp, hs, b, src, j, pk, v) (
  work = 0;
  while (work < budget && lst > 0 && lst < 6) (
    lst === 1 ? (
      n = min(65536, lfr * lnch - lpos);
      got = n > 0 ? file_mem(lh, STAGE + lpos, n) : 0;
      lpos += n; work += n;
      (lpos >= lfr * lnch || got < n) ? (
        file_close(lh); lopen = 0;
        lnc = min(lnch, 4);
        lrs = abs(lfsr - lsr) >= 0.5;
        lrs ? ( rs_setup(lfsr, lsr); lrn = min(MAXF, ceil(lfr * RS_R) - 1); ) : lrn = lfr;
        lrn = max(1, lrn);
        lc = 0; lpos = 0; lst = 2;
      );
    ) : lst === 2 ? (
      lrs ? (
        m1 = min(lrn, lpos + 4096);
        work += rs_run(PATHS + lc * MAXF, STAGE, lnch, lc, lfr, lpos, m1);
        lpos = m1;
      ) : (
        m1 = min(lrn, lpos + 65536);
        dp = PATHS + lc * MAXF + lpos; sp = STAGE + lpos * lnch + lc;
        loop(m1 - lpos, dp[] = sp[]; dp += 1; sp += lnch;);
        work += 2 * (m1 - lpos);
        lpos = m1;
      );
      lpos >= lrn ? (
        lpos = 0; lc += 1;
        lc >= lnc ? (
          lim === 1 ? (
            lnin = 1; lnp = 2; lmd = 2;
            PMAP[0] = 0; PMAP[1] = lnc >= 2 ? 1 : 0;
          ) : lnc >= 4 ? (
            lnin = 2; lnp = 4; lmd = 0;
            PMAP[0] = 0; PMAP[1] = 1; PMAP[2] = 2; PMAP[3] = 3;
          ) : (
            lnin = 2; lnp = 2; lmd = 1;
            PMAP[0] = 0; PMAP[1] = lnc >= 2 ? 1 : 0;
          );
          lpm0 = PMAP[0]; lpm1 = PMAP[1]; lpm2 = PMAP[2]; lpm3 = PMAP[3];
          FIXQ && lrs ? lg *= lfsr / lsr;
          this.e_layout(lrn, lzl ? ZB0 : BB0, lzl ? 0 : BB0, lnin, lnp, lmd) ? (
            lc = 0; lk = 0; lp = 0; lst = 3;
          ) : ( lerr = 3; lst = -1; );
        );
      );
    ) : lst === 3 ? (
      tb = LVT + lk * 16;
      bb = tb[0]; n2 = tb[10]; oo = tb[2] + lp * bb;
      src = PATHS + (lc === 0 ? lpm0 : lc === 1 ? lpm1 : lc === 2 ? lpm2 : lpm3) * MAXF;
      memset(TMP, 0, n2);
