slider1:program=0<0,133,1{Hall: Amsterdam Hall,Hall: Berliner Hall,Hall: Boston Hall A,Hall: Boston Hall B,Hall: Brass Hall,Hall: Chicago Hall,Hall: Clear Hall,Hall: Concert Hall,Hall: Dense Hall,Hall: Gold Hall,Hall: Large & Dark,Hall: Large & Deep,Hall: Large & Near,Hall: Large Hall,Hall: Mechanics Hall,Hall: Medium & Deep,Hall: Medium & Near,Hall: Medium Hall,Hall: Saint Gerold,Hall: Saint Sylvain,Hall: Sandors Hall,Hall: Small & Near,Hall: Small Hall,Hall: The ArchDuke,Hall: Troy Music Hall,Hall: Vienna Hall,Hall: Worcester Hall,Room: Back Room,Room: Blue Room,Room: Center Room,Room: Corn Room,Room: Deep Stone,Room: Djangos Room,Room: Drum & Chamber,Room: Front Room,Room: Glass Room,Room: Heavy Room,Room: Large & Room,Room: Large Red Room,Room: Large Room,Room: Large Tiled Room,Room: Large Wooden Room,Room: Marble Foyer,Room: Medium Tiled Room,Room: Music Room,Room: Oakland Room,Room: Percussion Room,Room: Red Room,Room: SF Perf Room,Room: Small & Room,Room: Small Room,Room: Small Tiled Room,Room: Small Vox Room,Room: Small Wooden Room,Room: Studio A,Room: Studio B Close,Room: Studio B Far,Room: Studio C,Room: Studio D,Room: Studio E,Room: Studio K,Room: Waits Room,Chamber: A&M Chamber,Chamber: Amb Chamber A,Chamber: Amb Chamber B,Chamber: CD Chamber,Chamber: Deep Chamber,Chamber: Kick Chamber,Chamber: Large & Bright,Chamber: Large & Dark,Chamber: Large Chamber,Chamber: Medium Chamber,Chamber: Old Chamber,Chamber: Small & Bright,Chamber: Small & Dark,Chamber: Small Chamber,Chamber: Snare Chamber,Chamber: Sunset Chamber,Chamber: Vocal Chamber,Plate: Bright Plate,Plate: CD Plate A,Plate: CD Plate B,Plate: Crystal Plate,Plate: Dark Plate,Plate: Dense Plate,Plate: Echo Plate,Plate: Fat Plate,Plate: Gold Plate,Plate: Large Plate,Plate: London Plate,Plate: Old Plate,Plate: Percussion Plate,Plate: Rich Plate,Plate: Silver Plate,Plate: Small Plate,Plate: Snare Plate A,Plate: Snare Plate B,Plate: Sun Plate A,Plate: Sun Plate B,Plate: Sun Plate C,Plate: Vocal Plate,Plate: Vocal Plate B,Space: Academy Yard,Space: Arena,Space: Bath House,Space: Car Park,Space: Cavern,Space: Cinema Room,Space: East Church,Space: Europa,Space: Gated Space,Space: Hillside,Space: North Church,Space: Redwood Valley,Space: Scoring Stage,Space: South Church,Space: Stone Quarry,Space: Tanglewood,Space: West Church,Ambience: Bass XXL,Ambience: Clear Ambience,Ambience: Deep Ambience,Ambience: Heavy Ambience,Ambience: Large & Bright,Ambience: Large & Dark,Ambience: Large Ambience,Ambience: Long Ambience,Ambience: Medium & Bright,Ambience: Medium & Dark,Ambience: Medium Ambience,Ambience: Percussion Air,Ambience: Small & Bright,Ambience: Small & Dark,Ambience: Small Ambience}>-Program
slider2:in_mode=0<0,1,1{Stereo,Mono to Stereo}>-Input
slider3:dry_db=-60<-60,6,0.1>-Dry (dB)
slider4:wet_db=0<-60,6,0.1>-Wet (dB)
slider5:predelay=0<0,200,0.1>-Predelay (ms)
slider6:zero_lat=0<0,1,1{Off,On}>-Zero Latency
slider7:enable=1<0,1,1{Off,On}>-Enable
slider8:theme=0<0,3,1{Red,Violet,Blue,Copper}>-Theme

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

options:no_meter
options:maxmem=33554432

@init
ext_noinit = gfx_ext_retina = ext_nodenorm = 1;
RSI = 65536; RSO = 131072; NWB = 400; MAXF = 786432; RSTMAX = 262144;
FIXQ = 1;
BB0 = 256; ZB0 = 64; FADE_MS = 40; GROW = 4;
PGS = 1000; PGM = 1200; PCAT = 1400; CST = 1600; PMAP = 1620;
CINL = 4096; CINR = CINL + 2 * RSI; CINM = CINR + 2 * RSI;
DRL = CINM + 2 * RSI; DRR = DRL + 1024;
PDL = DRR + 1024; PDR = PDL + 65536;
TMP = ceil((PDR + 65536) / 32768) * 32768; RST = TMP + 32768;
STAGE = RST + RSTMAX; PATHS = STAGE + 4 * MAXF;
ESZ = 12 * (MAXF + 16384) + 2 * RSO + 1048576;
EMA = PATHS + 4 * MAXF; EMB = EMA + ESZ;
strcpy(100, "Amsterdam Hall"); strcpy(300, "halls-amsterdam-hall"); PGS[0] = 0.058005; PGM[0] = 0.040366; PCAT[0] = 0;
strcpy(101, "Berliner Hall"); strcpy(301, "halls-berliner-hall"); PGS[1] = 0.083339; PGM[1] = 0.053522; PCAT[1] = 0;
strcpy(102, "Boston Hall A"); strcpy(302, "halls-boston-hall-a"); PGS[2] = 0.050148; PGM[2] = 0.037644; PCAT[2] = 0;
strcpy(103, "Boston Hall B"); strcpy(303, "halls-boston-hall-b"); PGS[3] = 0.052247; PGM[3] = 0.035206; PCAT[3] = 0;
