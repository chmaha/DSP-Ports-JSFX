TP = LPC_EN; tset(0, 2, 3, 4, 5, 7, 10, 15); tset(20, 32, 41, 57, 81, 114, 161, 255);
TP = LPC_PER;
tset(0, 16, 17, 18, 19, 20, 21, 22); tset(23, 24, 25, 26, 27, 28, 29, 30); tset(31, 32, 33, 34, 35, 36, 37, 38);
