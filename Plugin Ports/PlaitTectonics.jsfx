Version: 1.0
desc: Plait Tectonics Macro Oscillator (Mutable Instruments Plaits port) by chmaha
tags: synth oscillator macro-oscillator drums speech fm wavetable instrument
author: chmaha
changelog:
  Initial release.
about:
  A macro oscillator in the style of Mutable Instruments Plaits: 24 synthesis models in three banks,
  from virtual analog, wavefolding, FM, grains, additive, wavetables, chords and speech to swarms,
  noise, particles, physical models of strings and resonators and analog-style drums, plus the
  newer bank with a filtered VA voice, phase distortion, three banks of six-operator FM patches, wave
  terrain, a string machine and a chiptune voice.
  Harmonics, Timbre and Morph shape the sound; MIDI notes play it through the module's low-pass gate
  (pinged like the TRIG input, or gated with velocity like the LEVEL input), or it can drone.
  Needs Dependencies/PlaitTectonics/plaits_tables.txt.
  Ported from Plaits by Emilie Gillet (Mutable Instruments)
  https://github.com/pichenettes/eurorack (MIT)
  JSFX version released under GPLv3+ license
  Claude generated some of this code
provides:
  Dependencies/PlaitTectonics/plaits_tables.txt

slider1:p_model=8<0,23,1{VA + VCF,Phase Distortion,6-Op FM 1,6-Op FM 2,6-Op FM 3,Wave Terrain,String Machine,Chiptune,Virtual Analog,Waveshaping,FM,Grains,Additive,Wavetable,Chords,Speech,Swarm,Filtered Noise,Particle Noise,String,Modal,Bass Drum,Snare Drum,Hi-Hat}>-Model
slider2:p_freq=0<-1,1,0.001>-Frequency
slider3:p_harm=0.5<0,1,0.001>-Harmonics
slider4:p_timbre=0.5<0,1,0.001>-Timbre
slider5:p_morph=0.5<0,1,0.001>-Morph
slider6:p_fmamt=0<-1,1,0.001>-FM Amount
slider7:p_timamt=0<-1,1,0.001>-Timbre Mod
slider8:p_moramt=0<-1,1,0.001>-Morph Mod
slider9:p_decay=0.5<0,1,0.001>-LPG Decay
slider10:p_colour=0.5<0,1,0.001>-LPG Colour
slider11:p_range=5<0,10,1{Full (C0-C5),C0 +/-7,C1 +/-7,C2 +/-7,C3 +/-7,C4 +/-7,C5 +/-7,C6 +/-7,C7 +/-7,Octaves,C4 +/-4 oct}>-Range
slider12:p_play=0<0,2,1{Ping (trigger),Gate + Velocity,Drone}>-Play Mode
slider13:p_output=0<0,2,1{Out,Aux,Out L / Aux R}>-Output
slider14:p_out=0<-24,12,0.1>-Output (dB)

out_pin:Left output
out_pin:Right output
options:no_meter

@init

ext_noinit = gfx_ext_retina = 1;
ext_nodenorm = 1;

function alloc(n) local(r) instance(mp) global() ( r = mp; mp += n; memset(r, 0, n); r; );
alloc.mp = 0;

BS = 12;
SR_E = 47872.34;
SR_K = 48000;
A0 = (440 / 8) / SR_E;

TBL = alloc(60000);
TRAW = alloc(60000);
TOFF = alloc(32);
TLEN = alloc(32);
OUTE = alloc(24);
AUXE = alloc(24);
TMP0 = alloc(24);
TMP1 = alloc(24);
TMP2 = alloc(24);
TMP3 = alloc(24);
TRD = alloc(8);
EPOST = alloc(24 * 3);
MBUF = alloc(4);
SCO = alloc(512);
MQ = alloc(4 * 256);
EOR = alloc(4 * 4096);

// ---------------------------------------------------------------------- tables (Plaits resources + stmlib)

function tables_load() local(h, n, nt, i, p, q, len) (
  h = file_open("PlaitTectonics/plaits_tables.txt");
  h < 0 ? h = file_open("Dependencies/PlaitTectonics/plaits_tables.txt");
  tables_ok = 0;
  h >= 0 ? (
    n = file_mem(h, TRAW, 60000);
    file_close(h);
    nt = TRAW[0];
    (n > 100 && nt == 24) ? (
      q = 1;
      p = 0;
      i = 0;
      loop(nt,
        len = TRAW[q];
        TOFF[i] = TBL + p;
        TLEN[i] = len;
        memcpy(TBL + p, TRAW + q + 1, len);
        p += len;
        q += len + 1;
        i += 1;
      );
      tables_ok = q == n;
    );
  );
);
function tables_check() local(ok) (
  ok = tables_ok;
  ok ? ok = TLEN[0] == 256 && TLEN[1] == 256 && TLEN[2] == 641 && TLEN[15] == 25344 && TLEN[23] == 4096;
  ok ? ok = abs(TOFF[0][128] - 1) < 0.000001 && abs(TOFF[1][0] - 1) < 0.000001 && abs(TOFF[2][128] - 1) < 0.000001;
  tables_ok = ok;
);
tables_load();
tables_check();
T_PRH = TOFF[0]; T_PRL = TOFF[1]; T_SINE = TOFF[2]; T_FMQ = TOFF[3]; T_FOLD = TOFF[4]; T_FOLD2 = TOFF[5];
T_STIFF = TOFF[6]; T_SVFS = TOFF[7]; T_DSFIR = TOFF[8]; T_WS = TOFF[9]; T_LPCX = TOFF[14]; T_WAVES = TOFF[15];
T_BANK = TOFF[16]; T_SYX = TOFF[21];

// ---------------------------------------------------------------------- stmlib helpers

TD_A = 0.3736 * $pi * $pi * $pi;
TF_A = 0.326 * $pi * $pi * $pi;
TF_B = 0.1823 * $pi * $pi * $pi * $pi * $pi;
TA_A = 0.3333314036 * $pi * $pi * $pi;
TA_B = 0.1333923995 * $pi * $pi * $pi * $pi * $pi;
TA_C = 0.0533740603 * $pi * $pi * $pi * $pi * $pi * $pi * $pi;
TA_D = 0.002900525 * $pi * $pi * $pi * $pi * $pi * $pi * $pi * $pi * $pi;
TA_E = 0.0095168091 * $pi * $pi * $pi * $pi * $pi * $pi * $pi * $pi * $pi * $pi * $pi;
function tan_dirty(f) ( f * ($pi + TD_A * f * f); );
function tan_fast(f) local(f2) ( f2 = f * f; f * ($pi + f2 * (TF_A + TF_B * f2)); );
function tan_acc(f) local(f2) ( f2 = f * f; f * ($pi + f2 * (TA_A + f2 * (TA_B + f2 * (TA_C + f2 * (TA_D + f2 * TA_E))))); );
function tan_exact(f) ( f = f < 0.497 ? f : 0.497; tan($pi * f); );

function s2r(s) local(p, pint) ( p = s + 128; pint = p | 0; T_PRH[pint] * T_PRL[((p - pint) * 256) | 0]; );
function note_freq(n) ( n -= 9; n = max(-128, min(127, n)); A0 * 0.25 * s2r(n); );
function interp(t, x, n) local(xi, xf) ( x *= n; xi = x | 0; xf = x - xi; t[xi] + (t[xi + 1] - t[xi]) * xf; );
function interp_wrap(t, x, n) local(xi, xf) ( x -= x | 0; x *= n; xi = x | 0; xf = x - xi; t[xi] + (t[xi + 1] - t[xi]) * xf; );
function interp_herm(t, x, n) local(xi, f, xm1, x0, x1, x2, c, v, w, a, bneg) (
  x *= n; xi = x | 0; f = x - xi;
  xm1 = t[xi - 1]; x0 = t[xi]; x1 = t[xi + 1]; x2 = t[xi + 2];
  c = (x1 - xm1) * 0.5; v = x0 - x1; w = c + v; a = w + v + (x2 - x0) * 0.5; bneg = w + a;
  (((a * f) - bneg) * f + c) * f + x0;
);
function sine(p) ( interp_wrap(T_SINE, p, 512); );
function sine_nw(p) ( interp(T_SINE, p, 512); );
function sine_pm(ph, pm) local(t, ii) (
  t = ph + floor((pm + 32) * 67108864) * 64;
  t -= floor(t / 4294967296) * 4294967296;
  ii = floor(t / 8388608);
  T_SINE[ii] + (T_SINE[ii + 1] - T_SINE[ii]) * ((t - ii * 8388608) / 8388608);
);
function sine_raw(ph) ( T_SINE[floor(ph / 8388608)]; );
function soft_limit(x) ( x * (27 + x * x) / (27 + 9 * x * x); );
function soft_clip(x) ( x < -3 ? -1 : x > 3 ? 1 : soft_limit(x); );
function clamp(x, a, b) ( x < a ? a : x > b ? b : x; );
function u32(x) ( x - floor(x / 4294967296) * 4294967296; );

function tb(t) ( 0.5 * t * t; );
function nb(t) ( t = 1 - t; -0.5 * t * t; );
function nib(t) local(t1, t2) ( t1 = 0.5 * t; t2 = t1 * t1; 0.1875 - t1 + 1.5 * t2 - t2 * t2; );
function tib(t) ( nib(1 - t); );

rng = 33;
function rword() ( rng = rng * 1664525 + 1013904223; rng -= floor(rng / 4294967296) * 4294967296; rng; );
function rfloat() ( rword() / 4294967296; );
function rsample() local(h) ( h = floor(rword() / 65536); h >= 32768 ? h - 65536 : h; );

function rsqrt_c(x) local(e, m, mant, ib, jb, e2, m2, y) (
  e = floor(log(x) / log(2));
  2 ^ e > x ? e -= 1;
  2 ^ (e + 1) <= x ? e += 1;
  m = x / 2 ^ e;
  mant = floor((m - 1) * 8388608 + 0.5);
  mant >= 8388608 ? ( mant = 0; e += 1; );
  ib = (e + 127) * 8388608 + mant;
  jb = 1597463007 - floor(ib / 2);
  e2 = floor(jb / 8388608);
  m2 = jb - e2 * 8388608;
  y = (1 + m2 / 8388608) * 2 ^ (e2 - 127);
  y * (1.5 - (x * 0.5 * y * y));
);

function svf_set(p, g, res) ( p[0] = g; p[1] = 1 / res; p[2] = 1 / (1 + p[1] * g + g * g); );
function svf_init(p) ( svf_set(p, tan_dirty(0.01), 100); p[3] = 0; p[4] = 0; );
function svf_step(p, x) local(hpv, bpv, lpv) (
  hpv = (x - p[1] * p[3] - p[0] * p[3] - p[4]) * p[2];
  bpv = p[0] * hpv + p[3];
  p[3] = p[0] * hpv + bpv;
  lpv = p[0] * bpv + p[4];
  p[4] = p[0] * bpv + lpv;
  svf_hp = hpv; svf_bp = bpv; svf_lp = lpv;
);
function svf_lpf(p, x) ( svf_step(p, x); svf_lp; );
function svf_bpf(p, x) ( svf_step(p, x); svf_bp; );
function svf_hpf(p, x) ( svf_step(p, x); svf_hp; );

function op_set(p, g) ( p[0] = g; p[1] = 1 / (1 + g); );
function op_init(p) ( op_set(p, tan_dirty(0.01)); p[2] = 0; );
function op_lpf(p, x) local(lpv) ( lpv = (p[0] * x + p[2]) * p[1]; p[2] = p[0] * (x - lpv) + lpv; lpv; );
function op_hpf(p, x) local(lpv) ( lpv = (p[0] * x + p[2]) * p[1]; p[2] = p[0] * (x - lpv) + lpv; x - lpv; );

function hq_init(p, n, hyst, sym) ( p[0] = n; p[1] = hyst; p[2] = sym ? n - 1 : n; p[3] = sym ? 0 : -0.5; p[4] = 0; );
function hq_proc(p, base, v) local(sg, q) (
  v *= p[2];
  v += p[3];
  v += base;
  sg = v > p[4] ? -1 : 1;
  q = (v + sg * p[1] + 0.5) | 0;
  q = max(0, min(p[0] - 1, q));
  p[4] = q;
  q;
);

// ---------------------------------------------------------------------- oscillators

O_PH = 0; O_NX = 1; O_LP = 2; O_HP = 3; O_HI = 4; O_F = 5; O_PW = 6;
function osc_init(o) ( o[O_PH] = 0.5; o[O_NX] = 0; o[O_LP] = 1; o[O_HP] = 0; o[O_HI] = 1; o[O_F] = 0.001; o[O_PW] = 0.5; );

function osc_render(o, shape, frq, pw, ob, n) local(f_v, f_i, p_v, p_i, nx, ts, f, w, t, su, sd, dsc, k) (
  frq = clamp(frq, 0.000001, 0.25);
  pw = clamp(pw, abs(frq) * 2, 1 - 2 * abs(frq));
  f_v = o[O_F]; f_i = (frq - f_v) / n;
  p_v = o[O_PW]; p_i = (pw - p_v) / n;
  nx = o[O_NX];
  k = 0;
  loop(n,
    ts = nx;
    nx = 0;
    f_v += f_i;
    f = f_v;
    (shape == 2 || shape == 7) ? w = 0.5 : ( p_v += p_i; w = p_v; );
    o[O_PH] += f;
    shape <= 1 ? (
      o[O_PH] >= 1 ? (
        o[O_PH] -= 1;
        t = o[O_PH] / f;
        ts -= tb(t);
        nx -= nb(t);
      );
      nx += o[O_PH];
      shape == 1 ? (
        ob[k] = 2 * ts - 1;
      ) : (
        o[O_LP] += 0.25 * ((o[O_HP] - ts) - o[O_LP]);
        ob[k] = 4 * o[O_LP];
        o[O_HP] = ts;
      );
    ) : shape <= 3 ? (
      su = 2; sd = 2;
      shape == 3 ? ( su = 1 / w; sd = 1 / (1 - w); );
      (o[O_HI] ? 1 : 0) != (o[O_PH] < w ? 1 : 0) ? (
        t = (o[O_PH] - w) / f;
        dsc = (su + sd) * f;
        ts -= tib(t) * dsc;
        nx -= nib(t) * dsc;
        o[O_HI] = o[O_PH] < w;
      );
      o[O_PH] >= 1 ? (
        o[O_PH] -= 1;
        t = o[O_PH] / f;
        dsc = (su + sd) * f;
        ts += tib(t) * dsc;
        nx += nib(t) * dsc;
        o[O_HI] = 1;
      );
      nx += o[O_HI] ? o[O_PH] * su : 1 - (o[O_PH] - w) * sd;
      ob[k] = 2 * ts - 1;
    ) : (
      (o[O_HI] ? 1 : 0) != (o[O_PH] >= w ? 1 : 0) ? (
        t = (o[O_PH] - w) / f;
        ts += tb(t);
        nx += nb(t);
        o[O_HI] = o[O_PH] >= w;
      );
      o[O_PH] >= 1 ? (
        o[O_PH] -= 1;
        t = o[O_PH] / f;
        ts -= tb(t);
        nx -= nb(t);
        o[O_HI] = 0;
      );
      nx += o[O_PH] < w ? 0 : 1;
      shape == 7 ? (
        ts = 128 * (ts - 0.5);
        o[O_LP] += f * 0.0625 * (ts - o[O_LP]);
        ob[k] = o[O_LP];
      ) : shape == 6 ? (
        ts = 4 * (ts - 0.5);
        o[O_LP] += f * 2 * (ts - o[O_LP]);
        ob[k] = o[O_LP];
      ) : shape == 5 ? (
        ts = 2 * ts - 1;
        o[O_LP] += f * 2 * (ts - o[O_LP]);
        ob[k] = (ts - o[O_LP]) * 0.5;
      ) : (
        ob[k] = 2 * ts - 1;
      );
    );
    k += 1;
  );
  o[O_NX] = nx; o[O_F] = f_v; o[O_PW] = p_v;
);

V_MP = 0; V_SP = 1; V_NX = 2; V_PPW = 3; V_HI = 4; V_MF = 5; V_SF = 6; V_PW = 7; V_WS = 8; V_PM = 9;
function vso_init(o) ( o[V_MP] = 0; o[V_SP] = 0; o[V_NX] = 0; o[V_PPW] = 0.5; o[V_HI] = 0; o[V_MF] = 0; o[V_SF] = 0.01; o[V_PW] = 0.5; o[V_WS] = 0; o[V_PM] = 0; );

function vso_naive(ph, pw, su, sd, tri, sq) local(saw, sqv, trv) (
  saw = ph;
  sqv = ph < pw ? 0 : 1;
  trv = ph < pw ? ph * su : 1 - (ph - pw) * sd;
  saw += (sqv - saw) * sq;
  saw += (trv - saw) * tri;
  saw;
);

function vso_render(o, sync, outph, mf, frq, pw, ws, pma, ob, n)
local(m_v, m_i, f_v, f_i, p_v, p_i, w_v, w_i, q_v, q_i, nx, k, reset, tdr, rt, ts, mfr, sfr, pwv, wsv, sq, tri, su, sd, spr, val, t, ts2, run, wv, phs, p2)
(
  mf >= 0.25 ? mf = 0.25;
  frq >= 0.25 ? frq = 0.25;
  frq >= 0.25 ? pw = 0.5 : pw = clamp(pw, frq * 2, 1 - 2 * frq);
  m_v = o[V_MF]; m_i = (mf - m_v) / n;
  f_v = o[V_SF]; f_i = (frq - f_v) / n;
  p_v = o[V_PW]; p_i = (pw - p_v) / n;
  w_v = o[V_WS]; w_i = (ws - w_v) / n;
  q_v = o[V_PM]; q_i = (pma - q_v) / n;
  nx = o[V_NX];
  k = 0;
  loop(n,
    reset = 0; tdr = 0; rt = 0;
    ts = nx;
    nx = 0;
    m_v += m_i; mfr = m_v;
    f_v += f_i; sfr = f_v;
    p_v += p_i; pwv = p_v;
    w_v += w_i; wsv = w_v;
    sq = max(wsv - 0.5, 0) * 2;
    tri = max(1 - wsv * 2, 0);
    su = 1 / pwv;
    sd = 1 / (1 - pwv);
    sync ? (
      o[V_MP] += mfr;
      o[V_MP] >= 1 ? (
        o[V_MP] -= 1;
        rt = o[V_MP] / mfr;
        spr = o[V_SP] + (1 - rt) * sfr;
        reset = 1;
        spr >= 1 ? ( spr -= 1; tdr = 1; );
        (!o[V_HI] && spr >= pwv) ? tdr = 1;
        val = vso_naive(spr, pwv, su, sd, tri, sq);
        ts -= val * tb(rt);
        nx -= val * nb(rt);
      );
    ) : outph ? (
      o[V_MP] += mfr;
      o[V_MP] >= 1 ? o[V_MP] -= 1;
    );
    o[V_SP] += sfr;
    run = 1;
    while (run && (tdr || !reset)) (
      !o[V_HI] ? (
        o[V_SP] < pwv ? run = 0 : (
          t = (o[V_SP] - pwv) / (o[V_PPW] - pwv + sfr);
          ts2 = (su + sd) * sfr * tri;
          ts += sq * tb(t);
          nx += sq * nb(t);
          ts -= ts2 * tib(t);
          nx -= ts2 * nib(t);
          o[V_HI] = 1;
        );
      );
      (run && o[V_HI]) ? (
        o[V_SP] < 1 ? run = 0 : (
          o[V_SP] -= 1;
          t = o[V_SP] / sfr;
          ts2 = (su + sd) * sfr * tri;
          ts -= (1 - tri) * tb(t);
          nx -= (1 - tri) * nb(t);
          ts += ts2 * tib(t);
          nx += ts2 * nib(t);
          o[V_HI] = 0;
        );
      );
    );
    (sync && reset) ? ( o[V_SP] = rt * sfr; o[V_HI] = 0; );
    nx += vso_naive(o[V_SP], pwv, su, sd, tri, sq);
    o[V_PPW] = pwv;
    outph ? (
      phs = o[V_MP];
      sync ? (
        wv = 4 * (1 - o[V_MP]) * o[V_MP];
        ts *= wv * (2 - wv);
        p2 = phs * phs;
        phs += (p2 * p2 - phs) * abs(pwv - 0.5) * 2;
      );
      q_v += q_i;
      ob[k] = phs + q_v * ts;
    ) : (
      ob[k] = 2 * ts - 1;
    );
    k += 1;
  );
  o[V_NX] = nx; o[V_MF] = m_v; o[V_SF] = f_v; o[V_PW] = p_v; o[V_WS] = w_v; o[V_PM] = q_v;
);

S_PH = 0; S_NX = 1; S_PPW = 2; S_HI = 3; S_F = 4; S_PW = 5; S_WS = 6;
function vsaw_init(o) ( o[S_PH] = 0; o[S_NX] = 0; o[S_PPW] = 0.5; o[S_HI] = 0; o[S_F] = 0.01; o[S_PW] = 0.5; o[S_WS] = 0; );

function vsaw_render(o, frq, pw, ws, ob, n) local(f_v, f_i, p_v, p_i, w_v, w_i, nx, k, ts, f, pwv, tri, nt, su, sd, tst, nch, t, notch, sawn, trv) (
  frq >= 0.25 ? frq = 0.25;
  frq >= 0.25 ? pw = 0.5 : pw = clamp(pw, frq * 2, 1 - 2 * frq);
  f_v = o[S_F]; f_i = (frq - f_v) / n;
  p_v = o[S_PW]; p_i = (pw - p_v) / n;
  w_v = o[S_WS]; w_i = (ws - w_v) / n;
  nx = o[S_NX];
  k = 0;
  loop(n,
    ts = nx;
    nx = 0;
    f_v += f_i; f = f_v;
    p_v += p_i; pwv = p_v;
    w_v += w_i;
    tri = w_v;
    nt = 1 - w_v;
    su = 1 / pwv;
    sd = 1 / (1 - pwv);
    o[S_PH] += f;
    (!o[S_HI] && o[S_PH] >= pwv) ? (
      tst = (su + sd) * f * tri;
      notch = (0.2 + 1 - pwv) * nt;
      t = (o[S_PH] - pwv) / (o[S_PPW] - pwv + f);
      ts += notch * tb(t);
      nx += notch * nb(t);
      ts -= tst * tib(t);
      nx -= tst * nib(t);
      o[S_HI] = 1;
    ) : o[S_PH] >= 1 ? (
      o[S_PH] -= 1;
      tst = (su + sd) * f * tri;
      notch = (0.2 + 1) * nt;
      t = o[S_PH] / f;
      ts -= notch * tb(t);
      nx -= notch * nb(t);
      ts += tst * tib(t);
      nx += tst * nib(t);
      o[S_HI] = 0;
    );
    sawn = o[S_PH] < pwv ? o[S_PH] : 1 + 0.2;
    trv = o[S_PH] < pwv ? o[S_PH] * su : 1 - (o[S_PH] - pwv) * sd;
    nx += sawn * nt + trv * tri;
    o[S_PPW] = pwv;
    ob[k] = (2 * ts - 1) / (1 + 0.2);
    k += 1;
  );
  o[S_NX] = nx; o[S_F] = f_v; o[S_PW] = p_v; o[S_WS] = w_v;
);

// ---------------------------------------------------------------------- 8: virtual analog

VA_P = alloc(10); VA_A = alloc(10); VA_S = alloc(10); VA_W = alloc(8); VA_T = alloc(24);
VAI = alloc(5);
VAI[0] = 0; VAI[1] = 7.01; VAI[2] = 12.01; VAI[3] = 19.01; VAI[4] = 24.01;
function va_init() ( vso_init(VA_P); vso_init(VA_A); VA_A[V_MP] = 0.25; vso_init(VA_S); vsaw_init(VA_W); va_aux = 0; va_xmod = 0; );
function va_squash(x) ( x * x * (3 - 2 * x); );
function va_detune(d) local(sg, di, df, a, b) (
  d = 2.05 * d - 1.025;
  d = clamp(d, -1, 1);
  sg = d < 0 ? -1 : 1;
  d = d * sg * 3.9999;
  di = d | 0; df = d - di;
  a = VAI[di]; b = VAI[di + 1];
  (a + (b - a) * va_squash(va_squash(df))) * sg;
);
function va_render(ob, ab, n) local(sync, adet, pf, af, psf, asf, shp, pw, k, spw, ssr, sqg, swpw, sws, swg, ssf, nrm, sg_v, sg_i, sw_v, sw_i) (
  sync = ep_timbre * ep_timbre;
  adet = va_detune(ep_harm);
  pf = note_freq(ep_note);
  af = note_freq(ep_note + adet);
  psf = note_freq(ep_note + sync * 48);
  asf = note_freq(ep_note + adet + sync * 48);
  shp = clamp(ep_morph * 1.5, 0, 1);
  pw = clamp(0.5 + (ep_morph - 0.66) * 1.46, 0.5, 0.995);
  vso_render(VA_P, 1, 0, pf, psf, pw, shp, 0, ob, n);
  vso_render(VA_A, 1, 0, af, asf, pw, shp, 0, ab, n);
  k = 0; loop(n, ab[k] = (ab[k] - ob[k]) * 0.5; k += 1; );
  spw = clamp(1.3 * ep_timbre - 0.15, 0.005, 0.5);
  ssr = ep_timbre < 0.5 ? 0 : (ep_timbre - 0.5) * (ep_timbre - 0.5) * 4 * 48;
  sqg = min(ep_timbre * 8, 1);
  swpw = ep_morph < 0.5 ? ep_morph + 0.5 : 1 - (ep_morph - 0.5) * 2;
  swpw *= 1.1;
  swpw = clamp(swpw, 0.005, 1);
  sws = clamp(10 - 21 * ep_morph, 0, 1);
  swg = clamp(8 * (1 - ep_morph), 0.02, 1);
  ssf = note_freq(ep_note + ssr);
  vso_render(VA_S, 1, 0, pf, ssf, spw, 1, 0, VA_T, n);
  vsaw_render(VA_W, af, swpw, sws, ob, n);
  nrm = 1 / max(sqg, swg);
  sg_v = va_aux; sg_i = (sqg * 0.3 * nrm - sg_v) / n;
  sw_v = va_xmod; sw_i = (swg * 0.5 * nrm - sw_v) / n;
  k = 0;
  loop(n,
    sw_v += sw_i;
    sg_v += sg_i;
    ob[k] = ob[k] * sw_v + sg_v * VA_T[k];
    k += 1;
  );
  va_aux = sg_v; va_xmod = sw_v;
);

// ---------------------------------------------------------------------- 9: waveshaping

WS_S = alloc(8); WS_T = alloc(8);
function ws_init() ( osc_init(WS_S); osc_init(WS_T); ws_pshape = 0; ws_pwf = 0; ws_pov = 0; );
function ws_tame(f0, h, order) local(mf, ma) ( f0 *= h; mf = 0.5 / order; ma = clamp(1 - (f0 - mf) / (0.5 - mf), 0, 1); ma * ma * ma; );
function ws_render(ob, ab, n) local(f0, pw, slope, sha, shatt, wfg, wfatt, s_v, s_i, w_v, w_i, ovg, o_v, o_i, k, shp, si, sf, s1, s2, wi, wf, wii, x0, x1, xv, y0, y1, yv, mix, idx, fold, fold2, sn) (
  f0 = note_freq(ep_note);
  pw = ep_morph * 0.45 + 0.5;
  osc_render(WS_S, 3, f0, pw, ob, n);
  osc_render(WS_T, 3, f0, 0.5, ab, n);
  slope = 3 + abs(ep_morph - 0.5) * 5;
  sha = abs(ep_harm - 0.5) * 2;
  shatt = ws_tame(f0, slope, 16);
  wfg = ep_timbre;
  wfatt = ws_tame(f0, slope * (3 + sha * shatt * 5), 12);
  s_v = ws_pshape; s_i = ((0.5 + (ep_harm - 0.5) * shatt) - s_v) / n;
  w_v = ws_pwf; w_i = ((0.03 + 0.46 * wfg * wfatt) - w_v) / n;
  ovg = ep_timbre * (2 - ep_timbre);
  o_v = ws_pov; o_i = ((ovg * (2 - ovg)) - o_v) / n;
  k = 0;
  loop(n,
    s_v += s_i;
    shp = s_v * 3.9999;
    si = shp | 0; sf = shp - si;
    s1 = T_WS + si * 257;
    s2 = T_WS + (si + 1) * 257;
    wi = 127 * ob[k] + 128;
    wii = wi | 0; wf = wi - wii;
    wii &= 255;
    x0 = s1[wii] / 32768; x1 = s1[wii + 1] / 32768; xv = x0 + (x1 - x0) * wf;
    y0 = s2[wii] / 32768; y1 = s2[wii + 1] / 32768; yv = y0 + (y1 - y0) * wf;
    mix = xv + (yv - xv) * sf;
    w_v += w_i;
    idx = mix * w_v + 0.5;
    fold = interp_herm(T_FOLD + 1, idx, 512);
    fold2 = -interp_herm(T_FOLD2 + 1, idx, 512);
    sn = sine(ab[k] * 0.25 + 0.5);
    ob[k] = fold;
    o_v += o_i;
    ab[k] = sn + (fold2 - sn) * o_v;
    k += 1;
  );
  ws_pshape = s_v; ws_pwf = w_v; ws_pov = o_v;
);

// ---------------------------------------------------------------------- 10: FM

function fm_init() ( fm_cph = 0; fm_mph = 0; fm_sph = 0; fm_pcf = A0; fm_pmf = A0; fm_pam = 0; fm_pfb = 0; fm_prv = 0; fm_sfir = 0; fm_cfir = 0; );
function fm_render(ob, ab, n) local(nt, ratio, mnote, tmf, hft, c_v, c_i, m_v, m_i, a_v, a_i, b_v, b_i, ch, ct, sh, st, k, amt, fbk, pfb, cinc, mfr, j, mfb, modv, car, sub, h0, h1) (
  nt = ep_note - 24;
  ratio = interp(T_FMQ, ep_harm, 128);
  mnote = nt + ratio;
  tmf = clamp(note_freq(mnote), 0, 0.5);
  hft = clamp(1 - (mnote - 72) * 0.025, 0, 1);
  hft *= hft;
  c_v = fm_pcf; c_i = (note_freq(nt) - c_v) / n;
  m_v = fm_pmf; m_i = (tmf - m_v) / n;
  a_v = fm_pam; a_i = ((2 * ep_timbre * ep_timbre * hft) - a_v) / n;
  b_v = fm_pfb; b_i = ((2 * ep_morph - 1) - b_v) / n;
  ch = fm_cfir; ct = 0;
  sh = fm_sfir; st = 0;
  k = 0;
  loop(n,
    a_v += a_i; amt = a_v;
    b_v += b_i; fbk = b_v;
    pfb = fbk < 0 ? 0.5 * fbk * fbk : 0;
    c_v += c_i;
    cinc = floor(4294967296 * c_v);
    m_v += m_i; mfr = m_v;
    j = 0;
    loop(4,
      fm_mph = u32(fm_mph + floor(4294967296 * mfr * (1 + fm_prv * pfb)));
      fm_cph = u32(fm_cph + cinc);
      fm_sph = u32(fm_sph + floor(cinc / 2));
      mfb = fbk > 0 ? 0.25 * fbk * fbk : 0;
      modv = sine_pm(fm_mph, mfb * fm_prv);
      car = sine_pm(fm_cph, amt * modv);
      sub = sine_pm(fm_sph, amt * car * 0.25);
      fm_prv += 0.05 * (car - fm_prv);
      ch += car * T_DSFIR[3 - j]; ct += car * T_DSFIR[j];
      sh += sub * T_DSFIR[3 - j]; st += sub * T_DSFIR[j];
      j += 1;
    );
    ob[k] = ch; ch = ct; ct = 0;
    ab[k] = sh; sh = st; st = 0;
    k += 1;
  );
  fm_cfir = ch; fm_sfir = sh;
  fm_pcf = c_v; fm_pmf = m_v; fm_pam = a_v; fm_pfb = b_v;
);

// ---------------------------------------------------------------------- 11: grains

G_CP = 0; G_FP = 1; G_NX = 2; G_CF = 3; G_FF = 4; G_CS = 5; G_CB = 6;
GL0 = alloc(8); GL1 = alloc(8); GZ = alloc(10); GDC0 = alloc(4); GDC1 = alloc(4);
function gl_init(o) ( memset(o, 0, 7); );
function gl_carrier(ph, shp) local(si, sf, t, bp) (
  shp *= 3;
  si = shp | 0; sf = shp - si;
  t = 1 - sf;
  si == 0 ? (
    ph = ph * (1 + t * t * t * 15);
    ph >= 1 ? ph = 1;
    ph += 0.75;
  ) : si == 1 ? (
    bp = 0.001 + 0.499 * t * t * t;
    ph < bp ? ph *= (0.5 / bp) : ph = 0.5 + (ph - bp) * 0.5 / (1 - bp);
    ph += 0.75;
  ) : (
    t = 1 - t;
    ph = 0.25 + ph * (0.5 + t * t * t * 14.5);
    ph >= 0.75 ? ph = 0.75;
  );
  (sine(ph) + 1) * 0.25;
);
function gl_grain(cp, fp, shp, bl) ( gl_carrier(cp, shp) * (sine(fp) + bl) / (1 + bl); );
function gl_render(o, cf, ff, cs, cb, ob, n) local(cf_v, cf_i, ff_v, ff_i, cs_v, cs_i, cb_v, cb_i, nx, k, ts, f0, f1, rt, bef, aft, dsc) (
  cf >= 0.125 ? cf = 0.125;
  ff >= 0.25 ? ff = 0.25;
  cf_v = o[G_CF]; cf_i = (cf - cf_v) / n;
  ff_v = o[G_FF]; ff_i = (ff - ff_v) / n;
  cs_v = o[G_CS]; cs_i = (cs - cs_v) / n;
  cb_v = o[G_CB]; cb_i = (cb - cb_v) / n;
  nx = o[G_NX];
  k = 0;
  loop(n,
    ts = nx;
    nx = 0;
    cf_v += cf_i; f0 = cf_v;
    ff_v += ff_i; f1 = ff_v;
    o[G_CP] += f0;
    o[G_CP] >= 1 ? (
      o[G_CP] -= 1;
      rt = o[G_CP] / f0;
      bef = gl_grain(1, o[G_FP] + (1 - rt) * f1, cs_v + cs_i * (1 - rt), cb_v + cb_i * (1 - rt));
      aft = gl_grain(0, 0, cs_v + cs_i, cb_v + cb_i);
      dsc = aft - bef;
      ts += dsc * tb(rt);
      nx += dsc * nb(rt);
      o[G_FP] = rt * f1;
    ) : (
      o[G_FP] += f1;
      o[G_FP] >= 1 ? o[G_FP] -= 1;
    );
    cs_v += cs_i; cb_v += cb_i;
    nx += gl_grain(o[G_CP], o[G_FP], cs_v, cb_v);
    ob[k] = ts;
    k += 1;
  );
  o[G_NX] = nx; o[G_CF] = cf_v; o[G_FF] = ff_v; o[G_CS] = cs_v; o[G_CB] = cb_v;
);

Z_CP = 0; Z_DP = 1; Z_FP = 2; Z_NX = 3; Z_CF = 4; Z_FF = 5; Z_CS = 6; Z_MD = 7;
function z_fn(c, d, f, shp, md) local(rd, off, psh, dsc, ct) (
  rd = 0.5 * (1 + sine(0.5 * d + 0.25));
  md < 0.333 ? (
    off = 1;
    psh = 0.25 + md * 1.5;
  ) : md < 0.666 ? (
    psh = 0.7495 - (md - 0.33) * 0.75;
    off = -sine(psh);
  ) : (
    psh = 0.7495 - (md - 0.33) * 0.75;
    off = 0.001;
  );
  dsc = sine(f + psh);
  shp < 0.5 ? (
    shp *= 2;
    c >= 0.5 ? rd *= shp;
    ct = 1 + (sine(c + 0.25) - 1) * shp;
  ) : (
    ct = sine(c + shp * 0.5);
  );
  (rd * (off + dsc) - off) * ct;
);
function z_render(o, cf, ff, cs, md, ob, n) local(cf_v, cf_i, ff_v, ff_i, cs_v, cs_i, md_v, md_i, nx, k, ts, f0, f1, rt, cpb, cpa, bef, aft, dsc) (
  cf >= 0.125 ? cf = 0.125;
  ff >= 0.25 ? ff = 0.25;
  cf_v = o[Z_CF]; cf_i = (cf - cf_v) / n;
  ff_v = o[Z_FF]; ff_i = (ff - ff_v) / n;
  cs_v = o[Z_CS]; cs_i = (cs - cs_v) / n;
  md_v = o[Z_MD]; md_i = (md - md_v) / n;
  nx = o[Z_NX];
  k = 0;
  loop(n,
    ts = nx;
    nx = 0;
    cf_v += cf_i; f0 = cf_v;
    ff_v += ff_i; f1 = ff_v;
    o[Z_DP] += 2 * f0;
    o[Z_CP] += f0;
    o[Z_DP] >= 1 ? (
      o[Z_DP] -= 1;
      rt = o[Z_DP] / (2 * f0);
      cpb = o[Z_CP] >= 1 ? 1 : 0.5;
      cpa = o[Z_CP] >= 1 ? 0 : 0.5;
      bef = z_fn(cpb, 1, o[Z_FP] + (1 - rt) * f1, cs_v + cs_i * (1 - rt), md_v + md_i * (1 - rt));
      aft = z_fn(cpa, 0, 0, cs_v + cs_i, md_v + md_i);
      dsc = aft - bef;
      ts += dsc * tb(rt);
      nx += dsc * nb(rt);
      o[Z_FP] = rt * f1;
      o[Z_CP] > 1 ? o[Z_CP] = o[Z_DP] * 0.5;
    ) : (
      o[Z_FP] += f1;
      o[Z_FP] >= 1 ? o[Z_FP] -= 1;
    );
    o[Z_CP] >= 1 ? o[Z_CP] -= 1;
    cs_v += cs_i; md_v += md_i;
    nx += z_fn(o[Z_CP], o[Z_DP], o[Z_FP], cs_v, md_v);
    ob[k] = ts;
    k += 1;
  );
  o[Z_NX] = nx; o[Z_CF] = cf_v; o[Z_FF] = ff_v; o[Z_CS] = cs_v; o[Z_MD] = md_v;
);

function gr_init() ( gl_init(GL0); gl_init(GL1); memset(GZ, 0, 8); op_init(GDC0); op_init(GDC1); );
function gr_render(ob, ab, n) local(f0, f1, ratio, cbl, cbf, csh, k, cut) (
  f0 = note_freq(ep_note);
  f1 = note_freq(24 + 84 * ep_timbre);
  ratio = s2r(-24 + 48 * ep_harm);
  cbl = ep_harm < 0.5 ? 1 - 2 * ep_harm : 0;
  cbf = cbl * (2 - cbl);
  csh = 0.33 + (ep_morph - 0.33) * max(1 - f0 * 24, 0);
  gl_render(GL0, f0, f1, csh, cbf, ob, n);
  gl_render(GL1, f0, f1 * ratio, csh, cbf, ab, n);
  op_set(GDC0, tan_dirty(0.3 * f0));
  k = 0; loop(n, ob[k] = op_hpf(GDC0, ob[k] + ab[k]); k += 1; );
  cut = note_freq(ep_note + 96 * ep_timbre);
  z_render(GZ, f0, cut, ep_morph, ep_harm, ab, n);
  op_set(GDC1, tan_dirty(0.3 * f0));
  k = 0; loop(n, ab[k] = op_hpf(GDC1, ab[k]); k += 1; );
);

// ---------------------------------------------------------------------- 12: additive

ADA = alloc(36);
HO0 = alloc(16); HO1 = alloc(16); HO2 = alloc(16);
HAM = alloc(12);
ORGH = alloc(8);
ORGH[0] = 0; ORGH[1] = 1; ORGH[2] = 2; ORGH[3] = 3; ORGH[4] = 5; ORGH[5] = 7; ORGH[6] = 9; ORGH[7] = 11;
function ad_init() ( memset(HO0, 0, 16); memset(HO1, 0, 16); memset(HO2, 0, 16); );
function ad_reset() ( memset(ADA, 0, 36); );
function ad_update(cen, slope, bumps, amps, organ, nh) local(nn, mrg, ctr, sum, i, ord, gn, bv, bf, j) (
  nn = nh - 1;
  mrg = (1 / slope - 1) / (1 + bumps);
  ctr = cen * (nn + mrg) - 0.5 * mrg;
  sum = 0.001;
  i = 0;
  loop(nh,
    ord = abs(i - ctr) * slope;
    gn = 1 - ord;
    gn += abs(gn);
    gn *= gn;
    bv = 0.25 + ord * bumps;
    bf = 1 + sine(bv);
    gn *= bf;
    gn *= gn;
    gn *= gn;
    j = organ ? ORGH[i] : i;
    amps[j] += 0.001 * (gn - amps[j]);
    sum += amps[j];
    i += 1;
  );
  sum = 1 / sum;
  i = 0;
  loop(nh, j = organ ? ORGH[i] : i; amps[j] *= sum; i += 1; );
);
function ho_render(o, first, frq, amps, ob, n) local(f_v, f_i, i, f, k, tx, prv, cur, sum, tmp, kk) (
  frq >= 0.5 ? frq = 0.5;
  f_v = o[0]; f_i = (frq - f_v) / n;
  i = 0;
  loop(12,
    f = frq * (first + i);
    f >= 0.5 ? f = 0.5;
    HAM[i] = (amps[i] * (1 - f * 2) - o[2 + i]) / n;
    i += 1;
  );
  k = 0;
  loop(n,
    f_v += f_i;
    o[1] += f_v;
    o[1] >= 1 ? o[1] -= 1;
    tx = 2 * sine_nw(o[1]);
    first == 1 ? (
      prv = 1;
      cur = tx * 0.5;
    ) : (
      kk = first;
      prv = sine(o[1] * (kk - 1) + 0.25);
      cur = sine(o[1] * kk);
    );
    sum = 0;
    i = 0;
    loop(12,
      o[2 + i] += HAM[i];
      sum += o[2 + i] * cur;
      tmp = cur;
      cur = tx * cur - prv;
      prv = tmp;
      i += 1;
    );
    first == 1 ? ob[k] = sum : ob[k] += sum;
    k += 1;
  );
  o[0] = f_v;
);
function ad_render(ob, ab, n) local(f0, cen, rb, rs, slope, bumps) (
  f0 = note_freq(ep_note);
  cen = ep_timbre;
  rb = ep_harm;
  rs = (1 - 0.6 * rb) * ep_morph;
  slope = 0.01 + 1.99 * rs * rs * rs;
  bumps = 16 * rb * rb;
  ad_update(cen, slope, bumps, ADA, 0, 24);
  ho_render(HO0, 1, f0, ADA, ob, n);
  ho_render(HO1, 13, f0, ADA + 12, ob, n);
  ad_update(cen, slope, bumps, ADA + 24, 1, 8);
  ho_render(HO2, 1, f0, ADA + 24, ab, n);
);

// ---------------------------------------------------------------------- 13: wavetable

WMAP = alloc(256);
function wt_init() (
  wt_ph = 0; wt_xl = wt_yl = wt_zl = 0; wt_xp = wt_yp = wt_zp = 0; wt_px = wt_py = wt_pz = 0; wt_pf = A0;
  wt_dlp = 0; wt_dpr = 0;
);
function wt_load() local(b, w, i, ww) (
  b = 0;
  loop(4,
    w = 0;
    loop(64,
      i = b * 64 + w;
      ww = i;
      b == 3 ? ww = (ww * 101) % 192;
      WMAP[i] = T_WAVES + ww * 132;
      w += 1;
    );
    b += 1;
  );
);
function wt_clamp(x, amt) ( x = x - 0.5; x *= amt; x = clamp(x, -0.5, 0.5); x + 0.5; );
function wave_herm(t, ii, f) local(xm1, x0, x1, x2, c, v, w, a, bneg) (
  xm1 = t[ii]; x0 = t[ii + 1]; x1 = t[ii + 2]; x2 = t[ii + 3];
  c = (x1 - xm1) * 0.5; v = x0 - x1; w = c + v; a = w + v + (x2 - x0) * 0.5; bneg = w + a;
  (((a * f) - bneg) * f + c) * f + x0;
);
function wt_read(x, y, z, pi, pf) ( wave_herm(WMAP[x + y * 8 + z * 64], pi, pf); );
function wt_render(ob, ab, n) local(f0, q, lpc, x, y, z, xi, xf, yi, yf, zi, zf, x_v, x_i, y_v, y_i, z_v, z_i, f_v, f_i, k, f, gn, cut, p, pi, pf,
  x0, x1, y0, y1, z0, z1, a, b, c, d, e, g, h, m, mix)
(
  f0 = note_freq(ep_note);
  wt_xp += 0.2 * (ep_timbre * 6.9999 - wt_xp);
  wt_yp += 0.2 * (ep_morph * 6.9999 - wt_yp);
  wt_zp += 0.05 * (ep_harm * 6.9999 - wt_zp);
  x = wt_xp; y = wt_yp; z = wt_zp;
  q = min(max(z - 3, 0), 1);
  lpc = min(max(2 * f0 * (4 - 3 * q), 0.01), 0.1);
  xi = x | 0; xf = x - xi;
  yi = y | 0; yf = y - yi;
  zi = z | 0; zf = z - zi;
  xf += q * (wt_clamp(xf, 16) - xf);
  yf += q * (wt_clamp(yf, 16) - yf);
  zf += q * (wt_clamp(zf, 16) - zf);
  x_v = wt_px; x_i = ((xi + xf) - x_v) / n;
  y_v = wt_py; y_i = ((yi + yf) - y_v) / n;
  z_v = wt_pz; z_i = ((zi + zf) - z_v) / n;
  f_v = wt_pf; f_i = (f0 - f_v) / n;
  k = 0;
  loop(n,
    f_v += f_i; f = f_v;
    gn = (1 / (f * 131072)) * (0.95 - f);
    cut = min(128 * f, 1);
    x_v += x_i; wt_xl += lpc * (x_v - wt_xl);
    y_v += y_i; wt_yl += lpc * (y_v - wt_yl);
    z_v += z_i; wt_zl += lpc * (z_v - wt_zl);
    xi = wt_xl | 0; xf = wt_xl - xi;
    yi = wt_yl | 0; yf = wt_yl - yi;
    zi = wt_zl | 0; zf = wt_zl - zi;
    wt_ph += f;
    wt_ph >= 1 ? wt_ph -= 1;
    p = wt_ph * 128;
    pi = p | 0; pf = p - pi;
    x0 = xi; x1 = xi + 1; y0 = yi; y1 = yi + 1; z0 = zi; z1 = zi + 1;
    z0 >= 4 ? z0 = 7 - z0;
    z1 >= 4 ? z1 = 7 - z1;
    a = wt_read(x0, y0, z0, pi, pf); b = wt_read(x1, y0, z0, pi, pf); c = a + (b - a) * xf;
    a = wt_read(x0, y1, z0, pi, pf); b = wt_read(x1, y1, z0, pi, pf); d = a + (b - a) * xf;
    e = c + (d - c) * yf;
    a = wt_read(x0, y0, z1, pi, pf); b = wt_read(x1, y0, z1, pi, pf); g = a + (b - a) * xf;
    a = wt_read(x0, y1, z1, pi, pf); b = wt_read(x1, y1, z1, pi, pf); h = a + (b - a) * xf;
    m = g + (h - g) * yf;
    mix = e + (m - e) * zf;
    wt_dlp += cut * ((mix - wt_dpr) - wt_dlp);
    wt_dpr = mix;
    mix = wt_dlp * gn;
    ob[k] = mix;
    ab[k] = ((mix * 32) | 0) / 32;
    k += 1;
  );
  wt_px = x_v; wt_py = y_v; wt_pz = z_v; wt_pf = f_v;
);

// ---------------------------------------------------------------------- 14: chords

CH_SSO = alloc(5 * 10); CH_WTO = alloc(5 * 8); CH_WT = alloc(16); CB_CH = alloc(64); CB_SM = alloc(64); CB_CT = alloc(64);
CH_TBL = alloc(44); CH_REG = alloc(48); CH_HARM = alloc(8); CH_NR = alloc(5); CH_NA = alloc(5); CH_FADE = alloc(5);
CH_REGS = alloc(8);
function cset4(p, a, b, c, d) ( p[0] = a; p[1] = b; p[2] = c; p[3] = d; );
cset4(CH_TBL, 0, 0.01, 11.99, 12); cset4(CH_TBL + 4, 0, 7, 7.01, 12); cset4(CH_TBL + 8, 0, 5, 7, 12); cset4(CH_TBL + 12, 0, 3, 7, 12);
cset4(CH_TBL + 16, 0, 3, 7, 10); cset4(CH_TBL + 20, 0, 3, 10, 14); cset4(CH_TBL + 24, 0, 3, 10, 17); cset4(CH_TBL + 28, 0, 2, 9, 16);
cset4(CH_TBL + 32, 0, 4, 11, 14); cset4(CH_TBL + 36, 0, 4, 7, 11); cset4(CH_TBL + 40, 0, 4, 7, 12);
function cset6(p, a, b, c, d, e, f) ( p[0] = a; p[1] = b; p[2] = c; p[3] = d; p[4] = e; p[5] = f; );
cset6(CH_REG, 0, 1, 0, 0, 0, 0); cset6(CH_REG + 6, 1, 0, 0, 0, 0, 0); cset6(CH_REG + 12, 0.5, 0, 0.5, 0, 0, 0);
cset6(CH_REG + 18, 0.33, 0, 0.33, 0, 0.33, 0); cset6(CH_REG + 24, 0.33, 0, 0, 0.33, 0, 0.33); cset6(CH_REG + 30, 0.5, 0, 0, 0, 0, 0.5);
cset6(CH_REG + 36, 0, 0.5, 0, 0, 0, 0.5); cset6(CH_REG + 42, 0, 0.1, 0.1, 0, 0.2, 0.6);
CH_FADE[0] = 0.55; CH_FADE[1] = 0.47; CH_FADE[2] = 0.49; CH_FADE[3] = 0.51; CH_FADE[4] = 0.53;
function ch_wave(i, b, r, c) ( CH_WT[i] = T_WAVES + (b * 64 + r * 8 + c) * 132; );
function ch_waves() (
  ch_wave(0, 2, 6, 1); ch_wave(1, 2, 6, 6); ch_wave(2, 2, 6, 4); ch_wave(3, 0, 6, 0); ch_wave(4, 0, 6, 1);
  ch_wave(5, 0, 6, 2); ch_wave(6, 0, 6, 7); ch_wave(7, 2, 4, 7); ch_wave(8, 2, 4, 6); ch_wave(9, 2, 4, 5);
  ch_wave(10, 2, 4, 4); ch_wave(11, 2, 4, 3); ch_wave(12, 2, 4, 2); ch_wave(13, 2, 4, 1); ch_wave(14, 2, 4, 0);
);

function sso_init(o) ( o[0] = 0; o[1] = 0; o[2] = 0; o[3] = 0.001; o[4] = 0; o[5] = 0; o[6] = 0; o[7] = 0; );
function sso_render(o, frq, reg, gn, ob, n) local(shift, i, r0, r1, r2, r3, r4, r5, r6, f_v, f_i, g8, g8i, g4, g4i, g2, g2i, g1, g1i, ph, nx, sg, k, ts, f, nsg, dsc, fr, t) (
  frq *= 8;
  shift = 0;
  while (frq > 0.5) ( shift += 2; frq *= 0.5; );
  shift < 8 ? (
    i = 0;
    loop(7, CH_REGS[i] = i < shift ? 0 : reg[i - shift]; i += 1; );
    r0 = CH_REGS[0]; r1 = CH_REGS[1]; r2 = CH_REGS[2]; r3 = CH_REGS[3]; r4 = CH_REGS[4]; r5 = CH_REGS[5]; r6 = CH_REGS[6];
    f_v = o[3]; f_i = (frq - f_v) / n;
    g8 = o[4]; g8i = ((r0 + 2 * r1) * gn - g8) / n;
    g4 = o[5]; g4i = ((r2 - r1 + 2 * r3) * gn - g4) / n;
    g2 = o[6]; g2i = ((r4 - r3 + 2 * r5) * gn - g2) / n;
    g1 = o[7]; g1i = ((r6 - r5) * gn - g1) / n;
    ph = o[0]; nx = o[1]; sg = o[2];
    k = 0;
    loop(n,
      ts = nx;
      nx = 0;
      f_v += f_i; f = f_v;
      g8 += g8i; g4 += g4i; g2 += g2i; g1 += g1i;
      ph += f;
      nsg = ph | 0;
      nsg != sg ? (
        dsc = 0;
        nsg == 8 ? ( ph -= 8; nsg -= 8; dsc -= g8; );
        (nsg & 3) == 0 ? dsc -= g4;
        (nsg & 1) == 0 ? dsc -= g2;
        dsc -= g1;
        dsc !== 0 ? (
          fr = ph - nsg;
          t = fr / f;
          ts += tb(t) * dsc;
          nx += nb(t) * dsc;
        );
      );
      sg = nsg;
      nx += (ph - 4) * g8 * 0.125;
      nx += (ph - (sg & 4) - 2) * g4 * 0.25;
      nx += (ph - (sg & 6) - 1) * g2 * 0.5;
      nx += (ph - (sg & 7) - 0.5) * g1;
      ob[k] += 2 * ts;
      k += 1;
    );
    o[0] = ph; o[1] = nx; o[2] = sg; o[3] = f_v; o[4] = g8; o[5] = g4; o[6] = g2; o[7] = g1;
  );
);

function wto_init(o) ( memset(o, 0, 8); );
function wto_render(o, frq, amp, wf, wt, nw, ob, n) local(f_v, f_i, a_v, a_i, w_v, w_i, lp, ph, k, f0, cut, wi, wfr, p, pi, pf, t0, t1, x0, x1, s) (
  frq = clamp(frq, 0.0000001, 0.25);
  amp *= 1 - 2 * frq;
  amp *= 1 / (frq * 131072);
  f_v = o[1]; f_i = (frq - f_v) / n;
  a_v = o[2]; a_i = (amp - a_v) / n;
  w_v = o[3]; w_i = (wf * (nw - 1.0001) - w_v) / n;
  lp = o[4]; ph = o[0];
  k = 0;
  loop(n,
    f_v += f_i; f0 = f_v;
    cut = min(128 * f0, 1);
    ph += f0;
    ph >= 1 ? ph -= 1;
    w_v += w_i;
    wi = w_v | 0; wfr = w_v - wi;
    p = ph * 128;
    pi = p | 0; pf = p - pi;
    t0 = wt[wi]; t1 = wt[wi + 1];
    x0 = t0[pi] + (t0[pi + 1] - t0[pi]) * pf;
    x1 = t1[pi] + (t1[pi + 1] - t1[pi]) * pf;
    o[6] += cut * (((x0 + (x1 - x0) * wfr) - o[5]) - o[6]);
    o[5] = x0 + (x1 - x0) * wfr;
    s = o[6];
    lp += cut * (s - lp);
    a_v += a_i;
    ob[k] += a_v * lp;
    k += 1;
  );
  o[0] = ph; o[1] = f_v; o[2] = a_v; o[3] = w_v; o[4] = lp;
);

function cb_init(cb) ( hq_init(cb, 11, 0.075, 0); );
function cb_sort(cb) local(i, j, r, t) (
  i = 0;
  loop(4,
    r = cb[5 + cb[4] * 4 + i];
    while (r > 2) ( r *= 0.5; );
    cb[60 + i] = r;
    i += 1;
  );
  i = 0;
  loop(3,
    j = 0;
    loop(3 - i,
      cb[60 + j] > cb[61 + j] ? ( t = cb[60 + j]; cb[60 + j] = cb[61 + j]; cb[61 + j] = t; );
      j += 1;
    );
    i += 1;
  );
);
function cb_reset(cb) local(i, j, cnt, v) (
  i = 0;
  loop(11,
    cnt = 0;
    j = 0;
    loop(4,
      v = CH_TBL[i * 4 + j];
      cb[5 + i * 4 + j] = s2r(v);
      (v !== 0.01 && v !== 7.01 && v !== 11.99 && v !== 12) ? cnt += 1;
      j += 1;
    );
    cb[49 + i] = cnt;
    i += 1;
  );
  cb_sort(cb);
);
function cb_set(cb, p) ( hq_proc(cb, 0, p * 1.02); );
function cb_ratio(cb, nt) ( cb[5 + cb[4] * 4 + nt]; );
function cb_inversion(cb, inv) local(base, ii, fr, nrot, rnote, mask, i, tr, tv, pv) (
  base = cb + 5 + cb[4] * 4;
  inv = inv * 20;
  ii = inv | 0; fr = inv - ii;
  nrot = floor(ii / 4);
  rnote = ii % 4;
  mask = 0;
  i = 0;
  loop(4,
    tr = 0.25 * 2 ^ floor((3 + ii - i) / 4);
    tv = (i - nrot + 5) % 5;
    pv = (tv - 1 + 5) % 5;
    i == rnote ? (
      CH_NR[tv] = base[i] * tr;
      CH_NR[pv] = CH_NR[tv] * 2;
      CH_NA[pv] = 0.25 * fr;
      CH_NA[tv] = 0.25 * (1 - fr);
    ) : i < rnote ? (
      CH_NR[pv] = base[i] * tr;
      CH_NA[pv] = 0.25;
    ) : (
      CH_NR[tv] = base[i] * tr;
      CH_NA[tv] = 0.25;
    );
    i == 0 ? (
      i >= rnote ? mask |= 2 ^ tv;
      i <= rnote ? mask |= 2 ^ pv;
    );
    i += 1;
  );
  mask;
);
function ch_init() local(i) (
  i = 0; loop(5, sso_init(CH_SSO + i * 10); wto_init(CH_WTO + i * 8); i += 1; );
  cb_init(CB_CH);
  ch_mlp = 0; ch_tlp = 0;
  ch_waves();
);
function ch_reset() ( cb_reset(CB_CH); );
function ch_render(ob, ab, n) local(reg, ri, rf, i, a, b, mask, f0, wf, nt, wta, dda, dst, nf0, ddg, k) (
  ch_mlp += 0.1 * (ep_morph - ch_mlp);
  ch_tlp += 0.1 * (ep_timbre - ch_tlp);
  cb_set(CB_CH, ep_harm);
  reg = max(1 - ch_mlp * 2.15, 0);
  reg *= 7 - 0.001;
  ri = reg | 0; rf = reg - ri;
  i = 0;
  loop(6, a = CH_REG[ri * 6 + i]; b = CH_REG[(ri + 1) * 6 + i]; CH_HARM[i] = a + (b - a) * rf; i += 1; );
  CH_HARM[6] = 0;
  mask = cb_inversion(CB_CH, ch_tlp);
  memset(ob, 0, n);
  memset(ab, 0, n);
  f0 = note_freq(ep_note) * 0.998;
  wf = max((ch_mlp - 0.535) * 2.15, 0);
  nt = 0;
  loop(5,
    wta = clamp(50 * (ch_mlp - CH_FADE[nt]), 0, 1);
    dda = 1 - wta;
    dst = (2 ^ nt) & mask ? ab : ob;
    nf0 = f0 * CH_NR[nt];
    ddg = clamp(4 - nf0 * 32, 0, 1);
    dda *= ddg;
    wta !== 0 ? wto_render(CH_WTO + nt * 8, nf0 * 1.004, CH_NA[nt] * wta, wf, CH_WT, 15, dst, n);
    dda !== 0 ? sso_render(CH_SSO + nt * 10, nf0, CH_HARM, CH_NA[nt] * dda, dst, n);
    nt += 1;
  );
  k = 0; loop(n, ob[k] += ab[k]; ab[k] *= 3; k += 1; );
);


// ---------------------------------------------------------------------- 15: speech

NS_PH = alloc(125 * 2);
NS_PULSE = alloc(8); NS_COL = alloc(5); NS_FLT = alloc(5 * 5);
function nsp(pi, ri, f0, a0_, f1, a1, f2, a2, f3, a3, f4, a4) local(b) (
  b = NS_PH + (pi * 5 + ri) * 10;
  b[0] = f0; b[1] = a0_; b[2] = f1; b[3] = a1; b[4] = f2; b[5] = a2; b[6] = f3; b[7] = a3; b[8] = f4; b[9] = a4;
);
nsp(0,0, 74,255, 83,114, 97,90, 98,90, 100,25); nsp(0,1, 75,255, 84,128, 100,114, 101,101, 103,20);
nsp(0,2, 76,255, 85,128, 100,18, 102,16, 104,3); nsp(0,3, 79,255, 85,161, 101,25, 104,4, 110,0);
nsp(0,4, 79,255, 85,128, 101,6, 106,25, 110,0);
nsp(1,0, 67,255, 91,64, 98,90, 101,64, 102,32); nsp(1,1, 67,255, 92,51, 99,64, 103,51, 105,25);
nsp(1,2, 69,255, 93,51, 100,32, 102,25, 103,25); nsp(1,3, 67,255, 91,16, 100,8, 103,4, 110,0);
nsp(1,4, 65,255, 95,25, 101,45, 105,2, 110,0);
nsp(2,0, 59,255, 92,8, 99,40, 102,20, 104,10); nsp(2,1, 61,255, 94,45, 101,32, 103,25, 105,8);
nsp(2,2, 60,255, 93,16, 101,16, 104,4, 105,4); nsp(2,3, 65,255, 92,25, 100,8, 105,4, 110,0);
nsp(2,4, 60,255, 96,64, 101,12, 106,12, 110,1);
nsp(3,0, 67,255, 78,72, 98,22, 99,25, 101,2); nsp(3,1, 67,255, 79,80, 99,64, 101,64, 102,12);
nsp(3,2, 68,255, 79,80, 100,12, 102,20, 103,5); nsp(3,3, 69,255, 79,90, 101,40, 104,10, 110,0);
nsp(3,4, 69,255, 79,72, 101,20, 106,20, 110,0);
nsp(4,0, 65,255, 74,25, 98,6, 100,10, 101,4); nsp(4,1, 65,255, 74,25, 100,36, 101,51, 103,12);
nsp(4,2, 66,255, 75,25, 100,18, 102,8, 104,5); nsp(4,3, 63,255, 77,64, 99,8, 104,2, 110,0);
nsp(4,4, 63,255, 77,40, 100,4, 106,2, 110,0);

function ns_init() local(i) (
  osc_init(NS_PULSE);
  ns_click = 0;
  i = 0; loop(5, svf_init(NS_FLT + i * 5); i += 1; );
  svf_init(NS_COL);
  svf_set(NS_COL, tan_dirty(800 / SR_K), 0.5);
);
function ns_render(click, frq, phon, vreg, exc, ob, n) local(k, p, r, pi, pf, ri, rf, i, b00, b01, b10, b11, fa, fb, f, aa, ab, a, flt) (
  click ? ns_click = floor(SR_K * 0.05);
  ns_click -= min(ns_click, n);
  ns_click ? frq *= 0.5;
  osc_render(NS_PULSE, 0, frq, 0.5, exc, n);
  k = 0; loop(n, exc[k] = svf_bpf(NS_COL, exc[k]); k += 1; );
  k = 0; loop(n, exc[k] *= 4; k += 1; );
  p = phon * (5 - 1.001);
  r = vreg * (5 - 1.001);
  pi = p | 0; pf = p - pi;
  ri = r | 0; rf = r - ri;
  memset(ob, 0, n);
  i = 0;
  loop(5,
    b00 = NS_PH + (pi * 5 + ri) * 10 + i * 2;
    b01 = NS_PH + (pi * 5 + ri + 1) * 10 + i * 2;
    b10 = NS_PH + ((pi + 1) * 5 + ri) * 10 + i * 2;
    b11 = NS_PH + ((pi + 1) * 5 + ri + 1) * 10 + i * 2;
    fa = b00[0] + (b01[0] - b00[0]) * rf;
    fb = b10[0] + (b11[0] - b10[0]) * rf;
    f = fa + (fb - fa) * pf;
    aa = b00[1] + (b01[1] - b00[1]) * rf;
    ab = b10[1] + (b11[1] - b10[1]) * rf;
    a = (aa + (ab - aa) * pf) / 256;
    f >= 160 ? f = 160;
    f = A0 * s2r(f - 33);
    (ns_click && i == 0) ? f *= 0.5;
    flt = NS_FLT + i * 5;
    svf_set(flt, tan_dirty(f), 20);
    k = 0; loop(n, ob[k] += a * svf_bpf(flt, exc[k]); k += 1; );
    i += 1;
  );
);

SAMT = alloc(18 * 6); SAM_AMP = alloc(16); SAM_FF = alloc(3); SAM_FA = alloc(3); SAM_FP = alloc(3);
function samp(i, f0, a0_, f1, a1, f2, a2) local(b) ( b = SAMT + i * 6; b[0] = f0; b[1] = a0_; b[2] = f1; b[3] = a1; b[4] = f2; b[5] = a2; );
samp(0, 60,15, 90,13, 200,1); samp(1, 40,13, 114,12, 139,6); samp(2, 33,14, 155,12, 209,7); samp(3, 22,13, 189,10, 247,8);
samp(4, 51,15, 99,12, 195,1); samp(5, 29,13, 65,8, 180,0); samp(6, 13,12, 103,3, 182,0); samp(7, 20,15, 114,3, 213,0);
samp(8, 13,7, 164,3, 222,14); samp(9, 13,9, 121,9, 254,0); samp(10, 40,12, 112,10, 114,5); samp(11, 24,13, 54,8, 157,0);
samp(12, 33,14, 155,12, 166,7); samp(13, 36,14, 83,8, 249,1); samp(14, 40,14, 114,12, 139,6); samp(15, 13,5, 58,5, 182,5);
samp(16, 13,7, 164,10, 222,14); samp(17, 13,7, 164,10, 222,14);
TP = SAM_AMP;
function tset(a, b, c, d, e, f, g, h) ( TP[0] = a; TP[1] = b; TP[2] = c; TP[3] = d; TP[4] = e; TP[5] = f; TP[6] = g; TP[7] = h; TP += 8; );
tset(0.03125, 0.03756299, 0.04515131, 0.05427259, 0.06523652, 0.07841532, 0.09425646, 0.11329776);
tset(0.1361857, 0.16369736, 0.19676682, 0.23651683, 0.28429697, 0.34172946, 0.41076422, 0.49374509);

function sam_init() ( sam_ph = 0; sam_f = 0; sam_pnx = 0; sam_plp = 0; memset(SAM_FP, 0, 3); sam_cs = 0; sam_ci = 0; );
function sam_render(cons, frq, vowel, fsh, exc, ob, n) local(r, phon, pi, pf, p1, p2, i, f, a1, a2, f_v, f_i, pnx, k, pts, fr, t, d, sv) (
  frq >= 0.0625 ? frq = 0.0625;
  cons ? (
    sam_cs = floor(SR_K * 0.05);
    r = ((vowel + 3 * frq + 7 * fsh) * 8) | 0;
    sam_ci = r % 8;
  );
  sam_cs -= min(sam_cs, n);
  phon = sam_cs ? (sam_ci + 9) : vowel * (9 - 1.0001);
  pi = phon | 0; pf = phon - pi;
  p1 = SAMT + pi * 6; p2 = SAMT + (pi + 1) * 6;
  fsh = 1 + fsh * 2.5;
  i = 0;
  loop(3,
    f = p1[i * 2] + (p2[i * 2] - p1[i * 2]) * pf;
    f *= 8 * fsh * 4294967296 / SR_K;
    SAM_FF[i] = floor(f);
    a1 = SAM_AMP[p1[i * 2 + 1]];
    a2 = SAM_AMP[p2[i * 2 + 1]];
    SAM_FA[i] = a1 + (a2 - a1) * pf;
    i += 1;
  );
  f_v = sam_f; f_i = (frq - f_v) / n;
  pnx = sam_pnx;
  k = 0;
  loop(n,
    pts = pnx;
    pnx = 0;
    f_v += f_i; fr = f_v;
    sam_ph += fr;
    sam_ph >= 1 ? (
      sam_ph -= 1;
      t = sam_ph / fr;
      SAM_FP[0] = floor(t * SAM_FF[0]);
      SAM_FP[1] = floor(t * SAM_FF[1]);
      SAM_FP[2] = floor(t * SAM_FF[2]);
      pts -= tb(t);
      pnx -= nb(t);
    ) : (
      SAM_FP[0] = u32(SAM_FP[0] + SAM_FF[0]);
      SAM_FP[1] = u32(SAM_FP[1] + SAM_FF[1]);
      SAM_FP[2] = u32(SAM_FP[2] + SAM_FF[2]);
    );
    pnx += sam_ph;
    d = pts - 0.5 - sam_plp;
    sam_plp += min(16 * fr, 1) * d;
    exc[k] = d;
    sv = 0;
    sv += sine_raw(SAM_FP[0]) * SAM_FA[0];
    sv += sine_raw(SAM_FP[1]) * SAM_FA[1];
    sv += sine_raw(SAM_FP[2]) * SAM_FA[2];
    sv *= (1 - sam_ph);
    ob[k] = sv;
    k += 1;
  );
  sam_f = f_v; sam_pnx = pnx;
);

LPCW = alloc(1024 * 12); LPCP = alloc(16 * 12); LPCB = alloc(40); LPK = alloc(10); LPS = alloc(11); LPE = alloc(11);
LPC_EN = alloc(16); LPC_PER = alloc(64); LPC_K = alloc(10 * 32);
function lset(p, a, b, c, d, e, f, g, h, i, j, k, l) ( p[0] = a; p[1] = b; p[2] = c; p[3] = d; p[4] = e; p[5] = f; p[6] = g; p[7] = h; p[8] = i; p[9] = j; p[10] = k; p[11] = l; );
lset(LPCP, 192, 80, -18368, 11584, 52, 29, 23, 14, -17, 79, 37, 4);
lset(LPCP + 12, 192, 80, -14528, 1536, 38, 29, 11, 14, -41, 79, 57, 4);
lset(LPCP + 24, 192, 80, 14528, 9216, 25, -54, -70, 36, 19, 79, 57, 22);
