function bs_rev(b) ( b = floor(b / 16) + (b & 15) * 16; b = floor((b & 204) / 4) + (b & 51) * 4; floor((b & 170) / 2) + (b & 85) * 2; );
function bs_get(nb_) local(sh, res) (
  sh = nb_;
  nb_ > bs_av ? (
    bs_bits = (bs_bits * 2 ^ bs_av) & 65535;
    sh -= bs_av;
    bs_bits |= bs_rev(bs_p[0]);
    bs_p += 1;
    bs_av += 8;
  );
  bs_bits = (bs_bits * 2 ^ sh) & 65535;
  res = floor(bs_bits / 256);
  bs_bits &= 255;
  bs_av -= nb_;
  res;
);
function wb_load_word(data) local(en, fr, rep, go, i) (
  bs_p = data; bs_av = 0; bs_bits = 0;
  memset(LPE, 0, 12);
  go = 1;
  while (go) (
    en = bs_get(4);
    en == 0 ? (
      LPE[0] = 0;
    ) : en == 15 ? (
      while (bs_av) ( bs_get(1); );
      go = 0;
    ) : (
      LPE[0] = LPC_EN[en];
      rep = bs_get(1);
      LPE[1] = LPC_PER[bs_get(6)];
      !rep ? (
        LPE[2] = LPC_K[bs_get(5)];
        LPE[3] = LPC_K[32 + bs_get(5)];
        LPE[4] = LPC_K[64 + bs_get(4)];
        LPE[5] = LPC_K[96 + bs_get(4)];
        LPE[1] ? (
          LPE[6] = LPC_K[128 + bs_get(4)];
          LPE[7] = LPC_K[160 + bs_get(4)];
          LPE[8] = LPC_K[192 + bs_get(4)];
          LPE[9] = LPC_K[224 + bs_get(3)];
          LPE[10] = LPC_K[256 + bs_get(3)];
          LPE[11] = LPC_K[288 + bs_get(3)];
        );
      );
    );
    go ? (
      i = 0; loop(12, LPCW[wb_nf * 12 + i] = LPE[i]; i += 1; );
      wb_nf += 1;
    );
  );
  bs_p - data;
);
function wb_reset() ( wb_loaded = -1; wb_nf = 0; wb_nw = 0; memset(LPCB, 0, 32); sp_wait = 1; sp_lastwb = -2; );
function wb_load(bank) local(data, size, used) (
  (bank == wb_loaded || bank >= 5) ? 0 : (
    wb_nf = 0;
    wb_nw = 0;
    data = TOFF[16 + bank];
    size = TLEN[16 + bank];
    while (size > 0) (
      LPCB[wb_nw] = wb_nf;
      used = wb_load_word(data);
      data += used;
      size -= used;
      wb_nw += 1;
    );
    LPCB[wb_nw] = wb_nf;
    wb_loaded = bank;
    1;
  );
);

function lpc_init() ( lpc_ph = 0; lpc_f = 0.0125; lpc_ne = 0; lpc_pe = 0; lpc_nx = 0; lpc_xi = 0; memset(LPK, 0, 10); memset(LPS, 0, 11); );
function lpc_frame(f1, f2, bl) local(fr1, fr2, e1, e2, i) (
  fr1 = f1[1] == 0 ? lpc_f : 1 / f1[1];
  fr2 = f2[1] == 0 ? lpc_f : 1 / f2[1];
  lpc_f = fr1 + (fr2 - fr1) * bl;
  e1 = f1[0] / 256; e2 = f2[0] / 256;
  lpc_ne = (f1[1] == 0 ? e1 : 0) + ((f2[1] == 0 ? e2 : 0) - (f1[1] == 0 ? e1 : 0)) * bl;
  lpc_pe = (f1[1] != 0 ? e1 : 0) + ((f2[1] != 0 ? e2 : 0) - (f1[1] != 0 ? e1 : 0)) * bl;
  LPK[0] = f1[2] / 32768 + (f2[2] / 32768 - f1[2] / 32768) * bl;
  LPK[1] = f1[3] / 32768 + (f2[3] / 32768 - f1[3] / 32768) * bl;
  i = 2;
  loop(8, LPK[i] = f1[i + 2] / 128 + (f2[i + 2] / 128 - f1[i + 2] / 128) * bl; i += 1; );
);
function lpc_play(frames, frame, interp_) local(fi, ff) (
  fi = frame | 0; ff = frame - fi;
  !interp_ ? ff = 0;
  lpc_frame(frames + fi * 12, frames + (fi + 1) * 12, ff);
);
function lpc_render(pros, psh) local(bf, d, f, ts, rt, rsm, dsc, sv, e10, i) (
  bf = 100 / 8000;
  d = lpc_f - bf;
  f = clamp((bf + d * pros) * psh, 0, 0.5);
  lpc_ph += f;
  ts = lpc_nx;
  lpc_nx = 0;
  lpc_ph >= 1 ? (
    lpc_ph -= 1;
    rt = lpc_ph / f;
    rsm = (32 * rt) | 0;
    dsc = 0;
    lpc_xi < 640 ? (
      lpc_xi -= rsm;
      dsc = T_LPCX[lpc_xi] / 128 * lpc_pe;
    );
    ts += -dsc * tb(rt);
    lpc_nx += -dsc * nb(rt);
    lpc_xi = rsm;
  );
  e10 = rsample() > 0 ? lpc_ne : -lpc_ne;
  lpc_xi < 640 ? (
    lpc_nx += T_LPCX[lpc_xi] / 128 * lpc_pe;
    lpc_xi += 32;
  );
  e10 += ts;
  e10 *= 1.5;
  LPE[10] = e10;
  i = 9;
  loop(10, LPE[i] = LPE[i + 1] - LPK[i] * LPS[i]; i -= 1; );
  LPE[0] = clamp(LPE[0], -2, 2);
  i = 9;
  loop(9, LPS[i] = LPS[i - 1] + LPK[i - 1] * LPE[i - 1]; i -= 1; );
  LPS[0] = LPE[0];
  lpc_out_e = LPE[10];
  lpc_out_o = LPE[0];
);

function lpcc_init() ( lpcc_cp = 0; lpcc_pf = -1; lpcc_lpf = -1; lpcc_rem = 0; lpcc_s0 = lpcc_s1 = lpcc_n0 = lpcc_n1 = 0; lpcc_g = 0; lpc_init(); );
function lpcc_render(free, trig, bank, frq, pros, speed, addr, fsh, gn, exc, ob, n) local(rr, rate, psh, tst, nf, frames, r, wd, g_v, g_i, k, t0, t1, rt, d0, d1, ga) (
  rr = s2r((fsh - 0.5) * 36);
  rate = rr / 6;
  psh = frq / (rr * 100 / SR_E);
  tst = s2r(-speed * 24 + (fsh < 0.4 ? (fsh - 0.4) * -45 : (fsh > 0.6 ? (fsh - 0.6) * -45 : 0)));
  bank != -1 ? (
    wb_load(bank) ? ( lpcc_pf = -1; lpcc_lpf = -1; );
  );
  nf = bank == -1 ? 5 : wb_nf;
  frames = bank == -1 ? LPCP : LPCW;
  trig ? (
    bank == -1 ? (
      r = ((addr + 3 * fsh + 7 * frq) * 8) | 0;
      lpcc_pf = r % 10;
      lpcc_pf += 5;
      lpcc_lpf = lpcc_pf + 1;
    ) : (
      wb_nw == 0 ? ( lpcc_pf = lpcc_lpf = -1; ) : (
        wd = (addr * wb_nw) | 0;
        wd >= wb_nw ? wd = wb_nw - 1;
        lpcc_pf = LPCB[wd];
        lpcc_lpf = LPCB[wd + 1] - 1;
      );
    );
    lpcc_rem = 0;
  );
  (lpcc_pf == -1 && lpcc_rem == 0) ? (
    lpc_play(frames, addr * (nf - 1.0001), 1);
  ) : (
    lpcc_rem == 0 ? (
      lpc_play(frames, lpcc_pf, 0);
      lpcc_rem = floor(SR_K / 40 * tst);
      lpcc_pf += 1;
      lpcc_pf >= lpcc_lpf ? lpcc_pf = (bank == -1 || free) ? -1 : lpcc_lpf;
    );
    lpcc_rem -= min(n, lpcc_rem);
  );
  g_v = lpcc_g; g_i = (gn - g_v) / n;
  k = 0;
  loop(n,
    t0 = lpcc_n0; t1 = lpcc_n1;
    lpcc_n0 = 0; lpcc_n1 = 0;
    lpcc_cp += rate;
    lpcc_cp >= 1 ? (
      lpcc_cp -= 1;
      rt = lpcc_cp / rate;
      lpc_render(pros, psh);
      d0 = lpc_out_e - lpcc_s0;
      d1 = lpc_out_o - lpcc_s1;
      t0 += d0 * tb(rt); lpcc_n0 += d0 * nb(rt);
      t1 += d1 * tb(rt); lpcc_n1 += d1 * nb(rt);
      lpcc_s0 = lpc_out_e; lpcc_s1 = lpc_out_o;
    );
    lpcc_n0 += lpcc_s0;
    lpcc_n1 += lpcc_s1;
    g_v += g_i;
    exc[k] = t0 * g_v;
    ob[k] = t1 * g_v;
    k += 1;
  );
  lpcc_g = g_v;
);

SP_HQ = alloc(5);
function sp_init() ( sam_init(); ns_init(); wb_reset(); lpcc_init(); hq_init(SP_HQ, 6, 0.1, 0); sp_prosody = 0; sp_speed = 0; sp_wait = 1; sp_lastwb = -2; );
function sp_render(ob, ab, n) local(f0, grp, bl, k, wb, rp) (
  f0 = note_freq(ep_note);
  grp = ep_harm * 6;
  grp <= 2 ? (
    ep_env = 0;
    bl = grp;
    grp <= 1 ? (
      ns_render(ep_trig == 1, f0, ep_morph, ep_timbre, ab, ob, n);
    ) : (
      lpcc_render(ep_trig & 2, ep_trig & 1, -1, f0, 0, 0, ep_morph, ep_timbre, 1, ab, ob, n);
      bl = 2 - bl;
    );
    sam_render(ep_trig == 1, f0, ep_morph, ep_timbre, TMP0, TMP1, n);
    bl *= bl * (3 - 2 * bl);
    bl *= bl * (3 - 2 * bl);
    k = 0;
    loop(n,
      ab[k] += (TMP0[k] - ab[k]) * bl;
      ob[k] += (TMP1[k] - ob[k]) * bl;
      k += 1;
    );
  ) : (
    wb = hq_proc(SP_HQ, 0, (grp - 2) * 0.275) - 1;
    rp = wb >= 0 && !(ep_trig & 2);
    ep_env = rp;
    lpcc_render(ep_trig & 2, ep_trig & 1, wb, f0, sp_prosody, sp_speed, ep_morph, ep_timbre, rp ? ep_accent : 1, ab, ob, n);
    wb != sp_lastwb ? ( sp_lastwb = wb; sp_wait = 1; );
    (ep_trig & 1) ? sp_wait = 0;
    (rp && sp_wait) ? ( memset(ob, 0, n); memset(ab, 0, n); );
  );
);


// ---------------------------------------------------------------------- shared: sine oscillator, fast sine, delay lines, fx engine

function cos_init(p, f) local(sg) (
  sg = 16; f -= 0.25;
  f < 0 ? f = -f : ( f > 0.5 ? f -= 0.5 : sg = -16; );
  p[2] = sg * f * (1 - 2 * f); p[3] = p[2] * 0.25; p[0] = p[3]; p[1] = 0.5;
);
function cos_next(p) local(tv) ( tv = p[1]; p[1] = p[2] * p[1] - p[0]; p[0] = tv; tv + 0.5; );
function sino_init(o) ( o[0] = 0; o[1] = 0; o[2] = 0; );
function sino_next(o, f) ( f >= 0.5 ? f = 0.5; o[0] += f; o[0] >= 1 ? o[0] -= 1; sine_nw(o[0]); );

function fso_init(o) ( o[0] = 1; o[1] = 0; o[2] = 0; o[3] = 0; );
function fso_add(o, frq, amp, ob, n) local(e_v, e_i, a_v, a_i, x, y, nrm, sc, fp, k, e) (
  frq >= 0.25 ? ( frq = 0.25; amp = 0; ) : amp *= 1 - frq * 4;
  fp = frq * $pi;
  e_v = o[2]; e_i = ((fp * (2 - (2 * 0.96 / 6) * fp * fp)) - e_v) / n;
  a_v = o[3]; a_i = (amp - a_v) / n;
  x = o[0]; y = o[1];
  nrm = x * x + y * y;
  (nrm <= 0.5 || nrm >= 2) ? ( sc = rsqrt_c(nrm); x *= sc; y *= sc; );
  k = 0;
  loop(n,
    e_v += e_i; e = e_v;
    x += e * y;
    y -= e * x;
    a_v += a_i;
    ob[k] += a_v * x;
    k += 1;
  );
  o[0] = x; o[1] = y; o[2] = e_v; o[3] = a_v;
);

function dl_read(b, n, wp, d) local(di, df, a) ( di = d | 0; df = d - di; a = b[(wp + di) % n]; a + (b[(wp + di + 1) % n] - a) * df; );
function dl_herm(b, n, wp, d) local(di, f, t, xm1, x0, x1, x2, c, v, w, a, bneg) (
  di = d | 0; f = d - di; t = wp + di + n;
  xm1 = b[(t - 1) % n]; x0 = b[t % n]; x1 = b[(t + 1) % n]; x2 = b[(t + 2) % n];
  c = (x1 - xm1) * 0.5; v = x0 - x1; w = c + v; a = w + v + (x2 - x0) * 0.5; bneg = w + a;
  (((a * f) - bneg) * f + c) * f + x0;
);

function fxc(v) local(q) ( q = (v * 4096) | 0; q > 32767 ? 32767 : q < -32768 ? -32768 : q; );
function fx_rd(off) ( fxb[(fxwp + off) & fxmask] / 4096; );
function fx_wr(off) ( fxb[(fxwp + off) & fxmask] = fxc(fxacc); );
function fx_ip(off) local(oi, of, a) (
  oi = off | 0; of = off - oi;
  a = fxb[(fxwp + oi) & fxmask] / 4096;
  a + (fxb[(fxwp + oi + 1) & fxmask] / 4096 - a) * of;
);
function ap_rw(base, len, g) local(rr) ( rr = fx_rd(base + len - 1); fxacc += rr * g; fx_wr(base); fxacc *= -g; fxacc += rr; );
function ap_iw(base, off, g) local(rr) ( rr = fx_ip(base + off); fxacc += rr * g; fx_wr(base); fxacc *= -g; fxacc += rr; );

// ---------------------------------------------------------------------- 16: swarm

SWV = alloc(8 * 24);
function sw_reset() local(i, b) (
  i = 0;
  loop(8,
    b = SWV + i * 24;
    b[0] = (i - 3) / 3;
    b[1] = 0; b[2] = 1; b[3] = 1; b[4] = 0; b[5] = 0.5; b[6] = 0; b[7] = 0;
    b[8] = 0; b[9] = 0; b[10] = 0.01; b[11] = 0;
    fso_init(b + 12);
    i += 1;
  );
);
function sw_step(b, rate, burst, start) local(rnd) (
  rnd = 0;
  start ? (
    b[3] = 0.5; b[4] = 16; rnd = 1;
  ) : (
    b[3] += rate * b[4];
    b[3] >= 1 ? ( b[3] -= b[3] | 0; rnd = 1; );
  );
  rnd ? (
    b[1] += b[2];
    b[2] = rfloat() - b[1];
    burst ? b[4] *= 0.8 + 0.2 * rfloat() : b[4] = 0.5 + 1.5 * rfloat();
  );
);
function sw_amp(b, sr) local(ta, ph, e) (
  ta = 1;
  sr >= 1 ? (
    ph = clamp((b[3] - 0.5) * sr, -1, 1);
    e = sine(0.5 * ph + 1.25);
    ta = 0.5 * (e + 1);
  );
  (sr >= 1 ? 1 : 0) != (b[6] >= 1 ? 1 : 0) ? b[7] = 0.5;
  b[7] *= 0.95;
  b[6] = sr;
  b[5] += (0.5 - b[7]) * (ta - b[5]);
  b[5];
);
function saw_add(b, frq, lev, ob, n) local(f_v, f_i, g_v, g_i, nx, ph, k, ts, f, t) (
  frq >= 0.25 ? frq = 0.25;
  f_v = b[10]; f_i = (frq - f_v) / n;
  g_v = b[11]; g_i = (lev - g_v) / n;
  nx = b[9]; ph = b[8];
  k = 0;
  loop(n,
    ts = nx; nx = 0;
    f_v += f_i; f = f_v;
    ph += f;
    ph >= 1 ? ( ph -= 1; t = ph / f; ts -= tb(t); nx -= nb(t); );
    nx += ph;
    g_v += g_i;
    ob[k] += (2 * ts - 1) * g_v;
    k += 1;
  );
  b[8] = ph; b[9] = nx; b[10] = f_v; b[11] = g_v;
);
function sw_render(ob, ab, n) local(f0, dens, spread, sr, burst, start, i, b, amp, ex, f, lin) (
  f0 = note_freq(ep_note);
  dens = note_freq(ep_timbre * 120) * 0.025 * n;
  spread = ep_harm * ep_harm * ep_harm;
  sr = 0.25 * s2r((1 - ep_morph) * 84);
  burst = !(ep_trig & 2);
  start = ep_trig & 1;
  memset(ob, 0, n); memset(ab, 0, n);
  i = 0;
  loop(8,
    b = SWV + i * 24;
    sw_step(b, dens, burst, start);
    amp = sw_amp(b, sr) * (1 / 8);
    ex = sr < 1 ? 2 * (b[1] + b[2] * b[3]) - 1 : b[1];
    f = f0 * s2r(48 * ex * spread * b[0]);
    lin = b[0] * (b[0] + 0.01) * spread * 0.25;
    f *= 1 + lin;
    saw_add(b, f, amp, ob, n);
    fso_add(b + 12, f, amp, ab, n);
    sr *= 0.97;
    i += 1;
  );
);

// ---------------------------------------------------------------------- 17: filtered noise

CN0 = alloc(4); CN1 = alloc(4); NZ_LH = alloc(5); NZ_B0 = alloc(5); NZ_B1 = alloc(5);
function cn_init(o) ( o[0] = 0; o[1] = 0; o[2] = 0; o[3] = 0.001; );
function cn_render(o, sync, frq, ob, n) local(f_v, f_i, nx, smp, k, ts, f, raw, ra, t, dsc) (
  frq = clamp(frq, 0, 1);
  f_v = o[3]; f_i = (frq - f_v) / n;
  nx = o[2]; smp = o[1];
  sync ? o[0] = 1;
  k = 0;
  loop(n,
    ts = nx; nx = 0;
    f_v += f_i; f = f_v;
    raw = rfloat() * 2 - 1;
    ra = clamp(4 * (f - 0.25), 0, 1);
    o[0] += f;
    o[0] >= 1 ? (
      o[0] -= 1;
      t = o[0] / f;
      dsc = raw - smp;
      ts += dsc * tb(t);
      nx += dsc * nb(t);
      smp = raw;
    );
    nx += smp;
    ob[k] = ts + ra * (raw - ts);
    k += 1;
  );
  o[2] = nx; o[1] = smp; o[3] = f_v;
);
function nz_init() ( cn_init(CN0); cn_init(CN1); svf_init(NZ_LH); svf_init(NZ_B0); svf_init(NZ_B1); nz_pf0 = nz_pf1 = nz_pq = nz_pm = 0; );
function nz_render(ob, ab, n) local(f0, f1, cl, cf, q, sync, a_v, a_i, b_v, b_i, q_v, q_i, m_v, m_i, k, gn, in1, in2, hg, bg, lg) (
  f0 = note_freq(ep_note);
  f1 = note_freq(ep_note + ep_harm * 48 - 24);
  cl = ep_trig & 2 ? 0 : -24;
  cf = note_freq(ep_timbre * (128 - cl) + cl);
  q = 0.5 * s2r(ep_morph * 120);
  sync = ep_trig & 1;
  cn_render(CN0, sync, cf, ab, n);
  cn_render(CN1, sync, cf * f1 / f0, TMP0, n);
  a_v = nz_pf0; a_i = (f0 - a_v) / n;
  b_v = nz_pf1; b_i = (f1 - b_v) / n;
  q_v = nz_pq; q_i = (q - q_v) / n;
  m_v = nz_pm; m_i = (ep_harm - m_v) / n;
  k = 0;
  loop(n,
    a_v += a_i; b_v += b_i; q_v += q_i; m_v += m_i;
    gn = 1 / sqrt((0.5 + q_v) * 40 * a_v);
    svf_set(NZ_LH, tan_acc(a_v), q_v);
    svf_set(NZ_B0, tan_acc(a_v), q_v);
    svf_set(NZ_B1, tan_acc(b_v), q_v);
    in1 = ab[k] * gn;
    in2 = TMP0[k] * gn;
    hg = min(-m_v * 2 + 1, 0);
    bg = 1 - 2 * abs(m_v - 0.5);
    lg = max(1 - m_v * 2, 0);
    svf_step(NZ_LH, in1);
    ob[k] = hg * svf_hp + bg * svf_bp + lg * svf_lp;
    ab[k] = svf_bpf(NZ_B0, in1) + svf_bpf(NZ_B1, in2);
    k += 1;
  );
  nz_pf0 = a_v; nz_pf1 = b_v; nz_pq = q_v; nz_pm = m_v;
);

// ---------------------------------------------------------------------- 18: particles

PT_P = alloc(6 * 6); PT_POST = alloc(5); PT_DIF = alloc(8192); PT_LFO = alloc(4);
PDL = alloc(7); PDB = alloc(7);
PDL[0] = 126; PDL[1] = 180; PDL[2] = 269; PDL[3] = 444; PDL[4] = 1653; PDL[5] = 2010; PDL[6] = 3411;
b = 0; i = 0; loop(7, PDB[i] = b; b += PDL[i] + 1; i += 1; );
function pt_init() local(i) (
  i = 0; loop(6, PT_P[i * 6] = 0; svf_init(PT_P + i * 6 + 1); i += 1; );
  svf_init(PT_POST);
  pt_wp = 0; pt_lpd = 0;
  cos_init(PT_LFO, 0.3 / 48000 * 32);
);
function pt_reset() ( memset(PT_DIF, 0, 8192); pt_wp = 0; );
function pt_particle(o, sync, dens, gn, frq, spread, q, ob, ab, n) local(u, can, k, sv, uu, f) (
  u = rfloat();
  sync ? u = dens;
  can = 1;
  k = 0;
  loop(n,
    sv = 0;
    u <= dens ? (
      sv = u * gn;
      can ? (
        uu = 2 * rfloat() - 1;
        f = min(s2r(spread * uu) * frq, 0.25);
        o[0] = 0.5 / sqrt(q * f * sqrt(dens));
        svf_set(o + 1, tan_dirty(f), q);
        can = 0;
      );
    );
    ab[k] += sv;
    ob[k] += svf_bpf(o + 1, o[0] * sv);
    u = rfloat();
    k += 1;
  );
);
function pt_render(ob, ab, n) local(f0, ds, dens, gn, qs, q, spread, rds, rd, dif, sync, i, k, amt, rt, kap, lp1, wet) (
  f0 = note_freq(ep_note);
  ds = note_freq(60 + ep_timbre * ep_timbre * 72);
  dens = ds * ds * (1 / 6);
  gn = 1 / dens;
  qs = s2r(ep_morph >= 0.5 ? (ep_morph - 0.5) * 120 : 0);
  q = 0.5 + qs * qs;
  spread = 48 * ep_harm * ep_harm;
  rds = 2 * abs(ep_morph - 0.5);
  rd = rds * rds;
  dif = ep_morph < 0.5 ? rd : 0;
  sync = ep_trig & 1;
  memset(ob, 0, n); memset(ab, 0, n);
  i = 0; loop(6, pt_particle(PT_P + i * 6, sync, dens, gn, f0, spread, q, ob, ab, n); i += 1; );
  svf_set(PT_POST, tan_dirty(min(f0, 0.49)), 0.5);
  k = 0; loop(n, ob[k] = svf_lpf(PT_POST, ob[k]); k += 1; );
  amt = 0.8 * dif * dif;
  rt = 0.5 * dif + 0.25;
  kap = 0.625;
  fxb = PT_DIF; fxmask = 8191;
  k = 0;
  loop(n,
    pt_wp -= 1; pt_wp < 0 ? pt_wp += 8192;
    fxwp = pt_wp;
    (fxwp & 31) == 0 ? pt_l1 = cos_next(PT_LFO) : pt_l1 = PT_LFO[0] + 0.5;
    fxacc = 0;
    fxacc += ob[k];
    ap_rw(PDB[0], PDL[0], kap);
    ap_rw(PDB[1], PDL[1], kap);
    ap_rw(PDB[2], PDL[2], kap);
    ap_iw(PDB[3], 400 + 43 * pt_l1, kap);
    fxacc += fx_ip(PDB[6] + 3070 + 340 * pt_l1) * rt;
    pt_lpd += 0.75 * (fxacc - pt_lpd);
    fxacc = pt_lpd;
    ap_rw(PDB[4], PDL[4], -kap);
    ap_rw(PDB[5], PDL[5], kap);
    fx_wr(PDB[6]);
    fxacc *= 2;
    wet = fxacc;
    ob[k] += amt * (wet - ob[k]);
    k += 1;
  );
);

// ---------------------------------------------------------------------- 19: string

STV_B = alloc(3 * 32); STL = alloc(3 * 1024); STS = alloc(3 * 256); STF0 = alloc(3); STFD = alloc(16);
function str_reset_s(i) local(b) (
  b = STV_B + i * 32;
  memset(STL + i * 1024, 0, 1024); memset(STS + i * 256, 0, 256);
  b[2] = 0; b[3] = 0;
  svf_init(b + 4);
  b[9] = 0; b[10] = 0; b[11] = 1 - 20 / SR_K;
  b[12] = 0; b[13] = 0;
  b[14] = 0; b[15] = 0; b[16] = 0;
);
function str_init() local(i, b) (
  i = 0;
  loop(3,
    b = STV_B + i * 32;
    svf_init(b + 17);
    b[22] = 0;
    b[1] = 100;
    str_reset_s(i);
    STF0[i] = 0.01;
    i += 1;
  );
  str_active = 2;
  memset(STFD, 0, 16); str_fdw = 0;
);
function str_reset() local(i) ( memset(STFD, 0, 16); str_fdw = 0; i = 0; loop(3, str_reset_s(i); i += 1; ); );
function str_process(i, f0, nla, br, dmp, ib, ob, n) local(b, ln, sl, disp, dly, srcr, dcut, dfreq, ti, dcomp, d_v, d_i, stp, scor, nas, namt, nfl, bcur, apg, k, dl, sv, noise, apd, mdel, rd, y, val, sg, ox, wp, wp2) (
  b = STV_B + i * 32; ln = STL + i * 1024; sl = STS + i * 256;
  disp = nla > 0;
  nla = abs(nla);
  dly = clamp(1 / f0, 4, 1024 - 4);
  srcr = dly * f0;
  srcr >= 0.9999 ? ( b[14] = 1; srcr = 1; );
  dcut = min(12 + dmp * dmp * 60 + br * 24, 84);
  dfreq = min(f0 * s2r(dcut), 0.499);
  dmp >= 0.95 ? (
    ti = 20 * (dmp - 0.95);
    br += ti * (1 - br);
    dfreq += ti * (0.4999 - dfreq);
    dcut += ti * (128 - dcut);
  );
  svf_set(b + 4, tan_fast(dfreq), 0.5);
  dcomp = interp(T_SVFS, dcut, 1);
  d_v = b[1]; d_i = (dly * dcomp - d_v) / n;
  stp = nla * (2 - nla) * 0.225;
  scor = clamp((160 / SR_K) * dly, 1, 2.1);
  nas = nla > 0.75 ? 4 * (nla - 0.75) : 0;
  namt = nas * nas * 0.1;
  nfl = 0.06 + 0.94 * br * br;
  bcur = nla * nla * 0.01;
  apg = -0.618 * nla / (0.15 + abs(nla));
  wp = b[2]; wp2 = b[3];
  k = 0;
  loop(n,
    b[14] += srcr;
    b[14] > 1 ? (
      b[14] -= 1;
      d_v += d_i;
      dl = d_v;
      sv = 0;
      disp ? (
        noise = rfloat() - 0.5;
        b[12] += nfl * (noise - b[12]);
        dl *= 1 + b[12] * namt;
        apd = dl * stp;
        mdel = dl - apd * (0.408 - stp * 0.308) * scor;
        (apd >= 4 && mdel >= 4) ? (
          sv = dl_read(ln, 1024, wp, mdel);
          rd = sl[(wp2 + (apd | 0)) % 256];
          y = sv + apg * rd;
          sl[wp2] = y;
          wp2 = (wp2 + 255) % 256;
          sv = -y * apg + rd;
        ) : sv = dl_herm(ln, 1024, wp, dl);
      ) : (
        dl *= 1 - b[13] * bcur;
        sv = dl_herm(ln, 1024, wp, dl);
        val = abs(sv) - 0.025;
        sg = sv > 0 ? 1 : -1.5;
        b[13] = (abs(val) + val) * sg;
      );
      sv += ib[k];
      sv = clamp(sv, -20, 20);
      ox = b[9];
      b[9] = sv;
      sv = b[10] = b[10] * b[11] + sv - ox;
      sv = svf_lpf(b + 4, sv);
      ln[wp] = sv;
      wp = (wp + 1023) % 1024;
      b[16] = b[15];
      b[15] = sv;
    );
    ob[k] += b[16] + (b[15] - b[16]) * b[14];
    k += 1;
  );
  b[1] = d_v; b[2] = wp; b[3] = wp2;
);
function dust(f) local(u) ( u = rfloat(); u < f ? u * (1 / f) : 0; );
function sv_render(i, sus, trig, acc, f0, struc, br, dmp, tmp, ob, ab, n) local(b, dens, rng_, f, cut, q, df, ns, tl, k, nl) (
  b = STV_B + i * 32;
  dens = br * br;
  br += 0.25 * acc * (1 - br);
  dmp += 0.25 * acc * (1 - dmp);
  (trig || sus) ? (
    rng_ = 72;
    f = 4 * f0;
    cut = min(f * s2r((br * (2 - br) - 0.5) * rng_), 0.499);
    q = sus ? 1 : 0.5;
    b[22] = floor(1 / f0);
    svf_set(b + 17, tan_dirty(cut), q);
  );
  sus ? (
    df = 0.00005 + 0.99995 * dens * dens;
    k = 0; loop(n, tmp[k] = dust(df) * (8 - df * 6) * acc; k += 1; );
  ) : b[22] ? (
    ns = min(b[22], n);
    b[22] -= ns;
    tl = n - ns;
    k = 0;
    loop(ns, tmp[k] = 2 * rfloat() - 1; k += 1; );
    loop(tl, tmp[k] = 0; k += 1; );
  ) : memset(tmp, 0, n);
  k = 0; loop(n, tmp[k] = svf_lpf(b + 17, tmp[k]); k += 1; );
  k = 0; loop(n, ab[k] += tmp[k]; k += 1; );
  nl = struc < 0.24 ? (struc - 0.24) * 4.166 : (struc > 0.26 ? (struc - 0.26) * 1.35135 : 0);
  str_process(i, f0, nl, br, dmp, tmp, ob, n);
);
function st_render(ob, ab, n) local(f0, i) (
  (ep_trig & 1) ? (
    STF0[str_active] = STFD[(str_fdw + 14) % 16];
    str_active = (str_active + 1) % 3;
  );
  f0 = note_freq(ep_note);
  STF0[str_active] = f0;
  STFD[str_fdw] = f0; str_fdw = (str_fdw + 15) % 16;
  memset(ob, 0, n); memset(ab, 0, n);
  i = 0;
  loop(3,
    sv_render(i, (ep_trig & 2) && i == str_active, (ep_trig & 1) && i == str_active, ep_accent, STF0[i], ep_harm, ep_timbre * ep_timbre, ep_morph, TMP0, ob, ab, n);
    i += 1;
  );
);

// ---------------------------------------------------------------------- 20: modal

MD_EX = alloc(3); MD_AMP = alloc(24); MD_ST = alloc(24 * 2); MD_F = alloc(4); MD_Q = alloc(4); MD_A = alloc(4); MD_G = alloc(4); MD_R = alloc(4); MD_H = alloc(4); MD_RG = alloc(4);
function md_reset() local(i) (
  MD_EX[0] = 0; MD_EX[1] = 0;
  cos_init(TMP3, 0.015);
  i = 0; loop(24, MD_AMP[i] = cos_next(TMP3) * 0.25; i += 1; );
  memset(MD_ST, 0, 48);
);
function md_init() ( md_hlp = 0; md_reset(); );
function rsvf_batch(st, nb_, mode_lp, add, ib, ob, n) local(i, k, s_in, s_out, hpv, bpv, lpv) (
  i = 0;
  loop(nb_,
    MD_G[i] = tan_fast(MD_F[i]);
    MD_R[i] = 1 / MD_Q[i];
    MD_H[i] = 1 / (1 + MD_R[i] * MD_G[i] + MD_G[i] * MD_G[i]);
    MD_RG[i] = MD_R[i] + MD_G[i];
    i += 1;
  );
  k = 0;
  loop(n,
    s_in = ib[k];
    s_out = 0;
    i = 0;
    loop(nb_,
      hpv = (s_in - MD_RG[i] * st[i * 2] - st[i * 2 + 1]) * MD_H[i];
      bpv = MD_G[i] * hpv + st[i * 2];
      st[i * 2] = MD_G[i] * hpv + bpv;
      lpv = MD_G[i] * bpv + st[i * 2 + 1];
      st[i * 2 + 1] = MD_G[i] * bpv + lpv;
      s_out += MD_A[i] * (mode_lp ? lpv : bpv);
      i += 1;
    );
    add ? ob[k] += s_out : ob[k] = s_out;
    k += 1;
  );
);
function md_render(ob, ab, n) local(sus, trig, acc, f0, struc, br, dmp, dens, rng_, f, cut, q, df, k, att, amp, stiff, sf, j, harm, qs, ql, bc, i, mf, ma) (
  memset(ob, 0, n); memset(ab, 0, n);
  md_hlp += 0.01 * (ep_harm - md_hlp);
  sus = ep_trig & 2; trig = ep_trig & 1; acc = ep_accent;
  f0 = note_freq(ep_note); struc = md_hlp; br = ep_timbre; dmp = ep_morph;
  dens = br * br;
  br += 0.25 * acc * (1 - br);
  dmp += 0.25 * acc * (1 - dmp);
  rng_ = sus ? 36 : 60;
  f = sus ? 4 * f0 : 2 * f0;
  cut = min(f * s2r((br * (2 - br) - 0.5) * rng_), 0.499);
  q = sus ? 0.7 : 1.5;
  sus ? (
    df = 0.00005 + 0.99995 * dens * dens;
    k = 0; loop(n, TMP0[k] = dust(df) * (4 - df * 3) * acc; k += 1; );
  ) : (
    memset(TMP0, 0, n);
    trig ? (
      att = 1 - dmp * 0.5;
      amp = (0.12 + 0.08 * acc) * att;
      TMP0[0] = amp * s2r(cut * cut * 24) / cut;
    );
  );
  MD_F[0] = cut; MD_Q[0] = q; MD_A[0] = 1;
  rsvf_batch(MD_EX, 1, 1, 0, TMP0, TMP0, n);
  k = 0; loop(n, ab[k] += TMP0[k]; k += 1; );
  stiff = interp(T_STIFF, struc, 64);
  sf = 1; j = 0;
  loop(2, sf += stiff; stiff < 0 ? stiff *= 0.93 : stiff *= 0.98; j += 1; );
  stiff = interp(T_STIFF, struc, 64);
  f0 *= 1 / sf;
  harm = f0;
  sf = 1;
  qs = s2r(dmp * 79.7);
  q = 500 * qs * qs;
  br *= 1 - struc * 0.3;
  br *= 1 - dmp * 0.3;
  ql = br * (2 - br) * 0.85 + 0.15;
  bc = 0;
  i = 0;
  loop(24,
    mf = harm * sf;
    mf >= 0.499 ? mf = 0.499;
    ma = 1 - mf * 2;
    MD_F[bc] = mf;
    MD_Q[bc] = 1 + mf * q;
    MD_A[bc] = MD_AMP[i] * ma;
    bc += 1;
    bc == 4 ? (
      bc = 0;
      rsvf_batch(MD_ST + (i - 3) * 2, 4, 0, 1, TMP0, ob, n);
    );
    sf += stiff;
    stiff < 0 ? stiff *= 0.93 : stiff *= 0.98;
    harm += f0;
    q *= ql;
    i += 1;
  );
);

// ---------------------------------------------------------------------- 21: bass drum

ABD_R = alloc(5); ABD_O = alloc(3);
function abd_init() ( abd_prs = 0; abd_fprs = 0; abd_pl = 0; abd_ph = 0; abd_plp = 0; abd_fplp = 0; abd_rp = 0; abd_lpo = 0; abd_tlp = 0; abd_sg = 0; svf_init(ABD_R); sino_init(ABD_O); );
function diode(x) ( x >= 0 ? x : ( x *= 2; 0.7 * x / (1 + abs(x)); ); );
function abd_render(sus, trig, acc, f0, tone, dec, afm, sfm, ob, n) local(sc, q, tf, leak, g_v, g_i, k, pls, fmp, punch, f, ro) (
  sc = 0.001 / f0;
  q = 1500 * s2r(dec * 80);
  tf = min(4 * f0 * s2r(tone * 108), 1);
  leak = 0.08 * (tone + 0.25);
  trig ? ( abd_prs = 48; abd_fprs = 288; abd_ph = 3 + 7 * acc; abd_lpo = 0; );
  g_v = abd_sg; g_i = (acc * dec - g_v) / n;
  k = 0;
  loop(n,
    pls = 0;
    abd_prs ? (
      abd_prs -= 1;
      pls = abd_prs ? abd_ph : abd_ph - 1;
      abd_pl = pls;
    ) : (
      abd_pl *= 1 - 1 / 9.6;
      pls = abd_pl;
    );
    sus ? pls = 0;
    abd_plp += (1 / 4.8) * (pls - abd_plp);
    pls = diode((pls - abd_plp) + pls * 0.044);
    fmp = 0;
    abd_fprs ? (
      abd_fprs -= 1;
      fmp = 1;
      abd_rp = abd_fprs ? 0 : -0.8;
    ) : (
      abd_rp *= 1 - 1 / 2400;
    );
    sus ? fmp = 0;
    abd_fplp += (1 / 4.8) * (fmp - abd_fplp);
    punch = 0.7 + diode(10 * abd_lpo - 1);
    f = clamp(f0 * (1 + abd_fplp * 1.7 * afm + punch * 0.08 * sfm), 0, 0.4);
    sus ? (
      g_v += g_i;
      f >= 0.5 ? f = 0.5;
      ABD_O[0] += f; ABD_O[0] >= 1 ? ABD_O[0] -= 1;
      ro = g_v * sine_nw(ABD_O[0]);
      abd_lpo = g_v * sine_nw(ABD_O[0] + 0.25);
    ) : (
      svf_set(ABD_R, tan_dirty(f), 1 + q * f);
      svf_step(ABD_R, (pls - abd_rp * 0.2) * sc);
      ro = svf_bp;
      abd_lpo = svf_lp;
    );
    abd_tlp += tf * (pls * leak + ro - abd_tlp);
    ob[k] = abd_tlp;
    k += 1;
  );
  abd_sg = g_v;
);
function od_process(drv, ob, n) local(d2, pa, pb, pre, dsq, post, p_v, p_i, q_v, q_i, k) (
  d2 = drv * drv;
  pa = drv * 0.5;
  pb = d2 * d2 * drv * 24;
  pre = pa + (pb - pa) * d2;
  dsq = drv * (2 - drv);
  post = 1 / soft_clip(0.33 + dsq * (pre - 0.33));
  p_v = od_pre; p_i = (pre - p_v) / n;
  q_v = od_post; q_i = (post - q_v) / n;
  k = 0;
  loop(n, p_v += p_i; q_v += q_i; ob[k] = soft_clip(p_v * ob[k]) * q_v; k += 1; );
  od_pre = p_v; od_post = q_v;
);
SBD_CF = alloc(5);
function sbd_init() (
  sbd_ph = 0; sbd_pn = 0; sbd_f0 = 0; sbd_fm = 0; sbd_fmlp = 0; sbd_belp = 0; sbd_be = 0; sbd_bepw = 0; sbd_fmpw = 0; sbd_tlp = 0; sbd_sg = 0;
  sbd_te = 0; sbd_telp = 0;
  sbd_clp = 0; sbd_chp = 0; svf_init(SBD_CF); svf_set(SBD_CF, tan_fast(5000 / SR_K), 2);
  sbd_nlp = 0; sbd_nhp = 0;
);
function sbd_dsine(ph, pn, dirt) local(pi, tri, sn, cs) (
  ph += pn * dirt;
  pi = ph | 0;
  ph = ph - pi;
  tri = (ph < 0.5 ? ph : 1 - ph) * 4 - 1;
  sn = 2 * tri / (1 + abs(tri));
  cs = sine(ph + 0.75);
  sn + (1 - dirt) * (cs - sn);
);
function tvca(sv, gn) ( sv = (sv - 0.6) * gn; 3 * sv / (2 + abs(sv)) + gn * 0.3; );
function sbd_render(sus, trig, acc, f0, tone, dec, dirt, fmea, fmed, ob, n) local(f_v, f_i, fmd, bed, ted, tf, tl, g_v, g_i, k, mix, fm, body, tr, err, sm) (
  dec *= dec;
  fmed *= fmed;
  f_v = sbd_f0; f_i = (f0 - f_v) / n;
  dirt *= max(1 - 8 * f0, 0);
  fmd = 1 - 1 / (0.008 * (1 + fmed * 4) * SR_K);
  bed = 1 - 1 / (0.02 * SR_K) * s2r(-dec * 60);
  ted = 1 - 1 / (0.005 * SR_K);
  tf = min(4 * f0 * s2r(tone * 108), 1);
  tl = tone;
  trig ? (
    sbd_fm = 1;
    sbd_be = sbd_te = 0.3 + 0.7 * acc;
    sbd_bepw = 48;
    sbd_fmpw = 62;
  );
  g_v = sbd_sg; g_i = (acc * dec - g_v) / n;
  k = 0;
  loop(n,
    sbd_pn += 0.002 * ((rfloat() - 0.5) - sbd_pn);
    mix = 0;
    sus ? (
      f_v += f_i;
      sbd_ph += f_v;
      sbd_ph >= 1 ? sbd_ph -= 1;
      body = sbd_dsine(sbd_ph, sbd_pn, dirt);
      g_v += g_i;
      mix -= tvca(body, g_v);
    ) : (
      sbd_fmpw ? (
        sbd_fmpw -= 1;
        sbd_ph = 0.25;
      ) : (
        sbd_fm *= fmd;
        fm = 1 + fmea * 3.5 * sbd_fmlp;
        f_v += f_i;
        sbd_ph += min(f_v * fm, 0.5);
        sbd_ph >= 1 ? sbd_ph -= 1;
      );
      sbd_bepw ? (
        sbd_bepw -= 1;
      ) : (
        sbd_be *= bed;
        sbd_te *= ted;
      );
      sbd_belp += 0.1 * (sbd_be - sbd_belp);
      sbd_telp += 0.1 * (sbd_te - sbd_telp);
      sbd_fmlp += 0.1 * (sbd_fm - sbd_fmlp);
      body = sbd_dsine(sbd_ph, sbd_pn, dirt);
      sm = sbd_bepw ? 0 : 1;
      err = sm - sbd_clp;
      sbd_clp += (err > 0 ? 0.5 : 0.1) * err;
      sbd_chp += 0.04 * (sbd_clp - sbd_chp);
      tr = svf_lpf(SBD_CF, sbd_clp - sbd_chp);
      sm = rfloat();
      sbd_nlp += 0.05 * (sm - sbd_nlp);
      sbd_nhp += 0.005 * (sbd_nlp - sbd_nhp);
      tr += sbd_nlp - sbd_nhp;
      mix -= tvca(body, sbd_belp);
      mix -= tr * sbd_telp * tl;
    );
    sbd_tlp += tf * (mix - sbd_tlp);
    ob[k] = sbd_tlp;
    k += 1;
  );
  sbd_f0 = f_v; sbd_sg = g_v;
);
function bd_init() ( abd_init(); sbd_init(); od_pre = 0; od_post = 0; );
function bd_render(ob, ab, n) local(f0, afm, sfm, drv, sus) (
  f0 = note_freq(ep_note);
  afm = min(ep_harm * 4, 1);
  sfm = max(min(ep_harm * 4 - 1, 1), 0);
  drv = max(ep_harm * 2 - 1, 0) * max(1 - 16 * f0, 0);
  sus = ep_trig & 2;
  abd_render(sus, ep_trig & 1, ep_accent, f0, ep_timbre, ep_morph, afm, sfm, ob, n);
  od_process(0.5 + 0.5 * drv, ob, n);
  sbd_render(sus, ep_trig & 1, ep_accent, f0, ep_timbre, ep_morph, sus ? ep_harm : 0.4 - 0.25 * ep_morph * ep_morph,
    min(ep_harm * 2, 1), max(ep_harm * 2 - 1, 0), ab, n);
);

// ---------------------------------------------------------------------- 22: snare drum

ASD_R = alloc(5 * 5); ASD_O = alloc(5 * 3); ASD_N = alloc(5); ASD_F = alloc(5); ASD_G = alloc(5); ASD_MF = alloc(5);
ASD_MF[0] = 1; ASD_MF[1] = 2; ASD_MF[2] = 3.18; ASD_MF[3] = 4.16; ASD_MF[4] = 5.62;
function asd_init() local(i) (
  asd_prs = 0; asd_pl = 0; asd_ph = 0; asd_plp = 0; asd_ne = 0; asd_sg = 0;
  i = 0; loop(5, svf_init(ASD_R + i * 5); sino_init(ASD_O + i * 3); i += 1; );
  svf_init(ASD_N);
);
function asd_render(sus, trig, acc, f0, tone, dec, snap, ob, n) local(dxt, q, ned, leak, i, fn, g_v, g_i, k, pls, sgv, shell, ex, nz) (
  dxt = dec * (1 + dec * (dec - 1));
  q = 2000 * s2r(dxt * 84);
  ned = 1 - 0.0017 * s2r(-dec * (50 + snap * 10));
  leak = snap * (2 - snap) * 0.1;
  snap = clamp(snap * 1.1 - 0.05, 0, 1);
  trig ? ( asd_prs = 48; asd_ph = 3 + 7 * acc; asd_ne = 2; );
  i = 0;
  loop(5,
    ASD_F[i] = min(f0 * ASD_MF[i], 0.499);
    svf_set(ASD_R + i * 5, tan_fast(ASD_F[i]), 1 + ASD_F[i] * (i == 0 ? q : q * 0.25));
    i += 1;
  );
  tone < 0.666667 ? (
    tone *= 1.5;
    ASD_G[0] = 1.5 + (1 - tone) * (1 - tone) * 4.5;
    ASD_G[1] = 2 * tone + 0.15;
    ASD_G[2] = ASD_G[3] = ASD_G[4] = 0;
  ) : (
    tone = (tone - 0.666667) * 3;
    ASD_G[0] = 1.5 - tone * 0.5;
    ASD_G[1] = 2.15 - tone * 0.7;
    i = 2; loop(3, ASD_G[i] = tone; tone *= tone; i += 1; );
  );
  fn = clamp(f0 * 16, 0, 0.499);
  svf_set(ASD_N, tan_fast(fn), 1 + fn * 1.5);
  g_v = asd_sg; g_i = (acc * dec - g_v) / n;
  k = 0;
  loop(n,
    pls = 0;
    asd_prs ? (
      asd_prs -= 1;
      pls = asd_prs ? asd_ph : asd_ph - 1;
      asd_pl = pls;
    ) : (
      asd_pl *= 1 - 1 / 4.8;
      pls = asd_pl;
    );
    g_v += g_i; sgv = g_v;
    asd_plp += 0.75 * (pls - asd_plp);
    shell = 0;
    i = 0;
    loop(5,
      ex = i == 0 ? (pls - asd_plp) + 0.006 * pls : 0.026 * pls;
      shell += ASD_G[i] * (sus ? sino_next(ASD_O + i * 3, ASD_F[i]) * sgv * 0.25 : svf_bpf(ASD_R + i * 5, ex) + ex * leak);
      i += 1;
    );
    shell = soft_clip(shell);
    nz = 2 * rfloat() - 1;
    nz < 0 ? nz = 0;
    asd_ne *= ned;
    nz *= (sus ? sgv : asd_ne) * snap * 2;
    nz = svf_bpf(ASD_N, nz);
    ob[k] = nz + shell * (1 - snap);
    k += 1;
  );
  asd_sg = g_v;
);
SSD_DL = alloc(3); SSD_HP = alloc(3); SSD_LP = alloc(5);
function ssd_init() ( ssd_p0 = ssd_p1 = 0; ssd_da = 0; ssd_sa = 0; ssd_fm = 0; ssd_hold = 0; ssd_sg = 0; op_init(SSD_DL); op_init(SSD_HP); svf_init(SSD_LP); );
function ssd_dsine(ph) local(tri) ( tri = (ph < 0.5 ? ph : 1 - ph) * 4 - 1.3; 2 * tri / (1 + abs(tri)); );
function ssd_render(sus, trig, acc, f0, fma, dec, snap, ob, n) local(dxt, dd, sd, fd, dl, sl, g_v, g_i, rem, rn, rna, f, drum, nz, sn) (
  dxt = dec * (1 + dec * (dec - 1));
  fma *= fma;
  dd = 1 - 1 / (0.015 * SR_K) * s2r(-dxt * 72 - fma * 12 + snap * 7);
  sd = 1 - 1 / (0.01 * SR_K) * s2r(-dec * 60 - snap * 7);
  fd = 1 - 1 / (0.007 * SR_K);
  snap = clamp(snap * 1.1 - 0.05, 0, 1);
  dl = sqrt(1 - snap);
  sl = sqrt(snap);
  op_set(SSD_HP, tan_fast(min(10 * f0, 0.5)));
  svf_set(SSD_LP, tan_fast(min(35 * f0, 0.5)), 0.5 + 2 * snap);
  op_set(SSD_DL, tan_fast(3 * f0));
  trig ? (
    ssd_sa = ssd_da = 0.3 + 0.7 * acc;
    ssd_fm = 1;
    ssd_p0 = ssd_p1 = 0;
    ssd_hold = ((0.04 + dec * 0.03) * SR_K) | 0;
  );
  g_v = ssd_sg; g_i = (acc * dec - g_v) / n;
  rem = n;
  loop(n,
    rem -= 1;
    sus ? (
      g_v += g_i;
      ssd_sa = g_v;
      ssd_da = ssd_sa;
      ssd_fm = 0;
    ) : (
      ssd_da *= (ssd_da > 0.03 || !(rem & 1)) ? dd : 1;
      ssd_hold ? ssd_hold -= 1 : ssd_sa *= sd;
      ssd_fm *= fd;
    );
    rn = 0;
    rna = clamp((0.125 - f0) * 8, 0, 1);
    rna *= rna;
    rna *= fma;
    rn += ssd_p0 > 0.5 ? -1 : 1;
    rn += ssd_p1 > 0.5 ? -1 : 1;
    rn *= rna * 0.025;
    f = f0 * (1 + fma * (4 * ssd_fm));
    ssd_p0 += f;
    ssd_p1 += f * 1.47;
    rna > 0.1 ? (
      ssd_p0 >= 1 + rn ? ssd_p0 = 1 - ssd_p0;
      ssd_p1 >= 1 + rn ? ssd_p1 = 1 - ssd_p1;
    ) : (
      ssd_p0 >= 1 ? ssd_p0 -= 1;
      ssd_p1 >= 1 ? ssd_p1 -= 1;
    );
    drum = -0.1;
    drum += ssd_dsine(ssd_p0) * 0.6;
    drum += ssd_dsine(ssd_p1) * 0.25;
    drum *= ssd_da * dl;
    drum = op_lpf(SSD_DL, drum);
    nz = rfloat();
    sn = svf_lpf(SSD_LP, nz);
    sn = op_hpf(SSD_HP, sn);
    sn = (sn + 0.1) * (ssd_sa + ssd_fm) * sl;
    ob[n - 1 - rem] = sn + drum;
  );
  ssd_sg = g_v;
);
function sd_init() ( asd_init(); ssd_init(); );
function sd_render(ob, ab, n) local(f0) (
  f0 = note_freq(ep_note);
  asd_render(ep_trig & 2, ep_trig & 1, ep_accent, f0, ep_timbre, ep_morph, ep_harm, ob, n);
  ssd_render(ep_trig & 2, ep_trig & 1, ep_accent, f0, ep_timbre, ep_morph, ep_harm, ab, n);
);

// ---------------------------------------------------------------------- 23: hi-hat

HH_SQ = alloc(6); HH_RM = alloc(6 * 8); HH_R = alloc(6); HH_C1 = alloc(5); HH_H1 = alloc(5); HH_C2 = alloc(5); HH_H2 = alloc(5); HH_ST = alloc(8);
HH_R[0] = 1; HH_R[1] = 1.304; HH_R[2] = 1.466; HH_R[3] = 1.787; HH_R[4] = 1.932; HH_R[5] = 2.536;
function hh_init() local(i) (
  memset(HH_SQ, 0, 6);
  i = 0; loop(6, osc_init(HH_RM + i * 8); i += 1; );
  svf_init(HH_C1); svf_init(HH_H1); svf_init(HH_C2); svf_init(HH_H2);
  memset(HH_ST, 0, 8);
);
function hh_sqnoise(f0, ob, n) local(i, f, k, nz) (
  i = 0;
  loop(6, f = f0 * HH_R[i]; f >= 0.499 ? f = 0.499; HH_ST[i] = floor(f * 4294967296); i += 1; );
  k = 0;
  loop(n,
    nz = 0;
    i = 0;
    loop(6, HH_SQ[i] = u32(HH_SQ[i] + HH_ST[i]); nz += HH_SQ[i] >= 2147483648 ? 1 : 0; i += 1; );
    ob[k] = 0.33 * nz - 1;
    k += 1;
  );
);
function hh_rmnoise(f0, ob, n) local(ratio, i, k, fa, fb) (
  ratio = f0 / (0.01 + f0);
  memset(ob, 0, n);
  i = 0;
  loop(3,
    fa = (i == 0 ? 200 : i == 1 ? 510 : 730) / SR_K * ratio;
    fb = (i == 0 ? 7530 : i == 1 ? 8075 : 10500) / SR_K * ratio;
    osc_render(HH_RM + i * 16, 4, fa, 0.5, TMP0, n);
    osc_render(HH_RM + i * 16 + 8, 1, fb, 0.5, TMP1, n);
    k = 0; loop(n, ob[k] += TMP0[k] * TMP1[k]; k += 1; );
    i += 1;
  );
);
function hh_render1(which, sus, trig, acc, f0, tone, dec, noi, ob, n) local(ed, cd, cut, nf, g_v, g_i, k, s_, cf, hf, env, clk, smp, gn) (
  ed = 1 - 0.003 * s2r(-dec * 84);
  cd = 1 - 0.0025 * s2r(-dec * 36);
  env = which ? hh_env2 : hh_env1;
  trig ? env = (1.5 + 0.5 * (1 - dec)) * (0.3 + 0.7 * acc);
  which ? hh_rmnoise(2 * f0, ob, n) : hh_sqnoise(2 * f0, ob, n);
  cut = clamp(150 / SR_K * s2r(tone * 72), 0, 16000 / SR_K);
  cf = which ? HH_C2 : HH_C1;
  svf_set(cf, tan_acc(cut), which ? 1 : 3 + 3 * tone);
  k = 0; loop(n, ob[k] = svf_bpf(cf, ob[k]); k += 1; );
  noi *= noi;
  nf = clamp(f0 * (16 + 16 * (1 - noi)), 0, 0.5);
  clk = which ? hh_clk2 : hh_clk1;
  smp = which ? hh_smp2 : hh_smp1;
  k = 0;
  loop(n,
    clk += nf;
    clk >= 1 ? ( clk -= 1; smp = rfloat() - 0.5; );
    ob[k] += noi * (smp - ob[k]);
    k += 1;
  );
  g_v = which ? hh_sg2 : hh_sg1; g_i = (acc * dec - g_v) / n;
  k = 0;
  loop(n,
    env *= (env > 0.5 || !which) ? ed : cd;
    sus ? ( g_v += g_i; gn = g_v; ) : gn = env;
    s_ = ob[k];
    which ? ob[k] = s_ * gn : (
      s_ *= s_ > 0 ? 4 : 0.1;
      s_ = s_ / (1 + abs(s_));
      ob[k] = (s_ + 0.1) * gn;
    );
    k += 1;
  );
  hf = which ? HH_H2 : HH_H1;
  svf_set(hf, tan_acc(cut), 0.5);
  k = 0; loop(n, ob[k] = svf_hpf(hf, ob[k]); k += 1; );
  which ? ( hh_env2 = env; hh_clk2 = clk; hh_smp2 = smp; hh_sg2 = g_v; ) : ( hh_env1 = env; hh_clk1 = clk; hh_smp1 = smp; hh_sg1 = g_v; );
);
function hh_render(ob, ab, n) local(f0) (
  f0 = note_freq(ep_note);
  hh_render1(0, ep_trig & 2, ep_trig & 1, ep_accent, f0, ep_timbre, ep_morph, ep_harm, ob, n);
  hh_render1(1, ep_trig & 2, ep_trig & 1, ep_accent, f0, ep_timbre, ep_morph, ep_harm, ab, n);
);


// ---------------------------------------------------------------------- 0: VA + VCF

VF_O = alloc(10); VF_S = alloc(10); VF_F0 = alloc(5); VF_F1 = alloc(5);
function vf_init() ( vso_init(VF_O); vso_init(VF_S); svf_init(VF_F0); svf_init(VF_F1); vf_psg = vf_pc = vf_ps2 = vf_pq = vf_pg = 0; );
function vf_render(ob, ab, n) local(f0, shp, pw, sg, cut, s2g, res, rs, q, gn, a_v, a_i, c_v, c_i, b_v, b_i, q_v, q_i, g_v, g_i, k, c, qq, s2, g, inp, lpv, hpv) (
  f0 = note_freq(ep_note);
  shp = clamp((ep_morph - 0.25) * 2 + 0.5, 0.5, 1);
  pw = (ep_morph - 0.5) * 2 + 0.5;
  ep_morph > 0.75 ? pw = 2.5 - ep_morph * 2;
  pw = clamp(pw, 0.5, 0.98);
  sg = max(abs(ep_morph - 0.5) - 0.3, 0) * 5;
  vso_render(VF_O, 0, 0, 0, f0, pw, shp, 0, ob, n);
  vso_render(VF_S, 0, 0, 0, f0 * 0.501, 0.5, 1, 0, ab, n);
  cut = f0 * s2r((ep_timbre - 0.2) * 120);
  s2g = clamp(1 - (ep_harm - 0.4) * 4, 0, 1);
  res = 2.667 * max(abs(ep_harm - 0.5) - 0.125, 0);
  rs = res * res;
  q = rs * rs * 48;
  gn = clamp((ep_harm - 0.7) + 0.85, 0.7 - rs * 0.3, 1);
  a_v = vf_psg; a_i = (sg - a_v) / n;
  c_v = vf_pc; c_i = (cut - c_v) / n;
  b_v = vf_ps2; b_i = (s2g - b_v) / n;
  q_v = vf_pq; q_i = (q - q_v) / n;
  g_v = vf_pg; g_i = (gn - g_v) / n;
  k = 0;
  loop(n,
    c_v += c_i; c = min(c_v, 0.25);
    q_v += q_i; qq = q_v;
    b_v += b_i; s2 = b_v;
    svf_set(VF_F0, tan_fast(c), 0.5 + qq);
    svf_set(VF_F1, tan_fast(c), 0.5 + 0.025 * qq);
    g_v += g_i; g = g_v;
    a_v += a_i;
    inp = soft_clip((ob[k] + ab[k] * a_v) * g);
    svf_step(VF_F0, inp);
    lpv = svf_lp; hpv = svf_hp;
    lpv = soft_clip(lpv * g);
    lpv += s2 * (soft_clip(svf_lpf(VF_F1, lpv)) - lpv);
    ob[k] = lpv;
    ab[k] = soft_clip(hpv * g);
    k += 1;
  );
  vf_psg = a_v; vf_pc = c_v; vf_ps2 = b_v; vf_pq = q_v; vf_pg = g_v;
);

// ---------------------------------------------------------------------- 1: phase distortion

PD_M = alloc(10); PD_S = alloc(10); PD_T = alloc(48);
function pd_init() ( vso_init(PD_M); vso_init(PD_S); );
function pd_render(ob, ab, n) local(f0, mf, pw, amt, k, sy, fr) (
  f0 = 0.5 * note_freq(ep_note);
  mf = min(0.25, f0 * s2r(interp(T_FMQ, ep_harm, 128)));
  pw = 0.5 + ep_morph * 0.49;
  amt = 8 * ep_timbre * ep_timbre * (1 - mf * 3.8);
  vso_render(PD_S, 1, 1, f0, mf, pw, 0, amt, PD_T, 2 * n);
  vso_render(PD_M, 0, 1, f0, mf, pw, 0, amt, PD_T + 2 * n, 2 * n);
  k = 0;
  loop(n,
    ob[k] = 0.5 * sine(PD_T[2 * k] + 0.25);
    ob[k] += 0.5 * sine(PD_T[2 * k + 1] + 0.25);
    ab[k] = 0.5 * sine(PD_T[2 * n + 2 * k] + 0.25);
    ab[k] += 0.5 * sine(PD_T[2 * n + 2 * k + 1] + 0.25);
    k += 1;
  );
);

// ---------------------------------------------------------------------- 2-4: six-op FM

FM_ALG = alloc(32 * 6); FM_CALLN = alloc(32 * 6); FM_CALLM = alloc(32 * 6); FM_CALLA = alloc(32 * 6); FM_CALLI = alloc(32 * 6); FM_CALLO = alloc(32 * 6);
function alg6(k, a, b, c, d, e, f) local(p) ( p = FM_ALG + k * 6; p[0] = a; p[1] = b; p[2] = c; p[3] = d; p[4] = e; p[5] = f; );
alg6(0, 113, 17, 17, 20, 1, 20);
alg6(1, 1, 17, 17, 20, 113, 20);
alg6(2, 113, 17, 20, 1, 17, 20);
alg6(3, 49, 17, 84, 1, 17, 20);
alg6(4, 113, 20, 1, 20, 1, 20);
alg6(5, 49, 84, 1, 20, 1, 20);
alg6(6, 113, 17, 5, 20, 1, 20);
alg6(7, 1, 17, 117, 20, 1, 20);
alg6(8, 1, 17, 5, 20, 113, 20);
alg6(9, 1, 5, 20, 113, 17, 20);
alg6(10, 113, 5, 20, 1, 17, 20);
alg6(11, 1, 5, 5, 20, 113, 20);
alg6(12, 113, 5, 5, 20, 1, 20);
alg6(13, 113, 5, 17, 20, 1, 20);
alg6(14, 1, 5, 17, 20, 113, 20);
alg6(15, 113, 17, 2, 37, 5, 20);
alg6(16, 1, 17, 2, 37, 117, 20);
alg6(17, 1, 17, 17, 117, 5, 20);
alg6(18, 113, 20, 20, 1, 17, 20);
alg6(19, 1, 5, 20, 113, 20, 20);
alg6(20, 1, 20, 20, 113, 20, 20);
alg6(21, 113, 20, 20, 20, 1, 20);
alg6(22, 113, 20, 20, 1, 20, 4);
alg6(23, 113, 20, 20, 20, 4, 4);
alg6(24, 113, 20, 20, 4, 4, 4);
alg6(25, 113, 5, 20, 1, 20, 4);
alg6(26, 1, 5, 20, 113, 20, 4);
alg6(27, 4, 113, 17, 20, 1, 20);
alg6(28, 113, 20, 1, 20, 4, 4);
alg6(29, 4, 113, 17, 20, 4, 4);
alg6(30, 113, 20, 4, 4, 4, 4);
alg6(31, 116, 4, 4, 4, 4, 4);

function fm_renderer_ok(n, ms, add) (
  (n == 1 && (ms == -2 || ms == -1 || ms == 0)) || (n == 3 && ms == 2 && add) || (n == 2 && ms == 1 && add);
);
function fm_compile(alg) local(op, i, opc, n, from, to, hadd, brk, att, outop, add, ms, j, done) (
  op = FM_ALG + alg * 6;
  i = 0;
  while (i < 6) (
    opc = op[i];
    n = 1;
    done = 0;
    while (!done && i + n < 6) (
      from = op[i + n - 1];
      to = floor((op[i + n] & 48) / 16);
      hadd = from & 4;
      brk = (from & 3) != to;
      (hadd || brk) ? (
        to == (opc & 3) ? n = 1;
        done = 1;
      ) : n += 1;
    );
    att = 0;
    while (att < 2) (
      outop = op[i + n - 1];
      add = (outop & 4) ? 1 : 0;
      ms = -3;
      !(opc & 48) ? ms = -1 : (opc & 48) != 48 ? ms = -2 : (
        j = 0; loop(n, (op[i + j] & 64) ? ms = j; j += 1; );
      );
      fm_renderer_ok(n, ms, add) ? (
        FM_CALLN[alg * 6 + i] = n;
        FM_CALLM[alg * 6 + i] = ms;
        FM_CALLA[alg * 6 + i] = add;
        FM_CALLI[alg * 6 + i] = floor((opc & 48) / 16);
        FM_CALLO[alg * 6 + i] = outop & 3;
        att = 2;
      ) : (
        n = 1;
        att += 1;
      );
    );
    i += n;
  );
);
k = 0; loop(32, fm_compile(k); k += 1; );

FMCOARSE = alloc(32); FMAMS = alloc(4); FMPMS = alloc(8); FMCUBE = alloc(17);
TP = FMCOARSE;
function tset(a, b, c, d, e, f, g, h) ( TP[0] = a; TP[1] = b; TP[2] = c; TP[3] = d; TP[4] = e; TP[5] = f; TP[6] = g; TP[7] = h; TP += 8; );
tset(-12, 0, 12, 19.01955, 24, 27.863137, 31.01955, 33.688259); tset(36, 38.0391, 39.863137, 41.51318, 43.01955, 44.405276, 45.688259, 46.882687);
tset(48, 49.049554, 50.0391, 50.97513, 51.863137, 52.707809, 53.51318, 54.282743); tset(55.01955, 55.726274, 56.405276, 57.05865, 57.688259, 58.295772, 58.882687, 59.450356);
FMAMS[0] = 0; FMAMS[1] = 0.2588; FMAMS[2] = 0.4274; FMAMS[3] = 1;
TP = FMPMS; tset(0, 0.078125, 0.15625, 0.2578125, 0.4296875, 0.71875, 1.1953125, 2);
TP = FMCUBE; tset(0, 0.39685062976, 0.5, 0.57235744065, 0.62996081605, 0.67860466725, 0.72112502092, 0.75914745216);
tset(0.79370070937, 0.82548197054, 0.85498810729, 0.88258719406, 0.90856038354, 0.93312785379, 0.95646563396, 0.97871693135); FMCUBE[16] = 1;

function pow2f1(x) local(w, e, m) ( w = (8388608 * (127 + x)) | 0; e = floor(w / 8388608); m = w - e * 8388608; (1 + m / 8388608) * 2 ^ (e - 127); );
function pow2f2(x) local(xi, r) ( xi = x | 0; x < 0 ? xi -= 1; x -= xi; r = 1 + x * (0.6565 + x * 0.3435); r * 2 ^ xi; );
function s2r_safe(s) local(sc) (
  sc = 1;
  while (s > 120) ( s -= 120; sc *= 1024; );
  while (s < -120) ( s += 120; sc *= 1 / 1024; );
  sc * s2r(s);
);
function op_level(l) local(t) ( t = l; l < 20 ? ( t = t < 15 ? floor((t * (36 - t)) / 8) : 27 + t; ) : t += 28; t; );
function pe_level(l) local(x, tl) ( x = (l - 50) / 32; tl = max(abs(x + 0.02) - 1, 0); x * (1 + tl * tl * 5.3056); );
function oe_inc(r) local(rs, ma, ex) ( rs = floor((r * 41) / 64); ma = 4 + (rs & 3); ex = 2 + floor(rs / 4); (ma * 2 ^ ex) / 16777216; );
function pe_inc(r) ( r *= 0.01; (1 + 192 * r * (r * r * r * r + 0.3333)) / (21.3 * 44100); );
function lfo_freq(r) local(rs) ( rs = r == 0 ? 1 : floor((r * 165) / 64); rs *= rs < 160 ? 11 : (11 + floor((rs - 160) / 16)); rs * 0.005865; );

FP_SZ = 160;
FMPAT = alloc(32 * FP_SZ);
function fm_unpack(pp, d) local(i, o, od, j) (
  i = 0;
  loop(6,
    o = pp + i * 21;
    od = d + i * 17;
    j = 0;
    loop(4, o[j] = min(od[j] & 127, 99); o[4 + j] = min(od[4 + j] & 127, 99); j += 1; );
    o[8] = min(od[8] & 127, 99);
    o[9] = min(od[9] & 127, 99);
    o[10] = min(od[10] & 127, 99);
    o[11] = od[11] & 3;
    o[12] = floor(od[11] / 4) & 3;
    o[13] = od[12] & 7;
    o[14] = od[13] & 3;
    o[15] = floor(od[13] / 4) & 7;
    o[16] = min(od[14] & 127, 99);
    o[17] = od[15] & 1;
    o[18] = floor(od[15] / 2) & 31;
    o[19] = min(od[16] & 127, 99);
    o[20] = min(floor(od[12] / 8) & 15, 14);
    i += 1;
  );
  j = 0;
  loop(4, pp[126 + j] = min(d[102 + j] & 127, 99); pp[130 + j] = min(d[106 + j] & 127, 99); j += 1; );
  pp[134] = d[110] & 31;
  pp[135] = d[111] & 7;
  pp[136] = floor(d[111] / 8) & 1;
  pp[137] = min(d[112] & 127, 99);
  pp[138] = min(d[113] & 127, 99);
  pp[139] = min(d[114] & 127, 99);
  pp[140] = min(d[115] & 127, 99);
  pp[141] = d[116] & 1;
  pp[142] = min(floor(d[116] / 2) & 7, 5);
  pp[143] = floor(d[116] / 16);
  pp[144] = min(d[117] & 127, 48);
);

E_ST = 0; E_PH = 1; E_SS = 2; E_INC = 3; E_LV = 7; E_SC = 11; E_SZ = 12;
function env_init(e, sc) local(i) (
  e[E_SC] = sc; e[E_ST] = 3; e[E_PH] = 1; e[E_SS] = 0;
  i = 0; loop(4, e[E_INC + i] = 0.001; e[E_LV + i] = 1 / 2 ^ i; i += 1; );
  e[E_LV + 3] = 0;
);
function env_value(e, rs, st, ph, sl) local(fr, to) (
  fr = sl == -100 ? e[E_LV + (st + 3) % 4] : sl;
  to = e[E_LV + st];
  (rs && fr < to) ? (
    fr = max(6.7, fr);
    to = max(6.7, to);
    ph *= (2.5 - ph) * 0.666667;
  );
  ph * (to - fr) + fr;
);
function env_at_core(e, rs, t, gd) local(st, sd, done) (
  st = 0; done = 0;
  while (!done && st < 3) (
    sd = 1 / e[E_INC + st];
    t < sd ? done = 1 : ( t -= sd; st += 1; );
  );
  st == 3 ? (
    t -= gd;
    t <= 0 ? e[E_LV + 2] : t * e[E_INC + 3] > 1 ? e[E_LV + 3] : env_value(e, rs, st, t * e[E_INC + st], -100);
  ) : env_value(e, rs, st, t * e[E_INC + st], -100);
);
function env_at(e, rs, t, gd) local(ph) (
  t > gd ? (
    ph = (t - gd) * e[E_INC + 3];
    ph >= 1 ? e[E_LV + 3] : env_value(e, rs, 3, ph, env_at_core(e, rs, gd, gd));
  ) : env_at_core(e, rs, t, gd);
);
function env_render(e, rs, gate, rate, ads, rls) (
  gate ? (
    e[E_ST] == 3 ? ( e[E_SS] = env_value(e, rs, e[E_ST], e[E_PH], e[E_SS]); e[E_ST] = 0; e[E_PH] = 0; );
  ) : (
    e[E_ST] != 3 ? ( e[E_SS] = env_value(e, rs, e[E_ST], e[E_PH], e[E_SS]); e[E_ST] = 3; e[E_PH] = 0; );
  );
  e[E_PH] += e[E_INC + e[E_ST]] * rate * (e[E_ST] == 3 ? rls : ads);
  e[E_PH] >= 1 ? (
    e[E_ST] >= 2 ? e[E_PH] = 1 : ( e[E_PH] = 0; e[E_ST] += 1; );
    e[E_SS] = -100;
  );
  env_value(e, rs, e[E_ST], e[E_PH], e[E_SS]);
);
function oenv_set(e, rt, lv, gl) local(i, ls, inc, fr, to) (
  i = 0;
  loop(4,
    ls = op_level(lv[i]);
    ls = (ls - (ls & 1)) + gl - 133;
    e[E_LV + i] = 0.125 * (ls < 1 ? 0.5 : ls);
    i += 1;
  );
  i = 0;
  loop(4,
    inc = oe_inc(rt[i]);
    fr = e[E_LV + (i + 3) % 4];
    to = e[E_LV + i];
    fr === to ? (
      inc *= 0.6;
      (i == 0 && !lv[i]) ? inc *= 20;
    ) : fr < to ? (
      fr = max(6.7, fr);
      to = max(6.7, to);
      fr === to ? inc = 1 : inc *= 7.2 / (to - fr);
    ) : (
      inc *= 1 / (fr - to);
    );
    e[E_INC + i] = inc * e[E_SC];
    i += 1;
  );
);
function penv_set(e, rt, lv) local(i, inc, fr, to) (
  i = 0; loop(4, e[E_LV + i] = pe_level(lv[i]); i += 1; );
  i = 0;
  loop(4,
    fr = e[E_LV + (i + 3) % 4];
    to = e[E_LV + i];
    inc = pe_inc(rt[i]);
    fr !== to ? inc *= 1 / abs(fr - to) : i != 3 ? inc = 0.2;
    e[E_INC + i] = inc * e[E_SC];
    i += 1;
  );
);

L_PH = 0; L_F = 1; L_DP = 2; L_DI0 = 3; L_DI1 = 4; L_V = 5; L_RV = 6; L_HZ = 7; L_AMD = 8; L_PMD = 9; L_WF = 10; L_RP = 11; L_PI = 12;
function lfo_init(l) ( l[L_PH] = 0; l[L_F] = 0.1; l[L_DP] = 0; l[L_DI0] = l[L_DI1] = 0.1; l[L_RV] = l[L_V] = 0; l[L_HZ] = 1 / SR_E; l[L_AMD] = 0; l[L_PMD] = 0; l[L_WF] = 0; l[L_RP] = 0; l[L_PI] = 0; );
function lfo_val(l) local(ph) (
  ph = l[L_PH];
  l[L_WF] == 0 ? 2 * (ph < 0.5 ? 0.5 - ph : ph - 0.5) :
  l[L_WF] == 1 ? 1 - ph :
  l[L_WF] == 2 ? ph :
  l[L_WF] == 3 ? (ph < 0.5 ? 0 : 1) :
  l[L_WF] == 4 ? 0.5 + 0.5 * sine(ph + 0.5) :
  l[L_RV];
);
function lfo_set(l, pp) local(d) (
  l[L_F] = lfo_freq(pp[137]) * l[L_HZ];
  pp[138] == 0 ? ( l[L_DI0] = l[L_DI1] = 100000; ) : (
    d = 99 - pp[138];
    d = (16 + (d & 15)) * 2 ^ (1 + floor(d / 16));
    l[L_DI0] = d * 0.005865;
    l[L_DI1] = max(128, d & 65408) * 0.005865;
  );
  l[L_DI0] *= l[L_HZ];
  l[L_DI1] *= l[L_HZ];
  l[L_WF] = pp[142];
  l[L_RP] = pp[141] != 0;
  l[L_AMD] = pp[140] * 0.01;
  l[L_PMD] = pp[139] * 0.01 * FMPMS[pp[143]];
);
function lfo_reset(l) ( l[L_RP] ? l[L_PH] = 0; l[L_DP] = 0; );
function lfo_step(l, sc) (
  l[L_PH] += sc * l[L_F];
  l[L_PH] >= 1 ? ( l[L_PH] -= 1; l[L_RV] = rfloat(); );
  l[L_V] = lfo_val(l);
  l[L_DP] += sc * (l[L_DP] < 0.5 ? l[L_DI0] : l[L_DI1]);
  l[L_DP] >= 1 ? l[L_DP] = 1;
);
function lfo_scrub(l, smp) local(ph, pi) (
  ph = smp * l[L_F];
  pi = ph | 0;
  l[L_PH] = ph - pi;
  pi != l[L_PI] ? ( l[L_PI] = pi; l[L_RV] = rfloat(); );
  l[L_V] = lfo_val(l);
  l[L_DP] = smp * l[L_DI0];
  l[L_DP] > 0.5 ? (
    smp -= 0.5 / l[L_DI0];
    l[L_DP] = 0.5 + smp * l[L_DI1];
    l[L_DP] >= 1 ? l[L_DP] = 1;
  );
);
function lfo_dr(l) ( l[L_DP] < 0.5 ? 0 : (l[L_DP] - 0.5) * 2; );
function lfo_pm(l) ( (l[L_V] - 0.5) * lfo_dr(l) * l[L_PMD]; );
function lfo_am(l) ( (1 - l[L_V]) * lfo_dr(l) * l[L_AMD]; );

V_PAT = 0; V_LFO = 1; V_OP = 16; V_OE = 28; V_PE = 28 + 6 * 12; V_FB = 112; V_GATE = 114; V_NOTE = 115; V_NV = 116; V_RAT = 117; V_HR = 123; V_LEV = 129; V_DIRTY = 135; V_PAR = 136; V_SZ = 160;
P_SUS = 0; P_GATE = 1; P_NOTE = 2; P_VEL = 3; P_BR = 4; P_EC = 5; P_PM = 6; P_AM = 7;
FMV0 = alloc(2 * V_SZ); FMF = alloc(6); FMAMP = alloc(6); FMBUF = alloc(96); FMACC = alloc(48); FMHQ = alloc(5);
FMOF = alloc(6); FMOP = alloc(6); FMOA = alloc(6); FMOI = alloc(6);
function fmv_init(v) local(i, sc) (
  memset(v, 0, V_SZ);
  lfo_init(v + V_LFO);
  sc = 44100 * (1 / SR_E);
  i = 0; loop(6, v[V_OP + i * 2] = 0; v[V_OP + i * 2 + 1] = 0; env_init(v + V_OE + i * 12, sc); i += 1; );
  env_init(v + V_PE, sc);
  v[V_FB] = v[V_FB + 1] = 0;
  v[V_PAT] = -1;
  v[V_GATE] = 0;
  v[V_NOTE] = 48;
  v[V_NV] = 10;
  v[V_DIRTY] = 1;
  v[V_PAR + P_SUS] = 0; v[V_PAR + P_GATE] = 0; v[V_PAR + P_NOTE] = 48; v[V_PAR + P_VEL] = 0.5;
  v[V_PAR + P_BR] = 0.5; v[V_PAR + P_EC] = 0.5; v[V_PAR + P_PM] = 0; v[V_PAR + P_AM] = 0;
);
function fmv_load(v, pi) local(pp) (
  pi != v[V_PAT] ? (
    v[V_PAT] = pi;
    v[V_DIRTY] = 1;
    lfo_set(v + V_LFO, FMPAT + pi * FP_SZ);
  );
);
function fm_freq_ratio(o) local(dt, base) (
  dt = (o[17] == 0 && o[19]) ? 1 + 0.01 * o[19] : 1;
  base = o[17] == 0 ? FMCOARSE[o[18]] : ((o[18] & 3) * 100 + o[19]) * 0.39864;
  base += (o[20] - 7) * 0.015;
  s2r_safe(base) * dt;
);
function fm_kbs(note, o) local(x, crv, t, dp) (
  x = note - o[8] - 15;
  crv = x > 0 ? o[12] : o[11];
  t = abs(x);
  (crv == 1 || crv == 2) ? ( t = min(t * 0.010467, 1); t = t * t * t; t *= 96; );
  crv < 2 ? t = -t;
  dp = x > 0 ? o[10] : o[9];
  t * dp * 0.02677;
);
function fm_render_ops(v, ofs, n, ms, add, fb, mod, ob, sz) local(p0, p1, i, scl, fbs, k, pm, o) (
  ms >= 0 ? ( p0 = v[V_FB]; p1 = v[V_FB + 1]; );
  scl = 1 / sz;
  i = 0;
  loop(n,
    o = v + V_OP + (ofs + i) * 2;
    FMOF[i] = floor(min(FMF[ofs + i], 0.5) * 4294967296);
    FMOP[i] = o[0];
    FMOA[i] = o[1];
    FMOI[i] = (min(FMAMP[ofs + i], 4) - FMOA[i]) * scl;
    i += 1;
  );
  fbs = fb ? 2 ^ fb / 512 : 0;
  k = 0;
  loop(sz,
    pm = 0;
    ms >= 0 ? pm = (p0 + p1) * fbs : ms == -2 ? pm = mod[k];
    i = 0;
    loop(n,
      FMOP[i] = u32(FMOP[i] + FMOF[i]);
      pm = sine_pm(FMOP[i], pm) * FMOA[i];
      FMOA[i] += FMOI[i];
      i == ms ? ( p1 = p0; p0 = pm; );
      i += 1;
    );
    add ? ob[k] += pm : ob[k] = pm;
    k += 1;
  );
  i = 0; loop(n, o = v + V_OP + (ofs + i) * 2; o[0] = FMOP[i]; o[1] = FMOA[i]; i += 1; );
  ms >= 0 ? ( v[V_FB] = p0; v[V_FB + 1] = p1; );
);
function fmv_render(v, buf, sz) local(pp, i, o, lvl, par, er, ads, rls, gd, es, pe, pmod, f0, non, rsc, kb, vs, br, sens, llm, lmod, alg, ci, bi, bo, n) (
  v[V_PAT] >= 0 ? (
    pp = FMPAT + v[V_PAT] * FP_SZ;
    par = v + V_PAR;
    v[V_DIRTY] ? (
      penv_set(v + V_PE, pp + 126, pp + 130);
      i = 0;
      loop(6,
        o = pp + i * 21;
        lvl = op_level(o[16]);
        oenv_set(v + V_OE + i * 12, o, o + 4, lvl);
        v[V_HR + i] = 127 - lvl;
        v[V_RAT + i] = (o[17] == 0 ? 1 : -1) * fm_freq_ratio(o);
        i += 1;
      );
      v[V_DIRTY] = 0;
    ) : (
      er = sz;
      ads = pow2f1((0.5 - par[P_EC]) * 8);
      rls = pow2f1(-abs(par[P_EC] - 0.3) * 8);
      gd = 1.5 * SR_E;
      es = gd * par[P_EC];
      pe = par[P_SUS] ? env_at(v + V_PE, 0, es, gd) : env_render(v + V_PE, 0, par[P_GATE], er, ads, rls);
      pmod = pe + par[P_PM];
      f0 = (55 / SR_E) * 0.25 * s2r_safe(par[P_NOTE] - 9 + pmod * 12);
      non = par[P_GATE] && !v[V_GATE];
      v[V_GATE] = par[P_GATE];
      (non || par[P_SUS]) ? (
        v[V_NV] = 16 * (interp(FMCUBE, par[P_VEL], 16) - 0.918);
        v[V_NOTE] = par[P_NOTE];
      );
      (non && pp[136]) ? ( i = 0; loop(6, v[V_OP + i * 2] = 0; i += 1; ); );
      alg = pp[134];
      i = 0;
      loop(6,
        o = pp + i * 21;
        FMF[i] = v[V_RAT + i] * (v[V_RAT + i] < 0 ? -(1 / SR_E) : f0);
        rsc = pow2f1(o[13] * (v[V_NOTE] * 0.33333 - 7) * 0.03125);
        lvl = par[P_SUS] ? env_at(v + V_OE + i * 12, 1, es, gd) : env_render(v + V_OE + i * 12, 1, par[P_GATE], er * rsc, ads, rls);
        kb = fm_kbs(v[V_NOTE], o);
        vs = v[V_NV] * o[15];
        br = (FM_ALG[alg * 6 + i] & 3) ? (par[P_BR] - 0.5) * 32 : 0;
        lvl += 0.125 * min(kb + vs + br, v[V_HR + i]);
        v[V_LEV + i] = lvl;
        sens = FMAMS[o[14]];
        llm = sens * par[P_AM] - 1;
        lmod = 1 - pow2f2(6.4 * llm);
        FMAMP[i] = pow2f2(-14 + lvl * lmod);
        i += 1;
      );
      i = 0;
      while (i < 6) (
        ci = alg * 6 + i;
        n = FM_CALLN[ci];
        bi = FM_CALLI[ci]; bo = FM_CALLO[ci];
        fm_render_ops(v, i, n, FM_CALLM[ci], FM_CALLA[ci], pp[135],
          buf + (bi == 0 ? 0 : bi == 1 ? sz : 2 * sz), buf + (bo == 0 ? 0 : bo == 1 ? sz : 2 * sz), sz);
        i += n;
      );
    );
  );
);
function six_init() local(i) (
  hq_init(FMHQ, 32, 0.005, 0);
  i = 0; loop(2, fmv_init(FMV0 + i * V_SZ); i += 1; );
  six_av = 1; six_rv = 0;
);
function six_load(bank) local(i) (
  i = 0; loop(32, fm_unpack(FMPAT + i * FP_SZ, T_SYX + bank * 4096 + i * 128); i += 1; );
  FMV0[V_PAT] = -1; FMV0[V_SZ + V_PAT] = -1;
);
function six_render(ob, ab, n) local(pi, t, i, v, p, av, k) (
  pi = hq_proc(FMHQ, 0, ep_harm * 1.02);
  (ep_trig & 2) ? (
    t = ep_morph;
    lfo_scrub(FMV0 + V_LFO, 2 * SR_E * t);
    i = 0;
    loop(2,
      v = FMV0 + i * V_SZ;
      fmv_load(v, pi);
      p = v + V_PAR;
      p[P_SUS] = i == 0;
      p[P_GATE] = 0;
      p[P_NOTE] = ep_note;
      p[P_VEL] = ep_accent;
      p[P_BR] = ep_timbre;
      p[P_EC] = t;
      p[P_PM] = lfo_pm(FMV0 + V_LFO);
      p[P_AM] = lfo_am(FMV0 + V_LFO);
      i += 1;
    );
  ) : (
    (ep_trig & 1) ? (
      six_av = (six_av + 1) % 2;
      fmv_load(FMV0 + six_av * V_SZ, pi);
      lfo_reset(FMV0 + six_av * V_SZ + V_LFO);
    );
    av = FMV0 + six_av * V_SZ;
    p = av + V_PAR;
    p[P_NOTE] = ep_note;
    p[P_VEL] = ep_accent;
    p[P_EC] = ep_morph;
    lfo_step(av + V_LFO, n);
    i = 0;
    loop(2,
      v = FMV0 + i * V_SZ;
      p = v + V_PAR;
      p[P_BR] = ep_timbre;
      p[P_SUS] = 0;
      p[P_GATE] = (ep_trig & 4) && i == six_av;
      v[V_PAT] != av[V_PAT] ? (
        lfo_step(v + V_LFO, n);
        p[P_PM] = lfo_pm(v + V_LFO); p[P_AM] = lfo_am(v + V_LFO);
      ) : (
        p[P_PM] = lfo_pm(av + V_LFO); p[P_AM] = lfo_am(av + V_LFO);
      );
      i += 1;
    );
  );
  memcpy(FMBUF, FMACC, n);
  memset(FMBUF + n, 0, n);
  six_rv = (six_rv + 1) % 2;
  fmv_render(FMV0 + six_rv * V_SZ, FMBUF, 2 * n);
  k = 0; loop(n, ob[k] = ab[k] = soft_clip(FMBUF[k] * 0.25); k += 1; );
  memcpy(FMACC, FMBUF + n, n);
);

// ---------------------------------------------------------------------- 5: wave terrain

WTR_PATH = alloc(4); WTR_T = alloc(48);
function wtr_init() ( fso_init(WTR_PATH); wtr_off = 0; wtr_ter = 0; );
function fso_quad(o, frq, amp, xb, yb, n) local(e_v, e_i, a_v, a_i, x, y, nrm, sc, fp, k, e) (
  frq >= 0.25 ? ( frq = 0.25; amp = 0; ) : amp *= 1 - frq * 4;
  fp = frq * $pi;
  e_v = o[2]; e_i = ((fp * (2 - (2 * 0.96 / 6) * fp * fp)) - e_v) / n;
  a_v = o[3]; a_i = (amp - a_v) / n;
  x = o[0]; y = o[1];
  nrm = x * x + y * y;
  (nrm <= 0.5 || nrm >= 2) ? ( sc = rsqrt_c(nrm); x *= sc; y *= sc; );
  k = 0;
  loop(n,
    e_v += e_i; e = e_v;
    x += e * y;
    y -= e * x;
    a_v += a_i;
    xb[k] = x * a_v;
    yb[k] = y * a_v;
    k += 1;
  );
  o[0] = x; o[1] = y; o[2] = e_v; o[3] = a_v;
);
function wtr_squash(x, a) ( x *= a; x / (1 + abs(x)); );
function wtr_wt(x, y, bank) local(smp, wt, wv, si, sf, wi, wf, a, b, c, x0, x1) (
  smp = (y + 1) * 0.5 * 128;
  wt = (x + 1) * 0.5 * 63;
  wv = T_WAVES + bank * 64 * 132;
  si = smp | 0; sf = smp - si;
  wi = wt | 0; wf = wt - wi;
  wv += wi * 132;
  a = wv[si]; b = wv[si + 1]; c = wv[si + 2];
  x0 = (b - a) + (c - b - b + a) * sf;
  wv += 132;
  a = wv[si]; b = wv[si + 1]; c = wv[si + 2];
  x1 = (b - a) + (c - b - b + a) * sf;
  (x0 + (x1 - x0) * wf) * (1 / 1024);
);
function wtr_terrain(x, y, ti) local(k, xy, xys) (
  k = 4;
  ti == 0 ? (wtr_squash(sine(k + x * 1.273), 2) - sine(k + y * (x + 1.571) * 0.637)) * 0.57 :
  ti == 1 ? ( xy = x * y; sine(k + sine(k + (x + y) * 0.637) / (0.2 + xy * xy) * 0.159); ) :
  ti == 2 ? ( xy = x * y; sine(k + sine(k + 2.387 * xy) / (0.35 + xy * xy) * 0.159); ) :
  ti == 3 ? ( xy = x * y; xys = (x - 0.25) * (y + 0.25); sine(k + xy / (2 + abs(5 * xys)) * 6.366); ) :
  ti == 4 ? sine(0.159 / (0.17 + abs(y - 0.25)) + 0.477 / (0.35 + abs((x + 0.5) * (y + 1.5))) + k) :
  (ti >= 5 && ti <= 7) ? wtr_wt(x, y, 2 - (ti - 5)) :
  0;
);
function wtr_render(ob, ab, n) local(f0, att, rad, o_v, o_i, t_v, t_i, ij, k, xo, zi, zf, os, as, j, x, y, z0, z1, z) (
  f0 = note_freq(ep_note);
  att = max(1 - 8 * f0, 0);
  rad = 0.1 + 0.9 * ep_timbre * att * (2 - att);
  fso_quad(WTR_PATH, f0 * 0.5, rad, WTR_T, WTR_T + 2 * n, 2 * n);
  o_v = wtr_off; o_i = ((1.9 * ep_morph - 1) - o_v) / n;
  t_v = wtr_ter; t_i = (min(ep_harm * 1.05, 1) * (8 - 1.0001) - t_v) / n;
  ij = 0;
  k = 0;
  loop(n,
    o_v += o_i; xo = o_v;
    t_v += t_i;
    zi = t_v | 0; zf = t_v - zi;
    os = 0; as = 0;
    j = 0;
    loop(2,
      x = WTR_T[ij] * (1 - abs(xo)) + xo;
      y = WTR_T[2 * n + ij];
      ij += 1;
      z0 = wtr_terrain(x, y, zi);
      z1 = wtr_terrain(x, y, zi + 1);
      z = z0 + (z1 - z0) * zf;
      os += z;
      as += y + z;
      j += 1;
    );
    ob[k] = 0.5 * os;
    ab[k] = sine(1 + 0.5 * 0.5 * as);
    k += 1;
  );
  wtr_off = o_v; wtr_ter = t_v;
);

// ---------------------------------------------------------------------- 6: string machine

SM_SSO = alloc(4 * 10); SM_REG = alloc(66); SMRG = alloc(8); SM_NS0 = alloc(4); SM_NS1 = alloc(4); SM_ENS = alloc(1024);
cset6(SM_REG, 1, 0, 0, 0, 0, 0); cset6(SM_REG + 6, 0.5, 0, 0.5, 0, 0, 0); cset6(SM_REG + 12, 0.4, 0, 0.2, 0, 0.4, 0);
cset6(SM_REG + 18, 0.3, 0, 0, 0.3, 0, 0.4); cset6(SM_REG + 24, 0.3, 0, 0, 0, 0, 0.7); cset6(SM_REG + 30, 0.2, 0, 0, 0.2, 0, 0.6);
cset6(SM_REG + 36, 0, 0.2, 0.1, 0, 0.2, 0.5); cset6(SM_REG + 42, 0, 0.3, 0, 0.3, 0, 0.4); cset6(SM_REG + 48, 0, 0.4, 0, 0.3, 0, 0.3);
cset6(SM_REG + 54, 0, 0.5, 0, 0.5, 0, 0); cset6(SM_REG + 60, 0, 1, 0, 0, 0, 0);
function nsvf_set(p, f, res) ( f = f < 0.158 ? f : 0.158; p[0] = 2 * $pi * f; p[1] = 1 / res; );
function nsvf_lp(p, x) local(bn, nt, hp) ( bn = p[3] * p[1]; nt = x - bn; p[2] += p[0] * p[3]; hp = nt - p[2]; p[3] += p[0] * hp; p[2]; );
function sm_ip(off) local(oi, of, a) ( oi = off | 0; of = off - oi; a = fxb[(fxwp + oi) & fxmask]; a + (fxb[(fxwp + oi + 1) & fxmask] - a) * of; );
function sm_init() local(i) (
  i = 0; loop(4, sso_init(SM_SSO + i * 10); i += 1; );
  cb_init(CB_SM);
  sm_mlp = 0; sm_tlp = 0;
  memset(SM_NS0, 0, 4); memset(SM_NS1, 0, 4);
  nsvf_set(SM_NS0, 0.01, 100); nsvf_set(SM_NS1, 0.01, 100);
  sm_ewp = 0; sm_ep1 = 0; sm_ep2 = 0;
);
function sm_reset() ( cb_reset(CB_SM); memset(SM_ENS, 0, 1024); sm_ewp = 0; );
function sm_render(ob, ab, n) local(reg, ri, rf, i, a, b, f0, nt, nf0, ddg, cut, k, l, r, amt, dep, dry, s0, s120, s240, f_0, f120, f240, aa, bb, m1, m2, m3, wet) (
  sm_mlp += 0.1 * (ep_morph - sm_mlp);
  sm_tlp += 0.1 * (ep_timbre - sm_tlp);
  cb_set(CB_SM, ep_harm);
  reg = max(sm_mlp, 0);
  reg *= 11 - 1.001;
  ri = reg | 0; rf = reg - ri;
  i = 0;
  loop(6, a = SM_REG[ri * 6 + i]; b = SM_REG[(ri + 1) * 6 + i]; SMRG[i] = a + (b - a) * rf; i += 1; );
  SMRG[6] = 0;
  memset(ob, 0, n); memset(ab, 0, n);
  f0 = note_freq(ep_note) * 0.998;
  nt = 0;
  loop(4,
    nf0 = f0 * cb_ratio(CB_SM, nt);
    ddg = clamp(4 - nf0 * 32, 0, 1);
    sso_render(SM_SSO + nt * 10, nf0, SMRG, 0.25 * ddg, (nt & 1) ? ab : ob, n);
    nt += 1;
  );
  cut = 2.2 * f0 * s2r(120 * ep_timbre);
  nsvf_set(SM_NS0, cut, 1);
  nsvf_set(SM_NS1, cut * 1.5, 1);
  k = 0;
  loop(n,
    l = nsvf_lp(SM_NS0, ob[k]);
    r = nsvf_lp(SM_NS1, ab[k]);
    ob[k] = 0.66 * l + 0.33 * r;
    ab[k] = 0.66 * r + 0.33 * l;
    k += 1;
  );
  amt = abs(ep_timbre - 0.5) * 2;
  dep = 0.35 + 0.65 * ep_timbre;
  fxb = SM_ENS; fxmask = 1023;
  k = 0;
  loop(n,
    sm_ewp -= 1; sm_ewp < 0 ? sm_ewp += 1024;
    fxwp = sm_ewp;
    dry = 1 - amt * 0.5;
    sm_ep1 = u32(sm_ep1 + 67289);
    sm_ep2 = u32(sm_ep2 + 589980);
    s0 = sine_raw(sm_ep1); s120 = sine_raw(u32(sm_ep1 + 1417339207)); s240 = sine_raw(u32(sm_ep1 + 2834678415));
    f_0 = sine_raw(sm_ep2); f120 = sine_raw(u32(sm_ep2 + 1417339207)); f240 = sine_raw(u32(sm_ep2 + 2834678415));
    aa = dep * 160; bb = dep * 16;
    m1 = s0 * aa + f_0 * bb; m2 = s120 * aa + f120 * bb; m3 = s240 * aa + f240 * bb;
    SM_ENS[fxwp & 1023] = ob[k];
    SM_ENS[(fxwp + 512) & 1023] = ab[k];
    wet = 0;
    wet += sm_ip(m1 + 192) * 0.33; wet += sm_ip(m2 + 192) * 0.33; wet += sm_ip(512 + m3 + 192) * 0.33;
    ob[k] = wet * amt + ob[k] * dry;
    wet = 0;
    wet += sm_ip(512 + m1 + 192) * 0.33; wet += sm_ip(512 + m2 + 192) * 0.33; wet += sm_ip(m3 + 192) * 0.33;
    ab[k] = wet * amt + ab[k] * dry;
    k += 1;
  );
);

// ---------------------------------------------------------------------- 7: chiptune

CT_SQ = alloc(5 * 8); CT_TRI = alloc(8); CT_HQ = alloc(5);
function ssq_init(o) ( o[0] = 0; o[1] = 0; o[2] = 0; o[3] = 0; o[4] = 0; o[5] = 0.01; );
function ssq_render(o, frq, shp, ob, n) local(mfq, m_v, m_i, f_v, f_i, nx, k, reset, tdr, rt, ts, mf, sf, spr, val, t, run) (
  mfq = frq;
  frq *= shp < 0.5 ? (0.51 + 0.98 * shp) : 1 + 16 * (shp - 0.5) * (shp - 0.5);
  mfq >= 0.25 ? mfq = 0.25;
  frq >= 0.25 ? frq = 0.25;
  m_v = o[4]; m_i = (mfq - m_v) / n;
  f_v = o[5]; f_i = (frq - f_v) / n;
  nx = o[2];
  k = 0;
  loop(n,
    reset = 0; tdr = 0; rt = 0;
    ts = nx; nx = 0;
    m_v += m_i; mf = m_v;
    f_v += f_i; sf = f_v;
    o[0] += mf;
    o[0] >= 1 ? (
      o[0] -= 1;
      rt = o[0] / mf;
      spr = o[1] + (1 - rt) * sf;
      reset = 1;
      spr >= 1 ? ( spr -= 1; tdr = 1; );
      (!o[3] && spr >= 0.5) ? tdr = 1;
      val = spr < 0.5 ? 0 : 1;
      ts -= val * tb(rt);
      nx -= val * nb(rt);
    );
    o[1] += sf;
    run = 1;
    while (run && (tdr || !reset)) (
      !o[3] ? (
        o[1] < 0.5 ? run = 0 : (
          t = (o[1] - 0.5) / sf;
          ts += tb(t); nx += nb(t);
          o[3] = 1;
        );
      );
      (run && o[3]) ? (
        o[1] < 1 ? run = 0 : (
          o[1] -= 1;
          t = o[1] / sf;
          ts -= tb(t); nx -= nb(t);
          o[3] = 0;
        );
      );
    );
    reset ? ( o[1] = rt * sf; o[3] = 0; );
    nx += o[1] < 0.5 ? 0 : 1;
    ob[k] = 2 * ts - 1;
    k += 1;
  );
  o[2] = nx; o[4] = m_v; o[5] = f_v;
);
function nes_init(o) ( o[0] = 0; o[1] = 0; o[2] = 1; o[3] = 0; o[4] = 0.001; );
function nes_render(o, frq, ob, n) local(f_v, f_i, nx, k, f, fade, ng, tg, ts, dsc, t, ns, wrap, fr) (
  frq = min(frq, 0.25);
  f_v = o[4]; f_i = (frq - f_v) / n;
  nx = o[3];
  k = 0;
  loop(n,
    f_v += f_i; f = f_v;
    o[0] += f;
    fade = clamp((f - 0.5 / 32) * 2 * 32, 0, 1);
    ng = 1 - fade;
    tg = fade * 2 / (4 / 30);
    ts = nx; nx = 0;
    (o[2] && o[0] >= 0.5) ? (
      dsc = 4 * f * tg;
      dsc !== 0 ? ( t = (o[0] - 0.5) / f; ts -= tib(t) * dsc; nx -= nib(t) * dsc; );
      o[2] = 0;
    );
    ns = (o[0] * 32) | 0;
    ns != o[1] ? (
      wrap = 0;
      ns >= 32 ? ( o[0] -= 1; ns -= 32; wrap = 1; );
      dsc = ns < 16 ? 1 : -1;
      (ns == 0 || ns == 16) ? dsc = 0;
      dsc *= ng;
      dsc !== 0 ? (
        fr = o[0] * 32 - ns;
        t = fr / (f * 32);
        ts += tb(t) * dsc;
        nx += nb(t) * dsc;
      );
      wrap ? (
        dsc = 4 * f * tg;
        dsc !== 0 ? ( t = o[0] / f; ts += tib(t) * dsc; nx += nib(t) * dsc; );
        o[2] = 1;
      );
    );
    o[1] = ns;
    nx += ng * (o[1] < 16 ? o[1] : 31 - o[1]);
    nx += tg * (o[0] < 0.5 ? 2 * o[0] : 2 - 2 * o[0]);
    ob[k] = ts * (4 / 30) - 1;
    k += 1;
  );
  o[3] = nx; o[4] = f_v;
);
function arp_init() ( arp_mode = 0; arp_note = 0; arp_oct = 0; arp_dir = 1; );
function arp_clock(nn) local(w, oc, nt, go, done) (
  (nn == 1 && arp_range == 1) ? ( arp_note = arp_oct = 0; ) :
  arp_mode == 3 ? (
    go = 1;
    while (go) (
      w = rword();
      oc = floor(w / 16) % arp_range;
      nt = floor(w / 1048576) % nn;
      (oc != arp_oct || nt != arp_note) ? ( arp_oct = oc; arp_note = nt; go = 0; );
    );
  ) : (
    arp_mode == 0 ? arp_dir = 1;
    arp_mode == 1 ? arp_dir = -1;
    arp_note += arp_dir;
    done = 0;
    while (!done) (
      done = 1;
      (arp_note >= nn || arp_note < 0) ? ( arp_oct += arp_dir; arp_note = arp_dir > 0 ? 0 : nn - 1; );
      (arp_oct >= arp_range || arp_oct < 0) ? (
        arp_oct = arp_dir > 0 ? 0 : arp_range - 1;
        arp_mode == 2 ? (
          arp_dir = -arp_dir;
          arp_note = arp_dir > 0 ? 1 : nn - 2;
          arp_oct = arp_dir > 0 ? 0 : arp_range - 1;
          done = 0;
        );
      );
    );
  );
);
function ct_init() local(i) (
  nes_init(CT_TRI);
  memset(CT_SQ, 0, 5 * 8);
  i = 0; loop(4, ssq_init(CT_SQ + i * 8); i += 1; );
  cb_init(CB_CT);
  arp_init();
  hq_init(CT_HQ, 12, 0.075, 0);
  ct_envshape = 2; ct_env = 0; ct_aea = 1;
);
function ct_reset() ( cb_reset(CB_CT); );
function ct_render(ob, ab, n) local(f0, shp, clk, rt, pat, oct, nf0, j, vc, k, sh, dec, aea) (
  f0 = note_freq(ep_note);
  shp = ep_morph * 0.995;
  clk = !(ep_trig & 2);
  rt = 1;
  ep_env = clk;
  clk ? (
    (ep_trig & 1) ? (
      cb_set(CB_CT, ep_harm);
      cb_sort(CB_CT);
      pat = hq_proc(CT_HQ, 0, ep_timbre);
      arp_mode = floor(pat / 3);
      arp_range = 2 ^ (pat % 3);
      arp_clock(CB_CT[49 + CB_CT[4]]);
      ct_env = 1;
    );
    oct = 2 ^ arp_oct;
    nf0 = f0 * CB_CT[60 + arp_note] * oct;
    rt = oct;
    ssq_render(CT_SQ, nf0, shp, ob, n);
  ) : (
    cb_set(CB_CT, ep_harm);
    cb_inversion(CB_CT, ep_timbre);
    j = 1; loop(2, CH_NA[j] = -CH_NA[j]; j += 2; );
    memset(ob, 0, n);
    vc = 0;
    loop(5,
      ssq_render(CT_SQ + vc * 8, f0 * CH_NR[vc], shp, ab, n);
      k = 0; loop(n, ob[k] += ab[k] * CH_NA[vc]; k += 1; );
      vc += 1;
    );
  );
  nes_render(CT_TRI, f0 * 0.5 * rt, ab, n);
  ct_envshape != 2 ? (
    sh = abs(ct_envshape);
    dec = 1 - 2 / SR_K * s2r(60 * sh) * sh;
    aea = clamp(ct_envshape * 20, 0, 1);
    k = 0;
    loop(n,
      ct_aea += 0.01 * (aea - ct_aea);
      ct_env *= dec;
      ob[k] *= ct_env;
      ab[k] *= 1 + ct_aea * (ct_env - 1);
      k += 1;
    );
  );
);

// ---------------------------------------------------------------------- engine dispatch

function eng_set(i, env, og, ag) ( EPOST[i * 3] = env; EPOST[i * 3 + 1] = og; EPOST[i * 3 + 2] = ag; );
eng_set(0, 0, 1, 1); eng_set(1, 0, 0.7, 0.7); eng_set(2, 1, 1, 1); eng_set(3, 1, 1, 1); eng_set(4, 1, 1, 1);
eng_set(5, 0, 0.7, 0.7); eng_set(6, 0, 0.8, 0.8); eng_set(7, 0, 0.5, 0.5);
eng_set(8, 0, 0.8, 0.8); eng_set(9, 0, 0.7, 0.6); eng_set(10, 0, 0.6, 0.6); eng_set(11, 0, 0.7, 0.6);
eng_set(12, 0, 0.8, 0.8); eng_set(13, 0, 0.6, 0.6); eng_set(14, 0, 0.8, 0.8); eng_set(15, 0, -0.7, 0.8);
eng_set(16, 0, -3, 1); eng_set(17, 0, -1, -1); eng_set(18, 0, -2, 1); eng_set(19, 1, -1, 0.8);
eng_set(20, 1, -1, 0.8); eng_set(21, 1, 0.8, 0.8); eng_set(22, 1, 0.8, 0.8); eng_set(23, 1, 0.8, 0.8);

function engines_init() (
  va_init(); ws_init(); fm_init(); gr_init(); ad_init(); wt_init(); ch_init(); sp_init();
  str_init(); md_init(); bd_init(); sd_init(); hh_init(); nz_init(); pt_init();
  vf_init(); pd_init(); six_init(); wtr_init(); sm_init(); ct_init();
);

function engine_reset(e) (
  (e >= 2 && e <= 4) ? six_load(e - 2) :
  e == 6 ? sm_reset() :
  e == 7 ? ct_reset() :
  e == 12 ? ad_reset() :
  e == 13 ? wt_load() :
  e == 14 ? ch_reset() :
  e == 15 ? wb_reset() :
  e == 16 ? sw_reset() :
  e == 18 ? pt_reset() :
  e == 19 ? str_reset() :
  e == 20 ? md_reset();
);

function engine_render(e, ob, ab, n) (
  e == 0 ? vf_render(ob, ab, n) :
  e == 1 ? pd_render(ob, ab, n) :
  (e >= 2 && e <= 4) ? six_render(ob, ab, n) :
  e == 5 ? wtr_render(ob, ab, n) :
  e == 6 ? sm_render(ob, ab, n) :
  e == 7 ? ct_render(ob, ab, n) :
  e == 8 ? va_render(ob, ab, n) :
  e == 9 ? ws_render(ob, ab, n) :
  e == 10 ? fm_render(ob, ab, n) :
  e == 11 ? gr_render(ob, ab, n) :
  e == 12 ? ad_render(ob, ab, n) :
  e == 13 ? wt_render(ob, ab, n) :
  e == 14 ? ch_render(ob, ab, n) :
  e == 15 ? sp_render(ob, ab, n) :
  e == 16 ? sw_render(ob, ab, n) :
  e == 17 ? nz_render(ob, ab, n) :
  e == 18 ? pt_render(ob, ab, n) :
  e == 19 ? st_render(ob, ab, n) :
  e == 20 ? md_render(ob, ab, n) :
  e == 21 ? bd_render(ob, ab, n) :
  e == 22 ? sd_render(ob, ab, n) :
  e == 23 ? hh_render(ob, ab, n) :
  ( memset(ob, 0, n); memset(ab, 0, n); );
);

// ---------------------------------------------------------------------- voice

LPGF0 = alloc(5); LPGF1 = alloc(5); EHQ = alloc(5); OCTQ = alloc(5);

function post_init() ( lpg_pg0 = 0; lpg_pg1 = 0; svf_init(LPGF0); svf_init(LPGF1); lim0 = 0.5; lim1 = 0.5; );

function post_process(ch, gn, byp, lg, lf, lh, ib, n) local(k, s, pg, g_v, g_i, f, lpv, pre, f0, f1, f2, f3, f4, hpv, bpv) (
  gn < 0 ? (
    pre = -gn;
    k = 0;
    loop(n,
      s = ib[k] * pre;
      ch ? ( lim1 += (abs(s) - lim1 > 0 ? 0.05 : 0.00002) * (abs(s) - lim1); ib[k] = s * (lim1 <= 1 ? 1 : 1 / lim1) * 0.8; )
         : ( lim0 += (abs(s) - lim0 > 0 ? 0.05 : 0.00002) * (abs(s) - lim0); ib[k] = s * (lim0 <= 1 ? 1 : 1 / lim0) * 0.8; );
      k += 1;
    );
  );
  pg = (gn < 0 ? 1 : gn) * -32767;
  !byp ? (
    f = ch ? LPGF1 : LPGF0;
    g_v = ch ? lpg_pg1 : lpg_pg0;
    g_i = (pg * lg - g_v) / n;
    svf_set(f, tan_dirty(lf), 0.4);
    f0 = f[0]; f1 = f[1]; f2 = f[2]; f3 = f[3]; f4 = f[4];
    k = 0;
    loop(n,
      g_v += g_i;
      s = ib[k] * g_v;
      hpv = (s - f1 * f3 - f0 * f3 - f4) * f2;
      bpv = f0 * hpv + f3;
      f3 = f0 * hpv + bpv;
      lpv = f0 * bpv + f4;
      f4 = f0 * bpv + lpv;
      ib[k] = lpv + (s - lpv) * lh;
      k += 1;
    );
    f[3] = f3; f[4] = f4;
    ch ? lpg_pg1 = g_v : lpg_pg0 = g_v;
  ) : (
    k = 0; loop(n, ib[k] *= pg; k += 1; );
  );
);

function voice_init() (
  engines_init();
  hq_init(EHQ, 24, 0.05, 1);
  hq_init(OCTQ, 9, 0.01, 0);
  prev_engine = -1;
  post_init();
  dec_v = 0;
  lpg_vs = 0; lpg_g = 1; lpg_f = 0.5; lpg_hf = 0; lpg_up = 0;
  trig_state = 0;
  prev_note = 0;
  memset(TRD, 0, 8); trd_wp = 0;
);

function lpg_lp(lev, sd, dt, hf) local(err, v2, v4, tl, t2, coef) (
  err = lev - lpg_vs;
  v2 = lpg_vs * lpg_vs;
  v4 = v2 * v2;
  tl = 1 - lpg_vs;
  t2 = tl * tl;
  coef = err > 0 ? 0.6 : sd + (1 - v4) * dt;
  lpg_vs += coef * err;
  lpg_g = lpg_vs;
  lpg_f = 0.003 + 0.3 * v4 + hf * 0.04;
  lpg_hf = (t2 + (1 - t2) * hf) * hf * hf;
);

function voice_render(n) local(tv, prevts, e, rise, nt, sdec, clev, use_env, iea, ieat, amt, mv, byp, hf, dtail, att) (
  TRD[trd_wp] = m_trig;
  trd_wp = (trd_wp + 7) % 8;
  tv = TRD[(trd_wp + 5) % 8];
  prevts = trig_state;
  !prevts ? (
    tv > 0.3 ? (
      trig_state = 1;
      !m_levelp ? lpg_up = 1;
      dec_v = 1;
    );
  ) : (
    tv < 0.1 ? trig_state = 0;
  );
  e = hq_proc(EHQ, pt_engine, 0);
  (e != prev_engine) ? (
    engine_reset(e);
    lim0 = 0.5;
    prev_engine = e;
  );
  rise = trig_state && !prevts;
  nt = (m_note + prev_note) * 0.5;
  prev_note = m_note;
  m_trigp ? ep_trig = (rise ? 1 : 0) | (trig_state ? 4 : 0) : ep_trig = 2;
  sdec = (200 * BS) / SR_K * s2r(-96 * pt_decay);
  dec_v *= 1 - sdec * 2;
  clev = clamp(1.3 * m_level / (0.3 + abs(m_level)), 0, 1);
  ep_accent = m_levelp ? clev : 0.8;
  use_env = m_trigp;
  ep_harm = clamp(pt_harm, 0, 1);
  iea = 1;
  ieat = 1;
  e == 15 ? (
    iea = clamp(2 - ep_harm * 6, 0, 1);
    sp_prosody = !m_trigp ? 0 : pt_fmamt;
    sp_speed = !m_trigp ? 0 : pt_moramt;
  ) : e == 7 ? (
    m_trigp ? ( ieat = 0; ct_envshape = 0.051 + 0.949 * (1 - pt_decay) ^ 1.5; ) : ct_envshape = 2;
  );
  amt = pt_fmamt; amt *= max(abs(amt) - 0.05, 0.05); amt *= 1.05;
  mv = use_env ? iea * dec_v * dec_v * 48 : 1;
  ep_note = clamp(pt_note + nt + amt * mv, -119, 120);
  amt = pt_timamt; amt *= max(abs(amt) - 0.05, 0.05); amt *= 1.05;
  mv = use_env ? ieat * dec_v : 0;
  ep_timbre = clamp(pt_timbre + amt * mv, 0, 1);
  amt = pt_moramt; amt *= max(abs(amt) - 0.05, 0.05); amt *= 1.05;
  mv = use_env ? iea * dec_v : 0;
  ep_morph = clamp(pt_morph + amt * mv, 0, 1);
  ep_env = EPOST[e * 3];
  engine_render(e, OUTE, AUXE, n);
  byp = ep_env || (!m_levelp && !m_trigp);
  !byp ? (
    hf = pt_colour;
    dtail = (20 * BS) / SR_K * s2r(-72 * pt_decay + 12 * hf) - sdec;
    m_levelp ? lpg_lp(clev, sdec, dtail, hf) : (
      att = note_freq(ep_note) * BS * 2;
      lpg_up ? (
        lpg_vs += att;
        lpg_vs >= 1 ? ( lpg_vs = 1; lpg_up = 0; );
      );
      lpg_lp(lpg_up ? lpg_vs : 0, sdec, dtail, hf);
    );
  ) : (
    lpg_vs = 0; lpg_g = 1; lpg_f = 0.5; lpg_hf = 0; lpg_up = 0;
  );
  post_process(0, EPOST[e * 3 + 1], byp, lpg_g, lpg_f, lpg_hf, OUTE, n);
  post_process(1, EPOST[e * 3 + 2], byp, lpg_g, lpg_f, lpg_hf, AUXE, n);
);

// ---------------------------------------------------------------------- module glue

function engine_init() (
  rng = 33;
  voice_init();
  sm_freq = p_freq; sm_harm = p_harm; sm_tim = p_timbre; sm_mor = p_morph;
  sm_fm = p_fmamt; sm_ta = p_timamt; sm_ma = p_moramt; sm_dec = p_decay; sm_col = p_colour;
  pitch_lp = 0;
  note_cv = 0;
  m_level = 0;
  gate = 0;
  held = 0;
  retrig = 0;
);

function engine_block() local(r) (
  sm_freq += 0.005 * (p_freq - sm_freq);
  sm_harm += 0.005 * (p_harm - sm_harm);
  sm_tim += 0.01 * (p_timbre - sm_tim);
  sm_mor += 0.01 * (p_morph - sm_mor);
  sm_fm += 0.005 * (p_fmamt - sm_fm);
  sm_ta += 0.005 * (p_timamt - sm_ta);
  sm_ma += 0.005 * (p_moramt - sm_ma);
  sm_dec += 0.01 * (p_decay - sm_dec);
  sm_col += 0.01 * (p_colour - sm_col);
  pt_harm = sm_harm; pt_timbre = sm_tim; pt_morph = sm_mor;
  pt_fmamt = sm_fm; pt_timamt = sm_ta; pt_moramt = sm_ma;
  pt_decay = sm_dec; pt_colour = sm_col;
  pt_engine = p_model;
  r = p_range;
  r == 0 ? pt_note = -48.37 + sm_freq * 60 :
  r == 9 ? pt_note = 53 + sm_freq * 14 + 12 * (hq_proc(OCTQ, 0, 0.5 * sm_freq + 0.5) - 4) :
  r == 10 ? pt_note = 60 + sm_freq * 48 :
  pt_note = sm_freq * 7 + r * 12;
  pitch_lp += 0.7 * ((note_cv + bend) - pitch_lp);
  m_note = pitch_lp;
  m_trig = (gate && !retrig) ? 1 : 0;
  retrig = 0;
  m_trigp = p_play < 1.5;
  m_levelp = p_play >= 0.5 && p_play < 1.5;
  voice_render(BS);
);

WROT_C = cos($pi / 4.5);
WROT_S = sin($pi / 4.5);

function host_setup() (
  bypass = abs(srate - SR_E) < 0.01;
  up_step = SR_E / srate;
  host_lat = bypass ? BS : ceil((BS + 10) / up_step);
  eo_n = 0;
  hin = 0;
  bpos = 0;
  memset(EOR, 0, 4 * 4096);
);

mq_n = mq_r = mq_w = 0;
bend = 0;
out_g = 10 ^ (p_out / 20);

@slider

last_srate != srate ? (
  last_srate = srate;
  engine_init();
  host_setup();
);

@block

while ((mlen = midirecv_buf(mofs, MBUF, 3)) > 0) (
  mst = MBUF[0] & 0xF0;
  (mlen == 3 && mq_n < 256 && (mst == 0x90 || mst == 0x80)) ? (
    MQ[mq_w * 4] = hin + mofs;
    MQ[mq_w * 4 + 1] = (mst == 0x90 && MBUF[2] > 0) ? 1 : 0;
    MQ[mq_w * 4 + 2] = MBUF[1];
    MQ[mq_w * 4 + 3] = MBUF[2];
    mq_w = (mq_w + 1) & 255;
    mq_n += 1;
  ) : (mlen == 3 && mst == 0xE0) ? (
    bend = ((MBUF[2] * 128 + MBUF[1]) - 8192) / 8192 * 2;
  );
);
out_t = 10 ^ (p_out / 20);
gn_c = 1 - exp(-1 / (0.005 * srate));
pdc_bot_ch = 0;
pdc_top_ch = 0;
pdc_delay = 0;

@sample

while (mq_n > 0 && MQ[mq_r * 4] <= hin) (
  MQ[mq_r * 4 + 1] ? (
    gate ? retrig = 1;
    gate = 1;
    held += 1;
    note_cv = MQ[mq_r * 4 + 2] - 60;
    m_level = MQ[mq_r * 4 + 3] / 127;
  ) : (
    held = max(0, held - 1);
    held == 0 ? ( gate = 0; m_level = 0; );
  );
  mq_r = (mq_r + 1) & 255;
  mq_n -= 1;
);
out_g += gn_c * (out_t - out_g);
bypass ? (
  vo = OUTE[bpos];
  va = AUXE[bpos];
  bpos += 1;
  bpos >= BS ? ( bpos = 0; engine_block(); );
) : (
  ut = hin * up_step;
  while (eo_n <= ut + 9) (
    engine_block();
    k = 0;
    loop(BS,
      eix = (eo_n & 4095) * 2;
      EOR[eix] = EOR[eix + 8192] = OUTE[k];
      EOR[eix + 1] = EOR[eix + 8193] = AUXE[k];
      eo_n += 1; k += 1;
    );
  );
  mi = floor(ut);
  mf = ut - mi;
  vo = va = 0;
  mi >= 3 ? (
    ep = EOR + ((mi - 3) & 4095) * 2;
    x = mf + 3;
    ss0 = sin($pi * x);
    wc = cos($pi * x / 4.5);
    ws = sin($pi * x / 4.5);
    loop(8,
      kv = abs(x) < 0.000001 ? 1 : ss0 / ($pi * x) * (0.5 + 0.5 * wc);
      vo += ep[0] * kv;
      va += ep[1] * kv;
      ep += 2;
      x -= 1;
      ss0 = -ss0;
      wt = wc * WROT_C + ws * WROT_S;
      ws = ws * WROT_C - wc * WROT_S;
      wc = wt;
    );
  ) : (
    j = -3;
    loop(8,
      mm = mi + j;
      x = mf - j;
      kv = abs(x) < 0.000001 ? 1 : sin($pi * x) / ($pi * x) * (0.5 + 0.5 * cos($pi * x / 4.5));
      mm >= 0 ? (
        vo += EOR[(mm & 4095) * 2] * kv;
        va += EOR[(mm & 4095) * 2 + 1] * kv;
      );
      j += 1;
    );
  );
);
!tables_ok ? ( vo = va = 0; );
hin += 1;
dbg_o = vo; dbg_a = va;
vo /= 32768;
va /= 32768;
p_output < 0.5 ? ( spl0 = spl1 = vo; ) : p_output < 1.5 ? ( spl0 = spl1 = va; ) : ( spl0 = vo; spl1 = va; );
spl0 = max(-1, min(1, spl0)) * out_g;
(hin & 1) ? ( SCO[sco_w] = spl0; sco_w = (sco_w + 1) & 511; );
spl1 = max(-1, min(1, spl1)) * out_g;

@gfx 900 636

DW = 900;
DH = 636;
scale = max(0.5, min(gfx_w / DW, gfx_h / DH));
ox = floor((gfx_w - DW*scale) * 0.5);
oy = 0;

function automate(s, end_touch)
(
<?
  max_sliders > 14 ? printf("slider_automate(2^(s-1), end_touch);") :
    loop(i = 1; 14,
      printf("  s == %d ? slider_automate(slider%d, end_touch) :\n", i, i);
      i += 1;
    );
?> 0;
);

function set_slider(s, v) ( slider(s) = v; automate(s, 0); automate(s, 1); );

function hit_circle(mx, my, cx, cy, rad) ( sqr(mx - cx) + sqr(my - cy) <= sqr(rad); );

function hit_rect(mx, my, x, y, w, h) ( mx >= x && mx <= x+w && my >= y && my <= y+h; );

function px(x) ( ox + x*scale; );

function py(y) ( oy + y*scale; );

function ctext(str, cx, y, fs, fl)
local(tw, th)
(
  gfx_setfont(1, "Arial", fs*scale, fl);
  gfx_measurestr(str, tw, th);
  gfx_x = cx - tw*0.5; gfx_y = y;
  gfx_drawstr(str);
);

function rosette(cx, cy, r0)
local(i, a, r1)
(
  i = 0;
  loop(60,
    a = i * 2 * $pi / 60;
    r1 = r0 * ((i & 1) ? 1.20 : 1.12);
    gfx_set(0.45, 0.46, 0.48, (i & 1) ? 0.30 : 0.18);
    gfx_line(cx + sin(a)*r0*1.04, cy - cos(a)*r0*1.04, cx + sin(a)*r1, cy - cos(a)*r1, 1);
    gfx_circle(cx + sin(a + 0.05)*r0*1.26, cy - cos(a + 0.05)*r0*1.26, max(1, 1.2*scale), 0, 1);
    i += 1;
  );
);

function led(cx, cy, r, g, b, on)
(
  gfx_set(0.55, 0.55, 0.56, 1);
  gfx_circle(cx, cy, 6*scale, 1, 1);
  on ? (
    gfx_set(r, g, b, 0.35); gfx_circle(cx, cy, 9*scale, 1, 1);
    gfx_set(r, g, b, 1);
  ) : gfx_set(0.93, 0.93, 0.92, 1);
  gfx_circle(cx, cy, 5*scale, 1, 1);
  gfx_set(1, 1, 1, 0.6);
  gfx_circle(cx - 1.5*scale, cy - 1.5*scale, 1.6*scale, 1, 1);
);

function round_btn(s, cx, cy)
local(hov)
(
  hov = hit_circle(mouse_x, mouse_y, cx, cy, 13*scale);
  hov ? hov_s = s;
  gfx_set(0.55, 0.55, 0.57, 1);
  gfx_circle(cx, cy, 13*scale, 1, 1);
  gfx_set(0.08, 0.08, 0.09, 1);
  gfx_circle(cx, cy, 11*scale, 1, 1);
  gfx_set(hov ? 0.24 : 0.17, hov ? 0.24 : 0.17, hov ? 0.26 : 0.19, 1);
  gfx_circle(cx - scale, cy - scale, 7*scale, 1, 1);
  mouse_just_down && hov;
);

function dark_btn(s, x, y, w, h, label, act, fs)
local(tw, th, hov)
(
  hov = hit_rect(mouse_x, mouse_y, x, y, w, h);
  hov ? hov_s = s;
  gfx_set(0.10, 0.10, 0.11, 1);
  gfx_rect(x - scale, y - scale, w + 2*scale, h + 2*scale, 1);
  act ? gfx_set(0.93, 0.50, 0.16, 1) : gfx_set(hov ? 0.30 : 0.24, hov ? 0.30 : 0.24, hov ? 0.32 : 0.26, 1);
  gfx_rect(x, y, w, h, 1);
  gfx_set(1, 1, 1, act ? 0.20 : 0.07);
  gfx_rect(x, y, w, h*0.45, 1);
  gfx_setfont(1, "Arial", fs*scale, 'b');
  act ? gfx_set(0.10, 0.07, 0.04, 1) : gfx_set(0.90, 0.90, 0.91, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + (w - tw)*0.5; gfx_y = y + (h - th)*0.5;
  gfx_drawstr(label);
  mouse_just_down && hov;
);

function navy_box(x, y, w, h)
(
  gfx_set(0.10, 0.13, 0.20, 1);
  gfx_roundrect(x - scale, y - scale, w + 2*scale, h + 2*scale, 9*scale, 1);
  gfx_set(0.18, 0.23, 0.34, 1);
  gfx_rect(x + 6*scale, y, w - 12*scale, h, 1);
  gfx_rect(x, y + 6*scale, w, h - 12*scale, 1);
  gfx_circle(x + 6*scale, y + 6*scale, 6*scale, 1, 1);
  gfx_circle(x + w - 7*scale, y + 6*scale, 6*scale, 1, 1);
  gfx_circle(x + 6*scale, y + h - 7*scale, 6*scale, 1, 1);
  gfx_circle(x + w - 7*scale, y + h - 7*scale, 6*scale, 1, 1);
);

function screw(cx, cy)
(
  gfx_set(0.62, 0.62, 0.63, 1); gfx_circle(cx, cy, 6*scale, 1, 1);
  gfx_set(0.93, 0.93, 0.93, 1); gfx_circle(cx, cy, 4.5*scale, 1, 1);
  gfx_set(0.55, 0.55, 0.57, 1);
  gfx_line(cx - 3*scale, cy - 3*scale, cx + 3*scale, cy + 3*scale, 1);
);

function ck_draw(cx, cy, rad, pos, cr, cg, cb)
local(ang0, ang1, ang, i, a, sa, ca, rr)
(
  ang0 = -2.35619;
  ang1 = 2.35619;
  gfx_set(0, 0, 0, 0.18);
  gfx_circle(cx + rad*0.06, cy + rad*0.10, rad*1.02, 1, 1);
  gfx_set(0.07, 0.07, 0.08, 1);
  gfx_circle(cx, cy, rad, 1, 1);
  i = 0;
  loop(36,
    a = i * 2 * $pi / 36;
    gfx_set(0.20, 0.20, 0.22, 1);
    gfx_line(cx + sin(a)*rad*0.80, cy - cos(a)*rad*0.80, cx + sin(a)*rad*0.97, cy - cos(a)*rad*0.97, 1);
    i += 1;
  );
  gfx_set(0.13, 0.13, 0.14, 1);
  gfx_circle(cx, cy, rad*0.76, 1, 1);
  ang = ang0 + (ang1 - ang0) * pos;
  sa = sin(ang); ca = cos(ang);
  rr = rad*0.08;
  i = 0;
  loop(7,
    a = (i - 3) / 3 * rr;
    gfx_set(cr*0.9 + 0.08, cg*0.9 + 0.08, cb*0.9 + 0.08, 1);
    gfx_line(cx + sa*rad*0.50 + ca*a, cy - ca*rad*0.50 + sa*a, cx + sa*rad*0.96 + ca*a, cy - ca*rad*0.96 + sa*a, 1);
    i += 1;
  );
  gfx_set(cr*0.6, cg*0.6, cb*0.6, 1);
  gfx_circle(cx, cy, rad*0.58, 1, 1);
  gfx_set(cr, cg, cb, 1);
  gfx_circle(cx, cy, rad*0.55, 1, 1);
  gfx_set(1, 1, 1, 0.16);
  gfx_circle(cx - rad*0.12, cy - rad*0.14, rad*0.32, 1, 1);
);

function s_min(s) ( (s == 2 || s == 6 || s == 7 || s == 8) ? -1 : s == 14 ? -24 : 0; );
function s_max(s) ( s == 14 ? 12 : 1; );
function s_step(s) ( s == 14 ? 0.1 : 0.001; );
function def_val(s) ( (s == 2 || s == 6 || s == 7 || s == 8 || s == 14) ? 0 : 0.5; );
function norm_of(s) ( (slider(s) - s_min(s)) / (s_max(s) - s_min(s)); );
function set_norm(s, v) local(old, st) (
  old = slider(s);
  st = s_step(s);
  slider(s) = floor((s_min(s) + v * (s_max(s) - s_min(s))) / st + 0.5) * st;
  slider(s) !== old ? automate(s, 0);
);

function note_name(n, buf) local(pc, oc) (
  n = floor(n + 0.5);
  pc = n % 12; pc < 0 ? pc += 12;
  oc = floor(n / 12) - 1;
  strcpy(buf, pc == 0 ? "C" : pc == 1 ? "C#" : pc == 2 ? "D" : pc == 3 ? "D#" : pc == 4 ? "E" : pc == 5 ? "F" :
              pc == 6 ? "F#" : pc == 7 ? "G" : pc == 8 ? "G#" : pc == 9 ? "A" : pc == 10 ? "A#" : "B");
  sprintf(#nn_tmp, "%d", oc);
  strcat(buf, #nn_tmp);
  buf;
);

function model_tag(m) (
  m == 0 ? "VCF" : m == 1 ? "PD" : m == 2 ? "DX 1" : m == 3 ? "DX 2" : m == 4 ? "DX 3" : m == 5 ? "TERR" : m == 6 ? "STRM" : m == 7 ? "8BIT" :
  m == 8 ? "VA" : m == 9 ? "FOLD" : m == 10 ? "FM" : m == 11 ? "GRAIN" : m == 12 ? "ADD" : m == 13 ? "WAVE" : m == 14 ? "CHORD" : m == 15 ? "SPEAK" :
  m == 16 ? "SWARM" : m == 17 ? "NOISE" : m == 18 ? "DUST" : m == 19 ? "STRING" : m == 20 ? "MODAL" : m == 21 ? "KICK" : m == 22 ? "SNARE" : "HAT";
);
function model_long(m) (
  m == 0 ? "VIRTUAL ANALOG + FILTER" : m == 1 ? "PHASE DISTORTION" : m == 2 ? "6-OP FM · BANK 1" : m == 3 ? "6-OP FM · BANK 2" :
  m == 4 ? "6-OP FM · BANK 3" : m == 5 ? "WAVE TERRAIN" : m == 6 ? "STRING MACHINE" : m == 7 ? "CHIPTUNE" :
  m == 8 ? "VIRTUAL ANALOG" : m == 9 ? "WAVESHAPING" : m == 10 ? "TWO-OP FM" : m == 11 ? "GRANULAR FORMANT" :
  m == 12 ? "ADDITIVE" : m == 13 ? "WAVETABLE" : m == 14 ? "CHORDS" : m == 15 ? "SPEECH" :
  m == 16 ? "SWARM" : m == 17 ? "FILTERED NOISE" : m == 18 ? "PARTICLE NOISE" : m == 19 ? "INHARMONIC STRING" :
  m == 20 ? "MODAL RESONATOR" : m == 21 ? "BASS DRUM" : m == 22 ? "SNARE DRUM" : "HI-HAT";
);
function model_hts(m, w) (
  w == 0 ? (
    m == 0 ? "resonance" : m == 1 ? "mod ratio" : (m >= 2 && m <= 4) ? "patch" : m == 5 ? "terrain" : m == 6 ? "chord" : m == 7 ? "chord" :
    m == 8 ? "detune" : m == 9 ? "shaper" : m == 10 ? "ratio" : m == 11 ? "formant ratio" : m == 12 ? "bumps" : m == 13 ? "bank" :
    m == 14 ? "chord" : m == 15 ? "mode / words" : m == 16 ? "detune" : m == 17 ? "LP-BP-HP" : m == 18 ? "spread" : m == 19 ? "material" :
    m == 20 ? "material" : m == 21 ? "punch / drive" : m == 22 ? "snappy" : "noisiness";
  ) : w == 1 ? (
    m == 0 ? "cutoff" : m == 1 ? "amount" : (m >= 2 && m <= 4) ? "brightness" : m == 5 ? "path size" : m == 6 ? "chorus / filter" : m == 7 ? (p_play < 1.5 ? "arp pattern" : "inversion") :
    m == 8 ? "square / sync" : m == 9 ? "fold" : m == 10 ? "index" : m == 11 ? "formant" : m == 12 ? "peak harmonic" : m == 13 ? "row" :
    m == 14 ? "inversion" : m == 15 ? "species" : m == 16 ? "density" : m == 17 ? "clock" : m == 18 ? "density" : m == 19 ? "brightness" :
    m == 20 ? "brightness" : m == 21 ? "tone" : m == 22 ? "tone" : "tone";
  ) : (
    m == 0 ? "wave / sub" : m == 1 ? "asymmetry" : (m >= 2 && m <= 4) ? "env time" : m == 5 ? "path offset" : m == 6 ? "waveform" : m == 7 ? "pulse / sync" :
    m == 8 ? "saw shape" : m == 9 ? "asymmetry" : m == 10 ? "feedback" : m == 11 ? "shape" : m == 12 ? "slope" : m == 13 ? "column" :
    m == 14 ? "waveform" : m == 15 ? "phoneme / word" : m == 16 ? "grain size" : m == 17 ? "resonance" : m == 18 ? "filter / diffuse" : m == 19 ? "decay" :
    m == 20 ? "decay" : m == 21 ? "decay" : m == 22 ? "decay" : "decay";
  );
);

function sp_words() ( p_model == 15 && p_play < 1.5 && p_harm > 1 / 3; );
function knob_name(s) (
  s == 2 ? "FREQUENCY" : s == 3 ? "HARMONICS" : s == 4 ? "TIMBRE" : s == 5 ? "MORPH" :
  s == 6 ? (sp_words() ? "PROSODY" : "ENV→PITCH") :
  s == 7 ? ((p_model == 7 && p_play < 1.5) ? "(UNUSED)" : "ENV→TIMBRE") :
  s == 8 ? (sp_words() ? "SPEED" : "ENV→MORPH") :
  s == 9 ? ((p_model == 7 && p_play < 1.5) ? "NOTE LENGTH" : "DECAY") : s == 10 ? "COLOUR" : "OUTPUT";
);

function hint_text(s) local(m) (
  m = p_model;
  s == 2 ? "Frequency: fine tuning within the Range (or the pitch itself when Range is Full)" :
  s == 3 ? (strcpy(#ht, "Harmonics: "); strcat(#ht, model_hts(m, 0)); #ht) :
  (s == 4 && m == 7 && p_play < 1.5) ? "Timbre: arpeggio pattern; each note you play steps once through the Harmonics chord" :
  s == 4 ? (strcpy(#ht, "Timbre: "); strcat(#ht, model_hts(m, 1)); #ht) :
  s == 5 ? (strcpy(#ht, "Morph: "); strcat(#ht, model_hts(m, 2)); #ht) :
  s == 6 ? (sp_words() ? "Prosody: how much the words keep their original intonation (right) or follow the played pitch" :
            "Env→Pitch: how much each note's envelope sweeps the pitch (left = downwards); in Drone it offsets the pitch") :
  s == 7 ? ((p_model == 7 && p_play < 1.5) ? "Not used by 8BIT when playing notes (Timbre picks the arpeggio pattern)" :
            "Env→Timbre: how much each note's envelope moves Timbre (left = inverted)") :
  s == 8 ? (sp_words() ? "Speed: how fast the words are spoken" : "Env→Morph: how much each note's envelope moves Morph (left = inverted)") :
  s == 9 ? ((p_model == 7 && p_play < 1.5) ? "Note length: how long each 8BIT note lasts (fully right holds)" :
            "LPG Decay: how long the low-pass gate rings after each note (drums, strings, DX and speech words have their own)") :
  s == 10 ? "LPG Colour: low-pass gate response, from a VCA (left) to a lowpass gate that opens and closes" :
  s == 14 ? "Output: overall level" :
  s == 1 ? "Model: click a tag. Orange = newer bank, teal = pitched, pink = noise, physical models and drums" :
  s == 11 ? "Range: Full sweeps C0-C5 with the knob; the others put MIDI notes at pitch (C4 ±7 is standard)" :
  s == 12 ? "Play: Ping plucks the low-pass gate on each note, Gate + Velocity holds it open with velocity, Drone plays continuously" :
  s == 13 ? "Output: the main OUT, the alternative AUX output, or both in stereo" :
  s == 15 ? "Click a key to play a note" :
  "Drag or scroll a knob to adjust  ·  Ctrl for fine control  ·  double-click to reset";
);

function ptext(s) local(v) (
  v = slider(s);
  s == 2 ? (
    p_range == 0 ? note_name(-48.37 + v * 60, #ptxt) : sprintf(#ptxt, "%+.1f st", p_range == 10 ? v * 48 : v * 7);
  ) :
  (s == 6 || s == 7 || s == 8) ? sprintf(#ptxt, "%+d%%", floor(v * 100 + (v < 0 ? -0.5 : 0.5))) :
  s == 14 ? sprintf(#ptxt, "%+.1f dB", v) :
  sprintf(#ptxt, "%d%%", floor(100 * v + 0.5));
  #ptxt;
);

function knob_at(s, cx, cy, rad, sz) local(hov, v, act) (
  hov = hit_circle(mouse_x, mouse_y, cx, cy, rad + 4*scale);
  hov ? hov_s = s;
  (mouse_just_down && hov) ? (
    (click_target == s && time_precise() - click_time < 0.3) ? ( set_slider(s, def_val(s)); drag_target = 0; ) :
    ( drag_target = s; drag_y0 = mouse_y; drag_v0 = norm_of(s); drag_fine = mouse_cap & 4; );
    click_target = s; click_time = time_precise();
    mouse_just_down = 0;
  );
  (hov && wheel != 0 && drag_target == 0) ? (
    v = norm_of(s) + (wheel / 120) * ((mouse_cap & 4) ? 0.002 : 0.02);
    set_norm(s, max(0, min(1, v)));
    automate(s, 1);
    wheel = 0;
  );
  ck_draw(cx, cy, rad, norm_of(s), 0.97, 0.97, 0.96);
  act = hov || drag_target == s;
  gfx_set(0.12, 0.12, 0.13, 1);
  ctext(knob_name(s), cx, cy + rad + (sz >= 2 ? 10 : 6)*scale, sz >= 2 ? 15 : sz == 1 ? 13 : 11, 'b');
  gfx_set(act ? 0.78 : 0.34, act ? 0.42 : 0.35, act ? 0.10 : 0.38, 1);
  ctext(ptext(s), cx, cy + rad + (sz >= 2 ? 29 : sz == 1 ? 24 : 20)*scale, sz >= 1 ? 12 : 11, 0);
  sz == 0 ? (
    gfx_set(0.12, 0.12, 0.13, 1);
    gfx_setfont(1, "Arial", 13*scale, 'b');
    gfx_x = cx - rad - 12*scale; gfx_y = cy - rad - 6*scale; gfx_drawstr("-");
    gfx_x = cx + rad + 4*scale; gfx_y = cy - rad - 6*scale; gfx_drawstr("+");
  );
);

function rr_fill(x, y, w, h, r) (
  x = floor(x + 0.5); y = floor(y + 0.5); w = floor(w + 0.5); h = floor(h + 0.5); r = max(1, floor(r + 0.5));
  gfx_rect(x + r, y, w - 2*r, h, 1);
  gfx_rect(x, y + r, r, h - 2*r, 1);
  gfx_rect(x + w - r, y + r, r, h - 2*r, 1);
  gfx_circle(x + r, y + r, r, 1, 1);
  gfx_circle(x + w - r - 1, y + r, r, 1, 1);
  gfx_circle(x + r, y + h - r - 1, r, 1, 1);
  gfx_circle(x + w - r - 1, y + h - r - 1, r, 1, 1);
);

function model_pill(m, cx, cy, cr, cg, cb) local(hov, act, w, h, tw, th, k, cr2, cg2, cb2) (
  w = 52*scale; h = 20*scale;
  hov = hit_rect(mouse_x, mouse_y, cx - w*0.5, cy - h*0.5, w, h);
  hov ? ( hov_s = 1; hov_model = m; );
  act = p_model == m;
  act ? ( cr2 = cr; cg2 = cg; cb2 = cb; ) : ( cr2 = cr*0.45 + 0.45; cg2 = cg*0.45 + 0.45; cb2 = cb*0.45 + 0.45; );
  k = (hov && !act) ? 0.2 : 0;
  gfx_set(cr2 + (1 - cr2)*k, cg2 + (1 - cg2)*k, cb2 + (1 - cb2)*k, 1);
  rr_fill(cx - w*0.5, cy - h*0.5, w, h, 5*scale);
  gfx_setfont(1, "Arial", 11*scale, 'b');
  gfx_set(1, 1, 1, 1);
  gfx_measurestr(model_tag(m), tw, th);
  gfx_x = cx - tw*0.5; gfx_y = cy - th*0.5;
  gfx_drawstr(model_tag(m));
  (mouse_just_down && hov) ? ( set_slider(1, m); mouse_just_down = 0; );
);

function key_down(n) ( (mq_n < 256) ? ( MQ[mq_w * 4] = hin; MQ[mq_w * 4 + 1] = 1; MQ[mq_w * 4 + 2] = n; MQ[mq_w * 4 + 3] = 100; mq_w = (mq_w + 1) & 255; mq_n += 1; ); );
function key_up(n) ( (mq_n < 256) ? ( MQ[mq_w * 4] = hin; MQ[mq_w * 4 + 1] = 0; MQ[mq_w * 4 + 2] = n; MQ[mq_w * 4 + 3] = 0; mq_w = (mq_w + 1) & 255; mq_n += 1; ); );

mouse_down = mouse_cap & 1;
mouse_just_down = mouse_down && !mouse_state;
wheel = mouse_wheel;
mouse_wheel = 0;
hov_s = 0;
hov_model = -1;

OR_R = 0.93; OR_G = 0.55; OR_B = 0.13;
TL_R = 0.13; TL_G = 0.62; TL_B = 0.62;
PK_R = 0.82; PK_G = 0.20; PK_B = 0.45;

function jkb_draw(x, y, w, h, nw, lo, arr, held, decay, ar, ag, ab, al, sc) local(ww, bw, bh, n, wi, pc, isb, kx, kwid, kg, l, i, wr, wg, wb)
(
  ww = w / nw;
  bw = ww * 0.64; bh = h * 0.6;
  i = 1;
  loop(4,
    gfx_set(0, 0, 0, 0.12 * (1 - (i - 1) / 4));
    gfx_roundrect(x - i, y - i + 2 * sc, w + 2 * i, h + 2 * i, 3 * sc + i, 1);
    i += 1;
  );
  gfx_set(0.10, 0.10, 0.11, al);
  gfx_rect(x, y, w, h, 1);
  kg = max(1, floor(sc));
  n = lo; wi = 0;
  while (wi < nw) (
    pc = n % 12;
    isb = pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10;
    !isb ? (
      kx = floor(x + wi * ww) + kg;
      kwid = floor(x + (wi + 1) * ww) - kx;
      l = arr >= 0 ? arr[n] : 0;
      n == held ? l = 1;
      (decay && arr >= 0) ? arr[n] = max(0, arr[n] - 0.08);
      wr = 0.86 + (ar - 0.86) * l; wg = 0.87 + (ag - 0.87) * l; wb = 0.90 + (ab - 0.90) * l;
      gfx_gradrect(kx, y, kwid, h, wr, wg, wb, al, 0, 0, 0, 0, (0.12 - 0.12 * l) / h, (0.12 - 0.12 * l) / h, (0.12 - 0.12 * l) / h, 0);
      gfx_set(0, 0, 0, 0.18 * al); gfx_rect(kx, y, kwid, 2 * sc, 1);
      pc == 0 ? (
        gfx_setfont(1, "Arial", 11 * sc, 'b');
        gfx_set(0.35, 0.36, 0.40, al);
        sprintf(#jkbl, "C%d", floor(n / 12) - 1);
        gfx_measurestr(#jkbl, kwid, l);
        gfx_x = x + wi * ww + (ww - kwid) * 0.5; gfx_y = y + h - 15 * sc;
        gfx_drawstr(#jkbl);
      );
      wi += 1;
    );
    n += 1;
  );
  n = lo; wi = 0;
  while (wi < nw) (
    pc = n % 12;
    isb = pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10;
    isb ? (
      kx = floor(x + wi * ww - bw * 0.5);
      l = arr >= 0 ? arr[n] : 0;
      n == held ? l = 1;
      (decay && arr >= 0) ? arr[n] = max(0, arr[n] - 0.08);
      gfx_set(0, 0, 0, 0.35 * al); gfx_rect(kx + sc, y, bw, bh + 2 * sc, 1);
      l > 0 ? (
        gfx_gradrect(kx, y, bw, bh, 0.08 + (ar * 0.8 - 0.08) * l, 0.085 + (ag * 0.8 - 0.085) * l, 0.095 + (ab * 0.8 - 0.095) * l, al, 0, 0, 0, 0, 0.1 / bh, 0.1 / bh, 0.1 / bh, 0);
      ) : (
        gfx_gradrect(kx, y, bw, bh, 0.08, 0.085, 0.095, al, 0, 0, 0, 0, 0.1 / bh, 0.1 / bh, 0.1 / bh, 0);
        gfx_set(1, 1, 1, 0.10 * al); gfx_rect(kx + 2 * sc, y + bh - 7 * sc, bw - 4 * sc, 5 * sc, 1);
      );
    ) : wi += 1;
    n += 1;
  );
);

// ---------------------------------------------------------------------- panel + header
gfx_set(0.20, 0.20, 0.21, 1);
gfx_rect(0, 0, gfx_w, gfx_h, 1);
gfx_gradrect(px(0), py(0), DW*scale, 602*scale, 0.86, 0.865, 0.87, 1, 0, 0, 0, 0, -0.00007/scale, -0.00007/scale, -0.00006/scale, 0);
bseed = 13;
loop(140,
  bseed = (bseed * 1103 + 12345) % 65536;
  gfx_set(bseed & 1 ? 1 : 0, bseed & 1 ? 1 : 0, bseed & 1 ? 1 : 0, 0.028);
  gfx_rect(px(0), py(bseed / 65536 * 602), DW*scale, max(1, scale), 1);
);
screw(px(14), py(12)); screw(px(DW - 14), py(12));
gfx_set(0.14, 0.14, 0.15, 1);
gfx_rect(px(30), py(10), 30*scale, 30*scale, 0);
gfx_rect(px(31), py(11), 28*scale, 28*scale, 0);
ggi = 0;
loop(3,
  gfx_line(px(36 + ggi * 7), py(15), px(40 + ggi * 7), py(35), 1);
  gfx_line(px(44 + ggi * 7 - 7), py(15), px(40 + ggi * 7 - 7), py(35), 1);
  ggi += 1;
);
gfx_setfont(1, "Arial", 30*scale);
gfx_x = px(70); gfx_y = py(8);
gfx_drawstr("Plait Tectonics");
gfx_measurestr("Plait Tectonics", ttw, tth);
gfx_setfont(1, "Arial", 17*scale);
gfx_x = px(70) + ttw + 16*scale; gfx_y = py(17);
gfx_drawstr("macro oscillator");
gfx_setfont(1, "Arial", 12*scale);
gfx_set(0.36, 0.37, 0.40, 1);
gfx_x = px(71); gfx_y = py(41);
gfx_drawstr("by chmaha  ·  based on Mutable Instruments Plaits");

TABW = 92*scale; TABH = 24*scale;
tx0 = px(DW - 30) - 3*TABW - 8*scale;
dark_btn(12, tx0, py(14), TABW, TABH, "PING", p_play < 0.5, 11) ? ( set_slider(12, 0); mouse_just_down = 0; );
dark_btn(12, tx0 + TABW + 4*scale, py(14), TABW, TABH, "GATE + VEL", p_play >= 0.5 && p_play < 1.5, 11) ? ( set_slider(12, 1); mouse_just_down = 0; );
dark_btn(12, tx0 + 2*(TABW + 4*scale), py(14), TABW, TABH, "DRONE", p_play >= 1.5, 11) ? ( set_slider(12, 2); mouse_just_down = 0; );

BY = py(60);
gfx_set(0.70, 0.71, 0.73, 1);
gfx_rect(px(0), BY, DW*scale, 9*scale, 1);
hi = 0;
loop(DW / 4, gfx_set(0.52, 0.53, 0.56, 1); gfx_line(px(hi*4), BY + 8*scale, px(hi*4 + 6), BY + scale, 1); hi += 1; );
gfx_set(0.97, 0.97, 0.97, 1);
gfx_rect(px(0), BY + 9*scale, DW*scale, max(1, scale), 1);

// ---------------------------------------------------------------------- model matrix
gfx_setfont(1, "Arial", 11*scale, 'b');
gfx_set(OR_R*0.8, OR_G*0.8, OR_B*0.8, 1); ctext("NEW", px(330), py(78), 11, 'b');
gfx_set(TL_R*0.8, TL_G*0.8, TL_B*0.8, 1); ctext("PITCHED", px(396), py(78), 11, 'b');
gfx_set(PK_R*0.8, PK_G*0.8, PK_B*0.8, 1); ctext("NOISE · DRUMS", px(512), py(78), 11, 'b');
r = 0;
loop(8,
  cy = py(106 + r * 30);
  model_pill(r, px(330), cy, OR_R, OR_G, OR_B);
  model_pill(8 + r, px(396), cy, TL_R, TL_G, TL_B);
  model_pill(16 + r, px(512), cy, PK_R, PK_G, PK_B);
  lon = (p_model % 8) == r;
  bk = floor(p_model / 8);
  led(px(454), cy, bk == 0 ? OR_R : bk == 1 ? 0.45 : 0.95, bk == 0 ? OR_G : bk == 1 ? 0.92 : 0.25, bk == 0 ? OR_B : bk == 1 ? 0.35 : 0.25, lon);
  r += 1;
);

// ---------------------------------------------------------------------- knobs
knob_at(2, px(140), py(170), 50*scale, 2);
knob_at(3, px(760), py(170), 50*scale, 2);
knob_at(4, px(140), py(320), 34*scale, 1);
knob_at(5, px(760), py(320), 34*scale, 1);
gfx_set(0.30, 0.31, 0.34, 1);
ctext("ENVELOPE AMOUNT", px(454), py(348), 11, 'b');
knob_at(7, px(330), py(388), 17*scale, 0);
knob_at(6, px(454), py(388), 17*scale, 0);
knob_at(8, px(578), py(388), 17*scale, 0);
gfx_set(0.16, 0.16, 0.18, 0.75);
dx = 0; loop(12, gfx_rect(px(330) - scale, py(346 + dx * 2), max(1, 2*scale), max(1, 1*scale), 1); gfx_rect(px(578) - scale, py(346 + dx * 2), max(1, 2*scale), max(1, scale), 1); dx += 1; );

gfx_set(0.62, 0.63, 0.65, 1);
gfx_rect(px(20), py(442), (DW - 40)*scale, max(1, scale), 1);
gfx_set(0.97, 0.97, 0.97, 1);
gfx_rect(px(20), py(443), (DW - 40)*scale, max(1, scale), 1);

// ---------------------------------------------------------------------- bottom row: LPG, display, range/output
gfx_set(0.12, 0.12, 0.13, 1);
ctext("LOW-PASS GATE", px(95), py(450), 11, 'b');
knob_at(9, px(60), py(486), 17*scale, 1);
knob_at(10, px(130), py(486), 17*scale, 1);

DBX = px(190); DBY = py(452); DBW = 400*scale; DBH = 74*scale;
navy_box(DBX, DBY, DBW, DBH);
dm = hov_model >= 0 ? hov_model : p_model;
dfs = 15;
gfx_setfont(1, "Arial", dfs*scale, 'b'); gfx_measurestr(model_long(dm), dtw, dth);
while (dtw > 152*scale && dfs > 11) ( dfs -= 1; gfx_setfont(1, "Arial", dfs*scale, 'b'); gfx_measurestr(model_long(dm), dtw, dth); );
gfx_set(0.93, 0.95, 0.98, 1);
gfx_x = DBX + 12*scale; gfx_y = DBY + (8 + (15 - dfs) * 0.5)*scale;
gfx_drawstr(model_long(dm));
gfx_setfont(1, "Arial", 11*scale, 'b');
gfx_set(0.70, 0.76, 0.86, 1);
gfx_x = DBX + 12*scale; gfx_y = DBY + 30*scale; strcpy(#lt, "H: "); strcat(#lt, model_hts(dm, 0)); gfx_drawstr(#lt);
gfx_x = DBX + 12*scale; gfx_y = DBY + 44*scale; strcpy(#lt, "T: "); strcat(#lt, model_hts(dm, 1)); gfx_drawstr(#lt);
gfx_x = DBX + 12*scale; gfx_y = DBY + 58*scale; strcpy(#lt, "M: "); strcat(#lt, model_hts(dm, 2)); gfx_drawstr(#lt);
SCX = DBX + 170*scale; SCW = DBW - 182*scale; SCY = DBY + 10*scale; SCH = DBH - 20*scale;
gfx_set(0.08, 0.11, 0.17, 1);
gfx_rect(SCX, SCY, SCW, SCH, 1);
gfx_set(1, 1, 1, 0.1);
gfx_rect(SCX, SCY + SCH*0.5, SCW, max(1, scale), 1);
smax = 0.05; si = 0; loop(512, smax = max(smax, abs(SCO[si])); si += 1; );
sc_g = sc_g > 0 ? max(smax, sc_g * 0.92) : smax;
gfx_set(0.55, 0.88, 0.90, 1);
si = 0;
loop(200,
  sv = SCO[(sco_w + 300 + si) & 511] / sc_g;
  spx = SCX + SCW * si / 199;
  spy = SCY + SCH*0.5 - sv * SCH * 0.44;
  si == 0 ? ( gfx_x = spx; gfx_y = spy; ) : gfx_lineto(spx, spy, 1);
  si += 1;
);

gfx_set(0.12, 0.12, 0.13, 1);
gfx_setfont(1, "Arial", 11*scale, 'b');
gfx_x = px(606); gfx_y = py(452); gfx_drawstr("RANGE");
rhov = hit_rect(mouse_x, mouse_y, px(606), py(466), 130*scale, 22*scale);
rhov ? hov_s = 11;
strcpy(#lt, p_range == 0 ? "FULL C0-C5" : p_range == 9 ? "OCTAVES" : p_range == 10 ? "C4 ±4 OCT" : "C0 ±7");
p_range >= 1 && p_range <= 8 ? sprintf(#lt, "C%d ±7 ST", p_range - 1);
dark_btn(11, px(606), py(466), 22*scale, 22*scale, "<", 0, 12) ? ( set_slider(11, max(0, p_range - 1)); mouse_just_down = 0; );
gfx_set(0.10, 0.13, 0.20, 1); gfx_rect(px(630), py(466), 82*scale, 22*scale, 1);
gfx_set(0.93, 0.95, 0.98, 1); ctext(#lt, px(671), py(470), 11, 'b');
dark_btn(11, px(714), py(466), 22*scale, 22*scale, ">", 0, 12) ? ( set_slider(11, min(10, p_range + 1)); mouse_just_down = 0; );
gfx_set(0.12, 0.12, 0.13, 1);
gfx_x = px(606); gfx_y = py(496); gfx_drawstr("OUTPUT");
OBW = 42*scale;
dark_btn(13, px(606), py(510), OBW, 20*scale, "OUT", p_output < 0.5, 11) ? ( set_slider(13, 0); mouse_just_down = 0; );
dark_btn(13, px(606) + OBW + 3*scale, py(510), OBW, 20*scale, "AUX", p_output >= 0.5 && p_output < 1.5, 11) ? ( set_slider(13, 1); mouse_just_down = 0; );
dark_btn(13, px(606) + 2*(OBW + 3*scale), py(510), OBW, 20*scale, "STEREO", p_output >= 1.5, 10) ? ( set_slider(13, 2); mouse_just_down = 0; );
knob_at(14, px(818), py(474), 18*scale, 1);

// ---------------------------------------------------------------------- keyboard
KBY = py(540); KBH = 56*scale;
KBX = px(20); KBW = (DW - 40)*scale;
NWK = 36; WKW = KBW / NWK;
kb_hit = -1;
wi = 0;
loop(NWK,
  oc = floor(wi / 7); wn = wi % 7;
  kn = 36 + oc*12 + (wn == 0 ? 0 : wn == 1 ? 2 : wn == 2 ? 4 : wn == 3 ? 5 : wn == 4 ? 7 : wn == 5 ? 9 : 11);
  kpx = KBX + wi*WKW;
  hit_rect(mouse_x, mouse_y, kpx, KBY, WKW, KBH) ? kb_hit = kn;
  wi += 1;
);
wi = 0;
loop(NWK - 1,
  wn = wi % 7;
  (wn != 2 && wn != 6) ? (
    oc = floor(wi / 7);
    kn = 36 + oc*12 + (wn == 0 ? 1 : wn == 1 ? 3 : wn == 3 ? 6 : wn == 4 ? 8 : 10);
    kpx = KBX + (wi + 1)*WKW - WKW*0.32;
    hit_rect(mouse_x, mouse_y, kpx, KBY, WKW*0.64, KBH*0.6) ? kb_hit = kn;
  );
  wi += 1;
);
jkb_draw(KBX, KBY, KBW, KBH, NWK, 36, -1, kb_held, 0, 0.93, 0.55, 0.13, 1, scale);
kb_hit >= 0 ? (
  hov_s = 15;
  (mouse_just_down) ? ( key_down(kb_hit); kb_held = kb_hit; mouse_just_down = 0; );
);
(kb_held > 0 && !mouse_down) ? ( key_up(kb_held); kb_held = 0; );

// ---------------------------------------------------------------------- hint bar
gfx_set(0.20, 0.20, 0.21, 1);
gfx_rect(px(0), py(602), DW*scale, 34*scale, 1);
hs = drag_target > 0 ? drag_target : hov_s;
gfx_setfont(1, "Arial", 13*scale);
gfx_set(0.80, 0.80, 0.82, 1);
strcpy(#hint, hint_text(hs));
gfx_measurestr(#hint, htw, hth);
htw > (DW - 20)*scale ? ( gfx_setfont(1, "Arial", 13*scale*(DW - 20)*scale/htw); gfx_measurestr(#hint, htw, hth); );
gfx_x = ox + (DW*scale - htw)*0.5; gfx_y = py(602) + (34*scale - hth)*0.5;
gfx_drawstr(#hint);

drag_target > 0 ? (
  mouse_down ? (
    mouse_cap |= 65536;
    fine_now = mouse_cap & 4;
    fine_now != drag_fine ? ( drag_y0 = mouse_y; drag_v0 = norm_of(drag_target); drag_fine = fine_now; );
    v = max(0, min(1, drag_v0 + (drag_y0 - mouse_y) / (150*scale) * (fine_now ? 0.1 : 1)));
    set_norm(drag_target, v);
  ) : ( automate(drag_target, 1); drag_target = 0; );
);

!tables_ok ? (
  gfx_set(0.6, 0.1, 0.1, 0.92);
  gfx_rect(px(150), py(250), 600*scale, 60*scale, 1);
  gfx_set(1, 1, 1, 1);
  ctext("Missing or unreadable Dependencies/PlaitTectonics/plaits_tables.txt", px(450), py(260), 15, 'b');
  ctext("Install or update via ReaPack so the data file is present.", px(450), py(284), 12, 0);
);

mouse_state = mouse_down;
