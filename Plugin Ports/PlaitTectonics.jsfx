tset(92, 95, 99, 102, 106, 110, 115, 119); tset(123, 128, 133, 138, 143, 149, 154, 160);
TP = LPC_K;
tset(-32064, -31872, -31808, -31680, -31552, -31424, -31232, -30848); tset(-30592, -30336, -30016, -29696, -29376, -28928, -28480, -27968);
