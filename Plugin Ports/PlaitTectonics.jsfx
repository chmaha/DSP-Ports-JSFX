lset(LPCP + 72, 10, 0, 27968, 17856, 25, 43, -24, -20, -53, 55, -4, -51);
lset(LPCP + 84, 128, 160, 14528, -3712, -43, -26, -24, -20, -53, 55, -4, -51);
lset(LPCP + 96, 128, 160, 10048, 11584, -16, 15, 0, 0, 0, 0, 0, 0);
