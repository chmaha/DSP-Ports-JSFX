cur_sid2 = slider115;
read_globals();
vmode != vmode_prev ? (all_off(); src_reset(); filt_route(); vmode_prev = vmode;);
(dc_settle && idle_n >= srate) ? chip_settle();
(host_tick && (play_state & 1)) ? (
