(
<? loop(i = 1; 121,
  printf("  s == %d ? slider_automate(slider%d, e) :\n", i, i);
  i += 1;
); ?>  0;
);

function sx(x) ( ox + x * z; );
function sy(y) ( oy + y * z; );
function hit(x, y, w, h) ( mouse_x >= sx(x) && mouse_x < sx(x + w) && mouse_y >= sy(y) && mouse_y < sy(y + h); );
function hitc(x, y, r) ( sqr(mouse_x - sx(x)) + sqr(mouse_y - sy(y)) <= sqr(r * z); );
function font(n, sz, fl) ( n == 1 ? gfx_setfont(1, "Arial", (sz + 2) * z, fl) : gfx_setfont(n, "Courier New", (sz + 2) * z, fl); );
function clamp01(x) ( max(0, min(1, x)); );

function upper(str) local(i, c)
(
  i = 0;
  loop(strlen(str), c = str_getchar(str, i); (c >= 97 && c <= 122) ? str_setchar(str, i, c - 32); i += 1;);
  str;
);

function text_c(str, cx, y) local(tw, th) ( gfx_measurestr(str, tw, th); gfx_x = sx(cx) - tw * 0.5; gfx_y = sy(y); gfx_drawstr(str); );
function text_r(str, rx, y) local(tw, th) ( gfx_measurestr(str, tw, th); gfx_x = sx(rx) - tw; gfx_y = sy(y); gfx_drawstr(str); );
function text_l(str, lx, y) ( gfx_x = sx(lx); gfx_y = sy(y); gfx_drawstr(str); );

function glow_str(str, x, y, r, g, b) local(d)
(
  d = max(1, z);
  gfx_set(r, g, b, 0.14);
  gfx_x = x - d; gfx_y = y; gfx_drawstr(str);
  gfx_x = x + d; gfx_y = y; gfx_drawstr(str);
  gfx_x = x; gfx_y = y - d; gfx_drawstr(str);
  gfx_x = x; gfx_y = y + d; gfx_drawstr(str);
  gfx_set(r, g, b, 1);
  gfx_x = x; gfx_y = y; gfx_drawstr(str);
);

function rrect(x, y, w, h, rad) local(QX, QY, QW, QH, QR)
(
  QX = sx(x); QY = sy(y); QW = w * z; QH = h * z; QR = rad * z;
  gfx_rect(QX + QR, QY, QW - 2 * QR, QH, 1);
  gfx_rect(QX, QY + QR, QR, QH - 2 * QR, 1);
  gfx_rect(QX + QW - QR, QY + QR, QR, QH - 2 * QR, 1);
  gfx_circle(QX + QR, QY + QR, QR, 1, 1);
  gfx_circle(QX + QW - QR - 1, QY + QR, QR, 1, 1);
  gfx_circle(QX + QR, QY + QH - QR - 1, QR, 1, 1);
  gfx_circle(QX + QW - QR - 1, QY + QH - QR - 1, QR, 1, 1);
);

function soft_shadow(x, y, w, h, rad, n, a) local(i)
(
  i = 1;
  loop(n,
    gfx_set(0, 0, 0, a * (1 - (i - 1) / n));
    gfx_roundrect(sx(x) - i, sy(y) - i + 2 * z, w * z + 2 * i, h * z + 2 * i, (rad + i / z) * z, 1);
    i += 1;
  );
);

function g_col(c)
(
  c == 0 ? (g_r = 0.94; g_g = 0.32; g_b = 0.28;) :
  c == 1 ? (g_r = 0.98; g_g = 0.83; g_b = 0.30;) :
  c == 2 ? (g_r = 0.42; g_g = 0.82; g_b = 0.40;) :
  c == 3 ? (g_r = 0.33; g_g = 0.58; g_b = 0.95;) :
  c == 4 ? (g_r = 0.98; g_g = 0.58; g_b = 0.22;) :
  (g_r = 0.64; g_g = 0.59; g_b = 1.00;);
);

function panel(x, y, w, h, title, c) local(tw, th)
(
  g_pass == 0 ? (
    soft_shadow(x, y, w, h, 7, max(3, floor(6 * z)), 0.10);
    gfx_set(0.115, 0.122, 0.140, 1);
    rrect(x, y, w, h, 7);
    gfx_gradrect(sx(x + 7), sy(y + 1), (w - 14) * z, 40 * z, 1, 1, 1, 0.035, 0, 0, 0, 0, 0, 0, 0, -0.035 / (40 * z));
    gfx_set(1, 1, 1, 0.05);
    gfx_line(sx(x + 7), sy(y) + 1, sx(x + w - 7), sy(y) + 1, 1);
    g_col(c);
    font(1, 11, 'b');
    gfx_measurestr(title, tw, th);
    gfx_set(g_r, g_g, g_b, 0.95);
    gfx_x = sx(x + 12); gfx_y = sy(y + 8);
    gfx_drawstr(title);
    gfx_set(g_r, g_g, g_b, 0.35);
    gfx_rect(sx(x + 12) + tw + 8 * z, sy(y + 14), sx(x + w - 12) - (sx(x + 12) + tw + 8 * z), max(1, z), 1);
  );
);

function screen(x, y, w, h) local(QX, QY, QW, QH)
(
  QX = sx(x); QY = sy(y); QW = w * z; QH = h * z;
  gfx_set(0, 0, 0, 0.5);
  gfx_rect(QX - z, QY - z, QW + 2 * z, QH + 2 * z, 1);
  gfx_set(0.035, 0.04, 0.045, 1);
  gfx_rect(QX, QY, QW, QH, 1);
);

// ---------------- parameters ----------------
function smin(k) ( SPEC_B[k * 4]; );
function smax(k) ( SPEC_B[k * 4 + 1]; );
function sstep(k) ( SPEC_B[k * 4 + 2]; );
function sdef(k) ( SPEC_B[k * 4 + 3]; );
function clampv(k, v) local(mn, st)
(
  mn = smin(k);
  v = min(max(v, mn), smax(k));
  st = sstep(k);
  st > 0 ? v = mn + floor((v - mn) / st + 0.5) * st;
  v;
);
function pnorm(k) ( (slider(k) - smin(k)) / (smax(k) - smin(k)); );

function set_slider(k, v)
(
  v = clampv(k, v);
  slider(k) !== v ? (
    slider(k) = v;
    automate(k, 0);
  );
  g_tk = k; g_tt = g_now;
);
function end_touch(k) ( automate(k, 1); );

function vname(p)
(
  p == 0 ? "WAVEFORM" : p == 1 ? "SYNC" : p == 2 ? "RING MOD" : p == 3 ? "FILTER" : p == 4 ? "OUTPUT" :
  p == 5 ? "ATTACK" : p == 6 ? "DECAY" : p == 7 ? "SUSTAIN" : p == 8 ? "RELEASE" : p == 9 ? "HARD RESTART" :
  p == 10 ? "TRANSPOSE" : p == 11 ? "FINE TUNE" : p == 12 ? "GLIDE" : p == 13 ? "VIBRATO DEPTH" :
  p == 14 ? "VIBRATO SPEED" : p == 15 ? "VIBRATO DELAY" : p == 16 ? "PULSE WIDTH" : p == 17 ? "PW SWEEP SPEED" :
  p == 18 ? "PW SWEEP DEPTH" : p == 19 ? "STEP TABLE" : p == 20 ? "TABLE SPEED" : p == 21 ? "TABLE LENGTH" :
  p == 22 ? "TABLE LOOP" : p == 23 ? "DRUM KIT" : p == 24 ? "TABLE RELEASE" : p == 25 ? "OSC RESET" : "FIXED NOTE";
);

function pname(k, str)
(
  (k >= VS && k < VS + 3 * NV) ? sprintf(str, "V%d %s", floor((k - VS) / NV) + 1, vname((k - VS) % NV)) :
  strcpy(str, k == 1 ? "PATCH" : k == 2 ? "CHIP" : k == 3 ? "VOICE MODE" : k == 4 ? "CUTOFF" : k == 5 ? "RESONANCE" :
    k == 6 ? "FILTER TYPE" : k == 7 ? "ARP SPEED" : k == 8 ? "KEY MODE" : k == 9 ? "BEND RANGE" : k == 10 ? "VOLUME" :
    k == 11 ? "OVERSAMPLING" : k == 12 ? "MIDI CHANNEL" : k == 94 ? "BANK" : k == 95 ? "TICK CLOCK" : k == 96 ? "TICKS PER BEAT" :
    k == 97 ? "ARP MODE" : k == 98 ? "ARP OCTAVES" : k == 99 ? "ARP GATE" : k == 100 ? "6581 FILTER BIAS" : k == 101 ? "COMBINED WAVES" :
    k == 102 ? "VELOCITY" : k == 103 ? "MASTER TUNE" : k == 104 ? "DIGI LEVEL" : k == 105 ? "8580 DIGI BOOST" : k == 121 ? "DIGI MODE" : k == 106 ? "CHORUS MIX" :
    k == 107 ? "CHORUS RATE" : k == 108 ? "CHORUS DEPTH" : k == 109 ? "DELAY MIX" : k == 110 ? "DELAY TIME" : k == 111 ? "DELAY SYNC" :
    k == 112 ? "DELAY FEEDBACK" : k == 113 ? "PING-PONG" : k == 114 ? "DELAY DAMPING" : k == 115 ? "EXTRA SIDS" : k == 116 ? "STEREO WIDTH" : k == 117 ? "SID 2 DETUNE" : "SONG");
);

function atk_ms(v) ( v == 0 ? 2 : v == 1 ? 8 : v == 2 ? 16 : v == 3 ? 24 : v == 4 ? 38 : v == 5 ? 56 : v == 6 ? 68 : v == 7 ? 80 :
  v == 8 ? 100 : v == 9 ? 250 : v == 10 ? 500 : v == 11 ? 800 : v == 12 ? 1000 : v == 13 ? 3000 : v == 14 ? 5000 : 8000; );

function fmt_ms(ms, str) ( ms < 1000 ? sprintf(str, "%d ms", ms) : sprintf(str, "%.1f s", ms / 1000); );

function wave_str(w, str)
(
  strcpy(str, w == 0 ? "None" : w == 1 ? "Triangle" : w == 2 ? "Sawtooth" : w == 3 ? "Saw+Tri" : w == 4 ? "Pulse" :
    w == 5 ? "Pulse+Tri" : w == 6 ? "Pulse+Saw" : w == 7 ? "Pulse+Saw+Tri" : w == 8 ? "Noise" : "Noise combo");
);

function note_str(n, str) local(pc)
(
  pc = n % 12;
  sprintf(str, "%s%d", pc == 0 ? "C" : pc == 1 ? "C#" : pc == 2 ? "D" : pc == 3 ? "D#" : pc == 4 ? "E" : pc == 5 ? "F" : pc == 6 ? "F#" :
    pc == 7 ? "G" : pc == 8 ? "G#" : pc == 9 ? "A" : pc == 10 ? "A#" : "B", floor(n / 12) - 1);
);

function fmtv(k, v, str) local(p)
(
  v = clampv(k, v);
  (k >= VS && k < VS + 3 * NV) ? (
    p = (k - VS) % NV;
    p == 0 ? wave_str(v, str) :
    (p == 1 || p == 2 || p == 3 || p == 9 || p == 19 || p == 25) ? strcpy(str, v ? "On" : "Off") :
    p == 23 ? strcpy(str, v == 0 ? "No kit" : v == 1 ? "SID kit" : "Digi kit") :
    p == 24 ? (v == 0 ? strcpy(str, "Off") : sprintf(str, "Step %d", v)) :
    p == 26 ? (v == 0 ? strcpy(str, "Off") : note_str(v, str)) :
    p == 4 ? strcpy(str, v ? "On" : "Off (sync/ring source only)") :
    p == 5 ? fmt_ms(atk_ms(v), str) :
    (p == 6 || p == 8) ? fmt_ms(atk_ms(v) * 3, str) :
    p == 7 ? sprintf(str, "%d  (%d %%)", v, floor(v * 100 / 15 + 0.5)) :
    p == 10 ? sprintf(str, "%+d semi", v) :
    p == 11 ? sprintf(str, "%+d cents", v) :
    (p == 12 || p == 15) ? (v == 0 ? strcpy(str, "Off") : sprintf(str, "%d frames (%d ms)", v, floor(v * 1000 / FRAME_HZ + 0.5))) :
    p == 13 ? sprintf(str, "%d cents", v) :
    p == 14 ? sprintf(str, "%.1f Hz", FRAME_HZ / v) :
    p == 16 ? sprintf(str, "%.1f %%", v / 40.95) :
    p == 17 ? (v == 0 ? strcpy(str, "Off") : sprintf(str, "%d / frame", v)) :
    p == 18 ? sprintf(str, "+/- %.1f %%", v / 40.95) :
    p == 20 ? sprintf(str, "%d tick%s / step", v, v == 1 ? "" : "s") :
    p == 21 ? sprintf(str, "%d step%s", v, v == 1 ? "" : "s") :
    p == 22 ? (v >= 16 ? strcpy(str, "Hold") : sprintf(str, "Step %d", v + 1)) :
    sprintf(str, "%d", v);
  ) : (
    k == 2 ? strcpy(str, v ? "MOS 8580" : "MOS 6581") :
    k == 3 ? strcpy(str, v == 0 ? "Lead" : v == 1 ? "Poly" : v == 2 ? "Multi" : v == 3 ? "Poly x2" : "Poly x3") :
    k == 4 ? sprintf(str, "%d / 2047", v) :
    k == 5 ? sprintf(str, "%d / 15", v) :
    k == 6 ? strcpy(str, v == 0 ? "Off" : v == 1 ? "Low pass" : v == 2 ? "Band pass" : v == 3 ? "LP + BP" : v == 4 ? "High pass" : v == 5 ? "Notch" : v == 6 ? "BP + HP" : "All") :
    k == 7 ? (v == 0 ? strcpy(str, "Off") : sprintf(str, "%d tick%s / note", v, v == 1 ? "" : "s")) :
    k == 8 ? strcpy(str, v ? "Legato" : "Retrigger") :
    k == 9 ? sprintf(str, "%d semi", v) :
    k == 10 ? sprintf(str, "%+.1f dB", v) :
    k == 11 ? strcpy(str, v == 0 ? "1x (fast)" : v == 1 ? "2x" : "4x (best)") :
    k == 12 ? (v == 0 ? strcpy(str, "Omni") : sprintf(str, "Channel %d", v)) :
    k == 94 ? strcpy(str, v ? "User" : "Factory") :
    k == 95 ? strcpy(str, v == 0 ? "PAL 50 Hz" : v == 1 ? "NTSC 60 Hz" : "Host tempo") :
    k == 96 ? sprintf(str, "%d", v == 0 ? 4 : v == 1 ? 6 : v == 2 ? 8 : v == 3 ? 12 : v == 4 ? 16 : v == 5 ? 24 : v == 6 ? 32 : 48) :
    k == 97 ? strcpy(str, v == 0 ? "Up" : v == 1 ? "Down" : v == 2 ? "Up-Down" : v == 3 ? "Down-Up" : v == 4 ? "As played" : "Random") :
    k == 98 ? sprintf(str, "%d octave%s", v + 1, v ? "s" : "") :
    (k == 99 || k == 104 || k == 106 || k == 108 || k == 109 || k == 112 || k == 114 || k == 116) ? sprintf(str, "%d %%", v) :
    k == 100 ? sprintf(str, "%+.2f V", v * 0.01) :
    k == 101 ? strcpy(str, v ? "8580 style" : "Chip") :
    k == 102 ? strcpy(str, v == 0 ? "Off" : v == 1 ? "Sustain" : v == 2 ? "Cutoff" : "Sustain + Cutoff") :
    k == 103 ? sprintf(str, "%+d cents", v) :
    k == 105 ? strcpy(str, v ? (sidm ? "On" : "On (applies to the 8580)") : "Off") :
    k == 121 ? strcpy(str, v ? "Authentic (volume register)" : "Clean") :
    k == 113 ? strcpy(str, v ? "On" : "Off") :
    k == 107 ? sprintf(str, "%.2f Hz", v) :
    k == 110 ? sprintf(str, "%d ms", v) :
    k == 111 ? strcpy(str, v == 0 ? "Sync off (ms)" : v == 1 ? "Sync 1/16" : v == 2 ? "Sync 1/8T" : v == 3 ? "Sync 1/8" : v == 4 ? "Sync 1/8." : v == 5 ? "Sync 1/4" : v == 6 ? "Sync 1/4." : "Sync 1/2") :
    k == 115 ? strcpy(str, v == 0 ? "Off" : v == 1 ? "Wide (doubled)" : v == 2 ? "6-voice Poly" : v == 3 ? "9-voice Poly" : "12-voice Poly") :
    k == 117 ? sprintf(str, "%d cents", v) :
    sprintf(str, "%d", v);
  );
  str;
);
function fmt(k, str) ( fmtv(k, slider(k), str); );

// ---------------- widgets ----------------
function knob_body(x, y, r) local(QX, QY, QR, i, t, c)
(
  QX = sx(x); QY = sy(y); QR = r * z;
  gfx_set(0, 0, 0, 0.45);
  gfx_circle(QX, QY + 2 * z, QR + 2 * z, 1, 1);
  gfx_set(0.035, 0.037, 0.045, 1);
  i = 0; loop(ceil(6 * z) + 1, gfx_arc(QX, QY, QR + 2 * z + i * 0.5, -2.35619, 2.35619, 1); i += 1;);
  gfx_set(0.05, 0.052, 0.06, 1);
  gfx_circle(QX, QY, QR, 1, 1);
  i = 0;
  loop(ceil(QR),
    t = i / ceil(QR);
    c = 0.14 + 0.16 * t;
    gfx_set(c, c * 1.01, c * 1.06, 1);
    gfx_circle(QX - QR * 0.18 * t, QY - QR * 0.22 * t, (QR - 1.5 * z) * (1 - t * 0.92), 1, 1);
    i += 1;
  );
  gfx_set(1, 1, 1, 0.10);
  gfx_arc(QX, QY, QR - 1.5 * z, -1.9, 0.2, 1);
  gfx_set(0, 0, 0, 0.35);
  gfx_arc(QX, QY, QR - 0.5 * z, 1.4, 4.2, 1);
);

function knob_value(x, y, r, pos, style, hot, en) local(QX, QY, QR, a0, a1, as, ae, a, i, br)
(
  QX = sx(x); QY = sy(y); QR = r * z;
  a0 = -2.35619; a1 = 2.35619;
  a = a0 + (a1 - a0) * clamp01(pos);
  style == 1 ? (as = min(0, a); ae = max(0, a);) : (as = a0; ae = a;);
  br = !en ? 0.35 : hot ? 1 : 0.85;
  ae > as + 0.001 ? (
    gfx_set(g_r, g_g, g_b, 0.10 * br);
    i = 0; loop(3, gfx_arc(QX, QY, QR + (5.5 + i * 0.7) * z, as, ae, 1); i += 1;);
    gfx_set(g_r * br, g_g * br, g_b * br, 1);
    i = 0; loop(ceil(6 * z) + 1, gfx_arc(QX, QY, QR + 2 * z + i * 0.5, as, ae, 1); i += 1;);
  );
  style == 1 ? (gfx_set(1, 1, 1, 0.35); gfx_line(QX, QY - QR - 1.5 * z, QX, QY - QR - 5 * z, 1););
  gfx_set(0.95, 0.95, 0.97, en ? 1 : 0.4);
  gfx_circle(QX + sin(a) * QR * 0.72, QY - cos(a) * QR * 0.72, max(1.5, 2.2 * z), 1, 1);
);

function tooltip(x, y, str) local(tw, th, bx, by, bw, bh)
(
  font(1, 11, 'b');
  gfx_measurestr(str, tw, th);
  bw = tw + 12 * z; bh = th + 6 * z;
  bx = max(2, min(gfx_w - bw - 2, sx(x) - bw * 0.5)); by = sy(y) - bh;
  gfx_set(0.02, 0.02, 0.03, 0.92);
  gfx_rect(bx, by, bw, bh, 1);
  gfx_set(g_r, g_g, g_b, 0.8);
  gfx_rect(bx, by + bh - max(1, z), bw, max(1, z), 1);
  gfx_set(1, 1, 1, 1);
  gfx_x = bx + 6 * z; gfx_y = by + 3 * z;
  gfx_drawstr(str);
);

function knob(x, y, r, k, style, label, c, en) local(hov, newv, d, st, fine, steps)
(
  g_col(c);
  g_pass == 0 ? (
    knob_body(x, y, r);
    font(1, 9, 'b');
    gfx_set(0.62, 0.64, 0.68, en ? 1 : 0.45);
    text_c(label, x, y + r + 7);
  ) : (
    hov = hitc(x, y, r + 5);
    (g_click && hov) ? (
      (g_lck == k && g_now - g_lct < 0.3) ? (
        set_slider(k, sdef(k)); end_touch(k); g_drag = -1;
      ) : (
        g_drag = k; g_dy0 = mouse_y; g_dv0 = slider(k);
      );
      g_lck = k; g_lct = g_now;
      g_click = 0;
    );
    g_drag == k ? (
      mouse_cap |= 65536;
      fine = (mouse_cap & 4) || (mouse_cap & 8);
      d = (g_dy0 - mouse_y) / (200 * z) * (fine ? 0.15 : 1);
      st = sstep(k);
      steps = (smax(k) - smin(k)) / max(st, 0.000001);
      newv = st > 0 ? g_dv0 + floor(d * min(steps, 300) + 0.5) * max(st, (smax(k) - smin(k)) / 300) : g_dv0 + d * (smax(k) - smin(k));
      set_slider(k, newv);
    );
    (hov && mouse_wheel != 0 && g_drag < 0) ? (
      st = sstep(k);
      set_slider(k, slider(k) + (mouse_wheel > 0 ? 1 : -1) * (st > 0 ? st * ((mouse_cap & 4) || steps < 64 ? 1 : max(1, floor((smax(k) - smin(k)) / st / 64))) : (smax(k) - smin(k)) * 0.02));
      end_touch(k);
      mouse_wheel = 0;
    );
    knob_value(x, y, r, pnorm(k), style, hov || g_drag == k, en);
    (hov || g_drag == k) ? (g_hk = k; g_hx = x; g_hy = y - r - 8; g_hc = c;);
  );
);

function toggle(x, y, w, h, k, label, c, en) local(hov, on, QX, QY, QW, QH, tw, th)
(
  g_col(c);
  QX = sx(x); QY = sy(y); QW = w * z; QH = h * z;
  g_pass == 0 ? (
    gfx_set(0, 0, 0, 0.5);
    gfx_rect(QX - z, QY - z, QW + 2 * z, QH + 2 * z, 1);
  ) : (
    hov = hit(x, y, w, h);
    on = slider(k) >= 0.5;
    on && en ? gfx_set(g_r * 0.36, g_g * 0.36, g_b * 0.36, 1) : gfx_set(0.075, 0.08, 0.09, 1);
    gfx_rect(QX, QY, QW, QH, 1);
    hov ? (gfx_set(1, 1, 1, 0.06); gfx_rect(QX, QY, QW, QH, 1););
    on && en ? (gfx_set(g_r, g_g, g_b, 0.25); gfx_circle(QX + 9 * z, QY + QH * 0.5, 5 * z, 1, 1););
    on ? gfx_set(g_r, g_g, g_b, en ? 1 : 0.4) : gfx_set(0.25, 0.26, 0.28, 1);
    gfx_circle(QX + 9 * z, QY + QH * 0.5, 2.6 * z, 1, 1);
    font(1, 10, 'b');
    on && en ? gfx_set(1, 1, 1, 1) : gfx_set(0.62, 0.64, 0.68, en ? 1 : 0.5);
    gfx_measurestr(label, tw, th);
    gfx_x = QX + 17 * z; gfx_y = QY + (QH - th) * 0.5;
    gfx_drawstr(label);
    hov ? (g_hk = k; g_hx = x + w * 0.5; g_hy = y - 4; g_hc = c;);
    (g_click && hov) ? (set_slider(k, on ? 0 : 1); end_touch(k); g_click = 0;);
  );
);

function dropdown(x, y, w, h, label, str, c) local(hov, tw, th, QX, QY, QW, QH, ret)
(
  g_col(c);
  QX = sx(x); QY = sy(y); QW = w * z; QH = h * z;
  g_pass == 0 ? (
    font(1, 9, 'b');
    gfx_set(0.62, 0.64, 0.68, 1);
    gfx_x = QX; gfx_y = QY - 13 * z;
    gfx_drawstr(label);
    gfx_set(0, 0, 0, 0.5);
    gfx_rect(QX - z, QY - z, QW + 2 * z, QH + 2 * z, 1);
    gfx_set(0.075, 0.08, 0.09, 1);
    gfx_rect(QX, QY, QW, QH, 1);
    0;
  ) : (
    hov = hit(x, y, w, h);
    hov ? (gfx_set(1, 1, 1, 0.05); gfx_rect(QX, QY, QW, QH, 1););
    font(1, 11, 'b');
    gfx_set(0.90, 0.91, 0.93, 1);
    gfx_measurestr(str, tw, th);
    gfx_x = QX + 7 * z; gfx_y = QY + (QH - th) * 0.5;
    gfx_drawstr(str);
    gfx_set(g_r, g_g, g_b, hov ? 1 : 0.8);
    gfx_triangle(QX + QW - 13 * z, QY + QH * 0.5 - 2 * z, QX + QW - 5 * z, QY + QH * 0.5 - 2 * z, QX + QW - 9 * z, QY + QH * 0.5 + 2.5 * z);
    gfx_rect(QX, QY + QH - max(1, z), QW, max(1, z), 1);
    ret = g_click && hov;
    ret ? (g_click = 0; gfx_x = QX; gfx_y = QY + QH;);
    ret;
  );
);

function enum_dd(x, y, w, h, k, label, c) local(i, n, sel)
(
  dropdown(x, y, w, h, label, fmt(k, #g_dd), c) ? (
    strcpy(#g_menu, "");
    n = smax(k) - smin(k) + 1; i = 0;
    loop(n,
      strcat(#g_menu, i > 0 ? "|" : "");
      strcat(#g_menu, i + smin(k) == floor(slider(k) + 0.5) ? "!" : "");
      fmtv(k, i + smin(k), #g_mi); strcat(#g_menu, #g_mi);
      i += 1;
    );
    sel = gfx_showmenu(#g_menu);
    sel > 0 ? (set_slider(k, sel - 1 + smin(k)); end_touch(k););
  );
  g_pass == 1 && hit(x, y, w, h) ? (g_hk = k; g_hx = x + w * 0.5; g_hy = y - 16; g_hc = c;);
);

function btn(x, y, w, h, label, lit, c, en) local(QX, QY, QW, QH, hov, tw, th, ret)
(
  g_col(c);
  QX = sx(x); QY = sy(y); QW = w * z; QH = h * z;
  g_pass == 1 ? (
    hov = hit(x, y, w, h);
    gfx_set(0, 0, 0, 0.5);
    gfx_rect(QX - z, QY - z, QW + 2 * z, QH + 2 * z, 1);
    !en ? (gfx_set(0.10, 0.105, 0.115, 1); gfx_rect(QX, QY, QW, QH, 1);) :
    lit ? gfx_gradrect(QX, QY, QW, QH, g_r * 0.55, g_g * 0.55, g_b * 0.55, 1, 0, 0, 0, 0, -0.1 / QH, -0.1 / QH, -0.1 / QH, 0)
        : gfx_gradrect(QX, QY, QW, QH, 0.16, 0.165, 0.18, 1, 0, 0, 0, 0, -0.05 / QH, -0.05 / QH, -0.05 / QH, 0);
    hov && en ? (gfx_set(1, 1, 1, 0.07); gfx_rect(QX, QY, QW, QH, 1););
    font(1, 10, 'b');
    !en ? gfx_set(0.34, 0.35, 0.38, 1) : lit ? gfx_set(1, 1, 1, 1) : gfx_set(0.82, 0.83, 0.86, 1);
    gfx_measurestr(label, tw, th);
    gfx_x = QX + (QW - tw) * 0.5; gfx_y = QY + (QH - th) * 0.5;
    gfx_drawstr(label);
    ret = g_click && hov;
    ret ? (g_click = 0; gfx_x = QX; gfx_y = QY + QH;);
    ret && en;
  ) : 0;
);

// small waveform icon: w = bit (1 tri, 2 saw, 4 pulse, 8 noise)
function wave_icon(QX, QY, QW, QH, w, a) local(i, n, t, y, px, py, xx, yy)
(
  n = 40; i = 0;
  loop(n + 1,
    t = i / n;
    y = w == 1 ? (t < 0.5 ? 4 * t - 1 : 3 - 4 * t) :
        w == 2 ? 2 * t - 1 :
        w == 4 ? (t < 0.4 ? 1 : -1) :
        (sin(t * 91.7) * sin(t * 57.3 + 1.3) + sin(t * 213.1) * 0.4);
    y = max(-1, min(1, y));
    xx = QX + t * QW; yy = QY + QH * 0.5 - y * QH * 0.4;
    i > 0 ? (
      gfx_set(g_r, g_g, g_b, 0.16 * a); gfx_line(px, py - z, xx, yy - z, 1); gfx_line(px, py + z, xx, yy + z, 1);
      gfx_set(g_r, g_g, g_b, a); gfx_line(px, py, xx, yy, 1);
    );
    px = xx; py = yy; i += 1;
  );
);

function wave_btn(x, y, w, h, k, bit, label, c) local(hov, on, v)
(
  g_col(c);
  g_pass == 0 ? (
    screen(x, y, w, h);
    font(1, 9, 'b'); gfx_set(0.62, 0.64, 0.68, 1);
    text_c(label, x + w * 0.5, y + h + 5);
  ) : (
    hov = hit(x, y, w, h);
    v = floor(slider(k) + 0.5); on = (v & bit) != 0;
    on ? (gfx_set(g_r, g_g, g_b, 0.12); gfx_rect(sx(x), sy(y), w * z, h * z, 1););
    wave_icon(sx(x + 6), sy(y + 4), (w - 12) * z, (h - 8) * z, bit, on ? 1 : hov ? 0.45 : 0.22);
    (hov || on) ? (gfx_set(g_r, g_g, g_b, on ? 0.9 : 0.5); gfx_rect(sx(x), sy(y), w * z, h * z, 0););
    hov ? (g_hk = k; g_hx = x + w * 0.5; g_hy = y - 4; g_hc = c;);
    (g_click && hov) ? (set_slider(k, (mouse_cap & 12) ? v ~ bit : bit); end_touch(k); g_click = 0;);
  );
);

