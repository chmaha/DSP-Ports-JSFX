) : tsync = 0;
qn = 0;
while (gq_r != gq_w) (
  EVQ_B[qn * 4] = 0; EVQ_B[qn * 4 + 1] = GQ_B[gq_r * 3] | (vmode == 2 ? kb_ch : midich > 0 ? midich - 1 : 0);
  EVQ_B[qn * 4 + 2] = GQ_B[gq_r * 3 + 1]; EVQ_B[qn * 4 + 3] = GQ_B[gq_r * 3 + 2];
