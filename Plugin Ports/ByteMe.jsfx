// Clean digi keeps the volume register at 15 and adds the drum below; Authentic modulates every voice like a real C64
wrg(0x18, fmb | (slider121 >= 0.5 ? dvol : 15));
(p0.on || p1.on || p2.on || p3.on || p4.on || p5.on || p6.on || p7.on || p8.on || p9.on || p10.on || p11.on || dg_on ||
