    strcat(#g_menu, cp == 198 ? "|<!Wide Bass/Lead/Drums (ch 1-3)" : "|<Wide Bass/Lead/Drums (ch 1-3)");
  ) : (
    g = 0;
    loop(USLOTS / 32,
      strcat(#g_menu, g > 0 ? "|>" : ">"); strcat(#g_menu, sprintf(#g_mi, "%03d - %03d", g * 32 + 1, g * 32 + 32));
      i = g * 32;
      loop(32,
        strcat(#g_menu, i == g * 32 + 31 ? "|<" : "|"); strcat(#g_menu, i == cp ? "!" : "");
        strcat(#g_menu, sprintf(#g_mi, "%03d  ", i + 1)); menu_add_name(slot_name(i, #g_mi));
        i += 1;
      );
      g += 1;
    );
  );
  sel = gfx_showmenu(#g_menu);
  sel > 0 ? pick_patch(b, sel - 1);
);

function slot_set_name(p, str) local(a, n, k)
(
  a = UB_B + p * US;
  n = min(UNAME, strlen(str)); a[0] = n;
  k = 0; loop(n, a[1 + k] = str_getchar(str, k); k += 1;);
);

function store_menu() local(g, i, sel)
(
  strcpy(#g_menu, "#STORE CURRENT SOUND IN USER SLOT|");
  g = 0;
  loop(USLOTS / 32,
    strcat(#g_menu, sprintf(#g_mi, "|>%03d - %03d", g * 32 + 1, g * 32 + 32));
    i = g * 32;
    loop(32,
      strcat(#g_menu, i == g * 32 + 31 ? "|<" : "|");
      strcat(#g_menu, sprintf(#g_mi, "%03d  ", i + 1)); menu_add_name(slot_name(i, #g_mi));
      i += 1;
    );
    g += 1;
  );
  sel = gfx_showmenu(#g_menu);
  sel > 1 ? (
    cur_name(#g_sn);
    rec_from_current(UB_B + (sel - 2) * US + 1 + UNAME);
    slot_set_name(sel - 2, #g_sn);
    sliderchange(-1);
    pick_patch(1, sel - 2);
  );
);

function name_keys() local(ch)
(
  g_nedit ? (
    ch = gfx_getchar();
    while (ch > 0) (
      ch == 13 ? (
        strlen(#g_ned) > 0 ? (
          UB_B[floor(slider1 + 0.5) * US] < 0 ? rec_from_current(UB_B + floor(slider1 + 0.5) * US + 1 + UNAME);
          slot_set_name(floor(slider1 + 0.5), #g_ned); sliderchange(-1);
        );
        g_nedit = 0;
      ) : ch == 27 ? g_nedit = 0 :
      ch == 8 ? (strlen(#g_ned) > 0 ? str_setlen(#g_ned, strlen(#g_ned) - 1);) :
      (ch >= 32 && ch < 127 && strlen(#g_ned) < UNAME) ? strcat(#g_ned, sprintf(#g_ch, "%c", ch));
      ch = g_nedit ? gfx_getchar() : 0;
    );
  );
);

function patch_edited() local(a, k, ed)
(
  a = patch_addr(floor(slider94 + 0.5), floor(slider1 + 0.5));
  ed = 0;
  a >= 0 ? (rec_from_current(g_tmp); k = 0; loop(PS, g_tmp[k] != a[k] ? ed = 1; k += 1;););
  ed;
);

function arrow(x, y, w, h, dir) local(hov, QX, QY, QW, QH, cx, cy, s, ret)
(
  QX = sx(x); QY = sy(y); QW = w * z; QH = h * z;
  hov = hit(x, y, w, h);
  gfx_set(0.02, 0.022, 0.025, 1);
  gfx_rect(QX - z, QY - z, QW + 2 * z, QH + 2 * z, 1);
  gfx_set(hov ? 0.19 : 0.13, hov ? 0.19 : 0.13, hov ? 0.21 : 0.15, 1);
  gfx_rect(QX, QY, QW, QH, 1);
  gfx_set(1, 1, 1, 0.05);
  gfx_rect(QX, QY, QW, QH * 0.45, 1);
  cx = QX + QW * 0.5; cy = QY + QH * 0.5; s = 6 * z;
  g_col(6);
  gfx_set(g_r, g_g, g_b, hov ? 1 : 0.85);
  dir < 0 ? gfx_triangle(cx + s * 0.55, cy - s, cx + s * 0.55, cy + s, cx - s * 0.65, cy)
          : gfx_triangle(cx - s * 0.55, cy - s, cx - s * 0.55, cy + s, cx + s * 0.65, cy);
  ret = g_click && hov;
  ret ? g_click = 0;
  ret;
);

function lcd() local(x, y, w, h, gx, gy, gw, gh, lr, lg, lb, tw, th, p, bk, led, yb, hovp, hovb, i, e, n)
(
  x = 252; y = 10; w = 440; h = 70;
  g_pass == 0 ? (
    gfx_set(0, 0, 0, 0.6);
    gfx_rect(sx(x) - 2 * z, sy(y) - 2 * z, (w + 4) * z, (h + 4) * z, 1);
    gfx_set(0.10, 0.105, 0.12, 1);
    gfx_rect(sx(x), sy(y), w * z, h * z, 1);
  ) : (
    p = floor(slider1 + 0.5); bk = floor(slider94 + 0.5);
    arrow(x + 5, y + 6, 24, h - 12, -1) ? step_patch(-1);
    arrow(x + w - 29, y + 6, 24, h - 12, 1) ? step_patch(1);
    gx = x + 34; gy = y + 5; gw = w - 68; gh = h - 10;
    lr = 0.66; lg = 0.61; lb = 1.0;
    gfx_set(0.012, 0.012, 0.012, 1);
    gfx_rect(sx(gx) - z, sy(gy) - z, (gw + 2) * z, (gh + 2) * z, 1);
    gfx_set(0.13, 0.10, 0.34, 1);
    gfx_rect(sx(gx), sy(gy), gw * z, gh * z, 1);
    hovb = hit(gx, gy, gw * 0.5, 16);
    hovp = hit(gx, gy + 16, gw, 30) && !g_nedit;
    (hit(gx, gy, gw, gh) && mouse_wheel != 0) ? (step_patch(mouse_wheel > 0 ? -1 : 1); mouse_wheel = 0;);
    font(2, 11, 'b');
    strcpy(#g_lt, bk ? "USER" : "FACTORY");
    hovb ? strcat(#g_lt, "  \xe2\x96\xbe");
    glow_str(#g_lt, sx(gx + 8), sy(gy + 4), lr, lg, lb);
    gfx_measurestr(#g_lt, tw, th);
    midi_flag ? (g_ledt = g_now; midi_flag = 0;);
    led = g_now - g_ledt < 0.12;
    gfx_set(lr, lg, lb, led ? 1 : 0.16);
    gfx_circle(sx(gx + 8) + tw + 9 * z, sy(gy + 4) + th * 0.5, 2.8 * z, 1, 1);
    sprintf(#g_lt, bk ? "%03d/%03d" : "%02d/%02d", p + 1, bk ? USLOTS : NPATCH);
    patch_edited() ? strcat(#g_lt, " *");
    gfx_measurestr(#g_lt, tw, th);
    glow_str(#g_lt, sx(gx + gw - 8) - tw, sy(gy + 4), lr, lg, lb);
    font(2, 19, 'b');
    g_nedit ? (strcpy(#g_ln, #g_ned); (floor(g_now * 2.5) & 1) ? strcat(#g_ln, "_") : strcat(#g_ln, " ");) : upper(cur_name(#g_ln));
    gfx_measurestr(#g_ln, tw, th);
    tw > gw * z - 16 * z ? (font(2, 14, 'b'); gfx_measurestr(#g_ln, tw, th););
    glow_str(#g_ln, sx(gx + gw * 0.5) - tw * 0.5, sy(gy + 30) - th * 0.5, lr, lg, lb);
    hovp ? (gfx_set(lr, lg, lb, 0.35); gfx_rect(sx(gx + gw * 0.5) - tw * 0.5, sy(gy + 30) + th * 0.5, tw, max(1, z), 1););
    font(2, 11, 'b');
    yb = gy + gh - 15;
    g_nedit ? (
      strcpy(#g_lt, "TYPE A NAME, ENTER TO KEEP, ESC TO CANCEL");
      gfx_measurestr(#g_lt, tw, th);
      glow_str(#g_lt, sx(gx + gw * 0.5) - tw * 0.5, sy(yb), lr, lg, lb);
    ) : (g_hk > 0 || g_now - g_tt < 1.6) ? (
      pname(g_hk > 0 ? g_hk : g_tk, #g_lt);
      glow_str(#g_lt, sx(gx + 8), sy(yb), lr, lg, lb);
      upper(fmt(g_hk > 0 ? g_hk : g_tk, #g_lv));
      gfx_measurestr(#g_lv, tw, th);
      glow_str(#g_lv, sx(gx + gw - 8) - tw, sy(yb), lr, lg, lb);
    ) : (
      fmt(2, #g_lt); strcat(#g_lt, "  "); strcat(#g_lt, fmt(3, #g_mi)); upper(#g_lt);
      glow_str(#g_lt, sx(gx + 8), sy(yb), lr, lg, lb);
      i = 0;
      loop(3,
        e = env_of(0, i); n = 1; loop(nchip - 1, e = max(e, env_of(n, i)); n += 1;); n = 0;
        n = 0;
        loop(6,
          gfx_set(lr, lg, lb, e > n * 42 ? 0.9 : 0.14);
          gfx_rect(sx(gx + 172 + i * 62 + n * 9), sy(yb + 2), 7 * z, 8 * z, 1);
          n += 1;
        );
        i += 1;
      );
    );
    gfx_set(0, 0, 0, 0.22);
    i = sy(gy);
    while (i < sy(gy + gh)) (gfx_rect(sx(gx), i, gw * z, max(1, floor(z)), 1); i += 3 * z;);
    gfx_set(1, 1, 1, 0.03);
    gfx_rect(sx(gx), sy(gy), gw * z, gh * z * 0.42, 1);
    (g_click && hovb) ? (gfx_x = sx(gx); gfx_y = sy(gy + 16); bank_menu(); g_click = 0;);
    (g_click && hovp) ? (gfx_x = sx(gx + gw * 0.5 - 60); gfx_y = sy(gy + 46); patch_menu(); g_click = 0;);
  );
);

function scope_view(x, y, w, h) local(QX, QY, QW, QH, i, n, st, tr, p, v, xx, yy, px, py, prev)
(
  g_col(6);
  g_pass == 0 ? (
    screen(x, y, w, h);
    font(1, 9, 'b'); gfx_set(0.45, 0.47, 0.5, 1);
    gfx_x = sx(x + 5); gfx_y = sy(y + 3); gfx_drawstr("OUTPUT");
  ) : (
    QX = sx(x + 2); QY = sy(y + 2); QW = (w - 4) * z; QH = (h - 4) * z;
    n = floor(QW / max(1, z));
    st = (sc_w - n * 2 - 600) & 2047;
    tr = st; i = 0; prev = SC_B[st];
    while (i < 600) (
      p = (st + i) & 2047; v = SC_B[p];
      (prev < 0 && v >= 0) ? (tr = p; i = 600;);
      prev = v; i += 1;
    );
    i = 0;
    loop(n,
      p = (tr + i * 2) & 2047;
      v = max(-1, min(1, SC_B[p] * 1.5));
      xx = QX + i / n * QW; yy = QY + QH * 0.5 - v * QH * 0.46;
      i > 0 ? (
        gfx_set(g_r, g_g, g_b, 0.16); gfx_line(px, py - z, xx, yy - z, 1); gfx_line(px, py + z, xx, yy + z, 1);
        gfx_set(g_r, g_g, g_b, 0.95); gfx_line(px, py, xx, yy, 1);
      );
      px = xx; py = yy; i += 1;
    );
  );
);

function logo() local(tw, th, i, x0, y0)
(
  g_pass == 0 ? (
    font(1, 30, 'b');
    gfx_measurestr("BYTE", tw, th);
    g_col(5);
    gfx_set(g_r, g_g, g_b, 0.18);
    gfx_x = sx(18) + z; gfx_y = sy(14) + 2 * z; gfx_drawstr("BYTE");
    gfx_set(g_r, g_g, g_b, 1);
    gfx_x = sx(18); gfx_y = sy(14); gfx_drawstr("BYTE");
    gfx_set(0.92, 0.93, 0.95, 1);
    gfx_x = sx(18) + tw; gfx_y = sy(14); gfx_drawstr(" ME");
    gfx_measurestr("BYTE ME", tw, th);
    x0 = sx(18) + tw + 12 * z; y0 = sy(17);
    i = 0;
    loop(5,
      g_col(i == 0 ? 0 : i == 1 ? 4 : i == 2 ? 1 : i == 3 ? 2 : 3);
      gfx_set(g_r, g_g, g_b, 1);
      gfx_triangle(x0 + (i * 9 + 10) * z, y0, x0 + (i * 9 + 16) * z, y0, x0 + (i * 9 + 6) * z, y0 + 24 * z, x0 + i * 9 * z, y0 + 24 * z);
      i += 1;
    );
    font(1, 11, 0);
    gfx_set(0.50, 0.52, 0.56, 1);
    gfx_x = sx(20); gfx_y = sy(47); gfx_drawstr("by chmaha  \xc2\xb7  based on reSID");
  );
);

// ---------------- voice editor ----------------
function voice_tab(x, y, w, h, v) local(hov, sel, QX, QY, QW, QH, e, used, wv, kk, i_)
(
  g_col(v < 3 ? v : 5);
  QX = sx(x); QY = sy(y); QW = w * z; QH = h * z;
  g_pass == 1 ? (
    hov = hit(x, y, w, h);
    sel = g_ev == v;
    used = v == 3 || !vpoly || v < vlay;
    gfx_set(0, 0, 0, 0.5); gfx_rect(QX - z, QY - z, QW + 2 * z, QH + 2 * z, 1);
    sel ? gfx_gradrect(QX, QY, QW, QH, g_r * 0.30, g_g * 0.30, g_b * 0.30, 1, 0, 0, 0, 0, -0.08 / QH, -0.08 / QH, -0.08 / QH, 0)
        : gfx_gradrect(QX, QY, QW, QH, 0.13, 0.135, 0.15, 1, 0, 0, 0, 0, -0.04 / QH, -0.04 / QH, -0.04 / QH, 0);
    hov ? (gfx_set(1, 1, 1, 0.05); gfx_rect(QX, QY, QW, QH, 1););
    sel ? (gfx_set(g_r, g_g, g_b, 1); gfx_rect(QX, QY + QH - 2 * z, QW, 2 * z, 1););
    font(1, 12, 'b');
    gfx_set(g_r, g_g, g_b, used ? 1 : 0.45);
    v < 3 ? sprintf(#g_tl, "VOICE %d", v + 1) : strcpy(#g_tl, "SETUP / FX");
    gfx_x = QX + 12 * z; gfx_y = QY + 5 * z; gfx_drawstr(#g_tl);
    font(1, 10, 'b');
    gfx_set(0.62, 0.64, 0.68, used ? 1 : 0.5);
    v == 3 ? strcpy(#g_tl, "Clock, arp, chip, digi, effects") : (
      wv = floor(slider(VS + v * NV) + 0.5); kk = floor(slider(VS + v * NV + 23) + 0.5);
      (vpoly && v >= vlay) ? strcpy(#g_tl, vlay == 1 ? "Plays the Voice 1 sound (Poly)" : "Not used by this Poly stack") :
      (vlay > 1 && v > 0) ? sprintf(#g_tl, slider(VS + v * NV + 4) ? "Layer %d of each Poly note" : "Layer %d (output off: mod only)", v + 1) :
      (kk && vmode) ? strcpy(#g_tl, kk == 1 ? "SID drum kit" : "Digi drum kit") :
      !slider(VS + v * NV + 4) ? strcpy(#g_tl, "Output off (mod source)") : wave_str(wv, #g_tl);
      vmode == 2 ? (sprintf(#g_mi, "Ch %d  \xc2\xb7  ", v + 1); strcat(#g_mi, #g_tl); strcpy(#g_tl, #g_mi););
      e = env_of(0, v); i_ = 1; loop(nchip - 1, e = max(e, env_of(i_, v)); i_ += 1;);
      gfx_set(0, 0, 0, 0.5); gfx_rect(QX + QW - 58 * z, QY + 12 * z, 46 * z, 10 * z, 1);
      g_col(v); gfx_set(g_r, g_g, g_b, 0.9); gfx_rect(QX + QW - 57 * z, QY + 13 * z, 44 * z * e / 255, 8 * z, 1);
      gfx_set(0.62, 0.64, 0.68, used ? 1 : 0.5);
    );
    gfx_x = QX + 12 * z; gfx_y = QY + 21 * z; gfx_drawstr(#g_tl);
    (g_click && hov) ? (g_ev = v; g_click = 0;);
  );
);

function adsr_graph(x, y, w, h, b, c) local(QX, QY, QW, QH, a, d, s, r, ta, td, tr, sc, x0, x1, x2, x3, x4, yb, yt, ys, px, py, e)
(
  g_col(c);
  g_pass == 0 ? screen(x, y, w, h) : (
    QX = sx(x + 6); QY = sy(y + 6); QW = (w - 12) * z; QH = (h - 12) * z;
    a = atk_ms(slider(b + 5)); d = atk_ms(slider(b + 6)) * 3; s = slider(b + 7) / 15; r = atk_ms(slider(b + 8)) * 3;
    ta = log(1 + a); td = log(1 + d); tr = log(1 + r);
    sc = max(ta + td + tr, 0.000001);
    ta = 0.02 + 0.74 * ta / sc; td = 0.02 + 0.74 * td / sc; tr = 0.02 + 0.74 * tr / sc;
    x0 = QX; x1 = x0 + ta * QW; x2 = x1 + td * QW; x3 = x2 + 0.2 * QW; x4 = x3 + tr * QW;
    yb = QY + QH; yt = QY; ys = QY + QH * (1 - s);
    gfx_set(0.035 + g_r * 0.16, 0.04 + g_g * 0.16, 0.045 + g_b * 0.16, 1);
    px = floor(x0);
    while (px < x4) (
      py = px + 0.5;
      py = py < x1 ? yb - (yb - yt) * (py - x0) / max(x1 - x0, 1) :
           py < x2 ? yt + (ys - yt) * (1 - exp(-3 * (py - x1) / max(x2 - x1, 1))) / (1 - exp(-3)) :
           py < x3 ? ys : ys + (yb - ys) * (1 - exp(-3 * (py - x3) / max(x4 - x3, 1))) / (1 - exp(-3));
      gfx_rect(px, floor(py), 1, ceil(yb) - floor(py), 1);
      px += 1;
    );
    gfx_set(g_r, g_g, g_b, 0.22);
    gfx_line(x1, yt, x1, yb, 1); gfx_line(x2, ys, x2, yb, 1); gfx_line(x3, ys, x3, yb, 1);
    e = env_of(0, g_ev);
    gfx_set(1, 1, 1, 0.5);
    gfx_line(QX, yb - QH * e / 255, QX + QW, yb - QH * e / 255, 1);
  );
);

function cell_str(row, val, str)
(
  row == 0 ? (
    strcpy(str, val == 0 ? "\xc2\xb7" : val >= 16 ? "OFF" : val == 1 ? "T" : val == 2 ? "S" : val == 3 ? "ST" : val == 4 ? "P" :
      val == 5 ? "PT" : val == 6 ? "PS" : val == 7 ? "PST" : val == 8 ? "N" : "N+");
  ) : val == 0 ? strcpy(str, "\xc2\xb7") : (row == 1 && val != floor(val)) ? sprintf(str, "%+.2f", val) : sprintf(str, "%+d", val);
  str;
);

function wave_menu(cur) local(sel)
(
  sprintf(#g_menu, "%sKeep|%sTriangle|%sSawtooth|%sPulse|%sNoise|%sSaw+Tri|%sPulse+Tri|%sPulse+Saw|%sPulse+Saw+Tri|%sGate off",
    cur == 0 ? "!" : "", cur == 1 ? "!" : "", cur == 2 ? "!" : "", cur == 4 ? "!" : "", cur == 8 ? "!" : "",
    cur == 3 ? "!" : "", cur == 5 ? "!" : "", cur == 6 ? "!" : "", cur == 7 ? "!" : "", cur >= 16 ? "!" : "");
  sel = gfx_showmenu(#g_menu);
  sel == 0 ? -1 : sel == 1 ? 0 : sel == 2 ? 1 : sel == 3 ? 2 : sel == 4 ? 4 : sel == 5 ? 8 : sel == 6 ? 3 : sel == 7 ? 5 : sel == 8 ? 6 : sel == 9 ? 7 : 16;
);

function lane_pos(v, r) ( v == 0 ? (r == 0 ? p0.ls0 : r == 1 ? p0.ls1 : r == 2 ? p0.ls2 : p0.ls3) :
  v == 1 ? (r == 0 ? p1.ls0 : r == 1 ? p1.ls1 : r == 2 ? p1.ls2 : p1.ls3) : (r == 0 ? p2.ls0 : r == 1 ? p2.ls1 : r == 2 ? p2.ls2 : p2.ls3); );

function lane_menu(v, row, st) local(ll, sp, sel, i)
(
  ll = TAB_B[v * TW + 64 + row]; sp = TAB_B[v * TW + 68 + row];
  sprintf(#g_menu, "#%s LANE|%sFollow the table|%sLane ends at step %d (%d steps)|>Lane speed|%sTable speed",
    row == 0 ? "WAVE" : row == 1 ? "NOTE" : row == 2 ? "PW" : "CUTOFF", ll == 0 ? "!" : "", ll == st + 1 ? "!" : "", st + 1, st + 1, sp == 0 ? "!" : "");
  i = 1; loop(8, strcat(#g_menu, sprintf(#g_mi, i == 8 ? "|<%s%d ticks" : i == 1 ? "|%s%d tick" : "|%s%d ticks", sp == i ? "!" : "", i)); i += 1;);
  sel = gfx_showmenu(#g_menu);
  sel == 2 ? (TAB_B[v * TW + 64 + row] = 0; TAB_B[v * TW + 68 + row] = 0; g_tabdirty = 1;) :
  sel == 3 ? (TAB_B[v * TW + 64 + row] = st + 1; g_tabdirty = 1;) :
  sel >= 4 ? (TAB_B[v * TW + 68 + row] = sel - 4; TAB_B[v * TW + 64 + row] == 0 ? TAB_B[v * TW + 64 + row] = max(1, floor(slider(VS + v * NV + 21) + 0.5)); g_tabdirty = 1;);
);

function table_grid(x, y, cw, rh, v, c) local(b, row, s, st, hov, a, val, lim, on, len, cur, act, newv, twd, th, pl, lp, re, pg, ll, lsp, rc, yc)
(
  g_col(c);
  b = VS + v * NV; pg = g_tpage * 8;
  on = slider(b + 19) >= 0.5; len = floor(slider(b + 21) + 0.5);
  lp = floor(slider(b + 22) + 0.5); re = floor(slider(b + 24) + 0.5);
  g_pass == 0 ? (
    font(1, 9, 'b');
    row = 0;
    s = 0; gfx_set(0.62, 0.64, 0.68, 1);
    loop(8, text_c(sprintf(#g_mi, "%d", pg + s + 1), x + s * cw + cw * 0.5, y + 2); s += 1;);
    screen(x, y + 18, cw * 8, rh * 4);
  ) : (
    cur = v == 0 ? p0.step : v == 1 ? p1.step : p2.step;
    act = (v == 0 ? p0.on || env_of(0, 0) : v == 1 ? p1.on || env_of(0, 1) : p2.on || env_of(0, 2)) && on;
    rc = (mouse_cap & 2) && !g_rprev;
    row = 0;
    loop(4,
      ll = TAB_B[v * TW + 64 + row]; lsp = TAB_B[v * TW + 68 + row]; yc = y + 20 + row * rh + rh * 0.5;
      font(1, 9, 'b');
      ll > 0 ? g_col(c) : 0;
      ll > 0 ? gfx_set(g_r, g_g, g_b, 1) : gfx_set(0.62, 0.64, 0.68, 1);
      text_r(row == 0 ? "WAVE" : row == 1 ? "NOTE" : row == 2 ? "PW \xc2\xb1" : "CUT \xc2\xb1", x - 6, ll > 0 ? yc - 10 : yc - 6);
      ll > 0 ? (font(1, 8, 'b'); text_r(lsp > 0 ? sprintf(#g_mi, "%d ST \xc2\xb7 %dT", ll, lsp) : sprintf(#g_mi, "%d STEPS", ll), x - 6, yc + 1););
      s = 0;
      loop(8,
        st = pg + s;
        (ll > 0 ? st < ll : st < len) ? (gfx_set(g_r, g_g, g_b, 0.05); gfx_rect(sx(x + s * cw), sy(y + 18 + row * rh), cw * z, rh * z, 1););
        (act && st == (ll > 0 ? lane_pos(v, row) : cur)) ? (gfx_set(g_r, g_g, g_b, 0.25); gfx_rect(sx(x + s * cw), sy(y + 18 + row * rh), cw * z, rh * z, 1););
        (ll > 0 && st == ll - 1) ? (gfx_set(g_r, g_g, g_b, 0.9); gfx_rect(sx(x + (s + 1) * cw) - 2 * z, sy(y + 18 + row * rh), 2 * z, rh * z, 1););
        (rc && hit(x + s * cw, y + 18 + row * rh, cw, rh)) ? (gfx_x = mouse_x; gfx_y = mouse_y; lane_menu(v, row, st); rc = 0;);
        s += 1;
      );
      row += 1;
    );
    g_col(c);
    s = 0;
    loop(8,
      st = pg + s;
      (st == lp && st < len) ? (gfx_set(g_r, g_g, g_b, 0.8); gfx_rect(sx(x + s * cw), sy(y + 18 + rh * 4) - 2 * z, cw * z, 2 * z, 1););
      (re > 0 && st == re - 1 && st < len) ? (gfx_set(1, 1, 1, 0.8); gfx_rect(sx(x + s * cw), sy(y + 18), cw * z, 2 * z, 1););
      s += 1;
    );
    gfx_set(1, 1, 1, 0.06);
    s = 1; loop(7, gfx_rect(sx(x + s * cw), sy(y + 18), max(1, z), rh * 4 * z, 1); s += 1;);
    row = 1; loop(3, gfx_rect(sx(x), sy(y + 18 + row * rh), cw * 8 * z, max(1, z), 1); row += 1;);
    font(2, 11, 'b');
    row = 0;
    loop(4,
      s = 0;
      loop(8,
        st = pg + s;
        a = TAB_B + v * TW + row * 16 + st;
        val = a[0];
        hov = hit(x + s * cw, y + 18 + row * rh, cw, rh);
        ll = TAB_B[v * TW + 64 + row];
        pl = (ll > 0 ? st < ll : st < len) && on;
        gfx_set(val ? 0.92 : 0.45, val ? 0.93 : 0.47, val ? 0.95 : 0.5, pl ? 1 : 0.35);
        hov ? gfx_set(g_r, g_g, g_b, 1);
        cell_str(row, val, #g_cs);
        (row == 1 && val != floor(val)) ? font(2, 9, 'b');
        gfx_measurestr(#g_cs, twd, th);
        gfx_x = sx(x + s * cw + cw * 0.5) - twd * 0.5; gfx_y = sy(y + 18 + row * rh + rh * 0.5) - th * 0.5;
        gfx_drawstr(#g_cs);
        (row == 1 && val != floor(val)) ? font(2, 11, 'b');
        hov ? (
          lim = row == 1 ? 48 : row == 2 ? 255 : 127;
          (g_click && row == 0) ? (
            gfx_x = sx(x + s * cw); gfx_y = sy(y + 18 + rh);
            newv = wave_menu(val);
            newv >= 0 ? (a[0] = newv; g_tabdirty = 1;);
            g_click = 0;
          );
          (g_click && row > 0) ? (
            (g_lcell == a && g_now - g_lct < 0.3) ? (a[0] = 0; g_tabdirty = 1; g_cdrag = 0;) : (g_cdrag = a; g_cy0 = mouse_y; g_cv0 = val; g_clim = lim; g_cfine = row == 1 && (mouse_cap & 8););
            g_lcell = a; g_lct = g_now; g_click = 0;
          );
          (mouse_wheel != 0 && row > 0) ? (
            (row == 1 && (mouse_cap & 8)) ? a[0] = max(-lim, min(lim, floor((val + (mouse_wheel > 0 ? 1 : -1) * ((mouse_cap & 4) ? 0.01 : 0.05)) * 100 + 0.5) / 100))
              : a[0] = max(-lim, min(lim, val + (mouse_wheel > 0 ? 1 : -1) * ((mouse_cap & 4) ? 10 : 1)));
            g_tabdirty = 1; mouse_wheel = 0;
          );
        );
        s += 1;
      );
      row += 1;
    );
  );
);

function voice_editor(v) local(b, c, used, kit)
(
  b = VS + v * NV; c = v;
  used = !vpoly || v < vlay;
  kit = floor(slider(b + 23) + 0.5) && vmode;
  panel(10, 240, 318, 280, "OSCILLATOR", c);
  panel(336, 240, 318, 280, "ENVELOPE & PITCH", c);
  panel(662, 240, 308, 280, "STEP TABLE", c);
  wave_btn(24, 268, 68, 40, b, 1, "TRIANGLE", c);
  wave_btn(98, 268, 68, 40, b, 2, "SAWTOOTH", c);
  wave_btn(172, 268, 68, 40, b, 4, "PULSE", c);
  wave_btn(246, 268, 68, 40, b, 8, "NOISE", c);
  toggle(24, 332, 68, 20, b + 4, "OUTPUT", c, used);
  toggle(98, 332, 68, 20, b + 1, "SYNC", c, used);
  toggle(172, 332, 68, 20, b + 2, "RING", c, used);
  toggle(246, 332, 68, 20, b + 3, "FILTER", c, used);
  toggle(24, 358, 106, 20, b + 9, "HARD RESTART", c, used);
  toggle(136, 358, 96, 20, b + 25, "OSC RESET", c, used);
  vmode ? enum_dd(240, 358, 74, 20, b + 23, "", c);
  g_pass == 0 ? (
    font(1, 9, 'b'); gfx_set(0.42, 0.44, 0.48, 1);
    text_l(v == 0 ? "CTRL-CLICK WAVES TO COMBINE  \xc2\xb7  SYNC/RING FROM V3" : v == 1 ? "CTRL-CLICK WAVES TO COMBINE  \xc2\xb7  SYNC/RING FROM V1" : "CTRL-CLICK WAVES TO COMBINE  \xc2\xb7  SYNC/RING FROM V2", 24, 388);
    gfx_set(1, 1, 1, 0.06); gfx_rect(sx(24), sy(404), 290 * z, max(1, z), 1);
    text_l("PULSE", 24, 414);
  );
  knob(64, 460, 17, b + 16, 0, "WIDTH", c, used);
  knob(166, 460, 17, b + 17, 0, "SWEEP", c, used);
  knob(268, 460, 17, b + 18, 0, "SWEEP DEPTH", c, used);

  adsr_graph(350, 266, 290, 60, b, c);
  knob(386, 360, 16, b + 5, 0, "ATTACK", c, used);
  knob(458, 360, 16, b + 6, 0, "DECAY", c, used);
  knob(530, 360, 16, b + 7, 0, "SUSTAIN", c, used);
  knob(602, 360, 16, b + 8, 0, "RELEASE", c, used);
  g_pass == 0 ? (
    font(1, 9, 'b'); gfx_set(0.42, 0.44, 0.48, 1);
    text_l("PITCH", 350, 398); text_l("VIBRATO", 522, 398);
    gfx_set(1, 1, 1, 0.06); gfx_rect(sx(512), sy(398), max(1, z), 108 * z, 1);
  );
  knob(366, 446, 14, b + 10, 1, "TRANSP", c, used);
  knob(412, 446, 14, b + 11, 1, "FINE", c, used);
  knob(452, 446, 14, b + 12, 0, "GLIDE", c, used);
  knob(492, 446, 14, b + 26, 0, "FIXED", c, used);
  knob(540, 446, 14, b + 13, 0, "DEPTH", c, used);
  knob(584, 446, 14, b + 14, 0, "SPEED", c, used);
  knob(628, 446, 14, b + 15, 0, "DELAY", c, used);

  toggle(676, 274, 48, 20, b + 19, "ON", c, used);
  knob(746, 284, 12, b + 20, 0, "SPEED", c, used);
  knob(790, 284, 12, b + 21, 0, "LENGTH", c, used);
  enum_dd(822, 274, 66, 20, b + 22, "LOOP TO", c);
  enum_dd(896, 274, 66, 20, b + 24, "RELEASE", c);
  table_grid(718, 316, 30, 26, v, c);
  btn(718, 442, 56, 16, "1 - 8", g_tpage == 0, c, 1) ? g_tpage = 0;
  btn(778, 442, 56, 16, "9 - 16", g_tpage == 1, c, 1) ? g_tpage = 1;
  g_pass == 0 ? (
    font(1, 9, 0); gfx_set(0.45, 0.47, 0.5, 1);
    kit ? (
      text_l("Drum kit: GM drum notes (35-59) play built-in", 676, 466);
      text_l(floor(slider(b + 23) + 0.5) == 1 ? "SID drums on this voice." : "4-bit volume-register digi drums.", 676, 480);
    ) : (
      text_l("WAVE cells: click for a menu. NOTE/PW/CUT: drag or", 676, 466);
      text_l("scroll (Ctrl x10), double-click clears. Underline = loop", 676, 480);
      text_l("start, top line = release step (played after note-off).", 676, 494);
      text_l("Shift on NOTE = cents. Right-click: lane length/speed.", 676, 508);
    );
  );
);

function setup_page()
(
  panel(10, 240, 318, 280, "CLOCK & ARP", 5);
  panel(336, 240, 318, 280, "CHIP & DIGI", 3);
  panel(662, 240, 308, 280, "EFFECTS", 4);
  enum_dd(24, 276, 120, 22, 95, "TICK CLOCK", 5);
  enum_dd(154, 276, 70, 22, 96, "TICKS/BEAT", 5);
  enum_dd(24, 334, 120, 22, 97, "ARP MODE", 5);
  enum_dd(154, 334, 90, 22, 98, "ARP RANGE", 5);
  knob(282, 346, 17, 99, 0, "ARP GATE", 5, 1);
  enum_dd(24, 400, 140, 22, 102, "VELOCITY", 5);
  knob(214, 410, 17, 103, 1, "MASTER TUNE", 5, 1);
  g_pass == 0 ? (
    font(1, 9, 0); gfx_set(0.45, 0.47, 0.5, 1);
    text_l("Tables, arps, vibrato and glide count ticks: C64 PAL or", 24, 452);
    text_l("NTSC frames, or ticks locked to the project tempo.", 24, 466);
    text_l("Gate below 100% re-strikes every arp step (and repeats", 24, 480);
    text_l("a single held note). Speed is ARP on the PLAY strip.", 24, 494);
  );

  knob(378, 300, 17, 100, 1, "6581 FILTER BIAS", 3, sidm == 0);
  enum_dd(430, 286, 100, 22, 101, "COMBINED WAVES", 3);
  enum_dd(540, 286, 104, 22, 115, "EXTRA SIDS", 3);
  knob(378, 380, 17, 116, 0, "WIDTH", 3, nchip > 1);
  knob(446, 380, 17, 117, 0, "SID 2 DETUNE", 3, sid2m == 1 || (sid2m >= 2 && !vpoly));
  knob(530, 380, 17, 104, 0, "DIGI LEVEL", 3, 1);
  toggle(566, 370, 80, 20, 105, "8580 BOOST", 3, 1);
  toggle(566, 394, 80, 20, 121, "AUTHENTIC", 3, 1);
  g_pass == 0 ? (
    font(1, 9, 0); gfx_set(0.45, 0.47, 0.5, 1);
    text_l("Filter bias: chip-to-chip cutoff variation (6581 only).", 350, 424);
    text_l("Extra SIDs: Wide doubles voices on a detuned chip; the", 350, 438);
    text_l("Poly settings add chips (6/9/12 voices) in Poly mode.", 350, 452);
    text_l("Digi drums: Drum Kit = Digi on a voice, or MIDI ch 4 in", 350, 466);
    text_l("Multi mode. AUTHENTIC plays them through the volume", 350, 480);
    text_l("register like real C64 digis (it modulates every voice).", 350, 494);
  );

  g_pass == 0 ? (font(1, 9, 'b'); gfx_set(0.42, 0.44, 0.48, 1); text_l("CHORUS", 676, 266); text_l("DELAY", 676, 352););
  knob(706, 312, 16, 106, 0, "MIX", 4, 1);
  knob(766, 312, 16, 107, 0, "RATE", 4, 1);
  knob(826, 312, 16, 108, 0, "DEPTH", 4, 1);
  enum_dd(796, 450, 110, 20, 111, "", 4);
  knob(706, 400, 16, 109, 0, "MIX", 4, 1);
  knob(766, 400, 16, 110, 0, "TIME", 4, slider111 < 0.5);
  knob(826, 400, 16, 112, 0, "FEEDBACK", 4, 1);
  knob(886, 400, 16, 114, 0, "DAMPING", 4, 1);
  toggle(676, 450, 96, 20, 113, "PING-PONG", 4, 1);
  g_pass == 0 ? (
    font(1, 9, 0); gfx_set(0.45, 0.47, 0.5, 1);
    text_l("Effects run after the chip (not on a real C64).", 676, 480);
    text_l("Delay SYNC follows the project tempo.", 676, 494);
  );
);


function keyboard(x, y, w, h) local(nw, ww, bw, bh, QX, QY, QH, hovn, n, wi, pc, isb, bx, oct, down, vel, kx, kw, lit)
(
  nw = 43; ww = w / nw; bw = ww * 0.62; bh = h * 0.62;
  QX = sx(x); QY = sy(y); QH = h * z;
  g_pass == 0 ? soft_shadow(x, y, w, h, 3, max(3, floor(5 * z)), 0.12) : (
    hovn = -1;
    (mouse_y >= QY && mouse_y < QY + QH && mouse_x >= QX && mouse_x < QX + w * z) ? (
      n = 36; wi = 0;
      loop(73,
        pc = n % 12; isb = pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10;
        isb ? (bx = x + wi * ww - bw * 0.5; (mouse_y < QY + bh * z && mouse_x >= sx(bx) && mouse_x < sx(bx + bw)) ? hovn = n;);
        !isb ? wi += 1;
        n += 1;
      );
      hovn < 0 ? (wi = floor((mouse_x - QX) / (ww * z)); oct = floor(wi / 7); pc = wi - oct * 7;
        hovn = 36 + oct * 12 + (pc == 0 ? 0 : pc == 1 ? 2 : pc == 2 ? 4 : pc == 3 ? 5 : pc == 4 ? 7 : pc == 5 ? 9 : 11););
    );
    down = mouse_cap & 1;
    (g_click && hovn >= 0) ? (g_kbn = -1; g_kbon = 1; g_click = 0;);
    g_kbon && !down ? (
      g_kbn >= 0 ? (GQ_B[gq_w * 3] = 128; GQ_B[gq_w * 3 + 1] = g_kbn; GQ_B[gq_w * 3 + 2] = 0; gq_w = (gq_w + 1) % 64;);
      g_kbn = -1; g_kbon = 0;
    );
    (g_kbon && down && hovn != g_kbn && hovn >= 0 && hovn <= 127) ? (
      g_kbn >= 0 ? (GQ_B[gq_w * 3] = 128; GQ_B[gq_w * 3 + 1] = g_kbn; GQ_B[gq_w * 3 + 2] = 0; gq_w = (gq_w + 1) % 64;);
      vel = floor(40 + 87 * clamp01((mouse_y - QY) / QH));
      GQ_B[gq_w * 3] = 144; GQ_B[gq_w * 3 + 1] = hovn; GQ_B[gq_w * 3 + 2] = vel; gq_w = (gq_w + 1) % 64;
      g_kbn = hovn;
    );
    kb_ch = g_ev < 3 ? g_ev : 0;
    n = 36; wi = 0;
    loop(73,
      pc = n % 12; isb = pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10;
      !isb ? (
        kx = floor(sx(x + wi * ww)) + max(1, floor(z));
        kw = floor(sx(x + (wi + 1) * ww)) - kx;
        lit = KD_B[n] || g_kbn == n;
        lit ? (g_col(6); gfx_gradrect(kx, QY, kw, QH, g_r, g_g, g_b, 1, 0, 0, 0, 0, -0.2 / QH, -0.2 / QH, -0.2 / QH, 0);) :
              gfx_gradrect(kx, QY, kw, QH, 0.77, 0.78, 0.81, 1, 0, 0, 0, 0, 0.12 / QH, 0.12 / QH, 0.12 / QH, 0);
        gfx_set(0, 0, 0, 0.18); gfx_rect(kx, QY, kw, 2 * z, 1);
        pc == 0 ? (font(1, 8, 'b'); gfx_set(0.35, 0.36, 0.4, 1); text_c(sprintf(#g_kl, "C%d", floor(n / 12) - 1), x + wi * ww + ww * 0.5, y + h - 12););
        wi += 1;
      );
      n += 1;
    );
    n = 36; wi = 0;
    loop(73,
      pc = n % 12; isb = pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10;
      isb ? (
        bx = floor(sx(x + wi * ww - bw * 0.5));
        lit = KD_B[n] || g_kbn == n;
        gfx_set(0, 0, 0, 0.35); gfx_rect(bx + z, QY, bw * z, bh * z + 2 * z, 1);
        lit ? (g_col(6); gfx_gradrect(bx, QY, bw * z, bh * z, g_r * 0.8, g_g * 0.8, g_b * 0.8, 1, 0, 0, 0, 0, 0.1 / (bh * z), 0.1 / (bh * z), 0.1 / (bh * z), 0);) : (
          gfx_gradrect(bx, QY, bw * z, bh * z, 0.08, 0.085, 0.095, 1, 0, 0, 0, 0, 0.1 / (bh * z), 0.1 / (bh * z), 0.1 / (bh * z), 0);
          gfx_set(1, 1, 1, 0.10); gfx_rect(bx + 2 * z, QY + bh * z - 7 * z, bw * z - 4 * z, 5 * z, 1);
        );
      );
      !isb ? wi += 1;
      n += 1;
    );
  );
);

function copy_voice(v) local(k) ( k = 0; loop(NV, g_clip[k] = slider(VS + v * NV + k); k += 1;); memcpy(g_clip + NV, TAB_B + v * TW, TW); g_has_clip = 1; );
function paste_voice(v) local(k)
(
  k = 0; loop(NV, set_slider(VS + v * NV + k, g_clip[k]); end_touch(VS + v * NV + k); k += 1;);
  memcpy(TAB_B + v * TW, g_clip + NV, TW); sliderchange(-1);
);
function init_voice(v) local(k)
(
  k = 0; loop(NV, set_slider(VS + v * NV + k, sdef(VS + k)); end_touch(VS + v * NV + k); k += 1;);
  memset(TAB_B + v * TW, 0, TW); sliderchange(-1);
);

function layout()
(
  logo();
  lcd();
  scope_view(700, 12, 104, 66);
  g_ub = floor(slider94 + 0.5) == 1;
  (!g_ub || floor(slider1 + 0.5) != g_nedp) ? g_nedit = 0;
  btn(812, 12, 70, 20, "STORE", 0, 5, 1) ? store_menu();
  btn(812, 35, 70, 20, "INIT", 0, 5, g_ub) ? init_req = 1;
  btn(812, 58, 70, 20, "NAME", g_nedit, 5, g_ub) ? (
    g_nedit = !g_nedit;
    g_nedit ? (g_nedp = floor(slider1 + 0.5); UB_B[g_nedp * US] >= 0 ? slot_name(g_nedp, #g_ned) : strcpy(#g_ned, ""););
  );
  btn(888, 12, 82, 20, "COPY VOICE", 0, 5, g_ev < 3) ? copy_voice(g_ev);
  btn(888, 35, 82, 20, "PASTE VOICE", 0, 5, g_has_clip && g_ev < 3) ? paste_voice(g_ev);
  btn(888, 58, 82, 20, "INIT VOICE", 0, 5, g_ev < 3) ? init_voice(g_ev);

  panel(10, 90, 318, 100, "CHIP", 3);
  panel(336, 90, 244, 100, "FILTER", 4);
  panel(588, 90, 382, 100, "PLAY", 5);
  enum_dd(24, 132, 90, 22, 2, "MODEL", 3);
  enum_dd(124, 132, 90, 22, 3, "VOICE MODE", 3);
  enum_dd(224, 132, 90, 22, 11, "QUALITY", 3);
  knob(372, 146, 17, 4, 0, "CUTOFF", 4, 1);
  knob(440, 146, 17, 5, 0, "RESONANCE", 4, 1);
  enum_dd(478, 132, 90, 22, 6, "TYPE", 4);
  knob(622, 146, 17, 7, 0, "ARP", 5, !vpoly);
  enum_dd(656, 132, 80, 22, 8, "KEYS", 5);
  enum_dd(744, 132, 64, 22, 9, "BEND", 5);
  enum_dd(816, 132, 80, 22, 12, "MIDI", 5);
  knob(930, 146, 17, 10, 1, "VOLUME", 5, 1);

  voice_tab(10, 198, 232, 36, 0);
  voice_tab(248, 198, 232, 36, 1);
  voice_tab(486, 198, 232, 36, 2);
  voice_tab(724, 198, 246, 36, 3);
  g_ev < 3 ? voice_editor(g_ev) : setup_page();
  keyboard(10, 530, 960, 76);
);

g_mdown = mouse_cap & 1;
g_click = g_mdown && !g_mprev;
!g_mdown ? (
  g_drag >= 0 ? end_touch(g_drag);
  g_drag = -1;
  g_cdrag ? (g_cdrag = 0; g_tabdirty = 1;);
);
!g_inited ? (g_drag = -1; g_lck = -1; g_tk = 0; g_tt = -10; g_ev = 0; g_inited = 1;);
g_cdrag ? (
  g_cfine ? g_cdrag[0] = max(-g_clim, min(g_clim, floor((g_cv0 + floor((g_cy0 - mouse_y) / (6 * z)) * ((mouse_cap & 4) ? 0.01 : 0.05)) * 100 + 0.5) / 100))
          : g_cdrag[0] = max(-g_clim, min(g_clim, g_cv0 + floor((g_cy0 - mouse_y) / (6 * z) * ((mouse_cap & 4) ? 10 : 1))));
);
g_tabdirty && !g_cdrag ? (sliderchange(-1); g_tabdirty = 0;);

(gfx_w != g_bw || gfx_h != g_bh || g_ev != g_bev || vmode != g_bvm || g_tpage != g_btp || sidm != g_bsm || nchip != g_bnc) ? (
  gfx_setimgdim(1, gfx_w, gfx_h);
  gfx_dest = 1;
  gfx_set(0.075, 0.078, 0.088, 1);
  gfx_rect(0, 0, gfx_w, gfx_h, 1);
  gfx_gradrect(0, 0, gfx_w, gfx_h, 0.11, 0.115, 0.13, 1, 0, 0, 0, 0, -0.05 / gfx_h, -0.05 / gfx_h, -0.05 / gfx_h, 0);
  g_pass = 0;
  layout();
  gfx_dest = -1;
  g_bw = gfx_w; g_bh = gfx_h; g_bev = g_ev; g_bvm = vmode; g_btp = g_tpage; g_bsm = sidm; g_bnc = nchip;
);
gfx_x = gfx_y = 0;
gfx_blit(1, 1, 0);

name_keys();
g_pass = 1;
g_hk = -1; g_ht = 0;
layout();
g_hk > 0 ? (g_col(g_hc); fmt(g_hk, #g_tip); tooltip(g_hx, g_hy, #g_tip););

mouse_wheel = 0;
g_mprev = g_mdown;
g_rprev = mouse_cap & 2;
