function pick_patch(b, p)
(
  slider94 = b; slider1 = p;
  automate(94, 0); automate(94, 1); automate(1, 0); automate(1, 1);
);

function slot_name(p, str) local(a, i)
(
  a = UB_B + p * US;
  strcpy(str, "");
  a[0] >= 0 ? (i = 0; loop(a[0], strcat(str, sprintf(#g_ch, "%c", a[1 + i])); i += 1;)) : strcpy(str, "New Preset");
  str;
);

function cur_name(str) ( floor(slider94 + 0.5) ? slot_name(floor(slider1 + 0.5), str) : patch_name(floor(slider1 + 0.5), str); );

function menu_add_name(str) local(i, c, n)
(
  n = strlen(str); i = 0;
  loop(n, c = str_getchar(str, i); c == 38 ? strcat(#g_menu, "&&") : c == 124 ? strcat(#g_menu, "/") : strcat(#g_menu, sprintf(#g_ch, "%c", c)); i += 1;);
);

function step_patch(d) local(b, p, n)
(
  b = floor(slider94 + 0.5); p = floor(slider1 + 0.5);
  b ? (
    n = 0;
    while (p = (p + d + USLOTS) % USLOTS; n += 1; UB_B[p * US] < 0 && n < USLOTS;);
    UB_B[p * US] >= 0 ? pick_patch(1, p);
  ) : pick_patch(0, (p + d + NPATCH) % NPATCH);
);

function bank_menu() local(sel, b, i)
(
  b = floor(slider94 + 0.5);
  sel = gfx_showmenu(b ? "Factory|!User" : "!Factory|User");
  (sel > 0 && sel - 1 != b) ? (
    i = 0;
    sel == 2 ? (while (i < USLOTS - 1 && UB_B[i * US] < 0) (i += 1;); UB_B[i * US] < 0 ? i = 0;);
    pick_patch(sel - 1, i);
  );
);

function patch_menu() local(i, g, sel, b, cp)
(
  b = floor(slider94 + 0.5); cp = floor(slider1 + 0.5);
  strcpy(#g_menu, "");
  !b ? (
    strcat(#g_menu, ">Lead");
    strcat(#g_menu, cp == 0 ? "|!Pulse Hero" : "|Pulse Hero");
    strcat(#g_menu, cp == 1 ? "|!Sync Scream" : "|Sync Scream");
    strcat(#g_menu, cp == 2 ? "|!Sync Sweep Loop" : "|Sync Sweep Loop");
    strcat(#g_menu, cp == 3 ? "|!Octave Stack" : "|Octave Stack");
    strcat(#g_menu, cp == 4 ? "|!Detuned Pulse Duo" : "|Detuned Pulse Duo");
    strcat(#g_menu, cp == 5 ? "|!Soft Square" : "|Soft Square");
    strcat(#g_menu, cp == 6 ? "|!Saw Solo" : "|Saw Solo");
    strcat(#g_menu, cp == 7 ? "|!Wah Filter" : "|Wah Filter");
    strcat(#g_menu, cp == 8 ? "|!Ring Bell" : "|Ring Bell");
    strcat(#g_menu, cp == 9 ? "|!Ring Buzz" : "|Ring Buzz");
    strcat(#g_menu, cp == 10 ? "|!Hard Stab" : "|Hard Stab");
    strcat(#g_menu, cp == 11 ? "|!Hollow Tri Flute" : "|Hollow Tri Flute");
    strcat(#g_menu, cp == 12 ? "|!Combined Wave 8580" : "|Combined Wave 8580");
    strcat(#g_menu, cp == 13 ? "|!8580 Sync Brass" : "|8580 Sync Brass");
    strcat(#g_menu, cp == 14 ? "|!Wide Twin Pulse" : "|Wide Twin Pulse");
    strcat(#g_menu, cp == 15 ? "|!Echo Lead" : "|Echo Lead");
    strcat(#g_menu, cp == 16 ? "|!Chorus Saw" : "|Chorus Saw");
    strcat(#g_menu, cp == 17 ? "|!Sync Pad Lead" : "|Sync Pad Lead");
    strcat(#g_menu, cp == 18 ? "|!Staccato Pulse" : "|Staccato Pulse");
    strcat(#g_menu, cp == 19 ? "|!Ring Glass (fixed)" : "|Ring Glass (fixed)");
    strcat(#g_menu, cp == 20 ? "|!Sync Growl (fixed)" : "|Sync Growl (fixed)");
    strcat(#g_menu, cp == 21 ? "|!8580 Chorus Flute" : "|8580 Chorus Flute");
    strcat(#g_menu, cp == 22 ? "|!Classic Pulse Vibrato" : "|Classic Pulse Vibrato");
    strcat(#g_menu, cp == 23 ? "|!Classic Noise-Tick Saw" : "|Classic Noise-Tick Saw");
    strcat(#g_menu, cp == 24 ? "|!Scoop Up (cents)" : "|Scoop Up (cents)");
    strcat(#g_menu, cp == 25 ? "|!Fall Off (cents)" : "|Fall Off (cents)");
    strcat(#g_menu, cp == 26 ? "|!Detune Wobble (lanes)" : "|Detune Wobble (lanes)");
    strcat(#g_menu, cp == 27 ? "|!Modern Filter Lead" : "|Modern Filter Lead");
    strcat(#g_menu, cp == 28 ? "|!Saw Trio Stack" : "|Saw Trio Stack");
    strcat(#g_menu, cp == 29 ? "|!Glide Square Mono" : "|Glide Square Mono");
