// ---------------- decimator (one ring per chip) ----------------
function bessel_i0(x) local(s, t, k) ( s = t = k = 1; loop(30, t *= sqr(x * 0.5 / k); s += t; k += 1;); s; );

function dec_design() local(L, wc, i, t, sum, i0b)
(
  L = 32 * osf; dec_l = L;
  wc = (min(20000, 0.45 * srate) + srate * 0.5) * 0.5 / (srate * osf);
  i0b = bessel_i0(7);
  sum = 0; i = 0;
  loop(L,
    t = i - (L - 1) * 0.5;
    DH_B[i] = (sin(2 * $pi * wc * t) / ($pi * t)) * (bessel_i0(7 * sqrt(max(0, 1 - sqr(2 * t / (L - 1))))) / i0b);
    sum += DH_B[i]; i += 1;
  );
  i = 0; loop(L, DH_B[i] /= sum; i += 1;);
  memset(DR_B, 0, 2048); memset(DW_B, 0, 4);
);

function dec_push(ch, x) local(b, w)
(
  b = DR_B + ch * 512; w = DW_B[ch];
  b[w] = b[w + 256] = x; DW_B[ch] = (w + 1) & 255;
);

function dec_out(ch) local(b, e, i, s)
(
  b = DR_B + ch * 512 + DW_B[ch] + (256 - dec_l); e = b + (dec_l - 1);
  s = 0; i = 0;
  loop(dec_l * 0.5, s += DH_B[i] * (b[i] + e[-i]); i += 1;);
  s;
);

// ---------------- FX: chorus + delay ----------------
function fx_init()
(
  fx_cl = FX_B; fx_cr = FX_B + 4096; fx_dl = FX_B + 8192; fx_dlen = floor(2 * srate); fx_dr = fx_dl + fx_dlen;
  memset(FX_B, 0, 8192 + 2 * fx_dlen);
  fx_cw = fx_dw = 0; fx_lpl = fx_lpr = 0; fx_ph = 0; fx_tail = 0;
);

function fx_read(b, n, pos) local(i, f, a) ( i = floor(pos); f = pos - i; a = b[(i + n) % n]; a + (b[(i + 1 + n) % n] - a) * f; );

function fx_process() local(cm, d, dl, dr, ml, mr, t, fb, dm, damp, il, ir, wl, wr_)
(
  cm = slider106 * 0.01;
  cm > 0 ? (
    fx_cl[fx_cw] = outl; fx_cr[fx_cw] = outr;
    fx_ph += slider107 / srate; fx_ph >= 1 ? fx_ph -= 1;
    d = srate * 0.0001 * slider108;
    dl = fx_cw - (srate * 0.007 + d * (1 + sin(2 * $pi * fx_ph)));
    dr = fx_cw - (srate * 0.007 + d * (1 + cos(2 * $pi * fx_ph)));
    ml = fx_read(fx_cl, 4096, dl); mr = fx_read(fx_cr, 4096, dr);
    outl = outl * (1 - cm * 0.5) + ml * cm; outr = outr * (1 - cm * 0.5) + mr * cm;
    fx_cw = (fx_cw + 1) & 4095;
  );
  dm = slider109 * 0.01;
  (dm > 0 || fx_tail > 0) ? (
    t = floor(slider111 + 0.5);
    t = t == 0 ? slider110 * 0.001 : (60 / max(tempo, 20)) * (t == 1 ? 0.25 : t == 2 ? 1 / 3 : t == 3 ? 0.5 : t == 4 ? 0.75 : t == 5 ? 1 : t == 6 ? 1.5 : 2);
    t = min(fx_dlen - 2, max(1, t * srate));
    fb = slider112 * 0.01; damp = slider114 * 0.009;
    wl = fx_read(fx_dl, fx_dlen, fx_dw - t); wr_ = fx_read(fx_dr, fx_dlen, fx_dw - t);
    fx_lpl += (wl - fx_lpl) * (1 - damp); fx_lpr += (wr_ - fx_lpr) * (1 - damp);
    slider113 >= 0.5 ? (
      il = (outl + outr) * 0.5 + fx_lpr * fb; ir = fx_lpl * fb;
    ) : (
      il = outl + fx_lpl * fb; ir = outr + fx_lpr * fb;
    );
    fx_dl[fx_dw] = il; fx_dr[fx_dw] = ir;
    fx_dw = (fx_dw + 1) % fx_dlen;
    outl += wl * dm; outr += wr_ * dm;
    fx_tail = (abs(wl) + abs(wr_) > 0.00001 || dm > 0) ? srate : fx_tail - 1;
  );
);

// ---------------- clocks ----------------
function set_rate() local(q)
(
  q = floor(slider11 + 0.5);
  clk = floor(slider95 + 0.5);
  sidclk = clk == 1 ? 1022727 : 985248;
  frame_hz = clk == 1 ? 1022727 / 17095 : 985248 / 19656;
  osf = q == 0 ? 1 : q == 1 ? (srate < 70000 ? 2 : 1) : (srate < 70000 ? 4 : srate < 140000 ? 2 : 1);
  cps = floor(sidclk / (srate * osf) * 65536 + 0.5);
  osf > 1 ? dec_design();
  fx_init();
  cid_lim = floor(srate * 0.25);
  cur_q = q; cur_sr = srate; cur_clk = clk;
);

function tick_setup() local(t)
(
  t = floor(slider96 + 0.5);
  tpb = t == 0 ? 4 : t == 1 ? 6 : t == 2 ? 8 : t == 3 ? 12 : t == 4 ? 16 : t == 5 ? 24 : t == 6 ? 32 : 48;
  host_tick = clk == 2;
  tick_inc = host_tick ? (max(tempo, 20) / 60 * tpb) / srate : frame_hz / srate;
);

