  v2.gate = p[104];
  v2.rrc = p[105];
  v2.ep = p[106];
  v2.xp = p[107];
  flp.vx = p[108];
  flp.vc = p[109];
  fbp.vx = p[110];
  fbp.vc = p[111];
  ffc = p[112];
  fres = p[113];
  ffilt = p[114];
  fmode = p[115];
  fvol = p[116];
  fVhp = p[117];
  fVbp = p[118];
  fVlp = p[119];
  fv1 = p[120];
  fv2 = p[121];
  fv3 = p[122];
  fve = p[123];
  fvm = p[124];
  fsum = p[125];
  fmix = p[126];
  f8q = p[127];
  fq1024 = p[128];
  fw0 = p[129];
  fVddtVw2 = p[130];
  fVwb = p[131];
  efLp = p[132];
  efHp = p[133];
);
function chip_env(p, i) ( i == 0 ? p[18] : i == 1 ? p[54] : p[90]; );


function hard_restart_live(i)
(
  i == 0 ? (v0.rc = v0.ec = 0; v0.env == 255 ? v0.env = 254;) :
  i == 1 ? (v1.rc = v1.ec = 0; v1.env == 255 ? v1.env = 254;) :
           (v2.rc = v2.ec = 0; v2.env == 255 ? v2.env = 254;);
);

function chip_write(r, v) ( r >= 100 ? hard_restart_live(r - 100) : sid_write(r, v); );

function queue_flush(ch) local(q, n, i)
(
  q = QW_B + ch * 512; n = QN_B[ch];
  i = 0; loop(n, chip_write(q[i * 2], q[i * 2 + 1]); i += 1;);
  QN_B[ch] = 0;
);

function wrf(ch, r, v) local(q, n)
(
  r < 100 ? RSH_B[ch * 32 + r] = v;
  ((r == 0x17 || r == 0x18) && idle_n >= srate) ? dc_settle = 1;
  ch == lc ? chip_write(r, v) : (
    q = QW_B + ch * 512; n = QN_B[ch];
    n < 250 ? (q[n * 2] = r; q[n * 2 + 1] = v; QN_B[ch] = n + 1;);
  );
);
function wrc(ch, r, v) ( RSH_B[ch * 32 + r] !== v ? wrf(ch, r, v); );
function wrg(r, v) local(c) ( c = 0; loop(nchip, wrc(c, r, v); c += 1;); );

function env_of(ch, i) ( ch == lc ? (i == 0 ? v0.env : i == 1 ? v1.env : v2.env) : chip_env(CHS_B + ch * 256, i); );

// ---------------- digi drums (4-bit volume-register samples) ----------------
function dg_noise() ( dg_lf = (dg_lf * 1103515245 + 12345) % 2147483648; dg_lf / 1073741824 - 1; );

function dg_make(k, len, kind) local(i, t, x, ph, ph2, pk, lp, hp, prev, b, n)
(
  b = dg_top; DGS_B[k * 2] = b; n = floor(len * 8000); DGS_B[k * 2 + 1] = n;
  ph = ph2 = lp = hp = prev = 0; pk = 0.000001; i = 0;
  loop(n,
    t = i / 8000;
    kind == 0 ? (ph += (45 + 130 * exp(-t * 28)) / 8000; x = sin(2 * $pi * ph) * exp(-t * 9);) :
    kind == 1 ? (ph += 190 / 8000; x = (dg_noise() * 0.8 * exp(-t * 16)) + sin(2 * $pi * ph) * exp(-t * 30);) :
    kind == 2 ? (x = dg_noise(); hp = x - prev; prev = x; x = hp * exp(-t * 70);) :
    kind == 3 ? (x = dg_noise(); hp = x - prev; prev = x; x = hp * exp(-t * 9);) :
    kind == 4 ? (ph += (80 + 60 * exp(-t * 18)) / 8000; x = sin(2 * $pi * ph) * exp(-t * 8);) :
    kind == 5 ? (x = dg_noise(); lp += (x - lp) * 0.6; x = (x - lp * 0.5) * exp(-t * 3.2);) :
    kind == 6 ? (ph += 1650 / 8000; x = (ph - floor(ph) < 0.5 ? 1 : -1) * exp(-t * 140);) :
    kind == 7 ? (x = dg_noise() * ((t < 0.012 || (t > 0.02 && t < 0.032) || t > 0.04) ? 1 : 0.15) * exp(-max(0, t - 0.04) * 22);) :
    kind == 8 ? (ph += 530 / 8000; ph2 += 797 / 8000; x = ((ph - floor(ph) < 0.5 ? 1 : -1) + (ph2 - floor(ph2) < 0.5 ? 0.7 : -0.7) + dg_noise() * 0.6) * exp(-t * 4.5);) :
    (ph += 540 / 8000; ph2 += 800 / 8000; x = ((ph - floor(ph) < 0.5 ? 1 : -1) + (ph2 - floor(ph2) < 0.5 ? 1 : -1)) * exp(-t * 14););
    DG_B[b + i] = x; pk = max(pk, abs(x));
    i += 1;
  );
  i = 0; loop(n, DG_B[b + i] = max(0, min(15, floor(7.5 + 7.5 * DG_B[b + i] / pk + 0.5))); i += 1;);
  dg_top += n;
);

function dg_build()
(
  dg_top = 0; dg_lf = 12345;
  dg_make(0, 0.35, 0); dg_make(1, 0.28, 1); dg_make(2, 0.06, 2); dg_make(3, 0.35, 3); dg_make(4, 0.45, 4);
  dg_make(5, 0.9, 5); dg_make(6, 0.04, 6); dg_make(7, 0.2, 7); dg_make(8, 0.7, 8); dg_make(9, 0.25, 9);
);

function digi_trigger(n) local(k)
(
  k = (n == 35 || n == 36) ? 0 : (n == 38 || n == 40) ? 1 : (n == 42 || n == 44) ? 2 : n == 46 ? 3 :
      (n == 41 || n == 43 || n == 45 || n == 47 || n == 48 || n == 50) ? 4 :
      (n == 49 || n == 57 || n == 52 || n == 55) ? 5 : n == 37 ? 6 : n == 39 ? 7 : (n == 51 || n == 59 || n == 53) ? 8 : n == 56 ? 9 : -1;
  k >= 0 ? (
    dg_pos = DGS_B[k * 2]; dg_end = dg_pos + DGS_B[k * 2 + 1];
    dg_inc = 8000 / srate * (k == 4 ? pow(2, (n - 45) / 12) : 1);
    dg_on = 1; idle_n = 0;
  );
);

// ---------------- held notes / arp sequences ----------------
function hs_del(c, n) local(b, i, j)
(
  b = HS_B + c * 32; i = 1;
  while (i <= b[0]) (
    b[i] == n ? (j = i; while (j < b[0]) (b[j] = b[j + 1]; j += 1;); b[0] -= 1;) : i += 1;
  );
  arp_dirty[c] = 1;
);

function hs_add(c, n) local(b)
(
  hs_del(c, n);
  b = HS_B + c * 32;
  b[0] < 30 ? (b[0] += 1; b[b[0]] = n;);
  arp_dirty[c] = 1;
);

function arp_build(c) local(b, q, n, i, j, t, o, m, k)
(
  b = HS_B + c * 32; q = ASEQ_B + c * 150; n = b[0];
  m = floor(slider97 + 0.5);
  i = 0; loop(n, q[i] = b[i + 1]; i += 1;);
  m != 4 ? (i = 0; loop(n, j = i + 1; loop(n - i - 1, q[j] < q[i] ? (t = q[i]; q[i] = q[j]; q[j] = t;); j += 1;); i += 1;););
  o = 1; loop(floor(slider98 + 0.5), i = 0; loop(n, q[o * n + i] = q[i] + 12 * o; i += 1;); o += 1;);
  k = n * o;
  (m == 1 || m == 3) ? (i = 0; loop(floor(k / 2), t = q[i]; q[i] = q[k - 1 - i]; q[k - 1 - i] = t; i += 1;););
  ((m == 2 || m == 3) && k > 2) ? (i = k - 2; j = k; loop(k - 2, q[j] = q[i]; j += 1; i -= 1;); k = j;);
  arp_n[c] = k; arp_dirty[c] = 0;
);

function ctx_kit(c) ( c >= 3 ? 2 : floor(slider(VS + c * NV + 23) + 0.5); );

function arp_active(c) local(b)
(
  b = HS_B + c * 32;
  arp_dirty[c] ? arp_build(c);
  arpspd > 0 && b[0] >= 1 && (arp_n[c] >= 2 || slider99 < 100) && !(vmode == 2 && ctx_kit(c));
);

// ---------------- player voices (namespaces p0..p5) ----------------
function vp(p) instance(kit, src) ( kit >= 0 ? DRUM_B[kit * DS + p] : slider(VS + src * NV + p); );
function tb(col, s) instance(kit, src) ( kit >= 0 ? DRUM_B[kit * DS + NV + col * NSTEP + s] : TAB_B[src * TW + col * NSTEP + s]; );
function tll(col) instance(kit, src) ( kit >= 0 ? 0 : TAB_B[src * TW + 64 + col]; );
function tls(col) instance(kit, src) ( kit >= 0 ? 0 : TAB_B[src * TW + 68 + col]; );
function lstep(col, s) instance(ls0, ls1, ls2, ls3) ( this.tll(col) > 0 ? (col == 0 ? ls0 : col == 1 ? ls1 : col == 2 ? ls2 : ls3) : s; );

function pv_step(s) instance(twave, tgate, tnote, tpwd, tcd) local(w)
(
  w = this.tb(0, this.lstep(0, s));
  w >= 16 ? tgate = 0 : w > 0 ? (twave = w; tgate = 1;);
  tnote = this.tb(1, this.lstep(1, s)); tpwd = this.tb(2, this.lstep(2, s)); tcd = this.tb(3, this.lstep(3, s));
);

function pv_lanes_reset() instance(ls0, ls1, ls2, ls3, lc0, lc1, lc2, lc3) local(d)
(
  d = max(1, this.vp(20));
  ls0 = ls1 = ls2 = ls3 = 0;
  lc0 = this.tls(0) > 0 ? this.tls(0) : d; lc1 = this.tls(1) > 0 ? this.tls(1) : d;
  lc2 = this.tls(2) > 0 ? this.tls(2) : d; lc3 = this.tls(3) > 0 ? this.tls(3) : d;
);

function pv_lanes_tick() instance(ls0, ls1, ls2, ls3, lc0, lc1, lc2, lc3) local(d, L, ch)
(
  d = max(1, this.vp(20)); ch = 0;
  L = this.tll(0); L > 0 ? (lc0 -= 1; lc0 <= 0 ? (ls0 = (ls0 + 1) % L; lc0 = this.tls(0) > 0 ? this.tls(0) : d; ch = 1;););
  L = this.tll(1); L > 0 ? (lc1 -= 1; lc1 <= 0 ? (ls1 = (ls1 + 1) % L; lc1 = this.tls(1) > 0 ? this.tls(1) : d; ch = 1;););
  L = this.tll(2); L > 0 ? (lc2 -= 1; lc2 <= 0 ? (ls2 = (ls2 + 1) % L; lc2 = this.tls(2) > 0 ? this.tls(2) : d; ch = 1;););
  L = this.tll(3); L > 0 ? (lc3 -= 1; lc3 <= 0 ? (ls3 = (ls3 + 1) % L; lc3 = this.tls(3) > 0 ? this.tls(3) : d; ch = 1;););
  ch;
);

function pv_regs() instance(vi, on, kit, twave, tgate, tnote, cur, pwv, vctr, vph, ctx, vel, xo) local(wv, g, c, p, d, per, f, fb, pw, b, ch, i3, su)
(
  ch = floor(vi / 3); i3 = vi - ch * 3; b = i3 * 7;
  wv = twave > 0 ? twave : this.vp(0);
  (!on && !env_of(ch, i3) && (nchip < 2 || ch || sixv || !env_of(1, i3))) ? wv = 0;
  g = on && tgate && this.vp(4);
  c = (wv << 4) | (this.vp(2) ? 4 : 0) | (this.vp(1) ? 2 : 0) | (g ? 1 : 0);
  p = cur + tnote + mtune + xo;
  kit < 0 ? (
    p += this.vp(10) + this.vp(11) * 0.01 + bend[ctx];
    d = this.vp(13) + modw[ctx] * 0.5;
    (d > 0 && vctr >= this.vp(15)) ? (
      per = max(2, this.vp(14));
      vph += 1 / per; vph >= 1 ? vph -= 1;
      p += d * 0.01 * (vph < 0.25 ? 4 * vph : vph < 0.75 ? 2 - 4 * vph : 4 * vph - 4);
    );
  );
  f = max(0, min(65535, floor(440 * pow(2, (p - 69) / 12) * (16777216 / sidclk) + 0.5)));
  pw = max(0, min(4095, floor(pwv)));
  su = this.vp(7);
  (velmode & 1) ? su = floor(su * vel / 127 + 0.5);
  wrc(ch, b, f & 255); wrc(ch, b + 1, f >> 8);
  wrc(ch, b + 2, pw & 255); wrc(ch, b + 3, pw >> 8);
  wrc(ch, b + 5, (this.vp(5) << 4) | this.vp(6));
  wrc(ch, b + 6, (su << 4) | this.vp(8));
  wrc(ch, b + 4, c);
  (nchip > 1 && !ch && !sixv) ? (
    fb = max(0, min(65535, floor(440 * pow(2, (p + sid2det * 0.01 - 69) / 12) * (16777216 / sidclk) + 0.5)));
    wrc(1, b, fb & 255); wrc(1, b + 1, fb >> 8);
    pw = 4095 - pw;
    wrc(1, b + 2, pw & 255); wrc(1, b + 3, pw >> 8);
    wrc(1, b + 5, (this.vp(5) << 4) | this.vp(6));
    wrc(1, b + 6, (su << 4) | this.vp(8));
    wrc(1, b + 4, c);
  );
);

function pv_gate_reset(dohr, dorst) instance(vi) local(ch, i3, b, r)
(
  ch = floor(vi / 3); i3 = vi - ch * 3; b = i3 * 7;
  loop((nchip > 1 && !ch && !sixv) ? 2 : 1,
    (RSH_B[ch * 32 + b + 4] > 0 && (RSH_B[ch * 32 + b + 4] & 1)) ? wrf(ch, b + 4, RSH_B[ch * 32 + b + 4] - 1);
    dohr ? wrf(ch, 100 + i3, 0);
    dorst ? (r = RSH_B[ch * 32 + b + 4]; wrf(ch, b + 4, (r < 0 ? 0 : r) | 8););
    ch = 1;
  );
);

function pv_trigger(n, s, k, retrig, v) instance(vi, on, kit, src, note, cur, tgt, gstep, step, sctr, twave, tgate, tnote, tpwd, tcd, pwv, pwdir, cofs, vctr, vph, age, rel, vel) local(g, bn, fx)
(
  src = s; kit = k; vel = v;
  fx = kit < 0 ? this.vp(26) : 0;
  kit >= 0 ? (bn = DRUM_B[kit * DS + NV + 4 * NSTEP]; note = bn > 0 ? bn : n;) : note = fx > 0 ? fx : n;
  g = kit >= 0 ? 0 : this.vp(12);
  (retrig || !on) ? (
    (g > 0 && on) ? (tgt = note; gstep = (note - cur) / g;) : (cur = tgt = note; gstep = 0;);
    step = 0; sctr = max(1, this.vp(20)); rel = 0;
    twave = -1; tgate = 1; tnote = tpwd = tcd = 0;
    this.vp(19) ? (this.pv_lanes_reset(); this.pv_step(0););
    pwv = this.vp(16); pwdir = 1; cofs = 0; vctr = 0; vph = 0;
    this.pv_gate_reset(this.vp(9), kit < 0 && this.vp(25));
    on = 1; age = 0;
    this.vp(3) ? (fowner = vi; fvel = vel;);
  ) : (
    g > 0 ? (tgt = note; gstep = (note - cur) / g;) : (cur = tgt = note; gstep = 0;);
  );
  this.pv_regs();
);

function pv_off() instance(on, step, sctr, rel, age)
(
  on ? (
    on = 0; age = 0;
    (this.vp(19) && this.vp(24) > 0) ? (
      step = min(this.vp(24), max(1, this.vp(21))) - 1; rel = 1;
      this.pv_step(step); sctr = max(1, this.vp(20));
    );
    this.pv_regs();
  );
);

function pv_frame() instance(on, step, sctr, pwv, pwdir, cofs, cur, tgt, gstep, tpwd, tcd, vctr, age, rel) local(len, lp, sp, c, d, re)
(
  gstep != 0 ? (
    cur += gstep;
    ((gstep > 0 && cur >= tgt) || (gstep < 0 && cur <= tgt)) ? (cur = tgt; gstep = 0;);
  );
  this.vp(19) ? (
    sctr -= 1;
    sctr <= 0 ? (
      len = max(1, this.vp(21)); lp = this.vp(22); re = this.vp(24);
      step += 1;
      (!rel && re > 1 && re <= len) ? (
        step >= re - 1 ? step = lp < re - 1 ? lp : re - 2;
      ) : (
        step >= len ? step = (rel || lp >= len) ? len - 1 : lp;
      );
      this.pv_step(step);
      sctr = max(1, this.vp(20));
    );
    this.pv_lanes_tick() ? this.pv_step(step);
  );
  pwv += tpwd;
  sp = this.vp(17);
  sp > 0 ? (
    c = this.vp(16); d = this.vp(18);
    pwv += pwdir * sp;
    pwv > c + d ? (pwv = c + d; pwdir = -1;) : pwv < c - d ? (pwv = c - d; pwdir = 1;);
  );
  pwv = max(0, min(4095, pwv));
  cofs = max(-2047, min(2047, cofs + tcd));
  vctr += 1; age += 1;
  this.pv_regs();
);

// ---------------- note routing ----------------
function kit_index(n)
(
  (n == 35 || n == 36) ? 0 : (n == 38 || n == 40) ? 1 : (n == 42 || n == 44) ? 2 : n == 46 ? 3 :
  (n == 41 || n == 43) ? 4 : (n == 45 || n == 47) ? 5 : (n == 48 || n == 50) ? 6 :
  (n == 49 || n == 57 || n == 52 || n == 55) ? 7 : n == 37 ? 8 : n == 39 ? 9 : (n == 51 || n == 59) ? 10 : -1;
);

<? !jsfx_has_set_midi_note_name ? printf("function set_midi_note_name(a,b,c,d) ( 0 );\n"); ?>
function nn_drum(n, digi) (
  (n == 35 || n == 36) ? "Kick" : (n == 38 || n == 40) ? "Snare" : (n == 42 || n == 44) ? "Closed Hat" : n == 46 ? "Open Hat" :
  (n == 41 || n == 43) ? "Low Tom" : (n == 45 || n == 47) ? "Mid Tom" : (n == 48 || n == 50) ? "High Tom" :
  (n == 49 || n == 52 || n == 55 || n == 57) ? "Crash" : n == 37 ? "Rim" : n == 39 ? "Clap" : (n == 51 || n == 59) ? "Ride" :
  (digi && n == 53) ? "Ride" : (digi && n == 56) ? "Cowbell" : "";
);
function nn_kit(kk, ch) local(k) (
  kk > 0 ? (k = 35; loop(25, strlen(nn_drum(k, kk == 2)) ? set_midi_note_name(0, k, ch, nn_drum(k, kk == 2)); k += 1;););
);
function nn_update() local(m, c, k1, k2, k3, st) (
  m = floor(slider3 + 0.5); c = floor(slider12 + 0.5);
  k1 = floor(slider(VS + 23) + 0.5); k2 = floor(slider(VS + NV + 23) + 0.5); k3 = floor(slider(VS + 2 * NV + 23) + 0.5);
  st = m * 10000 + c * 100 + k1 * 9 + k2 * 3 + k3;
  st !== nn_st ? (
    nn_st = st;
    set_midi_note_name(-1, 0, 0, "");
    m == 2 ? (nn_kit(k1, 0); nn_kit(k2, 1); nn_kit(k3, 2); nn_kit(k3, 9); nn_kit(2, 3);) :
    m != 0 ? nn_kit(k1, c - 1);
  );
);
nn_st = -1;

function pvx(i, n, s, k, r, v)
(
<? loop(j = 0; 11, printf("  i == %d ? p%d.pv_trigger(n, s, k, r, v) :\n", j, j); j += 1;); ?>  p11.pv_trigger(n, s, k, r, v);
);
function pvoff(i)
(
<? loop(j = 0; 11, printf("  i == %d ? p%d.pv_off() :\n", j, j); j += 1;); ?>  p11.pv_off();
);
function pvon(i)
(
<? loop(j = 0; 11, printf("  i == %d ? p%d.on :\n", j, j); j += 1;); ?>  p11.on;
);
function pvage(i)
(
<? loop(j = 0; 11, printf("  i == %d ? p%d.age :\n", j, j); j += 1;); ?>  p11.age;
);
function pvcofs(i)
(
<? loop(j = 0; 11, printf("  i == %d ? p%d.cofs :\n", j, j); j += 1;); ?>  p11.cofs;
);
function pvsrc(i)
(
<? loop(j = 0; 11, printf("  i == %d ? p%d.src :\n", j, j); j += 1;); ?>  p11.src;
);
function chip_busy(c) local(b)
(
  b = QN_B[c] > 0 || pvon(c * 3) || pvon(c * 3 + 1) || pvon(c * 3 + 2) || env_of(c, 0) || env_of(c, 1) || env_of(c, 2);
  b ? CID_B[c] = 0 : CID_B[c] <= cid_lim ? CID_B[c] += 1;
  CID_B[c] < cid_lim;
);

function ctx_play(c, n, retrig) local(k, kk)
(
  vmode == 0 ? (
    p0.pv_trigger(n, 0, -1, retrig, vel_[0]); p1.pv_trigger(n, 1, -1, retrig, vel_[0]); p2.pv_trigger(n, 2, -1, retrig, vel_[0]);
  ) : (
    kk = ctx_kit(c);
    kk == 2 ? digi_trigger(n) : (
      k = kk ? kit_index(n) : -1;
      (k >= 0 || !kk) ? pvx(c, n, c, k, retrig, vel_[c]);
    );
  );
);

function ctx_release(c)
(
  vmode == 0 ? (p0.pv_off(); p1.pv_off(); p2.pv_off();) : c < 3 ? pvoff(c);
);

function arp_step(c) local(n, k, gl)
(
  k = arp_n[c];
  k > 0 ? (
    floor(slider97 + 0.5) == 5 ? (
      n = k > 1 ? floor(rand(k - 0.000001)) : 0;
      (n == arp_i[c] && k > 1) ? n = (n + 1) % k;
      arp_i[c] = n;
    ) : arp_i[c] = (arp_i[c] + 1) % k;
    n = ASEQ_B[c * 150 + arp_i[c]];
    gl = slider99 < 100 ? max(1, floor(arpspd * slider99 / 100 + 0.5)) : arpspd;
    gl < arpspd ? (ctx_play(c, n, 1); arp_g[c] = gl;) : (ctx_play(c, n, 0); arp_g[c] = 0;);
    arp_c[c] = arpspd;
  );
);

function mono_on(c, n, v) local(b, prev)
(
  b = HS_B + c * 32;
  prev = b[0];
  vel_[c] = v;
  hs_add(c, n);
  (vmode == 2 && ctx_kit(c)) ? ctx_play(c, n, 1) :
  arp_active(c) ? (
    prev == 0 ? (arp_i[c] = -1; arp_step(c); ctx_play(c, ASEQ_B[c * 150 + arp_i[c]], 1););
  ) : ctx_play(c, n, prev == 0 || keymode == 0);
);

function mono_off(c, n) local(b)
(
  b = HS_B + c * 32;
  hs_del(c, n);
  !(vmode == 2 && ctx_kit(c)) ? (
    b[0] == 0 ? ctx_release(c) : !arp_active(c) ? ctx_play(c, b[b[0]], 0);
  );
);

function vscore(i) ( pvage(i) + (pvon(i) ? 0 : 1000000); );
function poly_voice(i, n, s, v) ( pnote[i] = n; pvx(i, n, s, -1, 1, v); );

function poly_stack(n, v, nv_) local(nc, c, a, sc, ba, b0, b1, i, j, x)
(
  nc = nv_ / 3;
  vlay == 3 ? (
    ba = -1; c = 0;
    loop(nc, sc = min(vscore(3 * c), min(vscore(3 * c + 1), vscore(3 * c + 2))); sc > ba ? (ba = sc; b0 = c;); c += 1;);
    i = 0; loop(3, poly_voice(3 * b0 + i, n, i, v); i += 1;);
  ) : (
    (slider(VS + NV + 1) >= 0.5 || slider(VS + NV + 2) >= 0.5) ? (
      ba = -1; c = 0;
      loop(nc,
        a = 0;
        loop(3, x = 3 * c + (a + 1) % 3; sc = min(vscore(3 * c + a), vscore(x)); sc > ba ? (ba = sc; b0 = 3 * c + a; b1 = x;); a += 1;);
        c += 1;
      );
    ) : (
      ba = -1; i = 0; loop(nv_, sc = vscore(i); sc > ba ? (ba = sc; b0 = i;); i += 1;);
      ba = -1; i = 0; loop(nv_, sc = vscore(i); (i != b0 && sc > ba) ? (ba = sc; b1 = i;); i += 1;);
    );
    poly_voice(b0, n, 0, v); poly_voice(b1, n, 1, v);
  );
);

function poly_on(n, v) local(k, kk, best, ba, i, a, nv_)
(
  kk = floor(slider(VS + 23) + 0.5);
  kk == 2 ? digi_trigger(n) : (
    k = kk ? kit_index(n) : -1;
    (k >= 0 || !kk) ? (
      nv_ = sixv ? 3 * nchip : 3;
      (vlay > 1 && !kk) ? poly_stack(n, v, nv_) : (
      best = -1; ba = -1; i = 0;
      loop(nv_, a = pvage(i) + (pvon(i) ? 0 : 1000000); a > ba ? (ba = a; best = i;); i += 1;);
      pnote[best] = n;
      pvx(best, n, 0, k, 1, v);
      );
    );
  );
);

function poly_off(n) local(i)
(
  !slider(VS + 23) ? (
    i = 0;
    loop(12, pnote[i] == n ? (pnote[i] = -1; pvoff(i);); i += 1;);
  );
);

function filt_route() local(rb, i, k)
(
  vlay > 1 ? (
    k = 0;
    loop(sixv ? nchip : 1,
      rb = 0; i = 0; loop(3, slider(VS + pvsrc(3 * k + i) * NV + 3) >= 0.5 ? rb |= 1 << i; i += 1;);
      sixv ? wrc(k, 0x17, (floor(slider5 + 0.5) << 4) | rb) : wrg(0x17, (floor(slider5 + 0.5) << 4) | rb);
      k += 1;
    );
  ) : (
  rb = 0; i = 0;
  loop(3,
    k = vpoly ? 0 : i;
    slider(VS + k * NV + 3) ? rb |= 1 << i;
    i += 1;
  );
  (p0.kit >= 0) ? rb = (rb & 6) | (DRUM_B[p0.kit * DS + 3] ? 1 : 0);
  (p1.kit >= 0) ? rb = (rb & 5) | (DRUM_B[p1.kit * DS + 3] ? 2 : 0);
  (p2.kit >= 0) ? rb = (rb & 3) | (DRUM_B[p2.kit * DS + 3] ? 4 : 0);
  wrg(0x17, (floor(slider5 + 0.5) << 4) | rb);
  );
);

function src_reset()
(
<? loop(j = 0; 12, printf("  p%d.src = vpoly ? (vlay > 1 ? %d %% vlay : 0) : %d;\n", j, j % 3, j % 3); j += 1;); ?>);

function note_on(c, n, v) ( c == 3 ? digi_trigger(n) : vpoly ? poly_on(n, v) : mono_on(c, n, v); filt_route(); );
function note_off(c, n) ( c == 3 ? 0 : vpoly ? poly_off(n) : mono_off(c, n); );

function all_off() local(c, i)
(
  c = 0; loop(4, HS_B[c * 32] = 0; arp_dirty[c] = 1; arp_g[c] = 0; i = 0; loop(128, PEND_B[c * 128 + i] = 0; i += 1;); c += 1;);
  i = 0; loop(12, pnote[i] = -1; pvoff(i); i += 1;);
);

function pv_porta(n, t) instance(note, tgt, gstep, cur, on) ( on ? (note = n; tgt = n; gstep = (n - cur) / max(1, t);); on; );

// ---------------- tracker effects from MIDI (Track Record CC 115-117) ----------------
MF_B = 5732400;
mf_cmd = MF_B + 128; mf_val = MF_B + 132; mf_t = MF_B + 136; mf_note = MF_B + 140; mf_ph = MF_B + 144; mf_del = MF_B + 148;
mf_dn = MF_B + 152; mf_dv = MF_B + 156; mf_pend = MF_B + 160; mf_pc = MF_B + 164; mf_hi = MF_B + 168; mf_lo = MF_B + 172; mf_poff = MF_B + 176;

function mf_ok(c) ( c < 3 && !vpoly; );
function mf_xo(c, x) ( vmode == 0 ? (p0.xo = x; p1.xo = x; p2.xo = x;) : c == 0 ? p0.xo = x : c == 1 ? p1.xo = x : p2.xo = x; );

function mf_stop(c)
(
  mf_cmd[c] > 0 ? (mf_cmd[c] = 0; mf_xo(c, 0););
  mf_poff[c] = 0;
);

function mf_reset() local(c)
(
  c = 0;
  loop(3, mf_stop(c); mf_del[c] = 0; mf_pend[c] = 0; c += 1;);
);

function mf_porta(c, n, t) local(ok)
(
  vmode == 0 ? (ok = p0.pv_porta(n, t); p1.pv_porta(n, t); p2.pv_porta(n, t);) :
  c == 0 ? ok = p0.pv_porta(n, t) : c == 1 ? ok = p1.pv_porta(n, t) : ok = p2.pv_porta(n, t);
  ok;
);

function mf_cc(c, num, v)
(
  mf_ok(c) ? (
    num == 115 ? (mf_pc[c] = v; mf_pend[c] = 0;) :
    num == 116 ? mf_hi[c] = v :
    (mf_lo[c] = v; mf_pend[c] = 1;);
  );
);

function mf_note_on(c, n, v) local(cmd, val)
(
  !mf_ok(c) ? note_on(c, n, v) : (
    cmd = mf_pend[c] ? mf_pc[c] : 0;
    cmd == 15 ? cmd = 0;
    val = mf_hi[c] * 16 + mf_lo[c];
    mf_pend[c] = 0;
    cmd == 8 ? (
      mf_del[c] = max(1, val); mf_dn[c] = n; mf_dv[c] = v;
    ) : (
      (cmd == 4 && HS_B[c * 32] > 0 && (vmode != 2 || !ctx_kit(c))) ? (
        hs_add(c, n); vel_[c] = v; mf_poff[c] = 1;
        mf_porta(c, n, val);
      ) : note_on(c, n, v);
      mf_cmd[c] > 0 ? mf_xo(c, 0);
      mf_cmd[c] = cmd == 4 ? 0 : cmd;
      mf_val[c] = val; mf_t[c] = 0; mf_ph[c] = 0; mf_note[c] = n;
    );
  );
);

function mf_note_off(c, n)
(
  !mf_ok(c) ? note_off(c, n) :
  (mf_del[c] > 0 && mf_dn[c] == n) ? mf_del[c] = 0 :
  (mf_poff[c] && n != mf_note[c]) ? (hs_del(c, n); mf_poff[c] = 0;) : (
    note_off(c, n);
    HS_B[c * 32] == 0 ? mf_stop(c);
  );
);

function mf_frame() local(c, cmd, v, t, k, x, y, b)
(
  !vpoly ? (
    c = 0;
    loop(3,
      mf_pend[c] ? (
        mf_pend[c] = 0;
        b = HS_B + c * 32;
        mf_pc[c] == 15 ? mf_stop(c) : b[0] > 0 ? (
          mf_cmd[c] > 0 ? mf_xo(c, 0);
          mf_cmd[c] = mf_pc[c]; mf_val[c] = mf_hi[c] * 16 + mf_lo[c]; mf_t[c] = 0; mf_ph[c] = 0; mf_note[c] = b[b[0]];
        );
      );
      mf_del[c] > 0 ? (
        mf_del[c] -= 1;
        mf_del[c] == 0 ? (
          note_on(c, mf_dn[c], mf_dv[c]);
          mf_stop(c);
          mf_note[c] = mf_dn[c];
        );
      ) : mf_cmd[c] > 0 ? (
        cmd = mf_cmd[c]; v = mf_val[c]; t = mf_t[c];
        cmd == 1 ? (k = t % 3; mf_xo(c, k == 0 ? 0 : k == 1 ? v >> 4 : v & 15);) :
        cmd == 2 ? mf_xo(c, min(48, (t + 1) * v / 16)) :
        cmd == 3 ? mf_xo(c, max(-48, -(t + 1) * v / 16)) :
        cmd == 5 ? (
          x = max(1, v >> 4); y = v & 15;
          mf_ph[c] += x / 64; mf_ph[c] >= 1 ? mf_ph[c] -= 1; x = mf_ph[c];
          mf_xo(c, y * 0.1 * (x < 0.25 ? 4 * x : x < 0.75 ? 2 - 4 * x : 4 * x - 4));
        ) :
        cmd == 6 ? ((v > 0 && t > 0 && t % v == 0) ? ctx_play(c, mf_note[c], 1);) :
        cmd == 7 ? ((t + 1 >= max(1, v)) ? (ctx_release(c); mf_stop(c););) : 0;
        mf_t[c] = t + 1;
      );
      c += 1;
    );
  );
);

function handle_midi(m1, m2, m3) local(st, ch, c, i)
(
  st = m1 & 0xf0; ch = m1 & 15;
  vmode == 2 ? (c = ch < 4 ? ch : ch == 9 ? 2 : -1;) : (c = (midich == 0 || ch == midich - 1) ? 0 : -1;);
  c >= 0 ? (
    (st == 0x90 && m3 > 0) ? (
      PEND_B[c * 128 + m2] = 0; KD_B[m2] = 1;
      mf_note_on(c, m2, m3);
      midi_flag = 1;
    ) : (st == 0x80 || st == 0x90) ? (
      KD_B[m2] = 0;
      sus[c] ? PEND_B[c * 128 + m2] = 1 : mf_note_off(c, m2);
    ) : st == 0xe0 ? (
      bend[c] = ((m3 * 128 + m2) - 8192) / 8192 * bendr;
    ) : st == 0xb0 ? (
      m2 == 1 ? modw[c] = m3 / 127 * 50 :
      m2 == 64 ? (
        sus[c] = m3 >= 64;
        !sus[c] ? (i = 0; loop(128, PEND_B[c * 128 + i] ? (PEND_B[c * 128 + i] = 0; mf_note_off(c, i);); i += 1;););
      ) :
      (m2 >= 115 && m2 <= 117) ? mf_cc(c, m2, m3) :
      (m2 == 120 || m2 == 123) ? (all_off(); memset(KD_B, 0, 128); mf_reset(););
    );
  );
);

function arp_frame() local(c)
(
  (!vpoly && arpspd > 0) ? (
    c = 0;
    loop(vmode == 2 ? 3 : 1,
      arp_active(c) ? (
        arp_g[c] > 0 ? (arp_g[c] -= 1; arp_g[c] == 0 ? ctx_release(c););
        arp_c[c] -= 1;
        arp_c[c] <= 0 ? arp_step(c);
      );
      c += 1;
    );
  );
);

function player_frame() local(fc)
(
  mf_frame();
  arp_frame();
  p0.pv_frame(); p1.pv_frame(); p2.pv_frame();
  sixv ? (
    p3.pv_frame(); p4.pv_frame(); p5.pv_frame();
    nchip > 2 ? (p6.pv_frame(); p7.pv_frame(); p8.pv_frame(););
    nchip > 3 ? (p9.pv_frame(); p10.pv_frame(); p11.pv_frame(););
  );
  fc = floor(slider4 + 0.5) + pvcofs(fowner);
  (velmode & 2) ? fc += (fvel - 100) * 6;
  fc = max(0, min(2047, fc));
  wrg(0x15, fc & 7); wrg(0x16, fc >> 3);
  filt_route();
  fmb = floor(slider6 + 0.5) << 4;
);

function read_globals()
(
  vmode = floor(slider3 + 0.5);
  vpoly = vmode == 1 || vmode >= 3;
  vlay = vmode >= 3 ? vmode - 1 : 1;
  arpspd = floor(slider7 + 0.5);
  keymode = floor(slider8 + 0.5);
  bendr = floor(slider9 + 0.5);
  midich = floor(slider12 + 0.5);
  gain = 10 ^ (slider10 / 20);
  velmode = floor(slider102 + 0.5);
  mtune = slider103 * 0.01;
  sid2det = slider117;
  p1.ctx = vmode == 2 ? 1 : 0; p2.ctx = vmode == 2 ? 2 : 0;
  sid2m = floor(slider115 + 0.5);
  sixv = sid2m >= 2 && vpoly;
  nchip = sid2m == 0 ? 1 : sixv ? sid2m : 2;
  tick_setup();
);

function chip_reset() local(i)
(
  lc = 0; nchip = 1;
  sid_model(floor(slider2 + 0.5)); sid_reset();
  sid_bias(slider100 * 0.01);
  cwm = floor(slider101 + 0.5) ? 1 : -1;
  v0.v_model(); v1.v_model(); v2.v_model();
  v0.env = v1.env = v2.env = 0;
  memset(QN_B, 0, 4); memset(CID_B, 0, 4); memset(YC_B, 0, 4); zdir = 0;
  i = 0; loop(128, RSH_B[i] = -1; i += 1;);
<? loop(j = 0; 12, printf("  p%d.vi = %d; p%d.kit = -1; p%d.ctx = 0;\n", j, j, j, j); j += 1;); ?>  vmode_prev = -1;
  read_globals(); nchip = 1;
  src_reset();
  player_frame();
  wrg(0x18, fmb | 15);
  loop(400, sid_clock(1000););
  chip_save(CHS_B); chip_save(CHS_B + 256); chip_save(CHS_B + 512); chip_save(CHS_B + 768);
  i = 32; loop(96, RSH_B[i] = RSH_B[i - 32]; i += 1;);
  read_globals();
  cur_chip = floor(slider2 + 0.5); cur_bias = slider100; cur_cw = slider101; cur_boost = slider105; cur_sid2 = slider115;
);

function chip_settle() local(c)
(
  c = 0;
  loop(nchip,
    c != lc ? (chip_save(CHS_B + lc * 256); lc = c; chip_load(CHS_B + lc * 256); queue_flush(lc););
    loop(200, sid_clock(1000););
    c += 1;
  );
  dc_settle = 0;
);

function load_rec(a)
(
  slider2 = a[0];
  slider3 = a[1];
  slider4 = a[2];
  slider5 = a[3];
  slider6 = a[4];
  slider7 = a[5];
  slider8 = a[6];
  slider97 = a[7];
  slider98 = a[8];
  slider99 = a[9];
  slider100 = a[10];
  slider101 = a[11];
  slider104 = a[12];
  slider105 = a[13];
  slider106 = a[14];
  slider107 = a[15];
  slider108 = a[16];
  slider109 = a[17];
  slider110 = a[18];
  slider111 = a[19];
  slider112 = a[20];
  slider113 = a[21];
  slider114 = a[22];
  slider115 = a[23];
  slider116 = a[24];
  slider117 = a[25];
<? i = 0; loop(81, printf("  slider%d = a[%d];\n", 13 + i, 26 + i); i += 1;); ?>
  memcpy(TAB_B, a + 107, 216);
);

function rec_from_current(d)
(
  d[0] = slider2;
  d[1] = slider3;
  d[2] = slider4;
  d[3] = slider5;
  d[4] = slider6;
  d[5] = slider7;
  d[6] = slider8;
  d[7] = slider97;
  d[8] = slider98;
  d[9] = slider99;
  d[10] = slider100;
  d[11] = slider101;
  d[12] = slider104;
  d[13] = slider105;
  d[14] = slider106;
  d[15] = slider107;
  d[16] = slider108;
  d[17] = slider109;
  d[18] = slider110;
  d[19] = slider111;
  d[20] = slider112;
  d[21] = slider113;
  d[22] = slider114;
  d[23] = slider115;
  d[24] = slider116;
  d[25] = slider117;
<? i = 0; loop(81, printf("  d[%d] = slider%d;\n", 26 + i, 13 + i); i += 1;); ?>
  memcpy(d + 107, TAB_B, 216);
);

PS = 323; US = 1 + UNAME + PS; NPG = 26; TW = 72; USO = US - 24;
function tab_expand(s, d) local(v) ( v = 0; loop(3, memcpy(d + v * TW, s + v * 64, 64); memset(d + v * TW + 64, 0, TW - 64); v += 1;); );
function rec_expand(s, d) ( memcpy(d, s, 1 + UNAME + NPG + 3 * NV); tab_expand(s + 1 + UNAME + NPG + 3 * NV, d + 1 + UNAME + NPG + 3 * NV); );
function patch_addr(b, p) ( b == 0 ? (p < NPATCH ? PATCH_B + p * PS : -1) : (p < USLOTS && UB_B[p * US] >= 0 ? UB_B + p * US + 1 + UNAME : -1); );
function load_patch(p) ( load_rec(PATCH_B + p * PS); cur_patch = p; cur_bank = 0; );
function load_any(b, p) local(a) ( a = patch_addr(b, p); a >= 0 ? load_rec(a); cur_bank = b; cur_patch = p; );


