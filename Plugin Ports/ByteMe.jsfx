options:no_meter
options:maxmem=5865600

@init
ext_noinit = gfx_ext_retina = 1;

WAVE_B = 0; DACW_B = 65536; DACE_B = 73728; RCP_B = 74240; SUSL_B = 74256; F0_B = 74272;
OPV_B = 76400; VB_B = 76500; RLE_B = 76600;
OPREV_B = 90000; KVG_B = 160000; IDS_B = 230000; VOLT_B = 300000; OPDVX_B = 370000;
GAIN_B = 440000; SUM_B = 1490000; MIX_B = 2810000;

function build_dac(dst, bits, r2, term) local(sb, bit, Vn, R, Rn, rinf, cur, i, x, Vo, j, leak)
(
  leak = term ? 35 / 10000 : 75 / 10000;
  sb = 0;
  loop(bits,
    Vn = 1; R = 1; rinf = !term; Rn = r2;
    bit = 0;
    loop(sb,
      rinf ? (Rn = R + r2; rinf = 0;) : Rn = R + ((r2 * Rn) / (r2 + Rn));
      bit += 1;
    );
    rinf ? Rn = r2 : (Rn = (r2 * Rn) / (r2 + Rn); Vn = (Vn * Rn) / r2;);
    bit += 1;
    while (bit < bits) (
      Rn += R; cur = Vn / Rn; Rn = (r2 * Rn) / (r2 + Rn); Vn = Rn * cur;
      bit += 1;
    );
    VB_B[sb] = Vn;
    sb += 1;
  );
  i = 0;
  loop(1 << bits,
    x = i; Vo = 0; j = 0;
    loop(bits, Vo += ((x & 1) ? 1 : leak) * VB_B[j]; x = floor(x / 2); j += 1;);
    dst[i] = floor((((1 << bits) - 1) * Vo) + 0.5);
    i += 1;
  );
);

function build_wave_tables() local(i, m, p, v, n)
(
  i = 0;
  loop(4096,
    m = 0;
    loop(2,
      p = WAVE_B + m * 32768 + i;
      p[0] = 4095;
      p[4096] = floor(((i >= 2048 ? 16777215 - i * 4096 : i * 4096)) / 2048) & 4094;
      p[8192] = i;
      p[16384] = 4095;
      m += 1;
    );
    i += 1;
  );
  p = RLE_B; m = 0;
  loop(8,
    v = WAVE_B + (m >= 4 ? 32768 : 0) + ((m & 3) == 0 ? 3 : 4 + (m & 3)) * 4096;
    n = 0;
    while (n < 4096) ( loop(p[1], v[n] = p[0] * 16; n += 1;); p += 2; );
    m += 1;
  );
  build_dac(DACW_B, 12, 22 / 10, 0);
  build_dac(DACW_B + 4096, 12, 2, 1);
  build_dac(DACE_B, 8, 22 / 10, 0);
  build_dac(DACE_B + 256, 8, 2, 1);
  mem_set_values(RCP_B, 8, 31, 62, 94, 148, 219, 266, 312, 391, 976, 1953, 3125, 3906, 11719, 19531, 31250);
  i = 0; loop(16, SUSL_B[i] = i * 17; i += 1;);
);

function solve_gain(n, vi) local(ak, bk, a, b, bvi, c, xk, vx, dvx, vo, bvx, bvo, f, df, q, done, r)
(
  ak = sg_ak; bk = sg_bk;
  a = n + 128;
  b = 65535;
  bvi = b - vi; bvi < 0 ? bvi = 0;
  c = n * floor((bvi * bvi) / 4096);
  done = 0;
  while (!done) (
    xk = sg_x;
    vx = OPREV_B[sg_x];
    dvx = OPDVX_B[sg_x];
    vo = (vx + sg_x * 2) - 65536;
    vo >= 65536 ? vo = 65535 : vo < 0 ? vo = 0;
    bvx = b - vx; bvx < 0 ? bvx = 0;
    bvo = b - vo; bvo < 0 ? bvo = 0;
    f = ((a * floor((bvx * bvx) / 4096)) - c) - floor((bvo * bvo) / 32);
    df = floor((floor((bvo * (dvx + 2048)) / 2) - a * floor((bvx * dvx) / 256)) / 16384);
    df ? (q = f / df; sg_x -= q < 0 ? -floor(-q) : floor(q););
    sg_x === xk ? (r = vo; done = 1;) : (
      f < 0 ? ak = xk : bk = xk;
      (sg_x <= ak || sg_x >= bk) ? (
        sg_x = floor((ak + bk) / 2);
        sg_x === ak ? (r = vo; done = 1;);
      );
    );
  );
  r;
);

function build_filter_tables() local(sz, vmin, omax, kVddt, vmax, denorm, norm, N16, N31, i, xi, yi,
  p0, x0, x1, x2, x3, y0, y1, y2, y3, k1, k2, dx, dy, a, b, c, d, y, d2y, d3y, x, res,
  j, f, fp, df, n8, n, off, size, k, idiv, vi, l, N16v, vminv, kVddtv, Vg, v, kVt, Ut, Is, n_Is, lt, e)
(
  sz = 35;
  mem_set_values(OPV_B, 81, 1031, 81, 1031, 240, 1031, 260, 1030, 270, 1029, 280, 1026, 290, 1017, 300, 1004,
    310, 983, 320, 958, 330, 932, 350, 869, 370, 800, 400, 689, 440, 521, 454, 454, 460, 419, 480, 300,
    490, 230, 495, 203, 500, 188, 505, 177, 510, 169, 520, 158, 540, 144, 560, 133, 580, 126, 600, 121);
  mem_set_values(OPV_B + 56, 640, 112, 700, 102, 750, 97, 850, 89, 1000, 81, 1031, 81, 1031, 81);
  vmin = 81 / 100; omax = 1031 / 100;
  kVddt = 1 * (1218 / 100 - 131 / 100);
  vmax = kVddt < omax ? omax : kVddt;
  denorm = vmax - vmin; norm = 1 / denorm;
  N16 = norm * 65535; N31 = norm * 2147483647;
  i = 0;
  loop(sz,
    xi = OPV_B[2 * i] / 100; yi = OPV_B[2 * i + 1] / 100;
    VB_B[2 * (sz - 1 - i)] = floor(((N16 * (yi - xi)) + 65536) / 2 + 0.5);
    VB_B[2 * (sz - 1 - i) + 1] = N31 * (xi - vmin);
    i += 1;
  );
  VB_B[2 * (sz - 1)] >= 65536 ? VB_B[2 * (sz - 1)] = VB_B[2 * (sz - 2)] = 65535;
  res = 1;
  p0 = 0;
  while (p0 + 2 != sz - 1) (
    x0 = VB_B[2 * p0]; y0 = VB_B[2 * p0 + 1];
    x1 = VB_B[2 * p0 + 2]; y1 = VB_B[2 * p0 + 3];
    x2 = VB_B[2 * p0 + 4]; y2 = VB_B[2 * p0 + 5];
    x3 = VB_B[2 * p0 + 6]; y3 = VB_B[2 * p0 + 7];
    x1 !== x2 ? (
      x0 === x1 && x2 === x3 ? (
        k1 = k2 = (y2 - y1) / (x2 - x1);
      ) : x0 === x1 ? (
        k2 = (y3 - y1) / (x3 - x1);
        k1 = ((3 * (y2 - y1)) / (x2 - x1) - k2) / 2;
      ) : x2 === x3 ? (
        k1 = (y2 - y0) / (x2 - x0);
        k2 = ((3 * (y2 - y1)) / (x2 - x1) - k1) / 2;
      ) : (
        k1 = (y2 - y0) / (x2 - x0);
        k2 = (y3 - y1) / (x3 - x1);
      );
      dx = x2 - x1; dy = y2 - y1;
      a = ((k1 + k2) - ((2 * dy) / dx)) / (dx * dx);
      b = (((k2 - k1) / dx) - ((3 * (x1 + x2)) * a)) / 2;
      c = k1 - ((((3 * x1) * a) + (2 * b)) * x1);
      d = y1 - ((((((x1 * a) + b) * x1) + c)) * x1);
      y = ((((((a * x1) + b) * x1) + c)) * x1) + d;
      dy = ((((((3 * a) * (x1 + res)) + (2 * b)) * x1)) * res) + ((((((a * res) + b) * res) + c)) * res);
      d2y = (((((6 * a) * (x1 + res)) + (2 * b)) * res)) * res;
      d3y = (((6 * a) * res) * res) * res;
      x = x1;
      while (x <= x2) (
        VOLT_B[floor(x)] = floor((y < 0 ? 0 : y) + 0.5);
        y += dy; dy += d2y; d2y += d3y;
        x += res;
      );
    );
    p0 += 1;
  );
  sg_ak = VB_B[0]; sg_bk = VB_B[2 * (sz - 1)];
  j = 0;
  loop(sg_ak, OPREV_B[j] = OPDVX_B[j] = 0; j += 1;);
  f = VOLT_B[j];
  while (j <= sg_bk) (
    fp = f; f = VOLT_B[j];
    df = f - fp;
    OPREV_B[j] = f > 2147450880 ? 65535 : floor(f / 32768);
    e = floor(df / 16) & 65535;
    OPDVX_B[j] = e >= 32768 ? e - 65536 : e;
    j += 1;
  );
  while (j < 65536) ( OPREV_B[j] = OPDVX_B[j] = 0; j += 1; );
  n8 = 0;
  loop(16,
    n = n8 * 16; sg_x = sg_ak; vi = 0;
    loop(65536, GAIN_B[n8 * 65536 + vi] = solve_gain(n, vi); vi += 1;);
    n8 += 1;
  );
  off = 0; k = 0;
  loop(5,
    idiv = 2 + k; n = idiv * 128; size = idiv * 65536; sg_x = sg_ak; vi = 0;
    loop(size, SUM_B[off + vi] = solve_gain(n, floor(vi / idiv)); vi += 1;);
    off += size; k += 1;
  );
  off = 0; size = 1; l = 0;
  loop(8,
    idiv = l; n = floor((idiv * 128 * 8) / 6); idiv == 0 ? idiv = 1;
    sg_x = sg_ak; vi = 0;
    loop(size, MIX_B[off + vi] = solve_gain(n, floor(vi / idiv)); vi += 1;);
    off += size; size = (l + 1) * 65536; l += 1;
  );
  build_dac(F0_B, 11, 22 / 10, 0);
  n = 0;
  loop(2048,
    F0_B[n] = floor((N16 * (((665 / 100) + ((F0_B[n] * (263 / 100)) / 2048)) - vmin)) + 0.5);
    n += 1;
  );
  N16v = floor(N16);
  vminv = N16v * vmin;
  kVddtv = N16v * kVddt;
  i = 0;
  loop(65536,
    Vg = kVddtv - sqrt(i * 65536);
    v = ((1 * Vg) - vminv) + 0.5;
    v = v < 0 ? -floor(-v) : floor(v);
    KVG_B[i] = v & 65535;
    i += 1;
  );
  kVt = 1 * (131 / 100); Ut = 26 / 1000;
  Is = ((((2 * (20 / 1000000)) * Ut) * Ut) / 1) * 9;
  n_Is = (((N16v / 2) * (1 / 1000000)) / (470 / 1000000000000)) * Is;
  i = 0;
  loop(65536,
    e = exp(((i / N16v) - kVt) / (2 * Ut));
    lt = e < 0.0001 ? e * (1 - e * (1 / 2 - e / 3)) : log(1 + e) - (((1 + e) - 1) - e) / (1 + e);
    IDS_B[i] = floor((n_Is * lt) * lt);
    i += 1;
  );
);

// ---------------- waveform generator ----------------
function w_noise() instance(sr, noise, nnon, nonoise)
(
  noise = ((sr & 0x100000) >> 9) | ((sr & 0x040000) >> 8) | ((sr & 0x004000) >> 5) | ((sr & 0x000800) >> 3) |
          ((sr & 0x000200) >> 2) | ((sr & 0x000020) << 1) | ((sr & 0x000004) << 3) | ((sr & 0x000001) << 4);
  nnon = nonoise | noise;
);

function w_shift() instance(sr)
(
  sr = ((sr << 1) | (((sr >> 22) ~ (sr >> 17)) & 1)) & 0x7fffff;
  this.w_noise();
);

function w_wsr() instance(sr, wout, noise, nnon, nonoise)
(
  sr &= 0x6bb5da | ((wout & 0x800) << 9) | ((wout & 0x400) << 8) | ((wout & 0x200) << 5) | ((wout & 0x100) << 3) |
        ((wout & 0x080) << 2) | ((wout & 0x040) >> 1) | ((wout & 0x020) >> 3) | ((wout & 0x010) >> 4);
  noise &= wout;
  nnon = nonoise | noise;
);

function w_out1(srcacc) instance(wf, acc, ringm, wtab, nopulse, pulse, nnon, wout, test, fttl, pw) local(n)
(
  wf ? (
    wout = wtab[(acc ~ ((srcacc ~ 0xffffff) & ringm)) >> 12] & (nopulse | pulse) & nnon;
    (wf & 0xc) == 0xc ? (
      n = wout;
      wout = sidm ? (n < 0xfc0 ? n & (n << 1) : 0xfc0) : (n < 0xf00 ? 0 : n & (n << 1) & (n << 2));
    );
    (wf & 2) && (wf & 0xd) && !sidm ? acc &= (wout << 12) | 0x7fffff;
    wf > 8 && !test ? this.w_wsr();
  ) : fttl ? (
    fttl -= 1;
    !fttl ? (
      wout &= wout >> 1;
      wout ? fttl = sidm ? 50000 : 1500;
    );
  );
  pulse = (acc >> 12) >= pw ? 0xfff : 0;
);

function w_outd(srcacc, dt) instance(wf, acc, ringm, wtab, nopulse, pulse, nnon, wout, test, fttl)
(
  wf ? (
    wout = wtab[(acc ~ ((srcacc ~ 0xffffff) & ringm)) >> 12] & (nopulse | pulse) & nnon;
    (wf & 2) && (wf & 0xd) && !sidm ? acc &= (wout << 12) | 0x7fffff;
    wf > 8 && !test ? this.w_wsr();
  ) : fttl ? (
    fttl -= dt;
    fttl <= 0 ? (fttl = 0; wout = 0;);
  );
);

function w_clk(dt) instance(test, srr, sr, pulse, acc, freq, msbr, pw) local(da, an, spd, brk)
(
  test ? (
    srr ? (
      srr -= dt;
      srr <= 0 ? (sr = 0x7fffff; srr = 0; this.w_noise(););
    );
    pulse = 0xfff;
  ) : (
    da = dt * freq;
    an = (acc + da) & 0xffffff;
    msbr = ((acc ~ 0xffffff) & an & 0x800000) ? 1 : 0;
    acc = an;
    spd = 0x100000; brk = 0;
    while (da && !brk) (
      da < spd ? (
        spd = da;
        spd <= 0x80000 ? (
