mem_set_values(je + 120, 23.52, 67, 0, 23.52, 62, 0, 23.6, 38, 0, 23.82, 69, 0, 24, 71, 96, 24, 67, 58, 24, 62, 58, 24, 43, 70, 27.6, 43, 0, 28, 38, 62, 30.56, 71, 0, 31.52, 67, 0, 31.52, 62, 0, 31.6, 38, 0, 32, 72, 96, 32, 67, 58, 32, 64, 58, 32, 48, 70, 33.64, 72, 0, 34, 72, 96);
