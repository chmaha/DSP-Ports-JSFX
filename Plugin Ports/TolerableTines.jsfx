  g_sel = gfx_showmenu(#g_menu);
  g_sel > 0 ? ( slider2 = g_sel - 1; sliderchange(slider2); );
) : g_r >= 2 ? (
  slider2 = max(0, min(16, g_ch + (g_r == 2 ? 1 : -1))); sliderchange(slider2);
);

