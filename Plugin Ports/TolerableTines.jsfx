mem_set_values(je + 300, 55.52, 67, 0, 55.52, 64, 0, 55.6, 40, 0, 55.64, 71, 0, 56, 69, 96, 56, 66, 58, 56, 62, 58, 56, 38, 70, 59.28, 69, 0, 59.6, 38, 0, 60, 74, 96, 60, 45, 62, 63.28, 74, 0, 63.52, 66, 0, 63.52, 62, 0, 63.6, 45, 0, 64, 71, 96, 64, 67, 58, 64, 62, 58, 64, 43, 70);
mem_set_values(je + 360, 65.64, 71, 0, 66, 71, 96, 67.6, 43, 0, 67.64, 71, 0, 68, 71, 96, 68, 38, 62, 71.28, 71, 0, 71.52, 67, 0, 71.52, 62, 0, 71.6, 38, 0, 72, 71, 96, 72, 67, 58, 72, 62, 58, 72, 43, 70, 73.64, 71, 0, 74, 71, 96, 75.6, 43, 0, 75.64, 71, 0, 76, 71, 96, 76, 38, 62);
mem_set_values(je + 420, 79.28, 71, 0, 79.52, 67, 0, 79.52, 62, 0, 79.6, 38, 0, 80, 71, 96, 80, 67, 58, 80, 62, 58, 80, 43, 70, 81.64, 71, 0, 82, 74, 96, 83.6, 43, 0, 83.64, 74, 0, 84, 67, 96, 84, 38, 62, 86.46, 67, 0, 87, 69, 96, 87.52, 67, 0, 87.52, 62, 0, 87.6, 38, 0, 87.82, 69, 0);
