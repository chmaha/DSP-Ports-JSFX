  n === 0 ? strcpy(str, "Bank Select MSB") : n === 1 ? strcpy(str, "Modulation") : n === 2 ? strcpy(str, "Breath") :
  n === 5 ? strcpy(str, "Portamento Time") : n === 6 ? strcpy(str, "Data Entry MSB") : n === 7 ? strcpy(str, "Volume") :
  n === 8 ? strcpy(str, "Balance") : n === 10 ? strcpy(str, "Pan") : n === 11 ? strcpy(str, "Expression") :
  n === 32 ? strcpy(str, "Bank Select LSB") : n === 37 ? strcpy(str, "Portamento Time LSB") : n === 38 ? strcpy(str, "Data Entry LSB") :
  n === 64 ? strcpy(str, "Sustain") : n === 65 ? strcpy(str, "Portamento") : n === 66 ? strcpy(str, "Sostenuto") :
  n === 67 ? strcpy(str, "Soft Pedal") : n === 68 ? strcpy(str, "Legato") : n === 71 ? strcpy(str, "Resonance") :
  n === 72 ? strcpy(str, "Release Time") : n === 73 ? strcpy(str, "Attack Time") : n === 74 ? strcpy(str, "Brightness") :
  n === 84 ? strcpy(str, "Portamento Control") : n === 91 ? strcpy(str, "Reverb Send") : n === 93 ? strcpy(str, "Chorus Send") :
  n === 98 ? strcpy(str, "NRPN LSB") : n === 99 ? strcpy(str, "NRPN MSB") : n === 100 ? strcpy(str, "RPN LSB") :
  n === 101 ? strcpy(str, "RPN MSB") : n === 120 ? strcpy(str, "All Sound Off") : n === 121 ? strcpy(str, "Reset Controllers") :
  n === 122 ? strcpy(str, "Local Control") : n === 123 ? strcpy(str, "All Notes Off") : n === 124 ? strcpy(str, "Omni Off") :
  n === 125 ? strcpy(str, "Omni On") : n === 126 ? strcpy(str, "Mono On") : n === 127 ? strcpy(str, "Poly On") :
  sprintf(str, "Controller %d", n);
);

function mon_decode(m) local(ty, p, j)
