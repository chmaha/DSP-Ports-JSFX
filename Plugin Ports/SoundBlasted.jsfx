in_pin:none
out_pin:Left output
out_pin:Right output
options:no_meter

@init
ext_noinit = gfx_ext_retina = 1;
last_srate = srate;
NSL = 116;
TCT2HZ = 0; TCB2AMP = 1200; CONCAVE = 2700; CONVEX = 2830; PANTAB = 3000; INTERP = 4100; P2 = 5200;
SINCOS = 6000; UPD = 30100;
CHB = 31000; CHS = 512;
NV = 256; V = 40000; VS = 256;
RV = 106000; RS = 160;
ACT = 188000; FIN = 188600; DSPBUF = 189200; MIXL = 189300; MIXR = 189400; MIXREV = 189500; MIXCHO = 189600;
EVQ = 190000; EVQ_LEN = 60000;
BTXT = 250000; BSAMP = 650000; BML = 660000; BPRE = 700000; BREC = 710000; BGEN = 760000;
FXM = 1000000; SMPL = 1600000;

C_KP = 128; C_GEN = 256; C_PRESS = 320; C_BEND = 321; C_PWS = 322; C_MDR = 323; C_SOSID = 324; C_TYPE = 325;
C_BANK = 326; C_PROG = 327; C_PRESET = 328; C_NRPNSEL = 329; C_NRPNACT = 330; C_KMS = 331;

V_STATUS = 0; V_CHAN = 1; V_KEY = 2; V_VEL = 3; V_ID = 4; V_START = 5; V_HASOFF = 6; V_RV = 7; V_ORV = 8;
V_CAN = 9; V_OCAN = 10; V_SAMPLE = 11; V_OSAMPLE = 12; V_ML = 13; V_NMOD = 14; V_ROOTKEY = 15; V_ATT = 16;
V_PITCH = 17; V_PAN = 18; V_BAL = 19; V_REVS = 20; V_CHOS = 21; V_GAIN = 22;
V_G = 64; V_GM = 128; V_GN = 192;
ST_CLEAN = 0; ST_ON = 1; ST_SUST = 2; ST_SOST = 3; ST_OFF = 4; NO_CHANNEL = 255;

R_SAMPLE = 0; R_START = 1; R_END = 2; R_LS = 3; R_LE = 4; R_MODE = 5; R_CHECK = 6; R_PHI = 7; R_PHF = 8;
R_LOOPED = 9; R_PITCH = 10; R_POFS = 11; R_PINC = 12; R_ROOTHZ = 13; R_ATT = 15; R_PATT = 16;
R_MINATT = 17; R_ANFNL = 18; R_ANFL = 19; R_SGAIN = 20; R_INCR = 21; R_TICKS = 22; R_NOFFT = 23;
R_VE = 24; R_ME = 62;
R_ME2FC = 100; R_ME2P = 101; R_ML = 102; R_ML2FC = 105; R_ML2P = 106; R_ML2VOL = 107; R_VL = 108; R_VL2P = 111;
R_FH1 = 112; R_FH2 = 113; R_FRES = 114; R_FLAST = 115; R_FINC = 116; R_FCNT = 117; R_FLQ = 118; R_QINC = 119;
R_QCNT = 120; R_FSTART = 121; R_FAMP = 122; R_FAINC = 123; R_B02 = 124; R_B1 = 125; R_A1 = 126; R_A2 = 127;
R_BCUR = 128; R_BTGT = 132; R_INTERP = 137;
E_SEC = 0; E_CNT = 1; E_VAL = 2; E_DATA = 3;
ENV_DELAY = 0; ENV_ATTACK = 1; ENV_HOLD = 2; ENV_DECAY = 3; ENV_SUSTAIN = 4; ENV_RELEASE = 5; ENV_FINISHED = 6;
UINT_MAX = 4294967295; FRACT = 4294967296;
Q_MIN = 0.001;

function itrunc(x) ( x < 0 ? -floor(-x) : floor(x); );

function f32(x) local(a, e, q, m, r, f)
(
  x === 0 ? 0 : (
    a = abs(x);
    e = floor(log(a) / log(2));
    while (pow(2, e) > a) ( e -= 1; );
    while (pow(2, e + 1) <= a) ( e += 1; );
    e < -126 ? e = -126;
    q = pow(2, e - 23);
    m = a / q; r = floor(m); f = m - r;
    (f > 0.5 || (f === 0.5 && (r - 2 * floor(r / 2)) === 1)) ? r += 1;
    x < 0 ? -(r * q) : r * q;
  );
);

function build_tables() local(i, x, r, L10)
(
  L10 = 2.302585092994046;
  P2[0] = 1; i = 1; loop(63, P2[i] = P2[i - 1] * 2; i += 1; );
  i = 0; loop(1200, TCT2HZ[i] = 6.875 * pow(2, i / 1200); i += 1; );
  i = 0; loop(1441, TCB2AMP[i] = pow(10, i / -200); i += 1; );
  CONCAVE[0] = 0; CONCAVE[127] = 1; CONVEX[0] = 0; CONVEX[127] = 1;
  i = 1; loop(126,
    CONCAVE[i] = ((-400 / 960) * log((127 - i) / 127)) / L10;
    CONVEX[i] = 1 - (((-400 / 960) * log(i / 127)) / L10);
    i += 1;
  );
  i = 0; loop(1002, PANTAB[i] = sin(i * (1.5707963267948966 / 1001)); i += 1; );
  i = 0; loop(256,
    x = i / 256;
    INTERP[i * 4] = x * (-0.5 + (x * (1 - (0.5 * x))));
    INTERP[i * 4 + 1] = 1 + ((x * x) * ((1.5 * x) - 2.5));
    INTERP[i * 4 + 2] = x * (0.5 + (x * (2 - (1.5 * x))));
    INTERP[i * 4 + 3] = ((0.5 * x) * x) * (x - 1);
    i += 1;
  );
);

function ct2hz_real(cents) local(ic, fac, rem)
(
  ic = itrunc(cents) + 300;
  fac = floor(ic / 1200);
  rem = ic - 1200 * fac;
  fac >= 0 ? P2[fac - 32 * floor(fac / 32)] * TCT2HZ[rem] : TCT2HZ[rem] / P2[(-fac) - 32 * floor((-fac) / 32)];
);

function ct2hz(cents) ( ct2hz_real(cents >= 13500 ? 13500 : (cents < 1500 ? 1500 : cents)); );

function cb2amp(cb) ( cb < 0 ? pow(10, cb / -200) : (cb >= 1441 ? 0 : TCB2AMP[floor(cb)]); );

function tc2sec(tc) ( pow(2, tc / 1200); );
function tc2sec_delay(tc) ( tc <= -32768 ? 0 : tc2sec(tc < -12000 ? -12000 : (tc > 5000 ? 5000 : tc)); );
function tc2sec_attack(tc) ( tc <= -32768 ? 0 : tc2sec(tc < -12000 ? -12000 : (tc > 8000 ? 8000 : tc)); );
function hz2ct(f) ( 6900 + ((1200 / 0.6931471805599453) * log(f / 440)); );

function fpan(c, left) ( left ? c = -c; c <= -500 ? 0 : (c >= 500 ? 1 : PANTAB[itrunc(c) + 500]); );
function fbalance(b, left)
(
  b === 0 ? 1 : (
    ((left && b < 0) || (!left && b > 0)) ? 1 : cb2amp(abs(b));
  );
);
function fconcave(val) local(iv)
(
  iv = itrunc(val);
  val < 0 ? 0 : (iv >= 127 ? CONCAVE[127] : CONCAVE[iv] + ((CONCAVE[iv + 1] - CONCAVE[iv]) * (val - iv)));
);
function fconvex(val) local(iv)
(
  iv = itrunc(val);
  val < 0 ? 0 : (iv >= 127 ? CONVEX[127] : CONVEX[iv] + ((CONVEX[iv + 1] - CONVEX[iv]) * (val - iv)));
);

function build_sincos(rate) local(i, period, w)
(
  period = (2 * 3.141592653589793) / rate;
  i = 0; loop(12001,
    w = period * ct2hz(1500 + i);
    SINCOS[2 * i] = sin(w); SINCOS[2 * i + 1] = cos(w);
    i += 1;
  );
);

function synth_rate(rate)
(
  out_rate = rate;
  build_sincos(rate);
  max_fres_ct = hz2ct(0.44999998807907104 * rate);
  min_note_ticks = floor((10 * rate) / 1000);
);

function synth_setup(rate) local(i, r)
(
  synth_rate(rate);
  min_fres_ct = hz2ct(5);
  synth_gain = 1;
  noise_floor = 0.0000002;
  rev_on = 0; cho_on = 0; rev_type = 2; interp_method = 4; poly = NV; mix_poly = NV; note_cut = 0;
);

function env_set(e, sec, count, coeff, incr, mn, mx) local(d)
(
  d = e + E_DATA + 5 * sec;
  d[0] = count; d[1] = coeff; d[2] = incr; d[3] = mn; d[4] = mx;
);
function env_reset(e) ( e[E_CNT] = 0; e[E_SEC] = ENV_DELAY; e[E_VAL] = 0; );
function env_calc(e) local(d, x)
(
  d = e + E_DATA + 5 * e[E_SEC];
  while (e[E_CNT] >= d[0]) (
    e[E_SEC] === ENV_DECAY ? e[E_VAL] = d[3] * d[1];
    e[E_SEC] += 1; d += 5; e[E_CNT] = 0;
  );
  x = (d[1] * e[E_VAL]) + d[2];
  x < d[3] ? ( x = d[3]; e[E_SEC] += 1; e[E_CNT] = 0; ) :
  x > d[4] ? ( x = d[4]; e[E_SEC] += 1; e[E_CNT] = 0; ) :
  e[E_CNT] += 1;
  e[E_VAL] = x;
);

function lfo_calc(l, cur) local(lv)
(
  cur >= l[1] ? (
    lv = l[0] + l[2];
    lv > 1 ? ( l[2] = -l[2]; lv = 2 - lv; ) : lv < -1 ? ( l[2] = -l[2]; lv = -2 - lv; );
    l[0] = lv;
  );
);

function rv_init(rp)
(
  memset(rp, 0, RS);
  env_set(rp + R_VE, ENV_SUSTAIN, UINT_MAX, 1, 0, -1, 2);
  env_set(rp + R_VE, ENV_FINISHED, UINT_MAX, 0, 0, -1, 1);
  env_set(rp + R_ME, ENV_SUSTAIN, UINT_MAX, 1, 0, -1, 2);
  env_set(rp + R_ME, ENV_FINISHED, UINT_MAX, 0, 0, -1, 1);
  rp[R_FH1] = 0; rp[R_FH2] = 0; rp[R_FLAST] = -1; rp[R_FLQ] = 0; rp[R_FSTART] = 1; rp[R_FAMP] = 0; rp[R_FAINC] = 0;
  rp[R_SAMPLE] = -1;
);

function rv_reset(rp)
(
  rp[R_LOOPED] = 0; rp[R_TICKS] = 0; rp[R_NOFFT] = 0; rp[R_POFS] = 0; rp[R_PINC] = 0;
  env_reset(rp + R_ME); env_reset(rp + R_VE);
  rp[R_VL] = 0; rp[R_ML] = 0;
  rp[R_FH1] = 0; rp[R_FH2] = 0; rp[R_FLAST] = -1; rp[R_FLQ] = 0; rp[R_FSTART] = 1; rp[R_FAMP] = 0; rp[R_FAINC] = 0;
  rp[R_CHECK] |= 2;
);

function rv_voiceoff(rp)
(
  rp[R_VE + E_SEC] = ENV_FINISHED; rp[R_VE + E_CNT] = 0;
  rp[R_ME + E_SEC] = ENV_FINISHED; rp[R_ME + E_CNT] = 0;
);

function rv_set_synth_gain(rp, g)
(
  rp[R_SGAIN] = g;
  rp[R_ANFNL] = noise_floor / g; rp[R_ANFL] = noise_floor / g;
  rp[R_CHECK] |= 1;
);
function rv_set_att(rp, a) ( rp[R_PATT] = rp[R_ATT]; rp[R_ATT] = a; );

function rv_noteoff(rp, min_ticks) local(lfo, amp, ev)
(
  min_ticks > rp[R_TICKS] ? (
    rp[R_NOFFT] = min_ticks;
  ) : (
    rp[R_NOFFT] = 0;
    rp[R_VE + E_SEC] === ENV_ATTACK && rp[R_VE + E_VAL] > 0 ? (
      lfo = rp[R_ML] * -rp[R_ML2VOL];
      amp = rp[R_VE + E_VAL] * cb2amp(lfo);
      ev = -(((((-200 / 2.302585092994046) * log(amp)) - lfo) / 960) - 1);
      ev < 0 ? ev = 0 : ev > 1 ? ev = 1;
      rp[R_VE + E_VAL] = ev;
    );
    rp[R_ME + E_SEC] === ENV_ATTACK && rp[R_ME + E_VAL] > 0 ? (
      ev = fconvex(127 * rp[R_ME + E_VAL]);
      ev < 0 ? ev = 0 : ev > 1 ? ev = 1;
      rp[R_ME + E_VAL] = ev;
    );
    rp[R_VE + E_SEC] = ENV_RELEASE; rp[R_VE + E_CNT] = 0;
    rp[R_ME + E_SEC] = ENV_RELEASE; rp[R_ME + E_CNT] = 0;
  );
);

function q_from_db(q)
(
  q = q / 10;
  q < 0 ? q = 0 : q > 96 ? q = 96;
  q = q - 3.0099999904632568;
  pow(10, q / 20);
);

function filt_set_q(rp, q)
(
  q = q_from_db(q);
  rp[R_FSTART] ? (
    rp[R_FLQ] = q; rp[R_QCNT] = 0;
  ) : (
    q >= Q_MIN && rp[R_FLQ] < Q_MIN ? rp[R_FLQ] = Q_MIN;
    rp[R_QINC] = (q - rp[R_FLQ]) / 64;
    rp[R_QCNT] = 64;
  );
);

function filt_coeffs(fres, q) local(ti, sn, cs, alpha, a0i)
(
  ti = itrunc(fres) - 1500;
  ti < 0 ? ti = 0 : ti > 12000 ? ti = 12000;
  sn = SINCOS[2 * ti]; cs = SINCOS[2 * ti + 1];
  alpha = sn / (2 * q);
  a0i = 1 / (1 + alpha);
  fc_a1 = (-2 * cs) * a0i;
  fc_a2 = (1 - alpha) * a0i;
  fc_b1 = ((1 - cs) * a0i) * (1 / sqrt(q));
  fc_b02 = fc_b1 * 0.5;
);

function filt_calc(rp, fres_mod) local(fres, diff, calc, old, n)
(
  fres = rp[R_FRES] + fres_mod;
  fres > max_fres_ct ? fres = max_fres_ct : fres < min_fres_ct ? fres = min_fres_ct;
  diff = fres - rp[R_FLAST];
  calc = 0;
  rp[R_FSTART] ? (
    calc = 1; rp[R_FCNT] = 0; rp[R_FLAST] = fres;
    rp[R_FSTART] = rp[R_FLQ] < Q_MIN;
  ) : abs(diff) > 1 ? (
    n = rp[R_FLQ]; n < 1 ? n = 1 : n > 5 ? n = 5;
    n = 64 * n;
    rp[R_FINC] = diff / n;
    rp[R_FCNT] = floor(n + 0.5);
    calc = 1;
  ) : (
    old = rp[R_FLAST]; rp[R_FLAST] = fres; rp[R_FCNT] = 0;
    calc = old !== fres;
  );
  calc && !rp[R_FSTART] ? (
    filt_coeffs(rp[R_FLAST], rp[R_FLQ]);
    rp[R_A1] = fc_a1; rp[R_A2] = fc_a2; rp[R_B02] = fc_b02; rp[R_B1] = fc_b1;
  );
);

function filt_apply(rp, count) local(h1, h2, a1, a2, b02, b1, fcnt, qcnt, amp, ainc, fres, q, finc, qinc, i, c, s)
(
  rp[R_FLQ] >= Q_MIN ? (
    h1 = rp[R_FH1]; h2 = rp[R_FH2];
    a1 = rp[R_A1]; a2 = rp[R_A2]; b02 = rp[R_B02]; b1 = rp[R_B1];
