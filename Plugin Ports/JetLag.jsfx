  gfrr(G_XX, G_YY, G_XX + G_WW, G_YY + G_HH, floor(4 * G_SC), hov ? TH_KH_R : TH_KB_R, hov ? TH_KH_G : TH_KB_G, hov ? TH_KH_B : TH_KB_B, 1);
  gbord(G_XX, G_YY, G_XX + G_WW, G_YY + G_HH, floor(4 * G_SC), max(1, floor(G_SC + 0.5)), TH_TX_R, TH_TX_G, TH_TX_B, hov ? 0.7 : 0.35);
  gtext(cx, 189, "SET", 4, 0.97, 0.96, 0.93, 1, 1);
);

function fl_coef() (
  c_rate = min(max(f32k(fl_rate), 0.05000000074505806), 10.0);
  c_dep = min(max(f32k(fl_depth), 0), 1);
  c_fb = min(max((fl_feedback), -0.9900000095367432), 0.9900000095367432);
