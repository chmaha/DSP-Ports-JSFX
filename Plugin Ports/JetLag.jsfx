spl1 = t_o;

@gfx 1060 276
G_NOW = time_precise();
G_WHEEL = mouse_wheel; mouse_wheel = 0;
G_SC = max(0.45, min(gfx_w / 1060, gfx_h / 276));
G_OX = floor((gfx_w - 1060 * G_SC) * 0.5);
G_SC !== G_FSC ? (
  G_FSC = G_SC;
  gfx_setfont(1, "Arial", 13 * G_SC, 'b');
  gfx_setfont(2, "Arial", 12 * G_SC);
  gfx_setfont(3, "Arial", 14 * G_SC, 'b');
  gfx_setfont(4, "Arial", 12 * G_SC);
  gfx_setfont(5, "Arial", 11 * G_SC);
  gfx_setfont(6, "Arial", 15 * G_SC, 'b');
);
G_GH = max(1, gfx_h);
(gfx_w !== G_CW0 || gfx_h !== G_CH0 || G_SC !== G_CS0) ? (
  G_CW0 = gfx_w; G_CH0 = gfx_h; G_CS0 = G_SC;
  G_DST = gfx_dest;
  gfx_setimgdim(22, 0, 0); gfx_setimgdim(22, gfx_w, gfx_h);
  gfx_dest = 22;
  gfx_gradrect(0, 0, gfx_w, gfx_h, TH_BG0_R, TH_BG0_G, TH_BG0_B, 1, 0, 0, 0, 0, (TH_BG1_R - TH_BG0_R) / G_GH, (TH_BG1_G - TH_BG0_G) / G_GH, (TH_BG1_B - TH_BG0_B) / G_GH, 0);
  gfx_mode = 0;
  gtitle(0, 24, 44, 24, TH_T0_R, TH_T0_G, TH_T0_B);
  gtitle(1, 24 + gtitle_w(0, 24) + 14, 44, 13, TH_T1_R, TH_T1_G, TH_T1_B);
  gtext(1060 - 20, 30, "based on Classic Flanger RE-01 by AnClark Liu", 4, TH_CR_R, TH_CR_G, TH_CR_B, 1, 2);
  G_XX = floor(gsx(14)); G_YY = floor(gsy(62)); G_WW = ceil((1060 - 28) * G_SC); G_HH = ceil(200 * G_SC);
  gfrr(G_XX + 2, G_YY + 3, G_XX + G_WW + 2, G_YY + G_HH + 3, floor(12 * G_SC), 0, 0, 0, 0.35);
  gfrr(G_XX, G_YY, G_XX + G_WW, G_YY + G_HH, floor(12 * G_SC), TH_PN_R, TH_PN_G, TH_PN_B, 1);
  gbord(G_XX, G_YY, G_XX + G_WW, G_YY + G_HH, floor(12 * G_SC), max(1, floor(1.5 * G_SC + 0.5)), TH_PE_R, TH_PE_G, TH_PE_B, 0.3);
  gsection(30, 130, 84, "DELAY");
  gsection(160, 560, 84, "MODULATION");
  gsection(590, 900, 84, "OUTPUT");
  gsection(972 - 60, 972 + 60, 84, "PRESET");
  G_I = 0;
  loop(GKN,
    gscale(GKI[G_I], GKX[G_I], 164, 30);
    gtext(GKX[G_I], 164 + 30 + 30, GKL[G_I], 1, TH_TX_R, TH_TX_G, TH_TX_B, 1, 1);
    G_I += 1;
  );
  G_I = 0;
  loop(GSN,
    gtext(GSWX[G_I], 224, GSL[G_I], 1, TH_TX_R, TH_TX_G, TH_TX_B, 1, 1);
    G_I += 1;
  );
  gfx_dest = G_DST;
);
gfx_x = 0; gfx_y = 0; gfx_a = 1; gfx_mode = 0;
gfx_blit(22, 1, 0);

G_MD = mouse_cap & 1;
G_PRESS = G_MD && !G_LMD;
G_REL = !G_MD && G_LMD;
G_MX = (mouse_x - G_OX) / G_SC; G_MY = mouse_y / G_SC;
G_DCLK = G_PRESS && G_NOW - G_LCLK < 0.3 && abs(G_MX - G_LCX) < 4 && abs(G_MY - G_LCY) < 4;
G_PRESS ? ( G_LCLK = G_DCLK ? 0 : G_NOW; G_LCX = G_MX; G_LCY = G_MY; );

G_HK = 0;
G_I = 0;
loop(GKN,
  (G_MX - GKX[G_I]) ^ 2 + (G_MY - 164) ^ 2 <= 36 * 36 ? G_HK = GKI[G_I];
  G_I += 1;
);
G_HS = -1; G_HSR = -1;
G_I = 0;
loop(GSN,
  G_MX >= GSWX[G_I] - 40 && G_MX <= GSWX[G_I] + 52 && G_MY >= 122 && G_MY <= 172 ? ( G_HS = G_I; G_HSR = G_MY < 147 ? 0 : 1; );
  G_MX >= GSWX[G_I] - 32 && G_MX <= GSWX[G_I] + 32 && G_MY >= 176 && G_MY <= 202 ? ( G_HS = G_I; G_HSR = 2; );
  G_I += 1;
);
G_DRAG === 1 ? G_HK = G_DK;
G_I = 0;
loop(GKN, hknob(GKI[G_I], GKX[G_I], 164, 30, G_HK === GKI[G_I]); G_I += 1;);
G_I = 0;
loop(GSN, gswitch(G_I, G_HS === G_I && G_HSR === 2); G_I += 1;);

G_CURP = -1;
G_I = 0;
loop(NPRS,
  G_J = 1; G_OK = 1;
  loop(NPAR, PRS[G_I * NPAR + G_J - 1] !== hk_get(G_J) ? G_OK = 0; G_J += 1;);
  G_CURP < 0 && G_OK ? G_CURP = G_I;
  G_I += 1;
);
G_HPB = G_MX >= 972 - 52 && G_MX <= 972 + 52 && G_MY >= 130 && G_MY <= 160;
G_HPL = G_MX >= 972 - 52 && G_MX <= 972 - 4 && G_MY >= 172 && G_MY <= 196;
G_HPR = G_MX >= 972 + 4 && G_MX <= 972 + 52 && G_MY >= 172 && G_MY <= 196;
G_XX = floor(gsx(972 - 52)); G_YY = floor(gsy(130)); G_WW = ceil(104 * G_SC); G_HH = ceil(30 * G_SC);
gfrr(G_XX, G_YY, G_XX + G_WW, G_YY + G_HH, floor(5 * G_SC), G_HPB ? TH_KH_R : TH_KB_R, G_HPB ? TH_KH_G : TH_KB_G, G_HPB ? TH_KH_B : TH_KB_B, 1);
gbord(G_XX, G_YY, G_XX + G_WW, G_YY + G_HH, floor(5 * G_SC), max(1, floor(G_SC + 0.5)), TH_TX_R, TH_TX_G, TH_TX_B, G_HPB ? 0.8 : 0.45);
G_CURP >= 0 ? strcpy(#g_pn, 100 + G_CURP) : strcpy(#g_pn, "Custom");
gfx_setfont(4); gfx_measurestr(#g_pn, G_TW, G_TH);
gtext(972, 145, #g_pn, G_TW > 96 * G_SC ? 5 : 4, 0.98, 0.97, 0.94, 1, 1);
G_I = 0;
loop(2,
  G_XX = floor(gsx(G_I ? 972 + 4 : 972 - 52)); G_YY = floor(gsy(172)); G_WW = ceil(48 * G_SC); G_HH = ceil(24 * G_SC);
  G_H = G_I ? G_HPR : G_HPL;
  gfrr(G_XX, G_YY, G_XX + G_WW, G_YY + G_HH, floor(12 * G_SC), TH_PB_R, TH_PB_G, TH_PB_B, G_H ? 0.95 : 0.7);
  gbord(G_XX, G_YY, G_XX + G_WW, G_YY + G_HH, floor(12 * G_SC), max(1, floor(G_SC + 0.5)), TH_TX_R, TH_TX_G, TH_TX_B, G_H ? 0.8 : 0.4);
  G_AX = gsx(G_I ? 972 + 28 : 972 - 28); G_AY = gsy(184); G_AS = 4.5 * G_SC;
  gfx_set(0.98, 0.97, 0.94, 1);
  G_I ? gfx_triangle(G_AX - G_AS * 0.7, G_AY - G_AS, G_AX - G_AS * 0.7, G_AY + G_AS, G_AX + G_AS * 0.9, G_AY) :
    gfx_triangle(G_AX + G_AS * 0.7, G_AY - G_AS, G_AX + G_AS * 0.7, G_AY + G_AS, G_AX - G_AS * 0.9, G_AY);
  G_I += 1;
);
gtext(972, 222, "9 factory presets", 5, TH_TX_R, TH_TX_G, TH_TX_B, 0.95, 1);

G_SETP = -1;
G_PRESS ? (
  G_HK > 0 ? (
    G_DCLK ? ( hk_set(G_HK, GKDEF[G_HK]); gauto(G_HK, 1); ) :
    ( G_DRAG = 1; G_DK = G_HK; G_DY = mouse_y; G_DT = hk_t(G_HK, hk_get(G_HK)); );
  ) :
  G_HS >= 0 ? (
    G_K = GSI[G_HS];
    G_V = G_HSR === 0 ? GSV0[G_HS] : G_HSR === 1 ? GSV1[G_HS] : hk_get(G_K) >= 0.5 * (GSV0[G_HS] + GSV1[G_HS]) ? GSV0[G_HS] : GSV1[G_HS];
    G_V !== hk_get(G_K) ? ( hk_set(G_K, G_V); gauto(G_K, 1); );
  ) :
  G_HPB ? (
    strcpy(#g_menu, "");
    G_I = 0;
    loop(NPRS,
      G_I === G_CURP ? strcat(#g_menu, "!");
      strcat(#g_menu, 100 + G_I);
      G_I < NPRS - 1 ? strcat(#g_menu, "|");
      G_I += 1;
    );
    gfx_x = gsx(972 - 52); gfx_y = gsy(160);
    G_R = gfx_showmenu(#g_menu);
    G_R > 0 ? G_SETP = G_R - 1;
    G_LMD = 0; G_MD = 0;
  ) :
  G_HPL ? G_SETP = G_CURP < 0 ? 0 : (G_CURP + NPRS - 1) % NPRS :
  G_HPR ? G_SETP = G_CURP < 0 ? 0 : (G_CURP + 1) % NPRS;
);
G_SETP >= 0 ? (
  G_I = 1;
  loop(NPAR, hk_set(G_I, PRS[G_SETP * NPAR + G_I - 1]); gauto(G_I, 1); G_I += 1;);
);
G_DRAG === 1 && G_MD ? (
  G_V = hk_v(G_DK, G_DT + (G_DY - mouse_y) * ((mouse_cap & 4) ? 0.0005 : 0.005) / G_SC);
  G_V !== hk_get(G_DK) ? ( hk_set(G_DK, G_V); gauto(G_DK, 0); );
  mouse_cap |= 65536;
);
G_REL ? (
  G_DRAG === 1 ? gauto(G_DK, 1);
  G_DRAG = 0;
);
G_WHEEL !== 0 && G_DRAG === 0 && G_HK > 0 ? (
  G_T = hk_t(G_HK, hk_get(G_HK)) + (G_WHEEL > 0 ? 1 : -1) * ((mouse_cap & 4) ? 0.002 : 0.02);
  G_V = hk_v(G_HK, G_T);
  G_V === hk_get(G_HK) ? G_V = hk_v(G_HK, G_T + (G_WHEEL > 0 ? 1 : -1) * 0.002);
  hk_set(G_HK, G_V); gauto(G_HK, 1);
);

G_TID = 0;
G_HK > 0 ? G_TID = 1 : G_HS >= 0 ? G_TID = 4 : G_HPB ? G_TID = 2 : (G_HPL || G_HPR) ? G_TID = 3;
(G_TID !== G_TLAST || G_MD || G_DRAG > 0 || G_WHEEL !== 0) ? ( G_TLAST = G_TID; G_TT0 = G_NOW; );
(G_TID > 0 && !G_MD && G_DRAG === 0 && G_NOW - G_TT0 >= 0.5) ? (
  gtip_text(G_TID);
  gfx_setfont(4);
  gfx_measurestr(#g_tip, G_TW, G_TH);
  G_TPW = G_TW + floor(16 * G_SC); G_TPH = G_TH + floor(10 * G_SC);
  G_TPX = mouse_x + floor(14 * G_SC); G_TPY = mouse_y + floor(20 * G_SC);
  G_TPX + G_TPW > gfx_w - 2 ? G_TPX = max(2, gfx_w - 2 - G_TPW);
  G_TPY + G_TPH > gfx_h - 2 ? G_TPY = max(2, mouse_y - floor(8 * G_SC) - G_TPH);
  gfrr(G_TPX + 2, G_TPY + 3, G_TPX + G_TPW + 2, G_TPY + G_TPH + 3, floor(5 * G_SC), 0, 0, 0, 0.35);
  gfrr(G_TPX, G_TPY, G_TPX + G_TPW, G_TPY + G_TPH, floor(5 * G_SC), TH_BG0_R, TH_BG0_G, TH_BG0_B, 0.97);
  gbord(G_TPX, G_TPY, G_TPX + G_TPW, G_TPY + G_TPH, floor(5 * G_SC), max(1, floor(G_SC + 0.5)), TH_T1_R, TH_T1_G, TH_T1_B, 0.6);
  gfx_set(TH_T0_R, TH_T0_G, TH_T0_B, 1);
  gfx_x = G_TPX + floor(8 * G_SC); gfx_y = G_TPY + floor(5 * G_SC);
  gfx_drawstr(#g_tip);
);
G_LMD = G_MD;

