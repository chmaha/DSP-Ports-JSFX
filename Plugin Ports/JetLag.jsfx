t_k = wp_l - t_ds; t_c = t_k * 536870913; t_rp = t_c - (t_c - t_k); while (t_rp < 0) ( t_k = t_rp + 4801; t_c = t_k * 536870913; t_rp = t_c - (t_c - t_k); ); while (t_rp >= 4801) ( t_k = t_rp - 4801; t_c = t_k * 536870913; t_rp = t_c - (t_c - t_k); );
