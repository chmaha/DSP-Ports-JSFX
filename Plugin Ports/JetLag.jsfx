);
@slider
fl_last_srate != srate ? ( fl_last_srate = srate; fl_sr = f32k(srate); );
fq0 = fl_rate; fq1 = fl_depth; fq2 = fl_feedback; fq3 = fl_delay; fq4 = fl_mix; fq5 = fl_phase; fq6 = fl_wave; fq7 = fl_polarity; fl_coef();

@block
(fl_rate !== fq0 || fl_depth !== fq1 || fl_feedback !== fq2 || fl_delay !== fq3 || fl_mix !== fq4 || fl_phase !== fq5 || fl_wave !== fq6 || fl_polarity !== fq7) ? (
