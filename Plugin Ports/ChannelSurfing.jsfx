// biquads (JUCE IIR::Filter, transposed direct form II)

// Baxandall2

function bx_set(bdb, tdb, bhz, thz) instance(t2, t3, t4, t5, t6, b2, b3, b4, b5, b6, tgl, bgl) local(tf, bf, k, nrm) (
  tgl = pow(10, tdb / 20);
  tf = (thz * tgl) / srate;
  tf > 0.45 ? tf = 0.45;
  bgl = pow(10, bdb / 20);
  bf = pow(10, -bdb / 20);
  bf = (bhz * bf) / srate;
  bf > 0.45 ? bf = 0.45;
  k = tan($pi * tf);
  nrm = 1 / ((1 + (k / 0.4)) + (k * k));
  t2 = (k * k) * nrm; t3 = 2 * t2; t4 = t2;
  t5 = (2 * ((k * k) - 1)) * nrm;
  t6 = ((1 - (k / 0.4)) + (k * k)) * nrm;
  k = tan($pi * bf);
  nrm = 1 / ((1 + (k / 0.2)) + (k * k));
  b2 = (k * k) * nrm; b3 = 2 * b2; b4 = b2;
  b5 = (2 * ((k * k) - 1)) * nrm;
  b6 = ((1 - (k / 0.2)) + (k * k)) * nrm;
);
function bx_reset() instance(ta7, ta8, tb7, tb8, ba7, ba8, bb7, bb8, flip) (
  ta7 = ta8 = tb7 = tb8 = ba7 = ba8 = bb7 = bb8 = 0; flip = 0;
);
function bx_proc(x) instance(t2, t3, t4, t5, t6, b2, b3, b4, b5, b6, tgl, bgl, ta7, ta8, tb7, tb8, ba7, ba8, bb7, bb8, flip)
                    local(s, ts, bs) (
  s = x;
  abs(s) < 0.0000000000000000000000118 ? s = 0;
  flip ? (
    ts = (s * t2) + ta7;
    ta7 = ((s * t3) - (ts * t5)) + ta8;
    ta8 = (s * t4) - (ts * t6);
    ts = s - ts;
    bs = (s * b2) + ba7;
    ba7 = ((s * b3) - (bs * b5)) + ba8;
    ba8 = (s * b4) - (bs * b6);
  ) : (
    ts = (s * t2) + tb7;
    tb7 = ((s * t3) - (ts * t5)) + tb8;
    tb8 = (s * t4) - (ts * t6);
    ts = s - ts;
    bs = (s * b2) + bb7;
    bb7 = ((s * b3) - (bs * b5)) + bb8;
    bb8 = (s * b4) - (bs * b6);
  );
  flip = !flip;
  (bs * bgl) + (ts * tgl);
);

// BellFilter (dynamic Q, JUCE makePeakFilter)

function bl_set(fhz, gdb, qoff) instance(c0, c1, c2, c3, c4) local(q, ag, ff, lg, lf, aa, om, al, cc, ata, aoa, inv) (
  ag = abs(gdb);
  q = gdb > 0 ? 0.15 + ((ag / 12) * (0.75 - 0.15)) : 0.25 + ((ag / 12) * (3.3 - 0.5));
  ff = fhz < 500 ? 1.1 : (fhz > 3000 ? 0.9 : 1.1 + (((fhz - 500) / 2500) * (0.9 - 1.1)));
  q *= ff;
  q += qoff;
  q = q < 0.1 ? 0.1 : (10 < q ? 10 : q);
  lg = pow(10, gdb / 20);
  lf = srate * 0.49;
  lf = fhz < 20 ? 20 : (lf < fhz ? lf : fhz);
  aa = pow(10, -300 * 0.05);
  aa = sqrt(lg < aa ? aa : lg);
  om = ((2 * $pi) * (lf < 2 ? 2 : lf)) / srate;
  al = sin(om) / (q * 2);
  cc = -2 * cos(om);
  ata = al * aa; aoa = al / aa;
  inv = 1 / (1 + aoa);
  c0 = (1 + ata) * inv; c1 = cc * inv; c2 = (1 - ata) * inv; c3 = cc * inv; c4 = (1 - aoa) * inv;
);
function bl_proc(x) instance(c0, c1, c2, c3, c4, z1, z2) local(o) (
  o = (c0 * x) + z1;
  z1 = ((c1 * x) - (c3 * o)) + z2;
  z2 = (c2 * x) - (c4 * o);
  o;
);

// FilterSection

function fl_set(hf, hslope, hqm, hqo, lf, lslope, lqm, lqo)
  instance(h18, l12, h0, h1, h2, h3, h4, p0, p1, p2, p3, p4)
  local(q, f, w0, al, dsc, pr, pim, tt, ert, re, im, a1, a2, gn, n, n2, iq, c1) (
  h18 = hslope; l12 = lslope;
  q = (hqm ? 1 : 0.707) + hqo;
  q = q < 0.1 ? 0.1 : (5 < q ? 5 : q);
  f = srate * 0.49;
  f = hf < 20 ? 20 : (f < hf ? f : hf);
  w0 = (2 * $pi) * f;
  al = w0 / (2 * q);
  dsc = (al * al) - (w0 * w0);
  pr = -al;
  pim = dsc >= 0 ? 0 : sqrt(-dsc);
  tt = 1 / srate;
  ert = exp(pr * tt);
  re = ert * cos(pim * tt);
  im = ert * sin(pim * tt);
  a1 = -2 * re;
  a2 = (re * re) + (im * im);
  gn = ((1 - -2) + 1) / ((1 - a1) + a2);
  h0 = (1 / gn) * 1; h1 = (-2 / gn) * 1; h2 = (1 / gn) * 1; h3 = (a1 / 1) * 1; h4 = (a2 / 1) * 1;
  q = lqm ? 1 : 0.707;
  !lslope ? q = 0.5;
  q += lqo;
  q = q < 0.1 ? 0.1 : (5 < q ? 5 : q);
  f = srate * 0.49;
  f = lf < 20 ? 20 : (f < lf ? f : lf);
  n = 1 / tan(($pi * f) / srate);
  n2 = n * n;
  iq = 1 / q;
  c1 = 1 / ((1 + (iq * n)) + n2);
  p0 = c1 * 1; p1 = (c1 * 2) * 1; p2 = c1 * 1; p3 = ((c1 * 2) * (1 - n2)) * 1; p4 = (c1 * ((1 - (iq * n)) + n2)) * 1;
);
function fl_reset() instance(hz1, hz2, hy1, hy2, lz1, lz2, ly1, ly2) ( hz1 = hz2 = hy1 = hy2 = lz1 = lz2 = ly1 = ly2 = 0; );
function fl_proc(x) instance(h18, l12, h0, h1, h2, h3, h4, p0, p1, p2, p3, p4, hz1, hz2, hy1, hy2, lz1, lz2, ly1, ly2) local(o) (
  o = (h0 * x) + hz1;
  hz1 = ((h1 * x) - (h3 * o)) + hz2;
  hz2 = (h2 * x) - (h4 * o);
  x = o;
  h18 ? (
    o = (h0 * x) + hy1;
    hy1 = ((h1 * x) - (h3 * o)) + hy2;
    hy2 = (h2 * x) - (h4 * o);
    x = o;
  );
  o = (p0 * x) + lz1;
  lz1 = ((p1 * x) - (p3 * o)) + lz2;
  lz2 = (p2 * x) - (p4 * o);
  x = o;
  l12 ? (
    o = (p0 * x) + ly1;
    ly1 = ((p1 * x) - (p3 * o)) + ly2;
    ly2 = (p2 * x) - (p4 * o);
    x = o;
  );
  x;
);

// LowDynamicSection

function ld_coefs(fast) instance(rmc, phd, atc, rlc, lac, lrc) (
  rmc = exp(-1 / (0.02 * srate));
  phd = exp(-1 / (0.05 * srate));
  fast ? (
    atc = exp(-1 / (0.0005 * srate));
    rlc = exp(-1 / (0.06 * srate));
    lac = atc; lrc = rlc;
  ) : (
    atc = exp(-1 / (0.015 * srate));
    rlc = exp(-1 / (0.1 * srate));
    lac = exp(-1 / (0.0005 * srate));
    lrc = exp(-1 / (0.015 * srate));
  );
);
function ld_reset() instance(rms, sg, ph, wu) ( rms = 0; sg = 1; ph = 0; wu = 100; );
function ld_proc(x, thr, rt, fast, mix) instance(rmc, phd, atc, rlc, lac, lrc, rms, sg, ph, wu)
  local(il, idb, det, tg, dbt, nr, er, kr, tl, ic) (
  abs(rt) < 0.01 ? (
    sg = 1;
    x;
  ) : (
    il = abs(x);
    idb = 20 * log10(il < 0.000001 ? 0.000001 : il);
    fast && rt < 0 ? (
      ph = il > ph ? il : il + (phd * (ph - il));
      det = ph;
    ) : (
      rms = (rms * rmc) + ((x * x) * (1 - rmc));
      det = sqrt(rms);
    );
    tg = 0;
    idb < thr ? (
      dbt = thr - idb;
      dbt = dbt < 0 ? 0 : dbt;
      rt < 0 ? (
        nr = abs(rt) / 10;
        er = 1 + ((nr * nr) * 3);
        tg = -dbt * (er - 1);
        tg = tg < -96 ? -96 : tg;
      ) : rt > 0 ? (
        tg = dbt * (rt * 0.075);
      );
      dbt < 0.5 ? (
        kr = dbt / 0.5;
        tg *= (kr * kr);
      );
    );
    tl = pow(10, tg / 20);
    (wu > 0 || det < 0.000001) ? (
      wu > 0 ? wu -= 1;
      ic = rt > 0 ? lac : atc;
      sg = 1 + (ic * (tl - 1));
      sg = 2 < sg ? 2 : sg;
      sg = sg < 0.5 ? 0.5 : sg;
    ) : rt < 0 ? (
      sg = tl < sg ? tl + (rlc * (sg - tl)) : tl + (atc * (sg - tl));
    ) : rt > 0 ? (
      sg = tl > sg ? tl + (lrc * (sg - tl)) : tl + (lac * (sg - tl));
    );
    (x * (1 - mix)) + ((x * sg) * mix);
  );
);
// sections (one namespace per section and channel)

function bl_reset() instance(z1, z2) ( z1 = z2 = 0; );

function sec_pre(x) instance(bm) local(m, w) (
  m = this.bgate(QPRE_BYP, FC);
  (m === 0 || m === 2) ? (
    w = QPRE_ALG == 0 ? x * QPRE_LIN : QPRE_ALG == 1 ? this.pd.pd_proc(x) :
        QPRE_ALG == 2 ? this.tt.tt_proc(x) : this.tb.tb_proc(x);
    m === 2 ? w = (w * (1 - bm)) + (x * bm);
    w;
  ) : (
    m === 3 ? ( this.pd.pd_reset(); this.tt.tt_reset(); this.tb.tb_reset(); );
    x;
  );
);

function sec_flt(x) instance(bm) local(m, w) (
  m = this.bgate(QFLT_BYP, FC);
  (m === 0 || m === 2) ? (
    w = this.fl_proc(x);
    m === 2 ? w = (w * (1 - bm)) + (x * bm);
    w;
  ) : (
    m === 3 ? this.fl_reset();
    x;
  );
);

function sec_cc(x) instance(bm) local(m, w) (
  m = this.bgate(QCC_BYP, FC);
  (m === 0 || m === 2) ? (
    w = this.dv_proc(x);
    m === 2 ? w = (w * (1 - bm)) + (x * bm);
    w;
  ) : (
    m === 3 ? this.dv_reset();
    x;
  );
);

function sec_ld(x) instance(bm) local(m) (
  m = this.bgate(QLD_BYP, 0);
  m === 0 ? this.ld_proc(x, QLD_THR, QLD_RAT, QLD_FAST, QLD_MIX) : (
    m === 3 ? this.ld_reset();
    x;
  );
);

function sec_eq(x) instance(bm) local(m, w) (
  m = this.bgate(QEQ_BYP, FC);
  (m === 0 || m === 2) ? (
    w = this.b2.bl_proc(this.b1.bl_proc(this.bx.bx_proc(x)));
    m === 2 ? w = (w * (1 - bm)) + (x * bm);
    w;
  ) : (
    m === 3 ? ( this.bx.bx_reset(); this.b1.bl_reset(); this.b2.bl_reset(); );
    x;
  );
);

function sec_sc(x) instance(bm) local(m, w) (
  m = this.bgate(QSC_BYP, FC);
  (m === 0 || m === 2) ? (
    w = x * QSC_GIN;
    w = QSC_ALG < 0.5 ? this.cl.cl_proc(w) : this.dv.dv_proc(w);
    w = w / QSC_GIN;
    w = (x * (1 - QSC_MIX)) + ((w * QSC_MK) * QSC_MIX);
    m === 2 ? w = (w * (1 - bm)) + (x * bm);
    w;
  ) : (
    m === 3 ? ( this.cl.cl_reset(); this.dv.dv_reset(); );
    x;
  );
);

function sec_con(x) instance(bm, gn) local(m, w) (
  m = this.bgate(QCON_BYP, FC);
  (m === 0 || m === 2) ? (
    QCON_ALG == 0 ? w = x : (
      w = x * gn;
      w = QCON_ALG == 1 ? this.pc.pc_proc(w) : QCON_ALG == 2 ? this.ssl.c8_proc(w, C8_SSL, 0.84934656) :
          QCON_ALG == 3 ? this.nev.c8_proc(w, C8_NEV, 0.33362176) : this.api.c8_proc(w, C8_API, 0.59969536);
      w = w / gn;
    );
    m === 2 ? w = (w * (1 - bm)) + (x * bm);
    w;
  ) : (
    m === 3 ? ( this.pc.pc_reset(); this.ssl.c8_reset(); this.nev.c8_reset(); this.api.c8_reset(); );
    x;
  );
);

function sec_out(x) instance(bm) local(m, w) (
  m = this.bgate(QOUT_BYP, FC);
  (m === 0 || m === 2) ? (
    w = QOUT_ALG == 0 ? x * QOUT_LIN : QOUT_ALG == 1 ? this.pd.pd_proc(x) :
        QOUT_ALG == 2 ? this.tt.tt_proc(x) : QOUT_ALG == 3 ? this.tb.tb_proc(x) :
        QOUT_ALG == 4 ? this.fc.fc_proc(x * QOUT_LIN) / QOUT_LIN : this.cs.cs_proc(x * QOUT_LIN) / QOUT_LIN;
    m === 2 ? w = (w * (1 - bm)) + (x * bm);
    w;
  ) : (
    m === 3 ? ( this.pd.pd_reset(); this.tt.tt_reset(); this.tb.tb_reset(); this.fc.fc_reset(); this.cs.cs_reset(); );
    x;
  );
);

function sec_vol(x) instance(bm, gl) local(m, w) (
  m = this.bgate(QVOL_BYP, FC);
  (m === 0 || m === 2) ? (
    w = x * gl;
    m === 2 ? w = (w * (1 - bm)) + (x * bm);
    w;
  ) : x;
);

// channel (dual mono)

function ch_proc(x) instance(osi, oso) local(a) (
  x = this.s_pre.sec_pre(x);
  !QFLT_POST ? x = this.s_flt.sec_flt(x);
  x = this.s_cc.sec_cc(x);
  x = this.s_ld.sec_ld(x);
  QSC_PRE ? x = this.s_sc.sec_sc(x);
  x = this.s_eq.sec_eq(x);
  !QSC_PRE ? x = this.s_sc.sec_sc(x);
  x = this.s_con.sec_con(x);
  osi += x * x;
  x = this.s_out.sec_out(x);
  oso += x * x;
  QFLT_POST ? x = this.s_flt.sec_flt(x);
  this.s_vol.sec_vol(x);
);

function ch_upd(ci) local(row, cvp, thr, bi) (
  row = cv_mode == 1 ? cv_pair * 2 + ci : cv_mode == 2 ? cv_pair * 2 : 48;
  row = (row >= 0 && row < 48) ? row : 48;
  cvp = CVTAB + row * 16;
  this.s_flt.fl_set(QHPF_F + cvp[12], QHPF_S, QHPF_Q, cvp[13], QLPF_F + cvp[10], QLPF_S, QLPF_Q, cvp[11]);
  thr = QCC_THR < -30 ? -30 : (-0.1 < QCC_THR ? -0.1 : QCC_THR);
  QCC_FAST ? this.s_cc.dv_set(thr, 4, 0.2, 40) : this.s_cc.dv_set(thr, 2.5, 30, 100);
  this.s_ld.ld_coefs(QLD_FAST);
  this.s_eq.bx.bx_set(QEQ_B + cvp[2], QEQ_T + cvp[0], QEQ_BF + cvp[3], QEQ_TF + cvp[1]);
  bi = QEQ_1F < 0 ? 0 : (14 < QEQ_1F ? 14 : QEQ_1F);
  this.s_eq.b1.bl_set(BELLF[bi] + cvp[4], QEQ_1G + cvp[5], cvp[6]);
  bi = QEQ_2F < 0 ? 0 : (14 < QEQ_2F ? 14 : QEQ_2F);
  this.s_eq.b2.bl_set(BELLF[bi] + cvp[7], QEQ_2G + cvp[8], cvp[9]);
  this.s_sc.dv.dv_set(-10, 20, 24, 10);
  this.s_pre.pd.pd_drv(QPRE_DRV); this.s_pre.tt.tt_drv(QPRE_DRV); this.s_pre.tb.tb_drv(QPRE_DRV);
  this.s_out.pd.pd_drv(QOUT_DRV); this.s_out.tt.tt_drv(QOUT_DRV); this.s_out.tb.tb_drv(QOUT_DRV);
  this.s_con.gn = pow(10, (QCON_DRV + cvp[14]) / 20);
  this.s_vol.gl = pow(10, (QVOL_DB + cvp[15]) / 20);
);

function ch_rate() (
  this.s_cc.dv_rate();
  this.s_sc.dv.dv_rate();
);

function ch_reset_all() (
  this.s_pre.bm = this.s_flt.bm = this.s_cc.bm = this.s_ld.bm = this.s_eq.bm = 0;
  this.s_sc.bm = this.s_con.bm = this.s_out.bm = this.s_vol.bm = 0;
  this.s_pre.pd.pd_reset();
  this.s_pre.tt.fh = this.s_pre.tt.fl = 0; this.s_pre.tt.tt_reset();
  this.s_pre.tb.tb_reset();
  this.s_flt.fl_reset();
  this.s_cc.dv_reset();
  this.s_ld.ld_reset();
  this.s_eq.bx.bx_reset(); this.s_eq.b1.bl_reset(); this.s_eq.b2.bl_reset();
  this.s_sc.cl.cl_reset(); this.s_sc.dv.dv_reset();
  this.s_con.pc.pc_reset(); this.s_con.ssl.c8_reset(); this.s_con.nev.c8_reset(); this.s_con.api.c8_reset();
  this.s_out.pd.pd_reset();
  this.s_out.tt.fh = this.s_out.tt.fl = 0; this.s_out.tt.tt_reset();
  this.s_out.tb.tb_reset(); this.s_out.fc.fc_reset(); this.s_out.cs.cs_reset();
  this.osi = this.oso = 0;
);

function ch_prepare(ci) (
  this.s_pre.tt.tt_seed(17 + ci * 1000000007);
  this.s_flt.hz1 = this.s_flt.hz2 = this.s_flt.hy1 = this.s_flt.hy2 = this.s_flt.lz1 = this.s_flt.lz2 = 0;
  this.s_ld.ld_reset();
  this.s_pre.tt.tt_rate(); this.s_out.tt.tt_rate();
  this.ch_rate();
);

function params_snapshot() (
  QPRE_ALG = pre_algo; QPRE_DRV = pre_drive; QPRE_LIN = pow(10, QPRE_DRV / 20); QPRE_BYP = pre_byp > 0.5;
  QHPF_F = hpf_freq; QHPF_S = hpf_slope >= 0.5; QHPF_Q = hpf_q >= 0.5;
  QLPF_F = lpf_freq; QLPF_S = lpf_slope >= 0.5; QLPF_Q = lpf_q >= 0.5;
  QFLT_BYP = flt_byp > 0.5; QFLT_POST = flt_post > 0.5;
  QCC_THR = cc_thr; QCC_FAST = cc_fast >= 0.5; QCC_BYP = cc_byp > 0.5;
  QLD_THR = ld_thr; QLD_RAT = ld_ratio; QLD_FAST = ld_fast > 0.5;
  QLD_MIX = (ld_mix < 0 ? 0 : (100 < ld_mix ? 100 : ld_mix)) / 100; QLD_BYP = ld_byp > 0.5;
  QEQ_B = eq_bass; QEQ_BF = eq_bfreq; QEQ_T = eq_treble; QEQ_TF = eq_tfreq;
  QEQ_1F = floor(eq_b1f + 0.5); QEQ_1G = eq_b1g; QEQ_2F = floor(eq_b2f + 0.5); QEQ_2G = eq_b2g; QEQ_BYP = eq_byp > 0.5;
  QSC_ALG = sc_algo >= 0.5;
  QSC_GIN = pow(10, (sc_in < -18 ? -18 : (60 < sc_in ? 60 : sc_in)) / 20);
  QSC_MK = pow(10, (sc_mk < -6 ? -6 : (24 < sc_mk ? 24 : sc_mk)) / 20);
  QSC_MIX = (sc_mix < 0 ? 0 : (100 < sc_mix ? 100 : sc_mix)) / 100;
  QSC_BYP = sc_byp > 0.5; QSC_PRE = sc_pre > 0.5;
  QCON_ALG = con_algo; QCON_DRV = con_drive; QCON_BYP = con_byp > 0.5;
  QOUT_ALG = out_algo; QOUT_DRV = out_drive; QOUT_LIN = pow(10, QOUT_DRV / 20); QOUT_BYP = out_byp > 0.5;
  QVOL_DB = vol_gain; QVOL_BYP = vol_byp > 0.5;
  QTT_FIX = tt_fix > 0.5;
  L.ch_upd(0); R.ch_upd(1);
);

function rate_setup() (
  FC = 1 / (0.01 * srate);
  tt_coefs();
  cl_coefs();
  C8_NEV = 0.005832 / (srate / 44100);
  C8_API = 0.004096 / (srate / 44100);
  C8_SSL = 0.004913 / (srate / 44100);
  MT_PK = exp(-1 / (0.2 * srate));
  C8_IL2 = 1 / log(2);
);

BELLF = alloc(15);
BELLF[0] = 50; BELLF[1] = 100; BELLF[2] = 200; BELLF[3] = 300; BELLF[4] = 400; BELLF[5] = 500; BELLF[6] = 700;
BELLF[7] = 900; BELLF[8] = 1400; BELLF[9] = 2400; BELLF[10] = 3500; BELLF[11] = 5000; BELLF[12] = 7500;
BELLF[13] = 10000; BELLF[14] = 13000;
// GUI (Peak Performance helpers, own layout)

function gsx(x) ( G_OX + x * G_SC; );
function gsy(y) ( y * G_SC; );
function gclamp(x, a, b) ( min(b, max(a, x)); );

function grspan(qx0, qy0, qx1, qy1, qrad, yc) local(dy, ins) (
  dy = yc < qy0 + qrad ? qy0 + qrad - yc : yc > qy1 - qrad ? yc - (qy1 - qrad) : 0;
  G_RC = max(0, min(1, qrad - dy + 0.5));
  dy = min(qrad, dy);
  ins = qrad - sqrt(max(0, qrad * qrad - dy * dy));
  G_RL = qx0 + ins; G_RR = qx1 - ins;
);

function gspan(lx, rx, j, a) local(lc, rc) (
  lc = ceil(lx); rc = floor(rx);
  rc >= lc ? (
    gfx_a = a; rc > lc ? gfx_rect(lc, j, rc - lc, 1);
    lc - lx > 0 ? ( gfx_a = a * (lc - lx); gfx_rect(lc - 1, j, 1, 1); );
    rx - rc > 0 ? ( gfx_a = a * (rx - rc); gfx_rect(rc, j, 1, 1); );
  ) : rx > lx ? ( gfx_a = a * (rx - lx); gfx_rect(floor(lx), j, 1, 1); );
);

function gfrr(qx0, qy0, qx1, qy1, qrad, cr, cg, cb, a0) local(j) (
  qx0 = floor(qx0 + 0.5); qy0 = floor(qy0 + 0.5); qx1 = floor(qx1 + 0.5); qy1 = floor(qy1 + 0.5);
  qrad = max(0, min(qrad, min(qy1 - qy0, qx1 - qx0) * 0.5));
  gfx_set(cr, cg, cb, a0);
  j = qy0;
  loop(qy1 - qy0,
    grspan(qx0, qy0, qx1, qy1, qrad, j + 0.5);
    G_RC > 0 ? gspan(G_RL, G_RR, j, a0 * G_RC);
    j += 1;
  );
  gfx_a = 1;
);

function gbord(qx0, qy0, qx1, qy1, qrad, t, cr, cg, cb, a0) local(j, ol, orr, oc, il, ir, ic) (
  qx0 = floor(qx0 + 0.5); qy0 = floor(qy0 + 0.5); qx1 = floor(qx1 + 0.5); qy1 = floor(qy1 + 0.5);
  qrad = max(0, min(qrad, min(qy1 - qy0, qx1 - qx0) * 0.5));
  gfx_set(cr, cg, cb, a0);
  j = qy0;
  loop(qy1 - qy0,
    grspan(qx0, qy0, qx1, qy1, qrad, j + 0.5); ol = G_RL; orr = G_RR; oc = G_RC;
    (j + 0.5 > qy0 + t && j + 0.5 < qy1 - t) ? (
