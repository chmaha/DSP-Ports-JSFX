geq(64, 366, 312, 54, G_CDIM);
(ghit(64, 366, 312, 54) || ghit(60, 346, 240, 22)) && G_DRAG === 0 && G_TIPID === 0 ? G_TIPID = 5;
gk(20, 103, 474, 22, 0.5, "BASS", G_D);
