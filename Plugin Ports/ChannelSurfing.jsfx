slider1:pre_algo=1<0,3,1{Clean,Pure,Tape,Tube}>-Saturation In
slider2:pre_drive=0<-18,18,0.1>-Saturation Drive (dB)
slider3:pre_byp=0<0,1,1{Active,Off}>-Saturation Bypass
slider4:hpf_freq=20<20,6000,1>-HPF (Hz)
slider5:hpf_slope=0<0,1,1{12 dB/oct,24 dB/oct}>-HPF Slope
slider6:hpf_q=0<0,1,1{Normal,Bump}>-HPF Q
slider7:lpf_freq=24000<300,24000,1>-LPF (Hz)
slider8:lpf_slope=0<0,1,1{12 dB/oct (Q 0.5),24 dB/oct}>-LPF Slope
slider9:lpf_q=0<0,1,1{Normal,Bump}>-LPF Q
slider10:flt_byp=0<0,1,1{Active,Off}>-Filters Bypass
slider11:flt_post=0<0,1,1{Pre,Post}>-Filters Position
slider12:cc_thr=-18<-30,-0.1,0.1>-Clean Comp Threshold (dB)
slider13:cc_fast=0<0,1,1{Normal,Fast}>-Clean Comp Speed
slider14:cc_byp=0<0,1,1{Active,Off}>-Clean Comp Bypass
slider15:ld_thr=-20<-40,-3,0.1>-Low Dynamic Threshold (dB)
slider16:ld_ratio=0<-10,10,0.1>-Low Dynamic Ratio
slider17:ld_fast=0<0,1,1{Normal,Fast}>-Low Dynamic Speed
slider18:ld_mix=100<0,100,1>-Low Dynamic Mix (%)
slider19:ld_byp=0<0,1,1{Active,Off}>-Low Dynamic Bypass
slider20:eq_bass=0<-15,15,0.1>-EQ Bass (dB)
slider21:eq_bfreq=6500<600,6500,0.1>-EQ Bass Mid Cut (Hz)
slider22:eq_treble=0<-15,15,0.1>-EQ Treble (dB)
slider23:eq_tfreq=3500<3500,8200,1>-EQ Treble Mid Cut (Hz)
slider24:eq_b1f=10<0,14,1{50,100,200,300,400,500,700,900,1.4k,2.4k,3.5k,5k,7.5k,10k,13k}>-EQ Bell 1 Freq
slider25:eq_b1g=0<-12,20,1>-EQ Bell 1 Gain (dB)
slider26:eq_b2f=4<0,14,1{50,100,200,300,400,500,700,900,1.4k,2.4k,3.5k,5k,7.5k,10k,13k}>-EQ Bell 2 Freq
slider27:eq_b2g=0<-12,20,1>-EQ Bell 2 Gain (dB)
slider28:eq_byp=0<0,1,1{Active,Off}>-EQ Bypass
slider29:sc_algo=1<0,1,1{Warm,Punch}>-Style Comp
slider30:sc_in=-18<-18,60,0.1>-Style Comp In (dB)
slider31:sc_mk=0<-6,24,0.1>-Style Comp Makeup (dB)
slider32:sc_mix=100<0,100,0.1>-Style Comp Mix (%)
slider33:sc_byp=0<0,1,1{Active,Off}>-Style Comp Bypass
slider34:sc_pre=0<0,1,1{Post-EQ,Pre-EQ}>-Style Comp Position
slider35:con_algo=0<0,4,1{Clean,Pure,Oxford,Essex,USA}>-Console
slider36:con_drive=0<-18,18,0.1>-Console Drive (dB)
slider37:con_byp=0<0,1,1{Active,Off}>-Console Bypass
slider38:out_algo=0<0,5,1{Clean,Pure,Tape,Tube,Hard Clip,Soft Clip}>-Out Stage
slider39:out_drive=0<-24,24,0.1>-Out Stage Drive (dB)
slider40:out_byp=0<0,1,1{Active,Off}>-Out Stage Bypass
slider41:vol_gain=0<-60,12,0.1>-Output (dB)
slider42:vol_byp=0<0,1,1{Active,Off}>-Output Bypass
slider43:cv_mode=1<0,2,1{Off,Stereo,Mono}>-Channel Variation
slider44:cv_pair=0<0,23,1>-Channel Pair
slider45:tt_fix=1<0,1,1{Off,On}>-Tape Head Bump Fix

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output
options:no_meter

@init

ext_noinit = gfx_ext_retina = 1;

