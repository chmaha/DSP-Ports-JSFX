G_T = (abs(ld_ratio) < 0.01 || ld_byp >= 0.5) ? 0 : 20 * log10(max(0.000001, max(LD_GL, LD_GR) > 1 ? max(LD_GL, LD_GR) : min(LD_GL, LD_GR)));
sprintf(#g_lt, "gain %+.1f dB", G_T);
