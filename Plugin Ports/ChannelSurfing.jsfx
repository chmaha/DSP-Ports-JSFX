  kind === 6 ? ( i === 0 ? "CLEAN" : i === 1 ? "PURE" : i === 2 ? "OXFORD" : i === 3 ? "ESSEX" : "USA" ) :
  kind === 7 ? ( i === 0 ? "CLEAN" : i === 1 ? "PURE" : i === 2 ? "TAPE" : i === 3 ? "TUBE" : i === 4 ? "HARD CLIP" : "SOFT CLIP" ) :
  kind === 8 ? ( i === 0 ? "OFF" : i === 1 ? "STEREO" : "MONO" ) : "";
);

function ghit(x, y, w, h) ( G_MX >= x && G_MX < x + w && G_MY >= y && G_MY < y + h; );

function gk(s, kx, ky, kr, ctr, nm, dim) local(h) (
  h = G_DRAG > 0 ? G_DS === s : (G_MX - kx) * (G_MX - kx) + (G_MY - ky) * (G_MY - ky) <= (kr + 6) * (kr + 6);
  (h && G_DRAG === 0) ? ( G_HS = s; G_HK = 1; s === 21 ? G_TIPID = 3 : s === 23 ? G_TIPID = 4; );
  gknob(kx, ky, kr, gnorm(s), ctr, h, nm, gval(s), dim);
);

function gsegs(s, x, y, w, h, n, kind, dim) local(sw, i, sel, hv, xx, yy, ww, hh, al) (
  sel = floor(slider(s) + 0.5);
  hv = (ghit(x, y, w, h) && G_DRAG === 0) ? floor((G_MX - x) / (w / n)) : -1;
  hv >= 0 ? ( G_HS = s; G_HK = 2; G_HV = hv; );
  al = dim ? 0.6 : 1;
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC);
  gfrr(xx, yy, xx + ww, yy + hh, floor(h * 0.5 * G_SC), 0.10, 0.11, 0.12, 0.9);
  gbord(xx, yy, xx + ww, yy + hh, floor(h * 0.5 * G_SC), max(1, floor(G_SC + 0.5)), 0.62, 0.66, 0.70, 0.35);
  sw = w / n;
  i = 0;
  loop(n,
    i === sel ? (
      xx = floor(gsx(x + i * sw + 2)); yy = floor(gsy(y + 2)); ww = ceil((sw - 4) * G_SC); hh = ceil((h - 4) * G_SC);
      gfrr(xx, yy, xx + ww, yy + hh, floor((h - 4) * 0.5 * G_SC), G_ACR * al, G_ACG * al, G_ACB * al, hv === i ? 1 : 0.92);
      gtext(x + i * sw + sw * 0.5, y + h * 0.5, glab(kind, i), 3, 0.07, 0.08, 0.09, 1, 1);
    ) : (
      gtext(x + i * sw + sw * 0.5, y + h * 0.5, glab(kind, i), 3, 0.86, 0.88, 0.90, hv === i ? 1 : (dim ? 0.62 : 0.78), 1);
    );
    i += 1;
  );
);

function gsel(s, x, y, cols, cw, ch, gx, gy, n, kind, dim) local(i, cx, cy, sel, hv, al, xx, yy, ww, hh) (
  sel = floor(slider(s) + 0.5);
  al = dim ? 0.6 : 1;
  i = 0;
  loop(n,
    cx = x + (i % cols) * (cw + gx); cy = y + floor(i / cols) * (ch + gy);
    hv = ghit(cx, cy, cw, ch) && G_DRAG === 0;
    hv ? ( G_HS = s; G_HK = 2; G_HV = i; );
    xx = floor(gsx(cx)); yy = floor(gsy(cy)); ww = ceil(cw * G_SC); hh = ceil(ch * G_SC);
    i === sel ? (
      gfrr(xx, yy, xx + ww, yy + hh, floor(ch * 0.5 * G_SC), G_ACR * al, G_ACG * al, G_ACB * al, hv ? 1 : 0.92);
      gtext(cx + cw * 0.5, cy + ch * 0.5, glab(kind, i), 3, 0.07, 0.08, 0.09, 1, 1);
    ) : (
      gfrr(xx, yy, xx + ww, yy + hh, floor(ch * 0.5 * G_SC), 0.10, 0.11, 0.12, hv ? 0.98 : 0.85);
      gbord(xx, yy, xx + ww, yy + hh, floor(ch * 0.5 * G_SC), max(1, floor(G_SC + 0.5)), 0.62, 0.66, 0.70, hv ? 0.6 : 0.3);
      gtext(cx + cw * 0.5, cy + ch * 0.5, glab(kind, i), 3, 0.86, 0.88, 0.90, hv ? 1 : (dim ? 0.62 : 0.78), 1);
    );
    i += 1;
  );
);

function gtog(s, x, y, w, h, lb) local(hv) (
  hv = ghit(x, y, w, h) && G_DRAG === 0;
  hv ? ( G_HS = s; G_HK = 3; );
  gbtn(x, y, w, h, lb, slider(s) >= 0.5, hv);
);

function ginbtn(s, x, y, w, h) local(on, hv, xx, yy, ww, hh, rr) (
  on = slider(s) < 0.5;
  hv = ghit(x, y, w, h) && G_DRAG === 0;
  hv ? ( G_HS = s; G_HK = 3; G_TIPID = on ? 1 : 2; );
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC); rr = max(2, floor(3 * G_SC));
  on ? (
    gfrr(xx, yy, xx + ww, yy + hh, rr, G_ACR, G_ACG, G_ACB, hv ? 1 : 0.92);
    gtext(x + w * 0.5, y + h * 0.5, "IN", 3, 0.07, 0.08, 0.09, 1, 1);
  ) : (
    gfrr(xx, yy, xx + ww, yy + hh, rr, 0.07, 0.075, 0.08, 1);
    gbord(xx, yy, xx + ww, yy + hh, rr, max(1, floor(G_SC + 0.5)), 0.62, 0.66, 0.70, hv ? 0.75 : 0.45);
    gtext(x + w * 0.5, y + h * 0.5, "IN", 3, 0.62, 0.64, 0.66, 1, 1);
  );
);

function gcard_end() local(xx, yy) (
  G_CDIM ? (
    xx = floor(gsx(G_CX)); yy = floor(gsy(G_CY + 32));
    gfrr(xx + 1, yy, xx + ceil(G_CW * G_SC) - 1, floor(gsy(G_CY + G_CH)) - 1, floor(8 * G_SC), 0.165, 0.17, 0.18, 0.55);
  );
  G_CDIM = 0;
);

function gcard2(k, x, y, w, h, title) local(s, on, xx, yy) (
  gcard_end();
  gaccent(k);
  gcard(x, y, w, h, 8, 0.96, 0.42);
  s = G_BYS[k];
  on = slider(s) < 0.5;
  xx = floor(gsx(x + 12)); yy = floor(gsy(y + 11));
  gfrr(xx, yy, xx + max(2, floor(4 * G_SC)), yy + ceil(14 * G_SC), floor(2 * G_SC), G_ACR, G_ACG, G_ACB, on ? 1 : 0.35);
  gtext(x + 23, y + 18, title, 1, 0.93, 0.95, 0.96, on ? 1 : 0.62, 0);
  k < 8 ? ginbtn(s, x + w - 42, y + 9, 30, 18);
  G_CX = x; G_CY = y; G_CW = w; G_CH = h; G_CDIM = !on;
  0;
);

function gleds(x, y, w, v, kind, lab) local(i, th, cx, cr, cg, cb, sp, r) (
  sp = w / 8;
  r = 3.4 * G_SC;
  i = 0;
  loop(8,
    th = kind ? (i === 0 ? 0.1 : i === 1 ? 0.5 : i === 2 ? 1 : i === 3 ? 2 : i === 4 ? 3 : i === 5 ? 5 : i === 6 ? 7 : 10) : i + 1;
    (kind ? th <= 0.1 : th <= 2) ? ( cr = 0.36; cg = 0.92; cb = 0.48; ) :
    (kind ? th <= 5 : th <= 6) ? ( cr = 1; cg = 0.82; cb = 0.30; ) : ( cr = 1; cg = 0.36; cb = 0.34; );
    cx = gsx(x + sp * (i + 0.5));
    v >= th ? (
      gfx_set(cr, cg, cb, 0.22); gfx_circle(cx, gsy(y), r * 2, 1, 1);
      gfx_set(cr, cg, cb, 1); gfx_circle(cx, gsy(y), r, 1, 1);
    ) : (
      gfx_set(0.07, 0.075, 0.08, 1); gfx_circle(cx, gsy(y), r, 1, 1);
      gfx_set(cr * 0.35, cg * 0.35, cb * 0.35, 1); gfx_circle(cx, gsy(y), r - max(1, G_SC), 1, 1);
    );
    lab && (i === 0 || i === 2 || i === 4 || (kind ? i === 6 : i === 7)) ? (
      kind ? sprintf(#g_lt, th < 1 ? "%.1f" : "%d", th) : sprintf(#g_lt, "%d", th);
      gtext(x + sp * (i + 0.5), y + 14, #g_lt, 4, 0.66, 0.70, 0.74, 1, 1);
    );
    i += 1;
  );
);

function gmdb(v) ( v > 0.000001 ? 20 * log10(v) : -120; );
function gmy(d, y0, y1) ( y0 + (y1 - y0) * (1 - gclamp((d + 60) / 60, 0, 1)); );

function gmbar(x, w, y0, y1, v) local(d, yt, xx, ww, yy, ye, t, r0, g0, b0, r1, g1, b1, hh) (
  xx = floor(gsx(x)); ww = max(2, ceil(w * G_SC));
  yy = floor(gsy(y0)); ye = floor(gsy(y1));
  gfx_set(0.06, 0.065, 0.07, 1); gfx_rect(xx, yy, ww, ye - yy);
  d = gmdb(v);
  d > -60 ? (
    yt = floor(gsy(gmy(d, y0, y1)));
    hh = ye - yt;
    t = gclamp((d + 60) / 60, 0, 1);
    t < 0.5 ? ( r0 = 0.36 + t * 2 * 0.64; g0 = 0.92 - t * 2 * 0.1; b0 = 0.48 - t * 2 * 0.18; ) :
              ( r0 = 1; g0 = 0.82 - (t - 0.5) * 2 * 0.46; b0 = 0.30 + (t - 0.5) * 2 * 0.04; );
    r1 = 0.36; g1 = 0.92; b1 = 0.48;
    hh > 0 ? gfx_gradrect(xx, yt, ww, hh, r0, g0, b0, 1, 0, 0, 0, 0, (r1 - r0) / hh, (g1 - g0) / hh, (b1 - b0) / hh, 0);
  );
);

function gmeter(x, lx, lal, vl, vr, ttl) local(d, i) (
  gtext(x + 9, 97, ttl, 3, 0.80, 0.84, 0.88, 1, 1);
  gmbar(x, 8, 106, 596, vl);
  gmbar(x + 10, 8, 106, 596, vr);
  i = 0;
  loop(7,
    d = i === 0 ? -3 : i === 1 ? -6 : i === 2 ? -12 : i === 3 ? -18 : i === 4 ? -24 : i === 5 ? -32 : -48;
    sprintf(#g_lt, "%d", d);
    gtext(lx, gmy(d, 106, 596), #g_lt, 4, 0.62, 0.66, 0.70, 1, lal);
    i += 1;
  );
);

function gbqm(n0, n1, n2, d1, d2, w) local(c1, s1, c2, s2, nr, ni, dr, di, dd) (
  c1 = cos(w); s1 = sin(w); c2 = cos(2 * w); s2 = sin(2 * w);
  nr = n0 + n1 * c1 + n2 * c2; ni = -(n1 * s1 + n2 * s2);
  dr = 1 + d1 * c1 + d2 * c2; di = -(d1 * s1 + d2 * s2);
  dd = dr * dr + di * di;
  G_BR = (nr * dr + ni * di) / dd; G_BI = (ni * dr - nr * di) / dd;
);

function geq(x, y, w, h, dim) local(n, i, f, wv, br, bi, tr, ti, re, im, m, d, px, py, lx, ly, y0, xx, yy, ww, hh) (
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC);
  gfrr(xx, yy, xx + ww, yy + hh, floor(5 * G_SC), 0.075, 0.08, 0.085, 1);
  gfx_set(0.62, 0.66, 0.70, 0.12);
  i = 0;
  loop(9,
    f = i === 0 ? 50 : i === 1 ? 100 : i === 2 ? 200 : i === 3 ? 500 : i === 4 ? 1000 : i === 5 ? 2000 : i === 6 ? 5000 : i === 7 ? 10000 : 20000;
    px = floor(gsx(x + w * log(f / 20) / log(1000)));
    gfx_line(px, yy + 1, px, yy + hh - 2);
    i += 1;
  );
  y0 = gsy(y + h * 0.5);
  gfx_set(0.62, 0.66, 0.70, 0.28); gfx_line(xx + 1, floor(y0), xx + ww - 2, floor(y0));
  n = min(ww - 2, G_EQN);
  i = 0;
  loop(n + 1,
    f = 20 * pow(1000, i / n);
    wv = 2 * $pi * f / srate;
    m = 1;
    !dim && wv < $pi ? (
      gbqm(L.s_eq.bx.b2, L.s_eq.bx.b3, L.s_eq.bx.b4, L.s_eq.bx.b5, L.s_eq.bx.b6, 2 * wv); br = G_BR; bi = G_BI;
      gbqm(L.s_eq.bx.t2, L.s_eq.bx.t3, L.s_eq.bx.t4, L.s_eq.bx.t5, L.s_eq.bx.t6, 2 * wv); tr = G_BR; ti = G_BI;
      re = L.s_eq.bx.bgl * br + L.s_eq.bx.tgl * (1 - tr);
      im = L.s_eq.bx.bgl * bi - L.s_eq.bx.tgl * ti;
      m = sqrt(re * re + im * im);
      gbqm(L.s_eq.b1.c0, L.s_eq.b1.c1, L.s_eq.b1.c2, L.s_eq.b1.c3, L.s_eq.b1.c4, wv); m *= sqrt(G_BR * G_BR + G_BI * G_BI);
      gbqm(L.s_eq.b2.c0, L.s_eq.b2.c1, L.s_eq.b2.c2, L.s_eq.b2.c3, L.s_eq.b2.c4, wv); m *= sqrt(G_BR * G_BR + G_BI * G_BI);
    );
    G_EQD[i] = gclamp(20 * log10(max(m, 0.00001)), -16, 16);
    i += 1;
  );
  i = 0;
  loop(n + 1,
    px = floor(xx + 1 + ((ww - 2) * i) / n + 0.5);
    py = gsy(y + 2 + (h - 4) * (0.5 - G_EQD[i] / 32));
    i === 0 ? ly = py;
    gfx_set(G_ACR, G_ACG, G_ACB, dim ? 0.07 : 0.15);
    py < y0 ? gfx_rect(px, ceil(py), 1, max(0, floor(y0) - ceil(py))) : gfx_rect(px, floor(y0), 1, max(0, floor(py) - floor(y0)));
    lx = min(py, ly) - 0.8 * max(1, G_SC); f = max(py, ly) + 0.8 * max(1, G_SC);
    d = floor(lx);
    while (d < f) (
      m = min(d + 1, f) - max(d, lx);
      m > 0 ? ( gfx_set(G_ACR, G_ACG, G_ACB, (dim ? 0.45 : 1) * min(1, m)); gfx_rect(px, d, 1, 1); );
      d += 1;
    );
    ly = py;
    i += 1;
  );
);

function gchain() local(n, i, k, x, cw, al, xx, yy, ww, hh, hv, on) (
  n = 0;
  G_SEQ[n] = 0; n += 1;
  flt_post < 0.5 ? ( G_SEQ[n] = 1; n += 1; );
  G_SEQ[n] = 2; n += 1;
  G_SEQ[n] = 3; n += 1;
  sc_pre >= 0.5 ? ( G_SEQ[n] = 5; n += 1; );
  G_SEQ[n] = 4; n += 1;
  sc_pre < 0.5 ? ( G_SEQ[n] = 5; n += 1; );
  G_SEQ[n] = 6; n += 1;
  G_SEQ[n] = 7; n += 1;
  flt_post >= 0.5 ? ( G_SEQ[n] = 1; n += 1; );
  G_SEQ[n] = 8; n += 1;
  gtext(66, 69, "IN", 3, 0.80, 0.84, 0.88, 1, 1);
  gtext(999, 69, "OUT", 3, 0.80, 0.84, 0.88, 1, 1);
  cw = (888 - 8 * 14) / 9;
  i = 0;
  loop(n,
    k = G_SEQ[i];
    x = 86 + i * (cw + 14);
    gaccent(k);
    on = slider(G_BYS[k]) < 0.5;
    hv = ghit(x, 58, cw, 22) && G_DRAG === 0;
    hv ? ( G_HS = G_BYS[k]; G_HK = 3; G_TIPID = on ? 1 : 2; );
    xx = floor(gsx(x)); yy = floor(gsy(58)); ww = ceil(cw * G_SC); hh = ceil(22 * G_SC);
    on ? (
      gfrr(xx, yy, xx + ww, yy + hh, floor(11 * G_SC), G_ACR, G_ACG, G_ACB, hv ? 1 : 0.88);
    ) : (
      gfrr(xx, yy, xx + ww, yy + hh, floor(11 * G_SC), 0.10, 0.11, 0.12, 0.9);
      gbord(xx, yy, xx + ww, yy + hh, floor(11 * G_SC), max(1, floor(G_SC + 0.5)), G_ACR, G_ACG, G_ACB, hv ? 0.8 : 0.45);
    );
    gtext(x + cw * 0.5, 69, k === 0 ? "SATURATION" : k === 1 ? "FILTERS" : k === 2 ? "CLEAN COMP" : k === 3 ? "LOW DYN" :
          k === 4 ? "EQ" : k === 5 ? "STYLE COMP" : k === 6 ? "CONSOLE" : k === 7 ? "OUT STAGE" : "OUTPUT",
          3, on ? 0.07 : 0.70, on ? 0.08 : 0.72, on ? 0.09 : 0.75, 1, 1);
    i < n - 1 ? (
      gfx_set(0.62, 0.66, 0.70, 0.7);
      xx = gsx(x + cw + 4); yy = gsy(69);
      gfx_triangle(xx, yy - 4 * G_SC, xx, yy + 4 * G_SC, xx + 6 * G_SC, yy);
    );
    i += 1;
  );
  gfx_set(0.62, 0.66, 0.70, 0.7);
  xx = gsx(76); yy = gsy(69);
  gfx_triangle(xx, yy - 4 * G_SC, xx, yy + 4 * G_SC, xx + 6 * G_SC, yy);
  xx = gsx(86 + 9 * (cw + 14) - 10);
  gfx_triangle(xx, yy - 4 * G_SC, xx, yy + 4 * G_SC, xx + 6 * G_SC, yy);
);

function gtip_text(id) (
  id === 1 ? "Section in circuit - click to bypass" :
  id === 2 ? "Section bypassed - click to switch in" :
  id === 3 ? sprintf(#g_tip, "Bass Mid Cut: pulls the bass band's top edge down from 6.5 kHz to 600 Hz, scooping the low mids (0 = no cut). Now %d Hz", floor(eq_bfreq + 0.5)) :
  id === 5 ? "Even with every knob at 0 this Baxandall adds a gentle lift (about +0.9 dB around 2 kHz, and a little near 20 kHz): part of its colour." :
  id === 4 ? sprintf(#g_tip, "Treble Mid Cut: pushes the treble band's bottom edge up from 3.5 kHz to 8.2 kHz, scooping the upper mids (0 = no cut). Now %d Hz", floor(eq_tfreq + 0.5)) : "";
);

function gtip() local(tw, th, pw, ph, px, py) (
  (G_TIPID !== G_TLAST || G_MD || G_DRAG > 0 || G_WHEEL !== 0) ? ( G_TLAST = G_TIPID; G_TT0 = G_NOW; );
  (G_TIPID > 0 && !G_MD && G_DRAG === 0 && G_NOW - G_TT0 >= 0.5) ? (
    gfx_setfont(4);
    gfx_measurestr(gtip_text(G_TIPID), tw, th);
    pw = tw + floor(16 * G_SC); ph = th + floor(10 * G_SC);
    px = mouse_x + floor(14 * G_SC); py = mouse_y + floor(20 * G_SC);
    px + pw > gfx_w - 2 ? px = max(2, gfx_w - 2 - pw);
    py + ph > gfx_h - 2 ? py = max(2, mouse_y - floor(8 * G_SC) - ph);
    gfrr(px, py, px + pw, py + ph, floor(5 * G_SC), 0.06, 0.065, 0.07, 0.97);
    gbord(px, py, px + pw, py + ph, floor(5 * G_SC), max(1, floor(G_SC + 0.5)), 0.62, 0.66, 0.70, 0.55);
    gfx_set(0.93, 0.95, 0.96, 1);
    gfx_x = px + floor(8 * G_SC); gfx_y = py + floor(5 * G_SC);
    gfx_drawstr(gtip_text(G_TIPID));
  );
);

last_srate = srate;
rate_setup();
L.ch_reset_all(); R.ch_reset_all();
L.ch_prepare(0); R.ch_prepare(1);
params_snapshot();
MT_INL = MT_INR = MT_OUTL = MT_OUTR = 0;
MT_N = 0;

@slider

last_srate != srate ? (
  last_srate = srate;
  rate_setup();
  L.ch_prepare(0); R.ch_prepare(1);
  MT_INL = MT_INR = MT_OUTL = MT_OUTR = 0;
  MT_N = 0;
);
params_snapshot();

@block

params_snapshot();
MT_N > 0 ? (
  GR_CCL = L.s_cc.dv_grdb(); GR_CCR = R.s_cc.dv_grdb();
  GR_SCL = QSC_ALG < 0.5 ? L.s_sc.cl.cl_grdb() : L.s_sc.dv.dv_grdb();
  GR_SCR = QSC_ALG < 0.5 ? R.s_sc.cl.cl_grdb() : R.s_sc.dv.dv_grdb();
  GR_OSL = max(-100, log10(sqrt(L.oso / MT_N) + 0.0000000001) * 20) - max(-100, log10(sqrt(L.osi / MT_N) + 0.0000000001) * 20);
  GR_OSR = max(-100, log10(sqrt(R.oso / MT_N) + 0.0000000001) * 20) - max(-100, log10(sqrt(R.osi / MT_N) + 0.0000000001) * 20);
  LD_GL = L.s_ld.sg; LD_GR = R.s_ld.sg;
  MT_PINL = MT_INL; MT_PINR = MT_INR; MT_POUTL = MT_OUTL; MT_POUTR = MT_OUTR;
);
L.osi = L.oso = R.osi = R.oso = 0;
MT_N = 0;

@sample

MT_N += 1;
mt_a = abs(spl0); MT_INL = mt_a > MT_INL ? mt_a : MT_INL * MT_PK;
mt_a = abs(spl1); MT_INR = mt_a > MT_INR ? mt_a : MT_INR * MT_PK;
spl0 = L.ch_proc(spl0);
spl1 = R.ch_proc(spl1);
mt_a = abs(spl0); MT_OUTL = mt_a > MT_OUTL ? mt_a : MT_OUTL * MT_PK;
mt_a = abs(spl1); MT_OUTR = mt_a > MT_OUTR ? mt_a : MT_OUTR * MT_PK;

@gfx 1060 610

G_NOW = time_precise();
G_WHEEL = mouse_wheel; mouse_wheel = 0;
G_SC = max(0.45, min(gfx_w / 1060, gfx_h / 610));
G_OX = floor((gfx_w - 1060 * G_SC) * 0.5);
G_SC !== G_FSC ? (
  G_FSC = G_SC;
  gfx_setfont(1, "Arial", 14 * G_SC, 'b');
  gfx_setfont(2, "Arial", 13 * G_SC);
  gfx_setfont(3, "Arial", 12 * G_SC, 'b');
  gfx_setfont(4, "Arial", 12 * G_SC);
  gfx_setfont(5, "Arial", 15 * G_SC, 'b');
  gfx_setfont(6, "Georgia", 24 * G_SC, 'bi');
);
G_BGR = 0.115; G_BGG = 0.12; G_BGB = 0.125;
G_MD = mouse_cap & 1;
G_PRESS = G_MD && !G_LMD;
