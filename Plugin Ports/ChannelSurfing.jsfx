gfx_set(0.86, 0.88, 0.90, G_HPR ? 1 : 0.6);
G_XX = gsx(1028);
gfx_triangle(G_XX + 4 * G_SC, G_YY, G_XX - 3 * G_SC, G_YY - 5 * G_SC, G_XX - 3 * G_SC, G_YY + 5 * G_SC);

