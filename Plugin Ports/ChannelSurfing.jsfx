G_CVM === 0 ? strcpy(#g_cv, "--") : G_CVM === 1 ? sprintf(#g_cv, "%d | %d", G_CVP * 2 + 1, G_CVP * 2 + 2) : sprintf(#g_cv, "%d | %d", G_CVP * 2 + 1, G_CVP * 2 + 1);
gtext(992, 25, #g_cv, 5, G_CVM === 0 ? 0.45 : G_CVM === 1 ? 0.45 : 1, G_CVM === 0 ? 0.5 : G_CVM === 1 ? 0.95 : 0.84, G_CVM === 0 ? 0.5 : G_CVM === 1 ? 0.55 : 0.36, 1, 1);
G_HPL = ghit(944, 12, 22, 26) && G_DRAG === 0;
G_HPR = ghit(1018, 12, 22, 26) && G_DRAG === 0;
G_HPL ? ( G_HS = 44; G_HK = 2; G_HV = max(0, G_CVP - 1); );
G_HPR ? ( G_HS = 44; G_HK = 2; G_HV = min(23, G_CVP + 1); );
