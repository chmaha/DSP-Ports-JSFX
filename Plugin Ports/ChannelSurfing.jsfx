gtext(967, 518, #g_lt, 4, G_PK > -0.1 ? 1 : 0.80, G_PK > -0.1 ? 0.4 : 0.84, G_PK > -0.1 ? 0.4 : 0.88, 1, 1);
G_PK = gmdb(MT_POUTR); G_PK > -99 ? sprintf(#g_lt, "R %.1f", G_PK) : strcpy(#g_lt, "R -inf");
gtext(967, 536, #g_lt, 4, G_PK > -0.1 ? 1 : 0.80, G_PK > -0.1 ? 0.4 : 0.84, G_PK > -0.1 ? 0.4 : 0.88, 1, 1);

G_PRESS ? (
  G_HK === 1 ? (
    (G_NOW - G_LCLK < 0.3 && G_LCLKI === G_HS) ? (
      slider(G_HS) = G_DEF[G_HS]; gauto(G_HS, 1); G_DRAG = 0;
    ) : (
      G_DRAG = 1; G_DS = G_HS; G_DY = mouse_y; G_DV = gnorm(G_HS); G_MOVED = 0;
    );
    G_LCLK = G_NOW; G_LCLKI = G_HS;
  ) : G_HK === 2 ? (
    slider(G_HS) = G_HV; gauto(G_HS, 1);
  ) : G_HK === 3 ? (
    slider(G_HS) = slider(G_HS) >= 0.5 ? 0 : 1; gauto(G_HS, 1);
  );
);
G_DRAG > 0 && G_MD ? (
  abs(mouse_y - G_DY) > 2 ? G_MOVED = 1;
  G_MOVED ? (
    gset_norm(G_DS, G_DV + (G_DY - mouse_y) * ((mouse_cap & 4) ? 0.0006 : (G_DS === 24 || G_DS === 26) ? 0.008 : 0.004) / G_SC);
    mouse_cap |= 65536;
  );
);
(G_REL && G_DRAG > 0) ? (
  gauto(G_DS, 1);
  G_DRAG = 0;
);
(G_WHEEL !== 0 && G_DRAG === 0) ? (
  G_HK === 1 ? (
    gset_norm(G_HS, gnorm(G_HS) + (G_WHEEL > 0 ? 1 : -1) * ((G_HS === 24 || G_HS === 26) ? 1 / 14 : (mouse_cap & 4) ? 0.002 : 0.01));
    gauto(G_HS, 1);
  ) : G_HS === 44 ? (
    cv_pair = gclamp(floor(cv_pair + 0.5) + (G_WHEEL > 0 ? 1 : -1), 0, 23); gauto(44, 1);
  );
);
gtip();
G_LMD = G_MD;
