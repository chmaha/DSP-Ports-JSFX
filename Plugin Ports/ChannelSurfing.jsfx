function gnorm(s) local(u) (
  u = (slider(s) - G_MIN[s]) / (G_MAX[s] - G_MIN[s]);
  s === 21 ? u = 1 - u;
  G_SKW[s] !== 1 ? u = pow(max(0, u), G_SKW[s]);
  gclamp(u, 0, 1);
);

function gset_norm(s, u) local(v, st) (
  u = gclamp(u, 0, 1);
  G_SKW[s] !== 1 ? u = pow(u, 1 / G_SKW[s]);
  s === 21 ? u = 1 - u;
  v = G_MIN[s] + (G_MAX[s] - G_MIN[s]) * u;
  st = G_STP[s];
  st > 0 ? v = floor(v / st + 0.5) * st;
  st > 0 && st < 1 ? v = floor(v * 10 + 0.5) / 10;
  v = gclamp(v, G_MIN[s], G_MAX[s]);
  v !== slider(s) ? ( slider(s) = v; gauto(s, 0); );
);

function gbell(i) (
  i < 0.5 ? "50 Hz" : i < 1.5 ? "100 Hz" : i < 2.5 ? "200 Hz" : i < 3.5 ? "300 Hz" : i < 4.5 ? "400 Hz" :
  i < 5.5 ? "500 Hz" : i < 6.5 ? "700 Hz" : i < 7.5 ? "900 Hz" : i < 8.5 ? "1.4 kHz" : i < 9.5 ? "2.4 kHz" :
  i < 10.5 ? "3.5 kHz" : i < 11.5 ? "5 kHz" : i < 12.5 ? "7.5 kHz" : i < 13.5 ? "10 kHz" : "13 kHz";
);

function gval(s) local(v) (
  v = slider(s);
  (s === 2 || s === 12 || s === 15 || s === 20 || s === 22 || s === 30 || s === 31 || s === 36 || s === 39 || s === 41) ? (
    sprintf(#g_vs, "%.1f dB", v);
  ) : (s === 25 || s === 27) ? (
    sprintf(#g_vs, "%+d dB", floor(v + 0.5));
  ) : (s === 4 || s === 7) ? (
    v >= 1000 ? sprintf(#g_vs, "%.2f kHz", v / 1000) : sprintf(#g_vs, "%d Hz", floor(v + 0.5));
  ) : s === 21 ? (
    sprintf(#g_vs, "%.1f", (6500 - v) / 590);
