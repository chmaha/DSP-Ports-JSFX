  ) : (s === 24 || s === 26) ? (
    strcpy(#g_vs, gbell(v));
  ) : s === 16 ? (
    v < -0.1 ? sprintf(#g_vs, "EXPAND %.1f", -v) : v > 0.1 ? sprintf(#g_vs, "LIFT %.1f", v) : strcpy(#g_vs, "OFF");
  ) : s === 18 ? (
    sprintf(#g_vs, "%d%%", floor(v + 0.5));
