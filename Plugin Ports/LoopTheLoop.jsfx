slider1:p_maxdel=0<0,1,0.001>-Max Del
slider2:p_reset=0<0,1,0.001>-Reset (unused)
slider3:p_rec=0<0,1,0.001>-Record
slider4:p_inmix=1<0,1,0.001>-In Mix
slider5:p_inpan=0.5<0,1,0.001>-In Pan
slider6:p_fb=1<0,1,0.001>-Feedback
slider7:p_outmix=1<0,1,0.001>-Out Mix
slider8:p_clear=0<0,1,0.001>-Clear Loop

in_pin:Left input
in_pin:Right input
out_pin:Left output
out_pin:Right output
options:no_meter maxmem=33554432

@init

ext_noinit = gfx_ext_retina = 1;
ext_nodenorm = 1;

function itrunc(x) ( x < 0 ? ceil(x) : floor(x); );

EVQ = 0;
GOV = 1024;
LBUF = 4096;
LCAP = 33554432 - LBUF;

lx_seed = 1;
lx_status = 0;
lx_bufmax = 882000;
lx_fmax = 441000;
lx_fpos = lx_flen = lx_hw = 0;
lx_recreq = 0;
lx_old2 = 0;
lx_modwhl = 1;
lx_oldc = p_clear;

function lx_update()
(
  (p_rec > 0.5 && lx_old2 < 0.5) ? (
    lx_recreq == 0 ? lx_recreq = 1;
    lx_old2 = p_rec;
  );
  (p_rec < 0.5 && lx_old2 > 0.5) ? (
    lx_recreq == 1 ? lx_recreq = 0;
    lx_old2 = p_rec;
  );
  lx_imix = (2 * p_inmix) * p_inmix;
  lx_ipan = p_inpan;
  lx_fbk = p_fb;
  lx_omix = (0.000030517578125 * p_outmix) * p_outmix;
);

function lx_target()
(
  lx_tgtf = min(itrunc(srate) * itrunc(10.5 + (190 * p_maxdel)), LCAP);
);

lx_update();

@slider

last_srate != srate ? (
  last_srate = srate;
  meter_decay = 0.001 ^ (1 / (0.4 * srate));
);

@block

abs(p_clear - lx_oldc) > 0.10000000149011612 ? (
  lx_oldc = p_clear;
  lx_status = lx_fpos = lx_flen = lx_hw = 0;
  lx_recreq = 0;
);
lx_target();
lx_pend = lx_tgtf != lx_fmax;
(lx_pend && lx_status == 0) ? (
  lx_fmax = lx_tgtf;
  lx_bufmax = 2 * lx_fmax;
  lx_status = lx_fpos = lx_flen = lx_hw = 0;
  lx_pend = 0;
);
lx_guitog ? ( lx_recreq = lx_recreq ? 0 : 1; lx_guitog = 0; );
lx_update();
lx_nev = 0;
while (midirecv(lx_ofs, lx_m1, lx_m2, lx_m3)) (
  (lx_m1 & 0xF0) == 0xB0 ? (
    lx_m2 == 1 ? (
      lx_modwhl = 1 - (0.007873999886214733 * lx_m3);
    ) : lx_m2 == 64 ? (
      (lx_m3 > 63 && lx_nev < 120) ? ( EVQ[2 * lx_nev] = lx_ofs; EVQ[2 * lx_nev + 1] = 1; lx_nev += 1; );
    ) : (lx_m2 == 66 || lx_m2 == 67) ? (
      (lx_m3 > 63 && lx_nev < 120) ? ( EVQ[2 * lx_nev] = lx_ofs; EVQ[2 * lx_nev + 1] = 2; lx_nev += 1; );
    );
  );
  midisend(lx_ofs, lx_m1, lx_m2, lx_m3);
);
lx_fb = lx_fbk * lx_modwhl;
lx_d0 = 0;
lx_ei = 0;
lx_enext = lx_nev > 0 ? EVQ[0] : 1000000000;
lx_sc = 0;

@sample

lx_i0 = spl0; lx_i1 = spl1;
(
  while (lx_sc >= lx_enext) (
    EVQ[2 * lx_ei + 1] == 2 ? ( lx_fpos = 0; ) : ( lx_recreq = lx_recreq ? 0 : 1; );
    lx_ei += 1;
    lx_enext = lx_ei < lx_nev ? EVQ[2 * lx_ei] : 1000000000;
  );
  lx_l = spl0;
  lx_r = spl1;
  lx_r *= lx_imix * lx_ipan;
  lx_l *= lx_imix - (lx_ipan * lx_imix);
  (lx_recreq == 1 && lx_status == 0) ? lx_status = 1;
  (lx_recreq == 0 && lx_status == 1) ? lx_status = 2;
  lx_status ? (
    lx_d1 = lx_d0;
    lx_seed = (lx_seed * 214013) + 2531011;
    lx_seed -= floor(lx_seed / 4294967296) * 4294967296;
    lx_d0 = 0.000060999998822808266 * ((floor(lx_seed / 65536) & 32767) - 16384);
    lx_fpos < lx_hw ? (
      lx_w = LBUF[lx_fpos];
      lx_lh = floor(lx_w / 65536);
      lx_dl = lx_fb * (lx_lh - 32768);
      lx_dr = lx_fb * ((lx_w - (lx_lh * 65536)) - 32768);
    ) : (
      lx_dl = lx_dr = 0;
    );
    lx_recreq ? (
      lx_x = floor(((((32768 * lx_l) + lx_dl) + lx_d0) - lx_d1) + 100000.5) - 100000;
      lx_xl = lx_x > 32767 ? 32767 : lx_x < -32768 ? -32768 : lx_x;
      lx_x = floor(((((32768 * lx_r) + lx_dr) - lx_d0) + lx_d1) + 100000.5) - 100000;
      lx_xr = lx_x > 32767 ? 32767 : lx_x < -32768 ? -32768 : lx_x;
      LBUF[lx_fpos] = ((lx_xl + 32768) * 65536) + (lx_xr + 32768);
      lx_fpos >= lx_hw ? lx_hw = lx_fpos + 1;
    );
    lx_fpos += 1;
    lx_fpos >= lx_fmax ? (
      lx_flen = lx_fmax;
      lx_fpos -= lx_flen;
      lx_status = 2;
    ) : (
      lx_status == 1 ? ( lx_flen = lx_fpos; ) : ( lx_fpos >= lx_flen ? lx_fpos -= lx_flen; );
    );
    lx_l += lx_omix * lx_dl;
    lx_r += lx_omix * lx_dr;
  );
  spl0 = lx_l;
  spl1 = lx_r;
  lx_sc += 1;
);

lx_m = max(abs(lx_i0), abs(lx_i1));
lx_m > ipk ? ipk = lx_m : ipk *= meter_decay;
lx_m = max(abs(spl0), abs(spl1));
lx_m > opk ? opk = lx_m : opk *= meter_decay;

@gfx 860 380

DW = 860;
DH = 380;
scale = max(0.5, min(gfx_w / DW, gfx_h / DH));
ox = floor((gfx_w - DW*scale) * 0.5);
oy = 0;

MARGIN = 14*scale;
CW = 92*scale;
KR = 28*scale;
PANEL_H = 128*scale;

function automate(s, end_touch)
(
<?
  max_sliders > 8 ? printf("slider_automate(2^(s-1), end_touch);") :
    printf("s == 1 ? slider_automate(p_maxdel, end_touch) : s == 2 ? slider_automate(p_reset, end_touch) : s == 3 ? slider_automate(p_rec, end_touch) : s == 4 ? slider_automate(p_inmix, end_touch) : s == 5 ? slider_automate(p_inpan, end_touch) : s == 6 ? slider_automate(p_fb, end_touch) : s == 7 ? slider_automate(p_outmix, end_touch) : s == 8 ? slider_automate(p_clear, end_touch) :");
?> 0;
);
function set_slider(s, v) ( slider(s) = v; automate(s, 0); automate(s, 1); );
function hit_circle(mx, my, cx, cy, rad) ( sqr(mx - cx) + sqr(my - cy) <= sqr(rad); );
function hit_rect(mx, my, x, y, w, h) ( mx >= x && mx <= x+w && my >= y && my <= y+h; );
function g_trunc(x) ( x < 0 ? ceil(x) : floor(x); );

function set_norm(s, v)
local(old)
(
  old = slider(s);
  slider(s) = floor(v*1000 + 0.5) / 1000;
  slider(s) !== old ? automate(s, 0);
);

function upper(str)
local(i, c)
(
  i = 0;
  loop(strlen(str),
    c = str_getchar(str, i);
    (c >= 97 && c <= 122) ? str_setchar(str, i, c - 32);
    i += 1;
  );
  str;
);

function draw_knob(cx, cy, rad, pos, cr, cg, cb, valtext, name)
local(ang0, ang1, ang, i, tx, ty)
(
  ang0 = -2.35619;
  ang1 =  2.35619;
  gfx_set(0.05, 0.05, 0.06, 1);
  gfx_circle(cx, cy, rad + 2*scale, 1, 1);
  gfx_set(cr*0.55, cg*0.55, cb*0.55, 1);
  gfx_circle(cx, cy, rad, 1, 1);
  gfx_set(cr, cg, cb, 1);
  gfx_circle(cx, cy, rad*0.72, 1, 1);
  gfx_set(1, 1, 1, 0.18);
  gfx_circle(cx - rad*0.28, cy - rad*0.28, rad*0.42, 1, 1);
  i = 0;
  loop(9,
    ang = ang0 + (ang1 - ang0) * (i / 8);
    gfx_set(0.85, 0.85, 0.85, 0.7);
    gfx_line(cx + sin(ang)*rad*0.82, cy - cos(ang)*rad*0.82, cx + sin(ang)*rad*0.98, cy - cos(ang)*rad*0.98, 1);
    i += 1;
  );
  ang = ang0 + (ang1 - ang0) * pos;
  gfx_set(0.05, 0.05, 0.05, 1);
  gfx_line(cx, cy, cx + sin(ang)*rad*0.85, cy - cos(ang)*rad*0.85, 1);
  gfx_setfont(1, "Arial", 14*scale);
  gfx_set(0.85, 0.85, 0.85, 1);
  gfx_measurestr(valtext, tx, ty);
  gfx_x = cx - tx*0.5; gfx_y = cy - rad - 18*scale;
  gfx_drawstr(valtext);
  gfx_set(0.8, 0.8, 0.82, 1);
  gfx_measurestr(name, tx, ty);
  gfx_x = cx - tx*0.5; gfx_y = cy + rad + 7*scale;
  gfx_drawstr(name);
);

function lcd_touch(s) ( lcd_sl = s; lcd_t = time_precise(); );

function row_begin(y, nk, ns)
(
  rx = ox + (DW*scale - (nk*CW + ns*8*scale + (ns - 1)*10*scale)) * 0.5;
  ry = oy + y;
);

function sec(nk, title, cr, cg, cb)
local(w, tw, th)
(
  w = nk*CW + 8*scale;
  gfx_set(0.035, 0.035, 0.04, 1);
  gfx_rect(rx - scale, ry - scale, w + 2*scale, PANEL_H + 2*scale, 1);
  gfx_set(0.125, 0.125, 0.14, 1);
  gfx_rect(rx, ry, w, PANEL_H, 1);
  gfx_set(cr, cg, cb, 0.8);
  gfx_rect(rx, ry, w, max(1, 2*scale), 1);
  gfx_setfont(1, "Arial", 12*scale, 'b');
  gfx_set(cr*0.75 + 0.15, cg*0.75 + 0.15, cb*0.75 + 0.15, 1);
  gfx_measurestr(title, tw, th);
  gfx_x = rx + (w - tw)*0.5; gfx_y = ry + 5*scale;
  gfx_drawstr(title);
  k_sx = rx + 4*scale; k_col = 0;
  k_r = cr; k_g = cg; k_b = cb;
  sec_x = rx; sec_w = w;
  rx += w + 10*scale;
);

function seg_btn(s, x, y, w, h, label, act, fs)
local(tw, th, gap, hov)
(
  hov = hit_rect(mouse_x, mouse_y, x, y, w, h);
  hov ? hov_s = s;
  gap = max(1, scale);
  gfx_set(0.03, 0.03, 0.04, 1);
  gfx_rect(x - gap, y - gap, w + 2*gap, h + 2*gap, 1);
  act ? gfx_set(acc_r*0.62, acc_g*0.62, acc_b*0.62, 1) : gfx_set(hov ? 0.17 : 0.14, hov ? 0.17 : 0.14, hov ? 0.19 : 0.16, 1);
  gfx_rect(x, y, w, h, 1);
  act ? gfx_set(acc_r, acc_g, acc_b, 1) : gfx_set(0.21, 0.21, 0.24, 1);
  gfx_rect(x + gap, y + gap, w - 2*gap, h*0.5, 1);
  gfx_set(1, 1, 1, act ? 0.22 : 0.08);
  gfx_rect(x + gap, y + gap, w - 2*gap, h*0.3, 1);
  gfx_setfont(1, "Arial", fs*scale, 'b');
  act ? gfx_set(0.08, 0.08, 0.10, 1) : gfx_set(0.78, 0.78, 0.80, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + (w - tw)*0.5; gfx_y = y + (h - th)*0.5;
  gfx_drawstr(label);
  mouse_just_down && hov;
);

function glow_text(str, x, y, r, g, b)
(
  gfx_set(r, g, b, 0.16);
  gfx_x = x - scale; gfx_y = y; gfx_drawstr(str);
  gfx_x = x + scale; gfx_y = y; gfx_drawstr(str);
  gfx_x = x; gfx_y = y - scale; gfx_drawstr(str);
  gfx_x = x; gfx_y = y + scale; gfx_drawstr(str);
  gfx_set(r, g, b, 1);
  gfx_x = x; gfx_y = y; gfx_drawstr(str);
);

function meter(x, y, w, h, pk, label)
local(db, fy, tw, th)
(
  gfx_setfont(1, "Arial", 11*scale, 'b');
  gfx_set(0.62, 0.63, 0.66, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + w*0.5 - tw*0.5; gfx_y = y;
  gfx_drawstr(label);
  y += th + 3*scale;
  h -= th + 3*scale;
  gfx_set(0.04, 0.04, 0.05, 1);
  gfx_rect(x - scale, y - scale, w + 2*scale, h + 2*scale, 1);
  gfx_set(acc_r*0.22, acc_g*0.22, acc_b*0.22, 1);
  gfx_rect(x, y, w, h, 1);
  db = pk > 0.000001 ? 20 * log10(pk) : -100;
  fy = y + h * (1 - max(0, min(1, (db + 60) / 60)));
  db > -1 ? gfx_set(1.0, 0.35, 0.30, 1) : gfx_set(acc_r, acc_g, acc_b, 1);
  gfx_rect(x, fy, w, y + h - fy, 1);
);

function lcd_frame(x, y, w, h)
(
  LX = x; LY = y; LW = w; LH = h;
  gfx_set(0.03, 0.03, 0.04, 1);
  gfx_rect(LX - 2*scale, LY - 2*scale, LW + 4*scale, LH + 4*scale, 1);
  gfx_set(0.17, 0.17, 0.19, 1);
  gfx_rect(LX, LY, LW, LH, 1);
  GX = LX + 6*scale; GY = LY + 6*scale; GW = LW - 12*scale; GH = LH - 12*scale;
  gfx_set(0.02, 0.02, 0.02, 1);
  gfx_rect(GX - scale, GY - scale, GW + 2*scale, GH + 2*scale, 1);
  gfx_set(0.035 + acc_r*0.05, 0.035 + acc_g*0.05, 0.035 + acc_b*0.05, 1);
  gfx_rect(GX, GY, GW, GH, 1);
  lc_r = min(1, 0.35 + acc_r*0.75); lc_g = min(1, 0.35 + acc_g*0.75); lc_b = min(1, 0.35 + acc_b*0.75);
);

function lcd_finish()
local(scy)
(
  gfx_set(0, 0, 0, 0.22);
  scy = GY;
  while (scy < GY + GH) ( gfx_rect(GX, scy, GW, max(1, scale), 1); scy += 3*scale; );
  gfx_set(1, 1, 1, 0.035);
  gfx_rect(GX, GY, GW, GH*0.45, 1);
);

function header(title, sub)
(
  gfx_set(0.09, 0.08, 0.08, 1);
  gfx_rect(0, 0, gfx_w, gfx_h, 1);
  gfx_setfont(1, "Arial", 20*scale, 'b');
  gfx_set(acc_r, acc_g, acc_b, 1);
  gfx_x = ox + MARGIN; gfx_y = oy + 8*scale;
  gfx_drawstr(title);
  gfx_setfont(1, "Arial", 13*scale);
  gfx_set(0.58, 0.60, 0.64, 1);
  gfx_x = ox + MARGIN + 2*scale; gfx_y = oy + 30*scale;
  gfx_drawstr(sub);
);

function hline(y) ( gfx_set(0.04, 0.04, 0.05, 1); gfx_rect(0, oy + y, gfx_w, max(1, scale), 1); );

function hint_bar(y, h, str)
local(tw, th)
(
  hline(y);
  gfx_setfont(1, "Arial", 13*scale);
  gfx_set(0.62, 0.63, 0.66, 1);
  strcpy(#ghint, str);
  gfx_measurestr(#ghint, tw, th);
  tw > (DW - 20)*scale ? ( gfx_setfont(1, "Arial", 13*scale*(DW - 20)*scale/tw); gfx_measurestr(#ghint, tw, th); );
  gfx_x = ox + (DW*scale - tw)*0.5; gfx_y = oy + y + (h - th)*0.5;
  gfx_drawstr(#ghint);
);


function def_val(s) ( s == 1 ? 0 : s == 2 ? 0 : s == 3 ? 0 : s == 5 ? 0.5 : s == 8 ? 0 : 1; );

function knob_name(s)
(
  s == 1 ? "Max Del" : s == 2 ? "Reset" : s == 3 ? "Record" : s == 4 ? "In Mix" : s == 5 ? "In Pan" : s == 6 ? "Feedback" : s == 7 ? "Out Mix" : "Clear Loop";
);

function hint_text(s)
(
  s == 1 ? "Max Del: longest loop, 10 to 200 s; applies at once when the looper is empty, otherwise after Clear Loop" :
  s == 3 ? "Record: start or stop recording and overdubbing (the sustain pedal, CC64, toggles it too)" :
  s == 4 ? "In Mix: level of the input, both through the plugin and into the loop" :
  s == 5 ? "In Pan: input balance between left and right" :
  s == 6 ? "Feedback: how much of the loop is kept on each pass (the mod wheel, CC1, turns it down)" :
  s == 7 ? "Out Mix: loop playback level" :
  s == 8 ? "Clear Loop: stop recording and erase the loop, keeping the memory size" :
  s == 9 ? "Export Loop: put the recorded loop (as stored, at full scale) on a new track at the edit cursor" :
  "Sustain pedal (CC64) toggles recording  ·  CC66 / CC67 jump to the loop start  ·  mod wheel (CC1) lowers feedback";
);

function ptext(s)
local(v)
(
  v = slider(s);
  s == 1 ? sprintf(#ptxt, "%d s", g_trunc(10.5 + 190 * v)) :
  s == 2 ? sprintf(#ptxt, "%.1f MB", lx_bufmax / 524288) :
  s == 3 ? strcpy(#ptxt, lx_recreq ? "RECORD" : "MONITOR") :
  (s == 4 || s == 7) ? ( v < 0.01 ? strcpy(#ptxt, "OFF") : sprintf(#ptxt, "%.1f dB", 20 * log10(v * v)); ) :
  s == 6 ? ( v < 0.01 ? strcpy(#ptxt, "OFF") : sprintf(#ptxt, "%.1f dB", 20 * log10(v)); ) :
  s == 5 ? ( v < 0.505 ? ( v > 0.495 ? strcpy(#ptxt, "C") : sprintf(#ptxt, "L%.0f", 100 - 200 * v); ) : sprintf(#ptxt, "R%.0f", 200 * v - 100); ) :
  strcpy(#ptxt, "");
  #ptxt;
);

function knob_at(s, cx, cy, rad, cr, cg, cb)
local(hov, gv)
(
  hov = hit_circle(mouse_x, mouse_y, cx, cy, rad + 4*scale);
  hov ? hov_s = s;
  (mouse_just_down && hov) ? (
    (click_target == s && time_precise() - click_time < 0.3) ? (
      set_slider(s, def_val(s));
      drag_target = 0;
      lcd_touch(s);
    ) : (
      drag_target = s; drag_y0 = mouse_y; drag_v0 = slider(s); drag_fine = mouse_cap & 4;
    );
    click_target = s; click_time = time_precise();
  );
  (hov && mouse_wheel != 0 && drag_target == 0) ? (
    gv = slider(s) + (mouse_wheel / 120) * ((mouse_cap & 4) ? 0.001 : 0.01);
    set_norm(s, max(0, min(1, gv)));
    automate(s, 1);
    lcd_touch(s);
    mouse_wheel = 0;
  );
  draw_knob(cx, cy, rad, slider(s), cr, cg, cb, ptext(s), knob_name(s));
);

function knob(s)
local(cx, cy)
(
  cx = k_sx + CW*(k_col + 0.5);
  cy = ry + 72*scale;
  k_col += 1;
  knob_at(s, cx, cy, KR, k_r, k_g, k_b);
);

function drag_update()
(
  drag_target > 0 ? (
    mouse_down ? (
      mouse_cap |= 65536;
      fine_now = mouse_cap & 4;
      fine_now != drag_fine ? ( drag_y0 = mouse_y; drag_v0 = slider(drag_target); drag_fine = fine_now; );
      gv = max(0, min(1, drag_v0 + (drag_y0 - mouse_y) / (150*scale) * (fine_now ? 0.1 : 1)));
      set_norm(drag_target, gv);
      lcd_touch(drag_target);
    ) : ( automate(drag_target, 1); drag_target = 0; );
  );
);


mouse_down = mouse_cap & 1;
mouse_just_down = mouse_down && !mouse_state;
hov_s = 0;
acc_r = 0.72; acc_g = 0.58; acc_b = 1.00;

header("LOOP THE LOOP", "by chmaha  ·  based on mda Looplex");
TABW = 150*scale; TABH = 26*scale;
tx0 = ox + DW*scale - MARGIN - TABW;
seg_btn(3, tx0, oy + 11*scale, TABW, TABH, lx_recreq ? "RECORDING" : "RECORD", lx_recreq, 14) ? (
  set_slider(3, lx_recreq ? 0 : 1); lx_guitog = 1; mouse_just_down = 0;
);
hline(46*scale);

lcd_frame(ox + MARGIN, oy + 56*scale, 700*scale, 96*scale);
TAW = 230*scale;
gfx_setfont(2, "Courier New", 14*scale, 'b');
lx_pend ? sprintf(#lt, "%d S MAX (AFTER CLEAR)", g_trunc(10.5 + 190 * p_maxdel)) : (
  glow_text("LOOPER", GX + 10*scale, GY + 6*scale, lc_r, lc_g, lc_b);
  sprintf(#lt, "%.0f S MAX", lx_fmax / srate);
);
gfx_measurestr(#lt, ltw, lth);
glow_text(#lt, GX + TAW - ltw, GY + 6*scale, lc_r, lc_g, lc_b);
strcpy(#ln, lx_status == 0 ? (lx_recreq ? "ARMED" : "EMPTY") : lx_status == 1 ? "RECORDING" : lx_recreq ? "OVERDUB" : "PLAYING");
gfx_setfont(2, "Courier New", 26*scale, 'b');
gfx_measurestr(#ln, ltw, lth);
glow_text(#ln, GX + 10*scale + (TAW - 10*scale - ltw)*0.5, GY + 26*scale + (26*scale - lth)*0.5, lc_r, lc_g, lc_b);
gfx_setfont(2, "Courier New", 14*scale, 'b');
LY3 = GY + GH - 20*scale;
(lcd_sl > 0 && time_precise() - lcd_t < 1.5) ? (
  strcpy(#lt, knob_name(lcd_sl)); upper(#lt);
  glow_text(#lt, GX + 10*scale, LY3, lc_r, lc_g, lc_b);
  strcpy(#lv, ptext(lcd_sl)); upper(#lv);
  gfx_measurestr(#lv, ltw, lth);
  glow_text(#lv, GX + TAW - ltw, LY3, lc_r, lc_g, lc_b);
) : (
  g_len = lx_status == 1 ? lx_fpos : lx_flen;
  sprintf(#lt, "LOOP %.2f S", g_len / srate);
  glow_text(#lt, GX + 10*scale, LY3, lc_r, lc_g, lc_b);
  sprintf(#lv, "FB %.0f %%", 100 * p_fb * lx_modwhl);
  gfx_measurestr(#lv, ltw, lth);
  glow_text(#lv, GX + TAW - ltw, LY3, lc_r, lc_g, lc_b);
);

SDX = GX + TAW + 12*scale;
gfx_set(lc_r, lc_g, lc_b, 0.18);
gfx_rect(SDX, GY + 8*scale, max(1, scale), GH - 16*scale, 1);
VX = SDX + 12*scale; VW = GX + GW - 10*scale - VX;
VY = GY + 8*scale; VH = GH - 16*scale;
gfx_set(lc_r, lc_g, lc_b, 0.08);
gfx_rect(VX, VY, VW, VH, 1);
gfx_set(lc_r, lc_g, lc_b, 0.2);
gfx_rect(VX, VY + VH*0.5, VW, max(1, scale), 1);
g_span = lx_status == 0 ? 0 : lx_status == 1 ? max(lx_fpos, srate) : lx_flen;
g_n = floor(VW / max(1, 2*scale));
g_span > 0 ? (
  gci = 0;
  loop(g_n,
    gp0 = floor(gci * g_span / g_n);
    gpk = 0;
    gk = 0;
    loop(8,
      gpi = gp0 + floor(gk * g_span / g_n / 8);
      gpi < lx_hw ? (
        gsmp = LBUF[gpi];
        glh = floor(gsmp / 65536);
        gq = max(abs(glh - 32768), abs((gsmp - glh * 65536) - 32768));
        gq > gpk ? gpk = gq;
      );
      gk += 1;
    );
    gpk = min(1, gpk / 32768);
    gpk > 0 ? (
      gfx_set(lc_r, lc_g, lc_b, 0.75);
      gfx_rect(VX + gci * VW / g_n, VY + VH*0.5 - gpk*VH*0.48, max(1, VW / g_n - 0.5*scale), max(1, gpk*VH*0.96), 1);
    );
    gci += 1;
  );
  gph = VX + VW * min(1, lx_fpos / g_span);
  gfx_set(1, 0.9, 0.5, 0.95);
  gfx_rect(gph, VY, max(1, 2*scale), VH, 1);
) : (
  gfx_setfont(1, "Arial", 12*scale, 'b');
  gfx_set(lc_r, lc_g, lc_b, 0.7);
  strcpy(#gt, "press RECORD or the sustain pedal to start a loop");
  gfx_measurestr(#gt, gtw, gth);
  gfx_x = VX + (VW - gtw)*0.5; gfx_y = VY + (VH - gth)*0.5;
  gfx_drawstr(#gt);
);
lcd_finish();

MW = 16*scale;
MAX0 = LX + LW + 26*scale;
MSP = (ox + DW*scale - MARGIN - MAX0 - MW);
meter(MAX0, LY, MW, LH, ipk, "IN");
meter(MAX0 + MSP, LY, MW, LH, opk, "OUT");

SY = oy + 164*scale; SH = 26*scale;
gfx_setfont(1, "Arial", 12*scale, 'b');
gfx_set(0.62, 0.63, 0.66, 1);
gfx_measurestr("MEMORY", ltw, lth);
gfx_x = ox + MARGIN; gfx_y = SY + (SH - lth)*0.5;
gfx_drawstr("MEMORY");
LBX = ox + MARGIN + ltw + 10*scale; LBW = 110*scale;
XBW = 130*scale;
XBX = ox + DW*scale - MARGIN - XBW;
CBX = XBX - XBW - 6*scale;
seg_btn(8, CBX, SY, XBW, SH, "CLEAR LOOP", 0, 12) ? ( set_slider(8, p_clear > 0.5 ? 0 : 1); mouse_just_down = 0; );
g_xok = lx_status == 2 && lx_flen > 0 && g_xst == 0;
seg_btn(9, XBX, SY, XBW, SH, g_xst ? "EXPORTING" : "EXPORT LOOP", g_xst, 12) ? (
  mouse_just_down = 0;
  g_xok ? (
    g_xlen = lx_flen; g_xfm = lx_fmax; g_xbase = LBUF + lx_fmax;
    g_xbase + 2 * g_xlen <= 33554432 ? ( g_xst = 1; g_xpos = 0; ) : ( strcpy(#gxm, "loop too long to export at this sample rate"); g_xmt = time_precise(); );
  ) : g_xst == 0 ? ( strcpy(#gxm, "record a loop first"); g_xmt = time_precise(); );
);
g_xst ? (
  (lx_fmax != g_xfm || lx_status != 2) ? (
    g_xst = 0; strcpy(#gxm, "export cancelled (loop was cleared)"); g_xmt = time_precise();
  ) : (
    g_xn = min(262144, g_xlen - g_xpos);
    g_xk = g_xpos;
    g_xd = g_xbase + 2 * g_xpos;
    loop(g_xn,
      g_xk < lx_hw ? (
        g_xw = LBUF[g_xk];
        g_xh = floor(g_xw / 65536);
        g_xd[0] = (g_xh - 32768) / 32768;
        g_xd[1] = ((g_xw - (g_xh * 65536)) - 32768) / 32768;
      ) : ( g_xd[0] = g_xd[1] = 0; );
      g_xk += 1; g_xd += 2;
    );
    g_xpos += g_xn;
    g_xpos >= g_xlen ? (
      g_xst = 0;
      g_xrv = export_buffer_to_project(g_xbase, g_xlen, 2, srate, -1, 0);
      strcpy(#gxm, g_xrv == 0 ? "loop exported to a new track" : "export failed");
      g_xmt = time_precise();
    );
  );
);
gfx_setfont(1, "Arial", 12*scale);
gfx_set(0.58, 0.60, 0.64, 1);
(g_xmt > 0 && time_precise() - g_xmt < 3) ? strcpy(#gt, #gxm) :
  sprintf(#gt, "%.1f MB loop memory  ·  %s", lx_bufmax / 524288, lx_pend ? "new Max Del waits for Clear Loop" : "Max Del resizes it when the looper is empty");
gfx_x = LBX; gfx_y = SY + (SH - lth)*0.5;
gfx_drawstr(#gt);

hline(200*scale);
row_begin(208*scale, 5, 3);
sec(1, "MEMORY", 0.72, 0.58, 1.00); knob(1);
sec(2, "INPUT", 0.45, 0.80, 0.95); knob(4); knob(5);
sec(2, "LOOP", 0.98, 0.80, 0.30); knob(6); knob(7);

hint_bar(346*scale, 34*scale, hint_text(drag_target > 0 ? drag_target : hov_s));

drag_update();

mouse_wheel = 0;
mouse_state = mouse_down;
