  hexc(0xfdfeff, 0.18);
  gline(cx, 465 + 3, cx, 465 + h - 3); gline(769 + 3, cy, 769 + w - 3, cy);
  gline(cx - rr, cy - rr, cx + rr, cy + rr); gline(cx - rr, cy + rr, cx + rr, cy - rr);
  gfont(10, 0); hexc(0x9498a2, 0.7);
