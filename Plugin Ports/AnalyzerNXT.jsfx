  gchip(86, 561, 29.5, 17, gl_on_rms2, "RMS") ? gl_on_rms2 = !gl_on_rms2;
);

function gro_fmt(v) ( (v <= -90) ? sprintf(#gv, "—") : sprintf(#gv, "%.1f", v); #gv; );

function greadout() local(i, lab, v, over, cx, ry)
(
  hexc(0x0a0d10, 1); grr(760, 58.5, 256, 136, 3);
  i = 0;
  loop(8,
    cx = (i % 2) === 0 ? 769 : 892;
    ry = 77.5 + floor(i / 2) * 31.9;
    lab = i === 0 ? "Momentary" : i === 1 ? "Short-term" : i === 2 ? "Integrated" : i === 3 ? "Range" : i === 4 ? "L Peak" : i === 5 ? "R Peak" : i === 6 ? "L RMS" : "R RMS";
    v = i === 0 ? LDO[0] : i === 1 ? LDO[1] : i === 2 ? LDO[2] : i === 3 ? LDO[3] : i === 4 ? LDO[4] : i === 5 ? LDO[5] : i === 6 ? LDO[16] : LDO[17];
    over = (i === 2 && v > -90 && v > g_target) || ((i === 4 || i === 5) && v > -90 && v > g_tpc);
    gfont(12, 0); hexc(0xb6bac1, 1); txt_l(cx, ry, lab);
