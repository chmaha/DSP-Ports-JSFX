  f = max(-60, min(-24, floor((mn - 3) / 6) * 6));
  f < gh_min ? gh_min = f : gh_min += (f - gh_min) * 0.04;
  ymin = gh_min;
  hexc(0xffffff, 0.15);
  i = 0;
  loop(floor((6 - ymin) / 6) + 1,
    yy = y0 + h * (6 - (6 - i * 6)) / (6 - ymin);
    ghl(8.5, y0 + h * (i * 6) / (6 - ymin), w);
    i += 1;
  );
  hexc(0xffffff, 0.3); ghl(8.5, y0 + h * 6 / (6 - ymin), w);
  i = 1;
  loop(5,
    hexc(0xffffff, 0.15); gvl(8.5 + w * (1 - i / 6), y0, h);
    i += 1;
  );
  ord = 0;
  loop(4,
    ord === 0 ? ( gl_on_rms2 ? ( k = 3; gfx_set(TC[21], TC[22], TC[23], 0.45); gl_th = 0; ) : k = -1; ) :
    ord === 1 ? ( gl_on_tp ? ( k = 2; gfx_set(TC[30], TC[31], TC[32], 1); gl_th = 0; ) : k = -1; ) :
    ord === 2 ? ( gl_on_m ? ( k = 0; gfx_set(TC[24], TC[25], TC[26], 1); gl_th = 0; ) : k = -1; ) :
                ( gl_on_st ? ( k = 1; gfx_set(TC[12], TC[13], TC[14], 1); gl_th = 1; ) : k = -1; );
    k >= 0 ? (
      i = 0;
      loop(ld_hn,
        p = LHB + ((ld_hw - ld_hn + i + 480) % 480) * 4;
        v = p[k];
        v = (v < -90) ? -60 : max(-60, min(6, v));
        px = gxp(8.5 + w - (ld_hn - i) * cw); py = gyp(y0 + h * (6 - v) / (6 - ymin));
        py = min(py, gyp(y0 + h));
        i > 0 ? ( gl_th ? gthick(ppx, ppy, px, py) : gfx_line(ppx, ppy, px, py, 1); );
        ppx = px; ppy = py;
        i += 1;
      );
    );
    ord += 1;
  );
  gfont(10, 0); hexc(0x9498a2, 1);
  i = 0;
  loop(floor((6 - ymin) / 12) + 1,
    v = i === 0 ? 0 : -i * 12;
    txt_r(749, y0 + h * (6 - v) / (6 - ymin), sprintf(#gv, "%d", v));
    i += 1;
  );
  i = 0;
  loop(7,
    txt_cc(8.5 + w * i / 6 + (i === 0 ? 9 : i === 6 ? -5 : 0), y0 + h - 7, i === 6 ? "0" : sprintf(#gv, "%ds", 12 - i * 2));
    i += 1;
