Version: 1.1
desc: calfNXT Analyzer
tags: analysis meter spectrum loudness lufs goniometer
author: chmaha
changelog:
  Moving a control in the plugin window now records automation and notifies REAPER (named slider fix).
about:
  A transparent analyser. It shows a stereo spectrum (1k to 8k FFT, three scales), a spectrum difference view, ITU-R BS.1770-4
  loudness (momentary, short-term, integrated, loudness range, true peak) with EBU, ATSC, -14 and -16 LUFS targets, level
  meters, a correlation meter and a goniometer. The audio passes through unchanged apart from the In and Out gains.
  Ported from the Analyzer in calfNXT by Markus Schmidt (https://calfnxt.org), GNU GPL 3. Derived from Calf Studio Gear
  by Krzysztof Foltman et al. (https://calf-studio-gear.org).
  JSFX version released under GPLv3 license
  Claude generated some of this code

slider1:g_bypass=0<0,1,1{Off,On}>-Bypass
slider2:g_mode=0<0,1,1{Stereo,Waterfall}>-Waterfall
slider3:g_hold=0<0,1,1{Off,On}>-Pause
slider4:g_fft=2<0,3,1{1k,2k,4k,8k}>-FFT Size
slider5:g_scale=0<0,2,1{Lin,-3 dB,-4.5 dB}>-Scale
slider6:g_std=2<0,3,1{EBU,ATSC,-14,-16}>-Standard
slider7:g_target=-14<-36,-8,0.1>-Target (LUFS)
slider8:g_tpc=-1<-6,0,0.1>-True Peak Ceiling (dB)
slider9:g_in=0<-60,12,0.01>-In (dB)
slider10:g_out=0<-60,12,0.01>-Out (dB)
slider11:g_day=0<0,1,1{Night,Day}>-Theme Mode
slider12:g_acc=0<0,4,1{NXT,Fire,Lime,Sea,Slick}>-Theme Colors

in_pin:Left input
in_pin:Right input
out_pin:Left output
out_pin:Right output
options:no_meter

@init
ext_noinit = gfx_ext_retina = 1;

function alloc(n) local(r) instance(mp) global() ( r = mp; mp += n; memset(r, 0, n); r; );
alloc.mp = 0;

function f32(x) local(c) ( c = x * 536870913; c - (c - x); );
function sanitize64(x) ( abs(x) < SM50 ? 0 : x; );
SM50 = 10 ^ -50;
K0P025 = (0.025);

ld_sr = 48000;
LDS = alloc(16);
LDH = alloc(96);
LDR = alloc(32);
LDG = alloc(144100);
LRA = alloc(800);
LHB = alloc(480 * 4);
LDO = alloc(32);

ld_tpp = 0;
ld_rbn = 0; ld_rbw = 0;
ld_gn = 0; ld_lrac = 0; ld_lraps = 0;
ld_blks = 0; ld_blkc = 0; ld_hc = 0; ld_hw = 0; ld_hn = 0;
ld_samples = 0; ld_paused = 0;
ld_tcl = ld_tcr = ld_tml = ld_tmr = ld_sml = ld_smr = ld_shl = ld_shr = 0;
ld_rsl = ld_rsr = 0;
ld_pubtl = ld_pubtr = ld_pubshl = ld_pubshr = 0;
ld_gb = 0;
ld_inv = -200;

function ld_design(sr) local(f0, G, Q, K, Vh, Vb, a0)
(
  ld_sr = sr > 8000 ? sr : 48000;
  sr = ld_sr;
  f0 = 1681.974450955533; G = 3.999843853973347; Q = 0.7071752369554196;
  K = tan($pi * f0 / sr);
  Vh = 10 ^ (G / 20);
  Vb = Vh ^ 0.4996667741545416;
  a0 = 1 + K / Q + K * K;
  ld_sb0 = (Vh + Vb * K / Q + K * K) / a0;
  ld_sb1 = 2 * (K * K - Vh) / a0;
  ld_sb2 = (Vh - Vb * K / Q + K * K) / a0;
  ld_sa1 = 2 * (K * K - 1) / a0;
  ld_sa2 = (1 - K / Q + K * K) / a0;
  f0 = 38.13547087602444; Q = 0.5003270373238773;
  K = tan($pi * f0 / sr);
  a0 = 1 + K / Q + K * K;
  ld_hb0 = 1 / a0; ld_hb1 = -2 / a0; ld_hb2 = 1 / a0;
  ld_ha1 = 2 * (K * K - 1) / a0;
  ld_ha2 = (1 - K / Q + K * K) / a0;
  ld_blks = max(1, floor(sr * 0.1 + 0.5));
  ld_hs = max(1, floor(sr * K0P025 + 0.5));
  ld_rsa = (1 - exp(-1 / (0.3 * sr)));
);

function ld_reset()
(
  memset(LDS, 0, 16); memset(LDH, 0, 96); memset(LDR, 0, 32); memset(LRA, 0, 800); memset(LHB, 0, 480 * 4);
  ld_tpp = 0; ld_rbn = 0; ld_rbw = 0; ld_gn = 0; ld_lrac = 0; ld_lraps = 0;
  ld_blkc = 0; ld_hc = 0; ld_hw = 0; ld_hn = 0; ld_blksum = 0;
  ld_samples = 0;
  ld_tcl = ld_tcr = ld_tml = ld_tmr = ld_sml = ld_smr = 0;
  ld_rsl = ld_rsr = 0;
);

function ld_p2l(ms) ( ms > 0.00000000000000000001 ? (-0.691 + 10 * log10(ms)) : -200; );
function ld_l2db(x) ( x > 0.000000000001 ? (20 * (log10(x))) : -200; );

function ld_win(n) local(s, i, j)
(
  ld_rbn < n || n < 1 ? 0 : (
    s = 0; i = ld_rbn - n;
    loop(n,
      j = (ld_rbw - ld_rbn + i + 30) % 30;
      s += LDR[j];
      i += 1;
    );
    s / n;
  );
);

function ld_pushblock(ms) local(m, lufs, st, bin)
(
  LDR[ld_rbw] = ms;
  ld_rbw = (ld_rbw + 1) % 30;
  ld_rbn < 30 ? ld_rbn += 1;
  ld_paused ? 0 : (
    ld_rbn >= 4 ? (
      m = ld_win(4);
      lufs = ld_p2l(m);
      (lufs > -70 && ld_gn < 144000) ? ( LDG[ld_gn] = (m); ld_gn += 1; );
    );
    ld_rbn >= 30 ? (
      st = ld_p2l(ld_win(30));
      (st > -70 && st < 10) ? (
        bin = floor(((st + 70) * 10) + 0.5);
        (bin >= 0 && bin < 800) ? (
          LRA[bin] += 1; ld_lrac += 1;
          ld_lraps += 10 ^ ((st + 0.691) / 10);
        );
      );
    );
  );
);

function ld_pushhist() local(tp, rms, mom, st, p)
(
  ld_paused ? 0 : (
    tp = ld_l2db(max(ld_tcl, ld_tcr));
    rms = ld_l2db(sqrt(max(0, (0.5 * (ld_rsl + ld_rsr)))));
    mom = ld_p2l(ld_win(min(4, ld_rbn)));
    st = ld_p2l(ld_win(min(30, ld_rbn)));
    p = LHB + ld_hw * 4;
    p[0] = mom; p[1] = st; p[2] = tp; p[3] = rms;
    ld_hw = (ld_hw + 1) % 480;
    ld_hn < 480 ? ld_hn += 1;
  );
);
// generated by build.py: 4x polyphase true peak (BS.1770-4 Annex 2), taps unrolled
function ld_tp(h, x) local(pk, t0, t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11, y)
(
  pk = abs(x);
  h = h + ld_tpp;
  t0 = h[24];
  t1 = h[23];
  t2 = h[22];
  t3 = h[21];
  t4 = h[20];
  t5 = h[19];
  t6 = h[18];
  t7 = h[17];
  t8 = h[16];
  t9 = h[15];
  t10 = h[14];
  t11 = h[13];
  y = abs((0.001708984375 * t0) + (0.010986328125 * t1) + (-0.0196533203125 * t2) + (0.033203125 * t3) + (-0.0594482421875 * t4) + (0.1373291015625 * t5) + (0.97216796875 * t6) + (-0.102294921875 * t7) + (0.047607421875 * t8) + (-0.026611328125 * t9) + (0.014892578125 * t10) + (-0.00830078125 * t11)); y > pk ? pk = y;
  y = abs((-0.0291748046875 * t0) + (0.029296875 * t1) + (-0.0517578125 * t2) + (0.089111328125 * t3) + (-0.16650390625 * t4) + (0.465087890625 * t5) + (0.77978515625 * t6) + (-0.2003173828125 * t7) + (0.1015625 * t8) + (-0.0582275390625 * t9) + (0.0330810546875 * t10) + (-0.0189208984375 * t11)); y > pk ? pk = y;
  y = abs((-0.0189208984375 * t0) + (0.0330810546875 * t1) + (-0.0582275390625 * t2) + (0.1015625 * t3) + (-0.2003173828125 * t4) + (0.77978515625 * t5) + (0.465087890625 * t6) + (-0.16650390625 * t7) + (0.089111328125 * t8) + (-0.0517578125 * t9) + (0.029296875 * t10) + (-0.0291748046875 * t11)); y > pk ? pk = y;
  y = abs((-0.00830078125 * t0) + (0.014892578125 * t1) + (-0.026611328125 * t2) + (0.047607421875 * t3) + (-0.102294921875 * t4) + (0.97216796875 * t5) + (0.1373291015625 * t6) + (-0.0594482421875 * t7) + (0.033203125 * t8) + (-0.0196533203125 * t9) + (0.010986328125 * t10) + (0.001708984375 * t11)); y > pk ? pk = y;
  pk;
);

function ld_proc(L, R) local(x1, x2, y1, y2, p, zl, zr, aL, aR, tl, tr, q)
(
  p = LDS;
  y1 = (((ld_sb0 * L) + (p[0] * ld_sb1)) + (p[1] * ld_sb2)) - (p[2] * ld_sa1) - (p[3] * ld_sa2);
  p[1] = p[0]; p[0] = L; p[3] = p[2]; p[2] = y1;
  abs(p[0]) < SM50 ? p[0] = 0; abs(p[1]) < SM50 ? p[1] = 0; abs(p[2]) < SM50 ? p[2] = 0; abs(p[3]) < SM50 ? p[3] = 0;
  p = LDS + 8;
  y2 = (((ld_hb0 * y1) + (p[0] * ld_hb1)) + (p[1] * ld_hb2)) - (p[2] * ld_ha1) - (p[3] * ld_ha2);
  p[1] = p[0]; p[0] = y1; p[3] = p[2]; p[2] = y2;
  abs(p[0]) < SM50 ? p[0] = 0; abs(p[1]) < SM50 ? p[1] = 0; abs(p[2]) < SM50 ? p[2] = 0; abs(p[3]) < SM50 ? p[3] = 0;
  zl = (y2);
  p = LDS + 4;
  y1 = (((ld_sb0 * R) + (p[0] * ld_sb1)) + (p[1] * ld_sb2)) - (p[2] * ld_sa1) - (p[3] * ld_sa2);
  p[1] = p[0]; p[0] = R; p[3] = p[2]; p[2] = y1;
  abs(p[0]) < SM50 ? p[0] = 0; abs(p[1]) < SM50 ? p[1] = 0; abs(p[2]) < SM50 ? p[2] = 0; abs(p[3]) < SM50 ? p[3] = 0;
  p = LDS + 12;
  y2 = (((ld_hb0 * y1) + (p[0] * ld_hb1)) + (p[1] * ld_hb2)) - (p[2] * ld_ha1) - (p[3] * ld_ha2);
  p[1] = p[0]; p[0] = y1; p[3] = p[2]; p[2] = y2;
  abs(p[0]) < SM50 ? p[0] = 0; abs(p[1]) < SM50 ? p[1] = 0; abs(p[2]) < SM50 ? p[2] = 0; abs(p[3]) < SM50 ? p[3] = 0;
  zr = (y2);
  ld_blksum = ld_blksum + ((zl * zl) + (zr * zr));
  ld_blkc += 1;
  ld_blkc >= ld_blks ? ( ld_pushblock(ld_blksum / ld_blks); ld_blksum = 0; ld_blkc = 0; );
  ld_hc += 1;
  ld_hc >= ld_hs ? ( ld_pushhist(); ld_hc = 0; );
  ld_rsl += ld_rsa * (L * L - ld_rsl);
  ld_rsr += ld_rsa * (R * R - ld_rsr);
  aL = abs(L); aR = abs(R);
  aL > ld_shl ? ld_shl = aL;
  aR > ld_shr ? ld_shr = aR;
  ld_paused ? 0 : (
    aL > ld_sml ? ld_sml = aL;
    aR > ld_smr ? ld_smr = aR;
    ld_samples += 1;
  );
  ld_tpp = (ld_tpp + 1) % 24;
  LDH[ld_tpp] = L; LDH[ld_tpp + 24] = L;
  LDH[48 + ld_tpp] = R; LDH[48 + ld_tpp + 24] = R;
  tl = ld_tp(LDH, L);
  tr = ld_tp(LDH + 48, R);
  tl > ld_tcl ? ld_tcl = tl;
  tr > ld_tcr ? ld_tcr = tr;
  ld_paused ? 0 : (
    tl > ld_tml ? ld_tml = tl;
    tr > ld_tmr ? ld_tmr = tr;
  );
);

function ld_integrated() local(i, s, am, rel, n, p)
(
  ld_gn < 1 ? 0 : (
    s = 0; i = 0;
    loop(ld_gn, s += LDG[i]; i += 1; );
    am = s / ld_gn;
    rel = 10 ^ ((ld_p2l(am) - 10 + 0.691) / 10);
    s = 0; n = 0; i = 0;
    loop(ld_gn, p = LDG[i]; p >= rel ? ( s += p; n += 1; ); i += 1; );
    n < 1 ? 0 : ( ld_ipow = s / n; 1; );
  );
);

function ld_lra() local(am, absl, rell, relbin, above, i, lo, hi, seen, lobin, hibin, gotlo, done, c)
(
  ld_lrac < 20 ? 0 : (
    am = ld_lraps / ld_lrac;
    absl = ld_p2l(am);
    rell = (absl - 20);
    relbin = floor(((rell + 70) * 10));
    above = 0; i = max(0, relbin);
    loop(800 - i, above += LRA[i]; i += 1; );
    above < 2 ? 0 : (
      lo = max(1, floor(0.10 * above + 0.5));
      hi = max(lo, floor(0.95 * above + 0.5));
      seen = 0; lobin = relbin; hibin = relbin; gotlo = 0; done = 0;
      i = max(0, relbin);
      while (i < 800 && !done) (
        seen += LRA[i];
        (!gotlo && seen >= lo) ? ( lobin = i; gotlo = 1; );
        seen >= hi ? ( hibin = i; done = 1; );
        i += 1;
      );
      ld_lraout = ((hibin - lobin) * 0.1);
      ld_lralo = ((lobin * 0.1) - 70);
      ld_lrahi = ((hibin * 0.1) - 70);
      1;
    );
  );
);

function ld_take() local(mp, sp, ip, io, lo)
(
  mp = ld_win(4); sp = ld_win(30);
  io = ld_integrated();
  lo = ld_lra();
  LDO[0] = ld_p2l(mp);
  LDO[1] = ld_p2l(sp);
  LDO[2] = io ? ld_p2l(ld_ipow) : -200;
  LDO[3] = lo ? ld_lraout : -1;
  LDO[4] = ld_l2db(ld_pubtl); LDO[5] = ld_l2db(ld_pubtr);
  LDO[6] = ld_l2db(ld_tml); LDO[7] = ld_l2db(ld_tmr);
  LDO[8] = ld_l2db(ld_sml); LDO[9] = ld_l2db(ld_smr);
  LDO[10] = ld_samples / ld_sr;
  LDO[11] = ld_paused ? 1 : 0;
  LDO[12] = io ? 1 : 0; LDO[13] = lo ? 1 : 0;
  LDO[14] = ld_l2db(ld_pubshl); LDO[15] = ld_l2db(ld_pubshr);
  LDO[16] = ld_l2db(sqrt(max(0, ld_rsl))); LDO[17] = ld_l2db(sqrt(max(0, ld_rsr)));
  LDO[18] = lo ? ld_lralo : -200; LDO[19] = lo ? ld_lrahi : -200;
  LDO[20] = ld_hn;
);

ft_n = 64; ft_pos = 0; ft_c = 0; ft_env = 0.25; ft_er = 0.999;
ft_slr = ft_sl2 = ft_sr2 = 0; ft_corr = 0;
FTR = alloc(8200);
FTG = alloc(260);
ft_gn = 0;

function ft_reset()
(
  memset(FTR, 0, ft_n);
  ft_pos = 0; ft_env = 0.25; ft_slr = ft_sl2 = ft_sr2 = 0; ft_corr = 0;
);

function ft_setsr(sr)
(
  ft_n = max(64, floor(sr / 30) * 2);
  ft_c = exp(-1 / (0.4 * sr));
  ft_er = (exp(log(0.01) / (2000 * sr * 0.001)));
  ft_reset();
);

function ft_proc(L, R) local(c, den, cr, lemax, sc)
(
  c = ft_c;
  ft_slr = c * ft_slr + (1 - c) * L * R;
  ft_sl2 = c * ft_sl2 + (1 - c) * L * L;
  ft_sr2 = c * ft_sr2 + (1 - c) * R * R;
  den = sqrt(max(0.00000000000000000001, ft_sl2 * ft_sr2));
  cr = (ft_slr / den);
  ft_corr = max(-1, min(1, cr));
  lemax = (max(abs(L), abs(R)) * 1.41421356);
  lemax >= ft_env ? ft_env = lemax : ft_env = ((ft_er * (ft_env - lemax)) + lemax);
  sc = 1 / max(0.25, ft_env);
  FTR[ft_pos] = (L * sc);
  FTR[ft_pos + 1] = (R * sc);
  ft_pos = (ft_pos + 2) % ft_n;
);

function ft_publish() local(pairs, outp, step, p, src, idx, n)
(
  pairs = floor(ft_n / 2);
  outp = min(pairs, 128);
  step = max(1, floor(pairs / outp));
  n = 0; p = 0;
  loop(outp,
    src = (p * step) % pairs;
    idx = (ft_pos + src * 2) % ft_n;
    FTG[n] = FTR[idx]; FTG[n + 1] = FTR[(idx + 1) % ft_n];
    n += 2; p += 1;
  );
  ft_gn = n;
);

SPMAX = 512;
SPLO = alloc(SPMAX); SPHI = alloc(SPMAX); SPT = alloc(SPMAX);
SAVG = alloc(SPMAX); SMAX = alloc(SPMAX); SLD = alloc(SPMAX); SRD = alloc(SPMAX); SRMS = alloc(SPMAX); SRMP = alloc(SPMAX);
SIL = alloc(SPMAX); SIR = alloc(SPMAX); SPL = alloc(SPMAX); SPR = alloc(SPMAX);
SRL = alloc(8192); SRR = alloc(8192);
SWIN = alloc(8192);
alloc.mp % 65536 > 49152 ? alloc(65536 - alloc.mp % 65536);
SBUF = alloc(16384);
sp_fft = 0; sp_n = 0; sp_pos = 0; sp_hc = 0; sp_hop = 256;
sp_rlo = -1; sp_ra = 0; sp_rb = 0; sp_rpx = 0; sp_rhi = 0;
sp_ea = 0.2; sp_ra2 = 0.05;

function sp_logt(f) ( log(max(20, min(20000, f)) / 20) / log(1000); );

function sp_emit(blo, bhi, a, b) local(l)
(
  (bhi > blo && b > a) ? (
    sp_n >= SPMAX ? (
      l = sp_n - 1;
      SPHI[l] = bhi;
      SPT[l] = max(0, min(1, sp_logt(sqrt(max(a, 20) * b))));
    ) : (
      SPLO[sp_n] = blo; SPHI[sp_n] = bhi;
      SPT[sp_n] = max(0, min(1, sp_logt(sqrt(a * b))));
      sp_n += 1;
    );
  );
);

function sp_close()
(
  sp_rlo >= 0 ? ( sp_emit(sp_rlo, sp_rhi, sp_ra, sp_rb); sp_rlo = -1; sp_rpx = 0; );
);

function sp_map() local(half, binhz, ftop, lnspan, k, f0, f1, a, b, px, done)
(
  sp_n = 0; sp_rlo = -1; sp_rpx = 0;
  half = sp_fft / 2;
  binhz = srate / sp_fft;
  ftop = min(20000, srate * 0.5);
  lnspan = log(1000);
  k = 1; done = 0;
  while (k < half && !done) (
    f0 = k * binhz; f1 = (k + 1) * binhz;
    f1 <= 20 ? 0 : f0 >= ftop ? ( done = 1; ) : (
      a = max(f0, 20); b = min(f1, ftop);
      b > a ? (
        px = (SPMAX * log(b / a)) / lnspan;
        px >= 1 ? ( sp_close(); sp_emit(k, k + 1, a, b); ) : (
          sp_rlo < 0 ? ( sp_rlo = k; sp_rhi = k + 1; sp_ra = a; sp_rb = b; sp_rpx = px; ) :
          ( sp_rhi = k + 1; sp_rb = b; sp_rpx += px; );
          sp_rpx >= 1 ? sp_close();
        );
      );
    );
    k += 1;
  );
  sp_close();
);

function sp_floor() local(i)
(
  i = 0;
  loop(SPMAX,
    SAVG[i] = -120; SMAX[i] = -120; SLD[i] = -120; SRD[i] = -120; SRMS[i] = -120; SRMP[i] = 0;
    SIL[i] = -120; SIR[i] = -120; SPL[i] = 0; SPR[i] = 0;
    i += 1;
  );
);

function sp_ballistics() local(hps)
(
  hps = srate / sp_hop;
  sp_ea = max(0.01, min(1, (1 - exp(-1 / (0.1 * hps)))));
  sp_ra2 = max(0.001, min(1, (1 - exp(-1 / (1 * hps)))));
);

function sp_setfft(size) local(i)
(
  sp_fft = size;
  sp_hop = size / 4;
  sp_pos = 0; sp_hc = 0;
  memset(SRL, 0, 8192); memset(SRR, 0, 8192);
  sp_floor();
  i = 0;
  loop(size, SWIN[i] = (0.5 * (1 - cos((2 * $pi) * (size > 1 ? i / (size - 1) : 0)))); i += 1; );
  sp_ballistics();
  sp_map();
);

function sp_reset()
(
  memset(SRL, 0, 8192); memset(SRR, 0, 8192);
  sp_pos = 0; sp_hc = 0;
  sp_floor();
);

function sp_hopdo() local(i, k, n, pos, xr, xi, yr, yi, a, b, ml, mr, sl, sr_, cnt, nm, nm2, li, ri, lo, hi, pl, pr, mid, pw, db, mx)
(
  n = sp_fft;
  pos = sp_pos;
  i = 0;
  loop(n,
    k = pos + i; k >= n ? k -= n;
    SBUF[2 * i] = SRL[k] * SWIN[i];
    SBUF[2 * i + 1] = SRR[k] * SWIN[i];
    i += 1;
  );
  fft(SBUF, n);
  fft_permute(SBUF, n);
  nm = 2 / (n * 0.5);
  nm2 = nm * nm;
  i = 0;
  loop(sp_n,
    lo = SPLO[i]; hi = SPHI[i];
    ml = 0; mr = 0; sl = 0; sr_ = 0;
    k = lo;
    loop(hi - lo,
      xr = SBUF[2 * k]; xi = SBUF[2 * k + 1];
      yr = SBUF[2 * (n - k)]; yi = SBUF[2 * (n - k) + 1];
      a = 0.5 * sqrt(sqr(xr + yr) + sqr(xi - yi));
      b = 0.5 * sqrt(sqr(xi + yi) + sqr(xr - yr));
      a > ml ? ml = a;
      b > mr ? mr = b;
      sl += a * a; sr_ += b * b;
      k += 1;
    );
    cnt = hi - lo;
    li = ml * nm; ri = mr * nm;
    li = li > 0.000000000001 ? max(-120, min(0, 20 * log10(li))) : -120;
    ri = ri > 0.000000000001 ? max(-120, min(0, 20 * log10(ri))) : -120;
    SIL[i] = li; SIR[i] = ri;
    SPL[i] = cnt > 0 ? (sl / cnt) * nm2 : 0;
    SPR[i] = cnt > 0 ? (sr_ / cnt) * nm2 : 0;
    pl = SLD[i]; pl += sp_ea * (li - pl); SLD[i] = max(-120, min(0, sanitize64(pl)));
    pr = SRD[i]; pr += sp_ea * (ri - pr); SRD[i] = max(-120, min(0, sanitize64(pr)));
    SAVG[i] = 0.5 * (SLD[i] + SRD[i]);
    pw = SRMP[i];
    mid = 0.5 * (SPL[i] + SPR[i]);
    pw += sp_ra2 * (mid - pw);
    SRMP[i] = pw;
    pw > 0.00000000000000000001 ? ( db = 10 * log10(pw); SRMS[i] = max(-120, min(0, db)); ) : ( SRMS[i] = -120; );
    mid = 0.5 * (li + ri);
    mid > SMAX[i] ? SMAX[i] = mid;
    i += 1;
  );
);

function sp_feed(l, r)
(
  SRL[sp_pos] = l; SRR[sp_pos] = r;
  sp_pos += 1; sp_pos >= sp_fft ? sp_pos = 0;
  sp_hc += 1;
  sp_hc >= sp_hop ? ( sp_hc = 0; sp_hopdo(); );
);

function sp_resetpeaks() local(i)
( i = 0; loop(SPMAX, SMAX[i] = -120; i += 1; ); );

