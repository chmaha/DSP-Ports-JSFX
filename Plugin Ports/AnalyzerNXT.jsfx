  i = 0;
  loop(ft_gn / 2,
    L = FTG[i * 2]; R = FTG[i * 2 + 1];
    mx = (L + R) * 0.70710678; sx = (L - R) * 0.70710678;
    px = cx + sx * rr; py = cy - mx * rr;
