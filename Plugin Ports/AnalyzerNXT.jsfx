  hexc(0x0066ff, 0.18); grect(888, 675.5, 119, 9);
  c < 0 ? ( hexc(0xff0066, 1); grect(888 + c * 119, 675.5, -c * 119, 9); ) : ( hexc(0x0066ff, 1); grect(888, 675.5, c * 119, 9); );
  gfont(9, 0); hexc(0x9498a2, 1);
  i = 0;
