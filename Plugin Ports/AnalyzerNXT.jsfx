function ggonio() local(i, cx, cy, rr, L, R, mx, sx, px, py, t, w, h, c)
(
  hexc(0x0a0d10, 1); grr(760, 457, 256, 255, 3);
  w = 238; h = 209;
  hexc(0x000000, 1); grr(769, 465, w, h, 3);
