    t = i === 0 ? -1 : i === 1 ? -0.7 : i === 2 ? -0.5 : i === 3 ? -0.2 : i === 4 ? 0 : i === 5 ? 0.2 : i === 6 ? 0.5 : i === 7 ? 0.7 : 1;
    txt_cc(888 + t * 119 + (i === 0 ? 4 : i === 8 ? -5 : 0), 696.5, i === 4 ? "0.0" : sprintf(#gv, t > 0 ? "+%.1f" : "%.1f", t));
    i += 1;
