function gknob(cx, cy, r, s, tp, lo, hi, df, base, fm, en, kd, name) local(v, p, pbs, a0, av, ab, th, px1, py1, px2, py2, hit, k, ln, lv, lp, la, fs, al, noff, nf, nw, nh, lw, lh, lx, ly, pdw, pdh, plw, bs, lm, ta, ux, uy, asp)
