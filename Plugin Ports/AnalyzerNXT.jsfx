function gmy_db(db) ( 211.4 + 216.6 * (6 - db) / 66; );

function gmbar_seg(x, w, yv, yb, y0, y1, al) local(k, n, ya, yc, t0, t1, hp)
(
  n = 8; k = 0;
  loop(n,
    ya = y1 - (y1 - y0) * (k + 1) / n; yc = y1 - (y1 - y0) * k / n;
    ya = max(ya, yv); yc = min(yc, yb);
    yc > ya ? (
      t0 = min(1, 1.55 * (y1 - yc) / (y1 - y0)); t1 = min(1, 1.55 * (y1 - ya) / (y1 - y0));
      hp = (yc - ya) * gsc + 1;
      gfx_gradrect(gxp(x), gyp(ya), w * gsc, hp,
        TC[24] + (TC[30] - TC[24]) * t1, TC[25] + (TC[31] - TC[25]) * t1, TC[26] + (TC[32] - TC[26]) * t1, al,
        0, 0, 0, 0,
        (TC[30] - TC[24]) * (t0 - t1) / hp, (TC[31] - TC[25]) * (t0 - t1) / hp, (TC[32] - TC[26]) * (t0 - t1) / hp, 0);
    );
    k += 1;
  );
);

function gmy_db(db) ( 211.4 + 216.6 * (6 - db) / 66; );

function gmbar_seg(x, w, yv, yb, y0, y1) local(k, n, ya, yc, t0, t1)
(
  n = 8; k = 0;
  loop(n,
    ya = y1 - (y1 - y0) * (k + 1) / n; yc = y1 - (y1 - y0) * k / n;
    ya = max(ya, yv); yc = min(yc, yb);
    yc > ya ? (
      t0 = min(1, 1.55 * (y1 - yc) / (y1 - y0)); t1 = min(1, 1.55 * (y1 - ya) / (y1 - y0));
      gfx_gradrect(gxp(x), gyp(ya), w * gsc, (yc - ya) * gsc + 1,
        TC[24] + (TC[30] - TC[24]) * t1, TC[25] + (TC[31] - TC[25]) * t1, TC[26] + (TC[32] - TC[26]) * t1, 0.95,
        0, 0, 0, 0,
        (TC[30] - TC[24]) * (t0 - t1) / ((yc - ya) * gsc), (TC[31] - TC[25]) * (t0 - t1) / ((yc - ya) * gsc), (TC[32] - TC[26]) * (t0 - t1) / ((yc - ya) * gsc), 0);
    );
    k += 1;
  );
);

function gmbar(x, w, v, base, ymin, ymax) local(y0, y1, yb, yv, i3)
(
  y0 = 211.4; y1 = 428;
  hexc(0x15181d, 1); grect(x, y0, w, y1 - y0);
  gmbar_seg(x, w, y0, y1, y0, y1, 0.18);
  hexc(0xff6600, 0.2); grect(x, y0, w, gmy_db(0) - y0);
  hexc(0xffffff, 0.12);
  i3 = 0; loop(23, ghl(x, gmy_db(6 - i3 * 3), w); i3 += 1; );
  v > -90 ? (
    yv = gmy_db(max(-60, min(6, v)));
    yb = gmy_db(max(-60, base));
    yb > yv ? (
      gmbar_seg(x, w, yv, yb, y0, y1, 0.95);
    );
  );
);

function gmeters() local(i, db, lab, x, hv)
(
  hexc(0x0a0d10, 1); grr(760, 203.5, 256, 244.5, 3);
