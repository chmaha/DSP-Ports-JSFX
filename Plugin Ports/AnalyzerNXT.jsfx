@slider
last_srate !== srate ? (
  last_srate = srate;
  ld_design(srate);
  ld_reset();
  ft_setsr(srate);
  sp_fft = 0;
  sp_setfft(FFTSZ[max(0, min(3, floor(g_fft + 0.5)))]);
  sp_reset();
);

@block
bypass = g_bypass >= 0.5;
ld_paused = g_hold >= 0.5;
want_fft = FFTSZ[max(0, min(3, floor(g_fft + 0.5)))];
want_fft !== sp_fft ? sp_setfft(want_fft);
gui_beat !== gb_prev ? ( gb_prev = gui_beat; gb_idle = 0; ) : gb_idle += 1;
viz_on = viz_force || gb_idle < 40;
in_g = bypass ? 1 : (10 ^ (g_in * (0.05)));
out_g = bypass ? 1 : (10 ^ (g_out * (0.05)));
rp_req !== rp_seen ? ( rp_seen = rp_req; sp_resetpeaks(); );
rs_req !== rs_seen ? ( rs_seen = rs_req; ld_reset(); );
(bypass && viz_on) ? ( sp_reset(); ft_reset(); );

@sample
inL = (spl0 * in_g); inR = (spl1 * in_g);
mt_il = max(mt_il, abs(inL)); mt_ir = max(mt_ir, abs(inR));
(!bypass && viz_on) ? ( sp_feed(inL, inR); ft_proc(inL, inR); );
outL = (inL * out_g); outR = (inR * out_g);
ld_proc(outL, outR);
gui_beat !== ld_gb ? ( ld_snap(); ld_gb = gui_beat; );
mt_ol = max(mt_ol, abs(outL)); mt_or = max(mt_or, abs(outR));
spl0 = outL; spl1 = outR;

@gfx 1024 740

grr_hl = 0;
gW = 1024; gH = 740;
gsc = max(0.4, min(gfx_w / gW, gfx_h / gH));
gox = floor((gfx_w - gW * gsc) * 0.5);
goy = 0;
gwheel = mouse_wheel; mouse_wheel = 0;
gui_beat += 1;
