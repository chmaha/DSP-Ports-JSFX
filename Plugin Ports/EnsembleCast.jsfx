function hint_text(h)
(
  h == 1 ? strcpy(#uhint, "Scale: picks one of ten scales in the bank set by the Scale switch")
  : h == 2 ? strcpy(#uhint, "Spread: how far apart the oscillators are along the scale")
  : h == 3 ? strcpy(#uhint, "Pitch: transposes everything by up to three octaves (MIDI notes add to it)")
  : h == 4 ? strcpy(#uhint, "Balance: left = low oscillators louder, right = high oscillators louder")
  : h == 5 ? strcpy(#uhint, "Root: the lowest note the scale is built on")
  : h == 6 ? strcpy(#uhint, "Cross FM: oscillators modulate each other (switch: Up, All or Down the chain)")
  : h == 7 ? strcpy(#uhint, "Twist: Ramp = feedback, Pulsar = squeezed cycles, Crush = bit mangling")
  : h == 8 ? strcpy(#uhint, "Detune: spreads the oscillators slightly out of tune for beating")
  : h == 9 ? strcpy(#uhint, "Warp: Fold = wavefolder, Cheb = Chebyshev harmonics, Segment = piecewise shapes")
  : h == 10 ? strcpy(#uhint, "Scale switch: 12TET, Octave (just, harmonic, N-TET) or Free (non-octave) bank")
  : h == 11 ? strcpy(#uhint, "Cross FM switch: each oscillator modulates the next one up, all in a chain, or down")
  : h == 12 ? strcpy(#uhint, "Twist mode: Ramp (feedback), Pulsar or Crush")
  : h == 13 ? strcpy(#uhint, "Warp mode: Fold, Cheb or Segment")
  : h == 14 ? strcpy(#uhint, "Freeze split: which oscillators Freeze holds")
  : h == 15 ? strcpy(#uhint, "Stereo split: which oscillators go to Out A (left) and Out B (right)")
  : h == 16 ? strcpy(#uhint, "Crossfade: how smoothly each oscillator glides between scale notes")
  : h == 17 ? strcpy(#uhint, "Oscillators: pairs per voice (32 pairs shared by all voices)")
  : h == 18 ? strcpy(#uhint, "Fine tune: +/- 2 semitones")
  : h == 19 ? strcpy(#uhint, "Voices: how many MIDI notes play at once (each voice gets its share of the oscillators)")
  : h == 20 ? strcpy(#uhint, "Freeze note: hold this MIDI note to toggle Freeze (like the Freeze gate)")
  : h == 21 ? strcpy(#uhint, "Learn note: works like the Learn gate jack (a note is learned when it is released)")
  : h == 22 ? strcpy(#uhint, "Notes gate Learn: every played note also gates Learn, so learning needs no extra note")
