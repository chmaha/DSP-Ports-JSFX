  s == 1 ? "Scale" : s == 2 ? "Spread" : s == 3 ? "Pitch" : s == 4 ? "Balance" : s == 5 ? "Root" : s == 6 ? "Cross FM" :
  s == 7 ? "Twist" : s == 8 ? "Detune" : s == 9 ? "Warp" : s == 16 ? "Crossfade" : "Fine Tune";
