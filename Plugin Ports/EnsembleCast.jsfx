desc: Ensemble Cast (4ms Ensemble Oscillator port) by chmaha
tags: instrument synthesizer oscillator drone additive
author: chmaha
version: 1.0
changelog:
  Initial release.
about:
  An additive drone oscillator: up to 16 pairs of sine oscillators per voice, tuned to a scale, spread across the
  stereo field, cross-modulated and shaped. It always sounds; MIDI notes transpose it.
  Root and Pitch set the base note, Spread the interval between oscillators, Balance the tilt between low and high
  oscillators, Detune the beating, Cross FM the frequency modulation between oscillators, Twist (Ramp, Pulsar,
  Crush) and Warp (Fold, Cheby, Segment) the waveshape. Scale picks one of ten scales in three banks (12TET, Octave,
  Free). Freeze holds the pitches of half the oscillators (Freeze Split). Learn records your own scale: press Learn,
  play notes, press Learn again (hold Learn for a second to restore the factory scale).
  MIDI: notes drive up to 4 voices (0 V = middle C). The Freeze note (C2) and the Learn note (C#2) work like the
  Freeze and Learn gate jacks; with Notes Gate Learn on, every played note also gates Learn.
  Ported from the 4ms Ensemble Oscillator module of 4ms CoreModules (MetaModule / VCV Rack, 4ms Company,
  https://github.com/4ms/metamodule-core-modules, GPLv3+), original firmware by Matthias Puech.
  JSFX version released under GPLv3+ license
  Claude generated some of this code

slider1:k_scale=0.453125<0,1,0.001>-Scale
slider2:k_spread=0.375<0,1,0.001>-Spread
slider3:k_pitch=0.5<0,1,0.001>-Pitch
slider4:k_balance=0.5<0,1,0.001>-Balance
slider5:k_root=0.5<0,1,0.001>-Root
slider6:k_xfm=0<0,1,0.001>-Cross FM
slider7:k_twist=0<0,1,0.001>-Twist
slider8:k_detune=0<0,1,0.001>-Detune
slider9:k_warp=0<0,1,0.001>-Warp
slider10:sw_scale=2<0,2,1{Free,Octave,12TET}>-Scale Bank
slider11:sw_xfm=2<0,2,1{Down,All,Up}>-Cross FM Mode
slider12:sw_twist=0<0,2,1{Crush,Pulsar,Ramp}>-Twist Mode
slider13:sw_warp=2<0,2,1{Segment,Cheby,Fold}>-Warp Mode
slider14:a_fzs=0<0,2,1{Even/Odd,Low/High,Root/Others}>-Freeze Split
slider15:a_sts=0<0,2,1{Even/Odd,Low/High,Root/Others}>-Stereo Split
slider16:a_xf=0.5<0,1,0.001>-Crossfade
slider17:a_nosc=16<1,16,1>-Oscillators
slider18:a_fine=0.5<0,1,0.001>-Fine Tune
slider19:voices=4<1,4,1>-Voices
slider20:frz_note=36<0,127,1>-Freeze Note
slider21:lrn_note=37<0,127,1>-Learn Note
slider22:note_lrn=1<0,1,1{Off,On}>-Notes Gate Learn

in_pin:none
out_pin:Out A (left)
out_pin:Out B (right)
options:maxmem=1048576 no_meter

@init

function f32k(x) local(c) ( c = x * 536870913; c - (c - x); );
function alloc(n) local(r) instance(mp) global() ( r = mp; mp += n; memset(r, 0, n); r; );
function trunc(x) ( x < 0 ? -floor(-x) : floor(x); );
function u32w(x) ( x - 4294967296 * floor(x / 4294967296); );

K_PI = (13176795 / 4194304);
K_EXPINC = (524643 / 524288);
K_16O2PI = (10680707 / 4194304);
K_0225 = (7549747 / 33554432);
K_092 = (15435039 / 16777216);
K_1EM5 = (2748779 / 274877906944);
K_0004 = (8589935 / 2147483648);
K_0005 = (5368709 / 1073741824);
K_1O1024 = (1 / 1024);
K_01 = (13421773 / 134217728);
K_M01 = -(13421773 / 134217728);
K_M12 = -(5033165 / 4194304);
K_07 = (11744051 / 16777216);
K_06 = (5033165 / 8388608);
K_005 = (13421773 / 268435456);
K_DCC = (8346665 / 8388608);
K_DCG = (16735273 / 16777216);
K_001 = (5368709 / 536870912);
K_098 = (2055209 / 2097152);
K_099 = (4152361 / 4194304);
K_09 = (7549747 / 8388608);
K_0125 = (1 / 8);
K_04 = (13421773 / 33554432);
K_NNDELAY = 15;
LED_BLACK = 0;
LED_LEMON = 8421376;
LED_WHITE = 16777215;
LED_BLUE = 204;
LED_DRED = 8323084;
LED_GREEN = 65280;

SAD = alloc(513);
CHB = alloc(16 * 513);
FA = alloc(1025); FD = alloc(1025);
FMX = alloc(513);
TRI = alloc(80);
EX2 = alloc(1024);
POW2 = alloc(256);
NF = alloc(17);
SCL = alloc(3 * 10 * 33);
DSCL = alloc(3 * 10 * 33);
PSV = alloc(33);

PH = alloc(96); LPS = alloc(96); FDV = alloc(96); TWV = alloc(96); WAV = alloc(96); MDV = alloc(96);
SLC = alloc(32); F1S = alloc(32); F2S = alloc(32); XFS = alloc(32); XLP = alloc(32);
MODB = alloc(33 * 32);
ZB = alloc(32);
OB1 = alloc(4 * 32); OB2 = alloc(4 * 32);
FRL = alloc(4 * 32); FRR = alloc(4 * 32);
DCX1 = alloc(4); DCY1 = alloc(4); DCX2 = alloc(4); DCY2 = alloc(4);
ROOTC = alloc(4); PITCHC = alloc(4);
ADC = alloc(16);
SPIP = alloc(4); SPIR = alloc(4);
PCR = alloc(4 * 16); PCC = alloc(4); PCI = alloc(4 * 4);
RCR = alloc(4 * 8); RCC = alloc(4); RCI = alloc(4 * 2);
RHY = alloc(4); PSB = alloc(4);
EVT = alloc(64); EVD = alloc(64);
PVOLT = alloc(4);
POTF = alloc(16); POTP = alloc(16); SUMF = alloc(16);
LEDC = alloc(16);

function fexp2(x) local(y, e) ( y = x + 127; e = floor(y); POW2[e] * EX2[floor((y - e) * 1024)]; );
function fexp2k(x) local(y, e) ( y = f32k(x + 127); e = floor(y); POW2[e] * EX2[floor((y - e) * 1024)]; );

function of_pitch(p) ( ((fexp2(((p - 69) / 12)) * 440) / p_sr); );

function tables_init() local(i, n, sz, cz, fq, prev, x, g, p, y, mx, k, fv, v)
(
  i = 0; loop(256, POW2[i] = 2 ^ (i - 127); i += 1; );
  x = 1; i = 0; loop(1024, EX2[i] = x; x = f32k(x * K_EXPINC); i += 1; );
  fq = f32k(f32k(2 * K_PI) * f32k(1 / 512));
  sz = 0; cz = 1;
  sz = f32k(sz + f32k(fq * cz)); cz = f32k(cz - f32k(fq * sz));
  prev = trunc(f32k(sz * 32767));
  i = 0;
  loop(513,
    sz = f32k(sz + f32k(fq * cz)); cz = f32k(cz - f32k(fq * sz));
    v = trunc(f32k(sz * 32767));
    SAD[i] = (prev + 32768) * 65536 + (v - prev + 32768);
    prev = v;
    i += 1;
  );
  i = 0; loop(513, CHB[i] = f32k(f32k(i * 2 / 512) - 1); i += 1; );
  i = 0; loop(513, x = CHB[i]; CHB[513 + i] = f32k(f32k(f32k(2 * x) * x) - 1); i += 1; );
  n = 2;
  loop(14,
    i = 0;
    loop(513, CHB[n * 513 + i] = f32k(f32k(f32k(2 * CHB[i]) * CHB[(n - 1) * 513 + i]) - CHB[(n - 2) * 513 + i]); i += 1; );
    n += 1;
  );
  prev = 0; i = 0;
  loop(1025,
    x = f32k(i / 1022);
    x = f32k(6 * f32k(f32k(2 * x) - 1));
    g = f32k(1 / f32k(1 + abs(x)));
    p = f32k(f32k(K_16O2PI * x) * g);
    while (p > 1) ( p = f32k(p - 1); );
    while (p < 0) ( p = f32k(p + 1); );
    y = f32k(f32k(p * 2) - 1);
    y = f32k(4 * f32k(y - f32k(y * abs(y))));
    y = f32k(f32k(K_0225 * f32k(f32k(y * abs(y)) - y)) + y);
    x = f32k(-g * f32k(x + y));
    i === 0 ? ( FA[0] = x; FD[0] = 0; ) : ( FA[i] = prev; FD[i] = f32k(x - prev); );
    prev = x;
    i += 1;
  );
  mx = 0; i = 0;
  loop(513,
    v = abs(FA[i + 512]);
    mx = mx < v ? v : mx;
    FMX[i] = f32k(K_092 / f32k(mx + K_1EM5));
    i += 1;
  );
  TRI[0] = -1; TRI[1] = -(3 / 4); TRI[2] = -(1 / 2); TRI[3] = -(1 / 4); TRI[4] = 0; TRI[5] = (1 / 4); TRI[6] = (1 / 2); TRI[7] = (3 / 4); TRI[8] = 1; TRI[9] = -1; TRI[10] = -1; TRI[11] = -(11184811 / 16777216); TRI[12] = -(11184811 / 33554432); TRI[13] = 0; TRI[14] = (11184811 / 33554432); TRI[15] = (11184811 / 16777216); TRI[16] = 1; TRI[17] = 1; TRI[18] = -1; TRI[19] = -1; TRI[20] = -1; TRI[21] = -(1 / 2); TRI[22] = 0; TRI[23] = (1 / 2); TRI[24] = 1; TRI[25] = 1; TRI[26] = 1; TRI[27] = -1; TRI[28] = -1; TRI[29] = -1; TRI[30] = -1; TRI[31] = 0; TRI[32] = 1; TRI[33] = 1; TRI[34] = 1; TRI[35] = 1; TRI[36] = -1; TRI[37] = -(1 / 2); TRI[38] = -1; TRI[39] = -(1 / 2); TRI[40] = 0; TRI[41] = (1 / 2); TRI[42] = 1; TRI[43] = (1 / 2); TRI[44] = 1; TRI[45] = -1; TRI[46] = -(1 / 2); TRI[47] = 0; TRI[48] = -1; TRI[49] = 0; TRI[50] = 1; TRI[51] = 0; TRI[52] = (1 / 2); TRI[53] = 1; TRI[54] = -1; TRI[55] = -(1 / 2); TRI[56] = 1; TRI[57] = -1; TRI[58] = 0; TRI[59] = 1; TRI[60] = -1; TRI[61] = (1 / 2); TRI[62] = 1; TRI[63] = 1; TRI[64] = -1; TRI[65] = 1; TRI[66] = -1; TRI[67] = 0; TRI[68] = 1; TRI[69] = -1; TRI[70] = 1; TRI[71] = -1;
  NF[0] = 0; NF[1] = -(13421773 / 33554432); NF[2] = (11199393 / 8589934592); NF[3] = (1049601 / 1073741824); NF[4] = (13463847 / 4294967296); NF[5] = (2113665 / 268435456); NF[6] = (9761289 / 536870912); NF[7] = (16760321 / 536870912); NF[8] = (6408759 / 134217728); NF[9] = (8947849 / 134217728); NF[10] = (2942007 / 33554432); NF[11] = (458965 / 4194304); NF[12] = (278383 / 2097152); NF[13] = (5251339 / 33554432); NF[14] = (12134075 / 67108864); NF[15] = (3446291 / 16777216); NF[16] = (7719985 / 33554432);
  DSCL[0] = 0; DSCL[1] = 12; DSCL[32] = 2;
  DSCL[33] = 0; DSCL[34] = 7; DSCL[35] = 12; DSCL[65] = 3;
  DSCL[66] = 0; DSCL[67] = 4; DSCL[68] = 7; DSCL[69] = 12; DSCL[98] = 4;
  DSCL[99] = 0; DSCL[100] = 3; DSCL[101] = 7; DSCL[102] = 12; DSCL[131] = 4;
  DSCL[132] = 0; DSCL[133] = 3; DSCL[134] = 5; DSCL[135] = 7; DSCL[136] = 12; DSCL[164] = 5;
  DSCL[165] = 0; DSCL[166] = 3; DSCL[167] = 5; DSCL[168] = 10; DSCL[169] = 12; DSCL[197] = 5;
  DSCL[198] = 0; DSCL[199] = 1; DSCL[200] = 5; DSCL[201] = 8; DSCL[202] = 12; DSCL[230] = 5;
  DSCL[231] = 0; DSCL[232] = 7; DSCL[263] = 2;
  DSCL[264] = 0; DSCL[265] = 3; DSCL[266] = 5; DSCL[267] = 7; DSCL[296] = 4;
  DSCL[297] = 0; DSCL[298] = 1; DSCL[329] = 2;
  DSCL[330] = 0; DSCL[331] = (14721063 / 2097152); DSCL[332] = 12; DSCL[362] = 3;
  DSCL[363] = 0; DSCL[364] = (4050793 / 1048576); DSCL[365] = (14721063 / 2097152); DSCL[366] = (2539719 / 262144); DSCL[367] = 12; DSCL[395] = 5;
  DSCL[396] = 0; DSCL[397] = (8552605 / 4194304); DSCL[398] = (4050793 / 1048576); DSCL[399] = (11561975 / 2097152); DSCL[400] = (14721063 / 2097152); DSCL[401] = (8813571 / 1048576); DSCL[402] = (2539719 / 262144); DSCL[403] = (11411325 / 1048576); DSCL[404] = 12; DSCL[428] = 9;
  DSCL[429] = 0; DSCL[430] = (14721063 / 2097152); DSCL[431] = (16633705 / 1048576); DSCL[432] = (5685447 / 262144); DSCL[433] = (3412997 / 131072); DSCL[434] = (7736703 / 262144); DSCL[435] = (8494849 / 262144); DSCL[436] = (9144287 / 262144); DSCL[437] = 36; DSCL[461] = 9;
  DSCL[462] = 0; DSCL[463] = (10444761 / 2097152); DSCL[464] = (14721063 / 2097152); DSCL[465] = 12; DSCL[494] = 4;
  DSCL[495] = 0; DSCL[496] = (8552605 / 4194304); DSCL[497] = (10444761 / 2097152); DSCL[498] = (14721063 / 2097152); DSCL[499] = (9498683 / 1048576); DSCL[500] = 12; DSCL[527] = 6;
  DSCL[528] = 0; DSCL[529] = (10444761 / 2097152); DSCL[530] = (14721063 / 2097152); DSCL[531] = (9273173 / 1048576); DSCL[532] = 12; DSCL[560] = 5;
  DSCL[561] = 0; DSCL[562] = (4050793 / 1048576); DSCL[563] = (10444761 / 2097152); DSCL[564] = (14721063 / 2097152); DSCL[565] = (9273173 / 1048576); DSCL[566] = (2539719 / 262144); DSCL[567] = 12; DSCL[593] = 7;
  DSCL[594] = 0; DSCL[595] = (5033165 / 2097152); DSCL[596] = (5033165 / 1048576); DSCL[597] = (7549747 / 1048576); DSCL[598] = (5033165 / 524288); DSCL[599] = 12; DSCL[626] = 6;
  DSCL[627] = 0; DSCL[628] = (14380471 / 8388608); DSCL[629] = (14380471 / 4194304); DSCL[630] = (10785353 / 2097152); DSCL[631] = (14380471 / 2097152); DSCL[632] = (4493897 / 524288); DSCL[633] = (10785353 / 1048576); DSCL[634] = 12; DSCL[659] = 8;
  DSCL[660] = 0; DSCL[661] = (14721063 / 2097152); DSCL[692] = 2;
  DSCL[693] = 0; DSCL[694] = 2; DSCL[725] = 2;
  DSCL[726] = 0; DSCL[727] = 1; DSCL[728] = 3; DSCL[758] = 3;
  DSCL[759] = 0; DSCL[760] = 2; DSCL[761] = 3; DSCL[762] = 4; DSCL[791] = 4;
  DSCL[792] = 0; DSCL[793] = 1; DSCL[794] = 2; DSCL[795] = 5; DSCL[796] = 6; DSCL[824] = 5;
  DSCL[825] = 0; DSCL[826] = (1534111 / 1048576); DSCL[827] = (1534111 / 524288); DSCL[828] = (4602333 / 1048576); DSCL[829] = (1534111 / 262144); DSCL[830] = (15341111 / 2097152); DSCL[831] = (4602333 / 524288); DSCL[832] = (10738777 / 1048576); DSCL[833] = (1534111 / 131072); DSCL[834] = (13806999 / 1048576); DSCL[835] = (15341111 / 1048576); DSCL[836] = (8437611 / 524288); DSCL[837] = (4602333 / 262144); DSCL[838] = (4985861 / 262144); DSCL[857] = 14;
  DSCL[858] = 0; DSCL[859] = (4602333 / 524288); DSCL[860] = (15341111 / 1048576); DSCL[861] = (4985861 / 262144); DSCL[890] = 4;
  DSCL[891] = 0; DSCL[892] = (1534111 / 262144); DSCL[893] = (15341111 / 1048576); DSCL[894] = (4985861 / 262144); DSCL[923] = 4;
  DSCL[924] = 0; DSCL[925] = (3271557 / 4194304); DSCL[956] = 2;
  DSCL[957] = 0; DSCL[958] = (1337983 / 2097152); DSCL[989] = 2;
