@slider

srate !== cur_sr ? ( cur_sr = srate; eng_set_sr(srate); );
set_inputs();

@block

srate !== cur_sr ? ( cur_sr = srate; eng_set_sr(srate); );
set_inputs();
mq_n = 0;
while (midirecv(mofs, m1, m2, m3)) (
  mq_n < 1300 ? ( MQ[mq_n * 3] = mofs; MQ[mq_n * 3 + 1] = m1; MQ[mq_n * 3 + 2] = m2 + m3 * 256; mq_n += 1; );
  midisend(mofs, m1, m2, m3);
