ltext("Ensemble Cast", 592, 26, 24, 'b');
gfx_set(0.15, 0.64, 0.88, 1);
ltext("4ms Ensemble Oscillator", 593, 58, 12, 0);
gfx_set(0.62, 0.64, 0.68, 1);
ltext("by chmaha", 593, 74, 12, 0);

glabel("SCALE", 592, 96);
scale_view(592, 113, 200, 54);

glabel("VOICES", 592, 176);
cells(19, 193, 4, "1", "2", "3", "4");
u_i = 0;
loop(4,
  u_i < pitch_chans ? (
    gfx_set(VN[u_i] >= 0 ? 0.92 : 0.56, VN[u_i] >= 0 ? 0.93 : 0.58, VN[u_i] >= 0 ? 0.95 : 0.62, 1);
    u_nv = PVOLT[u_i] * 12 + 60;
    ctextm(notename(floor(u_nv + 0.5)), (gcol(u_i, 4) + gcol(u_i + 1, 4)) * 0.5, py(229), 11, 0);
  );
  u_i += 1;
);

