bpos = 0;

@sample

spl0 = OBL[bpos]; spl1 = OBR[bpos];
bpos += 1;

@serialize

sv_ver = 1;
file_var(0, sv_ver);
file_mem(0, SCL, 3 * 10 * 33);

@gfx 820 630

UDW = 820;
UDH = 630;
uscale = max(0.5, min(gfx_w / UDW, gfx_h / UDH));
uox = floor((gfx_w - UDW * uscale) * 0.5);
uoy = 0;

