mq_p = 0; s = 0;
loop(samplesblock,
  while (mq_p < mq_n && MQ[mq_p * 3] <= s) (
    m1 = MQ[mq_p * 3]; mt = MQ[mq_p * 3 + 1] & 240; m2 = MQ[mq_p * 3 + 2] & 255; m3 = floor(MQ[mq_p * 3 + 2] / 256);
