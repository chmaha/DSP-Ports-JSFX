function scl_base(m, v) ( SCL + (m * 10 + v) * 33; );

function scale_proc(SCQ, pitch) local(sz, mx, oc, octs, semi, lo, hi, mid, p1, p2, cf, t)
(
  sz = SCQ[32];
  mx = SCQ[sz - 1];
  oc = trunc((pitch / mx));
  octs = (oc * mx);
  semi = (pitch - octs);
  lo = 0; hi = sz - 1;
  while (lo + 1 < hi) ( mid = floor((lo + hi) / 2); semi < SCQ[mid] ? hi = mid : lo = mid; );
  p1 = SCQ[lo]; p2 = SCQ[lo + 1];
  cf = ((semi - p1) / (p2 - p1));
  p1 = (p1 + octs); p2 = (p2 + octs);
  (lo + oc * (sz + 1)) & 1 ? ( cf = (1 - cf); t = p1; p1 = p2; p2 = t; );
  sp_p1 = p1; sp_p2 = p2; sp_cf = cf;
);

function osc_prep(frq, fade, tw_in, wa_in, md_in, tv0, wv0, mv0, fv0) local(ff, sq, fv, t)
(
  ff = (1 - (2 * frq)); ff < 0 ? ff = 0; sq = (ff * ff);
  fv = (1 - ((4 * frq) * frq)); fv < 0 ? fv = 0;
  q_fade = (fade * fv);
  q_md = (md_in * sq);
  o_tm === 0 ? q_tw = (tw_in * sq) : o_tm === 1 ? (
    t = (sq * sq); t = (t * t); t = (t * t);
    q_tw = (((tw_in - 1) * t) + 1);
  ) : q_tw = tw_in;
  o_wm === 0 ? (
    t = (1 - (8 * frq)); t < 0 ? t = 0; t = (t * t); t = (t * t);
    q_wa = (wa_in * t); q_wa < K_0004 ? q_wa = K_0004;
  ) : o_wm === 1 ? (
    t = (1 - (6 * frq)); t < 0 ? t = 0;
    q_wa = (wa_in * t);
  ) : (
    t = (1 - (4 * frq)); t = ((t * t) * t); t < 0 ? t = 0;
    q_wa = (wa_in * t);
  );
  q_ti = ((q_tw - tv0) * 0.03125);
  q_wi = ((q_wa - wv0) * 0.03125);
  q_mi = ((q_md - mv0) * 0.03125);
  q_fi = ((q_fade - fv0) * 0.03125);
  q_fr = u32w(trunc((frq * 4294967296)));
);

function osc_run(o, frq, fade, amp, tw_in, wa_in, md_in, OUT)
  local(fr, phv, lp, fv, fi, tv, ti, wv, wi, mv, mi, i, m, p, x, e, k, q, fbv, t, smp, ii, fr2, ip, a, b, v, am, u, g, sf, fmv, C1, C2, R1)
(
  tv = TWV[o]; wv = WAV[o]; mv = MDV[o]; fv = FDV[o];
  osc_prep(frq, fade, tw_in, wa_in, md_in, tv, wv, mv, fv);
  ti = q_ti; wi = q_wi; mi = q_mi; fi = q_fi; fr = q_fr;
  phv = PH[o]; lp = LPS[o];
  i = 0;
  o_tm === 0 && o_wm === 0 ? (
    wi === 0 && wv > K_0005 ? ( ip = (wv * 512); ii = floor(ip); fmv = (FMX[ii] + ((FMX[ii + 1] - FMX[ii]) * (ip - ii))); );
    loop(32,
      m = 0;
      phv += fr; phv >= 4294967296 ? phv -= 4294967296;
      p = phv + m; p >= 4294967296 ? p -= 4294967296;
      tv = (tv + ti); wv = (wv + wi);
      fbv = tv * 65536; fbv = fbv < 0 ? -floor(-fbv) : floor(fbv);
      p = p + lp * floor(fbv / 2) * 4 + fbv * 65536; p = p - 4294967296 * floor(p / 4294967296);
      k = floor(p / 8388608); t = floor((p - k * 8388608) / 256);
      e = SAD[k]; a = floor(e / 65536);
      x = a - 32768 + floor((e - a * 65536 - 32768) * t * (1 / 32768));
      lp = lp + floor(x / 4) - floor(lp / 4);
      wv <= K_0005 ? smp = (x / 32767) : (
        sf = x * floor((wv * 32768)) * 2 + 2147483648; sf >= 4294967296 ? sf -= 4294967296 : sf < 0 ? sf += 4294967296;
        k = floor(sf / 4194304);
        smp = (FA[k] + (FD[k] * ((sf - k * 4194304) * (1 / 4194304))));
        wi !== 0 ? ( ip = (wv * 512); ii = floor(ip); fmv = (FMX[ii] + ((FMX[ii + 1] - FMX[ii]) * (ip - ii))); );
        smp = (smp * fmv);
      );
      fv = (fv + fi); smp = (smp * fv);
      mv = (mv + mi);
      OUT[i] = (OUT[i] + (smp * amp));
      i += 1;
    )
  ) :
  o_tm === 0 && o_wm === 1 ? (
    wi === 0 ? ( am = (wv * 14); ii = am < 0 ? -floor(-am) : floor(am); fr2 = (am - ii); R1 = CHB + ii * 513; );
    loop(32,
      m = 0;
      phv += fr; phv >= 4294967296 ? phv -= 4294967296;
      p = phv + m; p >= 4294967296 ? p -= 4294967296;
      tv = (tv + ti); wv = (wv + wi);
      fbv = tv * 65536; fbv = fbv < 0 ? -floor(-fbv) : floor(fbv);
      p = p + lp * floor(fbv / 2) * 4 + fbv * 65536; p = p - 4294967296 * floor(p / 4294967296);
      k = floor(p / 8388608); t = floor((p - k * 8388608) / 256);
      e = SAD[k]; a = floor(e / 65536);
      x = a - 32768 + floor((e - a * 65536 - 32768) * t * (1 / 32768));
      lp = lp + floor(x / 4) - floor(lp / 4);
      wi !== 0 ? ( am = (wv * 14); ii = am < 0 ? -floor(-am) : floor(am); fr2 = (am - ii); R1 = CHB + ii * 513; );
      u = x + 32768; k = floor(u / 128); g = (u - k * 128) * (1 / 128);
      C1 = R1 + k; C2 = C1 + 513;
      a = (C1[0] + ((C1[1] - C1[0]) * g));
      b = (C2[0] + ((C2[1] - C2[0]) * g));
      smp = (a + ((b - a) * fr2));
      fv = (fv + fi); smp = (smp * fv);
      mv = (mv + mi);
      OUT[i] = (OUT[i] + (smp * amp));
      i += 1;
    )
  ) :
  o_tm === 0 && o_wm === 2 ? (
    wi === 0 ? ( am = (wv * 7); ii = am < 0 ? -floor(-am) : floor(am); fr2 = (am - ii); R1 = TRI + ii * 9; );
