  ) : m == 1 ? (
    i == 0 ? "Harmonics 2-3" : i == 1 ? "Harmonics 4-7" : i == 2 ? "Harmonics 8-15" : i == 3 ? "Odd harmonics 1-8" : i == 4 ? "Do Fa So" : i == 5 ? "Do Re Fa So La" : i == 6 ? "Just ratios 1" : i == 7 ? "Just ratios 2" : i == 8 ? "5-TET" : "7-TET";
  ) : (
    i == 0 ? "Fifths spiral" : i == 1 ? "Whole tones" : i == 2 ? "Messiaen 2" : i == 3 ? "Messiaen 3" : i == 4 ? "Messiaen 4" : i == 5 ? "Bohlen-Pierce" : i == 6 ? "B-P major triad" : i == 7 ? "B-P minor triad" : i == 8 ? "Wendy Carlos alpha" : "Wendy Carlos beta";
  );
);

function scshort(m, i)
(
  m == 0 ? (
    i == 0 ? "Octaves" : i == 1 ? "Oct + fifths" : i == 2 ? "Major triad" : i == 3 ? "Minor triad" : i == 4 ? "Minor triad+" : i == 5 ? "Bluesy 1" : i == 6 ? "Maj 7 inv." : i == 7 ? "Fifths" : i == 8 ? "Bluesy 2" : "Semitones";
  ) : m == 1 ? (
    i == 0 ? "Harm. 2-3" : i == 1 ? "Harm. 4-7" : i == 2 ? "Harm. 8-15" : i == 3 ? "Odd harm." : i == 4 ? "Do Fa So" : i == 5 ? "Do Re Fa So La" : i == 6 ? "Just 1" : i == 7 ? "Just 2" : i == 8 ? "5-TET" : "7-TET";
  ) : (
    i == 0 ? "Fifths spiral" : i == 1 ? "Whole tones" : i == 2 ? "Messiaen 2" : i == 3 ? "Messiaen 3" : i == 4 ? "Messiaen 4" : i == 5 ? "Bohlen-Pierce" : i == 6 ? "B-P major" : i == 7 ? "B-P minor" : i == 8 ? "Carlos alpha" : "Carlos beta";
  );
