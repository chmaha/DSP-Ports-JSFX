  (u_click && hl) ? ( set_slider(s, max(lo, v - 1)); u_click = 0; );
  (u_click && hr) ? ( set_slider(s, min(hi, v + 1)); u_click = 0; );
  (hit_rect(mouse_x, mouse_y, ux, uy, uw, uh) && u_wheel != 0) ? ( set_slider(s, max(lo, min(hi, v + (u_wheel > 0 ? 1 : -1)))); u_wheel = 0; );
  gfx_set(0.06, 0.06, 0.07, 1);
  gfx_roundrect(ux - 1, uy - 1, uw + 2, uh + 2, pl(5), 1);
  gfx_set(0.21, 0.21, 0.23, 1);
  gfx_rect(ux + 1, uy + 1, uw - 2, uh - 2, 1);
  gfx_set(hl ? 0.32 : 0.26, hl ? 0.32 : 0.26, hl ? 0.34 : 0.28, 1); gfx_rect(ux + 1, uy + 1, pl(24) - 1, uh - 2, 1);
  gfx_set(hr ? 0.32 : 0.26, hr ? 0.32 : 0.26, hr ? 0.34 : 0.28, 1); gfx_rect(ux + uw - pl(24), uy + 1, pl(24) - 1, uh - 2, 1);
  gfx_set(0.86, 0.87, 0.89, 1);
  ctextm("-", ux + pl(12), uy + uh * 0.5, 14, 'b');
  ctextm("+", ux + uw - pl(12), uy + uh * 0.5, 14, 'b');
  isnote ? strcpy(#ustp, notename(v)) : sprintf(#ustp, "%d", v);
  ctextm(#ustp, ux + uw * 0.5, uy + uh * 0.5, 12, 'b');
);

function glabel(str, x, y)
(
  gfx_set(0.62, 0.64, 0.68, 1);
  ltext(str, x, y, 12, 'b');
);

function scale_view(x, y, w, h) local(ux, uy, uw, uh, SB, n, mx, i, tx, v)
(
  ux = px(x); uy = py(y); uw = pl(w); uh = pl(h);
  gfx_set(0.06, 0.06, 0.07, 1);
  gfx_rect(ux, uy, uw, uh, 1);
  learn_on ? (
    n = ps_size;
    gfx_set(0.98, 0.42, 0.36, 1);
    sprintf(#usv, "Learning: %d note%s", n, n == 1 ? "" : "s");
    ctextm(#usv, ux + uw * 0.5, uy + uh * 0.5 - pl(8), 13, 'b');
    gfx_set(0.62, 0.64, 0.68, 1);
    ctextm("play notes, then click Learn", ux + uw * 0.5, uy + uh * 0.5 + pl(10), 11, 0);
  ) : (
    SB = SCL + (p_scm * 10 + p_scale) * 33;
    n = SB[32]; mx = SB[n - 1];
    gfx_set(0.30, 0.31, 0.33, 1);
    gfx_rect(ux + pl(8), uy + uh - pl(14), uw - pl(16), 1, 1);
    i = 0;
    loop(n,
      v = SB[i];
      tx = ux + pl(8) + floor((uw - pl(16)) * (mx > 0 ? v / mx : 0));
      i == 0 || i == n - 1 ? gfx_set(0.15, 0.64, 0.88, 1) : gfx_set(0.92, 0.93, 0.95, 1);
      gfx_rect(tx - max(1, pl(1)), uy + pl(22), max(2, pl(3)), uh - pl(36), 1);
      i += 1;
    );
    gfx_set(0.86, 0.87, 0.89, 1);
    sclearned(p_scm, p_scale) ? sprintf(#usv, "%s %d: learned scale", bankname(p_scm), p_scale + 1)
    : sprintf(#usv, "%s %d: %s", bankname(p_scm), p_scale + 1, scname(p_scm, p_scale));
    ctextm(#usv, ux + uw * 0.5, uy + pl(11), 11, 'b');
  );
);


u_down = mouse_cap & 1;
