  i = 1; loop(floor(-mn / 12), txt_r(hx + hw - 2, ghy_b(-12 * i, mn), sprintf(#gv, "%d", -12 * i)); i += 1; );
  txt_l(hx + 3, 323, "4s"); txt_cc(hx + hw * 0.5, 323, "2s"); txt_r(hx + hw - 3, 323, "0");
  hexc(gg_gr ? 0x0066ff : inr(hx + 4, 237.5, 26, 20) ? 0x2a2e35 : 0x1a1d22, 1); grr(hx + 4, 237.5, 26, 20, 3);
  gfont(13, 0); hexc(0xfdfeff, 1); txt_cc(hx + 17, 247.5, "GR");
  inr(hx + 4, 237.5, 26, 20) && gclick ? ( gg_gr = !gg_gr; gclick = 0; );
);


function gc_chart() local(nb, sl, b, i, x, lo, hi, dec, m, f, db, lis, a)
(
  nb = max(2, min(6, floor(g_bands + 0.5)));
  sl = g_slope >= 72 ? 2 : g_slope >= 36 ? 1 : 0;
  hexc(0x000000, 1); grect(8.5, 56.5, 1007.6, 160.1);
  gc_spec();
  dec = 10;
  loop(4,
    m = 1;
    loop(9, f = m * dec; (f >= 20 && f <= 20000) ? ( hexc(0xffffff, 0.15); gvl(gc_x(f), 56.6, 160); ); m += 1; );
    dec *= 10;
  );
  db = -12; loop(4, hexc(0xffffff, 0.15); ghl(8.9, gc_y(db), 1008); db -= 12; );
  hexc(0xffffff, 0.37); ghl(8.9, 56.6, 1008);
  gfont(9, 0); hexc(0xffffff, 0.33);
  db = 0; loop(5, txt_r(1014, max(63.6, gc_y(db)), db === 0 ? "0dB" : sprintf(#gv, "%ddB", db)); db -= 12; );
  txt_l(12, 209.6, "20Hz"); txt_cc(gc_x(100), 209.6, "100Hz"); txt_cc(gc_x(1000), 209.6, "1kHz"); txt_cc(gc_x(10000), 209.6, "10kHz"); txt_r(1014, 209.6, "20kHz");
  gc_shapes(nb, sl);
  b = 0;
  loop(nb,
    lis = slider(gbs(b)) >= 0.5;
    gc_band(b, nb, lis ? 3 : 0);
    b += 1;
  );
  gc_hx = -1;
  gdrag === 0 && inr(8.5, 56.5, 1007.6, 160.1) ? ( i = 0; loop(nb - 1, abs(gmx - gc_x(gxo(i))) <= 10 ? gc_hx = i; i += 1; ); );
  i = 0;
  loop(nb - 1,
    x = gc_x(gxo(i));
    a = gdrag === 404 + i ? 0.5 : gc_hx === i ? 0.25 : 0.1;
    hexc(0xfdfeff, a); grect(x - 10, 56.6, 20, 160);
    hexc(0xfdfeff, gdrag === 404 + i ? 1 : gc_hx === i ? 0.63 : 0.5); gvl(x, 56.6, 160);
    gfont(9, 0); hexc(0xfdfeff, gdrag === 404 + i ? 1 : gc_hx === i ? 0.63 : 0.5); txt_cc(x, 64.3, gfmt_f(gxo(i)));
    i += 1;
