    st ? ( ln = sqrt(sqr(x - px) + sqr(y - py)); d += ln; (floor(d / (3 * gsc)) & 1) === 0 ? gfx_line(px, py, x, y, 1); );
    px = x; py = y; st = 1;
    k += 1;
