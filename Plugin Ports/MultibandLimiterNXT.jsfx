function q0_relscale(peak) local(avg, crest, t, fast, slow)
(
  q0_emph < K0P01 ? 1 : (
    avg = (q0_asccnt > 0 && q0_ascsum > EPS12) ? (q0_ascsum / q0_asccnt) : peak;
    crest = (peak / max(avg, K1M6));
    t = max(0, min(1, ((crest - 1) / 2)));
    fast = (1 - (0.75 * q0_emph));
    slow = (1 + (1.25 * q0_emph));
    (slow + ((fast - slow) * t));
