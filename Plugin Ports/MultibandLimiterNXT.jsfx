function ghy_b(db, mn) ( 233.5 + 96 * min(1, max(0, db / mn)); );


function gstrip_hist(b, hx, hw) local(k, idx, p, v, g, x, y, yy, cw, px, py, mn, m, f, st, i, d, ln)
(
  hexc(0x000000, 1); grect(hx, 233.5, hw, 96);
