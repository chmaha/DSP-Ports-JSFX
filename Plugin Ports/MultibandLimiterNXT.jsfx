out_pin:Right output
options:no_meter

@init
ext_noinit = gfx_ext_retina = 1;

function alloc(n) local(r) instance(mp) global() ( r = mp; mp += n; memset(r, 0, n); r; );
alloc.mp = 0;

function f32(x) local(c) ( c = x * 536870913; c - (c - x); );

K005 = (0.05); K1M4 = (0.0001); K1M6 = (0.000001); EPS12 = (0.000000000001); EPS20 = (0.00000000000000000001);
K0P01 = (0.01); K1M14 = (0.00000000000001); K9999 = (0.9999); K001 = (0.001); K01 = (0.1); K002 = (0.02);
K0001 = (0.001); K045 = (0.45); K04 = (0.4); K15 = (1.5);
SM15 = (10 ^ -15); SM50 = 10 ^ -50; FMIN = 1.17549435 / (10 ^ 38);
PIF = ($pi); HALFPI = (1.5707963267948966);
PI2 = $pi * 2;
LRQ24 = (0.7071067811865476); LRQ48A = (0.541196100146197); LRQ48B = (1.306562964876376);
LRQ96A = (0.509795579); LRQ96B = (0.601344886); LRQ96C = (0.899976223); LRQ96D = (2.562915447);
mt_il = mt_ir = mt_ol = mt_or = 0;
gui_beat = 0; gb_prev = -1; gb_idle = 100;

QMAX = 153700;
RSM = alloc(160);
OVL = alloc(96); OVR = alloc(96); RSL = alloc(16); RSR = alloc(16); CSL = alloc(16); CSR = alloc(16);
XDP = alloc(16 + 2 * 8192);
XDB = alloc(16 + 2 * 8192);
MBUF = alloc(QMAX); MBUF_n = 0;
XCF = alloc(800); XTG = alloc(16); XCU = alloc(16); XST = alloc(16); MBX = alloc(8);
i_ = 0;
loop(2,
  mem_set_values(XTG + i_ * 8, 200, 500, 1000, 2000, 4000, 8000, 12000);
  mem_set_values(XCU + i_ * 8, 200, 500, 1000, 2000, 4000, 8000, 12000);
  mem_set_values(XST + i_ * 8, 2, 1, 44100, 1);
  i_ += 1;
);

function dblin(db) ( (10 ^ (db * K005)); );
function lindb(x) ( (20 * (log10(max(x, EPS20)))); );
function sdn(x) ( abs(x) < FMIN ? 0 : x; );
function san32(x) ( abs(x) < SM15 ? 0 : x; );
function clampf(x, lo, hi) ( x < lo ? lo : hi < x ? hi : x; );
function rnd_half(x) ( x < 0 ? -floor(-x + 0.5) : floor(x + 0.5); );
function clip_lim(x, lim) local(ax) ( ax = abs(x); (ax > lim && ax > EPS12) ? (lim * (x / ax)) : x; );

function bq_lp(p, fc, q, sr) local(om, sn, cs, al, iv)
(
  om = (PI2 * fc) / sr; sn = sin(om); cs = cos(om);
  al = sn / (2 * q); iv = 1 / (1 + al);
  p[0] = (iv * (1 - cs)) * 0.5; p[2] = p[0]; p[1] = p[0] + p[0];
  p[3] = (-2 * cs) * iv; p[4] = (1 - al) * iv;
);

function bq_hp(p, fc, q, sr) local(om, sn, cs, al, iv)
(
  om = (PI2 * fc) / sr; sn = sin(om); cs = cos(om);
  al = sn / (2 * q); iv = 1 / (1 + al);
  p[0] = (iv * (1 + cs)) * 0.5; p[1] = -2 * p[0]; p[2] = p[0];
  p[3] = (-2 * cs) * iv; p[4] = (1 - al) * iv;
);

function xo_l0_2(x) local(lo, hi, o)
(
  lo = hi = x;
  o = ((((lo * kl00l0) + (sl00la * kl00l1)) + (sl00lb * kl00l2)) - (sl00lc * kl00l3)) - (sl00ld * kl00l4);
  sl00lb = sl00la; sl00ld = sl00lc; sl00la = lo; sl00lc = o; lo = o;
  o = ((((hi * kl00h0) + (sl00ha * kl00h1)) + (sl00hb * kl00h2)) - (sl00hc * kl00h3)) - (sl00hd * kl00h4);
  sl00hb = sl00ha; sl00hd = sl00hc; sl00ha = hi; sl00hc = o; hi = o;
  o = ((((lo * kl01l0) + (sl01la * kl01l1)) + (sl01lb * kl01l2)) - (sl01lc * kl01l3)) - (sl01ld * kl01l4);
  sl01lb = sl01la; sl01ld = sl01lc; sl01la = lo; sl01lc = o; lo = o;
  o = ((((hi * kl01h0) + (sl01ha * kl01h1)) + (sl01hb * kl01h2)) - (sl01hc * kl01h3)) - (sl01hd * kl01h4);
  sl01hb = sl01ha; sl01hd = sl01hc; sl01ha = hi; sl01hc = o; hi = o;
  xlo = lo; xhi = hi;
);

