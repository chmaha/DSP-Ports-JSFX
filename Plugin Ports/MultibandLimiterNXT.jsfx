th_set();
gmx = (mouse_x - gox) / gsc;
gmy = (mouse_y - goy) / gsc;
gdown = mouse_cap & 1;
gclick = gdown && !gprev_down;
gdbl = gclick && gnow - glast_click < 0.3 && abs(gmx - glast_cx) < 4 && abs(gmy - glast_cy) < 4;
gclick ? ( glast_click = gnow; glast_cx = gmx; glast_cy = gmy; );

