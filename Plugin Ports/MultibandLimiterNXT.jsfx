  );
  gdrag >= 404 && gdrag < 409 && !gdown ? ( automate(4 + gdrag - 404, 1); gdrag = 0; );
);

function gstrip(b, sx, sw) local(bs, x0, mx, mw, i, db, cp, kb, r, sp, rx, lx, wx)
(
  bs = gbs(b);
  hexc(0x0a0d10, 1); grect(sx, 225.1, sw, 254.9);
  x0 = sx + 9;
  gstrip_hist(b, x0, sw - 19);
  GMI[b] = max(slider_vi(b), GMI[b] * 0.85); GMO[b] = max(slider_vo(b), GMO[b] * 0.85);
  mx = sx + 7.9; mw = sw - 20.7;
