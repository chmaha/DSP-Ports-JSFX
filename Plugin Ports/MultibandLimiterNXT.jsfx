    st = 0; k = 0;
    loop(72,
      idx = h_pos + k; idx >= 72 ? idx -= 72;
      p = HB + b * 216 + idx * 3;
      g = p[1] > 0 && p[1] <= 1 ? p[1] : 1;
      x = gxp(hx + k * cw + cw * 0.5); y = gyp(ghy_b(max(mn, min(0, 20 * log10(g))), mn));
      hexc(0xfdfeff, 1); st ? gthick(px, py, x, y);
      px = x; py = y; st = 1;
      k += 1;
