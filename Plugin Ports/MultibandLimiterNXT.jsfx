function q0_rdelta(att, useasc, pk) local(rel, rd, aatt, d)
(
  rel = (q0_release * q0_relscale(pk > 0 ? pk : q0_limit));
  rd = ((1 - att) / (q0_srf * max(rel, K1M4)));
