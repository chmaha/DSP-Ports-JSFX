  loop(nb - 1,
    pv = XCU[ix * 8 + i];
    XCU[ix * 8 + i] = sp_glide(pv, XTG[ix * 8 + i]);
    XCU[ix * 8 + i] !== pv ? ch = 1;
    i += 1;
  );
  ch ? sp_enforce(XCU + ix * 8, nb - 1, v[2]);
  (ch || v[3]) ? sp_update(ix);
  ix ? ( sp_keyr = nb * 10 + sp_nst(code); ) : ( sp_keyl = nb * 10 + sp_nst(code); );
);


function rs_design(sr, factor) local(fc, osr, om, sn, cs, al, iv, q)
(
  fc = (max(25000, sr * 0.5));
  osr = (sr * factor);
  q = (0.8);
  om = (PI2 * fc) / osr;
  sn = sin(om); cs = cos(om);
  al = sn / (2 * q);
  iv = 1 / (1 + al);
  r_a0 = ((1 * iv) * (1 - cs)) * 0.5;
  r_a2 = r_a0; r_a1 = r_a0 + r_a0;
  r_b1 = ((-2 * cs) * iv);
  r_b2 = (1 - al) * iv;
  memset(RSM, 0, 128);
);

function rs_bq(k, x) local(p, o)
(
  p = RSM + k * 4;
  o = ((((x * r_a0) + (p[0] * r_a1)) + (p[1] * r_a2)) - (p[2] * r_b1)) - (p[3] * r_b2);
  p[1] = p[0]; p[3] = p[2]; p[0] = x; p[2] = o;
  o;
);

function rs_up(sample, ch, arr) local(i, x)
(
  r_fac <= 1 ? ( arr[0] = sample; ) : (
    i = 0;
    loop(r_fac,
      x = i === 0 ? sample * r_fac : 0;
      x = rs_bq(ch * 2, x);
      x = rs_bq(ch * 2 + 1, x);
      arr[i] = x;
      i += 1;
    );
  );
);

function rs_down(arr, k0) local(i, x)
(
  r_fac <= 1 ? arr[0] : (
    i = 0;
    loop(r_fac,
      x = arr[i];
      x = rs_bq(k0, x);
      x = rs_bq(k0 + 1, x);
      arr[i] = x;
      i += 1;
    );
    arr[0];
  );
);

function rs_sanitize() local(i)
(
  i = 0;
  loop(128, abs(RSM[i]) < SM50 ? RSM[i] = 0; i += 1; );
);

function xd_rd(d, dl) ( dl <= 0 ? d[0] : (d[0] - dl) & 8191; );

function xd_blend(d) local(t)
(
  d[5] <= 0 ? d[1] : (
    t = (d[4] / max(1, d[5]));
    max(0, floor((d[2] + ((d[3] - d[2]) * t)) + 0.5));
  );
);

function xd_proc(d, inL, inR, ds) local(w, t, a, b, i0, i1)
(
  ds = max(0, min(8191, ds));
  w = d[0];
  d[16 + w] = inL; d[16 + 8192 + w] = inR;
  ds !== d[1] ? (
    d[2] = d[5] > 0 ? xd_blend(d) : d[1];
    d[3] = ds; d[1] = ds; d[5] = d[6]; d[4] = 0;
  );
  d[5] > 0 ? (
    t = (d[4] / max(1, d[5]));
    a = (sin((t * HALFPI))); b = (cos((t * HALFPI)));
    i0 = xd_rd(d, d[2]); i1 = xd_rd(d, d[3]);
    xd_oL = ((d[16 + i0] * b) + (d[16 + i1] * a));
    xd_oR = ((d[16 + 8192 + i0] * b) + (d[16 + 8192 + i1] * a));
    d[4] += 1;
    d[4] >= d[5] ? ( d[5] = 0; d[4] = 0; d[2] = d[3]; );
  ) : (
    i0 = xd_rd(d, d[1]);
    xd_oL = d[16 + i0]; xd_oR = d[16 + 8192 + i0];
  );
  d[0] = (w + 1) & 8191;
);

function xd_reset(d, xl)
(
  memset(d, 0, 16 + 2 * 8192);
  d[6] = max(1, xl);
);

function apply_color(x, amt) local(dr, wet, e1, e2)
(
  amt < (0.0001) ? x : (
    dr = (1 + (amt * 4));
    e1 = exp(2 * (x * dr)); e2 = exp(2 * dr);
    wet = (((e1 - 1) / (e1 + 1)) / ((e2 - 1) / (e2 + 1)));
    (x + ((wet - x) * amt));
  );
);

xd_oL = 0; xd_oR = 0; r_fac = 1; r_a0 = 1; r_a1 = r_a2 = r_b1 = r_b2 = 0;

function san64(x) ( abs(x) < SM50 ? 0 : x; );
SM50 = 10 ^ -50;
SPN_FFT = 2048; SPHOP = 512; SPMAX = 192;
T_POS = 0; T_HOP = 1; T_LDB = 16; T_RDB = 16 + 512; T_AVG = 16 + 1024; T_RL = 16 + 1536; T_RR = 16 + 1536 + 4096; T_SZ = 16 + 1536 + 8192;
SPLO = alloc(SPMAX); SPHI = alloc(SPMAX); SPT = alloc(SPMAX);
alloc.mp = ceil(alloc.mp / 8192) * 8192;
SPBUF = alloc(SPN_FFT * 2);
SPWIN = alloc(SPN_FFT);
TAP_IN = alloc(T_SZ); TAP_OUT = alloc(T_SZ);
SP_AVG_IN = TAP_IN + T_AVG; SP_AVG_OUT = TAP_OUT + T_AVG;
sp_n = 0; sp_alpha = 0.2;
i_sp = 0;
loop(SPN_FFT, SPWIN[i_sp] = (0.5 * (1 - cos((2 * $pi) * (i_sp / (SPN_FFT - 1))))); i_sp += 1; );

function sp_logt(f) ( log(max(20, min(20000, f)) / 20) / log(1000); );

function sp_emit(blo, bhi, a, b) local(c, l)
(
  (bhi > blo && b > a) ? (
    sp_n >= SPMAX ? (
      l = sp_n - 1;
      SPHI[l] = bhi;
      SPT[l] = max(0, min(1, sp_logt(sqrt(max(a, 20) * b))));
    ) : (
      SPLO[sp_n] = blo; SPHI[sp_n] = bhi;
      SPT[sp_n] = max(0, min(1, sp_logt(sqrt(a * b))));
      sp_n += 1;
    );
  );
);

function sp_close()
(
  sp_rlo >= 0 ? (
    sp_emit(sp_rlo, sp_rhi, sp_ra, sp_rb);
    sp_rlo = -1; sp_rpx = 0;
  );
);

function sp_map() local(half, binhz, ftop, lnspan, k, f0, f1, a, b, px, done)
(
  sp_n = 0; sp_rlo = -1; sp_rpx = 0;
  half = SPN_FFT / 2;
  binhz = srate / SPN_FFT;
  ftop = min(20000, srate * 0.5);
  lnspan = log(1000);
  k = 1; done = 0;
  while (k < half && !done) (
    f0 = k * binhz; f1 = (k + 1) * binhz;
    f1 <= 20 ? 0 : f0 >= ftop ? ( done = 1; ) : (
      a = max(f0, 20); b = min(f1, ftop);
      b > a ? (
        px = (SPMAX * log(b / a)) / lnspan;
        px >= 1 ? ( sp_close(); sp_emit(k, k + 1, a, b); ) : (
          sp_rlo < 0 ? ( sp_rlo = k; sp_rhi = k + 1; sp_ra = a; sp_rb = b; sp_rpx = px; ) :
          ( sp_rhi = k + 1; sp_rb = b; sp_rpx += px; );
          sp_rpx >= 1 ? sp_close();
        );
      );
    );
    k += 1;
  );
  sp_close();
  sp_alpha = max(0.01, min(1, 1 - exp(-1 / (0.1 * (srate / SPHOP)))));
);

function sp_reset(sptp) local(i)
(
  memset(sptp, 0, T_SZ);
  i = 0;
  loop(SPMAX, sptp[T_LDB + i] = -120; sptp[T_RDB + i] = -120; sptp[T_AVG + i] = -120; i += 1; );
);

function sp_hop(sptp) local(i, k, st, n, a, b, xr, xi, yr, yi, ml, mr, ll, lr, nm, db, lo, hi, rl, rr, pos)
(
  n = SPN_FFT;
  pos = sptp[T_POS];
  rl = sptp + T_RL; rr = sptp + T_RR;
  i = 0;
  loop(n,
    k = pos + i; k >= n ? k -= n;
    SPBUF[2 * i] = rl[k] * SPWIN[i];
    SPBUF[2 * i + 1] = rr[k] * SPWIN[i];
    i += 1;
  );
  fft(SPBUF, n);
  fft_permute(SPBUF, n);
  nm = 2 / (n * 0.5);
  i = 0;
  loop(sp_n,
    lo = SPLO[i]; hi = SPHI[i];
    ml = 0; mr = 0;
    k = lo;
    loop(hi - lo,
      xr = SPBUF[2 * k]; xi = SPBUF[2 * k + 1];
      yr = SPBUF[2 * (n - k)]; yi = SPBUF[2 * (n - k) + 1];
      a = 0.5 * sqrt(sqr(xr + yr) + sqr(xi - yi));
      b = 0.5 * sqrt(sqr(xi + yi) + sqr(xr - yr));
      a > ml ? ml = a;
      b > mr ? mr = b;
      k += 1;
    );
    ll = ml * nm; lr = mr * nm;
    ll = ll > 0.000000000001 ? max(-120, min(0, 20 * log10(ll))) : -120;
    lr = lr > 0.000000000001 ? max(-120, min(0, 20 * log10(lr))) : -120;
    db = sptp[T_LDB + i]; db += sp_alpha * (ll - db); sptp[T_LDB + i] = max(-120, min(0, san64(db)));
    db = sptp[T_RDB + i]; db += sp_alpha * (lr - db); sptp[T_RDB + i] = max(-120, min(0, san64(db)));
    sptp[T_AVG + i] = 0.5 * (sptp[T_LDB + i] + sptp[T_RDB + i]);
    i += 1;
  );
);

function sp_feed(sptp, l, r) local(p)
(
  p = sptp[T_POS];
  sptp[T_RL + p] = l; sptp[T_RR + p] = r;
  p += 1; p >= SPN_FFT ? p = 0;
  sptp[T_POS] = p;
  sptp[T_HOP] += 1;
  sptp[T_HOP] >= SPHOP ? ( sptp[T_HOP] = 0; sp_hop(sptp); );
);

