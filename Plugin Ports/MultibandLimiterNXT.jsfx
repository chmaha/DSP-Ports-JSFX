function q0_sched() ( q0_xfLen <= 0 ? max(1, q0_look) : max(1, max(q0_xfFrom, q0_xfTo)); );
function q0_readpos(lf) ( (q0_pos - (max(1, lf) - 1) * 2 + q0_ovr) % q0_ovr; );

function q0_rebuildasc() local(look, f, idx, p, lim, frame)
