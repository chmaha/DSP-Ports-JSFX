  kb = cp ? 40 : 64; r = cp ? 20 : 24;
  sp = (sw - 18 - 2 * kb - 35.4 - 17.8) / 4;
  rx = x0 + sp + kb * 0.5;
  lx = x0 + sp + kb + 8.9 + sp;
  wx = lx + 35.4 + 8.9 + sp + kb * 0.5;
  cp ? gk_noff = r - 1;
  gdp = DOTS + 84; gknob(rx, 437.2, r, bs + 2, 0, -1, 1, slider_rd(b), 0, 2, 1, cp ? 0 : 118, "Release");
  cp ? gk_noff = r - 1;
