  m = 0; k = 0;
  loop(72, p = HB + b * 216 + k * 3; p[0] > 0 ? m = min(m, 20 * log10(max(0.000001, p[0] / max(0.000001, min(1, p[1] > 0 ? p[1] : 1))))); k += 1; );
  m = min(m, 20 * log10(max(0.000001, (10 ^ (g_limit / 20)))));
  f = max(-60, min(-24, floor((m - 3) / 6) * 6));
  f < GHM[b] ? GHM[b] = f : GHM[b] += (f - GHM[b]) * 0.02;
