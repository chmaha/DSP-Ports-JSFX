function q0_ascpush(frame, peak) local(old)
(
  (frame >= 0 && frame < q0_ovr / 2 + 2) ? (
    old = LASC0[frame];
    old > 0 ? ( q0_ascsum = (q0_ascsum - old); q0_asccnt -= 1; );
