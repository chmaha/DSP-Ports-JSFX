LBUF0 = alloc(QMAX); LASC0 = alloc(QMAX / 2 + 8); LNP0 = alloc(QMAX); LND0 = alloc(QMAX);
q0_ovr = 0; q0_srate = 48000; q0_srf = 48000; q0_att = 1; q0_attmax = 1; q0_pos = 0; q0_look = 1; q0_xfFrom = 1; q0_xfTo = 1; q0_xfPos = 0; q0_xfLen = 0;
q0_delta = 0; q0_niter = 0; q0_nlen = 0; q0_ascsum = 0; q0_asccnt = 0; q0_curve = 0; q0_knee = 0; q0_emph = 0; q0_holdlen = 0; q0_holdrem = 0;
q0_ss = 1; q0_se = 1; q0_sp = 0; q0_sl = 1; q0_sleeping = 1; q0_limit = 1; q0_attack = (0.005); q0_release = (0.05); q0_weight = 1; q0_autorel = 0; q0_ascc = 1;
q0_cl = 0; q0_cr = 0; q0_gl = 0; q0_gr = 0; q0_oL = 0; q0_oR = 0; q0_inL = 0; q0_inR = 0;

function q0_kneefloor(le) ( q0_knee < K005 ? le : (le * dblin(-q0_knee)); );

function q0_need(peak, le) local(sp, fl, t, op)
(
  sp = max(peak, EPS12);
  q0_knee < K005 ? ( sp > le ? min((le / sp), 1) : 1; ) : (
    fl = q0_kneefloor(le);
    sp <= fl ? 1 : sp >= le ? min((le / sp), 1) : (
      t = ((sp - fl) / max((le - fl), EPS12));
      t = ((t * t) * (3 - (2 * t)));
      op = (sp + ((le - sp) * t));
      max(0, min(1, (op / sp)));
    );
  );
);

function q0_beginseg(s, e, len) ( q0_ss = s; q0_se = e; q0_sl = max(1, len); q0_sp = 0; );

function q0_stepseg() local(t, s, e, w)
(
  q0_sp += 1;
  t = (q0_sp / q0_sl);
  q0_curve === 1 ? (
    s = max(q0_ss, EPS12); e = max(q0_se, EPS12);
    dblin((lindb(s) + ((lindb(e) - lindb(s)) * max(0, min(1, t)))));
