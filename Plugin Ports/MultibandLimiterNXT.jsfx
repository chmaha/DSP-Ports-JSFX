    db = i === 0 ? -60 : i === 1 ? -48 : i === 2 ? -36 : i === 3 ? -24 : i === 4 ? -18 : i === 5 ? -12 : i === 6 ? -6 : i === 7 ? -3 : 0;
    hexc(0x9498a2, 0.45); gvl(mx + mw * gdbp(db), 375.5, 3);
