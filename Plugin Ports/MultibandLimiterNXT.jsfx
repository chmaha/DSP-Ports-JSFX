  k = 0;
  loop(72,
    idx = h_pos + k; idx >= 72 ? idx -= 72;
    p = HB + b * 216 + idx * 3;
    g = p[1] > 0 && p[1] <= 1 ? p[1] : 1;
    x = hx + k * cw;
    p[0] > 0 ? (
      v = max(mn, min(0, 20 * log10(max(0.000001, p[0] / g)))); yy = ghy_b(v, mn);
      gfx_a = 1; gfx_mode = 0;
      gfx_blit(40, 1, 0, 0, (yy - 233.5) * gsc, 1, max(1, (329.5 - yy) * gsc), gxp(x), gyp(yy), cw * gsc + 1, max(1, (329.5 - yy) * gsc));
      v = max(mn, min(0, 20 * log10(max(0.000001, p[0])))); yy = ghy_b(v, mn);
      hexc(0x000000, 0.5); gfx_rect(gxp(x), gyp(yy), cw * gsc + 1, max(1, (329.5 - yy) * gsc));
    );
    k += 1;
  );
  gfx_a = 1;
  hexc(0xffffff, 0.15);
  i = 1; loop(floor(-mn / 12), ghl(hx, ghy_b(-12 * i, mn), hw); i += 1; );
  gvl(hx + hw * 0.5, 233.5, 96);
  st = 0; d = 0;
  k = 0;
  loop(72,
    idx = h_pos + k; idx >= 72 ? idx -= 72;
    p = HB + b * 216 + idx * 3;
    x = gxp(hx + k * cw + cw * 0.5);
    y = gyp(ghy_b(max(mn, min(0, 20 * log10(max(0.000001, p[2] > 0 ? p[2] : (10 ^ (g_limit / 20)))))), mn));
