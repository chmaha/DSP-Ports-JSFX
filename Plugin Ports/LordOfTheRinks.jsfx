  sv(57) ? envAttackClickLevel = slider(57);
  slider(58) >= 0 && slider(58) <= 1 ? envAtkClkMinLength = floor(FS * slider(58));
  slider(59) >= 0 && slider(59) <= 1 ? envAtkClkMaxLength = floor(FS * slider(59));
  m = slider(60); sv(60) ? envReleaseModel = m == 0 ? 0 : m == 1 ? 3 : m == 2 ? 1 : 2;
  sv(61) ? envReleaseClickLevel = slider(61);
  sv(62) && slider(62) >= 4 && slider(62) <= 22 ? vibHz = slider(62);
  sv(63) ? vib1Amp = slider(63);
