  sv(62) && slider(62) >= 4 && slider(62) <= 22 ? vibHz = slider(62);
  sv(63) ? vib1Amp = slider(63);
  sv(64) ? vib2Amp = slider(64);
  sv(65) ? vib3Amp = slider(65);
);
function cfg_midi() (
  midi_defaults();
  rcvA = slider(42) - 1; rcvB = slider(43) - 1; rcvC = slider(44) - 1;
  mTranspose = slider(47); nshA = slider(48); nshB = slider(49); nshC = slider(50);
  splitA_UL = slider(107); splitA_PL = slider(108);
  nshA_PL = slider(109); nshA_UL = slider(110); nshA_U = slider(111);
);
function cfg_whirl_filters() (
  sv(92) ? lpT = slider(92); sv(93) ? lpF = slider(93); sv(94) ? lpQ = slider(94); sv(95) ? lpG = slider(95);
  sv(96) ? haT = slider(96); sv(97) ? haF = slider(97); sv(98) ? haQ = slider(98); sv(99) ? haG = slider(99);
  sv(100) ? hbT = slider(100); sv(101) ? hbF = slider(101); sv(102) ? hbQ = slider(102); sv(103) ? hbG = slider(103);
);
function cfg_whirl() (
  sv(71) ? hornRPMslow = slider(71); sv(72) ? hornRPMfast = slider(72);
  sv(73) ? drumRPMslow = slider(73); sv(74) ? drumRPMfast = slider(74);
  sv(75) ? hornAcc = slider(75); sv(76) ? hornDec = slider(76);
  sv(77) ? drumAcc = slider(77); sv(78) ? drumDec = slider(78);
  sv(79) ? hornLevel = slider(79); sv(80) ? leakLevel = slider(80);
  fsetHornMicWidth(slider(81)); fsetDrumMicWidth(slider(82));
  sv(83) ? hornRadiusCm = slider(83); sv(84) ? drumRadiusCm = slider(84);
  hnBrakePos = slider(85); drBrakePos = slider(86);
  micAngle = 1.0 - slider(87) / 180.0;
  hornXOffsetCm = slider(88); hornZOffsetCm = slider(89);
  sv(90) ? micDistCm = slider(90);
  wh_bypass = slider(91);
  cfg_whirl_filters();
);

function reapply_tonegen_runtime() local(i) (
  i = 0; loop(27, setDrawBar(i, dbSet[i]); i += 1; );
  setPercussionFirst(slider(31));
  setPercussionVolume(slider(29));
  setPercussionFast(slider(30));
  setPercussionEnabled(slider(28));
  setVibratoKnob(slider(32));
  setVibratoUpper(slider(33)); setVibratoLower(slider(34));
  setSwell(slider(35));
);

function tonegen_reinit() (
  cfg_tonegen();
  tg_init();
  vib_reset();
  vib_init();
  reapply_tonegen_runtime();
  memset(guiKeys, 0, 160);
);

function rate_alloc()
(
  moremem.mp = __memtop()/2;
  waveMem = moremem.alloc(92 * ceil(srate / 48000.0) * 4096);
  rvStride = floor(2999 * srate / 22050.0) + 4;
  rvMem = moremem.alloc(7 * rvStride);
);

function rate_change() local(r, s) (
  r = last_srate / srate;
  hornIncr *= r; drumIncr *= r;
  last_srate = srate;
  rate_alloc();
  tonegen_reinit();
  rv_init();
  wh_setFilters();
  computeOffsets();
  s = lesSel; computeRotationSpeeds(); useRevOption(s, 0);
);

rate_alloc();

cfg_tonegen();
cc_prime();
cfg_midi();
tg_init();
vib_reset();
vib_init();
od_alloc();
sv(105) ? od_inputGain = slider(105);
sv(106) ? od_outputGain = slider(106);
od_init();
rv_alloc();
sv(104) ? rv_inputGain = slider(104);
rv_init();
wh_defaults();
wh_state_reset();
cfg_whirl();
