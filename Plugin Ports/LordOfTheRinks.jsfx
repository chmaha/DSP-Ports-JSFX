options:no_meter

in_pin:none
out_pin:left
out_pin:right

@init
ext_noinit = gfx_ext_retina = 1;
last_srate = srate;

function alloc(n) local(p) instance(mp) ( p = mp; mp += n; memset(p, 0, n); p; );

function prng() local(x, q) (
  x = rseed * 16807;
  q = floor(x / 2147483647);
  x -= q * 2147483647;
  x < 0 ? x += 2147483647;
  x >= 2147483647 ? x -= 2147483647;
  rseed = x;
);
function drnd() ( prng() / 2147483646; );
function imod(a, b) ( a - floor(a / b) * b; );
function idiv(a, b) ( floor(a / b); );
function db2g(d) ( pow(10, d / 20); );
function rint_(x) local(r, f) (
  r = floor(x); f = x - r;
  f > 0.5 ? r + 1 : f < 0.5 ? r : (imod(r, 2) === 0 ? r : r + 1);
);
function roundf_(x) local(r) ( r = floor(x); x - r >= 0.5 ? r + 1 : r; );
function remainder_(x, y) ( x - rint_(x / y) * y; );

DENORM = 1 / 100000000000000;
FS = 128;

alloc.mp = 0;
rseed = 1;

wheelPairs = alloc(92);
northT = alloc(26); southT = alloc(26); termStrip = alloc(93);
ULoff = alloc(9); gears60 = alloc(24); gears50 = alloc(24);
tm_w = alloc(92 * 8); tm_l = alloc(92 * 8); tm_n = alloc(92);
kt_t = alloc(160 * 9); kt_b = alloc(160 * 9); kt_l = alloc(160 * 9); kt_n = alloc(160);
kx_t = alloc(160 * 80); kx_b = alloc(160 * 80); kx_l = alloc(160 * 80); kx_n = alloc(160);
acc_g = alloc(92 * 27); acc_f = alloc(92 * 27);
KCMAX = 160 * 400;
kc_s = alloc(160); kc_n = alloc(160); kc_w = alloc(KCMAX); kc_b = alloc(KCMAX); kc_l = alloc(KCMAX);
o_wave = alloc(92); o_len = alloc(92); o_pos = alloc(92); o_freq = alloc(92);
o_att = alloc(92); o_acl = alloc(92); o_rf = alloc(92);
aot_bl = alloc(92 * 27); aot_kc = alloc(92 * 27); aot_rc = alloc(92);
aot_su = alloc(92); aot_sl = alloc(92); aot_sp = alloc(92);
aot_pc = alloc(92); aot_sw = alloc(92); aot_sc = alloc(92);
aol = alloc(92); rml = alloc(92);
mq = alloc(1024);
atkEnv = alloc(9 * FS); relEnv = alloc(9 * FS);
dbGain = alloc(27); dbLevel = alloc(27 * 9);
activeKeys = alloc(160);
kcTable = alloc(128);
harm = alloc(12); apl = alloc(12); plHz = alloc(12);
swl = alloc(FS); vibb = alloc(FS); vibY = alloc(FS); prc = alloc(FS);
off1T = alloc(2048); off2T = alloc(2048); off3T = alloc(2048); vbuf = alloc(1024);
fragA = alloc(FS); fragB = alloc(FS); fragC = alloc(FS);
outL = alloc(FS); outR = alloc(FS); tmpL = alloc(FS); tmpR = alloc(FS);
od_xzb = alloc(64); od_yzb = alloc(128); od_wi = alloc(4 * 9); od_wiLen = alloc(4);
od_aal = alloc(33); od_ipwdef = alloc(33); od_aaldef = alloc(33); od_mix = alloc(33);
rv_buf = alloc(7); rv_len = alloc(7); rv_idx = alloc(7); rv_end = alloc(7); rv_gain = alloc(7);
WDS = 16384; WDM = 16383; WBS = 2048; WBM = 2047;
bfw = alloc(WDS * 5); bbw = alloc(WDS * 5);
hnF = alloc(WDS); hnB = alloc(WDS); drF = alloc(WDS); drB = alloc(WDS);
hlBuf = alloc(WBS); hrBuf = alloc(WBS); dlBuf = alloc(WBS); drBuf = alloc(WBS);
adx0 = alloc(8); adx1 = alloc(8); adx2 = alloc(8);
hPh = alloc(6); dPh = alloc(6); hnSpc = alloc(6); drSpc = alloc(6);
hafw = alloc(8); hbfw = alloc(8); drfL = alloc(8); drfR = alloc(8);
wz = alloc(4); rv_ht = alloc(9); rv_dt = alloc(9); revsel = alloc(3);
eqC = alloc(6);
keyTA = alloc(128); keyTB = alloc(128); keyTC = alloc(128);
useA = alloc(128); useB = alloc(128); useC = alloc(128);
vecA = alloc(128); vecB = alloc(128); vecC = alloc(128);
chTab = alloc(16); chVec = alloc(16);
fnReg = alloc(128);
pg_flags = alloc(129); pg_db = alloc(129 * 27); pg_sc = alloc(129);
pg_pe = alloc(129); pg_pv = alloc(129); pg_ps = alloc(129); pg_ph = alloc(129);
pg_od = alloc(129); pg_rs = alloc(129); pg_rm = alloc(129);
pg_ksl = alloc(129); pg_ksp = alloc(129); pg_tr = alloc(129 * 7); pg_name = alloc(129);
evq = alloc(4096 * 4);
dbSet = alloc(27); guiKeys = alloc(160); slLast = alloc(160);
gq = alloc(256 * 3); gq_r = gq_w = 0;
usr = alloc(129); learn_fid = -1; map_user = 0;


wheelPairs[0] = 0;
i = 1; loop(36, wheelPairs[i] = i + 48; i += 1; );
i = 37; loop(5, wheelPairs[i] = 0; i += 1; );
i = 42; loop(7, wheelPairs[i] = i + 43; i += 1; );
i = 49; loop(36, wheelPairs[i] = i - 48; i += 1; );
i = 85; loop(7, wheelPairs[i] = i - 43; i += 1; );

function fill(a, n, v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11) (
  n > 0 ? a[0] = v0; n > 1 ? a[1] = v1; n > 2 ? a[2] = v2; n > 3 ? a[3] = v3;
  n > 4 ? a[4] = v4; n > 5 ? a[5] = v5; n > 6 ? a[6] = v6; n > 7 ? a[7] = v7;
  n > 8 ? a[8] = v8; n > 9 ? a[9] = v9; n > 10 ? a[10] = v10; n > 11 ? a[11] = v11;
);
fill(northT, 12, 85, 66, 90, 71, 47, 64, 86, 69, 45, 62, 86, 67);
fill(northT + 12, 12, 91, 72, 48, 65, 89, 70, 46, 63, 87, 68, 44, 61); northT[24] = 0;
fill(southT, 12, 78, 54, 83, 59, 76, 52, 81, 57, 74, 50, 79, 55);
fill(southT + 12, 12, 84, 60, 77, 53, 82, 58, 75, 51, 80, 56, 73, 49); southT[24] = 0;
fill(termStrip, 12, 85, 42, 30, 76, 66, 18, 6, 54, 90, 35, 83, 71);
fill(termStrip + 12, 12, 23, 11, 59, 47, 40, 28, 76, 64, 16, 4, 52, 88);
fill(termStrip + 24, 12, 33, 81, 69, 21, 9, 57, 45, 34, 26, 74, 62, 14);
fill(termStrip + 36, 12, 2, 50, 86, 43, 31, 79, 67, 19, 7, 55, 91, 36);
fill(termStrip + 48, 12, 84, 72, 24, 12, 60, 48, 41, 29, 77, 65, 17, 5);
fill(termStrip + 60, 12, 53, 89, 34, 82, 70, 22, 10, 58, 46, 39, 27, 75);
fill(termStrip + 72, 12, 63, 15, 3, 51, 87, 32, 80, 68, 20, 8, 56, 44);
fill(termStrip + 84, 8, 37, 25, 73, 61, 13, 1, 49, 0, 0, 0, 0, 0);
fill(ULoff, 9, -12, 7, 0, 12, 19, 24, 28, 31, 36, 0, 0, 0);
fill(gears60, 12, 85, 104, 71, 82, 67, 73, 35, 36, 69, 67, 12, 11);
fill(gears60 + 12, 12, 37, 32, 49, 40, 48, 37, 11, 8, 67, 46, 54, 35);
fill(gears50, 12, 17, 26, 57, 82, 11, 15, 49, 63, 33, 40, 55, 63);
fill(gears50 + 12, 12, 49, 53, 49, 50, 55, 53, 11, 10, 7, 6, 90, 73);

function tg_defaults() (
  envAttackModel = 0; envReleaseModel = 2;
  envAttackClickLevel = 0.50; envReleaseClickLevel = 0.25;
  envAtkClkMinLength = -1; envAtkClkMaxLength = -1;
  percSendBusA = 3; percSendBusB = 4;
  outputLevelTrim = 0.07;
  tuning = 440.0; gearTuning = 1;
  percTriggerBus = 8;
  percFastDecaySeconds = 0.3; percSlowDecaySeconds = 1.5;
  percEnvScaling = 11.0;
  percEnvGainResetNorm = 1.0; percEnvGainResetSoft = 0.5012;
  percDrawbarNormalGain = 0.60512; percDrawbarSoftGain = 1.0;
  tgPrecision = 0.001;
  eqP1y = 1.0; eqR1y = 0.0; eqP4y = 1.0; eqR4y = 0.0;
  cCompartment = 0.01; cTransformer = 0.0; cTermStrip = 0.01; cWiring = 0.01;
  contribFloor = 0.0000158; contribMin = 0.0;
  vib1Amp = 3.0; vib2Amp = 6.0; vib3Amp = 9.0; vibHz = 7.25;
);

function tm_add(term, wh, lv) local(n) (
  n = tm_n[term]; tm_w[term * 8 + n] = wh; tm_l[term * 8 + n] = lv; tm_n[term] = n + 1;
);
function kt_add(key, term, bus, lv) local(n) (
  n = kt_n[key]; kt_t[key * 9 + n] = term; kt_b[key * 9 + n] = bus; kt_l[key * 9 + n] = lv; kt_n[key] = n + 1;
);
function kx_add(key, term, bus, lv) local(n) (
  n = kx_n[key]; kx_t[key * 80 + n] = term; kx_b[key * 80 + n] = bus; kx_l[key * 80 + n] = lv; kx_n[key] = n + 1;
);

function findEW(v, w) local(i, found) (
  fe_e = 0; fe_w = 0; found = 0; i = 0;
  while (!found && v[i] > 0) (
    v[i] == w ? ( i > 0 ? fe_e = v[i - 1]; fe_w = v[i + 1]; found = 1; );
    i += 1;
  );
  found;
);

function taperModel(key, bus) local(t) (
  t = 0.0;
  bus == 0 ? ( t = key < 12 ? -10.0 : key < 17 ? -7.0 : key < 24 ? -3.5 : key < 36 ? 0.0 : key < 48 ? 3.5 : 7.0; ) :
  bus == 1 ? ( t = key < 15 ? -3.5 : key < 38 ? 0.0 : key < 50 ? 3.5 : 7.0; ) :
  bus == 2 ? ( t = key < 17 ? -7.0 : key < 22 ? -3.5 : key < 37 ? 0.0 : key < 49 ? 3.5 : 7.0; ) :
  bus == 3 ? ( t = key < 17 ? -3.5 : key < 39 ? 0.0 : -3.5; ) :
  bus == 4 ? ( t = key < 14 ? 7.0 : key < 20 ? 3.5 : key < 40 ? 0.0 : key < 50 ? -3.5 : -7.0; ) :
  bus == 5 ? ( t = key < 12 ? 7.0 : key < 15 ? 3.5 : key < 41 ? 0.0 : key < 54 ? -3.5 : -7.0; ) :
  bus == 6 ? ( t = key < 14 ? 3.5 : key < 42 ? 0.0 : key < 50 ? -3.5 : -7.0; ) :
  bus == 7 ? ( t = key < 43 ? 0.0 : key < 48 ? -3.5 : -7.0; ) :
  bus == 8 ? ( t = key < 43 ? 0.0 : -7.0; );
  db2g(t);
);

function applyManual(keyOffset, busOffset) local(k, b, tn) (
  k = 0;
  loop(61,
    b = 0;
    loop(9,
      tn = (k + 13) + ULoff[b];
      while (tn < 1) ( tn += 12; );
      while (tn < 13) ( tn += 12; );
      while (91 < tn) ( tn -= 12; );
      kt_add(k + keyOffset, tn, b + busOffset, taperModel(k, b));
      b += 1;
    );
    k += 1;
  );
);

function applyPedal(nof) local(k, b, tn) (
  k = 0;
  loop(nof,
    b = 0;
    loop(9,
      tn = (k + 13) + ULoff[b];
      tn >= 1 && tn <= 91 ? kt_add(k + 128, tn, b + 18, db2g(0.0));
      b += 1;
    );
    k += 1;
  );
);

function applyXtalk(keyOffset, busOffset) local(k, b, key, bn, j, lb) (
  k = 0;
  loop(61,
    key = k + keyOffset;
    b = 0;
    loop(9,
      bn = busOffset + b;
      j = 0;
      loop(kt_n[key],
        lb = kt_b[key * 9 + j];
        lb != bn ? kx_add(key, kt_t[key * 9 + j], bn, (cWiring * kt_l[key * 9 + j]) / abs(bn - lb));
        j += 1;
      );
      b += 1;
    );
    k += 1;
  );
);

function applyDefaultConfig() local(i) (
  memset(tm_n, 0, 92); memset(kt_n, 0, 160); memset(kx_n, 0, 160);
  i = 1;
  loop(91,
    tm_add(i, i, 1.0 - cCompartment);
    0.0 < cCompartment && wheelPairs[i] > 0 ? tm_add(i, wheelPairs[i], cCompartment);
    i += 1;
  );
  0.0 < cTransformer ? (
    i = 44;
    loop(48,
      findEW(northT, i) ? 0 : findEW(southT, i);
      fe_e > 0 ? tm_add(i, fe_e, cTransformer);
      fe_w > 0 ? tm_add(i, fe_w, cTransformer);
      i += 1;
    );
  );
  0.0 < cTermStrip ? (
    i = 1;
    loop(91,
      findEW(termStrip, i);
      fe_e > 0 ? tm_add(i, fe_e, cTermStrip);
      fe_w > 0 ? tm_add(i, fe_w, cTermStrip);
      i += 1;
    );
  );
  applyManual(0, 0);
  applyManual(64, 9);
  applyPedal(32);
  applyXtalk(0, 0);
  applyXtalk(64, 9);
);

function cpmIns(term, bus, lv) local(j, g, wn, c) (
  j = 0;
  loop(tm_n[term],
    g = tm_l[term * 8 + j] * lv;
    g !== 0 ? (
      wn = tm_w[term * 8 + j];
      c = wn * 27 + bus;
      acc_f[c] ? acc_g[c] += g : ( acc_g[c] = g; acc_f[c] = 1; );
    );
    j += 1;
  );
);

function compilePlayMatrix() local(k, j, w, b, c, n, lv) (
  n = 0; k = 0;
  loop(160,
    kc_s[k] = n; kc_n[k] = 0;
    !((60 < k && k < 64) || (124 < k && k < 128)) ? (
      memset(acc_f, 0, 92 * 27);
      j = 0; loop(kt_n[k], cpmIns(kt_t[k * 9 + j], kt_b[k * 9 + j], kt_l[k * 9 + j]); j += 1; );
      j = 0; loop(kx_n[k], cpmIns(kx_t[k * 80 + j], kx_b[k * 80 + j], kx_l[k * 80 + j]); j += 1; );
      w = 0;
      loop(92,
        b = 0;
        loop(27,
          c = w * 27 + b;
          acc_f[c] && !(acc_g[c] < contribFloor) ? (
            lv = acc_g[c];
            lv < contribMin ? lv = contribMin;
            kc_w[n] = w; kc_b[n] = b; kc_l[n] = lv; n += 1;
          );
          b += 1;
        );
        w += 1;
      );
      kc_n[k] = n - kc_s[k];
    );
    k += 1;
  );
);

function fitWave(hz, prec, minS, maxS) local(minErr, minSpn, i, minW, maxW, nws, spn, err, done) (
  minErr = 99999.9; minSpn = 0.0;
  minW = ceil((hz * minS) / srate);
  maxW = floor((hz * maxS) / srate);
  i = minW; done = 0;
  while (!done && i <= maxW) (
    nws = (srate * i) / hz;
    spn = rint_(nws);
    err = abs(nws - spn);
    err < minErr ? ( minErr = err; minSpn = spn; );
    err < prec ? done = 1 : i += 1;
  );
  minSpn;
);

function writeSamples(buf, len, att, f1) local(i, j, aplSum, U, s, fc, y, nz) (
  fc = 2.0 * $pi;
  aplSum = 0.0; i = 0;
  loop(12,
    apl[i] = harm[i];
    aplSum += abs(apl[i]);
    plHz[i] = f1 * (i + 1);
    (srate * 0.5) <= plHz[i] ? apl[i] = 0.0;
    i += 1;
  );
