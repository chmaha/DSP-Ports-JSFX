cc_build();
initMidiTables();
dbSet[0] = 8; dbSet[3] = 8;
i = 0; loop(9, setDrawBar(i, dbSet[i]); i += 1; );
dbSet[9] = 7; dbSet[10] = 8; dbSet[11] = 7; dbSet[18] = 7; dbSet[20] = 8;
vibKnob = 4; swellU = 127; od_char = 0; rv_mix = 0.1; curProg = 0;

i = 1; loop(111, slLast[i] = slDef[i]; i += 1; );
i = 45; loop(67, slLast[i] = slider(i); i += 1; );
boff = FS;
ui_dirty = 0;

function sync_sliders() local(i) (
  i = 0; loop(27, slider(i + 1) = dbSet[i]; i += 1; );
  slider(28) = percEnabled ? 1 : 0;
  slider(29) = percIsSoft ? 1 : 0;
  slider(30) = percIsFast ? 1 : 0;
  slider(31) = percSendBus == percSendBusA ? 1 : 0;
  slider(32) = vibKnob;
  slider(33) = newRouting & 2 ? 1 : 0;
  slider(34) = newRouting & 1 ? 1 : 0;
  slider(35) = swellU;
  slider(36) = idiv(lesSel, 3);
  slider(37) = imod(lesSel, 3);
  slider(38) = od_isClean ? 0 : 1;
  slider(39) = od_char;
  slider(40) = rv_mix;
  slider(41) = curProg;
  slider(47) = mTranspose; slider(48) = nshA; slider(49) = nshB; slider(50) = nshC;
  slider(75) = hornAcc; slider(76) = hornDec; slider(77) = drumAcc; slider(78) = drumDec;
  slider(85) = hnBrakePos; slider(86) = drBrakePos;
  slider(96) = haT; slider(97) = haF; slider(98) = haQ; slider(99) = haG;
  slider(100) = hbT; slider(101) = hbF; slider(102) = hbQ; slider(103) = hbG;
  slider(105) = od_inputGain; slider(106) = od_outputGain;
  slider(107) = splitA_UL; slider(108) = splitA_PL;
  slider(109) = nshA_PL; slider(110) = nshA_UL; slider(111) = nshA_U;
  i = 1; loop(111, slLast[i] = slider(i); i += 1; );
  sliderchange(-1);
);

function slch(i) ( slider(i) !== slLast[i]; );

function apply_sliders() local(i, other, tg, vb, pc, keys, rot, geo, s) (
  other = 0; i = 1;
  loop(111, i != 41 && slch(i) ? other = 1; i += 1; );
  slch(41) ? (
    !other ? installProgram(slider(41) - 1);
    slLast[41] = slider(41);
    ui_dirty ? ( sync_sliders(); ui_dirty = 0; );
  );
  other ? (
    tg = 0; i = 45; loop(2, slch(i) ? tg = 1; i += 1; );
    i = 51; loop(11, slch(i) ? tg = 1; i += 1; );
    pc = 0; i = 66; loop(5, slch(i) ? pc = 1; i += 1; );
    vb = 0; i = 62; loop(4, slch(i) ? vb = 1; i += 1; );
    i = 0;
    loop(27, slch(i + 1) ? ( dbSet[i] = slider(i + 1); setDrawBar(i, dbSet[i]); ); i += 1; );
    slch(28) ? setPercussionEnabled(slider(28));
    slch(29) ? setPercussionVolume(slider(29));
    slch(30) ? setPercussionFast(slider(30));
    slch(31) ? setPercussionFirst(slider(31));
    slch(32) ? setVibratoKnob(slider(32));
    slch(33) ? setVibratoUpper(slider(33));
    slch(34) ? setVibratoLower(slider(34));
    slch(35) ? setSwell(slider(35));
    slch(36) || slch(37) ? useRevOption(slider(36) * 3 + slider(37), 2);
    slch(38) ? od_isClean = slider(38) ? 0 : 1;
    slch(39) ? ( od_char = slider(39); ctl_biased_fat(od_char); );
    slch(40) ? ( rv_mix = slider(40); setReverbMix(rv_mix); );
    keys = 0; i = 42; loop(9, slch(i) ? keys = 1; i += 1; );
    i = 107; loop(5, slch(i) ? keys = 1; i += 1; );
    keys ? (
      cfg_midi(); initMidiTables(); midi_panic();
      i = 42; loop(9, slLast[i] = slider(i); i += 1; );
      i = 107; loop(5, slLast[i] = slider(i); i += 1; );
    );
    tg ? tonegen_reinit() : vb ? ( cfg_vibrato(); vib_init(); setVibratoKnob(vibKnob); );
    !tg && pc ? (
      percFastDecaySeconds = slider(66); percSlowDecaySeconds = slider(67);
      percEnvGainResetNorm = slider(68); percEnvGainResetSoft = slider(69); percEnvScaling = slider(70);
      computePercResets(); setPercussionVolume(percIsSoft);
    );
    rot = 0; i = 71; loop(4, slch(i) ? rot = 1; i += 1; );
    rot ? (
      hornRPMslow = slider(71); hornRPMfast = slider(72); drumRPMslow = slider(73); drumRPMfast = slider(74);
      s = lesSel; computeRotationSpeeds(); useRevOption(s, 0);
    );
    slch(75) ? hornAcc = slider(75); slch(76) ? hornDec = slider(76);
    slch(77) ? drumAcc = slider(77); slch(78) ? drumDec = slider(78);
    slch(79) || slch(80) ? ( hornLevel = slider(79); leakLevel = slider(80); leakage = leakLevel * hornLevel; );
    slch(81) ? fsetHornMicWidth(slider(81));
    slch(82) ? fsetDrumMicWidth(slider(82));
    geo = slch(83) || slch(84) || slch(88) || slch(89) || slch(90);
    geo ? (
      hornRadiusCm = slider(83); drumRadiusCm = slider(84);
      hornXOffsetCm = slider(88); hornZOffsetCm = slider(89); micDistCm = slider(90);
      computeOffsetsKeep(1);
    );
    slch(85) ? hnBrakePos = slider(85);
    slch(86) ? drBrakePos = slider(86);
    slch(87) ? micAngle = 1.0 - slider(87) / 180.0;
    slch(91) ? wh_bypass = slider(91);
    slch(92) || slch(93) || slch(94) || slch(95) ? (
      lpT = slider(92); lpF = slider(93); lpQ = slider(94); lpG = slider(95);
      setIIR(drfL, lpT, lpF, lpQ, lpG); setIIR(drfR, lpT, lpF, lpQ, lpG);
    );
    slch(96) || slch(97) || slch(98) || slch(99) ? ( haT = slider(96); haF = slider(97); haQ = slider(98); haG = slider(99); horn_filterA(); );
    slch(100) || slch(101) || slch(102) || slch(103) ? ( hbT = slider(100); hbF = slider(101); hbQ = slider(102); hbG = slider(103); horn_filterB(); );
    slch(104) ? rv_inputGain = slider(104);
    slch(105) ? od_inputGain = slider(105);
    slch(106) ? od_outputGain = slider(106);
    i = 1; loop(111, slLast[i] = slider(i); i += 1; );
  );
);

@slider
last_srate != srate ? rate_change();

@serialize
ser_ver = 1;
file_var(0, ser_ver);
ser_n = 0;
file_avail(0) < 0 ? ( k = 1; loop(128, usr[k] ? ser_n += 1; k += 1; ); );
file_var(0, ser_n);
file_avail(0) >= 0 ? (
  loop(ser_n,
    file_var(0, sp_);
    sp_ >= 1 && sp_ <= 128 ? (
      file_var(0, pg_flags[sp_]);
      k = 0; loop(27, file_var(0, pg_db[sp_ * 27 + k]); k += 1; );
      file_var(0, pg_sc[sp_]); file_var(0, pg_pe[sp_]); file_var(0, pg_pv[sp_]); file_var(0, pg_ps[sp_]);
      file_var(0, pg_ph[sp_]); file_var(0, pg_od[sp_]); file_var(0, pg_rs[sp_]); file_var(0, pg_rm[sp_]);
      file_string(0, 200 + sp_); pg_name[sp_] = 200 + sp_; usr[sp_] = 1;
    );
  );
) : (
  k = 1;
  loop(128,
    usr[k] ? (
      sp_ = k; file_var(0, sp_);
      file_var(0, pg_flags[k]);
      j = 0; loop(27, file_var(0, pg_db[k * 27 + j]); j += 1; );
      file_var(0, pg_sc[k]); file_var(0, pg_pe[k]); file_var(0, pg_pv[k]); file_var(0, pg_ps[k]);
      file_var(0, pg_ph[k]); file_var(0, pg_od[k]); file_var(0, pg_rs[k]); file_var(0, pg_rm[k]);
      file_string(0, 200 + k);
    );
    k += 1;
  );
);
file_var(0, map_user);
map_user ? (
  k = 0; loop(128, file_var(0, useA[k]); file_var(0, useB[k]); file_var(0, useC[k]); k += 1; );
  k = 0; loop(128, file_var(0, vecA[k]); file_var(0, vecB[k]); file_var(0, vecC[k]); k += 1; );
);

@block
ui_dirty ? ( sync_sliders(); ui_dirty = 0; );
apply_sliders();
eq_n = 0; written = 0;
while (gq_r != gq_w) (
  evq[eq_n * 4] = 0; evq[eq_n * 4 + 1] = gq[gq_r * 3]; evq[eq_n * 4 + 2] = gq[gq_r * 3 + 1]; evq[eq_n * 4 + 3] = gq[gq_r * 3 + 2];
  eq_n += 1; gq_r = (gq_r + 1) & 255;
);
while (midirecv(mofs, m1, m2, m3)) (
  mp_ = (written + FS < mofs && mofs < samplesblock) ? mofs : written;
  written = mp_;
  eq_n < 4096 ? (
    evq[eq_n * 4] = mp_; evq[eq_n * 4 + 1] = m1; evq[eq_n * 4 + 2] = m2; evq[eq_n * 4 + 3] = m3;
    eq_n += 1;
  );
);
eq_n > 0 ? midi_flag = 1;
eq_i = 0; spos = 0;

@sample
while (eq_i < eq_n && evq[eq_i * 4] <= spos) (
  midi_event(evq[eq_i * 4 + 1], evq[eq_i * 4 + 2], evq[eq_i * 4 + 3]);
  eq_i += 1;
  eq_i >= eq_n && ui_dirty ? ( sync_sliders(); ui_dirty = 0; );
);
boff >= FS ? ( gen_fragment(); boff = 0; );
spl0 = outL[boff];
spl1 = outR[boff];
boff += 1;
spos += 1;

@gfx 1040 660

W0 = 1040; H0 = 660;
z = max(0.45, min(gfx_w / W0, gfx_h / H0));
ox = floor((gfx_w - W0 * z) * 0.5);
oy = floor((gfx_h - H0 * z) * 0.5);
now = time_precise();

function automate(s, e)
(
<? loop(i = 1; 111,
  printf("  s == %d ? slider_automate(slider%d, e) :\n", i, i);
  i += 1;
); ?>  0;
);

function sx(x) ( ox + x * z; );
function sy(y) ( oy + y * z; );
function hit(x, y, w, h) ( mouse_x >= sx(x) && mouse_x < sx(x + w) && mouse_y >= sy(y) && mouse_y < sy(y + h); );
function hitc(x, y, r) ( sqr(mouse_x - sx(x)) + sqr(mouse_y - sy(y)) <= sqr(r * z); );
function font(n, sz, fl) (
  n == 1 ? gfx_setfont(1, "Arial", (sz + 2) * z, fl) :
  n == 2 ? gfx_setfont(2, "Courier New", (sz + 2) * z, fl) :
  gfx_setfont(3, "Georgia", (sz + 2) * z, fl);
);
function clamp01(x) ( max(0, min(1, x)); );

function text_c(str, cx, y) local(tw, th) ( gfx_measurestr(str, tw, th); gfx_x = sx(cx) - tw * 0.5; gfx_y = sy(y); gfx_drawstr(str); );
function text_r(str, rx, y) local(tw, th) ( gfx_measurestr(str, tw, th); gfx_x = sx(rx) - tw; gfx_y = sy(y); gfx_drawstr(str); );
function text_l(str, lx, y) ( gfx_x = sx(lx); gfx_y = sy(y); gfx_drawstr(str); );

function glow_str(str, x, y, r, g, b) local(d) (
  d = max(1, z);
  gfx_set(r, g, b, 0.14);
  gfx_x = x - d; gfx_y = y; gfx_drawstr(str);
  gfx_x = x + d; gfx_y = y; gfx_drawstr(str);
  gfx_x = x; gfx_y = y - d; gfx_drawstr(str);
  gfx_x = x; gfx_y = y + d; gfx_drawstr(str);
  gfx_set(r, g, b, 1);
  gfx_x = x; gfx_y = y; gfx_drawstr(str);
);

function rrect(x, y, w, h, rad) local(QX, QY, QW, QH, QR) (
  QX = sx(x); QY = sy(y); QW = w * z; QH = h * z; QR = min(rad * z, min(QW, QH) * 0.5);
  gfx_rect(QX + QR, QY, QW - 2 * QR, QH, 1);
  gfx_rect(QX, QY + QR, QR, QH - 2 * QR, 1);
  gfx_rect(QX + QW - QR, QY + QR, QR, QH - 2 * QR, 1);
  gfx_circle(QX + QR, QY + QR, QR, 1, 1);
  gfx_circle(QX + QW - QR - 1, QY + QR, QR, 1, 1);
  gfx_circle(QX + QR, QY + QH - QR - 1, QR, 1, 1);
  gfx_circle(QX + QW - QR - 1, QY + QH - QR - 1, QR, 1, 1);
);

function soft_shadow(x, y, w, h, rad, n, a) local(i) (
  i = 1;
  loop(n,
    gfx_set(0, 0, 0, a * (1 - (i - 1) / n));
    gfx_roundrect(sx(x) - i, sy(y) - i + 2 * z, w * z + 2 * i, h * z + 2 * i, (rad + i / z) * z, 1);
    i += 1;
  );
);

function wood(x, y, w, h, dark) local(QX, QY, QW, QH, i, t, c, n) (
  QX = sx(x); QY = sy(y); QW = w * z; QH = h * z;
  c = dark ? 0.55 : 1;
  gfx_gradrect(QX, QY, QW, QH, 0.30 * c, 0.155 * c, 0.075 * c, 1, 0, 0, 0, 0, -0.08 * c / QH, -0.045 * c / QH, -0.025 * c / QH, 0);
  n = floor(QH / max(1, 1.5 * z));
  i = 0;
  loop(n,
    t = sin(i * 0.37) * 0.5 + sin(i * 0.071 + 1.3) * 0.35 + sin(i * 1.93) * 0.15;
    gfx_set(t > 0 ? 0.55 : 0.05, t > 0 ? 0.30 : 0.02, t > 0 ? 0.12 : 0.0, abs(t) * 0.10);
    gfx_line(QX, QY + i * QH / n, QX + QW, QY + i * QH / n + sin(i * 0.9) * 2 * z, 1);
    i += 1;
  );
);

function panel(x, y, w, h, title) local(tw, th) (
  soft_shadow(x, y, w, h, 6, max(3, floor(5 * z)), 0.16);
  gfx_set(0.075, 0.062, 0.052, 1);
  rrect(x, y, w, h, 6);
  gfx_gradrect(sx(x + 6), sy(y + 1), (w - 12) * z, 30 * z, 1, 0.9, 0.7, 0.04, 0, 0, 0, 0, 0, 0, 0, -0.04 / (30 * z));
  gfx_set(1, 0.85, 0.6, 0.07);
  gfx_line(sx(x + 6), sy(y) + 1, sx(x + w - 6), sy(y) + 1, 1);
  font(3, 11, 'b');
  gfx_measurestr(title, tw, th);
  gfx_set(0.90, 0.80, 0.60, 0.95);
  gfx_x = sx(x + 10); gfx_y = sy(y + 6);
  gfx_drawstr(title);
  gfx_set(0.90, 0.80, 0.60, 0.25);
  gfx_rect(sx(x + 10) + tw + 8 * z, sy(y + 12), sx(x + w - 10) - (sx(x + 10) + tw + 8 * z), max(1, z), 1);
);

function set_sl(i, v) local(st) (
  v = max(slMin[i], min(slMax[i], v));
  st = slStep[i];
  st >= 1 ? v = floor(v / st + 0.5) * st;
  slider(i) !== v ? ( slider(i) = v; automate(i, 0); );
  touched_i = i; touched_t = now;
);
function end_sl(i) ( automate(i, 1); );
function tap_sl(i, v) ( set_sl(i, v); end_sl(i); );



function is_live(i) (
  (i >= 71 && i <= 82) || (i >= 85 && i <= 87) || (i >= 91 && i <= 106);
);

function is_enum(i) ( i == 46 || i == 56 || i == 60 || i == 91 || i == 92 || i == 96 || i == 100; );
function lever_get(i) ( 0; );
function lever_set(i, v) ( 0; );
lever_hov = -1;
knob_r = 15;

function note_name(n, str) local(pc) (
  pc = n % 12;
  sprintf(str, "%s%d", pc == 0 ? "C" : pc == 1 ? "C#" : pc == 2 ? "D" : pc == 3 ? "D#" : pc == 4 ? "E" : pc == 5 ? "F" :
                       pc == 6 ? "F#" : pc == 7 ? "G" : pc == 8 ? "G#" : pc == 9 ? "A" : pc == 10 ? "A#" : "B", floor(n / 12) - 1);
);

function ftype_name(t, str) (
  strcpy(str, t == 0 ? "Low Pass" : t == 1 ? "High Pass" : t == 2 ? "Band Pass" : t == 3 ? "Band Pass 0dB" : t == 4 ? "Notch" :
              t == 5 ? "All Pass" : t == 6 ? "Peaking" : t == 7 ? "Low Shelf" : "High Shelf");
);

function sl_value(i) ( i == pend_i ? pend_v : slider(i); );

function fmt_sl(i, str) local(v, t) (
  v = sl_value(i);
  i <= 27 ? sprintf(str, "%d", v) :
  i == 28 ? strcpy(str, v ? "On" : "Off") :
  i == 29 ? strcpy(str, v ? "Soft" : "Normal") :
  i == 30 ? strcpy(str, v ? "Fast" : "Slow") :
  i == 31 ? strcpy(str, v ? "Second" : "Third") :
  i == 32 ? strcpy(str, v == 0 ? "V1" : v == 1 ? "C1" : v == 2 ? "V2" : v == 3 ? "C2" : v == 4 ? "V3" : "C3") :
  i == 33 || i == 34 || i == 38 ? strcpy(str, v ? "On" : "Off") :
  i == 35 ? sprintf(str, "%d%%", floor(v / 127 * 100 + 0.5)) :
  i == 36 || i == 37 ? strcpy(str, v == 0 ? "Stop" : v == 1 ? "Slow" : "Fast") :
  i == 39 ? sprintf(str, "%d", v) :
  i == 40 ? sprintf(str, "%d%%", floor(v * 100 + 0.5)) :
  i >= 42 && i <= 44 ? sprintf(str, "Ch %d", v) :
  i == 45 ? sprintf(str, "%.1f Hz", v) :
  i == 46 ? strcpy(str, v == 0 ? "Gear 60 Hz" : v == 1 ? "Gear 50 Hz" : "Equal") :
  (i >= 47 && i <= 50) || (i >= 109 && i <= 111) ? sprintf(str, "%+d st", v) :
  i >= 51 && i <= 55 ? ( v > 0 ? sprintf(str, "%.1f dB", 20 * log10(v)) : strcpy(str, i == 54 ? "Off" : "None"); ) :
  i == 56 || i == 60 ? strcpy(str, v == 0 ? "Click" : v == 1 ? "Shelf" : v == 2 ? "Cosine" : "Linear") :
  i == 57 || i == 61 ? sprintf(str, "%d%%", floor(v * 100 + 0.5)) :
  i == 58 || i == 59 ? ( v < 0 ? strcpy(str, "Auto") : sprintf(str, "%d smp", floor(128 * v)); ) :
  i == 62 ? sprintf(str, "%.2f Hz", v) :
  i >= 63 && i <= 65 ? sprintf(str, "%.1f", v) :
  i == 66 || i == 67 ? sprintf(str, "%.2f s", v) :
  (i >= 68 && i <= 69) || (i >= 79 && i <= 80) ? ( v > 0 ? sprintf(str, "%.1f dB", 20 * log10(v)) : strcpy(str, "-inf dB"); ) :
  i == 70 ? sprintf(str, "%.2f", v) :
  i >= 71 && i <= 74 ? sprintf(str, "%.1f rpm", v) :
  i >= 75 && i <= 78 ? sprintf(str, "%.3f s", v) :
  i == 81 || i == 82 ? ( abs(v) < 0.005 ? strcpy(str, "Stereo") : v <= -0.995 ? strcpy(str, "Mono L") : v >= 0.995 ? strcpy(str, "Mono R") : sprintf(str, "%+.2f", v); ) :
  i == 83 || i == 84 || (i >= 88 && i <= 90) ? sprintf(str, "%.1f cm", v) :
  i == 85 || i == 86 ? ( v <= 0 ? strcpy(str, "Free") : sprintf(str, "%.0f deg", v * 360); ) :
  i == 87 ? sprintf(str, "%.1f deg", v) :
  i == 91 ? strcpy(str, v ? "Bypassed" : "Active") :
  i == 92 || i == 96 || i == 100 ? ftype_name(v, str) :
  i == 93 || i == 97 || i == 101 ? ( v < 1000 ? sprintf(str, "%.0f Hz", v) : sprintf(str, "%.2f kHz", v / 1000); ) :
  i == 94 || i == 98 || i == 102 ? sprintf(str, "%.2f", v) :
  i == 95 || i == 99 || i == 103 ? sprintf(str, "%+.1f dB", v) :
  i == 104 ? sprintf(str, "%.3f", v) :
  i == 105 || i == 106 ? sprintf(str, "%.2f", v) :
  i == 107 || i == 108 ? ( v <= 0 ? strcpy(str, "Off") : note_name(v, str); ) :
  sprintf(str, "%.3f", v);
  str;
);

function name_sl(i, str) local(f) (
  f = (i - 1) % 9;
  i <= 27 ? (
    strcpy(str, i <= 9 ? "UPPER " : i <= 18 ? "LOWER " : "PEDAL ");
    strcat(str, f == 0 ? "16'" : f == 1 ? "5 1/3'" : f == 2 ? "8'" : f == 3 ? "4'" : f == 4 ? "2 2/3'" : f == 5 ? "2'" : f == 6 ? "1 3/5'" : f == 7 ? "1 1/3'" : "1'");
  ) :
  strcpy(str,
    i == 28 ? "PERCUSSION" : i == 29 ? "PERC VOLUME" : i == 30 ? "PERC DECAY" : i == 31 ? "PERC HARMONIC" :
    i == 32 ? "VIBRATO / CHORUS" : i == 33 ? "VIBRATO UPPER" : i == 34 ? "VIBRATO LOWER" : i == 35 ? "SWELL" :
    i == 36 ? "LESLIE HORN" : i == 37 ? "LESLIE DRUM" : i == 38 ? "OVERDRIVE" : i == 39 ? "OD CHARACTER" : i == 40 ? "REVERB" :
    i == 42 ? "UPPER CHANNEL" : i == 43 ? "LOWER CHANNEL" : i == 44 ? "PEDAL CHANNEL" :
    i == 45 ? "TUNING" : i == 46 ? "TEMPERAMENT" : i == 47 ? "TRANSPOSE" : i == 48 ? "TRANSPOSE UPPER" :
    i == 49 ? "TRANSPOSE LOWER" : i == 50 ? "TRANSPOSE PEDALS" : i == 51 ? "COMPARTMENT X-TALK" :
    i == 52 ? "TERMINAL X-TALK" : i == 53 ? "WIRING X-TALK" : i == 54 ? "X-TALK FLOOR" : i == 55 ? "X-TALK MINIMUM" :
    i == 56 ? "ATTACK MODEL" : i == 57 ? "KEY CLICK LEVEL" : i == 58 ? "CLICK LENGTH MIN" : i == 59 ? "CLICK LENGTH MAX" :
    i == 60 ? "RELEASE MODEL" : i == 61 ? "RELEASE CLICK" : i == 62 ? "VIBRATO RATE" : i == 63 ? "VIBRATO 1 DEPTH" :
    i == 64 ? "VIBRATO 2 DEPTH" : i == 65 ? "VIBRATO 3 DEPTH" : i == 66 ? "PERC FAST DECAY" : i == 67 ? "PERC SLOW DECAY" :
    i == 68 ? "PERC NORMAL LEVEL" : i == 69 ? "PERC SOFT LEVEL" : i == 70 ? "PERC GAIN" :
    i == 71 ? "HORN SLOW" : i == 72 ? "HORN FAST" : i == 73 ? "DRUM SLOW" : i == 74 ? "DRUM FAST" :
    i == 75 ? "HORN ACCEL" : i == 76 ? "HORN DECEL" : i == 77 ? "DRUM ACCEL" : i == 78 ? "DRUM DECEL" :
    i == 79 ? "HORN LEVEL" : i == 80 ? "HORN LEAKAGE" : i == 81 ? "HORN MIC" : i == 82 ? "DRUM MIC" :
    i == 83 ? "HORN RADIUS" : i == 84 ? "DRUM RADIUS" : i == 85 ? "HORN BRAKE" : i == 86 ? "DRUM BRAKE" :
    i == 87 ? "HORN MIC ANGLE" : i == 88 ? "HORN X OFFSET" : i == 89 ? "HORN Z OFFSET" : i == 90 ? "MIC DISTANCE" :
    i == 91 ? "LESLIE" : i == 92 ? "DRUM FILTER" : i == 93 ? "DRUM FILTER FREQ" : i == 94 ? "DRUM FILTER Q" : i == 95 ? "DRUM FILTER GAIN" :
    i == 96 ? "HORN FILTER 1" : i == 97 ? "HORN FILTER 1 FREQ" : i == 98 ? "HORN FILTER 1 Q" : i == 99 ? "HORN FILTER 1 GAIN" :
    i == 100 ? "HORN FILTER 2" : i == 101 ? "HORN FILTER 2 FREQ" : i == 102 ? "HORN FILTER 2 Q" : i == 103 ? "HORN FILTER 2 GAIN" :
    i == 104 ? "REVERB INPUT" : i == 105 ? "OD INPUT GAIN" : i == 106 ? "OD OUTPUT GAIN" :
    i == 107 ? "SPLIT LOWER" : i == 108 ? "SPLIT PEDALS" : i == 109 ? "SPLIT TRANSPOSE PDL" :
    i == 110 ? "SPLIT TRANSPOSE LWR" : i == 111 ? "SPLIT TRANSPOSE UPR" : "");
  str;
);

function knob_label(i, str) (
  page == 2 ? (
    strcpy(str, i == 71 || i == 73 ? "SLOW" : i == 72 || i == 74 ? "FAST" : i == 75 || i == 77 ? "ACCEL" : i == 76 || i == 78 ? "DECEL" :
      i == 85 || i == 86 ? "BRAKE" : i == 83 || i == 84 ? "RADIUS" : i == 79 ? "LEVEL" : i == 81 || i == 82 ? "MIC WIDTH" :
      i == 80 ? "LEAKAGE" : i == 90 ? "DISTANCE" : i == 87 ? "MIC ANGLE" : i == 88 ? "X OFFSET" : i == 89 ? "Z OFFSET" : i == 91 ? "LESLIE" :
      i == 92 || i == 96 || i == 100 ? "TYPE" : i == 93 || i == 97 || i == 101 ? "FREQ" : i == 94 || i == 98 || i == 102 ? "Q" : "GAIN");
  ) : name_sl(i, str);
  str;
);

function menu_from(i, items) local(sel) (
  sel = gfx_showmenu(items);
  sel > 0 ? tap_sl(i, slMin[i] + (sel - 1) * slStep[i]);
);

function enum_menu(i) local(v, n, k) (
  v = slider(i);
  i == 46 ? sprintf(#m, "%sGear 60 Hz|%sGear 50 Hz|%sEqual", v == 0 ? "!" : "", v == 1 ? "!" : "", v == 2 ? "!" : "") :
  i == 56 || i == 60 ? sprintf(#m, "%sClick|%sShelf|%sCosine|%sLinear", v == 0 ? "!" : "", v == 1 ? "!" : "", v == 2 ? "!" : "", v == 3 ? "!" : "") :
  i == 91 ? sprintf(#m, "%sActive|%sBypassed", v == 0 ? "!" : "", v == 1 ? "!" : "") :
  i == 32 ? sprintf(#m, "%sV1|%sC1|%sV2|%sC2|%sV3|%sC3", v == 0 ? "!" : "", v == 1 ? "!" : "", v == 2 ? "!" : "", v == 3 ? "!" : "", v == 4 ? "!" : "", v == 5 ? "!" : "") :
  (
    strcpy(#m, ""); k = 0;
    loop(9, ftype_name(k, #t); strcat(#m, sprintf(#u, "%s%s%s", k ? "|" : "", k == v ? "!" : "", #t)); k += 1; );
  );
  menu_from(i, #m);
);

function chan_menu(i) local(k, v) (
  v = slider(i); strcpy(#m, ""); k = 1;
  loop(16, strcat(#m, sprintf(#u, "%s%sChannel %d", k > 1 ? "|" : "", k == v ? "!" : "", k)); k += 1; );
  menu_from(i, #m);
);

function tooltip(x, y, str) local(tw, th, bx, by, bw, bh) (
  font(1, 11, 'b');
  gfx_measurestr(str, tw, th);
  bw = tw + 12 * z; bh = th + 6 * z;
  bx = max(2, min(gfx_w - bw - 2, sx(x) - bw * 0.5)); by = sy(y) - bh;
  gfx_set(0.03, 0.025, 0.02, 0.93);
  gfx_rect(bx, by, bw, bh, 1);
  gfx_set(1.0, 0.62, 0.28, 0.8);
  gfx_rect(bx, by + bh - max(1, z), bw, max(1, z), 1);
  gfx_set(1, 0.95, 0.88, 1);
  gfx_x = bx + 6 * z; gfx_y = by + 3 * z;
  gfx_drawstr(str);
);

function vknob_body(x, y, r) local(QX, QY, QR, i, t, c) (
  QX = sx(x); QY = sy(y); QR = r * z;
  gfx_set(0, 0, 0, 0.5);
  gfx_circle(QX + z, QY + 2.5 * z, QR + 4 * z, 1, 1);
  i = 0;
  loop(ceil(4 * z) + 1,
    t = i / (ceil(4 * z) + 1);
    gfx_set(0.55 + 0.35 * t, 0.56 + 0.35 * t, 0.58 + 0.35 * t, 1);
    gfx_circle(QX, QY, QR + 4 * z - i, 1, 1);
    i += 1;
  );
  gfx_set(0.25, 0.25, 0.27, 1);
  gfx_circle(QX, QY, QR + 0.5 * z, 0, 1);
  i = 0;
  loop(ceil(QR),
    t = i / ceil(QR);
    c = 0.04 + 0.13 * t;
    gfx_set(c, c * 0.95, c * 0.9, 1);
    gfx_circle(QX - QR * 0.2 * t, QY - QR * 0.25 * t, QR * (1 - t * 0.9), 1, 1);
    i += 1;
  );
  gfx_set(1, 1, 1, 0.12);
  gfx_arc(QX, QY, QR - 1.5 * z, -1.9, 0.1, 1);
);

function vknob(x, y, r, i, label, bip) local(pos, hov, nv, d, a, a0, a1, QX, QY, QR, k, v, fine) (
  hov = hitc(x, y, r + 6);
  (mouse_click && hov) ? (
    (last_click_i == i && now - last_click_t < 0.3) ? ( tap_sl(i, slDef[i]); drag_i = -1; ) :
      ( drag_i = i; drag_y0 = mouse_y; drag_v0 = slider(i); );
    last_click_i = i; last_click_t = now; mouse_click = 0;
  );
  drag_i == i ? (
    mouse_cap |= 65536;
    fine = (mouse_cap & 4) || (mouse_cap & 8);
    d = (drag_y0 - mouse_y) / (200 * z) * (fine ? 0.12 : 1);
    nv = drag_v0 + d * (slMax[i] - slMin[i]);
    set_sl(i, nv);
  );
  (hov && mouse_wheel != 0 && drag_i < 0) ? (
    nv = slider(i) + (mouse_wheel > 0 ? 1 : -1) * max(slStep[i], (slMax[i] - slMin[i]) * ((mouse_cap & 4) ? 0.004 : 0.03));
    tap_sl(i, nv); mouse_wheel = 0;
  );
  vknob_body(x, y, r);
  QX = sx(x); QY = sy(y); QR = r * z;
  pos = (slider(i) - slMin[i]) / (slMax[i] - slMin[i]);
  a0 = -2.35619; a1 = 2.35619;
  a = a0 + (a1 - a0) * clamp01(pos);
  k = 0;
  loop(11,
    v = a0 + (a1 - a0) * k / 10;
    gfx_set(0.9, 0.82, 0.62, (v <= a + 0.001) ? 0.85 : 0.25);
    gfx_line(QX + sin(v) * (QR + 6 * z), QY - cos(v) * (QR + 6 * z), QX + sin(v) * (QR + 9 * z), QY - cos(v) * (QR + 9 * z), 1);
    k += 1;
  );
  gfx_set(0.97, 0.95, 0.9, 1);
  gfx_line(QX + sin(a) * QR * 0.25, QY - cos(a) * QR * 0.25, QX + sin(a) * QR * 0.9, QY - cos(a) * QR * 0.9, 1);
  gfx_line(QX + sin(a) * QR * 0.25 + 0.8 * cos(a), QY - cos(a) * QR * 0.25 + 0.8 * sin(a), QX + sin(a) * QR * 0.9 + 0.8 * cos(a), QY - cos(a) * QR * 0.9 + 0.8 * sin(a), 1);
  font(1, 9, 'b');
  gfx_set(0.85, 0.77, 0.58, 1);
  text_c(label, x, y + r + 11);
  (hov || drag_i == i) ? ( hov_i = i; hov_x = x; hov_y = y - r - 10; );
);

function tablet(x, y, w, h, on, l1, l2) local(QX, QY, QW, QH, hov, t, tw, th) (
  QX = sx(x); QY = sy(y); QW = w * z; QH = h * z;
  hov = hit(x, y, w, h);
  gfx_set(0, 0, 0, 0.55);
  rrect(x - 1.5, y - 1.5, w + 3, h + 3, 4);
  on ? gfx_gradrect(QX, QY, QW, QH, 0.80, 0.76, 0.66, 1, 0, 0, 0, 0, 0.16 / QH, 0.16 / QH, 0.15 / QH, 0)
     : gfx_gradrect(QX, QY, QW, QH, 0.98, 0.95, 0.86, 1, 0, 0, 0, 0, -0.20 / QH, -0.20 / QH, -0.20 / QH, 0);
  on ? ( gfx_set(0, 0, 0, 0.22); gfx_rect(QX, QY, QW, 3 * z, 1); )
     : ( gfx_set(0, 0, 0, 0.18); gfx_rect(QX, QY + QH - 4 * z, QW, 4 * z, 1); gfx_set(1, 1, 1, 0.5); gfx_rect(QX, QY, QW, max(1, z), 1); );
  hov ? ( gfx_set(1, 1, 1, 0.08); gfx_rect(QX, QY, QW, QH, 1); );
  gfx_set(0.10, 0.07, 0.05, 1);
  t = y + h * (on ? 0.24 : 0.18);
  font(1, 6, 'b');
  text_c(l1, x + w * 0.5, t);
  font(3, 9, 'b');
  text_c(l2, x + w * 0.5, t + 10);
  gfx_set(1.0, 0.55, 0.18, on ? 1 : 0.12);
  gfx_circle(QX + QW * 0.5, QY + QH - 9 * z, 2.5 * z, 1, 1);
  on ? ( gfx_set(1.0, 0.55, 0.18, 0.25); gfx_circle(QX + QW * 0.5, QY + QH - 9 * z, 5 * z, 1, 1); );
  ret = mouse_click && hov;
  ret ? mouse_click = 0;
  ret;
);

function arrow(x, y, w, h, dir) local(hov, QX, QY, QW, QH, cx, cy, s) (
  QX = sx(x); QY = sy(y); QW = w * z; QH = h * z;
  hov = hit(x, y, w, h);
  gfx_set(0.02, 0.018, 0.015, 1);
  gfx_rect(QX - z, QY - z, QW + 2 * z, QH + 2 * z, 1);
  gfx_set(hov ? 0.20 : 0.13, hov ? 0.17 : 0.11, hov ? 0.13 : 0.09, 1);
  gfx_rect(QX, QY, QW, QH, 1);
  cx = QX + QW * 0.5; cy = QY + QH * 0.5; s = 6 * z;
  gfx_set(1.0, 0.62, 0.28, hov ? 1 : 0.8);
  dir < 0 ? gfx_triangle(cx + s * 0.55, cy - s, cx + s * 0.55, cy + s, cx - s * 0.65, cy)
          : gfx_triangle(cx - s * 0.55, cy - s, cx - s * 0.55, cy + s, cx + s * 0.65, cy);
  ret = mouse_click && hov;
  ret ? mouse_click = 0;
  ret;
);

function btn(x, y, w, h, label, lit) local(QX, QY, QW, QH, hov) (
  QX = sx(x); QY = sy(y); QW = w * z; QH = h * z;
  hov = hit(x, y, w, h);
  gfx_set(0, 0, 0, 0.55);
  rrect(x - 1, y - 1, w + 2, h + 2, 4);
  gfx_gradrect(QX, QY, QW, QH, lit ? 0.55 : 0.20, lit ? 0.33 : 0.15, lit ? 0.14 : 0.11, 1, 0, 0, 0, 0, -0.1 / QH, -0.08 / QH, -0.06 / QH, 0);
  hov ? ( gfx_set(1, 1, 1, 0.08); gfx_rect(QX, QY, QW, QH, 1); );
  font(1, 10, 'b');
  gfx_set(0.96, 0.88, 0.72, 1);
  text_c(label, x + w * 0.5, y + h * 0.5 - 6);
  ret = mouse_click && hov;
  ret ? mouse_click = 0;
  ret;
);

function lever(x, y, i, label) local(v, pos, QX, QY, a, px, py, k, hov, lx) (
  v = i > 0 ? slider(i) : lever_get(i);
  pos = v == 1 ? -1 : v == 0 ? 0 : 1;
  font(1, 8.5, 'b');
  k = 0;
  loop(3,
    lx = x + (k - 1) * 28;
    gfx_set(0.9, 0.82, 0.62, (k - 1) == pos ? 1 : 0.4);
    text_c(k == 0 ? "SLOW" : k == 1 ? "STOP" : "FAST", lx, y - 34);
    hov = hit(lx - 14, y - 36, 28, 50);
    (mouse_click && hov) ? ( i > 0 ? tap_sl(i, k == 0 ? 1 : k == 1 ? 0 : 2) : lever_set(i, k == 0 ? 1 : k == 1 ? 0 : 2); mouse_click = 0; );
    k += 1;
  );
  QX = sx(x); QY = sy(y);
  gfx_set(0, 0, 0, 0.5);
  gfx_circle(QX, QY + 2 * z, 10 * z, 1, 1);
  gfx_set(0.62, 0.62, 0.64, 1);
  gfx_circle(QX, QY, 9 * z, 1, 1);
  gfx_set(0.85, 0.85, 0.87, 1);
  gfx_circle(QX - 2 * z, QY - 2 * z, 5 * z, 1, 1);
  a = pos * 0.62;
  px = sin(a); py = -cos(a);
  k = 0;
  loop(ceil(4 * z),
    gfx_set(0.72 + 0.05 * k, 0.72 + 0.05 * k, 0.75 + 0.05 * k, 1);
    gfx_line(QX + (k - 1.5) * cos(a), QY + (k - 1.5) * sin(a), QX + px * 20 * z + (k - 1.5) * cos(a), QY + py * 20 * z + (k - 1.5) * sin(a), 1);
    k += 1;
  );
  gfx_set(0.92, 0.92, 0.94, 1);
  gfx_circle(QX + px * 21 * z, QY + py * 21 * z, 3.5 * z, 1, 1);
  font(1, 9, 'b');
  gfx_set(0.85, 0.77, 0.58, 1);
  text_c(label, x, y + 14);
  hit(x - 42, y - 36, 84, 64) ? ( hov_i = i > 0 ? i : lever_hov; hov_x = x; hov_y = y - 40; );
);

function rotor_view(cx, cy, r) local(QX, QY, QR, a, d, i, hx, hy, bl, t) (
  QX = sx(cx); QY = sy(cy); QR = r * z;
  gfx_set(0, 0, 0, 0.5);
  gfx_circle(QX + z, QY + 2 * z, QR + 4 * z, 1, 1);
  i = 0;
  loop(ceil(4 * z) + 1,
    t = i / (ceil(4 * z) + 1);
    gfx_set(0.45 + 0.4 * t, 0.45 + 0.4 * t, 0.47 + 0.4 * t, 1);
    gfx_circle(QX, QY, QR + 4 * z - i, 1, 1);
    i += 1;
  );
  gfx_set(0.05, 0.045, 0.04, 1);
  gfx_circle(QX, QY, QR, 1, 1);
  a = 2 * $pi * drumAngleGRD;
  gfx_set(0.22, 0.19, 0.16, 1);
  gfx_circle(QX, QY, QR * 0.78, 1, 1);
  gfx_set(0.62, 0.52, 0.40, 0.9);
  i = 0;
  loop(28,
    d = a + $pi * (i / 27 - 0.5);
    gfx_line(QX + sin(d) * QR * 0.40, QY - cos(d) * QR * 0.40, QX + sin(d) * QR * 0.76, QY - cos(d) * QR * 0.76, 1);
    i += 1;
  );
  gfx_set(0.10, 0.09, 0.08, 1);
  gfx_circle(QX, QY, QR * 0.36, 1, 1);
  a = 2 * $pi * hornAngleGRD;
  hx = sin(a); hy = -cos(a);
  t = max(2 * z, QR * 0.035);
  gfx_set(0.80, 0.76, 0.68, 1);
  gfx_triangle(QX - hx * QR * 0.62 + t * hy, QY - hy * QR * 0.62 - t * hx, QX + hx * QR * 0.62 + t * hy, QY + hy * QR * 0.62 - t * hx,
               QX + hx * QR * 0.62 - t * hy, QY + hy * QR * 0.62 + t * hx, QX - hx * QR * 0.62 - t * hy, QY - hy * QR * 0.62 + t * hx);
  bl = QR * 0.24;
  gfx_set(0.95, 0.91, 0.82, 1);
  gfx_triangle(QX + hx * QR * 0.55, QY + hy * QR * 0.55, QX + hx * QR * 0.92 + hy * bl, QY + hy * QR * 0.92 - hx * bl,
               QX + hx * QR * 0.92 - hy * bl, QY + hy * QR * 0.92 + hx * bl);
  gfx_set(0.40, 0.38, 0.35, 1);
  gfx_triangle(QX - hx * QR * 0.55, QY - hy * QR * 0.55, QX - hx * QR * 0.80 + hy * bl * 0.7, QY - hy * QR * 0.80 - hx * bl * 0.7,
               QX - hx * QR * 0.80 - hy * bl * 0.7, QY - hy * QR * 0.80 + hx * bl * 0.7);
  gfx_set(0.7, 0.7, 0.72, 1);
  gfx_circle(QX, QY, 3 * z, 1, 1);
  gfx_set(0.9, 0.82, 0.62, 0.9);
  r < 40 ? (
    font(1, 8.5, 'b');
    sprintf(#rp, "HORN %d", floor(hornIncr * srate * 60 + 0.5)); text_c(#rp, cx, cy + r + 6);
    sprintf(#rp, "DRUM %d", floor(drumIncr * srate * 60 + 0.5)); text_c(#rp, cx, cy + r + 17);
  ) : (
    font(1, 9, 'b');
    sprintf(#rp, "HORN %d  DRUM %d", floor(hornIncr * srate * 60 + 0.5), floor(drumIncr * srate * 60 + 0.5));
    text_c(#rp, cx, cy + r + 8);
  );
);

function kmode(i) ( (i >= 51 && i <= 55) ? 1 : (i == 93 || i == 97 || i == 101) ? 2 : 0; );
function v2k(i, v) local(m) (
  m = kmode(i);
  m == 1 ? ( v <= 0 ? 0 : clamp01((20 * log10(v) + 100) / 100); ) :
  m == 2 ? clamp01(log(max(slMin[i], v) / slMin[i]) / log(slMax[i] / slMin[i])) :
  (v - slMin[i]) / (slMax[i] - slMin[i]);
);
function k2v(i, k) local(m) (
  m = kmode(i); k = clamp01(k);
  m == 1 ? ( k <= 0.001 ? 0 : pow(10, (k * 100 - 100) / 20); ) :
  m == 2 ? slMin[i] * pow(slMax[i] / slMin[i], k) :
  slMin[i] + k * (slMax[i] - slMin[i]);
);

function set_knob(x, y, i) local(hov, nv, d, fine, v, QX, QY, r, pos, a, a0, a1, en, k) (
  r = knob_r;
  en = is_enum(i);
  hov = hitc(x, y, r + 6);
  en ? (
    (mouse_click && hov) ? ( gfx_x = sx(x - r); gfx_y = sy(y + r); enum_menu(i); mouse_click = 0; );
  ) : (
    (mouse_click && hov) ? (
      (last_click_i == i && now - last_click_t < 0.3) ? (
        tap_sl(i, slDef[i]); drag_i = -1; pend_i = -1;
      ) : (
        drag_i = i; drag_y0 = mouse_y; drag_v0 = v2k(i, slider(i));
        !is_live(i) ? ( pend_i = i; pend_v = slider(i); );
      );
      last_click_i = i; last_click_t = now; mouse_click = 0;
    );
    drag_i == i ? (
      mouse_cap |= 65536;
      fine = (mouse_cap & 4) || (mouse_cap & 8);
      d = (drag_y0 - mouse_y) / (220 * z) * (fine ? 0.1 : 1);
      nv = k2v(i, drag_v0 + d);
      nv = max(slMin[i], min(slMax[i], nv));
      slStep[i] >= 1 ? nv = floor(nv / slStep[i] + 0.5) * slStep[i];
      is_live(i) ? set_sl(i, nv) : ( pend_v = nv; touched_i = i; touched_t = now; );
    );
    (hov && mouse_wheel != 0 && drag_i < 0) ? (
      nv = kmode(i) || slStep[i] < 1 ? k2v(i, v2k(i, slider(i)) + (mouse_wheel > 0 ? 1 : -1) * ((mouse_cap & 4) ? 0.002 : 0.02))
                                     : slider(i) + (mouse_wheel > 0 ? 1 : -1) * slStep[i];
      tap_sl(i, nv); mouse_wheel = 0;
    );
  );
  vknob_body(x, y, r);
  QX = sx(x); QY = sy(y);
  v = sl_value(i);
  pos = v2k(i, v);
  a0 = -2.35619; a1 = 2.35619;
  a = a0 + (a1 - a0) * clamp01(pos);
  gfx_set(1.0, 0.62, 0.28, 0.9);
  k = 0; loop(ceil(3 * z), gfx_arc(QX, QY, (r + 5) * z + k * 0.5, a0, a, 1); k += 1; );
  gfx_set(1.0, 0.62, 0.28, 0.15);
  gfx_arc(QX, QY, (r + 5) * z, a, a1, 1);
  gfx_set(0.97, 0.95, 0.9, 1);
  gfx_line(QX + sin(a) * r * 0.25 * z, QY - cos(a) * r * 0.25 * z, QX + sin(a) * r * 0.9 * z, QY - cos(a) * r * 0.9 * z, 1);
  k = r < 13 ? 9.5 : 10.5;
  font(1, k, 'b');
  gfx_set(0.90, 0.82, 0.62, 1);
  knob_label(i, #kn);
  text_c(#kn, x, y + r + 9);
  fmt_sl(i, #kv);
  font(1, k + 0.5, 'b');
  gfx_set(1.0, 0.72, 0.42, 1);
  text_c(#kv, x, y + r + 10 + k * 1.25);
  (hov || drag_i == i) ? ( hov_i = i; hov_x = x; hov_y = y - r - 8; );
);



function db_color(f) (
  (f == 0 || f == 1) ? ( dbr = 0.40; dbg = 0.19; dbb = 0.08; dbt = 0.95; ) :
  (f == 4 || f == 6 || f == 7) ? ( dbr = 0.07; dbg = 0.065; dbb = 0.06; dbt = 0.95; ) :
  ( dbr = 0.93; dbg = 0.90; dbb = 0.82; dbt = 0.12; );
);

function drawbar(x, i, f, lab) local(v, QX, QY, SW, L, ext, k, hov, col, hy, y0, nv, cy, tw, th, grab) (
  y0 = 112; L = 20;
  v = slider(i);
  QX = sx(x);
  db_color(f);
  hov = hit(x - 2, y0 - 6, 30, 8 * L + 44);
  (mouse_click && hov) ? (
    hy = y0 + v * L;
    grab = mouse_y >= sy(hy) - 2 * z;
    (last_click_i == i && now - last_click_t < 0.3) ? ( tap_sl(i, 0); drag_i = -1; ) : (
      drag_i = i; drag_y0 = mouse_y; drag_v0 = v;
      !grab ? ( nv = floor((mouse_y - sy(y0)) / (L * z) + 0.5); set_sl(i, nv); drag_v0 = slider(i); );
    );
    last_click_i = i; last_click_t = now; mouse_click = 0;
  );
  drag_i == i ? ( nv = floor(drag_v0 + (mouse_y - drag_y0) / (L * z) + 0.5); set_sl(i, nv); );
  (hov && mouse_wheel != 0 && drag_i < 0) ? ( tap_sl(i, v + (mouse_wheel > 0 ? -1 : 1)); mouse_wheel = 0; );
  v = slider(i);
  ext = v * L;
  gfx_set(0, 0, 0, 1);
  gfx_rect(QX - 2 * z, sy(y0 - 4), 30 * z, 6 * z, 1);
  gfx_set(0.35, 0.33, 0.30, 1);
  gfx_rect(QX - 2 * z, sy(y0 + 2), 30 * z, max(1, z), 1);
  SW = 18;
  ext > 0 ? (
    gfx_set(0, 0, 0, 0.35);
    gfx_rect(sx(x + 5 + 2), sy(y0), SW * z, ext * z, 1);
    gfx_gradrect(sx(x + 5), sy(y0), SW * z, ext * z, dbr * 0.8, dbg * 0.8, dbb * 0.8, 1, 0.05 / (SW * z), 0.05 / (SW * z), 0.05 / (SW * z), 0, 0, 0, 0, 0);
    font(1, 9, 'b');
    k = 1;
    loop(v,
      cy = y0 + (k - 0.5) * L;
      sprintf(#dn, "%d", k);
      gfx_measurestr(#dn, tw, th);
      gfx_set(dbt, dbt * 0.97, dbt * 0.92, 0.9);
      gfx_x = sx(x + 14) - tw * 0.5; gfx_y = sy(cy) - th * 0.5;
      gfx_drawstr(#dn);
      gfx_set(0, 0, 0, 0.25);
      gfx_rect(sx(x + 5), sy(y0 + k * L) - max(1, z), SW * z, max(1, z), 1);
      k += 1;
    );
  );
  hy = y0 + ext;
  gfx_set(0, 0, 0, 0.45);
  rrect(x + 1.5, hy + 2, 26, 30, 5);
  col = hov || drag_i == i ? 1.08 : 1;
  gfx_set(min(1, dbr * col * 0.8), min(1, dbg * col * 0.8), min(1, dbb * col * 0.8), 1);
  rrect(x, hy, 26, 30, 5);
  gfx_gradrect(sx(x + 1), sy(hy + 1), 24 * z, 26 * z, min(1, dbr * col), min(1, dbg * col), min(1, dbb * col), 1, 0, 0, 0, 0, -0.08 / (26 * z), -0.08 / (26 * z), -0.08 / (26 * z), 0);
  gfx_set(1, 1, 1, dbr > 0.5 ? 0.55 : 0.2);
  gfx_rect(sx(x + 4), sy(hy + 1.5), 18 * z, max(1, z), 1);
  gfx_set(dbr > 0.5 ? 0.55 : 0.0, dbr > 0.5 ? 0.5 : 0.0, dbr > 0.5 ? 0.42 : 0.0, 0.25);
  gfx_rect(sx(x + 2), sy(hy + 20), 22 * z, max(1, z), 1);
  strlen(lab) > 3 ? font(3, 7, 'b') : font(3, 10, 'b');
  gfx_set(dbt, dbt * 0.97, dbt * 0.9, 1);
  text_c(lab, x + 13, hy + (strlen(lab) > 3 ? 8 : 6));
  (hov || drag_i == i) ? ( hov_i = i; hov_x = x + 13; hov_y = y0 - 8; );
);

function foot_lab(f) (
  f == 0 ? "16'" : f == 1 ? "5 1/3" : f == 2 ? "8'" : f == 3 ? "4'" : f == 4 ? "2 2/3" : f == 5 ? "2'" : f == 6 ? "1 3/5" : f == 7 ? "1 1/3" : "1'";
);


function db_group(x, first, n, title) local(k, tw, th) (
  font(3, 12, 'b');
  gfx_set(0.92, 0.84, 0.66, 1);
  text_c(title, x + ((n - 1) * 34 + 26) * 0.5, 82);
  k = 0;
  loop(n,
    drawbar(x + k * 34, first + k, k, foot_lab(k));
    k += 1;
  );
);
function reg9(str, i) (
  sprintf(str, "%d%d %d%d%d%d %d%d%d", slider(i), slider(i + 1), slider(i + 2), slider(i + 3), slider(i + 4),
    slider(i + 5), slider(i + 6), slider(i + 7), slider(i + 8));
);
function lcd_menu() local(p, k, g, cnt) (
  strcpy(#m, ""); cnt = 0;
  p = 1;
  loop(110,
    pg_flags[p] & 1 ? (
      cnt % 20 == 0 ? (
        cnt > 0 ? strcat(#m, "|<|");
        strcat(#m, sprintf(#u, ">%d-%d|", p, min(110, p + 19)));
      ) : strcat(#m, "|");
      strcat(#m, sprintf(#u, "%s%d  %s", p == slider(41) ? "!" : "", p, pg_name[p]));
      cnt += 1;
    );
    p += 1;
  );
  strcat(#m, "|<|>User bank");
  loop(18,
    pg_flags[p] & 1 ? strcat(#m, sprintf(#u, "|%s%d  %s", p == slider(41) ? "!" : "", p, pg_name[p])) :
      strcat(#m, sprintf(#u, "|#%d  (empty)", p));
    p += 1;
  );
  strcat(#m, "|<");
  k = gfx_showmenu(#m);
  k > cnt ? g = 110 + k - cnt : (
    cnt = 0; p = 1; g = 0;
    loop(110, pg_flags[p] & 1 ? ( cnt += 1; cnt == k ? g = p; ); p += 1; );
  );
  g > 0 && (pg_flags[g] & 1) ? ( slider(41) = g; automate(41, 0); automate(41, 1); );
);

function step_prog(d) local(p, n) (
  p = slider(41); n = 0;
  while (n < 128) ( p += d; p < 1 ? p = 128; p > 128 ? p = 1; (pg_flags[p] & 1) ? n = 999 : n += 1; );
  slider(41) = p; automate(41, 0); automate(41, 1);
);

function sl2fid(i) (
  i >= 1 && i <= 27 ? i - 1 :
  i == 28 ? 27 : i == 29 ? 30 : i == 30 ? 28 : i == 31 ? 29 : i == 32 ? 31 : i == 33 ? 33 : i == 34 ? 34 :
  i == 35 ? 35 : i == 36 || i == 37 ? 39 : i == 38 ? 58 : i == 39 ? 59 : i == 40 ? 67 :
  i >= 96 && i <= 103 ? 40 + (i - 96) : i == 85 ? 52 : i == 86 ? 53 : i >= 75 && i <= 78 ? 54 + (i - 75) :
  i == 105 ? 60 : i == 106 ? 61 : -1;
);

function learn_menu(i) local(f, sel, k, n) (
  f = sl2fid(i);
  f >= 0 ? (
    n = 0; k = 0; loop(128, (vecA[k] == f || vecB[k] == f || vecC[k] == f) ? n += 1; k += 1; );
    sprintf(#m, "MIDI learn...|%sForget MIDI controllers for this control|%sReset all MIDI controllers", n ? "" : "#", map_user ? "" : "#");
    gfx_x = mouse_x; gfx_y = mouse_y;
    sel = gfx_showmenu(#m);
    sel == 1 ? ( learn_fid = f; learn_sl = i; ) :
    sel == 2 ? cc_forget(f) :
    sel == 3 ? cc_reset();
  );
);

function store_menu() local(p, sel) (
  strcpy(#m, "#User bank"); p = 111;
  loop(18,
    strcat(#m, "|");
    pg_flags[p] & 1 ? strcat(#m, sprintf(#u, "%d  %s", p, pg_name[p])) : strcat(#m, sprintf(#u, "%d  (empty)", p));
    p += 1;
  );
  sel = gfx_showmenu(#m);
  sel > 1 ? (
    store_p = 109 + sel;
    pg_flags[store_p] & 1 ? strcpy(#nm, pg_name[store_p]) : sprintf(#nm, "User %d", store_p);
    store_mode = 1;
  );
);

function store_keys() local(c, n) (
  c = gfx_getchar();
  while (c > 0) (
    c == 13 ? (
      store_program(store_p, #nm);
      slider(41) = store_p; slLast[41] = store_p; curProg = store_p; automate(41, 0); automate(41, 1);
      store_mode = 0; c = 0;
    ) : c == 27 ? ( store_mode = 0; c = 0; ) :
    c == 8 ? ( n = strlen(#nm); n > 0 ? str_setlen(#nm, n - 1); ) :
    c >= 32 && c < 127 && strlen(#nm) < 24 ? ( sprintf(#c1, "%c", c); strcat(#nm, #c1); );
    c > 0 ? c = gfx_getchar();
  );
);

function lcd() local(x, y, w, h, gx, gy, gw, gh, lr, lg, lb, tw, th, p, hovp, ii, yy) (
  x = 356; y = 7; w = 392; h = 62;
  gfx_set(0, 0, 0, 0.6);
  gfx_rect(sx(x) - 2 * z, sy(y) - 2 * z, (w + 4) * z, (h + 4) * z, 1);
  gfx_set(0.10, 0.08, 0.06, 1);
  gfx_rect(sx(x), sy(y), w * z, h * z, 1);
  arrow(x + 5, y + 6, 22, h - 12, -1) ? step_prog(-1);
  arrow(x + w - 27, y + 6, 22, h - 12, 1) ? step_prog(1);
  gx = x + 32; gy = y + 5; gw = w - 64; gh = h - 10;
  lr = 1.0; lg = 0.62; lb = 0.28;
  gfx_set(0.012, 0.012, 0.012, 1);
  gfx_rect(sx(gx) - z, sy(gy) - z, (gw + 2) * z, (gh + 2) * z, 1);
  gfx_set(0.07, 0.045, 0.028, 1);
  gfx_rect(sx(gx), sy(gy), gw * z, gh * z, 1);
  gfx_gradrect(sx(gx), sy(gy), gw * z, gh * z, lr, lg, lb, 0.05, 0, 0, 0, 0, 0, 0, 0, -0.05 / (gh * z));
  p = slider(41);
  hovp = hit(gx, gy, gw, gh);
  (hovp && mouse_wheel != 0) ? ( step_prog(mouse_wheel > 0 ? -1 : 1); mouse_wheel = 0; );
  font(2, 10, 'b');
  p > 0 ? sprintf(#lt, "PROGRAM %03d", p) : strcpy(#lt, "INIT");
  glow_str(#lt, sx(gx + 7), sy(gy + 3), lr, lg, lb);
  midi_flag ? ( midi_t = now; midi_flag = 0; );
  midi_led = now - midi_t < 0.12;
  gfx_measurestr(#lt, tw, th);
  gfx_set(lr, lg, lb, midi_led ? 1 : 0.15);
  gfx_circle(sx(gx + 7) + tw + 8 * z, sy(gy + 3) + th * 0.5, 2.6 * z, 1, 1);
  (hov_i >= 0 || now - touched_t < 1.6) ? (
    ii = hov_i >= 0 ? hov_i : touched_i;
    name_sl(ii, #lt); fmt_sl(ii, #lv);
    strcat(#lt, "  "); strcat(#lt, #lv);
    gfx_measurestr(#lt, tw, th);
    glow_str(#lt, sx(gx + gw - 7) - tw, sy(gy + 3), lr, lg, lb);
  );
  font(2, 18, 'b');
  store_mode ? ( strcpy(#ln, #nm); (floor(now * 2) & 1) ? strcat(#ln, "_") : strcat(#ln, " "); ) :
  learn_fid >= 0 ? strcpy(#ln, "MIDI LEARN") :
  p == 0 ? strcpy(#ln, "Ice of Sauron") :
  p > 0 && (pg_flags[p] & 1) ? strcpy(#ln, pg_name[p]) : strcpy(#ln, "LORD OF THE RINKS");
  gfx_measurestr(#ln, tw, th);
  glow_str(#ln, sx(gx + gw * 0.5) - tw * 0.5, sy(gy + 26) - th * 0.5, lr, lg, lb);
  font(2, 10, 'b');
  store_mode ? sprintf(#reg, "STORE TO %d: TYPE A NAME, ENTER / ESC", store_p) :
  learn_fid >= 0 ? ( name_sl(learn_sl, #reg); strcat(#reg, ": MOVE A CONTROLLER"); ) :
  ( reg9(#reg, 1); strcat(#reg, "  "); strcat(#reg, reg9(#rg, 19)); strcat(#reg, "  "); strcat(#reg, reg9(#rg, 10)); );
  gfx_measurestr(#reg, tw, th);
  glow_str(#reg, sx(gx + gw * 0.5) - tw * 0.5, sy(gy + 38), lr * 0.85, lg * 0.85, lb * 0.85);
  gfx_set(0, 0, 0, 0.22);
  yy = sy(gy);
  while (yy < sy(gy + gh)) ( gfx_rect(sx(gx), yy, gw * z, max(1, floor(z)), 1); yy += 3 * z; );
  gfx_set(1, 1, 1, 0.03);
  gfx_rect(sx(gx), sy(gy), gw * z, gh * z * 0.42, 1);
  (mouse_click && hovp) ? ( gfx_x = sx(gx + gw * 0.5 - 60); gfx_y = sy(gy + gh); lcd_menu(); mouse_click = 0; );
);

function vib_selector(cx, cy) local(r, v, k, a, hov, QX, QY, lx, ly) (
  r = 17;
  v = slider(32);
  font(1, 9, 'b');
  k = 0;
  loop(6,
    a = -2.1 + k * 0.84;
    lx = cx + sin(a) * (r + 17); ly = cy - cos(a) * (r + 17) - 5;
    gfx_set(0.95, 0.86, 0.66, k == v ? 1 : 0.45);
    text_c(k == 0 ? "V1" : k == 1 ? "C1" : k == 2 ? "V2" : k == 3 ? "C2" : k == 4 ? "V3" : "C3", lx, ly);
    hov = hit(lx - 10, ly - 2, 20, 14);
    (mouse_click && hov) ? ( tap_sl(32, k); mouse_click = 0; );
    k += 1;
  );
  hov = hitc(cx, cy, r + 4);
  (mouse_click && hov) ? ( tap_sl(32, (v + 1) % 6); mouse_click = 0; );
  (hov && mouse_wheel != 0) ? ( tap_sl(32, max(0, min(5, v + (mouse_wheel > 0 ? 1 : -1)))); mouse_wheel = 0; );
  vknob_body(cx, cy, r);
  QX = sx(cx); QY = sy(cy);
  a = -2.1 + v * 0.84;
  gfx_set(0.97, 0.95, 0.9, 1);
  gfx_line(QX + sin(a) * r * 0.2 * z, QY - cos(a) * r * 0.2 * z, QX + sin(a) * r * 0.9 * z, QY - cos(a) * r * 0.9 * z, 1);
  gfx_line(QX + sin(a) * r * 0.2 * z + cos(a), QY - cos(a) * r * 0.2 * z + sin(a), QX + sin(a) * r * 0.9 * z + cos(a), QY - cos(a) * r * 0.9 * z + sin(a), 1);
  font(1, 9, 'b');
  gfx_set(0.85, 0.77, 0.58, 1);
  font(1, 8, 'b');
  text_c("VIBRATO / CHORUS", cx, cy + r + 14);
  (hov) ? ( hov_i = 32; hov_x = cx; hov_y = cy - r - 30; );
);

function swell_pedal(x, y, w, h) local(v, QX, QY, QW, QH, t, hov, k, top) (
  v = slider(35);
  hov = hit(x, y, w, h);
  (mouse_click && hov) ? (
    (last_click_i == 35 && now - last_click_t < 0.3) ? ( tap_sl(35, 127); drag_i = -1; ) : ( drag_i = 35; drag_y0 = mouse_y; drag_v0 = v; );
    last_click_i = 35; last_click_t = now; mouse_click = 0;
  );
  drag_i == 35 ? set_sl(35, floor(drag_v0 + (drag_y0 - mouse_y) / (h * z) * 127 + 0.5));
  (hov && mouse_wheel != 0 && drag_i < 0) ? ( tap_sl(35, v + (mouse_wheel > 0 ? 4 : -4)); mouse_wheel = 0; );
  v = slider(35);
  t = v / 127;
  QX = sx(x); QY = sy(y); QW = w * z; QH = h * z;
  top = QY + QH * 0.30 * (1 - t);
  gfx_set(0, 0, 0, 0.5);
  gfx_triangle(QX + 2 * z, QY + QH + 2 * z, QX + QW + 2 * z, QY + QH + 2 * z, QX + QW - 4 * z, top + 3 * z, QX + 8 * z, top + 3 * z);
  gfx_set(0.10, 0.09, 0.085, 1);
  gfx_triangle(QX, QY + QH, QX + QW, QY + QH, QX + QW - 6 * z, top, QX + 6 * z, top);
  k = 0;
  loop(9,
    gfx_set(0.22, 0.2, 0.19, 1);
    gfx_line(QX + 9 * z, top + (QY + QH - top) * (k + 0.5) / 10, QX + QW - 9 * z, top + (QY + QH - top) * (k + 0.5) / 10, 1);
    k += 1;
  );
  gfx_set(0.62, 0.62, 0.65, 1);
  gfx_rect(QX + 4 * z, QY + QH - 4 * z, QW - 8 * z, 4 * z, 1);
  gfx_set(1.0, 0.55, 0.18, 0.9);
  gfx_rect(QX + QW + 4 * z, QY + QH * (1 - t), 3 * z, QH * t, 1);
  gfx_set(1.0, 0.55, 0.18, 0.15);
  gfx_rect(QX + QW + 4 * z, QY, 3 * z, QH, 1);
  font(1, 9, 'b');
  gfx_set(0.85, 0.77, 0.58, 1);
  text_c("SWELL", x + w * 0.5, y + h + 6);
  (hov || drag_i == 35) ? ( hov_i = 35; hov_x = x + w * 0.5; hov_y = y - 4; );
);

function kbd_send(st, n, v) (
  gq[gq_w * 3] = st; gq[gq_w * 3 + 1] = n; gq[gq_w * 3 + 2] = v;
  gq_w = (gq_w + 1) & 255;
);

function manual(x, y, w, h, base, lo, ch) local(nw, ww, bw, bh, QX, QY, QH, n, wi, pc, isb, bx, hovn, down, kx, kw, lit, oct) (
  nw = 36; ww = w / nw; bw = ww * 0.60; bh = h * 0.60;
  QX = sx(x); QY = sy(y); QH = h * z;
  hovn = -1;
  (mouse_y >= QY && mouse_y < QY + QH && mouse_x >= QX && mouse_x < QX + w * z) ? (
    n = 0; wi = 0;
    loop(61,
      pc = n % 12; isb = pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10;
      isb ? ( bx = x + wi * ww - bw * 0.5; (mouse_y < QY + bh * z && mouse_x >= sx(bx) && mouse_x < sx(bx + bw)) ? hovn = n; ) : wi += 1;
      n += 1;
    );
    hovn < 0 ? ( wi = floor((mouse_x - QX) / (ww * z)); oct = floor(wi / 7); pc = wi - oct * 7;
      hovn = oct * 12 + (pc == 0 ? 0 : pc == 1 ? 2 : pc == 2 ? 4 : pc == 3 ? 5 : pc == 4 ? 7 : pc == 5 ? 9 : 11); );
    hovn > 60 ? hovn = -1;
  );
  down = mouse_cap & 1;
  (mouse_click && hovn >= 0) ? ( kb_on = 1; kb_ch = ch; kb_lo = lo; kb_note = -1; kb_man = base; mouse_click = 0; );
  kb_on && kb_man == base ? (
    !down ? ( kb_note >= 0 ? kbd_send(128 + kb_ch, kb_lo + kb_note, 0); kb_note = -1; kb_on = 0; ) :
    hovn != kb_note && hovn >= 0 ? (
      kb_note >= 0 ? kbd_send(128 + kb_ch, kb_lo + kb_note, 0);
      kbd_send(144 + kb_ch, lo + hovn, 100);
      kb_note = hovn;
    );
  );
  gfx_set(0.02, 0.018, 0.016, 1);
  gfx_rect(QX - z, QY - 2 * z, w * z + 2 * z, QH + 3 * z, 1);
  n = 0; wi = 0;
  loop(61,
    pc = n % 12; isb = pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10;
    !isb ? (
      kx = floor(sx(x + wi * ww)) + max(1, floor(z)); kw = floor(sx(x + (wi + 1) * ww)) - kx;
      lit = guiKeys[base + n] || (kb_man == base && kb_note == n && kb_on);
      lit ? gfx_gradrect(kx, QY, kw, QH, 1.0, 0.72, 0.42, 1, 0, 0, 0, 0, -0.25 / QH, -0.25 / QH, -0.25 / QH, 0)
          : gfx_gradrect(kx, QY, kw, QH, 0.96, 0.94, 0.88, 1, 0, 0, 0, 0, -0.14 / QH, -0.14 / QH, -0.15 / QH, 0);
      gfx_set(0, 0, 0, 0.25); gfx_rect(kx, QY, kw, 2 * z, 1);
      wi += 1;
    );
    n += 1;
  );
  n = 0; wi = 0;
  loop(61,
    pc = n % 12; isb = pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10;
    isb ? (
      bx = floor(sx(x + wi * ww - bw * 0.5));
      lit = guiKeys[base + n] || (kb_man == base && kb_note == n && kb_on);
      gfx_set(0, 0, 0, 0.35); gfx_rect(bx + z, QY, bw * z, bh * z + 2 * z, 1);
      lit ? gfx_gradrect(bx, QY, bw * z, bh * z, 0.85, 0.5, 0.2, 1, 0, 0, 0, 0, 0.1 / (bh * z), 0.1 / (bh * z), 0.1 / (bh * z), 0)
          : gfx_gradrect(bx, QY, bw * z, bh * z, 0.06, 0.055, 0.05, 1, 0, 0, 0, 0, 0.1 / (bh * z), 0.1 / (bh * z), 0.1 / (bh * z), 0);
      gfx_set(1, 1, 1, 0.10); gfx_rect(bx + 2 * z, QY + bh * z - 6 * z, bw * z - 4 * z, 4 * z, 1);
    ) : wi += 1;
    n += 1;
  );
);

function pedalboard(x, y, w, h, ch) local(n, wi, pc, isb, pw, QX, QY, QH, kx, kw, lit, hovn, down, px) (
  pw = w / 15;
  QX = sx(x); QY = sy(y); QH = h * z;
  hovn = -1;
  hit(x, y, w, h) ? (
    n = 0; wi = 0;
    loop(25,
      pc = n % 12; isb = pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10;
      isb ? ( px = x + wi * pw - pw * 0.28; (mouse_y < sy(y + h * 0.62) && mouse_x >= sx(px) && mouse_x < sx(px + pw * 0.56)) ? hovn = n; ) : wi += 1;
      n += 1;
    );
    hovn < 0 ? (
      n = 0; wi = 0;
      loop(25,
        pc = n % 12; isb = pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10;
        !isb ? ( (mouse_x >= sx(x + wi * pw) && mouse_x < sx(x + (wi + 1) * pw)) ? hovn = n; wi += 1; );
        n += 1;
      );
    );
  );
  down = mouse_cap & 1;
  (mouse_click && hovn >= 0) ? ( kb_on = 1; kb_ch = ch; kb_lo = 24; kb_note = -1; kb_man = 128; mouse_click = 0; );
  kb_on && kb_man == 128 ? (
    !down ? ( kb_note >= 0 ? kbd_send(128 + kb_ch, kb_lo + kb_note, 0); kb_note = -1; kb_on = 0; ) :
    hovn != kb_note && hovn >= 0 ? (
      kb_note >= 0 ? kbd_send(128 + kb_ch, kb_lo + kb_note, 0);
      kbd_send(144 + kb_ch, 24 + hovn, 100);
      kb_note = hovn;
    );
  );
  n = 0; wi = 0;
  loop(25,
    pc = n % 12; isb = pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10;
    !isb ? (
      kx = sx(x + wi * pw + pw * 0.12); kw = pw * 0.76 * z;
      lit = guiKeys[128 + n] || (kb_man == 128 && kb_note == n && kb_on);
      gfx_set(0, 0, 0, 0.5); gfx_rect(kx + 2 * z, QY + 2 * z, kw, QH, 1);
      lit ? gfx_gradrect(kx, QY, kw, QH, 1.0, 0.72, 0.42, 1, 0, 0, 0, 0, -0.2 / QH, -0.2 / QH, -0.2 / QH, 0)
          : gfx_gradrect(kx, QY, kw, QH, 0.52, 0.30, 0.15, 1, 0, 0, 0, 0, -0.18 / QH, -0.10 / QH, -0.06 / QH, 0);
      gfx_set(1, 1, 1, 0.15); gfx_rect(kx, QY, kw, max(1, z), 1);
      wi += 1;
    );
    n += 1;
  );
  n = 0; wi = 0;
  loop(25,
    pc = n % 12; isb = pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10;
    isb ? (
      kx = sx(x + wi * pw - pw * 0.28); kw = pw * 0.56 * z;
      lit = guiKeys[128 + n] || (kb_man == 128 && kb_note == n && kb_on);
      gfx_set(0, 0, 0, 0.5); gfx_rect(kx + 2 * z, QY, kw, QH * 0.62 + 2 * z, 1);
      lit ? gfx_gradrect(kx, QY, kw, QH * 0.62, 0.85, 0.5, 0.2, 1, 0, 0, 0, 0, 0, 0, 0, 0)
          : gfx_gradrect(kx, QY, kw, QH * 0.62, 0.08, 0.07, 0.065, 1, 0, 0, 0, 0, 0.12 / QH, 0.12 / QH, 0.12 / QH, 0);
    ) : wi += 1;
    n += 1;
  );
);

function chan_chip(x, y, i, label) local(hov, QX, QY) (
  hov = hit(x, y, 54, 34);
  font(3, 10, 'b');
  gfx_set(0.92, 0.84, 0.66, 1);
  text_l(label, x, y);
  font(1, 9, 'b');
  gfx_set(0, 0, 0, 0.6); gfx_rect(sx(x), sy(y + 16), 44 * z, 15 * z, 1);
  gfx_set(hov ? 0.26 : 0.16, hov ? 0.20 : 0.12, hov ? 0.14 : 0.09, 1); gfx_rect(sx(x + 1), sy(y + 17), 42 * z, 13 * z, 1);
  gfx_set(1.0, 0.66, 0.34, 1);
  sprintf(#cc, "CH %d", slider(i));
  text_c(#cc, x + 22, y + 18);
  (mouse_click && hov) ? ( gfx_x = sx(x); gfx_y = sy(y + 32); chan_menu(i); mouse_click = 0; );
);

function logo() (
  font(3, 29, 'bi');
  gfx_set(0, 0, 0, 0.5);
  text_l("Lord of the Rinks", 22, 13);
  gfx_set(0.96, 0.88, 0.70, 1);
  text_l("Lord of the Rinks", 20, 11);
  font(1, 9, 'b');
  gfx_set(0.85, 0.72, 0.52, 0.8);
  text_l("TONEWHEEL ORGAN  ·  ROTARY SPEAKER", 22, 48);
  gfx_set(0.85, 0.72, 0.52, 0.55);
  text_l("by chmaha  ·  based on setBfree", 22, 60);
);

function organ_page() local(k) (
  gfx_set(0, 0, 0, 0.55);
  rrect(8, 74, 1024, 250, 8);
  gfx_gradrect(sx(12), sy(78), 1016 * z, 242 * z, 0.045, 0.04, 0.036, 1, 0, 0, 0, 0, -0.02 / (242 * z), -0.018 / (242 * z), -0.016 / (242 * z), 0);
  gfx_set(0.55, 0.53, 0.5, 0.35);
  gfx_rect(sx(12), sy(99), 1016 * z, max(1, z), 1);
  gfx_set(0.55, 0.53, 0.5, 0.35);
  gfx_rect(sx(350), sy(80), max(1, z), 236 * z, 1);
  gfx_rect(sx(689), sy(80), max(1, z), 236 * z, 1);
  db_group(32, 1, 9, "UPPER MANUAL");
  db_group(371, 19, 9, "PEDAL");
  db_group(710, 10, 9, "LOWER MANUAL");

  panel(10, 330, 232, 118, "PERCUSSION");
  tablet(19, 356, 52, 72, slider(28), "PERCUSSION", "ON") ? tap_sl(28, !slider(28));
  tablet(74, 356, 52, 72, slider(29), "VOLUME", "SOFT") ? tap_sl(29, !slider(29));
  tablet(129, 356, 52, 72, slider(30), "DECAY", "FAST") ? tap_sl(30, !slider(30));
  tablet(184, 356, 52, 72, !slider(31), "HARMONIC", "THIRD") ? tap_sl(31, !slider(31));
  k = hit(19, 356, 52, 72) ? 28 : hit(74, 356, 52, 72) ? 29 : hit(129, 356, 52, 72) ? 30 : hit(184, 356, 52, 72) ? 31 : -1;
  k > 0 ? ( hov_i = k; hov_x = (mouse_x - ox) / z; hov_y = 352; );

  panel(250, 330, 222, 118, "VIBRATO");
  tablet(260, 356, 50, 72, slider(33), "VIBRATO", "UPPER") ? tap_sl(33, !slider(33));
  tablet(315, 356, 50, 72, slider(34), "VIBRATO", "LOWER") ? tap_sl(34, !slider(34));
  k = hit(260, 356, 50, 72) ? 33 : hit(315, 356, 50, 72) ? 34 : -1;
  k > 0 ? ( hov_i = k; hov_x = (mouse_x - ox) / z; hov_y = 352; );
  vib_selector(420, 392);

  panel(480, 330, 250, 118, "LESLIE");
  lever(548, 406, 36, "HORN");
  lever(664, 406, 37, "DRUM");
  btn(576, 334, 70, 18, slider(91) ? "BYPASSED" : "ACTIVE", !slider(91)) ? tap_sl(91, !slider(91));
  btn(654, 334, 70, 18, "DETAILS", 0) ? page = 2;

  panel(738, 330, 200, 118, "OVERDRIVE  ·  REVERB");
  tablet(748, 356, 50, 72, slider(38), "OVERDRIVE", "ON") ? tap_sl(38, !slider(38));
  hit(748, 356, 50, 72) ? ( hov_i = 38; hov_x = 773; hov_y = 352; );
  vknob(836, 388, 16, 39, "CHARACTER", 0);
  vknob(900, 388, 16, 40, "REVERB", 0);

  panel(946, 330, 84, 118, "VOLUME");
  swell_pedal(962, 352, 44, 68);
);

tab_n = 3;
function tab_title(t) (
  t == 0 ? "TONE GENERATOR" : t == 1 ? "PERCUSSION & VIBRATO" : "KEYBOARD & LEVELS";
);

function settings_row(y, a, b, c, d, e, f, g) local(x0, dx) (
  x0 = 88; dx = 144;
  a > 0 ? set_knob(x0, y, a); b > 0 ? set_knob(x0 + dx, y, b); c > 0 ? set_knob(x0 + 2 * dx, y, c);
  d > 0 ? set_knob(x0 + 3 * dx, y, d); e > 0 ? set_knob(x0 + 4 * dx, y, e); f > 0 ? set_knob(x0 + 5 * dx, y, f);
  g > 0 ? set_knob(x0 + 6 * dx, y, g);
);

function settings_page() local(t, tx, tw, th, hov, k) (
  gfx_set(0, 0, 0, 0.55);
  rrect(8, 74, 1024, 374, 8);
  gfx_gradrect(sx(12), sy(78), 1016 * z, 366 * z, 0.075, 0.062, 0.052, 1, 0, 0, 0, 0, -0.03 / (366 * z), -0.025 / (366 * z), -0.02 / (366 * z), 0);
  t = 0; tx = 20;
  loop(tab_n,
    font(1, 11, 'b');
    gfx_measurestr(tab_title(t), tw, th);
    hov = hit(tx, 84, tw / z + 20, 22);
    gfx_set(t == stab ? 0.45 : hov ? 0.22 : 0.14, t == stab ? 0.27 : hov ? 0.17 : 0.11, t == stab ? 0.12 : hov ? 0.12 : 0.08, 1);
    rrect(tx, 84, tw / z + 20, 22, 4);
    gfx_set(0.97, 0.88, 0.72, t == stab ? 1 : 0.7);
    text_l(tab_title(t), tx + 10, 88);
    (mouse_click && hov) ? ( stab = t; mouse_click = 0; );
    tx += tw / z + 28;
    t += 1;
  );
  btn(900, 84, 118, 22, "RESET PAGE", 0) ? (
    k = 1;
    loop(111,
      (stab == 0 && ((k >= 45 && k <= 46) || (k >= 51 && k <= 61))) ||
      (stab == 1 && k >= 62 && k <= 70) ||
      (stab == 2 && ((k >= 47 && k <= 50) || (k >= 104 && k <= 111))) ? ( slider(k) = slDef[k]; automate(k, 0); automate(k, 1); );
      k += 1;
    );
  );
  stab == 0 ? (
    settings_row(170, 45, 46, 51, 52, 53, 54, 55);
    settings_row(280, 56, 57, 58, 59, 60, 61, 0);
    font(1, 11, 0); gfx_set(0.85, 0.75, 0.55, 0.8);
    text_l("Tone generator changes rebuild the tonewheels when you release the knob; held notes are released.", 30, 404);
  ) :
  stab == 1 ? (
    settings_row(170, 62, 63, 64, 65, 0, 0, 0);
    settings_row(280, 66, 67, 68, 69, 70, 0, 0);
    font(1, 11, 0); gfx_set(0.85, 0.75, 0.55, 0.8);
    text_l("As in setBfree, the percussion decay times are stored but the decay rate itself is fixed.", 30, 404);
  ) : (
    settings_row(170, 47, 48, 49, 50, 0, 0, 0);
    settings_row(280, 107, 108, 109, 110, 111, 0, 0);
    set_knob(88 + 4 * 144, 170, 104); set_knob(88 + 5 * 144, 170, 105); set_knob(88 + 6 * 144, 170, 106);
  );
);


function krow(x0, y, dx, a, b, c, d, e, f, g, h) (
  a > 0 ? set_knob(x0, y, a); b > 0 ? set_knob(x0 + dx, y, b); c > 0 ? set_knob(x0 + 2 * dx, y, c);
  d > 0 ? set_knob(x0 + 3 * dx, y, d); e > 0 ? set_knob(x0 + 4 * dx, y, e); f > 0 ? set_knob(x0 + 5 * dx, y, f);
  g > 0 ? set_knob(x0 + 6 * dx, y, g); h > 0 ? set_knob(x0 + 7 * dx, y, h);
);

function speaker_page() local(k) (
  panel(10, 74, 322, 374, "ROTORS");
  btn(168, 80, 74, 18, slider(91) ? "BYPASSED" : "ACTIVE", !slider(91)) ? tap_sl(91, !slider(91));
  btn(250, 80, 74, 18, "RESET", 0) ? (
    k = 71; loop(33, slider(k) = slDef[k]; automate(k, 0); automate(k, 1); k += 1; );
