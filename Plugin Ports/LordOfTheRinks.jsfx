  percEnvGainDecayFastSoft = exp(log(pow(10, -3) / percEnvGainResetSoft) / (srate * percFastDecaySeconds));
  percEnvGainDecaySlowNorm = exp(log(pow(10, -3) / percEnvGainResetNorm) / (srate * percSlowDecaySeconds));
  percEnvGainDecaySlowSoft = exp(log(pow(10, -3) / percEnvGainResetSoft) / (srate * percSlowDecaySeconds));
