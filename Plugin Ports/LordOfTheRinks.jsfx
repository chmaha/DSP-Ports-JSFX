function midi_defaults() (
  rcvA = 0; rcvB = 1; rcvC = 2;
  mTranspose = 0; nshA = 0; nshA_U = 0; nshA_PL = 0; nshA_UL = 0; nshB = 0; nshC = 0;
  splitA_PL = 0; splitA_UL = 0;
);
function keyRegion(tab, fn, ln, fk, lk, tr, strat) local(key, note, offset, fka, lka) (
  strat == 2 ? (
    key = fk; note = fn - tr;
    while (key <= lk) (
      note >= 1 && note <= 127 ? tab[note] = key;
      key += 1; note += 1;
    );
  ) : (
    offset = tr + fk - fn;
    fka = fk + 12 - imod(fk, 12);
    lka = lk - imod(lk, 12) - 12;
    note = fn;
    while (note <= ln) (
      key = note + offset;
