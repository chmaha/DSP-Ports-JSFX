  ) : dbGain[bus] = dbLevel[bus * 9 + setting];
);
function setMIDIDrawBar(bus, v) ( setDrawBar(bus, rint_((127 - v) * 8.0 / 127.0)); );

function setPercussionResets() (
  percEnvGainDecay = percIsFast ? (percIsSoft ? percEnvGainDecayFastSoft : percEnvGainDecayFastNorm)
                                : (percIsSoft ? percEnvGainDecaySlowSoft : percEnvGainDecaySlowNorm);
