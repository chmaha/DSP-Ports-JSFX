  ) :
  fid == 33 ? setVibratoUpper(v < 64 ? 0 : 1) :
  fid == 34 ? setVibratoLower(v < 64 ? 0 : 1) :
  fid == 35 || fid == 36 ? setSwell(v) :
  fid == 37 ? setRevSelect(idiv(v, 43)) :
  fid == 38 ? ( v > 63 ? useRevOption(revSelect == 0 ? revsel[2] : revsel[0], 3); ) :
  fid == 39 ? useRevOption(idiv(v, 15), 2) :
