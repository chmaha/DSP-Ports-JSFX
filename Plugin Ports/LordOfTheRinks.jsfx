function setVibratoLower(on) ( on ? newRouting |= 1 : newRouting -= (newRouting & 1); );
function getVibratoRouting() local(rv) ( rv = 0; newRouting & 1 ? rv |= 1; newRouting & 2 ? rv |= 2; rv; );

function oscKeyOff(key) (
  key < 160 && activeKeys[key] != 0 ? (
