);
function loadKeyTableB() ( memset(keyTB, 255, 128); keyRegion(keyTB, 36, 96, 64, 124, mTranspose + nshB, 2); );
function loadKeyTableC() ( memset(keyTC, 255, 128); keyRegion(keyTC, 24, 55, 128, 159, mTranspose + nshC, 2); );
function loadStatusTable() (
