  fid == 28 ? setPercussionFast(v < 64 ? 0 : 1) :
  fid == 29 ? setPercussionFirst(v < 64 ? 0 : 1) :
  fid == 30 ? setPercussionVolume(v < 64 ? 0 : 1) :
  fid == 31 ? ( k = idiv(v, 23); k < 6 ? setVibratoKnob(k); ) :
