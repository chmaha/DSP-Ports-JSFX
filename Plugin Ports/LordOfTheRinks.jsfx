function setVibratoKnob(k) (
  vibKnob = k;
  k == 0 ? setVibrato(1) : k == 1 ? setVibrato(129) : k == 2 ? setVibrato(2) :
  k == 3 ? setVibrato(130) : k == 4 ? setVibrato(3) : k == 5 ? setVibrato(131);
);
function setSwell(u) ( swellU = u; swellPedalGain = (outputLevelTrim * u) / 127.0; );
function horn_filterA() ( setIIR(hafw, haT, haF, haQ, haG); );
function horn_filterB() ( setIIR(hbfw, hbT, hbF, hbQ, hbG); );

function ctl(fid, v) local(u, k) (
