function midi_panic() local(i) ( i = 0; loop(160, oscKeyOff(i); i += 1; ); memset(guiKeys, 0, 160); );

function setDrawBarsManual(man, src) local(i, off) (
  off = man * 9;
  i = 0; loop(9, setDrawBar(off + i, src[i]); dbSet[off + i] = src[i]; i += 1; );
