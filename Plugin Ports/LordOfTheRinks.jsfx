function ccmap(fid, cc, a, b, c) ( a ? useA[fid] = cc; b ? useB[fid] = cc; c ? useC[fid] = cc; );
function cc_prime() local(i) (
  memset(useA, 255, 128); memset(useB, 255, 128); memset(useC, 255, 128);
