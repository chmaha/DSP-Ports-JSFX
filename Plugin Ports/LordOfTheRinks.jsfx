  fid == 41 ? ( haF = 250.0 + ((8000.0 - 250.0) * ((v * v) / 16129.0)); horn_filterA(); ) :
  fid == 42 ? ( haQ = 0.01 + ((6.00 - 0.01) * (v / 127.0)); horn_filterA(); ) :
  fid == 43 ? ( haG = -48.0 + ((48.0 - -48.0) * (v / 127.0)); horn_filterA(); ) :
  fid == 44 ? ( hbT = idiv(v, 15); horn_filterB(); ) :
  fid == 45 ? ( hbF = 250.0 + ((8000.0 - 250.0) * ((v * v) / 16129.0)); horn_filterB(); ) :
  fid == 46 ? ( hbQ = 0.01 + ((6.00 - 0.01) * (v / 127.0)); horn_filterB(); ) :
  fid == 47 ? ( hbG = -48.0 + ((48.0 - -48.0) * (v / 127.0)); horn_filterB(); ) :
