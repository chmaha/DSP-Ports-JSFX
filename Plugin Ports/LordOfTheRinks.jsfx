function sv(i) ( slider(i) !== slDef[i]; );

function cfg_tonegen() local(m) (
  tg_defaults();
  sv(45) && slider(45) >= 220 && slider(45) <= 880 ? tuning = slider(45);
  sv(46) ? gearTuning = slider(46) == 0 ? 1 : slider(46) == 1 ? 2 : 0;
  sv(51) ? cCompartment = slider(51);
  sv(52) ? cTermStrip = slider(52);
  sv(53) ? cWiring = slider(53);
  sv(54) ? contribFloor = slider(54);
