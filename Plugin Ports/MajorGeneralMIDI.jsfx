SMP = mk(212241);

// ---------------------------------------------------------------- plugin
EQ = mk(4 * 4096); SXP = mk(65536); SXB = mk(4096);
RSL = mk(2048); RSR = mk(2048); RTAB = mk(513 * 32);
ACT = mk(16); SLP = mk(80); SCALES = mk(80 * 12); FQ = mk(16);
g_min = mk(80); g_max = mk(80); g_step = mk(80); g_def = mk(80);

function smp_load(fn) local(h, nch, sr, n)
(
  n = 0;
  h = file_open(fn);
  h >= 0 ? (
    nch = 0; sr = 0;
    file_riff(h, nch, sr);
    (nch == 1 && file_avail(h) >= SMP_LEN) ? (
      file_mem(h, SMP, SMP_LEN) == SMP_LEN ? n = SMP_LEN;
    );
    file_close(h);
  );
  n;
);

SMP[-1] !== 5813 ? (
  loaded = smp_load("MajorGeneralMIDI/MajorGeneralMIDI.flac");
  !loaded ? loaded = smp_load("Dependencies/MajorGeneralMIDI/MajorGeneralMIDI.flac");
  loaded ? (
    i = 0; loop(SMP_LEN, SMP[i] = floor(SMP[i] * 32768 + 0.5); i += 1; );
    memset(SMP + SMP_LEN, 0, 64);
    SMP[-1] = 5813;
  );
) : loaded = 1;

function calc_tune() local(i, base, r) (
  base = slider17 == 440 ? 0 : 1200 * log(slider17 / 440) / log(2);
  r = SCALES + slider18 * 12;
  i = 0;
  loop(12,
    TUNE[i] = base + (slider18 == 5 ? 0 : 1200 * log(r[i] / r[9]) / log(2) - 100 * (i - 9));
    i += 1;
  );
);

function rs_init() local(p, j, t, x, fc, w, H) (
  H = 16;
  fc = min(1, srate / 44100) * 0.93;
  p = 0;
  loop(513,
    j = 0;
    loop(32,
      t = (j - H + 1) - p / 512;
      x = $pi * fc * t;
      w = abs(t) >= H ? 0 : 0.35875 + 0.48829 * cos($pi * t / H) + 0.14128 * cos(2 * $pi * t / H) + 0.01168 * cos(3 * $pi * t / H);
      RTAB[p * 32 + j] = fc * (abs(x) < 0.0000001 ? 1 : sin(x) / x) * w;
      j += 1;
    );
    p += 1;
  );
  rs_step = 44100 / srate;
  rs_pos = 0; rs_in = 0;
  memset(RSL, 0, 2048); memset(RSR, 0, 2048);
);

function rate_change()
(
  rs_init();
  opos = FRAME;
  cur_sr = srate;
);

// slider k (17..28) reflects engine state without applying anything
function show(k, v) ( slider(k) = v; SLP[k - 1] = v; sliderchange(2 ^ (k - 1)); );
function show_fx() (
  show(21, floor(rv_wet / 32.767 + 0.5) / 10);
  show(24, ch_rate_ui); show(25, ch_depth_ui);
  show(26, floor(ch_level / 32.767 + 0.5) / 10);
  show(27, floor(ch_dry / 32.767 + 0.5) / 10);
);
function ch_preset_ui(p) ( ch_rate_ui = CHP[p * 4 + 1]; ch_depth_ui = CHP[p * 4]; );

function apply_prog(c, p) (
  vm_cc(c, 0, p == 128 ? 0x78 : 0x79);
  vm_progchange(c, p == 128 ? 0 : p);
);

function sync_progs() local(c, p) (
  c = 0;
  loop(16,
    p = cfl[c] & 8 ? 128 : cprog[c];
    slider(c + 1) != p ? ( slider(c + 1) = p; prog_dirty = 1; );
    SLP[c] = p;
    c += 1;
  );
);

function apply_sliders() local(c, p, fx) (
  c = 0;
  loop(16,
    p = slider(c + 1);
    p != SLP[c] ? ( SLP[c] = p; apply_prog(c, p); );
    c += 1;
  );
  slider17 != SLP[16] || slider18 != SLP[17] ? ( SLP[16] = slider17; SLP[17] = slider18; calc_tune(); );
  fx = 0;
  slider19 != SLP[18] || slider20 != SLP[19] ? (
    slider19 != SLP[18] ? eas_setparam(2, 4, slider19);
    SLP[18] = slider19; SLP[19] = slider20;
    slider20 == 0 ? eas_setparam(2, 0, 1) : ( eas_setparam(2, 0, 0); eas_setparam(2, 1, slider20 - 1); );
    fx = 1;
  );
  slider21 != SLP[20] ? ( SLP[20] = slider21; rv_wet = floor(slider21 * 327.67 + 0.5); );
  slider22 != SLP[21] || slider23 != SLP[22] ? (
    slider22 != SLP[21] ? eas_setparam(3, 6, slider22);
    SLP[21] = slider22; SLP[22] = slider23;
    slider23 == 0 ? eas_setparam(3, 0, 1) : ( eas_setparam(3, 0, 0); eas_setparam(3, 1, slider23 - 1); ch_preset_ui(slider23 - 1); );
    fx = 1;
  );
  slider24 != SLP[23] ? ( SLP[23] = slider24; ch_rate_ui = slider24; ch_rate = w16(floor(8388608 / 882000) * slider24); );
  slider25 != SLP[24] ? ( SLP[24] = slider25; ch_depth_ui = slider25; ch_depth = w16(floor((floor((slider25 * 44100) / 32) * 105) / 65536)); );
  slider26 != SLP[25] ? ( SLP[25] = slider26; ch_level = floor(slider26 * 327.67 + 0.5); );
  slider27 != SLP[26] ? ( SLP[26] = slider27; ch_dry = floor(slider27 * 327.67 + 0.5); );
  slider28 != SLP[27] ? ( SLP[27] = slider28; eas_setvolume(100 + slider28); );
  slider77 != SLP[76] ? ( SLP[76] = slider77; vm_setpoly(slider77); );
  c = 0;
  loop(16,
    slider(45 + c) != SLP[44 + c] ? ( SLP[44 + c] = slider(45 + c); vm_cc(c, 7, slider(45 + c)); );
    slider(61 + c) != SLP[60 + c] ? ( SLP[60 + c] = slider(61 + c); vm_cc(c, 10, slider(61 + c)); );
    c += 1;
  );
  fx ? show_fx();
);

function gm_reset() (
  vm_reset(); vm_initmip();
  mix_pend = 1;
);

// GM RESET button: once the engine reset has finished, restore every channel strip to its initial setup
function init_strips() local(c) (
  c = 0;
  loop(16,
    slider(1 + c) = c == 9 ? 128 : c; SLP[c] = -1;
    slider(29 + c) = 0;
    slider(45 + c) = 100; SLP[44 + c] = -1;
    slider(61 + c) = 64; SLP[60 + c] = -1;
    c += 1;
  );
  apply_sliders();
<? loop(i = 1; 76, printf("  sliderchange(slider%d);\n", i); i += 1; ); ?>);

// after a GM reset, put back the level/pan the user set on the channel strips
function reapply_mix() local(c) (
  c = 0;
  loop(16,
    slider(45 + c) != 100 ? vm_cc(c, 7, slider(45 + c));
    slider(61 + c) != 64 ? vm_cc(c, 10, slider(61 + c));
    c += 1;
  );
);

// performance messages are copied to every channel that follows the source (chains allowed)
function dispatch(t, d1, d2) local(ty, cp, mask, qr, qw, src, c) (
  midi_msg(t, d1, d2);
  ty = t & 0xF0;
  ty == 0x90 && d2 > 0 ? ACT[t & 15] = 1;
  cp = ty == 0x80 || ty == 0x90 || ty == 0xD0 || ty == 0xE0 || (ty == 0xB0 && (d1 == 1 || d1 == 2 || d1 == 4 || d1 == 11 ||
       d1 == 64 || d1 == 66 || d1 == 67 || d1 == 120 || d1 == 121 || d1 == 123));
  cp ? (
    FQ[0] = t & 15; mask = 2 ^ (t & 15); qr = 0; qw = 1;
    while (qr < qw) (
      src = FQ[qr]; qr += 1;
      c = 0;
      loop(16,
        slider(29 + c) == src + 1 && !(mask & (2 ^ c)) ? (
          mask |= 2 ^ c; FQ[qw] = c; qw += 1;
          midi_msg(ty | c, d1, d2);
          ty == 0x90 && d2 > 0 ? ACT[c] = 1;
        );
        c += 1;
      );
    );
  );
);

function run_events(now) local(i, j, n, t, len) (
  i = 0; n = 0;
  while (i < eq_n) (
    EQ[i * 4] <= now ? (
      t = EQ[i * 4 + 1];
      t == 0xF0 ? (
        len = EQ[i * 4 + 3];
        j = 0; loop(len, SXB[j] = SXP[(EQ[i * 4 + 2] + j) & 65535]; j += 1; );
        eas_sysex(SXB, len);
        mix_pend = 1;
      ) : dispatch(t, EQ[i * 4 + 2], EQ[i * 4 + 3]);
    ) : (
      n != i ? memcpy(EQ + n * 4, EQ + i * 4, 4);
      n += 1;
    );
    i += 1;
  );
  eq_n = n;
);

