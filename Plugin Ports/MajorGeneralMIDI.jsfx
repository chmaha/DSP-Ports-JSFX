spos = 0;

<? jsfx_has_set_midi_note_name ?
  loop(i=0; prog_count, printf("set_midi_note_name(2,%d,0,\"%s\");\n",i,_prog_name(i)); i+=1; );
?>

@slider
cur_sr != srate ? rate_change();
apply_sliders();

@block
apply_sliders();
i = 0; loop(eq_n, EQ[i * 4] -= last_sb; i += 1; );
last_sb = samplesblock;
spos = 0;
gm_req ? ( gm_req = 0; gm_reset(); init_pend = 1; );
init_pend && !(sfl & 1) ? ( init_pend = 0; mix_pend = 0; init_strips(); );
mix_pend && !(sfl & 1) ? ( mix_pend = 0; reapply_mix(); );
while ((len = midirecv_buf(ofs, SXB, 4096)) > 0) (
  eq_n < 4096 ? (
    SXB[0] == 0xF0 ? (
      EQ[eq_n * 4] = ofs; EQ[eq_n * 4 + 1] = 0xF0; EQ[eq_n * 4 + 2] = sx_w; EQ[eq_n * 4 + 3] = len;
      i = 0; loop(len, SXP[sx_w] = SXB[i]; sx_w = (sx_w + 1) & 65535; i += 1; );
      eq_n += 1;
    ) : SXB[0] >= 0x80 && SXB[0] < 0xF0 ? (
      EQ[eq_n * 4] = ofs; EQ[eq_n * 4 + 1] = SXB[0]; EQ[eq_n * 4 + 2] = SXB[1] & 127; EQ[eq_n * 4 + 3] = len > 2 ? SXB[2] & 127 : 0;
      eq_n += 1;
    );
  );
);
sync_progs();
prog_dirty ? ( prog_dirty = 0; sliderchange(65535); );

@sample
srate == 44100 ? (
  opos >= FRAME ? ( render_frame(); opos = 0; );
  spl0 = OUTB[2 * opos] / 32768; spl1 = OUTB[2 * opos + 1] / 32768;
  opos += 1;
) : (
  rs_n = floor(rs_pos);
  while (rs_n + 16 >= rs_in) (
    render_frame();
    rs_i = 0;
    loop(FRAME,
      RSL[(rs_in + rs_i) & 2047] = OUTB[2 * rs_i] / 32768;
      RSR[(rs_in + rs_i) & 2047] = OUTB[2 * rs_i + 1] / 32768;
      rs_i += 1;
    );
    rs_in += FRAME;
  );
  rs_f = (rs_pos - rs_n) * 512;
  rs_p = floor(rs_f); rs_f -= rs_p;
  rs_t0 = RTAB + rs_p * 32; rs_t1 = rs_t0 + 32;
  rs_a = rs_b = 0;
  rs_j = 0; rs_k = rs_n - 15;
  loop(32,
    rs_h = rs_t0[rs_j] + rs_f * (rs_t1[rs_j] - rs_t0[rs_j]);
    rs_a += RSL[(rs_k + rs_j) & 2047] * rs_h;
    rs_b += RSR[(rs_k + rs_j) & 2047] * rs_h;
    rs_j += 1;
  );
  spl0 = rs_a; spl1 = rs_b;
  rs_pos += rs_step;
  rs_in > 16777216 ? ( rs_in -= 16777216; rs_pos -= 16777216; );
);
spos += 1;

@gfx 1000 640
W0 = 1000; H0 = 640;
z = max(0.5, min(gfx_w / W0, gfx_h / H0));
ox = floor((gfx_w - W0 * z) * 0.5);
oy = floor((gfx_h - H0 * z) * 0.5);
g_now = time_precise();
g_click = (mouse_cap & 1) && !(g_lcap & 1);
g_rclick = (mouse_cap & 2) && !(g_lcap & 2);
g_rel = !(mouse_cap & 1) && (g_lcap & 1);

function automate(s, e)
(
<? loop(i = 1; 77,
  printf("  s == %d ? slider_automate(slider%d, e) :\n", i, i);
  i += 1;
); ?>  0;
);

function sx(x) ( ox + x * z; );
function sy(y) ( oy + y * z; );
function hit(x, y, w, h) ( mouse_x >= sx(x) && mouse_x < sx(x + w) && mouse_y >= sy(y) && mouse_y < sy(y + h); );
function hitc(x, y, r) ( sqr(mouse_x - sx(x)) + sqr(mouse_y - sy(y)) <= sqr(r * z); );
function font(n, sz, fl) ( n == 1 ? gfx_setfont(1, "Arial", (sz + 2) * z, fl) : gfx_setfont(n, "Courier New", (sz + 2) * z, fl); );
function clamp01(x) ( max(0, min(1, x)); );

function text_c(str, cx, y) local(tw, th) ( gfx_measurestr(str, tw, th); gfx_x = sx(cx) - tw * 0.5; gfx_y = sy(y); gfx_drawstr(str); );

function glow_str(str, x, y, r, g, b) local(d)
(
  d = max(1, z);
  gfx_set(r, g, b, 0.14);
  gfx_x = x - d; gfx_y = y; gfx_drawstr(str);
  gfx_x = x + d; gfx_y = y; gfx_drawstr(str);
  gfx_x = x; gfx_y = y - d; gfx_drawstr(str);
  gfx_x = x; gfx_y = y + d; gfx_drawstr(str);
  gfx_set(r, g, b, 1);
  gfx_x = x; gfx_y = y; gfx_drawstr(str);
);

function rrect(x, y, w, h, rad) local(QX, QY, QW, QH, QR)
(
  QX = sx(x); QY = sy(y); QW = w * z; QH = h * z; QR = rad * z;
  gfx_rect(QX + QR, QY, QW - 2*QR, QH, 1);
  gfx_rect(QX, QY + QR, QR, QH - 2*QR, 1);
  gfx_rect(QX + QW - QR, QY + QR, QR, QH - 2*QR, 1);
  gfx_circle(QX + QR, QY + QR, QR, 1, 1);
  gfx_circle(QX + QW - QR - 1, QY + QR, QR, 1, 1);
  gfx_circle(QX + QR, QY + QH - QR - 1, QR, 1, 1);
  gfx_circle(QX + QW - QR - 1, QY + QH - QR - 1, QR, 1, 1);
);

function soft_shadow(x, y, w, h, rad, n, a) local(i)
(
  i = 1;
  loop(n,
    gfx_set(0, 0, 0, a * (1 - (i - 1) / n));
    gfx_roundrect(sx(x) - i, sy(y) - i + 2 * z, w * z + 2 * i, h * z + 2 * i, (rad + i / z) * z, 1);
    i += 1;
  );
);

function acc(c)
(
  c == 0 ? ( acc_r = 1.00; acc_g = 0.66; acc_b = 0.26; ) :
  c == 1 ? ( acc_r = 0.30; acc_g = 0.82; acc_b = 0.96; ) :
  c == 2 ? ( acc_r = 0.46; acc_g = 0.92; acc_b = 0.56; ) :
  c == 3 ? ( acc_r = 0.74; acc_g = 0.54; acc_b = 1.00; ) :
  c == 4 ? ( acc_r = 0.46; acc_g = 0.64; acc_b = 1.00; ) :
  ( acc_r = 1.00; acc_g = 0.42; acc_b = 0.56; );
);

function panel(x, y, w, h, title, c) local(tw, th)
(
  soft_shadow(x, y, w, h, 7, max(3, floor(6 * z)), 0.10);
  gfx_set(0.115, 0.122, 0.140, 1);
  rrect(x, y, w, h, 7);
  gfx_gradrect(sx(x + 7), sy(y + 1), (w - 14) * z, 40 * z, 1, 1, 1, 0.035, 0, 0, 0, 0, 0, 0, 0, -0.035 / (40 * z));
  gfx_set(1, 1, 1, 0.05);
  gfx_line(sx(x + 7), sy(y) + 1, sx(x + w - 7), sy(y) + 1, 1);
  acc(c);
  font(1, 11, 'b');
  gfx_measurestr(title, tw, th);
  gfx_set(acc_r, acc_g, acc_b, 0.95);
  gfx_x = sx(x + 12); gfx_y = sy(y + 8);
  gfx_drawstr(title);
  gfx_set(acc_r, acc_g, acc_b, 0.35);
  gfx_rect(sx(x + 12) + tw + 8 * z, sy(y + 14), sx(x + w - 12) - (sx(x + 12) + tw + 8 * z), max(1, z), 1);
);

function set_sl(k, v) (
  v = max(g_min[k], min(g_max[k], v));
  g_step[k] > 0 ? v = g_min[k] + floor((v - g_min[k]) / g_step[k] + 0.5) * g_step[k];
  slider(k) !== v ? ( slider(k) = v; automate(k, 0); );
  g_touch_k = k; g_touch_t = g_now;
);

function fmt_sl(k, str) (
  k == 17 ? sprintf(str, slider17 == floor(slider17) ? "%d Hz" : "%.1f Hz", slider17) :
  k >= 45 && k <= 60 ? sprintf(str, "Level %d", slider(k)) :
  k >= 61 ? ( slider(k) == 64 ? strcpy(str, "Pan C") : sprintf(str, slider(k) < 64 ? "Pan L%d" : "Pan R%d", abs(slider(k) - 64)); ) :
  k == 21 || k == 26 || k == 27 ? sprintf(str, "%.1f %%", slider(k)) :
  k == 28 ? sprintf(str, "%+d dB", slider28) :
  sprintf(str, "%d", slider(k));
);

function knob_body(x, y, r) local(QX, QY, QR, i, t, c, a0, a1)
(
  QX = sx(x); QY = sy(y); QR = r * z;
  gfx_set(0, 0, 0, 0.45);
  gfx_circle(QX, QY + 2 * z, QR + 2 * z, 1, 1);
  a0 = -2.35619; a1 = 2.35619;
  gfx_set(0.035, 0.037, 0.045, 1);
  i = 0; loop(ceil(6 * z) + 1, gfx_arc(QX, QY, QR + 2 * z + i * 0.5, a0, a1, 1); i += 1; );
  gfx_set(0.05, 0.052, 0.06, 1);
  gfx_circle(QX, QY, QR, 1, 1);
  i = 0;
  loop(ceil(QR),
    t = i / ceil(QR);
    c = 0.14 + 0.16 * t;
    gfx_set(c, c * 1.01, c * 1.06, 1);
    gfx_circle(QX - QR * 0.18 * t, QY - QR * 0.22 * t, (QR - 1.5 * z) * (1 - t * 0.92), 1, 1);
    i += 1;
  );
  gfx_set(1, 1, 1, 0.10);
  gfx_arc(QX, QY, QR - 1.5 * z, -1.9, 0.2, 1);
  gfx_set(0, 0, 0, 0.35);
  gfx_arc(QX, QY, QR - 0.5 * z, 1.4, 4.2, 1);
);

function knob_value(x, y, r, pos, hot) local(QX, QY, QR, a0, a1, a, i, px, py, br)
(
  QX = sx(x); QY = sy(y); QR = r * z;
  a0 = -2.35619; a1 = 2.35619;
  a = a0 + (a1 - a0) * clamp01(pos);
  br = hot ? 1 : 0.85;
  a > a0 + 0.001 ? (
    gfx_set(acc_r, acc_g, acc_b, 0.10 * br);
    i = 0; loop(3, gfx_arc(QX, QY, QR + (5.5 + i * 0.7) * z, a0, a, 1); i += 1; );
    gfx_set(acc_r * br, acc_g * br, acc_b * br, 1);
    i = 0; loop(ceil(6 * z) + 1, gfx_arc(QX, QY, QR + 2 * z + i * 0.5, a0, a, 1); i += 1; );
  );
  px = sin(a); py = -cos(a);
  gfx_set(0.95, 0.95, 0.97, 1);
  gfx_circle(QX + px * QR * 0.72, QY + py * QR * 0.72, max(1.5, 2.2 * z), 1, 1);
);

function tooltip(x, y, str) local(tw, th, bx, by, bw, bh)
(
  font(1, 11, 'b');
  gfx_measurestr(str, tw, th);
  bw = tw + 12 * z; bh = th + 6 * z;
  bx = sx(x) - bw * 0.5; by = sy(y) - bh;
  gfx_set(0.02, 0.02, 0.03, 0.92);
  gfx_rect(bx, by, bw, bh, 1);
  gfx_set(acc_r, acc_g, acc_b, 0.8);
  gfx_rect(bx, by + bh - max(1, z), bw, max(1, z), 1);
  gfx_set(1, 1, 1, 1);
  gfx_x = bx + 6 * z; gfx_y = by + 3 * z;
  gfx_drawstr(str);
);

function knob(x, y, r, k, label, c) local(hov, d, fine, nv)
(
  acc(c);
  knob_body(x, y, r);
  font(1, 10, 'b');
  gfx_set(0.62, 0.64, 0.68, 1);
  text_c(label, x, y + r + 7);
  hov = hitc(x, y, r + 5);
  g_click && hov ? (
    g_last_k == k && g_now - g_last_t < 0.3 ? ( set_sl(k, g_def[k]); automate(k, 1); g_drag = -1; ) :
    ( g_drag = k; g_dy0 = mouse_y; g_dv0 = slider(k); );
    g_last_k = k; g_last_t = g_now;
    g_click = 0;
  );
  g_drag == k ? (
    mouse_cap |= 65536;
    fine = (mouse_cap & 4) || (mouse_cap & 8);
    d = (g_dy0 - mouse_y) / (220 * z) * (fine ? 0.1 : 1);
    set_sl(k, g_dv0 + d * (g_max[k] - g_min[k]));
  );
  hov && mouse_wheel != 0 && g_drag < 0 ? (
    set_sl(k, slider(k) + (mouse_wheel > 0 ? 1 : -1) * max(g_step[k], (g_max[k] - g_min[k]) * 0.01) * ((mouse_cap & 4) ? 0.1 : 1));
    automate(k, 1);
    mouse_wheel = 0;
  );
  knob_value(x, y, r, (slider(k) - g_min[k]) / (g_max[k] - g_min[k]), hov || g_drag == k);
  (hov || g_drag == k) ? ( g_hov_k = k; g_hov_x = x; g_hov_y = y - r - 8; g_hov_c = c; );
);

function box(x, y, w, h, str, c, hl) local(hov, tw, th)
(
  acc(c);
  hov = hit(x, y, w, h);
  gfx_set(0, 0, 0, 0.5);
  gfx_rect(sx(x) - z, sy(y) - z, (w + 2) * z, (h + 2) * z, 1);
  gfx_set(0.075, 0.08, 0.09, 1);
  gfx_rect(sx(x), sy(y), w * z, h * z, 1);
  hov ? ( gfx_set(1, 1, 1, 0.05); gfx_rect(sx(x), sy(y), w * z, h * z, 1); );
  font(1, 11, 'b');
  gfx_set(0.90, 0.91, 0.93, hl ? 1 : 0.9);
  gfx_measurestr(str, tw, th);
  gfx_x = sx(x + 7); gfx_y = sy(y) + (h * z - th) * 0.5;
  gfx_drawstr(str);
  gfx_set(acc_r, acc_g, acc_b, hov ? 1 : 0.75);
  gfx_triangle(sx(x + w - 13), sy(y + h * 0.5 - 2), sx(x + w - 5), sy(y + h * 0.5 - 2), sx(x + w - 9), sy(y + h * 0.5 + 2.5));
  gfx_rect(sx(x), sy(y + h) - max(1, z), w * z, max(1, z), 1);
  g_click && hov ? ( g_click = 0; gfx_x = sx(x); gfx_y = sy(y + h); 1; ) : 0;
);

function label(str, x, y) ( font(1, 9, 'b'); gfx_set(0.62, 0.64, 0.68, 1); gfx_x = sx(x); gfx_y = sy(y); gfx_drawstr(str); );

function toggle2(x, y, w, h, k, s0, s1, c) local(hw, i, sel, hov)
(
  acc(c);
  hw = w / 2;
  i = 0;
  loop(2,
    sel = slider(k) == i;
    hov = hit(x + i * hw, y, hw, h);
    gfx_set(0, 0, 0, 0.5); gfx_rect(sx(x + i * hw) - z, sy(y) - z, (hw + 2) * z, (h + 2) * z, 1);
    sel ? gfx_set(acc_r * 0.35, acc_g * 0.35, acc_b * 0.35, 1) : gfx_set(0.075, 0.08, 0.09, 1);
    gfx_rect(sx(x + i * hw), sy(y), hw * z, h * z, 1);
    sel ? ( gfx_set(acc_r, acc_g, acc_b, 1); gfx_rect(sx(x + i * hw), sy(y + h) - max(1, z) * 2, hw * z, max(1, z) * 2, 1); );
    font(1, 10, 'b');
    sel ? gfx_set(1, 1, 1, 1) : gfx_set(0.62, 0.64, 0.68, hov ? 1 : 0.85);
    text_c(i ? s1 : s0, x + i * hw + hw * 0.5, y + h * 0.5 - 6);
    g_click && hov ? ( set_sl(k, i); automate(k, 1); g_click = 0; );
    i += 1;
  );
);

// horizontal bar for slider k: drag to set, double-click for default, wheel steps by 1
function hbar(x, y, w, k, val, pan) local(hov, v)
(
  hov = hit(x - 2, y - 7, w + 4, 20);
  gfx_set(0.05, 0.052, 0.06, 1); gfx_rect(sx(x), sy(y), w * z, 6 * z, 1);
  pan ? (
    gfx_set(acc_r, acc_g, acc_b, 0.35); gfx_rect(sx(x + w * 0.5), sy(y), max(1, z), 6 * z, 1);
    gfx_set(1, 1, 1, hov || g_drag == k ? 1 : 0.8); gfx_rect(sx(x + (w - 2) * val / 127), sy(y - 2), 2 * z, 10 * z, 1);
  ) : (
    gfx_set(acc_r, acc_g, acc_b, hov || g_drag == k ? 1 : 0.8); gfx_rect(sx(x), sy(y), w * val / 127 * z, 6 * z, 1);
  );
  g_click && hov ? (
    g_last_k == k && g_now - g_last_t < 0.3 ? ( set_sl(k, g_def[k]); automate(k, 1); g_drag = -1; ) : g_drag = k;
    g_last_k = k; g_last_t = g_now;
    g_click = 0;
  );
  g_drag == k ? set_sl(k, floor(clamp01((mouse_x - sx(x)) / (w * z)) * 127 + 0.5));
  hov && mouse_wheel != 0 && g_drag < 0 ? ( set_sl(k, slider(k) + (mouse_wheel > 0 ? 1 : -1)); automate(k, 1); mouse_wheel = 0; );
  (hov || g_drag == k) ? ( g_hov_k = k; g_hov_x = x + w * 0.5; g_hov_y = y - 6; g_hov_c = g_acc_c; );
);

function follow_menu(c) local(j) (
  strcpy(#g_m, slider(29 + c) == 0 ? "!Off" : "Off");
  j = 0;
  loop(16,
    strcat(#g_m, sprintf(#g_u, "|%s%s%d", j == c ? "#" : "", slider(29 + c) == j + 1 ? "!" : "", j + 1));
    j += 1;
  );
  j = gfx_showmenu(#g_m);
  j > 0 ? ( set_sl(29 + c, j - 1); automate(29 + c, 1); );
);

function prog_name(p) (
<?  loop(i=0; prog_count, printf("p == %d ? \"%s\" : \n",i,_prog_name(i)); i+=1; ); ?>
  "";
);

function fam_name(f) (
  f == 0 ? "Piano" :
  f == 1 ? "Chromatic Percussion" :
  f == 2 ? "Organ" :
  f == 3 ? "Guitar" :
  f == 4 ? "Bass" :
  f == 5 ? "Strings" :
  f == 6 ? "Ensemble" :
  f == 7 ? "Brass" :
  f == 8 ? "Reed" :
  f == 9 ? "Pipe" :
  f == 10 ? "Synth Lead" :
  f == 11 ? "Synth Pad" :
  f == 12 ? "Synth Effects" :
  f == 13 ? "Ethnic" :
  f == 14 ? "Percussive" :
  f == 15 ? "Sound Effects" :
  "";
);

function prog_menu(c) local(p, f, j) (
  strcpy(#g_m, "");
  f = 0;
  loop(16,
    strcat(#g_m, sprintf(#g_u, "%s>%s", f ? "|" : "", fam_name(f)));
    j = 0;
    loop(8,
      p = f * 8 + j;
      strcat(#g_m, sprintf(#g_u, "|%s%s%d  %s", j == 7 ? "<" : "", slider(c + 1) == p ? "!" : "", p + 1, prog_name(p)));
      j += 1;
    );
    f += 1;
  );
  strcat(#g_m, slider(c + 1) == 128 ? "||!Drum Kit" : "||Drum Kit");
  p = gfx_showmenu(#g_m);
  p > 0 ? ( set_sl(c + 1, p == 129 ? 128 : p - 1); automate(c + 1, 1); );
);

function temper_name(t) (
<?  loop(i=0; temper_count, printf("t == %d ? \"%s\" : \n",i,_temper_name(i)); i+=1; ); ?>
  "";
);

!g_init ? (
  g_init = 1; g_drag = -1;
  g_i = 1; loop(16, g_min[g_i] = 0; g_max[g_i] = 128; g_step[g_i] = 1; g_i += 1; );
  g_min[17] = 372; g_max[17] = 495; g_step[17] = 0.1; g_def[17] = 440;
  g_min[18] = 0; g_max[18] = 79; g_step[18] = 1;
  g_min[19] = 0; g_max[19] = 1; g_step[19] = 1;
  g_min[20] = 0; g_max[20] = 4; g_step[20] = 1;
  g_min[21] = 0; g_max[21] = 100; g_step[21] = 0.1; g_def[21] = 84.5;
  g_min[22] = 0; g_max[22] = 1; g_step[22] = 1;
  g_min[23] = 0; g_max[23] = 4; g_step[23] = 1;
  g_min[24] = 10; g_max[24] = 50; g_step[24] = 1; g_def[24] = 30;
  g_min[25] = 15; g_max[25] = 60; g_step[25] = 1; g_def[25] = 39;
  g_min[26] = 0; g_max[26] = 100; g_step[26] = 0.1; g_def[26] = 100;
  g_min[27] = 0; g_max[27] = 100; g_step[27] = 0.1; g_def[27] = 0;
  g_min[28] = -40; g_max[28] = 12; g_step[28] = 1; g_def[28] = 0;
  g_i = 29; loop(16, g_min[g_i] = 0; g_max[g_i] = 16; g_step[g_i] = 1; g_def[g_i] = 0; g_i += 1; );
  g_i = 45; loop(32, g_min[g_i] = 0; g_max[g_i] = 127; g_step[g_i] = 1; g_def[g_i] = g_i < 61 ? 100 : 64; g_i += 1; );
  g_min[77] = 1; g_max[77] = 256; g_step[77] = 1; g_def[77] = 64;
);

g_rel && g_drag >= 0 ? ( automate(g_drag, 1); g_drag = -1; );
g_hov_k = -1;

gfx_set(0.075, 0.078, 0.088, 1);
gfx_rect(0, 0, gfx_w, gfx_h, 1);
gfx_gradrect(sx(0), sy(0), W0 * z, 90 * z, 1, 1, 1, 0.03, 0, 0, 0, 0, 0, 0, 0, -0.03 / (90 * z));

// header
font(1, 30, 'b');
gfx_measurestr("MAJOR GENERAL ", g_tw, g_th);
acc(0);
gfx_set(acc_r, acc_g, acc_b, 0.18);
gfx_x = sx(18) + z; gfx_y = sy(14) + 2 * z; gfx_drawstr("MAJOR GENERAL ");
gfx_set(acc_r, acc_g, acc_b, 1);
gfx_x = sx(18); gfx_y = sy(14); gfx_drawstr("MAJOR GENERAL ");
gfx_set(0.92, 0.93, 0.95, 1);
gfx_x = sx(18) + g_tw; gfx_y = sy(14); gfx_drawstr("MIDI");
font(1, 11, 0);
gfx_set(0.50, 0.52, 0.56, 1);
gfx_x = sx(20); gfx_y = sy(50);
gfx_drawstr("by chmaha  ·  based on Sonivox EAS, the Android General MIDI synthesizer");
g_nv = 0; g_i = 0; loop(NV, vst[g_i] != 0 ? g_nv += 1; g_i += 1; );
font(2, 13, 'b');
acc(1);
function poly_menu() (
  g_sel = gfx_showmenu(sprintf(#g_m, "#Polyphony (more voices use more CPU)||%s16|%s24|%s32|%s48|%s64 (default)|%s96|%s128|%s192|%s256",
    slider77 == 16 ? "!" : "", slider77 == 24 ? "!" : "", slider77 == 32 ? "!" : "", slider77 == 48 ? "!" : "", slider77 == 64 ? "!" : "",
    slider77 == 96 ? "!" : "", slider77 == 128 ? "!" : "", slider77 == 192 ? "!" : "", slider77 == 256 ? "!" : ""));
  g_sel > 1 ? ( set_sl(77, g_sel == 2 ? 16 : g_sel == 3 ? 24 : g_sel == 4 ? 32 : g_sel == 5 ? 48 : g_sel == 6 ? 64 : g_sel == 7 ? 96 : g_sel == 8 ? 128 : g_sel == 9 ? 192 : 256); automate(77, 1); );
);
sprintf(#g_s, "VOICES %d /", g_nv);
gfx_measurestr(#g_s, g_tw, g_th);
glow_str(#g_s, sx(790) - g_tw, sy(26), acc_r, acc_g, acc_b);
sprintf(#g_n, "%d", slider77);
box(796, 18, 52, 30, #g_n, 1, 1) ? poly_menu();
acc(1); gfx_set(acc_r, acc_g, acc_b, 1); gfx_rect(sx(796), sy(46), 52 * z, 2 * z, 1);
hit(796, 18, 52, 30) && mouse_wheel != 0 ? ( set_sl(77, slider77 + (mouse_wheel > 0 ? 1 : -1) * ((mouse_cap & 4) ? 1 : 8)); automate(77, 1); mouse_wheel = 0; );
acc(5);
g_hb = hit(860, 18, 120, 30);
gfx_set(0, 0, 0, 0.5); gfx_rect(sx(860) - z, sy(18) - z, 122 * z, 32 * z, 1);
gfx_set(g_hb ? 0.2 : 0.14, 0.09, 0.1, 1); gfx_rect(sx(860), sy(18), 120 * z, 30 * z, 1);
gfx_set(acc_r, acc_g, acc_b, 1); gfx_rect(sx(860), sy(46), 120 * z, 2 * z, 1);
font(1, 11, 'b'); gfx_set(1, 1, 1, 1); text_c("GM RESET", 920, 26);
g_click && g_hb ? ( gm_req = 1; g_click = 0; );

// channels
panel(16, 74, 968, 350, "CHANNELS", 0);
g_c = 0;
loop(16,
  g_col = g_c >= 8; g_row = g_c % 8;
  g_x = 28 + g_col * 482; g_y = 104 + g_row * 39;
  g_dr = cfl[g_c] & 8;
  acc(g_dr ? 5 : 0);
  ACT[g_c] > 0.01 ? ( g_a = ACT[g_c]; ACT[g_c] *= 0.82; ) : g_a = 0;
  gfx_set(0.05, 0.052, 0.06, 1); gfx_rect(sx(g_x), sy(g_y), 30 * z, 28 * z, 1);
  gfx_set(acc_r, acc_g, acc_b, 0.25 + 0.75 * g_a); gfx_rect(sx(g_x), sy(g_y + 26), 30 * z, 2 * z, 1);
  font(2, 14, 'b');
  gfx_set(acc_r, acc_g, acc_b, 0.55 + 0.45 * g_a);
  sprintf(#g_s, "%d", g_c + 1); text_c(#g_s, g_x + 15, g_y + 6);
  g_a > 0.02 ? ( gfx_set(acc_r, acc_g, acc_b, g_a * 0.25); gfx_circle(sx(g_x + 15), sy(g_y + 14), 18 * z, 1, 1); );
  g_p = slider(g_c + 1);
  g_p == 128 ? strcpy(#g_s, "Drum Kit") : sprintf(#g_s, "%03d  %s", g_p + 1, prog_name(g_p));
  box(g_x + 38, g_y + 1, 214, 26, #g_s, g_dr ? 5 : 0, 1) ? prog_menu(g_c);
  // level and pan show the channel's CC7 and CC10, whether set here or by incoming MIDI
  g_acc_c = g_dr ? 5 : 0; acc(g_acc_c);
  hbar(g_x + 262, g_y + 11, 66, 45 + g_c, cvol[g_c], 0);
  hbar(g_x + 338, g_y + 11, 36, 61 + g_c, cpan[g_c], 1);
  g_f = slider(29 + g_c);
  g_f ? sprintf(#g_s, "%d", g_f) : strcpy(#g_s, "-");
  box(g_x + 384, g_y + 3, 46, 22, #g_s, 1, g_f > 0) ? follow_menu(g_c);
  g_n = 0; g_i = 0; loop(NV, vst[g_i] != 0 && vst[g_i] != 4 && (vch[g_i] & 15) == g_c && vch[g_i] < 16 ? g_n += 1; g_i += 1; );
  font(2, 11, 'b'); gfx_set(0.62, 0.64, 0.68, g_n ? 1 : 0.4);
  sprintf(#g_s, "%2d", g_n); gfx_x = sx(g_x + 440); gfx_y = sy(g_y + 8); gfx_drawstr(#g_s);
  g_c += 1;
);
font(1, 9, 'b'); gfx_set(0.56, 0.58, 0.62, 1);
g_i = 0;
loop(2,
  gfx_x = sx(290 + g_i * 482); gfx_y = sy(90); gfx_drawstr("LEVEL");
  gfx_x = sx(366 + g_i * 482); gfx_y = sy(90); gfx_drawstr("PAN");
  gfx_x = sx(412 + g_i * 482); gfx_y = sy(90); gfx_drawstr("FOLLOWS");
  gfx_x = sx(466 + g_i * 482); gfx_y = sy(90); gfx_drawstr("VC");
  g_i += 1;
);

// tuning
panel(16, 436, 250, 188, "TUNING", 2);
label("A4", 30, 470);
g_ht = hit(30, 484, 222, 28);
box(30, 484, 222, 28, fmt_sl(17, #g_s), 2, 1) ? (
  g_sel = gfx_showmenu("466 Hz (Chorton)|440 Hz (modern)|442 Hz|443 Hz|435 Hz (1859 diapason)|432 Hz|430 Hz (classical)|415 Hz (baroque)|392 Hz (French baroque)");
  g_sel > 0 ? (
    set_sl(17, g_sel == 1 ? 466 : g_sel == 2 ? 440 : g_sel == 3 ? 442 : g_sel == 4 ? 443 : g_sel == 5 ? 435 : g_sel == 6 ? 432 : g_sel == 7 ? 430 : g_sel == 8 ? 415 : 392);
    automate(17, 1);
  );
);
g_ht && mouse_wheel != 0 ? ( set_sl(17, slider17 + (mouse_wheel > 0 ? 1 : -1) * ((mouse_cap & 4) ? 0.1 : 1)); automate(17, 1); mouse_wheel = 0; );
label("TEMPERAMENT", 30, 528);
box(30, 542, 222, 28, temper_name(slider18), 2, 1) ? (
  g_sel = gfx_showmenu(#tempermenu);
  g_sel > 0 ? ( set_sl(18, TEMPER_ORDER[g_sel - 1]); automate(18, 1); );
);
font(1, 9, 0); gfx_set(0.56, 0.58, 0.62, 1);
gfx_x = sx(30); gfx_y = sy(584); gfx_drawstr("Wheel on A4: 1 Hz.");
gfx_x = sx(30); gfx_y = sy(598); gfx_drawstr("Drums are never retuned.");

// reverb
panel(278, 436, 250, 188, "REVERB", 1);
label("SOURCE", 292, 470);
toggle2(292, 484, 222, 26, 19, "CC91 SENDS", "WHOLE MIX", 1);
label("ROOM", 292, 526);
slider20 == 0 ? strcpy(#g_s, "Off") : slider20 == 1 ? strcpy(#g_s, "Large Hall") : slider20 == 2 ? strcpy(#g_s, "Hall") : slider20 == 3 ? strcpy(#g_s, "Chamber") : strcpy(#g_s, "Room");
box(292, 540, 130, 28, #g_s, 1, 1) ? (
  g_sel = gfx_showmenu(sprintf(#g_m, "%sOff|%sLarge Hall|%sHall|%sChamber|%sRoom", slider20 == 0 ? "!" : "", slider20 == 1 ? "!" : "", slider20 == 2 ? "!" : "", slider20 == 3 ? "!" : "", slider20 == 4 ? "!" : ""));
  g_sel > 0 ? ( set_sl(20, g_sel - 1); automate(20, 1); );
);
knob(472, 560, 22, 21, "WET", 1);

// chorus
panel(540, 436, 318, 188, "CHORUS", 3);
label("SOURCE", 554, 470);
toggle2(554, 484, 184, 26, 22, "CC93 SENDS", "WHOLE MIX", 3);
slider23 == 0 ? strcpy(#g_s, "Off") : sprintf(#g_s, "Chorus %d", slider23);
box(746, 484, 98, 26, #g_s, 3, 1) ? (
  g_sel = gfx_showmenu(sprintf(#g_m, "%sOff|%sChorus 1|%sChorus 2|%sChorus 3|%sChorus 4", slider23 == 0 ? "!" : "", slider23 == 1 ? "!" : "", slider23 == 2 ? "!" : "", slider23 == 3 ? "!" : "", slider23 == 4 ? "!" : ""));
  g_sel > 0 ? ( set_sl(23, g_sel - 1); automate(23, 1); );
);
knob(584, 562, 18, 24, "RATE", 3);
knob(656, 562, 18, 25, "DEPTH", 3);
knob(728, 562, 18, 26, "LEVEL", 3);
knob(800, 562, 18, 27, "DRY", 3);

// master
panel(870, 436, 114, 188, "MASTER", 4);
knob(927, 540, 26, 28, "VOLUME", 4);

g_hov_k > 0 || (g_now - g_touch_t < 1.2 && g_touch_k > 0) ? (
  g_k = g_hov_k > 0 ? g_hov_k : g_touch_k;
  g_hov_k > 0 ? acc(g_hov_c);
  g_hov_k > 0 ? tooltip(g_hov_x, g_hov_y, fmt_sl(g_k, #g_s));
);
!loaded ? (
  font(1, 16, 'b'); gfx_set(1, 0.45, 0.35, 1);
  text_c("Samples not found: Data/MajorGeneralMIDI/MajorGeneralMIDI.flac", 500, 300);
);
g_lcap = mouse_cap;
