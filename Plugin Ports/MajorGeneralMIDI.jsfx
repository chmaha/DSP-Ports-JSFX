function rv_setpreset(p) ( rv_next = p; rv_updroom(); );

CH_SIZE = 882;
CHL = mk(CH_SIZE); CHR = mk(CH_SIZE); CHS = mk(128);
mem_set_values(CHS, 0, 1608, 3212, 4808, 6393, 7962, 9512, 11309, 12539, 14010, 15446, 16846, 18204, 19519, 20787, 22005, 23170,
    24279, 25329, 26319, 27245, 28105, 28898, 29621, 30273, 30852, 31356, 31785, 32137, 32412, 32609, 32728,
