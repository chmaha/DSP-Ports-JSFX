in_pin:none
out_pin:Left output
out_pin:Right output
options:no_meter

@init
ext_noinit = gfx_ext_retina = 1;
SMP_LEN = 212177;

function mk(n) ( mem_top += n; mem_top - n; );
function w16(x) ( x - 65536 * floor((x + 32768) / 65536); );
function w32(x) ( x - 4294967296 * floor((x + 2147483648) / 4294967296); );
function m15(a, b) ( floor((a * b) / 32768); );
function tdiv(a, b) ( a >= 0 ? floor(a / b) : -floor((-a) / b); );
function sat16(x) ( x > 32767 ? 32767 : x < -32768 ? -32768 : x; );

function calc2x(c) local(d, ei, ef, t1, t2) (
  c < -18000 ? 0 : (
    c > 19200 ? c = 19200;
    d = floor((c * 111848) / 32768);
    ei = floor(d / 4096); ef = d - ei * 4096;
    t1 = 7344 + floor((ef * 2588) / 4096);
    t2 = 22833 + floor((ef * t1) / 4096);
    t1 = 32768 + floor((ef * t2) / 4096);
    ei >= 0 ? w32(t1 * (2 ^ ei)) : floor(t1 / (2 ^ (-ei)));
  );
);

function calcpan(pan) local(na, t) (
  na = (pan < -63 ? -63 : pan > 63 ? 63 : pan) * 256;
  t = 32768 + m15(-27146, na); t = 23170 + m15(t, na);
  pan_r = t > 32767 ? 32767 : t < 0 ? 0 : t;
  t = -32768 + m15(-27146, na); t = 23170 + m15(t, na);
  pan_l = t > 32767 ? 32767 : t < 0 ? 0 : t;
);

NV = 256; FRAME = 256;
vst = mk(NV); vfl = mk(NV); vch = mk(NV); vnc = mk(NV); vno = mk(NV); vnn = mk(NV);
vve = mk(NV); vnv = mk(NV); vrg = mk(NV); vnr = mk(NV); vag = mk(NV); vgn = mk(NV);
wart = mk(NV); e1s = mk(NV); e1v = mk(NV); e1i = mk(NV); e2s = mk(NV); e2v = mk(NV); e2i = mk(NV);
wgl = mk(NV); wgr = mk(NV); wpf = mk(NV); wpa = mk(NV); wls = mk(NV); wle = mk(NV);
wlv = mk(NV); wlp = mk(NV); wfx1 = mk(NV); wfx2 = mk(NV); wfy1 = mk(NV); wfy2 = mk(NV);
cfl = mk(16); csg = mk(16); csp = mk(16); cpool = mk(16); cbank = mk(16); cprog = mk(16);
creg = mk(16); cpb = mk(16); cmod = mk(16); cvol = mk(16); cpan = mk(16); cexp = mk(16);
cprs = mk(16); crpn = mk(16); cpbs = mk(16); cfine = mk(16); ccoarse = mk(16); crev = mk(16); ccho = mk(16);
pcnt = mk(16); palloc = mk(16);
VB = mk(FRAME); SB = mk(2 * FRAME); MIX = mk(2 * FRAME); RSND = mk(2 * FRAME); CSND = mk(2 * FRAME);
OUTB = mk(2 * FRAME); TUNE = mk(12);

function wt_updch(ch) local(sg, pb) (
  sg = m15(floor((cvol[ch] * 32768) / 127), floor((cexp[ch] * 32768) / 127));
  sg = m15(sg, sg);
  sg = m15(sg, smv);
  csg[ch] = sg > 32767 ? 32767 : sg < -32768 ? -32768 : sg;
  pb = cpb[ch] * 4 - 32768;
  csp[ch] = m15(pb, cpbs[ch]);
  !(cfl[ch] & 8) ? csp[ch] += cfine[ch] + ccoarse[ch] * 100;
  cfl[ch] &= 0xFB;
);

function wt_release(v) local(a) (
  a = ART + wart[v] * 17;
  e1s[v] = 6; e1i[v] = a[3];
  e2s[v] = 6; e2i[v] = a[7];
);

function wt_mute(v) (
  vfl[v] &= 0xB9;
  e1s[v] = 8; e2s[v] = 8;
);

function wt_sustain(v) (
  e1v[v] >= ART[wart[v] * 17 + 2] ? (
    e1s[v] = 4;
    vst[v] = 2;
    vfl[v] |= 2;
  );
);

function wt_start(v, ri) local(ch, a, rb, w) (
  vrg[v] = ri;
  vfl[v] = 8;
  ch = vch[v] & 15;
  cfl[ch] & 4 ? wt_updch(ch);
  rb = REG + ri * 9;
  wart[v] = rb[8];
  a = ART + wart[v] * 17;
  e1s[v] = 2; e1v[v] = 0; e1i[v] = a[0];
  e2s[v] = 2; e2v[v] = 0; e2i[v] = a[4];
  wlv[v] = 0; wlp[v] = w16(-a[9]);
  vgn[v] = 0;
  calcpan(cpan[ch] - 64 + a[16]); wgl[v] = pan_l; wgr[v] = pan_r;
  wfx1[v] = wfx2[v] = wfy1[v] = wfy2[v] = 0;
  rb[0] & 2 ? (
    wpa[v] = 4574296; wls[v] = -1; wle[v] = 4574295;
  ) : (
    w = rb[7];
    wpa[v] = SOFF[w] / 2;
    rb[0] & 1 ? (
      wls[v] = wpa[v] + rb[5]; wle[v] = wpa[v] + rb[6] - 1;
    ) : (
      wls[v] = wle[v] = wpa[v] + SLEN[w] / 2 - 1;
    );
  );
);

function wt_eg1(v, a) local(t) (
  e1s[v] == 2 ? (
    t = e1v[v] + e1i[v];
    t >= 32767 ? ( t = 32767; e1s[v] = 4; e1i[v] = a[1]; );
    e1v[v] = t;
  ) : e1s[v] == 4 ? (
    t = m15(e1v[v], e1i[v]);
    t <= a[2] ? ( t = a[2]; e1s[v] = t > 0 ? 5 : 8; );
    e1v[v] = t;
  ) : e1s[v] == 6 ? (
    t = m15(e1v[v], e1i[v]);
    t <= 0 ? ( t = 0; e1s[v] = 8; );
    e1v[v] = t;
  ) : e1s[v] != 5 ? e1v[v] = 0;
);

function wt_eg2(v, a) local(t) (
  e2s[v] == 2 ? (
    t = e2v[v] + e2i[v];
    t >= 32767 ? ( t = 32767; e2s[v] = 4; e2i[v] = a[5]; );
    e2v[v] = w16(t);
  ) : e2s[v] == 4 ? (
    t = e2v[v] - e2i[v];
    t <= a[6] ? ( t = a[6]; e2s[v] = 5; );
    e2v[v] = w16(t);
  ) : e2s[v] == 6 ? (
    t = e2v[v] - e2i[v];
    t <= 0 ? ( t = 0; e2s[v] = 8; );
    e2v[v] = w16(t);
  ) : e2s[v] != 5 ? e2v[v] = 0;
);

function wt_lfo(v, inc) local(p, lv) (
  p = wlp[v];
  p < 0 ? wlp[v] = p + 1 : (
    lv = w16(p * 4);
    p > 0x1fff && p < 0x6000 ? lv = -lv - 1;
    wlv[v] = lv;
    p += inc;
    wlp[v] = p - 32768 * floor(p / 32768);
  );
);

function wt_setfilt(cutoff, res) local(fc, rdb, theta, T, w0, q, w0T, D, g) (
  fc = (2 ^ ((cutoff - 6900) / 1200)) * 440;
  fc = max(min(fc, 22050), 44100 / 240);
  rdb = max(res / 10, 0);
  theta = ((2 * $pi) * fc) / 44100;
  T = 1 / 44100;
  w0 = 88200 * tan(theta / 2);
  q = rdb < 0.000000001 ? 1 / sqrt(2) : 10 ^ (rdb / 20);
  w0T = w0 * T;
  D = (4 + ((2 * w0T) / q)) + (w0T * w0T);
  f_a1 = ((-8) + (2 * (w0T * w0T))) / D;
  f_a2 = ((4 - ((2 * w0T) / q)) + (w0T * w0T)) / D;
  f_b02 = (w0T * w0T) / D;
  f_b1 = (2 * (w0T * w0T)) / D;
  g = 10 ^ ((-rdb) / 40);
  f_b02 *= g; f_b1 *= g;
);

function wt_update(v) local(a, rb, ch, prev, tgt, t, pinc, ns, done, noise, i, pa, pf, s1, s2, acc, n, le, ls,
                            x1, x2, y1, y2, b02, b1, a1, a2, gain, ginc, gl, gr, sv, p0, p1, fr, tmp0, tmp1)
(
  a = ART + wart[v] * 17;
  rb = REG + (vrg[v] & 0x3fff) * 9;
  ch = vch[v] & 15;
  prev = vgn[v];
  wt_eg1(v, a);
  wt_eg2(v, a);
  wt_lfo(v, a[10]);
  a[13] == 0 ? f_b02 = 0 : wt_setfilt(m15(e2v[v], a[12]) + a[13], a[15]);
  t = vve[v] * 256; t = m15(t, t); t = m15(t, rb[4]); t = m15(t, csg[ch]);
  tmp0 = m15(wlv[v], a[14]); tmp0 = m15(tmp0, 6531176); tmp0 = calc2x(tmp0);
  t = m15(t, tmp0);
  tgt = w16(m15(t, e1v[v]));
  t = csp[ch] + rb[3];
  cfl[ch] & 8 ? t += vno[v] * 100 : t += (vno[v] + gtr) * 100 + TUNE[vno[v] % 12];
  tmp0 = m15(50, cmod[ch] * 256) + m15(50, cprs[ch] * 256);
  tmp0 = m15(wlv[v], tmp0);
  t += m15(e2v[v], a[11]) + m15(wlv[v], a[8]);
  pinc = calc2x(t + tmp0);
  noise = wls[v] == -1;
  t = noise ? 0 : wle[v] - wls[v];
  t != 0 ? (
    t *= 32768;
    pinc > t ? pinc -= t * floor(pinc / t);
  );
  ns = FRAME; done = 0;
  !noise && wls[v] == wle[v] ? (
    t = wpf[v] + pinc * FRAME;
    wpa[v] + floor(t / 32768) >= wle[v] ? (
      n = (wle[v] - wpa[v]) * 32768 - wpf[v];
      ns = pinc ? tdiv(n + pinc - 1, pinc) : n;
      ns < 0 ? ns = 0 : ns > FRAME ? ns = FRAME;
      done = 1;
    );
  );
  ns > 0 ? (
    noise ? (
      tmp0 = floor(wpa[v] / 262144); tmp1 = floor(wle[v] / 262144);
      pf = wpf[v]; i = 0;
      loop(ns,
        VB[i] = floor((tmp0 * (32768 - pf)) / 32768) + floor((tmp1 * pf) / 32768);
        pf += pinc;
        pf >= 32768 ? (
          tmp0 = tmp1;
          wpa[v] = wle[v];
          wle[v] = w32(5 * wle[v] + 1);
          tmp1 = floor(wle[v] / 262144);
          pf -= 32768 * floor(pf / 32768);
        );
        i += 1;
      );
      wpf[v] = pf;
    ) : wls[v] != wle[v] ? (
      pa = wpa[v]; pf = wpf[v] & 32767; le = wle[v] + 1; ls = wls[v];
      s1 = SMP[pa]; s2 = SMP[pa + 1]; i = 0;
      loop(ns,
        VB[i] = s1 + floor(((s2 - s1) * pf) / 32768);
        pf += pinc;
        pf >= 32768 ? (
          pa += floor(pf / 32768);
          pf &= 32767;
          while (pa + 1 >= le) ( pa -= le - ls; );
          s1 = SMP[pa]; s2 = SMP[pa + 1];
        );
        i += 1;
      );
      wpa[v] = pa; wpf[v] = pf;
    ) : (
      pa = wpa[v]; pf = wpf[v] & 32767; le = wle[v] + 1;
      s1 = SMP[pa]; s2 = SMP[pa + 1]; i = 0;
      while (i < ns) (
        VB[i] = s1 + floor(((s2 - s1) * pf) / 32768);
        pf += pinc;
        i += 1;
        pf >= 32768 ? (
          n = floor(pf / 32768);
          pa + n + 1 >= le ? i = ns + 1 : (
            pa += n;
            pf &= 32767;
            s1 = SMP[pa]; s2 = SMP[pa + 1];
          );
        );
      );
      wpa[v] = pa; wpf[v] = pf;
    );
    f_b02 != 0 ? (
      b02 = f_b02; b1 = f_b1; a1 = f_a1; a2 = f_a2;
      x1 = wfx1[v]; x2 = wfx2[v]; y1 = wfy1[v]; y2 = wfy2[v];
      i = 0;
      loop(ns,
        acc = ((((b02 * VB[i]) + (b1 * x1)) + (b02 * x2)) - (a1 * y1)) - (a2 * y2);
        acc > 32767 ? acc = 32767;
        acc < -32768 ? acc = -32768;
        y2 = y1;
        y1 = acc >= 0 ? floor(acc) : ceil(acc);
        x2 = x1;
        x1 = VB[i];
        VB[i] = y1;
        i += 1;
      );
      wfx1[v] = x1; wfx2[v] = x2; wfy1[v] = y1; wfy2[v] = y2;
    );
    ginc = tdiv((tgt - prev) * 65536, FRAME);
    ginc < 0 ? ginc += 1;
    gain = prev * 65536;
    gl = wgl[v]; gr = wgr[v];
    i = 0;
    loop(ns,
      gain += ginc;
      sv = m15(VB[i], tdiv(gain, 65536));
      SB[2 * i] = m15(sv, gl);
      SB[2 * i + 1] = m15(sv, gr);
      i += 1;
    );
  );
  ns < FRAME ? memset(SB + 2 * ns, 0, 2 * (FRAME - ns));
  vfl[v] &= 0xF7;
  vst[v] != 5 && e1s[v] == 8 ? done = 1;
  vgn[v] = tgt;
  done;
);

function init_voice(v) (
  vch[v] = 16; vnc[v] = 16; vno[v] = vnn[v] = 0x69; vve[v] = vnv[v] = 0x64;
  vrg[v] = 0; vag[v] = 0; vfl[v] = 0; vst[v] = 0;
);

function pool_of(v) ( cpool[(vst[v] == 5 ? vnc[v] : vch[v]) & 15]; );
function inc_pool(v) local(p) ( vst[v] != 4 ? ( p = pool_of(v); pcnt[p] = (pcnt[p] + 1) & 255; ); );
function dec_pool(v) local(p) ( vst[v] != 4 ? ( p = pool_of(v); pcnt[p] = (pcnt[p] + 255) & 255; ); );

function upd_ages(age) local(i) (
  i = 0;
  loop(NV, age - vag[i] > 0 ? vag[i] = (vag[i] + 1) & 65535; i += 1; );
);

function vm_mute(v) (
  vst[v] != 4 && vst[v] != 0 ? (
    dec_pool(v);
    wt_mute(v);
    vst[v] = 4;
  );
);

function vm_release(v) (
  vst[v] != 4 && vst[v] != 0 && vst[v] != 3 ? (
    vst[v] == 5 ? vm_mute(v);
    wt_release(v);
    vst[v] = 3;
  );
);

function vm_free(v) (
  vst[v] != 0 ? (
    dec_pool(v);
    vm_act -= 1; snav -= 1;
    init_voice(v);
    upd_ages(vag[v]);
  );
);

function vm_stolen(v, ch, note, vel, ri) (
  dec_pool(v);
  wt_mute(v);
  vst[v] = 5;
  vnc[v] = ch; vnn[v] = note; vnv[v] = vel; vnr[v] = ri;
  inc_pool(v);
  vfl[v] &= 0xB9;
  upd_ages(vag[v]);
  vag[v] = vm_age; vm_age = (vm_age + 1) & 65535;
);

function vm_retarget(v) local(fl) (
  (sfl & 2) && (cfl[vch[v] & 15] & 2) ? vm_free(v) : (
    vch[v] = vnc[v];
    vno[v] = vnn[v]; vve[v] = vnv[v];
    vnc[v] = 16;
    vrg[v] = vnr[v];
    fl = vfl[v];
    vst[v] = 1;
    wt_start(v, vrg[v]);
    fl & 4 ? ( vfl[v] |= 4; sfl |= 8; );
  );
);

function vm_keygroup(kg, ch) local(i) (
  i = 0;
  loop(NV,
    vst[i] != 5 ? (
      ch == vch[i] && kg == (REG[vrg[i] * 9] & 0x7f00) ? (
        vfl[i] & 8 ? vfl[i] |= 0x40 : vm_mute(i);
      );
    ) : (
      ch == vnc[i] && kg == (REG[vnr[i] * 9] & 0x7f00) ? (
        vfl[i] & 8 ? vfl[i] |= 0x40 : vm_mute(i);
      );
    );
    i += 1;
  );
);

function vm_polylimit(ch, note, vel, ri) local(i, n, old, oldage, age, r) (
  n = 0; old = NV; oldage = 0; r = 0;
  i = 0;
  loop(NV,
    vst[i] != 5 ? (
      ch == vch[i] && note == vno[i] ? (
        n += 1;
        age = (vm_age - vag[i]) & 65535;
        age >= oldage ? ( oldage = age; old = i; );
      );
    ) : (
      ch == vnc[i] && note == vnn[i] ? n += 1;
    );
    i += 1;
  );
  n >= 2 && old != NV ? ( vm_stolen(old, ch, note, vel, ri); r = 1; );
  r;
);

function vm_steal(ch, note) local(i, best, bp, cp, cch, cn) (
  bp = 0; best = NV;
  i = 0;
  loop(NV,
    vst[i] != 0 ? (
      vst[i] == 5 ? ( cch = vnc[i]; cn = vnn[i]; ) : ( cch = vch[i]; cn = vno[i]; );
      vst[i] == 5 || (vfl[i] & 8) ? cp = 128 - vnv[i] : (
        cp = vag[i] * 2;
        cp += (floor(32768 / 256) + 256) - floor(vgn[i] / 256);
      );
      sfl & 2 ? (
        pcnt[cpool[cch & 15]] >= palloc[cpool[cch & 15]] ? cp += (pcnt[cpool[cch & 15]] - palloc[cpool[cch & 15]] + 1) * 4096;
        cp += cpool[cch & 15] * 4;
      );
      note == cn && ch == cch ? cp += 128;
      cp >= bp ? ( bp = cp; best = i; );
    );
    i += 1;
  );
  best;
);

function vm_startvoice(ch, note, vel, ri) local(rb, kg, v, done) (
  rb = REG + ri * 9;
  done = 0;
  pcnt[cpool[ch]] != 0 ? (
    kg = rb[0] & 0x7f00;
    kg != 0 ? vm_keygroup(kg, ch);
    (rb[0] & 0x40) == 0 ? done = vm_polylimit(ch, note, vel, ri);
  );
  !done ? (
    v = 0; while (v < NV && vst[v] != 0) ( v += 1; );
    vm_act < vm_maxp && snav < vm_maxp && v < NV ? (
      vm_act += 1; snav += 1;
      vch[v] = ch; vno[v] = note; vve[v] = vel;
      vag[v] = vm_age; vm_age = (vm_age + 1) & 65535;
      vst[v] = 1;
      inc_pool(v);
      wt_start(v, ri);
    ) : (
      v = vm_steal(ch, note);
      v < NV ? vm_stolen(v, ch, note, vel, ri);
    );
  );
);

function vm_startnote(ch, note, vel) local(ri, an, rb, go) (
  !(cfl[ch] & 2) ? (
    ri = creg[ch];
    an = note + ccoarse[ch] + (cfl[ch] & 8 ? 0 : gtr);
    an = an < 0 ? 0 : an > 127 ? 127 : an;
    go = 1;
    while (go) (
      rb = REG + ri * 9;
      an >= rb[1] && an <= rb[2] ? ( vm_startvoice(ch, note, vel, ri); go = 0; ) :
      rb[0] & 0x8000 ? go = 0 : ri += 1;
    );
  );
);

function vm_stopnote(ch, note) local(i) (
  i = 0;
  loop(NV,
    vst[i] != 5 ? (
      ch == vch[i] && note == vno[i] ? (
        cfl[ch] & 1 ? vfl[i] |= 2 : (
          vfl[i] & 8 ? ( vfl[i] |= 4; sfl |= 8; ) : vm_release(i);
        );
      );
    ) : ch == vnc[i] && note == vnn[i] ? vfl[i] |= 4;
    i += 1;
  );
);

function vm_rel_deferred(ch) local(i) (
  i = 0;
  loop(NV,
    ch == vch[i] && (vfl[i] & 2) ? ( vm_release(i); vfl[i] &= 0xFD; );
    i += 1;
  );
);

function vm_catch_sustain(ch) local(i) (
  i = 0;
  loop(NV, ch == vch[i] && vst[i] == 3 ? wt_sustain(i); i += 1; );
);

function vm_allnotesoff(ch) local(i) (
  i = 0;
  loop(NV,
    vst[i] != 0 && ((vst[i] != 5 && ch == vch[i]) || (vst[i] == 5 && ch == vnc[i])) ? ( wt_mute(i); vst[i] = 4; );
    i += 1;
  );
);

function vm_deferred_stop() local(i, any, ch) (
  any = 0; i = 0;
  loop(NV,
    vfl[i] & 4 ? (
      vst[i] == 5 ? any = 1 : (
        vfl[i] -= 4;
        ch = vch[i] & 15;
        cfl[ch] & 1 ? wt_sustain(i) : vm_release(i);
      );
    );
    i += 1;
  );
  !any ? sfl &= 0xF7;
);

function vm_findprog(bk, prog) local(r) (
  r = -1;
  bk == 0x7900 && BANK[prog] != 0xffff ? r = BANK[prog] :
  bk * 256 + prog == 0x780000 ? r = DRUMREG;
  r;
);

function vm_progchange(ch, prog) local(bk, ri) (
  bk = cbank[ch];
  (bk & 0xFF00) == 0x7800 ? cfl[ch] |= 8 : (bk & 0xFF00) == 0x7900 ? cfl[ch] &= 0xF7;
  ri = vm_findprog(bk, prog);
  ri < 0 ? (
    bk = cfl[ch] & 8 ? 0x7800 : 0x7900;
    ri = vm_findprog(bk, prog);
    ri < 0 ? ri = vm_findprog(bk, 0);
    ri < 0 ? ri = 0;
  );
  cprog[ch] = prog;
  creg[ch] = ri;
  cfl[ch] |= 4;
);

function vm_resetctrls() local(c) (
  c = 0;
  loop(16,
    cpb[c] = 0x2000; cmod[c] = 0; cvol[c] = 100; cpan[c] = 64; cexp[c] = 127;
    crev[c] = 40; ccho[c] = 0; cprs[c] = 0; crpn[c] = 0x3FFF; cpbs[c] = 200;
    cfine[c] = 0; ccoarse[c] = 0; cfl[c] |= 4;
    c += 1;
  );
);

function vm_initchannels() local(c) (
  vm_resetctrls();
  c = 0;
  loop(16,
    cfl[c] = 0; csg[c] = 0; csp[c] = 0; cpool[c] = 0;
    c == 9 ? ( cbank[c] = 0x7800; cfl[c] |= 8; ) : cbank[c] = 0x7900;
    vm_progchange(c, 0);
    c += 1;
  );
);

function vm_rpn(ch, cc, val) (
  cc == 99 || cc == 98 ? crpn[ch] = 0x3FFF :
  cc == 101 ? crpn[ch] = (crpn[ch] & 0x7F) | (val * 128) :
  cc == 100 ? crpn[ch] = (crpn[ch] & 0x7F00) | val :
  cc == 6 ? (
    crpn[ch] == 0 ? cpbs[ch] = val * 100 :
    crpn[ch] == 1 ? cfine[ch] = floor(((val * 128 - 8192) * 100) / 8192) :
    crpn[ch] == 2 ? ccoarse[ch] = val - 64;
  );
);

function vm_cc(ch, cc, val) (
  cfl[ch] |= 4;
  cc == 0 ? cbank[ch] = val * 256 :
  cc == 1 ? cmod[ch] = val :
  cc == 7 ? cvol[ch] = val :
  cc == 10 ? cpan[ch] = val :
  cc == 11 ? cexp[ch] = val :
  cc == 32 ? cbank[ch] = (cbank[ch] & 0xFF00) | val :
  cc == 64 ? (
    val < 64 ? ( cfl[ch] & 1 ? vm_rel_deferred(ch); cfl[ch] &= 0xFE; ) :
    ( !(cfl[ch] & 1) ? vm_catch_sustain(ch); cfl[ch] |= 1; );
  ) :
  cc == 91 ? crev[ch] = val :
  cc == 93 ? ccho[ch] = val :
  cc == 121 ? (
    cmod[ch] = 0; cexp[ch] = 127; cfl[ch] &= 0xFE; cpb[ch] = 0x2000; cprs[ch] = 0;
    crpn[ch] = 0x3FFF; cpbs[ch] = 200; cfine[ch] = 0; ccoarse[ch] = 0;
  ) :
  cc == 6 || cc == 38 || cc == 98 || cc == 99 || cc == 100 || cc == 101 ? vm_rpn(ch, cc, val) :
  cc == 120 || cc >= 123 ? vm_allnotesoff(ch);
);

function vm_reset() local(i) (
  i = 0; loop(NV, vm_mute(i); i += 1; );
  snav == 0 ? (
    vm_initchannels();
    memset(pcnt, 0, 16);
    palloc[0] = vm_maxp & 255;
    sfl &= 0xFE;
  ) : sfl |= 1;
);

function vm_initmip() local(c) (
  sfl &= 0xFD;
  c = 0; loop(16, cpool[c] = 0; c += 1; );
);

function midi_msg(st, d1, d2) local(ch, t) (
  ch = st & 15; t = st & 0xF0;
  t == 0x90 ? ( d2 ? vm_startnote(ch, d1, d2) : vm_stopnote(ch, d1); ) :
  t == 0x80 ? vm_stopnote(ch, d1) :
  t == 0xB0 ? vm_cc(ch, d1, d2) :
  t == 0xC0 ? vm_progchange(ch, d1) :
  t == 0xD0 ? ( cprs[ch] = d1; cfl[ch] |= 4; ) :
  t == 0xE0 ? ( cpb[ch] = d2 * 128 + d1; cfl[ch] |= 4; );
);

RV_SIZE = 8192;
RVD = mk(RV_SIZE);
RV_AP0_IN = 0; RV_AP1_IN = 887; RV_D0_IN = 1774; RV_D1_IN = 4645;
RV_D0_OUT = 4639; RV_D1_OUT = 7510;
RVP = mk(4 * 9);
mem_set_values(RVP, 8307, 14768, 27690, 32767, 127, 6388, 15691, 711, 17999,
                    6461, 14307, 27690, 32767, 127, 6391, 15230, 708, 9692,
                    5077, 12922, 24460, 32767, 127, 6449, 15691, 774, 15691,
                    5077, 11076, 23075, 32767, 127, 6470, 14768, 792, 15783);

function rv_noise() (
  rv_noise_v = w16(rv_noise_v * 5 + 1);
  rv_maxexc & (rv_noise_v < 0 ? rv_noise_v + 65536 : rv_noise_v);
);

function rv_updroom() local(p) (
  p = RVP + rv_next * 9;
  rv_lpffbk = p[0]; rv_lpffwd = p[1]; rv_wet = p[2]; rv_dry = p[3]; rv_maxexc = p[4];
  rv_xfint = floor((p[5] * 44100) / 65536);
  rv_ap0g = p[6]; rv_ap0out = (RV_AP0_IN + floor((p[7] * 44100) / 65536)) & 65535;
  rv_ap1g = p[8]; rv_ap1out = (RV_AP1_IN + floor((1113 * 44100) / 65536)) & 65535;
  rv_cur = rv_next;
);

function rv_init() local(o) (
  memset(RVD, 0, RV_SIZE);
  rv_fbkr = rv_fbkl = 0;
  rv_ap0out = RV_AP0_IN + 749; rv_ap0g = 19400;
  rv_ap1out = RV_AP1_IN + 727; rv_ap1g = -19400;
  rv_lpf0 = rv_lpf1 = 0; rv_lpffwd = 8837; rv_lpffbk = 6494;
  rv_sin = rv_cos = rv_sininc = rv_cosinc = 0;
  rv_xfint = 4410; rv_xfcnt = rv_xfint + 1;
  rv_phase = -32768; rv_phinc = 3855;
  rv_noise_v = w16(0xABCD); rv_maxexc = 127;
  o = rv_noise(); rv_d1cross = RV_D1_OUT - rv_maxexc + o;
  o = rv_noise(); rv_d0cross = RV_D1_OUT - rv_maxexc - o;
  o = rv_noise(); rv_d0self = RV_D0_OUT - rv_maxexc - o;
  o = rv_noise(); rv_d1self = RV_D1_OUT - rv_maxexc + o;
  rv_bypass = 1; rv_next = 1; rv_base = 0;
  rv_elpf = 0; rv_erlpf = 0; rv_updcnt = 0;
  rv_updroom();
);

function rv_sincos(ph) local(na, t) (
  na = floor(ph / 2);
  na > 16384 ? na = 16384 : na < -16384 ? na = -16384;
  t = 32768 + m15(-27145, na); t = 23170 + m15(t, na);
  rv_tsin = t > 32767 ? 32767 : t < -32768 ? -32768 : t;
  t = -32768 + m15(-27145, na); t = 23170 + m15(t, na);
  rv_tcos = t > 32767 ? 32767 : t < -32768 ? -32768 : t;
);

function rv_xfade(n) local(o) (
  rv_xfcnt >= rv_xfint ? (
    rv_xfcnt = 0;
    rv_phinc > 0 ? (
      rv_sin = 32767; rv_cos = 0; rv_phase = 32767;
      o = rv_noise(); rv_d1cross = RV_D1_OUT - rv_maxexc + o;
      o = rv_noise(); rv_d0cross = RV_D0_OUT - rv_maxexc - o;
    ) : (
      rv_sin = 0; rv_cos = 32767; rv_phase = -32768;
      o = rv_noise(); rv_d0self = RV_D0_OUT - rv_maxexc - o;
      o = rv_noise(); rv_d1self = RV_D1_OUT - rv_maxexc + o;
    );
    rv_phinc = -rv_phinc;
  );
  rv_phase = max(-32768, min(32767, rv_phase + rv_phinc));
  rv_sincos(rv_phase);
  rv_sininc = floor((rv_tsin - rv_sin) / 256);
  rv_cosinc = floor((rv_tcos - rv_cos) / 256);
  rv_xfcnt = (rv_xfcnt + n) & 65535;
);

function rv_process(b) local(i, base, inL, inR, apin, d, t1, t2, apout, t, M) (
  !(rv_bypass || (rv_wet == 0 && rv_dry == 32767)) ? (
    rv_next != rv_cur ? rv_updroom();
    rv_xfade(FRAME);
    M = RV_SIZE - 1;
    base = rv_base; i = 0;
    loop(FRAME,
      inL = b[2 * i]; inR = b[2 * i + 1];
      apin = floor(inL / 4) + rv_fbkr;
      d = RVD[(base + rv_ap0out) & M];
      t1 = m15(apin, rv_ap0g);
      apout = sat16(d - t1);
      t1 = m15(apout, rv_ap0g);
      RVD[(base + RV_AP0_IN) & M] = sat16(apin + t1);
      RVD[(base + RV_D0_IN) & M] = apout;
      apin = floor(inR / 4) + rv_fbkl;
      d = RVD[(base + rv_ap1out) & M];
      t1 = m15(apin, rv_ap1g);
      apout = sat16(d - t1);
      t1 = m15(apout, rv_ap1g);
      RVD[(base + RV_AP1_IN) & M] = sat16(apin + t1);
      RVD[(base + RV_D1_IN) & M] = apout;
      t1 = m15(RVD[(base + rv_d0self) & M], rv_sin);
      t2 = m15(RVD[(base + rv_d1cross) & M], rv_cos);
      d = sat16(t1 + t2);
      rv_lpf0 = sat16(m15(d, rv_lpffwd) + m15(rv_lpf0, rv_lpffbk));
      t1 = m15(RVD[(base + rv_d1self) & M], rv_sin);
      t2 = m15(RVD[(base + rv_d0cross) & M], rv_cos);
      d = sat16(t1 + t2);
      rv_lpf1 = sat16(m15(d, rv_lpffwd) + m15(rv_lpf1, rv_lpffbk));
      rv_fbkl = sat16(rv_lpf1 + rv_lpf0);
      rv_fbkr = sat16(rv_lpf1 - rv_lpf0);
      rv_elpf = sat16(m15(rv_elpf, 4915));
      t = sat16(rv_elpf + rv_fbkl);
      t = m15(t, rv_wet * 2);
      b[2 * i] = sat16(t + inL);
      rv_erlpf = sat16(m15(rv_erlpf, 4915));
      t = sat16(rv_erlpf + rv_fbkr);
      t = m15(t, rv_wet * 2);
      b[2 * i + 1] = sat16(t + inR);
      base = (base - 1) & 65535;
      rv_sin = w16(rv_sin + rv_sininc);
      rv_cos = w16(rv_cos + rv_cosinc);
      i += 1;
    );
    rv_base = base;
    rv_updcnt >= 255 ? rv_updcnt = 0;
    rv_updcnt += FRAME;
