    1608, 0, -1608, -3212, -4808, -6393, -7962, -9512, -11309, -12539, -14010, -15446, -16846, -18204, -19519,
    -20787, -22005, -23170, -24279, -25329, -26319, -27245, -28105, -28898, -29621, -30273, -30852, -31356, -31785,
    -32137, -32412, -32609, -32728, -32767, -32728, -32609, -32412, -32137, -31785, -31356, -30852, -30273, -29621,
    -28898, -28105, -27245, -26319, -25329, -24279, -23170, -22005, -20787, -19519, -18204, -16846, -15446, -14010,
    -12539, -11039, -9512, -7962, -6393, -4808, -3212, -1608);
CHP = mk(16);
mem_set_values(CHP, 39, 30, 32767, 32767, 21, 45, 25000, 32767, 53, 25, 32000, 32767, 32, 37, 29000, 32767);

function ch_update() local(p) (
  p = CHP + ch_next * 4;
  ch_level = p[2]; ch_rate = p[1]; ch_depth = p[0]; ch_dry = p[3];
  ch_rate = w16(floor(8388608 / 882000) * ch_rate);
  ch_depth = w16(floor((floor((ch_depth * 44100) / 32) * 105) / 65536));
  ch_cur = ch_next;
);

function ch_init() (
  memset(CHL, 0, CH_SIZE); memset(CHR, 0, CH_SIZE);
  ch_bypass = 1; ch_next = 0;
  ch_il = ch_ir = 0; ch_lpl = 0; ch_lpr = 32 * 65536;
  ch_tap = 441;
  ch_update();
);

function ch_wtap(arr, ref, want, lim) local(idx, fr, v1, v2) (
  idx = floor(want / 65536);
  idx = w16(idx);
  fr = floor(want / 2) & 0x7FFF;
  idx = w16(ref - idx);
  while (idx < 0) ( idx = w16(idx + lim); );
  v1 = arr[idx];
  v2 = idx == 0 ? arr[lim - 1] : arr[idx - 1];
  w16(v1 + w16(m15(v2 - v1, fr)));
);

function ch_process(b) local(i, x, lfo, pos, tap, o) (
  !(ch_bypass || ch_level == 0) ? (
    ch_next != ch_cur ? ch_update();
    i = 0;
    loop(FRAME,
      x = b[2 * i];
      CHL[ch_il] = x;
      lfo = ch_wtap(CHS, 0, ch_lpl, 128);
      pos = ch_depth * (lfo * 2) + ch_tap * 65536;
      tap = ch_wtap(CHL, ch_il, pos, CH_SIZE);
      x = m15(x, ch_dry);
      o = sat16(m15(tap, ch_level) + x);
      b[2 * i] = o;
      (ch_il += 1) >= CH_SIZE ? ch_il = 0;
      ch_lpl += ch_rate;
      while (ch_lpl >= 128 * 65536) ( ch_lpl -= 128 * 65536; );
      i += 1;
    );
    i = 0;
    loop(FRAME,
      x = b[2 * i + 1];
      CHR[ch_ir] = x;
      lfo = ch_wtap(CHS, 0, ch_lpr, 128);
      pos = ch_depth * (lfo * 2) + ch_tap * 65536;
      tap = ch_wtap(CHR, ch_ir, pos, CH_SIZE);
      x = m15(x, ch_dry);
      o = sat16(m15(tap, ch_level) + x);
      b[2 * i + 1] = o;
      (ch_ir += 1) >= CH_SIZE ? ch_ir = 0;
      ch_lpr += ch_rate;
      while (ch_lpr >= 128 * 65536) ( ch_lpr -= 128 * 65536; );
      i += 1;
    );
  );
);

function ch_setpreset(p) ( ch_next = p; ch_update(); );

function eas_setvolume(vol) local(c) (
  c = tdiv(tdiv((vol - 100) * 1200, 20) * 108852, 32768);
  master_gain = vol <= 0 ? 0 : calc2x(c);
);

function fx_rv_cc(on) (
  on && !rv_cc ? (
    rv_cc = 1; rv_bypass = 0; rv_setpreset(1); rv_dry = 0;
  ) : !on && rv_cc ? (
    rv_cc = 0; rv_setpreset(1);
  );
);
function fx_ch_cc(on) (
  on && !ch_cc ? (
    ch_cc = 1; ch_bypass = 0; ch_setpreset(0); ch_dry = 0;
  ) : !on && ch_cc ? (
    ch_cc = 0; ch_setpreset(0);
  );
);

function eas_init() local(i) (
  vm_act = 0; vm_age = 0; vm_maxp = NV;
  i = 0; loop(NV, init_voice(i);
    wart[i] = 0; e1s[i] = 2; e1v[i] = 0; e1i[i] = 0; e2s[i] = 2; e2v[i] = 0; e2i[i] = 0;
    wgl[i] = wgr[i] = 0; wpf[i] = 0; wpa[i] = 0; wfx1[i] = wfx2[i] = wfy1[i] = wfy2[i] = 0;
    i += 1; );
  memset(VB, 0, FRAME);
  rv_init(); ch_init();
  rv_cc = 0; ch_cc = 0;
  fx_ch_cc(1); fx_rv_cc(1);
  sfl = 4; smv = 0x7fff; sprio = 5; snav = 0; gtr = 0;
  memset(pcnt, 0, 16); memset(palloc, 0, 16); palloc[0] = vm_maxp & 255;
  vm_initchannels();
  eas_setvolume(100);
);

function eas_render() local(v, ch, done, i, lvl, rp, cp, s) (
  sfl & 4 ? (
    ch = 0; loop(16, wt_updch(ch); ch += 1; );
    sfl &= 0xFB;
  ) : (
    ch = 0; loop(16, cfl[ch] & 4 ? wt_updch(ch); ch += 1; );
  );
  memset(MIX, 0, 2 * FRAME);
  memset(CSND, 0, 2 * FRAME); memset(RSND, 0, 2 * FRAME);
  rp = cp = 0;
  v = 0;
  loop(NV,
    ch = vch[v] & 15;
    vst[v] == 5 && vgn[v] <= 0 ? vm_retarget(v);
    vst[v] != 0 ? (
      done = wt_update(v);
      i = 0;
      loop(2 * FRAME, MIX[i] += SB[i]; i += 1; );
      lvl = crev[ch];
      lvl != 0 ? (
        i = 0; loop(2 * FRAME, RSND[i] = w16(RSND[i] + tdiv(SB[i] * lvl, 128)); i += 1; );
        rp = 1;
      );
      lvl = ccho[ch];
      lvl != 0 ? (
        i = 0; loop(2 * FRAME, CSND[i] = w16(CSND[i] + tdiv(SB[i] * lvl, 128)); i += 1; );
        cp = 1;
      );
      done ? ( vst[v] == 5 ? vgn[v] = 0 : vm_free(v); );
      vfl[v] & 0x40 ? ( vfl[v] &= 0xBB; vm_mute(v); );
      vst[v] == 1 ? vst[v] = 2;
    );
    v += 1;
  );
  cp && ch_cc ? ( ch_process(CSND); i = 0; loop(2 * FRAME, MIX[i] += CSND[i]; i += 1; ); );
  rp && rv_cc ? ( rv_process(RSND); i = 0; loop(2 * FRAME, MIX[i] += RSND[i]; i += 1; ); );
  sfl & 8 ? vm_deferred_stop();
  (sfl & 1) && snav == 0 ? (
    vm_initchannels();
    i = 0; loop(NV, init_voice(i); i += 1; );
    sfl &= 0xFE;
  );
  ch = 0; loop(16, cfl[ch] &= 0xFB; ch += 1; );
  i = 0;
  loop(2 * FRAME,
    s = floor(w32(MIX[i] * master_gain) / 32768);
    OUTB[i] = sat16(s);
    i += 1;
  );
  !rv_cc ? rv_process(OUTB);
  !ch_cc ? ch_process(OUTB);
);

function vm_setpoly(n) local(i, act, best, bp, cp) (
  n < 1 ? n = 1;
  n > NV ? n = NV;
  n != vm_maxp ? (
    vm_maxp = n;
    palloc[0] = n & 255;
    vm_act > n ? (
      act = 0; i = 0; loop(NV, vst[i] != 0 && vst[i] != 4 ? act += 1; i += 1; );
      while (act > n) (
        bp = -1; best = -1;
        i = 0;
        loop(NV,
          vst[i] != 0 && vst[i] != 4 ? (
            vst[i] == 5 || (vfl[i] & 8) ? cp = 128 - vnv[i] + cpool[vnc[i] & 15] * 4 :
              cp = vag[i] * 2 + 384 - floor(vgn[i] / 256) + cpool[vch[i] & 15] * 4;
            cp += sprio * 256;
            cp > bp ? ( bp = cp; best = i; );
          );
          i += 1;
        );
        best < 0 ? act = 0 : ( vm_mute(best); act -= 1; );
      );
    );
  );
);

function eas_setparam(mod, par, val) (
  mod == 2 ? (
    par == 4 ? fx_rv_cc(!val) :
    par == 0 ? rv_bypass = val :
    par == 1 ? ( val >= 0 && val <= 3 ? rv_setpreset(val); ) :
    par == 2 ? rv_wet = val :
    par == 3 ? rv_dry = val;
  ) : mod == 3 ? (
    par == 6 ? fx_ch_cc(!val) :
    par == 0 ? ch_bypass = val :
    par == 1 ? ( val >= 0 && val <= 3 ? ch_setpreset(val); ) :
    par == 2 ? ch_rate = val :
    par == 3 ? ch_depth = val :
    par == 4 ? ch_level = val :
    par == 5 ? ch_dry = val;
  );
);

function eas_sysex(buf, len) local(g) (
  len >= 6 && buf[1] == 0x7E && buf[2] == 0x7F && buf[3] == 0x09 && (buf[4] == 1 || buf[4] == 3) ? (
    vm_reset(); vm_initmip();
  ) : len >= 8 && buf[1] == 0x7F && buf[2] == 0x7F && buf[3] == 0x04 && buf[4] == 0x01 ? (
    g = buf[6] * 256 + buf[5] * 2;
    smv = floor((g * g) / 32768); sfl |= 4;
  );
);

