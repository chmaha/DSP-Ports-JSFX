options:no_meter

in_pin:none
out_pin:Left
out_pin:Right

@init
ext_noinit = 1;
gfx_ext_retina = 1;
last_srate = 0;

// ------------------------------------------------------------- integer helpers

function s8(x) ( x = x & 255; x >= 128 ? x - 256 : x; );
function s16(x) ( x = x & 65535; x >= 32768 ? x - 65536 : x; );
function asr(x, n) ( floor(x / (1 << n)); );
function swap4(x) ( ((x & 15) << 4) | ((x >> 4) & 15); );
function clipu14(v) local(m) ( m = (v & 65535) >> 8; m & 128 ? 0 : (m & 64 ? 16383 : v); );
function mix3(a, b, bal) ( (a * (255 - bal) + b * bal) >> 8; );
function mix4(a, b, ga, gb) ( ((a * ga + b * gb) & 65535) >> 8; );
function interp(t, ph) local(i, f) ( i = ph >> 8; f = ph & 255; (t[i] * (255 - f) + t[i + 1] * f) >> 8; );

// ------------------------------------------------------------- memory

function shr_alloc(n) local(r) ( r = shr_top; shr_top += n; r; );

function shr_mem_init() (
  TOFF = shr_alloc(96);
  TLEN = shr_alloc(96);
  P = shr_alloc(160);
  SQ = P + 100;
  SY = P + 142;
  SRC = shr_alloc(40);
  MDST = shr_alloc(32);
  DST = shr_alloc(32);
  BUF = shr_alloc(48);
  BUF2 = shr_alloc(48);
  SYNCS = shr_alloc(48);
  NOSYNC = shr_alloc(48);
  DUMMY = shr_alloc(48);
  OUTB = shr_alloc(48);
  USERWT = shr_alloc(1040);
  ESPI = shr_alloc(10);
  ETGT = shr_alloc(10);
  EST = shr_alloc(2); EA = shr_alloc(2); EB = shr_alloc(2);
  EPI = shr_alloc(2); EPH = shr_alloc(2); EVAL = shr_alloc(2);
  DISAUTO = shr_alloc(2);
  LPI = shr_alloc(2); LPP = shr_alloc(2); LII = shr_alloc(2); LIN = shr_alloc(2);
  LPH = shr_alloc(2); LSH = shr_alloc(2); LRM = shr_alloc(2); LCC = shr_alloc(2);
  LRUN = shr_alloc(2); LVAL = shr_alloc(2); LOSV = shr_alloc(2);
  OPH = shr_alloc(2); OPI = shr_alloc(2); OSHP = shr_alloc(2); OPAR = shr_alloc(2);
  OSEC = shr_alloc(2); ONOTE = shr_alloc(2);
  OD = shr_alloc(48);
  PREVFM = shr_alloc(2); LSTEP = shr_alloc(2); LLIM = shr_alloc(2); LINC = shr_alloc(2);
  OPS = shr_alloc(8);
  NSP = shr_alloc(3 * 32);
  NSS = shr_alloc(3 * 16);
);

// ------------------------------------------------------------- tables

function shr_tables_load(path1, path2) local(h, n, nt, i, pp, q, len) (
  TRAW = shr_alloc(40000);
  TBL = shr_alloc(40000);
  h = file_open(path1);
  h < 0 ? h = file_open(path2);
  shr_tables_ok = 0;
  h >= 0 ? (
    n = file_mem(h, TRAW, 40000);
    file_close(h);
    nt = TRAW[0];
    (n > 1000 && nt == 90) ? (
      q = 1; pp = 0; i = 0;
      loop(nt,
        len = TRAW[q];
        TOFF[i] = TBL + pp;
        TLEN[i] = len;
        memcpy(TBL + pp, TRAW + q + 1, len);
        pp += len;
        q += len + 1;
        i += 1;
      );
      shr_tables_ok = q == n;
    );
  );
  T_LFOINC = TOFF[0]; T_ENVINC = TOFF[1]; T_OSCINC = TOFF[2]; T_FMRAT = TOFF[3];
  T_ARP = TOFF[36];
  T_FSIN = TOFF[43 + 0]; T_FSQR = TOFF[43 + 1]; T_SINE = TOFF[43 + 2];
  T_VOWEL = TOFF[43 + 24]; T_DIST = TOFF[43 + 25]; T_EXPO = TOFF[43 + 26];
  T_WAVES = TOFF[43 + 28]; T_WTDEF = TOFF[43 + 29];
  T_TRI0 = TOFF[43 + 17];
  T_TEMPO = TOFF[74];
);

function wav(id) ( TOFF[43 + id]; );

// ------------------------------------------------------------- random

function rnd_update() ( rng = (rng >> 1) ~ ((rng & 1) ? 46080 : 0); );
function rnd_byte() ( rnd_update(); rng >> 8; );

// ------------------------------------------------------------- envelope

function env_init(e) (
  ETGT[e * 5 + 0] = 255; ETGT[e * 5 + 3] = 0; ETGT[e * 5 + 4] = 0;
  ESPI[e * 5 + 2] = 0; ESPI[e * 5 + 4] = 0;
);
function env_trigger(e, st) (
  st == 4 ? EVAL[e] = 0;
  EA[e] = EVAL[e] >> 8;
  EB[e] = ETGT[e * 5 + st];
  EST[e] = st;
  EPH[e] = 0;
  EPI[e] = ESPI[e * 5 + st];
);
function env_update(e, a, d, s, r) (
  ESPI[e * 5 + 0] = T_ENVINC[a];
  ESPI[e * 5 + 1] = T_ENVINC[d];
  ESPI[e * 5 + 3] = T_ENVINC[r];
  ETGT[e * 5 + 1] = (s << 1) & 255;
  ETGT[e * 5 + 2] = ETGT[e * 5 + 1];
);
function env_render(e) local(ph, pi, step) (
  pi = EPI[e];
  ph = (EPH[e] + pi) & 65535;
  EPH[e] = ph;
  ph < pi ? (
    EVAL[e] = EB[e] * 255;
    env_trigger(e, (EST[e] + 1) & 255);
  );
  EPI[e] ? (
    step = interp(T_EXPO, EPH[e]);
    EVAL[e] = (EA[e] * (255 - step) + EB[e] * step) & 65535;
  );
  EST[e] == 2 ? ETGT[e * 5 + 1] : EVAL[e] >> 8;
);

// ------------------------------------------------------------- lfo

function lfo_render(l) local(i, v, ph, pts, so) (
  i = LIN[l];
  ((i >> 8) & 255) != 63 ? (
    i = (i + LII[l]) & 65535;
    ((i >> 8) & 255) >= 64 ? i = 16383;
    LIN[l] = i;
  );
  ph = LPH[l];
  LCC[l] = ph < LPI[l];
  LSH[l] == 3 ? (
    v = ph >> 8;
  ) : LSH[l] == 2 ? (
    LCC[l] ? LVAL[l] = rnd_byte();
    v = LVAL[l];
  ) : LSH[l] == 0 ? (
    v = (ph & 32768) ? (ph >> 7) & 255 : 255 - ((ph >> 7) & 255);
  ) : LSH[l] == 1 ? (
    v = (ph & 32768) ? 255 : 0;
  ) : LSH[l] == 4 ? (
    pts = ph >> 8;
    pts = (pts * SQ[8]) >> 8;
    v = ((SQ[11 + pts * 2] & 15) << 4) & 255;
  ) : (
    so = (LSH[l] - 5) & 255;
    so == 0 ? (so = 3) : (so = (so + 16) & 255);
    v = T_WAVES[so * 129 + (ph >> 9)];
  );
  ph = (ph + LPI[l]) & 65535;
  LPH[l] = ph;
  LRM[l] == 3 ? (
    LRUN[l] ? (
      ph < LPI[l] ? (
        LRUN[l] = 0;
        (LSH[l] == 3 || LSH[l] == 0 || LSH[l] == 1) ? (v = 255) : (LSH[l] == 4 ? v = 0);
        LOSV[l] = v;
      );
    ) : (
      v = LOSV[l];
    );
    v = LSH[l] == 4 ? 128 + (v >> 1) : 255 - (v >> 1);
  );
  (s8(floor((v - 128) * ((LIN[l] >> 6) & 255) / 256)) + 128) & 255;
);
function lfo_set_target_phase(l, step, inc) local(phi, de, pe, err, ni) (
  phi = LPH[l];
  de = s16(inc - ((phi - LPP[l]) & 65535));
  pe = s16(step * inc - phi);
  err = de + pe;
  ni = LPI[l] + asr(err, 8);
  ni < 6 ? (ni = 6) : (ni > 1040 ? ni = 1040);
  LPI[l] = ni;
  LPP[l] = phi;
);
function lfo_reset_phase(l) ( LPH[l] = 0; LCC[l] = 1; LRUN[l] = 1; );
function lfo_trigger(l) ( LRM[l] ? lfo_reset_phase(l); LIN[l] = 0; );
function lfo_reset(l) ( lfo_reset_phase(l); lfo_trigger(l); );
function lfo_update(l, shape, pinc, attack, rm) (
  LSH[l] = shape;
  pinc ? LPI[l] = pinc;
  LII[l] = T_ENVINC[attack] >> 1;
  LRM[l] = rm;
);

// ------------------------------------------------------------- oscillator union bytes

function od8(o, k) ( OD[o * 24 + k]; );
function od16(o, k) ( OD[o * 24 + k] | (OD[o * 24 + k + 1] << 8); );
function wd8(o, k, v) ( OD[o * 24 + k] = v & 255; );
function wd16(o, k, v) ( OD[o * 24 + k] = v & 255; OD[o * 24 + k + 1] = (v >> 8) & 255; );

function osc_reset(o) ( wd16(o, 3, rnd_byte() + 1); );

// ------------------------------------------------------------- oscillator renderers

function osc_silence(o, out) ( memset(out, 128, 40); );

function osc_pwm(o, out, si, so) local(bi, g1, g2, wi, w1, w2, shift, scale, nt, prm, pinc, ph, k, a, b, pi16, n) (
  nt = ONOTE[o]; prm = OPAR[o];
  bi = swap4((nt - 12) & 255);
  g2 = bi & 240; g1 = 255 - g2;
  wi = bi & 15;
  w1 = wav(11 + wi);
  wi = min(wi + 1, 5);
  w2 = wav(11 + wi);
  shift = ((prm + 128) << 8) & 65535;
  scale = (192 - (prm >> 1)) & 255;
  nt > 64 ? (
    scale = mix3(scale, 102, ((nt - 64) << 2) & 255);
    scale = mix3(scale, 102, ((nt - 64) << 2) & 255);
  );
  OPI[o] = (OPI[o] << 1) & 16777215;
  pinc = OPI[o];
  ph = OPH[o];
  k = 0;
  loop(20,
    ph += pinc;
    so[k] = ph >= 16777216;
    ph &= 16777215;
    so[k + 1] = 0;
    (si[k] || si[k + 1]) ? ph = 0;
    pi16 = ph >> 8;
    a = mix4(interp(w1, pi16), interp(w2, pi16), g1, g2);
    a = (a * scale) >> 8;
    n = (pi16 + shift) & 65535;
    b = mix4(interp(w1, n), interp(w2, n), g1, g2);
    b = (b * scale) >> 8;
    a = (a - b + 128) & 255;
    out[k] = a; out[k + 1] = a;
    k += 2;
  );
  OPH[o] = ph;
);

function osc_simple(o, out, si, so) local(bi, g1, g2, wi, base, w1, w2, prm, shp, pinc, ph, k, s, pi16) (
  prm = OPAR[o]; shp = OSHP[o];
  bi = swap4((ONOTE[o] - 12) & 255);
  g2 = bi & 240; g1 = 255 - g2;
  wi = bi & 15;
  base = shp == 1 ? 10 : (shp == 2 ? 3 : 17);
  w1 = wav(base + wi);
  wi = min(wi + 1, 6);
  w2 = wav(base + wi);
  pinc = OPI[o]; ph = OPH[o];
  k = 0;
  loop(40,
    si[k] ? ph = 0;
    ph += pinc;
    so[k] = ph >= 16777216;
    ph &= 16777215;
    pi16 = ph >> 8;
    s = mix4(interp(w1, pi16), interp(w2, pi16), g1, g2);
    s < prm ? (
      shp == 1 ? (s = (s + (prm >> 1)) & 255) : (s = prm);
    );
    out[k] = s;
    k += 1;
  );
  OPH[o] = ph;
);

function osc_wavetable(o, out, si, so) local(shp, idx, def, ns, ptr, i1, i2, g, w1, w2, pinc, ph, k, q) (
  shp = OSHP[o];
  idx = shp >= 25 ? shp - 25 + 8 : shp - 11;
  def = T_WTDEF + idx * 18;
  ns = def[0];
  ptr = ((OPAR[o] << 1) & 255) * ns;
  i1 = def[1 + (ptr >> 8)];
  i2 = def[2 + (ptr >> 8)];
  g = ptr & 255;
  w1 = T_WAVES + i1 * 129;
  w2 = T_WAVES + i2 * 129;
  pinc = OPI[o]; ph = OPH[o];
  k = 0;
  loop(40,
    si[k] ? ph = 0;
    ph += pinc;
    so[k] = ph >= 16777216;
    ph &= 16777215;
    q = (ph >> 8) >> 1;
    out[k] = mix4(interp(w1, q), interp(w2, q), 255 - g, g);
    k += 1;
  );
  OPH[o] = ph;
);

function osc_sweep_ram(o, out, si, so) local(bi, wi, g1, g2, off, w1, w2, pinc, ph, k, q) (
  bi = swap4(OPAR[o]);
  wi = bi & 15;
  g2 = bi & 240; g1 = 255 - g2;
  off = (wi << 7) + wi;
  w1 = USERWT + off;
  w2 = w1;
  off < 1032 - 129 ? w2 += 129;
  pinc = OPI[o]; ph = OPH[o];
  k = 0;
  loop(40,
    si[k] ? ph = 0;
    ph += pinc;
    so[k] = ph >= 16777216;
    ph &= 16777215;
    q = (ph >> 8) >> 1;
    out[k] = mix4(interp(w1, q), interp(w2, q), g1, g2);
    k += 1;
  );
  OPH[o] = ph;
);

function osc_czsaw(o, out, si, so) local(bal, pinc, ph, k, phi, cl) (
  bal = (OPAR[o] << 1) & 255;
  pinc = OPI[o]; ph = OPH[o];
  k = 0;
  loop(40,
    si[k] ? ph = 0;
    ph += pinc;
    so[k] = ph >= 16777216;
    ph &= 16777215;
    phi = ph >> 16;
    cl = phi < 32 ? (phi << 3) & 255 : 255;
    out[k] = T_SINE[((phi * (255 - bal) + cl * bal) & 65535) >> 8];
    k += 1;
  );
  OPH[o] = ph;
);

function osc_czpulse(o, out, si, so) local(pint, inc, p2, pinc, ph, k, c, r, pi16) (
  pint = OPI[o] >> 8;
  inc = ((pint + ((pint * OPAR[o]) >> 3)) << 1) & 65535;
  p2 = od16(o, 0);
  pinc = OPI[o]; ph = OPH[o];
  k = 0;
  loop(40,
    si[k] ? ph = 0;
    ph += pinc;
    c = ph >= 16777216;
    so[k] = c;
    ph &= 16777215;
    c ? p2 = 32768;
    p2 = (p2 + inc) & 65535;
    r = T_SINE[p2 >> 8];
    r = ((r >> 1) + 128) & 255;
    pi16 = ph >> 8;
    pi16 < 16384 ? (
      out[k] = r;
    ) : pi16 < 32768 ? (
      out[k] = (r * ((((65535 - ((pi16 - 16384) & 65535))) >> 6) & 255)) >> 8;
    ) : (
      out[k] = 0;
    );
    k += 1;
  );
  OPH[o] = ph;
  wd16(o, 0, p2);
);

function osc_czreso(o, out, si, so) local(pint, inc, p2, pinc, ph, k, c, car, win, shp, pi16) (
  shp = OSHP[o];
  pint = OPI[o] >> 8;
  inc = (pint + ((pint * OPAR[o]) >> 3)) & 65535;
  p2 = od16(o, 0);
  pinc = OPI[o]; ph = OPH[o];
  k = 0;
  loop(40,
    si[k] ? ph = 0;
    ph += pinc;
    c = ph >= 16777216;
    so[k] = c;
    ph &= 16777215;
    c ? p2 = 0;
    p2 = (p2 + inc) & 65535;
    car = interp(T_SINE, p2);
    pi16 = ph >> 8;
    shp == 8 ? (
      out[k] = pi16 < 32768 ? car : 128;
    ) : (
      shp == 5 ? (
        win = 255 - (pi16 >> 8);
      ) : (
        win = (pi16 & 32768) ? 255 - ((pi16 >> 7) & 255) : (pi16 >> 7) & 255;
      );
      out[k] = (car * win) >> 8;
    );
    k += 1;
  );
  OPH[o] = ph;
  wd16(o, 0, p2);
);

function osc_fm(o, out, si, so) local(off, mul, inc, prm, p2, pinc, ph, k, md, mo) (
  off = OSEC[o];
  off < 12 ? (off = 0) : (off > 36 ? (off = 24) : (off = off - 12));
  mul = T_FMRAT[off];
  inc = (((OPI[o] >> 8) * mul) >> 8) & 65535;
  OPAR[o] = (OPAR[o] << 1) & 255;
  prm = OPAR[o];
  OPH[o] = OPH[o] & 16776960;
  p2 = od16(o, 0);
  pinc = OPI[o]; ph = OPH[o];
  k = 0;
  loop(40,
    si[k] ? ph = 0;
    ph += pinc;
    so[k] = ph >= 16777216;
    ph &= 16777215;
    p2 = (p2 + inc) & 65535;
    md = interp(T_SINE, p2);
    mo = (md * prm) & 65535;
    out[k] = interp(T_SINE, ((ph >> 8) + mo) & 65535);
    k += 1;
  );
  OPH[o] = ph;
  wd16(o, 0, p2);
);

function osc_8bit(o, out, si, so) local(x, nx, pinc, ph, k) (
  x = OPAR[o]; nx = 255 - x;
  pinc = OPI[o]; ph = OPH[o];
  k = 0;
  loop(40,
    si[k] ? ph = 0;
    ph += pinc;
    so[k] = ph >= 16777216;
    ph &= 16777215;
    out[k] = ((((ph >> 16) ~ (x << 1)) & nx) + (x >> 1)) & 255;
    k += 1;
  );
  OPH[o] = ph;
);

function osc_crushed(o, out, si, so) local(dec, held, prm, pinc, ph, k) (
  dec = od8(o, 0); held = od8(o, 1);
  prm = OPAR[o];
  pinc = OPI[o]; ph = OPH[o];
  k = 0;
  loop(40,
    si[k] ? ph = 0;
    ph += pinc;
    so[k] = ph >= 16777216;
    ph &= 16777215;
    dec = (dec + 1) & 255;
    prm <= 63 ? (
      dec >= prm + 1 ? (dec = 0; held = interp(T_SINE, ph >> 8););
    ) : (
      dec >= 128 - prm ? (dec = 0; held = interp(T_TRI0, ph >> 8););
    );
    out[k] = held;
    k += 1;
  );
  OPH[o] = ph;
  wd8(o, 0, dec); wd8(o, 1, held);
);

function osc_vowel(o, out) local(prm, o1, o2, bal, i, a, b, pint, ph, k, res, fp, idx, pn, x, pinc16) (
  wd8(o, 16, (od8(o, 16) + 1) & 3);
  od8(o, 16) == 0 ? (
    prm = OPAR[o];
    o1 = ((prm >> 4) * 7) & 255;
    o2 = (o1 + 7) & 255;
    bal = prm & 15;
    i = 0;
    loop(3,
      a = T_VOWEL[o1 + i]; b = T_VOWEL[o2 + i];
      wd16(o, i * 2, ((a * (15 - bal) + b * bal) << 3) & 65535);
      i += 1;
    );
    i = 0;
    loop(4,
      b = T_VOWEL[o2 + 3 + i];
      wd8(o, 12 + i, ((b * 15) >> 4) & 255);
      i += 1;
    );
  );
  ph = OPH[o];
  pint = ph >> 8;
  pinc16 = OPI[o] >> 8;
  k = 0;
  loop(20,
    res = 0;
    i = 0;
    loop(3,
      fp = (od16(o, 6 + i * 2) + od16(o, i * 2)) & 65535;
      wd16(o, 6 + i * 2, fp);
      idx = ((fp >> 8) & 240) | od8(o, 12 + i);
      res = s8(res + (i == 2 ? T_FSQR[idx] : T_FSIN[idx]));
      i += 1;
    );
    res = s8(floor(res * (255 - (pint >> 8)) / 256));
    pint = (pint + pinc16) & 65535;
    pn = s8(rng >> 8) * s8(od8(o, 15));
    ((pint + pn) & 65535) < pinc16 ? (
      wd16(o, 6, 0); wd16(o, 8, 0); wd16(o, 10, 0);
    );
    x = max(0, min(255, 4 * res + 128));
    out[k] = x; out[k + 1] = x;
    k += 2;
  );
  OPH[o] = (pint << 8) | (ph & 255);
);

function osc_dirty(o, out, si, so) local(th, pinc, ph, k) (
  th = 127 + OPAR[o];
  pinc = OPI[o]; ph = OPH[o];
  k = 0;
  loop(40,
    si[k] ? ph = 0;
    ph += pinc;
    so[k] = ph >= 16777216;
    ph &= 16777215;
    out[k] = (ph >> 16) < th ? 0 : 255;
    k += 1;
  );
  OPH[o] = ph;
);

function osc_quadsaw(o, out, si, so) local(pint, sp, inc, i0, i1, i2, q0, q1, q2, pinc, ph, k) (
  pint = OPI[o] >> 8;
  sp = ((pint * OPAR[o]) >> 13) & 65535;
  sp = (sp + 1) & 65535;
  inc = pint;
  inc = (inc + sp) & 65535; i0 = inc;
  inc = (inc + sp) & 65535; i1 = inc;
  inc = (inc + sp) & 65535; i2 = inc;
  q0 = od16(o, 0); q1 = od16(o, 2); q2 = od16(o, 4);
  pinc = OPI[o]; ph = OPH[o];
  k = 0;
  loop(40,
    si[k] ? ph = 0;
    ph += pinc;
    so[k] = ph >= 16777216;
    ph &= 16777215;
    q0 = (q0 + i0) & 65535; q1 = (q1 + i1) & 65535; q2 = (q2 + i2) & 65535;
    out[k] = ((ph >> 18) + (q0 >> 10) + (q1 >> 10) + (q2 >> 10)) & 255;
    k += 1;
  );
  OPH[o] = ph;
  wd16(o, 0, q0); wd16(o, 2, q1); wd16(o, 4, q2);
);

function osc_noise(o, out, si) local(rs, fc, prm, lp, k, ns) (
  rs = od16(o, 1);
  rs == 0 ? rs = 1;
  prm = OPAR[o];
  fc = (prm << 2) & 255;
  fc <= 4 ? fc = 4;
  lp = od8(o, 0);
  k = 0;
  loop(40,
    si[k] ? rs = od16(o, 3);
    rs = (rs >> 1) ~ ((rs & 1) ? 46080 : 0);
    ns = rs >> 8;
    lp = mix3(lp, ns, fc);
    out[k] = prm >= 64 ? (ns - lp - 128) & 255 : lp;
    k += 1;
  );
  wd8(o, 0, lp);
  wd16(o, 1, rs);
);

function osc_render(o, shape, note, inc, si, so, out) local(ix) (
  OSHP[o] = shape;
  ONOTE[o] = note;
  OPI[o] = inc;
  shape == 2 ? (
    OPAR[o] == 0 ? osc_simple(o, out, si, so) : osc_pwm(o, out, si, so);
  ) : (
    ix = shape > 24 ? 11 : shape;
    ix == 0 ? osc_silence(o, out) :
    ix == 1 || ix == 3 ? osc_simple(o, out, si, so) :
    ix == 4 ? osc_czsaw(o, out, si, so) :
    ix == 5 || ix == 6 || ix == 8 ? osc_czreso(o, out, si, so) :
    ix == 7 ? osc_czpulse(o, out, si, so) :
    ix == 9 ? osc_quadsaw(o, out, si, so) :
    ix == 10 ? osc_fm(o, out, si, so) :
    ix >= 11 && ix <= 18 ? osc_wavetable(o, out, si, so) :
    ix == 19 ? osc_sweep_ram(o, out, si, so) :
    ix == 20 ? osc_8bit(o, out, si, so) :
    ix == 21 ? osc_crushed(o, out, si, so) :
    ix == 22 ? osc_dirty(o, out, si, so) :
    ix == 23 ? osc_noise(o, out, si) :
    ix == 24 ? osc_vowel(o, out);
  );
);

// ------------------------------------------------------------- sub oscillator and transients

function sub_render(shape, out, amount) local(inc, pw, mg, k, v, tri, ph, pi16) (
  inc = sub_inc;
  shape >= 3 ? (inc = inc >> 1; shape -= 3);
  pw = shape == 0 ? 128 : 64;
  mg = 255 - amount;
  ph = sub_ph;
  k = 0;
  loop(40,
    ph = (ph + inc) & 16777215;
    pi16 = ph >> 8;
    shape != 1 ? (
      v = ((pi16 >> 8) & 255) < pw ? 0 : 255;
    ) : (
      tri = (pi16 >> 7) & 255;
      v = (pi16 & 32768) ? tri : 255 - tri;
    );
    out[k] = mix4(out[k], v, mg, amount);
    k += 1;
  );
  sub_ph = ph;
);

function tr_value(fn) (
  fn == 0 ? (
    tr_gain = tr_cnt; tr_cnt = (tr_cnt - 1) & 255; tr_cnt < 32 ? 255 : 0;
  ) : fn == 1 ? (
    tr_gain = tr_cnt; tr_cnt = (tr_cnt - 1) & 255; tr_rng = (tr_rng * 73 + tr_cnt) & 255; tr_rng;
  ) : fn == 2 ? (
    tr_dec = (tr_dec + 2) & 255;
    tr_dec >= 16 ? (
      tr_dec = (tr_dec - 17) & 255;
      tr_rng = (tr_rng * 73 + tr_cnt) & 255;
      tr_dec == 0 ? (
        tr_cnt = (tr_cnt - 1) & 255;
        tr_gain = (tr_cnt & 128) ? 255 - tr_cnt : tr_cnt;
      );
    );
    tr_rng;
  ) : fn == 3 ? (
    tr_cnt = (tr_cnt - 1) & 255; tr_gain = tr_cnt >= 64 ? 255 : (tr_cnt << 2) & 255; (tr_cnt * 57) & 255;
  ) : (
    tr_cnt = (tr_cnt - 1) & 255; tr_gain = tr_cnt > 0 ? 255 : 0; 0;
  );
);
function tr_render(shape, out, amount) local(fn, size, k, v, amp) (
  shape >= 6 ? (
    shape > 10 ? shape = 10;
    fn = shape - 6;
    size = 40; k = 0;
    while (tr_cnt && size > 0) (
      size -= 1;
      v = tr_value(fn);
      amp = (tr_gain * amount) >> 8;
      out[k] = mix3(out[k], v, amp);
      k += 1;
    );
  );
);

// ------------------------------------------------------------- note stacks (pressed 0, mono 1, generated 2)

function ns_e(s, i) ( NSP + s * 32 + i * 3; );
function ns_size(s) ( NSS[s * 16 + 10]; );
function ns_root(s) ( NSS[s * 16 + 11]; );
function ns_clear(s) local(i) (
  NSS[s * 16 + 10] = 0;
  i = 1; loop(8, memset(ns_e(s, i), 0, 3); i += 1;);
  i = 1; loop(8, NSS[s * 16 + i] = 0; i += 1;);
  NSS[s * 16 + 11] = 0;
  i = 0; loop(9, ns_e(s, i)[0] = 255; i += 1;);
);
function ns_off(s, note) local(cur, prev, i, j, sz) (
  cur = ns_root(s); prev = 0;
  while (cur && ns_e(s, cur)[0] != note) ( prev = cur; cur = ns_e(s, cur)[2]; );
  cur ? (
    prev ? (ns_e(s, prev)[2] = ns_e(s, cur)[2]) : (NSS[s * 16 + 11] = ns_e(s, cur)[2]);
    sz = ns_size(s);
    i = 0;
    while (i < sz) (
      NSS[s * 16 + i] == cur ? (
        j = i;
        while (j < sz - 1) ( NSS[s * 16 + j] = NSS[s * 16 + j + 1]; j += 1; );
        i = sz;
      );
      i += 1;
    );
    ns_e(s, cur)[2] = 0;
    ns_e(s, cur)[0] = 255;
    ns_e(s, cur)[1] = 0;
    NSS[s * 16 + 10] = sz - 1;
  );
);
function ns_on(s, note, vel) local(lr, i, fs, j, sz, done) (
  ns_off(s, note);
  ns_size(s) == 8 ? (
    lr = 0;
    i = 1; loop(8, ns_e(s, i)[2] == 0 ? lr = ns_e(s, i)[0]; i += 1;);
    ns_off(s, lr);
  );
  fs = 0;
  i = 1; loop(8, ns_e(s, i)[0] == 255 ? fs = i; i += 1;);
  ns_e(s, fs)[2] = ns_root(s);
  ns_e(s, fs)[0] = note;
  ns_e(s, fs)[1] = vel;
  NSS[s * 16 + 11] = fs;
  sz = ns_size(s);
  i = 0; done = 0;
  while (!done && i < sz) (
    ns_e(s, NSS[s * 16 + i])[0] > note ? (
      j = sz;
      while (j > i) ( NSS[s * 16 + j] = NSS[s * 16 + j - 1]; j -= 1; );
      NSS[s * 16 + i] = fs;
      fs = 0;
      done = 1;
    );
    i += 1;
  );
  fs ? NSS[s * 16 + sz] = fs;
  NSS[s * 16 + 10] = sz + 1;
);
function ns_most_recent(s) ( ns_e(s, ns_root(s)); );
function ns_least_recent(s) local(cur) (
  cur = ns_root(s);
  while (cur && ns_e(s, cur)[2]) ( cur = ns_e(s, cur)[2]; );
  ns_e(s, cur);
);
function ns_sorted(s, i) ( ns_e(s, NSS[s * 16 + i]); );
function ns_played(s, idx) local(cur) (
  cur = ns_root(s);
  idx = (ns_size(s) - idx - 1) & 255;
  loop(idx, cur = ns_e(s, cur)[2];);
  ns_e(s, cur);
);

// ------------------------------------------------------------- voice

function voice_trigger_env(st) ( env_trigger(0, st); env_trigger(1, st); );
function voice_reset_controllers() (
  SRC[28] = 4; SRC[29] = 8; SRC[30] = 16; SRC[31] = 32;
  SRC[8] = 128; SRC[6] = 0; SRC[9] = 255;
  v_volume = 255;
);
function voice_note_off() ( v_gate = 0; voice_trigger_env(3); );
function voice_init() (
  v_pval = 7680;
  env_init(0); env_init(1);
  memset(NOSYNC, 0, 40);
  memcpy(USERWT, T_WAVES, 1032);
  voice_note_off();
  voice_reset_controllers();
);
function part_trigger_lfos() ( lfo_trigger(0); lfo_trigger(1); );
function voice_note_on(pitch, vel, porta, trig) local(i, delta, inc) (
  pitch != 0 ? (
    v_ptgt = s16(pitch);
    (trig || v_pval == 0) ? (
      !DISAUTO[0] ? env_trigger(0, 0);
      !DISAUTO[1] ? env_trigger(1, 0);
      v_tcount = (v_tcount + 1) & 255;
      v_gate = 255;
      part_trigger_lfos();
      tr_cnt = 255;
      SRC[21] = (vel << 1) & 255;
      SRC[22] = rng >> 8;
      osc_reset(0);
      osc_reset(1);
    );
    porta ? (
      delta = s16(v_ptgt - v_pval);
      inc = T_ENVINC[porta];
      v_pinc = s16(asr(delta * inc, 16));
      v_pinc == 0 ? (v_pinc = delta < 0 ? -1 : 1);
    ) : (
      v_pval = v_ptgt;
      v_pinc = 1;
    );
  );
);

function voice_load_sources() local(i, x, y, op, mx, mn, xg, r, mask, v, e) (
  SRC[19] = env_render(0);
  SRC[20] = env_render(1);
  SRC[23] = ((v_pval & 65535) >> 6) & 255;
  SRC[24] = v_gate;
  SRC[25] = BUF[0];
  i = 0;
  loop(2,
    op = P[94 + i * 3 + 2];
    op ? (
      x = SRC[P[94 + i * 3]];
      y = SRC[P[94 + i * 3 + 1]];
      op <= 7 ? (
        x > y ? ( OPS[3] = x; OPS[6] = 255; OPS[4] = y; OPS[7] = 0; )
              : ( OPS[3] = y; OPS[6] = 0; OPS[4] = x; OPS[7] = 255; );
        OPS[1] = (x >> 1) + (y >> 1);
        OPS[2] = (x * y) >> 8;
        OPS[5] = x ~ y;
        SRC[26 + i] = OPS[op];
      ) : op == 8 ? (
        mask = 0;
        while ((y = y >> 1) > 0) ( mask = (mask >> 1) | 128; );
        SRC[26 + i] = x & mask;
      ) : op == 9 ? (
        y = (y >> 2) + 1;
        v = (((256 - y) & 255) * SRC[26 + i] + y * x) & 65535;
        SRC[26 + i] = v >> 8;
      );
    );
    i += 1;
  );
  MDST[1] = v_volume;
  DST[0] = P[12] * 128;
  DST[2] = P[1] * 128;
  DST[3] = P[5] * 128;
  DST[6] = DST[7] = 8192;
  DST[4] = DST[5] = 8192;
  DST[15] = DST[16] = 8192;
  DST[17] = 0; DST[18] = 0;
  DST[11] = s16(P[13] << 8);
  DST[8] = s16(P[8] << 8);
  DST[9] = s16(P[10] << 8);
  DST[10] = s16(P[9] << 8);
  DST[14] = 8192;
  e = 0;
  loop(2,
    DST[19 + e * 4] = P[16 + e * 4] * 128;
    DST[20 + e * 4] = P[17 + e * 4] * 128;
    DST[21 + e * 4] = P[18 + e * 4] * 128;
    DST[22 + e * 4] = P[19 + e * 4] * 128;
    e += 1;
  );
  DST[12] = 0; DST[13] = 0;
  SY[9] >= 1 ? (
    DST[12] = P[84] * 128;
    DST[13] = s16(P[85] << 8);
  );
);

function voice_mod_matrix() local(i, amt, ms, md, sv, m) (
  DISAUTO[0] = 0; DISAUTO[1] = 0;
  i = 0;
  loop(12,
    amt = s8(P[32 + i * 3 + 2]);
    amt != 0 ? (
      i == 11 ? amt = s8(floor(amt * SRC[6] / 256));
      ms = P[32 + i * 3];
      md = P[33 + i * 3];
      (md >= 17 && md <= 18) ? DISAUTO[md - 17] = 1;
      sv = SRC[ms];
      md != 1 ? (
        m = DST[md];
        (ms <= 1 || ms == 8 || ms == 23 || ms == 25) ? (
          m = s16(m + amt * s8(sv + 128));
        ) : (
          m = s16(m + amt * sv);
        );
        DST[md] = clipu14(m);
      ) : (
        amt < 0 ? ( amt = -amt; sv = 255 - sv; );
        amt != 63 ? sv = mix3(255, sv, (amt << 2) & 255);
        MDST[1] = (MDST[1] * sv) >> 8;
      );
    );
    i += 1;
  );
);

function voice_update_dest() local(c, am, e, a) (
  c = DST[0] & 65535;
  P[3] != 9 ? c = clipu14(s16(c + v_pval - 8192));
  c = clipu14(s16(c + s8(P[14]) * SRC[19]));
  c = clipu14(s16(c + s8(P[15]) * s8(SRC[1] + 128)));
  MDST[0] = ((c & 65535) >> 6) & 255;
  MDST[11] = ((DST[11] & 65535) >> 6) & 255;
  MDST[12] = ((DST[12] & 65535) >> 6) & 255;
  MDST[13] = ((DST[13] & 65535) >> 6) & 255;
  MDST[15] = (DST[15] & 65535) >> 8;
  MDST[16] = (DST[16] & 65535) >> 8;
  DST[17] > 6000 ? (
    !MDST[17] ? env_trigger(0, 0);
    MDST[17] = 255;
  ) : (MDST[17] = 0);
  DST[18] > 6000 ? (
    !MDST[18] ? env_trigger(1, 0);
    MDST[18] = 255;
  ) : (MDST[18] = 0);
  OPAR[0] = ((DST[2] & 65535) >> 7) & 255;
  OSEC[0] = (P[2] + 24) & 255;
  OPAR[1] = ((DST[3] & 65535) >> 7) & 255;
  OSEC[1] = (P[6] + 24) & 255;
  am = s8(((((DST[14] & 65535) >> 7) & 255) - 64) << 1);
  e = 0;
  loop(2,
    a = ((DST[19 + e * 4] & 65535) >> 7) & 255;
    a = max(0, min(127, a - am));
    env_update(e, a,
      ((DST[20 + e * 4] & 65535) >> 7) & 255,
      ((DST[21 + e * 4] & 65535) >> 7) & 255,
      ((DST[22 + e * 4] & 65535) >> 7) & 255);
    e += 1;
  );
);

function voice_render_osc() local(base, i, pitch, rng8, ref, ns, ii, fr, i16, i16n, inc, mn, shp) (
  base = s16(v_pval + v_pinc);
  ((v_pinc > 0) ~ (base < v_ptgt)) ? ( base = v_ptgt; v_pinc = 0; );
  v_pval = base;
  base = s16(base + asr(DST[6] - 8192, 4));
  base = s16(base + asr(DST[7] - 8192, 7));
  base = s16(base + s8(SY[4]));
  i = 0;
  loop(2,
    pitch = base;
    (P[3] == 9 && i == 0 && v_bass) ? (
      pitch = s16(pitch - v_pval);
      pitch = s16(pitch + v_bass);
    );
    rng8 = 0;
    P[i * 4] != 10 ? rng8 = s8(rng8 + s8(P[i * 4 + 2]));
    rng8 = s8(rng8 + s8(SY[0]) * 12);
    pitch = s16(pitch + rng8 * 128);
    i == 1 ? pitch = s16(pitch + P[7]);
    pitch = s16(pitch + asr(DST[4 + i] - 8192, 2));
    while (pitch >= 16384) ( pitch -= 1536; );
    ref = s16(pitch - 14848);
    ns = 0;
    while (ref < 0) ( ref += 1536; ns += 1; );
    ii = (ref & 65535) >> 4;
    fr = (ref << 4) & 255;
    i16 = T_OSCINC[ii];
    i16n = T_OSCINC[ii + 1];
    inc = ((i16 + ((((i16n - i16) & 65535) * fr) >> 8)) & 65535) << 8;
    loop(ns, inc = inc >> 1;);
    mn = s8(((pitch & 65535) >> 7) & 255);
    mn < 12 ? mn = 12;
    i == 0 ? (
      sub_inc = inc >> 1;
      osc_render(0, P[0], mn, inc, NOSYNC, SYNCS, BUF);
    ) : (
      shp = P[4];
      (P[3] == 9 && !v_bass) ? shp = 0;
      osc_render(1, shp, mn, inc, P[3] == 1 ? SYNCS : NOSYNC, DUMMY, BUF2);
    );
    i += 1;
  );
);

function voice_process_block() local(op, mask, g1, g2, k, b, b2, dec, sg, ng, mg, noise, v) (
  voice_load_sources();
  voice_mod_matrix();
  voice_update_dest();
  voice_render_osc();
  MDST[1] == 0 ? (
    memset(OUTB, 128, 40);
  ) : (
    op = P[3];
    mask = 255;
    op == 10 ? (mask = (v_tcount & 1) ? 14 : 13);
    op == 11 ? (mask = shr_seq4[v_tcount & 3]);
    op == 12 ? (mask = shr_seq8[v_tcount & 7]);
    op == 13 ? (mask = SRC[2] >> 4);
    g2 = ((DST[8] & 65535) >> 6) & 255;
    g1 = 255 - g2;
    (mask != 255 && (mask & 3) != 3) ? (
      g2 = (mask & 1) ? 255 : 0;
      g1 = (mask & 2) ? 255 : 0;
    );
    (!g1 && !g2) ? (
      memset(BUF, 128, 40);
    ) : (
      k = 0;
      op == 2 ? (
        loop(40,
          b = BUF[k]; b2 = BUF2[k];
          v = (s8(floor(s8(b + 128) * s8(b2 + 128) / 256)) + 128) & 255;
          BUF[k] = mix4(b, v, g1, g2);
          k += 1;
        );
      ) : op == 4 ? (
        loop(40,
          b = ((BUF[k] >> 1) + (BUF2[k] >> 1)) & 255;
          BUF[k] = mix4(b, T_DIST[b], g1, g2);
          k += 1;
        );
      ) : op == 3 ? (
        loop(40, BUF[k] = (BUF[k] ~ BUF2[k]) ~ g2; k += 1;);
      ) : op == 7 ? (
        loop(40,
          b = ((BUF[k] >> 1) + (BUF2[k] >> 1)) & 255;
          BUF[k] = mix4(b, (b + 128) & 255, g1, g2);
          k += 1;
        );
      ) : op == 8 ? (
        g2 = g2 >> 5;
        g2 = (255 - ((1 << g2) - 1)) & 255;
        loop(40, BUF[k] = (((BUF[k] >> 1) + (BUF2[k] >> 1)) & 255) & g2; k += 1;);
      ) : (
        loop(40, BUF[k] = mix4(BUF[k], BUF2[k], g1, g2); k += 1;);
      );
    );
    dec = op == 5 ? 4 : op == 6 ? 8 : 1;
    sg = ((DST[10] & 65535) >> 7) & 255;
    mask != 255 ? (
      sg = (mask & 4) ? sg : 0;
      (mask & 3) == 0 ? sg = (sg << 1) & 255;
    );
    P[11] < 6 ? (
      sub_render(P[11], BUF, sg);
    ) : (
      sg < 128 ? sg = (sg << 1) & 255;
      tr_render(P[11], BUF, sg);
    );
    dec > 1 ? (
      k = 0;
      while (k < 40) (
        v = BUF[k];
        b = 1; loop(dec - 1, BUF[k + b] = v; b += 1;);
        k += dec;
      );
    );
    noise = rnd_byte();
    ng = (DST[9] & 65535) >> 8;
    mask != 255 ? (
      ng = (mask & 8) ? ng : 0;
      mask == 8 ? ng = (ng << 1) & 255;
    );
    mg = 255 - ng;
    k = 0;
    loop(40,
      noise = (noise * 73 + 1) & 255;
      OUTB[k] = mix4(BUF[k], noise, mg, ng);
      k += 1;
    );
  );
);

// ------------------------------------------------------------- part

function step_dur() ( shr_clkdiv[SQ[7]]; );
function seq_ctrl(n) ( SQ[11 + n * 2] & 15; );
function seq_gate(n) ( SQ[10 + n * 2] & 128; );
function seq_note(n) ( SQ[10 + n * 2] & 127; );
function seq_legato(n) ( SQ[11 + n * 2] & 128; );
function seq_vel(n) ( SQ[11 + n * 2] & 112; );

function part_update_lfo_rate(i) local(pi, rate) (
  P[25 + i * 4] < 16 ? (
    pi = 0;
  ) : (
    rate = P[25 + i * 4] + MDST[15 + i] - 32;
    rate < 0 ? (rate = 0) : (rate >= 128 ? (rate = 127));
    pi = T_LFOINC[rate];
  );
  lfo_update(i, P[24 + i * 4], pi, P[26 + i * 4], P[27 + i * 4]);
);
function part_update_mod_rates() ( part_update_lfo_rate(0); part_update_lfo_rate(1); );

function part_tune(note) local(ps) (
  SY[1] ? (
    ps = TOFF[4 + SY[1] - 1][note % 12];
    ps >= 32768 ? ps -= 65536;
    ps != 32767 ? (note * 128 + ps) & 65535 : 0;
  ) : note * 128;
);

function part_int_note_on(note, vel) local(bn, bv, an, av, leg, bass) (
  bn = ns_most_recent(1)[0];
  ns_on(1, note, vel);
  an = ns_most_recent(1)[0];
  av = ns_most_recent(1)[1];
  bn != an ? (
    leg = ns_size(1) > 1;
    voice_note_on(part_tune(an), av, (!SY[3] || leg) ? SY[2] : 0, !SY[3] || !leg);
    bass = ns_least_recent(1)[0];
    v_bass = bass != an ? s16(part_tune(bass)) : 0;
  );
);
function part_int_note_off(note) local(bn, an, av) (
  bn = ns_most_recent(1)[0];
  ns_off(1, note);
  an = ns_most_recent(1)[0];
  av = ns_most_recent(1)[1];
  ns_size(1) == 0 ? (
    voice_note_off();
  ) : (bn != an && P[3] != 9) ? (
    voice_note_on(part_tune(an), av, SY[2], !SY[3]);
  );
);
function part_stop_generated() local(n) (
  while (ns_size(2)) (
    n = ns_sorted(2, 0)[0];
    ns_off(2, n);
    part_int_note_off(n);
  );
);
function part_all_notes_off() (
  !p_ignore_off ? (
    ns_clear(1); ns_clear(0);
    voice_note_off();
    p_release_latched = 0;
    p_ignore_off = 0;
  );
);
function part_all_sound_off() ( p_ignore_off = 0; part_all_notes_off(); );

function part_start() (
  LSTEP[0] = 0; LSTEP[1] = 0;
  SQ[0] != 0 ? (
    ns_clear(1); ns_clear(2);
    voice_note_off();
  );
  p_release_latched = 0;
  p_ignore_off = 0;
  p_prescaler = 0;
  p_step = 255;
  p_running = 1;
  p_arp_prev = 0;
  p_seq_transp = 0;
  SQ[4] == 1 ? (
    p_arp_note = s8(ns_size(0) - 1);
    p_arp_oct = s8(SQ[5] - 1);
    p_arp_dir = -1;
  ) : (
    p_arp_note = 0; p_arp_oct = 0; p_arp_dir = 1;
  );
);
function part_stop() (
  p_running = 0;
  p_ignore_off = 0;
  SQ[0] != 0 ? ( part_stop_generated(); part_all_sound_off(); );
);
function part_next_step() local(n) (
  p_step = (p_step + 1) & 255;
  p_step >= SQ[8] ? p_step = 0;
  SQ[0] == 2 ? (
    n = (p_step + SQ[9]) & 15;
    seq_legato(n) ? p_gate_cnt = (p_gate_cnt + step_dur()) & 65535;
  );
);
function part_clock_arp() local(has, pm, pat, n, nn, rb, wrapped, e, note, vel) (
  SQ[6] < 15 ? (
    pm = (1 << p_step) & 65535;
    pat = T_ARP[SQ[6]];
    has = (pm & pat) != 0;
  ) : (
    n = (p_step + SQ[9]) & 15;
    has = seq_gate(n) && !seq_legato(n);
  );
  SRC[5] = has ? 255 : 0;
  nn = ns_size(0);
  (SQ[0] == 1 && has && nn) ? (
    (nn == 1 && SQ[5] == 1) ? (
      p_arp_note = 0; p_arp_oct = 0;
    ) : (
      SQ[4] == 3 ? (
        rb = rng >> 8;
        p_arp_oct = rb & 15;
        p_arp_note = (rb & 240) >> 4;
        while (p_arp_oct >= SQ[5]) ( p_arp_oct = s8(p_arp_oct - SQ[5]); );
        while (p_arp_note >= nn) ( p_arp_note = s8(p_arp_note - nn); );
      ) : (
        wrapped = 1;
        while (wrapped) (
          (p_arp_note >= nn || p_arp_note < 0) ? (
            p_arp_oct = s8(p_arp_oct + p_arp_dir);
            p_arp_note = p_arp_dir > 0 ? 0 : s8(nn - 1);
          );
          wrapped = 0;
          (p_arp_oct >= SQ[5] || p_arp_oct < 0) ? (
            p_arp_oct = p_arp_dir > 0 ? 0 : s8(SQ[5] - 1);
            SQ[4] == 2 ? (
              p_arp_dir = -p_arp_dir;
              p_arp_note = p_arp_dir > 0 ? 1 : s8(nn - 2);
              p_arp_oct = p_arp_dir > 0 ? 0 : s8(SQ[5] - 1);
              wrapped = 1;
            );
          );
        );
      );
    );
    part_stop_generated();
    e = SQ[4] == 4 ? ns_played(0, p_arp_note & 255) : ns_sorted(0, p_arp_note & 255);
    note = e[0];
    vel = e[1] & 127;
    note = (note + 12 * p_arp_oct) & 255;
    while (note > 127) ( note -= 12; );
    ns_on(2, note, vel);
    part_int_note_on(note, vel);
    (p_arp_prev && P[3] == 9 && p_arp_prev != note) ? (
      ns_on(2, p_arp_prev, vel);
      part_int_note_on(p_arp_prev, vel);
    );
    p_arp_prev = note;
    p_arp_note = s8(p_arp_note + p_arp_dir);
    p_gate_cnt = (step_dur() >> 1) + 1;
  );
  (SQ[0] == 1 && nn && SQ[6] == 15) ? (
    n = p_step + 1;
    n >= SQ[8] ? n = 0;
    n = (n + SQ[9]) & 15;
    seq_legato(n) ? p_gate_cnt = (p_gate_cnt + step_dur()) & 65535;
  );
);
function part_clock_seq() local(n, tr, note) (
  n = (p_step + SQ[9]) & 15;
  SRC[2] = (seq_ctrl(n) << 4) & 255;
  SRC[3] = (seq_ctrl(n & 7) << 4) & 255;
  SRC[4] = (seq_ctrl((n & 7) + 8) << 4) & 255;
  (SQ[0] == 2 && seq_gate(n)) ? (
    tr = ns_size(0) ? s8(ns_most_recent(0)[0] - 60) : p_seq_transp;
    p_seq_transp = tr;
    note = s8(seq_note(n) + tr);
    while (note < 0) ( note = s8(note + 12); );
    while (note > 127) ( note = s8(note - 12); );
    !seq_legato(n) ? (
      part_stop_generated();
      part_int_note_on(note, seq_vel(n));
    ) : (
      ns_most_recent(2)[0] != note ? (
        part_int_note_on(note, seq_vel(n));
        part_stop_generated();
      );
    );
    ns_on(2, note, seq_vel(n));
    p_gate_cnt = (step_dur() >> 1) + 1;
  );
);
function part_clock(internal) local(i, rate, lim) (
  p_clock_stopped = 0;
  p_running ? (
    internal ? (
      !ns_size(0) ? (
        p_blank = (p_blank + 1) & 255;
        p_blank >= 12 ? ( part_stop(); p_clock_stopped = 1; );
      ) : (p_blank = 0);
    );
    !p_clock_stopped ? (
      !p_prescaler ? ( part_next_step(); part_clock_arp(); part_clock_seq(); );
      (!p_gate_cnt && ns_size(2)) ? part_stop_generated() : (p_gate_cnt = (p_gate_cnt - 1) & 65535);
    );
  );
  !p_clock_stopped ? (
    i = 0;
    loop(2,
      rate = P[25 + i * 4];
      rate < 16 ? (
        lim = (step_dur() * (rate + 1)) & 65535;
        while (LSTEP[i] >= lim) ( LSTEP[i] = (LSTEP[i] - lim) & 65535; );
        lim != LLIM[i] ? ( LLIM[i] = lim; LINC[i] = floor(65536 / lim) & 65535; );
        lfo_set_target_phase(i, LSTEP[i], LINC[i]);
      );
      LSTEP[i] = (LSTEP[i] + 1) & 65535;
      LSTEP[i] >= 1536 ? LSTEP[i] = 0;
      i += 1;
    );
    p_prescaler = (p_prescaler + 1) & 255;
    p_prescaler >= step_dur() ? p_prescaler = 0;
  );
);

function part_note_off(note) local(i, e) (
  p_ignore_off ? (
    i = 1;
    loop(8,
      e = ns_e(0, i);
      (e[0] == note && e[1]) ? e[1] = e[1] | 128;
      i += 1;
    );
  ) : (
    ns_off(0, note);
    (SQ[0] == 0 || !p_running) ? part_int_note_off(note);
  );
);
function part_release_latched() local(i, e) (
  i = 1;
  loop(8,
    e = ns_e(0, i);
    e[1] & 128 ? part_note_off(e[0]);
    i += 1;
  );
);

function part_note_on(note, vel) local(reclock, still) (
  !vel ? (
    part_note_off(note);
  ) : (
    reclock = SQ[0] == 1 && SQ[1] < 40 && ns_size(0) == 0 && p_running;
    p_release_latched ? (
      still = p_ignore_off;
      p_ignore_off = 0;
      part_release_latched();
      p_release_latched = still;
      p_ignore_off = still;
    );
    ns_on(0, note, vel);
    (!p_running && SQ[1] >= 40) ? ( part_start(); part_clock(1); );
    (SQ[0] == 0 || !p_running) ? part_int_note_on(note, vel);
    reclock ? part_clock_arp();
  );
);
function clock_tick() ( clk_phase += clk_inc; clk_phase >= 4294967296 ? clk_phase -= 4294967296; );
function clock_wrap(amount) local(b3) (
  b3 = floor(clk_phase / 16777216);
  b3 >= 128 + amount ? (
    clk_phase = clk_phase - b3 * 16777216 + ((b3 - (128 + amount)) & 255) * 16777216;
    1;
  ) : 0;
);
function clock_update(bpm) ( clk_inc = T_TEMPO[bpm - 40]; );

function part_process_block() local(i, j, gv) (
  SQ[1] >= 40 ? (
    clock_tick();
    clock_wrap(p_swing) ? (
      gv = TOFF[37 + SQ[2]][p_step];
      p_swing = asr(s8(floor(s8(gv) * SQ[3] / 256)), 1);
      part_clock(1);
      clock_update(SQ[1]);
    );
  );
  SRC[0] = lfo_render(0);
  SRC[1] = lfo_render(1);
  SRC[18] = rng >> 8;
  i = 0;
  loop(2,
    PREVFM[i] != MDST[15 + i] ? ( PREVFM[i] = MDST[15 + i]; part_update_lfo_rate(i); );
    i += 1;
  );
  j = 0;
  loop(2,
    (LCC[j] && P[27 + j * 4] == 2) ? env_trigger(j, 0);
    j += 1;
  );
  voice_process_block();
);

function part_reset() (
  p_ignore_off = 0;
  voice_reset_controllers();
  lfo_reset(0); lfo_reset(1);
  part_all_notes_off();
);

function part_init() local(i) (
  memcpy(P, shr_init_patch, 100);
  part_update_mod_rates();
  memcpy(SQ, shr_init_seq, 42);
  memcpy(SY, shr_init_sys, 15);
  part_reset();
  ns_clear(0); ns_clear(1); ns_clear(2);
  voice_init();
  p_running = 0;
  clock_update(120);
);

// ------------------------------------------------------------- DSP board link (main side)

function shr_dsp_write() local(v) (
  dsp_rr == 0 ? (
    v = 255;
  ) : dsp_rr == 1 ? (
    v = ((P[92] << 4) | P[93]) & 255;
  ) : dsp_rr == 2 ? (
    v = SQ[1];
  ) : (
    v = MDST[11 + dsp_rr - 3];
    v == 255 ? v = 254;
  );
  cv_a = v;
  v = MDST[dsp_rr & 1];
  v == 255 ? v = 254;
  cv_b = v;
  dsp_rr += 1;
  dsp_rr == 6 ? dsp_rr = 0;
);

function shr_block() (
  part_process_block();
  shr_dsp_write();
);

function shr_boot() (
  rng = 33;
  part_init();
);

function shr_consts() local(i, d) (
  shr_seq4 = shr_alloc(4);
  shr_seq8 = shr_alloc(8);
  shr_clkdiv = shr_alloc(12);
  shr_init_patch = shr_alloc(100);
  shr_init_seq = shr_alloc(42);
  shr_init_sys = shr_alloc(15);
  d = shr_seq4; d[0] = 4; d[1] = 1; d[2] = 8; d[3] = 2;
  d = shr_seq8; d[0] = 4; d[1] = 1; d[2] = 8; d[3] = 8; d[4] = 2; d[5] = 4; d[6] = 8; d[7] = 2;
  d = shr_clkdiv; d[0] = 96; d[1] = 48; d[2] = 32; d[3] = 24; d[4] = 16; d[5] = 12;
  d[6] = 8; d[7] = 6; d[8] = 4; d[9] = 3; d[10] = 2; d[11] = 1;
  d = shr_init_patch;
  d[0] = 1; d[1] = 0; d[2] = 0; d[3] = 0;
  d[4] = 1; d[5] = 16; d[6] = 244; d[7] = 12;
  d[8] = 32; d[9] = 0; d[10] = 0; d[11] = 0;
  d[12] = 96; d[13] = 0; d[14] = 32; d[15] = 0;
  d[16] = 0; d[17] = 50; d[18] = 20; d[19] = 60;
  d[20] = 0; d[21] = 40; d[22] = 90; d[23] = 30;
  d[24] = 0; d[25] = 80; d[26] = 0; d[27] = 0;
  d[28] = 0; d[29] = 3; d[30] = 0; d[31] = 0;
  d[32] = 0; d[33] = 4; d[34] = 0;
  d[35] = 19; d[36] = 5; d[37] = 0;
  d[38] = 19; d[39] = 2; d[40] = 0;
  d[41] = 0; d[42] = 3; d[43] = 0;
  d[44] = 1; d[45] = 8; d[46] = 0;
  d[47] = 2; d[48] = 8; d[49] = 0;
  d[50] = 21; d[51] = 2; d[52] = 0;
  d[53] = 21; d[54] = 3; d[55] = 0;
  d[56] = 20; d[57] = 1; d[58] = 63;
  d[59] = 21; d[60] = 1; d[61] = 16;
  d[62] = 8; d[63] = 6; d[64] = 32;
  d[65] = 0; d[66] = 6; d[67] = 16;
  d[68] = 105; d[69] = 110; d[70] = 105; d[71] = 116;
  d[72] = 32; d[73] = 32; d[74] = 32; d[75] = 32;
  i = 76; loop(15, d[i] = 0; i += 1;);
  d[91] = 33;
  i = 92; loop(8, d[i] = 0; i += 1;);
  d = shr_init_sys;
  d[0] = 0; d[1] = 0; d[2] = 0; d[3] = 0; d[4] = 0; d[5] = 1; d[6] = 1; d[7] = 0;
  d[8] = 8; d[9] = 3; d[10] = 0; d[11] = 0; d[12] = 0; d[13] = 0; d[14] = 0;
  d = shr_init_seq;
  d[0] = 0; d[1] = 120; d[2] = 0; d[3] = 0; d[4] = 0; d[5] = 1; d[6] = 0; d[7] = 7; d[8] = 16; d[9] = 0;
  d[10] = 176; d[11] = 112; d[12] = 176; d[13] = 208; d[14] = 188; d[15] = 80; d[16] = 188; d[17] = 208;
  d[18] = 176; d[19] = 127; d[20] = 176; d[21] = 223; d[22] = 188; d[23] = 95; d[24] = 60; d[25] = 95;
  d[26] = 176; d[27] = 124; d[28] = 176; d[29] = 220; d[30] = 188; d[31] = 92; d[32] = 188; d[33] = 220;
  d[34] = 176; d[35] = 116; d[36] = 48; d[37] = 84; d[38] = 188; d[39] = 116; d[40] = 60; d[41] = 84;
);

function part_pitch_bend(v) ( SRC[8] = (v >> 6) & 255; );
function part_cc(c, v) ( 0; );

function part_set_param(o, v) (
  P[o] != v ? (
    P[o] = v;
    (o >= 16 && o <= 31) ? (
      part_update_mod_rates();
    ) : o == 104 ? (
      p_arp_dir = SQ[4] == 1 ? -1 : 1;
    );
  );
);

function prm_scale(unit, mn, mx, v) local(r, sv) (
  unit == 0 ? (
    sv = v;
  ) : (
    r = (mx - mn + 1) & 255;
    sv = ((((r * ((v << 1) & 255)) >> 8) + mn) & 255);
    unit == 14 ? ( sv >= 239 ? sv = 240; sv &= 254; );
  );
  sv;
);
function prm_in_range(unit, mn, mx, v) (
  unit == 2 ? (s8(v) >= s8(mn) && s8(v) <= s8(mx)) : (v >= mn && v <= mx);
);
function prm_increment(unit, mn, mx, cur, inc) local(v, nv) (
  nv = cur;
  unit == 2 ? (
    v = s8(cur) + inc;
    (v >= s8(mn) && v <= s8(mx)) ? nv = v & 255;
  ) : (
    v = cur + inc;
    (v >= mn && v <= mx) ? nv = v & 255;
  );
  nv;
);
function voice_cc(c, v) (
  v = (v << 1) & 255;
  c == 16 ? SRC[14] = v :
  c == 17 ? SRC[15] = v :
  c == 2 ? SRC[16] = v :
  c == 4 ? SRC[17] = v :
  c == 1 ? SRC[6] = v :
  c == 7 ? v_volume = v;
);
function part_cc_full(c, v) local(o, u, mn, mx, old, nv) (
  c == 64 ? (
    v >= 64 ? (p_ignore_off = 1) : ( p_ignore_off = 0; part_release_latched(); );
  ) : c == 6 ? (
    p_data_msb = (v << 7) & 255;
  ) : c == 98 ? (
    p_nrpn = (v | p_nrpn_msb) & 255;
    p_nrpn_msb = 0;
    p_data_msb = 0;
  ) : c == 99 ? (
    p_nrpn_msb = (v << 7) & 255;
    p_data_msb = 0;
  ) : (c == 38 || c == 96 || c == 97) ? (
    v = (v | p_data_msb) & 255;
    (p_nrpn != 255 && p_nrpn < 160 && OFFMAP[p_nrpn * 4] != 255) ? (
      o = p_nrpn; u = OFFMAP[o * 4]; mn = OFFMAP[o * 4 + 1]; mx = OFFMAP[o * 4 + 2];
      c == 38 ? (
        prm_in_range(u, mn, mx, v) ? part_set_param(o, v);
      ) : (
        old = P[o];
        nv = prm_increment(u, mn, mx, old, c == 96 ? 1 : -1);
        nv != old ? part_set_param(o, nv);
      );
    );
  ) : (
    CCMAP[c * 4] == 255 ? (
      voice_cc(c, v);
    ) : (
      part_set_param(CCMAP[c * 4], prm_scale(CCMAP[c * 4 + 1], CCMAP[c * 4 + 2], CCMAP[c * 4 + 3], v));
    );
  );
);
function part_midi(st, d1, d2) local(hi) (
  hi = st & 240;
  hi == 128 ? part_note_off(d1) :
  hi == 144 ? (d2 ? part_note_on(d1, d2) : part_note_off(d1)) :
  hi == 160 ? SRC[7] = (d2 << 1) & 255 :
  hi == 176 ? (
    d1 == 120 ? part_all_sound_off() :
    d1 == 121 ? ( p_ignore_off = 0; voice_reset_controllers(); ) :
    d1 == 123 ? part_all_notes_off() :
    (d1 >= 122) ? 0 :
    d1 == 0 ? p_bank = d2 :
    part_cc_full(d1, d2);
  ) :
  hi == 208 ? SRC[7] = (d1 << 1) & 255 :
  hi == 224 ? part_pitch_bend((d2 << 7) + d1);
);

