);
CANVW = 1100; CANVH = 720;

function rgba(r, g, b, a) ( gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; );
function col(c)
(
  c == 0 ? rgba(0.055, 0.060, 0.071, 1)
  : c == 1 ? rgba(0.090, 0.097, 0.112, 1)
  : c == 2 ? rgba(0.133, 0.143, 0.163, 1)
  : c == 3 ? rgba(0.196, 0.208, 0.233, 1)
  : c == 4 ? rgba(0.930, 0.937, 0.949, 1)
  : c == 5 ? rgba(0.620, 0.646, 0.690, 1)
  : c == 6 ? rgba(0.580, 0.600, 0.640, 1)
  : c == 7 ? rgba(0.039, 0.043, 0.052, 1)
  : c == 8 ? rgba(0.165, 0.176, 0.200, 1)
  : rgba(1, 1, 1, 1);
);
C_BG = 0; C_CARD = 1; C_CTRL = 2; C_LINE = 3; C_TEXT = 4; C_TEXT2 = 5; C_TEXT3 = 6; C_SCREEN = 7; C_HOVER = 8;

function acol(a, al)
(
  a == 0 ? rgba(0.937, 0.463, 0.502, al)
  : a == 1 ? rgba(0.388, 0.698, 0.965, al)
  : a == 2 ? rgba(0.945, 0.733, 0.388, al)
  : a == 3 ? rgba(0.612, 0.565, 0.965, al)
  : a == 4 ? rgba(0.333, 0.824, 0.733, al)
  : rgba(0.965, 0.580, 0.420, al);
);
A_PINK = 0; A_SKY = 1; A_LEMON = 2; A_LILAC = 3; A_MINT = 4; A_PEACH = 5;
function amix(a, t) local(r, g, b)
(
  acol(a, 1); r = gfx_r; g = gfx_g; b = gfx_b;
  rgba(0.090 + (r - 0.090) * t, 0.097 + (g - 0.097) * t, 0.112 + (b - 0.112) * t, 1);
);

function sx(x) ( ox + x * z; );
function sy(y) ( oy + y * z; );
function fnt(n)
(
  n == 1 ? gfx_setfont(1, "Arial", 15 * z, 0)
  : n == 2 ? gfx_setfont(2, "Arial", 16 * z, 0)
  : n == 3 ? gfx_setfont(3, "Arial", 17 * z, 'b')
  : n == 4 ? gfx_setfont(4, "Arial", 24 * z, 'b')
  : n == 5 ? gfx_setfont(5, "Arial", 19 * z, 'b')
  : n == 6 ? gfx_setfont(6, "Arial", 14 * z, 0)
  : n == 8 ? gfx_setfont(8, "Arial", 15 * z, 'b')
  : n == 9 ? gfx_setfont(9, "Arial", 13 * z, 'b')
  : gfx_setfont(7, "Arial", 15 * z, 'b');
);
function frect(x, y, w, h) local(x1, y1, x2, y2)
(
  x1 = floor(sx(x) + 0.5); y1 = floor(sy(y) + 0.5);
  x2 = floor(sx(x + w) + 0.5); y2 = floor(sy(y + h) + 0.5);
  gfx_rect(x1, y1, max(1, x2 - x1), max(1, y2 - y1), 1);
);
function disc(x, y, r) ( gfx_circle(sx(x), sy(y), r * z, 1, 1); );
function ring(x, y, r) ( gfx_circle(sx(x), sy(y), r * z, 0, 1); );
function rr(x, y, w, h, r, fill) local(x1, y1, x2, y2, rp)
(
  x1 = floor(sx(x) + 0.5); y1 = floor(sy(y) + 0.5);
  x2 = floor(sx(x + w) + 0.5); y2 = floor(sy(y + h) + 0.5);
  rp = floor(min(r * z, min(x2 - x1, y2 - y1) / 2) + 0.5);
  fill ? (
    rp < 1 ? gfx_rect(x1, y1, max(1, x2 - x1), max(1, y2 - y1), 1) : (
      gfx_rect(x1 + rp, y1, max(1, x2 - x1 - 2 * rp), y2 - y1, 1);
      gfx_rect(x1, y1 + rp, x2 - x1, max(1, y2 - y1 - 2 * rp), 1);
      gfx_circle(x1 + rp, y1 + rp, rp, 1, 1);
      gfx_circle(x2 - 1 - rp, y1 + rp, rp, 1, 1);
      gfx_circle(x1 + rp, y2 - 1 - rp, rp, 1, 1);
      gfx_circle(x2 - 1 - rp, y2 - 1 - rp, rp, 1, 1);
    );
  ) : gfx_roundrect(x1, y1, x2 - x1 - 1, y2 - y1 - 1, rp, 1);
);
function ln(x1, y1, x2, y2) ( gfx_line(sx(x1), sy(y1), sx(x2), sy(y2), 1); );
function txt_w(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / z; );
function txt(s, x, y, align) local(tw, th)
(
  gfx_measurestr(s, tw, th);
  gfx_x = align == 1 ? sx(x) - tw / 2 : align == 2 ? sx(x) - tw : sx(x);
  gfx_y = sy(y) - th / 2;
  gfx_drawstr(s);
);
function inr(x, y, w, h) ( mx >= x && mx < x + w && my >= y && my < y + h; );
function chevron(x, y, s) ( ln(x - s, y - s * 0.5, x, y + s * 0.5); ln(x, y + s * 0.5, x + s, y - s * 0.5); );
function thick_arc(x, y, r, a0, a1, t) local(i)
(
  i = 0; loop(ceil(t / 0.6), gfx_arc(sx(x), sy(y), (r - i * 0.6) * z, a0, a1, 1); i += 1;);
);
function hint(s) ( nh = s; );
function thick_line(x1, y1, x2, y2, t) local(i, nx, ny, l)
(
  l = sqrt(sqr(x2 - x1) + sqr(y2 - y1)) + 0.0001;
  nx = -(y2 - y1) / l; ny = (x2 - x1) / l;
  i = -t / 2;
  while (i <= t / 2) (ln(x1 + nx * i, y1 + ny * i, x2 + nx * i, y2 + ny * i); i += 0.5;);
);
function clampg(v, a, b) ( v < a ? a : v > b ? b : v; );

function dblclick(id) local(t, d)
(
  t = time_precise();
  d = id == last_click_id && t - last_click_t < 0.32;
  last_click_id = id; last_click_t = t;
  d;
);

function ui_frame_begin()
(
  mdown = mouse_cap & 1;
  mclick = mdown && !pdown;
  mx = (mouse_x - ox) / z;
  my = (mouse_y - oy) / z;
  wheel = mouse_wheel; mouse_wheel = 0;
  wid = 0;
  cur_hint = 0; nh = 0;
  !mdown ? (
    active > 0 && active_k > 0 ? automate(active_k, 1);
    active = 0; active_k = 0;
  );
);
function ui_frame_end() ( pdown = mdown; );
function nid() ( wid += 1; wid; );
function take_hint(hot) ( hot && nh ? cur_hint = nh; nh = 0; );

function sl(k) ( floor(slider(k) + 0.5); );
function set_sl(k, v)
(
  v = clampg(floor(v + 0.5), SMIN[k], SMAX[k]);
  v !== slider(k) ? ( slider(k) = v; automate(k, 0); );
);
function set_sl_done(k, v) ( set_sl(k, v); automate(k, 1); );

function fmt_val(k, v) local(u)
(
  u = SKIND[k];
  k == OUTK ? (
    sprintf(#gfv, "%+.1f dB", slider(k));
  ) : u == 1 ? (
    v < 16 ? sprintf(#gfv, "sync x%d", v + 1) : sprintf(#gfv, "%d", v - 16);
  ) : u == 2 ? (
    v < 40 ? strcpy(#gfv, "Host") : sprintf(#gfv, "%d bpm", v);
  ) : u == 3 ? (
    v > 0 ? sprintf(#gfv, "+%d", v) : sprintf(#gfv, "%d", v);
  ) : u >= 10 ? (
    strcpy(#gfv, LBASE[u] + v);
  ) : (
    sprintf(#gfv, "%d", v);
  );
  #gfv;
);

function knob_draw(cx, cy, r, norm, bip, hot) local(a0, a1, ang, cap, t)
(
  a0 = -2.4; a1 = 2.4;
  ang = a0 + (a1 - a0) * clampg(norm, 0, 1);
  t = max(2.4, r * 0.11);
  amix(acc, 0.16);
  thick_arc(cx, cy, r, a0, a1, t);
  acol(acc, 1);
  bip ? thick_arc(cx, cy, r, min(0, ang), max(0, ang), t) : thick_arc(cx, cy, r, a0, ang, t);
  cap = r - t - 3.5;
  hot ? col(C_HOVER) : col(C_CTRL);
  disc(cx, cy, cap);
  col(C_LINE); ring(cx, cy, cap);
  col(C_TEXT);
  thick_line(cx + sin(ang) * cap * 0.25, cy - cos(ang) * cap * 0.25, cx + sin(ang) * (cap - 1.5), cy - cos(ang) * (cap - 1.5), max(1.5, r * 0.07));
);

function knob(cx, cy, r, k, label) local(id, v, nv, rng, hit, hot, bip, fine)
(
  id = nid();
  fine = k == OUTK;
  v = fine ? slider(k) : sl(k);
  rng = SMAX[k] - SMIN[k];
  hit = (mx - cx) * (mx - cx) + (my - cy) * (my - cy) <= (r + 4) * (r + 4) || inr(cx - r - 6, cy + r, 2 * r + 12, 30);
  mclick && hit ? (
    dblclick(id) ? ( slider(k) = SDEF[k]; automate(k, 0); automate(k, 1); ) : ( active = id; active_k = k; drag_y = my; drag_v = v; );
  );
  active == id && mdown ? (
    mouse_cap |= 65536;
    nv = drag_v + (drag_y - my) / ((mouse_cap & 4) ? 1600 : 200) * rng;
    fine ? ( nv = clampg(floor(nv * 10 + 0.5) / 10, SMIN[k], SMAX[k]); nv !== slider(k) ? ( slider(k) = nv; automate(k, 0); ); ) : set_sl(k, nv);
    v = fine ? slider(k) : sl(k);
  );
  hit && wheel != 0 && !mdown ? (
    fine ? ( slider(k) = clampg(v + (wheel > 0 ? 0.5 : -0.5), SMIN[k], SMAX[k]); automate(k, 0); automate(k, 1); ) : set_sl_done(k, v + (wheel > 0 ? 1 : -1));
    v = fine ? slider(k) : sl(k);
  );
  hot = hit || active == id;
  !nh ? hint(LLAB + k);
  take_hint(hot);
  bip = SMIN[k] < 0;
  knob_draw(cx, cy, r, rng > 0 ? (v - SMIN[k]) / rng : 0, bip, hot);
  strlen(label) ? (
    fnt(8); col(C_TEXT2);
    txt(label, cx, cy + r + 11, 1);
    fnt(6); hot ? acol(acc, 1) : col(C_TEXT3);
    txt(fmt_val(k, v), cx, cy + r + 25, 1);
  );
);

function choice(x, y, w, k, label) local(hit, v, u, n, i, m, sel)
(
  v = sl(k);
  u = SKIND[k];
  hit = inr(x, y - 13, w, 26);
  !nh ? hint(LLAB + k);
  mclick && hit ? (
    strcpy(#menu, "");
    n = SMAX[k] - SMIN[k] + 1;
    i = 0;
    loop(n,
      m = u == 14 ? DORD[i] : SMIN[k] + i;
      i > 0 ? strcat(#menu, "|");
      m == v ? strcat(#menu, "!");
      strcat(#menu, LBASE[u] + m);
      i += 1;
    );
    gfx_x = sx(x); gfx_y = sy(y + 13);
    sel = gfx_showmenu(#menu);
    sel > 0 ? set_sl_done(k, u == 14 ? DORD[sel - 1] : SMIN[k] + sel - 1);
    mdown = 0; pdown = 0;
  );
  hit && wheel != 0 ? (
    u == 14 ? (
      i = 0; m = 0; loop(27, DORD[i] == v ? m = i; i += 1;);
      set_sl_done(k, DORD[clampg(m + (wheel > 0 ? -1 : 1), 0, 26)]);
    ) : set_sl_done(k, v + (wheel > 0 ? -1 : 1));
  );
  take_hint(hit);
  strlen(label) ? ( fnt(8); col(C_TEXT2); txt(label, x + 4, y - 24, 0); );
  hit ? col(C_HOVER) : col(C_CTRL);
  rr(x, y - 13, w, 26, 5, 1);
  col(C_LINE); rr(x, y - 13, w, 26, 5, 0);
  fnt(2); col(C_TEXT);
  txt(fmt_val(k, sl(k)), x + 13, y, 0);
  acol(acc, 1);
  chevron(x + w - 15, y, 3.5);
);

function counter(x, y, w, k, label) local(v, hl, hr, hm)
(
  v = sl(k);
  hl = inr(x, y - 13, 26, 26); hr = inr(x + w - 26, y - 13, 26, 26);
  hm = inr(x, y - 13, w, 26);
  !nh ? hint(LLAB + k);
  mclick && hl ? set_sl_done(k, v - ((mouse_cap & 8) ? 10 : 1));
  mclick && hr ? set_sl_done(k, v + ((mouse_cap & 8) ? 10 : 1));
  hm && wheel != 0 ? set_sl_done(k, v + (wheel > 0 ? 1 : -1));
  take_hint(hm);
  strlen(label) ? ( fnt(8); col(C_TEXT2); txt(label, x + 4, y - 24, 0); );
  col(C_CTRL); rr(x, y - 13, w, 26, 5, 1);
  col(C_LINE); rr(x, y - 13, w, 26, 5, 0);
  frect(x + 26, y - 13, 1, 26); frect(x + w - 27, y - 13, 1, 26);
  hl ? acol(acc, 1) : col(C_TEXT2);
  ln(x + 9, y, x + 17, y);
  hr ? acol(acc, 1) : col(C_TEXT2);
  ln(x + w - 17, y, x + w - 9, y); ln(x + w - 13, y - 4, x + w - 13, y + 4);
  fnt(3); col(C_TEXT);
  txt(fmt_val(k, sl(k)), x + w / 2, y, 1);
);

function hslider(x, y, w, k, label) local(id, v, nv, hit, hot, t, tx, lw, cx, bip, mid)
(
  id = nid();
  v = sl(k);
  lw = strlen(label) ? 70 : 0;
  tx = x + lw; t = w - lw - 56;
  hit = inr(tx - 8, y - 12, t + 16, 24);
  !nh ? hint(LLAB + k);
  mclick && hit ? (
    dblclick(id) ? set_sl_done(k, SDEF[k]) : ( active = id; active_k = k; drag_x = mx; drag_v = v; );
  );
  active == id && mdown ? (
    mouse_cap |= 65536;
    nv = drag_v + (mx - drag_x) / ((mouse_cap & 4) ? t * 8 : t) * (SMAX[k] - SMIN[k]);
    set_sl(k, nv);
    v = sl(k);
  );
  hit && wheel != 0 && !mdown ? ( set_sl_done(k, v + (wheel > 0 ? 1 : -1)); v = sl(k); );
  hot = hit || active == id;
  take_hint(hot);
  fnt(8); col(C_TEXT2);
  lw ? txt(label, x, y, 0);
  amix(acc, 0.24);
  rr(tx, y - 1.5, t, 3, 1.5, 1);
  bip = SMIN[k] < 0;
  mid = tx + t * (0 - SMIN[k]) / (SMAX[k] - SMIN[k]);
  cx = tx + t * (v - SMIN[k]) / (SMAX[k] - SMIN[k]);
  acol(acc, 1);
  bip ? rr(min(cx, mid), y - 1.5, max(abs(cx - mid), 3), 3, 1.5, 1) : rr(tx, y - 1.5, max(cx - tx, 3), 3, 1.5, 1);
  hot ? col(C_TEXT) : rgba(0.80, 0.81, 0.84, 1); disc(cx, y, hot ? 6.5 : 5.5);
  fnt(2); hot ? acol(acc, 1) : col(C_TEXT);
  txt(fmt_val(k, v), x + w, y, 2);
);

function toggle(x, y, k, label) local(on, hit, w)
(
  on = sl(k) != 0;
  fnt(2);
  w = 36 + txt_w(label);
  hit = inr(x - 2, y - 11, w + 4, 22);
  !nh ? hint(LLAB + k);
  mclick && hit ? ( set_sl_done(k, on ? 0 : 1); on = !on; );
  take_hint(hit);
  on ? acol(acc, 1) : col(C_LINE);
  rr(x, y - 7, 28, 14, 7, 1);
  on ? col(C_TEXT) : col(C_TEXT2);
  disc(on ? x + 21 : x + 7, y, 4.5);
  on || hit ? col(C_TEXT) : col(C_TEXT2);
  txt(label, x + 38, y, 0);
);

function button(x, y, w, h, label, lit) local(hit)
(
  hit = inr(x, y, w, h);
  take_hint(hit);
  lit ? acol(acc, 1) : hit ? col(C_HOVER) : col(C_CTRL);
  rr(x, y, w, h, 5, 1);
  !lit ? (col(C_LINE); rr(x, y, w, h, 5, 0););
  fnt(8);
  lit ? col(C_BG) : col(C_TEXT);
  txt(label, x + w / 2, y + h / 2, 1);
  mclick && hit;
);

function choice_count(list) local(i, n)
(
  n = strlen(list); ch_n = 1;
  i = 0; loop(n, str_getchar(list, i) == 124 ? ch_n += 1; i += 1;);
  ch_n;
);
function choice_str(list, idx, out) local(i, n, c, fxp, start)
(
  n = strlen(list); i = 0; fxp = 0; start = 0;
  strcpy(out, "");
  while (i <= n) (
    c = i < n ? str_getchar(list, i) : 124;
    c == 124 ? (
      fxp == idx ? strcpy_substr(out, list, start, i - start);
      fxp += 1; start = i + 1;
    );
    i += 1;
  );
  out;
);
function pills(x, y, h, list, a) local(i, n, tw, hit, px2)
(
  choice_count(list); n = ch_n;
  px2 = x;
  fnt(7);
  i = 0;
  loop(n,
    choice_str(list, i, #pl);
    tw = txt_w(#pl) + 26;
    hit = inr(px2, y, tw, h);
    mclick && hit ? page = i;
    page == i ? acol(a, 1) : hit ? col(C_HOVER) : col(C_CTRL);
    rr(px2, y, tw, h, 5, 1);
    page == i ? col(C_BG) : col(C_TEXT2);
    txt(#pl, px2 + tw / 2, y + h / 2, 1);
    px2 += tw + 6;
    i += 1;
  );
);

function card(x, y, w, h, title, a)
(
  col(C_CARD); rr(x, y, w, h, 8, 1);
  col(C_LINE); rr(x, y, w, h, 8, 0);
  acc = a;
  acol(a, 1); frect(x + 18, y + 19, 3, 12);
  fnt(3); col(C_TEXT);
  txt(title, x + 28, y + 25, 0);
);
function note_txt(x, y, s) ( fnt(6); col(C_TEXT3); txt(s, x, y, 0); );

function screen(x, y, w, h) local(i)
(
  col(C_SCREEN); rr(x, y, w, h, 6, 1);
  rgba(1, 1, 1, 0.03);
  i = 1; loop(3, frect(x + 8, y + h * i / 4, w - 16, 1); i += 1;);
  i = 1; loop(7, frect(x + w * i / 8, y + 8, 1, h - 16); i += 1;);
);

function draw_scope(x, y, w, h) local(i, st, n, v, px2, py2, kk, pk)
(
  screen(x, y, w, h);
  n = 900;
  st = scope_w - 2 * n;
  i = 0;
  while (i < n && !(SCOPE[(st + i) & 4095] <= 0 && SCOPE[(st + i + 1) & 4095] > 0)) (i += 1;);
  st += i;
  pk = 0.02; i = 0; loop(n, pk = max(pk, abs(SCOPE[(st + i) & 4095])); i += 1;);
  sc_gain = sc_gain * 0.9 + 0.1 / pk;
  kk = 0;
  loop(2,
    kk == 0 ? acol(A_MINT, 0.25) : acol(A_MINT, 1);
    i = 0;
    loop(n / 3,
      v = SCOPE[(st + i * 3) & 4095];
      px2 = x + 8 + (w - 16) * i / (n / 3 - 1);
      py2 = y + h / 2 - clampg(v * sc_gain * 0.9, -1, 1) * (h / 2 - 10) + (kk == 0 ? 1.5 : 0);
      i == 0 ? (gfx_x = sx(px2); gfx_y = sy(py2);) : gfx_lineto(sx(px2), sy(py2), 1);
      i += 1;
    );
    kk += 1;
  );
);

function white_note(i) local(d) ( d = i % 7; floor(i / 7) * 12 + (d == 0 ? 0 : d == 1 ? 2 : d == 2 ? 4 : d == 3 ? 5 : d == 4 ? 7 : d == 5 ? 9 : 11); );
function black_slot(pc) ( pc == 1 ? 1 : pc == 3 ? 2 : pc == 6 ? 4 : pc == 8 ? 5 : pc == 10 ? 6 : 0; );

function gq_push(a, b, c) (
  GQ[(gq_w & 255) * 3] = a; GQ[(gq_w & 255) * 3 + 1] = b; GQ[(gq_w & 255) * 3 + 2] = c;
  gq_w += 1;
);

function keyboard(x, y, w, h, base, oct) local(nw, ww, i, n, kx, pc, hitn, bw, bh, on)
(
  nw = oct * 7 + 1; ww = w / nw;
  bw = ww * 0.62; bh = h * 0.6;
  hitn = -1;
  i = 0;
  loop(oct * 12,
    pc = i % 12;
    black_slot(pc) ? (
      kx = x + (floor(i / 12) * 7 + black_slot(pc)) * ww - bw / 2;
      inr(kx, y, bw, bh) ? hitn = base + i;
    );
    i += 1;
  );
  hitn < 0 ? (i = 0; loop(nw, inr(x + i * ww, y, ww, h) ? hitn = base + white_note(i); i += 1;););
  mclick && hitn >= 0 ? (gq_push(144, hitn, 100); g_kb_note = hitn;);
  mdown && g_kb_note >= 0 && hitn >= 0 && hitn != g_kb_note ? (gq_push(128, g_kb_note, 0); gq_push(144, hitn, 100); g_kb_note = hitn;);
  !mdown && g_kb_note >= 0 ? (gq_push(128, g_kb_note, 0); g_kb_note = -1;);
  i = 0;
  loop(nw,
    n = base + white_note(i);
    on = KEYF[n] > 0 || n == g_kb_note;
    on ? acol(A_MINT, 1) : rgba(0.86, 0.87, 0.89, 1);
    rr(x + i * ww + 1, y, ww - 2, h, 3, 1);
    i % 7 == 0 ? (fnt(6); col(C_TEXT3); sprintf(#kn, "C%d", floor(n / 12) - 1); txt(#kn, x + i * ww + ww / 2, y + h - 12, 1););
    i += 1;
  );
  i = 0;
  loop(oct * 12,
    n = base + i; pc = i % 12;
    black_slot(pc) ? (
      kx = x + (floor(i / 12) * 7 + black_slot(pc)) * ww - bw / 2;
      KEYF[n] > 0 || n == g_kb_note ? acol(A_MINT, 1) : rgba(0.10, 0.105, 0.12, 1);
      rr(kx, y, bw, bh, 2.5, 1);
    );
    i += 1;
  );
  i = 0; loop(128, KEYF[i] = max(0, KEYF[i] - 0.05); i += 1;);
);

function notename_g(n) local(o, kk) (
  o = floor(n / 12) - 1; kk = n - 12 * floor(n / 12);
  sprintf(#gnn, "%s%d", kk == 0 ? "C" : kk == 1 ? "C#" : kk == 2 ? "D" : kk == 3 ? "D#" : kk == 4 ? "E" : kk == 5 ? "F" : kk == 6 ? "F#" : kk == 7 ? "G" : kk == 8 ? "G#" : kk == 9 ? "A" : kk == 10 ? "A#" : "B", o);
  #gnn;
);

function load_preset_gui(n) local(kk) (
  preset_to_sliders_g(n, GPTMP);
  seq_cur = n;
  kk = 1; loop(NSL, automate(kk, 0); automate(kk, 1); kk += 1;);
);

function pre_name(i, out) local(c, n) (
  strcpy(out, "        ");
  c = 0; loop(8, str_setchar(out, c, max(32, PRE[i * 132 + c])); c += 1;);
  n = 8; while (n > 1 && str_getchar(out, n - 1) == 32) ( n -= 1; );
  str_setlen(out, n);
  out;
);
function pre_cat(i) local(c, r) (
  r = 0; c = 0;
  loop(NCAT, i >= CATS[c] ? r = c; c += 1;);
  r;
);
function patch_menu() local(c, i, last, pos, gj) (
  strcpy(#menu, "");
  pos = 0;
  c = 0;
  loop(NCAT,
    c > 0 ? strcat(#menu, "|");
    strcat(#menu, ">");
    strcat(#menu, CATN + c);
    last = c == NCAT - 1 ? npre : CATS[c + 1];
    i = CATS[c];
    while (i < last) (
      strcat(#menu, "|");
      i == last - 1 ? strcat(#menu, "<");
      i == pre_cur ? strcat(#menu, "!");
      pre_name(i, #mn);
      gj = 0; loop(strlen(#mn), str_getchar(#mn, gj) == 124 ? str_setchar(#mn, gj, 47); gj += 1;);
      strcat(#menu, #mn);
      pos += 1; GMMAP[pos] = i;
      i += 1;
    );
    c += 1;
  );
  gm_n = pos;
);

function load_seq_gui(n) local(b, st, len, gk2, sa, sb) (
  b = PRE + n * 132 + 100;
  len = 16;
  st = 0;
  loop(16,
    sa = STEPK + st * 2; sb = sa + 1;
    slider(sa) = b[st * 2];
    slider(sb) = b[st * 2 + 1];
    (len == 16 && b[st * 2] == 0 && b[st * 2 + 1] == 0) ? len = st;
    st += 1;
  );
  sa = 87;
  slider(sa) = max(1, len);
  gk2 = 0;
  loop(32, automate(STEPK + gk2, 0); automate(STEPK + gk2, 1); gk2 += 1;);
  automate(87, 0); automate(87, 1);
  seq_cur = n;
);

function clear_seq_gui() local(st, sa, sb) (
  st = 0;
  loop(16,
    sa = STEPK + st * 2; sb = sa + 1;
    slider(sa) = 48;
    slider(sb) = 64;
    automate(sa, 0); automate(sa, 1);
    automate(sb, 0); automate(sb, 1);
    st += 1;
  );
  seq_cur = -1;
);

function seq_menu() local(c, i, last, pos, gj) (
  strcpy(#menu, "");
  pos = 0;
  c = 0;
  loop(NCAT,
    c > 0 ? strcat(#menu, "|");
    strcat(#menu, ">");
    strcat(#menu, CATN + c);
    last = c == NCAT - 1 ? npre : CATS[c + 1];
    i = CATS[c];
    while (i < last) (
      strcat(#menu, "|");
      i == last - 1 ? strcat(#menu, "<");
      i == seq_cur ? strcat(#menu, "!");
      pre_name(i, #mn);
      gj = 0; loop(strlen(#mn), str_getchar(#mn, gj) == 124 ? str_setchar(#mn, gj, 47); gj += 1;);
      strcat(#menu, #mn);
      pos += 1; GSMAP[pos] = i;
      i += 1;
    );
    c += 1;
  );
  gs_n = pos;
);

function seq_loader(x, y, w) local(hit, sel)
(
  hit = inr(x, y - 13, w, 26);
  hint("Load the 16 steps of a factory sequence (the sound is not changed)");
  take_hint(hit);
  fnt(8); col(C_TEXT2); txt("Load steps", x + 4, y - 24, 0);
  hit ? col(C_HOVER) : col(C_CTRL);
  rr(x, y - 13, w, 26, 5, 1);
  col(C_LINE); rr(x, y - 13, w, 26, 5, 0);
  fnt(2); col(C_TEXT);
  seq_cur >= 0 ? ( pre_name(seq_cur, #sqn); ) : strcpy(#sqn, "Choose...");
  txt(#sqn, x + 13, y, 0);
  acol(acc, 1); chevron(x + w - 15, y, 3.5);
  mclick && hit && npre > 0 ? (
    seq_menu();
    gfx_x = sx(x); gfx_y = sy(y + 13);
    sel = gfx_showmenu(#menu);
    (sel > 0 && sel <= gs_n) ? load_seq_gui(GSMAP[sel]);
    mdown = 0; pdown = 0;
  );
);

function logo(x, y) local(i, px2, py2)
(
  col(C_LINE); ring(x, y, 16); ring(x, y, 15.5);
  acol(A_LEMON, 1);
  i = 0;
  loop(23,
    px2 = x - 11 + i;
    py2 = y + 5 - (i % 8) * 1.45;
    i == 0 || (i % 8) == 0 ? (gfx_x = sx(px2); gfx_y = sy(py2);) : (gfx_lineto(sx(px2), sy(py2), 1); gfx_lineto(sx(px2), sy(py2) + 1, 1););
    i += 1;
  );
);

function topbar() local(i, sel, v)
(
  col(C_CARD); frect(0, 0, CANVW, 70);
  col(C_LINE); frect(0, 70, CANVW, 1);
  logo(44, 35);
  fnt(4); col(C_TEXT); txt("HOME TRUTHS", 70, 29, 0);
  fnt(6); col(C_TEXT3); txt("8-BIT MONOSYNTH  ·  SHRUTHI-1 + DSP BOARD", 71, 49, 0);
  hint("Click to pick a factory patch (with its sequence). The arrows step through them.");
  i = inr(450, 13, 360, 44);
  take_hint(i);
  i ? col(C_HOVER) : col(C_CTRL); rr(450, 13, 360, 44, 6, 1);
  col(C_LINE); rr(450, 13, 360, 44, 6, 0);
  fnt(5); col(C_TEXT);
  pre_cur >= 0 ? pre_name(pre_cur, #pname) : strcpy(#pname, "init");
  txt(#pname, 630, 29, 1);
  fnt(6); acol(A_LEMON, 1);
  pre_cur >= 0 ? ( sprintf(#pk, "Factory %03d  ·  ", pre_cur + 1); strcat(#pk, CATN + pre_cat(pre_cur)); ) : strcpy(#pk, "Starting point");
  txt(#pk, 630, 47, 1);
  inr(754, 17, 26, 36) ? col(C_TEXT) : col(C_TEXT2);
  ln(766, 29, 772, 35); ln(772, 35, 766, 41);
  inr(480, 17, 26, 36) ? col(C_TEXT) : col(C_TEXT2);
  ln(494, 29, 488, 35); ln(488, 35, 494, 41);
  mclick && npre > 0 ? (
    inr(480, 17, 26, 36) ? load_preset_gui(pre_cur <= 0 ? npre - 1 : pre_cur - 1)
    : inr(754, 17, 26, 36) ? load_preset_gui(pre_cur >= npre - 1 || pre_cur < 0 ? 0 : pre_cur + 1)
    : inr(450, 13, 360, 44) ? (
      patch_menu();
      gfx_x = sx(450); gfx_y = sy(57);
      sel = gfx_showmenu(#menu);
      (sel > 0 && sel <= gm_n && GMMAP[sel] >= 0) ? load_preset_gui(GMMAP[sel]);
      mdown = 0; pdown = 0;
    );
  );
  acc = A_LILAC;
  hint("Output level. 0 dB is the original DAC level.");
  knob(1000, 33, 17, OUTK, "");
  fnt(6); col(C_TEXT3); txt("OUTPUT", 1000, 62, 1);
  v = clampg((20 * log10(max(meter_pk, 0.00001)) + 60) / 60, 0, 1);
  col(C_CTRL); rr(1040, 14, 5, 42, 2, 1);
  v > 0.99 ? acol(A_PINK, 1) : acol(A_MINT, 1);
  v > 0.02 ? rr(1040, 14 + 42 * (1 - v), 5, 42 * v, 2, 1);
  pills(24, 82, 34, "Play|Oscillators|Filter & FX|Envelopes & LFOs|Modulation|Sequencer|Settings", A_LEMON);
);

function hintbar() local(s)
(
  col(C_LINE); frect(24, 690, 1052, 1);
  acol(A_MINT, 1); disc(30, 704, 2.5);
  fnt(2); col(C_TEXT2);
  s = cur_hint ? cur_hint
    : page == 0 ? "Pick a patch at the top, then play the keyboard or your MIDI controller. Double-click a knob to reset it."
    : page == 1 ? "Two oscillators with 35 shapes, combined by the operator, plus a sub oscillator and noise."
    : page == 2 ? "The DSP board's filter and VCA, then one of 16 effects in the order set by Routing."
    : page == 3 ? "Envelope 1 usually opens the filter, envelope 2 the VCA. LFO rates below 16 lock to the sequencer clock."
    : page == 4 ? "Twelve routes from any source to any destination. The last row is scaled by the mod wheel."
    : page == 5 ? "Step: notes play directly. Arpeggiator: hold a chord. Sequencer: hold a key to transpose the pattern."
    : "How the synth responds to your keyboard. MIDI CCs follow the Shruthi-1 manual.";
  txt(s, 40, 704, 0);
);

function quick(cx, cy, a, k, label, sub)
(
  acc = a;
  knob(cx, cy, 38, k, label);
  fnt(6); col(C_TEXT3); txt(sub, cx, cy + 38 + 40, 1);
);

function fx_names(fxp, which)
(
  fxp == 0 ? (which ? "Fuzz" : "Fold")
  : fxp == 1 ? (which ? "Bits" : "Rate")
  : fxp == 2 || fxp == 3 ? (which ? "Feedback" : "Delay")
  : fxp == 4 ? (which ? "Mix" : "Frequency")
  : fxp >= 5 && fxp <= 9 ? (which ? "Level" : "Time")
  : fxp >= 10 && fxp <= 13 ? (which ? "Level" : "Feedback")
  : fxp == 14 ? (which ? "Rec/Play" : "Pitch")
  : (which ? "Mix" : "Pitch");
);

function page_play() local(cx, cy, sp)
(
  card(24, 122, 1052, 364, "Quick controls", A_PINK);
  note_txt(200, 147, "each knob is a Shruthi parameter, named underneath");
  sp = 263; cx = 24 + sp / 2; cy = 224;
  hint("Opens or closes the DSP board's filter");
  quick(cx, cy, A_SKY, 13, "Brightness", "filter cutoff"); cx += sp;
  hint("Adds a peak at the cutoff; high values ring and distort");
  quick(cx, cy, A_SKY, 14, "Resonance", "filter resonance"); cx += sp;
  hint("How far envelope 1 sweeps the filter");
  quick(cx, cy, A_PEACH, 15, "Sweep", "env 1 > filter"); cx += sp;
  hint("Balance between oscillator 1 and oscillator 2");
  quick(cx, cy, A_LEMON, 9, "Blend", "osc 1 / osc 2 mix");
  cx = 24 + sp / 2; cy = 376;
  hint("How slowly notes fade in (envelope 2 drives the VCA)");
  quick(cx, cy, A_PINK, 21, "Attack", "env 2 attack"); cx += sp;
  hint("How long notes ring after you let go");
  quick(cx, cy, A_PINK, 24, "Release", "env 2 release"); cx += sp;
  hint("First control of the selected effect");
  quick(cx, cy, A_LILAC, 71, fx_names(sl(70), 0), "effect parameter 1"); cx += sp;
  hint("Glide between notes");
  quick(cx, cy, A_MINT, 123, "Glide", "portamento");

  card(24, 498, 1052, 188, "Try it", A_MINT);
  draw_scope(40, 534, 280, 138);
  hint("Click and drag across the keys to play. Your MIDI keyboard works too.");
  take_hint(inr(336, 534, 724, 138));
  keyboard(336, 534, 724, 138, kb_base, 3);
  fnt(8); col(C_TEXT2); txt("Octave", 900, 515, 0);
  acc = A_MINT;
  hint("Shift the on-screen keyboard down an octave");
  button(960, 503, 44, 24, "-", 0) && kb_base > 12 ? kb_base -= 12;
  hint("Shift the on-screen keyboard up an octave");
  button(1012, 503, 44, 24, "+", 0) && kb_base < 84 ? kb_base += 12;
);

function page_osc() local(x)
(
  x = 24;
  card(x, 122, 340, 330, "Oscillator 1", A_LEMON);
  hint("Waveform or synthesis algorithm of oscillator 1");
  choice(x + 24, 200, 292, 1, "Shape");
  hint("How oscillator 1 combines with oscillator 2 (sync, ring mod, fuzz, bit tricks...)");
  choice(x + 24, 266, 292, 4, "Operator");
  hint("Shape parameter: pulse width, timbre, wavetable position...");
  knob(x + 100, 350, 30, 2, "Parameter");
  hint("Coarse tuning in semitones");
  knob(x + 240, 350, 30, 3, "Range");
  x = 380;
  card(x, 122, 340, 330, "Oscillator 2", A_LEMON);
  hint("Waveform or synthesis algorithm of oscillator 2");
  choice(x + 24, 200, 292, 5, "Shape");
  knob(x + 70, 350, 30, 6, "Parameter");
  knob(x + 170, 350, 30, 7, "Range");
  hint("Fine detune against oscillator 1");
  knob(x + 270, 350, 30, 8, "Detune");
  x = 736;
  card(x, 122, 340, 330, "Mixer", A_PEACH);
  hint("Sub oscillator (an octave or two below osc 1) or a transient click at note start");
  choice(x + 24, 200, 292, 12, "Sub oscillator");
  hint("Balance between oscillator 1 and oscillator 2");
  knob(x + 70, 350, 30, 9, "Osc 1/2");
  knob(x + 170, 350, 30, 10, "Sub");
  knob(x + 270, 350, 30, 11, "Noise");
  card(24, 464, 1052, 222, "How the oscillators work", A_SKY);
  note_txt(48, 524, "Each oscillator is an 8-bit wavetable or algorithm running at the Shruthi's 39.2 kHz rate, aliasing included.");
  note_txt(48, 550, "The operator sets how oscillator 1 meets oscillator 2: Sum mixes them, Sync resets osc 2 from osc 1, Ring mod, Xor,");
  note_txt(48, 576, "Fuzz and Fold distort the pair, Crush and Bits reduce resolution, Duophonic plays two notes, Ping-pong alternates.");
  note_txt(48, 602, "Range transposes in semitones; with FM the range picks the modulator ratio instead.");
  note_txt(48, 628, "Sub shapes 1 sit one octave down, shapes 2 two octaves down; Click to Pop are percussive transients.");
);

function page_filter() local(x, fxp)
(
  card(24, 122, 516, 300, "Filter + VCA", A_SKY);
  hint("Filter cutoff (keyboard tracking is built in)");
  knob(100, 240, 32, 13, "Cutoff");
  knob(220, 240, 32, 14, "Resonance");
  hint("How much envelope 1 opens the filter");
  knob(340, 240, 32, 15, "Env 1 amount");
  hint("How much LFO 2 moves the filter");
  knob(460, 240, 32, 16, "LFO 2 amount");
  note_txt(48, 340, "DSP board filter: 3-pole, 18 dB/oct, low-pass or high-pass.");
  note_txt(48, 364, "The VCA after it is driven by the modulation matrix (env 2 by default).");
  card(552, 122, 524, 300, "DSP board effect", A_LILAC);
  hint("Order of filter and effect: LP or HP filter first, effect first, or effect only");
  choice(576, 200, 226, 69, "Routing");
  hint("One of the DSP board's 16 effects");
  choice(826, 200, 226, 70, "Effect");
  fxp = sl(70);
  hint("First control of the selected effect");
  knob(700, 300, 32, 71, fx_names(fxp, 0));
  hint("Second control of the selected effect");
  knob(920, 300, 32, 72, fx_names(fxp, 1));
  card(24, 434, 1052, 252, "About the effect", A_LILAC);
  fxp == 0 ? ( note_txt(48, 494, "Distortion: Fold wavefolds the signal, Fuzz adds a hard clipping curve."); )
  : fxp == 1 ? ( note_txt(48, 494, "Bit crusher: Rate holds samples (decimation), Bits removes resolution from 12 bits down to 1."); )
  : fxp == 2 || fxp == 3 ? ( note_txt(48, 494, "Comb filter: a short delay with positive or negative feedback, for metallic and flanged tones."); )
  : fxp == 4 ? ( note_txt(48, 494, "Ring modulator: multiplies the signal by a sine wave; Frequency sets the carrier, Mix the blend."); )
  : fxp >= 5 && fxp <= 7 ? ( note_txt(48, 494, "Delay: up to 1280 8-bit samples of echo; the feedback and dub versions repeat longer."); )
  : fxp == 8 || fxp == 9 ? ( note_txt(48, 494, "Crushed delays: the echo is written without filtering, so it gets grittier with each repeat."); )
  : fxp >= 10 && fxp <= 13 ? ( note_txt(48, 494, "Tempo delays: the delay time follows the tempo (or the host tempo when Tempo is set to Host)."); )
  : fxp == 14 ? ( note_txt(48, 494, "Looper: below half of Rec/Play it records, above half it plays the loop back; Pitch transposes it."); )
  : ( note_txt(48, 494, "Pitch shifter: a granular pitch shifter blended with the dry signal."); );
  note_txt(48, 526, "Parameter 2 is also a modulation destination (CV 2), and parameter 1 is CV 1, so effects can be modulated.");
);

function env_shape(x, y, w, h, kb) local(a, d, s, r, tot, px1, px2, px3, px4, sy2)
(
  screen(x, y, w, h);
  a = sl(kb) + 4; d = sl(kb + 1) + 4; s = sl(kb + 2) / 127; r = sl(kb + 3) + 4;
  tot = a + d + 40 + r;
  px1 = x + 10 + (w - 20) * a / tot;
  px2 = px1 + (w - 20) * d / tot;
  px3 = px2 + (w - 20) * 40 / tot;
  px4 = x + w - 10;
  sy2 = y + h - 10 - (h - 20) * s;
  acol(acc, 1);
  thick_line(x + 10, y + h - 10, px1, y + 10, 2);
  thick_line(px1, y + 10, px2, sy2, 2);
  thick_line(px2, sy2, px3, sy2, 2);
  thick_line(px3, sy2, px4, y + h - 10, 2);
);

function page_envlfo() local(x, y, e, l, kb)
(
  e = 0;
  loop(2,
    x = 24 + e * 536; kb = 17 + e * 4;
    card(x, 122, 516, 276, e ? "Envelope 2" : "Envelope 1", A_PINK);
    env_shape(x + 24, 160, 468, 86, kb);
    knob(x + 76, 310, 28, kb, "Attack");
    knob(x + 196, 310, 28, kb + 1, "Decay");
    knob(x + 316, 310, 28, kb + 2, "Sustain");
    knob(x + 436, 310, 28, kb + 3, "Release");
    e += 1;
  );
  l = 0;
  loop(2,
    x = 24 + l * 536; kb = 25 + l * 4;
    card(x, 410, 516, 276, l ? "LFO 2" : "LFO 1", A_LILAC);
    hint("LFO waveform: basic shapes, the step sequencer, or 16 wavetable shapes");
    choice(x + 24, 490, 220, kb, "Wave");
    hint("Free runs on its own, Slave restarts on each note, Master retriggers the envelope, One shot runs once");
    choice(x + 24, 558, 220, kb + 3, "Mode");
    hint("LFO speed; values below 16 lock to the sequencer clock");
    knob(x + 320, 530, 32, kb + 1, "Rate");
    hint("How long the LFO takes to fade in after each note");
    knob(x + 440, 530, 32, kb + 2, "Attack");
    l += 1;
  );
);

function page_mod() local(r, x, y)
(
  card(24, 122, 720, 564, "Modulation matrix", A_MINT);
  fnt(8); col(C_TEXT2);
  txt("Source", 76, 172, 0); txt("Destination", 290, 172, 0); txt("Amount", 504, 172, 0);
  r = 0;
  loop(12,
    y = 204 + r * 38;
    fnt(9); col(C_TEXT3);
    sprintf(#rn, "%d", r + 1);
    txt(#rn, 52, y, 1);
    hint("Where this modulation comes from");
    choice(70, y, 200, 33 + r * 3, "");
    hint("What it changes");
    choice(284, y, 200, 34 + r * 3, "");
    hint(r == 11 ? "Depth (and polarity); this row is scaled by the mod wheel" : "Depth and polarity of this route");
    hslider(500, y, 228, 35 + r * 3, "");
    r += 1;
  );
  card(756, 122, 320, 564, "Operators", A_SKY);
  note_txt(780, 168, "combine two sources; the results");
  note_txt(780, 188, "appear as Op 1 and Op 2 sources");
  r = 0;
  loop(2,
    y = 250 + r * 206;
    fnt(3); col(C_TEXT); sprintf(#rn, "Operator %d", r + 1); txt(#rn, 780, y - 22, 0);
    hint("First input");
    choice(780, y + 34, 272, 73 + r * 3, "In 1");
    hint("Second input");
    choice(780, y + 94, 272, 74 + r * 3, "In 2");
    hint("How the two inputs combine: add, multiply, max, min, xor, compare, quantise, lag");
    choice(780, y + 154, 272, 75 + r * 3, "Type");
    r += 1;
  );
);

function step_col(n, x, y) local(ka, kb, a, b, gate, leg, note, vel, ctl, hot, playing, hy, nv, d)
(
  ka = STEPK + n * 2; kb = ka + 1;
  a = sl(ka); b = sl(kb);
  gate = a & 128; note = a & 127; leg = b & 128; vel = (b >> 4) & 7; ctl = b & 15;
  playing = p_running && SQ[0] != 0 && ((p_step + SQ[9]) & 15) == n;
  hot = inr(x, y, 56, 330);
  playing ? amix(A_LEMON, 0.22) : hot ? col(C_HOVER) : col(C_CTRL);
  rr(x, y, 56, 330, 6, 1);
  n >= SQ[8] ? ( rgba(0, 0, 0, 0.45); rr(x, y, 56, 330, 6, 1); );
  fnt(9); col(C_TEXT3); sprintf(#sn, "%d", n + 1); txt(#sn, x + 28, y + 16, 1);
  gate ? acol(leg ? A_PEACH : A_LEMON, 1) : col(C_LINE);
  rr(x + 6, y + 30, 44, 24, 5, 1);
  fnt(9); gate ? col(C_BG) : col(C_TEXT2);
  txt(gate ? (leg ? "tie" : "on") : "rest", x + 28, y + 42, 1);
  inr(x + 6, y + 30, 44, 24) ? (
    hint("Click: rest > on > tie (legato into the next step)");
    take_hint(1);
    mclick ? (
      !gate ? ( set_sl_done(ka, a | 128); set_sl_done(kb, b & 127); )
      : !leg ? set_sl_done(kb, b | 128)
      : ( set_sl_done(ka, a & 127); set_sl_done(kb, b & 127); );
    );
  );
  fnt(8); col(C_TEXT);
  txt(notename_g(note), x + 28, y + 76, 1);
  hy = inr(x, y + 62, 56, 28);
  hy ? (
    hint("Note: drag up/down or use the wheel");
    take_hint(1);
    mclick ? ( active = 2000 + n; active_k = ka; drag_y = my; drag_v = note; );
    wheel != 0 ? set_sl_done(ka, (a & 128) | clampg(note + (wheel > 0 ? 1 : -1), 0, 127));
  );
  active == 2000 + n && mdown ? (
    mouse_cap |= 65536;
    nv = clampg(drag_v + floor((drag_y - my) / 4), 0, 127);
    set_sl(ka, (a & 128) | nv);
  );
  rgba(1, 1, 1, 0.05); rr(x + 12, y + 100, 32, 100, 3, 1);
  acol(A_PINK, 1); rr(x + 12, y + 100 + 100 * (1 - vel / 7), 32, max(3, 100 * vel / 7), 3, 1);
  inr(x + 6, y + 96, 44, 108) ? (
    hint("Velocity: click or drag in the bar");
    take_hint(1);
    mclick ? ( active = 3000 + n; active_k = kb; );
    wheel != 0 ? set_sl_done(kb, (b & 143) | (clampg(vel + (wheel > 0 ? 1 : -1), 0, 7) << 4));
  );
  active == 3000 + n && mdown ? (
    d = clampg(floor((y + 200 - my) / 100 * 7 + 0.5), 0, 7);
    set_sl(kb, (b & 143) | (d << 4));
  );
  fnt(9); col(C_TEXT3); sprintf(#sn, "v%d", vel); txt(#sn, x + 28, y + 212, 1);
  rgba(1, 1, 1, 0.05); rr(x + 12, y + 226, 32, 76, 3, 1);
  acol(A_SKY, 1); rr(x + 12, y + 226 + 76 * (1 - ctl / 15), 32, max(3, 76 * ctl / 15), 3, 1);
  inr(x + 6, y + 222, 44, 84) ? (
    hint("Step value (Step seq mod source): click or drag in the bar");
    take_hint(1);
    mclick ? ( active = 4000 + n; active_k = kb; );
    wheel != 0 ? set_sl_done(kb, (b & 240) | clampg(ctl + (wheel > 0 ? 1 : -1), 0, 15));
  );
  active == 4000 + n && mdown ? (
    d = clampg(floor((y + 302 - my) / 76 * 15 + 0.5), 0, 15);
    set_sl(kb, (b & 240) | d);
  );
  fnt(9); col(C_TEXT3); sprintf(#sn, "c%d", ctl); txt(#sn, x + 28, y + 316, 1);
);

function page_seq() local(i)
(
  card(24, 122, 1052, 170, "Sequencer / arpeggiator", A_LEMON);
  hint("Step plays notes directly; Arpeggiator plays held chords; Sequencer plays the pattern, transposed by the key you hold");
  choice(48, 202, 170, 79, "Mode");
  hint("Tempo of the internal clock, or Host to follow the REAPER transport");
  counter(238, 202, 130, 80, "Tempo");
  hint("Note length of each step");
  choice(388, 202, 110, 86, "Division");
  hint("Groove template");
  choice(518, 202, 130, 81, "Groove");
  hint("Groove amount");
  counter(668, 202, 110, 82, "Groove amount");
  hint("Number of steps in the pattern");
  counter(798, 202, 110, 87, "Length");
  hint("Rotates the start of the pattern");
  counter(928, 202, 110, 88, "Rotate");
  hint("Arpeggio direction");
  choice(48, 264, 170, 83, "Arp direction");
  hint("Octaves the arpeggio spans");
  counter(238, 264, 130, 84, "Arp range");
  hint("Rhythm pattern for the arpeggio; Sequence uses the gates below");
  choice(388, 264, 260, 85, "Arp pattern");
  seq_loader(668, 264, 260);
  hint("Clear all steps (rests on C3)");
  button(948, 251, 90, 26, "Clear", 0) ? clear_seq_gui();
  card(24, 304, 1052, 382, "Steps", A_LEMON);
  i = 0;
  loop(16,
    step_col(i, 44 + i * 64, 344);
    i += 1;
  );
);

function page_set()
(
  card(24, 122, 516, 300, "Playing", A_MINT);
  hint("Transposes the whole synth in octaves");
  counter(48, 200, 130, 121, "Octave");
  hint("Microtonal tuning: equal temperament, just, Pythagorean, quarter tones and Indian ragas");
  choice(200, 200, 300, 122, "Raga");
  hint("Fine tuning in 1/128 semitone steps");
  counter(48, 270, 130, 125, "Master tuning");
  hint("Glide time between notes");
  knob(280, 330, 32, 123, "Portamento");
  hint("Legato: overlapping notes glide without retriggering the envelopes");
  toggle(370, 290, 124, "Legato");
  card(560, 122, 516, 564, "MIDI", A_SKY);
  note_txt(584, 170, "Notes, velocity, pitch bend, aftertouch, mod wheel, hold pedal.");
  note_txt(584, 198, "Program change 1-128 picks factory patches 1-128.");
  note_txt(584, 250, "CCs follow the Shruthi-1 manual, e.g. 74 cutoff, 71 resonance,");
  note_txt(584, 274, "20-31 oscillators and mixer, 102-119 envelopes and LFOs,");
  note_txt(584, 298, "73/72 env 2 attack/release, 5 portamento, 68 legato.");
  note_txt(584, 326, "NRPN reaches every parameter, as on the hardware.");
  note_txt(584, 354, "CC 16, 17, 2 (breath), 4 (pedal) are mod sources.");
  note_txt(584, 382, "MIDI clock and the REAPER transport drive the");
  note_txt(584, 406, "sequencer when Tempo is set to Host.");
  note_txt(584, 446, "MIDI note 0 is silent, as on the hardware.");
  card(24, 434, 516, 252, "About", A_LILAC);
  note_txt(48, 494, "Mutable Instruments Shruthi-1 by Emilie Gillet:");
  note_txt(48, 518, "the firmware voice and the digital DSP filter board,");
  note_txt(48, 542, "ported from the original source (GPLv3) and checked");
  note_txt(48, 566, "sample for sample against both firmwares.");
);

z = min(gfx_w / CANVW, gfx_h / CANVH);
ox = floor((gfx_w - CANVW * z) / 2);
oy = 0;
gfx_gradrect(0, 0, gfx_w, gfx_h, 0.067, 0.073, 0.086, 1, 0, 0, 0, 0, -0.02 / max(gfx_h, 1), -0.02 / max(gfx_h, 1), -0.024 / max(gfx_h, 1), 0);
ui_frame_begin();
topbar();
page == 0 ? page_play()
: page == 1 ? page_osc()
: page == 2 ? page_filter()
: page == 3 ? page_envlfo()
: page == 4 ? page_mod()
: page == 5 ? page_seq()
: page_set();
hintbar();
ui_frame_end();
