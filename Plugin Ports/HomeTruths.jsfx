  OFFMAP[168] = 11; OFFMAP[169] = 0; OFFMAP[170] = 26;
  OFFMAP[172] = 2; OFFMAP[173] = 193; OFFMAP[174] = 63;
  OFFMAP[176] = 10; OFFMAP[177] = 0; OFFMAP[178] = 27;
  OFFMAP[180] = 11; OFFMAP[181] = 0; OFFMAP[182] = 26;
  OFFMAP[184] = 2; OFFMAP[185] = 193; OFFMAP[186] = 63;
  OFFMAP[188] = 10; OFFMAP[189] = 0; OFFMAP[190] = 27;
  OFFMAP[192] = 11; OFFMAP[193] = 0; OFFMAP[194] = 26;
  OFFMAP[196] = 2; OFFMAP[197] = 193; OFFMAP[198] = 63;
  OFFMAP[200] = 10; OFFMAP[201] = 0; OFFMAP[202] = 27;
  OFFMAP[204] = 11; OFFMAP[205] = 0; OFFMAP[206] = 26;
  OFFMAP[208] = 2; OFFMAP[209] = 193; OFFMAP[210] = 63;
  OFFMAP[212] = 10; OFFMAP[213] = 0; OFFMAP[214] = 27;
  OFFMAP[216] = 11; OFFMAP[217] = 0; OFFMAP[218] = 26;
  OFFMAP[220] = 2; OFFMAP[221] = 193; OFFMAP[222] = 63;
  OFFMAP[224] = 10; OFFMAP[225] = 0; OFFMAP[226] = 27;
  OFFMAP[228] = 11; OFFMAP[229] = 0; OFFMAP[230] = 26;
  OFFMAP[232] = 2; OFFMAP[233] = 193; OFFMAP[234] = 63;
  OFFMAP[236] = 10; OFFMAP[237] = 0; OFFMAP[238] = 27;
  OFFMAP[240] = 11; OFFMAP[241] = 0; OFFMAP[242] = 26;
  OFFMAP[244] = 2; OFFMAP[245] = 193; OFFMAP[246] = 63;
  OFFMAP[248] = 10; OFFMAP[249] = 0; OFFMAP[250] = 27;
  OFFMAP[252] = 11; OFFMAP[253] = 0; OFFMAP[254] = 26;
  OFFMAP[256] = 2; OFFMAP[257] = 193; OFFMAP[258] = 63;
  OFFMAP[260] = 10; OFFMAP[261] = 0; OFFMAP[262] = 27;
  OFFMAP[264] = 11; OFFMAP[265] = 0; OFFMAP[266] = 26;
  OFFMAP[268] = 2; OFFMAP[269] = 193; OFFMAP[270] = 63;
  OFFMAP[336] = 0; OFFMAP[337] = 0; OFFMAP[338] = 127;
  OFFMAP[340] = 1; OFFMAP[341] = 0; OFFMAP[342] = 63;
  OFFMAP[368] = 1; OFFMAP[369] = 0; OFFMAP[370] = 15;
  OFFMAP[372] = 1; OFFMAP[373] = 0; OFFMAP[374] = 15;
  OFFMAP[376] = 10; OFFMAP[377] = 0; OFFMAP[378] = 31;
  OFFMAP[380] = 10; OFFMAP[381] = 0; OFFMAP[382] = 31;
  OFFMAP[384] = 26; OFFMAP[385] = 0; OFFMAP[386] = 9;
  OFFMAP[388] = 10; OFFMAP[389] = 0; OFFMAP[390] = 31;
  OFFMAP[392] = 10; OFFMAP[393] = 0; OFFMAP[394] = 31;
  OFFMAP[396] = 26; OFFMAP[397] = 0; OFFMAP[398] = 9;
  OFFMAP[400] = 16; OFFMAP[401] = 0; OFFMAP[402] = 2;
  OFFMAP[404] = 14; OFFMAP[405] = 39; OFFMAP[406] = 240;
  OFFMAP[408] = 18; OFFMAP[409] = 0; OFFMAP[410] = 5;
  OFFMAP[412] = 0; OFFMAP[413] = 0; OFFMAP[414] = 127;
  OFFMAP[416] = 12; OFFMAP[417] = 0; OFFMAP[418] = 4;
  OFFMAP[420] = 2; OFFMAP[421] = 1; OFFMAP[422] = 4;
  OFFMAP[424] = 19; OFFMAP[425] = 0; OFFMAP[426] = 15;
  OFFMAP[428] = 17; OFFMAP[429] = 0; OFFMAP[430] = 11;
  OFFMAP[432] = 1; OFFMAP[433] = 1; OFFMAP[434] = 16;
  OFFMAP[436] = 1; OFFMAP[437] = 0; OFFMAP[438] = 15;
  OFFMAP[568] = 2; OFFMAP[569] = 254; OFFMAP[570] = 2;
  OFFMAP[572] = 13; OFFMAP[573] = 0; OFFMAP[574] = 32;
  OFFMAP[576] = 1; OFFMAP[577] = 0; OFFMAP[578] = 63;
  OFFMAP[580] = 3; OFFMAP[581] = 0; OFFMAP[582] = 1;
  OFFMAP[584] = 2; OFFMAP[585] = 129; OFFMAP[586] = 127;
  OFFMAP[588] = 1; OFFMAP[589] = 0; OFFMAP[590] = 16;
  OFFMAP[592] = 15; OFFMAP[593] = 0; OFFMAP[594] = 12;
  OFFMAP[596] = 21; OFFMAP[597] = 0; OFFMAP[598] = 2;
  OFFMAP[600] = 22; OFFMAP[601] = 0; OFFMAP[602] = 31;
  OFFMAP[604] = 23; OFFMAP[605] = 0; OFFMAP[606] = 7;
  OFFMAP[612] = 3; OFFMAP[613] = 0; OFFMAP[614] = 1;
);

// ------------------------------------------------------------- DSP filter board (dsp/fx_engine.cc)

function clip16(v, lo, hi) ( v < lo ? lo : (v > hi ? hi : v); );
function s16u8ms8(a, b) ( s16(floor(a * b / 256)); );
function s16s8ms8(a, b) ( s16(floor(a * b / 256)); );
function s16u16ms16(a, b) ( s16(floor(a * b / 65536)); );
function s8u8ms8(a, b) ( s8(floor(a * b / 256)); );
function clips8b(v) ( (max(-128, min(127, v))) & 255; );

function dsp_mem_init() (
  DCV = shr_alloc(8);
  DSM = shr_alloc(48);
  DL = shr_alloc(1288);
  T_DDIST = TOFF[75]; T_DFOLD = TOFF[76]; T_DIG = TOFF[77]; T_DCOMB = TOFF[78];
  T_DPHI = TOFF[79]; T_DDUR = TOFF[80]; T_DDEC = TOFF[81]; T_DFG = TOFF[82];
  T_DPSC = TOFF[83]; T_DTDUR = TOFF[84]; T_DTDEC = TOFF[85]; T_DTFG = TOFF[86];
  T_DPR = TOFF[87]; T_DRES = TOFF[88]; T_DSINE = TOFF[89];
);

function dsp_init() (
  d_fmode = 0; d_fx = 1; d_tempo = 0;
  d_p0 = 0; d_p1 = 0; d_p2 = 0;
  memset(DCV, 0, 8);
  memset(DL, 0, 1288);
  d_bc_cnt = 0; d_bc_held = 0; d_dptr = 0; d_rm_ph = 0; d_d_cnt = 0;
  d_d_del = 0; d_d_out = 0; d_d_in = 0;
  d_lp_ptr = 0; d_lp_start = 0; d_lp_dur = 0; d_lp_ref = 0; d_lp_ph = 0;
  d_ps_w = 0; d_ps_ph = 0;
  d_rr = 255; d_byte = 0;
);

function dsp_rx(value) (
  d_rr != 255 ? (
    d_byte == 0 ? (
      d_rr == 0 ? (
        value != 255 ? d_rr = 255;
      ) : d_rr == 1 ? (
        d_fmode = value >> 4; d_fx = value & 15;
      ) : d_rr == 2 ? (
        d_tempo = value;
      ) : d_rr == 3 ? (
        DCV[2] = value;
      ) : d_rr == 4 ? (
        DCV[0] = value;
      ) : d_rr == 5 ? (
        DCV[1] = value;
      );
    ) : (
      DCV[3 + (d_rr & 1)] = value;
    );
    d_byte = (d_byte + 1) & 1;
    !d_byte ? ( d_rr = (d_rr + 1) & 255; d_rr == 6 ? d_rr = 0; );
  ) : (
    value == 255 ? ( d_rr = 0; d_byte = 1; );
  );
);

function dsp_dcf() local(cut, res, gain, ig, comp, i, fb, in, out, p0, p1, p2) (
  cut = DCV[3];
  ((d_fmode & 1) && cut > 240) ? cut = 240;
  res = T_DRES[DCV[2]];
  gain = 255 - ((res * 208) >> 8);
  ig = T_DIG[cut];
  comp = 96 - (((ig >> 8) * 96) >> 8);
  res > comp ? (res -= comp) : (res = 0);
  p0 = d_p0; p1 = d_p1; p2 = d_p2;
  i = 0;
  loop(40,
    fb = s16(s16u8ms8(s16(p0 - p1), res) << 2);
    in = DSM[i];
    p0 = s16(p0 + s16u16ms16(s16(in - p0 + fb), ig));
    p1 = s16(p1 + s16u16ms16(s16(p0 - p1), ig));
    p2 = s16(p2 + s16u16ms16(s16(p1 - p2), ig));
    p0 > 8191 ? p0 = 8191;
    p0 < -8191 ? p0 = -8191;
    out = p2;
    d_fmode & 1 ? out = s16(in - out);
    out = s16u8ms8(out, gain);
    DSM[i] = clip16(out, -2047, 2047);
    i += 1;
  );
  d_p0 = p0; d_p1 = p1; d_p2 = p2;
);

function dsp_dca() local(g, i) (
  g = DCV[4];
  i = 0; loop(40, DSM[i] = s16u8ms8(DSM[i], g); i += 1;);
);

function dsp_distortion() local(fw, fd, zw, zd, i, s, fold, folded, fuzz) (
  fw = DCV[0]; fd = 255 - fw; zw = DCV[1]; zd = 255 - zw;
  i = 0;
  loop(40,
    s = DSM[i];
    fold = T_DFOLD[s + 2048] - 2048;
    folded = s16(s16u8ms8(s, fd) + s16u8ms8(fold, fw));
    fuzz = T_DDIST[folded + 2048] - 2048;
    DSM[i] = s16(s16u8ms8(folded, zd) + s16u8ms8(fuzz, zw));
    i += 1;
  );
);

function dsp_crush() local(dec, nb, mask, i) (
  dec = (DCV[0] >> 3) + 1;
  nb = 12 - ((DCV[1] * 12) >> 8);
  mask = -2048;
  nb -= 1;
  while (nb > 0) ( mask = asr(mask, 1); nb -= 1; );
  i = 0;
  loop(40,
    d_bc_cnt >= dec ? (
      d_bc_cnt = 0;
      d_bc_held = s16((DSM[i] & 65535) & (mask & 65535));
    );
    d_bc_cnt = (d_bc_cnt + 1) & 255;
    DSM[i] = d_bc_held;
    i += 1;
  );
);

function dsp_comb() local(fbk, dly, w, r, i, fb, out) (
  fbk = DCV[1];
  dly = T_DCOMB[DCV[0]];
  w = d_dptr;
  r = (d_dptr - dly) & 1023;
  i = 0;
  loop(40,
    fb = asr(DSM[i], 4);
    d_fx == 2 ? (fb += s8u8ms8(s8(DL[r]), fbk)) : (fb -= s8u8ms8(s8(DL[r]), fbk));
    DL[w] = clips8b(s16(fb));
    out = s16(s8(DL[r]) * 16 + DSM[i]);
    DSM[i] = clip16(out, -2047, 2047);
    r += 1; w += 1;
    r >= 1024 ? r -= 1024;
    w >= 1024 ? w -= 1024;
    i += 1;
  );
  d_dptr = (d_dptr + 40) & 1023;
);

function dsp_ringmod() local(inc, wet, dry, i, sine, rm) (
  inc = T_DPHI[DCV[0]];
  wet = DCV[1]; dry = 255 - wet;
  i = 0;
  loop(40,
    d_rm_ph = (d_rm_ph + inc) & 65535;
    sine = s8(128 + interp(T_DSINE, d_rm_ph));
    rm = s16s8ms8(DSM[i], sine);
    DSM[i] = s16(s16u8ms8(DSM[i], dry) + s16u8ms8(rm, wet));
    i += 1;
  );
);

function dsp_delay() local(fbk, amt, dec, fg, dur, dly, tempo, w, r, i, fb, x, out) (
  fbk = 0;
  amt = DCV[1];
  (d_fx >= 5 && d_fx <= 7) ? (
    dly = DCV[0];
    d_fx == 6 ? (fbk = 85) : (d_fx == 7 ? fbk = 224);
    dec = T_DDEC[dly] & 255;
    fg = T_DFG[dly] & 255;
    dur = T_DDUR[dly];
  ) : (
    tempo = d_tempo;
    tempo > 240 ? tempo = 240;
    tempo < 40 ? tempo = 40;
    d_fx == 10 ? (
      tempo = tempo * 3;
    ) : d_fx == 11 ? (
      tempo = (tempo * 9) >> 2;
    ) : d_fx == 12 ? (
      tempo = (tempo * 3) >> 1;
    );
    tempo -= 40;
    dec = T_DTDEC[tempo] & 255;
    fg = T_DTFG[tempo] & 255;
    dur = T_DTDUR[tempo];
    fbk = DCV[0];
  );
  w = d_dptr;
  r = (d_dptr - dur + 1280) & 65535;
  while (r >= 1280) ( r -= 1280; );
  i = 0;
  loop(40,
    d_d_cnt >= dec ? (
      d_d_cnt = 0;
      fb = s16(d_d_in + s8u8ms8(s8(DL[r]), fbk));
      DL[w] = clips8b(fb);
      d_d_del = s8(DL[r]) * 16;
      r += 1; w += 1;
      r >= 1280 ? r -= 1280;
      w >= 1280 ? w -= 1280;
      d_dptr = (d_dptr + 1) & 65535;
    );
    x = s16(asr(DSM[i], 4) - d_d_in);
    d_d_in = s16(d_d_in + s16u8ms8(x, fg));
    x = s16(d_d_del - d_d_out);
    d_d_out = s16(d_d_out + s16u8ms8(x, fg));
    d_d_cnt = (d_d_cnt + 1) & 255;
    out = s16(DSM[i] + s16u8ms8(d_d_out, amt));
    DSM[i] = clip16(out, -2047, 2047);
    i += 1;
  );
  while (d_dptr > 1280) ( d_dptr -= 1280; );
);

function dsp_crushdelay() local(dly, fbk, amt, dec, dur, w, r, i, fb, out) (
  dly = DCV[0];
  fbk = d_fx == 8 ? 85 : (d_fx == 9 ? 224 : 0);
  amt = DCV[1];
  dec = T_DDEC[dly] & 255;
  dur = T_DDUR[dly];
  w = d_dptr;
  r = (d_dptr - dur + 1280) & 65535;
  while (r >= 1280) ( r -= 1280; );
  i = 0;
  loop(40,
    d_d_cnt >= dec ? (
      d_d_cnt = 0;
      fb = s16(asr(DSM[i], 4) + s8u8ms8(s8(DL[r]), fbk));
      DL[w] = clips8b(fb);
      d_d_del = s8(DL[r]) * 16;
      r += 1; w += 1;
      r >= 1280 ? r -= 1280;
      w >= 1280 ? w -= 1280;
      d_dptr = (d_dptr + 1) & 65535;
    );
    d_d_cnt = (d_d_cnt + 1) & 255;
    out = s16(DSM[i] + s16u8ms8(d_d_del, amt));
    DSM[i] = clip16(out, -2047, 2047);
    i += 1;
  );
  while (d_dptr > 1280) ( d_dptr -= 1280; );
);

function dsp_loop_record() local(dec, dur, fg, w, i, s, x) (
  d_lp_ref = DCV[0];
  dec = T_DDEC[d_lp_ref] & 255;
  dur = T_DDUR[d_lp_ref];
  fg = T_DFG[d_lp_ref] & 255;
  w = d_lp_ptr;
  i = 0;
  loop(40,
    d_d_cnt >= dec ? (
      d_d_cnt = 0;
      s = (clips8b(d_d_in) + 128) & 255;
      DL[w] = s;
      w += 1;
      w >= 1024 ? ( DL[1024] = s; w -= 1024; );
      d_lp_ptr = (d_lp_ptr + 1) & 65535;
    );
    x = s16(asr(DSM[i], 4) - d_d_in);
    d_d_in = s16(d_d_in + s16u8ms8(x, fg));
    d_d_cnt = (d_d_cnt + 1) & 255;
    i += 1;
  );
  d_lp_ptr &= 1023;
  d_lp_start = (d_lp_ptr + 1024 - dur) & 1023;
  d_lp_ph = 0;
  d_lp_dur = dur;
);

function dsp_loop_replay() local(ps, inc, sc, i, rp, x, y, fr, ip) (
  ps = (128 - (DCV[0] >> 1) + (d_lp_ref >> 1)) & 255;
  inc = T_DPR[ps];
  sc = T_DPSC[d_lp_ref];
  sc != 0 ? inc = s16u16ms16(s16(inc), sc) & 65535;
  inc == 0 ? inc = 1;
  i = 0;
  loop(40,
    ip = d_lp_ph >> 8;
    rp = (d_lp_start + ip) & 1023;
    x = DL[rp]; y = DL[rp + 1];
    fr = d_lp_ph & 255;
    DSM[i] = s16(((x * (255 - fr) + y * fr) >> 4) - 2048);
    d_lp_ph = (d_lp_ph + inc) & 16777215;
    ip = d_lp_ph >> 8;
    ip >= d_lp_dur ? d_lp_ph = (((ip - d_lp_dur) & 65535) << 8) | (d_lp_ph & 255);
    i += 1;
  );
);

function dsp_pitch() local(inc, w, wet, dry, i, s, ri, a, b, dist, cf, ps) (
  inc = T_DPR[DCV[0]];
  w = d_ps_w;
  wet = DCV[1]; dry = 255 - wet;
  i = 0;
  loop(40,
    s = (asr(DSM[i], 4) + 128) & 255;
    DL[w] = s;
    w += 1;
    w >= 1024 ? ( DL[1024] = s; w -= 1024; );
    ri = d_ps_ph >> 8;
    a = DL[ri];
    ri += 512;
    ri >= 1024 ? ri -= 1024;
    b = DL[ri];
    dist = (ri - w + 1024) & 65535;
    dist >= 1024 ? dist -= 1024;
    dist >= 512 ? dist = 1024 - dist - 1;
    cf = (dist >> 1) & 255;
    ps = mix3(a, b, cf) * 16 - 2048;
    DSM[i] = s16(s16u8ms8(DSM[i], dry) + s16u8ms8(ps, wet));
    d_ps_ph = (d_ps_ph + inc) & 16777215;
    (d_ps_ph >> 8) >= 1024 ? d_ps_ph -= 1024 * 256;
    i += 1;
  );
  d_ps_w += 40;
  d_ps_w >= 1024 ? d_ps_w -= 1024;
);

function dsp_fx() (
  d_fx == 0 ? dsp_distortion() :
  d_fx == 1 ? dsp_crush() :
  d_fx == 2 || d_fx == 3 ? dsp_comb() :
  d_fx == 4 ? dsp_ringmod() :
  d_fx == 8 || d_fx == 9 ? dsp_crushdelay() :
  d_fx == 14 ? (DCV[1] < 128 ? dsp_loop_record() : dsp_loop_replay()) :
  d_fx == 15 ? dsp_pitch() :
  dsp_delay();
);

function dsp_block(inp, outp) local(i) (
  i = 0;
  loop(40, DSM[i] = s8(inp[i] + 128) * 16; i += 1;);
  d_fmode >= 2 ? (
    dsp_dca();
    dsp_fx();
    d_fmode != 4 ? dsp_dcf();
  ) : (
    dsp_dcf();
    dsp_dca();
    dsp_fx();
  );
  i = 0;
  loop(40, outp[i] = DSM[i]; i += 1;);
);

// ------------------------------------------------------------- factory presets

function presets_load(path1, path2) local(h, n, k) (
  h = file_open(path1);
  h < 0 ? h = file_open(path2);
  npre = 0;
  h >= 0 ? (
    n = file_mem(h, PRE - 1, 144 * 132 + 1);
    file_close(h);
    k = PRE[-1];
    (k > 0 && k <= 144 && n == k * 132 + 1) ? npre = k;
  );
);

// ------------------------------------------------------------- slider <-> engine sync

function sync_from_sliders() local(k, v, b) (
  k = 1;
  loop(NSL,
    v = floor(slider(k) + 0.5);
    v !== SVAL[k] ? (
      SVAL[k] = v;
      b = v & 255;
      SLOFF[k] == 101 && b < 40 ? b = 39;
      part_set_param(SLOFF[k], b);
    );
    k += 1;
  );
);

function sync_to_sliders() local(k, v, ch) (
  ch = 0;
  k = 1;
  loop(NSL,
    v = P[SLOFF[k]];
    SLSG[k] ? v = s8(v);
    v !== SVAL[k] ? ( slider(k) = v; SVAL[k] = v; ch = 1; );
    k += 1;
  );
  ch ? sliderchange(-1);
);

function preset_to_sliders_t(n, PT) local(b, k, v) (
  b = PRE + n * 132;
  memcpy(PT, b + 8, 92);
  (PT[89] == 110 && PT[90] == 103) ? memset(PT + 84, 0, 8);
  memcpy(PT + 100, SQ, 42);
  memcpy(PT + 142, SY, 15);
  PT[94] = PT[87] & 63;
  PT[95] = PT[88] >> 3;
  PT[96] = (PT[88] & 7) | ((PT[87] & 128) ? 8 : 0);
  (PT[87] & 64) ? PT[95] = PT[95] | 32;
  PT[97] = PT[89] & 63;
  PT[98] = PT[90] >> 3;
  PT[99] = (PT[90] & 7) | ((PT[89] & 128) ? 8 : 0);
  (PT[89] & 64) ? PT[98] = PT[98] | 32;
  PT[93] = PT[86] & 15;
  PT[92] = PT[86] >> 4;
  PT[91] == 37 ? (
    PT[145] = (PT[76] & 64) ? 1 : 0;
    PT[144] = PT[76] & 63;
    !p_running ? (
      PT[100] = PT[77]; PT[101] = PT[78]; PT[102] = PT[79]; PT[103] = PT[80];
      PT[104] = PT[81] >> 4; PT[105] = PT[81] & 15; PT[106] = PT[82]; PT[107] = PT[83];
    );
  );
  memcpy(PT + 110, b + 100, 32);
  PT[108] = 16;
  k = 0;
  while (k < 16) (
    (PT[110 + k * 2] == 0 && PT[111 + k * 2] == 0) ? ( PT[108] = k; k = 16; );
    k += 1;
  );
  k = 1;
  loop(NSL,
    v = PT[SLOFF[k]];
    SLSG[k] ? v = s8(v);
    slider(k) = v;
    k += 1;
  );
  pre_cur = n;
  memcpy(PNAME, b, 8);
);

function gs8(gx) ( gx = gx & 255; gx >= 128 ? gx - 256 : gx; );
function preset_to_sliders_g(gn, GPT) local(gb, gk, gv) (
  gb = PRE + gn * 132;
  memcpy(GPT, gb + 8, 92);
  (GPT[89] == 110 && GPT[90] == 103) ? memset(GPT + 84, 0, 8);
  memcpy(GPT + 100, SQ, 42);
  memcpy(GPT + 142, SY, 15);
  GPT[94] = GPT[87] & 63;
  GPT[95] = GPT[88] >> 3;
  GPT[96] = (GPT[88] & 7) | ((GPT[87] & 128) ? 8 : 0);
  (GPT[87] & 64) ? GPT[95] = GPT[95] | 32;
  GPT[97] = GPT[89] & 63;
  GPT[98] = GPT[90] >> 3;
  GPT[99] = (GPT[90] & 7) | ((GPT[89] & 128) ? 8 : 0);
  (GPT[89] & 64) ? GPT[98] = GPT[98] | 32;
  GPT[93] = GPT[86] & 15;
  GPT[92] = GPT[86] >> 4;
  GPT[91] == 37 ? (
    GPT[145] = (GPT[76] & 64) ? 1 : 0;
    GPT[144] = GPT[76] & 63;
    !p_running ? (
      GPT[100] = GPT[77]; GPT[101] = GPT[78]; GPT[102] = GPT[79]; GPT[103] = GPT[80];
      GPT[104] = GPT[81] >> 4; GPT[105] = GPT[81] & 15; GPT[106] = GPT[82]; GPT[107] = GPT[83];
    );
  );
  memcpy(GPT + 110, gb + 100, 32);
  GPT[108] = 16;
  gk = 0;
  while (gk < 16) (
    (GPT[110 + gk * 2] == 0 && GPT[111 + gk * 2] == 0) ? ( GPT[108] = gk; gk = 16; );
    gk += 1;
  );
  gk = 1;
  loop(NSL,
    gv = GPT[SLOFF[gk]];
    SLSG[gk] ? gv = gs8(gv);
    slider(gk) = gv;
    gk += 1;
  );
  pre_cur = gn;
  memcpy(PNAME, gb, 8);
);


// ------------------------------------------------------------- host-rate resampler (engine 2000000/51 Hz)

function rs_kern(x) local(ax, w) (
  ax = abs(x);
  ax >= RS_HW ? 0 : (
    w = 0.5 + 0.5 * cos($pi * ax / RS_HW);
    ax < 0.000001 ? RS_FC * w : sin($pi * RS_FC * x) / ($pi * x) * w;
  );
);
function rs_gcd(a, b) local(t) ( while (b > 0) ( t = b; b = a - b * floor(a / b); a = t; ); a; );

function host_setup() local(g, ri, j, n) (
  RS_E = 8000000 / 51;
  RS_HW = 16;
  RS_FC = min(1, srate / RS_E) * 0.92;
  rs_poly = 0;
  rs_num = RS_E; rs_den = srate;
  srate === floor(srate) ? (
    g = rs_gcd(8000000, 51 * srate);
    rs_num = 8000000 / g;
    rs_den = 51 * srate / g;
    rs_den <= 1024 ? (
      rs_poly = 1;
      ri = 0;
      loop(rs_den,
        j = 0;
        loop(2 * RS_HW, RSC[ri * 2 * RS_HW + j] = rs_kern(ri / rs_den + RS_HW - 1 - j); j += 1;);
        ri += 1;
      );
    );
  );
  !rs_poly ? (
    n = 0;
    loop(2 * RS_HW * 256 + 2, RSK[n] = rs_kern(n / 256 - RS_HW); n += 1;);
  );
  rs_q = 0; rs_r = 0; rs_f = 0;
  eo_n = 0;
  memset(EOR, 0, 2 * 16384);
);

function run_engine_block() local(k, x, y, v, j, u, w) (
  shr_block();
  dsp_rx(cv_a);
  dsp_rx(cv_b);
  k = 0;
  loop(40,
    x = OUTB[k] - 128;
    j = 0;
    loop(4,
      y = x - an_xp + dc_r * an_yp; an_xp = x; an_yp = y;
      v = ap_b0 * y + ap_b1 * ap_x1 - ap_a1 * ap_y1; ap_x1 = y; ap_y1 = v;
      u = -v;
      w = ai0_b0 * u + ai0_s1; ai0_s1 = ai0_b1 * u - ai0_a1 * w + ai0_s2; ai0_s2 = ai0_b2 * u - ai0_a2 * w; u = w;
      w = ai1_b0 * u + ai1_s1; ai1_s1 = ai1_b1 * u - ai1_a1 * w + ai1_s2; ai1_s2 = ai1_b2 * u - ai1_a2 * w; u = w;
      w = ai2_b0 * u + ai2_s1; ai2_s1 = ai2_b1 * u - ai2_a1 * w + ai2_s2; ai2_s2 = ai2_b2 * u - ai2_a2 * w; u = w;
      w = ai3_b0 * u + ai3_s1; ai3_s1 = ai3_b1 * u - ai3_a1 * w + ai3_s2; ai3_s2 = ai3_b2 * u - ai3_a2 * w; u = w;
      j == 0 ? ADCIN[k] = max(0, min(255, floor(128.5 + u)));
      j += 1;
    );
    k += 1;
  );
  dsp_block(ADCIN, DOUT);
  k = 0;
  loop(40,
    x = DOUT[k] / 2048;
    loop(4,
      w = ao0_b0 * x + ao0_s1; ao0_s1 = ao0_b1 * x - ao0_a1 * w + ao0_s2; ao0_s2 = ao0_b2 * x - ao0_a2 * w; u = w;
      w = ao1_b0 * u + ao1_s1; ao1_s1 = ao1_b1 * u - ao1_a1 * w + ao1_s2; ao1_s2 = ao1_b2 * u - ao1_a2 * w; u = w * ao_gain;
      y = u - ao_xp + dc_r * ao_yp; ao_xp = u; ao_yp = y;
      j = eo_n & 16383;
      EOR[j] = EOR[j + 16384] = y;
      eo_n += 1;
    );
    k += 1;
  );
);

function rs_next() local(acc, j, c, b, f) (
  b = (rs_q - RS_HW + 1) & 16383;
  acc = 0;
  rs_poly ? (
    c = RSC + rs_r * 2 * RS_HW;
    j = 0;
    loop(2 * RS_HW, acc += EOR[b + j] * c[j]; j += 1;);
    rs_r += rs_num;
    while (rs_r >= rs_den) ( rs_r -= rs_den; rs_q += 1; );
  ) : (
    j = 0;
    loop(2 * RS_HW,
      f = (rs_f + RS_HW - 1 - j + RS_HW) * 256;
      c = floor(f);
      acc += EOR[b + j] * (RSK[c] + (RSK[c + 1] - RSK[c]) * (f - c));
      j += 1;
    );
    rs_f += rs_num / rs_den;
    while (rs_f >= 1) ( rs_f -= 1; rs_q += 1; );
  );
  acc;
);

// ------------------------------------------------------------- host clock (tempo = Host)

function host_clock(nsamp) local(b1) (
  SQ[1] < 40 ? (
    (play_state & 1) ? (
      !hc_run ? (
        hc_run = 1;
        hc_tick = floor(beat_position * 24) - 1;
        part_start();
      );
      floor(beat_position * 24) < hc_tick - 1 ? hc_tick = floor(beat_position * 24) - 1;
      b1 = beat_position + nsamp / srate * tempo / 60;
      while (hc_tick < floor(b1 * 24)) (
        hc_tick += 1;
        HCQ[hc_n] = max(0, floor((hc_tick / 24 - beat_position) * 60 / tempo * srate));
        hc_n < 255 ? hc_n += 1;
      );
    ) : (
      hc_run ? ( hc_run = 0; part_stop(); );
    );
  ) : (
    hc_run = 0;
  );
);



