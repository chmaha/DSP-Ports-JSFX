dc_r = 0.99998643626220107;
presets_load("HomeTruths/home_truths_presets.txt", "Dependencies/HomeTruths/home_truths_presets.txt");
shr_boot();
dsp_init();
k = 1; loop(NSL, SVAL[k] = -1000; k += 1;);
pre_cur = -1;
gq_r = gq_w = 0;
hc_run = 0; hc_n = 0;
p_bank = 0;
g_kb_note = -1;
scope_w = 0; meter_pk = 0; out_g = 1;
page = 0; kb_base = 48;

@slider

last_srate !== srate ? ( last_srate = srate; host_setup(); );
sync_from_sliders();
out_g = 10 ^ (out_db / 20);

@block

last_srate !== srate ? ( last_srate = srate; host_setup(); );
sync_from_sliders();
mq_n = 0;
while (midirecv(mofs, m1, m2, m3)) (
  mq_n < 1000 ? ( MQ[mq_n * 3] = mofs; MQ[mq_n * 3 + 1] = m1; MQ[mq_n * 3 + 2] = m2 | (m3 << 8); mq_n += 1; );
);
while (gq_r < gq_w) (
  mq_n < 1000 ? ( MQ[mq_n * 3] = 0; MQ[mq_n * 3 + 1] = GQ[(gq_r & 255) * 3]; MQ[mq_n * 3 + 2] = GQ[(gq_r & 255) * 3 + 1] | (GQ[(gq_r & 255) * 3 + 2] << 8); mq_n += 1; );
  gq_r += 1;
);
hc_n = 0;
host_clock(samplesblock);
mq_p = 0; hc_p = 0; bs = 0;
loop(samplesblock,
  while (hc_p < hc_n && HCQ[hc_p] <= bs) ( part_clock(0); hc_p += 1; );
  while (mq_p < mq_n && MQ[mq_p * 3] <= bs) (
    mst = MQ[mq_p * 3 + 1]; md1 = MQ[mq_p * 3 + 2] & 255; md2 = MQ[mq_p * 3 + 2] >> 8;
    (mst & 240) == 192 ? (
      mpn = md1;
      mpn < npre ? ( preset_to_sliders_t(mpn, PTMP); sync_from_sliders(); sliderchange(-1); );
    ) : mst == 248 ? (
      SQ[1] < 40 && !(play_state & 1) ? part_clock(0);
    ) : (mst == 250 || mst == 251) ? (
      SQ[1] < 40 && !(play_state & 1) ? part_start();
    ) : mst == 252 ? (
      SQ[1] < 40 && !(play_state & 1) ? part_stop();
    ) : mst < 240 ? (
      part_midi(mst, md1, md2);
      (mst & 240) == 144 && md2 ? KEYF[md1] = 1;
    );
    mq_p += 1;
  );
  while (eo_n <= rs_q + RS_HW) ( run_engine_block(); );
  OB[bs] = rs_next();
  bs += 1;
);
sync_to_sliders();
bpos = 0;
out_g = 10 ^ (out_db / 20);

@sample

spl0 = spl1 = OB[bpos] * out_g;
SCOPE[scope_w & 4095] = spl0;
scope_w += 1;
meter_pk = max(meter_pk * 0.9997, abs(spl0));
bpos += 1;

@serialize

sv_ver = 1;
file_var(0, sv_ver);
file_var(0, pre_cur);
file_mem(0, PNAME, 8);

@gfx 1120 712
function automate(s, e)
(
<?
