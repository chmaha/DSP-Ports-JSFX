ai1_b0 = 0.027623689300947194; ai1_b1 = 0.055247378601894388; ai1_b2 = 0.027623689300947194; ai1_a1 = -1.7275800163288124; ai1_a2 = 0.83807477353260107;
ai2_b0 = 0.073140752258383346; ai2_b1 = 0.14628150451676669; ai2_b2 = 0.073140752258383346; ai2_a1 = -1.5434563298718087; ai2_a2 = 0.83601933890534219;
