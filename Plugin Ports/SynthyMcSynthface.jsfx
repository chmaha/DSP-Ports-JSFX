function hit_circle(mx, my, cx, cy, rad) ( sqr(mx - cx) + sqr(my - cy) <= sqr(rad); );
function hit_rect(mx, my, x, y, w, h) ( mx >= x && mx <= x+w && my >= y && my <= y+h; );

function accent(e)
(
  e == 0 ? ( acc_r = 0.86; acc_g = 0.70; acc_b = 0.40; ) :
  e == 1 ? ( acc_r = 0.90; acc_g = 0.52; acc_b = 0.22; ) :
  e == 2 ? ( acc_r = 0.58; acc_g = 0.40; acc_b = 0.88; ) :
  ( acc_r = 0.18; acc_g = 0.66; acc_b = 0.64; );
);

function upper(str)
local(i, c)
(
  i = 0;
  loop(strlen(str),
    c = str_getchar(str, i);
    (c >= 97 && c <= 122) ? str_setchar(str, i, c - 32);
    i += 1;
  );
  str;
);

function draw_knob(cx, cy, rad, pos, cr, cg, cb, valtext, name)
local(ang0, ang1, ang, i, tx, ty)
(
  ang0 = -2.35619;
  ang1 =  2.35619;

  gfx_set(0.05, 0.05, 0.06, 1);
  gfx_circle(cx, cy, rad + 2*scale, 1, 1);
  gfx_set(cr*0.55, cg*0.55, cb*0.55, 1);
  gfx_circle(cx, cy, rad, 1, 1);
  gfx_set(cr, cg, cb, 1);
  gfx_circle(cx, cy, rad*0.72, 1, 1);
  gfx_set(1, 1, 1, 0.18);
  gfx_circle(cx - rad*0.28, cy - rad*0.28, rad*0.42, 1, 1);

  i = 0;
  loop(9,
    ang = ang0 + (ang1 - ang0) * (i / 8);
    gfx_set(0.85, 0.85, 0.85, 0.7);
    gfx_line(cx + sin(ang)*rad*0.82, cy - cos(ang)*rad*0.82,
             cx + sin(ang)*rad*0.98, cy - cos(ang)*rad*0.98, 1);
    i += 1;
  );

  ang = ang0 + (ang1 - ang0) * pos;
  gfx_set(0.05, 0.05, 0.05, 1);
  gfx_line(cx, cy, cx + sin(ang)*rad*0.85, cy - cos(ang)*rad*0.85, 1);

  gfx_setfont(1, "Arial", 11*scale);
  gfx_set(0.85, 0.85, 0.85, 1);
  gfx_measurestr(valtext, tx, ty);
  gfx_x = cx - tx*0.5; gfx_y = cy - rad - 16*scale;
  gfx_drawstr(valtext);

  gfx_setfont(1, "Arial", 11*scale);
  gfx_set(0.8, 0.8, 0.82, 1);
  gfx_measurestr(name, tx, ty);
  gfx_x = cx - tx*0.5; gfx_y = cy + rad + 6*scale;
  gfx_drawstr(name);
);

// Display text for a parameter, following mda's getParameterDisplay()
function ptext(s)
local(p, v)
(
  p = slider(s);
  (s == 12 || s == 13 || s == 15 || s == 17 || s == 18) ? sprintf(#ptxt, "%.0f%%", 100*p) :
  s == 14 ? sprintf(#ptxt, "%+.1f", 100*p - 50) :
  s == 16 ? sprintf(#ptxt, "%.0f%%", 100 - 100*p) :
  s == 19 ? sprintf(#ptxt, "%.0f%%", 200*p) :
  (s == 20 || s == 22) ? sprintf(#ptxt, "%+.1f ct", 100*p - 50) :
  s == 21 ? sprintf(#ptxt, "%.1f ct", 50*p*p) :

  (s == 23 || s == 24 || s == 29) ? sprintf(#ptxt, "%.0f%%", 100*p) :
  (s == 25 || s == 26) ? sprintf(#ptxt, "%+.0f", 100*p - 50) :
  s == 27 ? ( p > 0.5 ? sprintf(#ptxt, "Trem %.0f", 200*p - 100) : sprintf(#ptxt, "Pan %.0f", 100 - 200*p); ) :
  s == 28 ? sprintf(#ptxt, "%.2f Hz", exp(6.22*p - 2.61)) :
  s == 30 ? sprintf(#ptxt, "%.0f%%", 200*p) :
  s == 31 ? sprintf(#ptxt, "%+.0f ct", 100*p - 50) :
  s == 32 ? sprintf(#ptxt, "%.1f ct", 50*p*p) :
  s == 33 ? sprintf(#ptxt, "%.1f%%", 100*p) :

  s == 34 ? sprintf(#ptxt, "%.0f:%.0f", 100 - 50*p, 50*p) :
  s == 35 ? sprintf(#ptxt, "%+.0f semi", floor(48*p) - 24) :
  s == 36 ? ( v = 15.876*p - 7.938; sprintf(#ptxt, "%+.1f ct", 0.1*floor(v*v*v)); ) :
  s == 37 ? (
    v = floor(7.9*p);
    strcpy(#ptxt, v <= 1 ? "Poly" : v == 2 ? "P-Legato" : v == 3 ? "P-Glide" : v <= 5 ? "Mono" : v == 6 ? "M-Legato" : "M-Glide");
  ) :
  s == 39 ? ( v = 6.604*p - 3.302; sprintf(#ptxt, "%+.2f semi", v*v*v); ) :
  s == 40 ? sprintf(#ptxt, "%.1f", 100*p) :
  s == 42 ? sprintf(#ptxt, "%+.1f", 200*p - 100) :
  s == 44 ? ( p < 0.05 ? strcpy(#ptxt, "Off") : sprintf(#ptxt, "%+.0f", 200*p - 100); ) :
  s == 53 ? sprintf(#ptxt, "%.3f Hz", exp(7*p - 4)) :
  s == 54 ? ( p < 0.5 ? sprintf(#ptxt, "PWM %.0f", 100 - 200*p) : sprintf(#ptxt, "%.0f", 200*p - 100); ) :
  s == 56 ? sprintf(#ptxt, "%+d", floor(p*4.9) - 2) :
  s == 57 ? sprintf(#ptxt, "%+.1f ct", 200*p - 100) :
  (s >= 34 && s <= 57) ? sprintf(#ptxt, "%.0f%%", 100*p) :

  s == 61 ? sprintf(#ptxt, "%.0f", floor(40.1*p*p)) :
  s == 62 ? (
    v = floor(8.9*p);
    v = p < 0.5 ? 0.2*p*p : v == 4 ? 0.25 : v == 5 ? 0.33333333 : v == 6 ? 0.5 : v == 7 ? 0.66666667 : 0.75;
    sprintf(#ptxt, "%.3f", v);
  ) :
  s == 69 ? sprintf(#ptxt, "%+d", floor(p*6.9) - 3) :
  s == 70 ? sprintf(#ptxt, "%+.0f ct", 200*p - 100) :
  s == 73 ? sprintf(#ptxt, "%.2f Hz", 25*p*p) :
  sprintf(#ptxt, "%.0f%%", 100*p);
  #ptxt;
);

function lcd_touch(s) ( lcd_sl = s; lcd_t = time_precise(); );

function row_begin(y, nk, ns)
(
  rx = (800*scale - (nk*CW + ns*8*scale + (ns - 1)*10*scale)) * 0.5;
  ry = y;
);

function sec(n, title, cr, cg, cb)
local(w, tw, th)
(
  w = n*CW + 8*scale;
  gfx_set(0.035, 0.035, 0.04, 1);
  gfx_rect(rx - scale, ry - scale, w + 2*scale, PANEL_H + 2*scale, 1);
  gfx_set(0.125, 0.125, 0.14, 1);
  gfx_rect(rx, ry, w, PANEL_H, 1);
  gfx_set(cr, cg, cb, 0.8);
  gfx_rect(rx, ry, w, max(1, 2*scale), 1);
  gfx_setfont(1, "Arial", 10*scale, 'b');
  gfx_set(cr*0.75 + 0.15, cg*0.75 + 0.15, cb*0.75 + 0.15, 1);
  gfx_measurestr(title, tw, th);
  gfx_x = rx + (w - tw)*0.5; gfx_y = ry + 5*scale;
  gfx_drawstr(title);
  k_sx = rx + 4*scale; k_col = 0;
  k_r = cr; k_g = cg; k_b = cb;
  rx += w + 10*scale;
);

function knob(s)
local(cx, cy, hov, v)
(
  cx = k_sx + CW*(k_col + 0.5);
  cy = ry + 52*scale;
  k_col += 1;
  hov = hit_circle(mouse_x, mouse_y, cx, cy, KR + 4*scale);
  (mouse_just_down && hov) ? (
    (click_target == s && time_precise() - click_time < 0.3) ? (
      slider(s) = prog_value(eng, s);
      automate(s, 0); automate(s, 1);
      drag_target = 0;
      lcd_touch(s);
    ) : (
      drag_target = s; drag_y0 = mouse_y; drag_v0 = slider(s); drag_fine = mouse_cap & 4;
    );
    click_target = s; click_time = time_precise();
  );
  (hov && mouse_wheel != 0 && drag_target == 0) ? (
    v = max(0, min(1, slider(s) + (mouse_wheel / 120) * ((mouse_cap & 4) ? 0.001 : 0.01)));
    slider(s) = floor(v*1000 + 0.5) / 1000;
    automate(s, 0); automate(s, 1);
    lcd_touch(s);
    mouse_wheel = 0;
  );
  draw_knob(cx, cy, KR, slider(s), k_r, k_g, k_b, ptext(s), knob_name(s));
);

function draw_box(x, y, w, h, label, txt)
local(tw, th)
(
  gfx_setfont(1, "Arial", 9*scale, 'b');
  gfx_set(0.6, 0.6, 0.62, 1);
  gfx_x = x; gfx_y = y - 13*scale;
  gfx_drawstr(label);
  gfx_set(0.04, 0.04, 0.05, 1);
  gfx_rect(x - scale, y - scale, w + 2*scale, h + 2*scale, 1);
  gfx_set(0.20, 0.21, 0.24, 1);
  gfx_rect(x, y, w, h, 1);
  gfx_set(1, 1, 1, 0.08);
  gfx_rect(x, y, w, max(1, scale), 1);
  gfx_setfont(1, "Arial", 12*scale);
  gfx_set(0.85, 0.85, 0.87, 1);
  gfx_measurestr(txt, tw, th);
  gfx_x = x + (w - tw)*0.5; gfx_y = y + (h - th)*0.5;
  gfx_drawstr(txt);
  gfx_set(0.6, 0.6, 0.62, 1);
  gfx_triangle(x + w - 14*scale, y + h*0.5 - 2*scale, x + w - 6*scale, y + h*0.5 - 2*scale, x + w - 10*scale, y + h*0.5 + 3*scale);
);

function tab(e, x, y, w, h, label)
local(act, tw, th, gap)
(
  act = inst_eng(slider1) == e;
  (mouse_just_down && hit_rect(mouse_x, mouse_y, x, y, w, h)) ? (
    slider1 = eng_inst(e); automate(1, 0); automate(1, 1);
    act = 1;
  );
  accent(e);
  gap = max(1, scale);
  gfx_set(0.03, 0.03, 0.04, 1);
  gfx_rect(x - gap, y - gap, w + 2*gap, h + 2*gap, 1);
  act ? gfx_set(acc_r*0.62, acc_g*0.62, acc_b*0.62, 1) : gfx_set(0.14, 0.14, 0.16, 1);
  gfx_rect(x, y, w, h, 1);
  act ? gfx_set(acc_r, acc_g, acc_b, 1) : gfx_set(0.21, 0.21, 0.24, 1);
  gfx_rect(x + gap, y + gap, w - 2*gap, h*0.5, 1);
  gfx_set(1, 1, 1, act ? 0.22 : 0.08);
  gfx_rect(x + gap, y + gap, w - 2*gap, h*0.3, 1);
  gfx_setfont(1, "Arial", 12*scale, 'b');
  act ? gfx_set(0.08, 0.08, 0.10, 1) : gfx_set(0.78, 0.78, 0.80, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + (w - tw)*0.5; gfx_y = y + (h - th)*0.5;
  gfx_drawstr(label);
);

function arrow_btn(x, y, w, h, dir)
local(hov, cx, cy, sz)
(
  hov = hit_rect(mouse_x, mouse_y, x, y, w, h);
  gfx_set(0.03, 0.03, 0.04, 1);
  gfx_rect(x - scale, y - scale, w + 2*scale, h + 2*scale, 1);
  gfx_set(hov ? 0.24 : 0.19, hov ? 0.24 : 0.19, hov ? 0.27 : 0.21, 1);
  gfx_rect(x, y, w, h, 1);
  gfx_set(1, 1, 1, 0.07);
  gfx_rect(x, y, w, h*0.4, 1);
  cx = x + w*0.5; cy = y + h*0.5; sz = 7*scale;
  gfx_set(acc_r, acc_g, acc_b, 1);
  dir < 0 ? gfx_triangle(cx + sz*0.6, cy - sz, cx + sz*0.6, cy + sz, cx - sz*0.7, cy)
          : gfx_triangle(cx - sz*0.6, cy - sz, cx - sz*0.6, cy + sz, cx + sz*0.7, cy);
  mouse_just_down && hov;
);

// Writes the program's values together with the program slider, so the display is right
// at once; @block then sees both change and adopts them (see check_engine).
function pick_prog(e, n)
local(j, s, tb)
(
  tb = prog_table(e) + n * npar(e);
  j = 0;
  loop(npar(e), s = sl_of(e, j); s > 0 ? slider(s) = tb[j]; j += 1; );
  slider(8 + e) = n;
  automate(8 + e, 0); automate(8 + e, 1);
  sliderchange(-1);
);

function step_prog(e, d)
local(n, cnt)
(
  cnt = prog_count(e);
  n = floor(slider(8 + e) + 0.5) + d;
  n < 0 ? n = cnt - 1 : n >= cnt ? n = 0;
  pick_prog(e, n);
);

function prog_menu(e)
local(n, cnt, cur, sel)
(
  cnt = prog_count(e);
  cur = floor(slider(8 + e) + 0.5);
  strcpy(#pm, "");
  n = 0;
  loop(cnt,
    n > 0 ? strcat(#pm, "|");
    (e == 2 && n % 13 == 0) ? sprintf(#pm, "%s>%02d-%02d|", #pm, n + 1, min(cnt, n + 13));
    (e == 2 && (n % 13 == 12 || n == cnt - 1)) ? strcat(#pm, "<");
    n == cur ? strcat(#pm, "!");
    sprintf(#pm, "%s%02d   %s", #pm, n + 1, prog_name(e, n));
    n += 1;
  );
  gfx_x = mouse_x; gfx_y = mouse_y;
  sel = gfx_showmenu(#pm);
  sel > 0 ? pick_prog(e, sel - 1);
);

function is_modified(e)
local(s, m, tb)
(
  m = 0;
  tb = prog_table(e) + floor(slider(8 + e) + 0.5) * npar(e);
  s = sl_lo(e);
  loop(sl_hi(e) - sl_lo(e) + 1, abs(slider(s) - tb[j_of(e, s)]) > 0.0005 ? m = 1; s += 1; );
  m;
);

function glow_text(str, x, y, r, g, b)
(
  gfx_set(r, g, b, 0.16);
  gfx_x = x - scale; gfx_y = y; gfx_drawstr(str);
  gfx_x = x + scale; gfx_y = y; gfx_drawstr(str);
  gfx_x = x; gfx_y = y - scale; gfx_drawstr(str);
  gfx_x = x; gfx_y = y + scale; gfx_drawstr(str);
  gfx_set(r, g, b, 1);
  gfx_x = x; gfx_y = y; gfx_drawstr(str);
);

mouse_down = mouse_cap & 1;
mouse_just_down = mouse_down && !mouse_state;
cur_eng = inst_eng(slider1);

// ---------------------------------------------------------------------- background + header
gfx_set(0.09, 0.09, 0.10, 1);
gfx_rect(0, 0, gfx_w, gfx_h, 1);

gfx_setfont(1, "Arial", 18*scale, 'b');
gfx_set(0.86, 0.70, 0.40, 1);
gfx_x = MARGIN; gfx_y = 8*scale;
gfx_drawstr("SYNTHY McSYNTHFACE");
gfx_setfont(1, "Arial", 11*scale);
gfx_set(0.55, 0.55, 0.58, 1);
gfx_x = MARGIN + 2*scale; gfx_y = 30*scale;
gfx_drawstr("by chmaha  ·  based on the mda plugins");

TABW = 84*scale; TABH = 26*scale; TABG = 5*scale;
tx0 = 800*scale - MARGIN - 4*TABW - 3*TABG;
tab(1, tx0, 11*scale, TABW, TABH, "ePiano");
tab(2, tx0 + (TABW + TABG), 11*scale, TABW, TABH, "JX10");
tab(3, tx0 + (TABW + TABG)*2, 11*scale, TABW, TABH, "DX10");
tab(0, tx0 + (TABW + TABG)*3, 11*scale, TABW, TABH, "Piano");
cur_eng = inst_eng(slider1);
accent(cur_eng);

gfx_set(0.04, 0.04, 0.05, 1);
gfx_rect(0, 46*scale, gfx_w, max(1, scale), 1);

// ---------------------------------------------------------------------- MIDI + polyphony boxes
BX = MARGIN; BW = 150*scale; BH = 24*scale;
midi_ch = floor(slider2 + 0.5);
BY1 = 70*scale;
(mouse_just_down && hit_rect(mouse_x, mouse_y, BX, BY1, BW, BH)) ? (
  strcpy(#mm, midi_ch == 0 ? "!Omni" : "Omni");
  n = 1;
  loop(16, sprintf(#mm, "%s|%s%d", #mm, n == midi_ch ? "!" : "", n); n += 1; );
  gfx_x = mouse_x; gfx_y = mouse_y;
  sel = gfx_showmenu(#mm);
  sel > 0 ? ( slider2 = sel - 1; automate(2, 0); automate(2, 1); );
  mouse_just_down = 0;
);
midi_ch == 0 ? strcpy(#bt, "Omni") : sprintf(#bt, "Channel %d", midi_ch);
draw_box(BX, BY1, BW, BH, "MIDI CHANNEL", #bt);

poly_idx = floor(slider(4 + cur_eng) + 0.5);
BY2 = 116*scale;
(mouse_just_down && hit_rect(mouse_x, mouse_y, BX, BY2, BW, BH)) ? (
  strcpy(#mm, "");
  n = 0;
  loop(9, sprintf(#mm, "%s%s%s%d", #mm, n > 0 ? "|" : "", n == poly_idx ? "!" : "", 2^n); n += 1; );
  gfx_x = mouse_x; gfx_y = mouse_y;
  sel = gfx_showmenu(#mm);
  sel > 0 ? ( slider(4 + cur_eng) = sel - 1; automate(4 + cur_eng, 0); automate(4 + cur_eng, 1); );
  mouse_just_down = 0;
  poly_idx = floor(slider(4 + cur_eng) + 0.5);
);
sprintf(#bt, "%d %s", 2^poly_idx, poly_idx == 0 ? "voice" : "voices");
draw_box(BX, BY2, BW, BH, "POLYPHONY", #bt);

// ---------------------------------------------------------------------- LCD
LX = 184*scale; LY = 56*scale; LW = 432*scale; LH = 90*scale;
gfx_set(0.03, 0.03, 0.04, 1);
gfx_rect(LX - 2*scale, LY - 2*scale, LW + 4*scale, LH + 4*scale, 1);
gfx_set(0.17, 0.17, 0.19, 1);
gfx_rect(LX, LY, LW, LH, 1);
gfx_set(1, 1, 1, 0.06);
gfx_rect(LX, LY, LW, max(1, scale), 1);

arrow_btn(LX + 6*scale, LY + 8*scale, 28*scale, LH - 16*scale, -1) ? ( step_prog(cur_eng, -1); mouse_just_down = 0; );
arrow_btn(LX + LW - 34*scale, LY + 8*scale, 28*scale, LH - 16*scale, 1) ? ( step_prog(cur_eng, 1); mouse_just_down = 0; );

GX = LX + 40*scale; GY = LY + 6*scale; GW = LW - 80*scale; GH = LH - 12*scale;
hov_glass = hit_rect(mouse_x, mouse_y, GX, GY, GW, GH);
(hov_glass && mouse_wheel != 0) ? ( step_prog(cur_eng, mouse_wheel > 0 ? -1 : 1); mouse_wheel = 0; );
(mouse_just_down && hov_glass) ? ( prog_menu(cur_eng); mouse_just_down = 0; );

gfx_set(0.02, 0.02, 0.02, 1);
gfx_rect(GX - scale, GY - scale, GW + 2*scale, GH + 2*scale, 1);
gfx_set(0.035 + acc_r*0.05, 0.035 + acc_g*0.05, 0.035 + acc_b*0.05, 1);
gfx_rect(GX, GY, GW, GH, 1);
lc_r = min(1, 0.35 + acc_r*0.75); lc_g = min(1, 0.35 + acc_g*0.75); lc_b = min(1, 0.35 + acc_b*0.75);

// top line: instrument, MIDI activity, program number
gfx_setfont(2, "Courier New", 12*scale, 'b');
strcpy(#lt, cur_eng == 0 ? "PIANO" : cur_eng == 1 ? "ePIANO" : cur_eng == 2 ? "JX10 SYNTH" : "DX10 FM");
glow_text(#lt, GX + 10*scale, GY + 6*scale, lc_r, lc_g, lc_b);
gfx_measurestr(#lt, ltw, lth);
midi_flag ? ( midi_led_t = time_precise(); midi_flag = 0; );
led_on = time_precise() - midi_led_t < 0.12;
gfx_set(lc_r, lc_g, lc_b, led_on ? 1 : 0.18);
gfx_circle(GX + 20*scale + ltw, GY + 6*scale + lth*0.5, 3*scale, 1, 1);
cur_prog = floor(slider(8 + cur_eng) + 0.5);
sprintf(#lt, "PROG %02d/%02d", cur_prog + 1, prog_count(cur_eng));
gfx_measurestr(#lt, ltw, lth);
glow_text(#lt, GX + GW - 10*scale - ltw, GY + 6*scale, lc_r, lc_g, lc_b);

// middle line: program name
strcpy(#ln, prog_name(cur_eng, cur_prog));
upper(#ln);
is_modified(cur_eng) ? strcat(#ln, " *");
gfx_setfont(2, "Courier New", 24*scale, 'b');
gfx_measurestr(#ln, ltw, lth);
ltw > GW - 20*scale ? ( gfx_setfont(2, "Courier New", 18*scale, 'b'); gfx_measurestr(#ln, ltw, lth); );
glow_text(#ln, GX + (GW - ltw)*0.5, GY + 24*scale + (26*scale - lth)*0.5, lc_r, lc_g, lc_b);

// bottom line: touched parameter, or voice usage
gfx_setfont(2, "Courier New", 12*scale, 'b');
LY3 = GY + GH - 20*scale;
((cur_eng == 0 && !pn_ok) || (cur_eng == 1 && !ep_ok)) ? (
  strcpy(#lt, "SAMPLE DATA NOT FOUND");
  gfx_measurestr(#lt, ltw, lth);
  glow_text(#lt, GX + (GW - ltw)*0.5, LY3, 1, 0.35, 0.3);
) : (lcd_sl >= sl_lo(cur_eng) && lcd_sl <= sl_hi(cur_eng) && time_precise() - lcd_t < 1.5) ? (
  strcpy(#lt, long_name(lcd_sl));
  upper(#lt);
  glow_text(#lt, GX + 10*scale, LY3, lc_r, lc_g, lc_b);
  strcpy(#lv, ptext(lcd_sl));
  upper(#lv);
  gfx_measurestr(#lv, ltw, lth);
  glow_text(#lv, GX + GW - 10*scale - ltw, LY3, lc_r, lc_g, lc_b);
) : (
  nact = cur_eng == 0 ? pn_nact : cur_eng == 1 ? ep_nact : cur_eng == 2 ? jx_nact : dx_nact;
  npoly = 2^floor(slider(4 + cur_eng) + 0.5);
  sprintf(#lt, "VOICES %d/%d", min(nact, npoly), npoly);
  glow_text(#lt, GX + 10*scale, LY3, lc_r, lc_g, lc_b);
  gfx_measurestr(#lt, ltw, lth);
  SEGX = GX + 22*scale + ltw; SEGW = GX + GW - 10*scale - SEGX;
  lit = npoly > 0 ? ceil(16 * min(1, nact / npoly)) : 0;
  seg = 0;
  loop(16,
    gfx_set(lc_r, lc_g, lc_b, seg < lit ? 0.95 : 0.14);
    gfx_rect(SEGX + seg * SEGW / 16, LY3 + 2*scale, SEGW / 16 - 2*scale, lth - 4*scale, 1);
    seg += 1;
  );
);

// scanlines + glass sheen
gfx_set(0, 0, 0, 0.22);
sy = GY;
while (sy < GY + GH) ( gfx_rect(GX, sy, GW, max(1, scale), 1); sy += 3*scale; );
gfx_set(1, 1, 1, 0.035);
gfx_rect(GX, GY, GW, GH*0.45, 1);

// ---------------------------------------------------------------------- volume + meter
VKX = 684*scale; VKY = 104*scale; VKR = 22*scale;
(mouse_just_down && hit_circle(mouse_x, mouse_y, VKX, VKY, VKR + 4*scale)) ? (
  (click_target == 3 && time_precise() - click_time < 0.3) ? (
    slider3 = 0; automate(3, 0); automate(3, 1); vol_drag = 0;
  ) : ( vol_drag = 1; drag_y0 = mouse_y; drag_v0 = (slider3 + 24) / 36; drag_fine = mouse_cap & 4; );
  click_target = 3; click_time = time_precise();
);
(hit_circle(mouse_x, mouse_y, VKX, VKY, VKR + 4*scale) && mouse_wheel != 0) ? (
  slider3 = max(-24, min(12, floor((slider3 + (mouse_wheel / 120) * 0.5) * 10 + 0.5) / 10));
  automate(3, 0); automate(3, 1);
  mouse_wheel = 0;
);
vol_drag ? (
  mouse_down ? (
    fine_now = mouse_cap & 4;
    fine_now != drag_fine ? ( drag_y0 = mouse_y; drag_v0 = (slider3 + 24) / 36; drag_fine = fine_now; );
    v = max(0, min(1, drag_v0 + (drag_y0 - mouse_y) / (150*scale) * (fine_now ? 0.1 : 1)));
    v = floor((v*36 - 24) * 10 + 0.5) / 10;
    v != slider3 ? ( slider3 = v; automate(3, 0); );
  ) : ( automate(3, 1); vol_drag = 0; );
);
sprintf(#vt, "%+.1f dB", slider3);
draw_knob(VKX, VKY, VKR, (slider3 + 24) / 36, 0.85, 0.85, 0.85, #vt, "Volume");

// CLIP label + bar span exactly the LCD's height
gfx_setfont(1, "Arial", 9*scale, 'b');
gfx_measurestr("CLIP", cltw, clth);
MX = 736*scale; MW = 16*scale;
CLY = LY;
MY = CLY + clth + 3*scale;
MH = LY + LH - MY;
(mouse_just_down && hit_rect(mouse_x, mouse_y, MX - 4*scale, CLY, MW + 8*scale, MY + MH - CLY)) ? clip_latch = 0;
gfx_set(0.04, 0.04, 0.05, 1);
gfx_rect(MX - scale, MY - scale, MW + 2*scale, MH + 2*scale, 1);
function meter_y(db) ( MY + MH * (1 - max(0, min(1, (db + 60) / 60))) );
y9 = meter_y(-9); y1 = meter_y(-1);
gfx_set(0.10, 0.22, 0.14, 1); gfx_rect(MX, y9, MW, MY + MH - y9, 1);
gfx_set(0.28, 0.24, 0.08, 1); gfx_rect(MX, y1, MW, y9 - y1, 1);
gfx_set(0.30, 0.08, 0.08, 1); gfx_rect(MX, MY, MW, y1 - MY, 1);
mdb = meter_peak > 0.000001 ? 20 * log10(meter_peak) : -100;
fy = meter_y(mdb);
mdb > -1 ? gfx_set(1.0, 0.35, 0.30, 1) : mdb > -9 ? gfx_set(1.0, 0.80, 0.25, 1) : gfx_set(0.30, 0.85, 0.50, 1);
gfx_rect(MX, fy, MW, MY + MH - fy, 1);
gfx_setfont(1, "Arial", 9*scale, 'b');
clip_latch ? gfx_set(1, 0.25, 0.25, 1) : gfx_set(0.32, 0.18, 0.18, 1);
gfx_x = MX + MW*0.5 - cltw*0.5; gfx_y = CLY;
gfx_drawstr("CLIP");

gfx_set(0.04, 0.04, 0.05, 1);
gfx_rect(0, 152*scale, gfx_w, max(1, scale), 1);

// ---------------------------------------------------------------------- knob panels
cur_eng == 0 ? (
  row_begin(160*scale + ROW_PITCH*0.5, 6, 3);
  sec(2, "ENVELOPE", 0.35, 0.60, 0.90); knob(12); knob(13);
  sec(2, "HARDNESS", 0.90, 0.55, 0.25); knob(14); knob(15);
  sec(2, "MUFFLE", 0.65, 0.40, 0.80); knob(16); knob(17);
  row_begin(160*scale + ROW_PITCH*1.5, 5, 2);
  sec(2, "DYNAMICS / STEREO", 0.20, 0.65, 0.62); knob(18); knob(19);
  sec(3, "TUNING", 0.85, 0.70, 0.30); knob(20); knob(21); knob(22);
) : cur_eng == 1 ? (
  row_begin(160*scale + ROW_PITCH*0.5, 6, 2);
  sec(3, "ENVELOPE", 0.35, 0.60, 0.90); knob(23); knob(24); knob(29);
  sec(3, "TONE", 0.90, 0.55, 0.25); knob(25); knob(26); knob(33);
  row_begin(160*scale + ROW_PITCH*1.5, 5, 2);
  sec(3, "MODULATION", 0.65, 0.40, 0.80); knob(27); knob(28); knob(30);
  sec(2, "TUNING", 0.85, 0.70, 0.30); knob(31); knob(32);
) : cur_eng == 2 ? (
  row_begin(160*scale, 9, 3);
  sec(4, "OSCILLATORS", 0.35, 0.60, 0.90); knob(34); knob(35); knob(36); knob(55);
  sec(2, "PITCH", 0.85, 0.70, 0.30); knob(56); knob(57);
  sec(3, "GLIDE", 0.20, 0.65, 0.62); knob(37); knob(38); knob(39);
  row_begin(160*scale + ROW_PITCH, 7, 2);
  sec(5, "FILTER", 0.90, 0.55, 0.25); knob(40); knob(41); knob(42); knob(43); knob(44);
  sec(2, "LFO", 0.40, 0.72, 0.45); knob(53); knob(54);
  row_begin(160*scale + ROW_PITCH*2, 8, 2);
  sec(4, "FILTER ENVELOPE", 0.65, 0.40, 0.80); knob(45); knob(46); knob(47); knob(48);
  sec(4, "AMP ENVELOPE", 0.45, 0.45, 0.85); knob(49); knob(50); knob(51); knob(52);
) : (
  row_begin(160*scale + ROW_PITCH*0.5, 7, 3);
  sec(3, "CARRIER", 0.35, 0.60, 0.90); knob(58); knob(59); knob(60);
  sec(2, "TONE", 0.90, 0.55, 0.25); knob(71); knob(72);
  sec(2, "PITCH", 0.85, 0.70, 0.30); knob(69); knob(70);
  row_begin(160*scale + ROW_PITCH*1.5, 9, 2);
  sec(7, "MODULATOR", 0.65, 0.40, 0.80); knob(61); knob(62); knob(63); knob(64); knob(65); knob(66); knob(67);
  sec(2, "LFO", 0.40, 0.72, 0.45); knob(68); knob(73);
);

// knob drag (Ctrl = fine)
drag_target > 0 ? (
  mouse_down ? (
    fine_now = mouse_cap & 4;
    fine_now != drag_fine ? ( drag_y0 = mouse_y; drag_v0 = slider(drag_target); drag_fine = fine_now; );
    v = max(0, min(1, drag_v0 + (drag_y0 - mouse_y) / (150*scale) * (fine_now ? 0.1 : 1)));
    v = floor(v*1000 + 0.5) / 1000;
    v != slider(drag_target) ? ( slider(drag_target) = v; automate(drag_target, 0); );
    lcd_touch(drag_target);
  ) : ( automate(drag_target, 1); drag_target = 0; );
);

mouse_wheel = 0;
mouse_state = mouse_down;
