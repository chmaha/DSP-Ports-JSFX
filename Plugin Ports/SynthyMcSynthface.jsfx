N_PROG_PN = 8;
N_PROG_EP = 5;
N_PROG_JX = 52;
N_PROG_DX = 32;

function prog_name(e, n)
(
  e == 0 ? (
    n == 0 ? "MDA Piano" :
    n == 1 ? "Plain Piano" :
    n == 2 ? "Compressed Piano" :
    n == 3 ? "Dance Piano" :
    n == 4 ? "Concert Piano" :
    n == 5 ? "Dark Piano" :
    n == 6 ? "School Piano" :
    "Broken Piano"
  ) : e == 1 ? (
    n == 0 ? "Default" :
    n == 1 ? "Bright" :
    n == 2 ? "Mellow" :
    n == 3 ? "Autopan" :
    "Tremolo"
  ) : e == 2 ? (
    n == 0 ? "5th Sweep Pad" :
    n == 1 ? "Echo Pad [SA]" :
    n == 2 ? "Space Chimes [SA]" :
    n == 3 ? "Solid Backing" :
    n == 4 ? "Velocity Backing [SA]" :
    n == 5 ? "Rubber Backing [ZF]" :
    n == 6 ? "808 State Lead" :
    n == 7 ? "Mono Glide" :
    n == 8 ? "Detuned Techno Lead" :
    n == 9 ? "Hard Lead [SA]" :
    n == 10 ? "Bubble" :
    n == 11 ? "Monosynth" :
    n == 12 ? "Moogcury Lite" :
    n == 13 ? "Gangsta Whine" :
    n == 14 ? "Higher Synth [ZF]" :
    n == 15 ? "303 Saw Bass" :
    n == 16 ? "303 Square Bass" :
    n == 17 ? "Analog Bass" :
    n == 18 ? "Analog Bass 2" :
    n == 19 ? "Low Pulses" :
    n == 20 ? "Sine Infra-Bass" :
    n == 21 ? "Wobble Bass [SA]" :
    n == 22 ? "Squelch Bass" :
    n == 23 ? "Rubber Bass [ZF]" :
    n == 24 ? "Soft Pick Bass" :
    n == 25 ? "Fretless Bass" :
    n == 26 ? "Whistler" :
    n == 27 ? "Very Soft Pad" :
    n == 28 ? "Pizzicato" :
    n == 29 ? "Synth Strings" :
    n == 30 ? "Synth Strings 2" :
    n == 31 ? "Leslie Organ" :
    n == 32 ? "Click Organ" :
    n == 33 ? "Hard Organ" :
    n == 34 ? "Bass Clarinet" :
    n == 35 ? "Trumpet" :
    n == 36 ? "Soft Horn" :
    n == 37 ? "Brass Section" :
    n == 38 ? "Synth Brass" :
    n == 39 ? "Detuned Syn Brass [ZF]" :
    n == 40 ? "Power PWM" :
    n == 41 ? "Water Velocity [SA]" :
    n == 42 ? "Ghost [SA]" :
    n == 43 ? "Soft E.Piano" :
    n == 44 ? "Thumb Piano" :
    n == 45 ? "Steel Drums [ZF]" :
    n == 46 ? "Car Horn" :
    n == 47 ? "Helicopter" :
    n == 48 ? "Arctic Wind" :
    n == 49 ? "Thip" :
    n == 50 ? "Synth Tom" :
    "Squelchy Frog"
  ) : (
    n == 0 ? "Bright E.Piano" :
    n == 1 ? "Jazz E.Piano" :
    n == 2 ? "E.Piano Pad" :
    n == 3 ? "Fuzzy E.Piano" :
    n == 4 ? "Soft Chimes" :
    n == 5 ? "Harpsichord" :
    n == 6 ? "Funk Clav" :
    n == 7 ? "Sitar" :
    n == 8 ? "Chiff Organ" :
    n == 9 ? "Tinkle" :
    n == 10 ? "Space Pad" :
    n == 11 ? "Koto" :
    n == 12 ? "Harp" :
    n == 13 ? "Jazz Guitar" :
    n == 14 ? "Steel Drum" :
    n == 15 ? "Log Drum" :
    n == 16 ? "Trumpet" :
    n == 17 ? "Horn" :
    n == 18 ? "Reed 1" :
    n == 19 ? "Reed 2" :
    n == 20 ? "Violin" :
    n == 21 ? "Chunky Bass" :
    n == 22 ? "E.Bass" :
    n == 23 ? "Clunk Bass" :
    n == 24 ? "Thick Bass" :
    n == 25 ? "Sine Bass" :
    n == 26 ? "Square Bass" :
    n == 27 ? "Upright Bass 1" :
    n == 28 ? "Upright Bass 2" :
    n == 29 ? "Harmonics" :
    n == 30 ? "Scratch" :
    "Syn Tom"
  );
);

function prog_count(e) ( e == 0 ? N_PROG_PN : e == 1 ? N_PROG_EP : e == 2 ? N_PROG_JX : N_PROG_DX; );
function npar(e) ( e == 2 ? 24 : e == 3 ? 16 : 12; );
function prog_table(e) ( e == 0 ? pn_pr : e == 1 ? ep_pr : e == 2 ? jx_pr : dx_pr; );

// slider index of mda parameter j (0 = none: Piano/ePiano's own Polyphony parameter)
function sl_of(e, j)
(
  e == 0 ? ( j == 8 ? 0 : j < 8 ? 12 + j : 11 + j ) :
  e == 1 ? ( j == 8 ? 0 : j < 8 ? 23 + j : 22 + j ) :
  e == 2 ? 34 + j : 58 + j;
);
function j_of(e, s)
(
  e == 0 ? ( s <= 19 ? s - 12 : s - 11 ) :
  e == 1 ? ( s <= 30 ? s - 23 : s - 22 ) :
  e == 2 ? s - 34 : s - 58;
);
function sl_lo(e) ( e == 0 ? 12 : e == 1 ? 23 : e == 2 ? 34 : 58; );
function sl_hi(e) ( e == 0 ? 22 : e == 1 ? 33 : e == 2 ? 57 : 73; );
function prog_value(e, s) ( (prog_table(e) + pcur[e] * npar(e))[j_of(e, s)]; );

// ---------------------------------------------------------------------------------------
// Parameter updates (mda update())

function itrunc(x) ( x < 0 ? ceil(x) : floor(x); );

function pn_update()
(
  pn_size = itrunc(12 * slider14 - 6);
  pn_sizevel = 0.12 * slider15;
  pn_muffvel = slider17 * slider17 * 5;
  pn_velsens = 1 + slider18 + slider18;
  slider18 < 0.25 ? pn_velsens -= 0.75 - 3 * slider18;
  pn_fine = slider20 - 0.5;
  pn_random = 0.077 * slider21 * slider21;
  pn_stretch = 0.000434 * (slider22 - 0.5);
  pn_cdep = slider19 * slider19;
  pn_trim = 1.5 - 0.79 * pn_cdep;
  pn_width = min(0.03, 0.04 * slider19);
  pn_cmax = srate > 64000 ? 255 : 127;
);

function ep_update()
(
  ep_size = itrunc(12 * slider25 - 6);
  ep_treb = 4 * slider26 * slider26 - 1;
  ep_tfrq = 1 - exp(-(slider26 > 0.5 ? 14000 : 5000) / srate);
  ep_rmod = ep_lmod = slider27 + slider27 - 1;
  slider27 < 0.5 ? ep_rmod = -ep_rmod;
  ep_dlfo = 6.283 / srate * exp(6.22 * slider28 - 2.61);
  ep_velsens = 1 + slider29 + slider29;
  slider29 < 0.25 ? ep_velsens -= 0.75 - 3 * slider29;
  ep_width = 0.03 * slider30;
  ep_fine = slider31 - 0.5;
  ep_random = 0.077 * slider32 * slider32;
  ep_overdrive = 1.8 * slider33;
);

function jx_update()
local(ifs, c, t, gd)
(
  ifs = 1 / srate;
  jx_mode = floor(7.9 * slider37);
  jx_noisemix = slider55 * slider55;
  jx_voltrim = (3.2 - slider34 - 1.5 * jx_noisemix) * (1.5 - 0.5 * slider41);
  jx_noisemix *= 0.06;
  jx_oscmix = slider34;
  jx_semi = floor(48 * slider35) - 24;
  c = 15.876 * slider36 - 7.938;
  jx_cent = 0.1 * floor(c * c * c);
  jx_detune = pow(1.059463094359, -jx_semi - 0.01 * jx_cent);
  t = -23.376 - 2 * slider57 - 12 * floor(slider56 * 4.9);
  jx_tune = srate * pow(1.059463094359, t);
  jx_vibrato = jx_pwmdep = 0.2 * (slider54 - 0.5) * (slider54 - 0.5);
  slider54 < 0.5 ? jx_vibrato = 0;
  jx_lfohz = exp(7 * slider53 - 4);
  jx_dlfo = jx_lfohz * (ifs * 2 * $pi * JX_KMAX);
  jx_filtf = 8 * slider40 - 1.5;
  jx_filtq = (1 - slider41) * (1 - slider41);
  jx_filtlfo = 2.5 * slider43 * slider43;
  jx_filtenv = 12 * slider42 - 6;
  jx_filtvel = 0.1 * slider44 - 0.05;
  slider44 < 0.05 ? ( jx_veloff = 1; jx_filtvel = 0; ) : jx_veloff = 0;
  jx_att = 1 - exp(-ifs * exp(5.5 - 7.5 * slider49));
  jx_dec = 1 - exp(-ifs * exp(5.5 - 7.5 * slider50));
  jx_sus = slider51;
  jx_rel = 1 - exp(-ifs * exp(5.5 - 7.5 * slider52));
  slider52 < 0.01 ? jx_rel = 0.1;
  ifs *= JX_KMAX;
  jx_fatt = 1 - exp(-ifs * exp(5.5 - 7.5 * slider45));
  jx_fdec = 1 - exp(-ifs * exp(5.5 - 7.5 * slider46));
  jx_fsus = slider47 * slider47;
  jx_frel = 1 - exp(-ifs * exp(5.5 - 7.5 * slider48));
  jx_glide = slider38 < 0.02 ? 1 : 1 - exp(-ifs * exp(6 - 7 * slider38));
  gd = 6.604 * slider39 - 3.302;
  jx_glidedisp = gd * gd * gd;
);

function dx_update()
local(ifs, c)
(
  ifs = 1 / srate;
  dx_tune = 8.175798915644 * ifs * pow(2, floor(slider69 * 6.9) - 2);
  dx_rati = floor(40.1 * slider61 * slider61);
  slider62 < 0.5 ? dx_ratf = 0.2 * slider62 * slider62 : (
    c = floor(8.9 * slider62);
    dx_ratf = c == 4 ? 0.25 : c == 5 ? 0.33333333 : c == 6 ? 0.5 : c == 7 ? 0.66666667 : 0.75;
  );
  dx_ratio = 1.570796326795 * (dx_rati + dx_ratf);
  dx_depth = 0.0002 * slider63 * slider63;
  dx_dept2 = 0.0002 * slider65 * slider65;
  dx_velsens = slider67;
  dx_vibrato = 0.001 * slider68 * slider68;
  dx_catt = 1 - exp(-ifs * exp(8 - 8 * slider58));
  dx_cdec = slider59 > 0.98 ? 1 : exp(-ifs * exp(5 - 8 * slider59));
  dx_crel = exp(-ifs * exp(5 - 5 * slider60));
  dx_mdec = 1 - exp(-ifs * exp(6 - 7 * slider64));
  dx_mrel = 1 - exp(-ifs * exp(5 - 8 * slider66));
  dx_rich = 0.5 - 3 * slider71 * slider71;
  dx_modmix = 0.25 * slider72 * slider72;
  dx_dlfo = 628.3 * ifs * 25 * slider73 * slider73;
);

function update_engine(e)
(
  e == 0 ? pn_update() : e == 1 ? ep_update() : e == 2 ? jx_update() : dx_update();
);

function sync_cache(e)
local(s)
(
  s = sl_lo(e);
  loop(sl_hi(e) - sl_lo(e) + 1, pcache[s] = slider(s); s += 1; );
);

function load_prog(e, n)
local(j, s, tb)
(
  n = max(0, min(prog_count(e) - 1, floor(n + 0.5)));
  tb = prog_table(e) + n * npar(e);
  j = 0;
  loop(npar(e), s = sl_of(e, j); s > 0 ? slider(s) = tb[j]; j += 1; );
  slider(8 + e) = n;
  pcur[e] = n;
  update_engine(e);
  sync_cache(e);
  prog_notify = 1;
);

// Program slider moved on its own (generic UI, automation) loads that program; moved
// together with the parameters (preset or project recall) it just adopts them.
function check_engine(e)
local(s, changed, ps)
(
  changed = 0;
  s = sl_lo(e);
  loop(sl_hi(e) - sl_lo(e) + 1, slider(s) != pcache[s] ? changed = 1; s += 1; );
  ps = floor(slider(8 + e) + 0.5);
  ps != pcur[e] ? (
    changed ? (
      pcur[e] = ps;
      update_engine(e);
      sync_cache(e);
    ) : load_prog(e, ps);
  ) : changed ? (
    update_engine(e);
    sync_cache(e);
  );
);

// ---------------------------------------------------------------------------------------
// Piano   voice: 0 delta 1 frac 2 pos 3 end 4 loop 5 env 6 dec 7 f0 8 f1 9 ff 10 outl 11 outr 12 note

function pn_note_on(note, vel)
local(l, vi, vl, vp, k, s, kb, n2)
(
  vel > 0 ? (
    vl = 0;
    pn_nact < pn_poly ? (
      vl = pn_nact;
      pn_nact += 1;
    ) : (
      l = 99; vi = 0;
      loop(pn_poly, vp = pn_v + vi * 16; vp[5] < l ? ( l = vp[5]; vl = vi; ); vi += 1; );
    );
    k = (note - 60) * (note - 60);
    l = pn_fine + pn_random * ((k % 13) - 6.5);
    note > 60 ? l += pn_stretch * k;
    s = pn_size;
    vel > 40 ? s += itrunc(pn_sizevel * (vel - 40));
    k = 0;
    while (note > pn_kg[k * 5 + 1] + s) ( k += 1; );
    kb = pn_kg + k * 5;
    l += note - kb[0];
    l = 22050 / srate * exp(0.05776226505 * l);
    vp = pn_v + vl * 16;
    vp[0] = floor(65536 * l);
    vp[1] = 0;
    vp[2] = kb[2]; vp[3] = kb[3]; vp[4] = kb[4];
    vp[5] = (0.5 + pn_velsens) * pow(0.0078 * vel, pn_velsens);
    l = 50 + slider16 * slider16 * pn_muff + pn_muffvel * (vel - 64);
    l < 55 + 0.25 * note ? l = 55 + 0.25 * note;
    l > 210 ? l = 210;
    vp[9] = l * l / srate;
    vp[7] = 0; vp[8] = 0;
    vp[12] = note;
    n2 = max(12, min(108, note));
    l = pn_volume * pn_trim;
    vp[11] = l + l * pn_width * (n2 - 60);
    vp[10] = l + l - vp[11];
    n2 < 44 ? n2 = 44;
    l = 2 * slider12;
    l < 1 ? l += 0.25 - 0.5 * slider12;
    vp[6] = exp(-exp(-0.6 + 0.033 * n2 - l) / srate);
  ) : (
    vi = 0;
    loop(pn_nact,
      vp = pn_v + vi * 16;
      vp[12] == note ? (
        pn_sustain == 0 ? (
          (note < 94 || note == 128) ? vp[6] = exp(-exp(2 + 0.017 * note - 2 * slider13) / srate);
        ) : vp[12] = 128;
      );
      vi += 1;
    );
  );
);

function pn_event(st, d1, d2)
local(vi)
(
  st == 0x80 ? pn_note_on(d1, 0) :
  st == 0x90 ? pn_note_on(d1, d2) :
  st == 0xB0 ? (
    (d1 == 1 || d1 == 0x43) ? pn_muff = 0.01 * (127 - d2) * (127 - d2) :
    d1 == 7 ? pn_volume = 0.00002 * d2 * d2 :
    (d1 == 0x40 || d1 == 0x42) ? ( pn_sustain = d2 & 0x40; pn_sustain == 0 ? pn_note_on(128, 0); ) :
    d1 > 0x7A ? (
      vi = 0; loop(pn_nact, pn_v[vi * 16 + 6] = 0.99; vi += 1; );
      pn_sustain = 0;
      pn_muff = 160;
    );
  ) :
  st == 0xC0 ? ( d1 < N_PROG_PN ? load_prog(0, d1); );
);

function pn_sample()
local(l, r, vp, f, adv, w0, x)
(
  l = 0; r = 0; vp = pn_v;
  loop(pn_nact,
    f = vp[1] + vp[0];
    adv = floor(f / 65536);
    vp[2] += adv;
    vp[1] = f - adv * 65536;
    vp[2] > vp[3] ? vp[2] -= vp[4];
    w0 = pn_w[vp[2]];
    x = vp[5] * (w0 + floor(vp[1] * (pn_w[vp[2] + 1] - w0) / 65536)) / 32768;
    vp[5] *= vp[6];
    vp[7] += vp[9] * (x + vp[8] - vp[7]);
    vp[8] = x;
    l += vp[10] * vp[7];
    r += vp[11] * vp[7];
    (!(l > -2) || !(l < 2)) ? l = 0;
    (!(r > -2) || !(r < 2)) ? r = 0;
    vp += 16;
  );
  pn_comb[pn_cpos] = l + r;
  pn_cpos = (pn_cpos + 1) & pn_cmax;
  x = pn_cdep * pn_comb[pn_cpos];
  out_l = l + x;
  out_r = r - x;
);

function pn_block_end()
local(vi, vp)
(
  vi = 0;
  while (vi < pn_nact) (
    vp = pn_v + vi * 16;
    vp[5] < PN_SIL ? ( pn_nact -= 1; memcpy(vp, pn_v + pn_nact * 16, 16); );
    vi += 1;
  );
);

// ---------------------------------------------------------------------------------------
// ePiano   voice: as Piano (f0/f1/ff unused)

function ep_note_on(note, vel)
local(l, vi, vl, vp, k, s, kb, n2)
(
  vel > 0 ? (
    vl = 0;
    ep_nact < ep_poly ? (
      vl = ep_nact;
      ep_nact += 1;
      vp = ep_v + vl * 16; vp[7] = 0; vp[8] = 0;
    ) : (
      l = 99; vi = 0;
      loop(ep_poly, vp = ep_v + vi * 16; vp[5] < l ? ( l = vp[5]; vl = vi; ); vi += 1; );
    );
    k = (note - 60) * (note - 60);
    l = ep_fine + ep_random * ((k % 13) - 6.5);
    s = ep_size;
    k = 0;
    while (note > ep_kg[k * 5 + 1] + s) ( k += 3; );
    l += note - ep_kg[k * 5];
    l = 32000 / srate * exp(0.05776226505 * l);
    vp = ep_v + vl * 16;
    vp[0] = floor(65536 * l);
    vp[1] = 0;
    vel > 48 ? k += 1;
    vel > 80 ? k += 1;
    kb = ep_kg + k * 5;
    vp[2] = kb[2]; vp[3] = kb[3] - 1; vp[4] = kb[4];
    vp[5] = (3 + 2 * ep_velsens) * pow(0.0078 * vel, ep_velsens);
    note > 60 ? vp[5] *= exp(0.01 * (60 - note));
    vp[12] = note;
    n2 = max(12, min(108, note));
    l = ep_volume;
    vp[11] = l + l * ep_width * (n2 - 60);
    vp[10] = l + l - vp[11];
    n2 < 44 ? n2 = 44;
    vp[6] = exp(-exp(-1 + 0.03 * n2 - 2 * slider23) / srate);
  ) : (
    vi = 0;
    loop(ep_nact,
      vp = ep_v + vi * 16;
      vp[12] == note ? (
        ep_sustain == 0 ? vp[6] = exp(-exp(6 + 0.01 * note - 5 * slider24) / srate) : vp[12] = 128;
      );
      vi += 1;
    );
  );
);

function ep_event(st, d1, d2)
local(vi)
(
  (ep_nact == 0 && slider27 > 0.5) ? ( ep_lfo0 = -0.7071; ep_lfo1 = 0.7071; );
  st == 0x80 ? ep_note_on(d1, 0) :
  st == 0x90 ? ep_note_on(d1, d2) :
  st == 0xB0 ? (
    d1 == 1 ? (
      ep_modwhl = 0.0078 * d2;
      ep_modwhl > 0.05 ? ( ep_rmod = ep_lmod = ep_modwhl; slider27 < 0.5 ? ep_rmod = -ep_rmod; );
    ) :
    d1 == 7 ? ep_volume = 0.00002 * d2 * d2 :
    (d1 == 0x40 || d1 == 0x42) ? ( ep_sustain = d2 & 0x40; ep_sustain == 0 ? ep_note_on(128, 0); ) :
    d1 > 0x7A ? (
      vi = 0; loop(ep_nact, ep_v[vi * 16 + 6] = 0.99; vi += 1; );
      ep_sustain = 0;
    );
  ) :
  st == 0xC0 ? ( d1 < N_PROG_EP ? load_prog(1, d1); );
);

function ep_sample()
local(l, r, vp, f, adv, w0, x)
(
  l = 0; r = 0; vp = ep_v;
  loop(ep_nact,
    f = vp[1] + vp[0];
    adv = floor(f / 65536);
    vp[2] += adv;
    vp[1] = f - adv * 65536;
    vp[2] > vp[3] ? vp[2] -= vp[4];
    w0 = ep_w[vp[2]];
    x = vp[5] * (w0 + floor(vp[1] * (ep_w[vp[2] + 1] - w0) / 65536)) / 32768;
    vp[5] *= vp[6];
    x > 0 ? ( x -= ep_od * x * x; x < -vp[5] ? x = -vp[5]; );
    l += vp[10] * x;
    r += vp[11] * x;
    vp += 16;
  );
  ep_tl += ep_tfrq * (l - ep_tl);
  ep_tr += ep_tfrq * (r - ep_tr);
  r += ep_treb * (r - ep_tr);
  l += ep_treb * (l - ep_tl);
  ep_lfo0 += ep_dlfo * ep_lfo1;
  ep_lfo1 -= ep_dlfo * ep_lfo0;
  out_l = l + l * ep_lmod * ep_lfo1;
  out_r = r + r * ep_rmod * ep_lfo1;
);

function ep_block_end()
local(vi, vp)
(
  abs(ep_tl) < 0.0000000001 ? ep_tl = 0;
  abs(ep_tr) < 0.0000000001 ? ep_tr = 0;
  vi = 0;
  while (vi < ep_nact) (
    vp = ep_v + vi * 16;
    vp[5] < EP_SIL ? ( ep_nact -= 1; memcpy(vp, ep_v + ep_nact * 16, 16); );
    vi += 1;
  );
);

// ---------------------------------------------------------------------------------------
// JX10   voice: 0 period 1 p 2 pmax 3 dp 4 sin0 5 sin1 6 sinx 7 dc 8 detune 9 p2 10 pmax2
//        11 dp2 12 sin02 13 sin12 14 sinx2 15 dc2 16 fc 17 ff 18 f0 19 f1 20 f2 21 saw
//        22 env 23 envd 24 envl 25 fenv 26 fenvd 27 fenvl 28 lev 29 lev2 30 target 31 note

function jx_period(note, vi)
local(p)
(
  p = jx_tune * exp(-0.05776226505 * (note + JX_ANALOG * (vi & 7)));
  while (p < 3 || p * jx_detune < 3) ( p += p; );
  p;
);

function jx_note_on(note, vel)
local(p, l, vi, vp, tmp, held, done)
(
  done = 0; held = 0; // locals keep their value between calls: the note-off path reads held too
  vel > 0 ? (
    jx_veloff ? vel = 80;
    vi = 0;
    jx_mode & 4 ? (
      jx_v[31] > 0 ? (
        tmp = 7;
        loop(7, vp = jx_v + tmp * 32; vp[31] = vp[-1]; tmp -= 1; );
        p = jx_period(note, 0);
        jx_v[30] = p;
        (jx_mode & 2) == 0 ? jx_v[0] = p;
        jx_v[16] = exp(jx_filtvel * (vel - 64)) / p;
        jx_v[22] += JX_SIL + JX_SIL;
        jx_v[31] = note;
        done = 1;
      );
    ) : (
      l = 100; tmp = 0;
      loop(jx_poly,
        vp = jx_v + tmp * 32;
        vp[31] > 0 ? held += 1;
        (vp[22] < l && vp[24] < 2) ? ( l = vp[22]; vi = tmp; );
        tmp += 1;
      );
    );
    !done ? (
      vp = jx_v + vi * 32;
      p = jx_period(note, vi);
      vp[30] = p;
      vp[8] = jx_detune;
      tmp = 0;
      jx_mode & 2 ? ( ((jx_mode & 1) || held) ? tmp = note - jx_lastnote; );
      vp[0] = p * pow(1.059463094359, tmp - jx_glidedisp);
      vp[0] < 3 ? vp[0] = 3;
      vp[31] = jx_lastnote = note;
      vp[16] = exp(jx_filtvel * (vel - 64)) / p;
      vp[28] = jx_voltrim * jx_volume * (0.004 * (vel + 64) * (vel + 64) - 8);
      vp[29] = vp[28] * jx_oscmix;
      slider54 < 0.5 ? (
        vp[3] > 0 ? ( p = vp[2] + vp[2] - vp[1]; vp[11] = -vp[3]; ) : ( p = vp[1]; vp[11] = vp[3]; );
        vp[9] = vp[10] = p + $pi * vp[0];
        vp[15] = 0;
        vp[12] = vp[13] = vp[14] = 0;
      );
      vp[22] += JX_SIL + JX_SIL;
      vp[24] = 2;
      vp[23] = jx_att;
      vp[27] = 2;
      vp[26] = jx_fatt;
      jx_hi = max(jx_hi, vi + 1);
      jx_top = max(jx_top, vi + 1);
    );
  ) : (
    ((jx_mode & 4) && jx_v[31] == note) ? (
      tmp = 7;
      loop(7, jx_v[tmp * 32 + 31] > 0 ? held = tmp; tmp -= 1; );
      held > 0 ? (
        jx_v[31] = jx_v[held * 32 + 31];
        jx_v[held * 32 + 31] = 0;
        p = jx_period(jx_v[31], 0);
        jx_v[30] = p;
        (jx_mode & 2) == 0 ? jx_v[0] = p;
        jx_v[16] = 1 / p;
      ) : (
        jx_v[24] = 0; jx_v[23] = jx_rel; jx_v[27] = 0; jx_v[26] = jx_frel; jx_v[31] = 0;
      );
    ) : (
      vi = 0;
      loop(jx_top,
        vp = jx_v + vi * 32;
        vp[31] == note ? (
          jx_sustain == 0 ? (
            vp[24] = 0; vp[23] = jx_rel; vp[27] = 0; vp[26] = jx_frel; vp[31] = 0;
          ) : vp[31] = -1;
        );
        vi += 1;
      );
    );
  );
);

function jx_event(st, d1, d2)
local(vi, vp)
(
  st == 0x80 ? jx_note_on(d1, 0) :
  st == 0x90 ? jx_note_on(d1, d2) :
  st == 0xB0 ? (
    d1 == 0x01 ? jx_modwhl = 0.000005 * d2 * d2 :
    (d1 == 0x02 || d1 == 0x4A) ? jx_filtwhl = 0.02 * d2 :
    d1 == 0x03 ? jx_filtwhl = -0.03 * d2 :
    d1 == 0x07 ? jx_volume = 0.00000005 * d2 * d2 :
    (d1 == 0x10 || d1 == 0x47) ? jx_rezwhl = 0.0065 * (154 - d2) :
    d1 == 0x40 ? ( jx_sustain = d2 & 0x40; jx_sustain == 0 ? jx_note_on(-1, 0); ) :
    d1 > 0x7A ? (
      vi = 0;
      loop(jx_top, vp = jx_v + vi * 32; vp[24] = vp[22] = 0; vp[23] = 0.99; vp[31] = 0; vi += 1; );
      jx_sustain = 0;
    );
  ) :
  st == 0xC0 ? ( d1 < N_PROG_JX ? load_prog(2, d1); ) :
  st == 0xD0 ? jx_press = 0.00001 * d1 * d1 :
  st == 0xE0 ? ( jx_ipbend = exp(0.000014102 * (d1 + 128 * d2 - 8192)); jx_pbend = 1 / jx_ipbend; );
);

function jx_block_begin()
local(vib)
(
  vib = sin(jx_lfo);
  jx_ff = jx_filtf + jx_filtwhl + (jx_filtlfo + jx_press) * vib;
  jx_pwm = 1 + vib * (jx_modwhl + jx_pwmdep);
  jx_vib = 1 + vib * (jx_modwhl + jx_vibrato);
  jx_pb = jx_pbend;
  jx_ipb = jx_ipbend;
  jx_gl = jx_glide;
  jx_ww = jx_noisemix;
  jx_fe = jx_filtenv;
  jx_fq = jx_filtq * jx_rezwhl;
  jx_fx = 1.97 - 0.85 * jx_fq;
);

function jx_sample()
local(vp, o, e, x, y, w, vib, a, t)
(
  // noise = noise * 196314165 + 907633515 (mod 2^32), split so doubles stay exact
  a = floor(jx_noise / 65536);
  t = jx_noise - a * 65536;
  a = a * 33845 + t * 2995;
  a -= floor(a / 65536) * 65536;
  t = t * 33845 + a * 65536 + 907633515;
  jx_noise = t - floor(t / 4294967296) * 4294967296;
  w = jx_ww * ((jx_noise - floor(jx_noise / 8388608) * 8388608) / 4194304 - 1);

  (jx_k -= 1) < 0 ? (
    jx_lfo += jx_dlfo;
    jx_lfo > $pi ? jx_lfo -= 2 * $pi;
    vib = sin(jx_lfo);
    jx_ff = jx_filtf + jx_filtwhl + (jx_filtlfo + jx_press) * vib;
    jx_pwm = 1 + vib * (jx_modwhl + jx_pwmdep);
    jx_vib = 1 + vib * (jx_modwhl + jx_vibrato);
    jx_k = JX_KMAX;
  );

  o = 0; vp = jx_v;
  loop(jx_hi,
    e = vp[22];
    e > JX_SIL ? (
      x = vp[1] + vp[3];
      x > 1 ? (
        x > vp[2] ? ( x = vp[2] + vp[2] - x; vp[3] = -vp[3]; );
        vp[1] = x;
        x = vp[4] * vp[6] - vp[5];
        vp[5] = vp[4];
        vp[4] = x;
        x = x / vp[1];
      ) : (
        vp[1] = x = -x;
        vp[3] = vp[0] * jx_vib * jx_pb;
        vp[2] = floor(0.5 + vp[3]) - 0.5;
        vp[7] = -0.5 * vp[28] / vp[2];
        vp[2] *= $pi;
        vp[3] = vp[2] / vp[3];
        vp[4] = vp[28] * sin(x);
        vp[5] = vp[28] * sin(x - vp[3]);
        vp[6] = 2 * cos(vp[3]);
        x = x * x > 0.1 ? vp[4] / x : vp[28];
      );

      y = vp[9] + vp[11];
      y > 1 ? (
        y > vp[10] ? ( y = vp[10] + vp[10] - y; vp[11] = -vp[11]; );
        vp[9] = y;
        y = vp[12] * vp[14] - vp[13];
        vp[13] = vp[12];
        vp[12] = y;
        y = y / vp[9];
      ) : (
        vp[9] = y = -y;
        vp[11] = vp[0] * vp[8] * jx_pwm * jx_pb;
        vp[10] = floor(0.5 + vp[11]) - 0.5;
        vp[15] = -0.5 * vp[29] / vp[10];
        vp[10] *= $pi;
        vp[11] = vp[10] / vp[11];
        vp[12] = vp[29] * sin(y);
        vp[13] = vp[29] * sin(y - vp[11]);
        vp[14] = 2 * cos(vp[11]);
        y = y * y > 0.1 ? vp[12] / y : vp[29];
      );

      vp[21] = vp[21] * 0.997 + vp[7] + x - vp[15] - y;
      x = vp[21] + w;
      vp[22] += vp[23] * (vp[24] - vp[22]);

      jx_k == JX_KMAX ? (
        vp[22] + vp[24] > 3 ? ( vp[23] = jx_dec; vp[24] = jx_sus; );
        vp[25] += vp[26] * (vp[27] - vp[25]);
        vp[25] + vp[27] > 3 ? ( vp[26] = jx_fdec; vp[27] = jx_fsus; );
        jx_fz += 0.005 * (jx_ff - jx_fz);
        y = vp[16] * exp(jx_fz + jx_fe * vp[25]) * jx_ipb;
        y < 0.005 ? y = 0.005;
        vp[17] = y;
        vp[0] += jx_gl * (vp[30] - vp[0]);
        vp[30] < vp[0] ? vp[0] += jx_gl * (vp[30] - vp[0]);
      );

      vp[17] > jx_fx ? vp[17] = jx_fx;
      vp[18] += vp[17] * vp[19];
      vp[19] -= vp[17] * (vp[18] + jx_fq * vp[19] - x - vp[20]);
      vp[19] -= 0.2 * vp[19] * vp[19] * vp[19];
      vp[20] = x;
      o += vp[22] * vp[18];
    );
    vp += 32;
  );
  out_l = out_r = o;
);

function jx_block_end()
local(vi, vp, hi)
(
  jx_nact = 0; hi = 0; vi = 0;
  loop(jx_hi,
    vp = jx_v + vi * 32;
    vp[22] < JX_SIL ? (
      vp[22] = vp[24] = 0;
      vp[18] = vp[19] = vp[20] = 0;
    ) : ( jx_nact += 1; hi = vi + 1; );
    vi += 1;
  );
  jx_hi = hi;
);

// ---------------------------------------------------------------------------------------
// DX10   voice: 0 env 1 dmod 2 mod0 3 mod1 4 menv 5 mlev 6 mdec 7 car 8 dcar 9 cenv
//        10 catt 11 cdec 12 note

function dx_note_on(note, vel)
local(l, vi, vl, vp)
(
  vel > 0 ? (
    l = 1; vl = 0; vi = 0;
    loop(dx_poly, vp = dx_v + vi * 16; vp[0] < l ? ( l = vp[0]; vl = vi; ); vi += 1; );
    l = exp(0.05776226505 * (note + slider70 + slider70 - 1));
    vp = dx_v + vl * 16;
    vp[12] = note;
    vp[7] = 0;
    vp[8] = dx_tune * dx_pbend * l;
    l > 50 ? l = 50;
    l *= 64 + dx_velsens * (vel - 64);
    vp[4] = dx_depth * l;
    vp[5] = dx_dept2 * l;
    vp[6] = dx_mdec;
    vp[1] = dx_ratio * vp[8];
    vp[2] = 0;
    vp[3] = sin(vp[1]);
    vp[1] = 2 * cos(vp[1]);
    vp[0] = (1.5 - slider71) * dx_volume * (vel + 10);
    vp[10] = dx_catt;
    vp[9] = 0;
    vp[11] = dx_cdec;
    dx_hi = max(dx_hi, vl + 1);
    dx_top = max(dx_top, vl + 1);
  ) : (
    vi = 0;
    loop(dx_top,
      vp = dx_v + vi * 16;
      vp[12] == note ? (
        dx_sustain == 0 ? (
          vp[11] = dx_crel; vp[0] = vp[9]; vp[10] = 1; vp[5] = 0; vp[6] = dx_mrel;
        ) : vp[12] = 128;
      );
      vi += 1;
    );
  );
);

function dx_event(st, d1, d2)
local(vi, pb)
(
  st == 0x80 ? dx_note_on(d1, 0) :
  st == 0x90 ? dx_note_on(d1, d2) :
  st == 0xB0 ? (
    d1 == 0x01 ? dx_modwhl = 0.00000005 * d2 * d2 :
    d1 == 0x07 ? dx_volume = 0.00000035 * d2 * d2 :
    d1 == 0x40 ? ( dx_sustain = d2 & 0x40; dx_sustain == 0 ? dx_note_on(128, 0); ) :
    d1 > 0x7A ? (
      vi = 0; loop(dx_top, dx_v[vi * 16 + 11] = 0.99; vi += 1; );
      dx_sustain = 0;
    );
  ) :
  st == 0xC0 ? ( d1 < N_PROG_DX ? load_prog(3, d1); ) :
  st == 0xE0 ? (
    pb = d1 + 128 * d2 - 8192;
    dx_pbend = pb > 0 ? 1 + 0.000014951 * pb : 1 + 0.000013318 * pb;
  );
);

function dx_sample()
local(vp, o, e, x)
(
  (dx_k -= 1) < 0 ? (
    dx_lfo0 += dx_dlfo * dx_lfo1;
    dx_lfo1 -= dx_dlfo * dx_lfo0;
    dx_mw = dx_lfo1 * (dx_modwhl + dx_vibrato);
    dx_k = 100;
  );
  o = 0; vp = dx_v;
  loop(dx_hi,
    e = vp[0];
    e > DX_SIL ? (
      vp[0] = e * vp[11];
      vp[9] += vp[10] * (e - vp[9]);
      x = vp[1] * vp[2] - vp[3];
      vp[3] = vp[2];
      vp[2] = x;
      vp[4] += vp[6] * (vp[5] - vp[4]);
      x = vp[7] + vp[8] + x * vp[4] + dx_mw;
      while (x > 1) ( x -= 2; );
      while (x < -1) ( x += 2; );
      vp[7] = x;
      o += vp[9] * (dx_m * vp[3] + (x + x * x * x * (dx_w * x * x - 1 - dx_w)));
    );
    vp += 16;
  );
  out_l = out_r = o;
);

function dx_block_end()
local(vi, vp, hi)
(
  dx_nact = 0; hi = 0; vi = 0;
  loop(dx_hi,
    vp = dx_v + vi * 16;
    vp[0] < DX_SIL ? ( vp[0] = vp[9] = 0; ) : ( dx_nact += 1; hi = vi + 1; );
    vp[4] < DX_SIL ? ( vp[4] = vp[5] = 0; );
    vi += 1;
  );
  dx_hi = hi;
);

// ---------------------------------------------------------------------------------------
// Shared

function reset_engine(e)
local(vi, vp)
(
  e == 0 ? (
    memset(pn_v, 0, 256 * 16);
    vi = 0; loop(256, pn_v[vi * 16 + 6] = 0.99; vi += 1; );
    pn_nact = 0; pn_sustain = 0; pn_cpos = 0;
    memset(pn_comb, 0, 256);
  ) : e == 1 ? (
    memset(ep_v, 0, 256 * 16);
    vi = 0; loop(256, ep_v[vi * 16 + 6] = 0.99; vi += 1; );
    ep_nact = 0; ep_sustain = 0;
  ) : e == 2 ? (
    memset(jx_v, 0, 256 * 32);
    vi = 0; loop(256, vp = jx_v + vi * 32; vp[3] = vp[11] = 1; vp[23] = 0.99; vi += 1; );
    jx_hi = 0; jx_top = 8; jx_nact = 0; jx_sustain = 0;
  ) : (
    memset(dx_v, 0, 256 * 16);
    vi = 0; loop(256, dx_v[vi * 16 + 11] = 0.99; vi += 1; );
    dx_hi = 0; dx_top = 0; dx_nact = 0; dx_sustain = 0;
  );
);

// Instrument slider order (ePiano, JX10, DX10, Piano) vs engine numbers (0 Piano .. 3 DX10)
function inst_eng(v) ( (max(0, min(3, floor(v + 0.5))) + 1) % 4; );
function eng_inst(e) ( (e + 3) % 4; );

function handle_event(st, d1, d2)
(
  st == 0x90 && d2 > 0 ? midi_flag = 1;
  eng == 0 ? pn_event(st, d1, d2) :
  eng == 1 ? ep_event(st, d1, d2) :
  eng == 2 ? jx_event(st, d1, d2) : dx_event(st, d1, d2);
);

!synth_inited ? (
  pn_volume = 0.2; pn_muff = 160;
  ep_volume = 0.2; ep_lfo1 = 1;
  jx_rezwhl = jx_pbend = jx_ipbend = 1; jx_volume = 0.0005; jx_noise = 22222;
  dx_lfo1 = 1; dx_pbend = 1; dx_volume = 0.0035;
  e = 0;
  loop(4,
    reset_engine(e);
    pcur[e] = floor(slider(8 + e) + 0.5);
    update_engine(e);
    sync_cache(e);
    e += 1;
  );
  eng = inst_eng(slider1);
  synth_inited = 1;
);
cur_srate = srate;
meter_decay = pow(0.001, 1 / (0.4 * srate));

@block

blk_done ? (
  eng == 0 ? pn_block_end() :
  eng == 1 ? ep_block_end() :
  eng == 2 ? ( !jx_skip ? jx_block_end(); ) :
  ( !dx_skip ? dx_block_end(); );
);

srate != cur_srate ? (
  cur_srate = srate;
  meter_decay = pow(0.001, 1 / (0.4 * srate));
  update_engine(0); update_engine(1); update_engine(2); update_engine(3);
);

new_eng = inst_eng(slider1);
new_eng != eng ? (
  reset_engine(eng);
  eng = new_eng;
  reset_engine(eng);
  update_engine(eng);
  sync_cache(eng);
);
check_engine(eng);

pn_poly = pow(2, max(0, min(8, floor(slider4 + 0.5))));
ep_poly = pow(2, max(0, min(8, floor(slider5 + 0.5))));
jx_poly = pow(2, max(0, min(8, floor(slider6 + 0.5))));
dx_poly = pow(2, max(0, min(8, floor(slider7 + 0.5))));
out_gain = pow(10, slider3 / 20);

q_n = 0;
while (midirecv(m_ofs, m_1, m_23)) (
  m_st = m_1 & 0xF0;
  (m_st >= 0x80 && m_st < 0xF0 && q_n < 1000 && (slider2 < 0.5 || (m_1 & 0x0F) + 1 == floor(slider2 + 0.5))) ? (
    q_ofs[q_n] = m_ofs;
    q_st[q_n] = m_st;
    q_d1[q_n] = m_23 & 0x7F;
    q_d2[q_n] = (m_23 >> 8) & 0x7F;
    q_n += 1;
  );
);

eng == 1 ? ep_od = ep_overdrive;
eng == 2 ? ( jx_skip = jx_nact == 0 && q_n == 0; !jx_skip ? jx_block_begin(); );
eng == 3 ? ( dx_skip = dx_nact == 0 && q_n == 0; dx_w = dx_rich; dx_m = dx_modmix; );

q_rd = 0;
q_next = q_n > 0 ? q_ofs[0] : NO_EVENT;
spos = 0;
blk_done = 1;

prog_notify ? ( sliderchange(-1); prog_notify = 0; );

@sample

spos >= q_next ? (
  while (q_rd < q_n && q_ofs[q_rd] <= spos) (
    handle_event(q_st[q_rd], q_d1[q_rd], q_d2[q_rd]);
    q_rd += 1;
  );
  q_next = q_rd < q_n ? q_ofs[q_rd] : NO_EVENT;
);

eng == 0 ? pn_sample() :
eng == 1 ? ep_sample() :
eng == 2 ? ( jx_skip ? out_l = out_r = 0 : jx_sample(); ) :
( dx_skip ? out_l = out_r = 0 : dx_sample(); );

spl0 = out_l * out_gain;
spl1 = out_r * out_gain;
spos += 1;

lvl_now = max(abs(spl0), abs(spl1));
lvl_now > meter_peak ? meter_peak = lvl_now : meter_peak *= meter_decay;
lvl_now >= 0.999 ? clip_latch = 1;

@gfx 800 480

scale = max(0.5, min(gfx_w / 800, gfx_h / 480));
ox = floor((gfx_w - 800*scale) * 0.5);
oy = floor((gfx_h - 480*scale) * 0.5);

MARGIN = 14*scale;
CW = 78*scale;
KR = 19*scale;
PANEL_H = 94*scale;
ROW_PITCH = 102*scale;

function knob_name(s)
(
  s == 12 ? "Decay" :
  s == 13 ? "Release" :
  s == 14 ? "Hardness" :
  s == 15 ? "Vel>Hard" :
  s == 16 ? "Muffle" :
  s == 17 ? "Vel>Muffle" :
  s == 18 ? "Vel Sens" :
  s == 19 ? "Width" :
  s == 20 ? "Fine" :
  s == 21 ? "Random" :
  s == 22 ? "Stretch" :
