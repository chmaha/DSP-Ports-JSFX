// ---------------------------------------------------------------------------------------
// Sample data

function load_wave(fn, dest, n)
local(h, nch, sr, ok, i)
(
  ok = 0;
  h = file_open(fn);
  h >= 0 ? (
    nch = 0; sr = 0;
    file_riff(h, nch, sr);
    (nch == 1 && file_avail(h) >= n) ? (
      file_mem(h, dest, n) == n ? (
        i = 0;
        loop(n, dest[i] = floor(dest[i] * 32768 + 0.5); i += 1; );
        ok = 1;
      );
    );
    file_close(h);
  );
  ok;
);

function load_waves()
(
  !pn_ok ? (
    memset(pn_w, 0, PN_WAVELEN + 16);
    pn_ok = load_wave("Dependencies/SynthyMcSynthfacePiano.flac", pn_w, PN_WAVELEN);
    !pn_ok ? pn_ok = load_wave("SynthyMcSynthfacePiano.flac", pn_w, PN_WAVELEN);
  );
  !ep_ok ? (
    memset(ep_w, 0, EP_WAVELEN + 16);
    ep_ok = load_wave("Dependencies/SynthyMcSynthfaceEPiano.flac", ep_w, EP_WAVELEN);
    !ep_ok ? ep_ok = load_wave("SynthyMcSynthfaceEPiano.flac", ep_w, EP_WAVELEN);
  );
);

load_waves();

function kg_set(kg, k, root, high, pos, end, lp)
local(b)
(
  b = kg + k * 5;
  b[0] = root; b[1] = high; b[2] = pos; b[3] = end; b[4] = lp;
);

// kg: root, high, pos, end, loop per keygroup
kg_set(pn_kg,  0, 36,  37,      0,  36275, 14774);
kg_set(pn_kg,  1, 40,  41,  36278,  83135, 16268);
