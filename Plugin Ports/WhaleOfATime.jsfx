slider1:clock_mode=0<0,1,1{Follow transport,Free run}>-Clock
slider2:tpb=4<1,16,1>-Ticks per Beat
slider3:free_bpm=120<20,300,1>-Free Run Tempo
slider4:rewind_on=1<0,1,1{Off,On}>-Rewind on Play
slider5:thru=1<0,1,1{Off,On}>-MIDI Thru
slider6:free_run=0<0,1,1{Stopped,Running}>-Free Run

in_pin:none
out_pin:none

options:no_meter
options:want_all_kb

@init
ext_noinit = gfx_ext_retina = 1;

GW = 64; GH = 32; NC = GW * GH;
NMAX = 128;
GRID = 0;
HOME = 4096;
LOCK = 8192;
DLOCK = 12288;
DISP = 16384;
VARS = 20480;
NT = 20736;
OQ = 21504;
CLIP = 26112;
UNDO = 28672;
REDO = 61440;
UMAX = 16;

function in_b(x, y) ( x >= 0 && x < GW && y >= 0 && y < GH; );
function gat(x, y) ( in_b(x, y) ? GRID[y * GW + x] : 46; );
function imod(a, b) ( a - floor(a / b) * b; );
function v36(g) ( g >= 48 && g <= 57 ? g - 48 : g >= 97 && g <= 122 ? g - 87 : g >= 65 && g <= 90 ? g - 55 : 0; );
function k36(v, uc) ( v = imod(floor(v), 36); v < 10 ? 48 + v : uc ? 55 + v : 87 + v; );
function isup(g) ( g >= 65 && g <= 90; );

function rnd01() ( o_seed = o_seed * 16807; o_seed -= floor(o_seed / 2147483647) * 2147483647; o_seed / 2147483647; );

function q_out(ofs, b1, b2, b3) local(p)
(
  oq_n < 1000 ? (
    p = OQ + oq_n * 4;
    p[0] = ofs; p[1] = b1; p[2] = b2; p[3] = b3;
    oq_n += 1;
  );
);

function oq_flush() local(i, j, a, b, c, d, p)
(
  i = 1;
  while (i < oq_n) (
    p = OQ + i * 4; a = p[0]; b = p[1]; c = p[2]; d = p[3];
    j = i - 1;
    while (j >= 0 && OQ[j * 4] > a) (
      OQ[(j + 1) * 4] = OQ[j * 4]; OQ[(j + 1) * 4 + 1] = OQ[j * 4 + 1];
      OQ[(j + 1) * 4 + 2] = OQ[j * 4 + 2]; OQ[(j + 1) * 4 + 3] = OQ[j * 4 + 3];
      j -= 1;
    );
    p = OQ + (j + 1) * 4; p[0] = a; p[1] = b; p[2] = c; p[3] = d;
    i += 1;
  );
  i = 0;
  loop(oq_n, p = OQ + i * 4; midisend(p[0], p[1], p[2], p[3]); i += 1;);
  oq_n = 0;
);

// ---------------- notes ----------------
function n_off(i) local(p)
(
  p = NT + i * 5;
  p[0] ? (q_out(o_ofs, 128 | p[1], p[2], 0); p[0] = 0; n_count -= 1;);
);

function all_off(ofs) local(i)
(
  o_ofs = ofs;
  i = 0; loop(NMAX, n_off(i); i += 1;);
  n_count = 0;
);

function n_due() local(i, p)
(
  i = 0;
  loop(NMAX, p = NT + i * 5; (p[0] && p[3] <= frame) ? n_off(i); i += 1;);
);

function n_on(nch, n, vel, len, mono) local(i, p, fr)
(
  fr = -1;
  i = 0;
  loop(NMAX,
    p = NT + i * 5;
    p[0] ? (
      (p[1] == nch && (p[2] == n || (mono && p[4]))) ? n_off(i);
    );
    (!p[0] && fr < 0) ? fr = i;
    i += 1;
  );
  fr >= 0 ? (
    p = NT + fr * 5;
    p[0] = 1; p[1] = nch; p[2] = n; p[3] = frame + len; p[4] = mono;
    n_count += 1;
    q_out(o_ofs, 144 | nch, n, vel);
  );
);

function note_code(g)
(
  g == 65 ? 9 : g == 66 ? 11 : g == 67 ? 0 : g == 68 ? 2 : g == 69 ? 4 : g == 70 ? 5 : g == 71 ? 7 : g == 72 ? 9 :
  g == 73 ? 11 : g == 74 ? 12 : g == 75 ? 14 : g == 76 ? 16 : g == 77 ? 17 : g == 78 ? 19 : g == 79 ? 21 : g == 80 ? 23 :
  g == 81 ? 24 : g == 82 ? 26 : g == 83 ? 28 : g == 84 ? 29 : g == 85 ? 31 : g == 86 ? 33 : g == 87 ? 35 : g == 88 ? 36 :
  g == 89 ? 38 : g == 90 ? 40 : g == 97 ? 10 : g == 98 ? 12 : g == 99 ? 1 : g == 100 ? 3 : g == 101 ? 5 : g == 102 ? 6 :
  g == 103 ? 8 : g == 104 ? 10 : g == 105 ? 12 : g == 106 ? 13 : g == 107 ? 15 : g == 108 ? 17 : g == 109 ? 18 : g == 110 ? 20 :
  g == 111 ? 22 : g == 112 ? 24 : g == 113 ? 25 : g == 114 ? 27 : g == 115 ? 29 : g == 116 ? 30 : g == 117 ? 32 : g == 118 ? 34 :
  g == 119 ? 36 : g == 120 ? 37 : g == 121 ? 39 : g == 122 ? 41 : -1;
);

function allowed(g) ( g == 46 || (g >= 48 && g <= 57) || (g >= 65 && g <= 90) || (g >= 97 && g <= 122) || g == 42 || g == 35 || g == 58 || g == 37 || g == 33 || g == 63 || g == 61 || g == 59 || g == 36; );

// ---------------- interpreter ----------------
function lock_at(dx, dy) local(x, y)
(
  x = o_x + dx; y = o_y + dy;
  (in_b(x, y) && LK[y * GW + x] < 1) ? LK[y * GW + x] = 1;
);
function pg(dx, dy) ( lock_at(dx, dy); gat(o_x + dx, o_y + dy); );
function pv(dx, dy, def) local(g) ( g = pg(dx, dy); (g == 46 || g == 42) ? def : v36(g); );
function po(dx, dy, g) local(x, y)
(
  x = o_x + dx; y = o_y + dy;
  in_b(x, y) ? (
    o_dry ? 0 : GRID[y * GW + x] = g;
    LK[y * GW + x] = 2;
  );
);
function banged() ( gat(o_x - 1, o_y) == 42 || gat(o_x + 1, o_y) == 42 || gat(o_x, o_y - 1) == 42 || gat(o_x, o_y + 1) == 42; );

function mover(dx, dy, g) local(x, y, me)
(
  x = o_x + dx; y = o_y + dy; me = o_y * GW + o_x;
  o_dry ? (
    in_b(x, y) ? LK[y * GW + x] = 2;
  ) : (!in_b(x, y) || GRID[y * GW + x] != 46) ? GRID[me] = 42 : (
    GRID[me] = 46;
    GRID[y * GW + x] = g;
    LK[y * GW + x] = 2;
  );
);

function op_letter(L, g) local(a, b, uc, r, m, x, y, n, i, k, v, w)
(
  uc = isup(gat(o_x + 1, o_y));
  L == 65 || L == 66 || L == 76 || L == 77 ? (
    a = pv(-1, 0, 0); b = pv(1, 0, 0);
    po(0, 1, k36(L == 65 ? a + b : L == 66 ? abs(b - a) : L == 76 ? min(a, b) : a * b, uc));
  ) :
  L == 67 ? (
    r = max(1, pv(-1, 0, 0)); m = pv(1, 0, 0);
    m > 0 ? po(0, 1, k36(imod(floor(frame / r), m), uc)) : lock_at(0, 1);
  ) :
  L == 68 ? (
    r = max(1, pv(-1, 0, 0)); m = max(1, pv(1, 0, 0));
    po(0, 1, (m == 1 || imod(frame, m * r) == 0) ? 42 : 46);
  ) :
  L == 69 ? mover(1, 0, g) :
  L == 87 ? mover(-1, 0, g) :
  L == 78 ? mover(0, -1, g) :
  L == 83 ? mover(0, 1, g) :
  L == 70 ? (
    a = pg(-1, 0); b = pg(1, 0);
    po(0, 1, a == b ? 42 : 46);
  ) :
  L == 71 ? (
    x = pv(-3, 0, 0); y = pv(-2, 0, 0); n = max(1, pv(-1, 0, 0));
    i = 0;
    loop(n, v = pg(1 + i, 0); po(x + i, y + 1, v); i += 1;);
  ) :
  L == 72 ? (
    in_b(o_x, o_y + 1) ? LK[(o_y + 1) * GW + o_x] = 2;
  ) :
  L == 73 ? (
    a = pv(-1, 0, 0); m = pv(1, 0, 0);
    v = pv(0, 1, 0);
    po(0, 1, m > 0 ? k36(imod(v + a, m), uc) : 48);
  ) :
  L == 74 ? (
    v = gat(o_x, o_y - 1);
    v != 74 ? (
      i = 1;
      while (in_b(o_x, o_y + i) && gat(o_x, o_y + i) == g) (i += 1;);
      lock_at(0, -1);
      po(0, i, v);
    );
  ) :
  L == 75 ? (
    n = max(1, pv(-1, 0, 0));
    i = 0;
    loop(n,
      k = pg(1 + i, 0);
      k != 46 ? (w = VARS[k & 127]; po(1 + i, 1, w ? w : 46););
      i += 1;
    );
  ) :
  L == 79 ? (
    x = pv(-2, 0, 0); y = pv(-1, 0, 0);
    v = pg(x + 1, y);
    po(0, 1, v);
  ) :
  L == 80 ? (
    k = pv(-2, 0, 0); n = max(1, pv(-1, 0, 0));
    v = pg(1, 0);
    i = 0; loop(n, lock_at(i, 1); i += 1;);
    po(imod(k, n), 1, v);
  ) :
  L == 81 ? (
    x = pv(-3, 0, 0); y = pv(-2, 0, 0); n = max(1, pv(-1, 0, 0));
    i = 0;
    loop(n, v = pg(x + 1 + i, y); po(i - n + 1, 1, v); i += 1;);
  ) :
  L == 82 ? (
    a = pv(-1, 0, 0); b = pv(1, 0, 0);
    m = min(a, b); r = abs(b - a);
    v = (o_dry || r == 0) ? m : m + min(r, floor(rnd01() * (r + 1)));
    po(0, 1, k36(v, uc));
  ) :
  L == 84 ? (
    k = pv(-2, 0, 0); n = max(1, pv(-1, 0, 0));
    i = 0; loop(n, lock_at(1 + i, 0); i += 1;);
    v = pg(1 + imod(k, n), 0);
    po(0, 1, v);
  ) :
  L == 85 ? (
    a = pv(-1, 0, 0); m = max(1, pv(1, 0, 0));
    po(0, 1, imod(a * (frame + m - 1), m) + a >= m ? 42 : 46);
  ) :
  L == 86 ? (
    w = pg(-1, 0); v = pg(1, 0);
    w != 46 ? (o_dry ? 0 : VARS[w & 127] = v;) :
    v != 46 ? (k = VARS[v & 127]; po(0, 1, k ? k : 46););
  ) :
  L == 88 ? (
    x = pv(-2, 0, 0); y = pv(-1, 0, 0);
    v = pg(1, 0);
    po(x, y + 1, v);
  ) :
  L == 89 ? (
    v = gat(o_x - 1, o_y);
    v != 89 ? (
      i = 1;
      while (in_b(o_x + i, o_y) && gat(o_x + i, o_y) == g) (i += 1;);
      lock_at(-1, 0);
      po(i, 0, v);
    );
  ) :
  L == 90 ? (
    r = pv(-1, 0, 0); b = pv(1, 0, 0);
    v = pv(0, 1, 0);
    m = v <= b - r ? r : v >= b + r ? -r : b - v;
    po(0, 1, k36(v + m, uc));
  );
);

function op_midi(g, act) local(cg, og, ng, ve, ln, ncode, n, kb, vv)
(
  g == 58 || g == 37 ? (
    cg = pg(1, 0); og = pg(2, 0); ng = pg(3, 0); ve = min(16, pv(4, 0, 15)); ln = min(32, pv(5, 0, 1));
    ncode = note_code(ng);
    (act && !o_dry && cg != 46 && og != 46 && ncode >= 0 && v36(cg) < 16) ? (
      n = min(8, min(8, v36(og)) + floor(ncode / 12)) * 12 + (ncode % 12) + 24;
      ve = floor(ve / 16 * 127);
      ve > 0 ? n_on(v36(cg), min(127, n), ve, max(1, ln), g == 37);
    );
  ) : g == 33 ? (
    cg = pg(1, 0); kb = pg(2, 0); vv = pv(3, 0, 0);
    (act && !o_dry && cg != 46 && kb != 46 && v36(cg) < 16) ? q_out(o_ofs, 176 | v36(cg), min(127, 64 + v36(kb)), min(127, ceil(127 * vv / 35)));
  ) : g == 63 ? (
    cg = pg(1, 0); kb = pg(2, 0); vv = pv(3, 0, 0);
    (act && !o_dry && cg != 46 && kb != 46) ? q_out(o_ofs, 224 | min(15, v36(cg)), min(127, ceil(127 * v36(kb) / 35)), min(127, ceil(127 * vv / 35)));
  );
);

function op_cell(g, i) local(up, lw, bg)
(
  up = g >= 65 && g <= 90;
  lw = g >= 97 && g <= 122;
  (up || lw) && (up || banged()) ? (
    op_letter(up ? g : g - 32, g);
    LK[i] = 3;
  ) : g == 42 ? (
    o_dry ? 0 : GRID[i] = 46;
  ) : (g == 58 || g == 37 || g == 33 || g == 63) ? (
    bg = banged();
    op_midi(g, bg || o_dry);
    LK[i] = bg ? 6 : 7;
  );
);

function scan() local(x, y, i, g, cm)
(
  y = 0;
  loop(GH,
    cm = 0; x = 0;
    loop(GW,
      i = y * GW + x; g = GRID[i];
      g == 35 ? (cm = !cm; LK[i] = 4;) :
      cm ? LK[i] = 4 :
      (g != 46 && !LK[i]) ? (o_x = x; o_y = y; op_cell(g, i););
      x += 1;
    );
    y += 1;
  );
);

function run_frame(ofs)
(
  o_ofs = ofs;
  n_due();
  memset(LOCK, 0, NC); memset(VARS, 0, 128);
  LK = LOCK; o_dry = 0;
  scan();
  shown_frame = frame;
);

function dry_pass()
(
  memset(DLOCK, 0, NC);
  LK = DLOCK; o_dry = 1;
  scan();
  o_dry = 0;
  memcpy(DISP, DLOCK, NC);
);

function load_home()
(
  memcpy(GRID, HOME, NC);
  memset(VARS, 0, 128);
  o_seed = 1234567;
);

// ---------------- examples ----------------
NEX = 37; NGRP = 4;
function ex_put(x, y, s) local(i, n)
(
  i = 0; n = min(strlen(s), GW - x);
  loop(n, HOME[y * GW + x + i] = str_getchar(s, i); i += 1;);
);

function ex_name(n)
(
  n == 1 ? "Hello beat" :
  n == 2 ? "First melody" :
  n == 3 ? "Euclid drums" :
  n == 4 ? "Random melody" :
  n == 5 ? "Bouncing movers" :
  n == 6 ? "A  add" :
  n == 7 ? "B  subtract" :
  n == 8 ? "C  clock" :
  n == 9 ? "D  delay" :
  n == 10 ? "F  if" :
  n == 11 ? "G  generator" :
  n == 12 ? "H  halt" :
  n == 13 ? "I  increment" :
  n == 14 ? "J  jumper" :
  n == 15 ? "K  konkat" :
  n == 16 ? "L  lesser" :
  n == 17 ? "U  uclid" :
  n == 18 ? "V  variable" :
  n == 19 ? "Z  lerp" :
  n == 20 ? ":  MIDI notes" :
  n == 21 ? "Timing" :
  n == 22 ? "Bang" :
  n == 23 ? "Chromatic" :
  n == 24 ? "Arpeggio" :
  n == 25 ? "Chord" :
  n == 26 ? "Echoes" :
  n == 27 ? "Multiplication" :
  n == 28 ? "Logic gates" :
  n == 29 ? "If else" :
  n == 30 ? "Kombine" :
  n == 31 ? "Recursion" :
  n == 32 ? "Tower" :
  n == 33 ? "Wave" :
  n == 34 ? "Popcorn" :
  n == 35 ? "Knobs (MIDI CC)" :
  n == 36 ? "Sequencer" :
  n == 37 ? "Tracker" : "";
);

function ex_group(n)
(
  n == 1 ? "Getting started" :
  n == 2 ? "Operator basics" :
  n == 3 ? "Patterns" :
  n == 4 ? "Setups" : "";
);

function ex_first(k) ( k == 1 ? 1 : k == 2 ? 6 : k == 3 ? 21 : k == 4 ? 35 : NEX + 1; );

function ex_data1(n)
(
  n == 1 ? (
    ex_put(0, 1, ".#.HELLO.BEAT.#");
    ex_put(0, 3, ".D4");
    ex_put(0, 4, "..:03C");
    ex_put(0, 6, ".#.D4.BANGS.EVERY.4.FRAMES.AND.:03C.PLAYS.MIDDLE.C#");
  ) :
  n == 2 ? (
    ex_put(0, 1, ".#.FIRST.MELODY.#");
    ex_put(0, 3, "....C8");
    ex_put(0, 4, "..D1.8TCDEGAGED");
    ex_put(0, 5, "...:03..2");
    ex_put(0, 7, ".#.C.COUNTS.T.PICKS.A.NOTE.D1.BANGS.EVERY.FRAME#");
  ) :
  n == 3 ? (
    ex_put(0, 1, ".#.EUCLID.DRUMS.ON.CHANNEL.9#");
    ex_put(0, 3, "..3U8");
    ex_put(0, 4, "....:91C");
    ex_put(0, 6, "..2U8");
    ex_put(0, 7, "....:91D");
    ex_put(0, 9, "..4U8");
    ex_put(0, 10, "....:91f");
    ex_put(0, 12, "..5Ug");
    ex_put(0, 13, "....:91a");
    ex_put(0, 15, ".#.STEPS.LEFT.OF.U.FRAMES.RIGHT#");
  ) :
  n == 4 ? (
    ex_put(0, 1, ".#.RANDOM.MELODY.#");
    ex_put(0, 3, ".....R4");
    ex_put(0, 4, "...D2.5TCDEGA");
    ex_put(0, 5, "....:04..3");
    ex_put(0, 7, ".#.R.PICKS.A.STEP.OF.THE.SCALE.TRACK#");
  ) :
  n == 5 ? (
    ex_put(0, 1, ".#.BOUNCING.MOVERS.#");
    ex_put(0, 3, "..D4H");
    ex_put(0, 4, "...xE");
    ex_put(0, 5, "................:03E");
    ex_put(0, 7, "..D6H");
    ex_put(0, 8, "...xE");
    ex_put(0, 9, "....................:02A");
    ex_put(0, 11, ".#.x.COPIES.THE.HALTED.E.WHICH.FLIES.EAST.TO.THE.NOTE#");
  ) :
  n == 6 ? (
    ex_put(0, 1, ".#.ADD.#");
    ex_put(0, 3, ".#.ADD.TWO.NUMBERS.TOGETHER.#");
    ex_put(0, 5, ".1A2");
    ex_put(0, 6, "..3");
    ex_put(0, 8, ".#.ADD.THREE.NUMBERS.TOGETHER.#");
    ex_put(0, 10, ".1A2A3");
    ex_put(0, 11, "..3A5");
    ex_put(0, 12, "...8");
  ) :
  n == 7 ? (
    ex_put(0, 1, ".#.BOUNCE.....#");
    ex_put(0, 3, "................#.OUTPUTS.DIFFERENCE.#");
    ex_put(0, 4, "..Cg............#.OF.INPUTS..........#");
    ex_put(0, 5, "..5B8");
    ex_put(0, 6, "...3.X*............5B3...aB4...7B3");
    ex_put(0, 7, "........*...........2.....6.....4");
  ) :
  n == 8 ? (
    ex_put(0, 1, ".#.CLOCK.#");
    ex_put(0, 3, ".#.COUNT.TO.8.#");
    ex_put(0, 5, "..C8");
    ex_put(0, 6, "..5");
