function ex_load(n) local(i)
(
  i = 0; loop(NC, HOME[i] = 46; i += 1;);
  n == 0 ? (
    ex_put(25, 1, "#...............:");
    ex_put(25, 2, "#..............:%");
    ex_put(25, 3, "#.............:%%");
    ex_put(25, 4, "#.....:%%%%%%%%%%%%%%%:..........:%");
    ex_put(25, 5, "#...:%%%%%%%%%%%%%%%%%%%%%%:...:%%:");
    ex_put(25, 6, "#.:%%ooo*%%%%%%%%%%%%%%%%%%%%%%%:");
    ex_put(25, 7, "#:%%%%%%%%%%%%%%%%%%%%%%%%%%%%%:..:%%:");
    ex_put(25, 8, "#.:ooooooooooooo%%%%%%%%%%%:......:%");
    ex_put(25, 9, "#.....:ooooooooooo:");
  ) : (
    ex_data1(n); ex_data2(n); ex_data3(n); ex_data4(n);
  );
  memcpy(GRID, HOME, NC);
);

// ---------------- undo ----------------
function snap() local(p)
(
  p = UNDO + imod(u_top, UMAX) * NC;
  memcpy(p, HOME, NC);
  u_top += 1; u_n = min(UMAX, u_n + 1);
  r_n = 0;
);

function restore_from(src) local(i, c)
(
  i = 0;
  loop(NC,
    c = src[i];
    HOME[i] !== c ? (HOME[i] = c; GRID[i] = c;);
    i += 1;
  );
);

function do_undo() local(p)
(
  u_n > 0 ? (
    memcpy(REDO + imod(r_top, UMAX) * NC, HOME, NC);
    r_top += 1; r_n = min(UMAX, r_n + 1);
    u_top -= 1; u_n -= 1;
    p = UNDO + imod(u_top, UMAX) * NC;
    restore_from(p);
  );
);

function do_redo() local(p)
(
  r_n > 0 ? (
    memcpy(UNDO + imod(u_top, UMAX) * NC, HOME, NC);
    u_top += 1; u_n = min(UMAX, u_n + 1);
    r_top -= 1; r_n -= 1;
    p = REDO + imod(r_top, UMAX) * NC;
    restore_from(p);
  );
);

g_inited !== 1 ? (
  ex_load(0);
  load_home();
  g_cx = 1; g_cy = 1;
  g_inited = 1;
);
o_seed = 1234567;
oq_n = 0;
was_run = 0;

@block
tp = max(1, min(16, floor(tpb + 0.5)));
oq_n = 0;
while (midirecv(mofs, m1, m2, m3)) (thru >= 0.5 ? q_out(mofs, m1, m2, m3););

req_load ? (all_off(0); load_home(); req_load = 0; f_count = 0; f_next = 0; t_jump = 1;);
req_off ? (all_off(0); req_off = 0;);

cmode = clock_mode >= 0.5;
cmode !== last_cmode ? (all_off(0); was_run = 0; last_cmode = cmode;);
run_now = cmode ? free_run >= 0.5 : (play_state & 1);

(run_now && !was_run) ? (
  rewind_on >= 0.5 ? load_home();
  all_off(0);
  f_count = 0; f_next = 0; t_jump = 1;
);
(!run_now && was_run) ? all_off(0);
was_run = run_now;

run_now ? (
  cmode ? (
    f_step = srate * 60 / (max(20, free_bpm) * tp);
    while (f_next < samplesblock) (
      frame = f_count;
      run_frame(max(0, min(samplesblock - 1, floor(f_next))));
      f_count += 1;
      f_next += f_step;
    );
    f_next -= samplesblock;
  ) : (
    t_pos = beat_position * tp;
    t_inc = tempo / 60 * tp / srate;
    (t_jump || t_pos < t_exp - 0.01 || t_pos > t_exp + 0.5) ? (
      t_jump ? 0 : all_off(0);
      t_next = ceil(t_pos - 0.0001);
      t_jump = 0;
    );
    t_end = t_pos + t_inc * samplesblock;
    while (t_next < t_end) (
      t_next >= 0 ? (
        frame = t_next;
        run_frame(max(0, min(samplesblock - 1, floor((t_next - t_pos) / t_inc))));
      );
      t_next += 1;
    );
    t_exp = t_end;
  );
);

d_cnt += samplesblock;
d_cnt >= srate * 0.03 ? (d_cnt = 0; dry_pass(););

oq_flush();

@serialize
file_avail(0) < 0 ? (ser_ver = 2; ser_w = GW; ser_h = GH;);
file_var(0, ser_ver);
file_var(0, ser_w);
file_var(0, ser_h);
(ser_w === GW && ser_h === GH) ? (
  ser_ver >= 2 ? (file_mem(0, GRID, NC); file_mem(0, HOME, NC);) : (file_mem(0, HOME, NC); file_avail(0) >= 0 ? memcpy(GRID, HOME, NC););
);
file_avail(0) >= 0 ? req_off = 1;

@gfx 1000 720

W0 = 1000; H0 = 720;
z = max(0.5, min(gfx_w / W0, gfx_h / H0));
ox = floor((gfx_w - W0 * z) * 0.5);
oy = floor((gfx_h - H0 * z) * 0.5);
GX0 = 20; GY0 = 70; CW = 15; CH = 19;
g_cm = clock_mode >= 0.5;
g_tp = max(1, min(16, floor(tpb + 0.5)));

function sx(x) ( ox + x * z; );
function sy(y) ( oy + y * z; );
function hit(x, y, w, h) ( mouse_x >= sx(x) && mouse_x < sx(x + w) && mouse_y >= sy(y) && mouse_y < sy(y + h); );
function font(n, sz, fl) ( n == 1 ? gfx_setfont(1, "Arial", (sz + 2) * z, fl) : gfx_setfont(n, "Courier New", (sz + 2) * z, fl); );

function text_c(str, cx, y) local(tw, th) ( gfx_measurestr(str, tw, th); gfx_x = sx(cx) - tw * 0.5; gfx_y = sy(y); gfx_drawstr(str); );
function text_l(str, lx, y) ( gfx_x = sx(lx); gfx_y = sy(y); gfx_drawstr(str); );
function text_r(str, rx, y) local(tw, th) ( gfx_measurestr(str, tw, th); gfx_x = sx(rx) - tw; gfx_y = sy(y); gfx_drawstr(str); );

function rrect(x, y, w, h, rad) local(QX, QY, QW, QH, QR)
(
  QX = sx(x); QY = sy(y); QW = w * z; QH = h * z; QR = max(1, rad * z);
  gfx_rect(QX + QR, QY, QW - 2 * QR, QH, 1);
  gfx_rect(QX, QY + QR, QR, QH - 2 * QR, 1);
  gfx_rect(QX + QW - QR, QY + QR, QR, QH - 2 * QR, 1);
  gfx_circle(QX + QR, QY + QR, QR, 1, 1);
  gfx_circle(QX + QW - QR - 1, QY + QR, QR, 1, 1);
  gfx_circle(QX + QR, QY + QH - QR - 1, QR, 1, 1);
  gfx_circle(QX + QW - QR - 1, QY + QH - QR - 1, QR, 1, 1);
);

function card(x, y, w, h) local(i)
(
  i = 1;
  loop(5, gfx_set(0, 0, 0, 0.09 * (1 - (i - 1) / 5)); gfx_roundrect(sx(x) - i, sy(y) - i + 2 * z, w * z + 2 * i, h * z + 2 * i, (7 + i / z) * z, 1); i += 1;);
  gfx_set(0.115, 0.122, 0.140, 1);
  rrect(x, y, w, h, 7);
  gfx_set(1, 1, 1, 0.05);
  gfx_line(sx(x + 7), sy(y) + 1, sx(x + w - 7), sy(y) + 1, 1);
);

function btn(x, y, w, h, label, lit, r, g, b) local(hov)
(
  hov = hit(x, y, w, h);
  lit ? gfx_set(r * 0.32, g * 0.32, b * 0.32, 1) : gfx_set(0.16, 0.17, 0.19, 1);
  rrect(x, y, w, h, 5);
  lit ? gfx_set(r, g, b, 0.9) : gfx_set(1, 1, 1, hov ? 0.22 : 0.10);
  gfx_roundrect(sx(x), sy(y), w * z, h * z, 5 * z, 1);
  font(1, 11, 'b');
  lit ? gfx_set(r, g, b, 1) : gfx_set(0.80, 0.82, 0.86, hov ? 1 : 0.85);
  text_c(label, x + w * 0.5, y + (h - 13) * 0.5);
  hov && g_click;
);

function slider_set(n, v)
(
  n == 1 ? clock_mode = v : n == 2 ? tpb = v : n == 3 ? free_bpm = v : n == 4 ? rewind_on = v : n == 5 ? thru = v : free_run = v;
  slider_automate(2 ^ (n - 1));
);

function op_name(L)
(
  L == 65 ? "ADD  outputs left + right below" :
  L == 66 ? "SUBTRACT  outputs the difference of left and right below" :
  L == 67 ? "CLOCK  counts (frame / rate) modulo mod: rate on the left, mod on the right" :
  L == 68 ? "DELAY  bangs below every rate x mod frames: rate on the left, mod on the right" :
  L == 69 ? "EAST  moves east every frame and turns into a bang when it hits something" :
  L == 70 ? "IF  bangs below when left and right are equal" :
  L == 71 ? "GENERATOR  writes the len cells to its right at offset x, y: x, y and len on the left" :
  L == 72 ? "HALT  stops the operator below it from running" :
  L == 73 ? "INCREMENT  adds step (left) to the value below, wrapping at mod (right)" :
  L == 74 ? "JUMPER  copies the cell above to below" :
  L == 75 ? "KONKAT  outputs the variables named in the len cells to its right, below them" :
  L == 76 ? "LESSER  outputs the smaller of left and right below" :
  L == 77 ? "MULTIPLY  outputs left x right below" :
  L == 78 ? "NORTH  moves north every frame and turns into a bang when it hits something" :
  L == 79 ? "READ  copies the cell at offset x, y (on the left) to below" :
  L == 80 ? "PUSH  writes the right cell into the row below at key mod len: key and len on the left" :
  L == 81 ? "QUERY  copies len cells from offset x, y into the row below: x, y and len on the left" :
  L == 82 ? "RANDOM  outputs a random value from min (left) up to max (right) below" :
  L == 83 ? "SOUTH  moves south every frame and turns into a bang when it hits something" :
  L == 84 ? "TRACK  outputs cell number key of the len cells to its right: key and len on the left" :
  L == 85 ? "UCLID  euclidean rhythm: bangs step times (left) every max frames (right)" :
  L == 86 ? "VARIABLE  left name stores the right cell; a right name alone reads it back below" :
  L == 87 ? "WEST  moves west every frame and turns into a bang when it hits something" :
  L == 88 ? "WRITE  writes the right cell at offset x, y: x and y on the left" :
  L == 89 ? "JYMPER  copies the cell on the left to the right" :
  "LERP  moves the value below towards target (right) by rate (left) each frame";
);

function note_str(g, str) local(ncode, k)
(
  ncode = note_code(g);
  ncode < 0 ? strcpy(str, "") : (
    k = ncode % 12;
    sprintf(str, ", note %s%s", k == 0 ? "C" : k == 1 ? "C#" : k == 2 ? "D" : k == 3 ? "D#" : k == 4 ? "E" : k == 5 ? "F" :
      k == 6 ? "F#" : k == 7 ? "G" : k == 8 ? "G#" : k == 9 ? "A" : k == 10 ? "A#" : "B",
      ncode >= 36 ? " (3 octaves up)" : ncode >= 24 ? " (2 octaves up)" : ncode >= 12 ? " (1 octave up)" : "");
  );
);

function cell_hint(g, d, str)
(
  (isup(g) && d == 3) ? sprintf(str, "%c   %s", g, op_name(g)) :
  (g >= 97 && g <= 122 && d == 3) ? sprintf(str, "%c   banged: %s", g, op_name(g - 32)) :
  (isup(g) || (g >= 97 && g <= 122)) ? (
    sprintf(str, "%c   value %d%s%s", g, v36(g), note_str(g, #g_s5),
      d == 1 ? "  (input)" : d == 2 ? "  (output)" : isup(g) ? "" : sprintf(#g_s4, ", or %s when banged", op_name(g - 32)));
  ) :
  (g >= 48 && g <= 57) ? sprintf(str, "%c   value %d", g, g - 48) :
  g == 42 ? strcpy(str, "*   BANG  triggers the lowercase and MIDI operators next to it for one frame") :
  g == 35 ? strcpy(str, "#   COMMENT  everything up to the next # on this row is ignored") :
  g == 58 ? strcpy(str, ":   MIDI NOTE  when banged: channel, octave, note (C-B, lowercase = sharp, H-Z higher), velocity (0-g), length in frames") :
  g == 37 ? strcpy(str, "%   MONO NOTE  like : but cuts the previous note on the same channel") :
  g == 33 ? strcpy(str, "!   MIDI CC  when banged: channel, knob (CC 64 + knob), value (0-z)") :
  g == 63 ? strcpy(str, "?   PITCH BEND  when banged: channel, lsb (0-z), msb (0-z)") :
  (g == 61 || g == 59 || g == 36) ? sprintf(str, "%c   not supported in REAPER (OSC, UDP and commands)", g) :
  g == 46 ? strcpy(str, ".   empty cell. Type to write, Shift+arrows to select, right-click for edit options") :
  sprintf(str, "%c   plain text", g);
);

function set_cell(x, y, g)
(
  in_b(x, y) ? (HOME[y * GW + x] = g; GRID[y * GW + x] = g;);
);

function sel_rect()
(
  g_sel ? (
    g_sx0 = min(g_ax, g_cx); g_sx1 = max(g_ax, g_cx);
    g_sy0 = min(g_ay, g_cy); g_sy1 = max(g_ay, g_cy);
  ) : (
    g_sx0 = g_sx1 = g_cx; g_sy0 = g_sy1 = g_cy;
  );
);

function clear_sel() local(x, y)
(
  sel_rect(); snap();
  y = g_sy0; loop(g_sy1 - g_sy0 + 1, x = g_sx0; loop(g_sx1 - g_sx0 + 1, set_cell(x, y, 46); x += 1;); y += 1;);
);

function copy_sel() local(x, y, i)
(
  sel_rect();
  g_clw = g_sx1 - g_sx0 + 1; g_clh = g_sy1 - g_sy0 + 1;
  i = 0;
  y = g_sy0; loop(g_clh, x = g_sx0; loop(g_clw, CLIP[i] = GRID[y * GW + x]; i += 1; x += 1;); y += 1;);
);

function paste() local(x, y, i)
(
  g_clw > 0 ? (
    snap();
    i = 0;
    y = 0; loop(g_clh, x = 0; loop(g_clw, set_cell(g_cx + x, g_cy + y, CLIP[i]); i += 1; x += 1;); y += 1;);
    g_ax = g_cx; g_ay = g_cy;
    g_cx = min(GW - 1, g_cx + g_clw - 1); g_cy = min(GH - 1, g_cy + g_clh - 1);
    g_sel = g_clw > 1 || g_clh > 1;
  );
);

function move_cur(dx, dy, ext)
(
  ext ? (!g_sel ? (g_ax = g_cx; g_ay = g_cy; g_sel = 1;);) : g_sel = 0;
  g_cx = max(0, min(GW - 1, g_cx + dx));
  g_cy = max(0, min(GH - 1, g_cy + dy));
);

function import_file(fn) local(h, x, y, i, n, c)
(
  h = file_open(fn);
  h >= 0 ? (
    snap();
    i = 0; loop(NC, HOME[i] = 46; i += 1;);
    y = 0;
    while (y < GH && file_avail(h) > 0) (
      file_string(h, #g_line);
      n = strlen(#g_line); x = 0; i = 0;
      while (i < n && x < GW) (
        c = str_getchar(#g_line, i, 'cu');
        (c == 13 || c == 10) ? i = n : (
          HOME[y * GW + x] = allowed(c) ? c : 46;
          x += 1; i += 1;
        );
      );
      y += 1;
    );
    file_close(h);
    memcpy(GRID, HOME, NC);
    g_cx = g_cy = 0; g_sel = 0;
  );
);

function pop_label(k)
(
  k == 1 ? "Undo" : k == 2 ? "Redo" : k == 4 ? "Cut" : k == 5 ? "Copy" : k == 6 ? "Paste" :
  k == 7 ? "Select all" : k == 8 ? "Clear selection" : k == 10 ? "Clear grid" :
  k == 12 ? "MIDI thru" : k == 13 ? "Operator help" : k == 14 ? "Examples" : "-";
);
function pop_on(k) ( k == 1 ? u_n > 0 : k == 2 ? r_n > 0 : k == 6 ? g_clw > 0 : 1; );
function pop_h(k) ( (k == 3 || k == 9 || k == 11) ? 9 : 24; );

function pop_do(k) local(i)
(
  k == 1 ? do_undo() : k == 2 ? do_redo() :
  k == 4 ? (copy_sel(); clear_sel();) : k == 5 ? copy_sel() : k == 6 ? paste() :
  k == 7 ? (g_ax = 0; g_ay = 0; g_cx = GW - 1; g_cy = GH - 1; g_sel = 1;) :
  k == 8 ? clear_sel() :
  k == 10 ? (snap(); i = 0; loop(NC, HOME[i] = 46; i += 1;); req_load = 1;) :
  k == 12 ? slider_set(5, thru >= 0.5 ? 0 : 1) :
  k == 13 ? (g_help = 1; g_exm = 0;) :
  k == 14 ? (g_exm = 1; g_help = 0;);
);

function pop_open() local(h, k)
(
  h = 12; k = 1; loop(14, h += pop_h(k); k += 1;);
  g_popw = 200; g_poph = h;
  g_popx = max(4, min(W0 - g_popw - 4, (mouse_x - ox) / z));
  g_popy = max(4, min(H0 - g_poph - 4, (mouse_y - oy) / z));
  g_pop = 1;
);

function pop_frame() local(k, y, h, hov, lab)
(
  g_pop_hit = 0;
  y = g_popy + 6; k = 1;
  loop(14,
    h = pop_h(k);
    (h > 9 && pop_on(k) && hit(g_popx + 4, y, g_popw - 8, h)) ? g_pop_hit = k;
    y += h; k += 1;
  );
  g_click ? (
    (g_pop_hit > 0) ? pop_do(g_pop_hit);
    g_pop = 0; g_click = 0;
  );
  g_rclick ? (!hit(g_popx, g_popy, g_popw, g_poph) ? g_pop = 0; g_rclick = 0;);
);

function pop_draw() local(k, y, h, i)
(
  i = 1;
  loop(6, gfx_set(0, 0, 0, 0.12 * (1 - (i - 1) / 6)); gfx_roundrect(sx(g_popx) - i, sy(g_popy) - i + 3 * z, g_popw * z + 2 * i, g_poph * z + 2 * i, (6 + i / z) * z, 1); i += 1;);
  gfx_set(0.135, 0.143, 0.165, 1); rrect(g_popx, g_popy, g_popw, g_poph, 6);
  gfx_set(1, 1, 1, 0.10); gfx_roundrect(sx(g_popx), sy(g_popy), g_popw * z, g_poph * z, 6 * z, 1);
  y = g_popy + 6; k = 1;
  loop(14,
    h = pop_h(k);
    h == 9 ? (
      gfx_set(1, 1, 1, 0.08); gfx_rect(sx(g_popx + 10), sy(y + 4), (g_popw - 20) * z, max(1, z), 1);
    ) : (
      g_pop_hit == k ? (gfx_set(0.38, 0.78, 0.96, 0.22); rrect(g_popx + 4, y, g_popw - 8, h, 4););
      font(1, 11, 0);
      pop_on(k) ? gfx_set(0.88, 0.90, 0.93, 1) : gfx_set(0.45, 0.47, 0.51, 1);
      text_l(pop_label(k), g_popx + 30, y + 5);
      (k == 12 && thru >= 0.5) || (k == 13 && g_help) || (k == 14 && g_exm) ? (
        gfx_set(0.38, 0.78, 0.96, 1); rrect(g_popx + 13, y + 9, 7, 7, 2);
      );
      k == 1 ? (font(1, 10, 0); gfx_set(0.56, 0.58, 0.62, 1); text_r("Ctrl+Z", g_popx + g_popw - 14, y + 6);) :
      k == 2 ? (font(1, 10, 0); gfx_set(0.56, 0.58, 0.62, 1); text_r("Ctrl+Y", g_popx + g_popw - 14, y + 6);) :
      k == 4 ? (font(1, 10, 0); gfx_set(0.56, 0.58, 0.62, 1); text_r("Ctrl+X", g_popx + g_popw - 14, y + 6);) :
      k == 5 ? (font(1, 10, 0); gfx_set(0.56, 0.58, 0.62, 1); text_r("Ctrl+C", g_popx + g_popw - 14, y + 6);) :
      k == 6 ? (font(1, 10, 0); gfx_set(0.56, 0.58, 0.62, 1); text_r("Ctrl+V", g_popx + g_popw - 14, y + 6);) :
      k == 7 ? (font(1, 10, 0); gfx_set(0.56, 0.58, 0.62, 1); text_r("Ctrl+A", g_popx + g_popw - 14, y + 6);) :
      k == 8 ? (font(1, 10, 0); gfx_set(0.56, 0.58, 0.62, 1); text_r("Del", g_popx + g_popw - 14, y + 6););
    );
    y += h; k += 1;
  );
);

function exm_pos(n) local(c)
(
  c = 0; loop(NGRP - 1, n >= ex_first(c + 2) ? c += 1;);
  g_ex_x = GX0 + 24 + c * 236;
  g_ex_y = GY0 + 94 + (n - ex_first(c + 1)) * 30;
);

function exm_frame() local(n)
(
  g_ex_hit = 0;
  n = 1;
  loop(NEX, exm_pos(n); hit(g_ex_x - 6, g_ex_y - 4, 222, 26) ? g_ex_hit = n; n += 1;);
  (g_click && g_ex_hit > 0) ? (
    snap(); ex_load(g_ex_hit); req_load = 1;
    g_sel = 0; g_cx = 1; g_cy = 1; g_exm = 0; g_click = 0;
  );
);

function draw_examples() local(n, k)
(
  card(GX0 + 10, GY0 + 10, CW * GW - 20, CH * GH - 20);
  font(1, 14, 'b'); gfx_set(0.38, 0.78, 0.96, 1);
  text_l("EXAMPLES", GX0 + 30, GY0 + 22);
  font(1, 10, 0); gfx_set(0.62, 0.65, 0.70, 1);
  text_l("Click one to load it. Ctrl+Z brings back what you had. Esc closes.", GX0 + 140, GY0 + 26);
  k = 1;
  loop(NGRP,
    font(1, 11, 'b'); gfx_set(1, 0.66, 0.32, 1);
    text_l(ex_group(k), GX0 + 24 + (k - 1) * 236, GY0 + 62);
    gfx_set(1, 0.66, 0.32, 0.30);
    gfx_rect(sx(GX0 + 24 + (k - 1) * 236), sy(GY0 + 80), 210 * z, max(1, z), 1);
    k += 1;
  );
  n = 1;
  loop(NEX,
    exm_pos(n);
    g_ex_hit == n ? (gfx_set(0.38, 0.78, 0.96, 0.20); rrect(g_ex_x - 6, g_ex_y - 4, 222, 26, 5););
    font(1, 11, 0); g_ex_hit == n ? gfx_set(1, 1, 1, 1) : gfx_set(0.84, 0.86, 0.90, 1);
    text_l(ex_name(n), g_ex_x, g_ex_y);
    n += 1;
  );
);

function keys() local(c, ctl, shf, alt)
(
  c = gfx_getchar();
  while (c > 0) (
    ctl = mouse_cap & 4; shf = mouse_cap & 8; alt = mouse_cap & 16;
    g_pop ? (c == 27 ? g_pop = 0;) :
    (g_help || g_exm) ? ((c == 27 || c == 63 || c == 13) ? (g_help = 0; g_exm = 0;);) :
    c == 'up' ? move_cur(0, -1, shf) :
    c == 'down' ? move_cur(0, 1, shf) :
    c == 'left' ? move_cur(-1, 0, shf) :
    c == 'rght' ? move_cur(1, 0, shf) :
    c == 'home' ? move_cur(-GW, 0, shf) :
    c == 'end' ? move_cur(GW, 0, shf) :
    c == 'pgup' ? move_cur(0, -8, shf) :
    c == 'pgdn' ? move_cur(0, 8, shf) :
    c == 'del' ? clear_sel() :
    c == 8 ? (g_sel ? clear_sel() : (move_cur(-1, 0, 0); snap(); set_cell(g_cx, g_cy, 46););) :
    c == 13 ? (g_sel = 0; g_cy = min(GH - 1, g_cy + 1); g_cx = g_lx;) :
    c == 27 ? (g_sel ? g_sel = 0 : g_help = 0;) :
    c == 1 ? (g_ax = 0; g_ay = 0; g_cx = GW - 1; g_cy = GH - 1; g_sel = 1;) :
    c == 3 ? copy_sel() :
    c == 24 ? (copy_sel(); clear_sel();) :
    c == 22 ? paste() :
    c == 26 ? (shf ? do_redo() : do_undo()) :
    c == 25 ? do_redo() :
    (c >= 32 && c < 127 && !ctl && !alt && (c == 32 || allowed(c))) ? (
      g_sel ? g_sel = 0;
      snap();
      set_cell(g_cx, g_cy, c == 32 ? 46 : c);
      g_cx = min(GW - 1, g_cx + 1);
    );
    (c != 13 && c != 'rght' && !(c >= 32 && c < 127)) ? g_lx = g_cx;
    c = gfx_getchar();
  );
);

function draw_grid() local(x, y, i, g, d, PX, PY, QW, QH, inr, ctr)
(
  QW = CW * z; QH = CH * z;
  sel_rect();
  g_sel ? (
    gfx_set(0.40, 0.75, 0.95, 0.16);
    gfx_rect(sx(GX0 + g_sx0 * CW), sy(GY0 + g_sy0 * CH), (g_sx1 - g_sx0 + 1) * QW, (g_sy1 - g_sy0 + 1) * QH, 1);
  );
  font(2, 12, 'b');
  y = 0;
  loop(GH,
    x = 0;
    loop(GW,
      i = y * GW + x; g = GRID[i]; d = DISP[i];
      PX = sx(GX0 + x * CW); PY = sy(GY0 + y * CH);
      g == 46 ? (
        ctr = (x % 8 == 0) && (y % 8 == 0);
        d == 2 ? gfx_set(1.0, 0.66, 0.32, 0.55) : d == 1 ? gfx_set(0.45, 0.86, 0.80, 0.45) : d == 4 ? gfx_set(0.5, 0.5, 0.5, 0.25) :
        gfx_set(0.6, 0.63, 0.7, ctr ? 0.45 : 0.20);
        ctr ? (gfx_rect(PX + QW * 0.5 - z * 1.5, PY + QH * 0.5 - 0.5, 3 * z, max(1, z), 1); gfx_rect(PX + QW * 0.5 - 0.5, PY + QH * 0.5 - z * 1.5, max(1, z), 3 * z, 1);) :
        gfx_rect(PX + QW * 0.5 - z * 0.75, PY + QH * 0.5 - z * 0.75, max(1, 1.5 * z), max(1, 1.5 * z), 1);
      ) : (
        inr = 0;
        g == 42 ? (
          gfx_set(1.0, 0.82, 0.28, 0.30); gfx_rect(PX + z, PY + z, QW - 2 * z, QH - 2 * z, 1);
          gfx_set(1.0, 0.88, 0.40, 1);
        ) : d == 4 ? gfx_set(0.52, 0.54, 0.58, 1) :
        d == 3 ? (
          gfx_set(0.38, 0.78, 0.96, 1); gfx_rect(PX + z * 0.5, PY + z * 0.5, QW - z, QH - z, 1);
          inr = 1; gfx_set(0.06, 0.08, 0.10, 1);
        ) :
        d == 6 ? (
          gfx_set(0.96, 0.46, 0.72, 1); gfx_rect(PX + z * 0.5, PY + z * 0.5, QW - z, QH - z, 1);
          inr = 1; gfx_set(0.08, 0.05, 0.07, 1);
        ) :
        d == 7 ? gfx_set(0.96, 0.52, 0.76, 1) :
        d == 2 ? gfx_set(1.0, 0.68, 0.36, 1) :
        d == 1 ? gfx_set(0.55, 0.92, 0.84, 1) :
        gfx_set(0.82, 0.84, 0.88, 1);
        gfx_measurechar(g, g_chw, g_chh);
        gfx_x = PX + (QW - g_chw) * 0.5; gfx_y = PY + (QH - g_chh) * 0.5;
        gfx_drawchar(g);
      );
      x += 1;
    );
    y += 1;
  );
  PX = sx(GX0 + g_cx * CW); PY = sy(GY0 + g_cy * CH);
  gfx_set(1, 1, 1, 0.9);
  gfx_rect(PX, PY, QW, QH, 0);
  gfx_rect(PX + 1, PY + 1, QW - 2, QH - 2, 0);
);

function help_line(x, y, g, str)
(
  font(2, 12, 'b');
  gfx_set(0.38, 0.78, 0.96, 1);
  text_l(sprintf(#g_hc, "%c", g), x, y);
  font(1, 10, 0);
  gfx_set(0.82, 0.84, 0.88, 1);
  text_l(str, x + 22, y + 1);
);

function draw_help() local(i, x, y, g)
(
  card(GX0 + 10, GY0 + 10, CW * GW - 20, CH * GH - 20);
  font(1, 14, 'b'); gfx_set(0.38, 0.78, 0.96, 1);
  text_l("OPERATORS", GX0 + 30, GY0 + 22);
  font(1, 10, 0); gfx_set(0.62, 0.65, 0.70, 1);
  text_l("Uppercase letters run every frame, lowercase only when a bang (*) touches them. Inputs sit left and right, results land below.", GX0 + 150, GY0 + 26);
  i = 0;
  loop(26,
    g = 65 + i;
    x = GX0 + 30 + (i >= 13 ? 470 : 0); y = GY0 + 56 + (i % 13) * 30;
    help_line(x, y, g, op_name(g));
    i += 1;
  );
  y = GY0 + 56 + 13 * 30 + 10;
  help_line(GX0 + 30, y, 42, "BANG  triggers neighbouring lowercase and MIDI operators for one frame");
  help_line(GX0 + 500, y, 35, "COMMENT  ignores everything up to the next # on the row");
  help_line(GX0 + 30, y + 30, 58, "NOTE  channel, octave, note, velocity 0-g, length: :03C");
  help_line(GX0 + 500, y + 30, 37, "MONO NOTE  like : but one note per channel");
  help_line(GX0 + 30, y + 60, 33, "CC  channel, knob (CC 64 + knob), value 0-z");
  help_line(GX0 + 500, y + 60, 63, "PITCH BEND  channel, lsb, msb");
  font(1, 10, 0); gfx_set(0.62, 0.65, 0.70, 1);
  text_l("Values: 0-9 then a-z = 0-35. Notes: C-B, lowercase for sharps (c = C#), H-Z continue upwards. Esc or ? closes.", GX0 + 30, GY0 + CH * GH - 46);
);

function draw_top() local(tw, th, s)
(
  font(1, 18, 'b'); gfx_set(0.92, 0.94, 0.97, 1);
  text_l("WHALE OF A TIME", 20, 14);
  font(1, 10, 'b'); gfx_set(0.38, 0.78, 0.96, 1);
  text_l("ORCA LIVECODING SEQUENCER", 21, 40);

  btn(230, 18, 150, 30, g_cm ? "CLOCK: FREE RUN" : "CLOCK: TRANSPORT", 0, 0.38, 0.78, 0.96) ? (slider_set(1, g_cm ? 0 : 1); slider_set(6, 0););

  g_cm ? (
    btn(388, 18, 70, 30, free_run >= 0.5 ? "STOP" : "PLAY", free_run >= 0.5, 0.45, 0.86, 0.55) ? slider_set(6, free_run >= 0.5 ? 0 : 1);
  ) : (
    gfx_set(0.16, 0.17, 0.19, 1); rrect(388, 18, 70, 30, 5);
    font(1, 11, 'b'); (play_state & 1) ? gfx_set(0.45, 0.86, 0.55, 1) : gfx_set(0.56, 0.58, 0.62, 1);
    text_c((play_state & 1) ? "PLAYING" : "STOPPED", 423, 26);
  );

  gfx_set(0.16, 0.17, 0.19, 1); rrect(466, 18, 84, 30, 5);
  font(1, 11, 'b');
  g_cm ? gfx_set(0.92, 0.94, 0.97, 1) : gfx_set(0.56, 0.58, 0.62, 1);
  text_c(sprintf(#g_s1, "%d BPM", g_cm ? free_bpm : tempo), 508, 26);
  hit(466, 18, 84, 30) && g_cm ? (
    g_wheel != 0 ? slider_set(3, max(20, min(300, free_bpm + (g_wheel > 0 ? 1 : -1) * ((mouse_cap & 8) ? 10 : 1))));
    g_click ? (g_drag = 1; g_dy = mouse_y; g_dv = free_bpm;);
  );

  btn(558, 18, 108, 30, sprintf(#g_s2, "%d TICKS/BEAT", g_tp), 0, 0.38, 0.78, 0.96) ? (
    s = g_tp == 1 ? 2 : g_tp == 2 ? 3 : g_tp == 3 ? 4 : g_tp == 4 ? 6 : g_tp == 6 ? 8 : g_tp == 8 ? 12 : g_tp == 12 ? 16 : 1;
    slider_set(2, s);
  );
  hit(558, 18, 108, 30) && g_wheel != 0 ? slider_set(2, max(1, min(16, g_tp + (g_wheel > 0 ? 1 : -1))));

  btn(674, 18, 176, 30, rewind_on >= 0.5 ? "REWIND ON PLAY: ON" : "REWIND ON PLAY: OFF", rewind_on >= 0.5, 1, 0.66, 0.32) ? slider_set(4, rewind_on >= 0.5 ? 0 : 1);
  btn(858, 18, 82, 30, "EXAMPLES", g_exm, 0.38, 0.78, 0.96) ? (g_exm = !g_exm; g_help = 0;);
  btn(946, 18, 34, 30, "?", g_help, 0.38, 0.78, 0.96) ? (g_help = !g_help; g_exm = 0;);
);

function draw_hint() local(g)
(
  gfx_set(0.16, 0.17, 0.19, 1); rrect(20, 686, 960, 26, 5);
  g = GRID[g_cy * GW + g_cx];
  font(1, 11, 0); gfx_set(0.85, 0.87, 0.90, 1);
  cell_hint(g, DISP[g_cy * GW + g_cx], #g_hint);
  text_l(#g_hint, 30, 691);
  font(1, 11, 'b'); gfx_set(0.56, 0.58, 0.62, 1);
  sel_rect();
  sprintf(#g_st, "%d,%d%s   FRAME %d   NOTES %d", g_cx, g_cy, g_sel ? sprintf(#g_s3, "  %dx%d", g_sx1 - g_sx0 + 1, g_sy1 - g_sy0 + 1) : "", shown_frame, n_count);
  gfx_set(0.115, 0.122, 0.140, 1); gfx_measurestr(#g_st, g_tw, g_th); gfx_rect(sx(970) - g_tw - 14 * z, sy(688), g_tw + 14 * z, 22 * z, 1);
  gfx_set(0.56, 0.58, 0.62, 1);
  text_r(#g_st, 970, 691);
);

g_wheel = mouse_wheel; mouse_wheel = 0;
g_down = mouse_cap & 1; g_rdown = mouse_cap & 2;
g_click = g_down && !g_last_down;
g_rclick = g_rdown && !g_last_rdown;
g_last_down = g_down; g_last_rdown = g_rdown;

gfx_set(0.075, 0.08, 0.09, 1);
gfx_rect(0, 0, gfx_w, gfx_h, 1);

card(GX0 - 8, GY0 - 8, CW * GW + 16, CH * GH + 16);
gfx_set(0.07, 0.075, 0.085, 1);
gfx_rect(sx(GX0), sy(GY0), CW * GW * z, CH * GH * z, 1);

keys();

g_pop ? pop_frame() :
g_exm ? exm_frame() :
g_help ? (
  g_click && !hit(230, 18, 750, 30) ? g_help = 0;
) : (
  (g_click || g_rclick) && hit(GX0, GY0, CW * GW, CH * GH) ? (
    g_mx = max(0, min(GW - 1, floor((mouse_x - sx(GX0)) / (CW * z))));
    g_my = max(0, min(GH - 1, floor((mouse_y - sy(GY0)) / (CH * z))));
    g_click ? (
      (mouse_cap & 8) ? (!g_sel ? (g_ax = g_cx; g_ay = g_cy;); g_sel = 1;) : (g_ax = g_mx; g_ay = g_my; g_sel = 0;);
      g_cx = g_mx; g_cy = g_my; g_lx = g_cx;
      g_drag = 2;
    ) : (
      (g_mx < g_sx0 || g_mx > g_sx1 || g_my < g_sy0 || g_my > g_sy1 || !g_sel) ? (g_cx = g_mx; g_cy = g_my; g_lx = g_cx; g_sel = 0;);
      pop_open(); g_rclick = 0;
    );
  );
);

g_drag == 2 && g_down ? (
  g_mx = max(0, min(GW - 1, floor((mouse_x - sx(GX0)) / (CW * z))));
  g_my = max(0, min(GH - 1, floor((mouse_y - sy(GY0)) / (CH * z))));
  (g_mx != g_cx || g_my != g_cy) ? (g_cx = g_mx; g_cy = g_my; g_sel = g_cx != g_ax || g_cy != g_ay;);
);
g_drag == 1 && g_down ? (
  mouse_cap |= 65536;
  slider_set(3, max(20, min(300, floor(g_dv + (g_dy - mouse_y) / (2 * z) + 0.5))));
);
!g_down ? g_drag = 0;

draw_top();
g_exm ? draw_examples() : g_help ? draw_help() : draw_grid();
draw_hint();
g_pop ? pop_draw();

gfx_getdropfile(0, #g_drop) ? (
  import_file(#g_drop);
  req_load = 1;
  gfx_getdropfile(-1);
);
