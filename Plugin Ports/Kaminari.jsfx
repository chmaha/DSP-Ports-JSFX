NOUT = 2;
i = 0; loop(128, SC[i] = f32((1 - cos($pi * (i / 127))) * 0.5); i += 1; );
i = 0; loop(4095, PT[i] = f32(cos(i * (($pi / 2) / 4094))); i += 1; );
i = 0; loop(32, E2T[i] = 2 ^ (i / 32); i += 1; );
PAN_G = PT[2047] * 1.9952622652053833;

function sec_load() local(h, n)
(
  n = 0;
  h = file_open("Kaminari/Kaminari.txt");
  h < 0 ? h = file_open("Dependencies/Kaminari/Kaminari.txt");
  h >= 0 ? (
    n = file_mem(h, TXT, SEQBASE - TXT);
    file_close(h);
  );
  (n > 8 && TXT[0] === 5813) ? n : 0;
);

function pack_open(p) local(h)
(
  strcpy(#pk_fn, "Kaminari/"); strcat(#pk_fn, pack_name(p)); strcat(#pk_fn, ".flac");
  h = file_open(#pk_fn);
  h < 0 ? (
    strcpy(#pk_fn, "Dependencies/Kaminari/"); strcat(#pk_fn, pack_name(p)); strcat(#pk_fn, ".flac");
    h = file_open(#pk_fn);
  );
  h;
);

function slot_uses(s, p) local(SL)
(
  SL = SLOT + s * SLS;
  (SL[0] > 0 && SL[9]) ? SL[1600 + p] : 0;
);

function slot_need(s) local(i, RG, NEED, pend)
(
  slot_enter(s);
  NEED = SL + 1600;
  memset(NEED, 0, NPACK);
  BLK ? (
    i = 0;
    loop(BLK[0],
      RG = REGB + i * RS;
