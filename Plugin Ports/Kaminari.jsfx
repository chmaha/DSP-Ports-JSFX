  sel ? ( c_fin(0.6, 0.16); gfx_rect(sx(x), sy(y), w * z, h * z, 1); c_fin(0.4, 1); gfx_rect(sx(x), sy(y), 3 * z, h * z, 1); )
      : hv ? ( c_fin(0.6, 0.07); gfx_rect(sx(x), sy(y), w * z, h * z, 1); );
  c_soft(1); text(sprintf(#g_n, "%d", i + 1), x + 10, y + 5, 11, "Arial", 'b');
  inst > 0 ? c_ink(1) : c_soft(0.7);
  gfx_setfont(1, "Georgia", 16 * z);
  gfx_x = sx(x + 28); gfx_y = sy(y + 3); gfx_drawstr(fit(inst_name(inst), w - 120, #g_fit));
  c_soft(1);
  rtext(slider(b + 2) == 0 ? "Omni" : sprintf(#g_chs, "Ch %d", slider(b + 2)), x + w - 8, y + 6, 10, "Arial", 0);
  inst > 0 ? (
    0 ? rtext(slider(b + 1) ? "N" : "P", x + w - 52, y + 6, 10, "Arial", 'b');
    (p[2] && !p[26]) ? (
      lv = clamp01((20 * log10(max(STR[i], 0.000001)) + 60) / 60);
      g_meter[i] = max(lv, g_meter[i] * 0.9);
      gfx_set(0.24, 0.26, 0.33, 0.5); gfx_rect(sx(x + 28), sy(y + h - 4), (w - 120) * z, max(1, z), 1);
      c_acc(0.9); gfx_rect(sx(x + 28), sy(y + h - 4), (w - 120) * g_meter[i] * z, max(1, 2 * z), 1);
    ) : (
      c_acc(1);
      a = slot_missing(i);
      rtext(a ? "missing" : "loading", x + w - 64, y + 6, 10, "Arial", 0);
    );
  );
  (hv && g_click) ? ( g_click = 0; g_slot = i; );
);

function bolt_pt(seed, k) local(t) ( t = sin(seed * 91.3458 + k * 47.1137) * 43758.5453; 2 * (t - floor(t)) - 1; );

function bolt(cx, cy, sd, y0, seed, a) local(k, x, y, px, py, n, bx, by, al)
(
  n = 8;
  al = 0.08 + 0.92 * a;
  k = 0;
  px = cx + sd * 70; py = cy + y0;
  a > 0.05 ? ( k = 0; loop(4, gfx_set(0.6, 0.72, 1, 0.05 * a); gfx_circle(sx(px), sy(py), (2 + 2.2 * k) * z, 1, 1); k += 1; ); k = 0; );
  loop(n,
    k += 1;
    x = cx + sd * (70 + k * 10);
    y = cy + y0 + k * 2.2 + 7 * bolt_pt(seed, k);
    a > 0.05 ? (
      gfx_set(0.45, 0.58, 1, 0.25 * a);
      gfx_line(sx(px), sy(py) - z, sx(x), sy(y) - z, 1); gfx_line(sx(px), sy(py) + z, sx(x), sy(y) + z, 1);
    );
    gfx_set(0.82, 0.88, 1, al);
    gfx_line(sx(px), sy(py), sx(x), sy(y), 1);
    k === 4 ? ( bx = x; by = y; );
    px = x; py = y;
  );
  px = bx; py = by;
  k = 0;
  loop(3,
    k += 1;
    x = bx + sd * k * 8; y = by + k * 6 + 3 * bolt_pt(seed + 7, k);
    gfx_set(0.82, 0.88, 1, al * 0.7);
    gfx_line(sx(px), sy(py), sx(x), sy(y), 1);
    px = x; py = y;
  );
);

function decor(cx, cy) local(j, lv, sd)
(
  j = 0;
  loop(4,
    lv = STBR[j];
    (lv > 0.01 && lv > g_bh[j] * 1.6) ? ( g_ph[j] = 1; g_ph[4 + j] = floor(time_precise() * 1000) % 997; );
    g_bh[j] = max(lv, g_bh[j] * 0.9);
    g_ph[j] *= 0.86;
    j += 1;
  );
  sd = -1;
  loop(2,
    bolt(cx, cy, sd, -26, 11 + g_ph[sd < 0 ? 6 : 7] + (sd > 0) * 31, sd < 0 ? g_ph[2] : g_ph[3]);
    bolt(cx, cy, sd, 14, 23 + g_ph[sd < 0 ? 4 : 5] + (sd > 0) * 17, sd < 0 ? g_ph[0] : g_ph[1]);
    sd = 1;
  );
);

function tab_head(t, col, row) ( c_soft(1); text(t, 632 + col * 128, 92 + row * 19, 9, "Arial", 'b'); );

function tab_key(t, cc, col, row) local(x, y, on, hv)
(
  x = 632 + col * 128; y = 90 + row * 19;
  on = g_CCV[cc] >= 0.5;
  hv = inside(x, y, 122, 17);
  on ? ( c_acc(1); gfx_rect(sx(x), sy(y), 122 * z, 17 * z, 1); gfx_set(0.06, 0.07, 0.1, 1); )
     : ( c_fin(0.3, hv ? 0.5 : 0.3); gfx_rect(sx(x), sy(y), 122 * z, 17 * z, 0); c_ink(hv ? 1 : 0.8); );
  text(t, x + 6, y + 2, 11, "Georgia", 0);
  (hv && g_click) ? ( g_click = 0; gq_push(0xB0, cc, on ? 0 : 127); );
);

function ctl_slider(t, cc, row) local(f, cv)
(
  cv = floor(g_CCV[cc] * 127 + 0.5);
  (f = tslider(20 + row, 640, 118 + g_cyo + row * 42, 230, g_CCV[cc], t, sprintf(#g_cs, "%d", cv))) != -1 ? (
    f = f == -2 ? floor(g_S[350 + cc] * 127 + 0.5) : floor(f * 127 + 0.5);
    f != cv ? gq_push(0xB0, cc, f);
  );
);

function stop_tabs(i, m) ( 0; );
function ctl_count(i, m) ( 0; );

function is_black(pc) ( pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10; );
function wpos(n) local(o, p)
(
  o = floor(n / 12); p = n - o * 12;
  o * 7 + (p < 1 ? 0 : p < 3 ? 1 : p < 5 ? 2 : p < 6 ? 3 : p < 8 ? 4 : p < 10 ? 5 : 6) - 12;
);
function key_state(n) ( g_KEYON[n] || g_note == n ? 2 : n == g_S[3] ? 3 : g_KSW[n] ? 4 : (n < g_lo || n > g_hi) ? 1 : 0; );

function keyboard(x, y, w, h) local(ww, bw, bh, QX, QY, QH, n, wi, hov, hovh, down, vel, kx, kw, bx, st, cx, tw, th)
(
  ww = w / 52; bw = ww * 0.6; bh = h * 0.63;
  QX = sx(x); QY = sy(y); QH = h * z;
  hov = -1; hovh = h;
  (mouse_x >= QX && mouse_x < QX + w * z && mouse_y >= QY && mouse_y < QY + QH) ? (
    n = 22;
    loop(86,
      is_black(n % 12) ? (
        cx = x + (wpos(n - 1) + 1) * ww;
        (mouse_y < QY + bh * z && abs(mouse_x - sx(cx)) < bw * z * 0.5) ? ( hov = n; hovh = bh; );
      );
      n += 1;
    );
    hov < 0 ? (
      wi = floor((mouse_x - QX) / (ww * z));
      n = 21;
      loop(88, (!is_black(n % 12) && wpos(n) == wi) ? hov = n; n += 1; );
    );
  );
  down = mouse_cap & 1;
  (g_click && hov >= 0) ? ( g_on = 1; g_note = -1; g_click = 0; );
  (g_on && !down) ? (
    g_note >= 0 ? gq_push(0x80, g_note, 0);
    g_note = -1; g_on = 0;
  );
  (g_on && down && hov >= 0 && hov != g_note) ? (
    g_note >= 0 ? gq_push(0x80, g_note, 0);
    vel = max(1, floor(1 + 126 * clamp01((mouse_y - QY) / (hovh * z))));
    gq_push(0x9F, hov, vel);
    g_note = hov;
  );

  g_rh = 12 * z; g_ry = sy(y) - g_rh;
  c_fin(0, 1);
  gfx_rect(sx(x) - 3 * z, g_ry, (w + 6) * z, QH + g_rh + 3 * z, 1);
  cx = 0;
  loop(ceil(g_rh),
    c_fin(0.5 + 0.5 * sin($pi * cx / g_rh), 1);
    gfx_rect(sx(x) - 3 * z, g_ry + cx, (w + 6) * z, 1, 1);
    cx += 1;
  );
  gfx_set(1, 1, 1, 0.18);
  cx = 0;
  loop(8,
    gfx_line(sx(x + 40 + cx * 105), g_ry + (3 + cx % 3 * 2) * z, sx(x + 40 + cx * 105 + 60 + cx % 2 * 30), g_ry + (4 + cx % 3 * 2) * z, 1);
    cx += 1;
  );

  n = 21;
  loop(88,
    !is_black(n % 12) ? (
      wi = wpos(n);
      kx = floor(sx(x + wi * ww)) + max(1, floor(z));
      kw = floor(sx(x + (wi + 1) * ww)) - kx;
      st = key_state(n);
      st == 2 ? gfx_gradrect(kx, QY, kw, QH, 0.62, 0.72, 0.98, 1, 0, 0, 0, 0, -0.22 / QH, -0.22 / QH, -0.2 / QH, 0)
      : st == 3 ? gfx_gradrect(kx, QY, kw, QH, 0.72, 0.8, 0.98, 1, 0, 0, 0, 0, -0.12 / QH, -0.14 / QH, -0.14 / QH, 0)
      : st == 4 ? gfx_gradrect(kx, QY, kw, QH, 0.84, 0.88, 0.96, 1, 0, 0, 0, 0, -0.1 / QH, -0.1 / QH, -0.1 / QH, 0)
      : st == 1 ? gfx_gradrect(kx, QY, kw, QH, 0.74, 0.72, 0.69, 1, 0, 0, 0, 0, -0.08 / QH, -0.08 / QH, -0.08 / QH, 0)
      : gfx_gradrect(kx, QY, kw, QH, 0.97, 0.95, 0.91, 1, 0, 0, 0, 0, -0.1 / QH, -0.1 / QH, -0.11 / QH, 0);
      gfx_set(0, 0, 0, 0.22); gfx_rect(kx, QY, kw, 2 * z, 1);
      n % 12 == 0 ? (
        gfx_setfont(1, "Arial", 11 * z, 'b');
        st == 2 ? gfx_set(0.35, 0.16, 0.05, 1) : gfx_set(0.52, 0.48, 0.44, 1);
        sprintf(#g_kl, "C%d", floor(n / 12) - 1);
        gfx_measurestr(#g_kl, tw, th);
        gfx_x = floor(kx + (kw - tw) * 0.5); gfx_y = QY + QH - 16 * z;
        gfx_drawstr(#g_kl);
      );
    );
    n += 1;
  );

  n = 22;
  loop(86,
    is_black(n % 12) ? (
      bx = floor(sx(x + (wpos(n - 1) + 1) * ww - bw * 0.5));
      st = key_state(n);
      gfx_set(0, 0, 0, 0.35); gfx_rect(bx + z, QY, bw * z, bh * z + 2 * z, 1);
      st == 2 ? gfx_gradrect(bx, QY, bw * z, bh * z, 0.34, 0.43, 0.8, 1, 0, 0, 0, 0, 0.12 / (bh * z), 0.1 / (bh * z), 0.06 / (bh * z), 0)
      : st == 3 ? gfx_gradrect(bx, QY, bw * z, bh * z, 0.42, 0.5, 0.82, 1, 0, 0, 0, 0, 0.1 / (bh * z), 0.1 / (bh * z), 0.06 / (bh * z), 0)
      : st == 4 ? gfx_gradrect(bx, QY, bw * z, bh * z, 0.24, 0.27, 0.36, 1, 0, 0, 0, 0, 0.1 / (bh * z), 0.1 / (bh * z), 0.1 / (bh * z), 0)
      : st == 1 ? gfx_gradrect(bx, QY, bw * z, bh * z, 0.3, 0.28, 0.27, 1, 0, 0, 0, 0, 0.1 / (bh * z), 0.1 / (bh * z), 0.1 / (bh * z), 0)
      : gfx_gradrect(bx, QY, bw * z, bh * z, 0.1, 0.08, 0.07, 1, 0, 0, 0, 0, 0.1 / (bh * z), 0.1 / (bh * z), 0.1 / (bh * z), 0);
      gfx_set(1, 1, 1, 0.1); gfx_rect(bx + 2 * z, QY + bh * z - 7 * z, bw * z - 4 * z, 5 * z, 1);
    );
    n += 1;
  );
);

function settings_page()
(
  g_ey = 1 ? 128 : 0;
  !1 ? (
    c_soft(1); text("TUNING", 332, 76, 10, "Arial", 'b');
    (g_f = tslider(6, 332, 116, 250, (slider(50) - 392) / 102, "Concert pitch (A4)", sprintf(#g_s, "%d Hz", slider(50)))) != -1 ? (
      slider(50) = g_f == -2 ? 440 : floor(392 + g_f * 102 + 0.5);
      sliderchange(2 ^ (50 - 1));
    );
    (inside(332, 100, 250, 26) && mouse_wheel != 0) ? (
      slider(50) = max(392, min(494, floor(slider(50) + 0.5) + (mouse_wheel > 0 ? 1 : -1)));
      sliderchange(2 ^ (50 - 1)); mouse_wheel = 0;
    );
    menu_field(612, 104, 150, "Presets", "choose...") ? (
      g_m = gfx_showmenu("466 Hz (Chorton)|440 Hz (modern)|442 Hz|443 Hz|435 Hz (1859 diapason)|432 Hz|430 Hz (classical)|415 Hz (baroque)|392 Hz (French baroque)");
      g_m > 0 ? (
        slider(50) = g_m == 1 ? 466 : g_m == 2 ? 440 : g_m == 3 ? 442 : g_m == 4 ? 443 : g_m == 5 ? 435 : g_m == 6 ? 432 : g_m == 7 ? 430 : g_m == 8 ? 415 : 392;
        sliderchange(2 ^ (50 - 1));
      );
    );
    menu_field(332, 164, 250, "Temperament", temper_name(slider(50 + 1))) ? (
      g_m = gfx_showmenu(temper_menu());
      g_m > 0 ? ( slider(50 + 1) = SCALES[960 + g_m - 1]; sliderchange(2 ^ 50); );
    );
  );
  c_soft(1); text("ENGINE", 332, 204 - g_ey, 10, "Arial", 'b');
  menu_field(332, 238 - g_ey, 120, NSLOT > 1 ? "Polyphony per slot" : "Polyphony", sprintf(#g_s, "%d voices", POLY)) ? (
    strcpy(#g_menu, ""); g_i = 0;
    loop(10,
      g_n2 = g_i == 0 ? 8 : g_i == 1 ? 16 : g_i == 2 ? 24 : g_i == 3 ? 32 : g_i == 4 ? 48 : g_i == 5 ? 64 : g_i == 6 ? 96 : g_i == 7 ? 128 : g_i == 8 ? 192 : 256;
      strcat(#g_menu, sprintf(#g_s, "%s%s%d", g_i ? "|" : "", slider(50 + 2) == g_i ? "!" : "", g_n2));
      g_i += 1;
    );
    g_m = gfx_showmenu(#g_menu);
    g_m > 0 ? ( slider(50 + 2) = g_m - 1; sliderchange(2 ^ (50 + 1)); );
  );
  menu_field(472, 238 - g_ey, 130, "Sample quality", slider(50 + 3) == 0 ? "Nearest" : slider(50 + 3) == 1 ? "Linear" : "Hermite") ? (
    g_m = gfx_showmenu(sprintf(#g_menu, "%sNearest|%sLinear|%sHermite (sfizz default)",
      slider(50 + 3) == 0 ? "!" : "", slider(50 + 3) == 1 ? "!" : "", slider(50 + 3) == 2 ? "!" : ""));
    g_m > 0 ? ( slider(50 + 3) = g_m - 1; sliderchange(2 ^ (50 + 2)); );
  );
  menu_field(622, 238 - g_ey, 140, "Pitch bend range", slider(50 + 4) == 0 ? "Instrument (2)" : sprintf(#g_s, "%d semitones", slider(50 + 4))) ? (
    strcpy(#g_menu, slider(50 + 4) == 0 ? "!Instrument (2 semitones)" : "Instrument (2 semitones)");
    g_i = 1;
    loop(24, strcat(#g_menu, sprintf(#g_s, "|%s%d", slider(50 + 4) == g_i ? "!" : "", g_i)); g_i += 1; );
    g_m = gfx_showmenu(#g_menu);
    g_m > 0 ? ( slider(50 + 4) = g_m - 1; sliderchange(2 ^ (50 + 3)); );
  );
  c_soft(0.9);
  text(NSLOT > 1 ? "Tuning, temperament and quality apply to every slot; polyphony is per slot (sfizz engine voices)."
    : 1 ? "Polyphony is the number of sfizz engine voices." : "Polyphony is the number of sfizz engine voices; tuning and temperament apply to every note.", 332, 280 - g_ey, 10, "Arial", 0);
);
g_down = mouse_cap & 1;
g_click = g_down && !g_prev;
g_prev = g_down;
!g_down ? g_drag = 0;
g_meter = GUI; g_bh = GUI + 20; g_ph = GUI + 30;

g_slot = 0;
g_S = SLOT;
g_CCV = g_S + 200; g_KSW = g_S + 800; g_KEYON = g_S + 950;
g_b = 2;
g_inst = max(1, slider(g_b)); g_mode = slider(g_b + 1);
g_lo = inst_lo(g_inst); g_hi = inst_hi(g_inst);

gfx_set(0.07, 0.08, 0.11, 1); gfx_rect(0, 0, gfx_w, gfx_h, 1);
gfx_gradrect(0, 0, gfx_w, gfx_h, 0.13, 0.14, 0.2, 1, 0, 0, 0, 0, -0.07 / gfx_h, -0.07 / gfx_h, -0.07 / gfx_h, 0);
gfx_set(0.02, 0.02, 0.04, 0.07);
g_i = 0; loop(10, gfx_rect(0, 0, gfx_w, max(1, (10 - g_i) * 2 * z), 1); g_i += 1; );

c_ink(1);
spaced("KAMINARI", 450, 12, 27, "Georgia", 7);
c_acc(1);
g_w2 = spaced("TAIKO DRUMS", 450, 48, 13, "Georgia", 6);
gfx_set(0.55, 0.59, 0.69, 0.8);
gfx_rect(sx(450 - g_w2 * 0.5 - 70), sy(56), 60 * z, max(1, z), 1);
gfx_rect(sx(450 + g_w2 * 0.5 + 10), sy(56), 60 * z, max(1, z), 1);

g_hv = inside(24, 30, 92, 20);
g_page ? c_acc(1) : c_ink(g_hv ? 1 : 0.6);
gfx_rect(sx(24), sy(30), 92 * z, 20 * z, 0);
ctext(g_page ? "INSTRUMENT" : "SETTINGS", 70, 34, 10, "Arial", 'b');
(g_hv && g_click) ? ( g_click = 0; g_page = !g_page; );

c_soft(1); text(NINST > 1 ? "INSTRUMENT" : "", 32, 76, 10, "Arial", 'b');
g_a = 1;
loop(NINST > 1 ? NINST : 0,
  g_y = 96 + (g_a - 1) * 24;
  g_on2 = g_a == g_inst;
  g_hv = inside(28, g_y - 2, 250, 22);
  g_on2 ? ( c_acc(1); gfx_circle(sx(34), sy(g_y + 8), 3 * z, 1, 1); );
  g_on2 ? c_acc(1) : c_ink(g_hv ? 1 : 0.75);
  text(inst_name(g_a), 44, g_y, 16, "Georgia", 0);
  (NINST > 1 && g_hv && g_click) ? ( g_click = 0; slider(g_b) = g_a; sliderchange(2 ^ (g_b - 1)); );
  g_a += 1;
);
0 ? (
  g_y = 110 + NINST * 24;
  c_soft(1); text("CONTROLS", 32, g_y, 10, "Arial", 'b');
  g_a = 0;
  loop(2,
    g_yy = g_y + 20 + g_a * 22;
    g_on2 = g_a == g_mode;
    g_hv = inside(28, g_yy - 2, 250, 20);
    g_on2 ? ( c_acc(1); gfx_circle(sx(34), sy(g_yy + 7), 3 * z, 1, 1); );
    g_on2 ? c_acc(1) : c_ink(g_hv ? 1 : 0.75);
    text(g_a ? "Notation (velocity dynamics)" : "Performance (mod wheel dynamics)", 44, g_yy, 13, "Georgia", 0);
    (g_hv && g_click) ? ( g_click = 0; slider(g_b + 1) = g_a; sliderchange(2 ^ g_b); );
    g_a += 1;
  );
);

g_bk = g_S[9];
g_na = g_bk ? g_bk[15] : 0;
g_na > 0 ? (
  g_y0 = 76 + (NINST > 1 ? NINST * 24 + 20 : 0) + (0 ? 80 : 0);
  c_soft(1); text("ARTICULATION", 32, g_y0, 10, "Arial", 'b');
  g_a = 0;
  loop(g_na,
    g_y = g_y0 + 18 + g_a * 20;
    g_k = g_artkey(g_a);
    g_on2 = g_k == g_S[3];
    g_hv = inside(28, g_y - 2, 252, 19);
    g_on2 ? ( c_acc(1); gfx_circle(sx(34), sy(g_y + 7), 3 * z, 1, 1); );
    g_on2 ? c_acc(1) : c_ink(g_hv ? 1 : 0.75);
    gfx_setfont(1, "Georgia", 15 * z);
    gfx_x = sx(44); gfx_y = sy(g_y); gfx_drawstr(fit(art_name(g_inst, g_mode, g_a), 190, #g_fit));
    c_soft(0.8); rtext(note_name(g_k), 280, g_y + 2, 10, "Arial", 0);
    (g_hv && g_click) ? ( g_click = 0; slider(g_b + 3) = g_a; sliderchange(2 ^ (g_b + 2)); );
    g_a += 1;
  );
);

g_na == 0 ? (
  c_soft(1); text("DRUMS", 32, 76, 10, "Arial", 'b');
  g_a = 0;
  loop(15,
    g_col = g_a >= 8; g_x = 28 + g_col * 132; g_y = 94 + (g_a - g_col * 8) * 20;
    g_k = drum_key(g_a);
    g_on2 = g_KEYON[g_k] || g_KEYON[g_k + 1] || (g_aud > 0 && g_aud == g_k);
    g_hv = inside(g_x, g_y - 2, 128, 19);
    g_on2 ? ( c_acc(1); gfx_circle(sx(g_x + 6), sy(g_y + 7), 3 * z, 1, 1); );
    g_on2 ? c_acc(1) : c_ink(g_hv ? 1 : 0.75);
    text(drum_name(g_a), g_x + 14, g_y, 13, "Georgia", 0);
    c_soft(0.8); rtext(note_name(g_k), g_x + 124, g_y + 2, 10, "Arial", 0);
    (g_hv && g_click) ? ( g_click = 0; g_aud = g_k; gq_push(0x9F, g_k, 100); );
    g_a += 1;
  );
  (g_aud > 0 && !g_down) ? ( gq_push(0x80, g_aud, 0); g_aud = 0; );
);

g_page ? (
  settings_page();
) : (
  decor(450, 172);
  g_kcc = knob_cc(g_inst, g_mode);
g_kcc == 1 && g_S[19] ? g_kcc = g_S[19];
(g_f = knob(450, 172, 64, g_CCV[g_kcc])) != -1 ? (
    g_c = g_f == -2 ? floor(g_S[350 + g_kcc] * 127 + 0.5) : floor(g_f * 127 + 0.5);
    g_c != g_lastx ? ( gq_push(0xB0, g_kcc, g_c); g_lastx = g_c; );
  );
  c_ink(1); ctext(g_kcc == 7 ? "Volume" : cc1_label(g_inst, g_mode), 450, 248, 20, "Arial", 0);
  c_soft(1); ctext(sprintf(#g_s, "CC%d  %d", g_kcc, floor(g_CCV[g_kcc] * 127 + 0.5)), 450, 272, 11, "Arial", 0);
  g_cyo = 0;
