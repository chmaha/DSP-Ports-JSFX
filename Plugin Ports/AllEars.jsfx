@init
ext_noinit = gfx_ext_retina = 1;
SL0 = 12;
#data_a = "AllEars/hrtf.txt"; #data_b = "Dependencies/AllEars/hrtf.txt";
function alloc(n) local(r) instance(mp) global() ( r = mp; mp += n; memset(r, 0, n); r; );

HOP = 128; NB = 133; HL = 1280; NTAB = 6697; NAZ = 181; MAXS = 64;
C1 = 0.031273141818515176604; C2 = 0.28127313041521179171;
FT = 0; FT2 = 512; FT3 = 1024;
OUB = 2048;
alloc.mp = 8192;
ND = 836; HLEN0 = 256; NPRE = 0;
PF = alloc(HL); PFI = alloc(HL);
KT = alloc(68);
HDIR = alloc(ND * 2); GW = alloc(ND); GIDX = alloc(NTAB * 3); GG = alloc(NTAB * 3);
PRN = alloc(64); PRD = alloc(64 * 128);
HR0 = alloc(ND * 2 * HLEN0);
FREQ = alloc(NB);
XT = alloc(MAXS * HOP); YT = alloc(2 * HOP);
INB = alloc(MAXS * HL); HYB = alloc(MAXS * 7 * 258);
BR = alloc(NB); BI = alloc(NB);
ORE = alloc(2 * NB); OIM = alloc(2 * NB);
HRE = alloc(MAXS * 2 * NB); HIM = alloc(MAXS * 2 * NB);
SAZ = alloc(MAXS); SEL = alloc(MAXS); RAZ = alloc(MAXS); REL = alloc(MAXS);
SG = alloc(MAXS); SGU = alloc(MAXS); RECALC = alloc(MAXS);
ABUF = alloc(2 * HL); AHYB = alloc(2 * 7 * 258);
CRE = alloc(NB * 24); CIM = alloc(NB * 24); CEN = alloc(NB);
TRE = alloc(NB * 24 * 2); TIM = alloc(NB * 24 * 2);
STAGE = alloc(500000);
RS = alloc(16384);
LFB = alloc(2048);
data_ok = 0;
KT[0] = 0.99859849; KT[1] = 1.00000000; KT[2] = 0.99859849; KT[3] = 0.99440475; KT[4] = 0.98745105; KT[5] = 0.97779076;
KT[6] = 0.96549770; KT[7] = 0.95066529; KT[8] = 0.93340547; KT[9] = 0.91384741; KT[10] = 0.89213598; KT[11] = 0.86843014;
KT[12] = 0.84290116; KT[13] = 0.81573067; KT[14] = 0.78710866; KT[15] = 0.75723148; KT[16] = 0.72629970; KT[17] = 0.69451601;
KT[18] = 0.66208321; KT[19] = 0.62920216; KT[20] = 0.59606986; KT[21] = 0.56287762; KT[22] = 0.52980938; KT[23] = 0.49704014;
KT[24] = 0.46473455; KT[25] = 0.43304576; KT[26] = 0.40211431; KT[27] = 0.37206735; KT[28] = 0.34301800; KT[29] = 0.31506490;
KT[30] = 0.28829195; KT[31] = 0.26276832; KT[32] = 0.23854851; KT[33] = 0.21567274; KT[34] = 0.19416736; KT[35] = 0.17404546;
KT[36] = 0.15530766; KT[37] = 0.13794294; KT[38] = 0.12192957; KT[39] = 0.10723616; KT[40] = 0.09382272; KT[41] = 0.08164178;
KT[42] = 0.07063950; KT[43] = 0.06075685; KT[44] = 0.05193064; KT[45] = 0.04409466; KT[46] = 0.03718069; KT[47] = 0.03111947;
KT[48] = 0.02584161; KT[49] = 0.02127838; KT[50] = 0.01736250; KT[51] = 0.01402878; KT[52] = 0.01121463; KT[53] = 0.00886058;
KT[54] = 0.00691064; KT[55] = 0.00531256; KT[56] = 0.00401805; KT[57] = 0.00298291; KT[58] = 0.00216702; KT[59] = 0.00153438;
KT[60] = 0.00105297; KT[61] = 0.00069463; KT[62] = 0.00043489; KT[63] = 0.00025272; KT[64] = 0.00013031; KT[65] = 0.0000527734;
KT[66] = 0.00001000; KT[67] = 0.00000000;

function data_load() local(h, n, p, i, k, e, eq)
(
  h = file_open(#data_a);
  h < 0 ? h = file_open(#data_b);
  n = 0;
  h >= 0 ? (
    n = file_text(h) ? file_mem(h, STAGE, 500000) : 0;
    file_close(h);
  );
  n > 400000 && STAGE[0] === ND && STAGE[1] === HLEN0 && STAGE[3] === NTAB ? (
    NPRE = STAGE[5];
    p = STAGE + 6;
    eq = 2 / sqrt(5.487604141);
    k = 0;
    loop(HL,
      PF[HL - k - 1] = p[k] * eq * 0.5;
      PFI[HL - k - 1] = p[k] * eq / 256;
      k += 1;
    );
    p += HL;
    memcpy(HDIR, p, ND * 2); p += ND * 2;
    memcpy(GW, p, ND); p += ND;
    i = 0;
    loop(NTAB * 3, GIDX[i] = p[0]; GG[i] = p[1]; p += 2; i += 1;);
    i = 0;
    loop(NPRE,
      e = p[0]; PRN[i] = e; p += 1;
      memcpy(PRD + i * 128, p, 2 * e); p += 2 * e;
      i += 1;
    );
    memcpy(HR0, p, ND * 2 * HLEN0);
    D_END = p + ND * 2 * HLEN0;
    data_ok = 1;
  );
);
data_load();

function stft_fwd(x, ib, hb, hin, lp, pre, pim) local(h2, n, lt, b, s6, s4, s2, s0, re, im, ab, q0, q1, q2, q3, q4, q5, q6, q7, q8, q9, f)
(
  memcpy(ib + hin * HOP, x, HOP);
  h2 = hin + 1; h2 >= 10 ? h2 = 0;
  q0 = ib + h2 * HOP; h2 += 1; h2 >= 10 ? h2 = 0;
  q1 = ib + h2 * HOP; h2 += 1; h2 >= 10 ? h2 = 0;
  q2 = ib + h2 * HOP; h2 += 1; h2 >= 10 ? h2 = 0;
  q3 = ib + h2 * HOP; h2 += 1; h2 >= 10 ? h2 = 0;
  q4 = ib + h2 * HOP; h2 += 1; h2 >= 10 ? h2 = 0;
  q5 = ib + h2 * HOP; h2 += 1; h2 >= 10 ? h2 = 0;
  q6 = ib + h2 * HOP; h2 += 1; h2 >= 10 ? h2 = 0;
  q7 = ib + h2 * HOP; h2 += 1; h2 >= 10 ? h2 = 0;
  q8 = ib + h2 * HOP; h2 += 1; h2 >= 10 ? h2 = 0;
  q9 = ib + h2 * HOP;
  f = PF;
  n = 0;
  loop(HOP,
    FT[n] = ((((q0[n] * f[0]) + (q2[n] * f[256])) + (q4[n] * f[512])) + (q6[n] * f[768])) + (q8[n] * f[1024]);
    FT[HOP + n] = ((((q1[n] * f[128]) + (q3[n] * f[384])) + (q5[n] * f[640])) + (q7[n] * f[896])) + (q9[n] * f[1152]);
    f += 1; n += 1;
  );
  fft_real(FT, 2 * HOP);
  fft_permute(FT, HOP);
  ab = hb + lp * 258;
  ab[0] = FT[0]; ab[129] = 0;
  ab[128] = FT[1]; ab[257] = 0;
  n = 1;
  loop(HOP - 1, ab[n] = FT[2 * n]; ab[129 + n] = FT[2 * n + 1]; n += 1;);
  lt = lp - 3; lt < 0 ? lt += 7;
  ab = hb + lt * 258;
  pre[0] = ab[0];
  pre[1] = pre[2] = ab[1] * 0.5;
  pre[3] = pre[4] = ab[2] * 0.5;
  pre[5] = pre[6] = ab[3] * 0.5;
  pre[7] = pre[8] = ab[4] * 0.5;
  memcpy(pre + 9, ab + 5, HOP - 4);
  pim[0] = ab[129];
  pim[1] = pim[2] = ab[130] * 0.5;
  pim[3] = pim[4] = ab[131] * 0.5;
  pim[5] = pim[6] = ab[132] * 0.5;
  pim[7] = pim[8] = ab[133] * 0.5;
  memcpy(pim + 9, ab + 134, HOP - 4);
  s6 = hb + lp * 258;
  s4 = lp + 5; s4 >= 7 ? s4 -= 7; s4 = hb + s4 * 258;
  s2 = lp + 3; s2 >= 7 ? s2 -= 7; s2 = hb + s2 * 258;
  s0 = lp + 1; s0 >= 7 ? s0 -= 7; s0 = hb + s0 * 258;
  b = 1;
  loop(4,
    re = -C1 * s6[129 + b];
    im = C1 * s6[b];
    re -= C2 * s4[129 + b];
    im += C2 * s4[b];
    re += C2 * s2[129 + b];
    im -= C2 * s2[b];
    re += C1 * s0[129 + b];
    im -= C1 * s0[b];
    (b & 1) ? (
      pre[b * 2 - 1] -= re; pim[b * 2 - 1] -= im;
      pre[b * 2] += re; pim[b * 2] += im;
    ) : (
      pre[b * 2 - 1] += re; pim[b * 2 - 1] += im;
      pre[b * 2] -= re; pim[b * 2] -= im;
    );
    b += 1;
  );
);

function stft_inv(ire, iim, ob, hout, y) local(n, h, f, q0, q1, q2, q3, q4, q5, q6, q7, q8, q9)
(
  ire[1] = ire[1] + ire[2]; ire[2] = ire[3] + ire[4]; ire[3] = ire[5] + ire[6]; ire[4] = ire[7] + ire[8];
  memcpy(ire + 5, ire + 9, HOP - 4);
  iim[1] = iim[1] + iim[2]; iim[2] = iim[3] + iim[4]; iim[3] = iim[5] + iim[6]; iim[4] = iim[7] + iim[8];
  memcpy(iim + 5, iim + 9, HOP - 4);
  q0 = ob + hout * 2 * HOP;
  q0[0] = ire[0]; q0[1] = ire[HOP];
  n = 1;
  loop(HOP - 1, q0[2 * n] = ire[n]; q0[2 * n + 1] = iim[n]; n += 1;);
  fft_ipermute(q0, HOP);
  ifft_real(q0, 2 * HOP);
  h = hout - 1; h < 0 ? h = 9; q1 = ob + h * 2 * HOP + HOP;
  h -= 1; h < 0 ? h = 9; q2 = ob + h * 2 * HOP;
  h -= 1; h < 0 ? h = 9; q3 = ob + h * 2 * HOP + HOP;
  h -= 1; h < 0 ? h = 9; q4 = ob + h * 2 * HOP;
  h -= 1; h < 0 ? h = 9; q5 = ob + h * 2 * HOP + HOP;
  h -= 1; h < 0 ? h = 9; q6 = ob + h * 2 * HOP;
  h -= 1; h < 0 ? h = 9; q7 = ob + h * 2 * HOP + HOP;
  h -= 1; h < 0 ? h = 9; q8 = ob + h * 2 * HOP;
  h -= 1; h < 0 ? h = 9; q9 = ob + h * 2 * HOP + HOP;
  f = PFI;
  n = 0;
  loop(HOP,
    y[n] = ((((((((((f[1152] * q9[n]) + (f[1024] * q8[n])) + (f[896] * q7[n])) + (f[768] * q6[n])) + (f[640] * q5[n]))
      + (f[512] * q4[n])) + (f[384] * q3[n])) + (f[256] * q2[n])) + (f[128] * q1[n])) + (f[0] * q0[n]));
    f += 1; n += 1;
  );
);

function freq_vec(fs) local(k)
(
  FREQ[0] = 0;
  FREQ[1] = 0.7501 * fs / 256; FREQ[2] = 1.2499 * fs / 256;
  FREQ[3] = 0.8751 * 2 * fs / 256; FREQ[4] = 1.1249 * 2 * fs / 256;
  FREQ[5] = 0.9167 * 3 * fs / 256; FREQ[6] = 1.0833 * 3 * fs / 256;
  FREQ[7] = 0.9375 * 4 * fs / 256; FREQ[8] = 1.0625 * 4 * fs / 256;
  k = 9;
  loop(NB - 9, FREQ[k] = (k - 4) * fs / 256; k += 1;);
);

function kaiser12(x) local(y, ind, frac, i0, i1, i2, i3)
(
  y = x * 64; ind = floor(y); frac = y - ind;
  i3 = -0.1666666667 * frac + 0.1666666667 * (frac * frac * frac);
  i2 = frac + 0.5 * (frac * frac) - 0.5 * (frac * frac * frac);
  i0 = -0.3333333333 * frac + 0.5 * (frac * frac) - 0.1666666667 * (frac * frac * frac);
  i1 = 1 - i3 - i2 - i0;
  i0 * KT[ind] + i1 * KT[ind + 1] + i2 * KT[ind + 2] + i3 * KT[ind + 3];
);

function spx_sinc(cutoff, x, n) local(xx)
(
  xx = x * cutoff;
  abs(x) < 0.000001 ? cutoff :
  abs(x) > 0.5 * n ? 0 :
  cutoff * sin($pi * xx) / ($pi * xx) * kaiser12(abs(2 * x / n));
);

function gcd(a, b) local(t) ( while (b > 0) ( t = a % b; a = b; b = t; ); a; );

function resample(fs) local(g, num, den, fl, cut, os, direct, ia, fa, olen, i, j, ch, ls, sfn, src, dst, acc, off, frac, a0, a1, a2, a3, p, tb, mj, rm, x0, x1, x2, x3, pad)
(
  olen = ceil(HLEN0 * fs / 48000);
  HLEN = 2 ^ ceil(log(olen) / log(2));
  fs == 48000 ? (
    memcpy(HRS, HR0, ND * 2 * HLEN0);
  ) : (
    g = gcd(48000, fs); num = 48000 / g; den = fs / g;
    ia = floor(num / den); fa = num - ia * den;
    os = 32; fl = 256;
    num > den ? (
      cut = 0.975 * den / num;
      mj = floor(fl / den); rm = fl - mj * den;
      fl = floor(rm * num / den) + mj * num;
      fl = floor((fl - 1) / 8) * 8 + 8;
      2 * den < num ? os = os / 2; 4 * den < num ? os = os / 2;
      8 * den < num ? os = os / 2; 16 * den < num ? os = os / 2;
      os < 1 ? os = 1;
    ) : cut = 0.975;
    direct = fl * den <= fl * os + 8;
    tb = HRS + ND * 2 * HLEN;
    direct ? (
      i = 0;
      loop(den,
        j = 0;
        loop(fl, tb[i * fl + j] = spx_sinc(cut, (j - floor(fl / 2) + 1) - i / den, fl); j += 1;);
        i += 1;
      );
    ) : (
      i = -4;
      loop(os * fl + 8, tb[i + 4] = spx_sinc(cut, i / os - floor(fl / 2), fl); i += 1;);
    );
    pad = tb + (direct ? den * fl : os * fl + 8);
    ch = 0;
    loop(ND * 2,
      memset(pad, 0, fl - 1 + HLEN0 + 4 * fl + 2 * HLEN);
      memcpy(pad + fl - 1, HR0 + ch * HLEN0, HLEN0);
      dst = HRS + ch * HLEN;
      ls = floor(fl / 2); sfn = 0;
      i = 0;
      loop(HLEN,
        src = pad + ls;
        direct ? (
          p = tb + sfn * fl; acc = 0; j = 0;
          loop(fl, acc += p[j] * src[j]; j += 1;);
          dst[i] = acc;
        ) : (
          off = floor(sfn * os / den);
          frac = ((sfn * os) % den) / den;
          a0 = a1 = a2 = a3 = 0;
          p = tb + 4 + os - off - 2;
          j = 0;
          loop(fl,
            x0 = src[j];
            a0 += x0 * p[0]; a1 += x0 * p[1]; a2 += x0 * p[2]; a3 += x0 * p[3];
            p += os; j += 1;
          );
          x0 = -0.16667 * frac + 0.16667 * frac * frac * frac;
          x1 = frac + 0.5 * frac * frac - 0.5 * frac * frac * frac;
          x3 = -0.33333 * frac + 0.5 * frac * frac - 0.16667 * frac * frac * frac;
          x2 = 1 - x0 - x1 - x3;
          dst[i] = x0 * a0 + x1 * a1 + x2 * a2 + x3 * a3;
        );
        ls += ia; sfn += fa;
        sfn >= den ? ( sfn -= den; ls += 1; );
        i += 1;
      );
      ch += 1;
    );
  );
);

function est_itds(fs) local(fc, q, kk, k2, dd, b0, b1, b2, a1, a2, i, n, j, w1, w2, v1, v2, wq, xl, xr, mx, mi, bnd, len, m, lag, r, sl, sr)
(
  fc = 750; q = 0.7071;
  kk = tan($pi * fc / fs); k2 = kk * kk;
  dd = k2 * q + kk + q;
  b0 = (k2 * q) / dd; b1 = (2 * k2 * q) / dd; b2 = (k2 * q) / dd;
  a1 = (2 * q * (k2 - 1)) / dd; a2 = (k2 * q - kk + q) / dd;
  bnd = sqrt(2) / 2000;
  len = 2 * HLEN;
  i = 0;
  loop(ND,
    memset(XC, 0, 2 * len);
    sl = HRS + i * 2 * HLEN; sr = sl + HLEN;
    w1 = w2 = v1 = v2 = 0;
    n = 0;
    loop(HLEN,
      wq = sl[n] - a1 * w1 - a2 * w2;
      XC[n] = b0 * wq + b1 * w1 + b2 * w2;
      w2 = w1; w1 = wq;
      wq = sr[n] - a1 * v1 - a2 * v2;
      XC[len + n] = b0 * wq + b1 * v1 + b2 * v2;
      v2 = v1; v1 = wq;
      n += 1;
    );
    m = 0;
    loop(len,
      XD[2 * m] = XC[m]; XD[2 * m + 1] = 0;
      XE[2 * m] = XC[len + m]; XE[2 * m + 1] = 0;
      m += 1;
    );
    fft(XD, len); fft(XE, len);
    m = 0;
    loop(len,
      xl = XD[2 * m]; xr = XD[2 * m + 1];
      v1 = XE[2 * m]; v2 = XE[2 * m + 1];
      XD[2 * m] = xl * v1 + xr * v2;
      XD[2 * m + 1] = xr * v1 - xl * v2;
      m += 1;
    );
    ifft(XD, len);
    mi = 0; mx = 0;
    m = 1;
    loop(2 * HLEN - 1,
      lag = m - HLEN;
      j = lag < 0 ? len + lag : lag;
      r = XD[2 * j] / len;
      r > mx ? ( mi = m - 1; mx = r; );
      m += 1;
    );
    r = (HLEN - mi - 1) / fs;
    r > bnd ? r = bnd; r < -bnd ? r = -bnd;
    ITD[i] = r;
    i += 1;
  );
);

function analyse(x, nch, nts, dre, dim) local(t, ch, b)
(
  memset(ABUF, 0, 2 * HL); memset(AHYB, 0, 2 * 7 * 258);
  a_hin = 0; a_lp = 0;
  t = 0;
  loop(nts,
    a_lp += 1; a_lp >= 7 ? a_lp = 0;
    ch = 0;
    loop(nch,
      stft_fwd(x + ch * nts * HOP + t * HOP, ABUF + ch * HL, AHYB + ch * 7 * 258, a_hin, a_lp, BR, BI);
      b = 0;
      loop(NB,
        dre[(b * nts + t) * nch + ch] = BR[b];
        dim[(b * nts + t) * nch + ch] = BI[b];
        b += 1;
      );
      ch += 1;
    );
    a_hin += 1; a_hin >= 10 ? a_hin = 0;
    t += 1;
  );
);

function fir_to_fb() local(nts, tl, mi, mv, i, j, del, b, t, e, ch, d, gn, cr, ci, xr, xi, yr, yi, ph, src)
(
  tl = max(HLEN, HOP) + 1024;
  nts = ceil(tl / HOP);
  del = 0;
  j = 0;
  loop(2,
    mv = 0.000000000000223; mi = 0;
    i = 0;
    loop(HLEN, HRS[j * HLEN + i] > mv ? ( mv = HRS[j * HLEN + i]; mi = i; ); i += 1;);
    del += mi;
    j += 1;
  );
  del = floor(del / 2 + 1.5);
  memset(XC, 0, nts * HOP * 2);
  XC[del] = 1;
  analyse(XC, 1, nts, CRE, CIM);
  b = 0;
  loop(NB,
    e = 0; t = 0;
    loop(nts, e += sqr(CRE[b * nts + t]) + sqr(CIM[b * nts + t]); t += 1;);
    CEN[b] = max(e, 0.0000000223);
    b += 1;
  );
  d = 0;
  loop(ND,
    memset(XC, 0, nts * HOP * 2);
    src = HRS + d * 2 * HLEN;
    memcpy(XC, src, HLEN);
    memcpy(XC + nts * HOP, src + HLEN, HLEN);
    analyse(XC, 2, nts, TRE, TIM);
    ch = 0;
    loop(2,
      b = 0;
      loop(NB,
        e = 0; cr = ci = 0; t = 0;
        loop(nts,
          xr = TRE[(b * nts + t) * 2 + ch]; xi = TIM[(b * nts + t) * 2 + ch];
          e += sqr(xr) + sqr(xi);
          yr = CRE[b * nts + t]; yi = -CIM[b * nts + t];
          cr += xr * yr - xi * yi;
          ci += xr * yi + xi * yr;
          t += 1;
        );
        gn = sqrt(e / CEN[b]);
        ph = atan2(ci, cr);
        FBR[(b * 2 + ch) * ND + d] = cos(ph) * gn;
        FBI[(b * 2 + ch) * ND + d] = sin(ph) * gn;
        b += 1;
      );
      ch += 1;
    );
    d += 1;
  );
);

function diffuse_eq() local(b, e, j, s, o, dv)
(
  b = 0;
  loop(NB,
    e = 0;
    loop(2,
      o = (b * 2 + e) * ND;
      s = 0; j = 0;
      loop(ND, s += GW[j] / (4 * $pi) * (sqr(FBR[o + j]) + sqr(FBI[o + j])); j += 1;);
      dv = sqrt(max(s, 0.00001)) + 0.0000000223;
      j = 0;
      loop(ND,
        FQR[o + j] = FBR[o + j] / dv; FQI[o + j] = FBI[o + j] / dv;
        j += 1;
      );
      e += 1;
    );
    b += 1;
  );
  j = 0;
  loop(NB * 2 * ND,
    FBM[j] = sqrt(sqr(FBR[j]) + sqr(FBI[j]));
    FQM[j] = sqrt(sqr(FQR[j]) + sqr(FQI[j]));
    j += 1;
  );
);

function clear_tft()
(
  memset(INB, 0, MAXS * HL); memset(HYB, 0, MAXS * 7 * 258); memset(OUB, 0, 2 * 10 * 2 * HOP);
);

function prep_alloc(fs) local(mx)
(
  moremem.mp = __memtop() / 2;
  mx = 2 ^ ceil(log(ceil(HLEN0 * fs / 48000)) / log(2));
  HRS = moremem.alloc(ND * 2 * mx + 16384 * 4 + 2 * mx * 8 + 4096);
  ITD = moremem.alloc(ND);
  FBR = moremem.alloc(NB * 2 * ND); FBI = moremem.alloc(NB * 2 * ND); FBM = moremem.alloc(NB * 2 * ND);
  FQR = moremem.alloc(NB * 2 * ND); FQI = moremem.alloc(NB * 2 * ND); FQM = moremem.alloc(NB * 2 * ND);
  XD = 65536 * ceil(moremem.mp / 65536); moremem.mp = XD + 65536;
  XE = XD + 32768;
  XC = moremem.alloc(4 * mx + 4096);
);

function prep(fs)
(
  prep_alloc(fs);
  resample(fs);
  est_itds(fs);
  freq_vec(fs);
  fir_to_fb();
  diffuse_eq();
  clear_tft();
  ready = 1;
);

function fmodp(x, y) ( x - y * floor(x / y); );

function interp_to(hr, hi, az, el) local(ai, ei, ix, w0, w1, w2, i0, i1, i2, b, e, o, re, im, ar, am, td, ipd, m0, m1, c, s)
(
  ai = floor(fmodp(az + 180, 360) / 2 + 0.5);
  ei = floor((el + 90) / 5 + 0.5);
  ix = (ei * NAZ + ai) * 3;
  w0 = GG[ix]; w1 = GG[ix + 1]; w2 = GG[ix + 2];
  i0 = GIDX[ix]; i1 = GIDX[ix + 1]; i2 = GIDX[ix + 2];
  diffeq ? ( re = FQR; im = FQI; am = FQM; ) : ( re = FBR; im = FBI; am = FBM; );
  interp === 0 ? (
    b = 0;
    loop(NB,
      e = 0;
      loop(2,
        o = (b * 2 + e) * ND;
        hr[b * 2 + e] = re[o + i0] * w0 + re[o + i1] * w1 + re[o + i2] * w2;
        hi[b * 2 + e] = im[o + i0] * w0 + im[o + i1] * w1 + im[o + i2] * w2;
        e += 1;
      );
      b += 1;
    );
  ) : (
    td = w0 * ITD[i0] + w1 * ITD[i1] + w2 * ITD[i2];
    b = 0;
    loop(NB,
      o = b * 2 * ND;
      m0 = w0 * am[o + i0] + w1 * am[o + i1] + w2 * am[o + i2];
      o += ND;
      m1 = w0 * am[o + i0] + w1 * am[o + i1] + w2 * am[o + i2];
      ipd = FREQ[b] < 1500 ? (fmodp(2 * $pi * FREQ[b] * td + $pi, 2 * $pi) - $pi) / 2 : 0;
      c = cos(ipd); s = sin(ipd);
      hr[b * 2] = c * m0; hi[b * 2] = s * m0;
      hr[b * 2 + 1] = c * m1; hi[b * 2 + 1] = -s * m1;
      b += 1;
    );
  );
);

function interp_src(ch, az, el) ( interp_to(HRE + ch * 2 * NB, HIM + ch * 2 * NB, az, el); );

function rot_matrix() local(y, p, r, cy, sy, cp, sp, cr, sr, a, t)
(
  y = flipyaw ? -yaw : yaw; p = flippitch ? -pitch : pitch; r = fliproll ? -roll : roll;
  y *= $pi / 180; p *= $pi / 180; r *= $pi / 180;
  a = RS;
  rpy ? (
    cy = cos(y); sy = sin(y);
    a[0] = 1; a[1] = 0; a[2] = 0; a[3] = 0; a[4] = cy; a[5] = sy; a[6] = 0; a[7] = -sy; a[8] = cy;
    cy = cos(r); sy = sin(r);
    a[18] = cy; a[19] = sy; a[20] = 0; a[21] = -sy; a[22] = cy; a[23] = 0; a[24] = 0; a[25] = 0; a[26] = 1;
  ) : (
    cy = cos(y); sy = sin(y);
    a[0] = cy; a[1] = sy; a[2] = 0; a[3] = -sy; a[4] = cy; a[5] = 0; a[6] = 0; a[7] = 0; a[8] = 1;
    cy = cos(r); sy = sin(r);
    a[18] = 1; a[19] = 0; a[20] = 0; a[21] = 0; a[22] = cy; a[23] = sy; a[24] = 0; a[25] = -sy; a[26] = cy;
  );
  cp = cos(p); sp = sin(p);
  a[9] = cp; a[10] = 0; a[11] = -sp; a[12] = 0; a[13] = 1; a[14] = 0; a[15] = sp; a[16] = 0; a[17] = cp;
  t = 0;
  loop(9,
    a[27 + t] = a[9 + 3 * floor(t / 3)] * a[t % 3] + a[10 + 3 * floor(t / 3)] * a[3 + t % 3] + a[11 + 3 * floor(t / 3)] * a[6 + t % 3];
    t += 1;
  );
  t = 0;
  loop(9,
    a[36 + t] = a[18 + 3 * floor(t / 3)] * a[27 + t % 3] + a[19 + 3 * floor(t / 3)] * a[30 + t % 3] + a[20 + 3 * floor(t / 3)] * a[33 + t % 3];
    t += 1;
  );
);

function rot_dirs() local(i, a, ce, x, y, z, rx, ry, rz)
(
  rot_matrix();
  a = RS + 36;
  i = 0;
  loop(nsrc,
    ce = cos(SEL[i] * $pi / 180);
    x = ce * cos(SAZ[i] * $pi / 180); y = ce * sin(SAZ[i] * $pi / 180); z = sin(SEL[i] * $pi / 180);
    rx = x * a[0] + y * a[3] + z * a[6];
    ry = x * a[1] + y * a[4] + z * a[7];
    rz = x * a[2] + y * a[5] + z * a[8];
    RAZ[i] = atan2(ry, rx) * 180 / $pi;
    REL[i] = atan2(rz, sqrt(rx * rx + ry * ry)) * 180 / $pi;
    i += 1;
  );
);

function sync() local(i, a, e, all, chg)
(
  all = chg = 0;
  ready ? (
    nsrc = max(1, min(MAXS, floor(num_src + 0.5)));
    nsrc !== p_nsrc ? ( p_nsrc = nsrc; clear_tft(); all = 1; );
    lfe_i = floor(lfe_ch + 0.5) - 1;
    a = lfe_i >= 0 && lfe_i < nsrc;
    (a !== p_lfon || (a && lfe_i !== p_lfi)) ? (
      lfon = a; p_lfon = a; p_lfi = lfe_i; clear_tft(); memset(LFB, 0, 2048); lfe_g = lfe_gt;
    );
    lfe_gt = 10 ^ (lfe_db / 20) * SG[max(0, lfe_i)];
    lfsc = 1 / sqrt(max(1, nsrc - lfon));
    (interp_mode !== p_interp || diff_eq !== p_deq) ? (
      p_interp = interp_mode; p_deq = diff_eq; interp = interp_mode; diffeq = diff_eq; all = 1;
    );
    (rotation !== p_rot || use_rpy !== p_rpy || yaw !== p_yaw || pitch !== p_pitch || roll !== p_roll ||
     flipyaw !== p_fy || flippitch !== p_fp || fliproll !== p_fr) ? (
      p_rot = rotation; p_rpy = use_rpy; rpy = use_rpy; p_yaw = yaw; p_pitch = pitch; p_roll = roll;
      p_fy = flipyaw; p_fp = flippitch; p_fr = fliproll;
      rotation ? chg = 1 : all = 1;
    );
    i = 0;
    loop(nsrc,
      a = slider(SL0 + 2 * i); e = slider(SL0 + 1 + 2 * i);
      a > 180 ? a = -360 + a;
      a = max(-180, min(180, a)); e = max(-90, min(90, e));
      (a !== SAZ[i] || e !== SEL[i] || all) ? (
        SAZ[i] = a; SEL[i] = e;
        RECALC[i] = 1; chg = 1;
      );
      i += 1;
    );
    rotation && (chg || all) ? (
      rot_dirs();
      i = 0; loop(nsrc, interp_src(i, RAZ[i], REL[i]); RECALC[i] = 0; i += 1;);
    ) : (
      i = 0;
      loop(nsrc,
        RECALC[i] ? ( interp_src(i, SAZ[i], SEL[i]); RECALC[i] = 0; );
        i += 1;
      );
    );
  );
);

function process_frame() local(ch, b, x, g, hr, hi, xr, xi, sc, n, o)
(
  memset(ORE, 0, 2 * NB); memset(OIM, 0, 2 * NB);
  rt_lp += 1; rt_lp >= 7 ? rt_lp = 0;
  ch = 0;
  loop(nsrc,
    lfon && ch === lfe_i ? 0 : (
    x = XT + ch * HOP;
    g = SG[ch];
    abs(g - 1) > 0.000001 ? ( n = 0; loop(HOP, x[n] *= g; n += 1;); );
    stft_fwd(x, INB + ch * HL, HYB + ch * 7 * 258, rt_hin, rt_lp, BR, BI);
    hr = HRE + ch * 2 * NB; hi = HIM + ch * 2 * NB;
    b = 0;
    loop(NB,
      xr = BR[b]; xi = BI[b];
      ORE[b] += hr[2 * b] * xr - hi[2 * b] * xi;
      OIM[b] += hr[2 * b] * xi + hi[2 * b] * xr;
      ORE[NB + b] += hr[2 * b + 1] * xr - hi[2 * b + 1] * xi;
      OIM[NB + b] += hr[2 * b + 1] * xi + hi[2 * b + 1] * xr;
      b += 1;
    );
    );
    ch += 1;
  );
  rt_hin += 1; rt_hin >= 10 ? rt_hin = 0;
  sc = 1 / sqrt(nsrc - lfon);
  n = 0; loop(2 * NB, ORE[n] *= sc; OIM[n] *= sc; n += 1;);
  stft_inv(ORE, OIM, OUB, rt_hout, YT);
  stft_inv(ORE + NB, OIM + NB, OUB + 10 * 2 * HOP, rt_hout, YT + HOP);
  rt_hout += 1; rt_hout >= 10 ? rt_hout = 0;
);

i = 0; loop(MAXS, SG[i] = 1; SAZ[i] = -1000; i += 1;);
ready = 0; pos = 0; last_srate = 0;
rt_hin = rt_hout = rt_lp = 0;
p_nsrc = p_interp = p_deq = p_rot = p_rpy = p_yaw = p_pitch = p_roll = p_fy = p_fp = p_fr = -1;
lfon = 0; p_lfon = p_lfi = -1; lfe_g = lfe_gt = 1; lfw = 0; lfsc = 1;
function gsx(x) ( G_OX + x * G_SC; );
function gsy(y) ( y * G_SC; );
function gclamp(x, a, b) ( min(b, max(a, x)); );

function grspan(qx0, qy0, qx1, qy1, qrad, yc) local(dy, ins) (
  dy = yc < qy0 + qrad ? qy0 + qrad - yc : yc > qy1 - qrad ? yc - (qy1 - qrad) : 0;
  G_RC = max(0, min(1, qrad - dy + 0.5));
  dy = min(qrad, dy);
  ins = qrad - sqrt(max(0, qrad * qrad - dy * dy));
  G_RL = qx0 + ins; G_RR = qx1 - ins;
);

function gspan(lx, rx, j, a) local(lc, rc) (
  lc = ceil(lx); rc = floor(rx);
  rc >= lc ? (
    gfx_a = a; rc > lc ? gfx_rect(lc, j, rc - lc, 1);
    lc - lx > 0 ? ( gfx_a = a * (lc - lx); gfx_rect(lc - 1, j, 1, 1); );
    rx - rc > 0 ? ( gfx_a = a * (rx - rc); gfx_rect(rc, j, 1, 1); );
  ) : rx > lx ? ( gfx_a = a * (rx - lx); gfx_rect(floor(lx), j, 1, 1); );
);

function gfrr(qx0, qy0, qx1, qy1, qrad, cr, cg, cb, a0) local(j) (
  qx0 = floor(qx0 + 0.5); qy0 = floor(qy0 + 0.5); qx1 = floor(qx1 + 0.5); qy1 = floor(qy1 + 0.5);
  qrad = max(0, min(qrad, min(qy1 - qy0, qx1 - qx0) * 0.5));
  gfx_set(cr, cg, cb, a0);
  j = qy0;
  loop(qy1 - qy0,
    grspan(qx0, qy0, qx1, qy1, qrad, j + 0.5);
    G_RC > 0 ? gspan(G_RL, G_RR, j, a0 * G_RC);
    j += 1;
  );
  gfx_a = 1;
);

function gbord(qx0, qy0, qx1, qy1, qrad, t, cr, cg, cb, a0) local(j, ol, orr, oc, il, ir, ic) (
  qx0 = floor(qx0 + 0.5); qy0 = floor(qy0 + 0.5); qx1 = floor(qx1 + 0.5); qy1 = floor(qy1 + 0.5);
  qrad = max(0, min(qrad, min(qy1 - qy0, qx1 - qx0) * 0.5));
  gfx_set(cr, cg, cb, a0);
  j = qy0;
  loop(qy1 - qy0,
    grspan(qx0, qy0, qx1, qy1, qrad, j + 0.5); ol = G_RL; orr = G_RR; oc = G_RC;
    (j + 0.5 > qy0 + t && j + 0.5 < qy1 - t) ? (
      grspan(qx0 + t, qy0 + t, qx1 - t, qy1 - t, max(0, qrad - t), j + 0.5); il = G_RL; ir = G_RR; ic = G_RC;
    ) : ( ic = 0; );
    oc > 0 ? (
      ic <= 0 ? gspan(ol, orr, j, a0 * oc) : (
        gspan(ol, il, j, a0 * oc);
        gspan(ir, orr, j, a0 * oc);
        oc - ic > 0.004 ? gspan(il, ir, j, a0 * (oc - ic));
      );
    );
    j += 1;
  );
  gfx_a = 1;
);

function gcard(x, y, w, h, r, a0, ba) local(xx, yy, ww, hh, rr) (
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC); rr = max(2, floor(r * G_SC));
  gfrr(xx, yy, xx + ww, yy + hh, rr, 0.165, 0.17, 0.18, a0);
  gbord(xx, yy, xx + ww, yy + hh, rr, max(1, floor(G_SC + 0.5)), 0.62, 0.66, 0.70, ba);
);

function gtext(x, y, s, fnt, r, g, b, a, ctr) local(tw, th) (
  gfx_setfont(fnt);
  gfx_set(r, g, b, a);
  gfx_measurestr(s, tw, th);
  gfx_x = ctr === 1 ? gsx(x) - tw * 0.5 : ctr === 2 ? gsx(x) - tw : gsx(x);
  gfx_y = gsy(y) - th * 0.5;
  gfx_drawstr(s);
);

function gann(cx, cy, ri, ro, aa, ab, cr, cg, cb, al) local(py, px, dy, dx, hwo, hwi, d, cv, th, ca, x0, x1, x2, x3) (
  py = floor(cy - ro - 1);
  loop(ceil(2 * ro + 3),
    dy = py + 0.5 - cy;
    hwo = sqrt(max(0, (ro + 0.5) * (ro + 0.5) - dy * dy));
    hwo > 0 ? (
      hwi = ri > 0.5 ? sqrt(max(0, (ri - 0.5) * (ri - 0.5) - dy * dy)) : 0;
      x0 = floor(cx - hwo); x1 = ceil(cx - hwi); x2 = floor(cx + hwi); x3 = ceil(cx + hwo);
      hwi <= 0 ? x1 = x3 + 1;
      px = x0;
      while (px <= x3) (
        dx = px + 0.5 - cx;
        d = sqrt(dx * dx + dy * dy);
        cv = min(1, min(ro - d + 0.5, d - ri + 0.5));
        cv > 0 ? (
          th = atan2(dx, -dy);
          ca = min(1, min((th - aa) * d + 0.5, (ab - th) * d + 0.5));
          ca > 0 ? (
            gfx_set(cr, cg, cb, al * cv * ca);
            gfx_rect(px, py, 1, 1);
          );
        );
        px += 1;
        (px > x1 && px < x2) ? px = x2;
      );
    );
    py += 1;
  );
  gfx_a = 1;
);

function gbar(x0, y0, x1, y1, w) local(dx, dy, ll, hw, bx0, by0, bx1, by1, px, py, qx, qy, t, ex, ey, d, cv, cr, cg, cb, ca) (
  cr = gfx_r; cg = gfx_g; cb = gfx_b; ca = gfx_a;
  dx = x1 - x0; dy = y1 - y0; ll = max(0.000001, dx * dx + dy * dy);
  hw = w * 0.5;
  bx0 = floor(min(x0, x1) - hw - 1); bx1 = ceil(max(x0, x1) + hw + 1);
  by0 = floor(min(y0, y1) - hw - 1); by1 = ceil(max(y0, y1) + hw + 1);
  py = by0;
  while (py <= by1) (
    px = bx0;
    while (px <= bx1) (
      qx = px + 0.5; qy = py + 0.5;
      t = max(0, min(1, ((qx - x0) * dx + (qy - y0) * dy) / ll));
      ex = qx - (x0 + t * dx); ey = qy - (y0 + t * dy);
      d = sqrt(ex * ex + ey * ey);
      cv = min(1, hw - d + 0.5);
      cv > 0 ? ( gfx_set(cr, cg, cb, ca * cv); gfx_rect(px, py, 1, 1); );
      px += 1;
    );
    py += 1;
  );
  gfx_set(cr, cg, cb, ca);
);

function gknob(kx, ky, kr, v, ctr, hov, nm, vs, dim) local(cx, cy, r, a0, a1, sa, ca, px0, py0, al) (
  cx = gsx(kx); cy = gsy(ky); r = kr * G_SC;
  al = dim ? 0.66 : 1;
  a0 = -$pi * 0.75; a1 = $pi * 0.75;
  gfx_set(0.02, 0.02, 0.03, 0.5 * al);
  gfx_circle(cx, cy, r + 3 * G_SC, 1, 1);
  gfx_set(0.11, 0.12, 0.13, 1);
  gfx_circle(cx, cy, r - 5 * G_SC, 1, 1);
  gfx_set(0.20, 0.21, 0.23, 1);
  gfx_circle(cx, cy, r - 7 * G_SC, 1, 1);
  gfx_set(0.13, 0.14, 0.15, 1);
  gfx_circle(cx, cy + 1.2 * G_SC, r - 9 * G_SC, 1, 1);
  gann(cx, cy, r - 1.2 * G_SC, r + 1.2 * G_SC, a0, a1, 0.62, 0.66, 0.70, 0.35 * al);
  sa = a0 + (a1 - a0) * v;
  ca = a0 + (a1 - a0) * ctr;
  abs(sa - ca) > 0.001 ? (
    gann(cx, cy, r - 3.5 * G_SC, r + 3.5 * G_SC, min(ca, sa), max(ca, sa), G_ACR, G_ACG, G_ACB, 0.18 * al);
    gann(cx, cy, r - 1.5 * G_SC, r + 1.5 * G_SC, min(ca, sa), max(ca, sa), G_ACR, G_ACG, G_ACB, al);
  );
  px0 = cx + sin(sa) * (r - 8 * G_SC);
  py0 = cy - cos(sa) * (r - 8 * G_SC);
  gfx_set(0.95, 0.97, 0.98, (hov ? 1 : 0.86) * al);
  gbar(cx + sin(sa) * (r * 0.22), cy - cos(sa) * (r * 0.22), px0, py0, max(1.5, 2.4 * G_SC));
  gtext(kx, ky - kr - 13, nm, 1, 0.93, 0.95, 0.96, 0.95 * al, 1);
  gtext(kx, ky + kr + 13, vs, 2, 0.80, 0.84, 0.88, 0.95 * al, 1);
);
function gbtn(x, y, w, h, lb, on, hov) local(xx, yy, ww, hh, rr) (
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC); rr = floor(h * 0.5 * G_SC);
  on ? (
    gfrr(xx, yy, xx + ww, yy + hh, rr, G_ACR, G_ACG, G_ACB, hov ? 1 : 0.9);
    gtext(x + w * 0.5, y + h * 0.5, lb, 3, 0.06, 0.12, 0.10, 1, 1);
  ) : (
    gfrr(xx, yy, xx + ww, yy + hh, rr, 0.10, 0.11, 0.12, hov ? 0.95 : 0.8);
    gbord(xx, yy, xx + ww, yy + hh, rr, max(1, floor(G_SC + 0.5)), 0.62, 0.66, 0.70, hov ? 0.7 : 0.4);
    gtext(x + w * 0.5, y + h * 0.5, lb, 3, 0.85, 0.88, 0.90, hov ? 1 : 0.8, 1);
  );
);

