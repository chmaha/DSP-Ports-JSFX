function gpanel(x, y, w, h, ttl) local(xx, yy, ww, hh, rr) (
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC); rr = max(2, floor(10 * G_SC));
  gfrr(xx, yy, xx + ww, yy + hh, rr, 0.105, 0.135, 0.165, 0.92);
  gbord(xx, yy, xx + ww, yy + hh, rr, max(1, floor(G_SC + 0.5)), 0.56, 0.64, 0.72, 0.45);
  gtext(x + w * 0.5, y + 16, ttl, 3, 0.86, 0.90, 0.94, 1, 1);
);

function gbox(x, y, w, h, s, hov, act) local(xx, yy, ww, hh, rr) (
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC); rr = max(2, floor(5 * G_SC));
  gfrr(xx, yy, xx + ww, yy + hh, rr, 0.06, 0.08, 0.10, 0.95);
  gbord(xx, yy, xx + ww, yy + hh, rr, max(1, floor(G_SC + 0.5)), act ? G_ACR : 0.56, act ? G_ACG : 0.64, act ? G_ACB : 0.72, act ? 0.95 : hov ? 0.75 : 0.4);
  gtext(x + w * 0.5, y + h * 0.5, s, 2, 0.92, 0.94, 0.96, 1, 1);
);

function gseg2(x, y, w, h, la, lb, cur, hov, dim) local(sw, i, xx, yy, ww, hh) (
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC);
  gfrr(xx, yy, xx + ww, yy + hh, floor(h * 0.5 * G_SC), 0.06, 0.08, 0.10, 0.9);
  gbord(xx, yy, xx + ww, yy + hh, floor(h * 0.5 * G_SC), max(1, floor(G_SC + 0.5)), 0.56, 0.64, 0.72, 0.4);
  sw = w / 2;
  i = 0;
  loop(2,
    i === cur ? (
      xx = floor(gsx(x + i * sw + 3)); yy = floor(gsy(y + 3)); ww = ceil((sw - 6) * G_SC); hh = ceil((h - 6) * G_SC);
      gfrr(xx, yy, xx + ww, yy + hh, floor((h - 6) * 0.5 * G_SC), G_ACR, G_ACG, G_ACB, (hov === i ? 1 : 0.9) * (dim ? 0.6 : 1));
      gtext(x + i * sw + sw * 0.5, y + h * 0.5, i ? lb : la, 3, 0.10, 0.04, 0.10, 1, 1);
    ) : (
      gtext(x + i * sw + sw * 0.5, y + h * 0.5, i ? lb : la, 3, 0.85, 0.88, 0.90, hov === i ? 1 : 0.75, 1);
    );
    i += 1;
  );
);

function gdot(cx, cy, r, cr, cg, cb, a) (
  gfx_set(cr, cg, cb, a);
  gfx_circle(cx, cy, r, 1, 1);
);

function gpreset_name(k) (
  k === 2 ? "Mono" : k === 3 ? "Stereo" : k === 4 ? "5.x" : k === 5 ? "7.x" : k === 6 ? "8.x" : k === 7 ? "9.x" :
  k === 8 ? "10.x" : k === 9 ? "11.x" : k === 10 ? "11.x (7+4)" : k === 11 ? "13.x" : k === 12 ? "22.x" : k === 13 ? "9+10+3.2" :
  k === 14 ? "Stereo" : k === 15 ? "LCR" : k === 16 ? "Quad" : k === 17 ? "5.0" : k === 18 ? "5.0.2" : k === 19 ? "5.0.4" :
  k === 20 ? "7.0" : k === 21 ? "7.0.2" : k === 22 ? "7.0.4" : k === 23 ? "7.0.6" : k === 24 ? "9.0.4" : k === 25 ? "9.0.6" :
  k === 26 ? "Aalto MCC" : k === 27 ? "Aalto MCC-subset" : k === 28 ? "Aalto Apaja" : k === 29 ? "Aalto LR" : k === 30 ? "DTU AVIL" :
  k === 31 ? "Zylia Lab (22.x)" : k === 32 ? "T-design (4)" : k === 33 ? "T-design (12)" : k === 34 ? "T-design (24)" :
  k === 35 ? "T-design (36)" : k === 36 ? "T-design (48)" : k === 37 ? "T-design (60)" : k === 38 ? "SphCov (9)" :
