function gsur(i, a, e) (
  slider(SL0 + 2 * i) = a; gauto(SL0 + 2 * i, 1);
  slider(SL0 + 1 + 2 * i) = e; gauto(SL0 + 1 + 2 * i, 1);
);

function gapply_surround(id) local(n) (
  n = id === 43 ? 6 : id === 44 ? 8 : id === 45 ? 8 : id === 46 ? 10 : id === 47 ? 10 : 12;
  num_src = n; gauto(1, 1);
  gsur(0, 30, 0); gsur(1, -30, 0); gsur(2, 0, 0); gsur(3, 0, -90);
  (id === 43 || id === 45 || id === 46) ? ( gsur(4, 110, 0); gsur(5, -110, 0); ) : (
    gsur(4, 90, 0); gsur(5, -90, 0); gsur(6, 135, 0); gsur(7, -135, 0);
  );
  id === 45 ? ( gsur(6, 90, 60); gsur(7, -90, 60); ) :
  id === 46 ? ( gsur(6, 45, 45); gsur(7, -45, 45); gsur(8, 135, 45); gsur(9, -135, 45); ) :
  id === 47 ? ( gsur(8, 90, 60); gsur(9, -90, 60); ) :
  id === 48 ? ( gsur(8, 45, 45); gsur(9, -45, 45); gsur(10, 135, 45); gsur(11, -135, 45); );
  lfe_ch = 4; gauto(140, 1);
  G_PRE = id;
);

function gapply_preset(id) local(k, n, p, i) (
  k = id - 1;
  id >= 43 && id <= 48 ? gapply_surround(id) :
  data_ok && k >= 0 && k < NPRE ? (
    lfe_ch = 0; gauto(140, 1);
    n = PRN[k]; p = PRD + k * 128;
    num_src = n; gauto(1, 1);
    i = 0;
    loop(n,
      slider(SL0 + 2 * i) = floor(p[2 * i] * 100 + 0.5) / 100; gauto(SL0 + 2 * i, 1);
      slider(SL0 + 1 + 2 * i) = floor(p[2 * i + 1] * 100 + 0.5) / 100; gauto(SL0 + 1 + 2 * i, 1);
      i += 1;
    );
    G_PRE = id;
  );
);

function gset_dir(i, a, e) (
  a = floor(gclamp(a, -180, 180) * 100 + 0.5) / 100; e = floor(gclamp(e, -90, 90) * 100 + 0.5) / 100;
  slider(SL0 + 2 * i) !== a ? ( slider(SL0 + 2 * i) = a; gauto(SL0 + 2 * i, 0); );
  slider(SL0 + 1 + 2 * i) !== e ? ( slider(SL0 + 1 + 2 * i) = e; gauto(SL0 + 1 + 2 * i, 0); );
);

function gtip_text(id) (
  id === 1 ? strcpy(#g_tip, "Load a loudspeaker layout onto the sources") :
  id === 2 ? strcpy(#g_tip, "Number of inputs (drag, wheel or +/-)") :
  id === 3 ? strcpy(#g_tip, "Drag up/down, wheel, Ctrl = fine, double-click to type") :
  id === 4 ? strcpy(#g_tip, "Drag a source to move it; Alt+click solos it") :
  id === 5 ? strcpy(#g_tip, "Divide out the average (diffuse-field) response of the HRTF set") :
  id === 6 ? strcpy(#g_tip, "Rotate the whole scene (head tracking)") :
  id === 7 ? strcpy(#g_tip, "Rotation order: yaw-pitch-roll or roll-pitch-yaw") :
  id === 8 ? strcpy(#g_tip, "Triangular: complex HRTFs; PS: magnitudes plus a low-frequency phase from the ITD") :
  id === 9 ? strcpy(#g_tip, "Invert this rotation axis") :
  id === 10 ? strcpy(#g_tip, "Rotation angle (double-click to reset)") :
  id === 11 ? strcpy(#g_tip, "LFE input: skips the HRTFs and feeds both ears (Off = every input is a source)") :
  id === 12 ? strcpy(#g_tip, "LFE level in dB (drag, wheel, double-click = 0 dB; cinema mixes may expect +10 dB)") : strcpy(#g_tip, "");
  #g_tip;
);

G_ACR = 0.95; G_ACG = 0.36; G_ACB = 0.90;
G_SHOWS = 1; G_SHOWH = 1; G_SCROLL = 0; G_EDIT = -1; G_SOLO = -1; G_PRE = 0; G_REQ = 0; G_MBLK = 0;


@slider
