strcpy(20, "Halls"); strcpy(30, "The programs found in the Halls group are reverberation programs designed to emulate real concert halls and larger natural acoustical spaces. They are useful for a variety of tasks, and are especially well suited for orchestral music applications.");
strcpy(21, "Rooms"); strcpy(31, "The programs found in the Rooms group are reverberation programs designed to emulate rooms and smaller natural acoustical spaces. They are useful for a variety of tasks, and are especially well suited for post production applications and adding space to dialog and solo instruments in music mixes.");
strcpy(22, "Plates"); strcpy(32, "The programs found in the Plates group are reverberation programs designed to emulate the sound of an analog metal plate reverb. They are useful for a variety of tasks, and are especially well suited for popular multi-track recordings and live performance applications.");
strcpy(23, "Spaces"); strcpy(33, "The programs found in the Spaces group are reverberation programs designed to emulate outdoor sounds, non-real sounds, and other very large or small acoustical spaces. They are useful for a variety of tasks, and are especially well suited for post production creating special effects.");
strcpy(24, "Ambiences"); strcpy(34, "The programs found in the Ambience group are reverberation programs designed add space without necessarily adding reverb. They are useful for a variety of tasks, and are especially well suited for post production and dialog applications, as well as adding 'air' to voice and solo instruments.");
strcpy(25, "Effects"); strcpy(35, "The programs found in the Effects group are not necessarily adding reverb, but recreate miscellaneous audible artifacts. They are mainly useful for creating special effects.");
function e_init(ebp, ez) instance(ebase, eend, LVT, OBL, OBR, HD, WV, DYN, ready, nlev, lst, act, QB0, L, nin, npath, mode, irlen, ncov, span, ph, ywl, ywr, lh, lopen, lerr, lnch, lfsr, lfr, lg, lim, lzl, lsr, lpos, lnc, lrs, lrn, lc, lk, lp, lnin, lnp, lmd, lpm0, lpm1, lpm2, lpm3, wpk, wver, cin0, gsc, age) (
  ebase = ebp; eend = ebp + ez;
  LVT = ebp; OBL = ebp + 256; OBR = OBL + RSO; HD = OBR + RSO; WV = HD + 512; DYN = WV + 4 * NWB;
  ready = 0; nlev = 0; lst = 0; act = 0;
);

function e_layout(nn, qb, lat, ni, np, md) instance(ebase, eend, LVT, OBL, OBR, HD, WV, DYN, ready, nlev, lst, act, QB0, L, nin, npath, mode, irlen, ncov, span, ph, ywl, ywr, lh, lopen, lerr, lnch, lfsr, lfr, lg, lim, lzl, lsr, lpos, lnc, lrs, lrn, lc, lk, lp, lnin, lnp, lmd, lpm0, lpm1, lpm2, lpm3, wpk, wver, cin0, gsc, age) local(k, bb, oo, pp, pn, ptr, tb, nb) (
  QB0 = qb; L = lat; nin = ni; npath = np; mode = md; irlen = nn; cin0 = md === 2 ? CINM : CINL;
  oo = lat ? 0 : qb;
  bb = qb; k = 0; ptr = DYN;
  while (oo < nn && k < 15) (
    tb = LVT + k * 16;
    nb = min(16384, bb * GROW);
    bb >= 16384 ? pp = ceil((nn - oo) / bb) : (
      pn = max(1, ceil((2 * nb - qb - lat - oo) / bb));
      pp = nn - oo <= (pn + 2) * bb ? ceil((nn - oo) / bb) : pn;
    );
    tb[0] = bb; tb[1] = pp; tb[2] = oo; tb[3] = bb / qb;
    tb[10] = 2 * bb; tb[11] = pp * 2 * bb;
    ptr = ceil(ptr / (2 * bb)) * 2 * bb;
    tb[4] = ptr; ptr += ni * pp * 2 * bb;
    tb[5] = ptr; ptr += pp * bb * 2 * np;
    tb[13] = bb * 2 * np;
    ptr = ceil(ptr / (2 * bb)) * 2 * bb;
    tb[6] = ptr; ptr += 2 * bb;
    tb[7] = ptr; ptr += 2 * bb;
    tb[8] = pp - 1; tb[9] = 0;
    tb[12] = oo + lat + 1 - bb - (bb / qb - 1) * qb;
    oo += pp * bb;
    bb = nb;
    k += 1;
  );
  nlev = k; ncov = oo;
  span = oo + lat + 2 * 16384 + 2 * qb;
  ptr <= eend ? ( memset(DYN, 0, ptr - DYN); memset(OBL, 0, 2 * RSO); memset(HD, 0, 512); ph = 0; 1; ) : 0;
);


function e_reset() instance(ebase, eend, LVT, OBL, OBR, HD, WV, DYN, ready, nlev, lst, act, QB0, L, nin, npath, mode, irlen, ncov, span, ph, ywl, ywr, lh, lopen, lerr, lnch, lfsr, lfr, lg, lim, lzl, lsr, lpos, lnc, lrs, lrn, lc, lk, lp, lnin, lnp, lmd, lpm0, lpm1, lpm2, lpm3, wpk, wver, cin0, gsc, age) local(k, tb) (
  k = 0;
  loop(nlev,
    tb = LVT + k * 16;
    memset(tb[4], 0, nin * tb[1] * tb[10]);
    memset(tb[6], 0, tb[10]); memset(tb[7], 0, tb[10]);
    tb[8] = tb[1] - 1; tb[9] = 0;
    k += 1;
  );
  memset(OBL, 0, RSO); memset(OBR, 0, RSO);
  ph = 0; age = 0;
);

function mac_ts(xx, xc, hq, hb, al, ar, pp, sq, n2, q0, q1) local(b, xp, hp, lr, li, rr, ri, xa, xb, xe, xf, xc1, na) (
  xc1 = xc + 1; na = sq + 1; b = q0;
  b === 0 ? (
      lr = li = rr = ri = 0;
      xp = xx + sq * n2 + 2 * 0; hp = hq + 0 * 8;
      loop(na,
        xa = xp[0]; xb = xp[1]; xe = xp[xc]; xf = xp[xc1];
          lr += xa * hp[0] + xe * hp[4]; li += xb * hp[1] + xf * hp[5];
          rr += xa * hp[2] + xe * hp[6]; ri += xb * hp[3] + xf * hp[7];
          xp -= n2; hp += hb;
      );
      xp = xx + (pp - 1) * n2 + 2 * 0;
      loop(pp - na,
        xa = xp[0]; xb = xp[1]; xe = xp[xc]; xf = xp[xc1];
          lr += xa * hp[0] + xe * hp[4]; li += xb * hp[1] + xf * hp[5];
          rr += xa * hp[2] + xe * hp[6]; ri += xb * hp[3] + xf * hp[7];
          xp -= n2; hp += hb;
      );
      al[2 * 0] = lr; al[2 * 0 + 1] = li; ar[2 * 0] = rr; ar[2 * 0 + 1] = ri;
      b = 1;
  );
  while (b < q1) (
      lr = li = rr = ri = 0;
      xp = xx + sq * n2 + 2 * b; hp = hq + b * 8;
      loop(na,
        xa = xp[0]; xb = xp[1]; xe = xp[xc]; xf = xp[xc1];
          lr += xa * hp[0] - xb * hp[1] + xe * hp[4] - xf * hp[5];
          li += xa * hp[1] + xb * hp[0] + xe * hp[5] + xf * hp[4];
          rr += xa * hp[2] - xb * hp[3] + xe * hp[6] - xf * hp[7];
          ri += xa * hp[3] + xb * hp[2] + xe * hp[7] + xf * hp[6];
          xp -= n2; hp += hb;
      );
      xp = xx + (pp - 1) * n2 + 2 * b;
      loop(pp - na,
        xa = xp[0]; xb = xp[1]; xe = xp[xc]; xf = xp[xc1];
          lr += xa * hp[0] - xb * hp[1] + xe * hp[4] - xf * hp[5];
          li += xa * hp[1] + xb * hp[0] + xe * hp[5] + xf * hp[4];
          rr += xa * hp[2] - xb * hp[3] + xe * hp[6] - xf * hp[7];
