  dy = min(qrad, dy);
  ins = qrad - sqrt(max(0, qrad * qrad - dy * dy));
  G_RL = qx0 + ins; G_RR = qx1 - ins;
);

function gspan(lx, rx, j, a) local(lc, rc) (
  lc = ceil(lx); rc = floor(rx);
  rc >= lc ? (
    gfx_a = a; rc > lc ? gfx_rect(lc, j, rc - lc, 1);
    lc - lx > 0 ? ( gfx_a = a * (lc - lx); gfx_rect(lc - 1, j, 1, 1); );
    rx - rc > 0 ? ( gfx_a = a * (rx - rc); gfx_rect(rc, j, 1, 1); );
  ) : rx > lx ? ( gfx_a = a * (rx - lx); gfx_rect(floor(lx), j, 1, 1); );
);

function gfrr(qx0, qy0, qx1, qy1, qrad, cr, cg, cb, a0) local(j) (
  qx0 = floor(qx0 + 0.5); qy0 = floor(qy0 + 0.5); qx1 = floor(qx1 + 0.5); qy1 = floor(qy1 + 0.5);
  qrad = max(0, min(qrad, min(qy1 - qy0, qx1 - qx0) * 0.5));
  gfx_set(cr, cg, cb, a0);
  j = qy0;
  loop(qy1 - qy0,
    grspan(qx0, qy0, qx1, qy1, qrad, j + 0.5);
    G_RC > 0 ? gspan(G_RL, G_RR, j, a0 * G_RC);
    j += 1;
  );
  gfx_a = 1;
);

function gbord(qx0, qy0, qx1, qy1, qrad, t, cr, cg, cb, a0) local(j, ol, orr, oc, il, ir, ic) (
  qx0 = floor(qx0 + 0.5); qy0 = floor(qy0 + 0.5); qx1 = floor(qx1 + 0.5); qy1 = floor(qy1 + 0.5);
  qrad = max(0, min(qrad, min(qy1 - qy0, qx1 - qx0) * 0.5));
  gfx_set(cr, cg, cb, a0);
  j = qy0;
  loop(qy1 - qy0,
    grspan(qx0, qy0, qx1, qy1, qrad, j + 0.5); ol = G_RL; orr = G_RR; oc = G_RC;
    (j + 0.5 > qy0 + t && j + 0.5 < qy1 - t) ? (
      grspan(qx0 + t, qy0 + t, qx1 - t, qy1 - t, max(0, qrad - t), j + 0.5); il = G_RL; ir = G_RR; ic = G_RC;
    ) : ( ic = 0; );
    oc > 0 ? (
      ic <= 0 ? gspan(ol, orr, j, a0 * oc) : (
        gspan(ol, il, j, a0 * oc);
        gspan(ir, orr, j, a0 * oc);
        oc - ic > 0.004 ? gspan(il, ir, j, a0 * (oc - ic));
      );
    );
    j += 1;
  );
  gfx_a = 1;
);

function gcard(x, y, w, h, r, a0, ba) local(xx, yy, ww, hh, rr) (
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC); rr = max(2, floor(r * G_SC));
  gfrr(xx, yy, xx + ww, yy + hh, rr, 0.165, 0.17, 0.18, a0);
  gbord(xx, yy, xx + ww, yy + hh, rr, max(1, floor(G_SC + 0.5)), 0.62, 0.66, 0.70, ba);
);

function gtext(x, y, s, fnt, r, g, b, a, ctr) local(tw, th) (
  gfx_setfont(fnt);
  gfx_set(r, g, b, a);
  gfx_measurestr(s, tw, th);
  gfx_x = ctr === 1 ? gsx(x) - tw * 0.5 : ctr === 2 ? gsx(x) - tw : gsx(x);
  gfx_y = gsy(y) - th * 0.5;
  gfx_drawstr(s);
);

function gann(cx, cy, ri, ro, aa, ab, cr, cg, cb, al) local(py, px, dy, dx, hwo, hwi, d, cv, th, ca, x0, x1, x2, x3) (
  py = floor(cy - ro - 1);
  loop(ceil(2 * ro + 3),
    dy = py + 0.5 - cy;
    hwo = sqrt(max(0, (ro + 0.5) * (ro + 0.5) - dy * dy));
    hwo > 0 ? (
      hwi = ri > 0.5 ? sqrt(max(0, (ri - 0.5) * (ri - 0.5) - dy * dy)) : 0;
      x0 = floor(cx - hwo); x1 = ceil(cx - hwi); x2 = floor(cx + hwi); x3 = ceil(cx + hwo);
      hwi <= 0 ? x1 = x3 + 1;
      px = x0;
      while (px <= x3) (
        dx = px + 0.5 - cx;
        d = sqrt(dx * dx + dy * dy);
        cv = min(1, min(ro - d + 0.5, d - ri + 0.5));
        cv > 0 ? (
          th = atan2(dx, -dy);
          ca = min(1, min((th - aa) * d + 0.5, (ab - th) * d + 0.5));
          ca > 0 ? (
            gfx_set(cr, cg, cb, al * cv * ca);
            gfx_rect(px, py, 1, 1);
          );
        );
        px += 1;
        (px > x1 && px < x2) ? px = x2;
      );
    );
    py += 1;
  );
  gfx_a = 1;
);

function gbar(x0, y0, x1, y1, w) local(dx, dy, ll, hw, bx0, by0, bx1, by1, px, py, qx, qy, t, ex, ey, d, cv, cr, cg, cb, ca) (
  cr = gfx_r; cg = gfx_g; cb = gfx_b; ca = gfx_a;
  dx = x1 - x0; dy = y1 - y0; ll = max(0.000001, dx * dx + dy * dy);
  hw = w * 0.5;
  bx0 = floor(min(x0, x1) - hw - 1); bx1 = ceil(max(x0, x1) + hw + 1);
  by0 = floor(min(y0, y1) - hw - 1); by1 = ceil(max(y0, y1) + hw + 1);
  py = by0;
  while (py <= by1) (
    px = bx0;
    while (px <= bx1) (
      qx = px + 0.5; qy = py + 0.5;
      t = max(0, min(1, ((qx - x0) * dx + (qy - y0) * dy) / ll));
      ex = qx - (x0 + t * dx); ey = qy - (y0 + t * dy);
      d = sqrt(ex * ex + ey * ey);
      cv = min(1, hw - d + 0.5);
      cv > 0 ? ( gfx_set(cr, cg, cb, ca * cv); gfx_rect(px, py, 1, 1); );
      px += 1;
    );
    py += 1;
  );
  gfx_set(cr, cg, cb, ca);
);

function gknob(kx, ky, kr, v, ctr, hov, nm, vs, dim) local(cx, cy, r, a0, a1, sa, ca, px0, py0, al) (
  cx = gsx(kx); cy = gsy(ky); r = kr * G_SC;
  al = dim ? 0.66 : 1;
  a0 = -$pi * 0.75; a1 = $pi * 0.75;
  gfx_set(0.02, 0.02, 0.03, 0.5 * al);
  gfx_circle(cx, cy, r + 3 * G_SC, 1, 1);
  gfx_set(G_KRR, G_KRG, G_KRB, 1);
  gfx_circle(cx, cy, r - 5 * G_SC, 1, 1);
  gfx_set(G_KFR, G_KFG, G_KFB, 1);
  gfx_circle(cx, cy, r - 7 * G_SC, 1, 1);
  gfx_set(G_KIR, G_KIG, G_KIB, 1);
  gfx_circle(cx, cy + 1.2 * G_SC, r - 9 * G_SC, 1, 1);
  gann(cx, cy, r - 1.2 * G_SC, r + 1.2 * G_SC, a0, a1, G_KTR, G_KTG, G_KTB, 0.6 * al);
  sa = a0 + (a1 - a0) * v;
  ca = a0 + (a1 - a0) * ctr;
  abs(sa - ca) > 0.001 ? (
    gann(cx, cy, r - 3.5 * G_SC, r + 3.5 * G_SC, min(ca, sa), max(ca, sa), G_ACR, G_ACG, G_ACB, 0.18 * al);
    gann(cx, cy, r - 1.5 * G_SC, r + 1.5 * G_SC, min(ca, sa), max(ca, sa), G_ACR, G_ACG, G_ACB, al);
  );
  px0 = cx + sin(sa) * (r - 8 * G_SC);
  py0 = cy - cos(sa) * (r - 8 * G_SC);
  gfx_set(G_KPR, G_KPG, G_KPB, (hov ? 1 : 0.86) * al);
  gbar(cx + sin(sa) * (r * 0.22), cy - cos(sa) * (r * 0.22), px0, py0, max(1.5, 2.4 * G_SC));
  gtext(kx, ky - kr - 13, nm, 1, G_T1R, G_T1G, G_T1B, 0.95 * al, 1);
  gtext(kx, ky + kr + 13, vs, 2, G_ACR, G_ACG, G_ACB, 0.95 * al, 1);
);
function gbtn(x, y, w, h, lb, on, hov) local(xx, yy, ww, hh, rr) (
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC); rr = floor(h * 0.5 * G_SC);
  on ? (
    gfrr(xx, yy, xx + ww, yy + hh, rr, G_ACR, G_ACG, G_ACB, hov ? 1 : 0.9);
    gtext(x + w * 0.5, y + h * 0.5, lb, 3, G_DKR, G_DKG, G_DKB, 1, 1);
  ) : (
    gfrr(xx, yy, xx + ww, yy + hh, rr, G_BFR, G_BFG, G_BFB, hov ? 0.95 : 0.8);
    gbord(xx, yy, xx + ww, yy + hh, rr, max(1, floor(G_SC + 0.5)), G_BDR, G_BDG, G_BDB, hov ? 0.7 : 0.4);
    gtext(x + w * 0.5, y + h * 0.5, lb, 3, G_T2R, G_T2G, G_T2B, hov ? 1 : 0.8, 1);
  );
);

function gauto(s, e) (
<?
max_sliders > 8 ? printf("slider_automate(2^(s-1), e);") : (
  printf("s == 1 ? slider_automate(program, e) :\n");
  printf("s == 2 ? slider_automate(in_mode, e) :\n");
  printf("s == 3 ? slider_automate(dry_db, e) :\n");
  printf("s == 4 ? slider_automate(wet_db, e) :\n");
  printf("s == 5 ? slider_automate(predelay, e) :\n");
  printf("s == 6 ? slider_automate(zero_lat, e) :\n");
  printf("s == 7 ? slider_automate(enable, e) :\n");
  printf("s == 8 ? slider_automate(theme, e) : 0;");
);
?>
);

function gpanel(x, y, w, h, ttl) local(xx, yy, ww, hh, rr) (
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC); rr = max(2, floor(10 * G_SC));
  gfrr(xx, yy, xx + ww, yy + hh, rr, G_PFR, G_PFG, G_PFB, 0.92);
  gbord(xx, yy, xx + ww, yy + hh, rr, max(1, floor(G_SC + 0.5)), G_BDR, G_BDG, G_BDB, 0.45);
  gtext(x + w * 0.5, y + 16, ttl, 3, G_T2R, G_T2G, G_T2B, 1, 1);
);

function gbox(x, y, w, h, s, hov, act) local(xx, yy, ww, hh, rr) (
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC); rr = max(2, floor(5 * G_SC));
  gfrr(xx, yy, xx + ww, yy + hh, rr, G_BXR, G_BXG, G_BXB, 0.95);
  gbord(xx, yy, xx + ww, yy + hh, rr, max(1, floor(G_SC + 0.5)), act ? G_ACR : G_BDR, act ? G_ACG : G_BDG, act ? G_ACB : G_BDB, act ? 0.95 : hov ? 0.75 : 0.4);
  gtext(x + w * 0.5, y + h * 0.5, s, 2, G_T1R, G_T1G, G_T1B, 1, 1);
);

function gseg2(x, y, w, h, la, lb, cur, hov, dim) local(sw, i, xx, yy, ww, hh) (
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC);
  gfrr(xx, yy, xx + ww, yy + hh, floor(h * 0.5 * G_SC), G_BXR, G_BXG, G_BXB, 0.9);
  gbord(xx, yy, xx + ww, yy + hh, floor(h * 0.5 * G_SC), max(1, floor(G_SC + 0.5)), G_BDR, G_BDG, G_BDB, 0.4);
  sw = w / 2;
  i = 0;
  loop(2,
    i === cur ? (
      xx = floor(gsx(x + i * sw + 3)); yy = floor(gsy(y + 3)); ww = ceil((sw - 6) * G_SC); hh = ceil((h - 6) * G_SC);
      gfrr(xx, yy, xx + ww, yy + hh, floor((h - 6) * 0.5 * G_SC), G_ACR, G_ACG, G_ACB, (hov === i ? 1 : 0.9) * (dim ? 0.6 : 1));
      gtext(x + i * sw + sw * 0.5, y + h * 0.5, i ? lb : la, 3, G_DKR, G_DKG, G_DKB, 1, 1);
    ) : (
      gtext(x + i * sw + sw * 0.5, y + h * 0.5, i ? lb : la, 3, G_T2R, G_T2G, G_T2B, hov === i ? 1 : 0.75, 1);
    );
    i += 1;
  );
);

function gwrap(w, fnt) local(n, i, c, ls, lb, ln, tw, th) (
  gfx_setfont(fnt);
  n = strlen(#g_desc); i = 0; ls = 0; lb = -1; ln = 0;
  while (i <= n && ln < 8) (
    c = i < n ? str_getchar(#g_desc, i) : 32;
    c === 32 ? (
      strcpy_substr(#g_tx, #g_desc, ls, i - ls);
      gfx_measurestr(#g_tx, tw, th);
      tw > w * G_SC && lb > ls ? (
        strcpy_substr(40 + ln, #g_desc, ls, lb - ls); ln += 1; ls = lb + 1;
      );
      lb = i;
    );
    i += 1;
  );
  ls < n && ln < 8 ? ( strcpy_substr(40 + ln, #g_desc, ls, n - ls); ln += 1; );
  ln;
);

function gtip_text(id) (
  id === 1 ? strcpy(#g_tip, "Programs in this group") :
  id === 2 ? strcpy(#g_tip, "Click to load this program") :
  id === 3 ? strcpy(#g_tip, "Drag up/down or use the wheel; Ctrl = fine; double-click resets") :
  id === 4 ? strcpy(#g_tip, "Stereo: L feeds the left IR and R the right one. Mono to Stereo: L+R feeds both") :
  id === 5 ? strcpy(#g_tip, "No latency (direct-form head, more CPU); off = 256 samples, compensated by REAPER") :
  id === 6 ? strcpy(#g_tip, "Off passes the dry signal only") :
  id === 9 ? strcpy(#g_tip, "Colour theme") : strcpy(#g_tip, "");
  #g_tip;
);

function gdbstr(d) ( d <= -60 ? strcpy(#g_tx, "Off") : sprintf(#g_tx, "%.1f dB", d); #g_tx; );


G_SCROLL = 0; G_CAT = -1; G_DRAG = 0; G_MBLK = 0; G_WCAT = -1; G_WSC = 0; G_NWL = 0;

TTBS = EMB + ESZ + 65536;
TTO = TTBS; TTN = TTBS + 4; TTW = TTBS + 8; TTY0 = TTBS + 12; TTY1 = TTBS + 16;
TTE = TTBS + 32; TTX = TTE + 8192; TTD = TTX + 2048; TTC = TTD + 2048;
TTK = 0;
