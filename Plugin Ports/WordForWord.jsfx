function e_sample() instance(ebase, eend, LVT, OBL, OBR, HD, WV, DYN, ready, nlev, lst, act, QB0, L, nin, npath, mode, irlen, ncov, span, ph, ywl, ywr, lh, lopen, lerr, lnch, lfsr, lfr, lg, lim, lzl, lsr, lpos, lnc, lrs, lrn, lc, lk, lp, lnin, lnp, lmd, lpm0, lpm1, lpm2, lpm3, wpk, wver, cin0, gsc, age) local(xl, xr, hp, a0, a1, v0, v1) (
