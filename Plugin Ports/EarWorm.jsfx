  loop(ns,
    x = XT + ch * HOP;
    g = nt === 1 ? sqrt(2 * floor(sqrt(ch)) + 1) : nt === 2 ? (ch === 0 ? sqrt(2) : sqrt(3)) : 1;
    g !== 1 ? ( n = 0; loop(HOP, x[n] *= g; n += 1;); );
    stft_fwd(x, INB + ch * HL, HYB + ch * 7 * 258, rt_hin, rt_lp, BR, BI);
