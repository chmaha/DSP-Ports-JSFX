function design_start()
(
  d_state = 1; d_band = 0;
);

function design_setup() local(i, d, w, k, j, s, pyw, pya, td)
(
  d_order = c_order; d_nsh = (d_order + 1) * (d_order + 1);
  d_method = c_method; d_maxre = c_maxre; d_diffm = c_diffm;
  d_trunc = c_trunc && d_method === 0 && pre_proc !== 2 && pre_proc !== 3;
  d_cut = band_cut();
