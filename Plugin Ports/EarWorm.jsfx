T441[128] = 21360.937478510; T441[129] = 21533.203108994; T441[130] = 21705.468678356; T441[131] = 21877.734276834; T441[132] = 22050.000000000;
YA = alloc(64 * ND); YWA = alloc(64 * ND); GM = alloc(64 * 128); GI = alloc(64 * 64);
WV = alloc(ND); SPA = alloc(ND * 128); YTD = alloc(NSH_SPR * 128); YTMP = alloc(NSH_SPR + 64);
DSR = alloc(NB * 2 * 64); DSI = alloc(NB * 2 * 64);
DCR = alloc(64 * NB * 2); DCI = alloc(64 * NB * 2);
ADR = alloc(64 * NB * 2); ADI = alloc(64 * NB * 2);
RMT = alloc(64 * 64); RXY = alloc(64);
RR2 = alloc(128); RI2 = alloc(128); BR2 = alloc(128); BI2 = alloc(128);
HMR = alloc(2 * ND); HMI = alloc(2 * ND); HTR = alloc(256); HTI = alloc(256);
TGN = alloc(NB); KRV = alloc(NB); WN = alloc(64);
BSJ = alloc(64); BDJ = alloc(64); BSY = alloc(64); BDY = alloc(64);
PTA = alloc(NB * 2 * 2); PTT = alloc(NB * 2);
INSC = alloc(64); XTT = alloc(HOP);

function tdesign_load(p) local(d, k, q)
(
  q = TDD; d = 0;
  loop(7,
    k = p[1]; TDN[d] = k; TDP[d] = q;
    memcpy(q, p + 2, 2 * k);
    q += 2 * k; p += 2 + 2 * k;
    d += 1;
  );
);

function abin_freq(fs) local(k)
(
  k = 0;
  loop(NB,
    FREQ[k] = fs === 44100 ? T441[k] : fs === 48000 ? T48[k] : T48[k] * fs / 48000;
    k += 1;
  );
);

function f32(x) local(c) ( c = x * 536870913; c - (c - x); );

function fmod_x(x, y) local(q, r)
(
  q = x / y; q = q < 0 ? ceil(q) : floor(q);
  r = x - y * q;
  x >= 0 && r < 0 ? r += y;
  x < 0 && r > 0 ? r -= y;
  abs(r) >= abs(y) ? r -= (r < 0 ? -y : y);
  r;
);

function ipd_f32(f, t) local(pfl, tp, a, r)
(
  pfl = f32($pi); tp = 2 * pfl;
  a = f32(f32(tp * f32(f32(f) * f32(t))) + pfl);
  r = fmod_x(a, tp);
  r = r >= 0 ? r : f32(r + tp);
  f32(r - pfl) / 2;
);

function apply_preproc() local(eq, ph, b, e, j, s, o, dv, ipd, m, c, sn, bnd, td)
(
  eq = pre_proc === 1 || pre_proc === 3;
  ph = pre_proc === 2 || pre_proc === 3;
  memcpy(FQR, FBR, NB * 2 * ND); memcpy(FQI, FBI, NB * 2 * ND);
  eq ? (
    b = 0;
    loop(NB,
      e = 0;
      loop(2,
        o = (b * 2 + e) * ND;
        s = 0; j = 0;
        loop(ND, s += GW[j] / (4 * $pi) * (sqr(FQR[o + j]) + sqr(FQI[o + j])); j += 1;);
        dv = sqrt(max(s, 0.00001)) + 0.0000000223;
        j = 0; loop(ND, FQR[o + j] /= dv; FQI[o + j] /= dv; j += 1;);
        e += 1;
      );
      b += 1;
    );
  );
  ph ? (
    b = 0;
    loop(NB,
      o = b * 2 * ND;
      j = 0;
      loop(ND,
        td = f32(ITD[j]); bnd = f32(f32(sqrt(2)) / 2000);
        td > bnd ? td = bnd; td < -bnd ? td = -bnd;
        ipd = ipd_f32(FREQ[b], td);
        c = cos(ipd); sn = sin(ipd);
        m = sqrt(sqr(FQR[o + j]) + sqr(FQI[o + j]));
        FQR[o + j] = c * m; FQI[o + j] = sn * m;
        m = sqrt(sqr(FQR[o + ND + j]) + sqr(FQI[o + ND + j]));
        FQR[o + ND + j] = c * m; FQI[o + ND + j] = -sn * m;
        j += 1;
      );
      b += 1;
    );
  );
);

function gauss_inv(n) local(i, j, k, piv, mx, t, f, a)
(
  i = 0;
  loop(n,
    j = 0; loop(n, GM[i * 128 + n + j] = i === j; j += 1;);
    i += 1;
  );
  k = 0;
  loop(n,
    piv = k; mx = abs(GM[k * 128 + k]);
    i = k + 1;
    loop(n - k - 1, abs(GM[i * 128 + k]) > mx ? ( mx = abs(GM[i * 128 + k]); piv = i; ); i += 1;);
    piv !== k ? (
      j = 0; loop(2 * n, t = GM[k * 128 + j]; GM[k * 128 + j] = GM[piv * 128 + j]; GM[piv * 128 + j] = t; j += 1;);
    );
    f = GM[k * 128 + k];
    j = 0; loop(2 * n, GM[k * 128 + j] /= f; j += 1;);
    i = 0;
    loop(n,
      i !== k ? (
        a = GM[i * 128 + k];
        a !== 0 ? ( j = 0; loop(2 * n, GM[i * 128 + j] -= a * GM[k * 128 + j]; j += 1;); );
      );
      i += 1;
    );
    k += 1;
  );
  i = 0;
  loop(n, j = 0; loop(n, GI[i * 64 + j] = GM[i * 128 + n + j]; j += 1;); i += 1;);
);

function ls_solve(hr, hi, b) local(i, e, d, yw, sr, si, h1, h2, k, g, sbr, sbi)
(
  i = 0;
  loop(d_nsh,
    yw = YWA + i * ND;
    e = 0;
    loop(2,
      h1 = hr + e * ND; h2 = hi + e * ND;
      sr = si = 0; d = 0;
      loop(ND, sr += yw[d] * h1[d]; si -= yw[d] * h2[d]; d += 1;);
      RR2[i * 2 + e] = sr; RI2[i * 2 + e] = si;
      e += 1;
    );
    i += 1;
  );
  i = 0;
  loop(d_nsh,
    g = GI + i * 64;
    e = 0;
    loop(2,
      sbr = sbi = 0; k = 0;
      loop(d_nsh, sbr += g[k] * RR2[k * 2 + e]; sbi += g[k] * RI2[k * 2 + e]; k += 1;);
      DSR[(b * 2 + e) * 64 + i] = sbr; DSI[(b * 2 + e) * 64 + i] = -sbi;
      e += 1;
    );
    i += 1;
  );
);

function band_cut() local(b, mv, bc)
(
  mv = 22300000000; bc = 0; b = 0;
  loop(NB, mv > abs(FREQ[b] - 1500) ? ( mv = abs(FREQ[b] - 1500); bc = b; ); b += 1;);
  bc;
);

function design_band(b) local(o, e, d, i, dr, di, sr, si, cref0, cref1, cls0, cls1, gh, src, x, y, a, m, k, tr, ti, ytp, ar, kk)
(
  o = b * 2 * ND;
  d_method === 0 ? ls_solve(HPR + o, HPI + o, b) :
  d_method === 1 ? (
    ls_solve(HPR + o, HPI + o, b);
    cref0 = cref1 = cls0 = cls1 = 0;
    d = 0;
    loop(ND,
      dr = di = sr = si = 0; i = 0;
      loop(d_nsh,
        y = YA[i * ND + d];
        dr += DSR[b * 128 + i] * y; di += DSI[b * 128 + i] * y;
        sr += DSR[b * 128 + 64 + i] * y; si += DSI[b * 128 + 64 + i] * y;
        i += 1;
      );
      cls0 += WV[d] * (dr * dr + di * di); cls1 += WV[d] * (sr * sr + si * si);
      cref0 += WV[d] * (sqr(HPR[o + d]) + sqr(HPI[o + d]));
      cref1 += WV[d] * (sqr(HPR[o + ND + d]) + sqr(HPI[o + ND + d]));
      d += 1;
    );
    gh = (sqrt(cref0 / (cls0 + 0.000000223)) + sqrt(cref1 / (cls1 + 0.000000223))) / 2;
    i = 0; loop(128, DSR[b * 128 + i] *= gh; DSI[b * 128 + i] *= gh; i += 1;);
  ) :
  d_method === 2 ? (
    e = 0;
    loop(2,
      k = 0;
      loop(d_ktd,
        tr = ti = 0; d = 0; src = o + e * ND;
        loop(ND, a = SPA[d * 128 + k]; tr += HPR[src + d] * a; ti += HPI[src + d] * a; d += 1;);
        HTR[e * 128 + k] = tr; HTI[e * 128 + k] = ti;
        k += 1;
      );
      e += 1;
    );
    i = 0;
    loop(d_nsh,
      ytp = YTD + i * 128;
      e = 0;
      loop(2,
        sr = si = 0; k = 0;
        loop(d_ktd, sr += ytp[k] * HTR[e * 128 + k]; si -= ytp[k] * HTI[e * 128 + k]; k += 1;);
        DSR[(b * 2 + e) * 64 + i] = sr / d_ktd; DSI[(b * 2 + e) * 64 + i] = -si / d_ktd;
        e += 1;
      );
      i += 1;
    );
  ) :
  d_method === 3 ? (
    b >= d_cut ? ls_solve(HPR + d_cut * 2 * ND, HPI + d_cut * 2 * ND, b) : ls_solve(HPR + o, HPI + o, b);
  ) : (
    b <= d_cut ? ls_solve(HPR + o, HPI + o, b) : (
      e = 0;
      loop(2,
        d = 0;
        loop(ND,
          dr = di = 0; i = 0;
          loop(d_nsh, y = YA[i * ND + d]; dr += DSR[((b - 1) * 2 + e) * 64 + i] * y; di += DSI[((b - 1) * 2 + e) * 64 + i] * y; i += 1;);
          m = sqrt(sqr(HPR[o + e * ND + d]) + sqr(HPI[o + e * ND + d]));
          a = atan2(di, dr);
          HMR[e * ND + d] = m * cos(a); HMI[e * ND + d] = m * sin(a);
          d += 1;
        );
        e += 1;
      );
      ls_solve(HMR, HMI, b);
    );
  );
);

function chol2(c00, c01r, c01i, c11, x) local(a, cbr, cbi)
(
  a = sqrt(c00); cbr = c01r / a; cbi = c01i / a;
  x[0] = a; x[1] = 0; x[2] = cbr; x[3] = cbi; x[4] = 0; x[5] = 0; x[6] = sqrt(c11 - (cbr * cbr + cbi * cbi)); x[7] = 0;
);

function cmul2(a, b, c) local(i, j)
(
  i = 0;
  loop(2,
    j = 0;
    loop(2,
      c[(i * 2 + j) * 2] = a[(i * 2) * 2] * b[j * 2] - a[(i * 2) * 2 + 1] * b[j * 2 + 1] + a[(i * 2 + 1) * 2] * b[(2 + j) * 2] - a[(i * 2 + 1) * 2 + 1] * b[(2 + j) * 2 + 1];
      c[(i * 2 + j) * 2 + 1] = a[(i * 2) * 2] * b[j * 2 + 1] + a[(i * 2) * 2 + 1] * b[j * 2] + a[(i * 2 + 1) * 2] * b[(2 + j) * 2 + 1] + a[(i * 2 + 1) * 2 + 1] * b[(2 + j) * 2];
      j += 1;
    );
    i += 1;
  );
);

function cadj2(a, c)
(
  c[0] = a[0]; c[1] = -a[1]; c[2] = a[4]; c[3] = -a[5]; c[4] = a[2]; c[5] = -a[3]; c[6] = a[6]; c[7] = -a[7];
);

function diffm_band(b) local(o, d, i, e, h0r, h0i, h1r, h1i, w, c00, c11, c01r, c01i, q, x, xa, m, t, u, s, tt, dt, k)
(
  o = b * 2 * ND;
  c00 = c11 = c01r = c01i = 0;
  d = 0;
  loop(ND,
    w = WV[d];
    h0r = HPR[o + d]; h0i = HPI[o + d]; h1r = HPR[o + ND + d]; h1i = HPI[o + ND + d];
    c00 += w * (h0r * h0r + h0i * h0i); c11 += w * (h1r * h1r + h1i * h1i);
    c01r += w * (h0r * h1r + h0i * h1i); c01i += w * (h0i * h1r - h0r * h1i);
    d += 1;
  );
  x = RR2; chol2(c00, c01r, c01i, c11, x);
  c00 = c11 = c01r = c01i = 0;
  d = 0;
  loop(ND,
    w = WV[d];
    h0r = h0i = h1r = h1i = 0; i = 0;
    loop(d_nsh,
      t = YA[i * ND + d];
      h0r += DSR[b * 128 + i] * t; h0i += DSI[b * 128 + i] * t;
      h1r += DSR[b * 128 + 64 + i] * t; h1i += DSI[b * 128 + 64 + i] * t;
      i += 1;
    );
    c00 += w * (h0r * h0r + h0i * h0i); c11 += w * (h1r * h1r + h1i * h1i);
    c01r += w * (h0r * h1r + h0i * h1i); c01i += w * (h0i * h1r - h0r * h1i);
    d += 1;
  );
  xa = RR2 + 8; chol2(c00, c01r, c01i, c11, xa);
  q = RR2 + 16; cadj2(xa, q);
  m = RR2 + 24; cmul2(q, x, m);
  q = RR2 + 32; cadj2(m, q);
  t = RR2 + 40; cmul2(m, q, t);
  dt = sqrt(t[0] * t[6] - (t[2] * t[2] + t[3] * t[3]));
  tt = sqrt(t[0] + t[6] + 2 * dt);
  u = RR2 + 48;
  s = (t[0] + dt) * (t[6] + dt) - (t[2] * t[2] + t[3] * t[3]);
  u[0] = (t[6] + dt) * tt / s; u[1] = 0;
  u[2] = -t[2] * tt / s; u[3] = -t[3] * tt / s;
  u[4] = -t[4] * tt / s; u[5] = -t[5] * tt / s;
  u[6] = (t[0] + dt) * tt / s; u[7] = 0;
  s = RR2 + 56; cmul2(q, u, s);
  t = RR2 + 64; cmul2(s, x, t);
  m = RR2 + 72;
  m[4] = 0; m[5] = 0;
  dt = xa[6];
  m[4] = t[4] / dt; m[5] = t[5] / dt;
  m[6] = t[6] / dt; m[7] = t[7] / dt;
  w = xa[0];
  m[0] = (t[0] - (xa[2] * m[4] - xa[3] * m[5])) / w;
  m[1] = (t[1] - (xa[2] * m[5] + xa[3] * m[4])) / w;
  m[2] = (t[2] - (xa[2] * m[6] - xa[3] * m[7])) / w;
  m[3] = (t[3] - (xa[2] * m[7] + xa[3] * m[6])) / w;
  i = 0;
  loop(d_nsh,
    h0r = DSR[b * 128 + i]; h0i = DSI[b * 128 + i]; h1r = DSR[b * 128 + 64 + i]; h1i = DSI[b * 128 + 64 + i];
    e = 0;
    loop(2,
      DSR[(b * 2 + e) * 64 + i] = (m[e * 2] * h0r + m[e * 2 + 1] * h0i) + (m[(2 + e) * 2] * h1r + m[(2 + e) * 2 + 1] * h1i);
      DSI[(b * 2 + e) * 64 + i] = (m[e * 2] * h0i - m[e * 2 + 1] * h0r) + (m[(2 + e) * 2] * h1i - m[(2 + e) * 2 + 1] * h1r);
      e += 1;
    );
    i += 1;
  );
);

function envj(n, x) ( 0.5 * log(6.28 * n) - n * log(1.36 * x / n); );

function msta1(x, mp) local(a0, f, f0, f1, it, nn, n0, n1, done)
(
  nn = 0; a0 = abs(x);
  n0 = floor(1.1 * a0) + 1;
  f0 = envj(n0, a0) - mp;
  n1 = n0 + 5;
  f1 = envj(n1, a0) - mp;
  it = 1; done = 0;
  while (it <= 20 && !done) (
    nn = n1 - ((n1 - n0) / (1 - f0 / f1) | 0);
    f = envj(nn, a0) - mp;
    abs(nn - n1) < 1 ? done = 1 : ( n0 = n1; f0 = f1; n1 = nn; f1 = f; it += 1; );
  );
  nn;
);

function msta2(x, n, mp) local(a0, ejn, f, f0, f1, hmp, obj, it, n0, n1, nn, done)
(
  nn = 0; a0 = abs(x); hmp = 0.5 * mp;
  ejn = envj(n, a0);
  ejn <= hmp ? ( obj = mp; n0 = floor(1.1 * a0); ) : ( obj = hmp + ejn; n0 = n; );
  f0 = envj(n0, a0) - obj;
  n1 = n0 + 5;
  f1 = envj(n1, a0) - obj;
  it = 1; done = 0;
  while (it <= 20 && !done) (
    nn = n1 - ((n1 - n0) / (1 - f0 / f1) | 0);
    f = envj(nn, a0) - obj;
    abs(nn - n1) < 1 ? done = 1 : ( n0 = n1; f0 = f1; n1 = nn; f1 = f; it += 1; );
  );
  nn + 10;
);

function sphj(n, x) local(k, m, i, cs, f, f0, f1, sa, sb, nm)
(
  nm = n;
  BSJ[0] = sin(x) / x;
  BSJ[1] = (BSJ[0] - cos(x)) / x;
  n >= 2 ? (
    sa = BSJ[0]; sb = BSJ[1];
    m = msta1(x, 200);
    m < n ? nm = m : m = msta2(x, n, 15);
    i = 0;
    while (m < 0) ( m = msta2(x, n, 14 - i); i += 1; i === 14 ? m = 0; );
    f0 = 0; f1 = 1 - 100; f = 1; cs = 1;
    k = m;
    while (k > -1) (
      f = (2 * k + 3) * f1 / x - f0;
      k <= nm ? BSJ[k] = f;
      f0 = f1; f1 = f;
      k -= 1;
    );
    abs(sa) > abs(sb) ? cs = sa / f;
    abs(sa) <= abs(sb) ? cs = sb / f0;
    k = 0; loop(nm + 1, BSJ[k] *= cs; k += 1;);
  );
  BDJ[0] = (cos(x) - sin(x) / x) / x;
  k = 1; loop(nm, BDJ[k] = BSJ[k - 1] - (k + 1) * BSJ[k] / x; k += 1;);
  nm;
);

function sphy(n, x) local(k, f, f0, f1, nm, done)
(
  BSY[0] = -cos(x) / x;
  BSY[1] = (BSY[0] - sin(x)) / x;
  f0 = BSY[0]; f1 = BSY[1];
  k = 2; done = 0;
  while (k <= n && !done) (
    f = (2 * k - 1) * f1 / x - f0;
    BSY[k] = f;
    abs(f) >= 10 ^ 300 ? done = 1 : ( f0 = f1; f1 = f; k += 1; );
  );
  nm = k - 1;
  BDY[0] = (sin(x) + cos(x) / x) / x;
  k = 1; loop(nm, BDY[k] = BSY[k - 1] - (k + 1) * BSY[k] / x; k += 1;);
  nm;
);

function modal_power(n, dst) local(b, maxn, nm1, nm2, k, x, jr, cr, ci, den, qr, qi, hr, hi, vr, vi, p)
(
  maxn = 1000000000;
  b = 0;
  loop(NB,
    x = KRV[b];
    x > 0.000000000000001 ? ( nm1 = sphj(n, x); maxn = min(maxn, nm1); nm2 = sphy(n, x); maxn = min(maxn, nm2); );
    b += 1;
  );
  b = 0;
  loop(NB,
    x = KRV[b];
    p = 0;
    x > 0.000000000000001 ? ( sphj(n, x); sphy(n, x); );
    k = 0;
    loop(min(maxn, n) + 1,
      x <= 0.00000000000000000001 ? (
        p += k === 0 ? WN[k] * (2 * k + 1) * sqr(4 * $pi) : 0;
      ) : (
        cr = BDJ[k]; ci = -BDY[k];
        den = cr * cr + ci * ci;
        qr = BDJ[k] * cr / den; qi = -BDJ[k] * ci / den;
        hr = BSJ[k]; hi = -BSY[k];
        vr = BSJ[k] - (qr * hr - qi * hi); vi = -(qr * hi + qi * hr);
        p += (2 * k + 1) * (sqr(4 * $pi) * (vr * vr + vi * vi)) * WN[k];
      );
      k += 1;
    );
    dst[b] = p;
    b += 1;
  );
);

function leg_p(n, x) local(p0, p1, p2, k)
(
  n === 0 ? 1 : (
    p0 = 1; p1 = x; k = 2;
    loop(n - 1, p2 = ((2 * k - 1) * x * p1 - (k - 1) * p0) / k; p0 = p1; p1 = p2; k += 1;);
    p1;
  );
);

function trunc_eq() local(b, n, x, p, w0, nrm, bn, clip, g)
(
  n = 0;
  d_maxre ? (
    x = cos(2.4068 / (d_order + 1.51));
    nrm = 0;
    loop(d_order + 1,
      p = leg_p(n, x);
      bn = sqrt((2 * n + 1) / (4 * $pi)) * p;
      WN[n] = bn; nrm += sqrt((2 * n + 1) / (4 * $pi)) * bn;
      n += 1;
    );
    n = 0; loop(d_order + 1, WN[n] /= nrm; WN[n] /= sqrt((2 * n + 1) / (4 * $pi)); n += 1;);
    w0 = WN[0]; n = 0; loop(d_order + 1, WN[n] /= w0; n += 1;);
  ) : ( loop(d_order + 1, WN[n] = 1; n += 1;); );
  b = 0; loop(NB, KRV[b] = 2 * $pi / 343 * FREQ[b] * 0.085; b += 1;);
  memcpy(WN + 48, WN, 8);
  n = 0; loop(43, WN[n] = 1; n += 1;);
  modal_power(42, PTT);
  memcpy(WN, WN + 48, 8);
  modal_power(d_order, PTA);
  clip = 10 ^ (9 / 20);
  b = 0;
  loop(NB,
    g = (1 / (4 * $pi) * sqrt(PTT[b])) / (1 / (4 * $pi) * sqrt(PTA[b]) + 0.000000000000223);
    g /= clip;
