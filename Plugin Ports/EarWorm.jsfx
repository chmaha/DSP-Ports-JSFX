        loop(a_nsh, m = RMT[k * 64 + j]; sr += DCR[(k * NB + b) * 2 + e] * m; si += DCI[(k * NB + b) * 2 + e] * m; k += 1;);
        ADR[(j * NB + b) * 2 + e] = sr; ADI[(j * NB + b) * 2 + e] = si;
        j += 1;
