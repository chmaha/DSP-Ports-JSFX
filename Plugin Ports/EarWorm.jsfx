data_ok ? tdesign_load(D_END);
ready = 0; pos = 0; last_srate = 0; have_dec = 0; d_state = 0; a_nsh = -1; a_order = 1; rot_dirty = 1;
rt_hin = rt_hout = rt_lp = 0;
p_order = p_method = p_maxre = p_diffm = p_trunc = p_pre = -1;
p_rot = p_rpy = p_yaw = p_pitch = p_roll = p_fy = p_fp = p_fr = -1000;

function abin_prep(fs)
