);

function gknob(kx, ky, kr, v, ctr, hov, nm, vs, dim) local(cx, cy, r, a0, a1, sa, ca, px0, py0, al) (
  cx = gsx(kx); cy = gsy(ky); r = kr * G_SC;
  al = dim ? 0.66 : 1;
  a0 = -$pi * 0.75; a1 = $pi * 0.75;
  gfx_set(0.02, 0.02, 0.03, 0.5 * al);
  gfx_circle(cx, cy, r + 3 * G_SC, 1, 1);
  gfx_set(0.11, 0.12, 0.13, 1);
  gfx_circle(cx, cy, r - 5 * G_SC, 1, 1);
  gfx_set(0.20, 0.21, 0.23, 1);
  gfx_circle(cx, cy, r - 7 * G_SC, 1, 1);
  gfx_set(0.13, 0.14, 0.15, 1);
  gfx_circle(cx, cy + 1.2 * G_SC, r - 9 * G_SC, 1, 1);
  gann(cx, cy, r - 1.2 * G_SC, r + 1.2 * G_SC, a0, a1, 0.62, 0.66, 0.70, 0.35 * al);
  sa = a0 + (a1 - a0) * v;
  ca = a0 + (a1 - a0) * ctr;
  abs(sa - ca) > 0.001 ? (
    gann(cx, cy, r - 3.5 * G_SC, r + 3.5 * G_SC, min(ca, sa), max(ca, sa), G_ACR, G_ACG, G_ACB, 0.18 * al);
    gann(cx, cy, r - 1.5 * G_SC, r + 1.5 * G_SC, min(ca, sa), max(ca, sa), G_ACR, G_ACG, G_ACB, al);
