    gfrr(xx, yy, xx + ww, yy + hh, rr, 0.10, 0.11, 0.12, hov ? 0.95 : 0.8);
    gbord(xx, yy, xx + ww, yy + hh, rr, max(1, floor(G_SC + 0.5)), 0.62, 0.66, 0.70, hov ? 0.7 : 0.4);
    gtext(x + w * 0.5, y + h * 0.5, lb, 3, 0.85, 0.88, 0.90, hov ? 1 : 0.8, 1);
  );
);

function gauto(s, e) (
<?
max_sliders > 16 ? printf("slider_automate(2^(s-1), e);") : (
  printf("s == 1 ? slider_automate(in_order, e) :\n");
  printf("s == 2 ? slider_automate(ch_order, e) :\n");
  printf("s == 3 ? slider_automate(norm_type, e) :\n");
  printf("s == 4 ? slider_automate(dec_method, e) :\n");
  printf("s == 5 ? slider_automate(trunc_eq, e) :\n");
  printf("s == 6 ? slider_automate(hrir_pre, e) :\n");
  printf("s == 7 ? slider_automate(diff_match, e) :\n");
  printf("s == 8 ? slider_automate(max_re, e) :\n");
  printf("s == 9 ? slider_automate(rotation, e) :\n");
  printf("s == 10 ? slider_automate(use_rpy, e) :\n");
  printf("s == 11 ? slider_automate(yaw, e) :\n");
  printf("s == 12 ? slider_automate(pitch, e) :\n");
  printf("s == 13 ? slider_automate(roll, e) :\n");
  printf("s == 14 ? slider_automate(flipyaw, e) :\n");
  printf("s == 15 ? slider_automate(flippitch, e) :\n");
