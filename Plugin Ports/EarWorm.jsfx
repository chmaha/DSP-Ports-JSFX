);
?>
);

function gpanel(x, y, w, h, ttl) local(xx, yy, ww, hh, rr) (
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC); rr = max(2, floor(10 * G_SC));
  gfrr(xx, yy, xx + ww, yy + hh, rr, 0.105, 0.135, 0.165, 0.92);
  gbord(xx, yy, xx + ww, yy + hh, rr, max(1, floor(G_SC + 0.5)), 0.56, 0.64, 0.72, 0.45);
  gtext(x + w * 0.5, y + 16, ttl, 3, 0.86, 0.90, 0.94, 1, 1);
);

function gbox(x, y, w, h, s, hov, act) local(xx, yy, ww, hh, rr) (
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC); rr = max(2, floor(5 * G_SC));
  gfrr(xx, yy, xx + ww, yy + hh, rr, 0.06, 0.08, 0.10, 0.95);
  gbord(xx, yy, xx + ww, yy + hh, rr, max(1, floor(G_SC + 0.5)), act ? G_ACR : 0.56, act ? G_ACG : 0.64, act ? G_ACB : 0.72, act ? 0.95 : hov ? 0.75 : 0.4);
  gtext(x + w * 0.5, y + h * 0.5, s, 2, 0.92, 0.94, 0.96, 1, 1);
);

function gseg2(x, y, w, h, la, lb, cur, hov, dim) local(sw, i, xx, yy, ww, hh) (
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC);
  gfrr(xx, yy, xx + ww, yy + hh, floor(h * 0.5 * G_SC), 0.06, 0.08, 0.10, 0.9);
  gbord(xx, yy, xx + ww, yy + hh, floor(h * 0.5 * G_SC), max(1, floor(G_SC + 0.5)), 0.56, 0.64, 0.72, 0.4);
  sw = w / 2;
  i = 0;
  loop(2,
    i === cur ? (
      xx = floor(gsx(x + i * sw + 3)); yy = floor(gsy(y + 3)); ww = ceil((sw - 6) * G_SC); hh = ceil((h - 6) * G_SC);
      gfrr(xx, yy, xx + ww, yy + hh, floor((h - 6) * 0.5 * G_SC), G_ACR, G_ACG, G_ACB, (hov === i ? 1 : 0.9) * (dim ? 0.6 : 1));
      gtext(x + i * sw + sw * 0.5, y + h * 0.5, i ? lb : la, 3, 0.10, 0.04, 0.10, 1, 1);
    ) : (
      gtext(x + i * sw + sw * 0.5, y + h * 0.5, i ? lb : la, 3, 0.85, 0.88, 0.90, hov === i ? 1 : 0.75, 1);
    );
    i += 1;
  );
);

function gtip_text(id) (
  id === 1 ? strcpy(#g_tip, "Ambisonic order of the input stream") :
  id === 2 ? strcpy(#g_tip, "LS: least squares; LS-DIFF: with diffuse-field EQ; SPR: spatial resampling; TA: time alignment; MAGLS: magnitude LS") :
  id === 3 ? strcpy(#g_tip, "Max-rE weighting: smoother, less sharp sources at low orders") :
  id === 4 ? strcpy(#g_tip, "Diffuse covariance matching: restores the binaural coherence of a diffuse field") :
  id === 5 ? strcpy(#g_tip, "Truncation EQ: compensates the high-frequency roll-off of low orders (LS only, not with phase pre-processing)") :
  id === 6 ? strcpy(#g_tip, "Input channel order (FuMa only at first order)") :
  id === 7 ? strcpy(#g_tip, "Input normalisation (SN3D for AmbiX)") :
  id === 8 ? strcpy(#g_tip, "HRTF pre-processing before the decoder is designed") :
  id === 9 ? strcpy(#g_tip, "Rotate the scene (head tracking)") :
  id === 10 ? strcpy(#g_tip, "Rotation order: yaw-pitch-roll or roll-pitch-yaw") :
  id === 11 ? strcpy(#g_tip, "Rotation angle: drag, wheel, Ctrl = fine, double-click to reset") :
  id === 12 ? strcpy(#g_tip, "Invert this rotation axis") : strcpy(#g_tip, "");
  #g_tip;
);

G_ACR = 0.50; G_ACG = 0.86; G_ACB = 0.46;


@slider
last_srate != srate ? (
  last_srate = srate;
  data_ok ? ( ready = 0; abin_prep(srate); );
);
pdc_delay = 13 * HOP; pdc_bot_ch = 0; pdc_top_ch = 2;
sync();

@block
sync();
ready && d_state ? (
  d_t0 = time_precise();
  design_step();
  while (d_state && time_precise() - d_t0 < 0.003) ( design_step(); );
  have_dec && rotation >= 0.5 && rot_dirty ? rot_update();
);

@sample
ready && have_dec ? (
  si = 0;
  loop(a_nsh, XT[si * HOP + pos] = spl(si); si += 1;);
  spl0 = YT[pos]; spl1 = YT[HOP + pos];
  pos += 1;
  pos >= HOP ? ( abin_frame(); pos = 0; );
) : (
  spl0 = spl1 = 0;
);

@gfx 1060 520
G_NOW = time_precise();
G_WHEEL = mouse_wheel; mouse_wheel = 0;
G_SC = max(0.45, min(gfx_w / 1060, gfx_h / 520));
G_OX = floor((gfx_w - 1060 * G_SC) * 0.5);
G_SC !== G_FSC ? (
  G_FSC = G_SC;
  gfx_setfont(1, "Arial", 14 * G_SC, 'b');
  gfx_setfont(2, "Arial", 13 * G_SC);
  gfx_setfont(3, "Arial", 12 * G_SC, 'b');
  gfx_setfont(4, "Arial", 12 * G_SC);
  gfx_setfont(5, "Arial", 15 * G_SC, 'b');
  gfx_setfont(6, "Arial", 24 * G_SC, 'b');
  gfx_setfont(7, "Arial", 11 * G_SC, 'b');
);
G_GH = max(1, gfx_h);
(gfx_w !== G_CW0 || gfx_h !== G_CH0 || G_SC !== G_CS0) ? (
  G_CW0 = gfx_w; G_CH0 = gfx_h; G_CS0 = G_SC;
  G_DST = gfx_dest;
  gfx_setimgdim(22, gfx_w, gfx_h);
  gfx_dest = 22;
  gfx_gradrect(0, 0, gfx_w, gfx_h, 0.13, 0.17, 0.21, 1, 0, 0, 0, 0, -0.07 / G_GH, -0.09 / G_GH, -0.11 / G_GH, 0);
  gfx_dest = G_DST;
);
gfx_x = 0; gfx_y = 0; gfx_a = 1; gfx_mode = 0;
gfx_blit(22, 1, 0);

G_MD = mouse_cap & 1;
G_PRESS = G_MD && !G_LMD;
G_REL = !G_MD && G_LMD;
G_MX = (mouse_x - G_OX) / G_SC; G_MY = mouse_y / G_SC;
G_DCLK = G_PRESS && G_NOW - G_LCLK < 0.3 && abs(G_MX - G_LCX) < 4 && abs(G_MY - G_LCY) < 4;
G_PRESS ? ( G_LCLK = G_DCLK ? 0 : G_NOW; G_LCX = G_MX; G_LCY = G_MY; );

gtext(24, 28, "EAR WORM", 6, 0.95, 0.96, 0.97, 1, 0);
gfx_setfont(6); gfx_measurestr("EAR WORM ", G_TW, G_TH);
gtext(24 + G_TW / G_SC, 29, "Ambisonic Binaural Decoder", 5, G_ACR, G_ACG, G_ACB, 1, 0);
gtext(1046, 28, "based on SPARTA AmbiBIN by Leo McCormack", 4, 0.62, 0.68, 0.74, 1, 2);

G_ORD = floor(in_order + 0.5) + 1;
G_METH = floor(dec_method + 0.5);
G_PRE = floor(hrir_pre + 0.5);
gpanel(14, 54, 380, 452, "DECODING");
gtext(28, 92, "Input order", 2, 0.86, 0.90, 0.94, 1, 0);
G_HOD = (G_MY >= 104 && G_MY <= 132 && G_MX >= 28 && G_MX < 378) ? floor((G_MX - 28) / 50) : -1;
G_HOD > 6 ? G_HOD = -1;
G_I = 0;
loop(7,
  sprintf(#g_tx, "%d", G_I + 1);
  gbtn(28 + G_I * 50, 104, 46, 28, #g_tx, G_ORD === G_I + 1, G_HOD === G_I);
  G_I += 1;
);
gtext(28, 158, "Method", 2, 0.86, 0.90, 0.94, 1, 0);
G_HME = (G_MY >= 170 && G_MY <= 198 && G_MX >= 28 && G_MX < 378) ? floor((G_MX - 28) / 70) : -1;
G_HME > 4 ? G_HME = -1;
G_I = 0;
loop(5,
  gbtn(28 + G_I * 70, 170, 66, 28, G_I === 0 ? "LS" : G_I === 1 ? "LS-DIFF" : G_I === 2 ? "SPR" : G_I === 3 ? "TA" : "MAGLS", G_METH === G_I, G_HME === G_I);
  G_I += 1;
);
G_HRE = G_MX >= 28 && G_MX <= 140 && G_MY >= 222 && G_MY <= 250;
G_HDM = G_MX >= 148 && G_MX <= 260 && G_MY >= 222 && G_MY <= 250;
G_HTQ = G_MX >= 268 && G_MX <= 380 && G_MY >= 222 && G_MY <= 250;
gbtn(28, 222, 112, 28, "MAX-RE", max_re >= 0.5, G_HRE);
gbtn(148, 222, 112, 28, "DIFFUSE COV.", diff_match >= 0.5, G_HDM);
G_TQA = G_METH === 0 && G_PRE !== 2 && G_PRE !== 3;
gbtn(268, 222, 112, 28, "TRUNC. EQ", trunc_eq >= 0.5 && G_TQA, G_HTQ);
!G_TQA ? gtext(268, 264, "Truncation EQ: LS only", 4, 0.62, 0.68, 0.74, 1, 0);
gfx_set(0.56, 0.64, 0.72, 0.3); gfx_rect(floor(gsx(28)), floor(gsy(286)), floor(352 * G_SC), max(1, floor(G_SC)));
G_DSTATE = d_state; G_DBAND = d_band;
G_DSTATE > 0 ? (
  G_PCT = G_DSTATE === 1 ? 0 : G_DSTATE === 2 ? 20 * d_spr / ND : G_DSTATE === 3 ? 20 + 60 * G_DBAND / NB : G_DSTATE === 4 ? 80 + 18 * G_DBAND / NB : 99;
  sprintf(#g_tx, "Designing decoder... %d%%", floor(G_PCT)); gtext(28, 308, #g_tx, 3, G_ACR, G_ACG, G_ACB, 1, 0);
  gfrr(floor(gsx(28)), floor(gsy(322)), floor(gsx(380)), floor(gsy(328)), 3, 0.06, 0.08, 0.10, 0.9);
  gfrr(floor(gsx(28)), floor(gsy(322)), floor(gsx(28 + 3.52 * G_PCT)), floor(gsy(328)), 3, G_ACR, G_ACG, G_ACB, 0.9);
) : (
  sprintf(#g_tx, "Decoder ready: order %d, %d channels", a_order, a_nsh); gtext(28, 308, have_dec ? #g_tx : "No decoder yet", 3, 0.76, 0.82, 0.88, 1, 0);
);
!data_ok ? gtext(204, 360, "HRTF data not found (Dependencies/EarWorm/hrtf.txt)", 3, 1, 0.45, 0.45, 1, 1);
gtext(28, 360, "MagLS is the recommended default. Lower orders", 4, 0.66, 0.72, 0.78, 1, 0);
gtext(28, 380, "benefit most from max-rE and truncation EQ.", 4, 0.66, 0.72, 0.78, 1, 0);
gtext(28, 410, "The previous decoder keeps playing while a new", 4, 0.66, 0.72, 0.78, 1, 0);
gtext(28, 430, "one is designed in the background.", 4, 0.66, 0.72, 0.78, 1, 0);

gpanel(406, 54, 388, 452, "INPUT FORMAT AND HRIRS");
gtext(420, 92, "Channel order", 2, 0.86, 0.90, 0.94, 1, 0);
G_HCO = (G_MX >= 420 && G_MX <= 780 && G_MY >= 104 && G_MY <= 132) ? floor((G_MX - 420) / 180) : -1;
gseg2(420, 104, 360, 28, "ACN", "FUMA", G_ORD === 1 && ch_order >= 0.5, G_HCO, 0);
gtext(420, 158, "Normalisation", 2, 0.86, 0.90, 0.94, 1, 0);
G_HNT = (G_MY >= 170 && G_MY <= 198 && G_MX >= 420 && G_MX < 780) ? floor((G_MX - 420) / 120) : -1;
G_NT = floor(norm_type + 0.5); G_ORD !== 1 && G_NT === 2 ? G_NT = 1;
gbtn(420, 170, 116, 28, "N3D", G_NT === 0, G_HNT === 0);
gbtn(540, 170, 116, 28, "SN3D", G_NT === 1, G_HNT === 1);
gbtn(660, 170, 116, 28, "FUMA", G_NT === 2, G_HNT === 2);
gtext(420, 224, "HRIR pre-processing", 2, 0.86, 0.90, 0.94, 1, 0);
G_HPP = (G_MY >= 236 && G_MY <= 264 && G_MX >= 420 && G_MX < 780) ? floor((G_MX - 420) / 90) : -1;
G_HPP > 3 ? G_HPP = -1;
G_I = 0;
loop(4,
  gbtn(420 + G_I * 90, 236, 86, 28, G_I === 0 ? "OFF" : G_I === 1 ? "DIFF. EQ" : G_I === 2 ? "PHASE" : "EQ+PHASE", G_PRE === G_I, G_HPP === G_I);
  G_I += 1;
);
gfx_set(0.56, 0.64, 0.72, 0.3); gfx_rect(floor(gsx(420)), floor(gsy(286)), floor(360 * G_SC), max(1, floor(G_SC)));
gtext(420, 308, "KEMAR dummy head (Genelec Aural ID), 836 directions", 4, 0.76, 0.82, 0.88, 1, 0);
sprintf(#g_tx, "HRIR 48000 Hz, DAW %d Hz", srate); gtext(420, 328, #g_tx, 4, 0.76, 0.82, 0.88, 1, 0);
sprintf(#g_tx, "Needs %d input channels (ACN 0-%d)", (G_ORD + 1) * (G_ORD + 1), (G_ORD + 1) * (G_ORD + 1) - 1); gtext(420, 348, #g_tx, 4, 0.76, 0.82, 0.88, 1, 0);
sprintf(#g_tx, "Latency %d samples", pdc_delay); gtext(420, 368, #g_tx, 4, 0.76, 0.82, 0.88, 1, 0);
gtext(600, 452, "Encode with Sphere of Influence, rotate with", 4, 0.66, 0.72, 0.78, 1, 1);
gtext(600, 470, "Spin Doctor (or the rotation here), listen here.", 4, 0.66, 0.72, 0.78, 1, 1);

gpanel(806, 54, 240, 452, "ROTATION");
G_HRO = G_MX >= 820 && G_MX <= 916 && G_MY >= 84 && G_MY <= 112;
G_HOR = (G_MX >= 924 && G_MX <= 1032 && G_MY >= 84 && G_MY <= 112) ? floor((G_MX - 924) / 54) : -1;
gbtn(820, 84, 96, 28, "ENABLE", rotation >= 0.5, G_HRO);
gseg2(924, 84, 108, 28, "Y-P-R", "R-P-Y", use_rpy >= 0.5, G_HOR, rotation < 0.5);
G_HK = -1;
G_I = 0;
loop(3,
  G_KX = 926; G_KY = 176 + G_I * 104;
  (G_MX - G_KX) * (G_MX - G_KX) + (G_MY - G_KY) * (G_MY - G_KY) <= 34 * 34 ? G_HK = G_I;
  G_I += 1;
);
G_DRAG === 30 ? G_HK = G_DK;
G_I = 0;
loop(3,
  G_V = slider(11 + G_I);
  sprintf(#g_tx, "%.2f\xc2\xb0", G_V);
  gknob(900, 176 + G_I * 104, 26, (G_V + 180) / 360, 0.5, G_HK === G_I, G_I === 0 ? "YAW" : G_I === 1 ? "PITCH" : "ROLL", #g_tx, rotation < 0.5);
  G_I += 1;
);
G_HFL = (G_MX >= 966 && G_MX <= 1022) ? (abs(G_MY - 176) <= 12 ? 0 : abs(G_MY - 280) <= 12 ? 1 : abs(G_MY - 384) <= 12 ? 2 : -1) : -1;
G_I = 0;
loop(3,
  gbtn(966, 164 + G_I * 104, 56, 24, "FLIP", slider(14 + G_I) >= 0.5, G_HFL === G_I);
  G_I += 1;
);

G_PRESS ? (
  G_HOD >= 0 ? (
    in_order = G_HOD; gauto(1, 1);
    G_HOD > 0 ? ( ch_order >= 0.5 ? ( ch_order = 0; gauto(2, 1); ); norm_type >= 1.5 ? ( norm_type = 1; gauto(3, 1); ); );
  ) :
  G_HME >= 0 ? ( dec_method = G_HME; gauto(4, 1); ) :
  G_HRE ? ( max_re = max_re >= 0.5 ? 0 : 1; gauto(8, 1); ) :
  G_HDM ? ( diff_match = diff_match >= 0.5 ? 0 : 1; gauto(7, 1); ) :
  G_HTQ ? ( trunc_eq = trunc_eq >= 0.5 ? 0 : 1; gauto(5, 1); ) :
  G_HCO >= 0 ? ( (G_HCO === 0 || G_ORD === 1) ? ( ch_order = G_HCO; gauto(2, 1); ); ) :
  G_HNT >= 0 ? ( (G_HNT < 2 || G_ORD === 1) ? ( norm_type = G_HNT; gauto(3, 1); ); ) :
  G_HPP >= 0 ? ( hrir_pre = G_HPP; gauto(6, 1); ) :
  G_HRO ? ( rotation = rotation >= 0.5 ? 0 : 1; gauto(9, 1); ) :
  G_HOR >= 0 ? ( use_rpy = G_HOR; gauto(10, 1); ) :
  G_HFL >= 0 ? ( slider(14 + G_HFL) = slider(14 + G_HFL) >= 0.5 ? 0 : 1; gauto(14 + G_HFL, 1); ) :
  G_HK >= 0 ? (
    G_DCLK ? ( slider(11 + G_HK) = 0; gauto(11 + G_HK, 1); ) : ( G_DRAG = 30; G_DK = G_HK; G_DY = mouse_y; G_DV = slider(11 + G_HK); );
  );
);
G_DRAG === 30 && G_MD ? (
  G_V = gclamp(G_DV + (G_DY - mouse_y) * ((mouse_cap & 4) ? 0.1 : 1) / G_SC, -180, 180);
  G_V = floor(G_V * 100 + 0.5) / 100;
  G_V !== slider(11 + G_DK) ? ( slider(11 + G_DK) = G_V; gauto(11 + G_DK, 0); );
  mouse_cap |= 65536;
);
G_REL ? ( G_DRAG === 30 ? gauto(11 + G_DK, 1); G_DRAG = 0; );
G_WHEEL !== 0 && G_DRAG === 0 && G_HK >= 0 ? (
  slider(11 + G_HK) = gclamp(floor((slider(11 + G_HK) + (G_WHEEL > 0 ? 1 : -1) * ((mouse_cap & 4) ? 0.1 : 1)) * 100 + 0.5) / 100, -180, 180);
  gauto(11 + G_HK, 1);
);

G_TID = 0;
G_HOD >= 0 ? G_TID = 1 : G_HME >= 0 ? G_TID = 2 : G_HRE ? G_TID = 3 : G_HDM ? G_TID = 4 : G_HTQ ? G_TID = 5 :
G_HCO >= 0 ? G_TID = 6 : G_HNT >= 0 ? G_TID = 7 : G_HPP >= 0 ? G_TID = 8 : G_HRO ? G_TID = 9 : G_HOR >= 0 ? G_TID = 10 :
G_HK >= 0 ? G_TID = 11 : G_HFL >= 0 ? G_TID = 12;
(G_TID !== G_TLAST || G_MD || G_DRAG > 0 || G_WHEEL !== 0) ? ( G_TLAST = G_TID; G_TT0 = G_NOW; );
(G_TID > 0 && !G_MD && G_DRAG === 0 && G_NOW - G_TT0 >= 0.5) ? (
  gtip_text(G_TID);
  gfx_setfont(4);
  gfx_measurestr(#g_tip, G_TW, G_TH);
  G_TPW = G_TW + floor(16 * G_SC); G_TPH = G_TH + floor(10 * G_SC);
  G_TPX = mouse_x + floor(14 * G_SC); G_TPY = mouse_y + floor(20 * G_SC);
  G_TPX + G_TPW > gfx_w - 2 ? G_TPX = max(2, gfx_w - 2 - G_TPW);
  G_TPY + G_TPH > gfx_h - 2 ? G_TPY = max(2, mouse_y - floor(8 * G_SC) - G_TPH);
  gfrr(G_TPX + 2, G_TPY + 3, G_TPX + G_TPW + 2, G_TPY + G_TPH + 3, floor(5 * G_SC), 0, 0, 0, 0.35);
  gfrr(G_TPX, G_TPY, G_TPX + G_TPW, G_TPY + G_TPH, floor(5 * G_SC), 0.07, 0.09, 0.11, 0.97);
  gbord(G_TPX, G_TPY, G_TPX + G_TPW, G_TPY + G_TPH, floor(5 * G_SC), max(1, floor(G_SC + 0.5)), G_ACR, G_ACG, G_ACB, 0.55);
  gfx_set(0.93, 0.95, 0.96, 1);
  gfx_x = G_TPX + floor(8 * G_SC); gfx_y = G_TPY + floor(5 * G_SC);
  gfx_drawstr(#g_tip);
);
G_LMD = G_MD;

