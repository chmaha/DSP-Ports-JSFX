function rot_update() local(y, p, r, i, j, k, b, e, sr, si, m)
(
  y = flipyaw >= 0.5 ? -yaw : yaw; p = flippitch >= 0.5 ? -pitch : pitch; r = fliproll >= 0.5 ? -roll : roll;
  rot_euler(y * $pi / 180, p * $pi / 180, r * $pi / 180, use_rpy >= 0.5, RXY);
  memcpy(RXY, RXY + 36, 9);
