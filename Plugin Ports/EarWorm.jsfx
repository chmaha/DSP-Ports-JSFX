  loop(ND,
    WV[d] = (pre_proc === 1 || pre_proc === 3) ? GW[d] : 1 / ND;
    sh_real(d_order, HDIR[2 * d], HDIR[2 * d + 1], YTMP);
    i = 0; loop(d_nsh, YA[i * ND + d] = YTMP[i]; YWA[i * ND + d] = YTMP[i] * WV[d]; i += 1;);
    d += 1;
