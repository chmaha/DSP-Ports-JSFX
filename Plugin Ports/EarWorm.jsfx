  ready ? (
    chg = 0;
    floor(hrir_pre + 0.5) !== p_pre ? ( p_pre = floor(hrir_pre + 0.5); pre_proc = p_pre; apply_preproc(); chg = 1; );
    (c_order !== p_order || c_method !== p_method || c_maxre !== p_maxre || c_diffm !== p_diffm || c_trunc !== p_trunc) ? (
      p_order = c_order; p_method = c_method; p_maxre = c_maxre; p_diffm = c_diffm; p_trunc = c_trunc; chg = 1;
