  h3 = ((1 - z3) * c3) + (z3 * h3);
  h4 = ((1 - z4) * c4) + (z4 * h4);
  h5 = ((1 - z5) * c5) + (z5 * h5);
  h6 = ((1 - z6) * c6) + (z6 * h6);
  h7 = ((1 - z7) * c7) + (z7 * h7);
  ((((((-0.16879507899284363) * h0) + ((-0.7646797299385071) * h1)) + (((-0.1357632726430893) * h2) + (0.4335372745990753 * h3))) + (((-0.9420055150985718) * h4) + ((-1.218264102935791) * h5))) + (((-0.6342813968658447) * h6) + (0.16264066100120544 * h7))) + 0.1790270060300827;
);

function gru_get(m) instance(h0, h1, h2, h3, h4, h5, h6, h7) local(p) (
  p = cs_gru0 + m * 8;
  h0 = p[0]; h1 = p[1]; h2 = p[2]; h3 = p[3]; h4 = p[4]; h5 = p[5]; h6 = p[6]; h7 = p[7];
);
function gru_put(m) instance(h0, h1, h2, h3, h4, h5, h6, h7) local(p) (
  p = cs_gru0 + m * 8;
  p[0] = h0; p[1] = h1; p[2] = h2; p[3] = h3; p[4] = h4; p[5] = h5; p[6] = h6; p[7] = h7;
);
function gru_zero() instance(h0, h1, h2, h3, h4, h5, h6, h7) ( h0 = h1 = h2 = h3 = h4 = h5 = h6 = h7 = 0; );

cs_gru0 = 262200;

function cs_gru_init() (
  mla0.gru_zero(); loop(2048, mla0.gru0(0)); mla0.gru_put(0);
  mla1.gru_zero(); loop(2048, mla1.gru1(0)); mla1.gru_put(1);
  mla2.gru_zero(); loop(2048, mla2.gru2(0)); mla2.gru_put(2);
  mla3.gru_zero(); loop(2048, mla3.gru3(0)); mla3.gru_put(3);
  mla4.gru_zero(); loop(2048, mla4.gru4(0)); mla4.gru_put(4);
);

function ml_reset() (
  mla0.gru_get(0); mla1.gru_get(1); mla2.gru_get(2); mla3.gru_get(3); mla4.gru_get(4);
  mlb0.gru_get(0); mlb1.gru_get(1); mlb2.gru_get(2); mlb3.gru_get(3); mlb4.gru_get(4);
);

function ml_run_a(m, x) (
  m < 2 ? ( m < 1 ? mla0.gru0(x) : mla1.gru1(x) ) : ( m < 3 ? mla2.gru2(x) : ( m < 4 ? mla3.gru3(x) : mla4.gru4(x) ) );
);
function ml_run_b(m, x) (
  m < 2 ? ( m < 1 ? mlb0.gru0(x) : mlb1.gru1(x) ) : ( m < 3 ? mlb2.gru2(x) : ( m < 4 ? mlb3.gru3(x) : mlb4.gru4(x) ) );
);

function cs_model_idx() ( min(4, max(0, floor(5 * p_gain))); );

function ib_coefs() local(c1, bs0, as0, kk, a0) (
  c1 = 0.0000001;
  bs0 = c1 * 1000000;
  as0 = c1 * (10000 + 1000000);
  kk = 2 * cs_fs;
  a0 = (as0 * kk) + 1;
  ib_b0 = ((bs0 * kk) + 0) / a0;
  ib_b1 = (((-bs0) * kk) + 0) / a0;
  ib_a1 = (((-as0) * kk) + 1) / a0;
);
function su_coefs() local(r20, c13, as0, kk, a0) (
  r20 = 392000; c13 = 0.00000000082;
  as0 = c13 * r20;
  kk = 2 * cs_fs;
  a0 = (as0 * kk) + 1;
  su_b0 = ((0 * kk) + r20) / a0;
  su_b1 = (((-0) * kk) + r20) / a0;
  su_a1 = (((-as0) * kk) + 1) / a0;
);
function dc_coefs() local(n, nsq, invq, c1) (
  n = tan(($pi * 35) / cs_fs);
  nsq = n * n;
  invq = 1 / 0.70710678118654752440;
  c1 = 1 / ((1 + (invq * n)) + nsq);
  dc_b0 = c1; dc_b1 = c1 * -2; dc_b2 = c1;
  dc_a1 = (c1 * 2) * (nsq - 1);
  dc_a2 = c1 * ((1 - (invq * n)) + nsq);
);

function tone_prep() instance(z1, cur, tgt, cnt, nst) (
  z1 = 0; cur = tgt; cnt = 0; nst = cs_nst;
  this.tone_coefs(tgt);
);
function out_prep() instance(z1, cur, tgt, cnt, nst) (
  z1 = 0; cur = tgt; cnt = 0; nst = cs_nst;
  this.out_coefs(tgt);
);
function amp_prep() instance(z1, z2, cur, tgt, cnt, nst) (
  z1 = z2 = 0; cur = tgt; cnt = 0; nst = cs_nst;
  this.amp_coefs(tgt);
);

function gs_reset() (
  osa.os_clear(); osb.os_clear();
  ampa.amp_prep(); ampb.amp_prep();
  suma.z1 = sumb.z1 = 0;
  su_coefs();
);

function cs_prepare() (
  cs_fs = srate;
  cs_nst = floor(0.05 * cs_fs);
  pra.z3 = pra.z5 = pra.z16 = pra.av = pra.a6 = pra.ff1 = 0;
  prb.z3 = prb.z5 = prb.z16 = prb.av = prb.a6 = prb.ff1 = 0;
  cla.z9 = cla.z10 = clb.z9 = clb.z10 = 0;
  ffa.z4 = ffa.z6 = ffa.z11 = ffa.z12 = 0;
  ffb.z4 = ffb.z6 = ffb.z11 = ffb.z12 = 0;
  cl_imp();
  cs_pa_g = cs_ff_g = -1;
  ampa.tgt = ampb.tgt = 2000;
  gs_reset();
  ml_reset();
  cs_last_idx = cs_model_idx();
  ib_coefs(); iba.z1 = ibb.z1 = 0;
  tna.tone_prep(); tnb.tone_prep();
  ota.out_prep(); otb.out_prep();
  cs_ml_prev = p_mode >= 0.5;
  cs_mono_prev = p_mono >= 0.5;
  dc_coefs(); dca.lv1 = dca.lv2 = dcb.lv1 = dcb.lv2 = 0;
  cs_prev_on = p_byp < 0.5;
  cs_bpos = 0;
);

function cs_block() local(on, ml, g) (
  on = p_byp < 0.5;
  cs_skip = !on && !cs_prev_on;
  !cs_skip ? (
    cs_fade_byp = on != cs_prev_on;
    cs_byp_in = on;
    cs_prev_on = on;
    cs_mono = p_mono >= 0.5;
    cs_mono !== cs_mono_prev ? (
      gs_reset();
      ml_reset();
      cs_last_idx = cs_model_idx();
      iba.z1 = ibb.z1 = 0;
      tna.tone_prep(); tnb.tone_prep();
      ota.out_prep(); otb.out_prep();
      cs_mono_prev = cs_mono;
    );
    ml = p_mode >= 0.5;
    cs_fade_mode = ml != cs_ml_prev;
    cs_new_ml = ml;
    cs_run_t = cs_fade_mode || !ml;
    cs_run_n = cs_fade_mode || ml;
    cs_ml_prev = ml;
    g = p_gain;
    cs_run_t ? (
      g !== cs_pa_g ? ( pa_imp(g); cs_pa_g = g; );
      g !== cs_ff_g ? ( ff_imp(g); cs_ff_g = g; );
      ampa.sm_mul_set(max(2000, min(102000, ((1 - g) * 100000) + 2000)));
      !cs_mono ? ampb.sm_mul_set(max(2000, min(102000, ((1 - g) * 100000) + 2000)));
    );
    cs_run_n ? (
      cs_ml_new = cs_model_idx();
      cs_ml_old = cs_last_idx;
      cs_fade_ml = cs_ml_new != cs_ml_old;
      cs_last_idx = cs_ml_new;
    );
    tna.sm_lin_set(max(0, min(1, p_treble)));
    ota.sm_mul_set(max(0.00001, min(1, p_level)));
    !cs_mono ? (
      tnb.sm_lin_set(max(0, min(1, p_treble)));
      otb.sm_mul_set(max(0.00001, min(1, p_level)));
    );
  );
  cs_rn = 0; cs_ro = 1;
);

function cs_block_end() (
  dca.dc_snap(); dcb.dc_snap();
);

function chain_a(x) local(y, x2, yt, yn, ya, yb, f1, f2, c0, c1) (
  y = iba.iir1_fixed(x * 0.5);
  y = max(-4.5, min(4.5, y));
  cs_run_t ? (
    x2 = y;
    yt = pra.pre_tick(y); f1 = pra.ff1;
    ampa.cnt > 0 ? ampa.amp_coefs(ampa.sm_mul_next());
    yt = ampa.iir2(yt);
    yt = max(-4.5, min(4.5, yt));
    osa.os_up(yt);
    c0 = cla.clip_tick(osa.e0);
    c1 = cla.clip_tick(osa.e1);
    yt = osa.os_down(c0, c1);
    f2 = ffa.ff2_tick(x2);
    yt = (yt + f1) + f2;
    yt = suma.sum_tick(yt);
    yt = max(-13.1, min(11.7, yt));
  );
  cs_run_n ? (
    cs_fade_ml ? (
      ya = ml_run_a(cs_ml_old, y);
      yb = ml_run_a(cs_ml_new, y);
      yn = (ya * cs_ro) + (cs_rn * yb);
    ) : (
      yn = ml_run_a(cs_ml_new, y);
    );
  );
  cs_fade_mode ? (
    y = cs_new_ml ? (yn * cs_rn) + (cs_ro * yt) : (yt * cs_rn) + (cs_ro * yn);
  ) : (
    y = cs_run_n ? yn : yt;
  );
  tna.cnt > 0 ? tna.tone_coefs(tna.sm_lin_next());
  y = tna.iir1(y);
  y = max(-13.1, min(11.7, -y));
  ota.cnt > 0 ? ota.out_coefs(ota.sm_mul_next());
  ota.iir1(y);
);

function chain_b(x) local(y, x2, yt, yn, ya, yb, f1, f2, c0, c1) (
  y = ibb.iir1_fixed(x * 0.5);
  y = max(-4.5, min(4.5, y));
  cs_run_t ? (
    x2 = y;
    yt = prb.pre_tick(y); f1 = prb.ff1;
    ampb.cnt > 0 ? ampb.amp_coefs(ampb.sm_mul_next());
    yt = ampb.iir2(yt);
    yt = max(-4.5, min(4.5, yt));
    osb.os_up(yt);
    c0 = clb.clip_tick(osb.e0);
    c1 = clb.clip_tick(osb.e1);
    yt = osb.os_down(c0, c1);
    f2 = ffb.ff2_tick(x2);
    yt = (yt + f1) + f2;
    yt = sumb.sum_tick(yt);
    yt = max(-13.1, min(11.7, yt));
  );
  cs_run_n ? (
    cs_fade_ml ? (
      ya = ml_run_b(cs_ml_old, y);
      yb = ml_run_b(cs_ml_new, y);
      yn = (ya * cs_ro) + (cs_rn * yb);
    ) : (
      yn = ml_run_b(cs_ml_new, y);
    );
  );
  cs_fade_mode ? (
    y = cs_new_ml ? (yn * cs_rn) + (cs_ro * yt) : (yt * cs_rn) + (cs_ro * yn);
  ) : (
    y = cs_run_n ? yn : yt;
  );
  tnb.cnt > 0 ? tnb.tone_coefs(tnb.sm_lin_next());
  y = tnb.iir1(y);
  y = max(-13.1, min(11.7, -y));
  otb.cnt > 0 ? otb.out_coefs(otb.sm_mul_next());
  otb.iir1(y);
);

tna.tgt = tnb.tgt = 0.287394;
ota.tgt = otb.tgt = 1;
cs_lut_init();
cs_gru_init();
cs_prepare();
last_srate = srate;

G_W = 600;
G_H = 392;

function gsx(x) ( G_OX + x * G_SC; );
function gsy(y) ( y * G_SC; );

function grspan(qx0, qy0, qx1, qy1, qrad, yc) local(dy, ins) (
  dy = yc < qy0 + qrad ? qy0 + qrad - yc : yc > qy1 - qrad ? yc - (qy1 - qrad) : 0;
  G_RC = max(0, min(1, qrad - dy + 0.5));
  dy = min(qrad, dy);
  ins = qrad - sqrt(max(0, qrad * qrad - dy * dy));
  G_RL = qx0 + ins; G_RR = qx1 - ins;
);

function gspan(lx, rx, j, a) local(lc, rc) (
  lc = ceil(lx); rc = floor(rx);
  rc >= lc ? (
    gfx_a = a; rc > lc ? gfx_rect(lc, j, rc - lc, 1);
    lc - lx > 0 ? ( gfx_a = a * (lc - lx); gfx_rect(lc - 1, j, 1, 1); );
    rx - rc > 0 ? ( gfx_a = a * (rx - rc); gfx_rect(rc, j, 1, 1); );
  ) : rx > lx ? ( gfx_a = a * (rx - lx); gfx_rect(floor(lx), j, 1, 1); );
);

function gfrr(qx0, qy0, qx1, qy1, qrad, cr, cg, cb, a0) local(j) (
  qx0 = floor(qx0 + 0.5); qy0 = floor(qy0 + 0.5); qx1 = floor(qx1 + 0.5); qy1 = floor(qy1 + 0.5);
  qrad = max(0, min(qrad, min(qy1 - qy0, qx1 - qx0) * 0.5));
  gfx_set(cr, cg, cb, a0);
  j = qy0;
  loop(qy1 - qy0,
    grspan(qx0, qy0, qx1, qy1, qrad, j + 0.5);
    G_RC > 0 ? gspan(G_RL, G_RR, j, a0 * G_RC);
    j += 1;
  );
  gfx_a = 1;
);

function gbord(qx0, qy0, qx1, qy1, qrad, t, cr, cg, cb, a0) local(j, ol, orr, oc, il, ir, ic) (
  qx0 = floor(qx0 + 0.5); qy0 = floor(qy0 + 0.5); qx1 = floor(qx1 + 0.5); qy1 = floor(qy1 + 0.5);
  qrad = max(0, min(qrad, min(qy1 - qy0, qx1 - qx0) * 0.5));
  gfx_set(cr, cg, cb, a0);
  j = qy0;
  loop(qy1 - qy0,
    grspan(qx0, qy0, qx1, qy1, qrad, j + 0.5); ol = G_RL; orr = G_RR; oc = G_RC;
    (j + 0.5 > qy0 + t && j + 0.5 < qy1 - t) ? (
      grspan(qx0 + t, qy0 + t, qx1 - t, qy1 - t, max(0, qrad - t), j + 0.5); il = G_RL; ir = G_RR; ic = G_RC;
    ) : ( ic = 0; );
    oc > 0 ? (
      ic <= 0 ? gspan(ol, orr, j, a0 * oc) : (
        gspan(ol, il, j, a0 * oc);
        gspan(ir, orr, j, a0 * oc);
        oc - ic > 0.004 ? gspan(il, ir, j, a0 * (oc - ic));
      );
    );
    j += 1;
  );
  gfx_a = 1;
);

function gbar(x0, y0, x1, y1, w) local(dx, dy, ll, hw, bx0, by0, bx1, by1, px, py, qx, qy, t, ex, ey, d, cv, cr, cg, cb, ca) (
  cr = gfx_r; cg = gfx_g; cb = gfx_b; ca = gfx_a;
  dx = x1 - x0; dy = y1 - y0; ll = max(0.000001, dx * dx + dy * dy);
  hw = w * 0.5;
  bx0 = floor(min(x0, x1) - hw - 1); bx1 = ceil(max(x0, x1) + hw + 1);
  by0 = floor(min(y0, y1) - hw - 1); by1 = ceil(max(y0, y1) + hw + 1);
  py = by0;
  while (py <= by1) (
    px = bx0;
    while (px <= bx1) (
      qx = px + 0.5; qy = py + 0.5;
      t = max(0, min(1, ((qx - x0) * dx + (qy - y0) * dy) / ll));
      ex = qx - (x0 + t * dx); ey = qy - (y0 + t * dy);
      d = sqrt(ex * ex + ey * ey);
      cv = min(1, hw - d + 0.5);
      cv > 0 ? ( gfx_set(cr, cg, cb, ca * cv); gfx_rect(px, py, 1, 1); );
      px += 1;
    );
    py += 1;
  );
  gfx_set(cr, cg, cb, ca);
);

function gauto(s, e) (
<?
max_sliders > 6 ? printf("slider_automate(2^(s-1), e);") : (
  printf("s == 1 ? slider_automate(p_gain, e) : s == 2 ? slider_automate(p_treble, e) : s == 3 ? slider_automate(p_level, e) :\n");
  printf("s == 4 ? slider_automate(p_mode, e) : s == 5 ? slider_automate(p_byp, e) : s == 6 ? slider_automate(p_mono, e) : 0;");
);
?>
);

function gtext(x, y, s, fnt, r, g, b, a, ctr) local(tw, th) (
  gfx_setfont(fnt);
  gfx_set(r, g, b, a);
  gfx_measurestr(s, tw, th);
  gfx_x = ctr === 1 ? gsx(x) - tw * 0.5 : ctr === 2 ? gsx(x) - tw : gsx(x);
  gfx_y = gsy(y) - th * 0.5;
  gfx_drawstr(s);
);

function ghash(j) local(v) ( v = sin(j * 12.9898) * 43758.5453; v - floor(v); );

function gplate(x0, y0, x1, y1, rad) local(qx0, qy0, qx1, qy1, qr, j, t, sh, br, gr, gb, nz) (
  qx0 = floor(gsx(x0) + 0.5); qy0 = floor(gsy(y0) + 0.5); qx1 = floor(gsx(x1) + 0.5); qy1 = floor(gsy(y1) + 0.5);
  qr = floor(rad * G_SC + 0.5);
  j = qy0;
  loop(qy1 - qy0,
    t = (j + 0.5 - qy0) / (qy1 - qy0);
    sh = 0.07 * exp(-sqr((t - 0.22) / 0.13)) + 0.03 * exp(-sqr((t - 0.78) / 0.2));
    nz = (ghash(floor((j - qy0) / max(1, floor(G_SC + 0.5)))) - 0.5) * 0.035;
    br = min(1, 0.86 - 0.13 * t + sh + nz);
    gr = min(1, 0.70 - 0.13 * t + sh * 0.9 + nz * 0.9);
    gb = min(1, 0.34 - 0.10 * t + sh * 0.5 + nz * 0.5);
    gfx_set(br, gr, gb, 1);
    grspan(qx0, qy0, qx1, qy1, qr, j + 0.5);
    G_RC > 0 ? gspan(G_RL, G_RR, j, G_RC);
    j += 1;
  );
  gfx_a = 1;
  gbord(qx0, qy0, qx1, qy1, qr, max(1, floor(2 * G_SC + 0.5)), 0.47, 0.34, 0.12, 1);
  gbord(qx0 + floor(2 * G_SC + 0.5), qy0 + floor(2 * G_SC + 0.5), qx1 - floor(2 * G_SC + 0.5), qy1 - floor(2 * G_SC + 0.5), max(0, qr - floor(2 * G_SC + 0.5)), max(1, floor(G_SC + 0.5)), 1, 0.93, 0.70, 0.55);
);

function gscrew(x, y) local(cx, cy, r) (
  cx = gsx(x); cy = gsy(y); r = 7 * G_SC;
  gfx_set(0.42, 0.31, 0.11, 1); gfx_circle(cx, cy, r, 1, 1);
  gfx_set(0.80, 0.67, 0.38, 1); gfx_circle(cx, cy, r - 1.6 * G_SC, 1, 1);
  gfx_set(0.93, 0.83, 0.56, 1); gfx_circle(cx - 1.2 * G_SC, cy - 1.2 * G_SC, r * 0.4, 1, 1);
  gfx_set(0.38, 0.27, 0.09, 1);
  gbar(cx - r * 0.62, cy + r * 0.3, cx + r * 0.62, cy - r * 0.3, max(1.2, 1.7 * G_SC));
);

function gknob(kx, ky, kr, v, hov) local(cx, cy, r, a0, a1, sa, i, ta, ri, ro) (
  cx = gsx(kx); cy = gsy(ky); r = kr * G_SC;
  a0 = -$pi * 0.75; a1 = $pi * 0.75;
  i = 0;
  loop(11,
    ta = a0 + (a1 - a0) * (i / 10);
    ri = r + 6 * G_SC; ro = r + ((i === 0 || i === 5 || i === 10) ? 14 : 11) * G_SC;
    gfx_set(0.30, 0.20, 0.06, 0.92);
    gbar(cx + sin(ta) * ri, cy - cos(ta) * ri, cx + sin(ta) * ro, cy - cos(ta) * ro, max(1.2, 1.8 * G_SC));
    i += 1;
  );
  gfx_set(0.30, 0.20, 0.05, 0.30); gfx_circle(cx + 2 * G_SC, cy + 4 * G_SC, r + 1 * G_SC, 1, 1);
  gfx_set(0.13, 0.11, 0.09, 1); gfx_circle(cx, cy, r, 1, 1);
  gfx_set(0.24, 0.21, 0.18, 1); gfx_circle(cx, cy - 1 * G_SC, r - 2 * G_SC, 1, 1);
  gfx_set(0.13, 0.11, 0.09, 1); gfx_circle(cx, cy, r - 5 * G_SC, 1, 1);
  hov ? gfx_set(0.99, 0.96, 0.88, 1) : gfx_set(0.95, 0.91, 0.82, 1);
  gfx_circle(cx, cy, r - 7 * G_SC, 1, 1);
  gfx_set(0.84, 0.79, 0.68, 1); gfx_circle(cx, cy + 1.5 * G_SC, r - 10 * G_SC, 1, 1);
  hov ? gfx_set(0.98, 0.95, 0.87, 1) : gfx_set(0.93, 0.89, 0.80, 1);
  gfx_circle(cx, cy, r - 11 * G_SC, 1, 1);
  gfx_set(1, 1, 1, 0.35); gfx_circle(cx - r * 0.22, cy - r * 0.26, r * 0.22, 1, 1);
  sa = a0 + (a1 - a0) * v;
  gfx_set(0.14, 0.10, 0.06, 1);
  gbar(cx + sin(sa) * (r * 0.18), cy - cos(sa) * (r * 0.18), cx + sin(sa) * (r - 2.5 * G_SC), cy - cos(sa) * (r - 2.5 * G_SC), max(2, 3.4 * G_SC));
);

function gseg(x, y, w, h, sel, l0, l1, hov) local(xx, yy, ww, hh, rr, hw, t) (
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC); rr = floor(6 * G_SC);
  t = max(1, floor(1.5 * G_SC + 0.5));
  gfrr(xx, yy, xx + ww, yy + hh, rr, 0.33, 0.23, 0.08, 1);
  hw = floor(ww * 0.5);
  sel === 0 ? gfrr(xx + t + 1, yy + t + 1, xx + hw - 1, yy + hh - t - 1, max(0, rr - t - 1), 0.97, 0.88, 0.62, 1)
            : gfrr(xx + hw + 1, yy + t + 1, xx + ww - t - 1, yy + hh - t - 1, max(0, rr - t - 1), 0.97, 0.88, 0.62, 1);
  gtext(x + w * 0.25, y + h * 0.5, l0, 3, sel === 0 ? 0.25 : 0.96, sel === 0 ? 0.16 : 0.88, sel === 0 ? 0.04 : 0.66, ((hov === 1) || (sel === 0)) ? 1 : 0.78, 1);
  gtext(x + w * 0.75, y + h * 0.5, l1, 3, sel === 1 ? 0.25 : 0.96, sel === 1 ? 0.16 : 0.88, sel === 1 ? 0.04 : 0.66, ((hov === 2) || (sel === 1)) ? 1 : 0.78, 1);
);

function gfoot(x, y, r, pressed, hov) local(cx, cy, rr, k, c, n) (
  cx = gsx(x); cy = gsy(y); rr = r * G_SC;
  gfx_set(0.30, 0.20, 0.05, 0.35); gfx_circle(cx + 2 * G_SC, cy + 4 * G_SC, rr + 9 * G_SC, 1, 1);
  gfx_set(0.20, 0.20, 0.21, 1); gfx_circle(cx, cy, rr + 9 * G_SC, 1, 1);
  gfx_set(0.55, 0.56, 0.58, 1); gfx_circle(cx, cy, rr + 7.5 * G_SC, 1, 1);
  gfx_set(0.30, 0.31, 0.33, 1); gfx_circle(cx, cy, rr + 3 * G_SC, 1, 1);
  n = 14; k = 0;
  loop(n,
    c = (pressed ? 0.50 : 0.58) + (pressed ? 0.28 : 0.38) * (k / n) * (k / n) + (hov ? 0.03 : 0);
    gfx_set(min(1, c), min(1, c + 0.005), min(1, c + 0.02), 1);
    gfx_circle(cx - (k / n) * rr * 0.22, cy - (k / n) * rr * 0.26, rr * (1 - 0.82 * (k / n)) - (pressed ? 1.5 * G_SC : 0), 1, 1);
    k += 1;
  );
);

function gled(x, y, on) local(cx, cy, r) (
  cx = gsx(x); cy = gsy(y); r = 6.5 * G_SC;
  on ? (
    gfx_set(1, 0.20, 0.12, 0.10); gfx_circle(cx, cy, r * 2.6, 1, 1);
    gfx_set(1, 0.22, 0.14, 0.16); gfx_circle(cx, cy, r * 1.8, 1, 1);
  );
  gfx_set(0.30, 0.22, 0.10, 1); gfx_circle(cx, cy, r + 2 * G_SC, 1, 1);
  on ? gfx_set(0.98, 0.16, 0.10, 1) : gfx_set(0.36, 0.09, 0.07, 1);
  gfx_circle(cx, cy, r, 1, 1);
  on ? gfx_set(1, 0.72, 0.62, 0.9) : gfx_set(0.62, 0.32, 0.28, 0.6);
  gfx_circle(cx - r * 0.3, cy - r * 0.32, r * 0.32, 1, 1);
);

function gknob_ui(k, kx, ky, kr) local(v, hv) (
  v = k === 1 ? p_gain : k === 2 ? p_treble : p_level;
  hv = (G_HOV === k) || (G_DRAG === k);
  gknob(kx, ky, kr, v, hv);
  sprintf(#gval, "%.1f", v * 10);
  gtext(kx, ky + kr + 16, #gval, 2, 0.26, 0.17, 0.05, 1, 1);
);

@slider

last_srate != srate ? (
  last_srate = srate;
  cs_prepare();
);

@sample

cs_bpos === 0 ? cs_block();
cs_skip ? (
  spl0 = dca.dc_tick(spl0);
  spl1 = dcb.dc_tick(spl1);
) : (
  cs_d0 = spl0; cs_d1 = spl1;
  cs_mono ? (
    cs_y0 = chain_a((cs_d0 + cs_d1) * 0.5);
    cs_y1 = cs_y0;
  ) : (
    cs_y0 = chain_a(cs_d0);
    cs_y1 = chain_b(cs_d1);
  );
  cs_fade_byp ? (
    cs_byp_in ? (
      cs_y0 = (cs_y0 * cs_rn) + (cs_ro * cs_d0);
      cs_y1 = (cs_y1 * cs_rn) + (cs_ro * cs_d1);
    ) : (
      cs_y0 = (cs_y0 * cs_ro) + (cs_rn * cs_d0);
      cs_y1 = (cs_y1 * cs_ro) + (cs_rn * cs_d1);
    );
  );
  spl0 = dca.dc_tick(cs_y0);
  spl1 = dcb.dc_tick(cs_y1);
);
cs_rn += CS_RINC;
cs_ro += -CS_RINC;
cs_bpos += 1;
cs_bpos >= CS_BS ? (
  cs_block_end();
  cs_bpos = 0;
);

@gfx 600 392

G_SC = max(0.5, min(gfx_w / G_W, gfx_h / G_H));
G_OX = floor((gfx_w - G_W * G_SC) * 0.5);
gfx_setfont(1, "Arial", 13 * G_SC);
gfx_setfont(2, "Arial", 14 * G_SC, 'b');
gfx_setfont(3, "Arial", 12 * G_SC, 'b');
gfx_setfont(4, "Georgia", 38 * G_SC, 'bi');
gfx_setfont(5, "Arial", 12 * G_SC, 'b');

G_MD = mouse_cap & 1;
G_WH = mouse_wheel; mouse_wheel = 0;
G_DOWN = G_MD && !G_LMD;
G_UP = !G_MD && G_LMD;
G_MX = (mouse_x - G_OX) / G_SC;
G_MY = mouse_y / G_SC;
G_NOW = time_precise();

G_HOV = 0;
sqr(G_MX - 150) + sqr(G_MY - 96) <= sqr(54) ? G_HOV = 1;
sqr(G_MX - 300) + sqr(G_MY - 96) <= sqr(54) ? G_HOV = 2;
sqr(G_MX - 450) + sqr(G_MY - 96) <= sqr(54) ? G_HOV = 3;
(G_MX >= 52 && G_MX <= 200 && G_MY >= 262 && G_MY <= 292) ? G_HOV = (G_MX < 126 ? 4 : 5);
(G_MX >= 400 && G_MX <= 548 && G_MY >= 262 && G_MY <= 292) ? G_HOV = (G_MX < 474 ? 6 : 7);
(sqr(G_MX - 300) + sqr(G_MY - 294) <= sqr(36)) || (sqr(G_MX - 300) + sqr(G_MY - 243) <= sqr(12)) ? G_HOV = 8;

G_DOWN ? (
  G_HOV >= 1 && G_HOV <= 3 ? (
    (G_HOV === G_LCK) && (G_NOW - G_LCT < 0.3) ? (
      G_HOV === 1 ? p_gain = 0.5 : G_HOV === 2 ? p_treble = 0.5 : p_level = 0.5;
      gauto(G_HOV, 1);
      G_LCK = 0;
    ) : (
      G_DRAG = G_HOV; G_DY0 = mouse_y;
      G_V0 = G_HOV === 1 ? p_gain : G_HOV === 2 ? p_treble : p_level;
      G_LCK = G_HOV; G_LCT = G_NOW;
    );
  );
  G_HOV === 4 ? ( p_mode = 0; gauto(4, 1); );
  G_HOV === 5 ? ( p_mode = 1; gauto(4, 1); );
  G_HOV === 6 ? ( p_mono = 0; gauto(6, 1); );
  G_HOV === 7 ? ( p_mono = 1; gauto(6, 1); );
  G_HOV === 8 ? ( p_byp = p_byp >= 0.5 ? 0 : 1; gauto(5, 1); G_FOOT = 1; );
);

G_DRAG > 0 && G_MD ? (
  mouse_cap |= 65536;
  G_V = max(0, min(1, G_V0 + (G_DY0 - mouse_y) / (((mouse_cap & 8) ? 900 : 180) * G_SC)));
  G_DRAG === 1 ? p_gain = G_V : G_DRAG === 2 ? p_treble = G_V : p_level = G_V;
  gauto(G_DRAG, 0);
);
G_UP ? (
  G_DRAG > 0 ? gauto(G_DRAG, 1);
  G_DRAG = 0; G_FOOT = 0;
);
G_WH != 0 && G_HOV >= 1 && G_HOV <= 3 && G_DRAG === 0 ? (
  G_V = G_HOV === 1 ? p_gain : G_HOV === 2 ? p_treble : p_level;
  G_V = max(0, min(1, G_V + (G_WH / 120) * 0.02));
  G_HOV === 1 ? p_gain = G_V : G_HOV === 2 ? p_treble = G_V : p_level = G_V;
  gauto(G_HOV, 1);
);
G_LMD = G_MD;

gfx_set(0.105, 0.10, 0.095, 1);
gfx_rect(0, 0, gfx_w, gfx_h, 1);

gfx_set(0.02, 0.015, 0.01, 0.35);
gfrr(gsx(22), gsy(18), gsx(582), gsy(350), floor(20 * G_SC), 0.02, 0.015, 0.01, 0.45);
gplate(18, 12, 582, 346, 20);
gscrew(40, 34); gscrew(560, 34); gscrew(40, 324); gscrew(560, 324);

gtext(150, 26, "GAIN", 2, 0.26, 0.17, 0.05, 1, 1);
gtext(300, 26, "TREBLE", 2, 0.26, 0.17, 0.05, 1, 1);
gtext(450, 26, "LEVEL", 2, 0.26, 0.17, 0.05, 1, 1);
gknob_ui(1, 150, 96, 40);
gknob_ui(2, 300, 96, 40);
gknob_ui(3, 450, 96, 40);

gtext(301, 192, "Gold Standard", 4, 0.98, 0.90, 0.66, 0.55, 1);
gtext(300, 191, "Gold Standard", 4, 0.27, 0.17, 0.04, 1, 1);
gtext(300, 220, "T R A N S P A R E N T    O V E R D R I V E", 5, 0.30, 0.20, 0.06, 1, 1);

gtext(126, 250, "MODE", 3, 0.26, 0.17, 0.05, 1, 1);
gseg(52, 262, 148, 30, p_mode >= 0.5 ? 1 : 0, "CIRCUIT", "NEURAL", G_HOV === 4 ? 1 : G_HOV === 5 ? 2 : 0);
gtext(474, 250, "INPUT", 3, 0.26, 0.17, 0.05, 1, 1);
gseg(400, 262, 148, 30, p_mono >= 0.5 ? 1 : 0, "STEREO", "MONO", G_HOV === 6 ? 1 : G_HOV === 7 ? 2 : 0);

gled(300, 243, p_byp < 0.5);
gfoot(300, 294, 25, G_FOOT && G_MD, G_HOV === 8);

gfrr(gsx(18), gsy(358), gsx(582), gsy(386), floor(6 * G_SC), 0.16, 0.155, 0.15, 1);
gbord(gsx(18), gsy(358), gsx(582), gsy(386), floor(6 * G_SC), max(1, floor(G_SC + 0.5)), 0.56, 0.52, 0.46, 0.5);
G_HID = G_DRAG > 0 ? G_DRAG : G_HOV;
G_HID === 1 ? sprintf(#ghint, "Gain %.1f%%: drive into the diode clipper (in Neural mode it also picks the network)", p_gain * 100);
G_HID === 2 ? sprintf(#ghint, "Treble %.1f%%: tone control after the clipper, darker to brighter", p_treble * 100);
G_HID === 3 ? sprintf(#ghint, "Level %.1f%%: output volume of the pedal", p_level * 100);
G_HID === 4 ? strcpy(#ghint, "Traditional: wave digital filter model of the pedal's circuit");
G_HID === 5 ? strcpy(#ghint, "Neural: small recurrent networks trained on the circuit model");
G_HID === 6 ? strcpy(#ghint, "Stereo: each channel runs through its own circuit");
G_HID === 7 ? strcpy(#ghint, "Mono: left and right summed into one circuit, output on both");
G_HID === 8 ? strcpy(#ghint, p_byp >= 0.5 ? "Footswitch: bypassed, click to engage" : "Footswitch: engaged, click to bypass");
G_HID === 0 ? strcpy(#ghint, "Drag or scroll the knobs (Shift for fine, double-click resets). Click the footswitch to bypass.");
gtext(30, 372, #ghint, 1, 0.80, 0.78, 0.74, 1, 0);
