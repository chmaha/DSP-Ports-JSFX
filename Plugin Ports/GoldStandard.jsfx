slider1:p_gain=0.5<0,1,0.001>-Gain
slider2:p_treble=0.5<0,1,0.001>-Treble
slider3:p_level=0.5<0,1,0.001>-Level
slider4:p_mode=0<0,1,1{Traditional,Neural}>-Mode
slider5:p_byp=0<0,1,1{Off,On}>-Bypass
slider6:p_mono=0<0,1,1{Off,On}>-Mono

in_pin:Left input
in_pin:Right input
out_pin:Left output
out_pin:Right output
options:no_meter

@init

ext_noinit = gfx_ext_retina = 1;
ext_nodenorm = 1;

CS_BS = 512;
CS_SNAP = 0.00000000999999993922529029;
CS_RINC = 1 / CS_BS;

cs_lut = 0;
CS_LUT_LO = 65530;
CS_LUT_HI = 196615;

function cs_wo_toms(x) local(pz, w, r, wp1, e, q, tq) (
  pz = x - 1;
  w = (0.5 + (0.5 * x)) + ((((0.0625 + (((-1 / 192) + (((-1 / 3072) + ((13 / 61440) * pz)) * pz)) * pz)) * pz) * pz));
  r = (x - w) - log(w);
  wp1 = w + 1;
  tq = (2 * wp1) * (wp1 + ((2 / 3) * r));
  e = ((r / wp1) * (tq - r)) / (tq - (2 * r));
  w = w * (1 + e);
  q = (((2 * w) * w) - (8 * w)) - 1;
  abs(q * (abs(r) ^ 4)) >= ((0.0000000000000002220446049250313080847263336181640625 * 72) * (abs(wp1) ^ 6)) ? (
    r = (x - w) - log(w);
    wp1 = w + 1;
    tq = (2 * wp1) * (wp1 + ((2 / 3) * r));
    e = ((r / wp1) * (tq - r)) / (tq - (2 * r));
    w = w * (1 + e);
  );
  w;
);

function cs_lut_init() local(i) (
  i = CS_LUT_LO;
  loop(CS_LUT_HI - CS_LUT_LO + 1,
    cs_lut[i] = cs_wo_toms(-1 + ((2 * i) / 262143));
    i += 1;
  );
);

function cs_omega4(x) local(y, xi, l, d, m, e2, k) (
  x < -3.34145955276862 ? (
    y = 0;
  ) : x < 8 ? (
    y = 0.6313183464296682 + (x * (0.3631952663804445 + (x * (0.04775931364975583 + (x * (-0.0013142931498778))))));
  ) : (
    e2 = 3; m = x * 0.125; k = 0;
    while ((m >= 2) && (k < 1100)) ( m *= 0.5; e2 += 1; k += 1; );
    y = x - (0.693147180559945 * ((floor((e2 + 1023) / 2) - 510) + (-2.213475204444817 + (m * (3.148297929334117 + (m * (-1.098865286222744 + (m * 0.1640425613334452))))))));
  );
  d = x - y;
  d = max(-126, 1.442695040888963 * d);
  xi = d < 0 ? ceil(d) : floor(d);
  l = d < 0 ? xi - 1 : xi;
  d = d - l;
  y - ((y - ((2 ^ l) * (1 + (d * (0.6931471805599453 + (d * (0.2274112777602189 + (d * 0.07944154167983575)))))))) / (y + 1));
);

function cs_flush(v) ( abs(v) <= CS_SNAP ? 0 : v; );

function sm_mul_set(v) instance(cur, tgt, cnt, stp, nst) (
  v !== tgt ? (
    nst <= 0 ? ( tgt = cur = v; cnt = 0; ) : (
      tgt = v; cnt = nst;
      stp = exp((log(abs(tgt)) - log(abs(cur))) / cnt);
    );
  );
);
function sm_mul_next() instance(cur, tgt, cnt, stp) (
  cnt > 0 ? ( cnt -= 1; cnt > 0 ? cur *= stp : cur = tgt; );
  cur;
);
function sm_lin_set(v) instance(cur, tgt, cnt, stp, nst) (
  v !== tgt ? (
    nst <= 0 ? ( tgt = cur = v; cnt = 0; ) : (
      tgt = v; cnt = nst;
      stp = (tgt - cur) / cnt;
    );
  );
);
function sm_lin_next() instance(cur, tgt, cnt, stp) (
  cnt > 0 ? ( cnt -= 1; cnt > 0 ? cur += stp : cur = tgt; );
  cur;
);

function tone_coefs(t) instance(b0, b1, a1) local(g1, g2, g3, g4, cc, wc, kk, bs0, bs1, as0, as1, a0, bu0, bu1, au1) (
  cc = 0.0000000039;
  g1 = 1 / 100000;
  g2 = 1 / (1800 + ((1 - t) * 10000));
  g3 = 1 / (4700 + (t * 10000));
  g4 = 1 / 100000;
  wc = g1 / cc;
  kk = wc / tan(wc / (2 * cs_fs));
  bs0 = cc * (g1 + g2);
  bs1 = g1 * (g2 + g3);
  as0 = cc * (g3 - g4);
  as1 = (-g4) * (g2 + g3);
  a0 = (as0 * kk) + as1;
  bu0 = ((bs0 * kk) + bs1) / a0;
  bu1 = (((-bs0) * kk) + bs1) / a0;
  au1 = (((-as0) * kk) + as1) / a0;
  a1 = 1 / au1;
  b0 = bu0 / au1;
  b1 = bu1 / au1;
);

function out_coefs(lv) instance(b0, b1, a1) local(r1, r2, cc, kk, bs0, as0, a0) (
  r1 = 560 + ((1 - lv) * 10000);
  r2 = (lv * 10000) + 1;
  cc = 0.0000047;
  bs0 = cc * r2;
  as0 = cc * (r1 + r2);
  kk = 2 * cs_fs;
  a0 = (as0 * kk) + 1;
  b0 = ((bs0 * kk) + 0) / a0;
  b1 = (((-bs0) * kk) + 0) / a0;
  a1 = (((-as0) * kk) + 1) / a0;
);

function amp_coefs(rb) instance(b0, b1, b2, a1, a2) local(c7, c8, r11, r12, as0, as1, as2, bs0, bs1, bs2, rad, wc, kk, ksq, a0) (
  c7 = 0.000000082; c8 = 0.00000000039; r11 = 15000; r12 = 422000;
  as0 = (((c7 * c8) * rb) * r11) * r12;
  as1 = ((c7 * rb) * r11) + ((c8 * r12) * (rb + r11));
  as2 = rb + r11;
  bs0 = as0;
  bs1 = ((c7 * r11) * r12) + as1;
  bs2 = r12 + as2;
  rad = (as1 * as1) - ((4 * as0) * as2);
  wc = rad >= 0 ? 0 : sqrt(-rad) / (2 * as0);
  kk = wc === 0 ? 2 * cs_fs : wc / tan(wc / (2 * cs_fs));
  ksq = kk * kk;
  a0 = ((as0 * ksq) + (as1 * kk)) + as2;
  a1 = (2 * (as2 - (as0 * ksq))) / a0;
  a2 = (((as0 * ksq) - (as1 * kk)) + as2) / a0;
  b0 = (((bs0 * ksq) + (bs1 * kk)) + bs2) / a0;
  b1 = (2 * (bs2 - (bs0 * ksq))) / a0;
  b2 = (((bs0 * ksq) - (bs1 * kk)) + bs2) / a0;
);

function iir1(x) instance(b0, b1, a1, z1) local(y) (
  y = z1 + (x * b0);
  z1 = (x * b1) - (y * a1);
  y;
);
function iir2(x) instance(b0, b1, b2, a1, a2, z1, z2) local(y) (
  y = z1 + (x * b0);
  z1 = (z2 + (x * b1)) - (y * a1);
  z2 = (x * b2) - (y * a2);
  y;
);
function iir1_fixed(x) instance(z1) local(y) (
  y = z1 + (x * ib_b0);
  z1 = (x * ib_b1) - (y * ib_a1);
  y;
);
function sum_tick(x) instance(z1) local(y) (
  y = z1 + (x * su_b0);
  z1 = (x * su_b1) - (y * su_a1);
  y;
);
function dc_tick(x) instance(lv1, lv2) local(y) (
  y = (x * dc_b0) + lv1;
  lv1 = ((x * dc_b1) - (y * dc_a1)) + lv2;
  lv2 = (x * dc_b2) - (y * dc_a2);
  y;
);
function dc_snap() instance(lv1, lv2) ( lv1 = cs_flush(lv1); lv2 = cs_flush(lv2); );

function pa_imp(g) local(c3r, c5r, c16r, c5g, c16g, p1g, p1r, vbr, s1r, s1g, p2g, p2r, s2r, s2g, p3g, p3r, s3r) (
  c3r = 1 / ((2 * 0.0000001) * cs_fs);
  c5r = 1 / ((2 * 0.000000068) * cs_fs);
  c16r = 1 / ((2 * 0.000001) * cs_fs);
  c5g = 1 / c5r; c16g = 1 / c16r;
  p1g = c5g + (1 / 10000); p1r = 1 / p1g; pa_p1 = c5g / p1g;
  vbr = g * 100000;
  s1r = p1r + vbr; s1g = 1 / s1r; pa_s1 = p1r / s1r;
  p2g = (1 / 15000) + c16g; p2r = 1 / p2g; pa_p2 = (1 / 15000) / p2g;
  s2r = p2r + 1500; s2g = 1 / s2r; pa_s2 = p2r / s2r;
  p3g = s1g + s2g; p3r = 1 / p3g; pa_p3 = s1g / p3g;
  s3r = p3r + c3r; pa_s3 = p3r / s3r;
);

function pre_tick(x) instance(z3, z5, z16, av, a6, ff1) local(bd1, bt1, p1b, s1b, bd2, bt2, p2b, s2b, bd3, bt3, p3b, s3b, i1b, vinb, xs3, b1, b2, xs1, c1, c2, d1, d2, y) (
  bd1 = 0 - z5; bt1 = 0 - (pa_p1 * bd1); p1b = 0 + bt1;
  s1b = 0 - (p1b + 0);
  bd2 = z16 - 0; bt2 = 0 - (pa_p2 * bd2); p2b = z16 + bt2;
  s2b = 0 - (p2b + 0);
  bd3 = s2b - s1b; bt3 = 0 - (pa_p3 * bd3); p3b = s2b + bt3;
  s3b = 0 - (p3b + z3);
  i1b = 0 - s3b;
  y = ((av + 0) * 0.5) + ((a6 + 0) * 0.5);
  vinb = (0 - i1b) + (2 * x);
  xs3 = 0 - vinb;
  b1 = p3b - (pa_s3 * ((xs3 + p3b) + z3));
  z3 = 0 - (xs3 + b1);
  b2 = b1 + bt3;
  xs1 = bd3 + b2;
  c1 = p1b - (pa_s1 * ((xs1 + p1b) + 0));
  av = 0 - (xs1 + c1);
  c2 = c1 + bt1;
  z5 = bd1 + c2;
  a6 = c2;
  d1 = p2b - (pa_s2 * ((b2 + p2b) + 0));
  d2 = d1 + bt2;
  ff1 = ((bd2 + d2) - 0) * (0.5 * (1 / 15000));
  z16 = d2;
  y;
);

function cl_imp() local(fs2, vr, c9r, c10r, s1r, s2r, s2g, s3r, s3g, p1g, p1r) (
  fs2 = cs_fs * 2;
  vr = 1 / 1000000000;
  c9r = 1 / ((2 * 0.000001) * fs2);
  c10r = 1 / ((2 * 0.000001) * fs2);
  s1r = vr + c9r; cl_s1 = vr / s1r;
  s2r = s1r + 1000; s2g = 1 / s2r; cl_s2 = s1r / s2r;
  s3r = c10r + 47000; s3g = 1 / s3r; cl_s3 = c10r / s3r;
  p1g = s2g + s3g; p1r = 1 / p1g; cl_p1 = s2g / p1g;
  cl_ris = p1r * 0.000015;
  cl_ovt = 1 / 0.02585;
  cl_risv = cl_ris * cl_ovt;
  cl_lrisv = log(cl_risv);
  cl_g10h = 0.5 * (1 / c10r);
);

function clip_tick(x) instance(z9, z10) local(i1b, s1b, s2b, s3b, bd, bt, a, lam, wi, w, idx, li, fr, b, b2, xs2, b1, c1, y) (
  i1b = 0 - x;
  s1b = 0 - (i1b + z9);
  s2b = 0 - (s1b + 0);
  s3b = 0 - (z10 + 0);
  bd = s3b - s2b; bt = 0 - (cl_p1 * bd);
  a = s3b + bt;
  lam = (0 < a) - (a < 0);
  wi = (cl_lrisv + ((lam * a) * cl_ovt)) + cl_risv;
  abs(wi) > 0.5 ? (
    w = cs_omega4(wi);
  ) : (
    idx = (131071.5 * wi) + 131071.5;
    li = floor(idx); fr = idx - li;
    w = cs_lut[li];
    w = w + (fr * (cs_lut[li + 1] - w));
  );
  b = a + ((2 * lam) * (cl_ris - (0.02585 * w)));
  b2 = b + bt;
  xs2 = bd + b2;
  b1 = s1b - (cl_s2 * ((xs2 + s1b) + 0));
  c1 = i1b - (cl_s1 * ((b1 + i1b) + z9));
  z9 = 0 - (b1 + c1);
  c1 = z10 - (cl_s3 * ((b2 + z10) + 0));
  y = (c1 - z10) * cl_g10h;
  z10 = c1;
  y;
);

function ff_imp(g) local(c4r, c6r, c11r, c12r, c4g, rvt, rvb, s1r, s1g, p1g, p1r, s2r, s3r, s3g, p2g, p2r, p3g, p3r, s4r, s4g, s5r, s5g, p4g, p4r, p5g, p5r, s6r, p6g, p6r, s7r) (
  c4r = 1 / ((2 * 0.000000068) * cs_fs);
  c6r = 1 / ((2 * 0.00000039) * cs_fs);
  c11r = 1 / ((2 * 0.0000000022) * cs_fs);
  c12r = 1 / ((2 * 0.000000027) * cs_fs);
  c4g = 1 / c4r;
  rvt = max(g * 100000, 1);
  rvb = max((1 - g) * 100000, 1);
  s1r = c12r + 12000; s1g = 1 / s1r; ff_s1 = c12r / s1r;
  p1g = s1g + (1 / 27000); p1r = 1 / p1g; ff_p1 = s1g / p1g;
  s2r = c11r + 22000; ff_s2 = c11r / s2r;
  s3r = s2r + 47000; s3g = 1 / s3r; ff_s3 = s2r / s3r;
  p2g = s3g + p1g; p2r = 1 / p2g; ff_p2 = s3g / p2g;
  p3g = p2g + (1 / rvb); p3r = 1 / p3g; ff_p3 = p2g / p3g;
  s4r = p3r + rvt; s4g = 1 / s4r; ff_s4 = p3r / s4r;
  s5r = c6r + 1000; s5g = 1 / s5r; ff_s5 = c6r / s5r;
  p4g = s4g + s5g; p4r = 1 / p4g; ff_p4 = s4g / p4g;
  p5g = p4g + (1 / 1500); p5r = 1 / p5g; ff_p5 = p4g / p5g;
  s6r = p5r + (1 / 1000000000); ff_s6 = p5r / s6r;
  p6g = (1 / 5100) + c4g; p6r = 1 / p6g; ff_p6 = (1 / 5100) / p6g;
  s7r = p6r + s6r; ff_s7 = p6r / s7r;
);

function ff2_tick(x) instance(z4, z6, z11, z12) local(s1b, bd1, bt1, p1b, s2b, s3b, bd2, bt2, p2b, bd3, bt3, p3b, s4b, s5b, bd4, bt4, p4b, bd5, bt5, p5b, s6b, bd6, bt6, p6b, s7b, vinb, x7, b1, c1, b2, d1, e1, g1, r16a) (
  s1b = 0 - (z12 + 0);
  bd1 = 0 - s1b; bt1 = 0 - (ff_p1 * bd1); p1b = 0 + bt1;
  s2b = 0 - (z11 + 0);
  s3b = 0 - (s2b + 0);
  bd2 = p1b - s3b; bt2 = 0 - (ff_p2 * bd2); p2b = p1b + bt2;
  bd3 = 0 - p2b; bt3 = 0 - (ff_p3 * bd3); p3b = 0 + bt3;
  s4b = 0 - (p3b + 0);
  s5b = 0 - (z6 + 0);
  bd4 = s5b - s4b; bt4 = 0 - (ff_p4 * bd4); p4b = s5b + bt4;
  bd5 = 0 - p4b; bt5 = 0 - (ff_p5 * bd5); p5b = 0 + bt5;
  s6b = 0 - (p5b + 0);
  bd6 = z4 - 0; bt6 = 0 - (ff_p6 * bd6); p6b = z4 + bt6;
  s7b = 0 - (p6b + s6b);
  vinb = (0 - (0 - s7b)) + (2 * x);
  x7 = 0 - vinb;
  b1 = p6b - (ff_s7 * ((x7 + p6b) + s6b));
  z4 = b1 + bt6;
  c1 = p5b - (ff_s6 * (((0 - (x7 + b1)) + p5b) + 0));
  b2 = c1 + bt5;
  b2 = (bd5 + b2) + bt4;
  d1 = p3b - (ff_s4 * (((bd4 + b2) + p3b) + 0));
  z6 = z6 - (ff_s5 * ((b2 + z6) + 0));
  d1 = d1 + bt3;
  d1 = (bd3 + d1) + bt2;
  e1 = s2b - (ff_s3 * (((bd2 + d1) + s2b) + 0));
  r16a = 0 - (((bd2 + d1)) + e1);
  g1 = z11 - (ff_s2 * ((e1 + z11) + 0));
  z11 = g1;
  d1 = d1 + bt1;
  z12 = z12 - (ff_s1 * (((bd1 + d1) + z12) + 0));
  (r16a - 0) * (0.5 * (1 / 47000));
);

function os_up(x) instance(s0, s1, s2, s3, s4, s5, s6, e0, e1) local(v, o) (
  v = x;
  o = (0.045728147624082692 * v) + s0; s0 = v - (0.045728147624082692 * o); v = o;
  o = (0.33250110957929974 * v) + s1; s1 = v - (0.33250110957929974 * o); v = o;
  o = (0.66320202004105133 * v) + s2; s2 = v - (0.66320202004105133 * o); v = o;
  o = (0.93385580308838401 * v) + s3; s3 = v - (0.93385580308838401 * o); v = o;
  e0 = v;
  v = x;
  o = (0.16808754441358362 * v) + s4; s4 = v - (0.16808754441358362 * o); v = o;
  o = (0.50448574772579069 * v) + s5; s5 = v - (0.50448574772579069 * o); v = o;
  o = (0.80378086620290357 * v) + s6; s6 = v - (0.80378086620290357 * o); v = o;
  e1 = v;
);
function os_down(x0, x1) instance(t0, t1, t2, t3, t4, t5, dly) local(v, o, r) (
  v = x0;
  o = (0.054217526478844993 * v) + t0; t0 = v - (0.054217526478844993 * o); v = o;
  o = (0.3830873308979566 * v) + t1; t1 = v - (0.3830873308979566 * o); v = o;
  o = (0.74872094746739482 * v) + t2; t2 = v - (0.74872094746739482 * o); v = o;
  r = v;
  v = x1;
  o = (0.19679797212217914 * v) + t3; t3 = v - (0.19679797212217914 * o); v = o;
  o = (0.57313641503021207 * v) + t4; t4 = v - (0.57313641503021207 * o); v = o;
  o = (0.91429371091299194 * v) + t5; t5 = v - (0.91429371091299194 * o); v = o;
  r = (dly + r) * 0.5;
  dly = v;
