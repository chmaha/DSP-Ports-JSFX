  q = ((r7 * ((((((0.04783935099840164 * h0) + (0.3461364507675171 * h1)) + (((-0.007049940060824156) * h2) + ((-0.5981517434120178) * h3))) + (((-0.36789670586586) * h4) + ((-1.787674903869629) * h5))) + ((0.611899197101593 * h6) + (0.6820011734962463 * h7))) + 0.14916960895061493)) + 0.09793771058320999) + (1.6917197704315186 * x); e = exp(-2 * abs(q)); c7 = (1 - e) / (1 + e); q < 0 ? c7 = -c7;
  h0 = ((1 - z0) * c0) + (z0 * h0);
