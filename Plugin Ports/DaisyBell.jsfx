function sam_chunk_load(src, st, m) local(en, j, k)
(
  en = min(st + 120, m - 1);
  en < m - 1 ? (
    j = en;
    while (j > st + 20 && src[j] != 32) ( j -= 1; );
    j > st + 20 ? (en = j + 1);
  );
  k = 0;
  loop(en - st, pin[k] = src[st + k]; k += 1; );
  pin[k] = 155;
  en;
);

function sam_chunks(m) local(st, en, ok)
(
  ok = 1; st = 0;
  while (st < m - 1) (
    en = sam_chunk_load(rc_out, st, m);
    memset(ph_str, 0, 256);
    !sam_parser1() ? (ok = 0; s_bad += st;);
    st = en;
  );
  ok;
);

function sam_phon(n) local(i, c)
(
  i = 0;
  loop(min(n, RC_CAP - 4),
    c = rc_in[i];
    c >= 97 && c <= 122 ? (c -= 32);
    c == 10 || c == 13 || c == 9 ? (c = 32);
    rc_out[i] = c; i += 1;
  );
  rc_out[i] = 155;
  i + 1;
);

function sam_begin(dst, cap, n) local(m)
(
  s_dst = dst; s_cap = cap; s_bp = 0; s_oti = 0; s_full = 0; s_err = 0;
