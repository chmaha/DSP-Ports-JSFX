        g_m38 = (g_m38-1) & 255;
        (g_m38 != 0 || s39 == 0) ? (
          g_p1 = (g_p1 + fr[256+sY]) & 255; g_p2 = (g_p2 + fr[512+sY]) & 255; g_p3 = (g_p3 + fr[768+sY]) & 255;
        ) : ( sam_sample(); reload = 1; );
      );
      reload ? ( sA = fr[sY]; s44 = sA; g_m38 = (sA - (sA >> 2)) & 255; g_p1 = g_p2 = g_p3 = 0; );
    );
    g_cnt += 1; sam_bud -= 1;
    (g_cnt > 4000000 || s_full) ? (g_run = 0);
