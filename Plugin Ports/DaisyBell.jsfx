TN_STA = alloc(128);
TN_STN = alloc(128);
TN_STW = alloc(512);
FSMT = alloc(1024);
PH_S = alloc(64);
PH_VOW = alloc(64);
PH_VOWS = alloc(16384);
ONS2 = alloc(4096);
ONS3 = alloc(262144);
KLPC = alloc(189501);
KRSZ = alloc(18951);
KDEC = alloc(1630560);
KDOFF = alloc(18952);
DST = alloc(1623);
DPB = alloc(1623);
DEN = alloc(1623);
DKEY = alloc(8192);
GQ_P2 = alloc(16);
G_DQLN = alloc(16);
G_WI = alloc(16);
G_FI = alloc(16);
G_A = alloc(2);
G_B = alloc(6);
G_PK = alloc(2);
G_DQ = alloc(6);
G_SR = alloc(2);
GUNP = alloc(1024);
U2S = alloc(256);
LCO = alloc(16);
OBUF = alloc(16);
SID2PH = alloc(16384);
seg_ph = alloc(4096);
seg_end = alloc(4096);
seg_cl = alloc(4096);
tg_pos = alloc(4096);
tg_f0 = alloc(4096);
u_te = alloc(8192);
u_st = alloc(8192);
u_en = alloc(8192);
pm_t = alloc(32768);
pm_f = alloc(32768);
pm_s = alloc(32768);
RESB = alloc(480000);
HAL_SCV = alloc(1024);
HAL_AB = alloc(256);
HAL_TMP = alloc(8192);
HAL_AB[0] = LXD; HAL_AB[1] = LTM; HAL_AB[2] = LTI; HAL_AB[3] = LXP; HAL_AB[4] = EH_O; HAL_AB[5] = EH_N; HAL_AB[6] = PH_O; HAL_AB[7] = PH_N; HAL_AB[8] = TPN; HAL_AB[9] = TPA; HAL_AB[10] = TPB; HAL_AB[11] = AD_KO; HAL_AB[12] = AD_KN; HAL_AB[13] = AD_PO; HAL_AB[14] = AD_PN; HAL_AB[15] = EH_C; HAL_AB[16] = PH_C; HAL_AB[17] = AD_KC; HAL_AB[18] = AD_PC; HAL_AB[19] = SP_H; HAL_AB[20] = SP_O; HAL_AB[21] = SP_L; HAL_AB[22] = SP_B; HAL_AB[23] = PA_N; HAL_AB[24] = PA_OP; HAL_AB[25] = PA_AR; HAL_AB[26] = PA_FIN; HAL_AB[27] = CT_BASE; HAL_AB[28] = ND_P; HAL_AB[29] = ND_OP; HAL_AB[30] = ND_NO; HAL_AB[31] = ND_T; HAL_AB[32] = ND_V; HAL_AB[33] = HSN; HAL_AB[34] = PS_ROW; HAL_AB[35] = PSF; HAL_AB[36] = GPOS; HAL_AB[37] = DS_OK; HAL_AB[38] = DS_M; HAL_AB[39] = DS_S; HAL_AB[40] = LR_P; HAL_AB[41] = LR_NEW; HAL_AB[42] = LR_S; HAL_AB[43] = LR_M; HAL_AB[44] = LR_E; HAL_AB[45] = LR_T; HAL_AB[46] = RXP; HAL_AB[47] = RX_O; HAL_AB[48] = TN_DIG; HAL_AB[49] = TN_TEEN; HAL_AB[50] = TN_ENTY; HAL_AB[51] = TN_ORDN; HAL_AB[52] = TN_ORDT; HAL_AB[53] = TN_ORDE; HAL_AB[54] = TN_EED; HAL_AB[55] = TN_REX1; HAL_AB[56] = TN_REX2; HAL_AB[57] = TN_SECT; HAL_AB[58] = TN_MONTH; HAL_AB[59] = TN_DAYS; HAL_AB[60] = TN_WMA; HAL_AB[61] = TN_WMB; HAL_AB[62] = TN_STK; HAL_AB[63] = TN_STA; HAL_AB[64] = TN_STN; HAL_AB[65] = TN_STW; HAL_AB[66] = FSMT; HAL_AB[67] = PH_S; HAL_AB[68] = PH_VOW; HAL_AB[69] = PH_VOWS; HAL_AB[70] = ONS2; HAL_AB[71] = ONS3; HAL_AB[72] = KLPC; HAL_AB[73] = KRSZ; HAL_AB[74] = KDEC; HAL_AB[75] = DST; HAL_AB[76] = DPB; HAL_AB[77] = DEN; HAL_AB[78] = DKEY; HAL_AB[79] = GQ_P2; HAL_AB[80] = G_DQLN; HAL_AB[81] = G_WI; HAL_AB[82] = G_FI; HAL_AB[83] = U2S; HAL_AB[84] = SID2PH; 
SP_HN = 32771;


function sp_hash(buf, n) local(h, i)
(
  h = 5381; i = 0;
  loop(n, h = (h*33 + buf[i]) % 1048573; i += 1;);
  h % SP_HN;
);

function sp_intern(buf, n) local(h, id, go, i, eq)
(
  h = sp_hash(buf, n); go = 1; id = -1;
  while (go) (
    SP_H[h] < 0 ? (
      id = SP_N; SP_O[id] = SP_TOP; SP_L[id] = n;
      i = 0; loop(n, SP_B[SP_TOP + i] = buf[i]; i += 1;);
      SP_TOP += n; SP_N += 1; SP_H[h] = id; go = 0;
    ) : (
      SP_L[SP_H[h]] == n ? (
        eq = 1; i = 0;
        while (eq && i < n) ( SP_B[SP_O[SP_H[h]] + i] != buf[i] ? (eq = 0); i += 1; );
        eq ? (id = SP_H[h]; go = 0) : (h = (h + 1) % SP_HN);
      ) : (h = (h + 1) % SP_HN);
    );
  );
  id;
);

function sp_lit(s) local(n, i)
(
  n = strlen(s); i = 0;
  loop(n, SP_T[i] = str_getchar(s, i, 'cu'); i += 1;);
  sp_intern(SP_T, n);
);

function sp_ch(id, i) ( i < SP_L[id] ? SP_B[SP_O[id] + i] : 0; );

function ct_new() local(c, k)
(
  c = NCT; NCT += 1;
  k = 0; loop(NK, CF_T[c*NK + k] = -1; k += 1;);
  k = 0; loop(NREL, CT_R[c*NREL + k] = -1; k += 1;);
  c;
);

function it_new(r, i) local(ni, c)
(
  ni = NIT; NIT += 1;
  IT_N[ni] = IT_P[ni] = IT_U[ni] = IT_D[ni] = -1;
  IT_R[ni] = r;
  c = i < 0 ? ct_new() : IT_C[i];
  IT_C[ni] = c;
  CT_R[c*NREL + r] = ni;
  ni;
);

function utt_relation_create(r) local(i)
(
  i = 0;
  loop(NIT, IT_R[i] == r && IT_C[i] >= 0 ? (CT_R[IT_C[i]*NREL + r] == i ? CT_R[IT_C[i]*NREL + r] = -1; IT_C[i] = -1;); i += 1;);
  RL_H[r] = RL_T[r] = -1; RL_X[r] = 1;
);

function relation_append(r, i) local(ni)
(
  ni = it_new(r, i);
  RL_H[r] < 0 ? (RL_H[r] = ni);
  IT_P[ni] = RL_T[r];
  RL_T[r] >= 0 ? (IT_N[RL_T[r]] = ni);
  RL_T[r] = ni;
  ni;
);

function item_append(cur, i) local(rni, r)
(
  r = IT_R[cur];
  rni = it_new(r, i);
  IT_N[rni] = IT_N[cur];
  IT_N[cur] >= 0 ? (IT_P[IT_N[cur]] = rni);
  IT_P[rni] = cur;
  IT_N[cur] = rni;
  RL_T[r] == cur ? (RL_T[r] = rni);
  rni;
);

function item_prepend(cur, i) local(rni, r)
(
  r = IT_R[cur];
  rni = it_new(r, i);
  IT_P[rni] = IT_P[cur];
  IT_P[cur] >= 0 ? (IT_N[IT_P[cur]] = rni);
  IT_N[rni] = cur;
  IT_P[cur] = rni;
  IT_U[cur] >= 0 ? (IT_D[IT_U[cur]] = rni; IT_U[rni] = IT_U[cur]; IT_U[cur] = -1;);
  RL_H[r] == cur ? (RL_H[r] = rni);
  rni;
);

function item_next(i) ( i < 0 ? -1 : IT_N[i]; );
function item_prev(i) ( i < 0 ? -1 : IT_P[i]; );
function item_daughter(i) ( i < 0 ? -1 : IT_D[i]; );
function item_parent(i) local(n)
(
  i < 0 ? -1 : (
    n = i; while (IT_P[n] >= 0) ( n = IT_P[n]; );
    IT_U[n];
  );
);
function item_last_daughter(i) local(p)
(
  p = item_daughter(i);
  p >= 0 ? (while (IT_N[p] >= 0) ( p = IT_N[p]; ););
  p;
);
function item_first(i) ( i < 0 ? -1 : (while (IT_P[i] >= 0) ( i = IT_P[i]; ); i;); );
function item_last(i) ( i < 0 ? -1 : (while (IT_N[i] >= 0) ( i = IT_N[i]; ); i;); );
function item_as(i, r) ( i < 0 ? -1 : CT_R[IT_C[i]*NREL + r]; );

function item_add_daughter(i, nd) local(p, rnd)
(
  p = item_last_daughter(i);
  p >= 0 ? (rnd = item_append(p, nd)) : (
    rnd = it_new(IT_R[i], nd);
    IT_U[rnd] = i;
    IT_D[i] = rnd;
  );
  rnd;
);

function delete_item(i) local(r, sp, x, y)
(
  IT_N[i] >= 0 ? (IT_P[IT_N[i]] = IT_P[i]; IT_U[IT_N[i]] = IT_U[i];);
  IT_P[i] >= 0 ? (IT_N[IT_P[i]] = IT_N[i]);
  IT_U[i] >= 0 ? (IT_D[IT_U[i]] = IT_N[i]);
  r = IT_R[i];
  RL_H[r] == i ? (RL_H[r] = IT_N[i]);
  RL_T[r] == i ? (RL_T[r] = IT_P[i]);
  sp = 0; DSTK[0] = i; sp = 1;
  while (sp > 0) (
    sp -= 1; x = DSTK[sp];
    y = IT_D[x]; while (y >= 0) ( DSTK[sp] = y; sp += 1; y = IT_N[y]; );
    CT_R[IT_C[x]*NREL + r] == x ? (CT_R[IT_C[x]*NREL + r] = -1);
    IT_C[x] = -1;
  );
);

function it_ft(i, k) ( i < 0 ? -1 : CF_T[IT_C[i]*NK + k]; );
function it_fv(i, k) ( CF_V[IT_C[i]*NK + k]; );
function it_present(i, k) ( it_ft(i, k) >= 0; );
function it_set(i, k, t, v) ( CF_T[IT_C[i]*NK + k] = t; CF_V[IT_C[i]*NK + k] = v; );
function it_set_s(i, k, sid) ( it_set(i, k, 2, sid); );
function it_set_i(i, k, v) ( it_set(i, k, 0, v); );
function it_set_f(i, k, v) ( it_set(i, k, 1, v); );
function it_del(i, k) ( CF_T[IT_C[i]*NK + k] = -1; );

function utt_reset() local(i)
(
  NIT = 0; NCT = 0;
  i = 0; loop(NREL, RL_H[i] = RL_T[i] = -1; RL_X[i] = 0; i += 1;);
);

function lx_uncompress(dbuf, p) local(i, j, c, n, k, go)
(
  i = p; j = 0; go = 1;
  while (go && LXD[i]) (
    c = LXD[i]; n = EH_N[c];
    j + n + 1 < 64 ? (
      k = 0; loop(n, dbuf[j + k] = EH_C[EH_O[c] + k]; k += 1;);
      j += n; i += 1;
    ) : (go = 0);
  );
  dbuf[j] = 0;
  j;
);

function lx_cmp(a, b, st) local(i, ca, cb, r, go)
(
  i = st; r = 0; go = 1;
  while (go) (
    ca = a[i]; cb = b[i];
    ca != cb ? (r = ca < cb ? -1 : 1; go = 0) : ca == 0 ? (go = 0) : (i += 1);
  );
  r;
);

function lx_next(p, en) local(go)
(
  p += 1; go = 1;
  while (go && p < en) ( LXD[p - 1] == 255 ? (go = 0) : (p += 1); );
  p;
);

function lx_prev(p, st) local(go)
(
  p -= 1; go = 1;
  while (go && p > st) ( LXD[p - 1] == 255 ? (go = 0) : (p -= 1); );
  p;
);

function lx_closest(p, st, en) local(d, r, go)
(
  d = 0; go = 1; r = -1;
  while (go && p - d > st && p + d < en) (
    LXD[p + d - 1] == 255 ? (r = p + d; go = 0)
    : LXD[p - d - 1] == 255 ? (r = p - d; go = 0)
    : (d += 1);
  );
  r < 0 ? p - d : r;
);

function lx_full(i, wp) local(w, match, go, hit)
(
  match = i; w = i; go = 1; hit = 0;
  while (go && w > 0) (
    lx_uncompress(LXU, w);
    lx_cmp(wp, LXU, 1) != 0 ? (go = 0) : lx_cmp(wp, LXU, 0) == 0 ? (match = w; hit = 1; go = 0) : (
      match = w;
      w = lx_prev(w, 0);
    );
  );
  !hit ? (
    w = i; go = 1;
    while (go && w < LX_NB) (
      lx_uncompress(LXU, w);
      lx_cmp(wp, LXU, 1) != 0 ? (go = 0) : lx_cmp(wp, LXU, 0) == 0 ? (match = w; go = 0) : (
        w = lx_next(w, LX_NB);
      );
    );
  );
  match;
);

function lx_bsearch(wp) local(st, mid, en, c, r, go)
(
  st = 0; en = LX_NB; r = -1; go = 1;
  while (go && st < en) (
    mid = floor((st + en)/2);
    mid = lx_closest(mid, st, en);
    lx_uncompress(LXU, mid);
    c = lx_cmp(LXU, wp, 1);
    c == 0 ? (r = lx_full(mid, wp); go = 0)
    : c > 0 ? (en = mid)
    : (st = lx_next(mid + 1, en));
  );
  r;
);

function lts_model(st) local(f, v, a, go)
(
  a = st*6; go = 1;
  while (LTM[a] != 255) (
    f = LTM[a]; v = LTM[a + 1];
    a = (LTSV[f] == v ? LTM[a + 2] + 256*LTM[a + 3] : LTM[a + 4] + 256*LTM[a + 5])*6;
  );
  LTM[a + 1];
);

function lts_apply(w, n, out) local(pos, k, fb, ph, np, i, c)
(
  i = 0; loop(3, LTB[i] = 48; i += 1;);
  LTB[3] = 35;
  i = 0; loop(n, LTB[4 + i] = w[i]; i += 1;);
  LTB[4 + n] = 35;
  i = 0; loop(3, LTB[5 + n + i] = 48; i += 1;);
  np = 0;
  pos = 4 + n - 1;
  while (LTB[pos] != 35) (
    k = 0; loop(4, LTSV[k] = LTB[pos - 4 + k]; LTSV[4 + k] = LTB[pos + 1 + k]; k += 1;);
    LTSV[8] = 0;
    c = LTB[pos];
    c >= 97 && c <= 122 ? (
      ph = lts_model(LTI[(c - 97) % 26]);
      TPN[ph] == 1 ? (LTR[np] = TPA[ph]; np += 1)
      : TPN[ph] == 2 ? (LTR[np] = TPB[ph]; LTR[np + 1] = TPA[ph]; np += 2);
    );
    pos -= 1;
  );
  i = 0; loop(np, out[i] = LTR[np - 1 - i]; i += 1;);
  np;
);

function lex_lookup(w, n, posc, out) local(i, j, a, ok, np, idx, p, q, c)
(
  LXW[0] = posc;
  i = 0; loop(n, LXW[1 + i] = w[i]; i += 1;);
  LXW[1 + n] = 0;
  np = -1;
  a = 0;
  while (np < 0 && a < NAD) (
    ok = posc == 48 || posc == AD_KC[AD_KO[a]] || AD_KC[AD_KO[a]] == 48;
    ok ? (
      AD_KN[a] - 1 != n ? (ok = 0) : (
        i = 0; loop(n, AD_KC[AD_KO[a] + 1 + i] != w[i] ? (ok = 0); i += 1;);
      );
    );
    ok ? (
      np = AD_PN[a];
      i = 0; loop(np, out[i] = AD_PC[AD_PO[a] + i]; i += 1;);
    );
    a += 1;
  );
  np < 0 ? (
    idx = lx_bsearch(LXW);
    idx >= 0 ? (
      np = 0;
      p = idx - 2;
      while (LXD[p]) (
        c = LXD[p];
        q = 0; loop(PH_N[c], out[np] = LXP[PH_C[PH_O[c] + q]]; np += 1; q += 1;);
        p -= 1;
      );
    ) : (
      np = lts_apply(w, n, out);
    );
  );
  np;
);

function rx_next(p) local(o)
(
  o = RXP[p + 1]*256 + RXP[p + 2];
  o == 0 ? -1 : RXP[p] == 7 ? p - o : p + o;
);

function rx_inset(op, c) local(r, go)
(
  r = 0; go = 1;
  while (go) ( RXP[op] == c ? (r = 1; go = 0) : RXP[op] == 0 ? (go = 0) : (op += 1); );
  r;
);

function rx_alnum(c) ( (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122); );

function rx_repeat(p, sid, inp) local(cnt, op, c)
(
  cnt = 0; op = p + 3;
  RXP[p] == 3 ? (cnt = SP_L[sid] - inp)
  : RXP[p] == 8 ? (while (RXP[op] == sp_ch(sid, inp + cnt)) ( cnt += 1; ))
  : RXP[p] == 4 ? (while ((c = sp_ch(sid, inp + cnt)) != 0 && rx_inset(op, c)) ( cnt += 1; ))
  : RXP[p] == 5 ? (while ((c = sp_ch(sid, inp + cnt)) != 0 && !rx_inset(op, c)) ( cnt += 1; ));
  cnt;
);

function rx_match(rx, sid) local(scan, inp, sp, op, nxt, res, fail, c, len, k, no, mn, nch, save, tp, go)
(
  scan = RX_O[rx] + 1; inp = 0; sp = 0; res = -1;
  while (res < 0) (
    fail = 0;
    scan < 0 ? (fail = 1) : (
      op = RXP[scan]; nxt = rx_next(scan); c = sp_ch(sid, inp);
      op == 0 ? (res = 1)
      : op == 1 ? (inp != 0 ? fail = 1; scan = nxt;)
      : op == 2 ? (c != 0 ? fail = 1; scan = nxt;)
      : op == 12 ? (
          (!rx_alnum(c) && c != 95) || (inp > 0 && (rx_alnum(sp_ch(sid, inp - 1)) || sp_ch(sid, inp - 1) == 95)) ? fail = 1;
          scan = nxt;
        )
      : op == 13 ? ((rx_alnum(c) || c == 95) ? fail = 1; scan = nxt;)
      : op == 3 ? (c == 0 ? fail = 1 : (inp += 1; scan = nxt;))
      : op == 8 ? (
          RXP[scan + 3] != c ? fail = 1 : (
            len = 0; while (RXP[scan + 3 + len]) ( len += 1; );
            k = 1; while (!fail && k < len) ( RXP[scan + 3 + k] != sp_ch(sid, inp + k) ? fail = 1; k += 1; );
            !fail ? (inp += len; scan = nxt;);
          );
        )
      : op == 4 ? ((c == 0 || !rx_inset(scan + 3, c)) ? fail = 1 : (inp += 1; scan = nxt;))
      : op == 5 ? ((c == 0 || rx_inset(scan + 3, c)) ? fail = 1 : (inp += 1; scan = nxt;))
      : (op == 9 || op == 7 || (op > 20 && op < 30) || (op > 30 && op < 40)) ? (scan = nxt)
      : op == 6 ? (
          RXP[nxt] != 6 ? (scan = scan + 3) : (
            RXS_T[sp] = 1; RXS_N[sp] = nxt; RXS_I[sp] = inp; sp += 1;
            scan = scan + 3;
          );
        )
      : (op == 10 || op == 11) ? (
          nch = RXP[nxt] == 8 ? RXP[nxt + 3] : 0;
          mn = op == 10 ? 0 : 1;
          save = inp;
          no = rx_repeat(scan + 3, sid, inp);
          inp = save + no; go = 1;
          while (go && no >= mn) (
            (nch == 0 || sp_ch(sid, inp) == nch) ? (
              RXS_T[sp] = 2; RXS_N[sp] = nxt; RXS_I[sp] = save; RXS_C[sp] = no - 1; RXS_M[sp] = mn; RXS_X[sp] = nch; sp += 1;
              scan = nxt; go = 0;
            ) : (no -= 1; inp = save + no;);
          );
          go ? fail = 1;
        )
      : (fail = 1);
    );
    while (fail && res < 0) (
      sp == 0 ? (res = 0) : (
        sp -= 1; tp = RXS_T[sp];
        tp == 1 ? (
          scan = RXS_N[sp]; inp = RXS_I[sp];
          scan >= 0 && RXP[scan] == 6 ? (
            RXS_T[sp] = 1; RXS_N[sp] = rx_next(scan); RXS_I[sp] = inp; sp += 1;
            scan = scan + 3; fail = 0;
          );
        ) : (
          no = RXS_C[sp]; save = RXS_I[sp]; mn = RXS_M[sp]; nch = RXS_X[sp]; nxt = RXS_N[sp];
          go = 1;
          while (go && no >= mn) (
            inp = save + no;
            (nch == 0 || sp_ch(sid, inp) == nch) ? (
              RXS_T[sp] = 2; RXS_N[sp] = nxt; RXS_I[sp] = save; RXS_C[sp] = no - 1; RXS_M[sp] = mn; RXS_X[sp] = nch; sp += 1;
              scan = nxt; go = 0; fail = 0;
            ) : (no -= 1);
          );
        );
      );
    );
  );
  res;
);

function f32(x) local(a, e, q, r, fl, d)
(
  x == 0 ? 0 : (
    a = abs(x);
    e = floor(log(a)/log(2));
    2^e > a ? (e -= 1);
    2^(e + 1) <= a ? (e += 1);
    q = 2^(e - 23);
    r = a/q; fl = floor(r); d = r - fl;
    d > 0.5 ? (fl += 1) : d == 0.5 ? ((fl & 1) ? (fl += 1));
    x < 0 ? -fl*q : fl*q;
  );
);



function lv_new(s, nx) local(n) ( n = NLV; NLV += 1; LV_S[n] = s; LV_B[n] = 0; LV_N[n] = nx; n; );
function lv_append(a, b) local(p) ( a < 0 ? b : (p = a; while (LV_N[p] >= 0) ( p = LV_N[p]; ); LV_N[p] = b; a;); );
function lv_reverse(a) local(p, nx, pv) ( pv = -1; p = a; while (p >= 0) ( nx = LV_N[p]; LV_N[p] = pv; pv = p; p = nx; ); pv; );
function lv_len(a) local(c) ( c = 0; while (a >= 0) ( c += 1; a = LV_N[a]; ); c; );
function add_break(l) local(p) ( l >= 0 ? (p = l; while (LV_N[p] >= 0) ( p = LV_N[p]; ); LV_B[p] = 1;); l; );

function sp_sub(id, a, n) local(i)
(
  n = max(0, min(n, SP_L[id] - a));
  i = 0; loop(n, TN_B[i] = SP_B[SP_O[id] + a + i]; i += 1;);
  sp_intern(TN_B, n);
);
function sp_tail(id, a) ( sp_sub(id, a, SP_L[id] - a); );
function sp_lower(id) local(i, c)
(
  i = 0; loop(SP_L[id], c = SP_B[SP_O[id] + i]; TN_B[i] = c >= 65 && c <= 90 ? c + 32 : c; i += 1;);
  sp_intern(TN_B, SP_L[id]);
);
function sp_chr(id, c) local(i, r)
(
  r = -1; i = 0;
  while (r < 0 && i < SP_L[id]) ( SP_B[SP_O[id] + i] == c ? (r = i); i += 1; );
  r;
);
function sp_rchr(id, c) local(i, r)
(
  r = -1; i = SP_L[id] - 1;
  while (r < 0 && i >= 0) ( SP_B[SP_O[id] + i] == c ? (r = i); i -= 1; );
  r;
);
function sp_strip(id, c) local(i, j, x)
(
  i = 0; j = 0;
  loop(SP_L[id], x = SP_B[SP_O[id] + i]; x != c ? (TN_B[j] = x; j += 1;); i += 1;);
  sp_intern(TN_B, j);
);
function sp_atoi(id) local(i, n, s, v, c)
(
  i = 0; n = SP_L[id]; s = 1; v = 0;
  while (i < n && (sp_ch(id, i) == 32 || (sp_ch(id, i) >= 9 && sp_ch(id, i) <= 13))) ( i += 1; );
  sp_ch(id, i) == 45 ? (s = -1; i += 1) : sp_ch(id, i) == 43 ? (i += 1);
  while (i < n && (c = sp_ch(id, i)) >= 48 && c <= 57) ( v = v*10 + c - 48; i += 1; );
  v = s*v;
  v > 9223372036854775807 ? (v = 9223372036854775807) : v < -9223372036854775808 ? (v = -9223372036854775808);
  v = v - floor((v + 2147483648)/4294967296)*4294967296;
  v;
);
function sp_ichar(c) ( TN_B[0] = c; sp_intern(TN_B, 1); );
function sp_fromint(v) local(n, neg, d, i, t)
(
  n = 0; neg = v < 0; v = abs(v);
  v == 0 ? (TN_C[0] = 48; n = 1) : (while (v > 0) ( TN_C[n] = 48 + (v % 10); v = floor(v/10); n += 1; ));
  i = 0; neg ? (TN_B[0] = 45; i = 1;);
  t = 0; loop(n, TN_B[i + t] = TN_C[n - 1 - t]; t += 1;);
  sp_intern(TN_B, i + n);
);
function in_set(c, s) local(i, r) ( r = c == 0; i = 0; loop(strlen(s), str_getchar(s, i, 'cu') == c ? (r = 1); i += 1;); r; );

function exp_digits(s) local(r, i, c)
(
  r = -1; i = SP_L[s] - 1;
  while (i >= 0) ( c = sp_ch(s, i); r = lv_new(c >= 48 && c <= 57 ? TN_DIG[c - 48] : W_umpty, r); i -= 1; );
  r;
);
function exp_letters(s) local(r, i, c, w)
(
  r = -1; i = SP_L[s] - 1;
  while (i >= 0) (
    c = sp_ch(s, i); c >= 65 && c <= 90 ? (c += 32);
    w = c >= 48 && c <= 57 ? TN_DIG[c - 48] : c == 97 ? W_Ua : sp_ichar(c);
    r = lv_new(w, r); i -= 1;
  );
  r;
);
function exp_roman(s) local(i, v, c)
(
  v = 0; i = 0;
  while (i < SP_L[s]) (
    c = sp_ch(s, i);
    c == 88 ? (v += 10) : c == 86 ? (v += 5) : c == 73 ? (
      sp_ch(s, i + 1) == 86 ? (v += 4; i += 1) : sp_ch(s, i + 1) == 88 ? (v += 9; i += 1) : (v += 1);
    );
    i += 1;
  );
  v;
);
function aswd_tr(o, v, st, sym) local(i, r)
(
  r = -1; i = st;
  while (r < 0 && FSMT[o + i]) ( (FSMT[o + i] % v) == sym ? (r = floor(FSMT[o + i]/v)); i += 1; );
  r;
);
function aswd_sym(c) ( c == 110 || c == 109 ? 78 : (c == 97 || c == 101 || c == 105 || c == 111 || c == 117 || c == 121) ? 86 : c; );
function us_aswd(w) local(dc, st, i, sym, pre, suf, go, n)
(
  dc = sp_lower(w); n = SP_L[dc];
  st = aswd_tr(FSM_P_O, FSM_P_V, 0, 35); pre = 0; go = 1; i = 0;
  while (go && i < n) (
    sym = aswd_sym(sp_ch(dc, i));
    st = aswd_tr(FSM_P_O, FSM_P_V, st, sym);
    st == -1 ? (go = 0) : sym == 86 ? (pre = 1; go = 0);
    i += 1;
  );
  pre ? (
    st = aswd_tr(FSM_P_O, FSM_P_V, 0, 35); suf = 0; go = 1; i = n - 1;
    while (go && i >= 0) (
      sym = aswd_sym(sp_ch(dc, i));
      st = aswd_tr(FSM_S_O, FSM_S_V, st, sym);
      st == -1 ? (go = 0) : sym == 86 ? (suf = 1; go = 0);
      i -= 1;
    );
    suf;
  ) : 0;
);
function in_lex_word(w) local(a, ok, i, n, r)
(
  n = SP_L[w]; r = 0; a = 0;
  while (!r && a < NAD) (
    AD_KN[a] - 1 == n ? (
      ok = 1; i = 0; loop(n, AD_KC[AD_KO[a] + 1 + i] != sp_ch(w, i) ? (ok = 0); i += 1;);
      ok ? (r = 1);
    );
    a += 1;
  );
  !r ? (
    LXW[0] = 48; i = 0; loop(n, LXW[1 + i] = sp_ch(w, i); i += 1;); LXW[1 + n] = 0;
    lx_bsearch(LXW) >= 0 ? (r = 1);
  );
  r;
);

function exp_num10(s) ( -1; );
<?
k = 9;
loop(10,
  printf("function exp_num%d(s) local(n, c0, c1, p, part, rest)\n", k);
  printf("(\n");
  printf("  n = SP_L[s];\n");
  printf("  n == 0 ? -1\n");
  printf("  : n == 1 ? exp_digits(s)\n");
  printf("  : n == 2 ? (\n");
  printf("    c0 = sp_ch(s, 0); c1 = sp_ch(s, 1);\n");
  printf("    c0 == 48 ? (c1 == 48 ? -1 : lv_new(TN_DIG[c1 - 48], -1))\n");
  printf("    : c1 == 48 ? lv_new(TN_ENTY[c0 - 48], -1)\n");
  printf("    : c0 == 49 ? lv_new(TN_TEEN[c1 - 48], -1)\n");
  printf("    : lv_new(TN_ENTY[c0 - 48], exp_digits(sp_tail(s, 1)));\n");
  printf("  )\n");
  printf("  : n == 3 ? (\n");
  printf("    sp_ch(s, 0) == 48 ? exp_num%d(sp_tail(s, 1)) : lv_new(TN_DIG[sp_ch(s, 0) - 48], lv_new(W_hundred, exp_num%d(sp_tail(s, 1))));\n", k + 1, k + 1);
  printf("  )\n");
  printf("  : n < 13 ? (\n");
  printf("    c0 = n < 7 ? 3 : n < 10 ? 6 : 9;\n");
  printf("    part = sp_sub(s, 0, n - c0); rest = sp_tail(s, n - c0);\n");
  printf("    p = exp_num%d(part);\n", k + 1);
  printf("    p < 0 ? exp_num%d(rest) : lv_append(p, lv_new(n < 7 ? W_thousand : n < 10 ? W_million : W_billion, exp_num%d(rest)));\n", k + 1, k + 1);
  printf("  )\n");
  printf("  : exp_digits(s);\n");
  printf(");\n");
  k -= 1;
);
?>
function exp_id40(s) ( -1; );
<?
k = 39;
loop(40,
  printf("function exp_id%d(s) local(n)\n", k);
  printf("(\n");
  printf("  n = SP_L[s];\n");
  printf("  n == 4 && sp_ch(s, 2) == 48 && sp_ch(s, 3) == 48 ? (\n");
  printf("    sp_ch(s, 1) == 48 ? exp_num0(s) : lv_append(exp_num0(sp_sub(s, 0, 2)), lv_new(W_hundred, -1));\n");
  printf("  )\n");
  printf("  : n == 3 && sp_ch(s, 0) != 48 && sp_ch(s, 1) == 48 && sp_ch(s, 2) == 48 ? lv_new(TN_DIG[sp_ch(s, 0) - 48], lv_new(W_hundred, -1))\n");
  printf("  : n == 2 && sp_ch(s, 0) == 48 && sp_ch(s, 1) == 48 ? lv_new(W_zero, lv_new(W_zero, -1))\n");
  printf("  : n == 2 && sp_ch(s, 0) == 48 ? lv_new(W_oh, exp_digits(sp_tail(s, 1)))\n");
  printf("  : (n == 4 && sp_ch(s, 1) == 48 && sp_ch(s, 2) == 48) || n < 3 ? exp_num0(s)\n");
  printf("  : n %% 2 == 1 ? lv_new(TN_DIG[sp_ch(s, 0) - 48], exp_id%d(sp_tail(s, 1)))\n", k + 1);
  printf("  : lv_append(exp_num0(sp_sub(s, 0, 2)), exp_id%d(sp_tail(s, 2)));\n", k + 1);
  printf(");\n");
  k -= 1;
);
?>
function exp_real8(s) ( -1; );
<?
k = 7;
loop(8,
  printf("function exp_real%d(s) local(p, r)\n", k);
  printf("(\n");
  printf("  sp_ch(s, 0) == 45 ? lv_new(W_minus, exp_real%d(sp_tail(s, 1)))\n", k + 1);
  printf("  : sp_ch(s, 0) == 43 ? lv_new(W_plus, exp_real%d(sp_tail(s, 1)))\n", k + 1);
  printf("  : ((p = sp_chr(s, 101)) >= 0 || (p = sp_chr(s, 69)) >= 0) ? (\n");
  printf("    r = exp_real%d(sp_tail(s, p + 1));\n", k + 1);
  printf("    lv_append(exp_real%d(sp_sub(s, 0, p)), lv_new(W_e, r));\n", k + 1);
  printf("  )\n");
  printf("  : (p = sp_chr(s, 46)) >= 0 ? lv_append(exp_num0(sp_sub(s, 0, p)), lv_new(W_point, exp_digits(sp_tail(s, p + 1))))\n");
  printf("  : exp_num0(s);\n");
  printf(");\n");
  k -= 1;
);
?>

function exp_ordinal(s) local(card, l, ord, i, o, t)
(
  card = lv_reverse(exp_num0(sp_strip(s, 44)));
  card < 0 ? (card = lv_new(W_zero, -1));
  l = LV_S[card]; ord = -1;
  i = 0; loop(10, l == TN_DIG[i] ? (ord = TN_ORDN[i]); i += 1;);
  ord < 0 ? (i = 0; loop(10, l == TN_TEEN[i] ? (ord = TN_ORDT[i]); i += 1;););
  ord < 0 ? (i = 0; loop(10, l == TN_ENTY[i] ? (ord = TN_ORDE[i]); i += 1;););
  l == W_hundred ? (ord = W_hundredth);
  l == W_thousand ? (ord = W_thousandth);
  l == W_billion ? (ord = W_billtionth);
  ord < 0 ? card : (
    o = lv_new(ord, -1);
    t = LV_N[card]; while (t >= 0) ( o = lv_new(LV_S[t], o); t = LV_N[t]; );
    o;
  );
);

function sp_atof(id) local(i, n, c, sg, v, fr, ex, es, go)
(
  n = SP_L[id]; i = 0; v = 0; sg = 1;
  while (i < n && (sp_ch(id, i) == 32 || (sp_ch(id, i) >= 9 && sp_ch(id, i) <= 13))) ( i += 1; );
  sp_ch(id, i) == 45 ? (sg = -1; i += 1) : sp_ch(id, i) == 43 ? (i += 1);
  while (i < n && sp_ch(id, i) >= 48 && sp_ch(id, i) <= 57) ( v = v*10 + sp_ch(id, i) - 48; i += 1; );
  sp_ch(id, i) == 46 ? (
    i += 1; fr = 0.1;
    while (i < n && sp_ch(id, i) >= 48 && sp_ch(id, i) <= 57) ( v += (sp_ch(id, i) - 48)*fr; fr *= 0.1; i += 1; );
  );
  (sp_ch(id, i) == 101 || sp_ch(id, i) == 69) ? (
    i += 1; es = 1; ex = 0;
    sp_ch(id, i) == 45 ? (es = -1; i += 1) : sp_ch(id, i) == 43 ? (i += 1);
    while (i < n && sp_ch(id, i) >= 48 && sp_ch(id, i) <= 57) ( ex = ex*10 + sp_ch(id, i) - 48; i += 1; );
    v *= 10^(es*ex);
  );
  sg*v;
);

function val_float(t, v) ( t == 0 ? v : t == 1 ? v : t == 2 ? f32(sp_atof(v)) : 0; );
function vstr_n(c) ( HSN[c < 0 ? 0 : c < 25 ? c : 24]; );
function ret_s(sid) ( FT = 2; FV = sid; );

function path_walk(item, pid, nops) local(j, op)
(
  j = 0;
  while (item >= 0 && j < nops) (
    op = PA_OP[pid*16 + j];
    op == 1 ? (item = item_next(item))
    : op == 2 ? (item = item_prev(item))
    : op == 3 ? (item = item_prev(item) >= 0 ? item_prev(item_prev(item)) : -1)
    : op == 4 ? (item = item_next(item) >= 0 ? item_next(item_next(item)) : -1)
    : op == 5 ? (item = item_parent(item))
    : op == 6 ? (item = item_daughter(item))
    : op == 7 ? (item = item_last_daughter(item))
    : op == 8 ? (item = item_first(item))
    : op == 9 ? (item = item_last(item))
    : op == 10 ? (item = item_as(item, PA_AR[pid*16 + j]));
    j += 1;
  );
  item;
);

function path_to_item(item, pid) ( path_walk(item, pid, PA_N[pid]); );

function stress_s(p) ( it_ft(p, K_stress) == 2 ? it_fv(p, K_stress) : S_ZERO; );

function ph_feat(sid, f) ( PSF[PS_ROW[sid]*8 + f]; );

function f_word_break(word) local(ww, pp, nm)
(
  ww = item_as(word, R_Phrase);
  (ww < 0 || item_next(ww) >= 0) ? ret_s(S_ONE) : (
    pp = item_parent(ww);
    nm = it_ft(pp, K_name) == 2 ? it_fv(pp, K_name) : -1;
    nm == S_BB ? ret_s(S_FOUR) : nm == S_B ? ret_s(S_THREE) : ret_s(S_ONE);
  );
);

function f_syl_break(syl) local(ss)
(
  ss = item_as(syl, R_SylStructure);
  ss < 0 ? ret_s(S_ONE) : item_next(ss) >= 0 ? ret_s(S_ZERO) : item_parent(ss) < 0 ? ret_s(S_ONE) : f_word_break(item_parent(ss));
);

function f_accented(syl) ( (it_present(syl, K_accent) || it_present(syl, K_endtone)) ? S_ONE : S_ZERO; );

function same_ct(a, b) ( a >= 0 && b >= 0 ? IT_C[a] == IT_C[b] : a == b; );

function f_ssyl_in(syl) local(ss, p, fs, c)
(
  ss = item_as(syl, R_Syllable);
  fs = path_to_item(syl, PTH_PHR_FIRSTSYL);
  same_ct(ss, fs) ? ret_s(HSN[0]) : (
    c = 0; p = item_prev(ss);
    while (p >= 0 && !same_ct(p, fs) && c < 19) ( stress_s(p) == S_ONE ? (c += 1); p = item_prev(p); );
    ret_s(vstr_n(c));
  );
);

function f_ssyl_out(syl) local(ss, p, fs, c, go)
(
  ss = item_as(syl, R_Syllable);
  fs = path_to_item(syl, PTH_PHR_LASTSYL);
  same_ct(ss, fs) ? ret_s(HSN[0]) : (
    c = 0; p = item_next(ss); go = 1;
    while (go && p >= 0 && c < 19) (
      stress_s(p) == S_ONE ? (c += 1);
      same_ct(p, fs) ? (go = 0) : (p = item_next(p));
    );
    ret_s(vstr_n(c));
  );
);

function f_syl_in(syl) local(p, fs, c, go)
(
  fs = path_to_item(syl, PTH_PHR_FIRSTSYL);
  c = 0; p = item_as(syl, R_Syllable); go = 1;
  while (go && p >= 0 && c < 19) ( same_ct(p, fs) ? (go = 0) : (p = item_prev(p); c += 1); );
  ret_s(vstr_n(c));
);

function f_syl_out(syl) local(p, fs, c, go)
(
  fs = path_to_item(syl, PTH_PHR_LASTSYL);
  c = 0; p = item_as(syl, R_Syllable); go = 1;
  while (go && p >= 0 && c < 19) ( same_ct(p, fs) ? (go = 0) : (p = item_next(p); c += 1); );
  ret_s(vstr_n(c));
);

function f_asyl_in(syl) local(ss, p, fs, c, go)
(
  ss = item_as(syl, R_Syllable);
  fs = path_to_item(syl, PTH_PHR_FIRSTSYL);
  same_ct(ss, fs) ? ret_s(HSN[0]) : (
    c = 0; p = item_prev(ss); go = 1;
    while (go && p >= 0 && c < 19) (
      f_accented(p) == S_ONE ? (c += 1);
      same_ct(p, fs) ? (go = 0) : (p = item_prev(p));
    );
    ret_s(vstr_n(c));
  );
);

function f_asyl_out(syl) local(ss, p, fs, c, go)
(
  ss = item_as(syl, R_Syllable);
  fs = path_to_item(syl, PTH_PHR_LASTSYL);
  same_ct(ss, fs) ? ret_s(HSN[0]) : (
    c = 0; p = item_next(ss); go = 1;
    while (go && p >= 0 && c < 19) (
      f_accented(p) == S_ONE ? (c += 1);
      same_ct(p, fs) ? (go = 0) : (p = item_next(p));
    );
    ret_s(vstr_n(c));
  );
);

function f_sub_phrases(syl) local(s, c)
(
  c = 0; s = path_to_item(syl, PTH_PHR_PREV);
  while (s >= 0 && c < 19) ( s = item_prev(s); c += 1; );
  ret_s(vstr_n(c));
);

function f_last_accent(syl) local(s, c, go)
(
  c = 0; s = item_as(syl, R_Syllable); go = 1;
  while (go && s >= 0 && c < 19) ( f_accented(s) == S_ONE ? (go = 0) : (s = item_prev(s); c += 1); );
  ret_s(vstr_n(c));
);

function f_next_accent(syl) local(s, c, go)
(
  s = item_as(syl, R_Syllable);
  s < 0 ? ret_s(HSN[0]) : (
    s = item_next(s); c = 0; go = 1;
    while (go && s >= 0 && c < 19) ( f_accented(s) == S_ONE ? (go = 0) : (s = item_next(s); c += 1); );
    ret_s(vstr_n(c));
  );
);

function f_syl_codasize(syl) local(d, c, go)
(
  c = 1; d = item_last_daughter(item_as(syl, R_SylStructure)); go = 1;
  while (go && d >= 0) ( ph_feat(it_fv(d, K_name), 0) == S_PLUS ? (go = 0) : (d = item_prev(d); c += 1); );
  ret_s(vstr_n(c));
);

function f_syl_onsetsize(syl) local(d, c, go)
(
  c = 0; d = item_daughter(item_as(syl, R_SylStructure)); go = 1;
  while (go && d >= 0) ( ph_feat(it_fv(d, K_name), 0) == S_PLUS ? (go = 0) : (d = item_next(d); c += 1); );
  ret_s(vstr_n(c));
);

function f_seg_onsetcoda(seg) local(s, r)
(
  r = S_CODA;
  s = item_next(item_as(seg, R_SylStructure));
  while (s >= 0 && r == S_CODA) ( ph_feat(it_fv(s, K_name), 0) == S_PLUS ? (r = S_ONSET) : (s = item_next(s)); );
  ret_s(r);
);

function f_pos_in_syl(seg) local(s, c)
(
  c = -1; s = item_as(seg, R_SylStructure);
  while (s >= 0) ( s = item_prev(s); c += 1; );
  ret_s(vstr_n(c));
);

function f_position_type(syl) local(s)
(
  s = item_as(syl, R_SylStructure);
  s < 0 ? ret_s(S_SINGLE)
  : item_next(s) < 0 ? (item_prev(s) < 0 ? ret_s(S_SINGLE) : ret_s(S_FINAL))
  : item_prev(s) < 0 ? ret_s(S_INITIAL) : ret_s(S_MID);
);

function f_word_numsyls(word) local(d, c)
(
  c = 0; d = item_daughter(item_as(word, R_SylStructure));
  while (d >= 0) ( d = item_next(d); c += 1; );
  FT = 0; FV = c < 25 ? c : 24;
);

function f_word_punc(word) local(ww)
(
  ww = item_as(word, R_Token);
  ww >= 0 && item_next(ww) >= 0 ? ret_s(S_EMPTY) : (
    ww = item_parent(ww);
    it_ft(ww, K_punc) >= 0 ? (FT = it_ft(ww, K_punc); FV = it_fv(ww, K_punc)) : ret_s(S_ZERO);
  );
);

function f_gpos(word) local(nm, r)
(
  nm = it_ft(word, K_name) == 2 ? it_fv(word, K_name) : -1;
  r = nm >= 0 ? GPOS[nm] : 0;
  ret_s(r > 0 ? r : S_CONTENT);
);

function f_syl_edge(seg, first) local(s)
(
  s = item_as(seg, R_SylStructure);
  ret_s((s < 0 || (first ? item_prev(s) : item_next(s)) < 0) ? S_ONE : S_ZERO);
);

function ff_call(f, p)
(
  f == FF_gpos ? f_gpos(p)
  : f == FF_ssyl_in ? f_ssyl_in(p)
  : f == FF_ssyl_out ? f_ssyl_out(p)
  : f == FF_syl_in ? f_syl_in(p)
  : f == FF_syl_out ? f_syl_out(p)
  : f == FF_syl_break || f == FF_old_syl_break ? f_syl_break(p)
  : f == FF_word_break ? f_word_break(p)
  : f == FF_sub_phrases ? f_sub_phrases(p)
  : f == FF_accented ? ret_s(f_accented(p))
  : f == FF_asyl_in ? f_asyl_in(p)
  : f == FF_asyl_out ? f_asyl_out(p)
  : f == FF_last_accent ? f_last_accent(p)
  : f == FF_next_accent ? f_next_accent(p)
  : f == FF_syl_codasize ? f_syl_codasize(p)
  : f == FF_syl_onsetsize ? f_syl_onsetsize(p)
  : f == FF_seg_onsetcoda ? f_seg_onsetcoda(p)
  : f == FF_pos_in_syl ? f_pos_in_syl(p)
  : f == FF_position_type ? f_position_type(p)
  : f == FF_word_numsyls ? f_word_numsyls(p)
  : f == FF_word_punc ? f_word_punc(p)
  : f == FF_syl_final ? f_syl_edge(p, 0)
  : f == FF_syl_initial ? f_syl_edge(p, 1)
  : f == FF_ph_vc ? ret_s(ph_feat(it_fv(p, K_name), 0))
  : f == FF_ph_vlng ? ret_s(ph_feat(it_fv(p, K_name), 1))
  : f == FF_ph_vheight ? ret_s(ph_feat(it_fv(p, K_name), 2))
  : f == FF_ph_vfront ? ret_s(ph_feat(it_fv(p, K_name), 3))
  : f == FF_ph_vrnd ? ret_s(ph_feat(it_fv(p, K_name), 4))
  : f == FF_ph_ctype ? ret_s(ph_feat(it_fv(p, K_name), 5))
  : f == FF_ph_cplace ? ret_s(ph_feat(it_fv(p, K_name), 6))
  : f == FF_ph_cvox ? ret_s(ph_feat(it_fv(p, K_name), 7))
  : f == FF_num_digits ? (FT = 0; FV = min(SP_L[it_fv(p, K_name)], 24))
  : f == FF_month_range ? (FV = sp_atoi(it_fv(p, K_name)); ret_s(FV > 0 && FV < 32 ? S_ONE : S_ZERO))
  : f == FF_token_pos_guess ? (
    FV = sp_lower(it_fv(p, K_name));
    rx_match(RX_cst_rx_digits, FV) ? ret_s(W_numeric)
    : rx_match(RX_cst_rx_double, FV) ? ret_s(W_number)
    : TN_MONTH[FV] ? ret_s(W_month)
    : TN_DAYS[FV] ? ret_s(W_day)
    : FV == W_a ? ret_s(W_a)
    : FV == W_flight ? ret_s(W_flight)
    : FV == W_to ? ret_s(W_to)
    : ret_s(W_UotherU);
  )
  : (printf("ffunction %d not ported\n", f); FT = 2; FV = S_ZERO;);
);

function ffeat(item, pid) local(p, f)
(
  p = path_walk(item, pid, PA_N[pid] - 1);
  f = PA_FIN[pid];
  p >= 0 && f >= 1000 ? (
    FT = -1; ff_call(f - 1000, p);
    FT < 0 ? (FT = 2; FV = S_ZERO);
  ) : (
    f >= 0 && it_ft(p, f) >= 0 ? (FT = it_ft(p, f); FV = it_fv(p, f)) : (FT = 2; FV = S_ZERO);
  );
);

function ffeat_s(item, pid) ( ffeat(item, pid); FT == 2 ? FV : -1; );

function cart_interpret(item, tree) local(n, r, t, v)
(
  n = CT_BASE[tree];
  while (ND_OP[n] != 255) (
    ffeat(item, ND_P[n]); t = FT; v = FV;
    r = ND_OP[n] == 0 ? (t == ND_T[n] && v == ND_V[n])
      : ND_OP[n] == 2 ? (f32(val_float(t, v)) < ND_V[n])
      : ND_OP[n] == 3 ? (f32(val_float(t, v)) > ND_V[n])
      : (printf("cart op %d not ported\n", ND_OP[n]); 0);
    n = r ? n + 1 : CT_BASE[tree] + ND_NO[n];
  );
  n;
);

function ts_cls(c, m) ( (TS_CC[c & 255] & m) != 0; );

function ts_getc() local(c)
(
  c = TS_IN[TS_POS];
  c == 0 ? (TS_EOF = 1; TS_CUR = 0) : (TS_CUR = c);
  !TS_EOF ? (TS_POS += 1);
  TS_CUR == 10 ? (TS_LINE += 1);
  TS_CUR;
);

function ts_sub(cls, buf) local(p)
(
  p = 0;
  while (!TS_EOF && ts_cls(TS_CUR, cls) && !ts_cls(TS_CUR, 2)) ( buf[p] = TS_CUR; p += 1; ts_getc(); );
  buf[p] = 0;
  p;
);

function ts_get() local(p, t)
(
  TS_WSN = ts_sub(1, TS_WS);
  !TS_EOF && ts_cls(TS_CUR, 4) ? (TS_PREN = ts_sub(4, TS_PRE)) : (TS_PRE[0] = 0; TS_PREN = 0);
  !TS_EOF && ts_cls(TS_CUR, 2) ? (
    TS_TOK[0] = TS_CUR; TS_TOK[1] = 0; TS_TOKN = 1; ts_getc();
  ) : (
    p = 0;
    while (!TS_EOF && !ts_cls(TS_CUR, 1) && !ts_cls(TS_CUR, 2)) ( TS_TOK[p] = TS_CUR; p += 1; ts_getc(); );
    TS_TOK[p] = 0; TS_TOKN = p;
  );
  TS_POST[0] = 0; TS_POSTN = 0;
  t = TS_TOKN; p = t;
  while (p > 0 && (TS_TOK[p] == 0 || ts_cls(TS_TOK[p], 8))) ( p -= 1; );
  t != p ? (
    TS_POSTN = t - p - 1;
    memcpy(TS_POST, TS_TOK + p + 1, t - p);
    TS_TOK[p + 1] = 0; TS_TOKN = p + 1;
  );
);

function tokenization(n) local(t, i)
(
  utt_relation_create(R_Token);
  memset(TS_CC, 0, 256);
  TS_CC[32] |= 1; TS_CC[9] |= 1; TS_CC[10] |= 1; TS_CC[13] |= 1;
  i = 0; loop(strlen(TS_PRESYM), TS_CC[str_getchar(TS_PRESYM, i, 'cu')] |= 4; i += 1;);
  i = 0; loop(strlen(TS_POSTSYM), TS_CC[str_getchar(TS_POSTSYM, i, 'cu')] |= 8; i += 1;);
  TS_IN[n] = 0; TS_POS = 0; TS_LINE = 0; TS_EOF = 0;
  ts_getc();
  while (!TS_EOF) (
    ts_get();
    TS_TOKN > 0 ? (
      t = relation_append(R_Token, -1);
      it_set_s(t, K_name, sp_intern(TS_TOK, TS_TOKN));
      it_set_s(t, K_whitespace, sp_intern(TS_WS, TS_WSN));
      it_set_s(t, K_prepunctuation, sp_intern(TS_PRE, TS_PREN));
      it_set_s(t, K_punc, sp_intern(TS_POST, TS_POSTN));
      it_set_i(t, K_file_pos, TS_POS);
      it_set_i(t, K_line_number, TS_LINE);
    );
  );
);
function pos_tagger() local(w, n)
(
  w = RL_H[R_Word];
  while (w >= 0) (
    n = cart_interpret(w, TR_pos);
    it_set_s(w, K_pos, ND_V[n]);
    w = item_next(w);
  );
);

function phrasing() local(w, p, lp, n)
(
  utt_relation_create(R_Phrase);
  p = -1; lp = -1;
  w = RL_H[R_Word];
  while (w >= 0) (
    p < 0 ? (
      p = relation_append(R_Phrase, -1);
      lp = p;
      it_set_s(p, K_name, S_B);
    );
    item_add_daughter(p, w);
    n = cart_interpret(w, TR_phrasing);
    ND_V[n] == S_BB ? (p = -1);
    w = item_next(w);
  );
  lp >= 0 && item_prev(lp) >= 0 ? it_set_s(lp, K_name, S_BB);
);
function ph_isvowel(base) ( PH_VOW[base]; );

function syl_boundary_mo(i, j, np) local(k, any, n, d2v, r0, r1, r2)
(
  j >= np ? 1 : (
    r0 = LPH[j] % 64;
    r0 == PH_PAU ? 1 : (
      any = 0; k = j; while (!any && k < np) ( ph_isvowel(LPH[k] % 64) ? (any = 1); k += 1; );
      !any ? 0 : (
        any = 0; n = i; while (!any && n >= 0) ( PH_VOWS[it_fv(n, K_name)] ? (any = 1); n = item_prev(n); );
        !any ? 0 : ph_isvowel(r0) ? 1 : r0 == PH_NG ? 0 : (
          d2v = 0; k = j; while (!ph_isvowel(LPH[k] % 64)) ( d2v += 1; k += 1; );
          r1 = LPH[j + 1] % 64; r2 = LPH[j + 2] % 64;
          d2v < 2 ? 1 : d2v > 3 ? 0 : d2v == 2 ? ONS2[r0*64 + r1] : ONS3[(r0*64 + r1)*64 + r2];
        );
      );
    );
  );
);

function lexical_insertion() local(word, ssword, posc, pv, np, j, sylitem, sssyl, segitem, seg_in_syl, stress, tk, nm, n, b, st)
(
  utt_relation_create(R_Syllable);
  utt_relation_create(R_SylStructure);
  utt_relation_create(R_Segment);
  word = RL_H[R_Word];
  while (word >= 0) (
    ssword = relation_append(R_SylStructure, word);
    pv = it_ft(word, K_pos) == 2 ? it_fv(word, K_pos) : S_ZERO;
    posc = sp_ch(pv, 0);
    nm = it_fv(word, K_name); n = SP_L[nm];
    j = 0; loop(n, LXQ[j] = SP_B[SP_O[nm] + j]; j += 1;);
    np = lex_lookup(LXQ, n, posc, LPH);
    sssyl = -1; sylitem = -1; stress = S_ZERO;
    j = 0;
    loop(np,
      sylitem < 0 ? (
        sylitem = relation_append(R_Syllable, -1);
        sssyl = item_add_daughter(ssword, sylitem);
        stress = S_ZERO;
      );
      segitem = relation_append(R_Segment, -1);
      b = LPH[j] % 64; st = floor(LPH[j]/64);
      st == 2 ? (stress = S_ONE) : st == 1 ? (stress = S_ZERO);
      it_set_s(segitem, K_name, PH_S[b]);
      seg_in_syl = item_add_daughter(sssyl, segitem);
      syl_boundary_mo(seg_in_syl, j + 1, np) ? (
        sylitem = -1;
        sssyl >= 0 ? it_set_s(sssyl, K_stress, stress);
      );
      j += 1;
    );
    word = item_next(word);
  );
);
function pause_insertion() local(s, p, w, done)
(
  s = RL_H[R_Segment];
  s < 0 ? (s = relation_append(R_Segment, -1)) : (s = item_prepend(s, -1));
  it_set_s(s, K_name, S_SILENCE);
  p = RL_H[R_Phrase];
  while (p >= 0) (
    w = item_last_daughter(p); done = 0;
    while (!done && w >= 0) (
      s = path_to_item(w, PTH_LASTSEG);
      s >= 0 ? (
        s = item_append(s, -1);
        it_set_s(s, K_name, S_SILENCE);
        done = 1;
      ) : (w = item_prev(w));
    );
    p = item_next(p);
  );
);

function cart_intonation() local(s, n)
(
  s = RL_H[R_Syllable];
  while (s >= 0) (
    n = cart_interpret(s, TR_accent);
    ND_V[n] != S_NONE ? it_set_s(s, K_accent, ND_V[n]);
    n = cart_interpret(s, TR_tone);
    ND_V[n] != S_NONE ? it_set_s(s, K_endtone, ND_V[n]);
    s = item_next(s);
  );
);

function pl_first(sid) ( SP_L[sid] > 0 ? SP_B[SP_O[sid]] : 0; );

function cmu_postlex() local(s, word, pname, ct, cp, schwa, i)
(
  s = item_next(RL_H[R_Segment]);
  while (s >= 0) (
    ffeat(s, PTH_SEG_WORD); word = FV;
    word == S_APS ? (
      pname = it_fv(item_prev(s), K_name);
      ct = pl_first(ph_feat(pname, 5)); cp = pl_first(ph_feat(pname, 6));
      (ct == 102 || ct == 97) && !(cp == 100 || cp == 98 || cp == 103) ? (
        schwa = item_prepend(s, -1);
        it_set_s(schwa, K_name, S_AX);
        item_prepend(item_as(s, R_SylStructure), schwa);
      ) : ph_feat(pname, 7) == S_MINUS ? (
        it_set_s(s, K_name, S_S);
      );
    ) : (word == S_APVE || word == S_APLL || word == S_APD) ? (
      ffeat(s, PTH_P_PHVC);
      FV == S_MINUS ? (
        schwa = item_prepend(s, -1);
        it_set_s(schwa, K_name, S_AX);
        item_prepend(item_as(s, R_SylStructure), schwa);
      );
    );
    s = item_next(s);
  );
  i = RL_H[R_Segment];
  while (i >= 0) (
    it_fv(i, K_name) == S_AX ? (
      ffeat(i, PTH_SEG_WORD); word = FV;
      ffeat(i, PTH_N_PHVC);
      word == S_THE && FV == S_PLUS ? it_set_s(i, K_name, S_IY);
    );
    i = item_next(i);
  );
  s = RL_H[R_Segment];
  while (s >= 0) ( it_fv(s, K_name) == S_AH ? it_set_s(s, K_name, S_AA); s = item_next(s); );
);

function cart_duration() local(s, n, zdur, dmean, dsdev, lds, dur, en, nm, stretch)
(
  en = 0;
  stretch = f32(DUR_STRETCH);
  s = RL_H[R_Segment];
  while (s >= 0) (
    n = cart_interpret(s, TR_dur);
    zdur = f32(val_float(ND_T[n], ND_V[n]));
    nm = it_fv(s, K_name);
    DS_OK[nm] ? (dmean = DS_M[nm]; dsdev = DS_S[nm]) : (dmean = DS_M0; dsdev = DS_S0);
    ffeat(s, PTH_LDS); lds = f32(val_float(FT, FV));
    lds != 0 ? (lds = f32(lds*stretch)) : (lds = stretch);
    dur = f32(lds*f32(f32(zdur*dsdev) + dmean));
    en = f32(en + dur);
    it_set_f(s, K_end, en);
    s = item_next(s);
  );
);

function f0_map(v, m, sd) ( (((v - 170)/34)*sd) + m; );

function f0_target(pos, f0) local(t)
(
  t = relation_append(R_Target, -1);
  it_set_f(t, K_pos, f32(pos));
  f0 = f32(f0);
  f0 > 500 ? it_set_f(t, K_f0, 500) : f0 < 50 ? it_set_f(t, K_f0, 50) : it_set_f(t, K_f0, f0);
);

function f0_vowel_mid(syl) local(s, ts, r, go)
(
  ts = item_daughter(item_as(syl, R_SylStructure));
  s = ts; go = 1; r = 0;
  while (go && s >= 0) (
    ph_feat(it_fv(s, K_name), 0) == S_PLUS ? (
      ffeat(s, PTH_SEG_PEND);
      r = f32(f32(it_fv(s, K_end) + f32(val_float(FT, FV)))/2); go = 0;
    ) : (s = item_next(s));
  );
  go ? (
    ts < 0 ? (r = 0) : (
      ffeat(ts, PTH_SEG_PEND);
      r = f32(f32(it_fv(ts, K_end) + f32(val_float(FT, FV)))/2);
    );
  );
  r;
);

function us_f0_model() local(syl, t, nt, mean, sdev, lmean, lsd, st, md, en, lend, segend, i, fval, vt, vv, post, pre)
(
  utt_relation_create(R_Target);
  mean = f32(f32(F0_MEAN)*f32(F0_SHIFT)); sdev = f32(F0_STD);
  lend = 0;
  syl = RL_H[R_Syllable];
  while (syl >= 0) (
    item_daughter(item_as(syl, R_SylStructure)) >= 0 ? (
      ffeat(syl, PTH_LF0SHIFT); lmean = f32(val_float(FT, FV));
      lmean != 0 ? (lmean = f32(lmean*mean)) : (lmean = mean);
      ffeat(syl, PTH_LF0RANGE); lsd = f32(val_float(FT, FV));
      lsd == 0 ? (lsd = sdev);
      st = LR_S[0]; md = LR_M[0]; en = LR_E[0];
      i = 1;
      loop(NLR - 1,
        LR_NEW[i] ? (ffeat(syl, LR_P[i]); vt = FT; vv = FV;);
        LR_T[i] >= 0 ? (fval = (vt == 2 && vv == LR_T[i]) ? 1 : 0) : (fval = f32(val_float(vt, vv)));
        st = f32(st + f32(fval*LR_S[i])); md = f32(md + f32(fval*LR_M[i])); en = f32(en + f32(fval*LR_E[i]));
        i += 1;
      );
      ffeat(syl, PTH_SYL_FSEG_PNAME);
      post = item_prev(syl) < 0 || (FT == 2 && FV == S_PAU);
      post ? (lend = f32(f0_map(st, lmean, lsd)));
      ffeat(syl, PTH_SYL_FSEG_PEND);
      f0_target(val_float(FT, FV), f0_map(f32(st + lend)/2, lmean, lsd));
      f0_target(f0_vowel_mid(syl), f0_map(md, lmean, lsd));
      lend = f32(f0_map(en, lmean, lsd));
      ffeat(syl, PTH_SYL_LSEG_NNAME);
      pre = item_next(syl) < 0 || (FT == 2 && FV == S_PAU);
      pre ? (ffeat(syl, PTH_SYL_LSEG_END); f0_target(val_float(FT, FV), f0_map(en, lmean, lsd)));
    );
    syl = item_next(syl);
  );
  t = RL_H[R_Target];
  t < 0 ? f0_target(0, mean) : it_fv(t, K_pos) > 0 ? (
    nt = item_prepend(t, -1);
    it_set_f(nt, K_pos, 0);
    it_set_f(nt, K_f0, it_fv(t, K_f0));
  );
  t = RL_T[R_Target];
  segend = it_fv(RL_T[R_Segment], K_end);
  it_fv(t, K_pos) < segend ? f0_target(segend, it_fv(t, K_f0));
);
function utt_to_kal() local(s, i, t)
(
  i = 0; s = RL_H[R_Segment];
  while (s >= 0) (
    seg_ph[i] = SID2PH[it_fv(s, K_name)];
    seg_end[i] = it_fv(s, K_end);
    ffeat(s, PTH_SS_N_PHVC);
    seg_cl[i] = ph_feat(it_fv(s, K_name), 0) == S_MINUS && FT == 2 && FV == S_MINUS;
    i += 1; s = item_next(s);
  );
  nseg = i;
  i = 0; t = RL_H[R_Target];
  while (t >= 0) ( tg_pos[i] = it_fv(t, K_pos); tg_f0[i] = it_fv(t, K_f0); i += 1; t = item_next(t); );
  ntg = i;
);

function sar(a, n) ( floor(a/2^n); );

function w32(x) ( x - floor((x + 2147483648)/4294967296)*4294967296; );
function s16(x) ( x = x|0; x = x & 65535; x >= 32768 ? x - 65536 : x; );
function idiv(a, b) ( (a/b)|0; );

function u2s(u) local(e, m, v)
(
  u = 255 - (u & 255);
  e = (sar(u, 4)) & 7; m = u & 15;
  v = (e == 0 ? 0 : e == 1 ? 132 : e == 2 ? 396 : e == 3 ? 924 : e == 4 ? 1980 : e == 5 ? 4092 : e == 6 ? 8316 : 16764) + (m << (e + 3));
  (u & 0x80) ? -v : v;
);

function s2u(smp) local(sg, ex, ma, b, t)
(
  smp = s16(smp);
  sg = (sar(smp, 8)) & 0x80;
  sg != 0 ? (smp = s16(-smp));
  smp > 32635 ? (smp = 32635);
  smp = s16(smp + 0x84);
  t = (sar(smp, 7)) & 0xFF;
  ex = t < 2 ? 0 : t < 4 ? 1 : t < 8 ? 2 : t < 16 ? 3 : t < 32 ? 4 : t < 64 ? 5 : t < 128 ? 6 : 7;
  ma = (sar(smp, (ex + 3))) & 0x0F;
  b = 255 - ((sg | (ex << 4) | ma) & 255);
  b == 0 ? 2 : b;
);

function nearest_pm(st, en, ui) local(i, isz, nsz, rv, go)
(
  isz = 0; i = st; rv = en - 1; go = 1;
  while (go && i < en) (
    nsz = isz + KRSZ[i];
    abs(f32(ui - isz)) < abs(f32(ui - nsz)) ? (rv = i; go = 0) : (isz = nsz; i += 1);
  );
  rv;
);

function kal_units() local(i, k, e, e0, e1)
(
  nunit = 0;
  i = 0;
  loop(nseg - 1,
    e = -1;
    seg_cl[i] ? (k = 4096 + seg_ph[i]*64 + seg_ph[i + 1]; e = DKEY[k];);
    e < 0 ? (k = seg_ph[i]*64 + seg_ph[i + 1]; e = DKEY[k];);
    e < 0 ? (e = 0);
    e0 = seg_end[i]; e1 = seg_end[i + 1];
    u_te[nunit] = floor(f32(e0*8000));
    u_st[nunit] = DST[e]; u_en[nunit] = DST[e] + DPB[e];
    nunit += 1;
    u_te[nunit] = floor(f32(e0 + e1)/2*8000);
    u_st[nunit] = DST[e] + DPB[e]; u_en[nunit] = DST[e] + DPB[e] + DEN[e];
    nunit += 1;
    i += 1;
  );
);

function kal_pms() local(t, pos, lpos, f0, lf0, m, tm)
(
  lpos = 0; lf0 = 120; npm = 0; tm = 0;
  t = 0;
  loop(ntg,
    pos = tg_pos[t]; f0 = tg_f0[t];
    tm != pos ? (
      m = f32(f32(f0 - lf0)/f32(pos - lpos));
      while (tm < pos) (
        tm += 1/(lf0 + ((tm - lpos)*m));
        pm_t[npm] = (8000*tm)|0;
        npm += 1;
      );
    );
    lf0 = f0; lpos = pos;
    t += 1;
  );
);


function tok_s(tok, pid) ( ffeat(tok, pid); FT == 2 ? FV : S_ZERO; );
function tw14(tok, name) ( -1; );
<?
k = 13;
loop(14,
  printf("function tw%d(tok, name) local(r, nsw, tname, p, aaa, bbb, ccc, i, j, n, c, tv, rname, pn, nn, street, saint, segs, nsg, t, ok)\n", k);
  printf("(\n");
  printf("  r = -1;\n");
  printf("  n = SP_L[name];\n");
  printf("  it_present(tok, K_phones) ? lv_new(name, -1) : (\n");
  printf("  nsw = it_present(tok, K_nsw) ? it_fv(tok, K_nsw) : W_EMPTY;\n");
  printf("  tname = it_fv(tok, K_name);\n");
  printf("  it_present(tok, K_ssml_alias) && tname != name ? (\n");
  printf("    it_fv(tok, K_ssml_alias) == tok_s(tok, PTH_T_PSSML) ? -1 : lv_new(it_fv(tok, K_ssml_alias), -1);\n");
  printf("  ) : (\n");
  printf("  it_present(tok, K_ssml_comment) && it_fv(tok, K_ssml_comment) == W_1 ? (r = -1)\n");
  printf("  : (name == W_a || name == W_9a) && (item_next(tok) < 0 || name != tname || tok_s(tok, PTH_PUNC) != W_EMPTY) ? (r = lv_new(W_Ua, -1))\n");
