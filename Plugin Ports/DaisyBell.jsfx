            pos += 1;
          ) : a == 32 ? (
            ph_idx[pm] == 60 ? (ph_idx[pos] = 38);
            pos += 1;
          ) : a == 60 ? (
            idx = ph_idx[(pos+1) & 255];
            (idx != 255 && !(t_fl[idx] & 32)) ? (ph_idx[pos] = 63);
            pos += 1;
          ) : (
            a == 72 ? ( y = ph_idx[(pos+1) & 255]; (y == 255 || !(t_fl[y] & 32)) ? (ph_idx[pos] = 75); );
            y = ph_idx[pos];
            !(t_fl[y] & 1) ? (a = ph_idx[x]; lbl = 1;)
            : ph_idx[pm] != 32 ? (a = y; lbl = 3;)
            : (ph_idx[pos] = y - 12; pos += 1;);
          );
        );
      );
      lbl == 1 ? (
        a == 53 ? ( (t_fl2[ph_idx[(x-1) & 255]] & 4) ? (ph_idx[x] = 16); pos += 1; )
        : (a == 42 || a == 44) ? ( sam_ins(x+1, a+1, 0, ph_str[x]); pos += 1; )
        : (lbl = 3);
