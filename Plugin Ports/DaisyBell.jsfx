function hal_phstr(dest) local(sg, nm, j, k, n, c)
(
  n = 0; sg = RL_H[R_Segment];
  while (sg >= 0 && n < 900) (
    nm = it_fv(sg, K_name);
    nm == S_PAU ? (
      n > 0 && item_next(sg) >= 0 ? (TN_B2[n] = 47; TN_B2[n + 1] = 32; n += 2;);
    ) : (
      k = 0; loop(SP_L[nm], c = SP_B[SP_O[nm] + k]; TN_B2[n] = c >= 97 && c <= 122 ? c - 32 : c; n += 1; k += 1;);
      TN_B2[n] = 32; n += 1;
    );
    sg = item_next(sg);
  );
  strcpy(dest, ""); str_setlen(dest, n);
  j = 0; loop(n, str_setchar(dest, j, TN_B2[j]); j += 1;);
);

hal_ok = hal_load("DaisyBell/DaisyBell-HAL.wav") || hal_load("Dependencies/DaisyBell/DaisyBell-HAL.wav");
hal_ok ? hal_unpack();
SQ_BEAT = 0.3;
sq_n = alloc(20); sq_d = alloc(20);
#sq_dat = "673643603553571591601572601556623673643603571591601622641626";
function sq_dig(p, n) local(v) ( v = 0; loop(n, v = v*10 + str_getchar(#sq_dat, p) - 48; p += 1;); v; );
u_i = 0;
loop(20,
  sq_n[u_i] = sq_dig(u_i*3, 2);
  sq_d[u_i] = sq_dig(u_i*3 + 2, 1);
  u_i += 1;
);
sl_key[0] = sl_key[1] = -1;

blk_ver = 0;
cur = 0; bend = 0;

function slot_buf(s) ( s ? sl_buf1 : sl_buf0; );

function set_rate() ( gain_k = 1 - exp(-1/(0.01*srate)); rel_step = 1/(0.006*srate); att_step = 1/(0.002*srate); dc_r = exp(-2*$pi*20/srate); rate_base = 22050/srate; );

function fill_text(src, st, n) local(i)
(
  n = max(0, min(n, TXT_MAX - 2));
  i = 0; loop(n, rc_in[i] = str_getchar(src, st + i, 'cu'); i += 1; );
  rc_in[n] = 32;
  n + 1;
);

function make_preview() local(n, m, i, k)
(
  n = fill_text(#mtext, 0, strlen(#mtext));
  s_bad = -1; ph_err = 0;
  phonetic ? (
    m = sam_phon(n);
    sam_busy ? (memcpy(sam_sv, ph_idx, 256); memcpy(sam_sv + 256, ph_str, 256););
    !sam_chunks(m) ? (ph_err = 1; ph_bad = s_bad;);
    sam_busy ? (memcpy(ph_idx, sam_sv, 256); memcpy(ph_str, sam_sv + 256, 256););
  ) : (
    m = sam_reciter(n);
    m <= 0 ? (ph_err = 2; m = 1;);
  );
  k = min(m - 1, 900);
  strcpy(#phon, "");
  str_setlen(#phon, max(k, 0));
  i = 0; loop(k, str_setchar(#phon, i, rc_out[i]); i += 1; );
  ph_ver += 1;
);

function voice_key() ( speed + 256*(mouth + 256*(throat + 256*(sing + 2*phonetic + 4*engine))); );

function start_voice(src, st, n, seg, note, vel, ofs) local(p, pr, pc, s, key, i)
(
  keytrack && note >= 0 ? (
    pr = 6805.56 / (440*2^((note - 69)/12));
    pc = sing ? 0 : 7;
    p = max(10, min(255, floor(pr + pc + 0.5)));
  ) : (
    pr = p = pitch; pc = 0;
  );
  engine ? (
    p = keytrack && note >= 0 ? 440*2^((note - 69)/12) : engine == 2 ? 6080/pitch : 6805.56/pitch;
    pr = p; pc = 0;
  );
  key = voice_key();
  s = 1 - cur;
  kl_busy && kl_slot == s ? (kl_busy = 0);
  hal_busy && hal_slot == s ? (hal_busy = 0);
  sam_busy = 0;
  !(seg != -2 && sl_key[s] == key && sl_seg[s] == seg && sl_pit[s] == p && sl_ver[s] == blk_ver) ? (
    s_pitch = p; s_speed = speed; s_mouth = mouth; s_throat = throat; s_sing = sing; s_phon = phonetic;
    sl_on[s] = 0;
    engine == 2 ? (
      n = min(n, 4000);
      i = 0; loop(n, TS_IN[i] = str_getchar(src, st + i, 'cu'); i += 1;);
      memset(slot_buf(s), 128, 8);
      hal_slot = s; hal_key = key;
      hal_busy = hal_ok && hal_prepare(n, p/95, sing ? p : 0, f32(1.1)*speed/72);
      hal_ok ? hal_phstr(hal_demo_flag ? #halph_demo : #halph);
      hal_busy ? (hal_busy = hal_step(2, slot_buf(s), SLOT_N, 0); sl_len[s] = hk_wp;) : (sl_len[s] = 0);
      sl_key[s] = hal_busy ? -1 : key;
    ) : engine ? (
      s_dst = slot_buf(s); s_cap = SLOT_N; memset(s_dst, 128, 8);
      kl_prepare(fill_text(src, st, n), p, sing);
      kl_busy = 1; kl_slot = s; kl_key = key;
      loop(2, kl_busy ? (kl_busy = kl_frame()); );
      sl_len[s] = kl_wp;
      sl_key[s] = kl_busy ? -1 : key;
    ) : (
      sam_busy = sam_begin(slot_buf(s), SLOT_N, fill_text(src, st, n));
      sam_slot = s; sam_key = key;
      sl_len[s] = 0;
      sl_key[s] = sam_busy ? -1 : key;
    );
    sl_seg[s] = seg; sl_pit[s] = p; sl_ver[s] = blk_ver;
    s_err ? (spk_err = 1);
  );
  sl_on[cur] ? (sl_rel[cur] = 1);
  sl_on[s] = sl_len[s] > 8 || (kl_busy && kl_slot == s) || (sam_busy && sam_slot == s) || (hal_busy && hal_slot == s); sl_pos[s] = 0; sl_env[s] = 0; sl_rel[s] = 0; sl_dly[s] = ofs;
  sl_ratio[s] = engine == 2 ? 8000/22050 : (p - pc)/pr; sl_gain[s] = vel/127*(engine == 1 ? 3.4 : 1); sl_note[s] = note; sl_word[s] = seg;
  cur = s;
);

function sq_syl(i)
(
  i == 0 || i == 2 ? "DEY6" : i == 1 || i == 3 || i == 13 ? "ZIY" : i == 4 ? "GIH6V" : i == 5 ? "MIY" : i == 6 ? "YOH6R" : i == 7 ? "AE6N" : i == 8 ? "SER" : i == 9 ? "DUW6"
  : i == 10 ? "AY6M" : i == 11 ? "/HAE6LF" : i == 12 ? "KREY6" : i == 14 ? "AO6L" : i == 15 ? "FOHR" : i == 16 ? "DHAX" : i == 17 ? "LAH6V" : i == 18 ? "AHV" : "YUW6";
);

function sq_note(ofs) local(v_sing, v_kt, v_ph, syl)
(
  v_sing = sing; v_kt = keytrack; v_ph = phonetic;
  sing = keytrack = phonetic = 1;
  syl = sq_syl(sq_i);
  start_voice(syl, 0, strlen(syl), -2, sq_n[sq_i], engine ? 55 : 110, ofs);
  sing = v_sing; keytrack = v_kt; phonetic = v_ph;
);

function release_all() ( sl_on[0] ? (sl_rel[0] = 1); sl_on[1] ? (sl_rel[1] = 1); );

function note_on(n, v, ofs)
(
  have_lyric ? (
    start_voice(#lyric, 0, strlen(#lyric), -2, n, v, ofs); have_lyric = 0;
  );
);

function text_event(len, ofs) local(t, st, i, c)
(
  t = MB[1]; st = 2;
  len > 3 && MB[2] == len - 3 ? (st = 3);
  (t >= 1 && t <= 7 && (text_type == 1 || t == text_type - 1) && len > st) ? (
    mt_type = t;
    strcpy(#mtext, ""); str_setlen(#mtext, min(len - st, TXT_MAX - 2));
    i = 0; loop(min(len - st, TXT_MAX - 2), c = MB[st + i]; str_setchar(#mtext, i, c < 32 ? 32 : c); i += 1; );
    mt_ver += 1;
    make_preview();
    textmode == 0 ? (
      start_voice(#mtext, 0, strlen(#mtext), -2, -1, 100, ofs);
    ) : (
      strcpy(#lyric, #mtext); have_lyric = 1;
    );
  );
);

set_rate();

@slider
last_srate != srate ? (
  last_srate = srate;
  set_rate();
);

@block
gain = 10^(vol_db/20)*0.5;
pv_key != phonetic ? (pv_key = phonetic; strlen(#mtext) > 0 ? make_preview(););

(play_state & 1) && !(last_ps & 1) ? (have_lyric = 0;);
!(play_state & 1) && (last_ps & 1) ? (release_all(); have_lyric = 0; sq_on = 0;);
last_ps = play_state;

while ((mlen = midirecv_buf(mofs, MB, 4096)) > 0) (
  mst = MB[0];
  mst == 0xFF ? (
    text_type > 0 ? text_event(mlen, mofs);
  ) : mst >= 0x80 && mst < 0xF0 && (midi_ch == 0 || (mst & 15) == midi_ch - 1) ? (
    mty = mst & 0xF0; m2 = MB[1] & 127; m3 = mlen > 2 ? MB[2] & 127 : 0;
    mty == 0x90 && m3 > 0 ? (
      note_on(m2, m3, mofs);
    ) : mty == 0x80 || mty == 0x90 ? (
      noteoff == 1 ? (
        sl_on[0] && sl_note[0] == m2 ? (sl_rel[0] = 1);
        sl_on[1] && sl_note[1] == m2 ? (sl_rel[1] = 1);
      );
    ) : mty == 0xE0 ? (
      bend = ((m3*128 + m2) - 8192)/8192*2;
    ) : mty == 0xB0 && (m2 == 120 || m2 == 123) ? (
      release_all(); have_lyric = 0; sq_on = 0;
    );
  );
);

engine != last_engine ? (
  engine == 2 && sq_on ? (sq_on = 0; release_all(););
  last_engine = engine;
);

hal_demo_req ? (
  hal_demo_req = 0; hal_demo_i = hal_demo_n % 2; hal_demo_n += 1;
  hal_demo_flag = 1;
  hal_demo_i == 0 ? start_voice("Just what do you think you're doing Dave?", 0, 42, -2, -1, 100, 0)
  : start_voice("I'm sorry Dave. I'm afraid I can't do that.", 0, 44, -2, -1, 100, 0);
  hal_demo_flag = 0;
  hal_demo_on = 1; hal_demo_slot = cur;
);
hal_demo_on && (cur != hal_demo_slot || !sl_on[hal_demo_slot]) ? (hal_demo_on = 0);

sq_req ? (
  sq_req = 0;
  sq_on ? (sq_on = 0; release_all();) : (sq_on = 1; sq_i = 0; sq_t = 0; sq_next = 0;);
);
sq_on ? (
  while (sq_i < 20 && sq_next < sq_t + samplesblock) (
    sq_note(max(0, floor(sq_next - sq_t)));
    sq_next += sq_d[sq_i]*SQ_BEAT*srate; sq_i += 1;
  );
  sq_t += samplesblock;
  sq_i >= 20 && sq_t > sq_next ? (sq_on = 0);
);

kl_busy ? (
  !sl_on[kl_slot] ? (kl_busy = 0) : (
    kl_n = 0; kl_cap = 2 + ceil(4*samplesblock*rate_base/KL_SPF);
    while (kl_busy && kl_n < kl_cap && kl_wp < sl_pos[kl_slot] + 0.3*KL_SR) ( kl_busy = kl_frame(); kl_n += 1; );
    sl_len[kl_slot] = kl_wp;
    !kl_busy ? (sl_key[kl_slot] = kl_key);
  );
);

sam_busy ? (
  !sl_on[sam_slot] ? (sam_busy = 0) : (
    sl_len[sam_slot] < sl_pos[sam_slot] + 0.3*22050 ? (
      sam_busy = sam_step();
      sl_len[sam_slot] = min((s_bp/50)|0, SLOT_N);
      !sam_busy ? (sl_key[sam_slot] = sam_key);
    );
  );
);

hal_busy ? (
  !sl_on[hal_slot] ? (hal_busy = 0) : (
    sl_len[hal_slot] < sl_pos[hal_slot] + 0.3*8000 ? (
      hal_tgt = sl_len[hal_slot] + 2*samplesblock*8000/srate + 8;
      while (hal_busy && sl_len[hal_slot] < hal_tgt) (
        hal_busy = hal_step(1, slot_buf(hal_slot), SLOT_N, sl_len[hal_slot]);
        sl_len[hal_slot] = hk_wp;
      );
      !hal_busy ? (sl_key[hal_slot] = hal_key);
    );
  );
);

bendf = 2^(bend/12);
playing = sl_on[0] || sl_on[1];

@sample
outv = 0;
s = 0;
loop(2,
  sl_on[s] ? (
    sl_dly[s] > 0 ? (sl_dly[s] -= 1) : (
      sb = slot_buf(s); sp = sl_pos[s]; si = sp|0; sf = sp - si; sn = sl_len[s];
      ym1 = si > 0 ? sb[si-1] : 128; y0 = sb[si]; y1 = si+1 < sn ? sb[si+1] : 128; y2 = si+2 < sn ? sb[si+2] : 128;
      hc1 = 0.5*(y1 - ym1); hc2 = ym1 - 2.5*y0 + 2*y1 - 0.5*y2; hc3 = 0.5*(y2 - ym1) + 1.5*(y0 - y1);
      sv = ((((hc3*sf + hc2)*sf + hc1)*sf + y0) - 128)/128;
      sl_rel[s] ? (
        sl_env[s] -= rel_step;
        sl_env[s] <= 0 ? (sl_env[s] = 0; sl_on[s] = 0;);
      ) : (sl_env[s] = min(1, sl_env[s] + att_step));
      outv += sv*sl_env[s]*sl_gain[s]*min(1, (sn - sp)*0.015);
      (kl_busy && kl_slot == s) || (sam_busy && sam_slot == s) || (hal_busy && hal_slot == s) ? (
        sp + 4 < sn ? (sl_pos[s] = sp + rate_base*sl_ratio[s]*bendf);
      ) : (
        sl_pos[s] = sp + rate_base*sl_ratio[s]*bendf;
        sl_pos[s] >= sn - 1 ? (sl_on[s] = 0);
      );
    );
  );
  s += 1;
);
dcy = outv - dcx + dc_r*dcy; dcx = outv;
gain_s += (gain - gain_s)*gain_k;
spl0 = spl1 = dcy*gain_s;
abs(spl0) > vu ? (vu = abs(spl0));

@gfx 800 400
!g_init ? (
  g_init = 1;
  lay_ver = -1;
  gfx_setimgdim(7, 400, 200);
);

gfx_dest = -1;
gfx_mode = 0;
u_sc = min(gfx_w/400, gfx_h/200);
u_sc = u_sc >= 1 ? floor(u_sc) : max(0.25, u_sc);
u_ox = floor((gfx_w - 400*u_sc)*0.5); u_oy = floor((gfx_h - 200*u_sc)*0.5);
wheel = mouse_wheel; mouse_wheel = 0;
wheel_once = 0;
mouse_down = mouse_cap & 1;
mouse_just_down = mouse_down && !last_down;
last_down = mouse_down;
u_mx = (mouse_x - u_ox)/u_sc; u_my = (mouse_y - u_oy)/u_sc;
gt = time_precise();

function hit(x, y, w, h) ( u_mx >= x && u_mx < x + w && u_my >= y && u_my < y + h; );
function hit_circle(cx, cy, rad) ( sqr(u_mx - cx) + sqr(u_my - cy) <= sqr(rad); );
function taper_pos(val, minv, maxv) ( (val - minv)/(maxv - minv); );
function taper_val(pos, minv, maxv) ( minv + pos*(maxv - minv); );
function ink() ( gfx_set(0.16, 0.13, 0.11, 1); );
function ink_dim() ( gfx_set(0.36, 0.31, 0.26, 1); );
function scr(b)
(
  engine == 2 ? (
    b == 0 ? gfx_set(0.09, 0.02, 0.02, 1) : b == 1 ? gfx_set(0.62, 0.16, 0.12, 1) : b == 2 ? gfx_set(0.86, 0.28, 0.20, 1) : gfx_set(1, 0.50, 0.38, 1);
  ) : engine ? (
    b == 0 ? gfx_set(0.03, 0.08, 0.04, 1) : b == 1 ? gfx_set(0.22, 0.55, 0.27, 1) : b == 2 ? gfx_set(0.32, 0.80, 0.38, 1) : gfx_set(0.50, 1, 0.55, 1);
  ) : (
    b == 0 ? gfx_set(0.20, 0.17, 0.56, 1) : b == 1 ? gfx_set(0.43, 0.41, 0.85, 1) : b == 2 ? gfx_set(0.56, 0.54, 0.96, 1) : gfx_set(0.72, 0.71, 1, 1);
  );
);

function px_w(str, tiny) local(n, i, c, w)
(
  n = strlen(str); i = 0; w = 0;
  loop(n, c = str_getchar(str, i, 'cu'); !(c >= 0x80 && c < 0xC0) ? (w += tiny ? 4 : 6); i += 1; );
  w;
);

function px_str(str, x, y, tiny, sc) local(n, i, c, gp, rr, bits, xx, run, ny, gw, adv)
(
  n = strlen(str); i = 0;
  ny = tiny ? 6 : 8; gw = tiny ? 4 : 5; adv = tiny ? 4 : 6;
  loop(n,
    c = str_getchar(str, i, 'cu');
    !(c >= 0x80 && c < 0xC0) ? (
      c >= 97 && c <= 122 ? (c -= 32);
      (c < 32 || c > 95) ? (c = 63);
      gp = (tiny ? g_ft : g_fb) + (c - 32)*ny;
      rr = 0;
      loop(ny,
        bits = gp[rr];
        bits ? (
          run = -1; xx = 0;
          loop(gw + 1,
            xx < gw && (bits >> (gw - 1 - xx)) & 1 ? (
              run < 0 ? (run = xx);
            ) : run >= 0 ? (
              gfx_rect(x + run*sc, y + rr*sc, (xx - run)*sc, sc);
              run = -1;
            );
            xx += 1;
          );
        );
        rr += 1;
      );
      x += adv*sc;
    );
    i += 1;
  );
  x;
);

function px_strc(str, cx, y, tiny) ( px_str(str, cx - floor(px_w(str, tiny)*0.5), y, tiny, 1); );

function bevel(x, y, w, h, up)
(
  up ? gfx_set(1, 1, 1, 0.45) : gfx_set(0, 0, 0, 0.30);
  gfx_rect(x, y, w, 1); gfx_rect(x, y, 1, h);
  up ? gfx_set(0, 0, 0, 0.30) : gfx_set(1, 1, 1, 0.45);
  gfx_rect(x, y + h - 1, w, 1); gfx_rect(x + w - 1, y, 1, h);
);

function btn(x, y, w, h, str, on, hot, dis) local(p)
(
  ink();
  gfx_rect(x - 1, y - 1, w + 2, h + 2);
  dis ? gfx_set(0.55, 0.52, 0.47, 1)
  : on ? gfx_set(0.96, 0.62, 0.18, 1)
  : hot ? gfx_set(0.40, 0.36, 0.33, 1) : gfx_set(0.31, 0.28, 0.26, 1);
  gfx_rect(x, y, w, h);
  bevel(x, y, w, h, !on);
  p = on ? 1 : 0;
  dis ? gfx_set(0.68, 0.65, 0.60, 1) : on ? ink() : gfx_set(0.96, 0.93, 0.85, 1);
  px_str(str, x + floor((w - px_w(str, 0))*0.5) + p, y + floor((h - 7)*0.5) + p, 0, 1);
);

function draw_knob(cx, cy, rad, pos, cr, cg, cb, valtext, minlabel, maxlabel, name, dis) local(ang0, ang1, ang, i)
(
  ang0 = -2.35619;
  ang1 =  2.35619;

  ink();
  gfx_circle(cx, cy, rad + 1, 1, 0);
  gfx_set(cr*0.55, cg*0.55, cb*0.55, 1);
  gfx_circle(cx, cy, rad, 1, 0);
  gfx_set(cr, cg, cb, 1);
  gfx_circle(cx, cy, floor(rad*0.72), 1, 0);
  gfx_set(1, 1, 1, 0.35);
  gfx_circle(cx - 3, cy - 3, 3, 1, 0);

  i = 0;
  loop(9,
    ang = ang0 + (ang1 - ang0) * (i / 8);
    gfx_set(0.96, 0.93, 0.85, 1);
    gfx_line(cx + sin(ang)*rad*0.80, cy - cos(ang)*rad*0.80, cx + sin(ang)*rad*0.98, cy - cos(ang)*rad*0.98, 0);
    i += 1;
  );

  ang = ang0 + (ang1 - ang0) * pos;
  gfx_set(0.08, 0.06, 0.05, 1);
  gfx_line(cx, cy, cx + sin(ang)*rad*0.85, cy - cos(ang)*rad*0.85, 0);
  gfx_line(cx + 1, cy, cx + 1 + sin(ang)*rad*0.85, cy - cos(ang)*rad*0.85, 0);

  dis ? ink_dim() : ink();
  dis ? px_strc(valtext, cx, cy - rad - 9, 1) : px_strc(valtext, cx, cy - rad - 11, 0);
  ink_dim();
  px_str(minlabel, cx - 2 - px_w(minlabel, 1), cy + rad + 3, 1, 1);
  px_str(maxlabel, cx + 3, cy + rad + 3, 1, 1);
  ink();
  px_strc(name, cx, cy + rad + 10, 0);
);

function knob(id, cx, val, minv, maxv, defv, fmt, name, cr, cg, cb, minlabel, maxlabel) local(newpos, cy, rad)
(
  cy = 134; rad = 12;
  k_dis ? (cr = cg = cb = 0.62;);
  !k_dis && mouse_just_down && hit_circle(cx, cy, rad + 4) ? (
    gt - k_click < 0.3 && k_last == id ? (
      val = defv; drag_target = 0;
    ) : (
      drag_target = id; drag_start_y = mouse_y; drag_start_pos = taper_pos(val, minv, maxv);
    );
    k_click = gt; k_last = id;
  );
  !k_dis && wheel != 0 && hit_circle(cx, cy, rad + 4) ? (
    drag_target = id; drag_start_y = mouse_y;
    drag_start_pos = max(0, min(1, taper_pos(val, minv, maxv) + wheel/120*0.02)); wheel_once = 1;
  );
  drag_target == id && (mouse_down || wheel_once) ? (
    mouse_down ? (mouse_cap |= 65536);
    newpos = max(0, min(1, drag_start_pos + (drag_start_y - mouse_y)/(80*u_sc)));
    val = taper_val(newpos, minv, maxv);
    fmt != 1 ? (val = floor(val + 0.5)) : (val = floor(val*10 + 0.5)/10);
  );
  draw_knob(cx, cy, rad, taper_pos(val, minv, maxv), cr, cg, cb, k_dis ? "SAM ONLY" : fmt == 0 ? sprintf(#kv, "%d", val) : fmt == 2 ? sprintf(#kv, "%d HZ", 6805.56/val + 0.5) : fmt == 4 ? sprintf(#kv, "%d HZ", 6080/val + 0.5) : fmt == 3 ? sprintf(#kv, "%d%%", 7200/val + 0.5) : sprintf(#kv, "%+.1fDB", val), minlabel, maxlabel, name, k_dis);
  val;
);

function layout(maxc) local(n, s, e, j)
(
  n = strlen(#mtext); nl = 0; s = 0;
  while (
    n - s <= maxc ? (e = n) : (
      e = s + maxc; j = e;
      while (j > s && str_getchar(#mtext, j) != 32) ( j -= 1; );
      j > s ? (e = j + 1);
    );
    g_ls[nl] = s; g_ln[nl] = e - s; nl += 1; s = e;
    s < n && nl < 390;
  );
);

function draw_lips(cx, cy, hw, op, ka, kb, lift) local(xx, t, e, ty, by, pt, pb)
(
  xx = -hw;
  loop(2*hw + 1,
    t = xx/hw; e = sqrt(max(0, 1 - t*t));
    ty = cy - floor(e*op*ka + 0.5) - floor((1 - e)*lift*max(0, 1 - op*4) + 0.5);
    by = cy + floor(e*op*kb + 0.5) - floor((1 - e)*lift*max(0, 1 - op*4) + 0.5);
    xx > -hw ? (
      gfx_line(cx + xx - 1, pt, cx + xx, ty, 0);
      gfx_line(cx + xx - 1, pb, cx + xx, by, 0);
    );
    pt = ty; pb = by;
    xx += 1;
  );
);

function draw_hal(cx, cy, op) local(gx, gy, d, t, b, k)
(
  b = 0.5 + 0.5*min(1, op*1.4);
  gy = -22;
  loop(22,
    gx = -22;
    loop(22,
      d = sqrt(sqr(gx + 1) + sqr(gy + 1));
      d <= 21 ? (
        d > 18 ? (
          k = gx + gy;
          k < -10 ? gfx_set(0.88, 0.89, 0.93, 1) : k < 8 ? gfx_set(0.60, 0.62, 0.67, 1) : gfx_set(0.33, 0.34, 0.38, 1);
        ) : d > 16 ? (
          gfx_set(0.04, 0.04, 0.05, 1);
        ) : (
          t = d/16;
          t < 0.14 ? gfx_set(b, b*0.92, b*0.55, 1)
          : t < 0.3 ? gfx_set(b, b*0.50, b*0.12, 1)
          : t < 0.55 ? gfx_set(b*0.86, b*0.10, b*0.06, 1)
          : t < 0.8 ? gfx_set(b*0.46, b*0.03, b*0.03, 1)
          : gfx_set(0.16, 0.01, 0.01, 1);
        );
        gfx_rect(cx + gx, cy + gy, 2, 2);
      );
      gx += 2;
    );
    gy += 2;
  );
  gfx_set(1, 1, 1, 0.55);
  gfx_rect(cx - 10, cy - 10, 4, 2); gfx_rect(cx - 12, cy - 8, 2, 4);
  gfx_set(1, 1, 1, 0.3);
  gfx_rect(cx + 8, cy + 8, 2, 2);
);

function draw_kbot(cx, cy, op, blink) local(lit, k)
(
  scr(op > 0.15 ? 3 : 1);
  gfx_rect(cx - 13, cy - 25, 3, 3); gfx_rect(cx + 11, cy - 25, 3, 3);
  scr(3);
  gfx_line(cx - 7, cy - 15, cx - 11, cy - 22, 0); gfx_line(cx + 7, cy - 15, cx + 11, cy - 22, 0);
  gfx_roundrect(cx - 14, cy - 16, 29, 30, 11, 0);
  gfx_rect(cx - 16, cy - 2, 2, 4); gfx_rect(cx + 15, cy - 2, 2, 4);
  gfx_roundrect(cx - 11, cy - 10, 23, 8, 3, 0);
  blink ? (
    gfx_rect(cx - 7, cy - 6, 5, 1); gfx_rect(cx + 3, cy - 6, 5, 1);
  ) : (
    gfx_circle(cx - 5, cy - 6, 2, 1, 0); gfx_circle(cx + 5, cy - 6, 2, 1, 0);
  );
  gfx_rect(cx - 7, cy + 3, 15, 1); gfx_rect(cx - 7, cy + 11, 15, 1);
  gfx_rect(cx - 7, cy + 3, 1, 9); gfx_rect(cx + 7, cy + 3, 1, 9);
  lit = op > 0.6 ? 3 : op > 0.3 ? 2 : op > 0.06 ? 1 : 0;
  k = 0;
  loop(3,
    scr(k < lit ? 3 : 1);
    gfx_rect(cx - 5, cy + 9 - k*2, 11, 1);
    k += 1;
  );
  scr(3);
  gfx_rect(cx - 4, cy + 14, 1, 3); gfx_rect(cx + 4, cy + 14, 1, 3);
);

function draw_bot(cx, cy, op, blink)
(
  scr(op > 0.15 ? 3 : 1);
  gfx_rect(cx - 1, cy - 25, 3, 3);
  scr(3);
  gfx_rect(cx, cy - 22, 1, 4);
  gfx_rect(cx - 13, cy - 18, 27, 1); gfx_rect(cx - 13, cy + 14, 27, 1);
  gfx_rect(cx - 15, cy - 16, 1, 29); gfx_rect(cx + 15, cy - 16, 1, 29);
  gfx_rect(cx - 14, cy - 17, 1, 1); gfx_rect(cx + 14, cy - 17, 1, 1);
  gfx_rect(cx - 14, cy + 13, 1, 1); gfx_rect(cx + 14, cy + 13, 1, 1);
  gfx_rect(cx - 18, cy - 6, 2, 9); gfx_rect(cx + 17, cy - 6, 2, 9);
  blink ? (
    gfx_rect(cx - 9, cy - 6, 5, 1); gfx_rect(cx + 5, cy - 6, 5, 1);
  ) : (
    gfx_rect(cx - 9, cy - 9, 5, 5); gfx_rect(cx + 5, cy - 9, 5, 5);
    scr(0); gfx_rect(cx - 8, cy - 8, 2, 2); gfx_rect(cx + 6, cy - 8, 2, 2);
  );
  scr(1);
  gfx_rect(cx - 12, cy + 1, 3, 1); gfx_rect(cx + 10, cy + 1, 3, 1);
  scr(3);
  draw_lips(cx, cy + 5, 7, op, 3, 5, 2);
);

function preset_get(n)
(
  n == 1 ? (u_ps = 72; u_pp = 64; u_pt = 128; u_pm = 128;)
  : n == 2 ? (u_ps = 72; u_pp = 64; u_pt = 110; u_pm = 160;)
  : n == 3 ? (u_ps = 92; u_pp = 60; u_pt = 190; u_pm = 190;)
  : n == 4 ? (u_ps = 82; u_pp = 72; u_pt = 110; u_pm = 105;)
  : n == 5 ? (u_ps = 82; u_pp = 32; u_pt = 145; u_pm = 145;)
  : (u_ps = 100; u_pp = 64; u_pt = 150; u_pm = 200;);
);

function menu_item(id, i)
(
  id == 1 ? (
    #u_mi = i == 0 ? "SAM" : i == 1 ? "ELF" : i == 2 ? "LITTLE ROBOT" : i == 3 ? "STUFFY GUY" : i == 4 ? "LITTLE OLD LADY" : "EXTRA-TERRESTRIAL";
  ) : id == 2 ? (
    #u_mi = i == 0 ? "OFF" : i == 1 ? "ANY TYPE" : i == 2 ? "TEXT" : i == 3 ? "COPYRIGHT" : i == 4 ? "TRACK NAME" : i == 5 ? "INSTRUMENT" : i == 6 ? "LYRIC" : i == 7 ? "MARKER" : "CUE POINT";
  ) : (
    i == 0 ? strcpy(#u_mi, "OMNI") : sprintf(#u_mi, "%d", i);
  );
  #u_mi;
);

function menu_geo(id) local(ax, ay, aw, ah)
(
  id == 1 ? (u_mn = 6; u_mc = 1; u_mw = 116; ax = 312; ay = 4; aw = 78; ah = 15; u_msel = u_pre - 1;)
  : id == 2 ? (u_mn = 9; u_mc = 1; u_mw = 76; ax = u_bx0; ay = 142; aw = u_bw; ah = u_bh; u_msel = text_type;)
  : (u_mn = 17; u_mc = 4; u_mw = 34; ax = u_bx1; ay = 142; aw = u_bw; ah = u_bh; u_msel = midi_ch;);
  u_mrw = u_mc*u_mw + 4; u_mrh = ceil(u_mn/u_mc)*11 + 4;
  u_mx0 = min(ax, 398 - u_mrw);
  u_my0 = ay + ah + 2 + u_mrh <= 198 ? ay + ah + 2 : ay - u_mrh - 2;
);

function menu_hit() local(c, r, i)
(
  i = -1;
  hit(u_mx0 + 2, u_my0 + 2, u_mc*u_mw, u_mrh - 4) ? (
    c = floor((u_mx - u_mx0 - 2)/u_mw); r = floor((u_my - u_my0 - 2)/11);
    i = r*u_mc + c;
    i >= u_mn ? (i = -1);
  );
  i;
);

function draw_menu(id) local(i, hv, ix, iy)
(
  menu_geo(id);
  gfx_set(0, 0, 0, 0.35);
  gfx_rect(u_mx0 + 2, u_my0 + 2, u_mrw, u_mrh);
  ink();
  gfx_rect(u_mx0 - 1, u_my0 - 1, u_mrw + 2, u_mrh + 2);
  gfx_set(0.79, 0.75, 0.65, 1);
  gfx_rect(u_mx0, u_my0, u_mrw, u_mrh);
  bevel(u_mx0, u_my0, u_mrw, u_mrh, 1);
  hv = menu_hit();
  i = 0;
  loop(u_mn,
    ix = u_mx0 + 2 + (i % u_mc)*u_mw; iy = u_my0 + 2 + floor(i/u_mc)*11;
    i == hv ? (gfx_set(0.96, 0.62, 0.18, 1); gfx_rect(ix, iy, u_mw, 11););
    ink();
    i == u_msel ? gfx_rect(ix + 3, iy + 4, 3, 3);
    px_str(menu_item(id, i), ix + 9, iy + 2, 0, 1);
    i += 1;
  );
);

u_pre = 0; u_i = 1;
loop(6, preset_get(u_i); speed == u_ps && pitch == u_pp && throat == u_pt && mouth == u_pm ? (u_pre = u_i); u_i += 1;);
engine && g_menu == 1 ? (g_menu = 0);
g_menu ? (
  while ((u_key = gfx_getchar()) > 0) ( u_key == 27 ? (g_menu = 0); );
  wheel = 0;
);
g_menu && mouse_just_down ? (
  menu_geo(g_menu);
  u_i = menu_hit();
  u_i >= 0 ? (
    g_menu == 1 ? (
      preset_get(u_i + 1);
