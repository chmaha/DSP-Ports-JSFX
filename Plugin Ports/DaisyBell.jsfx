    );
  );
  hk_wp = wp;
  go;
);

function hal_rd() local(v) ( file_var(HAL_FH, v); v*16777216; );

function hal_load(fn) local(nch, sr, i, n, a, ty, cnt, k, j, v, base, ok)
(
  ok = 0;
  HAL_FH = file_open(fn);
  HAL_FH >= 0 ? (
    nch = 0; sr = 0;
    file_riff(HAL_FH, nch, sr);
    nch == 1 && file_avail(HAL_FH) > 4 && hal_rd() == 7341 ? (
      hal_rd(); n = hal_rd(); cnt = hal_rd();
      file_mem(HAL_FH, HAL_SCV, n);
      i = 0; loop(n, HAL_SCV[i] *= 16777216; i += 1;);
      ok = 1;
      loop(cnt,
        a = hal_rd(); ty = hal_rd(); n = hal_rd();
        base = HAL_AB[a];
        ty == 0 ? (
          file_mem(HAL_FH, base, n) != n ? (ok = 0);
          i = 0; loop(n, base[i] *= 16777216; i += 1;);
        ) : ty == 1 ? (
          i = 0;
          while (i < n) (
            k = min(4096, ceil((n - i)/3));
            file_mem(HAL_FH, HAL_TMP, k);
            j = 0;
            loop(k,
              v = HAL_TMP[j]*16777216 + 8388608;
              i < n ? (base[i] = v & 255; i += 1;);
              i < n ? (base[i] = floor(v/256) & 255; i += 1;);
              i < n ? (base[i] = floor(v/65536) & 255; i += 1;);
              j += 1;
            );
          );
        ) : (
          i = 0;
          while (i < n) (
            k = min(2048, n - i);
            file_mem(HAL_FH, HAL_TMP, k*2);
            j = 0; loop(k, base[HAL_TMP[j*2]*16777216] = HAL_TMP[j*2 + 1]*16777216; j += 1;);
            i += k;
          );
        );
      );
    );
    file_close(HAL_FH);
  );
  ok;
);
