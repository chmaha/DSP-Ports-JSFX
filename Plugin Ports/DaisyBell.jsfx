  printf("      i = 0; loop(p, TN_B2[i] = sp_ch(name, i); i += 1;);\n");
  printf("      i = p; loop(n - p - 1, TN_B2[i] = sp_ch(name, i + 1); i += 1;);\n");
  printf("      r = tw%d(tok, sp_intern(TN_B2, n - 1));\n", k + 1);
  printf("    );\n");
  printf("  )\n");
  printf("  : rx_match(RX_digitsslashdigits, name) && name == tname ? (\n");
  printf("    p = sp_chr(name, 47);\n");
  printf("    aaa = sp_sub(name, 0, p); bbb = sp_tail(name, p + 1);\n");
  printf("    aaa == W_1 && bbb == W_2 ? (r = lv_new(W_a, lv_new(W_half, -1)))\n");
  printf("    : sp_atoi(aaa) < sp_atoi(bbb) ? (\n");
  printf("      r = lv_append(exp_num0(aaa), exp_ordinal(bbb));\n");
