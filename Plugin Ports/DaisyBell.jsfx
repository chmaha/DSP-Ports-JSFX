function sam_out(idx) local(b)
(
  s_bp += t_tt[s_oti*5 + idx]; s_oti = idx;
  b = (s_bp/50)|0;
  b + 5 < s_cap ? (
    s_dst[b] = s_ary[0]; s_dst[b+1] = s_ary[1]; s_dst[b+2] = s_ary[2]; s_dst[b+3] = s_ary[3]; s_dst[b+4] = s_ary[4];
  ) : s_full = 1;
);

function sam_out1(idx, v) ( s_ary[0] = s_ary[1] = s_ary[2] = s_ary[3] = s_ary[4] = v; sam_out(idx); );

function sam_trans(a, b) ( (((a*b) >> 8)*2) & 255; );

function sam_mouth_throat(m, t) local(p)
(
  p = 5;
  while (p < 30) ( t_f1[p] = sam_trans(m, t_mf[p]); t_f2[p] = sam_trans(t, t_tf[p]); p += 1; );
  p = 48;
  while (p < 54) ( t_f1[p] = sam_trans(m, t_mf2[p-48]); t_f2[p] = sam_trans(t, t_tf2[p-48]); p += 1; );
);

function sam_ins(p, idx, len, st) local(i)
(
  p = p & 255;
  i = 253;
  while (i >= p) ( ph_idx[i+1] = ph_idx[i]; ph_len[i+1] = ph_len[i]; ph_str[i+1] = ph_str[i]; i -= 1; );
  ph_idx[p] = idx; ph_len[p] = len; ph_str[p] = st;
);

function sam_parser1() local(x, pos, s1, s2, y, f, run, res)
(
  x = 0; pos = 0; run = 1; res = 0;
  memset(ph_str, 0, 256);
  while (run) (
    s1 = pin[x];
    s1 == 155 ? (
      ph_idx[pos & 255] = 255; run = 0; res = 1;
    ) : (
      x += 1; s2 = pin[x];
      f = -1; y = 0;
      while (f < 0 && y < 81) ( (t_sig1[y] == s1 && t_sig2[y] != 42 && t_sig2[y] == s2) ? (f = y); y += 1; );
      f >= 0 ? (
        ph_idx[pos & 255] = f; pos += 1; x += 1;
      ) : (
        y = 0;
        while (f < 0 && y < 81) ( (t_sig2[y] == 42 && t_sig1[y] == s1) ? (f = y); y += 1; );
        f >= 0 ? (
          ph_idx[pos & 255] = f; pos += 1;
        ) : (
          y = 8;
          while (s1 != t_stin[y] && y > 0) ( y -= 1; );
          y == 0 ? (run = 0; s_bad = x - 1;) : (ph_str[(pos-1) & 255] = y);
        );
      );
    );
    (x > 258 || pos > 250) ? (run = 0);
  );
  res;
);

function sam_parser2() local(pos, x, a, y, m58, lbl, done, x2, pm, idx, run, cnt)
(
  pos = 0; run = 1; cnt = 0;
