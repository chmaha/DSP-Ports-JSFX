            y = ph_idx[pm];
            y == 69 ? (ph_idx[pm] = 42) : y == 57 ? (ph_idx[pm] = 44) : (t_fl[y] & 128) ? (ph_idx[pos] = 18);
            pos += 1;
          ) : a == 24 ? (
