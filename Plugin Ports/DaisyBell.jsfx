function sam_main_begin()
(
  sam_mouth_throat(s_mouth, s_throat);
  memset(ph_len, 0, 256); memset(ph_str, 0, 256);
  ph_idx[255] = 32;
  gen_active = 0;
  sam_parser1() ? (
    sam_parser2(); sam_copystress(); sam_setlen(); sam_adjust(); sam_prolong();
    pr_x = 0; while (pr_x < 256 && ph_idx[pr_x] <= 80) ( pr_x += 1; ); pr_x < 256 ? (ph_idx[pr_x] = 255);
    sam_breath();
    pr_x = 0; pr_y = 0; pr_run = 1; pr_cnt = 0;
    1;
  ) : (pr_run = 0; 0);
);

function rc_rb(a, y) ( a >= 37541 ? t_rul2[a - 37541 + y] : t_rul1[a - 32000 + y]; );

function sam_reciter(n) local(it, ro, i, a, c, f, x, y, m56, m57, m58, m59, m60, m61, m62, m64, m65, m66, ok, run, res, found, pd, sd, brk, cnt, lim)
(
  it = rc_tmp + 2; ro = rc_out;
  it[-2] = it[-1] = 0; it[0] = 32;
  i = 0;
  loop(n,
    a = rc_in[i] & 127;
    a >= 112 ? (a = a & 95) : a >= 96 ? (a = a & 79);
    it[i+1] = a; i += 1;
