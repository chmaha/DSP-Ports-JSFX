            a = ph_idx[(x+1) & 255];
            (a != 255 && (t_fl[a] & 128)) ? (ph_idx[pos] = 30);
          );
          pos += 1;
        );
      );
    );
    pos = pos & 255; cnt += 1;
  );
);

function sam_copystress() local(pos, y, s, cnt)
(
  pos = 0; cnt = 0;
  while (ph_idx[pos] != 255 && cnt < 512) (
    y = ph_idx[pos];
    t_fl[y] & 64 ? (
      y = ph_idx[(pos+1) & 255];
      (y != 255 && (t_fl[y] & 128)) ? (
        s = ph_str[(pos+1) & 255];
        (s != 0 && !(s & 128)) ? (ph_str[pos] = s + 1);
      );
    );
    pos = (pos+1) & 255; cnt += 1;
  );
);

function sam_setlen() local(pos, s)
(
  pos = 0;
  while (pos < 256 && ph_idx[pos] != 255) (
    s = ph_str[pos];
    ph_len[pos] = (s == 0 || (s & 128)) ? t_len[ph_idx[pos]] : t_lens[ph_idx[pos]];
    pos += 1;
  );
);

function sam_adjust() local(x, idx, li, run, back, m56, a, cnt)
(
  x = 0; run = 1; cnt = 0;
  while (run && cnt < 1024) (
    idx = ph_idx[x];
    idx == 255 ? (run = 0) : !(t_fl2[idx] & 1) ? (x = (x+1) & 255) : (
      li = x; back = 1;
      while (back) (
        x = (x-1) & 255;
        x == 0 ? (back = 0; run = 0;) : (idx = ph_idx[x]; back = idx != 255 && !(t_fl[idx] & 128););
      );
      run ? (
        while (
          idx = ph_idx[x];
          (idx != 255 && (!(t_fl2[idx] & 32) || (t_fl[idx] & 4))) ? (a = ph_len[x]; ph_len[x] = ((a >> 1) + a + 1) & 255;);
          x = (x+1) & 255;
          x != li;
        );
        x = (x+1) & 255;
      );
    );
    cnt += 1;
  );
  li = 0; run = 1; cnt = 0;
  while (run && cnt < 1024) (
    x = li; idx = ph_idx[x];
    idx == 255 ? (run = 0) : (
      t_fl[idx] & 128 ? (
        x = (x+1) & 255; idx = ph_idx[x];
        m56 = idx == 255 ? 65 : t_fl[idx];
        !(t_fl[idx] & 64) ? (
          (idx == 18 || idx == 19) ? (
            x = (x+1) & 255; idx = ph_idx[x];
            (t_fl[idx] & 64) ? (ph_len[li] = (ph_len[li] - 1) & 255);
          );
        ) : !(m56 & 4) ? (
          m56 & 1 ? ( x = (x-1) & 255; m56 = ph_len[x] >> 3; ph_len[x] = (ph_len[x] - m56) & 255; );
        ) : (
          a = ph_len[(x-1) & 255]; ph_len[(x-1) & 255] = ((a >> 2) + a + 1) & 255;
        );
      ) : t_fl2[idx] & 8 ? (
        x = (x+1) & 255; idx = ph_idx[x];
        a = idx == 255 ? 0 : t_fl[idx] & 2;
        a ? (ph_len[x] = 6; ph_len[(x-1) & 255] = 5;);
      ) : t_fl[idx] & 2 ? (
        while ( x = (x+1) & 255; idx = ph_idx[x]; idx == 0; );
        (idx != 255 && (t_fl[idx] & 2)) ? (
          ph_len[x] = ((ph_len[x] >> 1) + 1) & 255;
          ph_len[li] = ((ph_len[li] >> 1) + 1) & 255;
        );
      ) : t_fl2[idx] & 16 ? (
        (t_fl[ph_idx[(x-1) & 255]] & 2) ? (ph_len[x] = (ph_len[x] - 2) & 255);
      );
      li = (li+1) & 255;
    );
    cnt += 1;
  );
);

function sam_prolong() local(pos, idx, x, a, ins, cnt)
(
  pos = 0; cnt = 0;
  while (ph_idx[pos] != 255 && cnt < 1024) (
    idx = ph_idx[pos]; ins = 0;
    t_fl[idx] & 2 ? (
      !(t_fl[idx] & 1) ? (ins = 1) : (
        x = pos;
        while ( x = (x+1) & 255; a = ph_idx[x]; a == 0; );
        ins = a == 255 || !((t_fl[a] & 8) || a == 36 || a == 37);
      );
    );
    ins ? (
      sam_ins(pos+1, idx+1, t_len[idx+1], ph_str[pos]);
      sam_ins(pos+2, idx+2, t_len[idx+2], ph_str[pos]);
      pos = (pos+3) & 255;
    ) : (pos = (pos+1) & 255);
    cnt += 1;
  );
);

function sam_breath() local(m54, m55, m66, x, idx, run, cnt)
(
  m54 = 255; m55 = 0; m66 = 0; run = 1; cnt = 0;
  while (run && cnt < 2048) (
    x = m66; idx = ph_idx[x];
    idx == 255 ? (run = 0) : (
      m55 = (m55 + ph_len[x]) & 255;
      m55 < 232 ? (
        (idx != 254 && (t_fl2[idx] & 1)) ? (
          x = (x+1) & 255; m55 = 0; sam_ins(x, 254, 0, 0); m66 = (m66+2) & 255;
        ) : (
          idx == 0 ? (m54 = x);
          m66 = (m66+1) & 255;
        );
      ) : m54 != 255 ? (
        x = m54; ph_idx[x] = 31; ph_len[x] = 4; ph_str[x] = 0;
        x = (x+1) & 255; m55 = 0; sam_ins(x, 254, 0, 0); x = (x+1) & 255; m66 = x;
      ) : (
        m55 = 0; sam_ins(x, 254, 0, 0); m66 = (x+1) & 255;
      );
    );
    cnt += 1;
  );
);

function sam_addinfl(m48) local(a, p1, cnt, inner)
(
  s49 = sX;
  sX = sX <= 30 ? 0 : sX - 30;
  cnt = 0;
  while (fr[sX] == 127 && cnt < 256) ( sX = (sX+1) & 255; cnt += 1; );
  a = fr[sX];
  cnt = 0;
  while (
    a = (a + m48) & 255; p1 = a; fr[sX] = a;
    inner = 1;
    while (inner) ( sX = (sX+1) & 255; inner = sX != s49 && fr[sX] == 255; );
    a = p1; cnt += 1;
    sX != s49 && cnt < 512;
  );
  sX = s49;
);

function sam_sample() local(a, x, ph, y, t)
(
  s49 = sY;
  x = ((s39 & 7) - 1) & 255;
  s53 = t_samp0[x]; s47 = min(x, 4);
  a = s39 & 248;
  a == 0 ? (
    ph = 255 - (fr[s49] >> 4); y = s66;
    while (
      a = t_smp[s47*256 + y];
      loop(8, (a & 128) ? sam_out1(3, 160) : sam_out1(4, 96); a = (a << 1) & 255; );
      y = (y+1) & 255; ph = (ph+1) & 255;
      ph != 0;
    );
    s66 = y;
  ) : (
    y = 255 - a;
    while (
      a = t_smp[s47*256 + y];
      loop(8,
        t = a; a = (a << 1) & 255;
        !(t & 128) ? ( sam_out1(1, (s53 & 15)*16); s53 == 0 ? sam_out1(2, 80); ) : sam_out1(2, 80);
      );
      y = (y+1) & 255;
      y != 0;
    );
  );
  s44 = 1; sY = s49;
);

function sam_render_setup() local(ph1, ph2, ph3, m38, m40, sc, m48, m36, m37, k, kb, m53s, i, run)
(
  o_idx[0] != 255 ? (
    s44 = 0; sX = 0; run = 1;
    while (run) (
      sY = s44; sA = o_idx[s44]; s56 = sA;
      sA == 255 ? (run = 0) : (
        sA == 1 ? sam_addinfl(1) : sA == 2 ? sam_addinfl(255);
        ph1 = t_strp[o_str[sY] + 1]; ph2 = o_len[sY]; sY = s56;
        while (
          fr[sX] = (s_pitch + ph1) & 255;
          fr[256+sX] = t_f1[sY]; fr[512+sX] = t_f2[sY]; fr[768+sX] = t_f3[sY];
          fr[1024+sX] = t_a1[sY]; fr[1280+sX] = t_a2[sY]; fr[1536+sX] = t_a3[sY];
          fr_scf[sX] = t_scf[sY];
          sX = (sX+1) & 255; ph2 = (ph2-1) & 255;
          ph2 != 0;
        );
        s44 = (s44+1) & 255;
        s44 == 0 ? (run = 0);
      );
    );

    s44 = 0; s49 = 0; sX = 0; run = 1;
    while (run) (
      sY = o_idx[sX]; sA = o_idx[sX+1]; sX += 1;
      sA == 255 ? (run = 0) : (
        sX = sA; s56 = t_brank[sA]; sA = t_brank[sY];
        sA == s56 ? ( ph1 = t_bout[sY]; ph2 = t_bout[sX]; )
        : sA < s56 ? ( ph1 = t_bin[sX]; ph2 = t_bout[sX]; )
        : ( ph1 = t_bout[sY]; ph2 = t_bin[sY]; );
        s49 = (s49 + o_len[s44]) & 255;
        sc = (s49 + ph2) & 255;
        ph3 = (s49 - ph1) & 255;
        m38 = (ph1 + ph2) & 255;
        !(((m38 - 2) & 255) & 128) ? (
          k = 0;
          loop(7,
            kb = k*256;
            m40 = m38;
            k == 0 ? (
              m36 = o_len[s44] >> 1; m37 = o_len[s44+1] >> 1;
              m40 = (m36 + m37) & 255; m37 = (m37 + s49) & 255; m36 = (s49 - m36) & 255;
              s53 = (fr[m37] - fr[m36]) & 255;
            ) : (
              s53 = (fr[kb+sc] - fr[kb+ph3]) & 255;
            );
            m40 ? (
              m53s = s53 >= 128 ? s53 - 256 : s53;
