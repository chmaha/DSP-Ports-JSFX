function sam_render_gen() local(skip, reload, f1, f2, f3, a1, a2, a3, i, mux)
(
  while (g_run && sam_bud > 0) (
    s39 = fr_scf[sY];
    skip = 0; reload = 0;
    s39 & 248 ? (
      sam_sample(); sY = (sY+2) & 255; g_m48 = (g_m48-2) & 255;
