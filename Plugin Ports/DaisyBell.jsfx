      sam_st = en; sam_bud -= 50;
      sam_main_begin() ? (sam_work = 1) : (s_err = 1; spk_err = 1);
    );
    sam_work ? (sam_work = sam_run());
  );
  sam_work || (sam_st < sam_m - 1 && !s_full);
);

