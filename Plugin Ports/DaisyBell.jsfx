?>
function textanalysis() local(t, w, l, word)
(
  utt_relation_create(R_Word);
  t = RL_H[R_Token];
  while (t >= 0) (
    NLV = 0;
    l = tw0(t, it_fv(t, K_name));
    while (l >= 0) (
      word = item_add_daughter(t, -1);
      it_set_s(word, K_name, LV_S[l]);
      LV_B[l] ? it_set_s(word, K_break, W_1);
      relation_append(R_Word, word);
      l = LV_N[l];
    );
    t = item_next(t);
  );
);

function hal_sp_reset() ( SP_N = SP_N0; SP_TOP = SP_TOP0; memcpy(SP_H, SP_H0, SP_HN); );

function add_res_dec(targ_size, targ, uunit, dec)
(
  uunit < targ_size ? memcpy(targ + idiv(targ_size - uunit, 2), dec, uunit) : memcpy(targ, dec + idiv(uunit - targ_size, 2), targ_size);
);

function hal_unit_setup() local(k)
(
  hk_ust = u_st[hk_u]; hk_uen = u_en[hk_u];
  hk_usz = 0; k = hk_ust; loop(hk_uen - hk_ust, hk_usz += KRSZ[k]; k += 1;);
  hk_te = u_te[hk_u];
  hk_ui = 0;
  hk_m = f32(hk_usz/(hk_te - hk_ts));
  hk_unew = 0;
);

function hal_prepare(n, shift, mono, stretch) local(t)
(
  hal_sp_reset(); utt_reset(); NLV = 0;
  F0_SHIFT = shift; DUR_STRETCH = stretch;
  tokenization(n); textanalysis(); pos_tagger(); phrasing(); lexical_insertion(); pause_insertion();
  cart_intonation(); cmu_postlex(); cart_duration(); us_f0_model();
  mono > 0 ? (t = RL_H[R_Target]; while (t >= 0) ( it_set_f(t, K_f0, f32(mono)); t = item_next(t); ););
  utt_to_kal(); kal_units(); kal_pms();
  npm > 0 ? (
    nsmp = pm_t[npm - 1];
    memset(RESB, 255, nsmp);
    hk_u = 0; hk_pi = 0; hk_ts = 0; hk_rpos = 0; hk_unew = 1;
    hk_ilmin = (f32(-4.226584)*32768)|0;
    hk_ilrng = (f32(8.130784)*2048)|0;
    memset(OBUF, 0, 11); hk_r = 0; hk_o = 10;
    1;
  ) : 0;
);

function hal_pm(wbuf, cap, wp) local(np, fb, k, j, v, cr, ci)
(
  np = nearest_pm(hk_ust, hk_uen, hk_ui);
  pm_f[hk_pi] = np;
  pm_s[hk_pi] = pm_t[hk_pi] - (hk_pi > 0 ? pm_t[hk_pi - 1] : 0);
  add_res_dec(pm_s[hk_pi], RESB + hk_rpos, KRSZ[np], KDEC + KDOFF[np]);
  hk_rpos += pm_s[hk_pi];
  hk_ui = f32(hk_ui + f32(pm_s[hk_pi]*hk_m));
  fb = KLPC + np*10;
  k = 0;
  loop(10, LCO[k] = idiv(idiv(idiv(fb[k], 2)*hk_ilrng, 2048) + hk_ilmin, 2); k += 1;);
  j = 0;
  loop(pm_s[hk_pi],
    v = U2S[RESB[hk_r]]*16384;
    cr = hk_o == 0 ? 10 : hk_o - 1;
    ci = 0;
    loop(10, v = w32(v + w32(LCO[ci]*OBUF[cr])); cr = cr == 0 ? 10 : cr - 1; ci += 1;);
    v = idiv(v, 16384);
    OBUF[hk_o] = v;
    wp < cap ? (wbuf[wp] = 128 + s16(v)*(128/32768); wp += 1;);
    hk_o = hk_o == 10 ? 0 : hk_o + 1;
    hk_r += 1;
  );
  hk_pi += 1;
  wp;
);

function hal_step(maxpm, wbuf, cap, wp) local(c, go)
(
  c = 0; go = 1;
  while (go && c < maxpm) (
    hk_u >= nunit || hk_pi >= npm ? (go = 0; hk_done = 1;) : (
      hk_unew ? hal_unit_setup();
      pm_t[hk_pi] <= hk_te ? (
        wp = hal_pm(wbuf, cap, wp); c += 1;
      ) : (
