  printf("    rx_match(RX_cst_rx_digits, tok_s(tok, PTH_T_PNAME)) && item_prev(tok) >= 0 ? (r = lv_new(W_and, r));\n");
  printf("  )\n");
  printf("  : (p = sp_chr(name, 45)) >= 0 ? (\n");
