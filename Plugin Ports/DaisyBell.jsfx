      : m57 == 0 ? ( it[m61] = 32; m56 += 1; ro[m56] = 32; )
      : !(m57 & 128) ? (run = 0)
      : ( m62 = 32000 + t_rlet[a - 65]; lim = 32000 + t_rul1n; found = 1; );
      found ? (
        ok = 0;
        while (!ok && run && m62 < lim - 2 && cnt < 200000) (
          cnt += 1;
          while ( m62 += 1; !(rc_rb(m62, 0) & 128) && m62 < lim; );
          y = 1; while (rc_rb(m62, y) != 40 && y < 255) ( y += 1; ); m66 = y;
