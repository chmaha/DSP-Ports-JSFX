function sam_run() local(a)
(
  gen_active ? sam_render_gen();
  while (!gen_active && pr_run && pr_cnt < 1024 && sam_bud > 0) (
    a = ph_idx[pr_x];
    a == 255 ? ( o_idx[pr_y] = 255; sam_render_setup(); pr_run = 0; )
    : a == 254 ? ( pr_x += 1; o_idx[pr_y] = 255; sam_render_setup(); pr_y = 0; )
    : a == 0 ? ( pr_x += 1 )
