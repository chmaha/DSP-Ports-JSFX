          x = m61; m60 = x; y = m66 + 1; ok = m62 < lim - 2; brk = 0;
          while (ok && !brk) (
            rc_rb(m62, y) != it[x] ? (ok = 0) : (
              y += 1;
              y == m65 ? (brk = 1) : (x += 1; m60 = x;);
            );
          );
          ok ? (
            m59 = m61; pd = 0;
            while (ok && !pd) (
              m66 -= 1; a = rc_rb(m62, m66); m57 = a;
              a & 128 ? (pd = 1) : t_rflag[a & 127] & 128 ? (
                x = m59 - 1; it[x] != m57 ? (ok = 0) : (m59 = x);
              ) : (
                x = m59 - 1; c = it[x]; f = t_rflag[c];
                a == 32 ? ( f & 128 ? (ok = 0) : (m59 = x); )
                : a == 35 ? ( f & 64 ? (m59 = x) : (ok = 0); )
                : a == 46 ? ( f & 8 ? (m59 = x) : (ok = 0); )
                : a == 38 ? ( f & 16 ? (m59 = x) : c != 72 ? (ok = 0) : ( x -= 1; c = it[x]; (c == 67 || c == 83) ? (m59 = x) : (ok = 0); ); )
                : a == 64 ? ( f & 4 ? (m59 = x) : (ok = 0); )
                : a == 94 ? ( f & 32 ? (m59 = x) : (ok = 0); )
                : a == 43 ? ( (c == 69 || c == 73 || c == 89) ? (m59 = x) : (ok = 0); )
                : a == 58 ? ( while (m59 > 0 && (t_rflag[it[m59 - 1]] & 32)) ( m59 -= 1; ); )
                : ( ok = 0; run = 0; );
