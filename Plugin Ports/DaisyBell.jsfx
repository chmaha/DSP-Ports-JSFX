  it[n+1] = 91; it[n+2] = it[n+3] = it[n+4] = it[n+5] = 0;
  m56 = -1; m61 = -1; run = 1; res = -1; cnt = 0;
  while (run && cnt < 200000) (
    cnt += 1;
    m61 += 1; a = it[m61]; m64 = a;
    a == 91 ? (
      m56 += 1; ro[m56] = 155; res = m56 + 1; run = 0;
    ) : (a == 46 && !(t_rflag[it[m61+1]] & 1)) ? (
      m56 += 1; ro[m56] = 46;
