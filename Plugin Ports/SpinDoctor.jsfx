slider1:rot_order=0<0,6,1{1st,2nd,3rd,4th,5th,6th,7th}>-Order
slider2:ch_order=0<0,1,1{ACN,FuMa}>-Channel Order
slider3:norm_type=1<0,2,1{N3D,SN3D,FuMa}>-Normalisation
slider4:use_rpy=0<0,1,1{Yaw-Pitch-Roll,Roll-Pitch-Yaw}>-Rotation Order
slider5:yaw=0<-180,180,0.01>-Yaw
slider6:pitch=0<-180,180,0.01>-Pitch
slider7:roll=0<-180,180,0.01>-Roll
slider8:qw=1<-1,1,0.001>-Quaternion W
slider9:qx=0<-1,1,0.001>-Quaternion X
slider10:qy=0<-1,1,0.001>-Quaternion Y
slider11:qz=0<-1,1,0.001>-Quaternion Z
slider12:flipyaw=0<0,1,1{Off,On}>-Flip Yaw
slider13:flippitch=0<0,1,1{Off,On}>-Flip Pitch
slider14:fliproll=0<0,1,1{Off,On}>-Flip Roll
slider15:flipquat=0<0,1,1{Off,On}>-Flip Quaternion

