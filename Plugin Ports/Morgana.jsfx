function ha_blit(img, k, tx, ty, tw, th, qx, qy) local(s2, ps, fx, fy, x0, y0, x1, y1)
(
  s2 = uscale * 0.5; ps = uscale / k;
  fx = HOX + qx * s2; fy = HOY + qy * s2;
  x0 = ceil(max(fx, CLX0)); y0 = ceil(max(fy, CLY0));
  x1 = floor(min(fx + tw * s2, CLX1)); y1 = floor(min(fy + th * s2, CLY1));
  (x1 > x0 && y1 > y0) ? gfx_blit(img, 1, 0, tx * k * 0.5 + (x0 - fx) / ps, ty * k * 0.5 + (y0 - fy) / ps, (x1 - x0) / ps, (y1 - y0) / ps, x0, y0, x1 - x0, y1 - y0);
);

function ha_ramp(y) ( max(0, min(1, (165 - y) / 145)) ^ 1.2; );

function ha_cr(x, sd) local(i, f, a, b, c, d)
(
  i = floor(x); f = x - i;
  a = ha_h(i - 1 + sd * 101); b = ha_h(i + sd * 101); c = ha_h(i + 1 + sd * 101); d = ha_h(i + 2 + sd * 101);
  b + 0.5 * f * (c - a + f * (2 * a - 5 * b + 4 * c - d + f * (3 * (b - c) + d - a)));
);

function ha_hrows(img, k) local(s2, ps, j, j0, j1, y2, rp, sy, fx, x0, x1)
(
  s2 = uscale * 0.5; ps = uscale / k;
  gfx_set(1, 1, 1, 1, 0);
  j0 = max(CLY0, ceil(HOY + AHY * s2)); j1 = min(CLY1, floor(HOY + (AHY + AHH) * s2));
  j = j0;
  while (j < j1) (
    y2 = (j + 0.5 - HOY) / s2;
    rp = ha_ramp(y2);
    sy = (y2 - rp * ha_nd - AHY) * k * 0.5 - 0.5 / ps;
    sy = max(0, min(AHH * k * 0.5 - 1 / ps, sy));
    fx = HOX + (AHX + rp * ha_ln) * s2;
    x0 = ceil(max(fx, CLX0)); x1 = floor(min(fx + AHW * s2, CLX1));
    x1 > x0 ? gfx_blit(img, 1, 0, (x0 - fx) / ps, sy, (x1 - x0) / ps, 1 / ps, x0, j, x1 - x0, 1);
    j += 1;
  );
);

function hw_gust(ge) ( ge < 0 ? 0 : ge < 0.9 ? sin(0.5 * $pi * ge / 0.9) : exp(-(ge - 0.9) / 1.8) - 0.22 * exp(-(ge - 0.9) / 3.5) * min(1, (ge - 0.9) / 1.5); );

function hw_W(tt) local(g)
(
  g = tt >= hw_gs ? hw_gust(tt - hw_gs) : hw_gust(tt - hw_gp);
  0.45 + 0.32 * ha_cr(tt * 0.33, 61) + 0.18 * ha_cr(tt * 0.9, 62) + 0.8 * hw_gk * g;
);

function hw_field(t) local(n, j, i, p, xn, yn, w, wy, m, amp)
(
  amp = ha_a * 6.2;
  n = 0; j = 0;
  loop(kw_ny + 1,
    yn = min(kw_y1, kw_y0 + j * kw_c);
    i = 0;
    loop(kw_nx,
      p = KWT + n * 5;
      w = p[0]; wy = p[1];
      (w > 0.002 || wy > 0.002) ? (
        xn = i * kw_c;
        m = amp * (hw_W(t - p[4]) - 0.45 * ha_a) + amp * 0.1 * sin(2 * $pi * (t / 1.7 - p[4] / 0.55) + xn / 40);
        KWX[n] = w * p[2] * m;
        KWY[n] = -wy * p[3] * 0.22 * m;
      ) : ( KWX[n] = 0; KWY[n] = 0; );
      n += 1; i += 1;
    );
    j += 1;
  );
);

function hw_at(x, y) local(fi, fj, i, j, u, v, n, xa, xb)
(
  fj = (y - kw_y0) / kw_c;
  (fj < 0 || fj > kw_ny) ? ( hw_y = 0; 0; ) : (
    fi = x / kw_c; fi = max(0, min(kw_nx - 1.0001, fi));
    i = floor(fi); u = fi - i; j = min(kw_ny - 1, floor(fj)); v = fj - j;
    n = j * kw_nx + i;
    hw_y = (KWY[n] * (1 - u) + KWY[n + 1] * u) * (1 - v) + (KWY[n + kw_nx] * (1 - u) + KWY[n + kw_nx + 1] * u) * v;
    (KWX[n] * (1 - u) + KWX[n + 1] * u) * (1 - v) + (KWX[n + kw_nx] * (1 - u) + KWX[n + kw_nx + 1] * u) * v;
  );
);

function hw_draw(s, xb, poy, ytop, ybot) local(j, i, n0, n1, xa, xc, ya, yc, cw, chh, s00, t00, s10, t10, s01, t01, s11, t11, mx, smx, tmn, tmx, xr)
(
  smx = xb - 1.01; tmn = ytop; tmx = ybot - 1.01;
  gfx_set(1, 1, 1, 1, 0);
  j = 0;
  loop(kw_ny,
    ya = floor(poy + min(kw_y1, kw_y0 + j * kw_c) * s); yc = min(ybot, floor(poy + min(kw_y1, kw_y0 + (j + 1) * kw_c) * s));
    chh = yc - ya;
    i = 0;
    chh > 0 ? loop(kw_nx - 1,
      n0 = j * kw_nx + i; n1 = n0 + kw_nx;
      mx = max(max(abs(KWX[n0]), abs(KWX[n0 + 1])), max(abs(KWX[n1]), abs(KWX[n1 + 1])));
      mx = max(mx, max(max(abs(KWY[n0]), abs(KWY[n0 + 1])), max(abs(KWY[n1]), abs(KWY[n1 + 1]))));
      xa = floor(i * kw_c * s); xr = i == kw_nx - 2 ? kw_w : (i + 1) * kw_c; xc = min(xb, floor(xr * s));
      cw = xc - xa;
      (mx > 0.03 && cw > 0) ? (
        s00 = max(0, min(smx, xa - KWX[n0] * s)); t00 = max(tmn, min(tmx, ya - KWY[n0] * s));
        s10 = max(0, min(smx, xc - KWX[n0 + 1] * s)); t10 = max(tmn, min(tmx, ya - KWY[n0 + 1] * s));
        s01 = max(0, min(smx, xa - KWX[n1] * s)); t01 = max(tmn, min(tmx, yc - KWY[n1] * s));
        s11 = max(0, min(smx, xc - KWX[n1 + 1] * s)); t11 = max(tmn, min(tmx, yc - KWY[n1 + 1] * s));
        gfx_deltablit(10, s00, t00, gfx_w, gfx_h, xa, ya, cw, chh,
          (s10 - s00) / cw, (t10 - t00) / cw, (s01 - s00) / chh, (t01 - t00) / chh,
          (s11 - s10 - s01 + s00) / (cw * chh), (t11 - t10 - t01 + t00) / (cw * chh), 0);
      );
      i += 1;
    );
    j += 1;
  );
);

function ha_sil(sq) local(j, j1, y1, dx, sy, fx, x0, x1, bw, bh)
(
  bw = ha_bw; bh = ha_bh;
  gfx_set(1, 1, 1, 1, 0);
  j1 = min(bh, floor(kw_y0 * 2 * sq));
  gfx_blit(34, 1, 0, AFP * 0.5, 0, 202, kw_y0, 0, 0, 404 * sq, kw_y0 * 2 * sq);
  j = j1;
  while (j < bh) (
    y1 = (j + 0.5) / (2 * sq);
    dx = hw_at(ABR[min(ABR_N - 1, floor(y1))], y1);
    sy = max(0, min(ASH * 0.5 - 1, y1 - hw_y - 0.25 / sq));
    fx = (2 * dx - AFP) * sq;
    x0 = ceil(max(fx, 0)); x1 = floor(min(fx + AFW * sq, bw));
    x1 > x0 ? gfx_blit(34, 1, 0, (x0 - fx) / (2 * sq), sy, (x1 - x0) / (2 * sq), 0.5 / sq, x0, j, x1 - x0, 1);
    j += 1;
  );
);

function ha_sblit(x1, w1, y1, y2) local(xa, xc, ya, yc, r)
(
  r = ha_bw / (CLX1 - CLX0);
  xa = floor(x1 * uscale); xc = min(CLX1, floor((x1 + w1) * uscale));
  ya = CLY0 + floor(y1 * uscale); yc = min(CLY1, CLY0 + floor(y2 * uscale));
  (xc > xa && yc > ya) ? gfx_blit(40, 1, 0, xa * r, (ya - CLY0) * r, (xc - xa) * r, (yc - ya) * r, xa, ya, xc - xa, yc - ya);
);

function ha_smoke(t, img, k) local(s2, sq, bw, bh, od, j, lf, u, c, f, sd, rg, x0, y0, age, px, py, sz, env, av, gx, gy, v, ts, tg, dd, fx, fy, dx0, dy0, dw, sc, sx0)
(
  s2 = uscale * 0.5; sq = 0.25;
  bw = ceil((CLX1 - CLX0) / s2 * sq); bh = ceil((CLY1 - CLY0) / s2 * sq);
  (bw != ha_bw || bh != ha_bh) ? ( gfx_setimgdim(40, bw, bh); ha_bw = bw; ha_bh = bh; );
  od = gfx_dest;
  gfx_dest = 40;
  gfx_set(0, 0, 0, 1, 0); gfx_rect(0, 0, bw, bh);
  ts = ASM_T * k * 0.5; tg = ASM_G * k * 0.5;
  hw_wd = hw_W(t) - 0.6;
  j = 0;
  loop(26,
    lf = 8 + 5 * ha_h(j * 7.3 + 1);
    u = (t + ha_h(j * 3.1 + 2) * lf) / lf; c = floor(u); f = u - c;
    sd = c * 31.7 + j * 13.1;
    rg = ha_h(sd);
    rg < 0.55 ? ( x0 = 330 + 90 * ha_h(sd + 1); y0 = 760 + 520 * ha_h(sd + 2); ) :
    rg < 0.8 ? ( x0 = -40 + 140 * ha_h(sd + 1); y0 = 330 + 380 * ha_h(sd + 2); ) :
               ( x0 = 60 + 300 * ha_h(sd + 1); y0 = 230 + 200 * ha_h(sd + 2); );
    age = f * lf;
    py = y0 - (22 + 18 * ha_h(sd + 3)) * age;
    px = x0 + (3 + 5 * ha_h(sd + 4)) * age + (8 + 8 * ha_h(sd + 5)) * sin(2 * $pi * age / (5 + 4 * ha_h(sd + 6)) + 6.283 * ha_h(sd + 7))
       + 14 * hw_wd;
    sz = (110 + 90 * ha_h(sd + 8)) * (0.7 + 0.8 * f);
    env = (f < 0.25 ? (f / 0.25) * (f / 0.25) * (3 - 2 * f / 0.25) : 1) * (1 - f) ^ 1.3;
    av = env * (0.24 + 0.16 * ha_h(sd + 11)) * ha_a;
    gx = floor(px / AFD_C); gy = floor(py / AFD_C);
    dd = (gx >= 0 && gx < AFD_W && gy >= 0 && gy < AFD_H) ? AFD[gy * AFD_W + gx] : 0;
    (av >= 0.004 && dd < sz * 0.45 && px + sz * 0.5 > 0 && px - sz * 0.5 < 404 && py + sz * 0.5 > 0 && py - sz * 0.5 < 1226) ? (
      v = floor(ASM_N * ha_h(sd + 12));
      sc = sz * sq / ts;
      fx = (px - sz * 0.5) * sq; fy = (py - sz * 0.5) * sq;
      dx0 = ceil(fx); dy0 = ceil(fy);
      dw = ceil(sz * sq) + 2;
      sx0 = tg + v * (ts + tg);
      gfx_set(1, 1, 1, av, 1);
      gfx_blit(img, 1, 0, sx0 + (dx0 - fx) / sc, tg + (dy0 - fy) / sc, dw / sc, dw / sc, dx0, dy0, dw, dw);
    );
    j += 1;
  );
  ha_sil(sq);
  gfx_dest = od;
  gfx_set(1, 1, 1, 1, 3);
  ha_sblit(0, 202, 0, ABN_Y0);
  j = 0;
  loop(ABN_N,
    ha_sblit(0, ABN[2 * j], ABN_Y0 + j * ABN_H, ABN_Y0 + (j + 1) * ABN_H);
    ha_sblit(ABN[2 * j + 1], 202 - ABN[2 * j + 1], ABN_Y0 + j * ABN_H, ABN_Y0 + (j + 1) * ABN_H);
    j += 1;
  );
  gfx_set(1, 1, 1, 1, 0);
);

function ha_draw() local(on, t, k, v2, fi, hi, p, dx, dy, br, u, f, lv, j, s2, ps, gu, gi, gf, th0, th1, sm, th, env, dg, wg, tau, bl, rp, ycs, ge, g)
(
  !ha_t0 ? ( ha_t0 = time_precise(); ha_bs = -1000; ha_bn = 0; hw_gs = hw_gp = -1000; hw_gn = 0; hw_gk = 1; );
  t = time_precise() - ha_t0;
  on = (play_state & 1) && hc_anim > 0.5;
  ha_a = on ? ha_a + (1 - ha_a) * 0.02 : ha_a * 0.97;
  (on && !ha_on) ? ( ha_bn = max(ha_bn, t + 2 + 3 * ha_h(floor(t * 3.1))); hw_gn = max(hw_gn, t + 3); );
  (on && t >= hw_gn) ? ( hw_gp = hw_gs; hw_gs = t; hw_gn = t + 7 + 8 * ha_h(floor(t * 5.3) + 1); hw_gk = 0.7 + 0.5 * ha_h(floor(t * 2.9) + 7); );
  ha_on = on;
  (on && t >= ha_bn && t - ha_bs > 0.3) ? ( ha_bs = t; ha_bn = t + 6 + 9 * ha_h(floor(t * 7.7) + 3); );
  (g_mk && g_fx && ha_a >= 0.002) ? (
    k = (g_fx2 && uscale > 1.25 && (!g_v2 || g_v22)) ? 2 : 1; fi = k == 2 ? 27 : 26; hi = k == 2 ? 29 : 28;
    v2 = g_v2;
    s2 = uscale * 0.5; ps = uscale / k;
    HOX = 0; HOY = floor(ui_py(25));
    CLX0 = 0; CLY0 = HOY; CLX1 = min(floor(sbx - UQ), floor(404 * s2)); CLY1 = HOY + floor(1226 * s2);
    ha_ln = ha_a * (2.3 * sin(2 * $pi * t / 8.9 + 0.6) + 1.4 * (ha_n(t * 0.4, 3) - 0.5) + 0.3 * sin(2 * $pi * t / 2.3));
    ha_nd = ha_a * 0.9 * sin(2 * $pi * t / 7.1 + 1.3);
    v2 ? (
      hw_field(t);
      hw_draw(uscale, CLX1, HOY, CLY0, CLY1);
    );
    j = 0;
    loop(AFF_N,
      p = AFF + j * 13;
      gfx_set(1, 1, 1, ha_a, 0);
      ha_blit(fi, k, p[0], p[1], p[2], p[3], p[4], p[5]);
      dx = (2.6 * sin(2 * $pi * t / (9 + 2.3 * j) + j * 1.7) + 1.2 * (ha_n(t * 0.35, 20 + j) - 0.5)) * ha_a * p[12];
      dy = 2 * sin(2 * $pi * t / (11.5 + 1.9 * j) + j * 0.9) * ha_a * p[12];
      br = 0.62 + 0.55 * ha_n(t * 0.45 + 3 * j, 40 + j);
      gfx_set(1, 1, 1, (1 - ha_a + ha_a * br) * ha_a, 1);
      ha_blit(fi, k, p[6], p[7], p[8], p[9], p[10] + dx, p[11] + dy);
      j += 1;
    );
    j = 0;
    loop(AST_N,
      p = AST + j * 8;
      u = (t + p[6]) / p[7]; f = u - floor(u);
      abs(f - 0.5) < 0.2 ? (
        lv = exp(-sqr((f - 0.5) / 0.09)) * (0.35 + 0.65 * ha_h(floor(u) + j)) * ha_a;
        lv >= 0.01 ? (
          ycs = p[5] + p[3] * 0.5;
          v2 ? ( dx = 2 * hw_at((p[4] + p[2] * 0.5) * 0.5, ycs * 0.5); dy = 2 * hw_y; ) : ( dx = 0; dy = 0; );
          gfx_set(1, 1, 1, lv * 0.33, 1); ha_blit(fi, k, p[0], p[1], p[2], p[3], p[4] + dx, p[5] + dy);
        );
      );
      j += 1;
    );
    g_hd ? ha_hrows(hi, k);
    v2 ? ha_smoke(t, k == 2 ? 37 : 36, k);
    tau = t - ha_bs;
    bl = tau < 0.08 ? tau / 0.08 : tau < 0.13 ? 1 : tau < 0.26 ? 1 - (tau - 0.13) / 0.13 : 0;
    bl *= min(1, ha_a * 1.5);
    bl > 0 ? (
      rp = ha_ramp(133);
      gfx_set(1, 1, 1, bl, 0);
      ha_blit(fi, k, ABL[0], ABL[1], ABL[2], ABL[3], ABL[4] + rp * ha_ln, ABL[5] + rp * ha_nd);
    );
    gu = (t - 2) / 5; gi = floor(gu); gf = (gu - gi) * 5;
    gf < 3 ? (
      ha_h(gi + 5) < 0.5 ? ( th0 = -0.15 * $pi; th1 = 1.15 * $pi; ) : ( th0 = 1.15 * $pi; th1 = -0.15 * $pi; );
      sm = gf / 3; sm = sm * sm * (3 - 2 * sm);
      th = th0 + (th1 - th0) * sm;
      env = sin($pi * gf / 3) * ha_a;
      j = 0;
      loop(AGL_N,
        p = AGL + j * 7;
        dg = p[6] - th; dg -= 2 * $pi * floor(dg / (2 * $pi) + 0.5);
        wg = exp(-sqr(dg / 0.3)) * env;
        wg >= 0.004 ? ( gfx_set(1, 1, 1, wg, 1); ha_blit(fi, k, p[0], p[1], p[2], p[3], p[4], p[5]); );
        j += 1;
      );
    );
    gfx_set(1, 1, 1, 1, 0);
  );
);

function ui_hint(h) local(hv, gm)
(
  hv = slider(h); gm = ui_ival(1);
  h == 1 ? sprintf(#u_hint, "Type: %s", 170 + ui_ival(1)) :
  h == 2 || h == 3 ? sprintf(#u_hint, "%s: %.1f %%", 190 + h - 1, hv * 100) :
  h == 4 ? sprintf(#u_hint, "Param A (%s): %.1f %%", 120 + gm, hv * 100) :
  h == 5 ? sprintf(#u_hint, "Param B (%s): %.1f %%", 140 + gm, hv * 100) :
  h == 6 ? sprintf(#u_hint, "DC Couple: %s", hv > 0.5 ? "On" : "Off") :
  h == 7 ? sprintf(#u_hint, "Y Input: %s", 160 + ui_ival(7)) :
  h == 8 ? sprintf(#u_hint, "Mix: %.1f %%", hv) :
  h == 9 ? sprintf(#u_hint, "Output: %+.1f dB", hv) :
  h == 20 ? strcpy(#u_hint, "X input: track audio, pins 1/2") :
  h == 21 ? strcpy(#u_hint, "Y input: sidechain pins 3/4 (or as set below)") :
  h == 104 ? strcpy(#u_hint, "Click the picture to switch the animation off or on") :
  (u_ysil > 1.5 && hc_ysrc < 1.5) ? strcpy(#u_hint, "Y is silent: route pins 3/4 or set Y = track") :
  strcpy(#u_hint, "Double-click a knob to reset, Ctrl-drag for fine");
);

!u_init ? ( ui_inittables(); ha_init(); u_init = 1; u_lw = u_lh = -1; u_ysil = 0; u_tp = time_precise(); );

u_down = mouse_cap & 1;
u_click = u_down && !u_pd;
u_wheel = mouse_wheel;
mouse_wheel = 0;
u_hov = 0;

(gfx_w != u_lw || gfx_h != u_lh) ? ( ui_static(); u_lw = gfx_w; u_lh = gfx_h; );
gfx_set(1, 1, 1, 1); gfx_x = 0; gfx_y = 0;
gfx_blit(10, 1, 0);
ha_draw();

u_now = time_precise(); u_dt = min(0.5, max(0, u_now - u_tp)); u_tp = u_now;
u_lx0 = max(g_xl, u_lx0 * exp(-u_dt * 8)); u_lx1 = max(g_xr, u_lx1 * exp(-u_dt * 8));
u_ly0 = max(g_yl, u_ly0 * exp(-u_dt * 8)); u_ly1 = max(g_yr, u_ly1 * exp(-u_dt * 8));
(u_ly0 < 0.0005 && u_ly1 < 0.0005 && (u_lx0 > 0.003 || u_lx1 > 0.003)) ? u_ysil += u_dt : u_ysil = 0;
ui_lamp(ui_px(14.65), ui_py(38.37), 3.6 * UQ, 1, 0.62, 0.1, min(1, sqrt(u_lx0) * 1.4));
ui_lamp(ui_px(41.65), ui_py(38.37), 3.6 * UQ, 1, 0.62, 0.1, min(1, sqrt(u_lx1) * 1.4));
ui_lamp(ui_px(107.65), ui_py(38.37), 3.6 * UQ, 1, 0.62, 0.1, min(1, sqrt(u_ly0) * 1.4));
ui_lamp(ui_px(134.65), ui_py(38.37), 3.6 * UQ, 1, 0.62, 0.1, min(1, sqrt(u_ly1) * 1.4));
ui_hit(ui_px(4), ui_py(28), 50 * UQ, 34 * UQ) && u_hov == 0 ? u_hov = 20;
ui_hit(ui_px(96), ui_py(28), 50 * UQ, 34 * UQ) && u_hov == 0 ? u_hov = 21;

ui_led(6, 66.17, 38.89);
ui_knob(2, 60.0, 62.98, 9.9, 5);
ui_knob(3, 90.06, 62.98, 9.9, 5);
ui_display(1, 100 + ui_ival(1), 30, 91.5, 90, 20, 1, 170);
ui_knob(1, 74.99, 144.02, 15.87, 5);
ui_display(4, 120 + ui_ival(1), 33, 174, 84, 18.5, 0, 0);
ui_knob(4, 74.99, 212.95, 15.87, 3);
ui_display(5, 140 + ui_ival(1), 33, 245.5, 84, 18.5, 0, 0);
ui_knob(5, 74.99, 285.02, 15.87, 0);
ui_knob(8, 25, 296, 9.9, 5);
ui_knob(9, 125, 296, 9.9, 5);
ui_choice(7, 22, 338, 106, 15);
(u_hov == 0 && u_drag == 0 && g_mk && ui_hit(0, floor(ui_py(25)), floor(sbx - UQ), floor(613 * uscale))) ? (
  u_hov = 104;
  u_click ? ( ui_put(10, hc_anim > 0.5 ? 0 : 1); u_click = 0; );
);

u_drag > 0 ? (
  u_down ? (
    mouse_cap |= 65536;
    u_fine = mouse_cap & 4;
    u_fine != u_dfine ? ( u_dy0 = mouse_y; u_dv0 = ui_norm(u_drag); u_dfine = u_fine; );
    ui_setn(u_drag, u_dv0 + (u_dy0 - mouse_y) / (200 * uscale) * (u_fine ? 0.1 : 1));
  ) : (
    automate(u_drag, 1);
    u_drag = 0;
  );
);

gfx_set(0.82, 0.83, 0.85, 1);
ui_hint(u_drag > 0 ? u_drag : u_hov);
ui_font(11 * uscale, 0);
gfx_measurestr(#u_hint, u_tw, u_th);
u_tw > 144 * UQ ? ( ui_font(11 * uscale * 144 * UQ / u_tw, 0); gfx_measurestr(#u_hint, u_tw, u_th); );
gfx_x = floor(gfx_w * 0.5 - u_tw * 0.5); gfx_y = floor(ui_py(373.6) - u_th * 0.5);
gfx_drawstr(#u_hint);

u_pd = u_down;
