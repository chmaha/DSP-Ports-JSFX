desc: Morgana (Valley Amalgam port) by chmaha
tags: ring modulator signal combiner bitcrusher distortion sidechain
author: chmaha
version: 1.0
changelog:
  Initial release.
about:
  Stereo signal combiner: 17 ways to smash two stereo signals together, from ring modulators, a diode ring modulator,
  min/max, sign switches, a crossfader, a random flip-flop and pulse modulation to integer and float32 bit-logic glitches.
  X is the track audio (pins 1/2), Y is the sidechain (pins 3/4), or the track itself or a mono sidechain from the Y Input menu.
  Ported from Valley Amalgam by Dale Johnson (ValleyRackFree, https://github.com/ValleyAudio/ValleyRackFree, GPLv3+).
  Title lettering: Zarathustra by Lorene Ceccon (SIL Open Font License 1.1), rendered into the panel image.
  Sidebar image: Alphonse Mucha, "Clair de lune" from "La Lune et les étoiles" (1902), public domain;
  scan by the Bibliothèque nationale de France (Gallica btv1b90077190) via Wikimedia Commons.
  The picture is gently animated while the transport plays; click it to switch the animation off or on.
  JSFX version released under GPLv3+ license
  Claude generated some of this code
provides:
  Dependencies/Morgana/MorganaPanel.png
  Dependencies/Morgana/MorganaPanel2x.png
  Dependencies/Morgana/MorganaImage.png
  Dependencies/Morgana/MorganaImage2x.png
  Dependencies/Morgana/MorganaImage-LICENSE.txt
  Dependencies/Morgana/MorganaTitle.png
  Dependencies/Morgana/MorganaTitle2x.png
  Dependencies/Morgana/MorganaFx.png
  Dependencies/Morgana/MorganaFx2x.png
  Dependencies/Morgana/MorganaHead.png
  Dependencies/Morgana/MorganaHead2x.png
  Dependencies/Morgana/MorganaSil.png
  Dependencies/Morgana/MorganaSmoke.png
  Dependencies/Morgana/MorganaSmoke2x.png

slider1:hc_mode=0<0,16,1{Ring Mod 1,Ring Mod 2,Ring Mod 3,Diode Ring Mod,Min/Max,Sign Switch 1,Sign Switch 2,X-Fade,Flip-Flop,Alpha PWM,Bit AND,Bit XOR,Bit Interleave,Bit Glitch,Float32 AND,Float32 Interleave,Float32 Glitch}>-Type
slider2:hc_xg=1<0,4,0.001>-X Gain
slider3:hc_yg=1<0,4,0.001>-Y Gain
slider4:hc_a=0<0,1,0.001>-Param A
slider5:hc_b=0<0,1,0.001>-Param B
slider6:hc_dc=0<0,1,1{Off,On}>-DC Couple
slider7:hc_ysrc=0<0,2,1{Sidechain 3/4,Sidechain 3 (mono),Track (X)}>-Y Input
slider8:hc_mix=100<0,100,0.1>-Mix (%)
slider9:hc_out=0<-24,12,0.1>-Output (dB)
slider10:hc_anim=1<0,1,1{Off,On}>-Animation

in_pin:X Left
in_pin:X Right
in_pin:Y Left (sidechain)
in_pin:Y Right (sidechain)
out_pin:Left
out_pin:Right

options:no_meter

@init
ext_noinit = gfx_ext_retina = 1;
ext_nodenorm = 1;

ZV = 0;
function k32(x) local(t)
(
  t = x * 536870913;
  t = t - (t - x);
  abs(t) < 0.000000000000000000000000000000000000011754943508222875 ? ((x < 0 || (x === 0 && 1 / x < 0)) ? -ZV : ZV) : t;
);
function zq(v) ( k32(v); );

function trunc(x) ( x < 0 ? ceil(x) : floor(x); );
function cvtt(x) local(t) ( t = trunc(x); (t >= 2147483648 || t < -2147483648 || x !== x) ? -2147483648 : t; );
function daz(x) ( abs(x) < 0.000000000000000000000000000000000000011754943508222875 ? (x < 0 || (x === 0 && 1 / x < 0) ? -ZV : ZV) : x; );
function sgn0(v, s) ( v === 0 && (s < 0 || (s === 0 && 1 / s < 0)) ? -ZV : v; );


ET = 0;
mem_set_values(ET, 1.0, 1.0218971486541166, 1.0442737824274138, 1.0671404006768237, 1.0905077326652577, 1.1143867425958924, 1.1387886347566916, 1.1637248587775775, 1.189207115002721, 1.215247359980469, 1.241857812073484, 1.2690509571917332, 1.2968395546510096, 1.3252366431597413, 1.3542555469368927, 1.383909881963832, 1.4142135623730951, 1.4451808069770467, 1.4768261459394993, 1.5091644275934228, 1.5422108254079407, 1.5759808451078865, 1.6104903319492543, 1.645755478153965, 1.681792830507429, 1.718619298122478, 1.7562521603732995, 1.7947090750031072, 1.8340080864093424, 1.8741676341103, 1.9152065613971474, 1.9571441241754002);
OUTSC = 0.1;
EINV = 46.16624130844683;
ESH = 6755399441055744;
EC0 = 0.0000016938359250920212;
EC1 = 0.00023459809789509004;
EC2 = 0.021660849396613134;
function fma(a, b, c) local(p, e, t, ah, al, bh, bl, s, bb, w)
(
  p = a * b;
  t = 134217729 * a; ah = t - (t - a); al = a - ah;
  t = 134217729 * b; bh = t - (t - b); bl = b - bh;
  e = (((ah * bh - p) + ah * bl) + al * bh) + al * bl;
  s = p + c; bb = s - p; w = (p - (s - bb)) + (c - bb);
  s + (w + e);
);
function exp_core(z) local(kd, r, ki, i, k, s, zz, r2, y)
(
  kd = (z + ESH) - ESH;
  r = z - kd;
  ki = kd;
  i = ki - floor(ki / 32) * 32;
  k = (ki - i) / 32;
  s = ET[i] * (2 ^ k);
  zz = fma(EC0, r, EC1);
  r2 = r * r;
  y = fma(EC2, r, 1);
  y = fma(zz, r2, y);
  (y * s);
);
function expf_emu(x) ( exp_core(EINV * x); );
function p2f(y) ( exp_core(32 * y); );

K015 = 0.15000000596046448; K133 = 1.3333330154418945; K066 = 0.6600000262260437; K1066 = 1.065999984741211;
K1EM5 = 0.000009999999747378752; K08 = 0.800000011920929; K1EM4 = 0.00009999999747378752; K1EM3 = 0.0010000000474974513;
K001 = 0.009999999776482582; K01 = 0.10000000149011612; XMAXK = 0.9999989867210388; XMINK = 0.9999979734420776;
P149 = 2 ^ 149; PM149 = 2 ^ -149; U32 = 4294967296; UFF = 4294967295; I31 = 2147483648; M55 = 1431655765; MAA = 2863311530;

DMG = 64;
memset(DMG, 0, 262144);

// ---- Float32 bit patterns
function fbits(v) local(a, e, b, p)
(
  a = abs(v);
  a === 0 ? b = 0 : a < 0.000000000000000000000000000000000000011754943508222875 ? b = a * P149 : (
    e = floor(log(a) * 1.4426950408889634);
    p = 2 ^ e;
    p > a ? ( e -= 1; p *= 0.5; ) : (p * 2 <= a) ? ( e += 1; p *= 2; );
    b = (e + 127) * 8388608 + (a / p - 1) * 8388608;
  );
  (v < 0 || (v === 0 && 1 / v < 0)) ? b + 2147483648 : b;
);
function bfloat(b) local(s, e, m, v)
(
  s = b >= 2147483648;
  s ? b -= 2147483648;
  e = floor(b / 8388608); m = b - e * 8388608;
  v = e == 0 ? m * PM149 : (8388608 + m) * (2 ^ (e - 150));
  s ? -v : v;
);
function to_u32(n) ( n < 0 ? n + U32 : n; );
function to_s32(n) ( n >= I31 ? n - U32 : n; );

// ---- Diode ring modulator makeup gain (VecDiode table, computed on demand)
function dgain_lut(i, j) local(k, vb, vl, lo, num, c, hb, pr, dir, x, dn)
(
  k = i * 512 + j;
  DMG[k] != 0 ? DMG[k] : (
    vb = ((i / 511) * 0.75);
    vl = (vb + ((j / 511) * (1 - vb)));
    lo = (vb + K1EM4);
    vl = vl > 1 ? 1 : vl; vl = vl < lo ? lo : vl;
    num = (vl - vb); num = (num * num);
    c = ((1 - vl) + (num / (2 * (vl - vb))));
    hb = 4; pr = K001; dir = -1; dn = 0;
    while (!dn) (
      x = (hb * c);
      (x >= XMINK && x <= XMAXK) ? dn = 1 : (
        hb = (hb + (dir * pr));
        (x < XMINK && dir == -1) ? ( dir = 1; pr = (pr * K01); ) :
        (x > XMAXK && dir == 1) ? ( dir = -1; pr = (pr * K01); );
      );
    );
    DMG[k] = hb;
    hb;
  );
);
function lint(a, b, f) ( (a + (f * (b - a))); );

function diode_setup() local(vl, lo, vbf, vlf, i1, j1, i2, j2, d, q1, q2, q3, q4)
(
  d_vb = (0.75 * pa);
  vl = pb < 0 ? 0 : pb > 1 ? 1 : pb;
  d_vl = (d_vb + (vl * (1 - d_vb)));
  lo = (d_vb + K1EM3);
  d_vl = d_vl > 1 ? 1 : d_vl; d_vl = d_vl < lo ? lo : d_vl;
  d_den = (1 / (2 * (d_vl - d_vb)));
  vbf = (((d_vb - K1EM3) / (0.75 - K1EM3)) * 511);
  vlf = (((d_vl - d_vb) / (1 - d_vb)) * 511);
  i1 = trunc(vbf); i1 = i1 < 0 ? 0 : i1 > 511 ? 511 : i1;
  j1 = trunc(vlf); j1 = j1 < 0 ? 0 : j1 > 511 ? 511 : j1;
  i2 = i1 + 1 > 511 ? 511 : i1 + 1;
  j2 = j1 + 1 > 511 ? 511 : j1 + 1;
  vbf = (vbf - i1); vlf = (vlf - j1);
  q1 = dgain_lut(i1, j1); q2 = dgain_lut(i1, j2); q3 = dgain_lut(i2, j1); q4 = dgain_lut(i2, j2);
  q1 = lint(q1, q2, vbf); q3 = lint(q3, q4, vbf);
  d_hb = lint(q1, q3, vlf);
  d = (d_vl - d_vb);
  d_cl = ((d * d) * d_den);
);
function diode(x) local(o, t)
(
  x > d_vl ? o = ((x - d_vl) + d_cl) : x > d_vb ? ( t = (x - d_vb); o = ((t * t) * d_den); ) : o = 0;
  (o * d_hb);
);

// ---- Shared helpers (Valley SIMDUtilities)
function mirror(a, f) local(k, x, y, z)
(
  k = ((abs(f) * 9) + 1);
  x = (((a * 2) - 1) * k);
  y = abs(((x + 1) * 0.5));
  x = (y * 0.5);
  x = (x - floor(x));
  z = (y - floor(y));
  x >= 0.5 ? (1 - z) : z;
);
function varstep(a, f) local(af, ff, ai, f2)
(
  af = abs(f);
  ff = (64 - (af * 64));
  ai = ((cvtt((a * ff))) / ff);
  f2 = (af * 100); f2 = f2 < 0 ? 0 : f2 > 1 ? 1 : f2;
  (a + (f2 * (ai - a)));
);
function drive(x, g) local(xd)
(
  xd = (x * g);
  xd > 1.25 ? 1 : xd > 0.75 ? ((xd * (2.5 - xd)) - 0.5625) :
  xd < -1.25 ? -1 : xd < -0.75 ? ((1 - ((xd * (-2.5 - xd)) - 0.5625)) - 1) : xd;
);
function tanhd(x)
(
  x = (x * K066);
  x < -1.25 ? -1 : x < -0.75 ? ((1 - ((x * (-2.5 - x)) - 0.5625)) - 1) :
  x > 1.25 ? 1 : x > 0.75 ? ((x * (2.5 - x)) - 0.5625) : x;
);

// ---- One lane of VecAmalgam
function lane_init(sz, sw) instance(rz, rw, zm, c32, xds, yds, zds, ff, xp, yp, dcz)
(
  rz = sz; rw = sw; zm = 0; c32 = 0; xds = yds = zds = 0; ff = 0; xp = yp = 0; dcz = 0;
);
function rnd() instance(rz, rw) local(t)
(
  rw = 36969 * (rw & 65535) + floor(rw / 65536);
  rz = 18000 * (rz & 65535) + floor(rz / 65536);
  t = (rw & 65535) * 65536 + rz;
  t >= U32 ? t - U32 : t;
);
function proc(x, y) instance(zm, c32, xds, yds, zds, ff, xp, yp, rz, rw) local(z, a, b, t, k, r, xa, ya, mx, mn, d)
(
  md == 0 ? (
    zm = (y > rm1 || y < -rm1) ? y : 0;
    (((x * rm1a) + rm1b) * zm);
  ) : md == 1 ? (
    a = mirror(((x * 0.5) + 0.5), mfa);
    b = mirror(((y * 0.5) + 0.5), mfb);
    (((a - 0.5) * 2) * ((b - 0.5) * 2));
  ) : md == 2 ? (
    a = ((mirror(((x * 0.5) + 0.5), mfa) - 0.5) * 2);
    b = ((mirror(((y * 0.5) + 0.5), mfa) - 0.5) * -2);
    zm = ((a > 0) != (b > 0)) ? -1 : 1;
    t = (a * b);
    (t + (pb * (zm - t)));
  ) : md == 3 ? (
    b = (x * 0.5);
    a = (y + b);
    b = (y - b);
    ((diode(a) + diode(-a)) - (diode(b) + diode(-b)));
  ) : md == 4 ? (
    x > y ? ( mx = x; mn = y; ) : ( mx = y; mn = x; );
    d = (mx - mn);
    zm = (mn + (pa * d));
    (zm + (pb * ((zm * d) - zm)));
  ) : md == 5 ? (
    ((x >= ssh ? x : 0) + (y < ssl ? y : 0));
  ) : md == 6 ? (
    zm = x > ssh ? x : 0;
    y < ssl ? y : zm;
  ) : md == 7 ? (
    t = (((x * 0.5) + 0.5) * pb);
    t = (pa + t); t = t < 0 ? 0 : t > 1 ? 1 : t;
    (x + (t * (y - x)));
  ) : md == 8 ? (
    xa = ((this.rnd()) / U32) > pa;
    ya = ((this.rnd()) / U32) > ffy;
    (x > pb && xp <= pb && xa) ? ff = 0;
    (y > pb && yp <= pb && ya) ? ff = 1;
    xp = x; yp = y;
    ff ? y : x;
  ) : md == 9 ? (
    zm = ((abs(x) * 0.5) * apk);
    zm = (zm - floor(zm));
    ((zm > apb ? 0 : x) * y);
  ) : md <= 12 ? (
    smp ? ( xds = varstep(x, vsf); yds = varstep(y, vsf); );
    a = to_u32(cvtt((xds * I31)));
    b = to_u32(cvtt((yds * I31)));
    c32 = md == 10 ? a & b : md == 11 ? a ~ b : (a & M55) | (b & MAA);
    ((to_s32(c32)) / I31);
  ) : md == 13 ? (
    r = this.rnd();
    k = ((to_s32(r)) / U32) > hthr ? r : UFF;
    smp ? ( xds = x; yds = y; );
    a = to_u32(cvtt((xds * I31)));
    b = to_u32(cvtt((yds * I31)));
    c32 = (c32 | (a & b)) & k;
    c32 = c32 & ((((a ~ UFF) & (b ~ UFF)) & k) ~ UFF);
    zm = ((to_s32(c32)) / I31);
    smp ? zds = zm;
    zds;
  ) : md == 14 ? (
    r = this.rnd();
    k = ((r) / U32) > hthr ? r : UFF;
    smp ? ( xds = x; yds = y; );
    zm = bfloat(fbits(k32(xds)) & fbits(k32(yds)) & k);
    smp ? zds = zm;
    zds;
  ) : md == 15 ? (
    smp ? ( xds = varstep(x, vsf); yds = varstep(y, vsf); );
    bfloat((fbits(k32(xds)) & M55) | (fbits(k32(yds)) & MAA));
  ) : (
    r = this.rnd();
    k = ((r) / U32) > hthr ? r : UFF;
    smp ? ( xds = x; yds = y; );
    a = fbits(k32(xds)); b = fbits(k32(yds));
    t = (fbits(zq(zm)) | (a & b)) & k;
    t = ((((a ~ UFF) & (b ~ UFF)) & k) ~ UFF) & t;
    zm = bfloat(t);
    smp ? zds = zm;
    zds;
  );
);
function dcout(z) instance(dcz) local(zi)
(
  zi = daz(z);
  dcz = ((dca * zi) + (dcz * dcb));
  abs(dcz) < 0.000000000000000000000000000001 ? dcz = 0;
  (tanhd(dcc ? z : (zi - dcz)) * 5.5) * OUTSC;
);

function sr_setup()
(
  srf = (srate);
  qny = (srf / 32);
  dcb = expf_emu(((-2 * $pi) * 1 * (1 / srf)));
  dca = (1 - dcb);
  last_sr = srate;
  last_b = -1;
);

function params() local(t)
(
  md = floor(hc_mode + 0.5); md = md < 0 ? 0 : md > 16 ? 16 : md;
  xg = (hc_xg); xg = xg < 0 ? 0 : xg > 4 ? 4 : xg;
  yg = (hc_yg); yg = yg < 0 ? 0 : yg > 4 ? 4 : yg;
  pa = (hc_a); pa = pa < 0 ? 0 : pa > 1 ? 1 : pa;
  pb = (hc_b); pb = pb < 0 ? 0 : pb > 1 ? 1 : pb;
  dcc = hc_dc > 0.5;
  (pb != last_b) ? (
    stp = k32(k32(k32(qny) * k32(p2f(k32(k32(1 - pb) * 5)))) / k32(srf));
    last_b = pb;
  );
  rm1 = (pb * K1066);
  rm1a = (1 - (0.5 * pa)); rm1b = (pa * 0.5);
  mfa = (pa + K1EM5); mfb = (pb + K1EM5);
  t = ((pa * 2) - 1);
  ssh = (t + pb); ssl = (t - pb);
  ffy = (1 - pa);
  apk = ((pa * 16) + 1); apb = (1 - pb);
  t = (1 - (pa * K08)); t = (t * t); vsf = (1 - t);
  hthr = (0.5 - ((pa * pa) * 0.5));
  (md == 3 && (pa != last_da || pb != last_db)) ? ( diode_setup(); last_da = pa; last_db = pb; );
  ysrc = floor(hc_ysrc + 0.5);
  wet = hc_mix * 0.01;
  og = 10 ^ (hc_out / 20);
  ogs < 0 ? ( ogs = og; wts = wet; );
);

last_da = last_db = -1;
ogs = -1;
stp_acc = 1;
L.lane_init(1206434461, 2463534242);
R.lane_init(521288629, 362436069);
last_sr = 0;
lsig_xl = lsig_xr = lsig_yl = lsig_yr = 0;

@slider
srate != last_sr ? sr_setup();
params();

@block
srate != last_sr ? sr_setup();
params();
g_xl = pk_xl; g_xr = pk_xr; g_yl = pk_yl * 0.1; g_yr = pk_yr * 0.1;
pk_xl = pk_xr = pk_yl = pk_yr = 0;

@sample
xl = (spl0 * 10); xr = (spl1 * 10);
ysrc == 0 ? ( yl = (spl2 * 10); yr = (spl3 * 10); ) : ysrc == 1 ? ( yl = yr = (spl2 * 10); ) : ( yl = xl; yr = xr; );
stp_acc = k32(stp_acc + stp);
smp = stp_acc >= 1;
smp ? stp_acc = k32(stp_acc - 1);
ys0 = ysrc == 2 ? spl0 : spl2; ys1 = ysrc == 2 ? spl1 : ysrc == 1 ? spl2 : spl3;
zol = L.dcout(L.proc(sgn0((drive((xl * K015), xg) * K133), spl0), sgn0((drive((yl * K015), yg) * K133), ys0)));
zor = R.dcout(R.proc(sgn0((drive((xr * K015), xg) * K133), spl1), sgn0((drive((yr * K015), yg) * K133), ys1)));
(abs(spl0) > pk_xl) ? pk_xl = abs(spl0);
(abs(spl1) > pk_xr) ? pk_xr = abs(spl1);
(abs(yl) > pk_yl) ? pk_yl = abs(yl);
(abs(yr) > pk_yr) ? pk_yr = abs(yr);
ogs += (og - ogs) * 0.002;
wts += (wet - wts) * 0.002;
spl0 = (spl0 * (1 - wts) + zol * wts) * ogs;
spl1 = (spl1 * (1 - wts) + zor * wts) * ogs;

@gfx 481 724

UK = 1.85; SBU = 110; UDW = (150 + SBU) * UK; UDH = 391 * UK;
uscale = max(0.5, min(gfx_w / UDW, gfx_h / UDH));
sbx = floor(SBU * UK * uscale + 0.5);
uox = floor(sbx + (gfx_w - sbx - 150 * UK * uscale) * 0.5 + 0.5);
uoy = 0;
UQ = UK * uscale;
!g_pnl_try ? (
  g_pnl_try = 1;
  g_pnl = gfx_loadimg(20, "Morgana/MorganaPanel.png") >= 0 || gfx_loadimg(20, "Dependencies/Morgana/MorganaPanel.png") >= 0;
  g_pnl2 = gfx_loadimg(21, "Morgana/MorganaPanel2x.png") >= 0 || gfx_loadimg(21, "Dependencies/Morgana/MorganaPanel2x.png") >= 0;
  g_mk = gfx_loadimg(22, "Morgana/MorganaImage.png") >= 0 || gfx_loadimg(22, "Dependencies/Morgana/MorganaImage.png") >= 0;
  g_mk2 = gfx_loadimg(23, "Morgana/MorganaImage2x.png") >= 0 || gfx_loadimg(23, "Dependencies/Morgana/MorganaImage2x.png") >= 0;
  g_tt = gfx_loadimg(24, "Morgana/MorganaTitle.png") >= 0 || gfx_loadimg(24, "Dependencies/Morgana/MorganaTitle.png") >= 0;
  g_tt2 = gfx_loadimg(25, "Morgana/MorganaTitle2x.png") >= 0 || gfx_loadimg(25, "Dependencies/Morgana/MorganaTitle2x.png") >= 0;
  g_fx = gfx_loadimg(26, "Morgana/MorganaFx.png") >= 0 || gfx_loadimg(26, "Dependencies/Morgana/MorganaFx.png") >= 0;
  g_fx2 = gfx_loadimg(27, "Morgana/MorganaFx2x.png") >= 0 || gfx_loadimg(27, "Dependencies/Morgana/MorganaFx2x.png") >= 0;
  g_hd = gfx_loadimg(28, "Morgana/MorganaHead.png") >= 0 || gfx_loadimg(28, "Dependencies/Morgana/MorganaHead.png") >= 0;
  g_hd2 = gfx_loadimg(29, "Morgana/MorganaHead2x.png") >= 0 || gfx_loadimg(29, "Dependencies/Morgana/MorganaHead2x.png") >= 0;
  g_hf = gfx_loadimg(34, "Morgana/MorganaSil.png") >= 0 || gfx_loadimg(34, "Dependencies/Morgana/MorganaSil.png") >= 0;
  g_sm = gfx_loadimg(36, "Morgana/MorganaSmoke.png") >= 0 || gfx_loadimg(36, "Dependencies/Morgana/MorganaSmoke.png") >= 0;
  g_sm2 = gfx_loadimg(37, "Morgana/MorganaSmoke2x.png") >= 0 || gfx_loadimg(37, "Dependencies/Morgana/MorganaSmoke2x.png") >= 0;
  g_v2 = g_hf && g_sm && g_hd;
  g_v22 = g_sm2 && g_hd2;
);

function automate(s, e)
(
<?
  max_sliders > 9 ? printf("slider_automate(2^(s-1), e);") : (
    printf("s == 1 ? slider_automate(hc_mode, e) : s == 2 ? slider_automate(hc_xg, e) : s == 3 ? slider_automate(hc_yg, e) :\n");
    printf("s == 4 ? slider_automate(hc_a, e) : s == 5 ? slider_automate(hc_b, e) : s == 6 ? slider_automate(hc_dc, e) :\n");
    printf("s == 7 ? slider_automate(hc_ysrc, e) : s == 8 ? slider_automate(hc_mix, e) : s == 9 ? slider_automate(hc_out, e) :\n");
    printf("s == 10 ? slider_automate(hc_anim, e) : 0;");
  );
?>
  0;
);

UMIN = 1000000; UMAX = 1000020; UDEF = 1000040; USTP = 1000060;

function ui_inittables()
(
  mem_set_values(UMIN + 1, 0, 0, 0, 0, 0, 0, 0, 0, -24, 0);
  mem_set_values(UMAX + 1, 16, 4, 4, 1, 1, 1, 2, 100, 12, 1);
  mem_set_values(UDEF + 1, 0, 1, 1, 0, 0, 0, 0, 100, 0, 1);
  mem_set_values(USTP + 1, 1, 0.001, 0.001, 0.001, 0.001, 1, 1, 0.1, 0.1, 1);
  strcpy(100, "RINGMOD1"); strcpy(101, "RINGMOD2"); strcpy(102, "RINGMOD3"); strcpy(103, "DIODE-RM"); strcpy(104, "MINIMAXI");
  strcpy(105, "SIGN-1"); strcpy(106, "SIGN-2"); strcpy(107, "X-FADE"); strcpy(108, "FLIPFLOP"); strcpy(109, "ALPHAPWM");
  strcpy(110, "BITAND"); strcpy(111, "BITXOR"); strcpy(112, "BITINTLV"); strcpy(113, "BITGLTCH"); strcpy(114, "FL32-AND");
  strcpy(115, "FL32INTV"); strcpy(116, "FL32HACK");
  strcpy(120, "QUADRANT"); strcpy(121, "FOLD-X"); strcpy(122, "FOLDXY"); strcpy(123, "OFFVLT"); strcpy(124, "MIN<>MAX");
  strcpy(125, "MIDPOINT"); strcpy(126, "MIDPOINT"); strcpy(127, "BIAS"); strcpy(128, "FAVOUR"); strcpy(129, "PULSES");
  strcpy(130, "BITDEPTH"); strcpy(131, "BITDEPTH"); strcpy(132, "BITDEPTH"); strcpy(133, "JITTER"); strcpy(134, "JITTER");
  strcpy(135, "BITDEPTH"); strcpy(136, "JITTER");
  strcpy(140, "XPWM"); strcpy(141, "FOLD-Y"); strcpy(142, "XORBLEND"); strcpy(143, "ON-VLT"); strcpy(144, "DIFF*Z");
  strcpy(145, "THRESH"); strcpy(146, "THRESH"); strcpy(147, "XMOD"); strcpy(148, "THRESH"); strcpy(149, "PWIDTH");
  strcpy(150, "BITCRUSH"); strcpy(151, "BITCRUSH"); strcpy(152, "BITCRUSH"); strcpy(153, "BITCRUSH"); strcpy(154, "BITCRUSH");
  strcpy(155, "BITCRUSH"); strcpy(156, "BITCRUSH");
  strcpy(160, "Y = sidechain 3/4"); strcpy(161, "Y = sidechain 3 (mono)"); strcpy(162, "Y = track (X)");
  strcpy(170, "Ring Mod 1"); strcpy(171, "Ring Mod 2"); strcpy(172, "Ring Mod 3"); strcpy(173, "Diode Ring Mod"); strcpy(174, "Min/Max");
  strcpy(175, "Sign Switch 1"); strcpy(176, "Sign Switch 2"); strcpy(177, "X-Fade"); strcpy(178, "Flip-Flop"); strcpy(179, "Alpha PWM");
  strcpy(180, "Bit AND"); strcpy(181, "Bit XOR"); strcpy(182, "Bit Interleave"); strcpy(183, "Bit Glitch"); strcpy(184, "Float32 AND");
  strcpy(185, "Float32 Interleave"); strcpy(186, "Float32 Glitch");
  strcpy(190, "Type"); strcpy(191, "X Gain"); strcpy(192, "Y Gain"); strcpy(193, "Param A"); strcpy(194, "Param B");
  strcpy(195, "DC Couple"); strcpy(196, "Y Input"); strcpy(197, "Mix"); strcpy(198, "Output");
);

function ui_min(s) ( UMIN[s]; );
function ui_max(s) ( UMAX[s]; );
function ui_def(s) ( UDEF[s]; );
function ui_stp(s) ( USTP[s]; );
function ui_norm(s) ( (slider(s) - ui_min(s)) / (ui_max(s) - ui_min(s)); );
function ui_set(s, xv) local(lo, hi, st, nv, old)
(
  lo = ui_min(s); hi = ui_max(s); st = ui_stp(s);
  nv = max(lo, min(hi, xv));
  nv = lo + floor((nv - lo) / st + 0.5) * st;
  nv = max(lo, min(hi, nv));
  old = slider(s);
  slider(s) = nv;
  nv !== old ? automate(s, 0);
);
function ui_setn(s, nn) ( ui_set(s, ui_min(s) + max(0, min(1, nn)) * (ui_max(s) - ui_min(s))); );
function ui_put(s, xv) ( ui_set(s, xv); automate(s, 1); );
function ui_ival(s) ( floor(slider(s) + 0.5); );

function ui_px(u) ( uox + u * UQ; );
function ui_py(v) ( uoy + v * UQ; );
function ui_hit(px, py, pw, ph) ( mouse_x >= px && mouse_x < px + pw && mouse_y >= py && mouse_y < py + ph; );
function ui_hitc(cx, cy, rr) ( sqr(mouse_x - cx) + sqr(mouse_y - cy) <= sqr(rr); );

function ui_font(fs, b) ( gfx_setfont(1, "Arial", max(11, floor(fs + 0.5)), b ? 'b' : 0); );
function ui_ctext(str, cx, cy, fs, b) local(tw, th)
(
  ui_font(fs, b);
  gfx_measurestr(str, tw, th);
  gfx_x = floor(cx - tw * 0.5 + 0.5); gfx_y = floor(cy - th * 0.5 + 0.5);
  gfx_drawstr(str);
);
function ui_rtext(str, rx, cy, fs, b) local(tw, th)
(
  ui_font(fs, b);
  gfx_measurestr(str, tw, th);
  gfx_x = floor(rx - tw + 0.5); gfx_y = floor(cy - th * 0.5 + 0.5);
  gfx_drawstr(str);
);
function plabel(str, cu, cv, fs) ( gfx_set(1, 1, 1, 1); ui_ctext(str, ui_px(cu), ui_py(cv), min(fs, 12) * UQ * 0.95, 0); );

function ui_bezel(cx, cy, rr) local(yy, xx, dx, dy, d, cv, th, f, q, rc, ac, c, band)
(
  yy = floor(cy - rr - 1);
  loop(ceil(2 * rr + 3),
    dy = yy + 0.5 - cy;
    xx = floor(cx - rr - 1);
    loop(ceil(2 * rr + 3),
      dx = xx + 0.5 - cx; d = sqrt(dx * dx + dy * dy);
      cv = min(1, rr - d + 0.5);
      cv > 0 ? (
        c = 0.2;
        th = atan2(dx, -dy) * 180 / $pi;
        f = d / rr;
        band = 0;
        (f > 0.84 && f < 0.97) ? ( band = 1; q = th + 360; q = q - 90 * floor(q / 90); );
        (f > 0.66 && f < 0.80) ? ( band = 2; q = th + 405; q = q - 90 * floor(q / 90); );
        band ? (
          rc = band == 1 ? min(1, min((f - 0.84) * rr + 0.5, (0.97 - f) * rr + 0.5)) : min(1, min((f - 0.66) * rr + 0.5, (0.80 - f) * rr + 0.5));
          ac = min(1, min((q - 12) * $pi / 180 * d + 0.5, (78 - q) * $pi / 180 * d + 0.5));
          rc > 0 && ac > 0 ? c = 0.2 + 0.059 * rc * ac;
        );
        f > 0.97 ? c = 0.2 - 0.05 * min(1, (f - 0.97) * rr);
        gfx_set(c, c, c, cv);
        gfx_rect(xx, yy, 1, 1);
      );
      xx += 1;
    );
    yy += 1;
  );
  gfx_a = 1;
);
function ui_bz(u, v, rr) ( ui_bezel(ui_px(u), ui_py(v), rr * UQ); );

function ui_jack(u, v) local(cx, cy, rr)
(
  cx = ui_px(u); cy = ui_py(v); rr = 7.2 * UQ;
  gfx_set(0.08, 0.08, 0.08, 1); gfx_circle(cx, cy, rr, 1, 1);
  gfx_set(0.26, 0.26, 0.26, 1); gfx_circle(cx, cy, rr - max(1, 0.9 * UQ), 1, 1);
  gfx_set(0.11, 0.11, 0.11, 1); gfx_circle(cx, cy, rr * 0.62, 1, 1);
);

function ui_panelimg() local(src, base)
(
  src = (g_pnl2 && UQ > UK * 1.25) ? 21 : 20;
  base = src == 21 ? UK * 2 : UK;
  gfx_set(1, 1, 1, 1);
  gfx_x = ui_px(0); gfx_y = ui_py(0);
  gfx_blit(src, UQ / base, 0);
);

function ui_static()
(
  gfx_dest = 10; gfx_setimgdim(10, gfx_w, gfx_h);
  gfx_set(0.157, 0.157, 0.157, 1); gfx_rect(0, 0, gfx_w, gfx_h);
  g_pnl ? ui_panelimg() : (
    gfx_set(1, 1, 1, 1);
    gfx_rect(floor(ui_px(0)), floor(ui_py(24)), ceil(150 * UQ), max(1, floor(UQ + 0.5)));
    plabel("Gain", 74.30, 81.68, 12);
    plabel("Type", 74.74, 166.86, 12);
    plabel("Param A", 75.38, 235.75, 12);
    plabel("Param B", 75.25, 307.81, 12);
    plabel("DC", 82.92, 38.48, 12);
    plabel("L   X   R", 28.50, 56.00, 11);
    plabel("L   Y   R", 121.50, 56.00, 11);
    gfx_set(0.067, 0.067, 0.067, 1);
    gfx_rect(floor(ui_px(30)), floor(ui_py(91.5)), floor(90 * UQ), floor(20 * UQ));
    gfx_rect(floor(ui_px(33)), floor(ui_py(174)), floor(84 * UQ), floor(18.5 * UQ));
    gfx_rect(floor(ui_px(33)), floor(ui_py(245.5)), floor(84 * UQ), floor(18.5 * UQ));
  );
  g_mk ? (
    gfx_set(1, 1, 1, 1);
    gfx_x = 0; gfx_y = floor(ui_py(25));
    (g_mk2 && uscale > 1.25) ? gfx_blit(23, uscale / 2, 0) : gfx_blit(22, uscale, 0);
  ) : (
    gfx_set(0.80, 0.80, 0.80, 1);
    ui_ctext("Clair de lune", floor(sbx - UQ) * 0.5, ui_py(180), 12 * uscale, 0);
  );
  gfx_set(1, 1, 1, 1);
  g_tt ? (
    gfx_x = floor((gfx_w - (150 + SBU) * UQ) * 0.5); gfx_y = 0;
    (g_tt2 && uscale > 1.25) ? gfx_blit(25, UQ / (2 * UK), 0) : gfx_blit(24, UQ / UK, 0);
  ) : ui_ctext("Morgana", gfx_w * 0.5, ui_py(12.3), 18 * UQ, 0);
  gfx_rect(0, floor(ui_py(356.2)), gfx_w, max(1, floor(UQ + 0.5)));
  gfx_rect(0, floor(ui_py(24)), gfx_w, max(1, floor(UQ + 0.5)));
  gfx_rect(floor(sbx - UQ), floor(ui_py(24)), max(1, floor(UQ + 0.5)), ceil(332.2 * UQ));
  plabel("Mix", 25, 311.5, 11);
  plabel("Output", 125, 311.5, 11);
  ui_bz(60.0, 62.98, 9.9); ui_bz(90.06, 62.98, 9.9);
  ui_bz(74.99, 144.02, 15.87); ui_bz(74.99, 212.95, 15.87); ui_bz(74.99, 285.02, 15.87);
  ui_bz(25, 296, 9.9); ui_bz(125, 296, 9.9);
  ui_jack(14.65, 38.37); ui_jack(41.65, 38.37); ui_jack(107.65, 38.37); ui_jack(134.65, 38.37);
  gfx_set(0.80, 0.80, 0.80, 1);
  ui_rtext("by chmaha", max(ui_px(147), gfx_w - 3 * UQ), ui_py(7.6), 11 * uscale, 0);
  ui_rtext("based on Valley Amalgam", max(ui_px(147), gfx_w - 3 * UQ), ui_py(16.6), 11 * uscale, 0);
  gfx_dest = -1;
);

function ui_click_at(s)
(
  (u_ctarget == s && time_precise() - u_ctime < 0.3) ? (
    ui_put(s, ui_def(s));
    u_drag = 0;
  ) : (
    u_drag = s; u_dy0 = mouse_y; u_dv0 = ui_norm(s); u_dfine = mouse_cap & 4;
  );
  u_ctarget = s; u_ctime = time_precise();
  u_click = 0;
);

function ui_bar(cx, cy, ca, sa, r0, r1, hw) local(x0, y0, x1, y1, xx, yy, dx, dy, ss, tt, cv)
(
  x0 = floor(min(cx + sa * r0, cx + sa * r1) - hw - 2); x1 = ceil(max(cx + sa * r0, cx + sa * r1) + hw + 2);
  y0 = floor(min(cy - ca * r0, cy - ca * r1) - hw - 2); y1 = ceil(max(cy - ca * r0, cy - ca * r1) + hw + 2);
  yy = y0;
  loop(y1 - y0 + 1,
    xx = x0;
    loop(x1 - x0 + 1,
      dx = xx + 0.5 - cx; dy = yy + 0.5 - cy;
      ss = dx * sa - dy * ca; tt = dx * ca + dy * sa;
      cv = max(0, min(1, min(ss - r0, r1 - ss) + 0.5)) * max(0, min(1, hw - abs(tt) + 0.5));
      cv > 0 ? ( gfx_a = cv; gfx_rect(xx, yy, 1, 1); );
      xx += 1;
    );
    yy += 1;
  );
  gfx_a = 1;
);

function ui_wheel(s)
(
  ui_stp(s) >= 1 ? ui_put(s, slider(s) + (u_wheel > 0 ? 1 : -1) * ui_stp(s))
                 : ( ui_setn(s, ui_norm(s) + (u_wheel / 120) * ((mouse_cap & 4) ? 0.002 : 0.02)); automate(s, 1); );
  u_wheel = 0;
);

function ui_knob(s, u, v, rd, col) local(cx, cy, rr, hov, nn, a, ca, sa, cr, cg, cb, hr, hg, hb, rc)
(
  cx = ui_px(u); cy = ui_py(v); rr = rd * UQ;
  hov = ui_hitc(cx, cy, rr + 2);
  hov ? u_hov = s;
  (u_click && hov) ? ui_click_at(s);
  (hov && u_wheel != 0 && u_drag == 0) ? ui_wheel(s);
  col == 0 ? ( cr = 0.220; cg = 0.455; cb = 0.812; hr = 0.345; hg = 0.533; hb = 0.820; ) :
  col == 3 ? ( cr = 0.031; cg = 0.616; cb = 0.706; hr = 0.302; hg = 0.722; hb = 0.788; ) :
             ( cr = 0.890; cg = 0.890; cb = 0.890; hr = 1; hg = 1; hb = 1; );
  nn = max(0, min(1, ui_norm(s)));
  a = (-0.75 + 1.5 * nn) * $pi;
  ca = cos(a); sa = sin(a);
  gfx_set(0, 0, 0, 1); gfx_circle(cx, cy, rr, 1, 1);
  gfx_set(0.22, 0.22, 0.22, 1); gfx_circle(cx, cy, rr * 0.80, 0, 1);
  (hov || u_drag == s) ? gfx_set(hr, hg, hb, 1) : gfx_set(cr, cg, cb, 1);
  gfx_circle(cx, cy, rr * 0.62, 1, 1);
  ui_bar(cx, cy, ca, sa, rr * 0.45, rr * 0.97, max(1, rr * 0.055));
);

function ui_lamp(cx, cy, rr, lr, lg, lb, on)
(
  on > 0.01 ? (
    gfx_set(lr, lg, lb, 0.25 * on); gfx_circle(cx, cy, rr * 1.6, 1, 1);
    gfx_set(0.235 + (lr - 0.235) * on, 0.235 + (lg - 0.235) * on, 0.235 + (lb - 0.235) * on, 1);
    gfx_circle(cx, cy, rr, 1, 1);
    gfx_set(1, 1, 1, 0.35 * on); gfx_circle(cx - rr * 0.3, cy - rr * 0.3, rr * 0.35, 1, 1);
  ) : (
    gfx_set(0.16, 0.16, 0.16, 1); gfx_circle(cx, cy, rr, 1, 1);
  );
);

function ui_led(s, u, v) local(cx, cy, hov)
(
  cx = ui_px(u); cy = ui_py(v);
  hov = ui_hitc(cx, cy, 8 * UQ);
  hov ? u_hov = s;
  gfx_set(0, 0, 0, 1); gfx_circle(cx, cy, 7.13 * UQ, 1, 1);
  gfx_set(0.235, 0.235, 0.235, 1); gfx_circle(cx, cy, 7.13 * UQ - max(1, 0.6 * UQ), 1, 1);
  ui_lamp(cx, cy, 4.2 * UQ, 0.929, 0.173, 0.141, slider(s) > 0.5);
  hov ? ( gfx_set(1, 1, 1, 0.5); gfx_circle(cx, cy, 7.13 * UQ, 0, 1); );
  (u_click && hov) ? ( u_click = 0; ui_put(s, slider(s) > 0.5 ? 0 : 1); );
);

function ui_menu(base, n, cur) local(i, r)
(
  strcpy(#u_menu, "");
  i = 0;
  loop(n,
    i == cur ? strcat(#u_menu, "!");
    strcat(#u_menu, base + i);
    i < n - 1 ? strcat(#u_menu, "|");
    i += 1;
  );
  gfx_x = mouse_x; gfx_y = mouse_y;
  r = gfx_showmenu(#u_menu);
  r - 1;
);

function ui_display(s, str, u, v, w, h, menu, mbase) local(px, py, pw, ph, hov, r)
(
  px = floor(ui_px(u)); py = floor(ui_py(v)); pw = floor(w * UQ); ph = floor(h * UQ);
  hov = menu ? ui_hit(px, py, pw, ph) : 0;
  hov ? u_hov = s;
  gfx_set(1, 0.18, 0.18, 0.35); ui_ctext(str, px + pw * 0.5 + 0.6, py + ph * 0.5 + 0.6, 11.5 * UQ, 1);
  gfx_set(1, hov ? 0.45 : 0.24, hov ? 0.45 : 0.24, 1); ui_ctext(str, px + pw * 0.5, py + ph * 0.5, 11.5 * UQ, 1);
  (u_click && hov) ? (
    u_click = 0;
    r = ui_menu(mbase, ui_max(s) - ui_min(s) + 1, ui_ival(s) - ui_min(s));
    r >= 0 ? ui_put(s, ui_min(s) + r);
  );
  (hov && u_wheel != 0 && u_drag == 0) ? ( ui_put(s, slider(s) + (u_wheel > 0 ? -1 : 1)); u_wheel = 0; );
);

function ui_choice(s, u, v, w, h) local(px, py, pw, ph, hov, r)
(
  px = floor(ui_px(u)); py = floor(ui_py(v)); pw = floor(w * UQ); ph = floor(h * UQ);
  hov = ui_hit(px, py, pw, ph);
  hov ? u_hov = s;
  gfx_set(0.255, 0.251, 0.259, 1); gfx_rect(px, py, pw, ph);
  gfx_set(hov ? 0.12 : 0.067, hov ? 0.12 : 0.067, hov ? 0.125 : 0.067, 1); gfx_rect(px + 1, py + 1, pw - 2, ph - 2);
  gfx_set(1, 1, 1, 1);
  ui_ctext(160 + ui_ival(s), px + pw * 0.5, py + ph * 0.5, 10 * UQ * 0.8, 0);
  (u_click && hov) ? (
    u_click = 0;
    r = ui_menu(160, 3, ui_ival(s));
    r >= 0 ? ui_put(s, r);
  );
  (hov && u_wheel != 0 && u_drag == 0) ? ( ui_put(s, slider(s) + (u_wheel > 0 ? -1 : 1)); u_wheel = 0; );
);

function ha_h(n) ( n = sin(n * 12.9898 + 78.233) * 43758.5453; n - floor(n); );
function ha_n(x, sd) local(i, f, va, vb)
(
  i = floor(x); f = x - i;
  va = ha_h(i + sd * 101); vb = ha_h(i + 1 + sd * 101);
  f = f * f * (3 - 2 * f);
  va + (vb - va) * f;
);

function ha_init()
(
  AFF = 2000000; AFF_N = 4;
  mem_set_values(AFF + 0, 616, 2, 58, 58, 314, 452, 2, 2, 70, 70, 308, 447, 1.0, 112, 74, 34, 54, 370, 486, 142, 2, 46, 66, 364, 480, 1.0, 300, 74, 46, 46, 312, 542, 676, 2, 58, 58, 306, 537, 0.0, 148, 74, 40, 54, 0, 1096, 190, 2, 52);
  mem_set_values(AFF + 48, 66, -6, 1090, 1.0);
  AST = 2000068; AST_N = 518;
  mem_set_values(AST + 0, 642, 74, 18, 18, 168, 322, 625.0955, 6.5375, 662, 74, 18, 18, 164, 324, 775.6857, 3.5134, 682, 74, 18, 18, 266, 326, 300.1663, 6.431, 702, 74, 18, 18, 68, 336, 5.2653, 6.1955, 722, 74, 18, 18, 102, 332, 797.0694, 4.6057, 742, 74, 18, 18, 124, 334, 303.0324, 3.7529);
  mem_set_values(AST + 48, 762, 74, 18, 18, 60, 338, 254.8696, 4.5028, 782, 74, 18, 18, 114, 344, 504.5483, 4.9907, 802, 74, 18, 18, 52, 344, 995.5003, 6.067, 822, 74, 18, 18, 80, 344, 622.1792, 6.9503, 842, 74, 18, 18, 184, 346, 215.3087, 3.221, 862, 74, 18, 18, 208, 344, 612.5396, 2.6977);
  mem_set_values(AST + 96, 882, 74, 18, 18, 72, 350, 35.6803, 4.817, 902, 74, 18, 18, 200, 352, 466.206, 6.6273, 922, 74, 18, 18, 62, 352, 629.2263, 4.8135, 942, 74, 18, 18, 108, 352, 496.8734, 3.6138, 962, 74, 18, 18, 170, 352, 11.794, 3.3658, 982, 74, 18, 18, 52, 356, 692.0321, 3.4027);
  mem_set_values(AST + 144, 1002, 74, 18, 18, 170, 360, 369.5363, 2.5168, 2, 132, 18, 18, 84, 360, 830.0477, 3.1951, 22, 132, 18, 18, 146, 362, 267.5993, 6.4615, 42, 132, 18, 18, 184, 360, 509.7908, 6.3122, 62, 132, 18, 18, 42, 364, 639.7172, 5.838, 82, 132, 18, 18, 78, 362, 91.4956, 4.9351);
