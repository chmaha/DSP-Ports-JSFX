NOUT = 2;
i = 0; loop(128, SC[i] = f32((1 - cos($pi * (i / 127))) * 0.5); i += 1; );
i = 0; loop(4095, PT[i] = f32(cos(i * (($pi / 2) / 4094))); i += 1; );
i = 0; loop(32, E2T[i] = 2 ^ (i / 32); i += 1; );
PAN_G = PT[2047] * 1.9952622652053833;

function sec_load() local(h, n)
(
  n = 0;
  h = file_open("GrandDesigns/GrandDesigns.txt");
  h < 0 ? h = file_open("Dependencies/GrandDesigns/GrandDesigns.txt");
  h >= 0 ? (
    n = file_mem(h, TXT, SEQBASE - TXT);
    file_close(h);
  );
  (n > 8 && TXT[0] === 5813) ? n : 0;
);

function pack_open(p) local(h)
(
  strcpy(#pk_fn, "GrandDesigns/"); strcat(#pk_fn, pack_name(p)); strcat(#pk_fn, ".flac");
  h = file_open(#pk_fn);
  h < 0 ? (
    strcpy(#pk_fn, "Dependencies/GrandDesigns/"); strcat(#pk_fn, pack_name(p)); strcat(#pk_fn, ".flac");
    h = file_open(#pk_fn);
  );
  h;
);

function slot_uses(s, p) local(SL)
(
  SL = SLOT + s * SLS;
  (SL[0] > 0 && SL[9]) ? SL[1600 + p] : 0;
);

function slot_need(s) local(i, RG, NEED, pend)
(
  slot_enter(s);
  NEED = SL + 1600;
  memset(NEED, 0, NPACK);
  BLK ? (
    i = 0;
    loop(BLK[0],
      RG = REGB + i * RS;
      ((RG[F_SW] < 0 || RG[F_SW] === cur_sw) && (RG[F_TGCC] < 0 || CCV[RG[F_TGCC]] >= RG[F_TGLO])) ? NEED[SMPT[RG[F_SMP] * 4]] = 1;
      i += 1;
    );
  );
  pend = 0; i = 0; loop(NPACK, (NEED[i] && PKS[i] !== 2 && PKS[i] !== 3) ? pend = 1; i += 1; );
  SL[26] = pend;
  slot_leave();
);

function all_need() local(s) ( s = 0; loop(NSLOT, slot_need(s); s += 1; ); );

function pack_needed(p) local(s, r)
(
  r = 0; s = 0;
  loop(NSLOT, slot_uses(s, p) ? r = 1; s += 1; );
  r;
);

function compact() local(s, p)
(
  p = 0; loop(NPACK, PKS[p] === 2 || PKS[p] === 1 ? PKS[p] = 0; p += 1; );
  pk_gen += 1;
  ld_h >= 0 ? ( file_close(ld_h); ld_h = -1; );
  heap_top = HEAP;
  s = 0;
  loop(NSLOT,
    slot_enter(s); kill_all(); SL[2] = 0; slot_leave();
    s += 1;
  );
  freembuf(heap_top);
);

function pack_start(p) local(h, nch, sr)
(
  heap_top + PKZ[p] > MAXW ? compact();
  heap_top + PKZ[p] > MAXW ? PKS[p] = 3 : (
    h = pack_open(p);
    nch = 0; sr = 0;
    h >= 0 ? file_riff(h, nch, sr);
    (h >= 0 && nch === 1 && file_avail(h) >= PKZ[p]) ? (
      PKB[p] = heap_top; heap_top += PKZ[p];
      PKS[p] = 1; ld_h = h; ld_p = p; ld_pos = 0;
    ) : (
      h >= 0 ? file_close(h);
      PKS[p] = 3;
    );
  );
);

function loader_step() local(n, got, i, dst, p, done)
(
  ld_h >= 0 ? (
    n = min(CHUNK, PKZ[ld_p] - ld_pos);
    got = file_mem(ld_h, PKB[ld_p] + ld_pos, n);
    ld_pos += got;
    (got < n || ld_pos >= PKZ[ld_p]) ? (
      file_close(ld_h); ld_h = -1;
      PKS[ld_p] = ld_pos >= PKZ[ld_p] ? 2 : 3;
      pk_gen += 1;
    );
  ) : (
    p = 0; done = 0;
    loop(NPACK,
      !done && PKS[p] === 0 && pack_needed(p) ? ( pack_start(p); done = 1; );
      p += 1;
    );
  );
);

function load_pending() local(p, r)
(
  r = ld_h >= 0; p = 0;
  loop(NPACK, PKS[p] === 0 && pack_needed(p) ? r = 1; p += 1; );
  r;
);

function loader_run(budget) local(t0)
(
  t0 = time_precise();
  loader_step();
  while (load_pending() && time_precise() - t0 < budget) ( loader_step(); );
);

function slot_ready_check(s) local(i, BK, t)
(
  slot_enter(s);
  (SL[0] > 0 && SL[9] && (!SL[2] || SL[25] !== pk_gen)) ? (
    BK = SL[9];
    i = 0;
    loop(BK[1], t = SMPT + i * 4; SMPA[i] = PKS[t[0]] === 2 ? PKB[t[0]] + t[1] : 0; i += 1; );
    SL[25] = pk_gen;
    SL[2] = 1;
  );
  slot_leave();
);

function art_key(k) local(BK) ( BK = SL[9]; (BK && k >= 0 && k < BK[15]) ? BK[BK[16] + k] : -1; );
function key_art(n) local(BK, i, r) ( BK = SL[9]; r = -1; i = 0; BK ? loop(BK[15], BK[BK[16] + i] === n ? r = i; i += 1; ); r; );

function slot_config(s, inst, mode) local(BK, i, r)
(
  slot_enter(s);
  kill_all();
  nact = 0; SL[4] = 0;
  SL[0] = inst; SL[1] = mode; SL[2] = 0;
  BLK = (inst > 0 && inst <= NINST) ? TXT + TXT[8 + NPACK + 2 * (inst - 1) + mode] : 0;
  SL[9] = BLK;
  slot_enter(s);
  memset(DEF, 0, 140);
  DEF[7] = f32(100 / 127); DEF[10] = 0.5; DEF[11] = 1;
  memset(KSW, 0, 128); memset(SEQ, 0, MAXREG); memset(RCV, 0, 140); memset(KEYON, 0, 128);
  volcc = -1; cur_sw = -1; ampcc = -1; eqcc = -1; lfcc = -1; HASREL = 0;
  SUSTHR = (BLK && BLK[39]) ? 0.5 : THR;
  i = 0; loop(16, SCURV[i] = CPT + (i <= 6 ? i : 0) * 128; i += 1; );
  BLK ? (
    i = 0; loop(BLK[4], DEF[BLK[BLK[10] + 2 * i]] = BLK[BLK[10] + 2 * i + 1]; i += 1; );
    i = 0; loop(BLK[0], r = REGB + i * RS; r[F_SW] >= 0 ? KSW[r[F_SW]] = 1; i += 1; );
    volcc = BLK[14]; cur_sw = BLK[3]; ampcc = BLK[17]; eqcc = BLK[20]; lfcc = BLK[32];
    i = 0; loop(BLK[18], r = BLK + BLK[19] + i * 129; SCURV[r[0]] = r + 1; i += 1; );
    HASST = 0; i = 0; loop(BLK[0], r = REGB + i * RS; !r[F_MONO] ? HASST = 1; r[F_TRIG] >= 3 ? HASREL = 1; SEQS[i] = r[F_SEQLEN] <= 1; i += 1; );
  );
  SL[10] = volcc; SL[15] = ampcc; SL[16] = HASREL; SL[17] = eqcc; SL[18] = lfcc; npend = 0;
  expr_cc !== 1 ? ( DEF[expr_cc] = DEF[1]; CCV[expr_cc] = DEF[expr_cc]; );
  i = 0; loop(140, CCV[i] = DEF[i]; i += 1; );
  active_notes = 0; bend = 0; bend_f = 1; ring_id = 0;
  src_setup(); src_rate(); src_reset();
  SL[13] = key_art(cur_sw);
  slot_leave();
);

function calc_tune() local(i, base, r, st, n)
(
  base = slider(50) == 440 ? 0 : 1200 * log(slider(50) / 440) / log(2);
  r = SCALES + slider(50 + 1) * 12;
  i = 0;
  loop(12,
    TUNE[i] = base + (slider(50 + 1) == 5 ? 0 : 1200 * log(r[i] / r[9]) / log(2) - 100 * (i - 9));
    i += 1;
  );
  n = 0; loop(128, KTAB[n] = f32(n + TUNE[n % 12] / 100); n += 1; );
  tun_on = base != 0 || slider(50 + 1) != 5;
  last_tune = slider(50); last_temper = slider(50 + 1);
);

function set_poly(k) local(s, v)
(
  POLY = k == 0 ? 8 : k == 1 ? 16 : k == 2 ? 24 : k == 3 ? 32 : k == 4 ? 48 : k == 5 ? 64 : k == 6 ? 96 : k == 7 ? 128 : k == 8 ? 192 : 256;
  NVE = min(NV, POLY + max(floor(POLY * 1.5), 4));
  s = 0;
  loop(NSLOT,
    slot_enter(s);
    v = VB; loop(NV, v_reset(v); v += VS; );
    nact = 0;
    slot_leave();
    s += 1;
  );
  last_poly = k;
);

function apply_settings() local(e)
(
  (slider(50) !== last_tune || slider(50 + 1) !== last_temper) ? calc_tune();
  slider(50 + 2) !== last_poly ? set_poly(slider(50 + 2));
  QUAL = max(0, min(2, slider(50 + 3)));
  BENDR = slider(50 + 4) > 0 ? slider(50 + 4) * 100 : 200;
  0 ? (
    e = slider(50 + 5); e = e == 1 ? 2 : e == 2 ? 4 : e == 3 ? 11 : 1;
    e !== SLOT[19] ? (
      SLOT[19] = e;
      slot_enter(0);
      DEF[e] = DEF[1] ? DEF[1] : f32(100 / 127);
      !RCV[e] ? CCV[e] = DEF[e];
      src_setup(); src_rate(); src_reset();
      slot_leave();
    );
  );
);

function ctl_cc(k) ( k == 0 ? 72 : k == 1 ? 99 : 10; );
function ctl_idx(c) ( c == 72 ? 0 : c == 99 ? 1 : c == 10 ? 2 : -1; );

function apply_sliders() local(m)
(
  apply_settings();
  vol_g = 10 ^ (vol_db / 20) * MASTER_G;
  SL = SLOT;
  !SL[20] ? (
    slot_config(0, 1, 0); SL[20] = 1;
