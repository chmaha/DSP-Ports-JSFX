slider52:poly_sel=5<0,9,1{8,16,24,32,48,64,96,128,192,256}>-Polyphony
slider53:quality=2<0,2,1{Nearest,Linear,Hermite}>-Sample Quality
slider54:bend_rng=0<0,24,1>-Pitch Bend Range (semitones, 0 = instrument)

