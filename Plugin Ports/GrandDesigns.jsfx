  );
  SL = SLOT;
  SL[21] = max(0, min(16, floor(midi_ch + 0.5)));
  SL[22] = 1; SL[23] = 1; SL[24] = 1;
);

!inited ? (
  memset(PKS, 0, 200);
  sec_ok = sec_load();
  i = 0; loop(NPACK, PKZ[i] = TXT[8 + i]; i += 1; );
  heap_top = HEAP; ld_h = -1; rng = 0; rt_clk = 0; rt_ofs = 0; gui_gain = 1; g_slot = 0;
  last_poly = -1; last_tune = -1; QUAL = 2; BENDR = 200;
  eng_rate();
  memset(SLOT, 0, NSLOT * SLS);
  inited = 1;
  apply_sliders();
  all_need();
  sec_ok ? while (load_pending()) ( loader_step(); );
);
apply_sliders();
vgt = vol_g;

@slider
srate !== last_rate ? (
  eng_rate();
  s = 0; loop(NSLOT, slot_enter(s); src_rate(); slot_leave(); s += 1; );
);
apply_sliders();

@block
apply_sliders();
all_need();
sec_ok ? loader_run(SLOT[4] > 0 ? 0.003 : 0.03);
slot_ready_check(0);
SL = SLOT;
memset(OBBASE, 0, samplesblock); memset(OBBASE + OBS, 0, samplesblock);
nlive = SL[2] ? 1 : 0; LIVE[0] = 0;
nev = 0;
while (q_r != g_qw) (
  nev < MAXEV ? (
    MEV[nev * 4] = 0; MEV[nev * 4 + 1] = GQ[q_r * 4]; MEV[nev * 4 + 2] = GQ[q_r * 4 + 1]; MEV[nev * 4 + 3] = GQ[q_r * 4 + 2];
    nev += 1;
  );
  q_r = (q_r + 1) % 64;
);
while (midirecv(ofs, m1, m2, m3)) (
  (SL[21] === 0 || (m1 & 15) === SL[21] - 1) && nev < MAXEV ? (
    MEV[nev * 4] = ofs; MEV[nev * 4 + 1] = m1 & 0xF0; MEV[nev * 4 + 2] = m2; MEV[nev * 4 + 3] = m3;
    nev += 1;
  );
  midisend(ofs, m1, m2, m3);
);
SL[2] ? (
  slot_enter(0);
  k = 0;
  loop(3,
    c = ctl_cc(k); x = slider(2 + k);
    x !== CSL[k] ? ( CSL[k] = x; CCV[c] = f32(x); RCV[c] = 1; egg += 1; );
    k += 1;
  );
  CB0 = 0; e0 = 0;
  while (CB0 < samplesblock) (
    CHN = min(MAXB, samplesblock - CB0);
    e1 = e0; non = 0;
    while (e1 < nev && MEV[e1 * 4] < CB0 + CHN) ( MEV[e1 * 4] -= CB0; MEV[e1 * 4 + 1] === 0x90 && MEV[e1 * 4 + 3] > 0 ? non = 1; e1 += 1; );
    k = 0; loop(nact, v = AV[k]; v[0] === 1 ? ( v[174] = min(CHN, max(0, v[155])); v[175] = min(CHN, max(0, v[170])); ); k += 1; );
    (nact > 0 || non) ? ( src_block(CHN, e0, e1); HASST ? glob_span(CHN); );
    SL[11] = 0;
    k = e0;
    while (k < e1) (
      ofs = MEV[k * 4]; st = MEV[k * 4 + 1]; m2 = MEV[k * 4 + 2]; m3 = MEV[k * 4 + 3];
      render(SL[11], ofs); SL[11] = ofs; rt_ofs = ofs;
      st === 0x90 && m3 > 0 ? (
        KEYON[m2] = 1; note_on(m2, m3);
      ) : st === 0x80 || st === 0x90 ? ( KEYON[m2] = 0; note_off(m2); )
      : st === 0xB0 ? (
        RCV[m2] = 1; cc_in(m2, m3);
        j = ctl_idx(m2);
        j >= 0 ? ( slider(2 + j) = m3 / 127; CSL[j] = slider(2 + j); sliderchange(2 ^ (1 + j)); );
      ) : st === 0xE0 ? pitch_in(m3 * 128 + m2 - 8192);
      k += 1;
    );
    render(SL[11], CHN); SL[11] = CHN;
    k = 0; loop(nact, v = AV[k]; v[9] ? ( v[8] = 0; v[9] = 0; ); k += 1; );
    e0 = e1;
    CB0 += CHN; rt_clk += CHN;
  );
  CB0 = 0;
  slot_leave();
);
bi = 0;
vgc = vgt; vgt = vol_g; vgs = (vgt - vgc) / samplesblock;

@sample
vgs ? ( vgc += vgs; spl0 = OBBASE[bi] * vgc; spl1 = (OBBASE + OBS)[bi] * vgc; )
: ( spl0 = OBBASE[bi] * vgt; spl1 = (OBBASE + OBS)[bi] * vgt; );
bi += 1;

@gfx 1000 404

UDW = 1000;
KSTYLE = 1;
ufr = UDW / 1000;
UDH = 404;
uscale = max(0.5, min(gfx_w / UDW, gfx_h / UDH));
uox = floor((gfx_w - UDW * uscale) * 0.5);
uoy = 0;

function automate(s, e)
(
<?
  max_sliders > 10 ? printf("slider_automate(2^(s-1), e);") :
    printf("s == 1 ? slider_automate(vol_db, e) : s == 2 ? slider_automate(rel_cc, e) : s == 3 ? slider_automate(vel_cc, e) : s == 4 ? slider_automate(pan_cc, e) : s == 10 ? slider_automate(midi_ch, e) :");
?> 0;
);

function smin(s) ( s == 1 ? -12 : 0; );
function smax(s) ( s == 1 ? 12 : 1; );
function sdef(s) ( s == 2 ? 0.05 : s == 3 ? 1 : s == 4 ? 0.5 : 0; );
function set_slider(s, x) ( slider(s) = x; automate(s, 0); automate(s, 1); );
function hit_circle(mx, my, cx, cy, rad) ( sqr(mx - cx) + sqr(my - cy) <= sqr(rad); );
function hit_rect(mx, my, x, y, w, h) ( mx >= x && mx <= x + w && my >= y && my <= y + h; );
function px(x) ( uox + x * uscale; );
function py(y) ( uoy + y * uscale; );
function norm_of(s) ( (slider(s) - smin(s)) / (smax(s) - smin(s)); );
function set_norm(s, x) local(old, nv) (
  old = slider(s);
  nv = smin(s) + max(0, min(1, x)) * (smax(s) - smin(s));
  s == 1 ? nv = floor(nv * 10 + 0.5) / 10 : nv = floor(nv * 1000 + 0.5) / 1000;
  slider(s) = nv;
  slider(s) !== old ? automate(s, 0);
);

function ctext(str, cx, y, fs, fl) local(tw, th)
(
  gfx_setfont(1, "Arial", fs * uscale, fl);
  gfx_measurestr(str, tw, th);
  gfx_x = cx - tw * 0.5; gfx_y = y;
  gfx_drawstr(str);
);

function knob_name(s) (
  s == 1 ? "VOLUME" : s == 2 ? "RELEASE" : s == 3 ? "VELOCITY" : "PAN";
);

function knob_value(s) local(v) (
  v = slider(s);
  s == 1 ? sprintf(#ukv, "%+.1f dB", v) :
  s == 2 ? sprintf(#ukv, "%.2f s", 0.001 + 2 * v) :
  s == 3 ? sprintf(#ukv, "%d%%", floor(v * 100 + 0.5)) :
  abs(v - 0.5) < 0.004 ? strcpy(#ukv, "C") :
  sprintf(#ukv, v < 0.5 ? "L%d" : "R%d", floor(abs(v - 0.5) * 200 + 0.5));
  #ukv;
);

function hint_text(s)
(
  s == 1 ? "Volume: output level, plus or minus 12 dB." :
  s == 2 ? "Release (CC72): how long notes take to fade after the key comes up, 0 to 2 s." :
  s == 3 ? "Velocity (CC99): how much key velocity changes the level. 0% plays every note at full level." :
  s == 4 ? "Pan (CC10): position in the stereo field." :
  s == 18 ? "Sustain (CC64): glows as the dampers lift. Click to hold or release; scroll or drag for half-pedal." :
  s == 17 ? "Click to play (88 keys). Lower on the key is louder." :
  KSTYLE == 3 ? "Drag a fader sideways or scroll  ·  Ctrl for fine control  ·  double-click to reset" : "Drag or scroll a knob to adjust  ·  Ctrl for fine control  ·  double-click to reset";
);

function ptr_bar(cx, cy, sa, ca, r0, r1, w) local(hx, hy)
(
  hx = ca * w * 0.5; hy = sa * w * 0.5;
  gfx_triangle(cx + sa * r0 - hx, cy - ca * r0 - hy, cx + sa * r0 + hx, cy - ca * r0 + hy,
               cx + sa * r1 + hx, cy - ca * r1 + hy, cx + sa * r1 - hx, cy - ca * r1 - hy);
);

function cp_knob(cx, cy, rad, pos) local(ang, i, a, a2, b, rc, sa, ca)
(
  gfx_set(0, 0, 0, 0.45);
  gfx_circle(cx + rad * 0.05, cy + rad * 0.09, rad * 1.03, 1, 1);
  gfx_set(0.035, 0.035, 0.038, 1);
  gfx_circle(cx, cy, rad, 1, 1);
  gfx_set(0.20, 0.20, 0.21, 1);
  gfx_circle(cx, cy, rad, 0, 1);
  gfx_set(0.10, 0.10, 0.11, 1);
  gfx_circle(cx, cy - rad * 0.04, rad * 0.86, 0, 1);
  rc = rad * 0.74;
  i = 0;
  loop(96,
    a = i * 2 * $pi / 96; a2 = (i + 1.6) * 2 * $pi / 96;
    b = 0.735 + 0.235 * cos(2 * (a + $pi / 96 - 0.45));
    gfx_set(b, b * 0.98, b * 0.87, 1);
    gfx_triangle(cx, cy, cx + sin(a) * rc, cy - cos(a) * rc, cx + sin(a2) * rc, cy - cos(a2) * rc);
    i += 1;
  );
  i = 0;
  loop(max(2, ceil(3 * uscale)),
    gfx_set(0.06 + 0.05 * i / max(2, ceil(3 * uscale)), 0.06, 0.055, 1);
    gfx_circle(cx, cy, rc + i * 0.5, 0, 1);
    i += 1;
  );
  ang = -2.35619 + 4.71239 * pos;
  sa = sin(ang); ca = cos(ang);
  gfx_set(0.09, 0.09, 0.08, 1);
  ptr_bar(cx, cy, sa, ca, rad * 0.10, rc * 0.96, max(2, rc * 0.11));
);

function wu_knob(cx, cy, rad, pos) local(ang, i, t, r, sa, ca)
(
  gfx_set(0.30, 0.31, 0.34, 1);
  gfx_circle(cx + rad * 0.05, cy + rad * 0.10, rad * 1.04, 1, 1);
  i = 0;
  loop(14,
    t = i / 13;
    r = rad * (1 - 0.40 * t);
    gfx_set(0.66 + 0.30 * t, 0.68 + 0.29 * t, 0.71 + 0.27 * t, 1);
    gfx_circle(cx - rad * 0.06 * t, cy - rad * 0.08 * t, r, 1, 1);
    i += 1;
  );
  gfx_set(0.55, 0.57, 0.60, 1);
  gfx_circle(cx, cy, rad, 0, 1);
  ang = -2.35619 + 4.71239 * pos;
  sa = sin(ang); ca = cos(ang);
  gfx_set(0.16, 0.16, 0.18, 1);
  ptr_bar(cx, cy, sa, ca, rad * 0.64, rad * 0.94, max(2, rad * 0.09));
  gfx_set(0.42, 0.44, 0.47, 1);
  gfx_circle(cx, cy, rad * 0.58, 1, 1);
  i = 0;
  loop(12,
    t = i / 11;
    gfx_set(0.02 + 0.20 * t * t, 0.02 + 0.21 * t * t, 0.03 + 0.24 * t * t, 1);
    gfx_circle(cx - rad * 0.14 * t, cy - rad * 0.16 * t, rad * (0.54 - 0.40 * t), 1, 1);
    i += 1;
  );
);

function rk_draw(cx, cy, rad, pos) local(ang0, ang1, ang, i, a, sa, ca)
(
  KSTYLE == 2 ? wu_knob(cx, cy, rad, pos) : KSTYLE == 1 ? cp_knob(cx, cy, rad, pos) : (
  ang0 = -2.35619;
  ang1 = 2.35619;
  gfx_set(0, 0, 0, 0.35);
  gfx_circle(cx + rad * 0.06, cy + rad * 0.10, rad * 1.02, 1, 1);
  gfx_set(0.78, 0.66, 0.40, 1);
  gfx_circle(cx, cy, rad, 1, 1);
  i = 0;
  loop(36,
    a = i * 2 * $pi / 36;
    gfx_set(0.78, 0.66, 0.40, 1);
    gfx_line(cx + sin(a) * rad * 0.84, cy - cos(a) * rad * 0.84, cx + sin(a) * rad * 0.97, cy - cos(a) * rad * 0.97, 1);
    i += 1;
  );
  gfx_set(0.05, 0.045, 0.04, 1);
  gfx_circle(cx, cy, rad * 0.80, 1, 1);
  gfx_set(1, 1, 1, 0.07);
  gfx_circle(cx - rad * 0.12, cy - rad * 0.14, rad * 0.54, 1, 1);
  ang = ang0 + (ang1 - ang0) * pos;
  sa = sin(ang); ca = cos(ang);
  gfx_set(0.98, 0.92, 0.76, 1);
  ptr_bar(cx, cy, sa, ca, rad * 0.30, rad * 0.78, max(2, rad * 0.09));
  );
);

function scale_ticks(cx, cy, rad) local(i, a, big)
(
  i = 0;
  KSTYLE == 2 ? 0 : KSTYLE == 1 ? loop(11,
    a = -2.35619 + 4.71239 * i / 10;
    gfx_set(0.58, 0.58, 0.58, 1);
    gfx_circle(cx + sin(a) * rad * 1.28, cy - cos(a) * rad * 1.28, max(1, 1.7 * uscale), 1, 1);
    i += 1;
  ) : loop(11,
    a = -2.35619 + 4.71239 * i / 10;
    big = i == 0 || i == 10 || i == 5;
    gfx_set(0.96, 0.92, 0.82, big ? 0.9 : 0.45);
    gfx_line(cx + sin(a) * rad * 1.12, cy - cos(a) * rad * 1.12, cx + sin(a) * rad * (big ? 1.30 : 1.22), cy - cos(a) * rad * (big ? 1.30 : 1.22), 1);
    i += 1;
  );
);

function knob_at(s, cx, cy, rad, fsz) local(hov, x, ly, act)
(
  hov = hit_circle(mouse_x, mouse_y, cx, cy, rad + 4 * uscale);
  hov ? u_hov = s;
  (u_click && hov) ? (
    (u_ctarget == s && time_precise() - u_ctime < 0.3) ? (
      set_slider(s, sdef(s));
      u_drag = 0;
    ) : (
      u_drag = s; u_dy0 = mouse_y; u_dv0 = norm_of(s); u_dfine = mouse_cap & 4;
      automate(s, 0);
    );
    u_ctarget = s; u_ctime = time_precise();
    u_click = 0;
  );
  (hov && u_wheel != 0 && u_drag == 0) ? (
    x = norm_of(s) + (u_wheel / 120) * ((mouse_cap & 4) ? 0.0079 : 0.0394);
    set_norm(s, x);
    automate(s, 1);
    u_wheel = 0;
  );
  scale_ticks(cx, cy, rad);
  rk_draw(cx, cy, rad, norm_of(s));
  act = hov || u_drag == s;
  KSTYLE == 2 ? (
    gfx_set(0.13, 0.13, 0.15, 1);
    ctext(knob_name(s), cx, cy - rad * 1.22 - (fsz + 4) * uscale, fsz, 'b');
    act ? gfx_set(0.66, 0.12, 0.12, 1) : gfx_set(0.30, 0.31, 0.34, 1);
    ctext(knob_value(s), cx, cy + rad * 1.22 + 2 * uscale, 12, act ? 'b' : 0);
  ) : (
    ly = cy + rad * 1.36 + 2 * uscale;
    gfx_set(0.96, 0.92, 0.82, 1);
    ctext(knob_name(s), cx, ly, fsz, 'b');
    act ? gfx_set(0.94, 0.78, 0.42, 1) : gfx_set(0.68, 0.63, 0.54, 1);
    ctext(knob_value(s), cx, ly + (fsz + 4) * uscale, 12, 0);
  );
);

function fader_at(s, cx, cy, len, fsz) local(hov, x, act, pos, fx, cw, ch, i, x0)
(
  x0 = cx - len * 0.5;
  hov = hit_rect(mouse_x, mouse_y, x0 - 12 * uscale, cy - 16 * uscale, len + 24 * uscale, 32 * uscale);
  hov ? u_hov = s;
  (u_click && hov) ? (
    (u_ctarget == s && time_precise() - u_ctime < 0.3) ? (
      set_slider(s, sdef(s));
      u_drag = 0;
    ) : (
      u_drag = s; u_dy0 = mouse_x; u_dv0 = norm_of(s); u_dfine = mouse_cap & 4; u_dlen = len;
      automate(s, 0);
    );
    u_ctarget = s; u_ctime = time_precise();
    u_click = 0;
  );
  (hov && u_wheel != 0 && u_drag == 0) ? (
    x = norm_of(s) + (u_wheel / 120) * ((mouse_cap & 4) ? 0.0079 : 0.0394);
    set_norm(s, x);
    automate(s, 1);
    u_wheel = 0;
  );
  i = 0;
  loop(11,
    gfx_set(0.42, 0.40, 0.37, 1);
    gfx_rect(floor(x0 + len * i / 10), cy + 9 * uscale, max(1, uscale), (i == 0 || i == 5 || i == 10 ? 6 : 4) * uscale, 1);
    i += 1;
  );
  gfx_set(0.10, 0.09, 0.08, 1);
  gfx_rect(x0, cy - 3 * uscale, len, 6 * uscale, 1);
  gfx_set(0.97, 0.96, 0.93, 1);
  gfx_rect(x0, cy + 3 * uscale, len, max(1, uscale), 1);
  pos = norm_of(s);
  fx = x0 + pos * len;
  cw = 16 * uscale; ch = 28 * uscale;
  gfx_set(0.20, 0.19, 0.18, 1);
  gfx_rect(fx - cw * 0.5 + 2 * uscale, cy - ch * 0.5 + 3 * uscale, cw, ch, 1);
  gfx_set(0.22, 0.22, 0.23, 1);
  gfx_rect(fx - cw * 0.5 - uscale, cy - ch * 0.5 - uscale, cw + 2 * uscale, ch + 2 * uscale, 1);
  gfx_gradrect(fx - cw * 0.5, cy - ch * 0.5, cw, ch, 0.96, 0.96, 0.97, 1, 0, 0, 0, 0, -0.016 / uscale, -0.016 / uscale, -0.015 / uscale, 0);
  i = 0;
  loop(4,
    gfx_set(0.40, 0.40, 0.42, 1);
    gfx_rect(fx - cw * 0.5 + 2 * uscale, cy - ch * 0.5 + (4 + i * 2.2) * uscale, cw - 4 * uscale, max(1, uscale), 1);
    gfx_rect(fx - cw * 0.5 + 2 * uscale, cy + ch * 0.5 - (5 + i * 2.2) * uscale, cw - 4 * uscale, max(1, uscale), 1);
    i += 1;
  );
  gfx_set(0.94, 0.78, 0.42, 1);
  gfx_rect(fx - max(1, uscale), cy - 3 * uscale, max(2, 2 * uscale), 6 * uscale, 1);
  act = hov || u_drag == s;
  gfx_set(0.13, 0.12, 0.11, 1);
  ctext(knob_name(s), cx, cy - 34 * uscale - fsz * uscale, fsz, 'b');
  act ? gfx_set(0.62, 0.30, 0.04, 1) : gfx_set(0.30, 0.29, 0.27, 1);
  ctext(knob_value(s), cx, cy + 21 * uscale, 12, act ? 'b' : 0);
);

function send_ev(st, d1, d2)
(
  GQ[g_qw * 4] = st; GQ[g_qw * 4 + 1] = d1; GQ[g_qw * 4 + 2] = d2; GQ[g_qw * 4 + 3] = 0;
  g_qw = (g_qw + 1) % 64;
);

function pedal_widget(x, y, w, h) local(hov, v, fill, pnv, cx, cy, lr)
(
  hov = hit_rect(mouse_x, mouse_y, x, y, w, h);
  hov ? u_hov = 18;
  v = floor((SLOT + 200)[64] * 127 + 0.5);
  (u_click && hov) ? (
    u_pdrag = 1; u_pdy0 = mouse_y; u_pdv0 = v; u_pmoved = 0;
    u_click = 0;
  );
  u_pdrag ? (
    u_down ? (
      abs(mouse_y - u_pdy0) > 3 * uscale ? u_pmoved = 1;
      u_pmoved ? (
        pnv = max(0, min(127, floor(u_pdv0 + (mouse_y - u_pdy0) / (h * 0.8) * 127 + 0.5)));
        pnv != v ? send_ev(176, 64, pnv);
      );
    ) : (
      !u_pmoved ? send_ev(176, 64, v >= 64 ? 0 : 127);
      u_pdrag = 0;
    );
  );
  (hov && u_wheel != 0 && !u_pdrag) ? (
    send_ev(176, 64, max(0, min(127, v + (u_wheel > 0 ? 8 : -8))));
    u_wheel = 0;
  );
  fill = max(0, min(1, v / 64));
  cx = x + w * 0.5; cy = y + h * 0.5; lr = 8 * uscale;
  fill > 0.01 ? (
    gfx_set(1, 0.62, 0.20, 0.10 + 0.25 * fill); gfx_circle(cx, cy, lr * (1.2 + 0.4 * fill), 1, 1);
  );
  gfx_set(0.02, 0.02, 0.025, 1); gfx_circle(cx, cy, lr + 2 * uscale, 1, 1);
  gfx_set(0.20 + 0.78 * fill, 0.10 + 0.55 * fill, 0.05 + 0.15 * fill, 1); gfx_circle(cx, cy, lr, 1, 1);
  gfx_set(1, 0.85, 0.55, 0.15 + 0.55 * fill); gfx_circle(cx - lr * 0.3, cy - lr * 0.3, lr * 0.3, 1, 1);
  KSTYLE >= 2 ? (
    gfx_set(0.13, 0.13, 0.15, 1);
    ctext("SUSTAIN", cx, y - 16 * uscale - 12 * uscale, 12, 'b');
    (hov || u_pdrag) ? gfx_set(0.66, 0.12, 0.12, 1) : gfx_set(0.30, 0.31, 0.34, 1);
  ) : (
    gfx_set(0.96, 0.92, 0.82, 1);
    ctext("SUSTAIN", cx, y + h + 2 * uscale, 12, 'b');
    (hov || u_pdrag) ? gfx_set(0.94, 0.78, 0.42, 1) : gfx_set(0.68, 0.63, 0.54, 1);
  );
  fill >= 0.995 ? strcpy(#upd, "full") : fill <= 0.005 ? strcpy(#upd, "off") : sprintf(#upd, "%d%%", floor(fill * 100 + 0.5));
  ctext(#upd, cx, y + h + 16 * uscale, 11, 0);
);

function kb_draw(x, y, w, h, lo, nw, held, sc) local(ww, bw, bh, n, wi, pc, isb, kx, kwid, dn, KD)
(
  KD = SLOT + 950;
  ww = w / nw;
  bw = ww * 0.58; bh = h * 0.62;
  gfx_set(0.50, 0.05, 0.07, 1);
  gfx_rect(x, y - 7 * sc, w, 7 * sc, 1);
  gfx_set(0, 0, 0, 0.35);
  gfx_rect(x, y - 2 * sc, w, 2 * sc, 1);
  gfx_set(0.02, 0.02, 0.02, 1);
  gfx_rect(x, y, w, h, 1);
  n = lo; wi = 0;
  while (wi < nw) (
    pc = n % 12;
    isb = pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10;
    !isb ? (
      kx = floor(x + wi * ww) + max(1, floor(sc));
      kwid = floor(x + (wi + 1) * ww) - kx;
      dn = KD[n] > 0 || n == held;
      dn ? (
        gfx_gradrect(kx, y, kwid, h - 2 * sc, 0.82, 0.81, 0.78, 1, 0, 0, 0, 0, -0.12 / h, -0.12 / h, -0.12 / h, 0);
      ) : (
        gfx_gradrect(kx, y, kwid, h, 0.97, 0.96, 0.93, 1, 0, 0, 0, 0, -0.06 / h, -0.06 / h, -0.06 / h, 0);
        gfx_set(1, 1, 1, 0.5); gfx_rect(kx, y + h - 4 * sc, kwid, 1 * sc, 1);
        gfx_set(0.72, 0.71, 0.68, 1); gfx_rect(kx, y + h - 3 * sc, kwid, 3 * sc, 1);
      );
      gfx_set(0, 0, 0, dn ? 0.45 : 0.25); gfx_rect(kx, y, kwid, 3 * sc, 1);
      wi += 1;
    );
    n += 1;
  );
  n = lo; wi = 0;
  while (wi < nw) (
    pc = n % 12;
    isb = pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10;
    isb ? (
      kx = floor(x + wi * ww - bw * 0.5);
      dn = KD[n] > 0 || n == held;
      gfx_set(0, 0, 0, 0.45); gfx_rect(kx + 2 * sc, y, bw, bh + 3 * sc, 1);
      gfx_gradrect(kx, y, bw, dn ? bh - 2 * sc : bh, 0.05, 0.05, 0.055, 1, 0, 0, 0, 0, 0.12 / bh, 0.12 / bh, 0.12 / bh, 0);
      !dn ? (
        gfx_set(1, 1, 1, 0.10); gfx_rect(kx + 2 * sc, y + bh - 9 * sc, bw - 4 * sc, 7 * sc, 1);
        gfx_set(1, 1, 1, 0.06); gfx_rect(kx + 2 * sc, y + 3 * sc, max(1, sc), bh - 14 * sc, 1);
      );
    ) : wi += 1;
    n += 1;
  );
);

function cheek(x, y, w, h)
(
  gfx_gradrect(x, y, w, h, 0.13, 0.11, 0.09, 1, 0.0006, 0.0006, 0.0006, 0, 0, 0, 0, 0);
  gfx_set(1, 1, 1, 0.06);
  gfx_rect(x + 2 * uscale, y, max(1, uscale), h, 1);
);

u_down = mouse_cap & 1;
u_click = u_down && !u_pstate;
u_wheel = mouse_wheel;
mouse_wheel = 0;
u_hov = 0;
u_kbinit == 0 ? ( u_kbinit = 1; u_kbnote = -1; );

// ---------------------------------------------------------------------- case
gfx_set(0.035, 0.030, 0.028, 1);
gfx_rect(0, 0, gfx_w, gfx_h, 1);
gfx_gradrect(px(0), py(0), UDW * uscale, 368 * uscale, 0.105, 0.095, 0.085, 1, 0, 0, 0, 0, -0.00012 / uscale, -0.00012 / uscale, -0.00012 / uscale, 0);
gfx_set(0.80, 0.68, 0.40, 1);
gfx_rect(px(0), py(62), UDW * uscale, max(1, 2 * uscale), 1);
gfx_set(1, 1, 1, 0.35);
gfx_rect(px(0), py(62), UDW * uscale, max(1, uscale), 1);

// ---------------------------------------------------------------------- header
gfx_set(0.96, 0.92, 0.82, 1);
gfx_setfont(2, "Arial", 34 * uscale, 'b');
gfx_x = px(28); gfx_y = py(12);
gfx_drawstr("Grand Designs");
gfx_measurestr("Grand Designs", utw, uth);
gfx_setfont(1, "Arial", 15 * uscale, 'b');
ubx = px(28) + utw + 14 * uscale;
gfx_set(0.94, 0.78, 0.42, 1);
gfx_x = ubx; gfx_y = py(26);
gfx_drawstr("YAMAHA CP80");
gfx_setfont(1, "Arial", 12 * uscale);
gfx_set(0.68, 0.63, 0.54, 1);
gfx_measurestr("by chmaha  ·  samples: Greg Sullivan", utw, uth);
gfx_x = px(UDW - 28) - utw; gfx_y = py(28);
gfx_drawstr("by chmaha  ·  samples: Greg Sullivan");

// ---------------------------------------------------------------------- controls row
KSTYLE == 2 ? (
  gfx_gradrect(px(0), py(76), UDW * uscale, 152 * uscale, 0.88, 0.90, 0.92, 1, 0, 0, 0, 0, -0.0009 / uscale, -0.0009 / uscale, -0.0008 / uscale, 0);
  gfx_set(0.50, 0.52, 0.55, 1); gfx_rect(px(0), py(76), UDW * uscale, max(1, uscale), 1);
  gfx_set(0.36, 0.37, 0.40, 1); gfx_rect(px(0), py(227), UDW * uscale, max(1, 2 * uscale), 1);
  gfx_set(0.38, 0.40, 0.43, 1); gfx_rect(px(0), py(139), UDW * uscale, max(1, 2 * uscale), 1);
  gfx_set(1, 1, 1, 1); gfx_rect(px(0), py(141), UDW * uscale, max(1, uscale), 1);
);
KSTYLE == 3 ? (
  gfx_gradrect(px(0), py(76), UDW * uscale, 152 * uscale, 0.90, 0.89, 0.86, 1, 0, 0, 0, 0, -0.0008 / uscale, -0.0008 / uscale, -0.0008 / uscale, 0);
  ubl = 0;
  gfx_set(1, 1, 1, 0.22);
  loop(floor(150 / 3),
    gfx_rect(px(0), py(78 + ubl * 3), UDW * uscale, 1, 1);
    ubl += 1;
  );
  gfx_set(0.48, 0.47, 0.44, 1); gfx_rect(px(0), py(76), UDW * uscale, max(1, uscale), 1);
  gfx_set(0.34, 0.33, 0.31, 1); gfx_rect(px(0), py(227), UDW * uscale, max(1, 2 * uscale), 1);
  pedal_widget(px(UDW * 0.12) - 36 * uscale, py(129), 72 * uscale, 22 * uscale);
  fader_at(1, px(UDW * 0.32), py(140), 96 * uscale, 13);
  fader_at(4, px(UDW * 0.505), py(140), 96 * uscale, 13);
  fader_at(2, px(UDW * 0.69), py(140), 96 * uscale, 13);
  fader_at(3, px(UDW * 0.875), py(140), 96 * uscale, 13);
) : (
pedal_widget(px(120 * ufr), py(KSTYLE == 2 ? 129 : 118), 72 * uscale, 22 * uscale);
knob_at(1, px(330 * ufr), py(KSTYLE == 2 ? 140 : 136), (KSTYLE == 2 ? 26 : 32) * uscale, KSTYLE == 2 ? 13 : 15);
gfx_set(0.42, 0.35, 0.22, 1);
KSTYLE != 2 ? gfx_rect(px(430 * ufr), py(80), max(1, uscale), 140 * uscale, 1);
knob_at(4, px(520 * ufr), py(140), 26 * uscale, 13);
knob_at(2, px(660 * ufr), py(140), 26 * uscale, 13);
knob_at(3, px(800 * ufr), py(140), 26 * uscale, 13);
);

// ---------------------------------------------------------------------- status
!sec_ok ? (
  gfx_set(0.10, 0.13, 0.20, 0.92);
  gfx_rect(px(20), py(150), (UDW - 40) * uscale, 50 * uscale, 1);
  gfx_set(1, 0.8, 0.5, 1);
  ctext("Missing or unreadable Dependencies/GrandDesigns/GrandDesigns.txt", px(UDW * 0.5), py(166), 14, 'b');
) : PKS[0] === 3 ? (
  gfx_set(0.10, 0.13, 0.20, 0.92);
  gfx_rect(px(20), py(150), (UDW - 40) * uscale, 50 * uscale, 1);
  gfx_set(1, 0.8, 0.5, 1);
  ctext("Missing or unreadable Dependencies/GrandDesigns/GrandDesigns.flac", px(UDW * 0.5), py(166), 14, 'b');
);

// ---------------------------------------------------------------------- keyboard
uwkw = 928 / 52 * uscale;
unwk = 52;
uklo = 21;
ukcnt = 88;
ukbw = unwk * uwkw;
ukbx = uox + (UDW * uscale - ukbw) * 0.5;
ukby = py(276); ukbh = 74 * uscale;
cheek(ukbx - 28 * uscale, py(262), 28 * uscale, 92 * uscale);
cheek(ukbx + ukbw, py(262), 28 * uscale, 92 * uscale);
ukhit = -1;
un = uklo;
uwi = 0;
loop(ukcnt,
  upc = un % 12;
  (upc == 1 || upc == 3 || upc == 6 || upc == 8 || upc == 10) ? (
    ukpx = ukbx + uwi * uwkw - uwkw * 0.29;
    hit_rect(mouse_x, mouse_y, ukpx, ukby, uwkw * 0.58, ukbh * 0.62) ? ( ukhit = un; ukhy = (mouse_y - ukby) / (ukbh * 0.62); );
  ) : uwi += 1;
  un += 1;
);
un = uklo;
uwi = 0;
loop(ukcnt,
  upc = un % 12;
  !(upc == 1 || upc == 3 || upc == 6 || upc == 8 || upc == 10) ? (
    ukpx = ukbx + uwi * uwkw;
    (ukhit < 0 && hit_rect(mouse_x, mouse_y, ukpx, ukby, uwkw, ukbh)) ? ( ukhit = un; ukhy = (mouse_y - ukby) / ukbh; );
    uwi += 1;
  );
  un += 1;
);
kb_draw(ukbx, ukby, ukbw, ukbh, uklo, unwk, u_kbnote, uscale);
ukhit >= 0 ? (
  u_hov = 17;
  u_click ? (
    send_ev(144, ukhit, floor(30 + 97 * min(1, max(0, ukhy))));
    u_kbnote = ukhit;
    u_click = 0;
  );
);
(u_kbnote >= 0 && !u_down) ? (
  send_ev(128, u_kbnote, 0);
  u_kbnote = -1;
);

(sec_ok && PKS[0] !== 2 && PKS[0] !== 3) ? (
  ulf = max(0, min(1, (PKS[0] === 1 ? ld_pos : 0) / max(1, PKZ[0])));
  gfx_set(0.03, 0.03, 0.035, 0.9);
  gfx_rect(px(8), py(258), (UDW - 16) * uscale, 100 * uscale, 1);
  gfx_set(0.96, 0.92, 0.82, 1);
  ctext("Loading samples...", px(UDW * 0.5), py(272), 18, 'b');
  gfx_set(0.16, 0.14, 0.11, 1);
  gfx_rect(px(UDW * 0.3), py(310), UDW * 0.4 * uscale, 10 * uscale, 1);
  gfx_set(0.94, 0.78, 0.42, 1);
  gfx_rect(px(UDW * 0.3), py(310), UDW * 0.4 * uscale * ulf, 10 * uscale, 1);
  gfx_set(0.68, 0.63, 0.54, 1);
  sprintf(#uld, "%d%%", floor(100 * ulf + 0.5));
  ctext(#uld, px(UDW * 0.5), py(326), 12, 0);
);

// ---------------------------------------------------------------------- hint bar
gfx_set(0.16, 0.14, 0.11, 1);
gfx_rect(px(0), py(368), UDW * uscale, 36 * uscale, 1);
uhs = u_drag > 0 ? u_drag : u_hov;
gfx_setfont(1, "Arial", 13 * uscale);
gfx_set(0.88, 0.83, 0.72, 1);
strcpy(#uhint, hint_text(uhs));
gfx_measurestr(#uhint, uhtw, uhth);
uhtw > (UDW - 20) * uscale ? ( gfx_setfont(1, "Arial", 13 * uscale * (UDW - 20) * uscale / uhtw); gfx_measurestr(#uhint, uhtw, uhth); );
gfx_x = uox + (UDW * uscale - uhtw) * 0.5; gfx_y = py(368) + (36 * uscale - uhth) * 0.5;
gfx_drawstr(#uhint);

u_drag > 0 ? (
  u_down ? (
    mouse_cap |= 65536;
    ufine = mouse_cap & 4;
    KSTYLE == 3 ? (
      ufine != u_dfine ? ( u_dy0 = mouse_x; u_dv0 = norm_of(u_drag); u_dfine = ufine; );
      set_norm(u_drag, u_dv0 + (mouse_x - u_dy0) / u_dlen * (ufine ? 0.1 : 1));
    ) : (
      ufine != u_dfine ? ( u_dy0 = mouse_y; u_dv0 = norm_of(u_drag); u_dfine = ufine; );
      set_norm(u_drag, u_dv0 + (u_dy0 - mouse_y) / (150 * uscale) * (ufine ? 0.1 : 1));
    );
  ) : ( automate(u_drag, 1); u_drag = 0; );
);

u_pstate = u_down;
