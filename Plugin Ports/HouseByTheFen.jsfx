// it under the terms of the GNU General Public License as published by
// the Free Software Foundation; either version 3 of the License, or
// (at your option) any later version.
//
// This program is distributed in the hope that it will be useful,
// but WITHOUT ANY WARRANTY; without even the implied warranty of
// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
// GNU General Public License for more details.
//
// You should have received a copy of the GNU General Public License
// along with this program.  If not, see <https://www.gnu.org/licenses/>.
//
// Modified 2026: translated to JSFX from Classic Reverb RE-01 by AnClark.
// https://github.com/AnClark/ClassicReverb-RE01

slider1:room_size=80<0.625,640,0.001>-Room Size (m2)
slider2:damping=40<0,100,0.1>-Damping (%)
slider3:pre_delay=0<-150,150,0.1>-Pre-delay (ms)
slider4:hi_damp=30<0,100,0.1>-Hi Damping (%)
slider5:lo_cut=80<20,1000,0.1>-Lo-Cut (Hz)
slider6:early_ref=-6<-40,6,0.1>-Early Reflections (dB)
slider7:mix=35<0,100,0.1>-Mix (%)
slider8:level=0<-10,10,0.1>-Level (dB)

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

options:no_meter
options:maxmem=4194304

@init
ext_noinit = gfx_ext_retina = 1;
CR_CLIP = 0;
CR_GATE = 1;
function f32(x) local(c) ( c = x * 536870913; c - (c - x); );
function f32k(x) local(c) ( c = x * 536870913; c - (c - x); );
function alloc(n) local(r) instance(mp) global() ( r = mp; mp += n; memset(r, 0, n); r; );
function rint(x) local(r) ( r = floor(x + 0.5); r - x === 0.5 && r - 2 * floor(r / 2) !== 0 ? r -= 1; r; );
cr_last_srate = -1; cr_rng = 0; cr_idle = 0; cr_quiet = 0;
CR_EPS = f32k(0.000002);
function gsx(x) ( G_OX + x * G_SC; );
function gsy(y) ( y * G_SC; );
function gclamp(x, a, b) ( min(b, max(a, x)); );

function grspan(qx0, qy0, qx1, qy1, qrad, yc) local(dy, ins) (
  dy = yc < qy0 + qrad ? qy0 + qrad - yc : yc > qy1 - qrad ? yc - (qy1 - qrad) : 0;
  G_RC = max(0, min(1, qrad - dy + 0.5));
  dy = min(qrad, dy);
  ins = qrad - sqrt(max(0, qrad * qrad - dy * dy));
  G_RL = qx0 + ins; G_RR = qx1 - ins;
);

function gspan(lx, rx, j, a) local(lc, rc) (
  lc = ceil(lx); rc = floor(rx);
  rc >= lc ? (
    gfx_a = a; rc > lc ? gfx_rect(lc, j, rc - lc, 1);
    lc - lx > 0 ? ( gfx_a = a * (lc - lx); gfx_rect(lc - 1, j, 1, 1); );
    rx - rc > 0 ? ( gfx_a = a * (rx - rc); gfx_rect(rc, j, 1, 1); );
  ) : rx > lx ? ( gfx_a = a * (rx - lx); gfx_rect(floor(lx), j, 1, 1); );
);

function gfrr(qx0, qy0, qx1, qy1, qrad, cr, cg, cb, a0) local(j) (
  qx0 = floor(qx0 + 0.5); qy0 = floor(qy0 + 0.5); qx1 = floor(qx1 + 0.5); qy1 = floor(qy1 + 0.5);
  qrad = max(0, min(qrad, min(qy1 - qy0, qx1 - qx0) * 0.5));
  gfx_set(cr, cg, cb, a0);
  j = qy0;
  loop(qy1 - qy0,
    grspan(qx0, qy0, qx1, qy1, qrad, j + 0.5);
    G_RC > 0 ? gspan(G_RL, G_RR, j, a0 * G_RC);
    j += 1;
  );
  gfx_a = 1;
);

function gbord(qx0, qy0, qx1, qy1, qrad, t, cr, cg, cb, a0) local(j, ol, orr, oc, il, ir, ic) (
  qx0 = floor(qx0 + 0.5); qy0 = floor(qy0 + 0.5); qx1 = floor(qx1 + 0.5); qy1 = floor(qy1 + 0.5);
  qrad = max(0, min(qrad, min(qy1 - qy0, qx1 - qx0) * 0.5));
  gfx_set(cr, cg, cb, a0);
  j = qy0;
  loop(qy1 - qy0,
    grspan(qx0, qy0, qx1, qy1, qrad, j + 0.5); ol = G_RL; orr = G_RR; oc = G_RC;
    (j + 0.5 > qy0 + t && j + 0.5 < qy1 - t) ? (
      grspan(qx0 + t, qy0 + t, qx1 - t, qy1 - t, max(0, qrad - t), j + 0.5); il = G_RL; ir = G_RR; ic = G_RC;
    ) : ( ic = 0; );
    oc > 0 ? (
      ic <= 0 ? gspan(ol, orr, j, a0 * oc) : (
        gspan(ol, il, j, a0 * oc);
        gspan(ir, orr, j, a0 * oc);
        oc - ic > 0.004 ? gspan(il, ir, j, a0 * (oc - ic));
      );
    );
    j += 1;
  );
  gfx_a = 1;
);

function gcard(x, y, w, h, r, a0, ba) local(xx, yy, ww, hh, rr) (
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC); rr = max(2, floor(r * G_SC));
  gfrr(xx, yy, xx + ww, yy + hh, rr, 0.165, 0.17, 0.18, a0);
  gbord(xx, yy, xx + ww, yy + hh, rr, max(1, floor(G_SC + 0.5)), 0.62, 0.66, 0.70, ba);
);

function gtext(x, y, s, fnt, r, g, b, a, ctr) local(tw, th) (
  gfx_setfont(fnt);
  gfx_set(r, g, b, a);
  gfx_measurestr(s, tw, th);
  gfx_x = ctr === 1 ? gsx(x) - tw * 0.5 : ctr === 2 ? gsx(x) - tw : gsx(x);
  gfx_y = gsy(y) - th * 0.5;
  gfx_drawstr(s);
);

function gann(cx, cy, ri, ro, aa, ab, cr, cg, cb, al) local(py, px, dy, dx, hwo, hwi, d, cv, th, ca, x0, x1, x2, x3) (
  py = floor(cy - ro - 1);
  loop(ceil(2 * ro + 3),
    dy = py + 0.5 - cy;
    hwo = sqrt(max(0, (ro + 0.5) * (ro + 0.5) - dy * dy));
    hwo > 0 ? (
      hwi = ri > 0.5 ? sqrt(max(0, (ri - 0.5) * (ri - 0.5) - dy * dy)) : 0;
      x0 = floor(cx - hwo); x1 = ceil(cx - hwi); x2 = floor(cx + hwi); x3 = ceil(cx + hwo);
      hwi <= 0 ? x1 = x3 + 1;
      px = x0;
      while (px <= x3) (
        dx = px + 0.5 - cx;
        d = sqrt(dx * dx + dy * dy);
        cv = min(1, min(ro - d + 0.5, d - ri + 0.5));
        cv > 0 ? (
          th = atan2(dx, -dy);
          ca = min(1, min((th - aa) * d + 0.5, (ab - th) * d + 0.5));
          ca > 0 ? (
            gfx_set(cr, cg, cb, al * cv * ca);
            gfx_rect(px, py, 1, 1);
          );
        );
        px += 1;
        (px > x1 && px < x2) ? px = x2;
      );
    );
    py += 1;
  );
  gfx_a = 1;
);

function gbar(x0, y0, x1, y1, w) local(dx, dy, ll, hw, bx0, by0, bx1, by1, px, py, qx, qy, t, ex, ey, d, cv, cr, cg, cb, ca) (
  cr = gfx_r; cg = gfx_g; cb = gfx_b; ca = gfx_a;
  dx = x1 - x0; dy = y1 - y0; ll = max(0.000001, dx * dx + dy * dy);
  hw = w * 0.5;
  bx0 = floor(min(x0, x1) - hw - 1); bx1 = ceil(max(x0, x1) + hw + 1);
  by0 = floor(min(y0, y1) - hw - 1); by1 = ceil(max(y0, y1) + hw + 1);
  py = by0;
  while (py <= by1) (
    px = bx0;
    while (px <= bx1) (
      qx = px + 0.5; qy = py + 0.5;
      t = max(0, min(1, ((qx - x0) * dx + (qy - y0) * dy) / ll));
      ex = qx - (x0 + t * dx); ey = qy - (y0 + t * dy);
      d = sqrt(ex * ex + ey * ey);
      cv = min(1, hw - d + 0.5);
      cv > 0 ? ( gfx_set(cr, cg, cb, ca * cv); gfx_rect(px, py, 1, 1); );
      px += 1;
    );
    py += 1;
  );
  gfx_set(cr, cg, cb, ca);
);

function gknob(kx, ky, kr, v, ctr, hov, nm, vs, dim) local(cx, cy, r, a0, a1, sa, ca, px0, py0, al) (
  cx = gsx(kx); cy = gsy(ky); r = kr * G_SC;
  al = dim ? 0.66 : 1;
  a0 = -$pi * 0.75; a1 = $pi * 0.75;
  gfx_set(0.02, 0.02, 0.03, 0.5 * al);
  gfx_circle(cx, cy, r + 3 * G_SC, 1, 1);
  gfx_set(0.11, 0.12, 0.13, 1);
  gfx_circle(cx, cy, r - 5 * G_SC, 1, 1);
  gfx_set(0.20, 0.21, 0.23, 1);
  gfx_circle(cx, cy, r - 7 * G_SC, 1, 1);
  gfx_set(0.13, 0.14, 0.15, 1);
  gfx_circle(cx, cy + 1.2 * G_SC, r - 9 * G_SC, 1, 1);
  gann(cx, cy, r - 1.2 * G_SC, r + 1.2 * G_SC, a0, a1, 0.62, 0.66, 0.70, 0.35 * al);
  sa = a0 + (a1 - a0) * v;
  ca = a0 + (a1 - a0) * ctr;
  abs(sa - ca) > 0.001 ? (
    gann(cx, cy, r - 3.5 * G_SC, r + 3.5 * G_SC, min(ca, sa), max(ca, sa), G_ACR, G_ACG, G_ACB, 0.18 * al);
    gann(cx, cy, r - 1.5 * G_SC, r + 1.5 * G_SC, min(ca, sa), max(ca, sa), G_ACR, G_ACG, G_ACB, al);
  );
  px0 = cx + sin(sa) * (r - 8 * G_SC);
  py0 = cy - cos(sa) * (r - 8 * G_SC);
  gfx_set(0.95, 0.97, 0.98, (hov ? 1 : 0.86) * al);
  gbar(cx + sin(sa) * (r * 0.22), cy - cos(sa) * (r * 0.22), px0, py0, max(1.5, 2.4 * G_SC));
  gtext(kx, ky - kr - 13, nm, 1, 0.93, 0.95, 0.96, 0.95 * al, 1);
  gtext(kx, ky + kr + 13, vs, 2, 0.80, 0.84, 0.88, 0.95 * al, 1);
);
function gbtn(x, y, w, h, lb, on, hov) local(xx, yy, ww, hh, rr) (
  xx = floor(gsx(x)); yy = floor(gsy(y)); ww = ceil(w * G_SC); hh = ceil(h * G_SC); rr = floor(h * 0.5 * G_SC);
  on ? (
    gfrr(xx, yy, xx + ww, yy + hh, rr, G_ACR, G_ACG, G_ACB, hov ? 1 : 0.9);
    gtext(x + w * 0.5, y + h * 0.5, lb, 3, 0.06, 0.12, 0.10, 1, 1);
  ) : (
    gfrr(xx, yy, xx + ww, yy + hh, rr, 0.10, 0.11, 0.12, hov ? 0.95 : 0.8);
    gbord(xx, yy, xx + ww, yy + hh, rr, max(1, floor(G_SC + 0.5)), 0.62, 0.66, 0.70, hov ? 0.7 : 0.4);
    gtext(x + w * 0.5, y + h * 0.5, lb, 3, 0.85, 0.88, 0.90, hov ? 1 : 0.8, 1);
  );
);

function gauto(s, e) (
<?
max_sliders > 8 ? printf("slider_automate(2^(s-1), e);") : (
  printf("s == 1 ? slider_automate(room_size, e) :\n");
  printf("s == 2 ? slider_automate(damping, e) :\n");
  printf("s == 3 ? slider_automate(pre_delay, e) :\n");
  printf("s == 4 ? slider_automate(hi_damp, e) :\n");
  printf("s == 5 ? slider_automate(lo_cut, e) :\n");
  printf("s == 6 ? slider_automate(early_ref, e) :\n");
  printf("s == 7 ? slider_automate(mix, e) :\n");
  printf("s == 8 ? slider_automate(level, e) : 0;");
);
?>
);

GB = 3000000;
TTO = GB; TTN = GB + 4; TTW = GB + 8; TTY0 = GB + 12; TTY1 = GB + 16;
TTE = GB + 32; TTX = TTE + 8192; TTD = TTX + 2048; TTC = TTD + 2048;
PRS = TTC + 4096; GKX = PRS + 256; GKMIN = GKX + 16; GKMAX = GKMIN + 16; GKDEF = GKMAX + 16; GKSTEP = GKDEF + 16; GKCTR = GKSTEP + 16;
GMO = GKCTR + 16; GMN = GMO + 16; GMV = GMN + 16; GML = GMV + 128;
TTK = 0;
