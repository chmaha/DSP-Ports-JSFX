function gtitle(sid, x, y, cap, r, g, b) local(s, x0, yb, bx, w, py, py1, k, ye, e, n, i, j, t, td, wd, wp, xa, a, bb, ia, ib, c, y0, y1)
(
  s = cap * G_SC / TTCAP;
  x0 = gsx(x); yb = gsy(y);
  bx = floor(x0); w = ceil(TTW[sid] * s) + 3;
  py = floor(yb - TTY1[sid] * s) - 1; py1 = ceil(yb - TTY0[sid] * s) + 1;
  memset(TTC, 0, w + 2);
  while (py <= py1) (
    k = 0;
    loop(8,
      ye = (yb - (py + (k + 0.5) / 8)) / s;
      n = 0; e = TTE + 4 * TTO[sid];
      loop(TTN[sid],
        y0 = e[1]; y1 = e[3];
        (y0 <= ye) !== (y1 <= ye) ? (
          t = x0 + (e[0] + (ye - y0) * (e[2] - e[0]) / (y1 - y0)) * s - bx;
          td = y1 > y0 ? 1 : -1;
          i = n;
          while (i > 0 && TTX[i - 1] > t) ( TTX[i] = TTX[i - 1]; TTD[i] = TTD[i - 1]; i -= 1; );
          TTX[i] = t; TTD[i] = td; n += 1;
        );
        e += 4;
      );
      wd = 0; j = 0;
      loop(n,
        wp = wd; wd += TTD[j];
