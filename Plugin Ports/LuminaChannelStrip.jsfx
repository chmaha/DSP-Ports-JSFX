// ---------------- HPF/LPF state (x42-fil4) ----------------
// freq/qual/res init to -1 so the first hp_target()/lp_target() call always
// computes alpha/beta/tg from the live slider values (matching defaults would
// leave them at 0 and drive the filter states toward silence).
hpL.freq=-1; hpL.qual=-1; hpL.q2=reshp(0.7); hpL.alpha=exp(-2*$pi*20/srate);
hpL.omega=20/srate; hpL.a=1.0; hpL.q=0.0; hpL.g=1.0; hpL.z1=0; hpL.z2=0; hpL.y2=0;
hpR.freq=-1; hpR.qual=-1; hpR.q2=reshp(0.7); hpR.alpha=exp(-2*$pi*20/srate);
hpR.omega=20/srate; hpR.a=1.0; hpR.q=0.0; hpR.g=1.0; hpR.z1=0; hpR.z2=0; hpR.y2=0;

lpL.freq=-1; lpL.res=-1; lpL.fb=reslp(1.0); lpL.a=1.0; lpL.b=1.0; lpL.r=0; lpL.g=0;
lpL.z1=0; lpL.z2=0; lpL.z3=0; lpL.z4=0;
lpR.freq=-1; lpR.res=-1; lpR.fb=reslp(1.0); lpR.a=1.0; lpR.b=1.0; lpR.r=0; lpR.g=0;
lpR.z1=0; lpR.z2=0; lpR.z3=0; lpR.z4=0;

