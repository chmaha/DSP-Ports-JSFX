function histmin_init(hl) instance(hlen_, hold_, wind_, vmin_, buf)
local(i)
(
  hlen_ = hl;
  hold_ = hl;
  wind_ = 0;
  vmin_ = 1;
  i = 0;
  loop(32,
    buf[i] = 1;
    i += 1;
  );
);

function histmin_write(v) instance(hlen_, hold_, wind_, vmin_, buf)
local(j, vv)
(
  buf[wind_] = v;
  (v <= vmin_) ? (
    vmin_ = v;
    hold_ = hlen_;
  ) : (
    hold_ -= 1;
    (hold_ == 0) ? (
      vmin_ = v;
      hold_ = hlen_;
      j = 1 - hlen_;
      while (j < 0) (
        vv = buf[(wind_ + j) & 31];
        (vv < vmin_) ? (
          vmin_ = vv;
          hold_ = hlen_ + j;
        );
        j += 1;
      );
    );
  );
  wind_ = (wind_ + 1) & 31;
  vmin_;
);

div1 = (srate > 130000) ? 32 : (srate > 65000) ? 16 : 8;
div2 = 8;
k1 = ceil(0.0012 * srate / div1);
k2 = 12;
delay = k1 * div1;

dsize = 64;
while (dsize < delay + div1) (
  dsize *= 2;
);
dmask = dsize - 1;

freemem = 0;
dbuffL = freemem; freemem += dsize;
dbuffR = freemem; freemem += dsize;
hist1.buf = freemem; freemem += 32;
hist2.buf = freemem; freemem += 32;
histmin_arr = freemem; freemem += 60;
histmax_arr = freemem; freemem += 60;

// ---------------- Gate (ZamGateX2) state ----------------
MAXG = 400;
g_smpl = freemem; freemem += MAXG;
g_smpr = freemem; freemem += MAXG;
g_posl = 0; g_posr = 0; g_suml = 0; g_sumr = 0;
g_state = 0; g_gr_sm = 0;
g_j = 0;
loop(MAXG,
  g_smpl[g_j] = 0;
  g_smpr[g_j] = 0;
  g_j += 1;
);

function g_push_l(v) local(gj)
(
  g_posl += 1;
  g_posl >= MAXG ? g_posl = 0;
  g_suml += v*v - g_smpl[g_posl]*g_smpl[g_posl];
  g_smpl[g_posl] = v;
  g_posl == 0 ? (
    g_suml = 0; gj = 0;
    loop(MAXG, g_suml += g_smpl[gj]*g_smpl[gj]; gj += 1; );
  );
);

function g_push_r(v) local(gj)
(
  g_posr += 1;
  g_posr >= MAXG ? g_posr = 0;
  g_sumr += v*v - g_smpr[g_posr]*g_smpr[g_posr];
  g_smpr[g_posr] = v;
  g_posr == 0 ? (
    g_sumr = 0; gj = 0;
    loop(MAXG, g_sumr += g_smpr[gj]*g_smpr[gj]; gj += 1; );
  );
);

// gate detector + gain stage (ZamGateX2). kept as one block so it can run
// either before or after the EQ: slider47 selects Pre EQ (console order,
// filters -> gate -> EQ) or Post EQ (filters -> EQ -> gate).
function gate_step()
global(spl0, spl1, g_suml, g_sumr, g_sumsq, g_thrsum, g_duck, g_att, g_rel, g_state, g_mingate, g_gr_t, g_gr_sm, play_state)
(
  g_push_l(spl0); g_push_r(spl1);
  g_sumsq = max(g_suml, g_sumr);

  g_sumsq > g_thrsum ? (
    g_duck ? (
      g_state -= g_att;
      g_state < g_mingate ? g_state = g_mingate;
    ) : (
      g_state += g_att;
      g_state > 1 ? g_state = 1;
    );
  ) : (
    g_duck ? (
      g_state += g_rel;
      g_state > 1 ? g_state = 1;
    ) : (
      g_state -= g_rel;
      g_state < g_mingate ? g_state = g_mingate;
    );
  );

  spl0 = g_state * spl0;
  spl1 = g_state * spl1;

  (play_state & 1) ? (
    g_gr_sm += 0.001 * (g_gr_t - g_gr_sm);
  ) : (
    g_gr_sm += 0.001 * (0 - g_gr_sm);
  );
);


