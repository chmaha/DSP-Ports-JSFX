function round_step(v, step)
(
  floor(v/step + 0.5) * step;
);

// ---------------- HPF/LPF (x42-fil4) ----------------
function eel_tanh(x)
local(e2x)
(
  (x > 20) ? 1.0 : (x < -20) ? -1.0 : (
    e2x = exp(2*x);
    (e2x - 1) / (e2x + 1);
  );
);

function reshp(q)
(
  0.7 + 0.78*eel_tanh(1.82*(q-0.8));
);

function hp_target(en, tfreq, tq)
instance(a, q, g, alpha, omega, q2, freq, qual)
local(to, tqv, tg)
(
  (tfreq !== freq) ? (
    freq = tfreq;
    (tfreq > srate/12.0) ? tfreq = srate/12.0;
    (tfreq < 5) ? tfreq = 5;
    omega = tfreq/srate;
    alpha = exp(-2*$pi*omega);
  );
  (qual !== tq) ? (
    q2 = reshp(tq);
    (q2 < 0) ? q2 = 0 : (q2 > 1.6) ? q2 = 1.6;
    qual = tq;
  );
  to = en ? alpha : 1.0;
  (abs(to-a) < 0.00001) ? a = to : a += 0.01*(to-a);
  tqv = en ? q2 : 0;
  (abs(tqv-q) < 0.00001) ? q = tqv : q += 0.01*(tqv-q);
  tg = en ? (1.0 + omega + 2.0*q*omega) : 1.0;
  (abs(tg-g) < 0.00001) ? g = tg : g += 0.01*(tg-g);
);

function hp_step(xin)
instance(a, q, g, z1, z2, y2)
local(m1, m2, _z1, _z2)
(
  m1 = g/a; m2 = g*q;
  (a===1.0 && q===0.0 && g===1.0) ? xin : (
    _z1 = z1; _z2 = z2;
    z1 = m1*xin - m2*(y2-z2);
    z2 = a*(z2 + z1 - _z1);
    y2 = a*(y2 + z2 - _z2);
    y2;
  );
);

function reslp(q)
(
  3.0 * pow(q, 3.20772);
);

function calc_lop_alpha(rate, freq)
local(fr)
(
  fr = freq/rate;
  (fr < 0.0002) ? fr = 0.0002 : (fr > 0.4998) ? fr = 0.4998;
  1.0 - exp(-2*$pi*fr);
);

function lp_target(en, tfreq, tres)
instance(a, b, r, g, alpha, beta, fb, tg, freq, res)
local(rchange, fs, w2, w3, ta, tb, tr, tgt)
(
  rchange = 0;
  (res !== tres) ? (
    res = tres;
    fb = reslp(tres);
    (fb < 0) ? fb = 0 : (fb > 9) ? fb = 9;
    rchange = 1;
  );
  (tfreq !== freq || rchange) ? (
    fs = tfreq / sqrt(1+fb);
    alpha = calc_lop_alpha(srate, fs);
    beta = calc_lop_alpha(srate, 0.25*srate + 0.5*fs);
    freq = tfreq;
    w2 = 4*freq/srate;
    w3 = freq / (0.25*srate + 0.5 + freq);
    tg = (1+w3*w3) / (1+w2*w2);
  );
  ta = en ? alpha : 1.0;
  (abs(ta-a) < 0.00001) ? a = ta : a += 0.01*(ta-a);
  tb = en ? beta : 1.0;
  (abs(tb-b) < 0.00001) ? b = tb : b += 0.01*(tb-b);
  tr = en ? fb : 0.0;
  (abs(tr-r) < 0.0001) ? r = tr : r += 0.01*(tr-r);
  tgt = en ? tg : 0.0;
  (abs(tgt-g) < 0.00001) ? g = tgt : g += 0.01*(tgt-g);
);

function lp_step(xin)
instance(a, b, r, g, z1, z2, z3, z4)
local(rg, inp)
(
  rg = r*g;
  (a===1.0 && b===1.0 && g===0.0) ? xin : (
    inp = (1+rg)*xin - z2*rg;
    z1 += a*(inp-z1);
    z2 += a*(z1-z2);
    z3 += b*(z2-z3);
    z4 += b*(z3-z4);
    z4;
  );
);

// compensating high shelf at srate/3 used by fil4's lowpass
function shelf_calc(is_high)
instance(freq, gn, q, a1, a2, b0, b1, b2)
local(w0, cosw, bigA, As, aa, bb0, bb1, bb2, aa0, aa1, aa2)
(
  w0 = 2*$pi*(freq/srate);
  cosw = cos(w0);
  bigA = sqrt(gn);
  As = sqrt(bigA);
  aa = sin(w0)/2 * (1/q);
  is_high ? (
    bb0 = bigA * ((bigA+1) + (bigA-1)*cosw + 2*As*aa);
    bb1 = -2*bigA * ((bigA-1) + (bigA+1)*cosw);
    bb2 = bigA * ((bigA+1) + (bigA-1)*cosw - 2*As*aa);
    aa0 = (bigA+1) - (bigA-1)*cosw + 2*As*aa;
    aa1 = 2 * ((bigA-1) - (bigA+1)*cosw);
    aa2 = (bigA+1) - (bigA-1)*cosw - 2*As*aa;
  ) : (
    bb0 = bigA * ((bigA+1) - (bigA-1)*cosw + 2*As*aa);
    bb1 = 2*bigA * ((bigA-1) - (bigA+1)*cosw);
    bb2 = bigA * ((bigA+1) - (bigA-1)*cosw - 2*As*aa);
    aa0 = (bigA+1) + (bigA-1)*cosw + 2*As*aa;
    aa1 = -2 * ((bigA-1) + (bigA+1)*cosw);
    aa2 = (bigA+1) + (bigA-1)*cosw - 2*As*aa;
  );
  b0 = bb0/aa0; b1 = bb1/aa0; b2 = bb2/aa0;
  a1 = aa1/aa0; a2 = aa2/aa0;
);

function shelf_target(is_high, tfreq, tq, tgain)
instance(freq, gn, q, a1, a2, b0, b1, b2, ta1, ta2, tb0, tb1, tb2, da1, da2, db0, db1, db2, icnt)
local(lpf, changed, f_l, f_u, c1, c2, c3, c4, c5)
(
  (tq < 0.25) ? tq = 0.25 : (tq > 2.0) ? tq = 2.0;
  f_l = 0.0004*srate; f_u = 0.4700*srate;
  (tfreq < f_l) ? tfreq = f_l : (tfreq > f_u) ? tfreq = f_u;

  lpf = 440.0/srate;
  changed = 0;
  (freq !== tfreq) ? ( freq += lpf*(tfreq-freq); (abs(freq-tfreq)<0.3) ? freq=tfreq; changed=1; );
  (gn !== tgain) ? ( gn += lpf*(tgain-gn); (abs(gn-tgain)<0.0001) ? gn=tgain; changed=1; );
  (q !== tq) ? ( q += lpf*(tq-q); (abs(q-tq)<0.001) ? q=tq; changed=1; );
  changed ? (
    c1 = a1; c2 = a2; c3 = b0; c4 = b1; c5 = b2;
    this.shelf_calc(is_high);
    ta1 = a1; ta2 = a2; tb0 = b0; tb1 = b1; tb2 = b2;
    da1 = (ta1 - c1) / 32; da2 = (ta2 - c2) / 32; db0 = (tb0 - c3) / 32; db1 = (tb1 - c4) / 32; db2 = (tb2 - c5) / 32;
    a1 = c1; a2 = c2; b0 = c3; b1 = c4; b2 = c5;
    icnt = 32;
  );
);

function shelf_step(xin)
instance(a1, a2, b0, b1, b2, y1, y2, ta1, ta2, tb0, tb1, tb2, da1, da2, db0, db1, db2, icnt)
local(y)
(
  icnt > 0 ? (
    icnt -= 1;
    icnt > 0 ? ( a1 += da1; a2 += da2; b0 += db0; b1 += db1; b2 += db2; )
             : ( a1 = ta1; a2 = ta2; b0 = tb0; b1 = tb1; b2 = tb2; );
  );
  y = b0*xin + y1;
  y1 = b1*xin - a1*y + y2;
  y2 = b2*xin - a2*y;
  y;
);

