// ---------------- Saturation (Airwindows ChannelX) ----------------
TINY = 1.18*10^-37;
flip = 0;

function sat_chan(inp, flipv, nonlin, rbamt, dens, phat, slew)
instance(rbA, rbB, pvA, pvB, pvC, pvD, paA, paB, paC, paD, pbA, pbB, pbC, pbD, lsA, lsB, lsC)
local(x, delta, dry, diel, rbk, phatS, distS, dA, dB, dC, dD, dE, clampv)
(
  x = inp;

  diel = abs(2.0-((x+nonlin)/nonlin));
  flipv ? (
    rbA = (rbA*(1.0-(rbamt*diel))) + (x*rbamt*diel);
    abs(rbA) > TINY ? (
      delta = x;
      rbk = rbA*0.96;
      x *= rbk;
      x = max(min(x, 1.25), -1.25);
      x = ((x*x)*-0.166666666666666)*(x*x) + x;
      x /= rbk;
      dA = delta - x;
      dB = paA - dA; paA = dA;
      dC = paB - dB; paB = dB;
      dD = paC - dC; paC = dC;
      dE = paD - dD; paD = dD;
      x *= (1.0 + (abs(dC)*0.0618) + (abs(dD)*-0.05982) + (abs(dE)*0.0206));
    );
    x -= rbA*0.92;
  ) : (
    rbB = (rbB*(1.0-(rbamt*diel))) + (x*rbamt*diel);
    abs(rbB) > TINY ? (
      delta = x;
      rbk = rbB*0.96;
      x *= rbk;
      x = max(min(x, 1.25), -1.25);
      x = ((x*x)*-0.166666666666666)*(x*x) + x;
      x /= rbk;
      dA = delta - x;
      dB = pbA - dA; pbA = dA;
      dC = pbB - dB; pbB = dB;
      dD = pbC - dC; pbC = dC;
      dE = pbD - dD; pbD = dD;
      x *= (1.0 + (abs(dC)*0.0618) + (abs(dD)*-0.05982) + (abs(dE)*0.0206));
    );
    x -= rbB*0.92;
  );

  delta = x;
  dry = x;
  x = max(min(x, 1.0), -1.0);
  phatS = sin(x*1.57079633);
  x *= 1.2533141373155;
  distS = sin(x*abs(x));
  distS /= (abs(x) == 0.0) ? 1.0 : abs(x);
  x = distS;
  dens < 1.0 ? x = (dry*(1-dens)) + (distS*dens);
  phat > 0.0 ? x = (x*(1-phat)) + (phatS*phat);

  dA = delta - x;
  dB = pvA - dA; pvA = dA;
  dC = pvB - dB; pvB = dB;
  dD = pvC - dC; pvC = dC;
  dE = pvD - dD; pvD = dD;
  x *= (1.0 + (abs(dC)*0.0618) + (abs(dD)*-0.05982) + (abs(dE)*0.0206));

  clampv = (lsB - lsC)*0.381966011250105;
  clampv -= (lsA - lsB)*0.6180339887498948482045;
  clampv += x - lsA;
  lsC = lsB; lsB = lsA; lsA = x;
  clampv > slew ? x = lsB + slew;
  -clampv > slew ? x = lsB - slew;
  lsA = (lsA*0.381966011250105) + (x*0.6180339887498948482045);

  x;
);

