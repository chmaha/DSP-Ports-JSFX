// Modified 2026: translated to JSFX from mda Tracker (mda-effects).
// https://github.com/pluginguru/mda-effects


slider1:p_mode=0<0,1,0.001>-Mode
slider2:p_dyn=1<0,1,0.001>-Dynamics
slider3:p_mix=1<0,1,0.001>-Mix
slider4:p_glide=0.97<0,1,0.001>-Glide
slider5:p_trans=0.5<0,1,0.001>-Transpose
slider6:p_max=0.8<0,1,0.001>-Maximum
slider7:p_trig=0.5<0,1,0.001>-Trigger
slider8:p_out=0.5<0,1,0.001>-Output

in_pin:Left input
in_pin:Right input
out_pin:Left output
out_pin:Right output
options:no_meter

@init

ext_noinit = gfx_ext_retina = 1;
ext_nodenorm = 1;

tr_fix = 1;

function itrunc(x) ( x < 0 ? ceil(x) : floor(x); );

CSR = 44100;
TWOPI = 6.2831854820251465;
tr_dp = 100 / CSR;
tr_min = itrunc(CSR / 30);
tr_r1 = cos(0.01);
tr_r2 = sin(0.01);
tr_p = tr_b1 = tr_b2 = tr_b3 = tr_b4 = tr_dn = tr_bo = tr_e = tr_sw = tr_dsw = tr_n = tr_s = 0;

function tr_set() local(r, j, k)
(
  tr_mode = itrunc(p_mode * 4.9);
  r = 0.9990000128746033;
  j = (r * r) - 1;
  k = 2 - (((2 * r) * r) * cos((0.6470000147819519 * 50) / srate));
  tr_fo = (sqrt((k * k) - ((4 * j) * j)) - k) / (2 * j);
  tr_fi = (1 - tr_fo) * (1 - tr_fo);
  tr_ddp = p_glide * p_glide;
  tr_thr = 10 ^ ((3 * p_trig) - 3.8);
  tr_max = itrunc(srate / (10 ^ (1.600000023841858 + (2.200000047683716 * p_max))));
  tr_trans = 1.0594631 ^ itrunc((72 * p_trans) - 36);
  tr_wet = 10 ^ ((2 * p_out) - 1);
  tr_mode < 4 ? (
    tr_dyn = ((tr_wet * 0.6000000238418579) * p_mix) * p_dyn;
    tr_dry = tr_wet * sqrt(1 - p_mix);
    tr_wet = ((tr_wet * 0.30000001192092896) * p_mix) * (1 - p_dyn);
  ) : (
    tr_dry = tr_wet * (1 - p_mix);
    tr_wet *= (0.019999999552965164 * p_mix) - 0.004000000189989805;
    tr_dyn = 0;
  );
  tr_rel = 10 ^ (-10 / srate);
  o_1 = p_mode; o_2 = p_dyn; o_3 = p_mix; o_4 = p_glide; o_5 = p_trans; o_6 = p_max; o_7 = p_trig; o_8 = p_out;
);

tr_set();

@slider

last_srate != srate ? (
  last_srate = srate;
  meter_decay = 0.001 ^ (1 / (0.4 * srate));
  tr_dirty = 1;
);

@block

abs(tr_b1) < 0.0000000001 ? tr_b1 = tr_b2 = tr_b3 = tr_b4 = 0;
tr_n > 100000 ? tr_n = 100000;
(tr_dirty || p_mode !== o_1 || p_dyn !== o_2 || p_mix !== o_3 || p_glide !== o_4 || p_trans !== o_5 || p_max !== o_6 || p_trig !== o_7 || p_out !== o_8) ? ( tr_set(); tr_dirty = 0; );
tr_cm = tr_mode;

@sample

tr_a = spl0;
tr_bi = spl1;
tr_x = tr_fix ? tr_a + tr_bi : tr_a;
tr_t = abs(tr_x);
tr_e = tr_t > tr_e ? 0.5 * (tr_t + tr_e) : tr_e * tr_rel;
tr_b1 = (tr_fo * tr_b1) + (tr_fi * tr_x);
tr_b2 = (tr_fo * tr_b2) + tr_b1;
tr_b2 > tr_thr ? (
  tr_s < 1 ? (
    tr_n < tr_min ? (
      tr_t2 = tr_b2 / (tr_b2 - tr_bo);
      tr_t = (tr_trans * TWOPI) / ((tr_n + tr_dn) - tr_t2);
      tr_dp = tr_dp + (tr_ddp * (tr_t - tr_dp));
      tr_dn = tr_t2;
      tr_dsw = 0.31830981373786926 * tr_dp;
      tr_cm == 4 ? (
        tr_r1 = cos(4 * tr_dp);
        tr_r2 = sin(4 * tr_dp);
      );
    );
    tr_n = 0;
  );
  tr_s = 1;
) : (
  tr_n > tr_max ? tr_s = 0;
);
tr_n += 1;
tr_bo = tr_b2;
tr_p += tr_dp;
tr_p >= TWOPI ? ( tr_p < 2 * TWOPI ? tr_p -= TWOPI : tr_p -= TWOPI * floor(tr_p / TWOPI); ) :
tr_p <= -TWOPI ? ( tr_p > -2 * TWOPI ? tr_p += TWOPI : tr_p -= TWOPI * ceil(tr_p / TWOPI); );
tr_cm == 0 ? ( tr_x = sin(tr_p); ) :
tr_cm == 1 ? ( tr_x = sin(tr_p) > 0 ? 0.5 : -0.5; ) :
tr_cm == 2 ? (
  tr_sw += tr_dsw;
  tr_sw >= 2 ? ( tr_sw < 4 ? tr_sw -= 2 : tr_sw -= 2 * floor(tr_sw / 2); ) :
  tr_sw <= -2 ? ( tr_sw > -4 ? tr_sw += 2 : tr_sw -= 2 * ceil(tr_sw / 2); );
  tr_x = tr_sw - 1;
) :
tr_cm == 3 ? ( tr_x *= sin(tr_p); ) :
(
  tr_x += (tr_b3 * tr_r1) - (tr_b4 * tr_r2);
  tr_b4 = 0.9959999918937683 * ((tr_b3 * tr_r2) + (tr_b4 * tr_r1));
  tr_b3 = 0.9959999918937683 * tr_x;
);
tr_x *= tr_wet + (tr_dyn * tr_e);
tr_fix ? (
  spl0 = (tr_dry * tr_a) + tr_x;
  spl1 = (tr_dry * tr_bi) + tr_x;
) : (
  spl0 = tr_a;
  spl1 = (tr_dry * tr_bi) + tr_x;
);

tr_m = max(abs(tr_a), abs(tr_bi));
tr_m > ipk ? ipk = tr_m : ipk *= meter_decay;
tr_m = max(abs(spl0), abs(spl1));
tr_m > opk ? opk = tr_m : opk *= meter_decay;

@gfx 860 336

DW = 860;
DH = 336;
scale = max(0.5, min(gfx_w / DW, gfx_h / DH));
ox = floor((gfx_w - DW*scale) * 0.5);
oy = 0;

MARGIN = 14*scale;
CW = 92*scale;
KR = 28*scale;
PANEL_H = 128*scale;
GHIST = 200000;
HN = 96;

function automate(s, end_touch)
(
<?
  max_sliders > 8 ? printf("slider_automate(2^(s-1), end_touch);") :
    printf("s == 1 ? slider_automate(p_mode, end_touch) : s == 2 ? slider_automate(p_dyn, end_touch) : s == 3 ? slider_automate(p_mix, end_touch) : s == 4 ? slider_automate(p_glide, end_touch) : s == 5 ? slider_automate(p_trans, end_touch) : s == 6 ? slider_automate(p_max, end_touch) : s == 7 ? slider_automate(p_trig, end_touch) : s == 8 ? slider_automate(p_out, end_touch) :");
?> 0;
);
function set_slider(s, v) ( slider(s) = v; automate(s, 0); automate(s, 1); );
function hit_circle(mx, my, cx, cy, rad) ( sqr(mx - cx) + sqr(my - cy) <= sqr(rad); );
function hit_rect(mx, my, x, y, w, h) ( mx >= x && mx <= x+w && my >= y && my <= y+h; );
function g_trunc(x) ( x < 0 ? ceil(x) : floor(x); );

function set_norm(s, v)
local(old)
(
  old = slider(s);
  slider(s) = floor(v*1000 + 0.5) / 1000;
  slider(s) !== old ? automate(s, 0);
);

function upper(str)
local(i, c)
(
  i = 0;
  loop(strlen(str),
    c = str_getchar(str, i);
    (c >= 97 && c <= 122) ? str_setchar(str, i, c - 32);
    i += 1;
  );
  str;
);

function draw_knob(cx, cy, rad, pos, cr, cg, cb, valtext, name)
local(ang0, ang1, ang, i, tx, ty)
(
  ang0 = -2.35619;
  ang1 =  2.35619;
  gfx_set(0.05, 0.05, 0.06, 1);
  gfx_circle(cx, cy, rad + 2*scale, 1, 1);
  gfx_set(cr*0.55, cg*0.55, cb*0.55, 1);
  gfx_circle(cx, cy, rad, 1, 1);
  gfx_set(cr, cg, cb, 1);
  gfx_circle(cx, cy, rad*0.72, 1, 1);
  gfx_set(1, 1, 1, 0.18);
  gfx_circle(cx - rad*0.28, cy - rad*0.28, rad*0.42, 1, 1);
  i = 0;
  loop(9,
    ang = ang0 + (ang1 - ang0) * (i / 8);
    gfx_set(0.85, 0.85, 0.85, 0.7);
    gfx_line(cx + sin(ang)*rad*0.82, cy - cos(ang)*rad*0.82, cx + sin(ang)*rad*0.98, cy - cos(ang)*rad*0.98, 1);
    i += 1;
  );
  ang = ang0 + (ang1 - ang0) * pos;
  gfx_set(0.05, 0.05, 0.05, 1);
  gfx_line(cx, cy, cx + sin(ang)*rad*0.85, cy - cos(ang)*rad*0.85, 1);
  gfx_setfont(1, "Arial", 14*scale);
  gfx_set(0.85, 0.85, 0.85, 1);
  gfx_measurestr(valtext, tx, ty);
  gfx_x = cx - tx*0.5; gfx_y = cy - rad - 18*scale;
  gfx_drawstr(valtext);
  gfx_set(0.8, 0.8, 0.82, 1);
  gfx_measurestr(name, tx, ty);
  gfx_x = cx - tx*0.5; gfx_y = cy + rad + 7*scale;
  gfx_drawstr(name);
);

function lcd_touch(s) ( lcd_sl = s; lcd_t = time_precise(); );

function row_begin(y, nk, ns)
(
  rx = ox + (DW*scale - (nk*CW + ns*8*scale + (ns - 1)*10*scale)) * 0.5;
  ry = oy + y;
);

function sec(nk, title, cr, cg, cb)
local(w, tw, th)
(
  w = nk*CW + 8*scale;
  gfx_set(0.035, 0.035, 0.04, 1);
  gfx_rect(rx - scale, ry - scale, w + 2*scale, PANEL_H + 2*scale, 1);
  gfx_set(0.125, 0.125, 0.14, 1);
  gfx_rect(rx, ry, w, PANEL_H, 1);
  gfx_set(cr, cg, cb, 0.8);
  gfx_rect(rx, ry, w, max(1, 2*scale), 1);
  gfx_setfont(1, "Arial", 12*scale, 'b');
  gfx_set(cr*0.75 + 0.15, cg*0.75 + 0.15, cb*0.75 + 0.15, 1);
  gfx_measurestr(title, tw, th);
  gfx_x = rx + (w - tw)*0.5; gfx_y = ry + 5*scale;
  gfx_drawstr(title);
  k_sx = rx + 4*scale; k_col = 0;
  k_r = cr; k_g = cg; k_b = cb;
  sec_x = rx; sec_w = w;
  rx += w + 10*scale;
);

function seg_btn(s, x, y, w, h, label, act, fs)
local(tw, th, gap, hov)
(
  hov = hit_rect(mouse_x, mouse_y, x, y, w, h);
  hov ? hov_s = s;
  gap = max(1, scale);
  gfx_set(0.03, 0.03, 0.04, 1);
  gfx_rect(x - gap, y - gap, w + 2*gap, h + 2*gap, 1);
  act ? gfx_set(acc_r*0.62, acc_g*0.62, acc_b*0.62, 1) : gfx_set(hov ? 0.17 : 0.14, hov ? 0.17 : 0.14, hov ? 0.19 : 0.16, 1);
  gfx_rect(x, y, w, h, 1);
  act ? gfx_set(acc_r, acc_g, acc_b, 1) : gfx_set(0.21, 0.21, 0.24, 1);
  gfx_rect(x + gap, y + gap, w - 2*gap, h*0.5, 1);
  gfx_set(1, 1, 1, act ? 0.22 : 0.08);
  gfx_rect(x + gap, y + gap, w - 2*gap, h*0.3, 1);
  gfx_setfont(1, "Arial", fs*scale, 'b');
  act ? gfx_set(0.08, 0.08, 0.10, 1) : gfx_set(0.78, 0.78, 0.80, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + (w - tw)*0.5; gfx_y = y + (h - th)*0.5;
  gfx_drawstr(label);
  mouse_just_down && hov;
);

function glow_text(str, x, y, r, g, b)
(
  gfx_set(r, g, b, 0.16);
  gfx_x = x - scale; gfx_y = y; gfx_drawstr(str);
  gfx_x = x + scale; gfx_y = y; gfx_drawstr(str);
  gfx_x = x; gfx_y = y - scale; gfx_drawstr(str);
  gfx_x = x; gfx_y = y + scale; gfx_drawstr(str);
  gfx_set(r, g, b, 1);
  gfx_x = x; gfx_y = y; gfx_drawstr(str);
);

function meter(x, y, w, h, pk, label)
local(db, fy, tw, th)
(
  gfx_setfont(1, "Arial", 11*scale, 'b');
  gfx_set(0.62, 0.63, 0.66, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + w*0.5 - tw*0.5; gfx_y = y;
  gfx_drawstr(label);
  y += th + 3*scale;
  h -= th + 3*scale;
  gfx_set(0.04, 0.04, 0.05, 1);
  gfx_rect(x - scale, y - scale, w + 2*scale, h + 2*scale, 1);
  gfx_set(acc_r*0.22, acc_g*0.22, acc_b*0.22, 1);
  gfx_rect(x, y, w, h, 1);
  db = pk > 0.000001 ? 20 * log10(pk) : -100;
  fy = y + h * (1 - max(0, min(1, (db + 60) / 60)));
  db > -1 ? gfx_set(1.0, 0.35, 0.30, 1) : gfx_set(acc_r, acc_g, acc_b, 1);
  gfx_rect(x, fy, w, y + h - fy, 1);
);

function lcd_frame(x, y, w, h)
(
  LX = x; LY = y; LW = w; LH = h;
  gfx_set(0.03, 0.03, 0.04, 1);
  gfx_rect(LX - 2*scale, LY - 2*scale, LW + 4*scale, LH + 4*scale, 1);
  gfx_set(0.17, 0.17, 0.19, 1);
  gfx_rect(LX, LY, LW, LH, 1);
  GX = LX + 6*scale; GY = LY + 6*scale; GW = LW - 12*scale; GH = LH - 12*scale;
  gfx_set(0.02, 0.02, 0.02, 1);
  gfx_rect(GX - scale, GY - scale, GW + 2*scale, GH + 2*scale, 1);
  gfx_set(0.035 + acc_r*0.05, 0.035 + acc_g*0.05, 0.035 + acc_b*0.05, 1);
  gfx_rect(GX, GY, GW, GH, 1);
  lc_r = min(1, 0.35 + acc_r*0.75); lc_g = min(1, 0.35 + acc_g*0.75); lc_b = min(1, 0.35 + acc_b*0.75);
);

function lcd_finish()
local(scy)
(
  gfx_set(0, 0, 0, 0.22);
  scy = GY;
  while (scy < GY + GH) ( gfx_rect(GX, scy, GW, max(1, scale), 1); scy += 3*scale; );
  gfx_set(1, 1, 1, 0.035);
  gfx_rect(GX, GY, GW, GH*0.45, 1);
);

function header(title, sub)
(
  gfx_set(0.09, 0.08, 0.08, 1);
  gfx_rect(0, 0, gfx_w, gfx_h, 1);
  gfx_setfont(1, "Arial", 20*scale, 'b');
  gfx_set(acc_r, acc_g, acc_b, 1);
  gfx_x = ox + MARGIN; gfx_y = oy + 8*scale;
  gfx_drawstr(title);
  gfx_setfont(1, "Arial", 13*scale);
  gfx_set(0.58, 0.60, 0.64, 1);
  gfx_x = ox + MARGIN + 2*scale; gfx_y = oy + 30*scale;
  gfx_drawstr(sub);
);

function hline(y) ( gfx_set(0.04, 0.04, 0.05, 1); gfx_rect(0, oy + y, gfx_w, max(1, scale), 1); );

function hint_bar(y, h, str)
local(tw, th)
(
  hline(y);
  gfx_setfont(1, "Arial", 13*scale);
  gfx_set(0.62, 0.63, 0.66, 1);
  strcpy(#ghint, str);
  gfx_measurestr(#ghint, tw, th);
  tw > (DW - 20)*scale ? ( gfx_setfont(1, "Arial", 13*scale*(DW - 20)*scale/tw); gfx_measurestr(#ghint, tw, th); );
  gfx_x = ox + (DW*scale - tw)*0.5; gfx_y = oy + y + (h - th)*0.5;
  gfx_drawstr(#ghint);
);


function def_val(s)
(
  s == 1 ? 0 : s == 2 ? 1 : s == 3 ? 1 : s == 4 ? 0.97 : s == 5 ? 0.5 : s == 6 ? 0.8 : 0.5;
);

function knob_name(s)
(
  s == 1 ? "Mode" : s == 2 ? "Dynamics" : s == 3 ? "Mix" : s == 4 ? "Glide" : s == 5 ? "Transpose" :
  s == 6 ? "Maximum" : s == 7 ? "Trigger" : "Output";
);

function hint_text(s)
(
  s == 1 ? "Mode: sine, square or saw oscillator, ring modulator, or a peaking EQ that follows the pitch" :
  s == 2 ? "Dynamics: apply the dynamics of the input signal to the generated output" :
  s == 3 ? "Mix: wet / dry mix" :
  s == 4 ? "Glide: maximum pitch change rate (100 % follows instantly)" :
  s == 5 ? "Transpose: pitch offset in semitones, for harmonics, octave doubling and so on" :
  s == 6 ? "Maximum: highest allowed pitch, to suppress pitch tracking errors" :
  s == 7 ? "Trigger: threshold level for the pitch tracker; raise it to stop tracking in gaps" :
  s == 8 ? "Output: level trim" :
  "Tracking works on monophonic inputs, and makes odd pitch sequences from drums or noise";
);

function ptext(s)
local(v)
(
  v = slider(s);
  s == 1 ? strcpy(#ptxt, g_mode == 0 ? "SINE" : g_mode == 1 ? "SQUARE" : g_mode == 2 ? "SAW" : g_mode == 3 ? "RING" : "EQ") :
  (s == 2 || s == 3 || s == 4) ? sprintf(#ptxt, "%d %%", g_trunc(100 * v)) :
  s == 5 ? sprintf(#ptxt, "%d semi", g_trunc(72 * v - 36)) :
  s == 6 ? sprintf(#ptxt, "%d Hz", g_trunc(srate / g_trunc(srate / (10 ^ (1.6 + 2.2 * v))))) :
  s == 7 ? sprintf(#ptxt, "%d dB", g_trunc(60 * v - 60)) :
  sprintf(#ptxt, "%d dB", g_trunc(40 * v - 20));
  #ptxt;
);

function note_str(n, dst)
local(o, k)
(
  o = floor(n / 12); k = n - 12 * o; o -= 2;
  strcpy(dst, k == 0 ? "C" : k == 1 ? "C#" : k == 2 ? "D" : k == 3 ? "D#" : k == 4 ? "E" : k == 5 ? "F" :
              k == 6 ? "F#" : k == 7 ? "G" : k == 8 ? "G#" : k == 9 ? "A" : k == 10 ? "A#" : "B");
  strcat(dst, sprintf(#gns, "%d", o));
  dst;
);

function knob_at(s, cx, cy, rad, cr, cg, cb)
local(hov, gv)
(
  hov = hit_circle(mouse_x, mouse_y, cx, cy, rad + 4*scale);
  hov ? hov_s = s;
  (mouse_just_down && hov) ? (
    (click_target == s && time_precise() - click_time < 0.3) ? (
      set_slider(s, def_val(s));
      drag_target = 0;
      lcd_touch(s);
    ) : (
      drag_target = s; drag_y0 = mouse_y; drag_v0 = slider(s); drag_fine = mouse_cap & 4;
    );
    click_target = s; click_time = time_precise();
  );
  (hov && mouse_wheel != 0 && drag_target == 0) ? (
    gv = slider(s) + (mouse_wheel / 120) * ((mouse_cap & 4) ? 0.001 : 0.01);
    set_norm(s, max(0, min(1, gv)));
    automate(s, 1);
    lcd_touch(s);
    mouse_wheel = 0;
  );
  draw_knob(cx, cy, rad, slider(s), cr, cg, cb, ptext(s), knob_name(s));
);

function knob(s)
local(cx, cy)
(
  cx = k_sx + CW*(k_col + 0.5);
  cy = ry + 72*scale;
  k_col += 1;
  knob_at(s, cx, cy, KR, k_r, k_g, k_b);
);

function drag_update()
(
  drag_target > 0 ? (
    mouse_down ? (
      mouse_cap |= 65536;
      fine_now = mouse_cap & 4;
      fine_now != drag_fine ? ( drag_y0 = mouse_y; drag_v0 = slider(drag_target); drag_fine = fine_now; );
      gv = max(0, min(1, drag_v0 + (drag_y0 - mouse_y) / (150*scale) * (fine_now ? 0.1 : 1)));
      set_norm(drag_target, gv);
      lcd_touch(drag_target);
    ) : ( automate(drag_target, 1); drag_target = 0; );
  );
);


function fy_of(hz) ( VY + VH * (1 - max(0, min(1, log(max(hz, 1) / 30) / log(3000 / 30)))); );

mouse_down = mouse_cap & 1;
mouse_just_down = mouse_down && !mouse_state;
hov_s = 0;
acc_r = 0.94; acc_g = 0.84; acc_b = 0.34;
g_mode = g_trunc(p_mode * 4.9);

header("COPY CAT", "by chmaha  ·  based on mda Tracker");
TABW = 74*scale; TABH = 26*scale; TABG = 5*scale;
tx0 = ox + DW*scale - MARGIN - 5*TABW - 4*TABG;
gli = 0;
loop(5,
  seg_btn(1, tx0 + gli*(TABW + TABG), oy + 11*scale, TABW, TABH, gli == 0 ? "SINE" : gli == 1 ? "SQUARE" : gli == 2 ? "SAW" : gli == 3 ? "RING" : "EQ", g_mode == gli, 13) ? (
    set_slider(1, gli == 0 ? 0 : gli == 1 ? 0.306 : gli == 2 ? 0.51 : gli == 3 ? 0.714 : 0.918); mouse_just_down = 0;
  );
  gli += 1;
);
g_mode = g_trunc(p_mode * 4.9);
hline(46*scale);

lcd_frame(ox + MARGIN, oy + 56*scale, 700*scale, 96*scale);
TAW = 230*scale;
g_hz = tr_dp * srate / 6.2831853;
g_in = g_hz / (1.0594631 ^ g_trunc(72 * p_trans - 36));
gfx_setfont(2, "Courier New", 14*scale, 'b');
glow_text("TRACKING", GX + 10*scale, GY + 6*scale, lc_r, lc_g, lc_b);
strcpy(#lt, ptext(1));
gfx_measurestr(#lt, ltw, lth);
glow_text(#lt, GX + TAW - ltw, GY + 6*scale, lc_r, lc_g, lc_b);
sprintf(#ln, "%.1f HZ", abs(g_hz));
gfx_setfont(2, "Courier New", 26*scale, 'b');
gfx_measurestr(#ln, ltw, lth);
glow_text(#ln, GX + 10*scale + (TAW - 10*scale - ltw)*0.5, GY + 26*scale + (26*scale - lth)*0.5, lc_r, lc_g, lc_b);
gfx_setfont(2, "Courier New", 14*scale, 'b');
LY3 = GY + GH - 20*scale;
(lcd_sl > 0 && time_precise() - lcd_t < 1.5) ? (
  strcpy(#lt, knob_name(lcd_sl)); upper(#lt);
  glow_text(#lt, GX + 10*scale, LY3, lc_r, lc_g, lc_b);
  strcpy(#lv, ptext(lcd_sl)); upper(#lv);
  gfx_measurestr(#lv, ltw, lth);
  glow_text(#lv, GX + TAW - ltw, LY3, lc_r, lc_g, lc_b);
) : (
  abs(g_in) > 8.2 ? note_str(floor(12 * log(abs(g_in) / 8.1757989) / log(2) + 0.5), #lt) : strcpy(#lt, "--");
  sprintf(#lv, "IN %s", #lt);
  glow_text(#lv, GX + 10*scale, LY3, lc_r, lc_g, lc_b);
  g_gate = tr_s ? min(1, g_gate + 0.34) : g_gate * 0.8;
  gfx_measurestr("TRIG", ltw, lth);
  glow_text("TRIG", GX + TAW - ltw - 14*scale, LY3, lc_r, lc_g, lc_b);
  gfx_set(lc_r, lc_g, lc_b, 0.18 + 0.82 * g_gate);
  gfx_circle(GX + TAW - 4*scale, LY3 + lth*0.5, 4*scale, 1, 1);
);

SDX = GX + TAW + 12*scale;
gfx_set(lc_r, lc_g, lc_b, 0.18);
gfx_rect(SDX, GY + 8*scale, max(1, scale), GH - 16*scale, 1);
VX = SDX + 12*scale; VW = GX + GW - 10*scale - VX;
VY = GY + 8*scale; VH = GH - 16*scale;
hist_t += 1;
hist_t >= 2 ? (
  hist_t = 0;
  ghi = 0; loop(HN - 1, GHIST[ghi] = GHIST[ghi + 1]; GHIST[HN + ghi] = GHIST[HN + ghi + 1]; ghi += 1; );
  GHIST[HN - 1] = abs(g_hz); GHIST[2*HN - 1] = ipk;
);
gfx_set(lc_r, lc_g, lc_b, 0.08);
gfx_rect(VX, VY, VW, VH, 1);
gfx_setfont(1, "Arial", 11*scale);
ghi = 0;
loop(3,
  gfq = ghi == 0 ? 100 : ghi == 1 ? 300 : 1000;
  gfy = fy_of(gfq);
  gfx_set(lc_r, lc_g, lc_b, 0.16);
  gfx_rect(VX, gfy, VW, max(1, scale), 1);
  gfx_set(lc_r, lc_g, lc_b, 0.6);
  gfx_x = VX + 3*scale; gfx_y = gfy - 12*scale; gfx_drawstr(sprintf(#gns, "%d", gfq));
  ghi += 1;
);
gmy = fy_of(srate / max(1, tr_max) * (1.0594631 ^ g_trunc(72 * p_trans - 36)));
gfx_set(1, 0.9, 0.5, 0.7);
gfx_rect(VX, gmy, VW, max(1, scale), 1);
gfx_set(1, 0.9, 0.5, 0.8);
gfx_x = VX + VW - 30*scale; gfx_y = max(VY, gmy - 12*scale); gfx_drawstr("MAX");
gbw = VW / HN;
ghi = 0;
loop(HN,
  GHIST[ghi] > 1 ? (
    gfy = fy_of(GHIST[ghi]);
    gfx_set(lc_r, lc_g, lc_b, 0.25 + 0.7 * min(1, GHIST[HN + ghi] * 4));
    gfx_rect(VX + ghi * gbw, gfy - scale, max(1, gbw - scale), max(2, 3*scale), 1);
  );
  ghi += 1;
);
lcd_finish();

MW = 16*scale;
MAX0 = LX + LW + 26*scale;
MSP = (ox + DW*scale - MARGIN - MAX0 - MW);
meter(MAX0, LY, MW, LH, ipk, "IN");
meter(MAX0 + MSP, LY, MW, LH, opk, "OUT");

hline(162*scale);
row_begin(170*scale, 7, 3);
sec(3, "TRACKING", 0.94, 0.84, 0.34); knob(4); knob(6); knob(7);
sec(1, "PITCH", 0.45, 0.80, 0.95); knob(5);
sec(3, "LEVEL", 0.80, 0.80, 0.84); knob(2); knob(3); knob(8);

hint_bar(304*scale, 32*scale, hint_text(drag_target > 0 ? drag_target : hov_s));

drag_update();

mouse_wheel = 0;
mouse_state = mouse_down;
