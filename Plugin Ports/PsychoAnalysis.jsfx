desc: Psycho Analysis Pitch Shifting Slicer (mda RePsycho! port) by chmaha
tags: pitch shift slicer drums transient glitch
author: chmaha
version: 1.0
changelog:
  Initial release.
about:
  Event-based pitch shifter. Each time the input crosses the threshold, a new slice starts: it is read
  back slower (and so lower) than it was recorded, and fades away with the Decay setting. Hold sets the
  shortest time before the next slice can start. Made for drums and percussive parts: detuned kicks,
  growling snares, and strange pitched-down echoes of anything with sharp attacks.
  High quality plays stereo with interpolation; Low quality sums to mono without interpolation, which
  sounds grittier.
  Ported from mda RePsycho! by Paul Kellett (Maxim Digital Audio), via mda-effects
  https://github.com/pluginguru/mda-effects (MIT or GPLv2+)
  JSFX version released under GPLv3+ license
  Claude generated some of this code

slider1:p_tune=1<0,1,0.0001>-Tune
slider2:p_fine=1<0,1,0.0001>-Fine
slider3:p_decay=0.5<0,1,0.001>-Decay
slider4:p_thresh=0.6<0,1,0.001>-Threshold
slider5:p_hold=0.45<0,1,0.001>-Hold
slider6:p_mix=1<0,1,0.001>-Mix
slider7:p_qual=0<0,1,1{Low,High}>-Quality

in_pin:Left input
in_pin:Right input
out_pin:Left output
out_pin:Right output
options:no_meter

@init

ext_noinit = gfx_ext_retina = 1;
ext_nodenorm = 1;

function itrunc(x) ( x < 0 ? ceil(x) : floor(x); );

SIZE = 22050;
BUF1 = 0;
BUF2 = 22100;
memset(BUF1, 0, 44200);

rp_tim = SIZE + 1;
rp_gai = 0;
rp_buf = 0;
rp_buf2 = 0;
rp_x = rp_x2 = 0;

function rp_set()
(
  rp_dtim = 441 + itrunc(0.5 * SIZE * p_hold);
  rp_thr = 10 ^ (1.5 * p_thresh - 1.5);
  rp_env = p_decay > 0.5 ? 1 + 0.003 * ((p_decay - 0.5) ^ 5) : 1 + 0.025 * ((p_decay - 0.5) ^ 5);
  rp_tun = ((itrunc(p_tune * 24) - 24) + (p_fine - 1)) / 24;
  rp_tun = 10 ^ (0.60206 * rp_tun);
  rp_wet = 0.5 * sqrt(p_mix);
  rp_dry = sqrt(1 - p_mix);
);

rp_set();

@slider

last_srate != srate ? (
  last_srate = srate;
  meter_decay = 0.001 ^ (1 / (0.4 * srate));
);
rp_set();

@block

rp_set();
rp_hq = p_qual > 0.5;
rp_we = rp_hq ? rp_wet * 2 : rp_wet;
rp_x = rp_x2 = 0;

@sample

rp_a = spl0;
rp_b = spl1;

(rp_a + rp_b > rp_thr && rp_tim > rp_dtim) ? (
  rp_gai = 1;
  rp_tim = 0;
  trig_flash = 1;
);

rp_hq ? (
  rp_tim < 22050 ? (
    rp_tim < 80 ? (
      rp_tim == 0 ? ( rp_buf = rp_x; rp_buf2 = rp_x2; );
      BUF1[rp_tim] = rp_a;
      BUF2[rp_tim] = rp_b;
      rp_i = floor(rp_tim * rp_tun);
      rp_x = BUF1[rp_i];
      rp_x2 = BUF2[rp_i];
      rp_x = rp_buf * (1 - 0.0125 * rp_tim) + rp_x * 0.0125 * rp_tim;
      rp_x2 = rp_buf2 * (1 - 0.0125 * rp_tim) + rp_x2 * 0.0125 * rp_tim;
    ) : (
      BUF1[rp_tim] = rp_a;
      BUF2[rp_tim] = rp_b;
      rp_it1 = rp_tim * rp_tun;
      rp_of1 = floor(rp_it1);
      rp_it1 = rp_it1 - rp_of1;
      rp_it2 = 1 - rp_it1;
      rp_x = rp_it2 * BUF1[rp_of1] + rp_it1 * BUF1[rp_of1 + 1];
      rp_x2 = rp_it2 * BUF2[rp_of1] + rp_it1 * BUF2[rp_of1 + 1];
    );
    rp_tim += 1;
    rp_gai *= rp_env;
  ) : rp_gai = 0;
  spl0 = rp_a * rp_dry + rp_x * rp_gai * rp_we;
  spl1 = rp_b * rp_dry + rp_x2 * rp_gai * rp_we;
) : (
  rp_tim < 22050 ? (
    rp_tim < 80 ? (
      rp_tim == 0 ? rp_buf = rp_x;
      BUF1[rp_tim] = rp_a + rp_b;
      rp_x = BUF1[floor(rp_tim * rp_tun)];
      rp_x = rp_buf * (1 - 0.0125 * rp_tim) + rp_x * 0.0125 * rp_tim;
    ) : (
      BUF1[rp_tim] = rp_a + rp_b;
      rp_x = BUF1[floor(rp_tim * rp_tun)];
    );
    rp_tim += 1;
    rp_gai *= rp_env;
  ) : rp_gai = 0;
  spl0 = rp_a * rp_dry + rp_x * rp_gai * rp_we;
  spl1 = rp_b * rp_dry + rp_x * rp_gai * rp_we;
);

m_l = max(abs(rp_a), abs(rp_b));
m_l > ipk ? ipk = m_l : ipk *= meter_decay;
m_l = max(abs(spl0), abs(spl1));
m_l > opk ? opk = m_l : opk *= meter_decay;
m_l = rp_a + rp_b;
m_l > spk ? spk = m_l : spk *= meter_decay;
gate_v = rp_gai;

@gfx 760 336

DW = 760;
DH = 336;
scale = max(0.5, min(gfx_w / DW, gfx_h / DH));
ox = floor((gfx_w - DW*scale) * 0.5);
oy = 0;

MARGIN = 14*scale;
CW = 112*scale;
KR = 30*scale;
PANEL_H = 128*scale;

function automate(s, end_touch)
(
<?
  max_sliders > 7 ? printf("slider_automate(2^(s-1), end_touch);") :
    printf("s == 1 ? slider_automate(p_tune, end_touch) : s == 2 ? slider_automate(p_fine, end_touch) : s == 3 ? slider_automate(p_decay, end_touch) : s == 4 ? slider_automate(p_thresh, end_touch) : s == 5 ? slider_automate(p_hold, end_touch) : s == 6 ? slider_automate(p_mix, end_touch) : s == 7 ? slider_automate(p_qual, end_touch) :");
?> 0;
);

function set_slider(s, gv) ( slider(s) = gv; automate(s, 0); automate(s, 1); );
function hit_circle(mx, my, cx, cy, rad) ( sqr(mx - cx) + sqr(my - cy) <= sqr(rad); );
function hit_rect(mx, my, x, y, w, h) ( mx >= x && mx <= x+w && my >= y && my <= y+h; );
function g_trunc(x) ( x < 0 ? ceil(x) : floor(x); );

function def_val(s)
(
  s == 1 ? 1 : s == 2 ? 1 : s == 3 ? 0.5 : s == 4 ? 0.6 : s == 5 ? 0.45 : 1;
);

function knob_name(s)
(
  s == 1 ? "Tune" : s == 2 ? "Fine" : s == 3 ? "Decay" : s == 4 ? "Thresh" : s == 5 ? "Hold" : "Mix";
);

function hint_text(s)
(
  s == 1 ? "Tune: how far each slice is pitched down, 0 to -24 semitones" :
  s == 2 ? "Fine: extra downward detune of up to one semitone" :
  s == 3 ? "Decay: how fast each slice fades; left of centre dies away quickly, right holds on" :
  s == 4 ? "Thresh: input level that starts a new slice; lower catches quieter hits" :
  s == 5 ? "Hold: shortest time before the next slice can start" :
  s == 6 ? "Mix: balance of the dry input and the pitched slices" :
  s == 7 ? "Quality: High keeps stereo with smooth interpolation; Low sums to mono and sounds grittier" :
  "Drag or scroll a knob to adjust  ·  Ctrl for fine control  ·  double-click to reset";
);

function ptext(s)
(
  s == 1 ? sprintf(#ptxt, "%d semi", g_trunc(24 * p_tune) - 24) :
  s == 2 ? sprintf(#ptxt, "%d cent", g_trunc(99 * p_fine) - 99) :
  s == 3 ? sprintf(#ptxt, "%d%%", g_trunc((p_decay - 0.5) * 100)) :
  s == 4 ? sprintf(#ptxt, "%d dB", g_trunc(30 * p_thresh - 30)) :
  s == 5 ? sprintf(#ptxt, "%d ms", g_trunc(1000 * (441 + g_trunc(0.5 * 22050 * p_hold)) / srate)) :
  sprintf(#ptxt, "%d%%", g_trunc(100 * p_mix));
  #ptxt;
);

function upper(str)
local(i, c)
(
  i = 0;
  loop(strlen(str),
    c = str_getchar(str, i);
    (c >= 97 && c <= 122) ? str_setchar(str, i, c - 32);
    i += 1;
  );
  str;
);

function draw_knob(cx, cy, rad, pos, cr, cg, cb, valtext, name)
local(ang0, ang1, ang, i, tx, ty)
(
  ang0 = -2.35619;
  ang1 =  2.35619;
  gfx_set(0.05, 0.05, 0.06, 1);
  gfx_circle(cx, cy, rad + 2*scale, 1, 1);
  gfx_set(cr*0.55, cg*0.55, cb*0.55, 1);
  gfx_circle(cx, cy, rad, 1, 1);
  gfx_set(cr, cg, cb, 1);
  gfx_circle(cx, cy, rad*0.72, 1, 1);
  gfx_set(1, 1, 1, 0.18);
  gfx_circle(cx - rad*0.28, cy - rad*0.28, rad*0.42, 1, 1);
  i = 0;
  loop(9,
    ang = ang0 + (ang1 - ang0) * (i / 8);
    gfx_set(0.85, 0.85, 0.85, 0.7);
    gfx_line(cx + sin(ang)*rad*0.82, cy - cos(ang)*rad*0.82, cx + sin(ang)*rad*0.98, cy - cos(ang)*rad*0.98, 1);
    i += 1;
  );
  ang = ang0 + (ang1 - ang0) * pos;
  gfx_set(0.05, 0.05, 0.05, 1);
  gfx_line(cx, cy, cx + sin(ang)*rad*0.85, cy - cos(ang)*rad*0.85, 1);
  gfx_setfont(1, "Arial", 14*scale);
  gfx_set(0.85, 0.85, 0.85, 1);
  gfx_measurestr(valtext, tx, ty);
  gfx_x = cx - tx*0.5; gfx_y = cy - rad - 18*scale;
  gfx_drawstr(valtext);
  gfx_set(0.8, 0.8, 0.82, 1);
  gfx_measurestr(name, tx, ty);
  gfx_x = cx - tx*0.5; gfx_y = cy + rad + 7*scale;
  gfx_drawstr(name);
);

function lcd_touch(s) ( lcd_sl = s; lcd_t = time_precise(); );

function row_begin(y, nk, ns)
(
  rx = ox + (DW*scale - (nk*CW + ns*8*scale + (ns - 1)*10*scale)) * 0.5;
  ry = oy + y;
);

function sec(nk, title, cr, cg, cb)
local(w, tw, th)
(
  w = nk*CW + 8*scale;
  gfx_set(0.035, 0.035, 0.04, 1);
  gfx_rect(rx - scale, ry - scale, w + 2*scale, PANEL_H + 2*scale, 1);
  gfx_set(0.125, 0.125, 0.14, 1);
  gfx_rect(rx, ry, w, PANEL_H, 1);
  gfx_set(cr, cg, cb, 0.8);
  gfx_rect(rx, ry, w, max(1, 2*scale), 1);
  gfx_setfont(1, "Arial", 12*scale, 'b');
  gfx_set(cr*0.75 + 0.15, cg*0.75 + 0.15, cb*0.75 + 0.15, 1);
  gfx_measurestr(title, tw, th);
  gfx_x = rx + (w - tw)*0.5; gfx_y = ry + 5*scale;
  gfx_drawstr(title);
  k_sx = rx + 4*scale; k_col = 0;
  k_r = cr; k_g = cg; k_b = cb;
  rx += w + 10*scale;
);

function set_norm(s, gv)
local(old)
(
  old = slider(s);
  slider(s) = (s == 1 || s == 2) ? floor(gv*10000 + 0.5) / 10000 : floor(gv*1000 + 0.5) / 1000;
  slider(s) !== old ? automate(s, 0);
);

function knob_at(s, cx, cy, rad, cr, cg, cb)
local(hov, gv, gst)
(
  hov = hit_circle(mouse_x, mouse_y, cx, cy, rad + 4*scale);
  hov ? hov_s = s;
  (mouse_just_down && hov) ? (
    (click_target == s && time_precise() - click_time < 0.3) ? (
      set_slider(s, def_val(s));
      drag_target = 0;
      lcd_touch(s);
    ) : (
      drag_target = s; drag_y0 = mouse_y; drag_v0 = slider(s); drag_fine = mouse_cap & 4;
    );
    click_target = s; click_time = time_precise();
  );
  (hov && mouse_wheel != 0 && drag_target == 0) ? (
    gst = s == 1 ? 1 / 24 : (mouse_cap & 4) ? 0.001 : 0.01;
    gv = slider(s) + (mouse_wheel > 0 ? gst : -gst);
    s == 1 ? gv = (floor(gv * 24 + 0.5) + 0.5) / 24;
    set_norm(s, max(0, min(1, gv)));
    automate(s, 1);
    lcd_touch(s);
    mouse_wheel = 0;
  );
  draw_knob(cx, cy, rad, slider(s), cr, cg, cb, ptext(s), knob_name(s));
);

function seg_btn(s, x, y, w, h, label, act, fs)
local(tw, th, gap, hov)
(
  hov = hit_rect(mouse_x, mouse_y, x, y, w, h);
  hov ? hov_s = s;
  gap = max(1, scale);
  gfx_set(0.03, 0.03, 0.04, 1);
  gfx_rect(x - gap, y - gap, w + 2*gap, h + 2*gap, 1);
  act ? gfx_set(acc_r*0.62, acc_g*0.62, acc_b*0.62, 1) : gfx_set(hov ? 0.17 : 0.14, hov ? 0.17 : 0.14, hov ? 0.19 : 0.16, 1);
  gfx_rect(x, y, w, h, 1);
  act ? gfx_set(acc_r, acc_g, acc_b, 1) : gfx_set(0.21, 0.21, 0.24, 1);
  gfx_rect(x + gap, y + gap, w - 2*gap, h*0.5, 1);
  gfx_set(1, 1, 1, act ? 0.22 : 0.08);
  gfx_rect(x + gap, y + gap, w - 2*gap, h*0.3, 1);
  gfx_setfont(1, "Arial", fs*scale, 'b');
  act ? gfx_set(0.08, 0.08, 0.10, 1) : gfx_set(0.78, 0.78, 0.80, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + (w - tw)*0.5; gfx_y = y + (h - th)*0.5;
  gfx_drawstr(label);
  mouse_just_down && hov;
);

function knob(s)
local(cx, cy)
(
  cx = k_sx + CW*(k_col + 0.5);
  cy = ry + 72*scale;
  k_col += 1;
  knob_at(s, cx, cy, KR, k_r, k_g, k_b);
);

function glow_text(str, x, y, r, g, b)
(
  gfx_set(r, g, b, 0.16);
  gfx_x = x - scale; gfx_y = y; gfx_drawstr(str);
  gfx_x = x + scale; gfx_y = y; gfx_drawstr(str);
  gfx_x = x; gfx_y = y - scale; gfx_drawstr(str);
  gfx_x = x; gfx_y = y + scale; gfx_drawstr(str);
  gfx_set(r, g, b, 1);
  gfx_x = x; gfx_y = y; gfx_drawstr(str);
);

function meter(x, y, w, h, pk, label)
local(db, fy, tw, th)
(
  gfx_setfont(1, "Arial", 11*scale, 'b');
  gfx_set(0.62, 0.63, 0.66, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + w*0.5 - tw*0.5; gfx_y = y;
  gfx_drawstr(label);
  y += th + 3*scale;
  h -= th + 3*scale;
  gfx_set(0.04, 0.04, 0.05, 1);
  gfx_rect(x - scale, y - scale, w + 2*scale, h + 2*scale, 1);
  gfx_set(acc_r*0.22, acc_g*0.22, acc_b*0.22, 1);
  gfx_rect(x, y, w, h, 1);
  db = pk > 0.000001 ? 20 * log10(pk) : -100;
  fy = y + h * (1 - max(0, min(1, (db + 60) / 60)));
  db > -1 ? gfx_set(1.0, 0.35, 0.30, 1) : gfx_set(acc_r, acc_g, acc_b, 1);
  gfx_rect(x, fy, w, y + h - fy, 1);
);

mouse_down = mouse_cap & 1;
mouse_just_down = mouse_down && !mouse_state;
hov_s = 0;
is_hq = p_qual > 0.5;
acc_r = 0.98; acc_g = 0.42; acc_b = 0.78;

// ---------------------------------------------------------------------- background + header
gfx_set(0.09, 0.08, 0.10, 1);
gfx_rect(0, 0, gfx_w, gfx_h, 1);

gfx_setfont(1, "Arial", 20*scale, 'b');
gfx_set(acc_r, acc_g, acc_b, 1);
gfx_x = ox + MARGIN; gfx_y = oy + 8*scale;
gfx_drawstr("PSYCHO ANALYSIS");
gfx_setfont(1, "Arial", 13*scale);
gfx_set(0.58, 0.60, 0.64, 1);
gfx_x = ox + MARGIN + 2*scale; gfx_y = oy + 30*scale;
gfx_drawstr("by chmaha  ·  based on mda RePsycho!");

TABW = 86*scale; TABH = 26*scale; TABG = 5*scale;
tx0 = ox + DW*scale - MARGIN - 2*TABW - TABG;
seg_btn(7, tx0, oy + 11*scale, TABW, TABH, "LOW", !is_hq, 14) ? ( set_slider(7, 0); mouse_just_down = 0; );
seg_btn(7, tx0 + TABW + TABG, oy + 11*scale, TABW, TABH, "HIGH", is_hq, 14) ? ( set_slider(7, 1); mouse_just_down = 0; );
is_hq = p_qual > 0.5;

gfx_set(0.04, 0.04, 0.05, 1);
gfx_rect(0, oy + 46*scale, gfx_w, max(1, scale), 1);

// ---------------------------------------------------------------------- LCD
LX = ox + MARGIN; LY = oy + 56*scale; LW = 600*scale; LH = 96*scale;
gfx_set(0.03, 0.03, 0.04, 1);
gfx_rect(LX - 2*scale, LY - 2*scale, LW + 4*scale, LH + 4*scale, 1);
gfx_set(0.17, 0.17, 0.19, 1);
gfx_rect(LX, LY, LW, LH, 1);
GX = LX + 6*scale; GY = LY + 6*scale; GW = LW - 12*scale; GH = LH - 12*scale;
gfx_set(0.02, 0.02, 0.02, 1);
gfx_rect(GX - scale, GY - scale, GW + 2*scale, GH + 2*scale, 1);
gfx_set(0.035 + acc_r*0.05, 0.035 + acc_g*0.05, 0.035 + acc_b*0.05, 1);
gfx_rect(GX, GY, GW, GH, 1);
lc_r = min(1, 0.35 + acc_r*0.75); lc_g = min(1, 0.35 + acc_g*0.75); lc_b = min(1, 0.35 + acc_b*0.75);

TAW = 230*scale;
gfx_setfont(2, "Courier New", 14*scale, 'b');
glow_text("PITCH", GX + 10*scale, GY + 6*scale, lc_r, lc_g, lc_b);
strcpy(#lt, is_hq ? "HQ STEREO" : "LQ MONO");
gfx_measurestr(#lt, ltw, lth);
glow_text(#lt, GX + TAW - ltw, GY + 6*scale, lc_r, lc_g, lc_b);

g_semis = (g_trunc(24 * p_tune) - 24) + (p_fine - 1);
sprintf(#ln, "%+.2f ST", g_semis);
gfx_setfont(2, "Courier New", 26*scale, 'b');
gfx_measurestr(#ln, ltw, lth);
glow_text(#ln, GX + 10*scale + (TAW - 10*scale - ltw)*0.5, GY + 26*scale + (26*scale - lth)*0.5, lc_r, lc_g, lc_b);

gfx_setfont(2, "Courier New", 14*scale, 'b');
LY3 = GY + GH - 20*scale;
(lcd_sl > 0 && time_precise() - lcd_t < 1.5) ? (
  strcpy(#lt, knob_name(lcd_sl)); upper(#lt);
  glow_text(#lt, GX + 10*scale, LY3, lc_r, lc_g, lc_b);
  strcpy(#lv, ptext(lcd_sl)); upper(#lv);
  gfx_measurestr(#lv, ltw, lth);
  glow_text(#lv, GX + TAW - ltw, LY3, lc_r, lc_g, lc_b);
) : (
  glow_text("TRIG", GX + 10*scale, LY3, lc_r, lc_g, lc_b);
  gfx_measurestr("TRIG", ltw, lth);
  trig_flash ? ( trig_lamp = 1; trig_flash = 0; ) : trig_lamp *= 0.82;
  gfx_set(lc_r, lc_g, lc_b, 0.18 + 0.82 * trig_lamp);
  gfx_circle(GX + 20*scale + ltw, LY3 + lth*0.5, 4*scale, 1, 1);
);

SDX = GX + TAW + 12*scale;
gfx_set(lc_r, lc_g, lc_b, 0.18);
gfx_rect(SDX, GY + 8*scale, max(1, scale), GH - 16*scale, 1);

VX = SDX + 12*scale; VW = GX + GW - 10*scale - VX;
VY = GY + 8*scale; VH = GH - 16*scale;
HN = 64;
GHIST_G = 50000; GHIST_I = 50100;
hist_t += 1;
hist_t >= 2 ? (
  hist_t = 0;
  ghi = 0; loop(HN - 1, GHIST_G[ghi] = GHIST_G[ghi + 1]; GHIST_I[ghi] = GHIST_I[ghi + 1]; ghi += 1; );
  GHIST_G[HN - 1] = gate_v; GHIST_I[HN - 1] = spk;
);
gfx_set(lc_r, lc_g, lc_b, 0.08);
gfx_rect(VX, VY, VW, VH, 1);
gthr_y = VY + VH * (1 - max(0, min(1, (20 * log10(10 ^ (1.5 * p_thresh - 1.5)) + 48) / 48)));
gbw = VW / HN;
ghi = 0;
loop(HN,
  ghd = GHIST_I[ghi] > 0.00001 ? 20 * log10(GHIST_I[ghi]) : -100;
  ghy = VY + VH * (1 - max(0, min(1, (ghd + 48) / 48)));
  gfx_set(lc_r, lc_g, lc_b, 0.30);
  gfx_rect(VX + ghi * gbw, ghy, max(1, gbw - scale), VY + VH - ghy, 1);
  ggy = VY + VH * (1 - max(0, min(1, GHIST_G[ghi])));
  gfx_set(lc_r, lc_g, lc_b, 0.95);
  gfx_rect(VX + ghi * gbw, ggy, max(1, gbw - scale), max(1, 2*scale), 1);
  ghi += 1;
);
gfx_set(1, 0.9, 0.5, 0.7);
gfx_rect(VX, gthr_y, VW, max(1, scale), 1);
gfx_setfont(1, "Arial", 11*scale);
gfx_set(1, 0.9, 0.5, 0.8);
gfx_x = VX + 3*scale; gfx_y = max(VY, gthr_y - 13*scale); gfx_drawstr("THRESH");

gfx_set(0, 0, 0, 0.22);
scan_y = GY;
while (scan_y < GY + GH) ( gfx_rect(GX, scan_y, GW, max(1, scale), 1); scan_y += 3*scale; );
gfx_set(1, 1, 1, 0.035);
gfx_rect(GX, GY, GW, GH*0.45, 1);

// ---------------------------------------------------------------------- meters
MW = 16*scale;
MAX0 = LX + LW + 26*scale;
MSP = (ox + DW*scale - MARGIN - MAX0 - MW);
meter(MAX0, LY, MW, LH, ipk, "IN");
meter(MAX0 + MSP, LY, MW, LH, opk, "OUT");

gfx_set(0.04, 0.04, 0.05, 1);
gfx_rect(0, oy + 162*scale, gfx_w, max(1, scale), 1);

// ---------------------------------------------------------------------- knob panels
row_begin(170*scale, 6, 3);
sec(2, "PITCH", 0.98, 0.42, 0.78); knob(1); knob(2);
sec(3, "TRIGGER", 0.45, 0.80, 0.95); knob(4); knob(5); knob(3);
sec(1, "OUTPUT", 0.80, 0.80, 0.84); knob(6);

// ---------------------------------------------------------------------- hint bar
gfx_set(0.04, 0.04, 0.05, 1);
gfx_rect(0, oy + 304*scale, gfx_w, max(1, scale), 1);
hs = drag_target > 0 ? drag_target : hov_s;
gfx_setfont(1, "Arial", 13*scale);
gfx_set(0.62, 0.63, 0.66, 1);
strcpy(#ghint, hint_text(hs));
gfx_measurestr(#ghint, htw, hth);
htw > (DW - 20)*scale ? ( gfx_setfont(1, "Arial", 13*scale*(DW - 20)*scale/htw); gfx_measurestr(#ghint, htw, hth); );
gfx_x = ox + (DW*scale - htw)*0.5; gfx_y = oy + 304*scale + (32*scale - hth)*0.5;
gfx_drawstr(#ghint);

drag_target > 0 ? (
  mouse_down ? (
    mouse_cap |= 65536;
    fine_now = mouse_cap & 4;
    fine_now != drag_fine ? ( drag_y0 = mouse_y; drag_v0 = slider(drag_target); drag_fine = fine_now; );
    gv = max(0, min(1, drag_v0 + (drag_y0 - mouse_y) / (150*scale) * (fine_now ? 0.1 : 1)));
    drag_target == 1 ? gv = min(1, (floor(gv * 24) + 0.5) / 24);
    set_norm(drag_target, gv);
    lcd_touch(drag_target);
  ) : ( automate(drag_target, 1); drag_target = 0; );
);

mouse_wheel = 0;
mouse_state = mouse_down;
