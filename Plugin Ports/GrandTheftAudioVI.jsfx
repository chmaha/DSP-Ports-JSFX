desc: Grand Theft Audio VI by chmaha
author: chmaha
version: 1.0
changelog:
  Initial release.
tags: utility joke
about:
  Steals nothing, changes nothing. Audio passes straight through while you admire the view.
  Claude generated some of this code.

  Licence: GPL-3.0. Artwork belongs to its owners.
provides:
  Dependencies/GrandTheftAudioVI/GTA6.jpg

options:no_meter

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@gfx 960 540
!g_tried ? (
  g_tried = 1;
  g_img = gfx_loadimg(1, "Dependencies/GrandTheftAudioVI/GTA6.jpg") >= 0 || gfx_loadimg(1, "GTA6.jpg") >= 0;
);
gfx_set(0, 0, 0, 1);
gfx_rect(0, 0, gfx_w, gfx_h);
g_img ? (
  g_sc = min(gfx_w / 960, gfx_h / 540);
  gfx_a = 1;
  gfx_blit(1, 1, 0, 0, 0, 960, 540, floor((gfx_w - 960 * g_sc) * 0.5), 0, 960 * g_sc, 540 * g_sc);
) : (
  gfx_set(0.85, 0.85, 0.85, 1);
  gfx_setfont(1, "Arial", 14);
  gfx_x = 20; gfx_y = 20;
  gfx_drawstr("Image not found (Dependencies/GrandTheftAudioVI/GTA6.jpg)");
);
