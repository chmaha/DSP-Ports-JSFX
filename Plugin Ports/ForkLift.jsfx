    dg = (g - sp_g) / n;
    k = sp_g;
    j = 0; loop(n, k += dg; s = SIDEB[j] * k; OUTL[j] += s; OUTR[j] -= s; j += 1;);
    sp_g = g;
  );
  j = 0; loop(n, blk_max = max(blk_max, abs(MIXB[j])); j += 1;);
  alive = 0;
  i = 0; loop(NV, v = VREC + i * VS; v[0] ? alive = 1; i += 1;);
  sub_count += 1;
  sub_count >= 8 ? (
    sub_count = 0;
    i = 0;
    loop(NV,
      v = VREC + i * VS;
      v[0] ? (v[10] > 0 ? (v[10] -= 8; v[10] <= 0 && v[8] === 32768 ? v[8] = 32767;););
      i += 1;
    );
    fx_peak = floor(blk_peak * 32768); blk_peak = 0;
    tw_lv += floor((min(32767, fx_peak) - tw_lv) / 32);
    (!alive && !pn_n && blk_max < 2 / 32768) ? (memset(CH_M, 0, 15); tx_n ? (tx_run = tx_ty; tx_n = 0;););
    blk_max = 0;
  );
);

// ---------------------------------------------------------------------- init

function engine_reset() local(i, v) (
  memset(VREC, 0, NV * VS);
  i = 0; loop(NV, v = VREC + i * VS; v[29] = i * 72; i += 1;);
  memset(CH_M, 0, 15); memset(CH_S, 0, 15); memset(TX_M, 0, 15); memset(TX_S, 0, 15);
  memset(KEYL, 0, 128);
  rh_pedal_w = 32768; rh_ped_dn = 0; sus_cc = 0;
  rh_lfsr = 44257;
  pn_x = 625341585; pn_n = 0; pn_lp = 0;
  kn_on = 0;
  tw_ph = 0; tw_gl = tw_gr = 32768; tw_lv = 0; fx_peak = 0;
  sp_g = 1; side_tail = 0;
  tx_n = 0;
  set_voicing();
  tx_run = rh_type;
  sub_pos = 0; sub_count = 0; blk_peak = 0; blk_max = 0;
);

function params_update() (
  set_voicing();
  lvl_t = 10 ^ (max(-12, min(12, p_lvl)) / 20);
  rng_lo = p_ext >= 0.5 ? 21 : 28;
  rng_hi = p_ext >= 0.5 ? 108 : 100;
);

tables_ok ? (
  keys_setup();
  hc_setup();
);
last_srate = 0;

@slider

tables_ok ? (
  last_srate != srate ? (
    last_srate = srate;
    rate_setup();
    engine_reset();
    lvl_g = 10 ^ (max(-12, min(12, p_lvl)) / 20);
  );
  params_update();
);

@block

tables_ok ? params_update();
evn = 0;
while (uiq_r != uiq_w && evn < 1000) (
  EVQ[evn * 4] = 0; EVQ[evn * 4 + 1] = UIQ[uiq_r * 3]; EVQ[evn * 4 + 2] = UIQ[uiq_r * 3 + 1]; EVQ[evn * 4 + 3] = UIQ[uiq_r * 3 + 2];
  evn += 1;
  uiq_r = (uiq_r + 1) % 64;
);
while (midirecv(mofs, mm1, mm2, mm3)) (
  st = mm1 & 240;
  (st === 144 || st === 128 || st === 176) && evn < 1000 ? (
    EVQ[evn * 4] = mofs; EVQ[evn * 4 + 1] = mm1; EVQ[evn * 4 + 2] = mm2; EVQ[evn * 4 + 3] = mm3;
    evn += 1;
  );
  midisend(mofs, mm1, mm2, mm3);
);
evi = 0;
bpos = 0;

@sample

tables_ok ? (
  sub_pos === 0 ? (
    while (evi < evn && EVQ[evi * 4] <= bpos + SUBN - 1) (
      st = EVQ[evi * 4 + 1] & 240; d1 = EVQ[evi * 4 + 2]; d2 = EVQ[evi * 4 + 3];
      st === 144 && d2 > 0 ? (
        (d1 >= rng_lo && d1 <= rng_hi) ? (KEYL[d1] = 1; strike(d1, d2););
      ) : (st === 128 || st === 144) ? (
        KEYL[d1] = 0; note_off(d1, st === 128 ? d2 : 0);
      ) : st === 176 ? (
        d1 === 64 ? (sus_cc = d2; pedal(d2);) : (d1 === 120 || d1 === 123) ? all_off();
      );
      evi += 1;
    );
    render_sub();
  );
  lvl_g += (lvl_t - lvl_g) * 0.002;
  spl0 = OUTL[sub_pos] * lvl_g;
  spl1 = OUTR[sub_pos] * lvl_g;
  blk_peak = max(blk_peak, max(abs(OUTL[sub_pos]), abs(OUTR[sub_pos])));
  sub_pos += 1;
  sub_pos >= SUBN ? sub_pos = 0;
);
bpos += 1;

@gfx 1000 484

UDW = 1000;
UDH = 484;
uscale = max(0.5, min(gfx_w / UDW, gfx_h / UDH));
uox = floor((gfx_w - UDW * uscale) * 0.5);
uoy = 0;

function automate(s, e)
(
<?
  max_sliders > 16 ? printf("slider_automate(2^(s-1), e);") : (
    loop(i = 1; 16,
      printf("  s == %d ? slider_automate(%s, e) :\n", i,
        i == 1 ? "p_type" : i == 2 ? "p_tone" : i == 3 ? "p_bark" : i == 4 ? "p_bell" : i == 5 ? "p_ham" :
        i == 6 ? "p_decay" : i == 7 ? "p_rel" : i == 8 ? "p_noise" : i == 9 ? "p_spread" : i == 10 ? "p_tune" :
        i == 11 ? "p_tw" : i == 12 ? "p_twd" : i == 13 ? "p_twr" : i == 14 ? "p_tws" : i == 15 ? "p_ext" : "p_lvl");
      i += 1;
    );
  );
?> 0;
);

function smin(s) ( s == 10 ? -50 : s == 16 ? -12 : 0; );
function smax(s) ( s == 10 ? 50 : s == 16 ? 12 : s == 1 ? 3 : s == 11 ? 2 : s == 15 ? 1 : 127; );
function sdef(s) ( s == 8 ? 48 : s == 13 ? 90 : (s == 9 || s == 10 || s == 14 || s == 16 || s == 1 || s == 11 || s == 15) ? 0 : 64; );
function set_slider(s, x) ( slider(s) = x; automate(s, 0); automate(s, 1); );
function hit_circle(mx, my, cx, cy, rad) ( sqr(mx - cx) + sqr(my - cy) <= sqr(rad); );
function hit_rect(mx, my, x, y, w, h) ( mx >= x && mx <= x + w && my >= y && my <= y + h; );
function px(x) ( uox + x * uscale; );
function py(y) ( uoy + y * uscale; );
function norm_of(s) ( (slider(s) - smin(s)) / (smax(s) - smin(s)); );
function set_norm(s, x) local(old, nv) (
  old = slider(s);
  nv = smin(s) + max(0, min(1, x)) * (smax(s) - smin(s));
  s == 16 ? nv = floor(nv * 10 + 0.5) / 10 : nv = floor(nv + 0.5);
  slider(s) = nv;
  slider(s) !== old ? automate(s, 0);
);

function ctext(str, cx, y, fs, fl) local(tw, th)
(
  gfx_setfont(1, "Arial", fs * uscale, fl);
  gfx_measurestr(str, tw, th);
  gfx_x = cx - tw * 0.5; gfx_y = y;
  gfx_drawstr(str);
);

function knob_name(s) (
  s == 2 ? "TONE" : s == 3 ? "BARK" : s == 4 ? "BELL" : s == 5 ? "HAMMER" : s == 6 ? "DECAY" : s == 7 ? "RELEASE" :
  s == 8 ? "NOISE" : s == 9 ? "SPREAD" : s == 10 ? "TUNE" : s == 12 ? "DEPTH" : s == 13 ? "RATE" : s == 14 ? "SHAPE" : "VOLUME";
);

function knob_value(s) local(v) (
  v = slider(s);
  s == 2 ? (v == 64 ? strcpy(#ukv, "0") : sprintf(#ukv, "%+d", v - 64)) :
  s == 10 ? (v == 0 ? strcpy(#ukv, "0 c") : sprintf(#ukv, "%+d c", v)) :
  s == 16 ? sprintf(#ukv, "%+.1f dB", v) :
  s == 13 ? sprintf(#ukv, "%.1f Hz", T_LFOINC[max(0, min(127, v | 0))] * 44100 / TWO32) :
  sprintf(#ukv, "%.1f", v * 10 / 127);
  #ukv;
);

function hint_text(s)
(
  s == 1 ? "Type: the instrument's voicing. Stage: the classic stage piano. Suitcase: its own amp and speakers. Early Felt: early felt hammer tips, rounder. Bell Dyno: a bright, bell-like modified voicing." :
  s == 2 ? "Tone: where the tine sits against its pickup. Lower is rounder and warmer, higher is more bell and midrange. Acts on the next notes." :
  s == 3 ? "Bark: how hard the tines swing past their pickups. Higher growls more when you play hard. Acts on the next notes." :
  s == 4 ? "Bell: the bright metallic overtone at the start of each note. Acts on the next notes." :
  s == 5 ? "Hammer: the hammer tips. Lower is softer and rounder, higher is harder and brighter. Acts on the next notes." :
  s == 6 ? "Decay: how long a held note rings. Acts on the next notes." :
  s == 7 ? "Release: how quickly the dampers stop a note when you let go. Acts on the next notes." :
  s == 8 ? "Noise: the mechanism. Damper thump and felt when you let go, the key knock (not on Stage) and the pedal's thud." :
  s == 9 ? "Spread: spreads the keys across the stereo field, low notes left and high notes right." :
  s == 10 ? "Tune: fine tuning, plus or minus 50 cents. Acts on the next notes." :
  s == 11 ? "Vibrato: Pan is the Suitcase's stereo vibrato (the sound swings between the speakers), Tremolo a volume tremolo." :
  s == 12 ? "Depth: how far the pan or tremolo swings." :
  s == 13 ? "Rate: the speed of the pan or tremolo." :
  s == 14 ? "Shape: from a smooth sine to a rounder, squarer swing. Above the middle it follows a lamp-driven amp tremolo: uneven, deeper on loud playing." :
  s == 15 ? "Keyboard range. 73: E1 to E7, like the real instrument (other notes are silent). 88: A0 to C8." :
  s == 16 ? "Volume: output level, plus or minus 12 dB." :
  s == 18 ? "Sustain (CC64): glows as the dampers lift off the tines. Click to hold or release; scroll or drag for half-pedal." :
  s == 17 ? (p_ext >= 0.5 ? "Click to play (88 keys, A0 to C8). Lower on the key is louder." : "Click to play (73 keys, E1 to E7). Lower on the key is louder.") :
  "Drag or scroll a knob to adjust  ·  Ctrl for fine control  ·  double-click to reset";
);

function rk_draw(cx, cy, rad, pos) local(ang0, ang1, ang, i, a, sa, ca)
(
  ang0 = -2.35619;
  ang1 = 2.35619;
  gfx_set(0, 0, 0, 0.35);
  gfx_circle(cx + rad * 0.06, cy + rad * 0.10, rad * 1.02, 1, 1);
  gfx_set(0.62, 0.63, 0.65, 1);
  gfx_circle(cx, cy, rad, 1, 1);
  i = 0;
  loop(36,
    a = i * 2 * $pi / 36;
    gfx_set(0.80, 0.81, 0.83, 1);
    gfx_line(cx + sin(a) * rad * 0.84, cy - cos(a) * rad * 0.84, cx + sin(a) * rad * 0.97, cy - cos(a) * rad * 0.97, 1);
    i += 1;
  );
  gfx_set(0.05, 0.05, 0.055, 1);
  gfx_circle(cx, cy, rad * 0.80, 1, 1);
  gfx_set(1, 1, 1, 0.07);
  gfx_circle(cx - rad * 0.12, cy - rad * 0.14, rad * 0.54, 1, 1);
  ang = ang0 + (ang1 - ang0) * pos;
  sa = sin(ang); ca = cos(ang);
  gfx_set(0.95, 0.93, 0.88, 1);
  i = -1;
  loop(3,
    gfx_line(cx + sa * rad * 0.30 + ca * i * uscale, cy - ca * rad * 0.30 + sa * i * uscale, cx + sa * rad * 0.78 + ca * i * uscale, cy - ca * rad * 0.78 + sa * i * uscale, 1);
    i += 1;
  );
);

function scale_ticks(cx, cy, rad) local(i, a, big)
(
  i = 0;
  loop(11,
    a = -2.35619 + 4.71239 * i / 10;
    big = i == 0 || i == 10 || i == 5;
    gfx_set(0.93, 0.89, 0.80, big ? 0.9 : 0.45);
    gfx_line(cx + sin(a) * rad * 1.12, cy - cos(a) * rad * 1.12, cx + sin(a) * rad * (big ? 1.30 : 1.22), cy - cos(a) * rad * (big ? 1.30 : 1.22), 1);
    i += 1;
  );
);

function knob_at(s, cx, cy, rad, fsz) local(hov, x, ly, act)
(
  hov = hit_circle(mouse_x, mouse_y, cx, cy, rad + 4 * uscale);
  hov ? u_hov = s;
  (u_click && hov) ? (
    (u_ctarget == s && time_precise() - u_ctime < 0.3) ? (
      set_slider(s, sdef(s));
      u_drag = 0;
    ) : (
      u_drag = s; u_dy0 = mouse_y; u_dv0 = norm_of(s); u_dfine = mouse_cap & 4;
      automate(s, 0);
    );
    u_ctarget = s; u_ctime = time_precise();
    u_click = 0;
  );
  (hov && u_wheel != 0 && u_drag == 0) ? (
    x = norm_of(s) + (u_wheel / 120) * ((mouse_cap & 4) ? 0.0079 : 0.0394);
    set_norm(s, x);
    automate(s, 1);
    u_wheel = 0;
  );
  scale_ticks(cx, cy, rad);
  rk_draw(cx, cy, rad, norm_of(s));
  act = hov || u_drag == s;
  ly = cy + rad * 1.36 + 2 * uscale;
  gfx_set(0.93, 0.89, 0.80, 1);
  ctext(knob_name(s), cx, ly, fsz, 'b');
  gfx_set(act ? 0.98 : 0.62, act ? 0.66 : 0.60, act ? 0.25 : 0.56, 1);
  ctext(knob_value(s), cx, ly + (fsz + 4) * uscale, 12, 0);
);

function send_ev(st, d1, d2)
(
  UIQ[uiq_w * 3] = st; UIQ[uiq_w * 3 + 1] = d1; UIQ[uiq_w * 3 + 2] = d2;
  uiq_w = (uiq_w + 1) % 64;
);

function pedal_widget(x, y, w, h) local(hov, v, fill, pnv, cx, cy, lr)
(
  hov = hit_rect(mouse_x, mouse_y, x, y, w, h);
  hov ? u_hov = 18;
  v = sus_cc;
  (u_click && hov) ? (
    u_pdrag = 1; u_pdy0 = mouse_y; u_pdv0 = v; u_pmoved = 0;
    u_click = 0;
  );
  u_pdrag ? (
    u_down ? (
      abs(mouse_y - u_pdy0) > 3 * uscale ? u_pmoved = 1;
      u_pmoved ? (
        pnv = max(0, min(127, floor(u_pdv0 + (mouse_y - u_pdy0) / (h * 0.8) * 127 + 0.5)));
        pnv != v ? send_ev(176, 64, pnv);
      );
    ) : (
      !u_pmoved ? send_ev(176, 64, v >= 64 ? 0 : 127);
      u_pdrag = 0;
    );
  );
  (hov && u_wheel != 0 && !u_pdrag) ? (
    send_ev(176, 64, max(0, min(127, v + (u_wheel > 0 ? 8 : -8))));
    u_wheel = 0;
  );
  fill = max(0, min(1, 1 - rh_pedal_w / 32768));
  cx = x + w * 0.5; cy = y + h * 0.5; lr = 8 * uscale;
  fill > 0.01 ? (
    gfx_set(1, 0.62, 0.20, 0.10 + 0.25 * fill); gfx_circle(cx, cy, lr * (1.2 + 0.4 * fill), 1, 1);
  );
  gfx_set(0.02, 0.02, 0.025, 1); gfx_circle(cx, cy, lr + 2 * uscale, 1, 1);
  gfx_set(0.20 + 0.78 * fill, 0.10 + 0.55 * fill, 0.05 + 0.15 * fill, 1); gfx_circle(cx, cy, lr, 1, 1);
  gfx_set(1, 0.85, 0.55, 0.15 + 0.55 * fill); gfx_circle(cx - lr * 0.3, cy - lr * 0.3, lr * 0.3, 1, 1);
  gfx_set(0.93, 0.89, 0.80, 1);
  ctext("SUSTAIN", cx, y + h + 2 * uscale, 12, 'b');
  gfx_set(hov || u_pdrag ? 0.98 : 0.62, hov || u_pdrag ? 0.66 : 0.60, hov || u_pdrag ? 0.25 : 0.56, 1);
  fill >= 0.995 ? strcpy(#upd, "full") : fill <= 0.005 ? strcpy(#upd, "off") : sprintf(#upd, "%d%%", floor(fill * 100 + 0.5));
  ctext(#upd, cx, y + h + 16 * uscale, 11, 0);
);

function seg_btn(s, val, x, y, w, h, label) local(on, hov, tw, th)
(
  on = floor(slider(s) + 0.5) == val;
  hov = hit_rect(mouse_x, mouse_y, x, y, w, h);
  hov ? u_hov = s;
  on ? gfx_set(0.95, 0.62, 0.22, 1) : gfx_set(hov ? 0.26 : 0.20, hov ? 0.26 : 0.20, hov ? 0.28 : 0.22, 1);
  gfx_rect(x + uscale, y + uscale, w - 2 * uscale, h - 2 * uscale, 1);
  gfx_setfont(1, "Arial", 13 * uscale, 'b');
  on ? gfx_set(0.10, 0.07, 0.04, 1) : gfx_set(0.93, 0.89, 0.80, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + (w - tw) * 0.5; gfx_y = y + (h - th) * 0.5;
  gfx_drawstr(label);
  (u_click && hov && !on) ? ( set_slider(s, val); u_click = 0; );
);

function seg_frame(x, y, w, h)
(
  gfx_set(0.02, 0.02, 0.025, 1);
  gfx_roundrect(x - uscale, y - uscale, w + 2 * uscale, h + 2 * uscale, 5 * uscale, 1);
);

function group_label(str, x, y)
(
  gfx_setfont(1, "Arial", 12 * uscale, 'b');
  gfx_set(0.66, 0.64, 0.60, 1);
  gfx_x = x; gfx_y = y;
  gfx_drawstr(str);
);

function tine_kb(x, y, w, h, lo, nw, held, sc) local(ww, bw, bh, n, wi, pc, isb, kx, kwid, dn)
(
  ww = w / nw;
  bw = ww * 0.58; bh = h * 0.62;
  gfx_set(0.62, 0.05, 0.06, 1);
  gfx_rect(x, y - 7 * sc, w, 7 * sc, 1);
  gfx_set(0, 0, 0, 0.35);
  gfx_rect(x, y - 2 * sc, w, 2 * sc, 1);
  gfx_set(0.02, 0.02, 0.02, 1);
  gfx_rect(x, y, w, h, 1);
  n = lo; wi = 0;
  while (wi < nw) (
    pc = n % 12;
    isb = pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10;
    !isb ? (
      kx = floor(x + wi * ww) + max(1, floor(sc));
      kwid = floor(x + (wi + 1) * ww) - kx;
      dn = KEYL[n] > 0 || n == held;
      dn ? (
        gfx_gradrect(kx, y, kwid, h - 2 * sc, 0.82, 0.81, 0.78, 1, 0, 0, 0, 0, -0.12 / h, -0.12 / h, -0.12 / h, 0);
      ) : (
        gfx_gradrect(kx, y, kwid, h, 0.97, 0.96, 0.93, 1, 0, 0, 0, 0, -0.06 / h, -0.06 / h, -0.06 / h, 0);
        gfx_set(1, 1, 1, 0.5); gfx_rect(kx, y + h - 4 * sc, kwid, 1 * sc, 1);
        gfx_set(0.72, 0.71, 0.68, 1); gfx_rect(kx, y + h - 3 * sc, kwid, 3 * sc, 1);
      );
      gfx_set(0, 0, 0, dn ? 0.45 : 0.25); gfx_rect(kx, y, kwid, 3 * sc, 1);
      wi += 1;
    );
    n += 1;
  );
  n = lo; wi = 0;
  while (wi < nw) (
    pc = n % 12;
    isb = pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10;
    isb ? (
      kx = floor(x + wi * ww - bw * 0.5);
      dn = KEYL[n] > 0 || n == held;
      gfx_set(0, 0, 0, 0.45); gfx_rect(kx + 2 * sc, y, bw, bh + 3 * sc, 1);
      gfx_gradrect(kx, y, bw, dn ? bh - 2 * sc : bh, 0.05, 0.05, 0.055, 1, 0, 0, 0, 0, 0.12 / bh, 0.12 / bh, 0.12 / bh, 0);
      !dn ? (
        gfx_set(1, 1, 1, 0.10); gfx_rect(kx + 2 * sc, y + bh - 9 * sc, bw - 4 * sc, 7 * sc, 1);
        gfx_set(1, 1, 1, 0.06); gfx_rect(kx + 2 * sc, y + 3 * sc, max(1, sc), bh - 14 * sc, 1);
      );
    ) : wi += 1;
    n += 1;
  );
);

function cheek(x, y, w, h)
(
  gfx_gradrect(x, y, w, h, 0.09, 0.09, 0.095, 1, 0.0006, 0.0006, 0.0006, 0, 0, 0, 0, 0);
  gfx_set(1, 1, 1, 0.06);
  gfx_rect(x + 2 * uscale, y, max(1, uscale), h, 1);
);

u_down = mouse_cap & 1;
u_click = u_down && !u_pstate;
u_wheel = mouse_wheel;
mouse_wheel = 0;
u_hov = 0;
u_kbinit == 0 ? ( u_kbinit = 1; u_kbnote = -1; );

// ---------------------------------------------------------------------- case
utype = max(0, min(3, floor(p_type + 0.5)));
gfx_set(0.05, 0.05, 0.055, 1);
gfx_rect(0, 0, gfx_w, gfx_h, 1);
utype == 1 ? (ucr = 0.290; ucg = 0.200; ucb = 0.215;) :
utype == 2 ? (ucr = 0.190; ucg = 0.255; ucb = 0.205;) :
utype == 3 ? (ucr = 0.170; ucg = 0.215; ucb = 0.300;) :
(ucr = 0.105; ucg = 0.105; ucb = 0.110;);
gfx_gradrect(px(0), py(0), UDW * uscale, 448 * uscale, ucr, ucg, ucb, 1, 0, 0, 0, 0, -0.00012 / uscale, -0.00012 / uscale, -0.00012 / uscale, 0);
utype == 1 ? (
  gfx_set(0.235, 0.160, 0.175, 1);
  gfx_rect(px(0), py(0), UDW * uscale, 62 * uscale, 1);
  gfx_set(0.78, 0.79, 0.82, 0.13);
  ugi = -62;
  while (ugi < UDW) (
    gfx_line(px(max(0, ugi)), py(max(0, -ugi)), px(min(UDW, ugi + 62)), py(min(62, UDW - ugi)), 1);
    gfx_line(px(max(0, ugi)), py(62 - max(0, -ugi)), px(min(UDW, ugi + 62)), py(62 - min(62, UDW - ugi)), 1);
    ugi += 4;
  );
);
gfx_set(0.55, 0.56, 0.58, 1);
gfx_rect(px(0), py(62), UDW * uscale, max(1, 2 * uscale), 1);
gfx_set(0.85, 0.86, 0.88, 1);
gfx_rect(px(0), py(62), UDW * uscale, max(1, uscale), 1);

// ---------------------------------------------------------------------- header
gfx_set(0.95, 0.91, 0.82, 1);
gfx_setfont(2, "Arial", 34 * uscale, 'b');
gfx_x = px(28); gfx_y = py(12);
gfx_drawstr("Fork Lift");
gfx_measurestr("Fork Lift", utw, uth);
gfx_setfont(1, "Arial", 15 * uscale, 'b');
ubx = px(28) + utw + 14 * uscale;
gfx_set(0.95, 0.62, 0.22, 1);
gfx_x = ubx; gfx_y = py(26);
gfx_drawstr("ELECTRIC PIANO");
gfx_setfont(1, "Arial", 12 * uscale);
gfx_set(0.62, 0.60, 0.56, 1);
gfx_measurestr("by chmaha  ·  based on Frodhes by Leonardo Mirabal", utw, uth);
gfx_x = px(UDW - 28) - utw; gfx_y = py(28);
gfx_drawstr("by chmaha  ·  based on Frodhes by Leonardo Mirabal");

// ---------------------------------------------------------------------- instrument row
group_label("TYPE", px(30), py(76));
seg_frame(px(30), py(94), 380 * uscale, 30 * uscale);
seg_btn(1, 0, px(30), py(94), 95 * uscale, 30 * uscale, "STAGE");
seg_btn(1, 1, px(125), py(94), 95 * uscale, 30 * uscale, "SUITCASE");
seg_btn(1, 2, px(220), py(94), 95 * uscale, 30 * uscale, "EARLY FELT");
seg_btn(1, 3, px(315), py(94), 95 * uscale, 30 * uscale, "BELL DYNO");
group_label("KEYS", px(30), py(138));
seg_frame(px(30), py(156), 104 * uscale, 28 * uscale);
seg_btn(15, 0, px(30), py(156), 52 * uscale, 28 * uscale, "73");
seg_btn(15, 1, px(82), py(156), 52 * uscale, 28 * uscale, "88");
pedal_widget(px(190), py(150), 72 * uscale, 22 * uscale);
knob_at(16, px(488), py(128), 32 * uscale, 15);

group_label("VIBRATO", px(586), py(76));
seg_frame(px(586), py(94), 186 * uscale, 30 * uscale);
seg_btn(11, 0, px(586), py(94), 62 * uscale, 30 * uscale, "OFF");
seg_btn(11, 1, px(648), py(94), 62 * uscale, 30 * uscale, "PAN");
seg_btn(11, 2, px(710), py(94), 62 * uscale, 30 * uscale, "TREM");
knob_at(12, px(616), py(162), 20 * uscale, 13);
knob_at(13, px(700), py(162), 20 * uscale, 13);
knob_at(14, px(784), py(162), 20 * uscale, 13);

gfx_set(0.30, 0.30, 0.32, 1);
gfx_rect(px(30), py(232), (UDW - 60) * uscale, max(1, uscale), 1);
group_label("VOICING", px(30), py(238));

// ---------------------------------------------------------------------- voicing row
ui = 0;
loop(9,
  knob_at(2 + ui, px(84 + ui * 104), py(286), 23 * uscale, 13);
  ui += 1;
);

!tables_ok ? (
  gfx_set(0.10, 0.13, 0.20, 0.92);
  gfx_rect(px(200), py(140), 600 * uscale, 50 * uscale, 1);
  gfx_set(1, 0.8, 0.5, 1);
  ctext("Missing or unreadable Dependencies/ForkLift/forklift_tables.txt", px(500), py(156), 14, 'b');
);

// ---------------------------------------------------------------------- keyboard
ukby = py(370); ukbh = 74 * uscale;
ukbx = px(36); ukbw = 928 * uscale;
ukext = p_ext >= 0.5;
unwk = ukext ? 52 : 43;
uklo = ukext ? 21 : 28;
ukcnt = ukext ? 88 : 73;
uwkw = ukbw / unwk;
cheek(px(8), py(356), 28 * uscale, 92 * uscale);
cheek(px(964), py(356), 28 * uscale, 92 * uscale);
ukhit = -1;
un = uklo;
uwi = 0;
loop(ukcnt,
  upc = un % 12;
  (upc == 1 || upc == 3 || upc == 6 || upc == 8 || upc == 10) ? (
    ukpx = ukbx + uwi * uwkw - uwkw * 0.29;
    hit_rect(mouse_x, mouse_y, ukpx, ukby, uwkw * 0.58, ukbh * 0.62) ? ( ukhit = un; ukhy = (mouse_y - ukby) / (ukbh * 0.62); );
  ) : uwi += 1;
  un += 1;
);
un = uklo;
uwi = 0;
loop(ukcnt,
  upc = un % 12;
  !(upc == 1 || upc == 3 || upc == 6 || upc == 8 || upc == 10) ? (
    ukpx = ukbx + uwi * uwkw;
    (ukhit < 0 && hit_rect(mouse_x, mouse_y, ukpx, ukby, uwkw, ukbh)) ? ( ukhit = un; ukhy = (mouse_y - ukby) / ukbh; );
    uwi += 1;
  );
  un += 1;
);
tine_kb(ukbx, ukby, ukbw, ukbh, uklo, unwk, u_kbnote, uscale);
ukhit >= 0 ? (
  u_hov = 17;
  u_click ? (
    send_ev(144, ukhit, floor(30 + 97 * min(1, max(0, ukhy))));
    u_kbnote = ukhit;
    u_click = 0;
  );
);
(u_kbnote >= 0 && !u_down) ? (
  send_ev(128, u_kbnote, 0);
  u_kbnote = -1;
);

// ---------------------------------------------------------------------- hint bar
gfx_set(0.20, 0.20, 0.21, 1);
gfx_rect(px(0), py(448), UDW * uscale, 36 * uscale, 1);
uhs = u_drag > 0 ? u_drag : u_hov;
gfx_setfont(1, "Arial", 13 * uscale);
gfx_set(0.80, 0.80, 0.82, 1);
strcpy(#uhint, hint_text(uhs));
gfx_measurestr(#uhint, uhtw, uhth);
uhtw > (UDW - 20) * uscale ? ( gfx_setfont(1, "Arial", 13 * uscale * (UDW - 20) * uscale / uhtw); gfx_measurestr(#uhint, uhtw, uhth); );
gfx_x = uox + (UDW * uscale - uhtw) * 0.5; gfx_y = py(448) + (36 * uscale - uhth) * 0.5;
gfx_drawstr(#uhint);

u_drag > 0 ? (
  u_down ? (
    mouse_cap |= 65536;
    ufine = mouse_cap & 4;
    ufine != u_dfine ? ( u_dy0 = mouse_y; u_dv0 = norm_of(u_drag); u_dfine = ufine; );
    set_norm(u_drag, u_dv0 + (u_dy0 - mouse_y) / (150 * uscale) * (ufine ? 0.1 : 1));
  ) : ( automate(u_drag, 1); u_drag = 0; );
);

u_pstate = u_down;
