Version: 1.1
desc: Fork Lift Electric Piano (Frodhes port) by chmaha
tags: instrument electric-piano tine physical-modeling
author: chmaha
changelog:
  Striking a key that is still ringing now uses the current Type, Tone, Bark, Bell, Decay, Release, Spread and Tune settings.
  Decay and Release now glide on notes that are already sounding.
about:
  A physically modelled tine electric piano in the style of a 1970s 73-key stage piano. Each key is a
  tine and tone bar ringing as resonant modes, struck by a hammer whose force pulse comes from a contact
  simulation, read by a magnetic pickup through its flux curve (the bark comes from the tine swinging past
  the pole). Four voicings (Stage, Suitcase, Early Felt, Bell Dyno), the stereo pan / tremolo, the
  sustain pedal (CC64) with half-pedalling and release velocity. Unlike Frodhes, the tines swing further
  and sit further off their pickups (voiced against a sampled tine piano) for a fuller, barkier tone. Every key has its own tine: no voice limit.
  Notes outside E1-E7 are silent unless the range is set to 88 keys (A0-C8).
  Needs Dependencies/ForkLift/forklift_tables.txt.
  Ported from Frodhes by Leonardo Mirabal
  https://github.com/leonardoMirabal/frodhes (GPL-3.0-only)
  JSFX version released under GPL-3.0 license
  Claude generated some of this code
provides:
  Dependencies/ForkLift/forklift_tables.txt

slider1:p_type=0<0,3,1{Stage,Suitcase,Early Felt,Bell Dyno}>-Type
slider2:p_tone=64<0,127,1>-Tone
slider3:p_bark=64<0,127,1>-Bark
slider4:p_bell=64<0,127,1>-Bell
slider5:p_ham=64<0,127,1>-Hammer
slider6:p_decay=64<0,127,1>-Decay
slider7:p_rel=64<0,127,1>-Release
slider8:p_noise=48<0,127,1>-Noise
slider9:p_spread=0<0,127,1>-Spread
slider10:p_tune=0<-50,50,1>-Tune (cents)
slider11:p_tw=0<0,2,1{Off,Pan,Tremolo}>-Vibrato
slider12:p_twd=64<0,127,1>-Vibrato Depth
slider13:p_twr=90<0,127,1>-Vibrato Rate
slider14:p_tws=0<0,127,1>-Vibrato Shape
slider15:p_ext=0<0,1,1{73 keys (E1-E7),88 keys (A0-C8)}>-Keyboard Range
slider16:p_lvl=0<-12,12,0.1>-Volume (dB)

in_pin:none
out_pin:Left
out_pin:Right
options:no_meter

@init

ext_noinit = gfx_ext_retina = 1;
ext_nodenorm = 1;

function alloc(n) local(r) instance(mp) global() ( r = mp; mp += n; memset(r, 0, n); r; );
alloc.mp = 0;

TWO32 = 4294967296;
TWO30 = 1073741824;
NV = 96;
VS = 160;
MODE0 = 40;
MS = 16;
SUBMAX = 128;

TRAW = alloc(70000);
GR_K = alloc(6); GR_M = alloc(6);
GR_K[0] = 5.5; GR_K[1] = 5; GR_K[2] = 4; GR_K[3] = 2; GR_K[4] = 1; GR_K[5] = 0;
GR_M[0] = 2.4; GR_M[1] = 2.4; GR_M[2] = 2.4; GR_M[3] = 2.4; GR_M[4] = 2.7; GR_M[5] = 3;
VREC = alloc(NV * VS);
PBUF = alloc(NV * 72);
RHX = alloc(SUBMAX);
FRC = alloc(SUBMAX);
MIXB = alloc(SUBMAX);
SIDEB = alloc(SUBMAX);
TXB = alloc(SUBMAX);
TXS = alloc(SUBMAX);
OUTL = alloc(SUBMAX);
OUTR = alloc(SUBMAX);
EVQ = alloc(4 * 1024);
UIQ = alloc(3 * 64);
KEYF = alloc(88 * 40);
CH_M = alloc(15);
CH_S = alloc(15);
TX_M = alloc(15);
TX_S = alloc(15);
CF = alloc(4 * 15);
CFN = alloc(4);
KEYL = alloc(128);
RSTEP = alloc(17);
mem_set_values(RSTEP, 0, 0, 16384, 10923, 8192, 6554, 5461, 4681, 4096, 3641, 3277, 2979, 2731, 2521, 2341, 2185, 2048);
HC = alloc(2 * 2048 * 4);
KNON = alloc(4);
mem_set_values(KNON, 0, 1, 1, 1);

// ---------------------------------------------------------------------- tables

function tables_load() local(h, n, p) (
  h = file_open("ForkLift/forklift_tables.txt");
  h < 0 ? h = file_open("Dependencies/ForkLift/forklift_tables.txt");
  tables_ok = 0;
  h >= 0 ? (
    n = file_mem(h, TRAW, 70000);
    file_close(h);
    p = TRAW;
    p[0] === 20261103 ? (
      KEY_LO = p[1]; NKEY = p[2]; NM = p[3]; NLAYER = p[4]; PLEN = p[5]; PU_N = p[6]; NANCH = p[7]; TG_N = p[8];
      p += 9;
      T_KEYS = p; p += NKEY * 40;
      T_PULSE = p; p += NKEY * NLAYER * (PLEN + 2);
      T_PRATEB = p; p += NKEY;
      T_PRATE = p; p += NKEY * NANCH;
      T_PAMP = p; p += NKEY * NANCH;
      T_VPOSI = p; p += 128;
      T_VPOSF = p; p += 128;
      T_VLAYI = p; p += 128;
      T_VLAYW = p; p += 128;
      T_PHIM = p; p += 4 * (PU_N + 1);
      T_TONEA = p; p += 16 * TG_N;
      TG_SH = p[0]; TG_O_LO = p[1]; TONE_UP = p[2]; OFF_MAX = p[3]; p += 4;
      T_TYPE = p; p += 24;
      T_TYPEFG = p; p += 8;
      T_RLC = p; p += 20;
      T_BODY = p; p += 40;
      T_PEDW = p; p += 128;
      T_DECK = p; p += 128;
      T_P64 = p; p += 128;
      T_P64I = p; p += 128;
      T_P32 = p; p += 128;
      T_HAM = p; p += 128;
      T_THUMP = p; p += 128;
      T_FELT = p; p += 128;
      T_KNOCK = p; p += 128;
      T_PEDN = p; p += 128;
      T_TUNE = p; p += 101;
      T_KAP = p; p += 27;
      T_SINE = p; p += 1025;
      T_LFOINC = p; p += 128;
      T_TRLT = p; p += 128;
      T_TRMK = p; p += 128;
      T_EXP2F = p; p += 256;
      tables_ok = p[0] === -999999 && (p + 1 - TRAW) === n;
    );
  );
);
tables_load();

function itrunc(x) ( x < 0 ? -floor(-x) : floor(x); );

// ---------------------------------------------------------------------- rate

function rbj(dst, kind, f0, q, gdb) local(A, w0, c, al, sq, K, nrm, b0, b1, b2, a0, a1, a2) (
  A = 10 ^ (gdb / 40);
  w0 = 2 * $pi * f0 / srate;
  c = cos(w0); al = sin(w0) / (2 * q);
  kind == 0 ? (
    K = tan($pi * f0 / srate);
    nrm = 1 / (1 + K / q + K * K);
    b0 = K * K * nrm;
    dst[0] = b0; dst[1] = 2 * b0; dst[2] = b0; dst[3] = 2 * (K * K - 1) * nrm; dst[4] = (1 - K / q + K * K) * nrm;
  ) : (
    kind == 1 ? (
      b0 = 1 + al * A; b1 = -2 * c; b2 = 1 - al * A; a0 = 1 + al / A; a1 = -2 * c; a2 = 1 - al / A;
    ) : kind == 2 ? (
      sq = 2 * sqrt(A) * al;
      b0 = A * ((A + 1) - (A - 1) * c + sq); b1 = 2 * A * ((A - 1) - (A + 1) * c); b2 = A * ((A + 1) - (A - 1) * c - sq);
      a0 = (A + 1) + (A - 1) * c + sq; a1 = -2 * ((A - 1) + (A + 1) * c); a2 = (A + 1) + (A - 1) * c - sq;
    ) : (
      sq = 2 * sqrt(A) * al;
      b0 = A * ((A + 1) + (A - 1) * c + sq); b1 = -2 * A * ((A - 1) + (A + 1) * c); b2 = A * ((A + 1) + (A - 1) * c - sq);
      a0 = (A + 1) - (A - 1) * c + sq; a1 = 2 * ((A - 1) - (A + 1) * c); a2 = (A + 1) - (A - 1) * c - sq;
    );
    dst[0] = b0 / a0; dst[1] = b1 / a0; dst[2] = b2 / a0; dst[3] = a1 / a0; dst[4] = a2 / a0;
  );
);

function rate_setup() local(t, i, j) (
  RR = 44100 / srate;
  native = abs(srate - 44100) < 0.5;
  SUBN = min(SUBMAX, max(8, floor(32 / RR + 0.5)));
  native ? SUBN = 32;
  native ? (
    t = 0;
    loop(4,
      i = 0; loop(5, CF[t * 15 + i] = T_RLC[t * 5 + i] / 268435456; i += 1;);
      j = 0; loop(2, i = 0; loop(5, CF[t * 15 + 5 + j * 5 + i] = T_BODY[t * 10 + j * 5 + i] / 268435456; i += 1;); j += 1;);
      t += 1;
    );
  ) : (
    rbj(CF + 0, 0, 5000, 1, 0);
    rbj(CF + 15, 0, 4500, 1.3, 0); rbj(CF + 20, 1, 250, 0.7, 3.5); rbj(CF + 25, 3, 5500, 0.7, -5);
    rbj(CF + 30, 0, 3200, 0.8, 0); rbj(CF + 35, 1, 300, 0.8, 1.5);
    rbj(CF + 45, 0, 7000, 1.3, 0); rbj(CF + 50, 2, 150, 0.7, -2); rbj(CF + 55, 3, 3500, 0.7, 6);
  );
  t = 0; loop(4, CFN[t] = T_TYPE[t * 6 + 5]; t += 1;);
  fade_step = 512 * RR;
  felt_len = floor(353 / RR + 0.5);
  felt_a = native ? 0.125 : 1 - (0.875 ^ RR);
  pn_len = floor(440 / RR + 0.5);
  pn_a = native ? 0.125 : 1 - (0.875 ^ RR);
  tw_incs = RR;
  pk_gain = 1 / RR;
);

// ---------------------------------------------------------------------- per-key data

function keys_setup() local(k, m, src, dst) (
  k = 0;
  loop(NKEY,
    src = T_KEYS + k * 40; dst = KEYF + k * 40;
    m = 0;
    loop(5,
      dst[m * 7] = src[m * 7] / TWO30;
      dst[m * 7 + 1] = src[m * 7 + 1] / TWO30;
      dst[m * 7 + 2] = src[m * 7 + 2] / TWO30;
      dst[m * 7 + 3] = src[m * 7 + 3] / TWO30;
      dst[m * 7 + 4] = src[m * 7 + 4] / TWO30;
      dst[m * 7 + 5] = src[m * 7 + 5];
      dst[m * 7 + 6] = src[m * 7 + 6];
      m += 1;
    );
    dst[35] = src[35]; dst[36] = src[36]; dst[37] = src[37] / 33554432; dst[38] = src[38]; dst[39] = src[39];
    k += 1;
  );
);

// ---------------------------------------------------------------------- coefficients

function coef(kf, m, dsel, t, kk) local(sh, ch, th, d, cr, dpi, dl, dl2, cdl, sdl, sp, crr, q, om, kd, r2, r, thx) (
  sh = kf[m * 7]; ch = kf[m * 7 + 1]; th = kf[m * 7 + 2]; d = kf[m * 7 + 3 + dsel]; cr = kf[m * 7 + 5];
  native ? (
    dpi = kk * d - (kk * (kk - 1) * 0.5) * d * d + ((kk * (kk - 1) * (kk - 2)) / 6) * d * d * d;
    dpi < 1 / TWO30 ? dpi = 1 / TWO30;
    dl = th * t; dl2 = dl * dl;
    cdl = 1 - dl2 * 0.5 + (dl2 * dl2) / 24;
    sdl = dl - (dl2 * dl) / 6 + (dl2 * dl2 * dl) / 120;
    sp = sh * cdl + ch * sdl;
    crr = cr * (1 - 2 * t + 3 * t * t);
    q = 1 - dpi * 0.25 - (3 * dpi * dpi) / 32;
    om = dpi * 0.5 + (dpi * dpi) / 8 + (dpi * dpi * dpi) / 16;
    c_e = 2 * q * sp * (1 + (om * om * crr) / 65536);
    c_eps = dpi;
  ) : (
    kd = kk * RR;
    r2 = (1 - d) ^ kd;
    c_eps = 1 - r2;
    r = sqrt(r2);
    thx = 2 * th * (1 + t) * RR;
    c_e = sqrt(max(0, 1 + r2 - 2 * r * cos(thx)));
  );
);

// ---------------------------------------------------------------------- voices

function hc_setup() local(f, i, q, d, p0, m0, p1, m1) (
  f = 0;
  loop(2,
    q = T_PHIM + f * 2 * (PU_N + 1) + 2 * (f ? 132 : 84);
    q[0] === -3145728 ? q[0] = floor((4 * (q[-2] + q[2]) - q[-4] - q[4]) / 6 + 0.5);
    q = T_PHIM + f * 2 * (PU_N + 1) + 2;
    loop(PU_N - 1,
      q[1] === -3145728 ? q[1] = floor((q[2] - q[-2]) / 2 + 0.5);
      q += 2;
    );
    f += 1;
  );
  f = 0;
  loop(2,
    i = 0;
    loop(2048,
      q = T_PHIM + f * 2 * (PU_N + 1) + 2 * i;
      p0 = q[0]; m0 = q[1]; p1 = q[2]; m1 = q[3];
      d = HC + (f * 2048 + i) * 4;
      d[0] = p0 / 268435456; d[1] = m0 / 268435456;
      d[2] = (3 * (p1 - p0) - 2 * m0 - m1) / 268435456;
      d[3] = (2 * (p0 - p1) + m0 + m1) / 268435456;
      i += 1;
    );
    f += 1;
  );
  HC_T = 1 - 1 / 4194304;
);

function hermite(fam, s) local(i, t, q) (
  s *= 64;
  s >= 2048 ? (i = 2047; t = HC_T;) : (i = s | 0; t = s - i;);
  q = HC + (fam * 2048 + i) * 4;
  q[0] + t * (q[1] + t * (q[2] + t * q[3]));
);

function mode_runs(key, m) local(kf) (
  kf = T_KEYS + key * 40;
  (m === 1 && key + KEY_LO >= 29 && key + KEY_LO <= 39) ? 0 : kf[m * 7 + 2] !== 0;
);

function load_pulse(v, vel) local(key, i, f, pa, pr, l, w, p1, p2, j, h) (
  key = v[26];
  i = T_VPOSI[vel]; f = T_VPOSF[vel];
  pa = T_PAMP + key * NANCH; pr = T_PRATE + key * NANCH;
  l = T_VLAYI[vel]; w = T_VLAYW[vel];
  p1 = T_PULSE + (key * NLAYER + l) * (PLEN + 2);
  w ? (
    p2 = T_PULSE + (key * NLAYER + min(l + 1, NLAYER - 1)) * (PLEN + 2);
    j = 0;
    loop(PLEN + 2, PBUF[v[29] + j] = p1[j] + floor(((p2[j] - p1[j]) * w) / 32768); j += 1;);
    v[17] = PBUF + v[29];
  ) : v[17] = p1;
  v[16] = pa[i] + floor(((pa[i + 1] - pa[i]) * f) / 256);
  v[15] = (T_PRATEB[key] + pr[i] + floor(((pr[i + 1] - pr[i]) * f) / 256)) * 16;
  h = floor((rh_ham * T_TYPE[rh_type * 6 + 4]) / 65536);
  v[15] = floor((v[15] * h) / 65536);
  v[16] = min(32767, floor((v[16] * h) / 65536));
  v[14] = 0;
  v[30] = 1;
);

function tone_a(fam, ty, hard, o) local(A, u, i, f) (
  A = T_TONEA + ((fam * 4 + ty) * 2 + hard) * TG_N;
  o < TG_O_LO ? o = TG_O_LO;
  u = o - TG_O_LO;
  i = floor(u / (2 ^ TG_SH)); f = floor(u / (2 ^ (TG_SH - 15))) & 32767;
  i >= TG_N - 1 ? A[TG_N - 1] : A[i] + floor(((A[i + 1] - A[i]) * f) / 32768);
);

function tone_gain(gain, o64, o, vel, fam) local(w, s, h, a64, a, g) (
  w = vel <= 40 ? 0 : vel >= 127 ? 87 : floor(((vel - 40) * (vel - 40)) / 87);
  s = tone_a(fam, rh_type, 0, o64); h = tone_a(fam, rh_type, 1, o64); a64 = s + itrunc(((h - s) * w) / 87);
  s = tone_a(fam, rh_type, 0, o); h = tone_a(fam, rh_type, 1, o); a = s + itrunc(((h - s) * w) / 87);
  a < 1 ? a = 1;
  g = floor((a64 * 16384) / a);
  floor((gain * g) / 16384);
);

function settle(note) local(d) (
  note < 48 ? (d = floor((50 - note) / 4); 7 + min(3, d)) : note < 72 ? 7 : note < 84 ? 6 : 5;
);

function v_voice(v, note, vel) local(key, kf, kr, m, s, b, t, sh, mx, o64, g, ig, p, o, om, u, i, k, sa, sb, c) (
  key = v[26];
  kf = KEYF + key * 40; kr = T_KEYS + key * 40;
  t = rh_tune;
  v[35] = t;
  v[24] = rh_k_decay; v[25] = rh_k_rel;
  m = 0;
  loop(5,
    s = v + MODE0 + m * MS;
    mode_runs(key, m) ? (
      coef(kf, m, 0, t, rh_k_decay); s[4] = c_e; s[5] = c_eps;
      coef(kf, m, 1, t, rh_k_rel); s[6] = c_e; s[7] = c_eps;
      b = floor((floor((kr[m * 7 + 6] * rh_bark_s) / 65536) * T_TYPE[rh_type * 6 + 1]) / 65536);
      (m === 2 || m === 3) ? b = floor((floor((b * T_TYPE[rh_type * 6 + 3]) / 65536) * rh_bell) / 65536);
      s[10] = b / TWO30;
    );
    m += 1;
  );
  p = rh_spread ? itrunc(((2 * note - 129) * rh_spread * 256) / (87 * 127)) : 0;
  v[21] = max(-256, min(256, p));
  sh = kr[39] === 0 ? 1 : 0;
  mx = floor(OFF_MAX / (2 ^ sh));
  v[12] = kr[35] + floor((T_TYPE[rh_type * 6] + rh_tone_off) / (2 ^ sh));
  v[12] > mx ? v[12] = mx;
  g = floor((kr[36] * rh_bark_g) / 65536);
  g = floor((g * T_TYPE[rh_type * 6 + 2]) / 65536);
  g = floor((g * T_TYPEFG[rh_type * 2 + kr[39]]) / 65536);
  rh_tone_off > 0 ? (
    o64 = kr[35] + floor(T_TYPE[rh_type * 6] / (2 ^ sh));
    g = tone_gain(g, min(o64, mx), v[12], vel, kr[39]);
  );
  v[13] = g / 65536 * pk_gain;
  v[27] = kr[39];
  o = v[12] / 33554432;
  u = max(0, min(5, (note - 28) / 12)); i = min(4, floor(u)); u -= i;
  k = GR_K[i] + (GR_K[i + 1] - GR_K[i]) * u;
  k = 2 ^ (k + 1.6 * min(1, k * 0.5) * log(100 / max(40, vel)) / log(2));
  om = o + (GR_M[i] + (GR_M[i + 1] - GR_M[i]) * u - 1) * min(0, kr[35] + floor(T_TYPE[rh_type * 6] / (2 ^ sh))) / 33554432;
  sa = (hermite(v[27], sqr(o + 0.001)) - hermite(v[27], sqr(o - 0.001)));
  sb = (hermite(v[27], sqr(om + 0.001)) - hermite(v[27], sqr(om - 0.001)));
  c = abs(sb) > 0.000001 ? max(0.25, min(2.5, sa / sb)) : 1;
  v[28] = k; v[31] = om / k; v[32] = v[13] * c / k;
  vv_om = om;
  key + KEY_LO < 48 ? (
    g = floor((rh_bark_s * T_TYPE[rh_type * 6 + 1]) / 65536);
    g < 4096 ? g = 4096;
    ig = floor(2147483648 / g);
    s = v + MODE0;
    s[12] = floor((T_KAP[key] * ig * ig) / TWO30) * (sh ? 4 : 1) / 65536;
  );
  v[33] = rh_gen; v[34] = vel;
);

function v_glide(v, len) local(m, s) (
  m = 0; loop(5, s = v + MODE0 + m * MS; s[8] = s[2]; s[9] = s[3]; m += 1;);
  v[4] = len; v[5] = len;
);

function v_restrike(v) local(m, s, x, off, xk, g) (
  x = 0;
  m = 0; loop(5, s = v + MODE0 + m * MS; s[13] ? x += s[0]; m += 1;);
  off = v[31]; xk = v[28]; g = v[32];
  v_voice(v, v[1], v[34]);
  (v[31] !== off || v[28] !== xk) ? v[11] = hermite(v[27], sqr(x + v[31]) * sqr(v[28]));
  v[32] !== g ? (v[37] = v[32]; v[32] = g; v[36] = 8;);
  v_glide(v, settle(v[1]));
);

function live_decay() local(i, v, kf, m, s) (
  i = 0;
  loop(NV,
    v = VREC + i * VS;
    v[0] ? (
      kf = KEYF + v[26] * 40;
      v[24] = rh_k_decay; v[25] = rh_k_rel;
      m = 0;
      loop(5,
        s = v + MODE0 + m * MS;
        mode_runs(v[26], m) ? (
          coef(kf, m, 0, v[35], rh_k_decay); s[4] = c_e; s[5] = c_eps;
          coef(kf, m, 1, v[35], rh_k_rel); s[6] = c_e; s[7] = c_eps;
        );
        m += 1;
      );
      v_glide(v, 16);
    );
    i += 1;
  );
);

function v_init(v, note, vel) local(key, m, s) (
  key = max(0, min(NKEY - 1, note - KEY_LO));
  v[26] = key;
  m = 0;
  loop(5,
    s = v + MODE0 + m * MS;
    s[0] = s[1] = 0; s[11] = 0; s[12] = 0;
    s[13] = mode_runs(key, m);
    m += 1;
  );
  v[1] = note; v[2] = vel; v[22] = v[23] = 0;
  v_voice(v, note, vel);
  m = 0;
  loop(5,
    s = v + MODE0 + m * MS;
    s[13] ? (s[2] = s[8] = s[4]; s[3] = s[9] = s[5];) : (s[2] = s[3] = 0;);
    m += 1;
  );
  v[11] = hermite(v[27], vv_om * vv_om);
  v[0] = 1; v[3] = 1; v[4] = 0; v[7] = 0;
  v[8] = 32768; v[18] = 0; v[19] = 0; v[36] = 0;
  rh_ages += 1; v[9] = rh_ages;
  v[10] = T_KEYS[key * 40 + 38] * 8;
  load_pulse(v, vel);
);

function set_voicing() local(v) (
  v = p_tone | 0; v = max(0, min(127, v));
  rh_tone_off = v <= 64 ? (v - 64) * 262144 : (v - 64) * TONE_UP;
  v = max(0, min(127, p_bark | 0)); rh_bark_s = T_P64[v]; rh_bark_g = T_P64I[v];
  rh_bell = T_P32[max(0, min(127, p_bell | 0))];
