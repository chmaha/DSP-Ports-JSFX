UW0 = 900; UH0 = 524;
gz = max(0.3, min(gfx_w / UW0, gfx_h / UH0));
gox = floor((gfx_w - UW0 * gz) * 0.5);
goy = 0;

function ux(x) ( gox + x * gz; );
function uy(y) ( goy + y * gz; );
function u01(x) ( max(0, min(1, x)); );
function u_in(x, y, w, h) ( mouse_x >= ux(x) && mouse_x < ux(x + w) && mouse_y >= uy(y) && mouse_y < uy(y + h); );
function c_ink(a) ( gfx_set(0.93, 0.95, 0.97, a); );
function c_soft(a) ( gfx_set(0.62, 0.68, 0.76, a); );
function c_gown(a) ( gfx_set(0.31, 0.70, 0.67, a); );
function c_glow(a) ( gfx_set(0.37, 0.83, 0.79, a); );
function c_trim(a) ( gfx_set(0.73, 0.88, 0.86, a); );
function c_star(a) ( gfx_set(0.99, 0.90, 0.48, a); );
function c_line(a) ( gfx_set(0.22, 0.27, 0.38, a); );

function u_set(s, x) ( slider(s) = x; u_automate(s, 0); u_automate(s, 1); );

function u_gq(a, b, c)
(
  GQ[g_qw * 4] = a; GQ[g_qw * 4 + 1] = b; GQ[g_qw * 4 + 2] = c; GQ[g_qw * 4 + 3] = g_sel;
  g_qw = (g_qw + 1) % 64;
);

function u_text(str, x, y, sz, face, flags)
(
  gfx_setfont(1, face, (sz + 2) * gz, flags);
  gfx_x = ux(x); gfx_y = uy(y); gfx_drawstr(str);
);

function u_rtext(str, x, y, sz, face, flags) local(tw, th)
(
  gfx_setfont(1, face, (sz + 2) * gz, flags);
  gfx_measurestr(str, tw, th);
  gfx_x = ux(x) - tw; gfx_y = uy(y); gfx_drawstr(str);
);

function u_ctext(str, cx, y, sz, face, flags) local(tw, th)
(
  gfx_setfont(1, face, (sz + 2) * gz, flags);
  gfx_measurestr(str, tw, th);
  gfx_x = floor(ux(cx) - tw * 0.5); gfx_y = uy(y); gfx_drawstr(str);
);

function u_fit(str, w, dst) local(tw, th, n)
(
  strcpy(dst, str);
  gfx_measurestr(dst, tw, th);
  n = strlen(dst);
  while (tw > w * gz && n > 1) (
    n -= 1; strcpy_substr(dst, str, 0, n); strcat(dst, "...");
    gfx_measurestr(dst, tw, th);
  );
  dst;
);

function u_spaced(str, cx, y, sz, face, sp) local(n, i, tw, th, w)
(
  gfx_setfont(1, face, (sz + 2) * gz);
  n = strlen(str); w = 0; i = 0;
  loop(n, strcpy_substr(#u_ch1, str, i, 1); gfx_measurestr(#u_ch1, tw, th); w += tw + sp * gz; i += 1; );
  gfx_x = floor(ux(cx) - (w - sp * gz) * 0.5); gfx_y = uy(y);
  i = 0;
  loop(n, strcpy_substr(#u_ch1, str, i, 1); gfx_drawstr(#u_ch1); gfx_x += sp * gz; i += 1; );
  w / gz;
);

function u_dbl(id) local(r)
(
  r = time_precise() - g_dct < 0.35 && g_dcid == id;
  g_dct = r ? 0 : time_precise(); g_dcid = id;
  r;
);

function u_rspan(qx0, qy0, qx1, qy1, qrad, yc) local(dy, ins)
(
  dy = yc < qy0 + qrad ? qy0 + qrad - yc : yc > qy1 - qrad ? yc - (qy1 - qrad) : 0;
  U_RC = max(0, min(1, qrad - dy + 0.5));
  dy = min(qrad, dy);
  ins = qrad - sqrt(max(0, qrad * qrad - dy * dy));
  U_RL = qx0 + ins; U_RR = qx1 - ins;
);

function u_span(lx, rx, j, a) local(lc, rc)
(
  lc = ceil(lx); rc = floor(rx);
  rc >= lc ? (
    gfx_a = a; rc > lc ? gfx_rect(lc, j, rc - lc, 1);
    lc - lx > 0 ? ( gfx_a = a * (lc - lx); gfx_rect(lc - 1, j, 1, 1); );
    rx - rc > 0 ? ( gfx_a = a * (rx - rc); gfx_rect(rc, j, 1, 1); );
  ) : rx > lx ? ( gfx_a = a * (rx - lx); gfx_rect(floor(lx), j, 1, 1); );
);

function u_frr(qx0, qy0, qx1, qy1, qrad, cr, cg, cb, a0) local(j)
(
  qx0 = floor(qx0 + 0.5); qy0 = floor(qy0 + 0.5); qx1 = floor(qx1 + 0.5); qy1 = floor(qy1 + 0.5);
  qrad = max(0, min(qrad, min(qy1 - qy0, qx1 - qx0) * 0.5));
  gfx_set(cr, cg, cb, a0);
  j = qy0;
  loop(qy1 - qy0,
    u_rspan(qx0, qy0, qx1, qy1, qrad, j + 0.5);
    U_RC > 0 ? u_span(U_RL, U_RR, j, a0 * U_RC);
    j += 1;
  );
  gfx_a = 1;
);

function u_bord(qx0, qy0, qx1, qy1, qrad, t, cr, cg, cb, a0) local(j, ol, orr, oc, il, ir, ic)
(
  qx0 = floor(qx0 + 0.5); qy0 = floor(qy0 + 0.5); qx1 = floor(qx1 + 0.5); qy1 = floor(qy1 + 0.5);
  qrad = max(0, min(qrad, min(qy1 - qy0, qx1 - qx0) * 0.5));
  gfx_set(cr, cg, cb, a0);
  j = qy0;
  loop(qy1 - qy0,
    u_rspan(qx0, qy0, qx1, qy1, qrad, j + 0.5); ol = U_RL; orr = U_RR; oc = U_RC;
    (j + 0.5 > qy0 + t && j + 0.5 < qy1 - t) ? (
      u_rspan(qx0 + t, qy0 + t, qx1 - t, qy1 - t, max(0, qrad - t), j + 0.5); il = U_RL; ir = U_RR; ic = U_RC;
    ) : ( ic = 0; );
    oc > 0 ? (
      ic <= 0 ? u_span(ol, orr, j, a0 * oc) : (
        u_span(ol, il, j, a0 * oc);
        u_span(ir, orr, j, a0 * oc);
        oc - ic > 0.004 ? u_span(il, ir, j, a0 * (oc - ic));
      );
    );
    j += 1;
  );
  gfx_a = 1;
);

function u_ann(cx, cy, ri, ro, aa, ab, cr, cg, cb, al, grad) local(py, px, dy, dx, hwo, hwi, d, cv, th, ca, f, x0, x1, x2, x3, sp)
(
  sp = max(0.0001, ab - aa);
  py = floor(cy - ro - 1);
  loop(ceil(2 * ro + 3),
    dy = py + 0.5 - cy;
    hwo = sqrt(max(0, (ro + 0.5) * (ro + 0.5) - dy * dy));
    hwo > 0 ? (
      hwi = ri > 0.5 ? sqrt(max(0, (ri - 0.5) * (ri - 0.5) - dy * dy)) : 0;
      x0 = floor(cx - hwo); x1 = ceil(cx - hwi); x2 = floor(cx + hwi); x3 = ceil(cx + hwo);
      hwi <= 0 ? x1 = x3 + 1;
      px = x0;
      while (px <= x3) (
        dx = px + 0.5 - cx;
        d = sqrt(dx * dx + dy * dy);
        cv = min(1, min(ro - d + 0.5, d - ri + 0.5));
        cv > 0 ? (
          th = atan2(dx, -dy);
          ca = min(1, min((th - aa) * d + 0.5, (ab - th) * d + 0.5));
          ca > 0 ? (
            grad ? ( f = u01((th - aa) / sp); gfx_r = 0.25 + 0.48 * f; gfx_g = 0.66 + 0.22 * f; gfx_b = 0.62 + 0.24 * f; )
                 : ( gfx_r = cr; gfx_g = cg; gfx_b = cb; );
            gfx_a = al * cv * ca;
            gfx_rect(px, py, 1, 1);
          );
        );
        px += 1;
        (px > x1 && px < x2) ? px = x2;
      );
    );
    py += 1;
  );
  gfx_a = 1;
);

function u_knob(id, kx, ky, kr, v, nm, vs, bip) local(cx, cy, r, a0, a1, am, sa, px0, py0, hv, dv, act)
(
  cx = ux(kx); cy = uy(ky); r = kr * gz;
  hv = (mouse_x - cx) ^ 2 + (mouse_y - cy) ^ 2 < ((kr + 6) * gz) ^ 2;
  act = hv || g_drag == id;
  a0 = -$pi * 0.75; a1 = $pi * 0.75; am = bip ? 0 : a0;
  gfx_set(0, 0, 0, 0.45);
  gfx_circle(cx, cy, r + 3 * gz, 1, 1);
  gfx_set(0.10, 0.13, 0.20, 1);
  gfx_circle(cx, cy, r - 8 * gz, 1, 1);
  gfx_set(0.18, 0.22, 0.31, 1);
  gfx_circle(cx, cy, r - 11 * gz, 1, 1);
  gfx_set(0.09, 0.11, 0.17, 1);
  gfx_circle(cx, cy + 1.5 * gz, r - 13 * gz, 1, 1);
  u_ann(cx, cy, r - 1.5 * gz, r + 1.5 * gz, a0, a1, 0.80, 0.88, 0.95, 0.18, 0);
  sa = a0 + (a1 - a0) * u01(v);
  abs(sa - am) > 0.001 ? (
    u_ann(cx, cy, r - 4 * gz, r + 4 * gz, min(am, sa), max(am, sa), 0.37, 0.83, 0.79, act ? 0.30 : 0.18, 0);
    u_ann(cx, cy, r - 1.5 * gz, r + 1.5 * gz, min(am, sa), max(am, sa), 0, 0, 0, act ? 1 : 0.88, 1);
  );
  px0 = cx + sin(sa) * (r - 14 * gz);
  py0 = cy - cos(sa) * (r - 14 * gz);
  gfx_set(0.95, 0.97, 0.98, act ? 1 : 0.85);
  gfx_line(cx + sin(sa) * (r * 0.25), cy - cos(sa) * (r * 0.25), px0, py0, 1);
  gfx_circle(px0, py0, 2.6 * gz, 1, 1);
  c_ink(0.95); u_ctext(nm, kx, ky + kr + 8, 12, "Arial", 0);
  c_glow(0.97); u_ctext(vs, kx, ky + kr + 25, 11, "Arial", 0);
  dv = -1;
  (hv && g_click) ? ( g_click = 0; u_dbl(id) ? dv = -2 : ( g_drag = id; g_dy = mouse_y; g_dv = v; ); );
  (g_drag == id && g_down) ? ( mouse_cap |= 65536; dv = u01(g_dv + (g_dy - mouse_y) / (220 * gz)); );
  (hv && g_wheel != 0) ? ( dv = u01(v + (g_wheel > 0 ? 1 : -1) / 100); g_wheel = 0; );
  dv;
);

function u_tslider(id, x, y, w, val, label, valstr) local(hv, f, hx)
(
  hv = u_in(x - 6, y - 8, w + 12, 18);
  c_ink(1); u_text(label, x, y - 22, 12, "Arial", 0);
  c_soft(1); u_rtext(valstr, x + w, y - 20, 11, "Arial", 0);
  f = u01(val);
  c_line(1); gfx_rect(ux(x), uy(y), w * gz, max(1, gz), 1);
  c_gown(0.95); gfx_rect(ux(x), uy(y) - floor(gz * 0.5), w * f * gz, max(2, 2 * gz), 1);
  hx = ux(x + w * f);
  u_frr(hx - 3 * gz, uy(y - 7), hx + 3 * gz, uy(y + 8), 3 * gz, 0.78, 0.86, 0.88, hv || g_drag == id ? 1 : 0.85);
  (hv && g_click) ? ( g_click = 0; u_dbl(100 + id) ? g_dbl = 1 : g_drag = id; );
  (hv && g_wheel != 0) ? ( g_wf = u01(val + (g_wheel > 0 ? 1 : -1) / 100); g_wheel = 0; g_wset = 1; );
  g_wset ? ( g_wset = 0; g_wf; )
  : (g_dbl || (hv && (mouse_cap & 2) && !g_rprev)) ? ( g_dbl = 0; -2; )
  : (g_drag == id && g_down) ? u01((mouse_x - ux(x)) / (w * gz)) : -1;
);

function u_menu(x, y, w, label, val, big) local(hv, r)
(
  hv = u_in(x, y, w, big ? 28 : 22);
  c_soft(1); u_text(label, x, y - 17, 11, "Arial", 0);
  c_ink(1); u_text(u_fit(val, w - 18, #u_fitb), x, y + 2, big ? 18 : 14, "Georgia", 0);
  gfx_set(0.55, 0.62, 0.72, hv ? 1 : 0.6); gfx_rect(ux(x), uy(y + (big ? 27 : 21)), w * gz, max(1, gz), 1);
  hv ? c_glow(1) : c_soft(0.9);
  gfx_triangle(ux(x + w - 11), uy(y + (big ? 11 : 8)), ux(x + w - 3), uy(y + (big ? 11 : 8)), ux(x + w - 7), uy(y + (big ? 16 : 13)));
  r = hv && g_click;
  r ? ( g_click = 0; gfx_x = ux(x); gfx_y = uy(y + (big ? 28 : 22)); );
  r;
);

function u_toggle(x, y, w, h, lb, on) local(hv, qx, qy, qw, qh, r)
(
  hv = u_in(x, y, w, h);
  qx = ux(x); qy = uy(y); qw = w * gz; qh = h * gz;
  on ? (
    u_frr(qx, qy, qx + qw, qy + qh, qh * 0.5, 0.31, 0.70, 0.67, hv ? 1 : 0.92);
    gfx_set(0.04, 0.09, 0.10, 1); u_ctext(lb, x + w * 0.5, y + (h - 14) * 0.5, 11, "Arial", 'b');
  ) : (
    u_frr(qx, qy, qx + qw, qy + qh, qh * 0.5, 0.10, 0.13, 0.20, hv ? 1 : 0.85);
    u_bord(qx, qy, qx + qw, qy + qh, qh * 0.5, max(1, floor(gz + 0.5)), 0.73, 0.88, 0.86, hv ? 0.6 : 0.34);
    c_ink(hv ? 1 : 0.8); u_ctext(lb, x + w * 0.5, y + (h - 14) * 0.5, 11, "Arial", 'b');
  );
  r = hv && g_click;
  r ? g_click = 0;
  r;
);

function u_star(cx, cy, ro, a) local(k, t, x1, y1, x2, y2, x3, y3)
(
  k = 0;
  loop(5,
    t = -$pi * 0.5 + k * 2 * $pi / 5;
    x1 = cx + cos(t) * ro; y1 = cy + sin(t) * ro;
    x2 = cx + cos(t + $pi / 5) * ro * 0.42; y2 = cy + sin(t + $pi / 5) * ro * 0.42;
    x3 = cx + cos(t - $pi / 5) * ro * 0.42; y3 = cy + sin(t - $pi / 5) * ro * 0.42;
    gfx_a = a;
    gfx_triangle(cx, cy, x1, y1, x2, y2);
    gfx_triangle(cx, cy, x1, y1, x3, y3);
    k += 1;
  );
  gfx_a = 1;
);

function u_is_black(pc) ( pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10; );
function u_wpos(n) local(o, p)
(
  o = floor(n / 12); p = n - o * 12;
  o * 7 + (p < 1 ? 0 : p < 3 ? 1 : p < 5 ? 2 : p < 6 ? 3 : p < 8 ? 4 : p < 10 ? 5 : 6) - 7;
);
function u_kstate(n) ( g_KEYON[n] || g_note == n ? 2 : g_KSW[n] ? 4 : u_named(g_inst, n, g_S[3]) ? 5 : (n < g_lo || n > g_hi) ? 1 : 0; );

function u_keyboard(x, y, w, h) local(ww, bw, bh, QX, QY, QH, n, wi, hov, hovh, down, vel, kx, kw, bx, st, cx, tw, th)
(
  ww = w / 57; bw = ww * 0.6; bh = h * 0.63;
  QX = ux(x); QY = uy(y); QH = h * gz;
  hov = -1; hovh = h;
  (mouse_x >= QX && mouse_x < QX + w * gz && mouse_y >= QY && mouse_y < QY + QH) ? (
    n = 13;
    loop(95,
      u_is_black(n % 12) ? (
        cx = x + (u_wpos(n - 1) + 1) * ww;
        (mouse_y < QY + bh * gz && abs(mouse_x - ux(cx)) < bw * gz * 0.5) ? ( hov = n; hovh = bh; );
      );
      n += 1;
    );
    hov < 0 ? (
      wi = floor((mouse_x - QX) / (ww * gz));
      n = 12;
      loop(97, (!u_is_black(n % 12) && u_wpos(n) == wi) ? hov = n; n += 1; );
    );
  );
  down = mouse_cap & 1;
  (g_click && hov >= 0) ? ( g_on = 1; g_note = -1; g_click = 0; );
  (g_on && !down) ? (
    g_note >= 0 ? u_gq(0x80, g_note, 0);
    g_note = -1; g_on = 0;
  );
  (g_on && down && hov >= 0 && hov != g_note) ? (
    g_note >= 0 ? u_gq(0x80, g_note, 0);
    vel = max(1, floor(1 + 126 * u01((mouse_y - QY) / (hovh * gz))));
    u_gq(0x9F, hov, vel);
    g_note = hov;
  );
  gfx_set(0.02, 0.03, 0.06, 1);
  gfx_rect(ux(x) - 3 * gz, uy(y) - 12 * gz, (w + 6) * gz, QH + 15 * gz, 1);
  cx = 0;
  loop(ceil(10 * gz),
    gfx_set(0.12 + 0.10 * sin($pi * cx / (10 * gz)), 0.17 + 0.11 * sin($pi * cx / (10 * gz)), 0.26 + 0.12 * sin($pi * cx / (10 * gz)), 1);
    gfx_rect(ux(x) - 3 * gz, uy(y) - 11 * gz + cx, (w + 6) * gz, 1, 1);
    cx += 1;
  );
  c_gown(0.95); gfx_rect(ux(x) - 3 * gz, uy(y) - 2 * gz, (w + 6) * gz, max(1, gz), 1);
  n = 12;
  loop(97,
    !u_is_black(n % 12) ? (
      wi = u_wpos(n);
      kx = floor(ux(x + wi * ww)) + max(1, floor(gz));
      kw = floor(ux(x + (wi + 1) * ww)) - kx;
      st = u_kstate(n);
      st == 2 ? gfx_gradrect(kx, QY, kw, QH, 0.37, 0.83, 0.79, 1, 0, 0, 0, 0, -0.16 / QH, -0.2 / QH, -0.2 / QH, 0)
      : st == 4 ? gfx_gradrect(kx, QY, kw, QH, 0.99, 0.88, 0.52, 1, 0, 0, 0, 0, -0.12 / QH, -0.12 / QH, -0.12 / QH, 0)
      : st == 5 ? gfx_gradrect(kx, QY, kw, QH, 0.76, 0.90, 0.88, 1, 0, 0, 0, 0, -0.1 / QH, -0.1 / QH, -0.1 / QH, 0)
      : st == 1 ? gfx_gradrect(kx, QY, kw, QH, 0.56, 0.58, 0.62, 1, 0, 0, 0, 0, -0.1 / QH, -0.1 / QH, -0.1 / QH, 0)
      : gfx_gradrect(kx, QY, kw, QH, 0.93, 0.94, 0.95, 1, 0, 0, 0, 0, -0.1 / QH, -0.1 / QH, -0.09 / QH, 0);
      gfx_set(0, 0, 0, 0.3); gfx_rect(kx, QY, kw, 2 * gz, 1);
      n % 12 == 0 ? (
        gfx_setfont(1, "Arial", 11 * gz, 'b');
        gfx_set(0.26, 0.30, 0.38, 1);
        sprintf(#u_kl, "C%d", floor(n / 12) - 1);
        gfx_measurestr(#u_kl, tw, th);
        gfx_x = floor(kx + (kw - tw) * 0.5); gfx_y = QY + QH - 16 * gz;
        gfx_drawstr(#u_kl);
      );
    );
    n += 1;
  );
  n = 13;
  loop(95,
    u_is_black(n % 12) ? (
      bx = floor(ux(x + (u_wpos(n - 1) + 1) * ww - bw * 0.5));
      st = u_kstate(n);
      gfx_set(0, 0, 0, 0.4); gfx_rect(bx + gz, QY, bw * gz, bh * gz + 2 * gz, 1);
      st == 2 ? gfx_gradrect(bx, QY, bw * gz, bh * gz, 0.22, 0.60, 0.57, 1, 0, 0, 0, 0, 0.1 / (bh * gz), 0.1 / (bh * gz), 0.1 / (bh * gz), 0)
      : st == 4 ? gfx_gradrect(bx, QY, bw * gz, bh * gz, 0.62, 0.52, 0.22, 1, 0, 0, 0, 0, 0.1 / (bh * gz), 0.1 / (bh * gz), 0.06 / (bh * gz), 0)
      : st == 5 ? gfx_gradrect(bx, QY, bw * gz, bh * gz, 0.30, 0.46, 0.46, 1, 0, 0, 0, 0, 0.1 / (bh * gz), 0.1 / (bh * gz), 0.1 / (bh * gz), 0)
      : st == 1 ? gfx_gradrect(bx, QY, bw * gz, bh * gz, 0.24, 0.25, 0.29, 1, 0, 0, 0, 0, 0.1 / (bh * gz), 0.1 / (bh * gz), 0.1 / (bh * gz), 0)
      : gfx_gradrect(bx, QY, bw * gz, bh * gz, 0.06, 0.07, 0.10, 1, 0, 0, 0, 0, 0.1 / (bh * gz), 0.1 / (bh * gz), 0.1 / (bh * gz), 0);
      gfx_set(1, 1, 1, 0.1); gfx_rect(bx + 2 * gz, QY + bh * gz - 7 * gz, bw * gz - 4 * gz, 5 * gz, 1);
    );
    n += 1;
  );
);

function u_settings()
(
  c_soft(1); u_text("TUNING", 332, 78, 10, "Arial", 'b');
  (g_f = u_tslider(6, 332, 118, 250, (slider(10) - 392) / 102, "Concert pitch (A4)", sprintf(#u_s, "%d Hz", slider(10)))) != -1 ? (
    u_set(10, g_f == -2 ? 440 : floor(392 + g_f * 102 + 0.5));
  );
  u_menu(612, 97, 150, "Presets", "choose...", 0) ? (
    g_m = gfx_showmenu("466 Hz (Chorton)|440 Hz (modern)|442 Hz|443 Hz|435 Hz (1859 diapason)|432 Hz|430 Hz (classical)|415 Hz (baroque)|392 Hz (French baroque)");
    g_m > 0 ? u_set(10, g_m == 1 ? 466 : g_m == 2 ? 440 : g_m == 3 ? 442 : g_m == 4 ? 443 : g_m == 5 ? 435 : g_m == 6 ? 432 : g_m == 7 ? 430 : g_m == 8 ? 415 : 392);
  );
  u_menu(332, 166, 250, "Temperament", u_temper_name(slider(11)), 0) ? (
    g_m = gfx_showmenu(u_temper_menu());
    g_m > 0 ? u_set(11, SCALES[960 + g_m - 1]);
  );
  c_soft(1); u_text("ENGINE", 332, 206, 10, "Arial", 'b');
  u_menu(332, 240, 120, "Polyphony", sprintf(#u_s, "%d voices", POLY), 0) ? (
    strcpy(#u_menub, ""); g_i = 0;
    loop(7,
      g_n2 = g_i == 0 ? 8 : g_i == 1 ? 16 : g_i == 2 ? 24 : g_i == 3 ? 32 : g_i == 4 ? 48 : g_i == 5 ? 64 : 96;
      strcat(#u_menub, sprintf(#u_s, "%s%s%d", g_i ? "|" : "", slider(12) == g_i ? "!" : "", g_n2));
      g_i += 1;
    );
    g_m = gfx_showmenu(#u_menub);
    g_m > 0 ? u_set(12, g_m - 1);
  );
  u_menu(472, 240, 130, "Sample quality", slider(13) == 0 ? "Nearest" : slider(13) == 1 ? "Linear" : "Hermite", 0) ? (
    g_m = gfx_showmenu(sprintf(#u_menub, "%sNearest|%sLinear|%sHermite (sfizz default)",
      slider(13) == 0 ? "!" : "", slider(13) == 1 ? "!" : "", slider(13) == 2 ? "!" : ""));
    g_m > 0 ? u_set(13, g_m - 1);
  );
  u_menu(622, 240, 140, "Pitch bend range", slider(14) == 0 ? "2 semitones" : sprintf(#u_s, "%d semitones", slider(14)), 0) ? (
    strcpy(#u_menub, slider(14) == 0 ? "!Instrument (2 semitones)" : "Instrument (2 semitones)");
    g_i = 1;
    loop(24, strcat(#u_menub, sprintf(#u_s, "|%s%d", slider(14) == g_i ? "!" : "", g_i)); g_i += 1; );
    g_m = gfx_showmenu(#u_menub);
    g_m > 0 ? u_set(14, g_m - 1);
  );
  c_soft(1);
  u_text("Polyphony is the number of sfizz engine voices; tuning and temperament apply to every note.", 332, 272, 11, "Arial", 0);
  
);

function u_backdrop() local(k, p, tw)
(
  gfx_set(0.04, 0.05, 0.10, 1); gfx_rect(0, 0, gfx_w, gfx_h, 1);
  gfx_gradrect(0, 0, gfx_w, gfx_h, 0.06, 0.08, 0.15, 1, 0, 0, 0, 0, -0.03 / gfx_h, -0.04 / gfx_h, -0.07 / gfx_h, 0);
  gfx_gradrect(0, 0, gfx_w, uy(70), 0.07, 0.10, 0.20, 1, 0, 0, 0, 0, -0.03 / uy(70), -0.03 / uy(70), -0.08 / uy(70), 0);
  k = 0;
  loop(90,
    p = GUI + 20 + 4 * k;
    gfx_set(0.85, 0.92, 1, p[2]);
    gfx_rect(ux(p[0]), uy(p[1]), max(1, floor(p[3] * gz)), max(1, floor(p[3] * gz)), 1);
    k += 1;
  );
  c_line(1); gfx_rect(0, uy(70), gfx_w, max(1, gz), 1);
  c_gown(0.35); gfx_rect(0, uy(70) + max(1, gz), gfx_w, max(1, gz), 1);
  c_ink(1);
  tw = u_spaced("ROSALINA CURIOSA", 450, 10, 27, "Georgia", 7);
  c_star(1); u_star(ux(450 - tw * 0.5 - 22), uy(26), 7 * gz, 0.95);
  c_star(1); u_star(ux(450 + tw * 0.5 + 16), uy(26), 7 * gz, 0.95);
  c_glow(1);
  tw = u_spaced("H A R P S I C H O R D S", 450, 46, 12, "Georgia", 5);
  c_trim(0.7);
  gfx_rect(ux(450 - tw * 0.5 - 70), uy(55), 60 * gz, max(1, gz), 1);
  gfx_rect(ux(450 + tw * 0.5 + 10), uy(55), 60 * gz, max(1, gz), 1);
);

function u_pagebtn() local(hv)
(
  hv = u_in(24, 30, 92, 20);
  g_page ? c_glow(1) : c_ink(hv ? 1 : 0.7);
  gfx_rect(ux(24), uy(30), 92 * gz, 20 * gz, 0);
  u_ctext(g_page ? "INSTRUMENTS" : "SETTINGS", 70, 33, 10, "Arial", 'b');
  (hv && g_click) ? ( g_click = 0; g_page = !g_page; );
);

function u_state(s) local(k, qsl)
(
  qsl = SLOT + s * SLS;
  k = qsl[0] - 1;
  !sec_ok ? 4 : qsl[0] <= 0 ? 0 : PKS[k] === 3 ? 3 : (qsl[2] && !qsl[26]) ? 1 : 2;
);

function u_meter(s, x, y, w) local(lv)
(
  lv = u01((20 * log10(max(STR[s], 0.000001)) + 60) / 60);
  g_meter[s] = max(lv, g_meter[s] * 0.9);
  c_line(1); gfx_rect(ux(x), uy(y), w * gz, max(1, gz), 1);
  c_gown(0.95); gfx_rect(ux(x), uy(y), w * g_meter[s] * gz, max(1, 2 * gz), 1);
);

function u_arts(x, y, slA) local(n, j, w)
(
  n = u_art_n(g_inst);
  n > 0 ? (
    c_soft(1); u_text("REGISTRATION", x, y - 18, 10, "Arial", 'b');
    w = min(150, floor((540 - 12 * (n - 1)) / n));
    j = 0;
    loop(n,
      u_toggle(x + j * (w + 12), y, w, 26, u_art_label(g_inst, j), g_S[3] == u_art_key(g_inst, j)) ? u_set(slA, j);
      j += 1;
    );
  );
  n;
);

function u_status(s)
(
  c_soft(1);
  g_st = u_state(s);
  g_st == 1 ? sprintf(#u_st, "%d / %d voices", min(g_S[4], POLY), POLY)
    : g_st == 0 ? strcpy(#u_st, "")
    : g_st == 3 ? ( c_star(1); strcpy(#u_st, "Samples not found in Dependencies/RosalinaCuriosa"); )
    : g_st == 4 ? ( c_star(1); strcpy(#u_st, "Instrument data missing in Dependencies/RosalinaCuriosa"); )
    : sprintf(#u_st, "Loading %s  %d%%", ld_h >= 0 ? u_inst_name(ld_p + 1) : "", ld_h >= 0 ? floor(100 * ld_pos / max(1, PKZ[ld_p])) : 0);
  u_rtext(#u_st, 872, 378, 11, "Arial", 0);
);

function u_nn(n, dst) local(p)
(
  p = n % 12;
  sprintf(dst, "%s%d", p == 0 ? "C" : p == 1 ? "C#" : p == 2 ? "D" : p == 3 ? "D#" : p == 4 ? "E" : p == 5 ? "F" : p == 6 ? "F#" : p == 7 ? "G" : p == 8 ? "G#" : p == 9 ? "A" : p == 10 ? "A#" : "B", floor(n / 12) - 1);
);

function u_keylist(x, y) local(j, nm, cx, cy)
(
  j = 0;
  loop(12,
    nm = u_kname(g_inst, g_S[3], j);
    g_kn >= 0 ? (
      cx = x + (j % 3) * 182; cy = y + floor(j / 3) * 18;
      c_glow(1); u_text(u_nn(g_kn, #u_n3), cx, cy, 11, "Arial", 'b');
      c_ink(0.85); u_text(nm, cx + 34, cy, 11, "Arial", 0);
    );
    j += 1;
  );
);

function u_hint()
(
  c_soft(1);
  u_art_n(g_inst) > 0 ? sprintf(#u_h, "Articulation keyswitches in gold; playing range %s - %s", u_nn(g_lo, #u_n1), u_nn(g_hi, #u_n2))
  : u_named(g_inst, 60, g_S[3]) ? strcpy(#u_h, "Each lit key plays a different sound; names show in the piano roll")
  : g_inst > 0 ? sprintf(#u_h, "Playing range %s - %s", u_nn(g_lo, #u_n1), u_nn(g_hi, #u_n2)) : strcpy(#u_h, "");
  u_text(#u_h, 24, 378, 11, "Arial", 0);
);


function u_inst_row(i, x, y, w) local(sel, hv, h)
(
  sel = floor(slider(2) + 0.5) == i;
  h = 30;
  hv = u_in(x, y, w, h);
  sel ? ( gfx_set(0.31, 0.70, 0.67, 0.12); gfx_rect(ux(x), uy(y), w * gz, h * gz, 1); c_gown(1); gfx_rect(ux(x), uy(y), 3 * gz, h * gz, 1); )
      : hv ? ( gfx_set(1, 1, 1, 0.05); gfx_rect(ux(x), uy(y), w * gz, h * gz, 1); );
  sel ? c_ink(1) : c_ink(hv ? 0.9 : 0.72);
  gfx_setfont(1, "Georgia", 18 * gz);
  gfx_x = ux(x + 16); gfx_y = uy(y + 5); gfx_drawstr(u_inst_name(i + 1));
  (sel && u_state(0) == 1) ? u_meter(0, x + 16, y + h - 4, w - 32);
  (hv && g_click) ? ( g_click = 0; !sel ? u_set(2, i); );
);

function u_pedal(x, y, w) local(hv, v, f)
(
  v = (SLOT + 200)[64];
  hv = u_in(x - 4, y - 6, w + 8, 34);
  c_soft(1); u_text("SUSTAIN PEDAL (CC64)", x, y - 18, 10, "Arial", 'b');
  u_frr(ux(x), uy(y), ux(x + w), uy(y + 22), 11 * gz, 0.10, 0.13, 0.20, 1);
  v > 0.004 ? u_frr(ux(x), uy(y), ux(x + max(22, w * v)), uy(y + 22), 11 * gz, 0.31, 0.70, 0.67, 0.35 + 0.6 * v);
  u_bord(ux(x), uy(y), ux(x + w), uy(y + 22), 11 * gz, max(1, floor(gz + 0.5)), 0.73, 0.88, 0.86, hv ? 0.6 : 0.34);
  c_ink(0.9); u_ctext(v < 0.004 ? "Up: dampers on the strings" : v >= 0.5 ? "Down: dampers lifted" : "Half pedal: dampers brushing", x + w * 0.5, y + 4, 11, "Arial", 0);
  f = -1;
  (hv && g_click) ? ( g_click = 0; g_drag = 900; g_pv = v < 0.5 ? 1 : 0; f = g_pv; g_px = mouse_x; );
  (g_drag == 900 && g_down && abs(mouse_x - g_px) > 3) ? f = u01((mouse_x - ux(x)) / (w * gz));
  (hv && g_wheel != 0) ? ( f = u01(v + (g_wheel > 0 ? 1 : -1) / 16); g_wheel = 0; );
  f >= 0 ? ( f = floor(f * 127 + 0.5); f !== g_lastped ? ( g_lastped = f; GQ[g_qw * 4] = 0xB0; GQ[g_qw * 4 + 1] = 64; GQ[g_qw * 4 + 2] = f; GQ[g_qw * 4 + 3] = 0; g_qw = (g_qw + 1) % 64; ); );
);

g_sel = 0;
g_S = SLOT; g_KEYON = g_S + 950; g_KSW = g_S + 800;
g_inst = floor(slider(2) + 0.5) + 1;
g_lo = u_inst_lo(g_inst); g_hi = u_inst_hi(g_inst);
u_backdrop();
u_pagebtn();
c_soft(1); u_text("INSTRUMENT", 24, 80, 10, "Arial", 'b');
g_i = 0; loop(5, u_inst_row(g_i, 20, 98 + g_i * 34, 280); g_i += 1; );
u_menu(24, 98 + 5 * 34 + 26, 130, "MIDI channel", slider(4) == 0 ? "Omni" : sprintf(#u_chs, "Channel %d", slider(4)), 0) ? (
  strcpy(#u_menub, slider(4) == 0 ? "!Omni" : "Omni");
  g_i = 1;
  loop(16, strcat(#u_menub, sprintf(#u_chs, "|%s%d", slider(4) == g_i ? "!" : "", g_i)); g_i += 1; );
  g_m = gfx_showmenu(#u_menub);
  g_m > 0 ? u_set(4, g_m - 1);
);
g_page ? u_settings() : (
  c_ink(1); u_text(u_inst_name(g_inst), 332, 80, 20, "Georgia", 0);
  c_soft(1); u_text(u_inst_info(g_inst), 332, 110, 12, "Arial", 0);
  u_arts(332, 166, 3);
  
  c_line(1); gfx_rect(ux(332), uy(250), 540 * gz, max(1, gz), 1);
  (g_f = u_knob(1, 812, 300, 26, (slider(1) + 60) / 72, "Output", sprintf(#u_s, "%.1f dB", slider(1)), 0)) != -1 ? (
    u_set(1, g_f == -2 ? 0 : floor((g_f * 72 - 60) * 10 + 0.5) / 10);
  );
);
u_status(0);
u_hint();
g_rprev = mouse_cap & 2;
u_keyboard(20, 410, 860, 106);
