  i = 0;
  loop(9, printf("  pv%d = (pq%d + (ic0 * pc0_%d + ic1 * pc1_%d + ib0 * pb0_%d + ib1 * pb1_%d)) - dsm * pf%d;\n", i, i, i, i, i, i, i); i += 1; );
?>
  pcinp = cnow;
  pjcin = -pgc1pc * (vin - pv0) - pccin * pjcin;
  pic0 = ic0; pic1 = ic1; pib0 = ib0; pib1 = ib1;
  pvnl0 = v0;
  pvnl1 = v1;
  p_gldrp = p_gldr;
  pv7;
);

// ---------------------------------------------------------------------- power amp, volume network, speaker

PW_G = 19000;
PW_RAIL = 22;
PW_VT = 0.013;
PW_Q = 0.1;

function tanh_x(x) local(a, e, x2, r) (
  a = abs(x);
  a < 0.05 ? (
    x2 = x * x;
    r = x * (1 + x2 * (-0.33333333333333333 + x2 * (0.13333333333333333 + x2 * (-0.053968253968253968 + x2 * (0.021869488536155203 + x2 * -0.0088632355299021965)))));
  ) : (
    e = exp(-2 * a);
    r = (1 - e) / (1 + e);
    x < 0 ? r = -r;
  );
  r;
);

function pamp_new(osr) local(k, tz, tp, a0) (
  k = 2 * osr;
  tz = 220 * 0.000022;
  tp = (220 + 15000) * 0.000022;
  a0 = 1 + tp * k;
  pw_b0 = (1 + tz * k) / a0;
  pw_b1 = (1 - tz * k) / a0;
  pw_a1 = (1 - tp * k) / a0;
  pw_y1 = 0;
  pw_fbp = 0;
);

function pamp_process(input) local(fbh, b0, y, it, er, v, vsq, ex, cg, vc, dc, tv, fv, fd, res, jac, dl) (
  fbh = pw_b1 * pw_y1 - pw_a1 * pw_fbp;
  b0 = pw_b0;
  y = max(-PW_RAIL + 0.000001, min(PW_RAIL - 0.000001, ((input - fbh) * PW_G) / (1 + PW_G * b0)));
  it = 0;
  while (it < 8) (
    er = input - (b0 * y + fbh);
    v = PW_G * er;
    vsq = v * v;
    ex = exp(-vsq / (PW_VT * PW_VT));
    cg = PW_Q + (1 - PW_Q) * (1 - ex);
    vc = v * cg;
    dc = cg + v * (1 - PW_Q) * ((2 * v) / (PW_VT * PW_VT)) * ex;
    tv = tanh_x(vc / PW_RAIL);
    fv = PW_RAIL * tv;
    fd = (1 - tv * tv) * dc;
    res = y - fv;
    jac = 1 + PW_G * b0 * fd;
    dl = res / jac;
    y -= dl;
    abs(dl) < 0.000001 ? it = 8 : it += 1;
  );
  pw_fbp = b0 * y + fbh;
  pw_y1 = y;
  y / PW_RAIL;
);

function taper(p) (
  p = max(0, min(1, p));
  p <= 0.5 ? 0.15 * (p / 0.5) : 0.15 + 0.85 * ((p - 0.5) / 0.5);
);

function vol_update(vol) local(rlo, rup, rle, rsrc, a, rth, fc) (
  rlo = 10000 * taper(vol);
  rup = 10000 - rlo;
  rle = rlo <= 0 ? 0 : (rlo * 15000) / (rlo + 15000);
  v_drive = PA_OCF * (rle / (6800 + 17200 + rup + rle));
  rsrc = 6800 + 17200 + rup;
  rlo <= 0 ? (
    v_c9a = 1;
  ) : (
    a = (rsrc * rlo) / (rsrc + rlo);
    rth = (a * 15000) / (a + 15000);
    fc = 1 / (((2 * $pi) * rth) * 0.000000001);
    v_c9a = fc >= 0.5 * os_sr ? 1 : 1 - exp(((-2 * $pi) * fc) / os_sr);
  );
);

function biq_lp(fc, q, fs) local(w0, cw, sw, al, a0) (
  w0 = (TWOPI * min(fc, fs * 0.499)) / fs;
  cw = cos(w0); sw = sin(w0);
  al = sw / (2 * q);
  a0 = 1 + al;
  bq_b0 = ((1 - cw) / 2) / a0;
  bq_b1 = (1 - cw) / a0;
  bq_b2 = ((1 - cw) / 2) / a0;
  bq_a1 = (-2 * cw) / a0;
  bq_a2 = (1 - al) / a0;
);

function biq_hp(fc, q, fs) local(w0, cw, sw, al, a0) (
  w0 = (TWOPI * min(fc, fs * 0.499)) / fs;
  cw = cos(w0); sw = sin(w0);
  al = sw / (2 * q);
  a0 = 1 + al;
  bq_b0 = ((1 + cw) / 2) / a0;
  bq_b1 = -(1 + cw) / a0;
  bq_b2 = ((1 + cw) / 2) / a0;
  bq_a1 = (-2 * cw) / a0;
  bq_a2 = (1 - al) / a0;
);

function biq_bp(fc, q, fs) local(w0, cw, sw, al, a0) (
  w0 = (TWOPI * min(fc, fs * 0.499)) / fs;
  cw = cos(w0); sw = sin(w0);
  al = sw / (2 * q);
  a0 = 1 + al;
  bq_b0 = al / a0;
  bq_b1 = 0 / a0;
  bq_b2 = -al / a0;
  bq_a1 = (-2 * cw) / a0;
  bq_a2 = (1 - al) / a0;
);

function spk_coef() local(c) (
  c = sp_char;
  biq_hp(20 * ((30 / 20) ^ c), 0.75, srate);
  sh_b0 = bq_b0; sh_b1 = bq_b1; sh_b2 = bq_b2; sh_a1 = bq_a1; sh_a2 = bq_a2;
  biq_lp(20000 * ((5500 / 20000) ^ c), 0.707, srate);
  sl_b0 = bq_b0; sl_b1 = bq_b1; sl_b2 = bq_b2; sl_a1 = bq_a1; sl_a2 = bq_a2;
  sp_a2 = 0.2 * c;
  sp_a3 = 0.6 * c;
  sp_tc = 2 * c;
);

function spk_set(c) (
  c = max(0, min(1, c));
  abs(c - sp_char) > 0.002 ? (
    sp_char = c;
    spk_coef();
  );
);

function spk_reset() ( sh_s1 = sh_s2 = sl_s1 = sl_s2 = sp_th = 0; );

function spk_process(x) local(x2, x3, sh, lim, tg, fl, o) (
  x2 = x * x;
  x3 = x2 * x;
  sh = (x + sp_a2 * x2 + sp_a3 * x3) / (1 + sp_a2 + sp_a3);
  lim = sp_char < 0.001 ? sh : tanh_x(sh);
  sp_th += (x2 - sp_th) * sp_alpha;
  tg = 1 / (1 + sp_tc * sqrt(sp_th));
  lim *= tg;
  fl = sh_b0 * lim + sh_s1;
  sh_s1 = sh_b1 * lim - sh_a1 * fl + sh_s2;
  sh_s2 = sh_b2 * lim - sh_a2 * fl;
  o = sl_b0 * fl + sl_s1;
  sl_s1 = sl_b1 * fl - sl_a1 * o + sl_s2;
  sl_s2 = sl_b2 * fl - sl_a2 * o;
  sp_char < 0.001 ? x : o;
);

// ---------------------------------------------------------------------- smoothers

function sm_init(v) instance(cur, tgt, stp, rem) ( cur = tgt = v; stp = 0; rem = 0; );
function sm_set(t) instance(cur, tgt, stp, rem) (
  abs(t - tgt) >= 0.000000001 ? (
    tgt = t;
    stp = (t - cur) / sm_ramp;
    rem = sm_ramp;
  );
);
function sm_snap() instance(cur, tgt, stp, rem) ( cur = tgt; stp = 0; rem = 0; );
function sm_next() instance(cur, tgt, stp, rem) (
  rem > 0 ? (
    cur += stp;
    rem -= 1;
    rem == 0 ? cur = tgt;
  );
  cur;
);

// ---------------------------------------------------------------------- voices

V_SMP = 63; V_ONS = 64; V_OINC = 65; V_OEXP = 66; V_DACT = 67; V_DRAMP = 68; V_DCNT = 69;
V_DDONE = 70; V_DRAG = 71; V_PW = 72; V_PSP = 73; V_PMP = 74; V_PBETA = 75; V_LAW = 76;
V_PSCALE = 77; V_PCREST = 78; V_NAMP = 79; V_NDEC = 80; V_NREM = 81; V_NFADE = 82;
V_NB0 = 83; V_NB1 = 84; V_NB2 = 85; V_NA1 = 86; V_NA2 = 87; V_NS1 = 88; V_NS2 = 89; V_NRNG = 90;
V_GAIN = 91; V_MIDI = 92; V_ENG = 93; V_FORCE = 94;
PED_ON = 0.15;
PED_OFF = 0.7;

PK_RATIO = 0.000000000003 / 0.00000000024;
PK_SENS = (147 * 0.000000000003) / 0.00000000024;
PK_FC = (880.5 * (0.00000000024 + 0.00000000022)) / (0.00000000024 + 0.00000000022);
PK_TAU = 1 / ((2 * $pi) * PK_FC);
SILENT_LIN = 10 ^ (-80 / 20);

function mlp_infer(midi, vel) local(fade, mn, vn, i, j, s) (
  fade = midi < 38 ? max(0, min(1, (midi - (38 - 12)) / 12)) : midi > 86 ? max(0, min(1, ((86 + 12) - midi) / 12)) : 1;
  ml_f0 = ml_f1 = 0;
  ml_d0 = ml_d1 = 1;
  fade > 0 ? (
    mn = max(0, min(1, (midi - 21) / (108 - 21)));
    vn = max(0, min(1, vel));
    i = 0;
    loop(16,
      s = MB1[i];
      s += MW1[i * 2] * mn;
      s += MW1[i * 2 + 1] * vn;
      MLPH1[i] = s > 0 ? s : 0;
      i += 1;
    );
    i = 0;
    loop(16,
      s = MB2[i];
      j = 0;
      loop(16, s += MW2[i * 16 + j] * MLPH1[j]; j += 1; );
      MLPH2[i] = s > 0 ? s : 0;
      i += 1;
    );
    i = 0;
    loop(11,
      s = MB3[i];
      j = 0;
      loop(16, s += MW3[i * 16 + j] * MLPH2[j]; j += 1; );
      MLPR[i] = s * MSTD[i] + MMEAN[i];
      i += 1;
    );
    ml_f0 = max(-100, min(100, MLPR[0] * fade));
    ml_f1 = max(-100, min(100, MLPR[1] * fade));
    ml_d0 = 1 + (max(0.3, min(3, MLPR[5])) - 1) * fade;
    ml_d1 = 1 + (max(0.3, min(3, MLPR[6])) - 1) * fade;
  );
);

function voice_init(vp, midi, vi, seed) local(nt, vel, f0d, td, a0, i, ft, onset, rs, frq, inc, sw, lw, reed, cen) (
  nt = NOTET + (midi - 21) * 289;
  vel = VELT[vi];
  f0d = nt[0] * nt[1];
  td = max(0.0003, min(0.02, (0.75 + 0.25 * (1 - vel)) / f0d));
  i = 0;
  loop(7,
    ft = (f0d * nt[2 + i]) * td;
    VATT[i] = exp(((-ft) * ft) / (2 * 64));
    i += 1;
  );
  a0 = VATT[0];
  a0 > 0.000000000000000000000000000001 ? ( i = 0; loop(7, VATT[i] /= a0; i += 1; ); );
  onset = max((1 + 1 * (1 - vel)) * (1 / f0d), 0.002);
  i = 0;
  loop(7,
    VAMP[i] = (nt[9 + i] * VATT[i]) * nt[16 + i];
    VAMP[i] *= nt[34 + 2 * vi];
    VRAT[i] = nt[2 + i];
    VDEC[i] = nt[23 + i];
    i += 1;
  );
  p_mlp >= 0.5 ? (
    mlp_infer(midi, vel);
    VRAT[1] *= 2 ^ (ml_f0 / 1200);
    VRAT[2] *= 2 ^ (ml_f1 / 1200);
    VDEC[1] /= ml_d0;
    VDEC[2] /= ml_d1;
  );
  sw = nt[30];
  i = 0;
  loop(7,
    frq = f0d * VRAT[i];
    inc = (TWOPI * frq) / srate;
    vp[i * 9] = 0;
    vp[i * 9 + 1] = 1;
    vp[i * 9 + 2] = cos(inc);
    vp[i * 9 + 3] = sin(inc);
    vp[i * 9 + 4] = VAMP[i];
    vp[i * 9 + 5] = exp(-((VDEC[i] / 8.686) / srate));
    vp[i * 9 + 6] = 1;
    vp[i * 9 + 7] = 0;
    vp[i * 9 + 8] = 1;
    i += 1;
  );
  rs = floor(onset * srate + 0.5);
  vp[V_SMP] = 0;
  vp[V_ONS] = rs;
  vp[V_OINC] = rs > 0 ? $pi / rs : 0;
  vp[V_OEXP] = 1 + (1 - vel);
  vp[V_DACT] = 0; vp[V_DRAMP] = 0; vp[V_DCNT] = 0; vp[V_DDONE] = 0;
  vp[V_DRAG] = (((nt[31] / 8.686) * abs(VAMP[0])) * sw) / srate;
  reed = midi - 32;
  lw = reed <= 14 ? 0 : reed <= 20 ? 1 : reed <= 42 ? 2 : 3;
  vp[V_PW] = 0; vp[V_PSP] = 0; vp[V_PMP] = 1;
  vp[V_PBETA] = (1 / srate) / (2 * PK_TAU);
  vp[V_LAW] = lw;
  vp[V_PSCALE] = (reed <= 20 ? 1 : -1) * sw;
  vp[V_PCREST] = nt[32];
  vp[V_NAMP] = (0.025 * vel) * vel;
  vp[V_NDEC] = exp(-1 / (0.003 * srate));
  vp[V_NREM] = floor(0.015 * srate);
  vp[V_NFADE] = 16;
  cen = max(200, min(2000, f0d * 5));
  biq_bp(cen, 0.7, srate);
  vp[V_NB0] = bq_b0; vp[V_NB1] = bq_b1; vp[V_NB2] = bq_b2; vp[V_NA1] = bq_a1; vp[V_NA2] = bq_a2;
  vp[V_NS1] = 0; vp[V_NS2] = 0;
  vp[V_NRNG] = seed;
  vp[V_GAIN] = nt[33 + 2 * vi];
  vp[V_MIDI] = midi;
  vp[V_ENG] = 0;
  vp[V_FORCE] = 0;
);

function voice_damp(vp, e) local(midi, br, m, fac, prev) (
  midi = vp[V_MIDI];
  midi < 92 ? (
    prev = vp[V_DACT] ? vp[V_ENG] : 0;
    br = max(55 * (2 ^ ((midi - 60) / 24)), 0.5);
    m = 0;
    fac = 1;
    loop(7,
      vp[m * 9 + 7] = (min(br * fac, 2000) / srate) * e;
      vp[m * 9 + 8] = exp(-vp[m * 9 + 7]);
      fac *= 3;
      m += 1;
    );
    vp[V_ENG] = e;
    (e > 0 && prev <= 0) ? (
      vp[V_DRAMP] = (midi < 48 ? 0.05 : midi < 72 ? 0.025 : 0.008) * srate;
      vp[V_DACT] = 1;
      vp[V_DCNT] = 0;
      vp[V_DDONE] = 0;
    );
  );
);

function ped_engage(v) local(e) ( e = max(0, min(1, (PED_OFF - v / 127) / (PED_OFF - PED_ON))); e * e; );

function voice_silent(vp) local(r, m) (
  r = 0;
  (vp[V_DACT] && vp[V_ENG] >= 1) && vp[V_DCNT] / srate > 10 ? r = 1 : (
    r = 1;
    m = 0;
    loop(7,
      abs(vp[m * 9 + 4] * vp[m * 9 + 6]) <= SILENT_LIN ? 0 : r = 0;
      m += 1;
    );
  );
  r;
);

function voice_render(vp, dst, len, sf, sfl) local(i, sum, onset, cs, ns, ri, x, u, pos, ii, t, ta, ly, lm, lu0, ldu, llast, lh2, s, mm, mavg, y, nz, nenv, nout, smp, ons, oinc, oexp, dact, dramp, dcnt, ddone, dragk, pkw, psp, pmp, pbeta, pscale, pcrest, namp, ndec, nrem, nfade, nb0, nb1, nb2, na1, na2, ns1, ns2, nrng, gain, gn
<? m = 0; loop(7, printf(", s%d, c%d, k%d, q%d, a%d, d%d, e%d, r%d, g%d", m, m, m, m, m, m, m, m, m); m += 1; ); ?>
) (
<? m = 0; loop(7,
  printf("  s%d = vp[%d]; c%d = vp[%d]; k%d = vp[%d]; q%d = vp[%d]; a%d = vp[%d];\n", m, m * 9, m, m * 9 + 1, m, m * 9 + 2, m, m * 9 + 3, m, m * 9 + 4);
  printf("  d%d = vp[%d]; e%d = vp[%d]; r%d = vp[%d]; g%d = vp[%d];\n", m, m * 9 + 5, m, m * 9 + 6, m, m * 9 + 7, m, m * 9 + 8);
  m += 1; ); ?>
  smp = vp[V_SMP]; ons = vp[V_ONS]; oinc = vp[V_OINC]; oexp = vp[V_OEXP];
  dact = vp[V_DACT]; dramp = vp[V_DRAMP]; dcnt = vp[V_DCNT]; ddone = vp[V_DDONE]; dragk = vp[V_DRAG];
  pkw = vp[V_PW]; psp = vp[V_PSP]; pmp = vp[V_PMP]; pbeta = vp[V_PBETA]; pscale = vp[V_PSCALE]; pcrest = vp[V_PCREST];
  namp = vp[V_NAMP]; ndec = vp[V_NDEC]; nrem = vp[V_NREM]; nfade = vp[V_NFADE];
  nb0 = vp[V_NB0]; nb1 = vp[V_NB1]; nb2 = vp[V_NB2]; na1 = vp[V_NA1]; na2 = vp[V_NA2];
  ns1 = vp[V_NS1]; ns2 = vp[V_NS2]; nrng = vp[V_NRNG]; gain = vp[V_GAIN];
  ii = vp[V_LAW] * 6;
  lu0 = LAWP[ii]; ldu = LAWP[ii + 1]; llast = LAWP[ii + 2]; ly = LAWP[ii + 3]; lm = LAWP[ii + 4]; lh2 = LAWP[ii + 5];
  i = 0;
  loop(len,
    dact ? (
      dcnt += 1;
      !ddone ? (
        dcnt > dramp ? ddone = 1 : (
<? m = 0; loop(7, printf("          e%d *= exp(-((r%d * dcnt) / dramp));\n", m, m); m += 1; ); ?>
        );
      );
      ddone ? (
<? m = 0; loop(7, printf("        e%d *= g%d;\n", m, m); m += 1; ); ?>
      );
