    ii = min(floor(pos), llast);
    t = pos - ii;
    ta = 1 - t;
    s = (ta * ly[ii] + t * ly[ii + 1] + ((ta * ta * ta - ta) * lm[ii] + (t * t * t - t) * lm[ii + 1]) * lh2) - pcrest;
    mm = 1 + PK_RATIO * s;
    mavg = 0.5 * (mm + pmp);
    pkw = (pkw * (mavg - pbeta) - (s - psp)) / (mavg + pbeta);
    psp = s;
    pmp = mm;
    y = (pkw * PK_SENS) * gain;
    sfl > 0 ? (
      gn = max(sf - i, 0) / sfl;
      dst[i] += y * gn;
    ) : dst[i] += y;
    i += 1;
  );
<? m = 0; loop(7,
  printf("  vp[%d] = s%d; vp[%d] = c%d; vp[%d] = e%d;\n", m * 9, m, m * 9 + 1, m, m * 9 + 6, m);
  m += 1; ); ?>
  vp[V_SMP] = smp; vp[V_DCNT] = dcnt; vp[V_DDONE] = ddone;
  vp[V_PW] = pkw; vp[V_PSP] = psp; vp[V_PMP] = pmp;
  vp[V_NAMP] = namp; vp[V_NREM] = nrem; vp[V_NFADE] = nfade; vp[V_NS1] = ns1; vp[V_NS2] = ns2; vp[V_NRNG] = nrng;
);

// ---------------------------------------------------------------------- engine

function eng_alloc() local(i, best, bp, pr, st, r) (
  r = -1;
  best = 0;
  bp = 1000000000000;
  i = 0;
  while (i < 64 && r < 0) (
    st = SL_ST[i];
    st == 0 ? r = i : (
      pr = st == 3 ? SL_AGE[i] : st == 2 ? SL_AGE[i] + 100000000 : SL_AGE[i] + 200000000;
      pr < bp ? ( bp = pr; best = i; );
    );
    i += 1;
  );
  r < 0 ? best : r;
);

function eng_note_on(note, vi) local(i, sl, rec, fl) (
  i = 0;
  loop(64,
    SL_ST[i] == 2 && SL_NOTE[i] == note ? (
      SL_ST[i] = 3;
      SL_V[i] >= 0 ? (
        voice_damp(VREC + SL_V[i] * VSZ, 1);
        VREC[SL_V[i] * VSZ + V_FORCE] = 1;
      );
    );
    i += 1;
  );
  sl = eng_alloc();
  SL_ST[sl] != 0 ? (
    fl = floor(srate * 0.005);
    SL_SV[sl] = SL_V[sl];
    SL_V[sl] = -1;
    SL_SF[sl] = fl;
    SL_SFL[sl] = fl;
  );
  eng_age += 1;
  rec = sl * 2;
  SL_SV[sl] == rec ? rec += 1;
  SL_V[sl] = rec;
  voice_init(VREC + rec * VSZ, note, vi, (note * 2654435761 + eng_age) - floor((note * 2654435761 + eng_age) / TWO32) * TWO32);
  SL_ST[sl] = 1;
  SL_NOTE[sl] = note;
  SL_AGE[sl] = eng_age;
);

function eng_note_off(note) local(i, best, ba) (
  best = -1;
  ba = 0;
  i = 0;
  loop(64,
    SL_ST[i] == 1 && SL_NOTE[i] == note && (best < 0 || SL_AGE[i] < ba) ? ( best = i; ba = SL_AGE[i]; );
    i += 1;
  );
  best >= 0 ? (
    SL_ST[best] = ped_e < 1 ? 2 : 3;
    SL_V[best] >= 0 ? voice_damp(VREC + SL_V[best] * VSZ, ped_e);
  );
);

function eng_pedal(v) local(e, i, vp) (
  e = ped_engage(v);
  e !== ped_e ? (
    ped_e = e;
    i = 0;
    loop(64,
      (SL_ST[i] == 2 || SL_ST[i] == 3) && SL_V[i] >= 0 ? (
        vp = VREC + SL_V[i] * VSZ;
        !vp[V_FORCE] ? (
          voice_damp(vp, e);
          SL_ST[i] = e < 1 ? 2 : 3;
        );
      );
      i += 1;
    );
  );
);

function eng_clear() (
  memset(SL_ST, 0, 64);
  memset(SL_SF, 0, 64);
  memset(SL_SFL, 0, 64);
  memset(SL_V, -1, 64);
  memset(SL_SV, -1, 64);
  eng_age = 0;
  ped_e = 1;
  eng_idle = 0;
  eng_sleep = 0;
  eng_active = 0;
);

function eng_render(dst, len) local(i, x, u0, u1, ya, yb, yc, depth, vol, j, po, st, any, pk) (
  any = 0;
  i = 0;
  loop(64, (SL_ST[i] != 0 || SL_SV[i] >= 0) ? any = 1; i += 1; );
  any ? eng_sleep = 0;
  eng_sleep ? (
    memset(dst, 0, len);
    tr_pos += tr_step * len * (os_on ? 2 : 1);
    while (tr_pos >= tr_p + 1) ( tr_pos -= tr_p; );
    sm_vol.sm_snap();
    sm_depth.sm_snap();
    sm_spk.sm_snap();
  ) : (
  memset(SUMB, 0, len);
  pk = 0;
  any = 0;
  i = 0;
  loop(64,
    st = SL_ST[i];
    (st != 0 || SL_SV[i] >= 0) ? (
      any = 1;
      SL_V[i] >= 0 ? voice_render(VREC + SL_V[i] * VSZ, SUMB, len, 0, 0);
      SL_SV[i] >= 0 ? (
        voice_render(VREC + SL_SV[i] * VSZ, SUMB, len, SL_SF[i], SL_SFL[i]);
        SL_SF[i] = max(0, SL_SF[i] - len);
        SL_SF[i] == 0 ? SL_SV[i] = -1;
      );
    );
    i += 1;
  );
  eng_active = any;
  i = 0;
  loop(len,
    x = SUMB[i];
    os_on ? (
      ya = ua0 * x + ua_s0; ua_s0 = x - ua0 * ya;
      yb = ua1 * ya + ua_s1; ua_s1 = ya - ua1 * yb;
      u0 = ua2 * yb + ua_s2; ua_s2 = yb - ua2 * u0;
      ya = ub0 * x + ub_s0; ub_s0 = x - ub0 * ya;
      yb = ub1 * ya + ub_s1; ub_s1 = ya - ub1 * yb;
      u1 = ub2 * yb + ub_s2; ub_s2 = yb - ub2 * u1;
      depth = sm_depth.sm_next();
      tr_depth = max(0, min(1, depth));
      vol = sm_vol.sm_next();
      vol !== v_last ? ( v_last = vol; vol_update(vol); );
      preamp_set_ldr(trem_process());
      po = preamp_process(u0);
      c9 += v_c9a * (po * v_drive - c9);
      u0 = pamp_process(c9);
      preamp_set_ldr(trem_process());
      po = preamp_process(u1);
      c9 += v_c9a * (po * v_drive - c9);
      u1 = pamp_process(c9);
      ya = ua0 * u0 + da_s0; da_s0 = u0 - ua0 * ya;
      yb = ua1 * ya + da_s1; da_s1 = ya - ua1 * yb;
      yc = ua2 * yb + da_s2; da_s2 = yb - ua2 * yc;
      ya = ub0 * u1 + db_s0; db_s0 = u1 - ub0 * ya;
      yb = ub1 * ya + db_s1; db_s1 = ya - ub1 * yb;
      u1 = ub2 * yb + db_s2; db_s2 = yb - ub2 * u1;
      x = (yc + d_del) * 0.5;
      d_del = u1;
    ) : (
      depth = sm_depth.sm_next();
      tr_depth = max(0, min(1, depth));
      preamp_set_ldr(trem_process());
      po = preamp_process(x);
      vol = sm_vol.sm_next();
      vol !== v_last ? ( v_last = vol; vol_update(vol); );
      c9 += v_c9a * (po * v_drive - c9);
      x = pamp_process(c9);
    );
    spk_set(sm_spk.sm_next());
    dst[i] = spk_process(x);
    pk = max(pk, abs(dst[i]));
    i += 1;
  );
  any || pk >= 0.000001 ? eng_idle = 0 : eng_idle += len;
  eng_idle > srate * 2 ? eng_sleep = 1;
  );
  i = 0;
  loop(64,
    SL_ST[i] != 0 && SL_V[i] >= 0 ? (
      voice_silent(VREC + SL_V[i] * VSZ) ? ( SL_ST[i] = 0; SL_V[i] = -1; );
    );
    i += 1;
  );
);

function chain_reset() (
  c9 = 0;
  ua_s0 = ua_s1 = ua_s2 = ub_s0 = ub_s1 = ub_s2 = 0;
  da_s0 = da_s1 = da_s2 = db_s0 = db_s1 = db_s2 = d_del = 0;
  pw_y1 = pw_fbp = 0;
  spk_reset();
);

function warm_up() local(tot, n) (
  tot = floor(srate * 0.6);
  while (tot > 0) (
    n = min(512, tot);
    eng_render(OUTB, n);
    tot -= n;
  );
);

function engine_setup() local(n) (
  os_on = srate < 88200;
  os_sr = os_on ? srate * 2 : srate;
  sm_ramp = max(floor(srate * 0.005), 1);
  ua0 = 0.036681502163648; ua1 = 0.24803092158011; ua2 = 0.64318462013648;
  ub0 = 0.11037763476868; ub1 = 0.42039930419088; ub2 = 0.85464011270192;
  eng_clear();
  preamp_new(os_sr);
  trem_setup(os_sr);
  trem_reset();
  pamp_new(os_sr);
  sp_alpha = 1 / (5 * srate);
  sp_char = 1;
  spk_coef();
  chain_reset();
  v_last = -1;
  tr_depth = 0.5;
  n = floor(srate * 0.6) * (os_on ? 2 : 1);
  loop(n, preamp_set_ldr(trem_process()));
  sp_char = 0;
  spk_coef();
  sm_vol.sm_init(p_vol);
  sm_depth.sm_init(p_depth);
  sm_spk.sm_init(p_spk);
  eng_clear();
  preamp_reset();
  trem_reset();
  chain_reset();
  warm_up();
  eng_idle = 0;
  ob_pos = 0;
  ob_len = 0;
);

last_srate = 0;

@slider

last_srate != srate ? (
  last_srate = srate;
  engine_setup();
);

@block

sm_vol.sm_set(p_vol);
sm_depth.sm_set(p_depth);
sm_spk.sm_set(p_spk);

ev_n = 0;
while (uiq_r != uiq_w) (
  EVQ[ev_n * 4] = 0; EVQ[ev_n * 4 + 1] = UIQ[uiq_r * 3]; EVQ[ev_n * 4 + 2] = UIQ[uiq_r * 3 + 1]; EVQ[ev_n * 4 + 3] = UIQ[uiq_r * 3 + 2];
  ev_n += 1;
  uiq_r = (uiq_r + 1) % 64;
);
while (midirecv(mofs, mm1, mm2, mm3)) (
  ev_n < 1024 ? (
    EVQ[ev_n * 4] = max(0, min(samplesblock - 1, mofs));
    EVQ[ev_n * 4 + 1] = mm1;
    EVQ[ev_n * 4 + 2] = mm2;
    EVQ[ev_n * 4 + 3] = mm3;
    ev_n += 1;
  );
);

blk_n = min(samplesblock, 16384);
bpos = 0;
ev_r = 0;
while (bpos < blk_n) (
  while (ev_r < ev_n && EVQ[ev_r * 4] <= bpos) (
    ev_st = EVQ[ev_r * 4 + 1] & 0xF0;
    ev_d1 = EVQ[ev_r * 4 + 2];
    ev_d2 = EVQ[ev_r * 4 + 3];
    ev_st == 0x90 && ev_d2 > 0 ? (
      (ev_d1 >= (p_ext >= 0.5 ? 21 : 33) && ev_d1 <= (p_ext >= 0.5 ? 108 : 96)) ? eng_note_on(ev_d1, ev_d2);
    ) :
    (ev_st == 0x80 || ev_st == 0x90) ? eng_note_off(ev_d1) :
    ev_st == 0xB0 && ev_d1 == 64 ? ( ped_raw = ev_d2; eng_pedal(ev_d2); );
    ev_r += 1;
  );
  blk_end = ev_r < ev_n ? min(blk_n, EVQ[ev_r * 4]) : blk_n;
  blk_end > bpos ? eng_render(OUTB + bpos, blk_end - bpos);
  bpos = blk_end;
);
ob_pos = 0;

OUT_ALIGN = 5.0118722915649414;

@sample

spl0 = spl1 = OUTB[ob_pos] * OUT_ALIGN;
ob_pos += 1;

@gfx 1000 330

UDW = 1000;
UDH = 330;
uscale = max(0.5, min(gfx_w / UDW, gfx_h / UDH));
uox = floor((gfx_w - UDW * uscale) * 0.5);
uoy = 0;

function automate(s, e)
(
<?
  max_sliders > 5 ? printf("slider_automate(2^(s-1), e);") :
    loop(i = 1; 5,
      printf("  s == %d ? slider_automate(slider%d, e) :\n", i, i);
      i += 1;
    );
?> 0;
);

function set_slider(s, x) ( slider(s) = x; automate(s, 0); automate(s, 1); );
function hit_circle(mx, my, cx, cy, rad) ( sqr(mx - cx) + sqr(my - cy) <= sqr(rad); );
function hit_rect(mx, my, x, y, w, h) ( mx >= x && mx <= x + w && my >= y && my <= y + h; );
function px(x) ( uox + x * uscale; );
function py(y) ( uoy + y * uscale; );
function def_val(s) ( s == 1 ? 0.8 : s == 2 ? 0.5 : 0; );
function norm_of(s) ( slider(s); );
function set_norm(s, x) local(old) (
  old = slider(s);
  slider(s) = x;
  slider(s) !== old ? automate(s, 0);
);

function ctext(str, cx, y, fs, fl) local(tw, th)
(
  gfx_setfont(1, "Arial", fs * uscale, fl);
  gfx_measurestr(str, tw, th);
  gfx_x = cx - tw * 0.5; gfx_y = y;
  gfx_drawstr(str);
);

function knob_name(s) ( s == 1 ? "VOLUME" : s == 2 ? "VIBRATO" : "SPEAKER"; );

function hint_text(s)
(
  s == 1 ? "Volume: the 200A's volume pot between the preamp and the power amp. Turned right up, big loud chords drive the amp into clipping, like the real one." :
  s == 2 ? "Vibrato: the 200A's tremolo (about 5.6 Hz). It works inside the preamp's feedback loop, so it changes the tone as well as the level." :
  s == 3 ? "Speaker: 0 % is the flat amp output. Turn it up for the 200A's small speakers and cabinet: less bass and treble, gentle saturation." :
  s == 4 ? "MLP corrections: small per-note changes to the reed's partials, learnt from recordings of a real 200A (experimental)." :
  s == 5 ? "Keyboard range. 64: the 200A's keys, A1 to C7 (other notes are silent). 88: A0 to C8, with OpenWurli's reed model carried beyond the real 200A's range." :
  s == 8 ? "Sustain (CC64): glows as the dampers lift off the reeds. Click to hold or release; scroll or drag for half-pedal." :
  s == 7 ? (p_ext >= 0.5 ? "Click to play (88 keys, A0 to C8). Lower on the key is louder." : "Click to play (the 200A's 64 keys, A1 to C7). Lower on the key is louder.") :
  "Drag or scroll a knob to adjust  ·  Ctrl for fine control  ·  double-click to reset";
);

function rk_draw(cx, cy, rad, pos, cr, cg, cb) local(ang0, ang1, ang, i, a, sa, ca)
(
  ang0 = -2.35619;
  ang1 = 2.35619;
  gfx_set(0, 0, 0, 0.35);
  gfx_circle(cx + rad * 0.06, cy + rad * 0.10, rad * 1.02, 1, 1);
  gfx_set(0.03, 0.03, 0.035, 1);
  gfx_circle(cx, cy, rad, 1, 1);
  i = 0;
  loop(30,
    a = i * 2 * $pi / 30;
    gfx_set(0.17, 0.17, 0.18, 1);
    gfx_line(cx + sin(a) * rad * 0.80, cy - cos(a) * rad * 0.80, cx + sin(a) * rad * 0.97, cy - cos(a) * rad * 0.97, 1);
    i += 1;
  );
  gfx_set(0.10, 0.10, 0.11, 1);
  gfx_circle(cx, cy, rad * 0.78, 1, 1);
  gfx_set(1, 1, 1, 0.08);
  gfx_circle(cx - rad * 0.12, cy - rad * 0.14, rad * 0.52, 1, 1);
  ang = ang0 + (ang1 - ang0) * pos;
  sa = sin(ang); ca = cos(ang);
  gfx_set(cr, cg, cb, 1);
  i = -1;
  loop(3,
    gfx_line(cx + sa * rad * 0.30 + ca * i * uscale, cy - ca * rad * 0.30 + sa * i * uscale, cx + sa * rad * 0.92 + ca * i * uscale, cy - ca * rad * 0.92 + sa * i * uscale, 1);
    i += 1;
  );
);

function scale_ticks(cx, cy, rad) local(i, a)
(
  i = 0;
  loop(11,
    a = -2.35619 + 4.71239 * i / 10;
    gfx_set(0.93, 0.89, 0.80, (i == 0 || i == 10 || i == 5) ? 0.9 : 0.45);
    gfx_line(cx + sin(a) * rad * 1.12, cy - cos(a) * rad * 1.12, cx + sin(a) * rad * ((i == 0 || i == 10 || i == 5) ? 1.30 : 1.22), cy - cos(a) * rad * ((i == 0 || i == 10 || i == 5) ? 1.30 : 1.22), 1);
    i += 1;
  );
);

function knob_at(s, cx, cy, rad, fsz) local(hov, x, ly, act)
(
  hov = hit_circle(mouse_x, mouse_y, cx, cy, rad + 4 * uscale);
  hov ? u_hov = s;
  (u_click && hov) ? (
    (u_ctarget == s && time_precise() - u_ctime < 0.3) ? (
      set_slider(s, def_val(s));
      u_drag = 0;
    ) : (
      u_drag = s; u_dy0 = mouse_y; u_dv0 = norm_of(s); u_dfine = mouse_cap & 4;
      automate(s, 0);
    );
    u_ctarget = s; u_ctime = time_precise();
    u_click = 0;
  );
  (hov && u_wheel != 0 && u_drag == 0) ? (
    x = norm_of(s) + (u_wheel / 120) * ((mouse_cap & 4) ? 0.002 : 0.02);
    set_norm(s, max(0, min(1, x)));
    automate(s, 1);
    u_wheel = 0;
  );
  scale_ticks(cx, cy, rad);
  rk_draw(cx, cy, rad, norm_of(s), 0.95, 0.91, 0.82);
  act = hov || u_drag == s;
  ly = cy + rad * 1.36 + 2 * uscale;
  gfx_set(0.93, 0.89, 0.80, 1);
  ctext(knob_name(s), cx, ly, fsz, 'b');
  gfx_set(act ? 0.98 : 0.62, act ? 0.66 : 0.60, act ? 0.25 : 0.56, 1);
  sprintf(#upt, "%d%%", floor(slider(s) * 100 + 0.5));
  ctext(#upt, cx, ly + (fsz + 5) * uscale, 12, 0);
);

function send_ev(st, d1, d2)
(
  UIQ[uiq_w * 3] = st; UIQ[uiq_w * 3 + 1] = d1; UIQ[uiq_w * 3 + 2] = d2;
  uiq_w = (uiq_w + 1) % 64;
);

function pedal_widget(x, y, w, h) local(hov, v, fill, tw, th, nv, cx, cy, rr)
(
  hov = hit_rect(mouse_x, mouse_y, x, y, w, h);
  hov ? u_hov = 8;
  v = ped_raw;
  (u_click && hov) ? (
    u_pdrag = 1; u_pdy0 = mouse_y; u_pdv0 = v; u_plast = v; u_pmoved = 0;
    u_click = 0;
  );
  u_pdrag ? (
    u_down ? (
      abs(mouse_y - u_pdy0) > 3 * uscale ? u_pmoved = 1;
      u_pmoved ? (
        nv = max(0, min(127, floor(u_pdv0 + (mouse_y - u_pdy0) / (h * 0.8) * 127 + 0.5)));
        nv != v ? ( send_ev(0xB0, 64, nv); );
      );
    ) : (
      !u_pmoved ? ( nv = v >= 64 ? 0 : 127; send_ev(0xB0, 64, nv); );
      u_pdrag = 0;
    );
  );
  (hov && u_wheel != 0 && !u_pdrag) ? (
    nv = max(0, min(127, v + (u_wheel > 0 ? 8 : -8)));
    send_ev(0xB0, 64, nv);
    u_wheel = 0;
  );
  fill = max(0, min(1, 1 - ped_e));
  cx = x + w * 0.5; cy = y + h * 0.5; rr = 8 * uscale;
  fill > 0.01 ? (
    gfx_set(1, 0.62, 0.20, 0.10 + 0.25 * fill); gfx_circle(cx, cy, rr * (1.2 + 0.4 * fill), 1, 1);
  );
  gfx_set(0.02, 0.02, 0.025, 1); gfx_circle(cx, cy, rr + 2 * uscale, 1, 1);
  gfx_set(0.20 + 0.78 * fill, 0.10 + 0.55 * fill, 0.05 + 0.15 * fill, 1); gfx_circle(cx, cy, rr, 1, 1);
  gfx_set(1, 0.85, 0.55, 0.15 + 0.55 * fill); gfx_circle(cx - rr * 0.3, cy - rr * 0.3, rr * 0.3, 1, 1);
  gfx_set(0.93, 0.89, 0.80, 1);
  ctext("SUSTAIN", cx, y + h + 2 * uscale, 12, 'b');
  gfx_set(hov || u_pdrag ? 0.98 : 0.62, hov || u_pdrag ? 0.66 : 0.60, hov || u_pdrag ? 0.25 : 0.56, 1);
  fill >= 0.995 ? strcpy(#upd, "full") : fill <= 0.005 ? strcpy(#upd, "off") : sprintf(#upd, "%d%%", floor(fill * 100 + 0.5));
  ctext(#upd, cx, y + h + 16 * uscale, 11, 0);
);

function seg_btn(s, val, x, y, w, h, label) local(on, hov, tw, th)
(
  on = (slider(s) >= 0.5) == val;
  hov = hit_rect(mouse_x, mouse_y, x, y, w, h);
  hov ? u_hov = s;
  on ? gfx_set(0.95, 0.62, 0.22, 1) : gfx_set(hov ? 0.26 : 0.20, hov ? 0.26 : 0.20, hov ? 0.28 : 0.22, 1);
  gfx_rect(x + uscale, y + uscale, w - 2 * uscale, h - 2 * uscale, 1);
  gfx_setfont(1, "Arial", 13 * uscale, 'b');
  on ? gfx_set(0.10, 0.07, 0.04, 1) : gfx_set(0.93, 0.89, 0.80, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + (w - tw) * 0.5; gfx_y = y + (h - th) * 0.5;
  gfx_drawstr(label);
  (u_click && hov && !on) ? ( set_slider(s, val); u_click = 0; );
);

function toggle_btn(s, x, y, w, h, label) local(on, hov, tw, th)
(
  on = slider(s) >= 0.5;
  hov = hit_rect(mouse_x, mouse_y, x, y, w, h);
  hov ? u_hov = s;
  gfx_set(0.02, 0.02, 0.025, 1);
  gfx_roundrect(x - uscale, y - uscale, w + 2 * uscale, h + 2 * uscale, 5 * uscale, 1);
  on ? gfx_set(0.95, 0.62, 0.22, 1) : gfx_set(hov ? 0.26 : 0.20, hov ? 0.26 : 0.20, hov ? 0.28 : 0.22, 1);
  gfx_rect(x + uscale, y + uscale, w - 2 * uscale, h - 2 * uscale, 1);
  gfx_setfont(1, "Arial", 13 * uscale, 'b');
  on ? gfx_set(0.10, 0.07, 0.04, 1) : gfx_set(0.93, 0.89, 0.80, 1);
  gfx_measurestr(label, tw, th);
  gfx_x = x + (w - tw) * 0.5; gfx_y = y + (h - th) * 0.5;
  gfx_drawstr(label);
  (u_click && hov) ? ( set_slider(s, on ? 0 : 1); u_click = 0; );
);

function wurli_kb(x, y, w, h, lo, nw, held, sc) local(ww, bw, bh, n, wi, pc, isb, kx, kwid, dn, i)
(
  ww = w / nw;
  bw = ww * 0.58; bh = h * 0.62;
  gfx_set(0.55, 0.06, 0.07, 1);
  gfx_rect(x, y - 7 * sc, w, 7 * sc, 1);
  gfx_set(0, 0, 0, 0.35);
  gfx_rect(x, y - 2 * sc, w, 2 * sc, 1);
  gfx_set(0.02, 0.02, 0.02, 1);
  gfx_rect(x, y, w, h, 1);
  n = lo; wi = 0;
  while (wi < nw) (
    pc = n % 12;
    isb = pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10;
    !isb ? (
      kx = floor(x + wi * ww) + max(1, floor(sc));
      kwid = floor(x + (wi + 1) * ww) - kx;
      dn = KEYL[n] > 0 || n == held;
      dn ? (
        gfx_gradrect(kx, y, kwid, h - 2 * sc, 0.80, 0.78, 0.72, 1, 0, 0, 0, 0, -0.12 / h, -0.12 / h, -0.12 / h, 0);
      ) : (
        gfx_gradrect(kx, y, kwid, h, 0.96, 0.94, 0.88, 1, 0, 0, 0, 0, -0.06 / h, -0.06 / h, -0.07 / h, 0);
        gfx_set(1, 1, 1, 0.5); gfx_rect(kx, y + h - 4 * sc, kwid, 1 * sc, 1);
        gfx_set(0.70, 0.68, 0.62, 1); gfx_rect(kx, y + h - 3 * sc, kwid, 3 * sc, 1);
      );
      gfx_set(0, 0, 0, dn ? 0.45 : 0.25); gfx_rect(kx, y, kwid, 3 * sc, 1);
      wi += 1;
    );
    n += 1;
  );
  n = lo; wi = 0;
  while (wi < nw) (
    pc = n % 12;
    isb = pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10;
    isb ? (
      kx = floor(x + wi * ww - bw * 0.5);
      dn = KEYL[n] > 0 || n == held;
      gfx_set(0, 0, 0, 0.45); gfx_rect(kx + 2 * sc, y, bw, bh + 3 * sc, 1);
      gfx_gradrect(kx, y, bw, dn ? bh - 2 * sc : bh, 0.05, 0.05, 0.055, 1, 0, 0, 0, 0, 0.12 / bh, 0.12 / bh, 0.12 / bh, 0);
      !dn ? (
        gfx_set(1, 1, 1, 0.10); gfx_rect(kx + 2 * sc, y + bh - 9 * sc, bw - 4 * sc, 7 * sc, 1);
        gfx_set(1, 1, 1, 0.06); gfx_rect(kx + 2 * sc, y + 3 * sc, max(1, sc), bh - 14 * sc, 1);
      );
    ) : wi += 1;
    n += 1;
  );
);

function cheek(x, y, w, h)
(
  gfx_gradrect(x, y, w, h, 0.10, 0.10, 0.105, 1, 0.0006, 0.0006, 0.0006, 0, 0, 0, 0, 0);
  gfx_set(1, 1, 1, 0.06);
  gfx_rect(x + 2 * uscale, y, max(1, uscale), h, 1);
);

u_down = mouse_cap & 1;
u_click = u_down && !u_pstate;
u_wheel = mouse_wheel;
mouse_wheel = 0;
u_hov = 0;
u_kbinit == 0 ? ( u_kbinit = 1; u_kbnote = -1; );

// ---------------------------------------------------------------------- case
gfx_set(0.06, 0.06, 0.065, 1);
gfx_rect(0, 0, gfx_w, gfx_h, 1);
gfx_gradrect(px(0), py(0), UDW * uscale, 294 * uscale, 0.115, 0.115, 0.12, 1, 0, 0, 0, 0, -0.00015 / uscale, -0.00015 / uscale, -0.00015 / uscale, 0);
gfx_set(0.55, 0.56, 0.58, 1);
gfx_rect(px(0), py(66), UDW * uscale, max(1, 2 * uscale), 1);
gfx_set(0.85, 0.86, 0.88, 1);
gfx_rect(px(0), py(66), UDW * uscale, max(1, uscale), 1);

// ---------------------------------------------------------------------- header
gfx_set(0.95, 0.91, 0.82, 1);
gfx_setfont(2, "Georgia", 36 * uscale, 'i');
gfx_x = px(28); gfx_y = py(10);
gfx_drawstr("Wurly Bird");
gfx_measurestr("Wurly Bird", utw, uth);
gfx_setfont(1, "Arial", 15 * uscale, 'b');
gfx_set(0.95, 0.62, 0.22, 1);
gfx_x = px(28) + utw + 14 * uscale; gfx_y = py(26);
gfx_drawstr("ELECTRIC PIANO");
gfx_setfont(1, "Arial", 12 * uscale);
gfx_set(0.62, 0.60, 0.56, 1);
gfx_measurestr("by chmaha  ·  based on OpenWurli by hal0zer0", utw, uth);
gfx_x = px(UDW - 28) - utw; gfx_y = py(28);
gfx_drawstr("by chmaha  ·  based on OpenWurli by hal0zer0");

// ---------------------------------------------------------------------- controls
knob_at(1, px(150), py(124), 34 * uscale, 15);
knob_at(2, px(330), py(124), 34 * uscale, 15);
knob_at(3, px(510), py(124), 34 * uscale, 15);
toggle_btn(4, px(640), py(92), 104 * uscale, 30 * uscale, "MLP");
gfx_set(0.02, 0.02, 0.025, 1);
gfx_roundrect(px(640) - uscale, py(134) - uscale, 104 * uscale + 2 * uscale, 30 * uscale + 2 * uscale, 5 * uscale, 1);
seg_btn(5, 0, px(640), py(134), 52 * uscale, 30 * uscale, "64");
seg_btn(5, 1, px(692), py(134), 52 * uscale, 30 * uscale, "88");
gfx_set(0.62, 0.60, 0.56, 1);
ctext("KEYS", px(692), py(168), 11, 'b');
pedal_widget(px(820), py(108), 72 * uscale, 24 * uscale);

!tables_ok ? (
  gfx_set(0.10, 0.13, 0.20, 0.92);
  gfx_rect(px(250), py(100), 500 * uscale, 50 * uscale, 1);
  gfx_set(1, 0.8, 0.5, 1);
  ctext("Missing or unreadable Dependencies/WurlyBird/wurlybird_tables.txt", px(500), py(116), 14, 'b');
);

// ---------------------------------------------------------------------- keyboard
memset(KEYL, 0, 128);
ui = 0;
loop(64, SL_ST[ui] == 1 ? KEYL[SL_NOTE[ui]] = 1; ui += 1; );
ukby = py(214); ukbh = 74 * uscale;
ukbx = px(36); ukbw = 928 * uscale;
ukext = p_ext >= 0.5;
unwk = ukext ? 52 : 38;
uklo = ukext ? 21 : 33;
ukcnt = ukext ? 88 : 64;
uwkw = ukbw / unwk;
cheek(px(8), py(200), 28 * uscale, 94 * uscale);
cheek(px(964), py(200), 28 * uscale, 94 * uscale);
ukhit = -1;
un = uklo;
uwi = 0;
loop(ukcnt,
  upc = un % 12;
  (upc == 1 || upc == 3 || upc == 6 || upc == 8 || upc == 10) ? (
    ukpx = ukbx + uwi * uwkw - uwkw * 0.29;
    hit_rect(mouse_x, mouse_y, ukpx, ukby, uwkw * 0.58, ukbh * 0.62) ? ( ukhit = un; ukhy = (mouse_y - ukby) / (ukbh * 0.62); );
  ) : uwi += 1;
  un += 1;
);
un = uklo;
uwi = 0;
loop(ukcnt,
  upc = un % 12;
  !(upc == 1 || upc == 3 || upc == 6 || upc == 8 || upc == 10) ? (
    ukpx = ukbx + uwi * uwkw;
    (ukhit < 0 && hit_rect(mouse_x, mouse_y, ukpx, ukby, uwkw, ukbh)) ? ( ukhit = un; ukhy = (mouse_y - ukby) / ukbh; );
    uwi += 1;
  );
  un += 1;
);
wurli_kb(ukbx, ukby, ukbw, ukbh, uklo, unwk, u_kbnote, uscale);
ukhit >= 0 ? (
  u_hov = 7;
  u_click ? (
    send_ev(0x90, ukhit, floor(30 + 97 * min(1, max(0, ukhy))));
    u_kbnote = ukhit;
    u_click = 0;
  );
);
(u_kbnote >= 0 && !u_down) ? (
  send_ev(0x80, u_kbnote, 0);
  u_kbnote = -1;
);

// ---------------------------------------------------------------------- hint bar
gfx_set(0.20, 0.20, 0.21, 1);
gfx_rect(px(0), py(294), UDW * uscale, 36 * uscale, 1);
uhs = u_drag > 0 ? u_drag : u_hov;
gfx_setfont(1, "Arial", 13 * uscale);
gfx_set(0.80, 0.80, 0.82, 1);
strcpy(#uhint, hint_text(uhs));
gfx_measurestr(#uhint, uhtw, uhth);
uhtw > (UDW - 20) * uscale ? ( gfx_setfont(1, "Arial", 13 * uscale * (UDW - 20) * uscale / uhtw); gfx_measurestr(#uhint, uhtw, uhth); );
gfx_x = uox + (UDW * uscale - uhtw) * 0.5; gfx_y = py(294) + (36 * uscale - uhth) * 0.5;
gfx_drawstr(#uhint);

u_drag > 0 ? (
  u_down ? (
    mouse_cap |= 65536;
    ufine = mouse_cap & 4;
    ufine != u_dfine ? ( u_dy0 = mouse_y; u_dv0 = norm_of(u_drag); u_dfine = ufine; );
    set_norm(u_drag, max(0, min(1, u_dv0 + (u_dy0 - mouse_y) / (150 * uscale) * (ufine ? 0.1 : 1))));
  ) : ( automate(u_drag, 1); u_drag = 0; );
);

u_pstate = u_down;
