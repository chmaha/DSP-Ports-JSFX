    smp < ons ? (
      cs = 0.5 * (1 - cos(smp * oinc));
      onset = oexp <= 1.001 ? cs : oexp >= 1.999 ? cs * cs : cs ^ oexp;
    ) : onset = 1;
    sum = 0;
<? m = 0; loop(7,
  printf("    sum += ((a%d * s%d) * onset) * e%d;\n", m, m, m);
  printf("    ns = s%d * k%d + c%d * q%d; c%d = c%d * k%d - s%d * q%d; s%d = ns; e%d *= d%d;\n", m, m, m, m, m, m, m, m, m, m, m, m);
  m += 1; ); ?>
    dragk > 0 ? e0 = e0 * (1 - dragk * e0);
    ((smp & 1023) == 0 && smp > 0) ? (
<? m = 0; loop(7, printf("      ri = 1 / sqrt(s%d * s%d + c%d * c%d); s%d *= ri; c%d *= ri;\n", m, m, m, m, m, m); m += 1; ); ?>
    );
    smp += 1;
    x = sum;
    nrem > 0 ? (
      nfade > 0 ? (
        t = (16 - nfade) / 16;
        nfade -= 1;
        nenv = 0.5 * (1 - cos($pi * t));
