      conv = 1;
    ) : (
      j00 = 1 - kc00 * gc0 - kb00 * gb0;
      j01 = -kc01 * gc1 - kb01 * gb1;
      j10 = -kc10 * gc0 - kb10 * gb0;
      j11 = 1 - kc11 * gc1 - kb11 * gb1;
      det = j00 * j11 - j01 * j10;
