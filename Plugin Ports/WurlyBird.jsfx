slider1:p_vol=0.8<0,1,0.001>-Volume
slider2:p_depth=0.5<0,1,0.001>-Vibrato (Tremolo Depth)
slider3:p_spk=0<0,1,0.001>-Speaker Character
slider4:p_mlp=0<0,1,1{Off,On}>-MLP Corrections
slider5:p_ext=0<0,1,1{64 keys (A1-C7),88 keys (A0-C8)}>-Keyboard Range

in_pin:none
out_pin:Left
out_pin:Right
options:no_meter

@init

ext_noinit = gfx_ext_retina = 1;
ext_nodenorm = 1;

function alloc(n) local(r) instance(mp) global() ( r = mp; mp += n; memset(r, 0, n); r; );
alloc.mp = 0;

TWO32 = 4294967296;
TWOPI = 2 * $pi;
NREC = 128;
VSZ = 96;

TRAW = alloc(70000);
VREC = alloc(NREC * VSZ);
SL_ST = alloc(64);
SL_NOTE = alloc(64);
SL_AGE = alloc(64);
SL_V = alloc(64);
SL_SV = alloc(64);
SL_SF = alloc(64);
SL_SFL = alloc(64);
SUMB = alloc(16384);
OUTB = alloc(16384);
EVQ = alloc(4096);
UIQ = alloc(3 * 64);
KEYL = alloc(128);
LEDLUT = alloc(256);
MA = alloc(81);
MB = alloc(81);
MC = alloc(81);
AUG = alloc(162);
PG = alloc(81);
PGDC = alloc(81);
PCM = alloc(81);
PANEG = alloc(81);
PS = alloc(81);
PSDC = alloc(81);
PW = alloc(9);
PRHS = alloc(9);
PVDC = alloc(9);
NVA = alloc(4);
NVB = alloc(4);
NICA = alloc(4);
NICB = alloc(4);
NIBA = alloc(4);
NIBB = alloc(4);
KC = alloc(4);
KB = alloc(4);
MLPH1 = alloc(16);
MLPH2 = alloc(16);
MLPR = alloc(11);
VRAT = alloc(7);
VDEC = alloc(7);
VAMP = alloc(7);
VATT = alloc(7);
LAWP = alloc(24);

// ---------------------------------------------------------------------- tables

function tables_load() local(h, n, p, k, ln) (
  h = file_open("WurlyBird/wurlybird_tables.txt");
  h < 0 ? h = file_open("Dependencies/WurlyBird/wurlybird_tables.txt");
  tables_ok = 0;
  h >= 0 ? (
    n = file_mem(h, TRAW, 70000);
    file_close(h);
    p = TRAW;
    k = 0;
    loop(4,
      ln = p[2];
      LAWP[k * 6] = p[0];
      LAWP[k * 6 + 1] = p[1];
      LAWP[k * 6 + 2] = ln - 2;
      LAWP[k * 6 + 3] = p + 3;
      LAWP[k * 6 + 4] = p + 3 + ln;
      LAWP[k * 6 + 5] = (p[1] * p[1]) / 6;
      p += 3 + 2 * ln;
      k += 1;
    );
    MW1 = p; MB1 = p + 32; MW2 = p + 48; MB2 = p + 304; MW3 = p + 320; MB3 = p + 496;
    MMEAN = p + 507; MSTD = p + 518;
    p += 529;
    VELT = p;
    NOTET = p + 128;
    p += 128 + 88 * 289;
    TT_A = p + 4; TT_A_SR = p[0]; TT_A_P = p[1]; TT_A_N = p[2]; TT_A_S0 = p[3];
    p += 4 + TT_A_N;
    TT_B = p + 4; TT_B_SR = p[0]; TT_B_P = p[1]; TT_B_N = p[2]; TT_B_S0 = p[3];
    p += 4 + TT_B_N;
    tables_ok = (p - TRAW) == n && TT_A_SR == 88200 && TT_B_SR == 96000;
  );
);
tables_load();

// ---------------------------------------------------------------------- LED + LDR

function led_ln_at(i) local(acc, pi, pn, r, done) (
  pi = 0.1;
  pn = 1.36;
  i <= pi ? (
    r = pn * log(i / pi);
  ) : (
    acc = 0;
    done = 0;
    acc += pn * log(min(i, 1) / pi);
    i <= 1 ? ( r = acc; done = 1; );
    !done ? (
      pi = 1; pn = 1.22;
      acc += pn * log(min(i, 3) / pi);
      i <= 3 ? ( r = acc; done = 1; );
    );
    !done ? (
      pi = 3; pn = 1.02;
      acc += pn * log(min(i, 10) / pi);
      i <= 10 ? ( r = acc; done = 1; );
    );
    !done ? (
      pi = 10; pn = 0.88;
      acc += pn * log(min(i, 40) / pi);
      i <= 40 ? ( r = acc; done = 1; );
    );
    !done ? (
      pi = 40; pn = 0.88;
      r = acc + pn * log(i / pi);
    );
  );
  r;
);

function led_intensity(i) (
  i <= 0 ? 0 : exp(led_ln_at(i) - led_ln_at(2.279));
);

function led_lut_init() local(k) (
  k = 0;
  loop(256,
    LEDLUT[k] = max(0, min(1, led_intensity((2.279 * k) / 255)));
    k += 1;
  );
);
led_lut_init();

TR_LNMAX = log(1000000);
TR_LND = log(9000) - log(1000000);

function trem_setup(osr) (
  osr % 11025 == 0 ? (
    TT = TT_A; tr_p = TT_A_P; tr_s0 = TT_A_S0; tr_step = TT_A_SR / osr;
  ) : (
    TT = TT_B; tr_p = TT_B_P; tr_s0 = TT_B_S0; tr_step = TT_B_SR / osr;
  );
  tr_att = exp(-1 / (0.0025 * osr));
  tr_rel = exp(-1 / (0.035 * osr));
);

function trem_reset() (
  tr_pos = tr_s0;
  tr_env = 0;
  tr_r = 1000000;
);

function trem_process() local(fi, fr, y0, y1, y2, y3, ima, x, k, f, light, coeff, drv, ru, rl, top, low) (
  fi = floor(tr_pos);
  fr = tr_pos - fi;
  fr == 0 ? (
    ima = TT[fi];
  ) : fi < 1 ? (
    ima = TT[fi] + fr * (TT[fi + 1] - TT[fi]);
  ) : (
    y0 = TT[fi - 1]; y1 = TT[fi]; y2 = TT[fi + 1]; y3 = TT[fi + 2];
    ima = y1 + 0.5 * fr * (y2 - y0 + fr * (2 * y0 - 5 * y1 + 4 * y2 - y3 + fr * (3 * (y1 - y2) + y3 - y0)));
  );
  tr_pos += tr_step;
  tr_pos >= tr_p + 1 ? tr_pos -= tr_p;
  x = max(0, min(1, ima / 2.279)) * 255;
  k = floor(x);
  k + 1 < 256 ? (
    f = x - k;
    light = LEDLUT[k] * (1 - f) + LEDLUT[k + 1] * f;
  ) : light = LEDLUT[255];
  coeff = light > tr_env ? tr_att : tr_rel;
  tr_env = light + coeff * (tr_env - light);
  drv = max(0, min(1, tr_env));
  drv < 0.000001 ? tr_r = 1000000 : tr_r = exp(TR_LNMAX + TR_LND * (drv ^ 0.9));
  ru = 50000 * (1 - tr_depth);
  rl = 50000 * tr_depth;
  top = ru > 0 ? (ru * 18000) / (ru + 18000) : 0;
  low = rl > 0 ? (rl * tr_r) / (rl + tr_r) : 0;
  top + low;
);

// ---------------------------------------------------------------------- preamp (9-node DK solver)

PA_VCC = 14.5;
PA_R1 = 22000; PA_R2 = 1000000; PA_R3 = 470000; PA_RE1 = 33000; PA_RC1 = 150000;
PA_RE2A = 270; PA_RE2B = 820; PA_RC2 = 1800; PA_R9 = 6800; PA_R10 = 56000; PA_RLOAD = 100000;
PA_RINEFF = (PA_R1 * PA_R2) / (PA_R1 + PA_R2);
PA_KIN = PA_R2 / (PA_R1 + PA_R2);
PA_CIN = 0.000000022; PA_C2 = 0.00000000022; PA_C3 = 0.0000000001; PA_C4 = 0.0000000001;
PA_CE1 = 0.0000047; PA_CE2 = 0.000022; PA_C6 = 0.0000047;
BJ_IS = 0.0000000000000303; BJ_VT = 0.026; BJ_NF = 1.005; BJ_BF = 1434;
BJ_ISE = 0.00000000000000288; BJ_NE = 1.262; BJ_IKF = 0.01358;
BJ_VTF = BJ_NF * BJ_VT;
BJ_NEVT = BJ_NE * BJ_VT;
BJ_ISIKF = BJ_IS / BJ_IKF;
PA_OCF = (PA_R9 + PA_RLOAD) / PA_RLOAD;

NVA[0] = 0; NVA[1] = 1; NVA[2] = 1; NVA[3] = -1;
NVB[0] = 2; NVB[1] = 1; NVB[2] = 3; NVB[3] = -1;
NICA[0] = 1; NICA[1] = 1; NICA[2] = 2; NICA[3] = -1;
NICB[0] = 3; NICB[1] = 1; NICB[2] = 5; NICB[3] = -1;
NIBA[0] = 1; NIBA[1] = 1; NIBA[2] = 0; NIBA[3] = -1;
NIBB[0] = 3; NIBB[1] = 1; NIBB[2] = 2; NIBB[3] = -1;

function bjt(vbe) local(v, ef, icc, q2, root, qb, ee, dicc, dq2, dqb) (
  v = max(-1, min(0.85, vbe));
  ef = exp(v / BJ_VTF);
  icc = BJ_IS * (ef - 1);
  q2 = BJ_ISIKF * ef;
  root = sqrt(1 + 4 * q2);
  qb = 0.5 * (1 + root);
  bj_ic = icc / qb;
  ee = exp(v / BJ_NEVT);
  bj_ib = icc / BJ_BF + BJ_ISE * (ee - 1);
  dicc = (BJ_IS * ef) / BJ_VTF;
  dq2 = q2 / BJ_VTF;
  dqb = dq2 / root;
  bj_gc = (dicc * qb - icc * dqb) / (qb * qb);
  bj_gb = dicc / BJ_BF + (BJ_ISE * ee) / BJ_NEVT;
);

function stamp_r(g, i, j, r) local(cd) (
  cd = 1 / r;
  g[i * 9 + i] += cd;
  g[j * 9 + j] += cd;
  g[i * 9 + j] -= cd;
  g[j * 9 + i] -= cd;
);

function stamp_c(c, i, j, cap) (
  c[i * 9 + i] += cap;
  c[j * 9 + j] += cap;
  c[i * 9 + j] -= cap;
  c[j * 9 + i] -= cap;
);

function mat_inverse(m, dst) local(i, j, col, row, mx, mr, piv, fc, tmp) (
  i = 0;
  loop(9,
    j = 0;
    loop(9, AUG[i * 18 + j] = m[i * 9 + j]; AUG[i * 18 + 9 + j] = i == j ? 1 : 0; j += 1; );
    i += 1;
  );
  col = 0;
  loop(9,
    mx = abs(AUG[col * 18 + col]);
    mr = col;
    row = col + 1;
    loop(8 - col,
      abs(AUG[row * 18 + col]) > mx ? ( mx = abs(AUG[row * 18 + col]); mr = row; );
      row += 1;
    );
    mr != col ? (
      j = 0;
      loop(18, tmp = AUG[col * 18 + j]; AUG[col * 18 + j] = AUG[mr * 18 + j]; AUG[mr * 18 + j] = tmp; j += 1; );
    );
    piv = AUG[col * 18 + col];
    j = 0;
    loop(18, AUG[col * 18 + j] /= piv; j += 1; );
    row = 0;
    loop(9,
      row != col ? (
        fc = AUG[row * 18 + col];
        j = 0;
        loop(18, AUG[row * 18 + j] -= fc * AUG[col * 18 + j]; j += 1; );
      );
      row += 1;
    );
    col += 1;
  );
  i = 0;
  loop(9,
    j = 0;
    loop(9, dst[i * 9 + j] = AUG[i * 18 + 9 + j]; j += 1; );
    i += 1;
  );
);

function mat_vec(m, x, dst) local(i, j, s) (
  i = 0;
  loop(9,
    s = 0;
    j = 0;
    loop(9, s += m[i * 9 + j] * x[j]; j += 1; );
    dst[i] = s;
    i += 1;
  );
);

function nv_ptr(i) ( i == 0 ? NVA : NVB; );

function compute_k(s, nia, nib, dst) local(i, j, nv, ni, acc, a, b) (
  i = 0;
  loop(2,
    nv = nv_ptr(i);
    j = 0;
    loop(2,
      ni = j == 0 ? nia : nib;
      acc = 0;
      a = 0;
      loop(2,
        b = 0;
        loop(2,
          acc += (nv[a * 2 + 1] * ni[b * 2 + 1]) * s[nv[a * 2] * 9 + ni[b * 2]];
          b += 1;
        );
        a += 1;
      );
      dst[i * 2 + j] = acc;
      j += 1;
    );
    i += 1;
  );
);

function full_dc_solve(rl) local(i, sv0, sv1, sv2, sv3, pdc0, pdc1, v0, v1, ic0, ib0, gc0, gb0, ic1, ib1, gc1, gb1, f0, f1, j00, j01, j10, j11, det, idet, dv0, dv1, it) (
  memcpy(MA, PGDC, 81);
  MA[8 * 9 + 8] += 1 / rl;
  mat_inverse(MA, PSDC);
  compute_k(PSDC, NICA, NICB, KC);
  compute_k(PSDC, NIBA, NIBB, KB);
  mat_vec(PSDC, PW, PRHS);
  pdc0 = PRHS[0] - PRHS[1];
  pdc1 = PRHS[2] - PRHS[3];
  v0 = 0.56;
  v1 = 0.66;
  it = 0;
  while (it < 200) (
    bjt(v0); ic0 = bj_ic; ib0 = bj_ib; gc0 = bj_gc; gb0 = bj_gb;
    bjt(v1); ic1 = bj_ic; ib1 = bj_ib; gc1 = bj_gc; gb1 = bj_gb;
    f0 = v0 - pdc0 - KC[0] * ic0 - KC[1] * ic1 - KB[0] * ib0 - KB[1] * ib1;
    f1 = v1 - pdc1 - KC[2] * ic0 - KC[3] * ic1 - KB[2] * ib0 - KB[3] * ib1;
    (abs(f0) < 0.0000000000001 && abs(f1) < 0.0000000000001) ? (
      it = 200;
    ) : (
      j00 = 1 - KC[0] * gc0 - KB[0] * gb0;
      j01 = -KC[1] * gc1 - KB[1] * gb1;
      j10 = -KC[2] * gc0 - KB[2] * gb0;
      j11 = 1 - KC[3] * gc1 - KB[3] * gb1;
      det = j00 * j11 - j01 * j10;
      idet = 1 / det;
      dv0 = idet * (j11 * f0 - j01 * f1);
      dv1 = idet * (j00 * f1 - j10 * f0);
      v0 -= max(-2 * BJ_VT, min(2 * BJ_VT, dv0));
      v1 -= max(-2 * BJ_VT, min(2 * BJ_VT, dv1));
      it += 1;
    );
  );
  bjt(v0); ic0 = bj_ic; ib0 = bj_ib;
  bjt(v1); ic1 = bj_ic; ib1 = bj_ib;
  i = 0;
  loop(9, PRHS[i] = PW[i]; i += 1; );
  PRHS[1] += ic0; PRHS[2] += -ic0;
  PRHS[1] += ib0; PRHS[0] += -ib0;
  PRHS[3] += ic1; PRHS[5] += -ic1;
  PRHS[3] += ib1; PRHS[2] += -ib1;
  mat_vec(PSDC, PRHS, PVDC);
  dc_v0 = v0;
  dc_v1 = v1;
);

function preamp_state_from_dc() (
  pjcin = pgcin * PVDC[0];
  pcinp = pgcin * PVDC[0];
<?
  i = 0;
  loop(9, printf("  pv%d = PVDC[%d];\n", i, i); i += 1; );
?>
  bjt(dc_v0); pic0 = bj_ic; pib0 = bj_ib;
  bjt(dc_v1); pic1 = bj_ic; pib1 = bj_ib;
  pvnl0 = dc_v0;
  pvnl1 = dc_v1;
);

function preamp_new(osr) local(t, tot, acin, i, j) (
  t = 1 / osr;
  tot = 2 / t;
  acin = ((2 * PA_RINEFF) * PA_CIN) * osr;
  pgcin = ((2 * PA_CIN) * osr) / (1 + acin);
  pccin = (1 - acin) / (1 + acin);
  pgc1pc = pgcin * (1 + pccin);
  memset(PG, 0, 81);
  memset(PW, 0, 9);
  memset(PCM, 0, 81);
  stamp_r(PG, 0, 4, PA_R3);
  PG[1 * 9 + 1] += 1 / PA_RE1;
  PG[2 * 9 + 2] += 1 / PA_RC1;
  PW[2] += PA_VCC / PA_RC1;
  stamp_r(PG, 3, 4, PA_RE2A);
  PG[4 * 9 + 4] += 1 / PA_RE2B;
  PG[5 * 9 + 5] += 1 / PA_RC2;
  PW[5] += PA_VCC / PA_RC2;
  stamp_r(PG, 6, 7, PA_R9);
  stamp_r(PG, 6, 8, PA_R10);
  PG[7 * 9 + 7] += 1 / PA_RLOAD;
  memcpy(PGDC, PG, 81);
  PG[0] += pgcin;
  stamp_c(PCM, 2, 0, PA_C3);
  stamp_c(PCM, 5, 2, PA_C4);
  stamp_c(PCM, 1, 8, PA_CE1);
  stamp_c(PCM, 5, 6, PA_C6);
  PCM[3 * 9 + 3] += PA_CE2;
  PCM[0] += PA_C2;
  i = 0;
  loop(81,
    MB[i] = tot * PCM[i];
    MA[i] = MB[i] + PG[i];
    PANEG[i] = MB[i] - PG[i];
    i += 1;
  );
  mat_inverse(MA, PS);
  compute_k(PS, NICA, NICB, KC);
  compute_k(PS, NIBA, NIBB, KB);
  pkc00 = KC[0]; pkc01 = KC[1]; pkc10 = KC[2]; pkc11 = KC[3];
  pkb00 = KB[0]; pkb01 = KB[1]; pkb10 = KB[2]; pkb11 = KB[3];
  psfb = PS[8 * 9 + 8];
  pnvs0 = PS[0 * 9 + 8] - PS[1 * 9 + 8];
  pnvs1 = PS[2 * 9 + 8] - PS[3 * 9 + 8];
  psnic0 = PS[8 * 9 + 1] + -PS[8 * 9 + 2];
  psnic1 = PS[8 * 9 + 3] + -PS[8 * 9 + 5];
  psnib0 = PS[8 * 9 + 1] + -PS[8 * 9 + 0];
  psnib1 = PS[8 * 9 + 3] + -PS[8 * 9 + 2];
<?
  i = 0;
  loop(9,
    j = 0;
    loop(9, printf("  pa%d_%d = PANEG[%d]; ps%d_%d = PS[%d];\n", i, j, i * 9 + j, i, j, i * 9 + j); j += 1; );
    printf("  pw%d = 2 * PW[%d]; pf%d = PS[%d];\n", i, i, i, i * 9 + 8);
    printf("  pc0_%d = PS[%d] + -PS[%d]; pc1_%d = PS[%d] + -PS[%d];\n", i, i * 9 + 1, i * 9 + 2, i, i * 9 + 3, i * 9 + 5);
    printf("  pb0_%d = PS[%d] + -PS[%d]; pb1_%d = PS[%d] + -PS[%d];\n", i, i * 9 + 1, i * 9 + 0, i, i * 9 + 3, i * 9 + 2);
    i += 1;
  );
?>
  p_rldr = 1000000;
  full_dc_solve(p_rldr);
  preamp_state_from_dc();
  p_gldr = 1 / p_rldr;
  p_gldrp = p_gldr;
);

function preamp_reset() (
  full_dc_solve(p_rldr);
  p_gldr = 1 / p_rldr;
  p_gldrp = p_gldr;
  preamp_state_from_dc();
);

function preamp_set_ldr(r) local(nr) (
  nr = max(r, 1000);
  abs(nr - p_rldr) > 0.01 ? (
    p_rldr = nr;
    p_gldr = 1 / nr;
  );
);

function preamp_process(input) local(conv, vin, cnow, smk, smv, p0, p1, kc00, kc01, kc10, kc11, kb00, kb01, kb10, kb11, v0, v1, it, ic0, ib0, gc0, gb0, ic1, ib1, gc1, gb1, f0, f1, j00, j01, j10, j11, det, idet, dot, dsm) (
<?
  NZ = 1000;
  memset(NZ, 0, 81);
  NZ[0] = NZ[2] = NZ[4] = NZ[10] = NZ[17] = NZ[18] = NZ[20] = NZ[23] = NZ[30] = NZ[31] = NZ[36] = NZ[39] = NZ[40] = 1;
  NZ[47] = NZ[50] = NZ[51] = NZ[59] = NZ[60] = NZ[61] = NZ[62] = NZ[69] = NZ[70] = NZ[73] = NZ[78] = NZ[80] = 1;
  i = 0;
  loop(9,
    printf("  pr%d = ", i);
    j = 0;
    k = 0;
    loop(9, NZ[i * 9 + j] ? ( k ? printf(" + "); printf("pa%d_%d * pv%d", i, j, j); k = 1; ); j += 1; );
    printf(";\n");
    i += 1;
  );
?>
  pr8 -= p_gldrp * pv8;
  vin = input * PA_KIN;
  cnow = pgcin * vin + pjcin;
  pr0 += cnow + pcinp;
  pr1 += pic0; pr2 += -pic0;
  pr1 += pib0; pr0 += -pib0;
  pr3 += pic1; pr5 += -pic1;
  pr3 += pib1; pr2 += -pib1;
<?
  i = 0;
  loop(9, printf("  pr%d += pw%d;\n", i, i); i += 1; );
  i = 0;
  loop(9,
    printf("  pq%d = ", i);
    j = 0;
    loop(9, j ? printf(" + "); printf("ps%d_%d * pr%d", i, j, j); j += 1; );
    printf(";\n");
    i += 1;
