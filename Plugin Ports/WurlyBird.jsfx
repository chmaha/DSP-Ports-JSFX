?>
  smk = p_gldr / (1 + psfb * p_gldr);
  smv = smk * pq8;
<?
  i = 0;
  loop(9, printf("  pq%d = pq%d - smv * pf%d;\n", i, i, i); i += 1; );
?>
  p0 = pq0 - pq1;
  p1 = pq2 - pq3;
  kc00 = pkc00 - smk * pnvs0 * psnic0;
  kc01 = pkc01 - smk * pnvs0 * psnic1;
  kc10 = pkc10 - smk * pnvs1 * psnic0;
  kc11 = pkc11 - smk * pnvs1 * psnic1;
  kb00 = pkb00 - smk * pnvs0 * psnib0;
  kb01 = pkb01 - smk * pnvs0 * psnib1;
  kb10 = pkb10 - smk * pnvs1 * psnib0;
  kb11 = pkb11 - smk * pnvs1 * psnib1;
  v0 = pvnl0;
  v1 = pvnl1;
  it = 0;
  conv = 0;
  while (it < 6) (
    bjt(v0); ic0 = bj_ic; ib0 = bj_ib; gc0 = bj_gc; gb0 = bj_gb;
    bjt(v1); ic1 = bj_ic; ib1 = bj_ib; gc1 = bj_gc; gb1 = bj_gb;
    f0 = v0 - p0 - kc00 * ic0 - kc01 * ic1 - kb00 * ib0 - kb01 * ib1;
    f1 = v1 - p1 - kc10 * ic0 - kc11 * ic1 - kb10 * ib0 - kb11 * ib1;
