G_HOD >= 0 ? G_TID = 11 : G_HCO >= 0 ? G_TID = 12 : G_HNT >= 0 ? G_TID = 13 : G_HEQ ? G_TID = 5 : G_HRO ? G_TID = 6 : G_HOR >= 0 ? G_TID = 7 : G_HIM >= 0 ? G_TID = 8 : G_HFL >= 0 ? G_TID = 9 : G_HK >= 0 ? G_TID = 10;
(G_TID !== G_TLAST || G_MD || G_DRAG > 0 || G_WHEEL !== 0) ? ( G_TLAST = G_TID; G_TT0 = G_NOW; );
